import React, { useState } from 'react';
import DatePicker from 'react-datepicker';
import { format, addDays, setHours, setMinutes } from 'date-fns';
import 'react-datepicker/dist/react-datepicker.css';

const AppointmentScheduler = ({ onConfirm }) => {
  const [selectedDate, setSelectedDate] = useState(null);
  const [selectedTime, setSelectedTime] = useState(null);
  const [appointments, setAppointments] = useState([]);
  const [activeTab, setActiveTab] = useState(0);

  // Generate time slots (4 specific slots as requested)
  const generateTimeSlots = () => {
    if (!selectedDate) return [];
    
    return [
      {
        start: setHours(setMinutes(new Date(selectedDate), 0), 10), // 10:00 AM
        end: setHours(setMinutes(new Date(selectedDate), 0), 11),  // 11:00 AM
        display: '10:00 AM - 11:00 AM'
      },
      {
        start: setHours(setMinutes(new Date(selectedDate), 0), 12), // 12:00 PM
        end: setHours(setMinutes(new Date(selectedDate), 0), 13),   // 1:00 PM
        display: '12:00 PM - 1:00 PM'
      },
      {
        start: setHours(setMinutes(new Date(selectedDate), 0), 15), // 3:00 PM
        end: setHours(setMinutes(new Date(selectedDate), 0), 16),    // 4:00 PM
        display: '3:00 PM - 4:00 PM'
      },
      {
        start: setHours(setMinutes(new Date(selectedDate), 0), 16), // 4:00 PM
        end: setHours(setMinutes(new Date(selectedDate), 0), 17),   // 5:00 PM
        display: '4:00 PM - 5:00 PM'
      }
    ];
  };

  const timeSlots = generateTimeSlots();

  const handleDateSelect = (date) => {
    setSelectedDate(date);
    setSelectedTime(null);
  };

  const handleTimeSelect = (time) => {
    setSelectedTime(time);
  };

  const handleAddAppointment = () => {
    if (selectedDate && selectedTime) {
      const newAppointment = {
        date: selectedDate,
        time: selectedTime.display,
        start: selectedTime.start,
        end: selectedTime.end
      };
      
      setAppointments([...appointments, newAppointment]);
      setSelectedDate(null);
      setSelectedTime(null);
    }
  };

  const handleRemoveAppointment = (index) => {
    const updatedAppointments = [...appointments];
    updatedAppointments.splice(index, 1);
    setAppointments(updatedAppointments);
  };

  const handleConfirm = () => {
    if (appointments.length > 0 && onConfirm) {
      onConfirm(appointments);
    }
  };

  return (
    <div className="appointment-scheduler-container">
      <h2 className="scheduler-title">Schedule Your Appointments</h2>
      
      <div className="scheduler-section">
        <div className="date-selection">
          <h3>Select Date</h3>
          <DatePicker
            selected={selectedDate}
            onChange={handleDateSelect}
            minDate={new Date()}
            inline
            calendarClassName="custom-calendar"
          />
        </div>
        
        {selectedDate && (
          <div className="time-selection">
            <h3>Select Time Slot for {format(selectedDate, 'MMMM d, yyyy')}</h3>
            <div className="time-slots-grid">
              {timeSlots.map((slot, index) => (
                <button
                  key={index}
                  className={`time-slot ${
                    selectedTime?.display === slot.display ? 'selected' : ''
                  }`}
                  onClick={() => handleTimeSelect(slot)}
                >
                  {slot.display}
                </button>
              ))}
            </div>
            
            <button
              className="add-button"
              onClick={handleAddAppointment}
              disabled={!selectedTime}
            >
              Add Appointment
            </button>
          </div>
        )}
      </div>
      
      <div className="appointments-list">
        <h3>Proposed Appointments</h3>
        
        {appointments.length === 0 ? (
          <div className="empty-state">No appointments scheduled yet</div>
        ) : (
          <div className="appointments-grid">
            {appointments.map((appt, index) => (
              <div key={index} className="appointment-card">
                <div className="appointment-info">
                  <span className="appointment-date">
                    {format(appt.date, 'MMM d, yyyy')}
                  </span>
                  <span className="appointment-time">{appt.time}</span>
                </div>
                <button
                  className="remove-button"
                  onClick={() => handleRemoveAppointment(index)}
                >
                  ×
                </button>
              </div>
            ))}
          </div>
        )}
      </div>
      
      <button
        className="confirm-button"
        onClick={handleConfirm}
        disabled={appointments.length === 0}
      >
        Confirm Appointments
      </button>
    </div>
  );
};

export default AppointmentScheduler;
