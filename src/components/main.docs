  //                 );
  //               })
  //             ) : (
  //               <div className="text-center py-5 text-muted">
  //                 <div className="bg-light rounded-circle p-4 d-inline-flex mb-3">
  //                   <BsFileEarmarkPdf size={48} className="opacity-50" />
  //                 </div>
  //                 <p className="mb-0">No files uploaded</p>
  //               </div>
  //             )
  //           ) : (
  //             <>
  //               {files.map((fileInput, idx) => (
  //                 <FileUploadCard
  //                   key={fileInput.id}
  //                   label={`${t(type === 'workOrder' ? 'Work Order' : 'Drawing')} ${fileInput.id}`}
  //                   // label={type === 'workOrder' ? `WorkOrder_${fileInput.id}` : `Drawing_${fileInput.id}`}
  //                   name={`${type}_file_${fileInput.id}`}
  //                   onRemove={() => removeFileInput(type, fileInput.id)}
  //                   showRemove={files.length > 1}
  //                 />
  //               ))}
  //             </>
  //           )}
  //         </div>
  //       </Card.Body>

  //       {!viewMode && (
  //         <Card.Footer className="bg-light border-0 text-center py-3">
  //           <Button
  //             variant="primary"
  //             size="sm"
  //             onClick={() => addFileInput(type)}
  //             className="rounded-pill px-4"
  //           >
  //             <BsPlus className="me-1" size={18} />
  //             Add {title}
  //           </Button>
  //         </Card.Footer>
  //       )}
  //     </Card>
  //   );
  // };

  const SingleFileSection = ({ title, fileName, onDownload, fileSize, icon }) => (
    <Card className="h-100 shadow-sm border-0">
      <Card.Header className="bg-light border-0 py-3">
        <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
          {icon}
          <span className="ms-2">{title}</span>
        </h5>
      </Card.Header>
      <Card.Body className="p-3">
        {fileName ? (
          <DocumentCard
            fileName={fileName}
            description={`${title} document`}
            fileSize={fileSize}
            onDownload={() => onDownload(fileName)}
          />
        ) : (
          <div className="text-center py-4 text-muted">
            <div className="bg-light rounded-circle p-4 d-inline-flex mb-3">
              <BsFileEarmarkPdf size={32} className="opacity-50" />
            </div>
            <p className="mb-0">No file uploaded</p>
          </div>
        )}
      </Card.Body>
    </Card>
  );

  const addFileInput = (type) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      const newId = workOrderFiles.length > 0 ? Math.max(...workOrderFiles.map(f => f.id)) + 1 : 1;
      setWorkOrderFiles([...workOrderFiles, { id: newId }]);
    } else if (type === 'drawings') {
      const newId = drawingsFiles.length > 0 ? Math.max(...drawingsFiles.map(f => f.id)) + 1 : 1;
      setDrawingsFiles([...drawingsFiles, { id: newId }]);
    }
  };

  const removeFileInput = (type, id) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      setWorkOrderFiles(workOrderFiles.filter(file => file.id !== id));
    } else if (type === 'drawings') {
      setDrawingsFiles(drawingsFiles.filter(file => file.id !== id));
    }
    setValue(`${type}_file_${id}`, null);
    setValue(`${type}_desc_${id}`, "");
    clearErrors([`${type}_file_${id}`, `${type}_desc_${id}`]);
  };

  const handleDownload = (fileName) => {
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
  };

  return (
    <div>
      <Collapsible title={t("Documents")} openStat={true}>
        <div style={{ padding: "2rem", backgroundColor: "#f8f9fa" }}>
          <Row className="g-4">
            <Col lg={6} md={12}>
              <FileSection
                title={t("Work Order")}
                files={workOrderFiles}
                type="workOrder"
                icon={<BsFileEarmarkPdf className="text-primary" />}
              />
            </Col>

            <Col lg={6} md={12}>
              <FileSection
                title={t("Drawings")}
                files={drawingsFiles}
                type="drawings"
                icon={<BsFileEarmarkPdf className="text-success" />}
              />
            </Col>

            <Col md={6}>
              {viewMode ? (
                <SingleFileSection
                  title={t('Tonnage Booklets')}
                  fileName={watch("tonnageBooklets")?.name}
                  fileSize={watch("tonnageBooklets")?.size}
                  onDownload={handleDownload}
                  icon={<BsFileEarmarkPdf className="text-warning" />}
                />
              ) : (
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-3">
                    <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
                      <BsFileEarmarkPdf className="text-warning me-2" />
                      {t('Tonnage Booklets')}
                    </h5>
                  </Card.Header>
                  <Card.Body className="p-3">
                    <InputFile
                      label={t('Tonnage Booklets')}
                      required={true}
                      name="tonnageBooklets"
                      register={register("tonnageBooklets")}
                      errors={errors}
                      onChange={(e) => {
                        if (e.target.files && e?.target?.files[0]) {
                          const file = e.target.files[0];
                          if (file.size > 10 * 1024 * 1024) {
                            setError("tonnageBooklets", {
                              type: 'manual',
                              message: t('File size should not exceed 10MB')
                            });
                            return;
                          }
                          const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                          const fileName = `Tonnage Booklets${extension}`;
                          file.originalName = fileName;
                          const renamedFile = renameFile(file, fileName);
                          clearErrors("tonnageBooklets");
                          setValue("tonnageBooklets", renamedFile, { shouldValidate: true });
                        }
                      }}
                      watch={watch}
                      accept=".pdf,.jpg,.jpeg,.png"
                      defaultValue={watch("tonnageBooklets")}
                      clearErrors={clearErrors}
                    />
                  </Card.Body>
                </Card>
              )}
            </Col>

            <Col md={6}>
              {viewMode ? (
                <SingleFileSection
                  title={t('Stability Booklets')}
                  fileName={watch("stabilityBooklets")?.name}
                  fileSize={watch("stabilityBooklets")?.size}
                  onDownload={handleDownload}
                  icon={<BsFileEarmarkPdf className="text-info" />}
                />
              ) : (
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-3">
                    <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
                      <BsFileEarmarkPdf className="text-info me-2" />
                      {t('Stability Booklets')}
                    </h5>
                  </Card.Header>
                  <Card.Body className="p-3">
                    <InputFile
                      label={t('Stability Booklets')}
                      required={true}
                      name="stabilityBooklets"
                      register={register("stabilityBooklets")}
                      errors={errors}
                      onChange={(e) => {
                        if (e.target.files && e?.target?.files[0]) {
                          const file = e.target.files[0];
                          if (file.size > 10 * 1024 * 1024) {
                            setError("stabilityBooklets", {
                              type: 'manual',
                              message: t('File size should not exceed 10MB')
                            });
                            return;
                          }
                          const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                          const fileName = `Stability Booklets${extension}`;
                          file.originalName = fileName;
                          const renamedFile = renameFile(file, fileName);
                          clearErrors("stabilityBooklets");
                          setValue("stabilityBooklets", renamedFile, { shouldValidate: true });
                        }
                      }}
                      watch={watch}
                      accept=".pdf,.jpg,.jpeg,.png"
                      defaultValue={watch("stabilityBooklets")}
                      clearErrors={clearErrors}
                    />
                  </Card.Body>
                </Card>
              )}
            </Col>

            <Col md={12}>
              <Card className="shadow-sm border-0">
                <Card.Body className="p-4">
                  <div className="d-flex align-items-start">
                    <input
                      type="checkbox"
                      id="termsAccepted"
                      className="me-3 mt-1"
                      {...register("termsAccepted", { required: t('You must accept the terms and conditions') })}
                      disabled={viewMode}
                        // checked={viewMode ? watch("termsAccepted") : undefined}
                      checked={viewMode ? true : watch("termsAccepted")}
                    />
                    <div>
                      <label
                        htmlFor="termsAccepted"
                        className="mb-0 fw-medium"
                        style={{ color: "#333", cursor: viewMode ? "default" : "pointer", lineHeight: "1.5" }}
                      >
                        {t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.')}
                      </label>
                      {errors.termsAccepted && !viewMode && (
                        <div className="text-danger small mt-2">
                          {errors.termsAccepted.message}
                        </div>
                      )}
                    </div>
                  </div>
                </Card.Body>
              </Card>
            </Col>
          </Row>
        </div>
      </Collapsible>
    </div>
  );
};

export default Documents;
import React, { useState, useEffect, useRef, useCallback } from "react";
import { useForm } from "react-hook-form";
import { Row, Col } from "react-bootstrap";
import InputText from "../../../common/InputText.tsx";
import InputSelect from "../../../common/InputSelect.tsx";
import InputRadio from "../../../common/InputRadio.tsx";
import InputFile from "../../../common/InputFile.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import { renameFile } from "../../../../utils/constants.ts";
import { BsDownload } from "react-icons/bs";

const VesselDetails = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [formData, setFormData] = useState({});

  const defaultValues = {
    ownerName: "",
    ownerAddress: "",
    mobile: "",
    email: "",
    pan: "",
    aadhar: "",
    tradeLicence: "",
    gst: "",
    grt: "",
    workOrderValue: "",
    vesselType: "",
    category: "",
    zone: "",
    supervisionAuthority: "",
    purchaseType: "",
    classificationSociety: "",
    constructedBy: "",
    builder: "",
    builderName: "",
    builderAddress: "",
    builderEmail: "",
    builderMobile: "",
    builderTradeLicence: "",
    builderGST: "",
    builderAuth: "",
    authLetter: "",
    termsAccepted: false,
    tonnageBooklets: null,
    stabilityBooklets: null,
  };

  const internalFormMethods = useForm({
    defaultValues,
    mode: "onTouched",
  });

  const methods = formMethods || internalFormMethods;

  const isCompMount = useRef(true);

  const {
    register,
    watch,
    setValue,
    clearErrors,
    trigger,
    getValues,
    setError,
    formState: { errors },
  } = methods;

  const constructedBy = watch("constructedBy");
  const category = watch("category");

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [changeLanguage]);

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach((key) => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  const handleInputChange = useCallback(
    (name, value) => {
      setValue(name, value, { shouldValidate: true });
      clearErrors(name);
      setFormData((prev) => ({
        ...prev,
        [name]: value,
      }));
    },
    [setValue, clearErrors]
  );

  const handleFileChange = useCallback(
    (name, file) => {
      if (!file) return;

      const validTypes = [
        "application/pdf",
        "image/jpeg",
        "image/png",
        "image/jpg",
      ];
      if (!validTypes.includes(file.type)) {
        setError(name, {
          type: "manual",
          message: t("Only PDF, JPG or PNG files are allowed"),
        });
        setValue(name, null);
        return;
      }

      if (file.size > 10 * 1024 * 1024) {
        setError(name, {
          type: "manual",
          message: t("File size should not exceed 10MB"),
        });
        setValue(name, null);
        return;
      }

      const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
      const fileName = `${name}${extension}`;
      file.originalName = fileName;
      const renamedFile = renameFile(file, fileName);

      clearErrors(name);
      setValue(name, renamedFile, { shouldValidate: true });
      setFormData((prev) => ({
        ...prev,
        [name]: renamedFile,
      }));
    },
    [setValue, clearErrors, setError, t]
  );

  useEffect(() => {
    if (category === "A") {
      setValue("zone", "1", { shouldValidate: true });
      setValue("supervisionAuthority", "classificationSociety", {
        shouldValidate: true,
      });
      clearErrors("zone");
      clearErrors("supervisionAuthority");
    }
  }, [category, setValue, clearErrors]);

  const handleDownload = (fileName) => {
    const link = document.createElement("a");
    link.href = "#";
    link.download = fileName;
    link.click();
  };

  return (
    <form autoComplete="off">
      <Collapsible title={t("Basic Information")} openStat={true}>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Name of Owner")}
              required={true}
              name="ownerName"
              placeholder={t("Please enter Name of Owner")}
              register={register("ownerName", {
                required: t("Name is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Address of Owner")}
              required={true}
              name="ownerAddress"
              placeholder={t("Please enter Address of Owner")}
              register={register("ownerAddress", {
                required: t("Address is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Mobile")}
              required={true}
              name="mobile"
              placeholder={t("Please enter Mobile")}
              register={register("mobile", {
                required: t("Mobile is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Email Id")}
              required={true}
              name="email"
              type="email"
              placeholder={t("Please enter Email Id")}
              register={register("email", { required: t("Email is required") })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("PAN")}
              required={true}
              name="pan"
              placeholder={t("Please enter PAN")}
              register={register("pan", { required: t("PAN is required") })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Aadhar")}
              required={true}
              name="aadhar"
              placeholder={t("Please enter Aadhar")}
              register={register("aadhar", {
                required: t("Aadhar is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Trade Licence")}
              required={true}
              name="tradeLicence"
              placeholder={t("Please enter Trade Licence")}
              register={register("tradeLicence", {
                required: t("Trade Licence is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("GST")}
              required={true}
              name="gst"
              placeholder={t("Please enter GST")}
              register={register("gst", { required: t("GST is required") })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
        </Row>
      </Collapsible>

      <Collapsible title={t("Vessel Details")} openStat={true}>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputSelect
              label={t("Type of Vessel")}
              required={true}
              name="vesselType"
              options={[
                { value: "new", label: t("New Vessel") },
                { value: "old", label: t("Old Vessel") },
              ]}
              register={register("vesselType", {
                required: t("vesselType is required"),
              })}
              errors={errors}
              value={formData.vesselType || watch("vesselType") || ""}
              onChange={(value) =>
                !viewMode && handleInputChange("vesselType", value)
              }
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputSelect
              label={t("Category")}
              required={true}
              name="category"
              options={[
                { value: "A", label: t("Category A") },
                { value: "B", label: t("Category B") },
                { value: "C", label: t("Category C") },
              ]}
              register={register("category", {
                required: t("category is required"),
              })}
              errors={errors}
              value={formData.category || watch("category") || ""}
              onChange={(value) =>
                !viewMode && handleInputChange("category", value)
              }
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputSelect
              label={t("Zone")}
              required={true}
              name="zone"
              options={[
                { value: "1", label: t("Zone 1") },
                { value: "2", label: t("Zone 2") },
                { value: "3", label: t("Zone 3") },
              ]}
              register={register("zone", {
                required: category !== "A" && t("zone is required"),
              })}
              errors={errors}
              value={formData.zone || watch("zone") || ""}
              onChange={(value) =>
                !viewMode && handleInputChange("zone", value)
              }
              disabled={viewMode || category === "A"}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Gross Tonnage (GRT)")}
              required={true}
              name="grt"
              placeholder={t("Please enter GRT")}
              register={register("grt", { required: t("GRT is required") })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Work Order Value")}
              required={true}
              name="workOrderValue"
              placeholder={t("Enter Work Order Value")}
              register={register("workOrderValue", {
                required: t("Work Order Value is required"),
                pattern: {
                  value: /^[0-9]+$/,
                  message: t("Please enter a valid number"),
                },
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>

          <Col md={4}>
            <InputSelect
              label={t("Supervision Authority")}
              required={true}
              name="supervisionAuthority"
              options={[
                { value: "iwt", label: t("IWT") },
                {
                  value: "classificationSociety",
                  label: t("Classification Society"),
                },
              ]}
              register={register("supervisionAuthority", {
                required:
                  category !== "A" && t("Supervision Authority is required"),
              })}
              errors={errors}
              value={
                formData.supervisionAuthority ||
                watch("supervisionAuthority") ||
                ""
              }
              onChange={(value) =>
                !viewMode && handleInputChange("supervisionAuthority", value)
              }
              disabled={viewMode || category === "A"}
            />
          </Col>
          <Col md={4}>
            <InputSelect
              label={t("Purchase Type")}
              required={true}
              name="purchaseType"
              options={[
                { value: "new", label: t("New") },
                { value: "used", label: t("Used") },
              ]}
              register={register("purchaseType", {
                required: t("Purchase Type is required"),
              })}
              errors={errors}
              value={formData.purchaseType || watch("purchaseType") || ""}
              onChange={(value) =>
                !viewMode && handleInputChange("purchaseType", value)
              }
              disabled={viewMode}
            />
          </Col>
          <Col md={5}>
            <InputText
              label={t("Name of the Classification Society")}
              name="classificationSociety"
              placeholder={t("Please enter Name of the Classification Society")}
              register={register("classificationSociety")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={6} style={{ paddingTop: "1rem" }}>
            <InputRadio
              name="constructedBy"
              label={t("Constructed By ?")}
              options={[
                { label: t("Self"), value: "1" },
                { label: t("Builder"), value: "2" },
              ]}
              register={register}
              rules={{ required: t("Please select a Constructor Type") }}
              errors={errors}
              onChange={() => !viewMode && clearErrors("constructedBy")}
              disabled={viewMode}
            />
          </Col>
          {constructedBy === "2" && (
            <Col md={6}>
              <InputSelect
                label={t("Builder")}
                required={true}
                name="builder"
                options={[
                  { value: "builder1", label: t("Builder 1") },
                  { value: "builder2", label: t("Builder 2") },
                ]}
                register={register("builder", {
                  required: t("Builder is required"),
                })}
                errors={errors}
                value={formData.builder || watch("builder") || ""}
                onChange={(value) =>
                  !viewMode && handleInputChange("builder", value)
                }
                disabled={viewMode}
              />
            </Col>
          )}
        </Row>
      </Collapsible>

      {constructedBy === "2" && (
        <Collapsible title={t("Builder Details")} openStat={true}>
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Builder Name")}
                required={true}
                name="builderName"
                placeholder={t("Please enter Builder Name")}
                register={register("builderName", {
                  required: t("Builder Name is required"),
                })}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Builder Address")}
                required={true}
                name="builderAddress"
                placeholder={t("Please enter Builder Address")}
                register={register("builderAddress", {
                  required: t("Builder Address is required"),
                })}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Builder Email Id")}
                required={true}
                name="builderEmail"
                type="email"
                placeholder={t("Please enter Builder Email Id")}
                register={register("builderEmail", {
                  required: t("Builder Email is required"),
                  pattern: {
                    value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                    message: t("Invalid email address"),
                  },
                })}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Mobile")}
                required={true}
                name="builderMobile"
                placeholder={t("Please enter Mobile")}
                register={register("builderMobile", {
                  required: t("Builder Mobile is required"),
                  pattern: {
                    value: /^[0-9]{10}$/,
                    message: t("Invalid mobile number"),
                  },
                })}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Trade Licence")}
                required={true}
                name="builderTradeLicence"
                placeholder={t("Please enter Trade Licence")}
                register={register("builderTradeLicence", {
                  required: t("Builder Trade Licence is required"),
                })}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("GST")}
                required={true}
                name="builderGST"
                placeholder={t("Please enter GST")}
                register={register("builderGST", {
                  required: t("Builder GST is required"),
                })}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputSelect
                label={t("Builder Authorization")}
                required={true}
                name="builderAuth"
                options={[
                  { value: "auth", label: t("Authorized") },
                  { value: "rejected", label: t("Rejected") },
                ]}
                register={register("builderAuth", {
                  required: t("Builder Authorization is required"),
                })}
                errors={errors}
                value={formData.builderAuth || watch("builderAuth") || ""}
                onChange={(value) =>
                  !viewMode && handleInputChange("builderAuth", value)
                }
                disabled={viewMode}
              />
            </Col>
            <Col md={6}>
              {viewMode ? (
                watch("authLetter") && watch("authLetter").name ? (
                  <div className="mb-3">
                    <label className="form-label fw-bold">
                      {t("Authorization Letter")}
                    </label>
                    <div
                      className="mb-2 p-2 border rounded"
                      style={{ backgroundColor: "#f8f9fa" }}
                    >
                      <div className="d-flex justify-content-between align-items-center">
                        <div className="flex-grow-1">
                          <strong className="text-primary small">
                            {watch("authLetter").name}
                          </strong>
                        </div>
                        <button
                          type="button"
                          className="btn btn-outline-primary btn-sm"
                          onClick={() =>
                            handleDownload(watch("authLetter").name)
                          }
                        >
                          <BsDownload size={14} />
                        </button>
                      </div>
                    </div>
                  </div>
                ) : null
              ) : (
                <div className="mb-2">
                  <InputFile
                    label={t("Authorization Letter")}
                    required={true}
                    name="authLetter"
                    register={register("authLetter", {
                      required: t("Authorization Letter is required"),
                    })}
                    errors={errors}
                    onChange={(e) => {
                      if (viewMode) return;
                      if (e.target.files && e?.target?.files[0]) {
                        handleFileChange("authLetter", e.target.files[0]);
                      }
                    }}
                    disabled={viewMode}
                    watch={watch}
                    defaultValue={watch("authLetter")}
                    clearErrors={clearErrors}
                    accept=".pdf,.jpg,.jpeg,.png"
                  />
                </div>
              )}
            </Col>
          </Row>
        </Collapsible>
      )}
    </form>
  );
};

export default VesselDetails;
