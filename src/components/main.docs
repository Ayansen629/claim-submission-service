const fetchReports = async () => {
  setLoading(true);
 
  try {
    const payload = {
      uuid: [],
      applicationNumber: [applicationNumber || ''],
    };

    const searchApiUrl =
      SERVICE_BASE.IWT_REGISTRATION +
      URLS_ENDPOINT.USER_SERVICE.REPORT_SEARCH;
    const response = await postData(searchApiUrl, payload);

    // Fix: Check for status "200" instead of "Document(s) fetched successfully."
    if (
      response?.status === 200 &&
      (response?.data?.responseStatus?.status === "200" ||
       response?.data?.responseStatus?.message === "Operation completed successfully.")
    ) {
      const fetchedReports = response.data.data || [];

      const categorizedReports = {
        materialTest: [],
        radiography: [],
        inspection: [],
        other: [],
      };

      fetchedReports.forEach((report) => {
        // Only process reports that are for reports (not other document types)
        if (["MATERIAL_TEST_REPORT", "RADIOGRAPHY_REPORT", "INSPECTION_REPORT", "OTHER_REPORT"].includes(report.documentType)) {
          const reportData = {
            id: report.id,
            fileName: report.documentName,
            description: report.description || t("No description"),
            remarks: t("Active"),
            fileStoreId: report.fileStoreId,
          };

          switch (report.documentType) {
            case "MATERIAL_TEST_REPORT":
              categorizedReports.materialTest.push(reportData);
              break;
            case "RADIOGRAPHY_REPORT":
              categorizedReports.radiography.push(reportData);
              break;
            case "INSPECTION_REPORT":
              categorizedReports.inspection.push(reportData);
              break;
            case "OTHER_REPORT":
              categorizedReports.other.push(reportData);
              break;
          }
        }
      });

      setReports(categorizedReports);
    } else {
      console.warn("Unexpected API response:", response?.data);
    }
  } catch (err) {
    console.error("Failed to fetch reports:", err);
    toast.error("Failed to fetch reports");
  } finally {
    setLoading(false);
  }
};
