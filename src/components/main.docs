import React, { useState, useEffect, useRef, useCallback, use } from "react";
import { useForm, useFieldArray } from "react-hook-form";
import { Row, Col, Button, Card } from "react-bootstrap";
import InputText from "../../../../common/InputText.tsx";
import InputSelect from "../../../../common/InputSelect.tsx";
import InputFile from "../../../../common/InputFile.tsx";
import Collapsible from "../../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import {
  FaShip,
  FaCog,
  FaBroadcastTower,
  FaLeaf,
  FaUsers,
  FaFileUpload,
  FaPlus,
  FaTrash,
  FaDownload,
  FaTimesCircle,
  FaExchangeAlt,
  FaClipboardList,
} from "react-icons/fa";
import { useMasterData } from "../../../../context/MasterDataContext.js";
import { toast } from "react-toastify";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import { BASE_IP, SERVICE_BASE, URLS_ENDPOINT } from "../../../../../utils/urlsConstants.ts";
import axios from "axios";
import { postData, postFORMdata } from "../../../../../services/http.service.ts";
import NewLoader from "../../../../common/NewLoader.js";
import styles from "../../../vessel-registration/new-vessel/Documents.module.css";
import { BsDownload, BsFileEarmarkPdf, BsPlus, BsTrash } from "react-icons/bs";
import { deleteFile } from "../../../../../utils/deleteFile.js";
import { renameFile } from "../../../../../utils/constants.ts";
import MultiFile from "../../../../common/MultiFile.js";

const ConsentForm = ({
  formMethods,
  viewMode = false,
  editMode = false,
  registrationData,
  intialSurveyData
}) => {
  const { t } = useTranslation();
  const { masterData } = useMasterData();
  const loaderRef = useRef();
  const [formData, setFormData] = useState({});
  const [suggestions, setSuggestions] = useState([]);


  const [localNewsPaperFiles, setLocalNewsPaperFiles] = useState([{ id: 1 }]);

  console.log("registrationData--survey--steps", registrationData);

  const internalFormMethods = useForm({
    mode: "onTouched",
  });

  const methods = formMethods || internalFormMethods;
  const {
    setError,
    register,
    watch,
    setValue,
    clearErrors,
    formState: { errors },
    unregister,
  } = methods;

  const { fields, append, remove } = useFieldArray({
    control: methods.control,
    name: "crewDetails.crewDetails",
  });

  useEffect(() => {
    if (fields.length === 0 && !intialSurveyData?.CrewDetails) {
      append({
        totalDeckCrew: "",
        totalEngineCrew: "",
        crewType: "",
        name: "",
        rank: "",
        cocNo: "",
        validity: "",
        experience: "",
        placeOfIssue: ""
      });
    }
  }, [fields.length, append, intialSurveyData]);

  const handleSelectChange = useCallback(
    (name, value) => {
      console.log("sdas", name, value);
      setValue(name, value, { shouldValidate: true });
      clearErrors(name);
    },
    [setValue, clearErrors]
  );

  // const handleFileChange = async (e, documentType) => {
  //   if (viewMode) return;
  //   const file = e?.target?.files[0];
  //   if (!file) return;

  //   const maxSize = 10 * 1024 * 1024;
  //   if (file.size > maxSize) {
  //     toast.error("File size must be less than or equal to 10 MB.");
  //     e.target.value = null;
  //     return;
  //   }

  //   loaderRef.current?.show();

  //   try {
  //     const formData = new FormData();
  //     formData.append("file", file);

  //     const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
  //     const response = await postFORMdata(uploadUrl, formData);

  //     const fileStoreId = response?.data?.files[0]?.fileStoreId;

  //     if (fileStoreId) {
  //       const getStandardizedFileName = (docType) => {
  //         const fileNames = {
  //           authorizationFile: "Authorization of Authorised Person.pdf",
  //           paymentChallan: "Payment Challan_Acknowledgement.pdf",
  //           builderCertificate: "Builder Certificate.pdf",
  //           lastCertificateCopy: "Copy of last Certificate of Survey.pdf",
  //           registrationCertificateCopy:
  //             "Copy of Certificate of Registration.pdf",
  //           testCertificate: "Test Certificate.pdf",
  //         };
  //         return fileNames[docType] || file.name;
  //       };

  //       const standardizedName = getStandardizedFileName(documentType);

  //       setFileStates((prev) => ({
  //         ...prev,
  //         [documentType]: {
  //           name: standardizedName,
  //           fileStoreId,
  //           originalName: file.name,
  //         },
  //       }));
  //       setValue(`enclosure.${documentType}`, standardizedName || null);
  //       setValue(`enclosure.${documentType}FileStoreId`, fileStoreId || null);
  //       clearErrors(`enclosure.${documentType}`);
  //       toast.success("File uploaded successfully!");
  //     }
  //   } catch (err) {
  //     console.error("File upload failed:", err);
  //     toast.error("File upload failed. Please try again.");
  //     setFileStates((prev) => ({ ...prev, [documentType]: null }));
  //     e.target.value = null;
  //   } finally {
  //     loaderRef.current?.hide();
  //   }
  // };

  const handleFileChange = async (e, documentType) => {
    if (viewMode) return;
    const file = e?.target?.files[0];
    if (!file) return;

    const maxSize = 10 * 1024 * 1024;
    if (file.size > maxSize) {
      toast.error("File size must be less than or equal to 10 MB.");
      e.target.value = null;
      return;
    }

    loaderRef.current?.show();

    try {
      const formData = new FormData();
      formData.append("file", file);

      const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
      const response = await postFORMdata(uploadUrl, formData);

      const fileStoreId = response?.data?.files[0]?.fileStoreId;

      if (fileStoreId) {
        const fileExtension = file.name.substring(file.name.lastIndexOf("."));

        const getStandardizedFileName = (docType, extension) => {
          const baseNames = {
            authorizationFile: "Authorised Person",
            paymentChallan: "Payment Acknowledgement",
            builderCertificate: "Builder Certificate",
            lastCertificateCopy: "Certificate of Survey",
            registrationCertificateCopy: "Certificate of Registration",
            testCertificate: "Test Certificate",
          };
          return `${baseNames[docType] || docType}${extension}`;
        };

        const standardizedName = getStandardizedFileName(
          documentType,
          fileExtension
        );

        const displayFile = new File([file], standardizedName, {
          type: file.type,
        });

        setFileStates((prev) => ({
          ...prev,
          [documentType]: {
            name: standardizedName,
            fileStoreId,
            originalName: file.name,
            displayFile: displayFile,
          },
        }));

        setValue(`enclosure.${documentType}`, displayFile);
        setValue(`enclosure.${documentType}FileStoreId`, fileStoreId);
        setValue(`enclosure.${documentType}OriginalName`, file.name);
        clearErrors(`enclosure.${documentType}`);
        toast.success("File uploaded successfully!");
      }
    } catch (err) {
      console.error("File upload failed:", err);
      toast.error("File upload failed. Please try again.");
      setFileStates((prev) => ({ ...prev, [documentType]: null }));
      setValue(`enclosure.${documentType}`, null);
      setValue(`enclosure.${documentType}FileStoreId`, null);
      setValue(`enclosure.${documentType}OriginalName`, null);
      e.target.value = null;
    } finally {
      loaderRef.current?.hide();
    }
  };


  const handleFileDownload = async (fileStoreId, fileName, originalName) => {
    try {
      if (!fileStoreId) return;
      const url = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${fileStoreId}`;

      const accessToken = getFromLocalStorage("access_token");
      const tokenDetails = getFromLocalStorage("tokenDetails");
      const sessionState = tokenDetails
        ? JSON.parse(tokenDetails)?.session_state
        : "";

      const response = await axios({
        method: "GET",
        url: url,
        responseType: "blob",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "X-Request-ID": sessionState,
          Accept: "application/octet-stream",
        },
      });

      if (response.data) {
        let filename = fileName || "document";
        const contentDisposition = response.headers["content-disposition"];
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(
            /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
          );
          if (filenameMatch && filenameMatch[1]) {
            filename = filenameMatch[1].replace(/['"]/g, "");
          }
        }

        const blob = new Blob([response.data], {
          type: response.headers["content-type"] || "application/octet-stream",
        });
        const blobUrl = window.URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = blobUrl;
        link.setAttribute("download", filename);
        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          window.URL.revokeObjectURL(blobUrl);
        }, 100);
      }
    } catch (error) {
      console.error("Error downloading file:", error);
      toast.error("Failed to download file. Please try again.");
    }
  };

  const [fileStates, setFileStates] = useState({
    authorizationFile: null,
    paymentChallan: null,
    builderCertificate: null,
    lastCertificateCopy: null,
    registrationCertificateCopy: null,
    testCertificate: null,
  });



  useEffect(() => {
    const enclosureData = watch("enclosure");
    if (enclosureData) {
      const newFileStates = {};

      Object.keys(fileStates).forEach(docType => {
        const fileStoreId = enclosureData[`${docType}FileStoreId`];
        const fileName = enclosureData[`${docType}OriginalName`] || enclosureData[docType]?.name;

        if (fileStoreId && fileName) {
          newFileStates[docType] = {
            name: fileName,
            fileStoreId: fileStoreId,
            originalName: fileName
          };
        }
      });

      if (Object.keys(newFileStates).length > 0) {
        setFileStates(prev => ({ ...prev, ...newFileStates }));
      }
    }
  }, [registrationData]);

  const values = watch();

  const getVesselNameSuggestions = async (value) => {
    if (viewMode) return true;
    console.log("Here in suggestions", value);
    try {
      const vesselName = value.trim();
      if (!vesselName) return;
      const applicationNo = registrationData?.vesselDetails?.applicationNo;
      const regId = registrationData?.vesselDetails?.id;
      if (!applicationNo || !regId) return;

      loaderRef.current?.show();

      const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.VESSEL_SERVICE.VESSELNAME_SEARCH + `?vesselName=${encodeURIComponent(vesselName)}`;

      const response = await postData(apiUrl, {
        vesselRegistrationId: regId,
        applicationNumber: applicationNo,
        vesselName: vesselName
      });

      setSuggestions([]);
      clearErrors("basicInfo.proposedNameOfVessel");
      loaderRef.current?.hide();

      return true;

    } catch (error) {
      const suggestions = error?.response?.data?.data?.suggestions || [];
      setSuggestions(suggestions);
      toast.error(error?.response?.data?.responseStatus?.message || "The Vessel is not available please try with another name");
      setError("basicInfo.proposedNameOfVessel", {
        type: "manual",
        message: t("The Vessel is not available please try with another name"),
      });
      loaderRef.current?.hide();

      return false;
    }
  };

  console.log("proposedNameOfVessel", values?.basicInfo?.proposedNameOfVessel);


  useEffect(() => {
    if (viewMode) return;

    const timer = setTimeout(() => {
      if (values?.basicInfo?.proposedNameOfVessel) {
        console.log("inside efffect", values?.basicInfo?.proposedNameOfVessel);
        getVesselNameSuggestions(values?.basicInfo?.proposedNameOfVessel);
      }
    }, 1000);

    return () => clearTimeout(timer);
  }, [values?.basicInfo?.proposedNameOfVessel, viewMode]);


  useEffect(() => {
    if (!intialSurveyData?.Enclosure) return;

    const newFileStates = {};

    intialSurveyData.Enclosure.forEach(doc => {
      const typeMap = {
        SURVEY_AUTHORIZATION_OF_AUTHORISED_PERSON: "authorizationFile",
        SURVEY_PAYMENT_CHALLAN: "paymentChallan",
        SURVEY_BUILDER_CERTIFICATE: "builderCertificate",
        SURVEY_COPY_OF_LAST_CERTIFICATE_OF_SURVEY: "lastCertificateCopy",
        SURVEY_COPY_OF_CERTIFICATE_OF_REGISTRATION: "registrationCertificateCopy",
        SURVEY_TEST_CERTIFICATE: "testCertificate",
      };

      const key = typeMap[doc.documentType];
      if (key && doc.fileStoreId) {
        newFileStates[key] = {
          name: doc.documentName,
          fileStoreId: doc.fileStoreId,
          originalName: doc.documentName
        };
      }
    });

    setFileStates(prev => ({ ...prev, ...newFileStates }));
  }, [intialSurveyData?.Enclosure]);

  const renderFileField = (docType, label) => {
    if (viewMode) {
      return (
        <>
          <label className="form-label">{t(label)}</label>
          {fileStates[docType] ? (
            <div
              className="d-flex align-items-center p-2 border rounded"
              style={{ backgroundColor: "#f8f9fa" }}
            >
              <span className="me-2">{fileStates[docType].name}</span>
              <button
                type="button"
                className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
                onClick={() =>
                  handleFileDownload(
                    fileStates[docType].fileStoreId,
                    fileStates[docType].name,
                    fileStates[docType].originalName
                  )
                }
                title="Download file"
                style={{ width: "24px", height: "24px", padding: "0" }}
              >
                <FaDownload size={10} />
              </button>
            </div>
          ) : (
            <div
              className="p-2 border rounded text-muted"
              style={{ backgroundColor: "#f8f9fa" }}
            >
              No file uploaded
            </div>
          )}
        </>
      );
    }

    return (
      <>
        <div className="position-relative">
          <InputFile
            name={`enclosure.${docType}`}
            label={t(label)}
            id={docType}
            style={{ width: "100%" }}
            register={register(`enclosure.${docType}`, {
              required: !fileStates[docType] && t(`${label} is required`),
            })}
            errors={errors}
            // required={!fileStates[docType]}
            clearErrors={clearErrors}
            onChange={(e) => handleFileChange(e, docType)}
            watch={watch}
            defaultValue={
              fileStates[docType]?.displayFile || watch(`enclosure.${docType}`)
            }
            key={`${docType}-${fileStates[docType] ? "uploaded" : "empty"}`}
          />

          {fileStates[docType] && (
            <FaTimesCircle
              className="text-danger position-absolute"
              style={{
                top: "50%",
                right: "10px",
                transform: "translateY(-50%)",
                cursor: "pointer",
                zIndex: 10,
              }}
              size={18}
              title="Remove file"
              onClick={() => {
                setFileStates((prev) => ({
                  ...prev,
                  [docType]: null,
                }));
                setValue(`enclosure.${docType}`, null);
                setValue(`enclosure.${docType}FileStoreId`, null);
                setValue(`enclosure.${docType}OriginalName`, null);
                clearErrors(`enclosure.${docType}`);

                const fileInput = document.getElementById(docType);
                if (fileInput) {
                  fileInput.value = "";
                  const event = new Event("change", { bubbles: true });
                  fileInput.dispatchEvent(event);
                }
              }}
            />
          )}
        </div>

        {fileStates[docType] && (
          <div
            className="d-flex align-items-center mt-2"
            style={{ maxWidth: "100%" }}
          >
            <small className="text-success me-2 flex-grow-1 text-truncate">
              ✓ {fileStates[docType].name}
            </small>
            <button
              type="button"
              className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
              onClick={() =>
                handleFileDownload(
                  fileStates[docType].fileStoreId,
                  fileStates[docType].name,
                  fileStates[docType].originalName
                )
              }
              title="Download file"
              style={{ width: "24px", height: "24px", padding: "0" }}
            >
              <FaDownload size={10} />
            </button>
          </div>
        )}
      </>
    );
  };

  useEffect(() => {
    if (!registrationData) return;

    const mapping = {
      // Basic Vessel Info
      "basicVesselInfo.nameOfVessel": registrationData.vessel?.vesselName,
      "basicVesselInfo.grossTonnage": registrationData.vessel?.grt,
      "basicVesselInfo.typeOfVessel": registrationData.vessel?.type,
      "basicVesselInfo.officialNo": registrationData.vessel?.registrationNo,
      "basicVesselInfo.categoryOfVessel": registrationData.vessel?.category,
      "basicVesselInfo.yearOfBuild": registrationData.vessel?.yearOfBuild,
      "basicVesselInfo.nameOfOwner": registrationData.owner?.name,
      "basicVesselInfo.addressOfOwner": registrationData.owner?.address,
      "basicVesselInfo.ownerTelephone": registrationData.owner?.mobile,
      "basicVesselInfo.nameOfBuilder": registrationData.builder?.name,
      "basicVesselInfo.addressOfBuilder": registrationData.builder?.address,

      // Engine / Propulsion
      "detailsOfPropulsion.typeOfEngine": registrationData.engine?.type,
      "detailsOfPropulsion.engineMake": registrationData.engine?.make,
      "detailsOfPropulsion.engineMakerAddress":
        registrationData.engine?.makerAddress,
      "detailsOfPropulsion.yearOfMake": registrationData.engine?.yearOfMake,
      "detailsOfPropulsion.horsepower": registrationData.engine?.horsepower,
      "detailsOfPropulsion.speedRPM": registrationData.engine?.speed,
    };

    const validEntries = Object.entries(mapping).filter(
      ([, value]) => value != null
    );
    validEntries.forEach(([key, value]) => setValue(key, value));
  }, [registrationData, setValue]);
  return (
    <>
      <NewLoader ref={loaderRef} />
      <form autoComplete="off">
        <Collapsible
          title={
            <>
              <FaClipboardList className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Basic Information")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Issued by")}
                name="basicInfo.issuedBy"
                register={register(
                  "basicInfo.issuedBy"
                )}
                errors={errors}
                disabled={false}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Official No. of the Vessel")}
                placeholder={t("Enter Official No. of the Vessel")}
                name="basicInfo.officialNo"
                register={register(
                  "basicInfo.officialNo"
                )}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Name of Vessel")}
                name="basicInfo.nameOfVessel"
                register={register(
                  "basicInfo.nameOfVessel"
                )}
                errors={errors}
                placeholder={t("Enter Name of Vessel")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Proposed Name of the Vessel")}
                name="basicInfo.proposedNameOfVessel"
                register={register(
                  "basicInfo.proposedNameOfVessel"
                )}
                errors={errors}
                placeholder={t("Enter Proposed Name of the Vessel")}
                disabled={false}
                style={{ backgroundColor: "#f8f9fa" }}
              />
              {!viewMode && suggestions.length > 0 && (
                <div
                  className={`${styles.suggestionCard} border rounded mt-1 bg-white w-100`}
                  style={{
                    top: `${errors?.basicInfo?.proposedNameOfVessel ? (errors?.basicInfo?.proposedNameOfVessel?.type === "validate" ? "90%" : "60%") : '60%'}`,
                  }}
                >
                  <div className="px-3 py-2 border-bottom bg-light" style={{ fontWeight: "600", fontSize: "0.875rem", color: "#545D69" }}>
                    {t("Suggestions")}
                  </div>
                  {suggestions.map((suggestion, index) => (
                    <div
                      key={suggestion + index}
                      className={`${styles.suggestionItem} px-3 py-2 suggestion-item`}
                      onClick={() => {
                        setValue("basicInfo.proposedNameOfVessel", suggestion);
                        setSuggestions([]);
                        clearErrors("basicInfo.proposedNameOfVessel");
                      }}
                    >
                      {suggestion}
                    </div>
                  ))}
                </div>
              )}
            </Col>

            <Col md={4}>
              <InputText
                label={t("Port of Registry of Vessel")}
                name="basicInfo.portOfRegistry"
                register={register(
                  "basicInfo.portOfRegistry"
                )}
                errors={errors}
                placeholder={t("Enter Port of Registry of Vessel")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Date of Registry")}
                name="basicInfo.dateOfRegistry"
                register={register(
                  "basicInfo.dateOfRegistry"
                )}
                type="date"
                errors={errors}
                placeholder={t("Enter Date of Registry")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Date of Previous Registry (If any)")}
                name="basicInfo.dateOfPreviousRegistry"
                type="date"
                register={register(
                  "basicInfo.dateOfPreviousRegistry"
                )}
                errors={errors}
                placeholder={t("Enter Date of Previous Registry")}
                disabled={true}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Previous Registry Port (If any)")}
                name="basicInfo.previousRegistryPort"
                register={register(
                  "basicInfo.previousRegistryPort"
                )}
                errors={errors}
                placeholder={t("Enter Previous Registry Port")}
                disabled={true}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Where Built")}
                name="basicInfo.whereBuilt"
                register={register(
                  "basicInfo.whereBuilt"
                )}
                errors={errors}
                placeholder={t("Enter Where Built")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Name of Builder")}
                name="basicInfo.nameOfBuilder"
                register={register(
                  "basicInfo.nameOfBuilder"
                )}
                errors={errors}
                placeholder={t("Enter Name of Builder")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Address of Builder")}
                name="basicInfo.addressOfBuilder"
                register={register(
                  "basicInfo.addressOfBuilder"
                )}
                errors={errors}
                placeholder={t("Enter Address of Builder")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                // required={true}
                label={t("Whether Indian or Foreign Built")}
                name="basicInfo.indianOrForeignBuilt"
                register={register(
                  "basicInfo.indianOrForeignBuilt",
                  // {
                  //   required: t("Whether Indian or Foreign Built is required"),
                  // }
                )}
                errors={errors}
                placeholder={t("Enter Indian or Foreign Built")}
                disabled={true}
                style={{
                  borderColor: errors?.certificateOfRegistration?.basicInfo
                    ?.indianOrForeignBuilt
                    ? "#dc3545"
                    : "",
                }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Whether Self Propelled Propulsion Type")}
                name="basicInfo.propulsionType"
                register={register(
                  "basicInfo.propulsionType"
                )}
                errors={errors}
                placeholder={t("Enter Propulsion Type")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Material")}
                name="basicInfo.material"
                register={register(
                  "basicInfo.material"
                )}
                errors={errors}
                placeholder={t("Enter Material")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Numbers of Decks")}
                name="basicInfo.numberOfDecks"
                register={register(
                  "basicInfo.numberOfDecks"
                )}
                errors={errors}
                placeholder={t("Enter Numbers of Decks")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Number of Bulkheads")}
                name="basicInfo.numberOfBulkheads"
                register={register(
                  "basicInfo.numberOfBulkheads"
                )}
                errors={errors}
                placeholder={t("Enter Number of Bulkheads")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Stern")}
                name="basicInfo.stern"
                register={register("basicInfo.stern")}
                errors={errors}
                placeholder={t("Enter Stern")}
                disabled={true}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Length (Meter)")}
                name="basicInfo.length"
                register={register("basicInfo.length")}
                errors={errors}
                placeholder={t("Enter Length (Meter)")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Breadth (Meter)")}
                name="basicInfo.breadth"
                register={register("basicInfo.breadth")}
                errors={errors}
                placeholder={t("Enter Breadth (Meter)")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Depth (Meter)")}
                name="basicInfo.depth"
                register={register("basicInfo.depth")}
                errors={errors}
                placeholder={t("Enter Depth (Meter)")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Draft (Meter)")}
                name="basicInfo.draft"
                register={register("basicInfo.draft")}
                errors={errors}
                placeholder={t("Enter Draft (Meter)")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Length of Engine Room")}
                name="basicInfo.lengthOfEngineRoom"
                register={register(
                  "basicInfo.lengthOfEngineRoom"
                )}
                errors={errors}
                placeholder={t("Enter Length of Engine Room")}
                disabled={true}
              />
            </Col>
          </Row>
        </Collapsible>

        <Collapsible
          title={
            <>
              <FaClipboardList className="me-2" style={{ color: "#2466BF" }} />
              <span>
                {t(
                  "PARTICULARS OF PROPELLING ENGINES, & MACHINERY as supplied by Builders, Owners, or Engine Makers"
                )}
              </span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("No. of Sets")}
                name="particularsOfEngine.noOfSets"
                register={register(
                  "particularsOfEngine.noOfSets"
                )}
                errors={errors}
                placeholder={t("Enter No. of Sets")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Description")}
                name="particularsOfEngine.description"
                register={register(
                  "particularsOfEngine.description"
                )}
                errors={errors}
                placeholder={t("Enter Description")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Whether Indian or Foreign Built")}
                name="particularsOfEngine.indianOrForeignBuilt"
                register={register(
                  "particularsOfEngine.indianOrForeignBuilt"
                )}
                errors={errors}
                placeholder={t("Enter Indian or Foreign Built")}
                disabled={true}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Year of Make")}
                name="particularsOfEngine.yearOfMake"
                register={register(
                  "particularsOfEngine.yearOfMake"
                )}
                errors={errors}
                placeholder={t("Enter Year of Make")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Made by")}
                name="particularsOfEngine.madeBy"
                register={register(
                  "particularsOfEngine.madeBy"
                )}
                errors={errors}
                placeholder={t("Enter Made by")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Engine Maker Address")}
                name="particularsOfEngine.engineMakerAddress"
                register={register(
                  "particularsOfEngine.engineMakerAddress"
                )}
                errors={errors}
                placeholder={t("Enter Engine Maker Address")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("No. of Cylinders per Set for Reciprocating Engine")}
                name="particularsOfEngine.cylindersPerSetReciprocating"
                register={register(
                  "particularsOfEngine.cylindersPerSetReciprocating"
                )}
                errors={errors}
                placeholder={t("Enter No. of Cylinders per Set (Reciprocating)")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Diameter of Cylinder (MM)")}
                name="particularsOfEngine.diameterOfCylinder"
                register={register(
                  "particularsOfEngine.diameterOfCylinder"
                )}
                errors={errors}
                placeholder={t("Enter Diameter of Cylinder (MM)")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("No. of Cylinders per Set for Rotary Engine")}
                name="particularsOfEngine.cylindersPerSetRotary"
                register={register(
                  "particularsOfEngine.cylindersPerSetRotary"
                )}
                errors={errors}
                placeholder={t("Enter No. of Cylinders per Set (Rotary)")}
                disabled={true}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("B.H.P.")}
                name="particularsOfEngine.bhp"
                register={register(
                  "particularsOfEngine.bhp"
                )}
                errors={errors}
                placeholder={t("Enter B.H.P.")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("No. of Shaft")}
                name="particularsOfEngine.noOfShaft"
                register={register(
                  "particularsOfEngine.noOfShaft"
                )}
                errors={errors}
                placeholder={t("Enter No. of Shaft")}
                disabled={true}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Length of Stroke")}
                name="particularsOfEngine.lengthOfStroke"
                register={register(
                  "particularsOfEngine.lengthOfStroke"
                )}
                errors={errors}
                placeholder={t("Enter Length of Stroke")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Vessel Speed")}
                name="particularsOfEngine.vesselSpeed"
                register={register(
                  "particularsOfEngine.vesselSpeed"
                )}
                errors={errors}
                placeholder={t("Enter Vessel Speed")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("RPM")}
                name="particularsOfEngine.rpm"
                register={register(
                  "particularsOfEngine.rpm"
                )}
                errors={errors}
                placeholder={t("Enter RPM")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Propeller Type")}
                name="particularsOfEngine.propellerType"
                register={register(
                  "particularsOfEngine.propellerType"
                )}
                errors={errors}
                placeholder={t("Enter Propeller Type")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
          </Row>
        </Collapsible>

        <Collapsible
          title={
            <>
              <FaClipboardList className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("PARTICULARS OF BOILERS (IF ANY)")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Description")}
                name="particularsOfBoilers.description"
                register={register(
                  "particularsOfBoilers.description"
                )}
                errors={errors}
                placeholder={t("Enter Description")}
                disabled={true}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Number")}
                name="particularsOfBoilers.number"
                register={register(
                  "particularsOfBoilers.number"
                )}
                errors={errors}
                placeholder={t("Enter Number")}
                disabled={true}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Loaded Pressure")}
                name="particularsOfBoilers.loadedPressure"
                register={register(
                  "particularsOfBoilers.loadedPressure"
                )}
                errors={errors}
                placeholder={t("Enter Loaded Pressure")}
                disabled={true}
              />
            </Col>
          </Row>
        </Collapsible>

        <Collapsible
          title={
            <>
              <FaClipboardList className="me-2 " style={{ color: "#2466BF", postion: 'relative', bottom : '2px' }} />
              <span>{t("PARTICULARS OF TONNAGE")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Gross Tonnage")}
                name="particularsOfTonnage.grossTonnage"
                register={register(
                  "particularsOfTonnage.grossTonnage"
                )}
                errors={errors}
                placeholder={t("Enter Gross Tonnage")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Net Tonnage")}
                name="particularsOfTonnage.netTonnage"
                register={register(
                  "particularsOfTonnage.netTonnage"
                )}
                errors={errors}
                placeholder={t("Enter Net Tonnage")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>

            <Col md={4}>
              <InputText
                label={t("Number of Crew")}
                name="particularsOfTonnage.numberOfCrew"
                register={register(
                  "particularsOfTonnage.numberOfCrew"
                )}
                errors={errors}
                placeholder={t("Enter Number of Crew")}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
          </Row>
        </Collapsible>

        {/* Enclosure */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>{t("ENCLOSURE")}</span>
            </div>
          }
          defaultOpen={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "certificateOfRegistration",
                    t("Certificate of Registration")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "lastSurveyCertificate",
                    t("Last Survey Certificate")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {/* <FileSection
                    title={t("Local News Paper Advertisement")}
                    files={localNewsPaperFiles}
                    type="LOCAL_NEWS_PAPER"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                  /> */}
                  <MultiFile
                    title={t("Local News Paper Advertisement")}
                    files={localNewsPaperFiles}
                    setFiles={setLocalNewsPaperFiles}
                    type="LOCAL_NEWS_PAPER"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                    isRegistrationMode={false}
                  />
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>
      </form>
    </>
  );
};

export default ConsentForm;
