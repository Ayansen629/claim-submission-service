import React from 'react';
import WelcomeBox from '../../common/WelcomeBox';
import { Card, Table, Form, InputGroup, Button } from 'react-bootstrap';
import { BsPersonBadge, BsClipboardData, BsSearch } from 'react-icons/bs';
import { FaUserGraduate } from 'react-icons/fa';
import './employeeDashboard.css';

const StatusCard = ({ title, value, icon: IconComponent, color, bgColor, subtitle }) => (
  <Card className="status-card">
    <div className="status-card-content">
      <div className="icon-wrapper" style={{ backgroundColor: bgColor }}>
        <IconComponent size={24} color={color} />
      </div>
      <div className="value" style={{ color }}>{value}</div>
      <div className="title">{title}</div>
      <div className="subtitle">{subtitle}</div>
    </div>
  </Card>
);

const EmployeeDashboard = () => {
  const statData = [
    { 
      title: 'Registration', 
      value: 12, 
      icon: BsPersonBadge, 
      color: '#1251a6',
      bgColor: 'rgba(18, 81, 166, 0.1)'
    },
    { 
      title: 'Survey', 
      value: 24, 
      icon: BsClipboardData, 
      color: '#28a745',
      bgColor: 'rgba(40, 167, 69, 0.1)'
    },
    { 
      title: 'Manning/Training & Certification', 
      value: 7, 
      icon: FaUserGraduate, 
      color: '#902424',
      bgColor: 'rgba(144, 36, 36, 0.1)'
    },
  ];

  const inboxData = [
    {
      appNo: 'APP-2025-001',
      appType: 'Registration',
      owner: 'John Doe',
      vesselNo: 'WB1423',
      date: '2025-05-22',
      status: 'Pending',
    },
    {
      appNo: 'APP-2025-002',
      appType: 'Survey',
      owner: 'Jane Smith',
      vesselNo: 'WB1424',
      date: '2025-05-20',
      status: 'Completed',
    },
  ];

  return (
    <>
      <WelcomeBox userName="Welcome John" desc="Here's your Dashboard overview." />

      <Card className="bg-transparent mb-4 dashboard-card">
        <Card.Header className="dashboard-card-header">
          My WorkDesk
        </Card.Header>
        <Card.Body>
          <div className="stats-container">
            {statData.map((item, index) => (
              <StatusCard key={`stat-${index}`} {...item} subtitle="Total Application" />
            ))}
            
            <Card className="search-card">
              <div className="search-card-content">
                <h6 className="search-title">Quick Search</h6>
                <p className="search-subtitle">Find applications quickly</p>
                <InputGroup className="search-input-group">
                  <Form.Control
                    type="text"
                    placeholder="Search application..."
                    aria-label="Search application"
                  />
                  <Button variant="primary">
                    <BsSearch />
                  </Button>
                </InputGroup>
              </div>
            </Card>
          </div>
        </Card.Body>
      </Card>

      <Card className="bg-transparent mt-4 dashboard-card">
        <Card.Header className="dashboard-card-header d-flex justify-content-between align-items-center">
          <span>Inbox</span>
          <Form className="inbox-search">
            <InputGroup>
              <Form.Control
                type="text"
                placeholder="Search by application number, type"
                aria-label="Search inbox"
              />
              <Button variant="primary">
                <BsSearch />
              </Button>
            </InputGroup>
          </Form>
        </Card.Header>
        <div className="table-responsive">
          <Table responsive="md" striped bordered hover className="mb-0 dashboard-table">
            <thead>
              <tr>
                <th>Application No</th>
                <th>Application Type</th>
                <th>Vessel Owner</th>
                <th>Vessel No</th>
                <th>Date of Submission</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {inboxData.map((row) => (
                <tr key={row.appNo}>
                  <td>{row.appNo}</td>
                  <td>{row.appType}</td>
                  <td>{row.owner}</td>
                  <td>{row.vesselNo}</td>
                  <td>{row.date}</td>
                  <td>
                    <span className={`status-badge ${row.status.toLowerCase()}`}>
                      {row.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </Table>
        </div>
      </Card>
    </>
  );
};

export default EmployeeDashboard;
