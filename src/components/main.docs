import React, { useState, useEffect, useRef } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaCheckCircle } from "react-icons/fa";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
  defaultValue?: string | File;
  autoFocus?: boolean;
  clearErrors?: (fieldName: string) => void;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  watch,
  defaultValue,
  clearErrors
}) => {
  const hasError = errors && errors[name];
  const fileInputRef = useRef(null);
  const [fileSelected, setFileSelected] = useState(false);
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  const currentFile = watch ? watch(name) : null;

  useEffect(() => {
    if (currentFile && fileSelected) {
      clearErrors(name);
    }
  }, [currentFile, fileSelected, name, clearErrors]);

  const handleFileChange = (e) => {
    if (e.target.files && e.target.files[0]) {
      setFileSelected(true);
      if (onChange) {
        onChange(e);
      }
    }
  };

  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold text-dark mb-2" style={{ fontSize: '0.9rem' }}>
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      <div
        className={`file-upload border rounded p-2 ${hasError ? 'border-danger' : currentFile ? 'border-success' : ''}`}
        style={{
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderRadius: '8px',
          transition: 'all 0.3s ease'
        }}
      >
        <div className="d-flex align-items-center">
          <label
            htmlFor={name}
            className={`file-label btn ${hasError ? 'btn-outline-danger' : 'btn-primary'} mb-0 d-inline-flex align-items-center`}
            style={{
              borderRadius: '6px',
              padding: '6px 12px',
              cursor: disabled ? 'not-allowed' : 'pointer',
              opacity: disabled ? 0.6 : 1,
              minWidth: '100px',
              fontSize: '0.8rem',
              color: hasError ? '#dc3545' : '#fff',
            }}
          >
            <FaUpload className="file-icon me-1" size={12} style={{ color: hasError ? '#dc3545' : '#fff' }} />
            <span className="file-text" style={{ color: hasError ? '#dc3545' : '#fff' }}>Choose File</span>
          </label>
          <div
            className={`file-name-container ms-2 flex-grow-1 border rounded px-2 py-1 ${currentFile ? 'bg-light-success' : 'bg-light'} d-flex align-items-center ${hasError ? 'border-danger' : currentFile ? 'border-success' : ''}`}
            style={{
              overflow: 'hidden',
              minHeight: '32px'
            }}
          >
            {currentFile ? (
              <div className="d-flex align-items-center w-100">
                <FaCheckCircle className="text-success me-2 flex-shrink-0" size={12} />
                <span className="file-icon-preview me-2 flex-shrink-0">
                  {currentFile.name && currentFile.name.endsWith('.pdf') ? (
                    <FaFilePdf color="#dc3545" size={14} />
                  ) : (
                    <FaFileImage color="#28a745" size={14} />
                  )}
                </span>
                <span 
                  className="text-dark fw-medium" 
                  style={{ 
                    overflow: 'hidden', 
                    textOverflow: 'ellipsis', 
                    whiteSpace: 'nowrap',
                    fontSize: '0.8rem'
                  }}
                  title={currentFile.name}
                >
                  {currentFile.name}
                </span>
              </div>
            ) : (
              <span className="text-muted" style={{ fontSize: '0.8rem' }}>No file chosen</span>
            )}
          </div>
        </div>
        <input
          ref={fileInputRef}
          type="file"
          id={name}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="d-none"
        />
      </div>
      {hasError ? (
        <Form.Text className="text-danger small mt-1 d-block" style={{ fontSize: '0.75rem' }}>
          {errors[name]?.message}
        </Form.Text>
      ) : (
        <Form.Text className="text-muted small mt-1" style={{ fontSize: '0.75rem' }}>
          {t("Upload PDF, JPG or PNG file (Max size: 10MB)")}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
