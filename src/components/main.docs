<InputFile
  label={t('vesselDetails.Tonnage Booklets')}
  required={isTonnageRequired()}
  name="tonnageBooklets"
  register={register("tonnageBooklets", {
    required: isTonnageRequired() ? t('Tonnage Booklets is required') : false,
    validate: {
      checkRequired: (value) => {
        const isRequired = editMode ? 
          !!(getValues("tonnageBooklets")?.id || (grossTonnage && grossTonnage.trim() !== "")) :
          !!(grossTonnage && grossTonnage.trim() !== "");
        
        if (isRequired && !value) {
          return t('Tonnage Booklets is required');
        }
        return true;
      }
    }
  })}
  errors={errors}
  // ... rest of props
/>

