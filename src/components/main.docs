{generatedCertificates.survey && !registrationData?.basicDetails?.isProvSurveyCertificateGenerated && (
  <Button
    variant="contained"
    onClick={() => handleProvisionModalOpen("survey")}
    data-tooltip-id="survey-cert-tooltip"
    data-tooltip-content="Generate Provisional Certificate of Survey for vessel inspection"
    style={{
      background: "#10b981",
      color: "#fff",
      fontWeight: "600",
      borderRadius: "6px",
      fontSize: "0.75rem",
      padding: "6px 12px",
      height: "32px",
      minWidth: "140px",
      maxWidth: "140px",
      textTransform: "none",
      border: "none",
      boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
      transition: "all 0.2s ease",
      whiteSpace: "nowrap",
      overflow: "hidden",
      textOverflow: "ellipsis",
    }}
  >
    Provisional Survey Cert
  </Button>
)}

{generatedCertificates.registration && !registrationData?.basicDetails?.isProvisionalCertificate && (
  <Button
    variant="contained"
    onClick={() => handleProvisionModalOpen("registration")}
    data-tooltip-id="reg-cert-tooltip"
    data-tooltip-content="Generate Provisional Certificate of Registration for vessel registry"
    style={{
      background: "#10b981",
      color: "#fff",
      fontWeight: "600",
      borderRadius: "6px",
      fontSize: "0.75rem",
      padding: "6px 12px",
      height: "32px",
      minWidth: "140px",
      maxWidth: "140px",
      textTransform: "none",
      border: "none",
      boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
      transition: "all 0.2s ease",
      whiteSpace: "nowrap",
      overflow: "hidden",
      textOverflow: "ellipsis",
    }}
  >
    Provisional Registration Cert
  </Button>
)}
