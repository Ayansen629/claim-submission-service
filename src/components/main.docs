import React, { useRef, useState, useEffect, forwardRef, useImperativeHandle, use } from "react";
import { useNavigate, useParams, useLocation } from "react-router-dom";
import { useForm } from "react-hook-form";
import { Container, Row, Col, Card } from "react-bootstrap";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";
import { FaUser, FaLock, FaDownload } from "react-icons/fa";
import InputFile from "../../../../common/InputFile.jsx";
import InputText from "../../../../common/InputText.tsx";
import InputSelect from "../../../../common/InputSelect.tsx";
import Collapsible from "../../../../common/Collapsible.js";
import { CONSTANT_REGEX, renameFile } from "../../../../../utils/constants.ts";
import { useMasterData } from "../../../../context/MasterDataContext.js";
import NewLoader from "../../../../common/NewLoader.js";
import { getData, postData, postFORMdata } from "../../../../../services/http.service.ts";
import { BASE_IP, SERVICE_BASE, URLS_ENDPOINT } from "../../../../../utils/urlsConstants.ts";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import axios from "axios";
import styles from "./RegistrationApplicationForm.module.css";

const RegistrationApplicationForm = forwardRef(({ registrationData }, ref) => {
  const { t } = useTranslation();
  const { id } = useParams();
  const loaderRef = useRef();
  const { masterData } = useMasterData();
  const [isDataLoaded, setIsDataLoaded] = useState(false);
  const [suggestions, setSuggestions] = useState([]);

  const {
    register,
    formState: { errors },
    setValue,
    watch,
    clearErrors,
    trigger,
    setError,
  } = useForm({
    mode: "onChange",
    defaultValues: {
      ownerName: "", address: "", ownerType: "", builderEmail: "",
      applicantphoneNumber: "", ownerpin: "",
      // ownercity: "",
      ownerdistrict: "",
      ownerstateUt: "", occupation: "", originalPlaceOfBusiness: "",
      nameOfMaster: "", certificateNo: "", nameOfRegistry: "", registrationNo: "",
      vesselName: "", kindOfVessel: "", typeOfVessel: "", categoryOfVessel: "",
      zone: "", mortgage: "", placeOfBuild: "", detailsOfInsurance: "",
      vesselyearOfBuild: "", protectionAndIndemnityClubNo: "", protectionAndIndemnityClubName: "",
      insuranceValidUpto: "", yearOfBuild: "", typeOfEngine: "", engineMake: "",
      engineMakerAddress: "", enginepin: "", enginephoneNumber: "", engineemail: "",
      horsepower: "", speed: "", yearOfMake: "", builderName: "", builderAddress: "",
      builderemail: "", builderphoneNumber: "", pin: "",
      // city: "", 
      district: "",
      stateUt: "", country: "India",
    },
  });

  useImperativeHandle(ref, () => ({
    validateForm: async () => {
      const isValid = await trigger();
      if (!isValid) {
        const firstErrorField = Object.keys(errors)[0];
        if (firstErrorField) {
          const element = document.querySelector(`[name="${firstErrorField}"]`);
          if (element) {
            element.scrollIntoView({ behavior: 'smooth', block: 'center' });
            element.focus();
          }
        }
      }
      return isValid;
    },
    getFormData: () => watch(),
  }));


  const [fileStates, setFileStates] = useState({
    thirdPartyInsurance: null,
    builderCertificate: null,
    instrumentOfSale: null,
    mortgageDetails: null,
    pniInsurance: null,
    declarationOfOwnership: null,
    challan: null,
  });

  const hasValue = (value) => {
    return value !== null && value !== undefined && value !== "" && value !== "N/A";
  };

  const isOwnerFieldDisabled = (fieldName) => {
    if (!isDataLoaded || !registrationData?.basicDetails?.ownerDetails) return false;
    const owner = registrationData.basicDetails.ownerDetails;

    switch (fieldName) {
      case 'ownerName':
        return hasValue(owner.ownerCompanyName);
      case 'address':
        return hasValue(owner.addressLine1);
      case 'ownerType':
        return hasValue(owner.categoryOfOwner);
      case 'builderEmail':
        return hasValue(owner.emailId);
      case 'applicantphoneNumber':
        return hasValue(owner.phoneNumber);
      case 'ownerpin':
        return hasValue(owner.pin);
      // case 'ownercity':
      //   return hasValue(owner.city);
      case 'ownerdistrict':
        return hasValue(owner.district);
      case 'ownerstateUt':
        return hasValue(owner.state);
      case 'occupation':
        return false;
      case 'originalPlaceOfBusiness':
        return false;
      default:
        return false;
    }
  };
  const vesselKindOptions = masterData?.kindOfVessels?.map(type => ({
    value: type.valueCode,
    label: type.valueLabel
  })) || [];
  const vesselTypeOptions = masterData?.vesselTypes?.map(type => ({
    value: type.valueCode,
    label: type.valueLabel
  })) || [];

  const categoryOptions = masterData?.vesselCategories?.map(category => ({
    value: category.valueCode,
    label: category.valueLabel
  })) || [];

  const zoneOptions = masterData?.zones?.map(zone => ({
    value: zone.valueCode,
    label: zone.valueLabel
  })) || [];

  const isBuilderFieldDisabled = (fieldName) => {
    if (!isDataLoaded || !registrationData?.basicDetails?.builderDetails) return false;
    const builder = registrationData.basicDetails.builderDetails;

    switch (fieldName) {
      case 'builderName':
        return hasValue(builder.builderName);
      case 'builderAddress':
        return hasValue(builder.addressLine1);
      case 'builderemail':
        return hasValue(builder.emailId);
      case 'builderphoneNumber':
        return hasValue(builder.phone);
      case 'pin':
        return hasValue(builder.pin);
      // case 'city':
      //   return hasValue(builder.city);
      case 'district':
        return hasValue(builder.district);
      case 'stateUt':
        return hasValue(builder.state);
      default:
        return false;
    }
  };

  const hasOwnerData = isDataLoaded && registrationData?.basicDetails?.ownerDetails &&
    Object.values(registrationData.basicDetails.ownerDetails).some(value => hasValue(value));

  const hasBuilderData = isDataLoaded && registrationData?.basicDetails?.builderDetails &&
    Object.values(registrationData.basicDetails.builderDetails).some(value => hasValue(value));

  const getFileDisplayName = (documentType) => {
    const fileState = fileStates[documentType];
    return fileState?.name || "";
  };


  useEffect(() => {
    if (registrationData && !isDataLoaded) {
      const { basicDetails, vesselDetails, engineDetails, enclosers } = registrationData;

      // Basic Details
      if (basicDetails?.ownerDetails) {
        const owner = basicDetails.ownerDetails;
        setValue("ownerName", owner.ownerCompanyName || "");
        setValue("address", owner.addressLine1 || "");
        setValue("ownerType", owner.categoryOfOwner || "");
        setValue("builderEmail", owner.emailId || "");
        setValue("applicantphoneNumber", owner.phoneNumber || "");
        setValue("ownerpin", owner.pin?.toString() || "");
        // setValue("ownercity", owner.city || "N/A");
        setValue("ownerdistrict", owner.district || "");
        setValue("ownerstateUt", owner.state || "");
        setValue("occupation", basicDetails.occupation || "");
        setValue("originalPlaceOfBusiness", basicDetails.originalPlaceBusiness || "");
      }

      // Vessel Details 
      if (vesselDetails) {
        setValue("nameOfMaster", vesselDetails.nameOfMaster || "");
        setValue("certificateNo", vesselDetails.certficateNumber || "");
        setValue("nameOfRegistry", vesselDetails.nameOfRegistry || "");
        setValue("registrationNo", vesselDetails.registrationNumber || "");
        setValue("vesselName", vesselDetails.vesselName || "");
        setValue("kindOfVessel", vesselDetails.kindOfVessel || "");
        setValue("mortgage", vesselDetails.mortgage || "");
        setValue("placeOfBuild", vesselDetails.placeOfBuild || "");
        setValue("detailsOfInsurance", vesselDetails.insuranceDetails || "");
        setValue("vesselyearOfBuild", vesselDetails.yearOfBuild?.toString() || "");
        setValue("protectionAndIndemnityClubNo", vesselDetails.pniClubNo || "");
        setValue("protectionAndIndemnityClubName", vesselDetails.pniClubName || "");
        setValue("insuranceValidUpto", vesselDetails.insuranceValidDate || "");
      }

      // Engine Details
      if (engineDetails) {
        setValue("yearOfBuild", engineDetails.yearOfBuild || "");
        setValue("typeOfEngine", engineDetails.engineType || "");
        setValue("engineMake", engineDetails.engineMake || "");
        setValue("engineMakerAddress", engineDetails.makerAddress || "");
        setValue("enginepin", engineDetails.pin || "");
        setValue("enginephoneNumber", engineDetails.mobile || "");
        setValue("engineemail", engineDetails.email || "");
        setValue("horsepower", engineDetails.horsepower?.toString() || "");
        setValue("speed", engineDetails.speed?.toString() || "");
        setValue("yearOfMake", engineDetails.yearOfMake || "");
      }

      // Builder Details
      if (basicDetails?.builderDetails) {
        const builder = basicDetails.builderDetails;
        setValue("builderName", builder.builderName || "");
        setValue("builderAddress", builder.addressLine1 || "");
        setValue("builderemail", builder.emailId || "");
        setValue("builderphoneNumber", builder.phone || "");
        setValue("pin", builder.pin?.toString() || "");
        // setValue("city", builder.city || "N/A");
        setValue("district", builder.district || "");
        setValue("stateUt", builder.state || "");
      }


      if (enclosers && Array.isArray(enclosers)) {
        const fileMapping = {
          "THIRD_PARTY_INSURANCE": "thirdPartyInsurance",
          "BUILDERS_CERTIFICATE": "builderCertificate",
          "INSTRUMENT_OF_SALE": "instrumentOfSale",
          "MORTGAGE_DETAILS": "mortgageDetails",
          "PREOTECTION_AND_INDEMNITY_INSURANCE_NO": "pniInsurance",
          "DECLARATION_OF_OWNERSHIP": "declarationOfOwnership",
          "CHALLAN": "challan"
        };

        enclosers.forEach(encloser => {
          const fieldName = fileMapping[encloser.documentType];
          if (fieldName && encloser.fileStoreId) {
            setFileStates(prev => ({
              ...prev,
              [fieldName]: {
                name: encloser.documentName,
                fileStoreId: encloser.fileStoreId
              }
            }));
            setValue(`${fieldName}FileStoreId`, encloser.fileStoreId);
          }
        });
      }

      setIsDataLoaded(true);
    }
  }, [registrationData, setValue, isDataLoaded]);


  useEffect(() => {
    if (registrationData?.vesselDetails && masterData && isDataLoaded) {
      const vesselDetails = registrationData.vesselDetails;

      const findValueCode = (apiValue, masterArray) => {
        if (!apiValue || !masterArray) return "";
        const found = masterArray.find(item =>
          item.valueLabel === apiValue || item.valueCode === apiValue
        );
        return found?.valueCode || "";
      };

      setValue("typeOfVessel", findValueCode(vesselDetails.typeOfVessel, masterData.vesselTypes));
      setValue("categoryOfVessel", findValueCode(vesselDetails.categoryOfVessel, masterData.vesselCategories));
      setValue("zone", findValueCode(vesselDetails.zone, masterData.zones));
      setValue("kindOfVessel", findValueCode(vesselDetails.kindOfVessel, masterData.kindOfVessels));
    }
  }, [masterData, registrationData, isDataLoaded, setValue]);

  const fetchAddressDetails = async (pin, prefix = "") => {
    try {
      loaderRef.current?.show();
      const URL = process.env.REACT_APP_PUBLIC_URL + URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE + pin;
      const response = await getData(URL);

      if (response?.status === 200 && response?.data?.length > 0) {
        const data = response.data[0];
        if (prefix) {
          // setValue(`${prefix}city`, data.district);
          setValue(`${prefix}district`, data.district);
          setValue(`${prefix}stateUt`, data.stateName);
          // clearErrors(`${prefix}city`);
          clearErrors(`${prefix}district`);
          clearErrors(`${prefix}stateUt`);
        } else {
          // setValue("city", data.district);
          setValue("district", data.district);
          setValue("stateUt", data.stateName);
          // clearErrors("city");
          clearErrors("district");
          clearErrors("stateUt");
        }
        setValue("country", "India");
      } else {
        toast.info("No data found for this PIN code");
      }
    } catch (error) {
      toast.error("Error fetching address details");
    } finally {
      loaderRef.current?.hide();
    }
  };

  const handleDropdownChange = (name, value) => {
    setValue(name, value, { shouldValidate: true });
    clearErrors(name);
  };

  const handleFileChange = async (e, documentType) => {
    const file = e?.target?.files[0];
    if (!file) return;

    const maxSize = 10 * 1024 * 1024;
    if (file.size > maxSize) {
      toast.error("File size must be less than or equal to 10 MB.");
      e.target.value = null;
      return;
    }

    loaderRef.current?.show();

    try {
      const formData = new FormData();
      formData.append("file", file);

      const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
      const response = await postFORMdata(uploadUrl, formData);

      const fileStoreId = response?.data?.files[0]?.fileStoreId;

      if (fileStoreId) {

        const getStandardizedFileName = (docType) => {
          const fileNames = {
            "thirdPartyInsurance": "Third Party Insurance.pdf",
            "builderCertificate": "Builder's Certificate.pdf",
            "instrumentOfSale": "Instrument of Sale.pdf",
            "mortgageDetails": "Mortgage Details.pdf",
            "pniInsurance": "Protection & Indemnity Insurance.pdf",
            "declarationOfOwnership": "Declaration of Ownership.pdf",
            "challan": "Challan.pdf"
          };
          return fileNames[docType] || file.name;
        };

        const standardizedName = getStandardizedFileName(documentType);

        setFileStates(prev => ({
          ...prev,
          [documentType]: {
            name: standardizedName,
            fileStoreId,
            originalName: file.name
          }
        }));
        setValue(`${documentType}FileStoreId`, fileStoreId);
        toast.success("File uploaded successfully!");
      }
    } catch (err) {
      console.error("File upload failed:", err);
      toast.error("File upload failed. Please try again.");
      setFileStates(prev => ({ ...prev, [documentType]: null }));
      e.target.value = null;
    } finally {
      loaderRef.current?.hide();
    }
  };

  // const handleFileDownload = (fileStoreId, fileName, originalName) => {
  //   if (fileStoreId) {
  //     const downloadUrl = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${fileStoreId}`;
  //     const link = document.createElement('a');
  //     link.href = downloadUrl;
  //     link.download = originalName || fileName; 
  //     link.target = '_blank';
  //     document.body.appendChild(link);
  //     link.click();
  //     document.body.removeChild(link);
  //   }
  // };

  const handleFileDownload = async (fileStoreId, fileName, originalName) => {
    try {
      if (!fileStoreId) return;
      const url = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${fileStoreId}`;

      loaderRef.current?.show();

      const accessToken = getFromLocalStorage("access_token");
      const tokenDetails = getFromLocalStorage("tokenDetails");
      const sessionState = tokenDetails
        ? JSON.parse(tokenDetails)?.session_state
        : "";

      const response = await axios({
        method: "GET",
        url: url,
        responseType: "blob",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "X-Request-ID": sessionState,
          Accept: "application/octet-stream",
        },
      });

      if (response.data) {
        let filename = fileName || "document";
        const contentDisposition = response.headers["content-disposition"];
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(
            /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
          );
          if (filenameMatch && filenameMatch[1]) {
            filename = filenameMatch[1].replace(/['"]/g, "");
          }
        }

        const blob = new Blob([response.data], {
          type: response.headers["content-type"] || "application/octet-stream",
        });
        const blobUrl = window.URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = blobUrl;
        link.setAttribute("download", filename);
        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          window.URL.revokeObjectURL(blobUrl);
        }, 100);
      }
    } catch (error) {
      console.error("Error downloading file:", error);
      toast.error("Failed to download file. Please try again.");
    } finally {
      loaderRef.current?.hide();
    }
  };

  const getVesselNameSuggestions = async (value) => {
    try {
      const vesselName = value.trim();
      if (!vesselName) return;
      const applicationNo = registrationData?.vesselDetails?.applicationNo;
      const regId = registrationData?.vesselDetails?.id;
      if (!applicationNo || !regId) return;

      loaderRef.current?.show();

      const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.VESSEL_SERVICE.VESSELNAME_SEARCH + `?vesselName=${encodeURIComponent(vesselName)}`;

      const response = await postData(apiUrl, {
        vesselRegistrationId: regId,
        applicationNumber: applicationNo,
        vesselName: vesselName
      });

      setSuggestions([]);
      clearErrors("vesselName");
      loaderRef.current?.hide();

      return true;

    } catch (error) {

      const suggestions = error?.response?.data?.data?.suggestions || [];
      setSuggestions(suggestions);
      toast.error(error?.response?.data?.responseStatus?.message || "The Vessel is not available please try with another name");
      setError("vesselName", {
        type: "manual",
        message: t("The Vessel is not available please try with another name"),
      });
      loaderRef.current?.hide();

      return false;
    }
  };

  const checkVesselNameError = () => {
    if (errors?.vesselName) {
      return false;
    }
    return true;
  }

  const values = watch();

  useEffect(() => {
    const timer = setTimeout(() => {
      getVesselNameSuggestions(values.vesselName);
    }, 1000);

    return () => clearTimeout(timer);
  }, [values.vesselName]);
  const shouldShowBuilderDetails = () => {
  return registrationData?.basicDetails?.builderDetails !== null && 
         registrationData?.basicDetails?.builderDetails?.builderName !== null &&
         registrationData?.basicDetails?.constructedBy !== "1";
};

const hasRegistrationNumber = () => {
  return hasValue(registrationData?.vesselDetails?.registrationNumber);
};
const isVesselFieldDisabled = (fieldName) => {
  if (!isDataLoaded || !registrationData?.vesselDetails) return false;
  const vessel = registrationData.vesselDetails;
  
  const hasRegistrationNumber = hasValue(vessel.registrationNumber);
  return !hasRegistrationNumber;
};

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="p-0">
        <Card className="mb-1">
          <Card.Body>
            <form className="employee-form">
              <div className="d-flex align-items-center">
                <h6 style={{ color: "#2466BF" }}>{t("FORM-2")}</h6>
              </div>

              {/* APPLICANT DETAILS */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaUser className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>{t("APPLICANT DETAILS")}</span>
                    {hasOwnerData && (
                      <FaLock className="ms-2" style={{ color: "#6c757d" }} title="Some fields are auto-populated and cannot be edited" />
                    )}
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="ownerName"
                          label={t("Owner Name")}
                          placeholder={t("Enter owner name")}
                          required={true}
                          register={{
                            ...register("ownerName", {
                              required: t("Owner Name is required"),
                              minLength: { value: 3, message: t("Minimum 3 characters required") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isOwnerFieldDisabled('ownerName')}
                          disabled={isOwnerFieldDisabled('ownerName')}
                          style={{
                            backgroundColor: isOwnerFieldDisabled('ownerName') ? '#e9ecef' : '#ffffff',
                            cursor: isOwnerFieldDisabled('ownerName') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="address"
                          label={t("Address")}
                          placeholder={t("Enter address")}
                          required={true}
                          register={{
                            ...register("address", {
                              required: t("Address is required"),
                              minLength: { value: 5, message: t("Minimum 5 characters required") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isOwnerFieldDisabled('address')}
                          disabled={isOwnerFieldDisabled('address')}
                          style={{
                            backgroundColor: isOwnerFieldDisabled('address') ? '#e9ecef' : '#ffffff',
                            cursor: isOwnerFieldDisabled('address') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="ownerType"
                          label={t("Owner Type")}
                          placeholder={t("Enter owner type")}
                          required={true}
                          register={{
                            ...register("ownerType", {
                              required: t("Owner Type is required"),
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isOwnerFieldDisabled('ownerType')}
                          disabled={isOwnerFieldDisabled('ownerType')}
                          style={{
                            backgroundColor: isOwnerFieldDisabled('ownerType') ? '#e9ecef' : '#ffffff',
                            cursor: isOwnerFieldDisabled('ownerType') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="builderEmail"
                          label={t("Email ID")}
                          type="email"
                          placeholder={t("Enter email address")}
                          required={true}
                          register={{
                            ...register("builderEmail", {
                              required: t("Email is required"),
                              pattern: { value: CONSTANT_REGEX.EMAIL, message: t("Invalid email address") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isOwnerFieldDisabled('builderEmail')}
                          disabled={isOwnerFieldDisabled('builderEmail')}
                          style={{
                            backgroundColor: isOwnerFieldDisabled('builderEmail') ? '#e9ecef' : '#ffffff',
                            cursor: isOwnerFieldDisabled('builderEmail') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="applicantphoneNumber"
                          label={t("Phone Number")}
                          placeholder={t("Enter 10-digit phone number")}
                          required={true}
                          maxlength={10}
                          register={{
                            ...register("applicantphoneNumber", {
                              required: t("Phone Number is required"),
                              pattern: { value: CONSTANT_REGEX.MOBILE, message: t("Phone number must be 10 digits") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isOwnerFieldDisabled('applicantphoneNumber')}
                          disabled={isOwnerFieldDisabled('applicantphoneNumber')}
                          style={{
                            backgroundColor: isOwnerFieldDisabled('applicantphoneNumber') ? '#e9ecef' : '#ffffff',
                            cursor: isOwnerFieldDisabled('applicantphoneNumber') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="ownerpin"
                          label={t("PIN")}
                          placeholder={t("Enter 6-digit PIN code")}
                          required={true}
                          register={{
                            ...register("ownerpin", {
                              required: t("PIN Code is required"),
                              pattern: { value: /^[0-9]{6}$/, message: t("PIN must be 6 digits") },
                            }),
                          }}
                          onChange={async (e) => {
                            const pinValue = e.target.value;
                            if (pinValue.length === 6 && !isOwnerFieldDisabled('ownerpin')) {
                              await fetchAddressDetails(pinValue, "owner");
                            }
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isOwnerFieldDisabled('ownerpin')}
                          disabled={isOwnerFieldDisabled('ownerpin')}
                          style={{
                            backgroundColor: isOwnerFieldDisabled('ownerpin') ? '#e9ecef' : '#ffffff',
                            cursor: isOwnerFieldDisabled('ownerpin') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      {/* <Col md={4}>
                        <InputText
                          name="ownercity"
                          label={t("City")}
                          required={true}
                          placeholder={t("Auto-populated")}
                          register={{
                            ...register("ownercity", { required: t("City is required") }),
                          }}
                          errors={errors}
                          readOnly={true}
                          clearErrors={clearErrors}
                          style={{ backgroundColor: '#e9ecef', cursor: 'not-allowed' }}
                        />
                      </Col> */}
                      <Col md={4}>
                        <InputText
                          name="ownerdistrict"
                          label={t("District")}
                          required={true}
                          placeholder={t("Auto-populated")}
                          register={{
                            ...register("ownerdistrict", { required: t("District is required") }),
                          }}
                          errors={errors}
                          readOnly={true}
                          clearErrors={clearErrors}
                          style={{ backgroundColor: '#e9ecef', cursor: 'not-allowed' }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="ownerstateUt"
                          label={t("State/UT")}
                          required={true}
                          placeholder={t("Auto-populated")}
                          register={{
                            ...register("ownerstateUt", { required: t("State/UT is required") }),
                          }}
                          errors={errors}
                          readOnly={true}
                          clearErrors={clearErrors}
                          style={{ backgroundColor: '#e9ecef', cursor: 'not-allowed' }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="occupation"
                          label={t("Occupation")}
                          placeholder={t("Occupation")}
                          register={{ ...register("occupation") }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isOwnerFieldDisabled('occupation')}
                          disabled={isOwnerFieldDisabled('occupation')}
                          style={{
                            backgroundColor: isOwnerFieldDisabled('occupation') ? '#e9ecef' : '#ffffff',
                            cursor: isOwnerFieldDisabled('occupation') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="originalPlaceOfBusiness"
                          label={t("Original Place of Business")}
                          placeholder={t("Original Place of Business")}
                          register={{ ...register("originalPlaceOfBusiness") }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isOwnerFieldDisabled('originalPlaceOfBusiness')}
                          disabled={isOwnerFieldDisabled('originalPlaceOfBusiness')}
                          style={{
                            backgroundColor: isOwnerFieldDisabled('originalPlaceOfBusiness') ? '#e9ecef' : '#ffffff',
                            cursor: isOwnerFieldDisabled('originalPlaceOfBusiness') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* VESSEL DETAILS */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaUser className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>{t("VESSEL DETAILS")}</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="nameOfMaster"
                          label={t("Name of Master")}
                          placeholder={t("Enter name of master")}
                          required={true}
                          register={{
                            ...register("nameOfMaster", { required: t("Name of Master is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="certificateNo"
                          label={t("Certificate No.")}
                          placeholder={t("Enter certificate number")}
                          required={true}
                          register={{
                            ...register("certificateNo", { required: t("Certificate No. is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="nameOfRegistry"
                          label={t("Name of Registry")}
                          placeholder={t("Enter name of registry")}
                          required={true}
                          register={{
                            ...register("nameOfRegistry", { required: t("Name of Registry is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
  <InputText
    name="registrationNo"
    label={t("Registration No.")}
    placeholder={t("Enter registration number")}
    required={hasRegistrationNumber()}
    register={{
      ...register("registrationNo", 
        hasRegistrationNumber() ? { required: t("Registration No. is required") } : {}
      ),
    }}
    errors={errors}
    clearErrors={clearErrors}
    readOnly={isVesselFieldDisabled('registrationNo')}
    disabled={isVesselFieldDisabled('registrationNo')}
    style={{
      backgroundColor: isVesselFieldDisabled('registrationNo') ? '#e9ecef' : '#ffffff',
      cursor: isVesselFieldDisabled('registrationNo') ? 'not-allowed' : 'text'
    }}
  />
</Col>
                      {/* <Col md={4}>
                        <InputText
                          name="registrationNo"
                          label={t("Registration No.")}
                          placeholder={t("Enter registration number")}
                          required={true}
                          register={{
                            ...register("registrationNo", { required: t("Registration No. is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col> */}
                      <Col md={4} className="position-relative">
                        <InputText
                          name="vesselName"
                          label={t("Vessel Name")}
                          placeholder={t("Enter vessel name")}
                          required={true}
                          register={{
                            ...register("vesselName", {
                              required: t("Vessel Name is required"),
                              validate: async (value) => {
                                const isValid = checkVesselNameError();
                                if (!isValid) {
                                  return t("The Vessel is not available please try with another name");
                                }
                              },
                            }),
                            // onBlur: (e) => getVesselNameSuggestions(e.target.value),
                            // onChange: (e) => {
                            //   const value = e.target.value;
                            //   setValue("vesselName", value);
                            //   if (value) {
                            //     getVesselNameSuggestions(value);
                            //   } else {
                            //     setSuggestions([]);
                            //   }
                            // }
                          }}

                          errors={errors}
                          clearErrors={clearErrors}
                        />
                        {suggestions.length > 0 && (
                          <div
                            className={`${styles.suggestionCard} border rounded mt-1 bg-white w-100`}
                            style={{
                              top: `${errors?.vesselName ? (errors?.vesselName?.type === "validate" ? "90%" : "60%") : '60%'}`,
                            }}
                          >
                            <div className="px-3 py-2 border-bottom bg-light" style={{ fontWeight: "600", fontSize: "0.875rem", color: "#545D69" }}>
                              {t("Suggestions")}
                            </div>
                            {suggestions.map((suggestion, index) => (
                              <div
                                key={suggestion + index}
                                className={`${styles.suggestionItem} px-3 py-2 suggestion-item`}
                                onClick={() => {
                                  setValue("vesselName", suggestion);
                                  setSuggestions([]);
                                  clearErrors("vesselName");
                                }}
                              >
                                {suggestion}
                              </div>
                            ))}
                          </div>
                        )}
                      </Col>

                      <Col md={4}>
                        <InputSelect
                          name="kindOfVessel"
                          label={t("Kind of Vessel")}
                          required={true}
                          placeholder={t("Select kind of vessel")}
                          options={vesselKindOptions}
                          register={register("kindOfVessel", { required: t("Kind of Vessel is required") })}
                          errors={errors}
                          value={watch("kindOfVessel") || ""}
                          onChange={(val) => handleDropdownChange("kindOfVessel", val)}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="typeOfVessel"
                          label={t("Type of Vessel")}
                          required={true}
                          placeholder={t("Select type of vessel")}
                          options={vesselTypeOptions}
                          register={register("typeOfVessel", { required: t("Type of Vessel is required") })}
                          errors={errors}
                          value={watch("typeOfVessel") || ""}
                          onChange={(val) => handleDropdownChange("typeOfVessel", val)}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="categoryOfVessel"
                          label={t("Category of Vessel")}
                          required={true}
                          placeholder={t("Select category of vessel")}
                          options={categoryOptions}
                          register={register("categoryOfVessel", { required: t("Category of Vessel is required") })}
                          errors={errors}
                          value={watch("categoryOfVessel") || ""}
                          onChange={(val) => handleDropdownChange("categoryOfVessel", val)}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="zone"
                          label={t("Zone")}
                          required={true}
                          placeholder={t("Select zone")}
                          options={zoneOptions}
                          register={register("zone", { required: t("Zone is required") })}
                          errors={errors}
                          value={watch("zone") || ""}
                          onChange={(val) => handleDropdownChange("zone", val)}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="mortgage"
                          label={t("Mortgage")}
                          required={true}
                          placeholder={t("Select Mortgage")}
                          options={[
                            { value: "yes", label: "Yes" },
                            { value: "no", label: "No" },
                          ]}
                          register={register("mortgage", { required: t("Mortgage is required") })}
                          errors={errors}
                          value={watch("mortgage") || ""}
                          onChange={(val) => handleDropdownChange("mortgage", val)}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="placeOfBuild"
                          label={t("Place of Build")}
                          placeholder={t("Enter place of build")}
                          required={true}
                          register={{
                            ...register("placeOfBuild", { required: t("Place of Build is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="detailsOfInsurance"
                          label={t("Details of Insurance")}
                          placeholder={t("Enter details of insurance")}
                          required={true}
                          register={{
                            ...register("detailsOfInsurance", { required: t("Details of Insurance is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="vesselyearOfBuild"
                          label={t("Year of Build")}
                          placeholder={t("Enter year of build")}
                          required={true}
                          register={{
                            ...register("vesselyearOfBuild", {
                              required: t("Year of Build is required"),
                              pattern: { value: /^[0-9]{4}$/, message: t("Enter a valid year (YYYY)") },
                              min: { value: 1900, message: t("Year must be after 1900") },
                              max: { value: new Date().getFullYear(), message: t("Year cannot be in the future") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="protectionAndIndemnityClubNo"
                          label={t("Protection & Indemnity Club No.")}
                          placeholder={t("Enter PNI Club No.")}
                          required={true}
                          register={{
                            ...register("protectionAndIndemnityClubNo", {
                              required: t("PNI Club No. is required"),
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="protectionAndIndemnityClubName"
                          label={t("Protection & Indemnity Club Name")}
                          placeholder={t("Enter PNI Club Name")}
                          required={true}
                          register={{
                            ...register("protectionAndIndemnityClubName", {
                              required: t("PNI Club Name is required"),
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* ENGINE DETAILS */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaUser className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>{t("Engine Details")}</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="insuranceValidUpto"
                          label={t("Insurance Valid Upto")}
                          placeholder={t("Enter insurance valid upto")}
                          required={true}
                          register={{
                            ...register("insuranceValidUpto", { required: t("Insurance Valid Upto is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="yearOfBuild"
                          label={t("Year of Build")}
                          placeholder={t("Enter year of build")}
                          required={true}
                          register={{
                            ...register("yearOfBuild", {
                              required: t("Year of Build is required"),
                              pattern: { value: /^[0-9]{4}$/, message: t("Enter a valid year (YYYY)") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="typeOfEngine"
                          label={t("Type of Engine")}
                          placeholder={t("Enter type of engine")}
                          required={true}
                          register={{
                            ...register("typeOfEngine", { required: t("Type of Engine is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="engineMake"
                          label={t("Engine Make")}
                          placeholder={t("Enter engine make")}
                          required={true}
                          register={{
                            ...register("engineMake", { required: t("Engine Make is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="engineMakerAddress"
                          label={t("Engine Maker Address")}
                          placeholder={t("Enter engine maker address")}
                          required={true}
                          register={{
                            ...register("engineMakerAddress", { required: t("Engine Maker Address is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="enginepin"
                          label={t("PIN")}
                          placeholder={t("Enter 6-digit PIN code")}
                          required={true}
                          register={{
                            ...register("enginepin", {
                              required: t("PIN Code is required"),
                              pattern: { value: /^[0-9]{6}$/, message: t("PIN must be 6 digits") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="enginephoneNumber"
                          label={t("Phone Number")}
                          placeholder={t("Enter 10-digit phone number")}
                          required={true}
                          maxlength={10}
                          register={{
                            ...register("enginephoneNumber", {
                              required: t("Phone Number is required"),
                              pattern: { value: CONSTANT_REGEX.MOBILE, message: t("Phone number must be 10 digits") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="engineemail"
                          label={t("Email ID")}
                          type="email"
                          placeholder={t("Enter email address")}
                          required={true}
                          register={{
                            ...register("engineemail", {
                              required: t("Email is required"),
                              pattern: { value: CONSTANT_REGEX.EMAIL, message: t("Invalid email address") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="horsepower"
                          label={t("Horsepower")}
                          type="number"
                          placeholder={t("Enter horsepower")}
                          required={true}
                          register={{
                            ...register("horsepower", {
                              required: t("Horsepower is required"),
                              min: { value: 1, message: t("Horsepower must be positive") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="speed"
                          label={t("Speed")}
                          placeholder={t("Enter speed")}
                          required={true}
                          register={{
                            ...register("speed", { required: t("Speed is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="yearOfMake"
                          label={t("Year of Make")}
                          placeholder={t("Enter year of make")}
                          required={true}
                          register={{
                            ...register("yearOfMake", {
                              required: t("Year of Make is required"),
                              pattern: { value: /^[0-9]{4}$/, message: t("Enter a valid year (YYYY)") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* BUILDER DETAILS */}
           {
           shouldShowBuilderDetails() && (
  <Collapsible
    title={
      <div className="d-flex align-items-center">
        <FaUser className="me-2" style={{ color: "#2466BF" }} />
        <span style={{ color: "#2466BF" }}>{t("Builder Details")}</span>
        {hasBuilderData && (
          <FaLock className="ms-2" style={{ color: "#6c757d" }} title="Some fields are auto-populated and cannot be edited" />
        )}
      </div>
    }
    defaultOpen={true}
  >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="builderName"
                          label={t("Name of Builder")}
                          placeholder={t("Enter name of builder")}
                          required={true}
                          register={{
                            ...register("builderName", { required: t("Name of Builder is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isBuilderFieldDisabled('builderName')}
                          disabled={isBuilderFieldDisabled('builderName')}
                          style={{
                            backgroundColor: isBuilderFieldDisabled('builderName') ? '#e9ecef' : '#ffffff',
                            cursor: isBuilderFieldDisabled('builderName') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="builderAddress"
                          label={t("Address of Builder")}
                          placeholder={t("Enter address of builder")}
                          required={true}
                          register={{
                            ...register("builderAddress", { required: t("Address of Builder is required") }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isBuilderFieldDisabled('builderAddress')}
                          disabled={isBuilderFieldDisabled('builderAddress')}
                          style={{
                            backgroundColor: isBuilderFieldDisabled('builderAddress') ? '#e9ecef' : '#ffffff',
                            cursor: isBuilderFieldDisabled('builderAddress') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="builderemail"
                          label={t("Email ID")}
                          type="email"
                          placeholder={t("Enter email address")}
                          required={true}
                          register={{
                            ...register("builderemail", {
                              required: t("Email is required"),
                              pattern: { value: CONSTANT_REGEX.EMAIL, message: t("Invalid email address") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isBuilderFieldDisabled('builderemail')}
                          disabled={isBuilderFieldDisabled('builderemail')}
                          style={{
                            backgroundColor: isBuilderFieldDisabled('builderemail') ? '#e9ecef' : '#ffffff',
                            cursor: isBuilderFieldDisabled('builderemail') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="builderphoneNumber"
                          label={t("Phone Number")}
                          placeholder={t("Enter 10-digit phone number")}
                          required={true}
                          maxlength={10}
                          register={{
                            ...register("builderphoneNumber", {
                              required: t("Phone Number is required"),
                              pattern: { value: CONSTANT_REGEX.MOBILE, message: t("Phone number must be 10 digits") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isBuilderFieldDisabled('builderphoneNumber')}
                          disabled={isBuilderFieldDisabled('builderphoneNumber')}
                          style={{
                            backgroundColor: isBuilderFieldDisabled('builderphoneNumber') ? '#e9ecef' : '#ffffff',
                            cursor: isBuilderFieldDisabled('builderphoneNumber') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="pin"
                          label={t("PIN")}
                          placeholder={t("Enter 6-digit PIN code")}
                          required={true}
                          register={{
                            ...register("pin", {
                              required: t("PIN Code is required"),
                              pattern: { value: /^[0-9]{6}$/, message: t("PIN must be 6 digits") },
                            }),
                          }}
                          onChange={(e) => {
                            const pinValue = e.target.value;
                            if (pinValue.length === 6 && !isBuilderFieldDisabled('pin')) {
                              fetchAddressDetails(pinValue);
                            }
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isBuilderFieldDisabled('pin')}
                          disabled={isBuilderFieldDisabled('pin')}
                          style={{
                            backgroundColor: isBuilderFieldDisabled('pin') ? '#e9ecef' : '#ffffff',
                            cursor: isBuilderFieldDisabled('pin') ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      {/* <Col md={4}>
                        <InputText
                          name="city"
                          label={t("City")}
                          required={true}
                          placeholder={t("Auto-populated")}
                          register={{
                            ...register("city", { required: t("City is required") }),
                          }}
                          errors={errors}
                          readOnly={true}
                          clearErrors={clearErrors}
                          style={{ backgroundColor: '#e9ecef', cursor: 'not-allowed' }}
                        />
                      </Col> */}
                      <Col md={4}>
                        <InputText
                          name="district"
                          label={t("District")}
                          required={true}
                          placeholder={t("Auto-populated")}
                          register={{
                            ...register("district", { required: t("District is required") }),
                          }}
                          errors={errors}
                          readOnly={true}
                          clearErrors={clearErrors}
                          style={{ backgroundColor: '#e9ecef', cursor: 'not-allowed' }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="stateUt"
                          label={t("State/UT")}
                          required={true}
                          placeholder={t("Auto-populated")}
                          register={{
                            ...register("stateUt", { required: t("State/UT is required") }),
                          }}
                          errors={errors}
                          readOnly={true}
                          clearErrors={clearErrors}
                          style={{ backgroundColor: '#e9ecef', cursor: 'not-allowed' }}
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>
           )}

              {/* FORM-3 - DECLARATION OF OWNERSHIP */}

              <div className="d-flex align-items-center mb-3 mt-4">
                <h6 style={{ color: "#2466BF" }}>{t("FORM-3")}</h6>
              </div>
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaUser className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>{t("DECLARATION OF OWNERSHIP")}</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={6}>
                        <div className="position-relative">
                          <InputFile
                            name="thirdPartyInsurance"
                            label={t("Third Party Insurance")}
                            id="thirdPartyInsurance"
                            register={register("thirdPartyInsurance", {
                              required: !fileStates.thirdPartyInsurance && t("Third Party Insurance is required"),
                            })}
                            errors={errors}
                            required={!fileStates.thirdPartyInsurance}
                            clearErrors={clearErrors}
                            onChange={(e) => handleFileChange(e, "thirdPartyInsurance")}
                          />
                          {fileStates.thirdPartyInsurance && (
                            <div className="d-flex align-items-center mt-2">
                              <small className="text-success me-2">✓ {fileStates.thirdPartyInsurance.name}</small>
                              <button
                                type="button"
                                className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
                                onClick={() => handleFileDownload(
                                  fileStates.thirdPartyInsurance.fileStoreId,
                                  fileStates.thirdPartyInsurance.name,
                                  fileStates.thirdPartyInsurance.originalName
                                )}
                                title="Download file"
                                style={{ width: '24px', height: '24px', padding: '0' }}
                              >
                                <FaDownload size={10} />
                              </button>
                            </div>
                          )}
                        </div>
                      </Col>
                      <Col md={6}>
                        <div className="position-relative">
                          <InputFile
                            name="builderCertificate"
                            label={t("Builder's Certificate")}
                            id="builderCertificate"
                            register={register("builderCertificate", {
                              required: !fileStates.builderCertificate && t("Builder's Certificate is required"),
                            })}
                            errors={errors}
                            required={!fileStates.builderCertificate}
                            clearErrors={clearErrors}
                            onChange={(e) => handleFileChange(e, "builderCertificate")}
                          />
                          {fileStates.builderCertificate && (
                            <div className="d-flex align-items-center mt-2">
                              <small className="text-success me-2">✓ {fileStates.builderCertificate.name}</small>
                              <button
                                type="button"
                                className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
                                onClick={() => handleFileDownload(
                                  fileStates.builderCertificate.fileStoreId,
                                  fileStates.builderCertificate.name,
                                  fileStates.builderCertificate.originalName
                                )}
                                title="Download file"
                                style={{ width: '24px', height: '24px', padding: '0' }}
                              >
                                <FaDownload size={10} />
                              </button>
                            </div>
                          )}
                        </div>
                      </Col>
                      <Col md={6}>
                        <div className="position-relative">
                          <InputFile
                            name="instrumentOfSale"
                            label={t("Instrument of Sale")}
                            id="instrumentOfSale"
                            register={register("instrumentOfSale", {
                              required: !fileStates.instrumentOfSale && t("Instrument of Sale is required"),
                            })}
                            errors={errors}
                            required={!fileStates.instrumentOfSale}
                            clearErrors={clearErrors}
                            onChange={(e) => handleFileChange(e, "instrumentOfSale")}
                          />
                          {fileStates.instrumentOfSale && (
                            <div className="d-flex align-items-center mt-2">
                              <small className="text-success me-2">✓ {fileStates.instrumentOfSale.name}</small>
                              <button
                                type="button"
                                className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
                                onClick={() => handleFileDownload(
                                  fileStates.instrumentOfSale.fileStoreId,
                                  fileStates.instrumentOfSale.name,
                                  fileStates.instrumentOfSale.originalName
                                )}
                                title="Download file"
                                style={{ width: '24px', height: '24px', padding: '0' }}
                              >
                                <FaDownload size={10} />
                              </button>
                            </div>
                          )}
                        </div>
                      </Col>
                      <Col md={6}>
                        <div className="position-relative">
                          <InputFile
                            name="mortgageDetails"
                            label={t("Mortgage Details")}
                            id="mortgageDetails"
                            register={register("mortgageDetails", {
                              required: !fileStates.mortgageDetails && t("Mortgage Details is required"),
                            })}
                            errors={errors}
                            required={!fileStates.mortgageDetails}
                            clearErrors={clearErrors}
                            onChange={(e) => handleFileChange(e, "mortgageDetails")}
                          />
                          {fileStates.mortgageDetails && (
                            <div className="d-flex align-items-center mt-2">
                              <small className="text-success me-2">✓ {fileStates.mortgageDetails.name}</small>
                              <button
                                type="button"
                                className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
                                onClick={() => handleFileDownload(
                                  fileStates.mortgageDetails.fileStoreId,
                                  fileStates.mortgageDetails.name,
                                  fileStates.mortgageDetails.originalName
                                )}
                                title="Download file"
                                style={{ width: '24px', height: '24px', padding: '0' }}
                              >
                                <FaDownload size={10} />
                              </button>
                            </div>
                          )}
                        </div>
                      </Col>
                      <Col md={6}>
                        <div className="position-relative">
                          <InputFile
                            name="pniInsurance"
                            label={t("Protection & Indemnity Insurance No.")}
                            id="pniInsurance"
                            register={register("pniInsurance", {
                              required: !fileStates.pniInsurance && t("PNI Insurance No. is required"),
                            })}
                            errors={errors}
                            required={!fileStates.pniInsurance}
                            clearErrors={clearErrors}
                            onChange={(e) => handleFileChange(e, "pniInsurance")}
                          />
                          {fileStates.pniInsurance && (
                            <div className="d-flex align-items-center mt-2">
                              <small className="text-success me-2">✓ {fileStates.pniInsurance.name}</small>
                              <button
                                type="button"
                                className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
                                onClick={() => handleFileDownload(
                                  fileStates.pniInsurance.fileStoreId,
                                  fileStates.pniInsurance.name,
                                  fileStates.pniInsurance.originalName
                                )}
                                title="Download file"
                                style={{ width: '24px', height: '24px', padding: '0' }}
                              >
                                <FaDownload size={10} />
                              </button>
                            </div>
                          )}
                        </div>
                      </Col>
                      <Col md={6}>
                        <div className="position-relative">
                          <InputFile
                            name="declarationOfOwnership"
                            label={t("Declaration of Ownership")}
                            id="declarationOfOwnership"
                            register={register("declarationOfOwnership", {
                              required: !fileStates.declarationOfOwnership && t("Declaration of Ownership is required"),
                            })}
                            errors={errors}
                            required={!fileStates.declarationOfOwnership}
                            clearErrors={clearErrors}
                            onChange={(e) => handleFileChange(e, "declarationOfOwnership")}
                          />
                          {fileStates.declarationOfOwnership && (
                            <div className="d-flex align-items-center mt-2">
                              <small className="text-success me-2">✓ {fileStates.declarationOfOwnership.name}</small>
                              <button
                                type="button"
                                className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
                                onClick={() => handleFileDownload(
                                  fileStates.declarationOfOwnership.fileStoreId,
                                  fileStates.declarationOfOwnership.name,
                                  fileStates.declarationOfOwnership.originalName
                                )}
                                title="Download file"
                                style={{ width: '24px', height: '24px', padding: '0' }}
                              >
                                <FaDownload size={10} />
                              </button>
                            </div>
                          )}
                        </div>
                      </Col>
                      <Col md={6}>
                        <div className="position-relative">
                          <InputFile
                            name="challan"
                            label={t("Challan")}
                            id="challan"
                            register={register("challan", {
                              required: !fileStates.challan && t("Challan is required"),
                            })}
                            errors={errors}
                            required={!fileStates.challan}
                            clearErrors={clearErrors}
                            onChange={(e) => handleFileChange(e, "challan")}
                          />
                          {fileStates.challan && (
                            <div className="d-flex align-items-center mt-2">
                              <small className="text-success me-2">✓ {fileStates.challan.name}</small>
                              <button
                                type="button"
                                className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
                                onClick={() => handleFileDownload(
                                  fileStates.challan.fileStoreId,
                                  fileStates.challan.name,
                                  fileStates.challan.originalName
                                )}
                                title="Download file"
                                style={{ width: '24px', height: '24px', padding: '0' }}
                              >
                                <FaDownload size={10} />
                              </button>
                            </div>
                          )}
                        </div>
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

            </form>
          </Card.Body>
        </Card>
      </Container>
    </>
  );
});

export default RegistrationApplicationForm;
