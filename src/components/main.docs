import React, { useState, useEffect } from "react";
import { useForm, FormProvider } from "react-hook-form";
import { Row, Col, Form } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile";
import InputText from "../../../common/InputText.tsx";

const Documents = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  
  const {
    register,
    watch,
    setValue,
    clearErrors,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  const formFields = [
    {
      name: 'workOrderFiles',
      label: t('Work Order'),
      type: 'file',
      required: false,
      colSize: 6
    },
    {
      name: 'drawingsFiles',
      label: t('Drawings'),
      type: 'file',
      required: false,
      colSize: 6
    },
    {
      name: 'tonnageBooklets',
      label: t('Tonnage Booklets'),
      type: 'file',
      required: true,
      colSize: 6,
      validation: { required: t('Tonnage Booklets are required') }
    },
    {
      name: 'stabilityBooklets',
      label: t('Stability Booklets'),
      type: 'file',
      required: true,
      colSize: 6,
      validation: { required: t('Stability Booklets are required') }
    },
    {
      name: 'authLetter',
      label: t('Authorisation Letter'),
      type: 'file',
      required: false,
      colSize: 6,
      showIf: () => constructedBy === "2",
      validation: { required: constructedBy === "2" && t('Authorization Letter is required') }
    },
    {
      name: 'termsAccepted',
      label: t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.'),
      type: 'checkbox',
      required: true,
      colSize: 12,
      validation: { required: t('You must accept the terms and conditions') }
    }
  ];

  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    switch (field.type) {
      case 'file':
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (viewMode) return;
              if (e.target.files && e.target.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
                const customFileName = `${field.label}${extension}`;
                file.originalName = customFileName;
                setValue(field.name, file);

                setFormData(prev => ({
                  ...prev,
                  [field.name]: file
                }));

                if (errors[field.name]) {
                  clearErrors(field.name);
                }

                const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'Only PDF, JPG or PNG files are allowed'
                  });
                } else if (file.size > 2 * 1024 * 1024) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'File size should not exceed 2MB'
                  });
                }
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={formData[field.name]}
            clearErrors={clearErrors}
            setValue={setValue}
          />
        );

      case 'checkbox':
        return (
          <div className="mb-3">
            <div className="d-flex align-items-start">
              <input
                type="checkbox"
                id={field.name}
                className="me-2 mt-1"
                {...register(field.name, field.validation)}
                disabled={viewMode}
              />
              <div>
                <label
                  htmlFor={field.name}
                  className="mb-0"
                  style={{ fontWeight: 500, color: "#333", cursor: "pointer" }}
                >
                  {field.label}
                </label>
                {errors[field.name] && (
                  <div className="text-danger small mt-1" style={{ display: "block" }}>
                    {errors[field.name].message}
                  </div>
                )}
              </div>
            </div>
          </div>
        );

      default:
        return null;
    }
  };

  return (
    <div>
      <Collapsible title={t("Documents")} openStat={true}>
        <Row className="gy-4" style={{ padding: "1rem" }}>
          {formFields.map((field, index) => (
            <Col key={index} md={field.colSize || 12} className="mb-2">
              <DynamicField field={field} />
            </Col>
          ))}
        </Row>
      </Collapsible>
    </div>
  );
};

export default Documents;
