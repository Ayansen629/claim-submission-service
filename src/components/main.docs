import React, { useRef, useState } from "react";
import { Modal, Button } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { BsX } from "react-icons/bs";
import ProvisionalCertificateOfSurvey from "../private/vessel-registration/new-vessel/survey/ProvisionalCertificateOfSurvey";
import ProvisionalCertificateOfRegistration from "../private/vessel-registration/new-vessel/survey/ProvisionalCertificateOfRegistration";

const ProvisionModal = ({
  show,
  onHide = () => {},
  onGenerateCertificate = () => {},
  type,
  preFilledCertData = {},
  registrationData,
}) => {
  const { t } = useTranslation();
  const certificateRef = useRef();
  const [isGenerating, setIsGenerating] = useState(false);

  const handleGenerate = async () => {
    if (certificateRef.current) {
      if (!certificateRef.current.validate()) {
        return;
      }
      
      setIsGenerating(true);
      const formData = certificateRef.current.getFormData();
      
      try {
        await onGenerateCertificate(formData);
        onHide(); // Close modal after successful generation
      } catch (error) {
        console.error("Certificate generation failed:", error);
      } finally {
        setIsGenerating(false);
      }
    }
  };

  return (
    <Modal show={show} onHide={onHide} size="lg" centered backdrop="static">
      <Modal.Header className="border-0 pb-0" style={{background: "linear-gradient(to right, #0c5dcf 10%, #91daff 50%, #0c5dcf 100%)", borderRadius: "0.5rem 0.5rem 0 0"}}>
        <div className="d-flex align-items-center w-100">
          <h5 className="mb-0 fw-bold flex-grow-1" style={{ color: "#001044" }}>
            {type === "survey" ? "PROVISIONAL CERTIFICATE OF SURVEY" : "PROVISIONAL CERTIFICATE OF REGISTRATION"}
          </h5>
          <Button variant="link" onClick={onHide} className="p-2" style={{color: "#ffffff", textDecoration: "none", borderRadius: "50%", transition: "all 0.2s ease"}}>
            <BsX size={24} />
          </Button>
        </div>
      </Modal.Header>

      <Modal.Body className="pt-4">
        {type === "survey" ? (
          <ProvisionalCertificateOfSurvey
            ref={certificateRef}
            registrationData={registrationData}
            preFilledCertData={preFilledCertData}
          />
        ) : (
          <ProvisionalCertificateOfRegistration
            ref={certificateRef}
            registrationData={registrationData}
            preFilledCertData={preFilledCertData}
          />
        )}
      </Modal.Body>

      <Modal.Footer className="border-0 pt-0 pb-4" style={{ background: "#f8f9fa" }}>
        <Button variant="outline-secondary" onClick={onHide} className="me-3 px-4 py-2" disabled={isGenerating}>
          Cancel
        </Button>
        <Button
          onClick={handleGenerate}
          disabled={isGenerating}
          className="px-4 py-2"
          style={{
            background: isGenerating ? "#6c757d" : "linear-gradient(135deg, #2E57A7 0%, #1e3a8a 100%)",
            border: "none",
            borderRadius: "8px",
            fontWeight: "500",
            boxShadow: "0 4px 12px rgba(46, 87, 167, 0.3)",
            transition: "all 0.2s ease",
          }}
        >
          {isGenerating ? "Generating..." : "Generate Certificate"}
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default ProvisionModal;
