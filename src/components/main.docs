<Col md={6}>
  <div className="position-relative">
    <InputText
      label="Address line 1"
      name="addressLine1"
      placeholder="Enter Address Line 1"
      register={register("addressLine1", {
        required: "Address line 1 is required"
      })}
      errors={showValidation ? errors : {}}
      required={true}
      style={{ paddingLeft: '40px' }}
    />
    <FaMapMarkerAlt 
      className="position-absolute" 
      style={{ 
        left: '12px', 
        top: '38px', 
        color: '#1A61C1', 
        fontSize: '16px',
        zIndex: 10
      }} 
    />
  </div>
</Col>

<Col md={6}>
  <div className="position-relative">
    <InputText
      label="Address line 2"
      name="addressLine2"
      placeholder="Enter Address Line 2"
      register={register("addressLine2")}
      errors={showValidation ? errors : {}}
      style={{ paddingLeft: '40px' }}
    />
    <FaMapMarkerAlt 
      className="position-absolute" 
      style={{ 
        left: '12px', 
        top: '38px', 
        color: '#1A61C1', 
        fontSize: '16px',
        zIndex: 10
      }} 
    />
  </div>
</Col>

<Col md={6}>
  <div className="position-relative">
    <InputText
      label="PIN"
      name="pin"
      placeholder="Enter 6-digit Pin code"
      register={register("pin", {
        required: "PIN is required",
        pattern: {
          value: /^[0-9]{6}$/,
          message: "Please enter a valid 6-digit PIN"
        }
      })}
      errors={showValidation ? errors : {}}
      required={true}
      maxLength={6}
      style={{ paddingLeft: '40px' }}
    />
    <FaMapMarkerAlt 
      className="position-absolute" 
      style={{ 
        left: '12px', 
        top: '38px', 
        color: '#1A61C1', 
        fontSize: '16px',
        zIndex: 10
      }} 
    />
  </div>
</Col>

<Col md={6}>
  <div className="position-relative">
    <InputText
      label="District"
      name="district"
      placeholder="Please Enter Your District"
      register={register("district", {
        required: "District is required"
      })}
      errors={showValidation ? errors : {}}
      required={true}
      style={{ paddingLeft: '40px' }}
    />
    <FaMapMarkerAlt 
      className="position-absolute" 
      style={{ 
        left: '12px', 
        top: '38px', 
        color: '#1A61C1', 
        fontSize: '16px',
        zIndex: 10
      }} 
    />
  </div>
</Col>

<Col md={6}>
  <div className="position-relative">
    <InputText
      label="State"
      name="state"
      placeholder="Please Enter Your State"
      register={register("state", {
        required: "State is required"
      })}
      errors={showValidation ? errors : {}}
      required={true}
      style={{ paddingLeft: '40px' }}
    />
    <FaMapMarkerAlt 
      className="position-absolute" 
      style={{ 
        left: '12px', 
        top: '38px', 
        color: '#1A61C1', 
        fontSize: '16px',
        zIndex: 10
      }} 
    />
  </div>
</Col>

<Col md={6}>
  <div className="position-relative">
    <InputText
      label="Country"
      name="country"
      register={register("country")}
      errors={showValidation ? errors : {}}
      disabled={true}
      style={{ paddingLeft: '40px' }}
    />
    <FaMapMarkerAlt 
      className="position-absolute" 
      style={{ 
        left: '12px', 
        top: '38px', 
        color: '#1A61C1', 
        fontSize: '16px',
        zIndex: 10
      }} 
    />
  </div>
</Col>
