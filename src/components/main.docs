.certificateBody {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1.5rem;
  background: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #333;
  line-height: 1.5;
}

.expirySection, .issuedBySection {
  text-align: center;
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 6px;
  border: 1px solid #e9ecef;
  margin-bottom: 1.5rem;
}

.expiryLabel, .issuedLabel {
  font-weight: 500;
  color: #495057;
  font-size: 0.95rem;
}

.editableDate {
  border: 1px solid #ced4da;
  border-radius: 4px;
  padding: 0.5rem;
  font-size: 0.9rem;
  margin-left: 0.5rem;
  width: 140px;
  transition: border-color 0.15s ease-in-out;
}

.editableDate:focus {
  outline: none;
  border-color: #007bff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.sectionTitle {
  color: #495057;
  font-weight: 600;
  font-size: 1.1rem;
  text-align: center;
  margin-bottom: 1.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid #dee2e6;
}

.particularsTable {
  font-size: 0.85rem;
  margin-bottom: 1.5rem;
  border-collapse: collapse;
  width: 100%;
}

.labelCell {
  background: #f8f9fa;
  color: #495057;
  font-weight: 600;
  padding: 0.75rem 0.5rem;
  text-align: left;
  border: 1px solid #dee2e6;
  vertical-align: middle;
  width: 15%;
}

.autoPopulateCell {
  background: #ffffff;
  color: #6c757d;
  font-weight: 500;
  padding: 0.75rem 0.5rem;
  text-align: left;
  border: 1px solid #dee2e6;
  vertical-align: middle;
  width: 15%;
}

.editableCell {
  background: #ffffff;
  padding: 0.5rem;
  text-align: left;
  border: 1px solid #dee2e6;
  vertical-align: middle;
  width: 15%;
  position: relative;
}

.editableInput {
  width: 100%;
  padding: 0.5rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  font-size: 0.85rem;
  transition: border-color 0.15s ease-in-out;
}

.editableInput:focus {
  outline: none;
  border-color: #007bff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.surveyNote {
  background: #fff3cd;
  border: 1px solid #ffeaa7;
  padding: 1rem;
  border-radius: 6px;
  text-align: center;
  margin-bottom: 1.5rem;
}

.noteText {
  margin: 0;
  font-weight: 500;
  color: #856404;
  font-size: 0.9rem;
}

.crewSection {
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 6px;
  border-left: 3px solid #007bff;
  margin-bottom: 1.5rem;
}

.crewInfo {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.crewLabel {
  font-weight: 500;
  color: #495057;
  font-size: 0.9rem;
}

.crewValue {
  font-weight: 600;
  color: #007bff;
  font-size: 1rem;
}

.certificationStatement {
  background: #f8f9fa;
  padding: 1.5rem;
  border-radius: 6px;
  margin-bottom: 1.5rem;
}

.statementText {
  text-align: justify;
  line-height: 1.6;
  margin: 0;
  color: #495057;
  font-size: 0.9rem;
}

.ownerTable {
  font-size: 0.9rem;
  border-collapse: collapse;
  width: 100%;
  margin-bottom: 1.5rem;
}

.ownerHeader, .sharesHeader {
  background: #f8f9fa;
  color: #495057;
  text-align: center;
  font-weight: 600;
  padding: 1rem;
  border: 1px solid #dee2e6;
}

.ownerInfo {
  padding: 1rem;
  line-height: 1.6;
  background: #ffffff;
  border: 1px solid #dee2e6;
}

.ownerInfo div {
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
}

.sharesValue {
  text-align: center;
  font-weight: 500;
  color: #495057;
  vertical-align: middle;
  padding: 1rem;
  background: #ffffff;
  border: 1px solid #dee2e6;
}

.sharesInput {
  width: 100px;
  padding: 0.5rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  text-align: center;
  font-weight: 500;
  font-size: 0.9rem;
  transition: border-color 0.15s ease-in-out;
}

.sharesInput:focus {
  outline: none;
  border-color: #007bff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.asterisk {
  color: #dc3545;
  margin-left: 2px;
  font-weight: bold;
}

.errorField {
  border-color: #dc3545 !important;
  box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
}

.errorMessage {
  color: #dc3545;
  font-size: 0.75rem;
  margin-top: 0.25rem;
  font-weight: 500;
  position: absolute;
  bottom: -18px;
  left: 0;
  width: 100%;
}

.required {
  font-weight: 600;
}

/* Form Controls */
.form-control {
  width: 100%;
  padding: 0.5rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  font-size: 0.9rem;
  transition: border-color 0.15s ease-in-out;
}

.form-control:focus {
  outline: none;
  border-color: #007bff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.form-label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 500;
  color: #495057;
  font-size: 0.9rem;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .certificateBody {
    padding: 1rem;
  }
  
  .particularsTable {
    font-size: 0.8rem;
  }
  
  .labelCell, .autoPopulateCell, .editableCell {
    width: auto;
    min-width: 120px;
  }
}

@media (max-width: 992px) {
  .particularsTable {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
  }
  
  .particularsTable tbody,
  .particularsTable tr,
  .particularsTable td {
    display: block;
    width: 100%;
  }
  
  .particularsTable tr {
    border: 1px solid #dee2e6;
    margin-bottom: 1rem;
    border-radius: 6px;
    overflow: hidden;
  }
  
  .labelCell {
    background: #f8f9fa;
    font-weight: 600;
    padding: 0.5rem;
    border-bottom: 1px solid #dee2e6;
  }
  
  .autoPopulateCell,
  .editableCell {
    padding: 0.5rem;
    border-bottom: none;
  }
  
  .editableCell {
    padding-bottom: 1.5rem;
  }
}

@media (max-width: 768px) {
  .certificateBody {
    padding: 0.75rem;
  }
  
  .expirySection, .issuedBySection {
    padding: 0.75rem;
  }
  
  .editableDate {
    width: 120px;
    margin-left: 0;
    margin-top: 0.5rem;
    display: block;
  }
  
  .crewInfo {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  
  .ownerTable {
    font-size: 0.8rem;
  }
  
  .ownerHeader, .sharesHeader {
    padding: 0.75rem 0.5rem;
  }
  
  .ownerInfo {
    padding: 0.75rem;
  }
  
  .sharesInput {
    width: 80px;
  }
}

@media (max-width: 576px) {
  .certificateBody {
    padding: 0.5rem;
  }
  
  .sectionTitle {
    font-size: 1rem;
  }
  
  .particularsTable {
    font-size: 0.75rem;
  }
  
  .editableInput {
    padding: 0.4rem;
    font-size: 0.8rem;
  }
  
  .form-control {
    padding: 0.4rem;
    font-size: 0.85rem;
  }
  
  .certificationStatement {
    padding: 1rem;
  }
  
  .statementText {
    font-size: 0.85rem;
  }
}
