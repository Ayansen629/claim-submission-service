useEffect(() => {
  if (fields.length === 0 && !intialSurveyData?.CrewDetails) {
    append({
      totalDeckCrew: "",
      totalEngineCrew: "",
      crewType: "",
      name: "",
      rank: "",
      cocNo: "",
      validity: "",
      experience: "",
      placeOfIssue: ""
    });
  }
}, [fields.length, append, intialSurveyData]);
