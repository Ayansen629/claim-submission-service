.heroSection {
  position: relative;
  width: 100%;
  height: 100vh;
  background: url("/src/assets/images/homeBgImage1.jpg") no-repeat center center/cover;
  display: flex;
  justify-content: center;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #0F55B2 0%, rgba(15, 85, 178, 0.66) 37.98%, rgba(255, 255, 255, 0) 100%);
  z-index: 1;
}

.heroContent {
  position: relative;
  z-index: 2;
}

.separator {
  width: 100%;
  height: 2px;
  background-color: white;
}

.brandName {
  font-family: "Aptos", sans-serif;
  font-weight: 400;
  font-style: normal;
  font-size: 22px;
  line-height: 28px;
  letter-spacing: 0;
  color: white;
  margin: 0;
}

.homeLoginBtn {
  position: absolute;
  right: 86px;
  top: 12px;
  border-radius: 4px;
  color: #1A61C1;
}

.homeLoginBtn:hover {
  border-radius: 4px;
  color: white !important;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.43) 0%, rgba(0, 210, 224, 0.43) 47.12%, rgba(0, 163, 224, 0.43) 100%) !important;
}

.topNavBtn {
  border-radius: 6px;
  border: 1px solid white;
  background-color: transparent;
  color: white;
}

.topNavBtn:hover {
  border: 1px solid white;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.43) 0%, rgba(0, 210, 224, 0.43) 47.12%, rgba(0, 163, 224, 0.43) 100%) !important;
}

.section2 {
  position: relative;
  width: 100%;
  background: linear-gradient(180deg, #FFFFFF 0.96%, #00A3E0 100%);
  overflow: hidden;
}

.bgImage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: fill;
  mix-blend-mode: screen;
  z-index: 0;
}

.section2Content {
  position: relative;
  z-index: 1;
}

.navLinkItems {
  color: white !important;
  z-index: 1075;
}

.navLinkItems:hover {
  color: #2466BF !important;
}

.popupCardParent {
  width: 11rem;
  height: 11rem;
  border-radius: 4px;
  box-shadow: 0 4px 5px rgba(0, 0, 0, 0.25);
}

.popupCardInner {
  width: 9rem;
  height: 9rem;
  background-color: inherit;
  border-color: white;
  border-width: 1px;
  border-style: solid;
  border-radius: 4px;
}

.popupCardTitle {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 600;
  font-size: 25px;
  line-height: 1.2;
  letter-spacing: 0;
  color: #fff;
}

.popupCardText {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 130;
  font-size: 10px;
  line-height: 1.2;
  letter-spacing: 0;
  color: #fff;
}

.advertiseCardText {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 100;
  font-size: 1rem;
  line-height: 1.2;
  letter-spacing: 0;
  color: #0070C0;
}

.popup2CardTitle {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 700;
  font-style: Bold;
  font-size: 32px;
  line-height: 1.2;
  letter-spacing: 0;
}

.popup2CardText {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 130;
  font-size: 12px;
  line-height: 1.2;
  letter-spacing: 0;
}

.subText {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 600;
  font-size: 32px;
  line-height: 1.2;
  letter-spacing: 0;
  color: #0070C0;
}

.subTextSpan {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 300;
  font-style: Regular;
  font-size: 24px;
  line-height: 1.2;
  letter-spacing: 0;
  color: #0070C0;
}

.serviceContainer {
  width: 70%
}

.serviceCard {
  width: 16rem;
  border-radius: 5px;
  box-shadow: 0 4px 5px rgba(0, 0, 0, 0.25);
}

.serviceCardTitle {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 700;
  font-style: normal;
  font-size: 1.05rem;
  line-height: 1.4rem;
  letter-spacing: 0;
  color: #203532;
  width: 85%;
}

.serviceCardText {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 400;
  font-size: 0.7rem;
  line-height: 1.1rem;
  letter-spacing: 0;
  text-align: center;
  width: 85%;
}

.serviceCardBtn {
  width: 100%;
  max-width: 85%;
  border-radius: 5px;
  background-color: #00A3E0;
  color: white;
  font-size: 12px;
  line-height: 1.2rem;
  height: 3.2rem;
}

.serviceCardBtnText {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 200;
  color: white;
}

.serviceCardIcon {
  width: 40px;
  height: 40px;
  object-fit: contain;
}

.serviceCardBtnIcon {
  width: 15px;
  height: 15px;
  object-fit: contain;
  margin-bottom: 0.2rem;
}

.article {
  position: relative;
  width: 100%;
  background: linear-gradient(180deg, #FFFFFF 0.96%, #00A3E0 100%);
  overflow: hidden;
}

.articleBgImage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: fill;
  mix-blend-mode: screen;
  z-index: 0;
}

.atricleContent {
  position: relative;
  z-index: 1;
}

.artCard {
  width: 18rem;
  position: "relative";
  border-radius: 4px;
}

.artGlobalCard {
  max-width: 20rem;
  max-height: 32rem;
}

.artMidCard {
  width: 18rem;
  min-width: 14rem;
  max-height: 10rem;
  min-height: 10rem;
  position: relative;
  border-radius: 8px;
  overflow: hidden;
}

.artLeftImg {
  width: 100%;
  height: 100%;
  min-height: 14rem;
  object-fit: cover;
}

.artRightImg {
  width: 100%;
  height: 100%;
  min-height: 13rem;
  object-fit: cover;
}

.artLeftIcon {
  position: absolute;
  top: 0.8rem;
  left: 0.8rem;
  width: 2rem;
  height: 2rem;
}

.artCardContent {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 400;
  font-size: 0.7rem;
  line-height: 1.2;
  letter-spacing: 0;
}

.subIcons {
  width: 0.8rem;
  height: 0.8rem;
}

.artRightIcon {
  width: 2rem;
  height: 2rem;
}

.artMidCard1Div {
  margin-top: 4rem;
  width: 100%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(0, 0, 0, 0.6) 100%);
}

.artMidCard1Content {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 400;
  font-size: 0.7rem;
  line-height: 1.2;
  letter-spacing: 0;
}

.artCenterIcon {
  width: 2rem;
  height: 2rem;
  max-width: 20%;
  height: auto;
}

.footer {
  background-Color: #1B62C0;
  width: 100%;
}

.footerTitle {
  font-family: 'Roboto', sans-serif;
  font-weight: 300;
  font-style: normal;
  font-size: 1.25rem;
  line-height: 1.2;
  letter-spacing: 0;
  color: white;
}

.footerText {
  font-family: 'Roboto', sans-serif;
  font-weight: 300;
  font-style: normal;
  font-size: 0.7rem;
  line-height: 1;
  letter-spacing: 0;
  color: white;
}

.footerSocialIcons {
  width: 1.5rem;
  height: 1.5rem;
  box-shadow: 0 0px 3px rgba(0, 0, 0, 0.25);
}

.hideBar {
  margin-left: 2rem;
  margin-right: 2rem;
}

.subTextDynamic {
  display: inline;
}

.socialContainer {
  width: 70% !important;
}

.customSocialRow {
  gap: 0.3rem;
}

.storeCol {
  gap: 0.25rem;
  margin-left: -1rem;
}

.firstCol {
  margin: 0 !important;
  padding: 0 !important;
}

.googleStoreIcon {
  width: 6rem;
  height: 5rem;
}

.appleStoreIcon {
  width: 4.6rem;
  height: 1.6rem;
}

.customDropdownItem {
  background-color: white !important;
  color: black !important;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.customDropdownItem:hover,
.customDropdownItem:focus {
  background-color: rgb(15, 85, 178) !important;
  color: white !important;
}

:global(.dropdown-menu .dropdown-item.customDropdownItem) {
  background-color: white !important;
  color: black !important;
  transition: background-color 0.3s ease, color 0.3s ease;
}

:global(.dropdown-menu .dropdown-item.customDropdownItem:hover),
:global(.dropdown-menu .dropdown-item.customDropdownItem:focus) {
  background-color: rgb(15, 85, 178) !important;
  color: white !important;
}

.topNavWrapper {
  width: 100%;
  left: -23rem;
  position: absolute;
}

.advertiseLeftCol {
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.advertiseRightCol {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.advLeftColImg {
  max-height: 18rem;
  object-fit: cover;
  opacity: 0.2;
  mix-blend-mode: screen;
  position: absolute;
  left: 0;
  transform: rotate(582deg);
}

.advRightColImg {
  max-height: 24rem;
  object-fit: cover;
  opacity: 0.2;
  mix-blend-mode: screen;
  position: absolute;
  right: 0;
  transform: rotate(-4deg);
}

.advTitle {
  color: rgb(146, 208, 80);
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 700;
  font-style: Bold;
  font-size: 2.5rem;
  line-height: 1.2;
  letter-spacing: 0;
  padding: 1rem;
  margin-top: 1rem;
}

.advText {
  font-family: 'Inter', sans-serif;
  font-weight: 200;
  font-style: normal;
  font-size: 0.7rem;
  line-height: 2.1875rem;
  letter-spacing: 0;
  color: white;
  padding: 2rem;
  padding-right: 4rem;
}

.mapDiv {
  width: 100%
}

.topNavCol {
  padding: 0;
}

.mapImage {
  width: 10rem;
  height: 7rem;
  border-radius: 8px;
}

/* Tablet and Mobile Responsive Styles */
@media (max-width: 540px) {
  .hideBar {
    display: none;
    margin: 0;
  }

  .subTextDynamic {
    display: block;
    margin-top: 0.5rem;
  }

  .artGlobalCard {
    max-width: 15rem;
  }
}

@media (min-width: 540px) and (max-width: 540px) {
  .artGlobalCard {
    margin-left: 2.4rem !important;
  }
}

@media (min-width: 768px) and (max-width: 1186px) {
  .serviceContainer {
    width: 100%;
  }
}

@media (min-width: 768px) and (max-width: 1250px) {
  .socialContainer {
    width: 100% !important;
  }
}

@media (max-width: 770px) {
  .customSocialRow {
    flex-wrap: nowrap;
    overflow-x: auto;
    justify-content: center;
  }

  .storeCol {
    gap: 0rem;
  }

  footer .d-flex.align-items-start {
    align-items: center !important;
    text-align: center !important;
  }

  footer .d-flex.align-items-start p {
    margin-left: 0 !important;
  }

  .firstCol {
    margin-bottom: 1.5rem !important;
  }
}

@media (min-width: 768px) and (max-width: 820px) {
  .googleStoreIcon {
    width: 6rem;
    height: 5rem;
  }

  .appleStoreIcon {
    width: 4.6rem;
    height: 1.6rem;
  }
}

@media (max-width: 992px) {
  .navbarSeparator {
    display: none !important;
  }

  .navItems {
    justify-content: flex-start !important;
    align-items: flex-start !important;
    margin: 0.5rem;
  }
}

@media (min-width: 769px) and (max-width: 992px) {
  .navbarCollapse {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
  }

  .formButtons {
    margin-left: auto !important;
    display: flex !important;
    align-items: center !important;
  }
}

@media (max-width: 715px) {
  .headerRow>div {
    width: 100% !important;
    margin-bottom: 2rem;
  }

  .headerRow>div:last-child {
    margin-bottom: 0;
  }
}

@media (max-width: 768px) {
  .advertiseLeftCol {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .advTitle {
    padding: 2rem;
  }

  .advertiseRightCol {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .mapDiv {
    width: 50%
  }
}

@media (min-width: 768px) and (max-width: 1023px) {
  .mapImage {
    width: 6rem;
    height: 5rem;
    border-radius: 8px;
  }
}

@media (min-width: 768px) and (max-width: 1140px) {
  .mapImage {
    width: 6rem;
    height: 5rem;
    border-radius: 8px;
  }
}

/* Hero Section Responsive Fixes */
@media (max-width: 767px) {
  .heroSection {
    height: 60vh;
    min-height: 500px;
  }

  .brandName {
    font-size: 16px;
    line-height: 20px;
    text-align: center;
  }

  .homeLoginBtn {
    position: static !important;
    right: auto !important;
    top: auto !important;
    margin: 1rem auto 0 !important;
    display: block !important;
    width: fit-content !important;
  }

  .navLinkItems {
    font-size: 12px;
    padding: 0.2rem 0.4rem !important;
  }

  .topNavCol {
    padding: 1rem !important;
    margin-bottom: 2rem !important;
  }
}

@media (max-width: 480px) {
  .heroSection {
    height: 50vh;
    min-height: 450px;
  }

  .brandName {
    font-size: 14px;
    line-height: 18px;
  }

  .navLinkItems {
    font-size: 10px;
    padding: 0.15rem 0.3rem !important;
  }
}

/* Tablet specific fixes */
@media (min-width: 768px) and (max-width: 1024px) {
  .heroSection {
    height: 70vh;
  }
  
  .homeLoginBtn {
    right: 20px !important;
  }

  .topNavCol {
    padding: 1rem !important;
    margin-bottom: 3rem !important;
  }
}

/* Large tablet and small desktop */
@media (min-width: 1025px) and (max-width: 1366px) {
  .heroSection {
    height: 80vh;
  }
}
