import axios from "axios";
import { URLS_ENDPOINT } from "../utils/urlsConstants.ts";

export const uploadDocument = async (file, docType) => {
  console.log("Uploading file:", file, docType);

  const formData = new FormData();
  formData.append("file", file);
  formData.append("fileStoreId", "");

  try {
    const UPLOAD_URL = `${process.env.REACT_APP_FILE_SERVICE}${URLS_ENDPOINT.APP_SERVICES.UPLOAD_FILE}`;

    const response = await axios.post(UPLOAD_URL, formData, {
      headers: {
        "Content-Type": "multipart/form-data",
        Accept: "application/json",
      },
    });

    const files = response?.data?.files;

    if (files && files.length) {
      const uploadedFileData = {
        success: true,
        fileId: files[0].fileStoreId,
        docName: file.name,
        docType: docType,
        docSource: "web_upload",
        fileUrl: "",
        timestamp: new Date().toISOString()
      };

      // Save to localStorage based on docType
      saveToLocalStorage(docType, uploadedFileData);

      return uploadedFileData;
    } else {
      throw new Error("File upload failed: No file in response.");
    }
  } catch (error) {
    console.error("Upload error:", error);
    throw new Error(
      error?.response?.data?.message || "Failed to upload document"
    );
  }
};

// Helper function to save uploaded files to localStorage by docType
const saveToLocalStorage = (docType, fileData) => {
  try {
    // Get existing uploads from localStorage
    const existingUploads = JSON.parse(localStorage.getItem('fileUploads') || '{}');
    
    // Initialize array for this docType if it doesn't exist
    if (!existingUploads[docType]) {
      existingUploads[docType] = [];
    }
    
    // Add the new file data
    existingUploads[docType].push(fileData);
    
    // Save back to localStorage
    localStorage.setItem('fileUploads', JSON.stringify(existingUploads));
    
    console.log(`File saved to localStorage under docType: ${docType}`);
  } catch (error) {
    console.error("Error saving to localStorage:", error);
  }
};

// Helper function to get uploaded files by docType
export const getUploadedFilesByType = (docType) => {
  try {
    const allUploads = JSON.parse(localStorage.getItem('fileUploads') || '{}');
    return allUploads[docType] || [];
  } catch (error) {
    console.error("Error reading from localStorage:", error);
    return [];
  }
};

// Helper function to clear files for a specific docType
export const clearFilesByType = (docType) => {
  try {
    const allUploads = JSON.parse(localStorage.getItem('fileUploads') || '{}');
    delete allUploads[docType];
    localStorage.setItem('fileUploads', JSON.stringify(allUploads));
  } catch (error) {
    console.error("Error clearing files from localStorage:", error);
  }
};
