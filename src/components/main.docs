import React, { useState } from 'react';
import { format, addDays, setHours, setMinutes } from 'date-fns';

const TimeSlotScheduler = ({ onConfirm }) => {
  const [selectedSlot, setSelectedSlot] = useState(null);
  const [activeTab, setActiveTab] = useState(0);

  // Generate time slots with 4 specific 1-hour blocks throughout the day
  const generateTimeSlots = () => {
    const today = new Date();
    const slots = [];
    
    // Create 4 days starting from today
    for (let i = 0; i < 4; i++) {
      const date = addDays(today, i);
      
      // Define our four 1-hour time slots
      const timeSlots = [
        {
          start: setHours(setMinutes(date, 0), 10), // 10:00 AM
          end: setHours(setMinutes(date, 0), 11),    // 11:00 AM
          display: '10:00 AM - 11:00 AM',
          period: 'Morning'
        },
        {
          start: setHours(setMinutes(date, 0), 12), // 12:00 PM
          end: setHours(setMinutes(date, 0), 13),   // 1:00 PM
          display: '12:00 PM - 1:00 PM',
          period: 'Noon'
        },
        {
          start: setHours(setMinutes(date, 0), 15), // 3:00 PM
          end: setHours(setMinutes(date, 0), 16),   // 4:00 PM
          display: '3:00 PM - 4:00 PM',
          period: 'Afternoon'
        },
        {
          start: setHours(setMinutes(date, 0), 16), // 4:00 PM
          end: setHours(setMinutes(date, 0), 17),    // 5:00 PM
          display: '4:00 PM - 5:00 PM',
          period: 'Evening'
        }
      ];
      
      slots.push({
        date,
        displayDate: format(date, 'EEE, MMM d'),
        timeSlots
      });
    }
    
    return slots;
  };

  const timeSlots = generateTimeSlots();

  const handleSlotSelect = (slot) => {
    setSelectedSlot(slot);
  };

  const handleConfirm = () => {
    if (selectedSlot && onConfirm) {
      onConfirm(selectedSlot);
    }
  };

  return (
    <div className="time-slot-scheduler">
      <h2 className="scheduler-title">Select Your Appointment</h2>
      
      <div className="date-tabs">
        {timeSlots.map((day, index) => (
          <button
            key={index}
            className={`tab-button ${activeTab === index ? 'active' : ''}`}
            onClick={() => {
              setActiveTab(index);
              setSelectedSlot(null); // Reset selection when changing days
            }}
          >
            {day.displayDate}
          </button>
        ))}
      </div>
      
      <div className="time-slots-container">
        <h3 className="time-slots-title">Available Time Slots</h3>
        <div className="time-slots-list">
          {timeSlots[activeTab].timeSlots.map((slot, index) => (
            <div key={index} className="time-slot-group">
              <div className="time-period">{slot.period}</div>
              <button
                className={`time-slot ${
                  selectedSlot?.display === slot.display ? 'selected' : ''
                }`}
                onClick={() => handleSlotSelect({
                  date: timeSlots[activeTab].date,
                  ...slot
                })}
              >
                {slot.display}
              </button>
            </div>
          ))}
        </div>
      </div>
      
      <button 
        className="confirm-button"
        onClick={handleConfirm}
        disabled={!selectedSlot}
      >
        Confirm Appointment
      </button>
      
      {selectedSlot && (
        <div className="selected-summary">
          <p>Your appointment is scheduled for:</p>
          <p className="selected-time">
            <strong>{format(selectedSlot.date, 'MMMM d, yyyy')}</strong><br />
            {selectedSlot.display}
          </p>
        </div>
      )}
    </div>
  );
};

export default TimeSlotScheduler;
