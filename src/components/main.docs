const INBOX_COLUMNS = [
  {
    colName: "Application No",
    fieldName: "appNo",
    clsName: "column-text-start",
  },
  {
    colName: "Application Type",
    fieldName: "appType",
    clsName: "column-text-start",
  },
  {
    colName: "Vessel Owner",
    fieldName: "owner",
    clsName: "column-text-start",
  },
  {
    colName: "Vessel No",
    fieldName: "vesselNo",
    clsName: "column-text-start",
  },
  {
    colName: "Date of Submission",
    fieldName: "date",
    clsName: "column-text-start",
  },
  {
    colName: "Status",
    fieldName: "status",
    clsName: "column-text-start",
    render: (value) => (
      <span className={`status-badge ${value.toLowerCase()}`}>{value}</span>
    ),
  },
   {
      colName: "Action",
      fieldName: "action",
      actions: ['view', 
        // 'edit'
      ],
      clsName: "col-sm-2 column-text-start actions-column",
    },
];

const OfficerRoleDashboard = () => {
  const statData = [
    {
      title: "Registration",
      value: 12,
      icon: BsPersonBadge,
      color: "#1251a6",
      bgColor: "rgba(18, 81, 166, 0.1)",
    },
    {
      title: "Survey",
      value: 24,
      icon: MdOutlineAssignment,
      color: "#28a745",
      bgColor: "rgba(40, 167, 69, 0.1)",
    },
    {
      title: "Manning/Training & Certification",
      value: 7,
      icon: FaUserGraduate,
      color: "#902424",
      bgColor: "rgba(144, 36, 36, 0.1)",
    },
    // {
    //   title: "View Application",
    //   value: "",
    //   icon: FaRegEye,
    //   color: "#2466BF",
    //   bgColor: "rgba(36, 102, 191, 0.08)",
    // },
  ];

  const generateInboxData = () => {
    const statuses = ["Pending", "Completed", "Processing", "Rejected"];
    const appTypes = [
      "Registration",
      "Survey",
      "Manning",
      "Certification",
      "Training",
    ];
    const owners = [
      "John Doe",
      "Jane Smith",
      "Robert Johnson",
      "Emily Davis",
      "Michael Wilson",
    ];

    return Array.from({ length: 20 }, (_, i) => ({
      id: i + 1,
      appNo: `APP-2025-${(i + 1).toString().padStart(3, "0")}`,
      appType: appTypes[Math.floor(Math.random() * appTypes.length)],
      owner: owners[Math.floor(Math.random() * owners.length)],
      vesselNo: `WB${1420 + i}`,
      date: new Date(
        2025,
        Math.floor(Math.random() * 12),
        Math.floor(Math.random() * 28) + 1
      )
        .toISOString()
        .split("T")[0],
      status: statuses[Math.floor(Math.random() * statuses.length)],
    }));
  };

  // State for inbox data and pagination
  const [inboxData, setInboxData] = useState([]);
  const [filteredData, setFilteredData] = useState([]);
  const [currentPage, setCurrentPage] = useState(1);
  const [searchTerm, setSearchTerm] = useState("");
  const itemsPerPage = 5;

  // Initialize data
  useEffect(() => {
    const data = generateInboxData();
    setInboxData(data);
    setFilteredData(data);
  }, []);

  // Handle search
  useEffect(() => {
    const results = inboxData.filter(
      (item) =>
        item.appNo.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.appType.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.owner.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.vesselNo.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.status.toLowerCase().includes(searchTerm.toLowerCase())
    );
    setFilteredData(results);
    setCurrentPage(1);
  }, [searchTerm, inboxData]);

  // Pagination handler for ActionTable
  const handleTablePageChange = (page) => {
    setCurrentPage(page);
  };

  const navigate = useNavigate();

  return (
    <>
      <WelcomeBox
        userName="Welcome John"
        desc="Here's your Dashboard overview."
      />

      <Card className="bg-transparent mb-4 dashboard-card">
        <Card.Header className="dashboard-card-header">My WorkDesk

          <div style={{ float: 'right', width: 180 }}>
            <button className="generic-btn-submit" type="button" onClick={() => navigate('/dashboard/employee-dashboard/employee-applications')}>
              View Applications &nbsp; <FaUsersBetweenLines size={15} color={'#fff'} />
            </button>
          </div>
        </Card.Header>
      </Card>


      <div className="row g-3" style={{ paddingLeft: '1rem', paddingRight: '1rem' }}>
        {statData.map((item, index) => (
          <div className="col-md-4 col-lg-3 col-sm-12" key={index}>
            <StatusCard {...item} />
          </div>
        ))}
      </div>

      <Card className="bg-transparent mt-4 dashboard-card">
        <Card.Header
          style={headerStyle}
          className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
        >
          <div className="d-flex align-items-center">
            <h5 className="mb-0 me-2">Inbox</h5>
            <span className="badge bg-primary rounded-pill">
              {filteredData.length}
            </span>
          </div>
          <div className="d-flex align-items-center">
            <Button variant="outline-secondary" className="filter-btn me-2">
              <BsFilter size={18} />
              <span className="ms-1 d-none d-sm-inline">Filter</span>
            </Button>
            <Form className="inbox-search">
              <InputGroup>
                <Form.Control
                  type="text"
                  placeholder="Search inbox..."
                  aria-label="Search inbox"
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                />
                <Button variant="primary">
                  <BsSearch />
                </Button>
              </InputGroup>
            </Form>
          </div>
        </Card.Header>
        <div style={{ position: 'relative', 'bottom': '2rem', }}>
          <ActionTable
            columns={INBOX_COLUMNS}
            rowData={filteredData}
            tableHeader={null}
            hideExportBtn={true}
            hideSearchBar={true}
            pagination={true}
            currentPage={currentPage}
            itemsPerPage={itemsPerPage}
            onPageChange={handleTablePageChange}
            onViewRow={handleOnViewRow}
            noDataText={
              <div className="no-results text-center py-4">
                <BsSearch size={24} className="mb-2" />
                <p>No results found</p>
                <small>
                  Try adjusting your search to find what you're looking for.
                </small>
              </div>
            }
          />
        </div>
      </Card>
    </>
  );
};

export default OfficerRoleDashboard;


import React from 'react';
import { FaUser, FaIdCard, FaEnvelope, FaPhone, FaMapMarkerAlt } from 'react-icons/fa';
import { CONSTANT_REGEX } from '../../utils/constants.ts';

const createFormFieldsConfig = (getDetailsByPIN) => {
  return {
    step1: [
      {
        name: 'firstName',
        label: 'First Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 80,
        placeholder: "Enter Builder's First name",
        validation: { required: 'First name is required' }
      },
      {
        name: 'lastName',
        label: 'Last Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 80,
        placeholder: "Enter Builder's Last name",
        validation: { required: 'Last name is required' }
      },
      {
        name: 'emailId',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: {
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      {
        name: 'phoneNumber',
        label: 'Phone Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        maxlength: 10,
        placeholder: 'Enter 10-digit phone number',
        validation: {
          required: 'Phone number is required (10 digits)',
          pattern: {
            value: CONSTANT_REGEX.MOBILE,
            message: 'Please enter a valid Phone number'
          }
        },
      },
      {
        name: 'panNumber',
        label: 'PAN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        maxlength: 10,
        placeholder: 'Enter PAN number (e.g., ABCDE1234F)',
        validation: {
          required: 'PAN number is required',
          pattern: {
            value: CONSTANT_REGEX.PAN,
            message: 'Invalid PAN number'
          }
        }
      },
      {
        name: 'gstNumber',
        label: 'GST Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter GST number',
        maxlength: 15,
        validation: {
          required: 'GST number is required',
          pattern: {
            value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
            message: 'Invalid GST No.'
          }
        }
      },
      {
        name: 'addressLine1',
        label: 'Address Line-1',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 100,
        placeholder: 'Enter address line 1',
        validation: { required: 'Address is required' }
      },
      {
        name: 'addressLine2',
        label: 'Address Line-2',
        type: 'text',
        required: false,
        maxlength: 100,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 2 (optional)'
      },
      {
        name: 'pin',
        label: 'PIN',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 6,
        placeholder: 'Enter 6-digit PIN code',
        validation: {
          required: 'PIN code is required',
          pattern: {
            value: /^[0-9]{6}$/,
            message: 'PIN must be 6 digits'
          }
        },
        onChange: (e, setValue, watch) => {
          const changedValue = e?.target?.value || "";
          if (changedValue?.length === 6) {
            setValue('district', '');
            setValue('stateUt', '');
            setValue('country', 'India');
            getDetailsByPIN(changedValue);
          }
        },
      },
      {
        name: 'district',
        label: 'District',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter district',
      },
      {
        name: 'stateUt',
        label: 'State / UT',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter state',
      },
      {
        name: 'country',
        label: 'Country',
        type: 'text',
        required: false,
        disabled: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter country',
      }
    ],
    step2: [
      {
        name: 'addressProof',
        label: 'Address Proof',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'panCardUpload',
        label: 'PAN Card',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'gstCertificate',
        label: 'GST Certificate',
        type: 'file',
        required: false,
        colSize: 6,
      }
    ]
  };
};

export default createFormFieldsConfig;


import React, { useState, useEffect, useRef } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Button, Card, Image } from 'react-bootstrap';
import {
  FaBuilding, FaFileUpload, FaCheck, FaArrowRight,
  FaArrowLeft
} from 'react-icons/fa';
import './UserRegistration.css';
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";
import { toast } from "react-toastify";
import NewLoader from '../../common/NewLoader.js';
import { getData, postFORMdata } from "../../../services/http.service.ts";
import { URLS_ENDPOINT } from '../../../utils/urlsConstants.ts';
import { handleErrorMessage } from '../../../utils/errorMessageHandler.js';
import { mapToVesselUserDetails } from '../model/mapToVesselModel.ts';
import ApprovalModal from '../../common/ApprovalModal.js';
import ActionDropdown from '../../common/ActionDropdown.js';
import DynamicFormFields from '../../common/DynamicFormFields';
import createFormFieldsConfig from '../../common/FormFieldsConfig';

const VesselBuilderRegistrationPage = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [successMessage, setSuccessMessage] = useState("");
  const [validationMessage, setValidationMessage] = useState("");
  const loaderRef = useRef();
  const PUBLIC_URL = process.env.REACT_APP_PUBLIC_URL;

  const actionsFromAPI = ["Accept", "Reject", "Send Back"];
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
   const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      ...formData,
    };
    console.log("Submitted Data:", payload);
    setShowApprovalModal(false);
    setSelectedAction("");
    // we need to API call here
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };


  const methods = useForm({
    mode: 'onBlur',
    defaultValues: { country: 'India' }
  });

  const { handleSubmit, formState: { errors }, trigger, setValue, getValues, watch, setError } = methods;
  const totalSteps = 2;

  useEffect(() => {
    setTimeout(() => {
       // console.log("Current Step:", currentStep);
      // console.log("current form data:", formData);
      Object.keys(formData).forEach(key => {
        if (formData[key]) {
           // console.log("Setting value for", key, formData[key]);
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [currentStep, setValue, formData]);

  const getDetailsByPIN = async (pinCode) => {
    try {
      const URL = PUBLIC_URL + URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE + pinCode;
      loaderRef.current?.show();
      const response = await getData(URL);
      if (response?.status === 200 && response?.data?.length > 0) {
        setValue('district', response?.data[0]?.district);
        setValue('stateUt', response?.data[0]?.stateName);
        loaderRef?.current?.hide();
      } else {
        loaderRef?.current?.hide();
        toast.info("No Data Found! Pleasee enter manually..", { position: "top-right" });
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const formFields = createFormFieldsConfig(getDetailsByPIN);

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      default: return [];
    }
  };

  const validateStep = async () => {
    const currentFields = getCurrentStepFields();
    const requiredFields = currentFields
      .filter(field => field.required && (!field.showIf || field.showIf()));

    requiredFields.forEach(field => {
      const value = getValues(field.name);
      if (!value || value === '') {
        setError(field.name, {
          type: 'required',
          message: `${field.label} is required`
        });
      } else if (field.validation && field.validation.pattern) {
        const pattern = field.validation.pattern.value;
        if (!pattern.test(value)) {
          setError(field.name, {
            type: 'pattern',
            message: field.validation.pattern.message
          });
        }
      }
    });

    const fieldsToValidate = currentFields
      .filter(field => !field.showIf || field.showIf())
      .map(field => field.name);

    return await trigger(fieldsToValidate);
  };

  const handleNext = async () => {
    const isStepValid = await validateStep();

    if (isStepValid) {
      setValidationMessage("");
      const currentValues = getValues();
      const fileFields = getCurrentStepFields().filter(field => field.type === 'file');
      fileFields.forEach(field => {
        if (currentValues[field.name]) {
          setFormData(prev => ({
            ...prev,
            [field.name]: currentValues[field.name]
          }));
        }
      });

      setFormData(prev => ({ ...prev, ...currentValues }));

      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    }
  };

  const handlePrevious = () => {
    const currentValues = getValues();
    const fileFields = getCurrentStepFields().filter(field => field.type === 'file');
    fileFields.forEach(field => {
      if (currentValues[field.name]) {
        setFormData(prev => ({
          ...prev,
          [field.name]: currentValues[field.name]
        }));
      }
    });

    setFormData(prev => ({ ...prev, ...currentValues }));
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
    setValidationMessage("");
  };

  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };
    finalData.userCategory = 'Ship-Builder';
    finalData.userType = 'Builder';
    const formDetails = mapToVesselUserDetails({ ...finalData });
    const filesToUpload = [finalData?.addressProof, finalData?.panCardUpload, finalData?.gstCertificate];

    const fd = new FormData();
    fd.append("request", new Blob([JSON.stringify(formDetails)], { type: 'application/json' }));
    filesToUpload?.forEach((file) => {
      if (file) {
        fd.append(`files`, file);
      }
    });
    submitUserDetails(fd);
  };

  const submitUserDetails = async (payload) => {
    try {
      const URL = process.env.REACT_APP_AUTH_URL + URLS_ENDPOINT.USER_SERVICE.CREATE_USER;
      loaderRef.current?.show();
      const response = await postFORMdata(URL, payload);
      const apiRes = { ...response?.data }
      if (response?.status === 200 && apiRes?.responseStatus?.status === '200') {
        loaderRef?.current?.hide();
        setIsSubmitted(true);
        setSuccessMessage(apiRes?.responseStatus?.message);
        window.scrollTo(0, 0);
      } else {
        loaderRef?.current?.hide();
        toast.info(apiRes?.responseStatus?.message || "Something went wrong..", { position: "top-right" });
      }
    } catch (err) {
      console.log(err,"builder-error");
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };


  

 
 
  

  const stepTitles = [
    { title: "Vessel Builder Details", icon: FaBuilding },
    { title: "Documents Upload", icon: FaFileUpload }
  ];

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="registration-container py-5">
        <Row className="justify-content-center">
          <Col md={10} xl={9}>
            <Card className="registration-card">
              <Card.Header className="registration-header p-0">
                <div className="registration-header-content">
                  <div className="header-logo-container">
                    <Image
                      src={IWT_FULL_IMG}
                      alt="IWT Logo"
                      className="header-logo"
                    />
                  </div>
                  <h3 className="header-title">
                    Vessel Builder Registration
                  </h3>
                </div>
              </Card.Header>

              <Card.Body className="registration-body p-4 p-md-5">
                {isSubmitted ? (
                  <div className="success-container text-center py-5">
                    <div className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style={{ width: '90px', height: '90px', boxShadow: '0 10px 20px rgba(40, 167, 69, 0.3)' }}>
                      <FaCheck className="success-icon text-white fs-1" />
                    </div>
                    <h4 className="success-title text-success mb-3 fw-bold">Registration Successful!</h4>
                    <div className="registration-id p-4 bg-light rounded mb-4" style={{ borderLeft: '4px solid #0077b6' }}>
                      {successMessage ||
                        'Your vessel builder registration has been submitted successfully. You will receive a confirmation email shortly.'
                      }
                    </div>
                    <Button
                      variant="primary"
                      size="lg"
                      className="mt-2 d-flex align-items-center justify-content-center mx-auto"
                      style={{
                        background: 'linear-gradient(135deg, #0077b6, #023e8a)',
                        border: 'none',
                        boxShadow: '0 4px 15px rgba(0, 119, 182, 0.3)',
                        borderRadius: '8px',
                        padding: '12px 30px',
                        fontWeight: '600',
                        transition: 'all 0.3s ease',
                        minWidth: '150px',
                        height: '50px'
                      }}
                      onClick={() => window.location.href = '/'}
                    >
                      Go to Home
                    </Button>
                  </div>
                ) : (
                  <FormProvider {...methods}>
                    <form>
                      <div className="text-center mb-4">
                        <p className="text-muted">Please complete all required information to register as a vessel builder</p>
                      </div>

                      <div className="stepper-container mb-5">
                        <div className="stepper d-flex justify-content-between">
                          {[1, 2].map((step) => (
                            <React.Fragment key={step}>
                              <div className={`step ${currentStep >= step ? 'active' : ''} ${currentStep > step ? 'completed' : ''} flex-grow-1 text-center`}>
                                <div
                                  className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2"
                                  style={{
                                    width: '60px',
                                    height: '60px',
                                    borderRadius: '50%',
                                    fontSize: '20px',
                                    fontWeight: 'bold',
                                    boxShadow: currentStep >= step ? '0 5px 15px rgba(0, 119, 182, 0.3)' : '0 4px 10px rgba(0, 0, 0, 0.1)',
                                    background: currentStep >= step ?
                                      (currentStep > step ? 'linear-gradient(135deg, #28a745, #20c997)' : 'linear-gradient(135deg, #0077b6, #023e8a)') :
                                      '#ffffff',
                                    border: currentStep >= step ? 'none' : '2px solid #e9ecef',
                                    color: currentStep >= step ? '#fff' : '#6c757d',
                                    transition: 'all 0.4s ease'
                                  }}>
                                  {currentStep > step ? <FaCheck size={22} /> : React.createElement(stepTitles[step - 1].icon, { size: 18 })}
                                </div>
                                <div className="step-label fw-bold"
                                  style={{
                                    color: currentStep >= step ? (currentStep > step ? '#28a745' : '#0077b6') : '#6c757d',
                                    fontSize: '0.9em',
                                    transition: 'all 0.3s ease'
                                  }}>
                                  {stepTitles[step - 1].title}
                                </div>
                              </div>
                              {step < 2 && (
                                <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                                  <div className={`connector-line w-100 ${currentStep > step ? 'active' : ''}`}
                                    style={{
                                      height: '4px',
                                      background: currentStep > step ? 'linear-gradient(to right, #28a745, #20c997)' : '#e9ecef',
                                      borderRadius: '2px',
                                      transition: 'all 0.5s ease'
                                    }}></div>
                                </div>
                              )}
                            </React.Fragment>
                          ))}
                        </div>
                      </div>

                      <div className="step-content">
                        <div className="form-section p-4 rounded mb-4">
                          <div className="form-content">
                            <DynamicFormFields 
                              fields={getCurrentStepFields()} 
                              setFormData={setFormData} 
                            />
                          </div>
                        </div>
                      </div>

                      <div className="form-navigation mt-4" style={{ display: 'block' }}>
                        {currentStep > 1 &&
                          <Button
                            variant="outline-secondary"
                            onClick={handlePrevious}
                            // hidden={currentStep === 1}
                            className="prev-btn"
                            style={{ 'float': 'left' }}
                          >
                            <FaArrowLeft className="btn-icon me-2" /> Previous
                          </Button>
                        }

                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="next-btn"
                          style={{ 'float': 'right' }}
                        >
                          {currentStep === totalSteps ? 'Submit Registration' : 'Next'}
                          {currentStep !== totalSteps && <FaArrowRight className="btn-icon ms-2" />}
                        </Button>
                        
                        {/* <div style={{ 'float': 'right' }} className="d-flex flex-column align-items-center">
                          <ActionDropdown actions={actionsFromAPI} onActionClick={handleActionClick} />
                          <ApprovalModal
                            show={showApprovalModal}
                            handleClose={handleCloseModal}
                            handleSubmitData={handleActionSubmit}
                            selectedAction={selectedAction}
                          />
                        </div> */}
                      </div>
                    </form>
                  </FormProvider>
                )}
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Container>
   
    </>
  );
};

export default VesselBuilderRegistrationPage;

