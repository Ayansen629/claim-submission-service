import React, { useState } from 'react';
import { Modal, Button, Form, Row, Col } from 'react-bootstrap';
import { toast } from 'react-toastify';
import DatePicker from 'react-datepicker';
import "react-datepicker/dist/react-datepicker.css";

const OfficerAppointmentModal = ({ show, handleClose, handleConfirm }) => {
  const [appointments, setAppointments] = useState([
    { id: 1, date: null, time: null },
    { id: 2, date: null, time: null },
    { id: 3, date: null, time: null },
    { id: 4, date: null, time: null }
  ]);

  const timeSlots = [
    { value: '09:00-10:00', label: '9:00 AM - 10:00 AM' },
    { value: '10:00-11:00', label: '10:00 AM - 11:00 AM' },
    { value: '11:00-12:00', label: '11:00 AM - 12:00 PM' },
    { value: '12:00-13:00', label: '12:00 PM - 1:00 PM' },
    { value: '13:00-14:00', label: '1:00 PM - 2:00 PM' },
    { value: '14:00-15:00', label: '2:00 PM - 3:00 PM' },
    { value: '15:00-16:00', label: '3:00 PM - 4:00 PM' },
    { value: '16:00-17:00', label: '4:00 PM - 5:00 PM' },
    { value: '17:00-18:00', label: '5:00 PM - 6:00 PM' }
  ];

  const handleDateChange = (index, date) => {
    const updatedAppointments = [...appointments];
    updatedAppointments[index].date = date;
    setAppointments(updatedAppointments);
  };

  const handleTimeChange = (index, time) => {
    const updatedAppointments = [...appointments];
    updatedAppointments[index].time = time;
    setAppointments(updatedAppointments);
  };

  const handleConfirmAppointments = async () => {
    const validAppointments = appointments.filter(apt => apt.date && apt.time);
    
    if (validAppointments.length < 2) {
      toast.error("Please select at least 2 appointment slots");
      return;
    }

    const formattedAppointments = validAppointments.map(apt => ({
      date: apt.date,
      time: apt.time,
      dateTime: `${apt.date.toLocaleDateString()} at ${timeSlots.find(t => t.value === apt.time)?.label}`,
      appointmentStatus: "PENDING",
      isBooked: false,
      bookedBy: null
    }));

    try {
      await handleConfirm(formattedAppointments);
      toast.success(`${validAppointments.length} appointment slots proposed successfully!`, {
        position: "top-right",
        autoClose: 3000,
      });
      handleClose();
      resetForm();
    } catch (error) {
      toast.error("Failed to submit appointments. Please try again.");
      console.error("Appointment submission error:", error);
    }
  };

  const resetForm = () => {
    setAppointments([
      { id: 1, date: null, time: null },
      { id: 2, date: null, time: null },
      { id: 3, date: null, time: null },
      { id: 4, date: null, time: null }
    ]);
  };

  const handleModalClose = () => {
    resetForm();
    handleClose();
  };

  const validAppointmentsCount = appointments.filter(apt => apt.date && apt.time).length;

  return (
    <Modal 
      show={show} 
      onHide={handleModalClose} 
      centered 
      size="lg"
      style={{ zIndex: 1050 }}
    >
      <Modal.Header 
        closeButton 
        style={{ 
          backgroundColor: '#2E57A7', 
          color: 'white',
          border: 'none'
        }}
      >
        <Modal.Title className="fw-bold d-flex align-items-center">
          <i className="bi bi-calendar-plus me-2"></i>
          Confirm Appointment
        </Modal.Title>
      </Modal.Header>
      
      <Modal.Body style={{ padding: '2rem' }}>
        {/* ... existing modal body code ... */}
      </Modal.Body>
      
      <Modal.Footer style={{ border: 'none', padding: '1rem 2rem 2rem' }}>
        <Button 
          variant="outline-secondary" 
          onClick={handleModalClose}
          style={{ 
            borderRadius: '8px',
            padding: '8px 20px',
            fontWeight: 500
          }}
        >
          <i className="bi bi-x-lg me-2"></i>
          Cancel
        </Button>
        <Button 
          variant="primary"
          onClick={handleConfirmAppointments}
          disabled={validAppointmentsCount < 2}
          style={{ 
            backgroundColor: validAppointmentsCount >= 2 ? '#2E57A7' : '#6c757d',
            borderColor: validAppointmentsCount >= 2 ? '#2E57A7' : '#6c757d',
            borderRadius: '8px',
            padding: '8px 20px',
            fontWeight: 500,
            opacity: validAppointmentsCount >= 2 ? 1 : 0.6
          }}
        >
          <i className="bi bi-check-lg me-2"></i>
          Confirm Appointments
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default OfficerAppointmentModal;
