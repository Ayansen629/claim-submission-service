// For Type of Vessel
<InputSelect
  label="Type of Vessel"
  name="vesselType"
  required
  options={[
    { value: "new", label: "New Vessel" },
    { value: "old", label: "Old Vessel" },
  ]}
  register={register}
  errors={errors}
  value={watch("vesselType") || ""}
  onChange={(value) => {
    setValue("vesselType", value, { shouldValidate: true });
    clearErrors("vesselType");
  }}
/>

// For Category
<InputSelect
  label="Category"
  name="category"
  required
  options={[
    { value: "A", label: "Category A" },
    { value: "B", label: "Category B" },
    { value: "C", label: "Category C" },
  ]}
  register={register}
  errors={errors}
  value={watch("category") || ""}
  onChange={(value) => {
    setValue("category", value, { shouldValidate: true });
    clearErrors("category");
  }}
/>

// For Zone
<InputSelect
  label="Zone"
  name="zone"
  options={[
    { value: "1", label: "Zone 1" },
    { value: "2", label: "Zone 2" },
    { value: "3", label: "Zone 3" },
