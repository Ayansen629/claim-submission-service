// EmployeeRegistrationForm.tsx (corrected parts)
const EmployeeRegistrationForm = () => {
  const { control, register, setValue, watch, formState: { errors } } = useFormContext();
  
  // Watch the nested address.pin field
  const watchPin = watch("address.pin");

  // Auto-populate address details
  useEffect(() => {
    const fetchAddressDetails = async (pin: string) => {
      if (pin?.length === 6) {
        try {
          // Simulated API call
          const response = await fetch(`https://api.postalpincode.in/pincode/${pin}`);
          const data = await response.json();
          
          if(data[0].Status === "Success") {
            const postOffice = data[0].PostOffice[0];
            setValue("address.district", postOffice.District);
            setValue("address.state", postOffice.State);
            setValue("address.country", postOffice.Country);
          }
        } catch (error) {
          console.error("Error fetching address details:", error);
        }
      }
    };

    fetchAddressDetails(watchPin);
  }, [watchPin, setValue]);

  return (
    {/* Address Details Section */}
    <Collapsible title="Address Details">
      <Card className="form-section-card">
        <Card.Body>
          <Row className="g-3">
            {/* Other address fields */}
            <Col md={4}>
              <InputText
                name="address.pin"  // Correct nested field name
                label="PIN Code"
                register={register}
                errors={errors}
                validation={{
                  required: "PIN Code is required",
                  pattern: {
                    value: /^\d{6}$/,
                    message: "Invalid PIN code (must be 6 digits)"
                  }
                }}
              />
            </Col>
            {/* Auto-populated fields */}
            <Col md={4}>
              <InputText
                name="address.district"
                label="District"
                register={register}
                errors={errors}
                readOnly
              />
            </Col>
            <Col md={4}>
              <InputText
                name="address.state"
                label="State/UT"
                register={register}
                errors={errors}
                readOnly
              />
            </Col>
            <Col md={4}>
              <InputText
                name="address.country"
                label="Country"
                register={register}
                errors={errors}
                readOnly
              />
            </Col>
          </Row>
        </Card.Body>
      </Card>
    </Collapsible>
  );
};
