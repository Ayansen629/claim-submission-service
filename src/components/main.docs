{/* Hero Section */}
<div className={styles.heroSection}>
  <div className={styles.overlay}></div>

  <div className="container-fluid position-relative z-2">
    <div className={`row g-0 pt-4 px-2 px-md-4 ${styles.headerRow}`}>
      {/* Top Navigation Row */}
      <div className={`${styles.topNavCol} mb-0 col-12 position-relative`}>
        <div className={`d-flex flex-column flex-sm-row justify-content-between align-items-center w-100 ${styles.navGroupWrapper}`}>
          
          {/* Left side - IWT Logo and Brand Name (visible on all screens) */}
          <div className="d-flex align-items-center mb-2 mb-sm-0">
            <img className="me-2" src={IWTIcon} alt="Logo" style={{ width: "3.5rem", borderRadius: "0px" }} />
            <div className="d-flex flex-column">
              <p className={`${styles.brandName} mb-0`}>{t("home2.InlandWaterTransportServices")}</p>
              <p className={`${styles.brandName} mb-0`}>{t("home2.departmentOfWB")}</p>
            </div>
          </div>

          {/* Right side - Navigation and Bengal Logo */}
          <div className="d-flex flex-column align-items-center position-relative" style={{ width: "100%", maxWidth: "600px" }}>
            {/* Navigation Links - Horizontal on medium+, vertical on small screens */}
            <Nav className={`d-flex flex-column flex-md-row justify-content-center align-items-center ${styles.navLinksContainer}`}>
              <Nav.Link className={`${styles.navLinkItems} text-decoration-none px-1 px-md-2 py-1`}>
                {t("home2.home")}
              </Nav.Link>
              <Nav.Link
                onClick={() => navigate("/about-us")}
                className={`${styles.navLinkItems} text-decoration-none px-1 px-md-2 py-1`}
              >
                {t("home2.aboutUs")}
              </Nav.Link>
              <Nav.Link
                onClick={() => navigate("/our-services")}
                className={`${styles.navLinkItems} text-decoration-none px-1 px-md-2 py-1`}
              >
                {t("home2.services")}
              </Nav.Link>
              <Nav.Link
                onClick={() => navigate("/rules-and-act")}
                className={`${styles.navLinkItems} text-decoration-none px-1 px-md-2 py-1`}
              >
                {t("home2.RulesAndAct")}
              </Nav.Link>
              <Nav.Link
                onClick={() => navigate("/gallery")}
                className={`${styles.navLinkItems} text-decoration-none px-1 px-md-2 py-1`}
              >
                {t("home2.Gallery")}
              </Nav.Link>
              <Nav.Link
                onClick={() => navigate("/important-link")}
                className={`${styles.navLinkItems} text-decoration-none px-1 px-md-2 py-1`}
              >
                {t("home2.ImportantLink")}
              </Nav.Link>
              <Nav.Link
                onClick={() => navigate("/contact-us")}
                className={`${styles.navLinkItems} text-decoration-none px-1 px-md-2 py-1`}
              >
                {t("home2.contactUs")}
              </Nav.Link>
            </Nav>

            {/* Underline only below nav links */}
            <div className="w-100 border-top border-white mt-1 d-none d-md-block"></div>

            {/* Bengal Logo and Login Button */}
            <div className="d-flex justify-content-between align-items-center w-100 mt-2">
              <div style={{width: "20px"}}></div> {/* Spacer for balance */}
              
              <Button
                variant="light"
                className={`${styles.homeLoginBtn} ${styles.loginBtn} me-2`}
                onClick={() => navigate("/login")}
              >
                {t("home2.Login")}
              </Button>
              
              <img src={BengalLogo} alt="Logo" className={styles.bengalLogo} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
