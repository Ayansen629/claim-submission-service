import React, { useState } from "react";
import { Button, Card } from "react-bootstrap";
import { BsPlus } from "react-icons/bs";
import { useTranslation } from "react-i18next";
import ActionTable from "../../../../../common/ActionTable.tsx";
import FileReportsUploadModal from "../../../../../common/FileReportsUploadModal.jsx";
import Collapsible from "../../../../../common/Collapsible.js";

const ReportsDashboard = () => {
  const { t } = useTranslation();
  const [showFileModal, setShowFileModal] = useState(false);
  const [currentReportType, setCurrentReportType] = useState("");
  const [reports, setReports] = useState({
    materialTest: [
      {
        id: 1,
        fileName: "material_test_1.pdf",
        description: t("Initial material test results"),
        remarks: t("Approved"),
      },
      {
        id: 2,
        fileName: "material_test_2.pdf",
        description: t("Follow-up material analysis"),
        remarks: t("Pending review"),
      },
    ],
    radiography: [
      {
        id: 1,
        fileName: "radiography_report_1.pdf",
        description: t("X-ray inspection results"),
        remarks: t("Completed"),
      },
      {
        id: 2,
        fileName: "radiography_report_2.pdf",
        description: t("Ultrasonic testing report"),
        remarks: t("Approved"),
      },
    ],
    inspection: [
      {
        id: 1,
        fileName: "inspection_report_1.pdf",
        description: t("Quarterly inspection"),
        remarks: t("Completed"),
      },
      {
        id: 2,
        fileName: "inspection_report_2.pdf",
        description: t("Annual safety check"),
        remarks: t("Pending corrections"),
      },
    ],
    other: [
      {
        id: 1,
        fileName: "other_report_1.pdf",
        description: t("Additional documentation"),
        remarks: t("N/A"),
      },
      {
        id: 2,
        fileName: "other_report_2.pdf",
        description: t("Supplementary notes"),
        remarks: t("For reference"),
      },
    ],
  });

  const REPORT_COLUMNS = [
    {
      colName: t("Add Attachment"),
      fieldName: "fileName",
      clsName: "column-text-start",
    },
    {
      colName: t("Description"),
      fieldName: "description",
      clsName: "column-text-start",
    },
    // {
    //   colName: t("Remarks"),
    //   fieldName: "remarks",
    //   clsName: "column-text-start",
    // },
    {
      colName: t("Action"),
      fieldName: "action",
      actions: [ 'delete', 'download'],
      clsName: "col-sm-2 column-text-start actions-column",
    },
  ];

  const handleAddReport = (reportType) => {
    setCurrentReportType(reportType);
    setShowFileModal(true);
  };

  const handleFileUpload = (e) => {
    e.preventDefault();
    const file = e.target.file.files[0];
    if (file) {
      const newReport = {
        id: Date.now(),
        fileName: file.name,
        description: e.target.description.value || t("No description"),
        remarks: e.target.remarks.value || t("No remarks"),
      };

      setReports((prev) => ({
        ...prev,
        [currentReportType]: [...prev[currentReportType], newReport],
      }));

      setShowFileModal(false);
    }
  };

  const handleViewReport = (rowData, reportType) => {
    console.log("View report:", rowData, reportType);
    alert(t("Viewing report") + `: ${rowData.fileName}`);
  };

  const handleDeleteReport = (rowData, reportType) => {
    if (window.confirm(t("Are you sure you want to delete this report?"))) {
      setReports(prev => ({
        ...prev,
        [reportType]: prev[reportType].filter(report => report.id !== rowData.id)
      }));
    }
  };

  const handleDownloadReport = (rowData, reportType) => {
    console.log("Download report:", rowData, reportType);
    alert(t("Downloading report") + `: ${rowData.fileName}`);
  };

  const handleSaveReports = () => {
    console.log("Reports saved:", reports);
    alert(t("All reports have been saved successfully"));
  };

  const handleResetReports = () => {
    if (window.confirm(t("Are you sure you want to reset all changes?"))) {
      setReports({
        materialTest: reports.materialTest.filter(r => r.id <= 2),
        radiography: reports.radiography.filter(r => r.id <= 2),
        inspection: reports.inspection.filter(r => r.id <= 2),
        other: reports.other.filter(r => r.id <= 2),
      });
    }
  };

  const renderReportTable = (reportType, reportData, title) => {
    return (
      <Collapsible title={title} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <div className="d-flex justify-content-end mb-3">
            <Button
              variant="primary"
              size="sm"
              onClick={() => handleAddReport(reportType)}
            >
              <BsPlus size={20} /> {t("Add")}
            </Button>
          </div>

          <ActionTable
            columns={REPORT_COLUMNS}
            rowData={reportData}
            tableHeader={null}
            hideExportBtn={true}
            hideSearchBar={true}
            pagination={false}
            onViewRow={(rowData) => handleViewReport(rowData, reportType)}
            onDeleteRow={(rowData) => handleDeleteReport(rowData, reportType)}
            download={(rowData) => handleDownloadReport(rowData, reportType)}
            noDataText={t("No reports available")}
          />
        </div>
      </Collapsible>
    );
  };

  return (
    <Card className="mt-4">
         {/* <Card.Header className="dashboard-card-header">
        <h5>{t("Reports Dashboard")}</h5>
      </Card.Header> */}
      <Card.Body style={{ padding: 0 }}>
        <div className="reports-section">
          {renderReportTable("materialTest", reports.materialTest, t("Material Test Report"))}
          {renderReportTable("radiography", reports.radiography, t("Radiography Report"))}
          {renderReportTable("inspection", reports.inspection, t("Inspection Report"))}
          {renderReportTable("other", reports.other, t("Other Report"))}
          {/* <div className="d-flex justify-content-end mt-4">
            <Button 
              variant="secondary" 
              className="me-2"
              onClick={handleResetReports}
            >
              {t("Reset")}
            </Button>
            <Button 
              variant="primary"
              onClick={handleSaveReports}
            >
              {t("Save")}
            </Button>
          </div> */}
        </div>
      </Card.Body>

      <FileReportsUploadModal
        show={showFileModal}
        onHide={() => setShowFileModal(false)}
        reportType={currentReportType}
        onSubmit={handleFileUpload}
      />
    </Card>
  );
};

export default ReportsDashboard;
import React, { useState } from "react";
import { useForm } from "react-hook-form";
import { Modal, Form, Button, Spinner } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { FaTimesCircle, FaFileAlt } from "react-icons/fa";
import { toast } from "react-toastify";
import { postFORMdata, postData } from "../../services/http.service.ts";
import {
  BASE_IP,
  URLS_ENDPOINT,
   SERVICE_BASE,
} from "../../utils/urlsConstants.ts";

const FileReportsUploadModal = ({
  show,
  onHide,
  reportType,
  onSubmit,
}) => {
  const { t } = useTranslation();
  const {
    register,
    handleSubmit,
    reset,
    formState: { errors },
    setValue,
  } = useForm();

  const [uploadedFile, setUploadedFile] = useState(null);
  const [uploading, setUploading] = useState(false);
  const [submitting, setSubmitting] = useState(false);

  const getReportDisplayName = (type) => {
    const reportNames = {
      MATERIAL_TEST_REPORT: "Material Test Certificate",
      RADIOGRAPHY_REPORT: "Radiography Report", 
      INSPECTION_REPORT: "Inspection Report",
      OTHER_REPORT: "Other Report"
    };
    return reportNames[type] || "Report";
  };

  const handleFormSubmit = async (data) => {
    // debugger;
    console.log("Form submitted with data:", data);
    console.log("Uploaded file:", uploadedFile);
    
    if (!uploadedFile?.url) {
      toast.error("Please upload a file first.");
      return;
    }

    setSubmitting(true);
    
    try {
      const payload = {
        applicationNo: "039f85be-0201-4802-b6fb-c3b9d59af6e1",
        doc: [
          {
            id: "",
            documentName: getReportDisplayName(reportType),
            documentType: reportType,
            applicationNumber: "039f85be-0201-4802-b6fb-c3b9d59af6e1",
            fileStoreId: uploadedFile.url,
            documentSource: reportType,
            description: data.description || "",
            active: true
          }
        ]
      };

      const uploadApiUrl = SERVICE_BASE.IWT_REGISTRATION  + URLS_ENDPOINT.USER_SERVICE.REPORT_UPLOAD;
      console.log("Making API call to:",uploadApiUrl );
      console.log("Payload:", payload);
      
      const response = await postData(uploadApiUrl, payload);
      
      console.log("Report upload response:", response);
      
      if (response?.responseStatus?.status === "Document saved successfully.") {
        toast.success("Report uploaded successfully!");
        onSubmit && onSubmit(response.data[0]);
        resetForm();
        onHide();
      } else {
        toast.error("Failed to save report. Please try again.");
      }
    } catch (err) {
      console.error("Report upload failed:", err);
      console.log("Error details:", err.response || err.message);
      toast.error("Report upload failed. Please try again.");
    } finally {
      setSubmitting(false);
    }
  };

  const handleModalClose = () => {
    resetForm();
    onHide();
  };

  const resetForm = () => {
    reset();
    setUploadedFile(null);
    setUploading(false);
    setSubmitting(false);
  };

  const handleFileChange = async (e) => {
    const file = e?.target?.files[0];
    if (!file) return;

    const maxSize = 10 * 1024 * 1024;
    if (file.size > maxSize) {
      toast.error("File size must be less than or equal to 10 MB.");
      e.target.value = null;
      return;
    }

    setUploading(true);
    
    try {
      const formData = new FormData();
      formData.append("file", file);

      const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
      const response = await postFORMdata(uploadUrl, formData);
      
      console.log("File upload response:", response);
      
      const fileStoreId = response?.data?.files[0]?.fileStoreId;
      
      setUploadedFile({ name: file.name, url: fileStoreId });
      setValue("file", fileStoreId);
      toast.success("File uploaded successfully!");
    } catch (err) {
      console.error("File upload failed:", err);
      console.log("Error details:", err.response || err.message);
      toast.error("File upload failed. Please try again.");
      setUploadedFile(null);
      e.target.value = null;
    } finally {
      setUploading(false);
    }
  };

  const removeFile = () => {
    setUploadedFile(null);
    setValue("file", null);
  };

  return (
    <Modal show={show} onHide={handleModalClose}>
      <Modal.Header closeButton>
        <Modal.Title>
          {t("Upload")}{" "}
          {reportType
            .replace(/([A-Z])/g, " $1")
            .replace(/^./, (str) => str.toUpperCase())}{" "}
          {t("Report")}
        </Modal.Title>
      </Modal.Header>
      
      <Form onSubmit={handleSubmit(handleFormSubmit)}>
        <Modal.Body>
          <Form.Group className="mb-3">
            <Form.Label>
              {t("Select File")} <span className="text-danger">*</span>
            </Form.Label>
            
            {uploading ? (
              <div className="border rounded p-3 text-center bg-light">
                <Spinner animation="border" size="sm" className="me-2" />
                <span className="text-muted">Uploading file...</span>
              </div>
            ) : !uploadedFile ? (
              <Form.Control
                type="file"
                onChange={handleFileChange}
                required
                accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.jpg,.jpeg,.png"
              />
            ) : (
              <div className="border rounded p-2 bg-light">
                <div className="d-flex align-items-center justify-content-between">
                  <div className="d-flex align-items-center flex-grow-1">
                    <FaFileAlt className="text-primary me-2" />
                    <span className="text-truncate" title={uploadedFile.name}>
                      {uploadedFile.name}
                    </span>
                  </div>
                  <FaTimesCircle
                    size={18}
                    color="#dc3545"
                    style={{ cursor: "pointer", marginLeft: "10px" }}
                    onClick={removeFile}
                    title="Remove file"
                  />
                </div>
              </div>
            )}
          </Form.Group>

          <Form.Group className="mb-3">
            <Form.Label>{t("Description")}</Form.Label>
            <Form.Control
              as="textarea"
              rows={3}
              {...register("description")}
              placeholder={t("Enter description")}
            />
          </Form.Group>
        </Modal.Body>

        <Modal.Footer>
          <Button variant="secondary" onClick={handleModalClose}>
            {t("Cancel")}
          </Button>
          <Button 
            variant="primary" 
            type="submit"
            disabled={!uploadedFile || uploading || submitting}
          >
            {submitting ? (
              <>
                <Spinner animation="border" size="sm" className="me-2" />
                Uploading...
              </>
            ) : (
              t("Upload")
            )}
          </Button>
        </Modal.Footer>
      </Form>
    </Modal>
  );
};

export default FileReportsUploadModal;
