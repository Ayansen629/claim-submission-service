
import React, { useState, useEffect } from "react";
import WelcomeBox from "../../../common/WelcomeBox.js";
import { Card, Form, InputGroup, Button } from "react-bootstrap";
import {
  BsPersonBadge,
  BsClipboardData,
  BsSearch,
  BsFilter,
} from "react-icons/bs";
import { FaUserGraduate, FaRegEye, FaUser } from "react-icons/fa";
import { MdOutlineAssignment } from "react-icons/md";
import "./userRegDashboard.css";
import { headerStyle } from "../../../../utils/constants.ts";
import ActionTable from "../../../common/ActionTable.tsx";
import { useNavigate } from "react-router-dom";
import StatusCard from "../../../common/StatusCard.js";
import { FaUsersBetweenLines } from "react-icons/fa6";

const INBOX_COLUMNS = [
  {
    colName: "Application No",
    fieldName: "appNo",
    clsName: "column-text-start",
  },
  {
    colName: "Application Type",
    fieldName: "appType",
    clsName: "column-text-start",
  },
  {
    colName: "Phone No",
    fieldName: "phoneNumber",
    clsName: "column-text-start",
  },
  {
    colName: "State",
    fieldName: "stateUt",
    clsName: "column-text-start",
  },
  {
    colName: "District",
    fieldName: "district",
    clsName: "column-text-start",
  },
  {
    colName: "Date of Submission",
    fieldName: "date",
    clsName: "column-text-start",
  },
  {
    colName: "Status",
    fieldName: "status",
    clsName: "column-text-start",
    render: (value) => (
      <span className={`status-badge ${value.toLowerCase()}`}>{value}</span>
    ),
  },
  {
    colName: "Action",
    fieldName: "action",
    actions: ['view'],
    clsName: "col-sm-2 column-text-start actions-column",
  },
];

const UserRegDashboard = () => {
 

  const generateInboxData = () => {
    const statuses = ["Pending", "Completed", "Processing", "Rejected"];
    const states = ["West Bengal", "Kerala", "Tamil Nadu", "Gujarat", "Maharashtra"];
    const districts = ["Kolkata", "Howrah", "North 24 Parganas", "South 24 Parganas", "Hooghly"];
    const phoneNumbers = ["9876543210", "8765432109", "7654321098", "6543210987", "9432109876"];

    return Array.from({ length: 20 }, (_, i) => ({
      id: i + 1,
      appNo: `APP-2025-${(i + 1).toString().padStart(3, "0")}`,
      appType: i % 2 === 0 ? "Ship Builder" : "Vessel Owner", 
      phoneNumber: phoneNumbers[i % 5],
      stateUt: states[i % 5],
      district: districts[i % 5],
      date: new Date(
        2025,
        Math.floor(Math.random() * 12),
        Math.floor(Math.random() * 28) + 1
      )
        .toISOString()
        .split("T")[0],
      status: statuses[Math.floor(Math.random() * statuses.length)],
    }));
  };

  const [inboxData, setInboxData] = useState([]);
  const [filteredData, setFilteredData] = useState([]);
  const [currentPage, setCurrentPage] = useState(1);
  const [searchTerm, setSearchTerm] = useState("");
  const itemsPerPage = 5;

  useEffect(() => {
    const data = generateInboxData();
    setInboxData(data);
    setFilteredData(data);
  }, []);

  useEffect(() => {
    const results = inboxData.filter(
      (item) =>
        item.appNo.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.appType.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.phoneNumber.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.stateUt.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.district.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.status.toLowerCase().includes(searchTerm.toLowerCase())
    );
    setFilteredData(results);
    setCurrentPage(1);
  }, [searchTerm, inboxData]);

  const handleTablePageChange = (page) => {
    setCurrentPage(page);
  };

  const handleOnViewRow = (rowData) => {
    console.log("View Row Data:", rowData);
    navigate('/user-dashboard/view-application', {
      state: { application: rowData },
    });
  };

  const navigate = useNavigate();

  return (
    <>
     

      

      <Card className="bg-transparent mt-4 dashboard-card">
        <Card.Header
          style={headerStyle}
          className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
        >
          <div className="d-flex align-items-center">
            <h5 className="mb-0 me-2">Inbox</h5>
            <span className="badge bg-primary rounded-pill">
              {filteredData.length}
            </span>
          </div>
          <div className="d-flex align-items-center">
            <Button variant="outline-secondary" className="filter-btn me-2">
              <BsFilter size={18} />
              <span className="ms-1 d-none d-sm-inline">Filter</span>
            </Button>
            <Form className="inbox-search">
              <InputGroup>
                <Form.Control
                  type="text"
                  placeholder="Search inbox..."
                  aria-label="Search inbox"
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                />
                <Button variant="primary">
                  <BsSearch />
                </Button>
              </InputGroup>
            </Form>
          </div>
        </Card.Header>
        <div style={{ position: 'relative', 'bottom': '2rem' }}>
          <ActionTable
            columns={INBOX_COLUMNS}
            rowData={filteredData}
            tableHeader={null}
            hideExportBtn={true}
            hideSearchBar={true}
            pagination={true}
            currentPage={currentPage}
            itemsPerPage={itemsPerPage}
            onPageChange={handleTablePageChange}
            onViewRow={handleOnViewRow}
            noDataText={
              <div className="no-results text-center py-4">
                <BsSearch size={24} className="mb-2" />
                <p>No results found</p>
                <small>
                  Try adjusting your search to find what you're looking for.
                </small>
              </div>
            }
          />
        </div>
      </Card>
    </>
  );
};

export default UserRegDashboard;


.officer-view-container {
  background: linear-gradient(120deg, #f5f7fa 60%, #e3eafc 100%);
  min-height: 100vh;
  padding-bottom: 32px;
}

.card {
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(13,110,253,0.06);
  border: none;
}

.back-btn {
  min-width: 140px;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.application-number {
  background: linear-gradient(90deg, #e3eafc 0%, #b6d0fe 100%);
  color: #0d6efd;
  font-size: 1.05rem;
  font-family: 'Roboto Mono', monospace;
  border: 1.5px solid #b6d0fe;
  margin-right: 0;
}

.status-badge {
  font-size: 1rem;
  padding: 0.5em 1.2em;
  border-radius: 2em;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.stepper-wrapper {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32px;
  position: relative;
  background: transparent;
  padding: 24px 0 12px 0;
}

.stepper-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 120px;
}

.stepper-item:not(:last-child)::after {
  content: "";
  position: absolute;
  top: 18px;
  left: 50%;
  width: 100%;
  height: 4px;
  background: linear-gradient(90deg, #e3eafc 0%, #b6d0fe 100%);
  z-index: 0;
  transform: translateX(18px);
}

.stepper-item:last-child::after {
  display: none;
}

.stepper-item.active .step-counter,
.stepper-item.completed .step-counter {
  background: linear-gradient(135deg, #0d6efd 60%, #198754 100%);
  color: #fff;
  border-color: #0d6efd;
  box-shadow: 0 2px 8px rgba(13,110,253,0.08);
}

.stepper-item.completed .step-counter {
  background: linear-gradient(135deg, #198754 60%, #0d6efd 100%);
  border-color: #198754;
}

.stepper-item .step-counter {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  border: 2.5px solid #dee2e6;
  color: #6c757d;
  font-weight: 700;
  font-size: 1.2rem;
  margin-bottom: 10px;
  transition: all 0.2s;
}

.step-name {
  color: #6c757d;
  font-size: 1rem;
  font-weight: 500;
  letter-spacing: 0.01em;
  text-align: center;
}

.stepper-item.active .step-name {
  color: #0d6efd;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.stepper-item.completed .step-name {
  color: #198754;
  font-weight: 700;
}

.disabled-field {
  background-color: #f8f9fa !important;
  color: #495057 !important;
  cursor: not-allowed !important;
  border: 1.5px solid #e3eafc !important;
  border-radius: 6px !important;
}

.file-display {
  padding: 10px 16px;
  background-color: #f8f9fa;
  border-radius: 6px;
  border: 1.5px solid #dee2e6;
  font-size: 0.97rem;
  min-width: 180px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.file-name {
  font-weight: 500;
  color: #0d6efd;
  font-family: 'Roboto Mono', monospace;
  font-size: 1rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140px;
}

.file-download-btn {
  color: #198754 !important;
  margin-left: 8px;
  padding: 0 6px;
}

@media (max-width: 768px) {
  .stepper-wrapper {
    flex-direction: column;
    align-items: flex-start;
    padding: 16px 0 8px 0;
  }
  .stepper-item {
    flex-direction: row;
    margin-bottom: 18px;
    width: 100%;
    min-width: 0;
  }
  .stepper-item:not(:last-child)::after {
    display: none;
  }
  .stepper-item .step-counter {
    margin-right: 15px;
    margin-bottom: 0;
  }
  .step-name {
    margin-top: 3px;
    text-align: left;
  }
}
  <Card>
          <form
            style={{ padding: "2rem", margin: 0 }}
            onSubmit={handleSubmit(onSubmitFilterForm)}
          >
            <Row>
              <Col md={2}>
                <InputSelect
                  label="Application Module"
                  name="applicationModule"
                  options={[
                    { value: 1, label: "Registration" },
                    { value: 2, label: "Survey" },
                    { value: 3, label: "Manning/Training & Certification" },
                  ]}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected apptype :", val)}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label="Application Type"
                  name="applicationType"
                  options={[
                    { value: 1, label: "New Vessel Registration" },
                    { value: 2, label: "Duplicate Certificate" },
                  ]}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected apptype :", val)}
                />
              </Col>

            
              <Col md={2}>
                <InputText
                  type="date"
                  name="fromDate"
                  label="From Date"
                  register={{
                    ...register("fromDate", {}),
                  }}
                  errors={errors}
                />
              </Col>

             
              <Col md={2}>
                <InputText
                  type="date"
                  name="toDate"
                  label="To Date"
                  register={{
                    ...register("toDate", {}),
                  }}
                  errors={errors}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label="Application Status"
                  name="applicationStatus"
                  options={[
                    { value: 1, label: "Pending for Approval" },
                    { value: 2, label: "Approved" },
                    { value: 3, label: "Rejected" },
                  ]}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected Desig :", val)}
                />
              </Col>

              <Col md={2}>
                <InputText
                  type="text"
                  name="applicationNumber"
                  label="Application Number"
                  maxlength={10}
                  placeholder="Enter Application Number"
                  register={{
                    ...register("applicationNumber", {}),
                  }}
                  onKeyDown={(e) => {
                    if (!/^\d$/.test(e.key)) {
                      e.preventDefault();
                    }
                  }}
                  errors={errors}
                />
              </Col>

              <Col
                md={2}
                // className="filter-btn"
                // style={{ display: "flex", position: "relative", top: "2rem" }}
              >
                <div
                  style={{
                    display: "flex",
                    gap: "8px",
                    marginTop: "2rem",
                    whiteSpace: "nowrap",
                  }}
                >
                  <div className="w48">
                    <button className="generic-btn-submit" type="submit">
                      Submit
                    </button>
                  </div>
                  <div className="w48">
                    <button
                      className="generic-btn-cancel "
                      type="reset"
                      onClick={() => {
                        reset();
                      }}
                    >
                      {t("login.reset")}
                    </button>
                  </div>
                </div>
                {/* <Col >
                                         
                                        </Col>
                                        &nbsp;&nbsp;
                                        <Col>
                                         
                                        </Col> */}
              </Col>
            </Row>
          </form>
        </Card>
