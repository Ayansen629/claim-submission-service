.collapseContainer {
  transition: background-color 0.3s ease;
  border: 1px solid #2466BF;
  border-radius: 5px;
  padding: 6px 10px;
  font-size: 0.9rem;
}

.collapseContainer.open {
  background-color: #f0f0f0;
}

.collapseContainer.closed {
  background-color: #ffffff;
}

.collapseDiv {
  display: flex;
  justify-content: space-between;
  padding: 6px 8px;
  align-items: center;
  margin-bottom: 0.75rem;
  cursor: pointer;
}

.open-collapse {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 6px;
}

/* Make sure the SVG icon is properly centered */
.open-collapse svg {
  display: block;
  margin: auto;
}

.title {
  font-weight: bold;
  font-size: 0.85rem;
  font-family: 'Roboto', sans-serif;
}

.cptitle {
  font-size: 1rem !important;
  color: #2466BF !important;
}

/* Optional: Add smooth transition for the chevron */
.open-collapse svg {
  transition: transform 0.2s ease;
}

.collapseContainer.open .open-collapse svg {
  transform: rotate(90deg);
}
