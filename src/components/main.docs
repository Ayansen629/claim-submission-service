if (isOfficerLogin) {
  let actionsItems =
    processActionMapResponce?.length > 0
      ? processActionMapResponce[0]?.processs?.[0]?.actions || []
      : [];

  // Filter out Forward action if Generate CMN exists
  const hasGenerateCMN = actionsItems.some(item => item.actionName === "Generate CMN");
  if (hasGenerateCMN) {
    actionsItems = actionsItems.filter(item => item.actionName !== "Forward");
  }

  if (
    actionsItems?.length > 0 &&
    resData?.appointmentSlots?.length > 0
  ) {
    actionsItems = actionsItems?.filter(
      (item) => item.actionName !== "Generate CMN"
    );
  }

  setActionsFromAPI(actionsItems);
}
