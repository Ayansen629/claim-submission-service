  <button
      style={{
        width: "106px",
        height: "32px",
        borderRadius: "40px",
        padding: "4px 16px 4px 4px",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        gap: "8px",
        border: "none",
        backgroundColor: "#007BFF", // Update color as per your theme
        cursor: "pointer",
      }}
    >
      {/* Login Icon */}
      <div
        style={{
          width: "24px",
          height: "24px",
          borderRadius: "28.8px",
          padding: "2px",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          backgroundColor: "#FFFFFF", // Icon background color
        }}
      >
        <img
          src={LoginIcon}
          alt="Login"
          style={{
            width: "100%",
            height: "100%",
            objectFit: "contain",
          }}
        />
      </div>

      {/* Login Text */}
      <span
        style={{
          fontFamily: "'Open Sans', sans-serif",
          fontWeight: 600,
          fontSize: "14px",
          lineHeight: "120%",
          letterSpacing: "0%",
          color: "#FFFFFF", // Text color
        }}
      >
        Login
      </span>
    </button>
