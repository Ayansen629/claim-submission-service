const ClaimTypeFields = ({ 
  claimType, 
  control, 
  register, 
  errors, 
  setValue, 
  getValues, 
  watch,
  trigger
}) => {
  // Initialize state based on form values
  const hasSecurityInterest = watch("hasSecurityInterest");
  const hasGuarantee = watch("hasGuarantee");
  
  const [showSecurityFields, setShowSecurityFields] = useState(hasSecurityInterest === "yes");
  const [showGuaranteeFields, setShowGuaranteeFields] = useState(hasGuarantee === "yes");

  const currentClaimType = watch("claimType");
  const formEntityData = watch("entityData");
  
  // Function to get entity type based on claim type
  function getEntityType(claimType) {
    switch(claimType) {
      case "PRINCIPAL_BORROWER": return "GUARANTOR";
      case "GUARANTOR": return "PRINCIPAL_BORROWER";
      case "BENEFICIARY": return "BENEFICIARY";
      default: return "";
    }
  }

  // Initialize entity data with correct types
  const [entityData, setEntityData] = useState(() => {
    const existingData = getValues("entityData");
    if (existingData && existingData.length > 0) {
      return existingData;
    }
    return [{ 
      id: 1, 
      name: "", 
      address: "", 
      type: getEntityType(claimType) 
    }];
  });

  // Update entity types when claimType changes
  useEffect(() => {
    if (claimType) {
      setEntityData(prev => {
        return prev.map(entity => ({
          ...entity,
          type: getEntityType(claimType)
        }));
      });
    }
  }, [claimType]);
  
  useEffect(() => {
    setEntityData([{ 
      id: 1, 
      name: "", 
      address: "", 
      type: getEntityType(currentClaimType) 
    }]);
    setValue("entityData", [{
      id: 1,
      name: "",
      address: "",
      type: getEntityType(currentClaimType)
    }]);
  }, [currentClaimType, setValue]);

  // Handle form value changes
  useEffect(() => {
    setShowSecurityFields(hasSecurityInterest === "yes");
    setShowGuaranteeFields(hasGuarantee === "yes");
  }, [hasSecurityInterest, hasGuarantee]);

  const handleSecurityInterestChange = (value) => {
    setShowSecurityFields(value === "yes");
    if (value === "no") {
      setValue("securityValue", "", { shouldValidate: false });
      setValue("securityDate", "", { shouldValidate: false });
    }
  };

  const handleGuaranteeChange = (value) => {
    setShowGuaranteeFields(value === "yes");
    if (value === "no") {
      setValue("guaranteeValue", "", { shouldValidate: false });
      setValue("guaranteeDate", "", { shouldValidate: false });
    }
  };

  // Sync entityData with form values when claimType changes or when form data loads
  useEffect(() => {
    // If we have form data (when navigating back), use that
    if (formEntityData && formEntityData.length > 0) {
      setEntityData(formEntityData);
    } 
    // If claimType changed, reset with empty fields
    else {
      const newEntity = { 
        id: 1, 
        name: "", 
        address: "", 
        type: getEntityType(currentClaimType) 
      };
      setEntityData([newEntity]);
      setValue("entityData", [newEntity]);
    }
  }, [currentClaimType, formEntityData, setValue]);

  // Update form data when entity data changes
  useEffect(() => {
    setValue("entityData", entityData, { shouldValidate: true });
  }, [entityData, setValue]);

  const updateEntityDetails = (id, field, value) => {
    const updatedEntities = entityData.map(entity => 
      entity.id === id ? { ...entity, [field]: value } : entity
    );
    setEntityData(updatedEntities);
  };

  const addEntityField = () => {
    const newId = entityData.length > 0 ? Math.max(...entityData.map(e => e.id)) + 1 : 1;
    setEntityData([...entityData, { 
      id: newId, 
      name: "", 
      address: "", 
      type: getEntityType(claimType) 
    }]);
  };

  const removeEntityField = (id) => {
    if (entityData.length <= 1) return;
    const updatedEntities = entityData.filter(entity => entity.id !== id);
    setEntityData(updatedEntities);
  };

  return (
    <div className="form-section">
      <div className="row g-3">
        {/* Claim Amount and Security Interest in one row */}
        <div className="col-md-6">
          <div className="form-group">
            <label className="form-label">
              <FaMoneyBillWave className="field-icon me-2" />
              Amount of claim <span className="required-asterisk">*</span>
            </label>
            <input
              {...register("claimAmount", { 
                required: "Claim amount is required",
                min: { value: 1, message: "Amount must be greater than 0" }
              })}
              type="number"
              className={`form-control ${errors.claimAmount ? "is-invalid" : ""}`}
              placeholder="Enter claim amount"
            />
            {errors.claimAmount && <div className="invalid-feedback">{errors.claimAmount.message}</div>}
          </div>
        </div>

        {claimType !== "BENEFICIARY" && (
          <div className="col-md-6">
            <div className="form-group">
              <label className="form-label">
                <FaBalanceScale className="field-icon me-2" />
                Amount of claim covered by security interest <span className="required-asterisk">*</span>
              </label>
              <div className="radio-group">
                <label className="radio-option">
                  <input
                    type="radio"
                    {...register("hasSecurityInterest", { required: "This field is required" })}
                    value="yes"
                    checked={watch("hasSecurityInterest") === "yes"}
                    onChange={() => handleSecurityInterestChange("yes")}
                    className="radio-input"
                  />
                  <span className="radio-label">Yes</span>
                </label>
                <label className="radio-option">
                  <input
                    type="radio"
                    {...register("hasSecurityInterest", { required: "This field is required" })}
                    value="no"
                    checked={watch("hasSecurityInterest") === "no"}
                    onChange={() => handleSecurityInterestChange("no")}
                    className="radio-input"
                  />
                  <span className="radio-label">No</span>
                </label>
              </div>
              {errors.hasSecurityInterest && <div className="invalid-feedback">{errors.hasSecurityInterest.message}</div>}
            </div>
          </div>
        )}

        {/* Security Value and Date in one row */}
        {showSecurityFields && claimType !== "BENEFICIARY" && (
          <>
            <div className="col-md-6">
              <div className="form-group">
                <label className="form-label">
                  <FaMoneyBillWave className="field-icon me-2" />
                  Value of the security <span className="required-asterisk">*</span>
                </label>
                <input
                  {...register("securityValue", { 
                    required: "Security value is required",
                    min: { value: 1, message: "Value must be greater than 0" }
                  })}
                  type="number"
                  className={`form-control ${errors.securityValue ? "is-invalid" : ""}`}
                  placeholder="Enter security value"
                />
                {errors.securityValue && <div className="invalid-feedback">{errors.securityValue.message}</div>}
              </div>
            </div>
            <div className="col-md-6">
              <div className="form-group">
                <label className="form-label">
                  <FaCalendarAlt className="field-icon me-2" />
                  Date of the security <span className="required-asterisk">*</span>
                </label>
                <input
                  {...register("securityDate", { 
                    required: "Security date is required",
                    validate: value => {
                      const today = new Date().toISOString().split('T')[0];
                      return value <= today || "Date cannot be in the future";
                    }
                  })}
                  type="date"
                  className={`form-control ${errors.securityDate ? "is-invalid" : ""}`}
                  placeholder="Select security date"
                />
                {errors.securityDate && <div className="invalid-feedback">{errors.securityDate.message}</div>}
              </div>
            </div>
          </>
        )}

        {/* Guarantee Radio and Value in one row */}
        {claimType !== "BENEFICIARY" && (
          <>
            <div className="col-md-6">
              <div className="form-group">
                <label className="form-label">
                  <FaHandshake className="field-icon me-2" />
                  Amount of claim covered by guarantee <span className="required-asterisk">*</span>
                </label>
                <div className="radio-group">
                  <label className="radio-option">
                    <input
                      type="radio"
                      {...register("hasGuarantee", { required: "This field is required" })}
                      value="yes"
                      checked={watch("hasGuarantee") === "yes"}
                      onChange={() => handleGuaranteeChange("yes")}
                      className="radio-input"
                    />
                    <span className="radio-label">Yes</span>
                  </label>
                  <label className="radio-option">
                    <input
                      type="radio"
                      {...register("hasGuarantee", { required: "This field is required" })}
                      value="no"
                      checked={watch("hasGuarantee") === "no"}
                      onChange={() => handleGuaranteeChange("no")}
                      className="radio-input"
                    />
                    <span className="radio-label">No</span>
                  </label>
                </div>
                {errors.hasGuarantee && <div className="invalid-feedback">{errors.hasGuarantee.message}</div>}
              </div>
            </div>

            {showGuaranteeFields && (
              <div className="col-md-6">
                <div className="form-group">
                  <label className="form-label">
                    <FaMoneyBillWave className="field-icon me-2" />
                    Value of the guarantee <span className="required-asterisk">*</span>
                  </label>
                  <input
                    {...register("guaranteeValue", { 
                      required: "Guarantee value is required",
                      min: { value: 1, message: "Value must be greater than 0" }
                    })}
                    type="number"
                    className={`form-control ${errors.guaranteeValue ? "is-invalid" : ""}`}
                    placeholder="Enter guarantee value"
                  />
                  {errors.guaranteeValue && <div className="invalid-feedback">{errors.guaranteeValue.message}</div>}
                </div>
              </div>
            )}
          </>
        )}

        {/* Guarantee Date in a new row if needed */}
        {showGuaranteeFields && claimType !== "BENEFICIARY" && (
          <div className="col-md-6">
            <div className="form-group">
              <label className="form-label">
                <FaCalendarAlt className="field-icon me-2" />
                Date of the guarantee <span className="required-asterisk">*</span>
              </label>
              <input
                {...register("guaranteeDate", { 
                  required: "Guarantee date is required",
                  validate: value => {
                    const today = new Date().toISOString().split('T')[0];
                    return value <= today || "Date cannot be in the future";
                  }
                })}
                type="date"
                className={`form-control ${errors.guaranteeDate ? "is-invalid" : ""}`}
                placeholder="Select guarantee date"
              />
              {errors.guaranteeDate && <div className="invalid-feedback">{errors.guaranteeDate.message}</div>}
            </div>
          </div>
        )}
      </div>

      {/* Entity Fields */}
      <div className="entity-fields-container mt-4">
        <h5 className="mb-3">
          {claimType === "GUARANTOR" ? "Principal Borrower Details" : 
           claimType === "PRINCIPAL_BORROWER" ? "Guarantor Details" : 
           "Beneficiary Details"}
        </h5>
        
        {entityData.map((entity, index) => (
          <div key={entity.id} className="entity-field-group mb-4">
            <div className="d-flex justify-content-between align-items-center mb-3">
              <h6 className="mb-0">
                {claimType === "GUARANTOR" ? "Principal Borrower" : 
                 claimType === "PRINCIPAL_BORROWER" ? "Guarantor" : 
                 "Beneficiary"} {index + 1}
              </h6>
              {entityData.length > 1 && (
                <button
                  type="button"
                  className="btn btn-sm btn-danger"
                  onClick={() => removeEntityField(entity.id)}
                >
                  <FaMinus className="me-1" /> Remove
                </button>
              )}
            </div>
            
            <div className="row g-3">
              <div className="col-md-6">
                <div className="form-group">
                  <label className="form-label">
                    <FaUser className="field-icon me-2" />
                    {claimType === "GUARANTOR" ? "Name of the Principal Borrower" : 
                     claimType === "PRINCIPAL_BORROWER" ? "Name of the Guarantor" : 
                     "Name of the Beneficiary"} <span className="required-asterisk">*</span>
                  </label>
                  <input
                    type="text"
                    className={`form-control ${errors.entityData?.[index]?.name ? "is-invalid" : ""}`}
                    value={entity.name || ""}
                    onChange={(e) => updateEntityDetails(entity.id, "name", e.target.value)}
                    placeholder={`Enter name`}
                  />
                  {errors.entityData?.[index]?.name && (
                    <div className="invalid-feedback">{errors.entityData[index].name.message}</div>
                  )}
                </div>
              </div>
              
              <div className="col-md-6">
                <div className="form-group">
                  <label className="form-label">
                    <FaMapMarkerAlt className="field-icon me-2" />
                    {claimType === "GUARANTOR" ? "Address of the Principal Borrower" : 
                     claimType === "PRINCIPAL_BORROWER" ? "Address of the Guarantor" : 
                     "Address of the Beneficiary"} <span className="required-asterisk">*</span>
                  </label>
                  <input
                    type="text"
                    className={`form-control ${errors.entityData?.[index]?.address ? "is-invalid" : ""}`}
                    value={entity.address || ""}
                    onChange={(e) => updateEntityDetails(entity.id, "address", e.target.value)}
                    placeholder={`Enter address`}
                  />
                  {errors.entityData?.[index]?.address && (
                    <div className="invalid-feedback">{errors.entityData[index].address.message}</div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}

        <button 
          type="button" 
          className="btn btn-outline-primary add-more-btn"
          onClick={addEntityField}
        >
          <FaPlus className="me-2" /> Add {claimType === "GUARANTOR" ? "Principal Borrower" : 
                    claimType === "PRINCIPAL_BORROWER" ? "Guarantor" : "Beneficiary"}
        </button>
      </div>
    </div>
  );
};
