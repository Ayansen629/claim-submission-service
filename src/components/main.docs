export const SURVEY_TABLE_COLUMNS = [
  {
    colName: "Survey ID",
    fieldName: "id",
    clsName: "column-text-start",
  },
  {
    colName: "Survey Type",
    fieldName: "surveyType",
    clsName: "column-text-start",
  },
  {
    colName: "Vessel Name",
    fieldName: "vesselName",
    clsName: "column-text-start",
  },
  {
    colName: "Vessel Type",
    fieldName: "vesselType",
    clsName: "column-text-start",
  },
  {
    colName: "Date Requested",
    fieldName: "dateRequested",
    clsName: "column-text-start",
  },
  {
    colName: "Status",
    fieldName: "status",
    clsName: "column-text-start",
    render: (value) => (
      <span className={`status-badge ${value.toLowerCase().replace(' ', '-')}`}>
        {value}
      </span>
    ),
  },
  {
    colName: "Action",
    fieldName: "action",
    actions: ['view', 'approve', 'reject'],
    clsName: "column-text-start actions-column",
  },
];
