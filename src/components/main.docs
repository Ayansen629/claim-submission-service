import moment from "moment";
import { removeFromLocalStorage, setToLocalStorage } from "./localStorageUtils";

export const CONSTANT_REGEX = {
  PASSWORD: /(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?!.*\s)(?=.*[!@#$*])/,
  ALPHANUMERIC: /^[a-zA-Z0-9]*$/,
  NUMERIC: /^[0-9]*$/,
  ALPHABATE: /^[A-Za-z]+$/,
  ALPHANUMERIC_SPECIAL: /^[a-zA-Z0-9\s,'.-]+$/,
  ALPHABATEWITHSPACE: /^([a-zA-Z]+\s)*[a-zA-Z]+$/,
  GSTNO: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
  PAN: /[A-Z]{5}[0-9]{4}[A-Z]{1}/,
  DL: / ^(([A-Z]{2}[0-9]{2})( )|([A-Z]{2}-[0-9]{2}))((19|20)[0-9][0-9])[0-9]{7}$/,
  NAME: /^(?!.*\s$)[A-Za-z.'-]+( [A-Za-z.'-]+)*$/,

  ONLY_NUM: "^[0-9 .]+$",
  ALPHA_NUM: "^[a-zA-Z0-9 ]+$",
  ONLY_INT: "^[0-9]+$",
  EMAIL: /\w+([-+.']\w+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*/,
  PINCODE: /^[1-9][0-9]{5}$/,
  MOBILE: /^(?:(?:\+|0{0,2})91(\s*[-]\s*)?|[0]?)?(?!.*(\d)\2{5})[6789]\d{9}$/,
  NO_SPACES: /^\S*$/,
  ALPHA_NUM_INPUT: /^[A-Za-z0-9]+( [A-Za-z0-9]+)*$/,
  AADHAR: /^[2-9]{1}[0-9]{3}[0-9]{4}[0-9]{4}$/,
  TRADE_LICENSE: /^[A-Z0-9\/\-]{5,25}$/, // -- Tentative
};

