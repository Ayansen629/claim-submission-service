import React from "react";
import { Controller } from "react-hook-form";
import Tooltip from "@mui/material/Tooltip";
import { FaInfoCircle } from "react-icons/fa";
import DatePicker from "react-datepicker";
import "react-datepicker/dist/react-datepicker.css";
import { Download, CheckCircle } from "lucide-react";
import { Button } from "react-bootstrap";

const DynamicField = ({ fieldConfig, control, register, errors, setValue, trigger, getValues }) => {
  const { name, label, type, options, rules, tooltip, placeholder, disabled } = fieldConfig;
  const hasError = errors[name];
  const [uploadSuccess, setUploadSuccess] = React.useState(false);

  const handleKeyPress = (e) => {
    if (type === "number" && !/^\d$/.test(e.key) && e.key !== "Backspace") {
      e.preventDefault();
    }
  };

  const handleFileChange = async (e) => {
    const file = e.target.files[0];
    if (file && fieldConfig.onFileUpload) {
      try {
        fieldConfig.setIsUploading(true);
        fieldConfig.setUploadError(null);
        setUploadSuccess(false);

        const result = await fieldConfig.onFileUpload(file);

        if (result.success) {
          setValue(name, {
            fileId: result.fileId,
            docName: result.docName,
            docType: result.docType,
            docSource: result.docSource,
            fileUrl: result.fileUrl
          }, { shouldValidate: true });
          setUploadSuccess(true);
        }
      } catch (error) {
        fieldConfig.setUploadError(error.message);
        setValue(name, null, { shouldValidate: true });
        setUploadSuccess(false);
      } finally {
        fieldConfig.setIsUploading(false);
      }
    }
  };

  const renderFilePreview = (fileValue) => {
    if (!fileValue) return null;

    const fileUrl = typeof fileValue === 'object' ? 
      `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileValue.fileId}` : 
      fileValue;

    const fileName = typeof fileValue === 'object' ? 
      fileValue.docName || fileValue.name || 'Uploaded file' : 
      fileValue;

    return (
      <div className="file-preview-container">
        {uploadSuccess && (
          <div className="text-success d-flex align-items-center gap-2 mb-2">
            <CheckCircle size={16} />
            <span>File uploaded successfully!</span>
          </div>
        )}
        <div className="d-flex align-items-center gap-2">
          <span>{fileName}</span>
          <Button
            variant="link"
            size="sm"
            href={fileUrl}
            target="_blank"
            rel="noopener noreferrer"
            download
            className="p-0"
            title="Download file"
          >
            <Download size={16} />
          </Button>
        </div>
      </div>
    );
  };

  return (
    <div className="flex-item">
      <label>
        {label}
        {tooltip && (
          <Tooltip title={tooltip} arrow>
            <span style={{ marginLeft: "5px", cursor: "pointer" }}>
              <FaInfoCircle />
            </span>
          </Tooltip>
        )}
      </label>

      {type === "select" ? (
        <Controller
          name={name}
          control={control}
          rules={rules}
          render={({ field }) => (
            <select
              {...field}
              className={`form-input ${hasError ? "input-error" : ""}`}
              onChange={(e) => {
                field.onChange(e);
                if (fieldConfig.onChange) fieldConfig.onChange(e.target.value);
              }}
              disabled={disabled}
            >
              <option value="" disabled>
                Select {label}
              </option>
              {options.map((option) => (
                <option key={option.value} value={option.value} disabled={option.disabled}>
                  {option.label}
                </option>
              ))}
            </select>
          )}
        />
      ) : type === "date" ? (
        <Controller
          name={name}
          control={control}
          rules={rules}
          render={({ field }) => (
            <DatePicker
              {...field}
              selected={field.value}
              onChange={(date) => {
                setValue(name, date);
                trigger(name);
              }}
              className={`form-input ${hasError ? "input-error" : ""}`}
              dateFormat="yyyy-MM-dd"
              placeholderText={placeholder || "Select a date"}
              disabled={disabled}
            />
          )}
        />
      ) : type === "file" ? (
        <div className="custom-file-input">
          <input
            type="file"
            id={name}
            onChange={handleFileChange}
            className={`form-input ${hasError ? "input-error" : ""}`}
            style={{ display: "none" }}
            disabled={fieldConfig.isUploading || disabled}
            accept={fieldConfig.accept}
          />
          <label
            htmlFor={name}
            className={`file-label ${hasError ? "input-error" : ""} ${fieldConfig.isUploading ? "uploading" : ""}`}
          >
            {fieldConfig.isUploading ? "Uploading..." : "Choose File"}
          </label>

          {getValues(name) && renderFilePreview(getValues(name))}

          {fieldConfig.uploadError && <p className="error-message">{fieldConfig.uploadError}</p>}
          {hasError && !fieldConfig.uploadError && <p className="error-message">{errors[name]?.message}</p>}
        </div>
      ) : type === "textarea" ? (
        <textarea
          {...register(name, rules)}
          className={`form-input ${hasError ? "input-error" : ""}`}
          placeholder={placeholder}
          onChange={(e) => {
            setValue(name, e.target.value);
            trigger(name);
          }}
          disabled={disabled}
        />
      ) : (
        <input
          {...register(name, rules)}
          type={type}
          className={`form-input ${hasError ? "input-error" : ""}`}
          placeholder={placeholder}
          onChange={(e) => {
            setValue(name, e.target.value);
            trigger(name);
          }}
          onKeyPress={handleKeyPress}
          disabled={disabled}
        />
      )}
      {hasError && <p className="error-message">{errors[name]?.message}</p>}
    </div>
  );
};

export default DynamicField;
