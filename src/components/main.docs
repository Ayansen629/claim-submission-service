.container {
  padding: 16px;
  background-color: #f8f9fa;
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  margin-bottom: 24px;
  padding: 16px 20px;
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  border: 1px solid #e9ecef;
  gap: 16px;
}

.backButton {
  border-radius: 10px !important;
  width: 40px;
  height: 40px;
  border: 2px solid #2E57A7 !important;
  color: #2E57A7 !important;
  background-color: #fff !important;
  transition: all 0.3s ease;
  padding: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.backButton:hover {
  background-color: #2E57A7 !important;
  color: #fff !important;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(46, 87, 167, 0.3);
}

.headerContent {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}

.title {
  font-weight: 600;
  color: #2E57A7;
  font-size: 1.3rem;
  line-height: 1.3;
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.applicationId {
  background: linear-gradient(135deg, #e3f2fd, #f3e5f5);
  border-radius: 8px;
  padding: 6px 12px;
  border: 1px solid #bbdefb;
  color: #1976d2;
  font-size: 0.9rem;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

/* Tablet styles */
@media (max-width: 768px) {
  .container {
    padding: 12px;
  }

  .header {
    padding: 12px 16px;
    margin-bottom: 20px;
  }

  .headerContent {
    gap: 12px;
  }

  .title {
    font-size: 1.1rem;
  }

  .applicationId {
    font-size: 0.8rem;
    padding: 4px 8px;
  }
}

/* Mobile styles */
@media (max-width: 480px) {
  .container {
    padding: 8px;
  }

  .header {
    flex-direction: column;
    align-items: flex-start;
    padding: 12px;
    gap: 12px;
  }

  .headerContent {
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .title {
    font-size: 1rem;
    white-space: normal;
    overflow: visible;
    text-overflow: unset;
  }

  .applicationId {
    align-self: flex-start;
    font-size: 0.75rem;
  }

  .backButton {
    align-self: flex-start;
  }
}

/* Extra small mobile */
@media (max-width: 360px) {
  .container {
    padding: 4px;
  }

  .header {
    padding: 8px;
    border-radius: 8px;
  }

  .title {
    font-size: 0.9rem;
  }

  .applicationId {
    font-size: 0.7rem;
    padding: 3px 6px;
  }

  .backButton {
    width: 35px;
    height: 35px;
  }
}
