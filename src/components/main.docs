import React, { useState, useEffect, useRef } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Button, Card, Badge, Stack, Image } from 'react-bootstrap';
import {
  FaUser,
  FaBuilding,
  FaFileUpload,
  FaCheck,
  FaArrowRight,
  FaArrowLeft,
  FaIdCard,
  FaEnvelope,
  FaPhone,
  FaMapMarkerAlt,
  FaShip,
  FaDownload
} from 'react-icons/fa';
import { useNavigate, useParams } from 'react-router-dom';
import ActionDropdown from '../../common/ActionDropdown';
import ApprovalModal from '../../common/ApprovalModal';
import NewLoader from '../../common/NewLoader';
import DynamicViewFields from '../../common/DynamicViewFields';
import { useTranslation } from 'react-i18next';
import IWT_FULL_IMG from '../../../assets/images/iwt-whole.jpg';
import './UserViewPage.css';

const VesselRegistrationViewPage = () => {
  const { t } = useTranslation();
  const { registrationType, id } = useParams();
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(true);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [isCompany, setIsCompany] = useState(false);
  const navigate = useNavigate();
  const loaderRef = useRef();

  const isVesselOwner = registrationType === 'vessel_owner';
  const totalSteps = isVesselOwner ? 3 : 2;

  // Mock data for demonstration
  const mockOwnerData = {
    applicationNumber: "APP-OWNER-2025-001",
    categoryOfOwner: "COMPANY",
    ownerCompanyName: "Marine Transport Ltd",
    emailId: "contact@marinetransport.com",
    phoneNumber: "9876543210",
    cinNo: "U12345WB2025PTC123456",
    dinNo: "12345678",
    panNo: "ABCDE1234F",
    gstNo: "22ABCDE1234F1Z5",
    addressLine1: "123 Marine Drive",
    addressLine2: "Floor 5",
    pin: "700001",
    district: "Kolkata",
    state: "West Bengal",
    country: "India",
    authorisedFname: "John",
    authorisedLname: "Smith",
    authorisedMob: "9876543210",
    authorisedEmail: "john.smith@marinetransport.com",
    authorizationLetter: "authorization_letter.pdf",
    panCardUpload: "pan_card.pdf",
    gstCertificate: "gst_certificate.pdf",
    addressProof: "address_proof.pdf",
    companyRegistrationCertificate: "company_registration.pdf",
    moaCertificate: "moa.pdf",
    aoaCertificate: "aoa.pdf",
    status: "Pending Review"
  };

  const mockBuilderData = {
    applicationNumber: "APP-BUILDER-2025-001",
    builderName: "Ocean Shipbuilders Pvt Ltd",
    emailId: "info@oceanshipbuilders.com",
    phoneNumber: "9876543210",
    panNo: "ABCDE1234F",
    gstNo: "22ABCDE1234F1Z5",
    addressLine1: "456 Shipyard Road",
    addressLine2: "Industrial Area",
    pin: "700001",
    district: "Kolkata",
    state: "West Bengal",
    country: "India",
    companyDetails: "company_details.pdf",
    gstCertificate: "gst_certificate.pdf",
    panCardUpload: "pan_card.pdf",
    factoryLicense: "factory_license.pdf",
    addressProof: "address_proof.pdf",
    fireCertificate: "fire_certificate.pdf",
    esipfRegistration: "esipf_registration.pdf",
    iso9001: "iso9001.pdf",
    iso14001: "iso14001.pdf",
    iso45001: "iso45001.pdf",
    pollutionCertificate: "pollution_certificate.pdf",
    experienceCertificate: "experience_certificate.pdf",
    status: "Pending Review"
  };

  useEffect(() => {
    setIsLoading(true);
    loaderRef.current?.show?.();
    
    // Simulate API call
    setTimeout(() => {
      setFormData(isVesselOwner ? mockOwnerData : mockBuilderData);
      setIsCompany(isVesselOwner && mockOwnerData.categoryOfOwner === "COMPANY");
      setIsLoading(false);
      loaderRef.current?.hide?.();
    }, 500);
  }, [registrationType]);

  const methods = useForm({ defaultValues: { country: 'India' } });
  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading) {
      Object.keys(formData).forEach(key => {
        if (formData[key]) {
          setValue(key, formData[key]);
        }
      });
    }
  }, [isLoading, formData, setValue]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      ...formData,
    };
    console.log("Action submitted:", payload);
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleDownload = (filename) => {
    const blob = new Blob(["Dummy file content"], { type: "text/plain" });
    const link = document.createElement("a");
    link.href = window.URL.createObjectURL(blob);
    link.download = filename;
    link.click();
    window.URL.revokeObjectURL(link.href);
  };

  const renderFileField = (value) => (
    <div className="file-display d-flex align-items-center justify-content-between">
      <span className="file-name">{value || 'No file uploaded'}</span>
      {value && (
        <Button
          variant="link"
          size="sm"
          className="file-download-btn"
          onClick={() => handleDownload(value)}
          tabIndex={-1}
        >
          <FaDownload style={{ fontSize: 18 }} />
        </Button>
      )}
    </div>
  );

  const getFormFieldsConfig = () => {
    const ownerFields = {
      step1: [
        {
          name: "categoryOfOwner",
          label: t("vesselOwnerRegistration.Category of Owner"),
          type: "select",
          options: [
            { value: "INDIVIDUAL", label: "Individual", isCompany: false },
            { value: "COMPANY", label: "Company", isCompany: true },
            { value: "GOVERNMENT", label: "Government", isCompany: false }
          ],
          required: true,
          icon: FaBuilding,
          colSize: 6,
          disabled: true
        },
        {
          name: "ownerCompanyName",
          label: t("vesselOwnerRegistration.Owner/Company Name"),
          type: "text",
          required: true,
          icon: FaUser,
          colSize: 6,
          disabled: true
        },
        {
          name: "emailId",
          label: t("vesselOwnerRegistration.Email ID"),
          type: "email",
          required: true,
          icon: FaEnvelope,
          colSize: 6,
          disabled: true
        },
        {
          name: "phoneNumber",
          label: t("vesselOwnerRegistration.Phone Number"),
          type: "text",
          required: true,
          icon: FaPhone,
          colSize: 6,
          disabled: true
        },
        {
          name: "cinNo",
          label: t("vesselOwnerRegistration.CIN Number"),
          type: "text",
          required: false,
          icon: FaIdCard,
          colSize: 6,
          disabled: true,
          showIf: () => isCompany
        },
        {
          name: "dinNo",
          label: t("vesselOwnerRegistration.DIN Number"),
          type: "text",
          required: false,
          icon: FaIdCard,
          colSize: 6,
          disabled: true,
          showIf: () => isCompany
        },
        {
          name: "panNo",
          label: t("vesselOwnerRegistration.PAN Number"),
          type: "text",
          required: true,
          icon: FaIdCard,
          colSize: 6,
          disabled: true
        },
        {
          name: "gstNo",
          label: t("vesselOwnerRegistration.GST Number"),
          type: "text",
          required: false,
          icon: FaIdCard,
          colSize: 6,
          disabled: true
        },
        {
          name: "addressLine1",
          label: t("vesselOwnerRegistration.Address Line-1"),
          type: "text",
          required: true,
          icon: FaMapMarkerAlt,
          colSize: 6,
          disabled: true
        },
        {
          name: "addressLine2",
          label: t("vesselOwnerRegistration.Address Line-2"),
          type: "text",
          required: false,
          icon: FaMapMarkerAlt,
          colSize: 6,
          disabled: true
        },
        {
          name: "pin",
          label: t("vesselOwnerRegistration.PIN"),
          type: "text",
          required: true,
          icon: FaMapMarkerAlt,
          colSize: 6,
          disabled: true
        },
        {
          name: "district",
          label: t("vesselOwnerRegistration.District"),
          type: "text",
          required: false,
          icon: FaMapMarkerAlt,
          colSize: 6,
          disabled: true
        },
        {
          name: "state",
          label: t("vesselOwnerRegistration.State / UT"),
          type: "text",
          required: false,
          icon: FaMapMarkerAlt,
          colSize: 6,
          disabled: true
        },
        {
          name: "country",
          label: t("vesselOwnerRegistration.Country"),
          type: "text",
          required: false,
          icon: FaMapMarkerAlt,
          colSize: 6,
          disabled: true
        }
      ],
      step2: [
        {
          name: "authorisedFname",
          label: t("vesselOwnerRegistration.First Name"),
          type: "text",
          required: true,
          icon: FaUser,
          colSize: 6,
          disabled: true
        },
        {
          name: "authorisedLname",
          label: t("vesselOwnerRegistration.Last Name"),
          type: "text",
          required: true,
          icon: FaUser,
          colSize: 6,
          disabled: true
        },
        {
          name: "authorisedMob",
          label: t("vesselOwnerRegistration.Primary Mobile Number"),
          type: "text",
          required: true,
          icon: FaPhone,
          colSize: 6,
          disabled: true
        },
        {
          name: "authorisedEmail",
          label: t("vesselOwnerRegistration.Email ID"),
          type: "email",
          required: true,
          icon: FaEnvelope,
          colSize: 6,
          disabled: true
        },
        {
          name: "authorizationLetter",
          label: t("vesselOwnerRegistration.Letter of Authorization"),
          type: "file",
          required: false,
          colSize: 12,
          disabled: true,
          render: renderFileField
        }
      ],
      step3: [
        {
          name: "panCardUpload",
          label: t("vesselOwnerRegistration.PAN Card"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "gstCertificate",
          label: t("vesselOwnerRegistration.GST Certificate"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "addressProof",
          label: t("vesselOwnerRegistration.Address Proof"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "companyRegistrationCertificate",
          label: t("vesselOwnerRegistration.Company Registration Certificate"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField,
          showIf: () => isCompany
        },
        {
          name: "moaCertificate",
          label: t("vesselOwnerRegistration.MOA Certificate"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField,
          showIf: () => isCompany
        },
        {
          name: "aoaCertificate",
          label: t("vesselOwnerRegistration.AOA Certificate"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField,
          showIf: () => isCompany
        }
      ]
    };

    const builderFields = {
      step1: [
        {
          name: "builderName",
          label: t("builderRegistration.builderName"),
          type: "text",
          required: true,
          icon: FaUser,
          colSize: 6,
          disabled: true
        },
        {
          name: "emailId",
          label: t("builderRegistration.Email ID"),
          type: "email",
          required: true,
          icon: FaEnvelope,
          colSize: 6,
          disabled: true
        },
        {
          name: "phoneNumber",
          label: t("builderRegistration.Phone Number"),
          type: "text",
          required: true,
          icon: FaPhone,
          colSize: 6,
          disabled: true
        },
        {
          name: "panNo",
          label: t("builderRegistration.PAN Number"),
          type: "text",
          required: true,
          icon: FaIdCard,
          colSize: 6,
          disabled: true
        },
        {
          name: "gstNo",
          label: t("builderRegistration.GST Number"),
          type: "text",
          required: true,
          icon: FaIdCard,
          colSize: 6,
          disabled: true
        },
        {
          name: "addressLine1",
          label: t("builderRegistration.Address Line-1"),
          type: "text",
          required: true,
          icon: FaMapMarkerAlt,
          colSize: 6,
          disabled: true
        },
        {
          name: "addressLine2",
          label: t("builderRegistration.Address Line-2"),
          type: "text",
          required: false,
          icon: FaMapMarkerAlt,
          colSize: 6,
          disabled: true
        },
        {
          name: "pin",
          label: t("builderRegistration.PIN"),
          type: "text",
          required: true,
          icon: FaMapMarkerAlt,
          colSize: 6,
          disabled: true
        },
        {
          name: "district",
          label: t("builderRegistration.District"),
          type: "text",
          required: false,
          icon: FaMapMarkerAlt,
          colSize: 6,
          disabled: true
        },
        {
          name: "state",
          label: t("builderRegistration.State / UT"),
          type: "text",
          required: false,
          icon: FaMapMarkerAlt,
          colSize: 6,
          disabled: true
        },
        {
          name: "country",
          label: t("builderRegistration.Country"),
          type: "text",
          required: false,
          icon: FaMapMarkerAlt,
          colSize: 6,
          disabled: true
        }
      ],
      step2: [
        {
          name: "companyDetails",
          label: t("builderRegistration.Company Details"),
          type: "file",
          required: true,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "gstCertificate",
          label: t("builderRegistration.GST Certificate"),
          type: "file",
          required: true,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "panCardUpload",
          label: t("builderRegistration.PAN Card"),
          type: "file",
          required: true,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "factoryLicense",
          label: t("builderRegistration.Factory License"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "addressProof",
          label: t("builderRegistration.Address Proof"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "fireCertificate",
          label: t("builderRegistration.Fire Certificate"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "esipfRegistration",
          label: t("builderRegistration.ESIPF Registration"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "iso9001",
          label: t("builderRegistration.ISO 9001 Certificate"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "iso14001",
          label: t("builderRegistration.ISO 14001 Certificate"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "iso45001",
          label: t("builderRegistration.ISO 45001 Certificate"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "pollutionCertificate",
          label: t("builderRegistration.Pollution Certificate"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField
        },
        {
          name: "experienceCertificate",
          label: t("builderRegistration.Experience Certificate"),
          type: "file",
          required: false,
          colSize: 6,
          disabled: true,
          render: renderFileField
        }
      ]
    };

    return isVesselOwner ? ownerFields : builderFields;
  };

  const formFields = getFormFieldsConfig();

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return formFields.step1.filter(field => !field.showIf || field.showIf());
      case 2: return formFields.step2.filter(field => !field.showIf || field.showIf());
      case 3: return formFields.step3 ? formFields.step3.filter(field => !field.showIf || field.showIf()) : [];
      default: return [];
    }
  };

  const handleNext = () => {
    if (currentStep < totalSteps) {
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const handleBackToList = () => {
    navigate('/registrations');
  };

  const getStatusBadge = (status) => {
    const statusMap = {
      'Pending Review': 'warning',
      'Approved': 'success',
      'Rejected': 'danger',
      'Processing': 'info'
    };
    return <Badge bg={statusMap[status] || 'secondary'} className="status-badge" text='white'>{status}</Badge>;
  };

  const stepTitles = isVesselOwner ? [
    {
      title: t("vesselOwnerRegistration.Vessel Owner Details"),
      icon: FaBuilding,
    },
    {
      title: t("vesselOwnerRegistration.Authorized Person's Details"),
      icon: FaUser,
    },
    {
      title: t("vesselOwnerRegistration.Documents Upload"),
      icon: FaFileUpload,
    },
  ] : [
    {
      title: t("builderRegistration.Vessel Builder Details"),
      icon: FaBuilding,
    },
    {
      title: t("builderRegistration.Documents Upload"),
      icon: FaFileUpload,
    }
  ];

  if (isLoading) {
    return <NewLoader ref={loaderRef} />;
  }

  return (
    <>
      <Container fluid className="registration-view-container py-5">
        <Row className="justify-content-center">
          <Col lg={10} xl={9}>
            <Card className="registration-card">
              <Card.Header className="registration-header p-0">
                <div className="registration-header-content">
                  <div className="header-logo-container">
                    <Image
                      src={IWT_FULL_IMG}
                      alt="IWT Logo"
                      className="header-logo"
                    />
                  </div>
                  <h3 className="header-title">
                    {isVesselOwner 
                      ? t("vesselOwnerRegistration.Vessel Owner Registration") 
                      : t("builderRegistration.Vessel Builder Registration")}
                  </h3>
                </div>
              </Card.Header>

              <Card.Body className="registration-body p-4 p-md-5">
                <Stack direction="horizontal" gap={3} className="flex-wrap justify-content-between align-items-center mb-4">
                  <Button
                    variant="outline-primary"
                    onClick={handleBackToList}
                    className="back-button"
                  >
                    <FaArrowLeft className="me-2" />
                    Back to List
                  </Button>

                  <div className="d-flex flex-wrap align-items-center justify-content-center gap-2">
                    <span className="application-label fw-semibold text-muted">Application Number:</span>
                    <span className="application-number px-3 py-1 rounded-pill fw-semibold">
                      {formData.applicationNumber}
                    </span>
                  </div>

                  <div style={{ width: 160 }}>
                    {getStatusBadge(formData.status)}
                  </div>
                </Stack>

                <FormProvider {...methods}>
                  <form>
                    <div className="stepper-container mb-5">
                      <div className="stepper d-flex justify-content-between">
                        {stepTitles.map((step, index) => (
                          <React.Fragment key={index}>
                            <div
                              className={`step ${
                                currentStep >= index + 1 ? "active" : ""
                              } ${
                                currentStep > index + 1 ? "completed" : ""
                              } flex-grow-1 text-center`}
                            >
                              <div
                                className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2"
                                style={{
                                  width: "60px",
                                  height: "60px",
                                  borderRadius: "50%",
                                  fontSize: "20px",
                                  fontWeight: "bold",
                                  boxShadow:
                                    currentStep >= index + 1
                                      ? "0 5px 15px rgba(0, 119, 182, 0.3)"
                                      : "0 4px 10px rgba(0, 0, 0, 0.1)",
                                  background:
                                    currentStep >= index + 1
                                      ? currentStep > index + 1
                                        ? "linear-gradient(135deg, #28a745, #20c997)"
                                        : "linear-gradient(135deg, #0077b6, #023e8a)"
                                      : "#ffffff",
                                  border:
                                    currentStep >= index + 1
                                      ? "none"
                                      : "2px solid #e9ecef",
                                  color:
                                    currentStep >= index + 1 ? "#fff" : "#6c757d",
                                  transition: "all 0.4s ease",
                                }}
                              >
                                {currentStep > index + 1 ? (
                                  <FaCheck size={22} />
                                ) : (
                                  React.createElement(
                                    stepTitles[index].icon,
                                    { size: 22 }
                                  )
                                )}
                              </div>
                              <div
                                className="step-label fw-bold"
                                style={{
                                  color:
                                    currentStep >= index + 1
                                      ? currentStep > index + 1
                                        ? "#28a745"
                                        : "#0077b6"
                                      : "#6c757d",
                                  fontSize: "0.9rem",
                                  transition: "all 0.3s ease",
                                }}
                              >
                                {stepTitles[index].title}
                              </div>
                            </div>
                            {index < stepTitles.length - 1 && (
                              <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                                <div
                                  className={`connector-line w-100 ${
                                    currentStep > index + 1 ? "active" : ""
                                  }`}
                                  style={{
                                    height: "4px",
                                    background:
                                      currentStep > index + 1
                                        ? "linear-gradient(to right, #28a745, #20c997)"
                                        : "#e9ecef",
                                    borderRadius: "2px",
                                    transition: "all 0.5s ease",
                                  }}
                                ></div>
                              </div>
                            )}
                          </React.Fragment>
                        ))}
                      </div>
                    </div>

                    <div className="step-content">
                      <div className="form-section p-4 rounded mb-4">
                        <div className="section-title">
                          {React.createElement(
                            stepTitles[currentStep - 1].icon,
                            { className: "section-icon" }
                          )}
                          <h4 className="mb-0 fw-bold">
                            {stepTitles[currentStep - 1].title}
                          </h4>
                        </div>

                        <div className="form-content py-3">
                          <Row className="g-3">
                            <DynamicViewFields
                              fields={getCurrentStepFields()}
                              setFormData={setFormData}
                            />
                          </Row>
                        </div>
                      </div>
                    </div>

                    <div className="form-navigation mt-4" style={{ display: "block" }}>
                      {currentStep > 1 && (
                        <Button
                          variant="outline-secondary"
                          onClick={handlePrevious}
                          className="prev-btn"
                          style={{ float: "left" }}
                        >
                          <FaArrowLeft className="btn-icon me-2" /> Previous
                        </Button>
                      )}

                      {currentStep < totalSteps ? (
                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="next-btn"
                          style={{ float: "right" }}
                        >
                          Next <FaArrowRight className="btn-icon ms-2" />
                        </Button>
                      ) : (
                        <div style={{ float: "right" }} className="d-flex flex-column align-items-center">
                          <ActionDropdown 
                            actions={["Approve", "Reject", "Request Changes"]} 
                            onActionClick={handleActionClick} 
                          />
                        </div>
                      )}
                    </div>
                  </form>
                </FormProvider>
              </Card.Body>
            </Card>
          </Col>
        </Row>

        <ApprovalModal
          show={showApprovalModal}
          handleClose={handleCloseModal}
          handleSubmitData={handleActionSubmit}
          selectedAction={selectedAction}
        />
      </Container>
    </>
  );
};

export default VesselRegistrationViewPage;
