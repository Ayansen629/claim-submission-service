import React, { useState } from "react";
import { Modal, Button, Container, Row, Col, Table } from "react-bootstrap";
import { FaDownload, FaClipboardList, FaFilePdf, FaBuilding, FaUser, FaIdCard, FaMoneyBillWave, FaUniversity, FaSignature, FaFileAlt, FaUsers } from "react-icons/fa";
import { PDFDownloadLink, Document, Page, Text, View, StyleSheet } from '@react-pdf/renderer';
import PreviewCard from "../../private/stepperForm/common-design/PreviewCard";
import Collapsible from "../../private/stepperForm/common-design/Collapsible";
import "./ApplicationDetailsView.css";

const ApplicationDetailsView = ({ show, onHide, modalData, fullModelData, handleDownload }) => {
  console.log("modalData", modalData);
  console.log("fullModelData", fullModelData);
  const [showDocumentModal, setShowDocumentModal] = useState(false);
  
  // PDF Document component
  const MyDocument = ({ modalData, fullModelData }) => (
    <Document>
      <Page style={styles.page}>
        <View style={styles.section}>
          <Text style={styles.header}>Application Details</Text>
          <Text style={styles.subHeader}>Application Number: {modalData?.applicationNumber || "N/A"}</Text>
          
          {/* Creditor & Identification Details */}
          <Text style={styles.sectionHeader}>Creditor & Identification Details</Text>
          {modalData?.step1?.creditorDetails && Object.entries(modalData.step1.creditorDetails).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
          ))}
          {modalData?.step1?.identificationDetails && Object.entries(modalData.step1.identificationDetails).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {typeof value === 'string' ? value : "See document"}</Text>
          ))}
          
          {/* Claim Details */}
          <Text style={styles.sectionHeader}>Claim Details</Text>
          {modalData?.step2?.claimDetails && Object.entries(modalData.step2.claimDetails).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {typeof value === 'string' ? value : "See document"}</Text>
          ))}
          
          {/* Bank Details */}
          <Text style={styles.sectionHeader}>Bank Details</Text>
          {modalData?.step2?.bankDetails && Object.entries(modalData.step2.bankDetails).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
          ))}
          
          {/* Supporting Documents */}
          <Text style={styles.sectionHeader}>Supporting Documents</Text>
          {modalData?.step2?.supportingDocuments && Object.entries(modalData.step2.supportingDocuments).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {typeof value === 'string' ? value : "See document"}</Text>
          ))}
          
          {/* Signatory Details */}
          <Text style={styles.sectionHeader}>Signatory Details</Text>
          {modalData?.step3?.signatoryDetails && Object.entries(modalData.step3.signatoryDetails).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {typeof value === 'string' ? value : "See document"}</Text>
          ))}
        </View>
      </Page>
    </Document>
  );

  // PDF styles
  const styles = StyleSheet.create({
    page: {
      padding: 30,
    },
    header: {
      fontSize: 24,
      marginBottom: 10,
      textAlign: 'center',
      fontWeight: 'bold',
    },
    subHeader: {
      fontSize: 16,
      marginBottom: 20,
      textAlign: 'center',
    },
    sectionHeader: {
      fontSize: 18,
      marginTop: 15,
      marginBottom: 10,
      fontWeight: 'bold',
      borderBottom: '1 solid #000',
    },
    text: {
      fontSize: 12,
      marginBottom: 5,
    },
    section: {
      marginBottom: 10,
    },
  });

  // Function to get all documents from fullModelData
  const getAllDocuments = () => {
    const documents = [];
    
    // Add identification documents
    if (fullModelData?.creditorBasicDetails?.identificationTypeDetails?.identifications) {
      fullModelData.creditorBasicDetails.identificationTypeDetails.identifications.forEach((id, index) => {
        if (id.proofOfIdentificationDocuments?.docId) {
          documents.push({
            id: documents.length + 1,
            name: `Identification Document ${index + 1}`,
            docName: id.proofOfIdentificationDocuments.docName || "No name",
            docId: id.proofOfIdentificationDocuments.docId,
            docType: id.proofOfIdentificationDocuments.docType || "Document"
          });
        }
      });
    }
    
    // Add signature document
    if (fullModelData?.signatoryDetails?.document?.docId) {
      documents.push({
        id: documents.length + 1,
        name: "Signature Document",
        docName: fullModelData.signatoryDetails.document.docName || "No name",
        docId: fullModelData.signatoryDetails.document.docId,
        docType: fullModelData.signatoryDetails.document.docType || "Document"
      });
    }
    
    // Add supporting documents
    if (fullModelData?.supportingDocument?.documents) {
      fullModelData.supportingDocument.documents.forEach((doc, index) => {
        if (doc.docId) {
          documents.push({
            id: documents.length + 1,
            name: `${doc.docType || "Supporting"} Document`,
            docName: doc.docName || "No name",
            docId: doc.docId,
            docType: doc.docType || "Document"
          });
        }
      });
    }
    
    return documents;
  };

  const allDocuments = getAllDocuments();

  if (!modalData) return null;

  return (
    <Modal
      show={show}
      onHide={onHide}
      dialogClassName="modal-1110w application-details-modal"
      aria-labelledby="application-details-title"
      centered
    >
      <Modal.Header closeButton className="modal-header">
        <Modal.Title id="application-details-title" className="modal-title">
          <FaFileAlt className="modal-title-icon" />
          Application Details
        </Modal.Title>
      </Modal.Header>
      
      <Modal.Body className="modal-body">
        <div className="application-header-container">
          <div className="application-number-container">
            <h4 className="application-number-label">Application Number:</h4>
            <div className="application-number-value">
              {modalData.applicationNumber || "N/A"}
            </div>
          </div>
          
          <div className="application-status-container">
            <h4 className="application-status-label">Status:</h4>
            <div className={`application-status-value status-${fullModelData.status?.toLowerCase() || "pending"}`}>
              {fullModelData.status || "Pending"}
            </div>
          </div>
          
          <button 
            className="action-button"
            onClick={() => setShowDocumentModal(true)}
            aria-label="View Documents"
          >
            <FaClipboardList />
          </button>
        </div>

        {/* Document Modal */}
        {showDocumentModal && (
          <div className="document-modal">
            <div className="document-modal-content">
              <div className="document-modal-header">
                <h2 className="document-modal-title">
                  Documents for Application
                </h2>
                <button 
                  className="document-modal-close"
                  onClick={() => setShowDocumentModal(false)}
                  aria-label="Close"
                >
                  &times;
                </button>
              </div>

              <Table className="document-table" responsive>
                <thead>
                  <tr>
                    <th style={{ width: "10%" }}>SL #</th>
                    <th style={{ width: "20%" }}>Document Type</th>
                    <th style={{ width: "50%" }}>Document Name</th>
                    <th style={{ width: "20%" }}>Action</th>
                  </tr>
                </thead>
                <tbody>
                  {allDocuments.length > 0 ? (
                    allDocuments.map((doc) => (
                      <tr key={doc.id}>
                        <td>{doc.id}</td>
                        <td>{doc.docType}</td>
                        <td>
                          <div className="document-name">
                            <FaFilePdf className="document-icon" />
                            {doc.docName}
                          </div>
                        </td>
                        <td>
                          <button
                            className="download-button"
                            onClick={() => handleDownload(doc.docId, doc.docName)}
                          >
                            <FaDownload className="download-icon" />
                            Download
                          </button>
                        </td>
                      </tr>
                    ))
                  ) : (
                    <tr>
                      <td colSpan="4" className="text-center">No documents available</td>
                    </tr>
                  )}
                  <tr>
                    <td>{allDocuments.length + 1}</td>
                    <td>PDF</td>
                    <td>
                      <div className="document-name">
                        <FaFilePdf className="document-icon" />
                        Full Application Form
                      </div>
                    </td>
                    <td>
                      <PDFDownloadLink 
                        document={<MyDocument modalData={modalData} fullModelData={fullModelData} />} 
                        fileName={`application_${modalData.applicationNumber || 'form'}.pdf`}
                      >
                        {({ loading }) => (
                          <button
                            className="download-button"
                            disabled={loading}
                          >
                            {loading ? 'Generating...' : (
                              <>
                                <FaDownload className="download-icon" />
                                Download
                              </>
                            )}
                          </button>
                        )}
                      </PDFDownloadLink>
                    </td>
                  </tr>
                </tbody>
              </Table>

              <div className="document-modal-footer">
                <Button variant="secondary" onClick={() => setShowDocumentModal(false)}>
                  Close
                </Button>
              </div>
            </div>
          </div>
        )}

        {/* Application UUID */}
        <div className="details-card mb-3">
          <div className="details-card-header">
            <h5 className="details-card-title">
              <FaFileAlt className="details-card-title-icon" />
              Application Information
            </h5>
          </div>
          <div className="details-card-body">
            <Container fluid>
              <Row className="g-3">
                <Col xs={12} sm={6} md={4} className="mb-3">
                  <PreviewCard title="UUID" value={fullModelData.uuid || "N/A"} />
                </Col>
                <Col xs={12} sm={6} md={4} className="mb-3">
                  <PreviewCard title="Final Submit" value={fullModelData.isFinalSubmit ? "Yes" : "No"} />
                </Col>
                <Col xs={12} sm={6} md={4} className="mb-3">
                  <PreviewCard title="Active" value={fullModelData.isActive ? "Yes" : "No"} />
                </Col>
              </Row>
            </Container>
          </div>
        </div>

        {/* Creditor & Identification Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaUser className="me-2" />
              <span>Creditor & Identification Details</span>
            </div>
          }
          defaultOpen={true}
        >
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaUser className="details-card-title-icon" />
                Creditor Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step1?.creditorDetails && Object.entries(modalData.step1.creditorDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
          
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaIdCard className="details-card-title-icon" />
                Identification Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step1?.identificationDetails && Object.entries(modalData.step1.identificationDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={key === "Identification Records" ? 12 : 4} className="mb-3">
                      <PreviewCard 
                        title={key} 
                        value={
                          key === "Proof Documents" && value ? (
                            <div className="d-flex align-items-center">
                              <span className="me-2">{value}</span>
                              {fullModelData?.creditorBasicDetails?.identificationTypeDetails?.identifications?.length > 0 && (
                                <Button 
                                  variant="link" 
                                  size="sm" 
                                  className="download-btn p-0"
                                  onClick={() => handleDownload(
                                    fullModelData.creditorBasicDetails.identificationTypeDetails.identifications[0].proofOfIdentificationDocuments.docId,
                                    fullModelData.creditorBasicDetails.identificationTypeDetails.identifications[0].proofOfIdentificationDocuments.docName
                                  )}
                                >
                                  <FaDownload />
                                </Button>
                              )}
                            </div>
                          ) : value || "N/A"
                        } 
                      />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
        </Collapsible>

        {/* Claim Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaMoneyBillWave className="me-2" />
              <span>Claim Details</span>
            </div>
          }
          defaultOpen={true}
        >
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaMoneyBillWave className="details-card-title-icon" />
                Claim Information
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.claimDetails && Object.entries(modalData.step2.claimDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={key.includes("Details") ? 6 : 3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
          
          {/* Guarantor Details Section */}
          {fullModelData?.claimDetails?.guarantorDetails?.length > 0 && (
            <div className="details-card">
              <div className="details-card-header">
                <h5 className="details-card-title">
                  <FaUsers className="details-card-title-icon" />
                  Guarantor Details
                </h5>
              </div>
              <div className="details-card-body">
                <Container fluid>
                  {fullModelData.claimDetails.guarantorDetails.map((guarantor, index) => (
                    <div key={index} className="entity-card mb-3">
                      <h6 className="entity-title">Guarantor {index + 1}</h6>
                      <Row className="g-3">
                        <Col xs={12} sm={6}>
                          <PreviewCard title="Name" value={guarantor.name || "N/A"} />
                        </Col>
                        <Col xs={12} sm={6}>
                          <PreviewCard title="Address" value={guarantor.address || "N/A"} />
                        </Col>
                      </Row>
                    </div>
                  ))}
                </Container>
              </div>
            </div>
          )}
          
          {/* Principal Borrower Details Section */}
          {fullModelData?.claimDetails?.principalBorrowerDetails?.length > 0 && (
            <div className="details-card">
              <div className="details-card-header">
                <h5 className="details-card-title">
                  <FaUsers className="details-card-title-icon" />
                  Principal Borrower Details
                </h5>
              </div>
              <div className="details-card-body">
                <Container fluid>
                  {fullModelData.claimDetails.principalBorrowerDetails.map((borrower, index) => (
                    <div key={index} className="entity-card mb-3">
                      <h6 className="entity-title">Principal Borrower {index + 1}</h6>
                      <Row className="g-3">
                        <Col xs={12} sm={6}>
                          <PreviewCard title="Name" value={borrower.name || "N/A"} />
                        </Col>
                        <Col xs={12} sm={6}>
                          <PreviewCard title="Address" value={borrower.address || "N/A"} />
                        </Col>
                      </Row>
                    </div>
                  ))}
                </Container>
              </div>
            </div>
          )}
          
          {/* Beneficiary Details Section */}
          {fullModelData?.claimDetails?.beneficiaryDetails?.length > 0 && (
            <div className="details-card">
              <div className="details-card-header">
                <h5 className="details-card-title">
                  <FaUsers className="details-card-title-icon" />
                  Beneficiary Details
                </h5>
              </div>
              <div className="details-card-body">
                <Container fluid>
                  {fullModelData.claimDetails.beneficiaryDetails.map((beneficiary, index) => (
                    <div key={index} className="entity-card mb-3">
                      <h6 className="entity-title">Beneficiary {index + 1}</h6>
                      <Row className="g-3">
                        <Col xs={12} sm={6}>
                          <PreviewCard title="Name" value={beneficiary.name || "N/A"} />
                        </Col>
                        <Col xs={12} sm={6}>
                          <PreviewCard title="Address" value={beneficiary.address || "N/A"} />
                        </Col>
                      </Row>
                    </div>
                  ))}
                </Container>
              </div>
            </div>
          )}
          
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaUniversity className="details-card-title-icon" />
                Bank Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.bankDetails && Object.entries(modalData.step2.bankDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={key === "Branch Address" ? 12 : 3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
          
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaIdCard className="details-card-title-icon" />
                Supporting Documents
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {fullModelData?.supportingDocument?.documents?.map((doc, index) => (
                    <Col key={index} xs={12} sm={6} className="mb-3">
                      <PreviewCard 
                        title={`${doc.docType || "Document"} (${doc.docSource || ""})`}
                        value={
                          <div className="d-flex align-items-center">
                            <span className="me-2">{doc.docName || "No name"}</span>
                            <Button 
                              variant="link" 
                              size="sm" 
                              className="download-btn p-0"
                              onClick={() => handleDownload(doc.docId, doc.docName)}
                            >
                              <FaDownload />
                            </Button>
                          </div>
                        } 
                      />
                    </Col>
                  ))}
                  
                  {(!fullModelData?.supportingDocument?.documents || fullModelData.supportingDocument.documents.length === 0) && (
                    <Col xs={12}>
                      <div className="text-center p-3">No supporting documents available</div>
                    </Col>
                  )}
                </Row>
              </Container>
            </div>
          </div>
        </Collapsible>

        {/* Signatory Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaSignature className="me-2" />
              <span>Signatory Details</span>
            </div>
          }
          defaultOpen={true}
        >
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaSignature className="details-card-title-icon" />
                Signatory Information
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  <Col xs={12} sm={6} md={3} className="mb-3">
                    <PreviewCard title="Name" value={fullModelData?.signatoryDetails?.financialCreditorName || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={3} className="mb-3">
                    <PreviewCard title="Position" value={fullModelData?.signatoryDetails?.positionOfCreditor || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={3} className="mb-3">
                    <PreviewCard title="Signature Text" value={fullModelData?.signatoryDetails?.signatureFinancialCreditor || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={3} className="mb-3">
                    <PreviewCard title="Has Uploaded Signature" value={fullModelData?.signatoryDetails?.isSignatureToUpload ? "Yes" : "No"} />
                  </Col>
                  <Col xs={12} className="mb-3">
                    <PreviewCard title="Address" value={fullModelData?.signatoryDetails?.addressOfSigningPerson || "N/A"} />
                  </Col>
                  
                  {fullModelData?.signatoryDetails?.document?.docId && (
                    <Col xs={12} sm={6} className="mb-3">
                      <PreviewCard 
                        title="Signature Document" 
                        value={
                          <div className="d-flex align-items-center">
                            <span className="me-2">{fullModelData.signatoryDetails.document.docName || "Signature Document"}</span>
                            <Button 
                              variant="link" 
                              size="sm" 
                              className="download-btn p-0"
                              onClick={() => handleDownload(
                                fullModelData.signatoryDetails.document.docId,
                                fullModelData.signatoryDetails.document.docName || "signature.pdf"
                              )}
                            >
                              <FaDownload />
                            </Button>
                          </div>
                        } 
                      />
                    </Col>
                  )}
                </Row>
              </Container>
            </div>
          </div>
        </Collapsible>
        
        {/* Audit Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaFileAlt className="me-2" />
              <span>Audit Information</span>
            </div>
          }
          defaultOpen={false}
        >
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaFileAlt className="details-card-title-icon" />
                Audit Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  <Col xs={12} sm={6} md={3} className="mb-3">
                    <PreviewCard title="Created By" value={fullModelData?.auditDetails?.createdBy || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={3} className="mb-3">
                    <PreviewCard title="Created Time" value={fullModelData?.auditDetails?.createdTime || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={3} className="mb-3">
                    <PreviewCard title="Last Modified By" value={fullModelData?.auditDetails?.lastModifiedBy || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={3} className="mb-3">
                    <PreviewCard title="Last Modified Time" value={fullModelData?.auditDetails?.lastModifiedTime || "N/A"} />
                  </Col>
                </Row>
              </Container>
            </div>
          </div>
        </Collapsible>
      </Modal.Body>
      
      <Modal.Footer className="modal-footer">
        <Button variant="secondary" onClick={onHide}>
          Close
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default ApplicationDetailsView;
