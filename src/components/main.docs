// In your VesselBuilderRegistrationPage component
const methods = useForm({
  mode: 'onBlur',
  defaultValues: { country: 'India' },
  resolver: async (values) => {
    const errors = {};
    const requiredFiles = formFields.step2
      .filter(field => field.type === 'file' && field.required)
      .map(field => field.name);

    requiredFiles.forEach(fieldName => {
      if (!values[fieldName]) {
        errors[fieldName] = {
          type: 'required',
          message: `${fieldName.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase())} is required`
        };
      }
    });

    return {
      values,
      errors
    };
  }
});

const validateStep = async () => {
  const currentFields = getCurrentStepFields();
  const requiredFields = currentFields
    .filter(field => field.required && (!field.showIf || field.showIf()));

  // First validate all required fields
  const validationResults = await Promise.all(
    requiredFields.map(field => trigger(field.name))
  );

  // Check if all validations passed
  const isStepValid = validationResults.every(result => result);

  if (!isStepValid) {
    // Find the first error and scroll to it
    const firstErrorField = requiredFields.find(field => methods.formState.errors[field.name]);
    if (firstErrorField) {
      const element = document.getElementById(firstErrorField.name);
      if (element) {
        element.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      setValidationMessage("Please fill all required fields correctly");
    }
    return false;
  }

  return true;
};
