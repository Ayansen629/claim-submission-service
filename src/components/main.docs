const handleFormSubmit = async (stepInfo) => {
  window.scrollTo({ top: 0, behavior: "smooth" });

  // Step 0: Initial Survey Form
  if (stepInfo.index === 0) {
    const formValues = stepInfo?.getFormData?.() || {};
    const surveyPayload = buildSurveyPayload(formValues, registrationData);
    submitIntialSurveyData(surveyPayload, stepInfo);
  }

  // Step 1: Equipment Form
  if (stepInfo.index === 1) {
    const formValues = stepInfo?.getFormData?.() || {};
    const equipmentPayload = buildEquipmentPayload(formValues, intialSurveyData);
    if (isOfficerLogin && isViewMode) {
      await submitIntialSurveyData(equipmentPayload, null);
      return;
    }
    submitIntialSurveyData(equipmentPayload, stepInfo);
  }

  // Step 2: Book of Registration - ADD VALIDATION CHECK
  if (stepInfo.index === 2) {
    // Trigger validation first
    const isValid = await validateBookForm();
    if (!isValid) {
      toast.error("Please fill all required fields before proceeding.");
      return; // Stop execution if validation fails
    }
    
    const success = await handleBookOfRegistrationSubmit(); 
    if (success) {
      stepperRef.current?.goToNextStep(); 
    }
  }

  // Step 3: Certificate of Registration  
  if (stepInfo.index === 3) {
    const formValues = stepInfo?.getFormData?.() || {};
    console.log("=== CERTIFICATE PAYLOAD ===", formValues);
    stepperRef.current?.goToNextStep();
  }
};
const validateBookForm = async () => {
  console.log("validateBookForm -> ", methods?.getValues());
  
  if (isViewMode) return true;
  
  const requiredFields = [
    "bookOfRegistration.engine.engineNo",
    "bookOfRegistration.engine.description", 
    "bookOfRegistration.engine.cylindersPerSet",
    "bookOfRegistration.engine.nhp",
    "bookOfRegistration.engine.ihp",
    "bookOfRegistration.propulsion.propulsionType",
  ];

  // This will trigger validation and show errors
  const isValid = await trigger(requiredFields);
  
  // Force form to show all errors
  if (!isValid) {
    await trigger(); // Trigger all validations
  }
  
  return isValid;
};

