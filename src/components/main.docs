import React, { useState, useEffect } from 'react';
import { Table, Dropdown, Form, Button, Tooltip, OverlayTrigger } from 'react-bootstrap';
import {
    PencilSquare,
    Eye,
    Trash3,
    GeoAltFill,
    Plus,
    ArrowDown,
    ArrowUp,
    Database,
    Check,
    Calendar,
    FileEarmarkText,
    Download,
    CheckSquareFill
} from 'react-bootstrap-icons';
import { useNavigate } from 'react-router-dom';
import './ActionTable.module.css';

const ActionTable = (props) => {
    // ... (keep all existing state and logic)

    return (
        <div className="mb-5 generic-action-table pt-4 mx-3">
            {/* Search and Filter Controls */}

            {/* Table */}
            <div className="table-responsive mb-3">
                <Table className="table align-middle">
                    <thead className="table-primary">
                        <tr>
                            <th style={{ width: '60px', paddingLeft: '20px' }}>
                                <div className="custom-checkbox">
                                    <Form.Check
                                        type="checkbox"
                                        checked={selected.length > 0 && selected.length === currentItems.length}
                                        onChange={handleSelectAll}
                                        ref={input => input && (input.indeterminate = selected.length > 0 && selected.length < currentItems.length)}
                                    />
                                </div>
                            </th>
                            {/* Other headers */}
                        </tr>
                    </thead>
                    <tbody>
                        {currentItems.map((row) => (
                            <tr key={row.id}>
                                <td style={{ paddingLeft: '20px' }}>
                                    <div className="custom-checkbox">
                                        <Form.Check
                                            type="checkbox"
                                            checked={isSelected(row.id)}
                                            onChange={(e) => handleRowSelect(e, row)}
                                        />
                                    </div>
                                </td>
                                
                                {/* Other cells */}
                                
                                <td className="text-center">
                                    <div className="d-flex justify-content-center gap-2 px-2">
                                        {/* Edit Button with proper disabled state */}
                                        {col.actions?.includes("edit") && (
                                            <OverlayTrigger overlay={<Tooltip>{row.applicationStatus !== "Sent back" && row.applicationStatus !== "Draft" ? "Editing disabled" : "Edit"}</Tooltip>}>
                                                <Button
                                                    variant="outline-primary"
                                                    size="sm"
                                                    disabled={row.applicationStatus !== "Sent back" && row.applicationStatus !== "Draft"}
                                                    onClick={() => handleEdit(row)}
                                                    className="action-btn"
                                                >
                                                    <PencilSquare className={`action-icon ${row.applicationStatus !== "Sent back" && row.applicationStatus !== "Draft" ? "disabled-icon" : ""}`} />
                                                </Button>
                                            </OverlayTrigger>
                                        )}

                                        {/* Delete Button with proper spacing */}
                                        {col.actions?.includes("delete") && (
                                            <OverlayTrigger overlay={<Tooltip>Delete</Tooltip>}>
                                                <div className="ms-2"> {/* Added spacing here */}
                                                    <Button 
                                                        variant="outline-danger" 
                                                        size="sm" 
                                                        onClick={() => handleDeleteRow(row)}
                                                        className="action-btn"
                                                    >
                                                        <Trash3 className="action-icon" />
                                                    </Button>
                                                </div>
                                            </OverlayTrigger>
                                        )}
                                    </div>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </Table>
            </div>

            {/* Table Footer */}
        </div>
    );
};

export default ActionTable;
/* Checkbox Styles */
.custom-checkbox {
    position: relative;
}

.custom-checkbox .form-check-input {
    width: 20px;
    height: 20px;
    cursor: pointer;
    margin: 0;
    position: relative;
    border: 2px solid #269ccc;
}

.custom-checkbox .form-check-input:checked {
    background-color: #269ccc;
    border-color: #269ccc;
}

.custom-checkbox .form-check-input:indeterminate {
    background-color: #269ccc;
    border-color: #269ccc;
}

/* Action Icons */
.action-icon {
    font-size: 1.2rem;
    transition: all 0.2s;
}

.disabled-icon {
    color: #adb5bd !important;
}

.action-btn {
    padding: 0.35rem 0.5rem;
    border-radius: 4px;
}

.action-btn:disabled {
    background-color: #f8f9fa;
    border-color: #dee2e6;
}

/* Delete Button Spacing */
.btn-outline-danger {
    margin-left: 8px;
}

/* Table Cell Padding */
.table td, .table th {
    padding: 12px 8px;
}

/* Responsive Adjustments */
@media (max-width: 768px) {
    .custom-checkbox .form-check-input {
        width: 18px;
        height: 18px;
    }
    
    .action-icon {
        font-size: 1.1rem;
    }
    
    .table td, .table th {
        padding: 10px 6px;
    }
}
