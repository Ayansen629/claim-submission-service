.custom-sidebar {
  background: linear-gradient(135deg, #f4f8fc 0%, #e8f2ff 100%);
  color: #2466bf;
  height: calc(100vh - 60px);
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  overflow: hidden;
  padding-top: 0;
  box-shadow: 0 4px 20px rgba(36, 102, 191, 0.15);
  border-right: 1px solid #d1e7ff;
  position: fixed;
  top: 75px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  will-change: width, transform;
  backdrop-filter: blur(10px);
}

.custom-sidebar.collapsed {
  width: 70px;
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.custom-sidebar.expanded {
  width: 18rem;
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.custom-sidebar-menu,
.custom-sidebar-submenu-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.custom-sidebar-item {
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  margin: 2px 8px;
  border-radius: 12px;
  overflow: hidden;
}

.custom-sidebar-item.active > .custom-sidebar-link {
  background: linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%);
  color: white;
  font-weight: 600;
  box-shadow: 0 4px 15px rgba(36, 102, 191, 0.3);
  transform: translateX(4px);
}

.custom-sidebar-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  border-radius: 12px;
  position: relative;
  overflow: hidden;
}

.custom-sidebar-link::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.5s;
}

.custom-sidebar-link:hover::before {
  left: 100%;
}

.custom-sidebar-link:hover {
  background: linear-gradient(135deg, #e1ecfb 0%, #d6e6f9 100%);
  transform: translateX(2px);
  box-shadow: 0 2px 10px rgba(36, 102, 191, 0.1);
}

.custom-sidebar-link-content {
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
}

.custom-sidebar-icon {
  margin-right: 14px;
  font-size: 1.2rem;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
}

.custom-sidebar.collapsed .custom-sidebar-icon {
  margin-right: 0;
  transform: scale(1.1);
}

.custom-sidebar-chevron {
  margin-left: auto;
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  opacity: 1;
  transform: rotate(0deg) scale(1);
}

.custom-sidebar-chevron.rotate {
  transform: rotate(90deg) scale(1.1);
}

.custom-sidebar.collapsed .custom-sidebar-chevron {
  opacity: 0;
  transform: scale(0);
}

.custom-sidebar-submenu {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transform: translateY(-10px) scaleY(0.95);
  transition: all 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
  will-change: max-height, opacity, transform;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 8px;
  border-radius: 0 0 12px 12px;
  backdrop-filter: blur(5px);
}

.custom-sidebar-submenu.expanded {
  max-height: 600px;
  opacity: 1;
  transform: translateY(0) scaleY(1);
  overflow-y: auto;
  transition: all 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
  padding: 8px 0;
}

.custom-sidebar-submenu.collapsed {
  max-height: 0;
  opacity: 0;
  transform: translateY(-10px) scaleY(0.95);
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.custom-sidebar-submenu-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.custom-sidebar-sublink {
  margin: 3px 12px;
  display: block;
  padding: 12px 20px;
  color: #2466bf;
  text-decoration: none;
  font-size: 0.9rem;
  border-radius: 10px;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
  overflow: hidden;
}

.custom-sidebar-sublink::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 3px;
  background: linear-gradient(135deg, #2466bf, #1a4fa0);
  transform: scaleY(0);
  transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.custom-sidebar-sublink:hover::before,
.custom-sidebar-sublink.active::before {
  transform: scaleY(1);
}

.custom-sidebar-sublink:hover {
  background: linear-gradient(135deg, rgba(36, 102, 191, 0.1) 0%, rgba(36, 102, 191, 0.05) 100%);
  color: #1a4fa0;
  transform: translateX(4px);
  box-shadow: 0 2px 8px rgba(36, 102, 191, 0.1);
}

.custom-sidebar-sublink.active {
  background: linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%);
  color: white;
  font-weight: 500;
  transform: translateX(4px);
  box-shadow: 0 3px 12px rgba(36, 102, 191, 0.3);
}

.custom-sidebar-backdrop {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(2px);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.custom-sidebar-backdrop.show {
  opacity: 1;
}

.custom-sidebar-close {
  display: none;
  justify-content: flex-end;
  padding: 1rem;
}

.custom-sidebar-close svg {
  cursor: pointer;
  font-size: 1.5rem;
  color: #2466bf;
  transition: all 0.3s ease;
}

.custom-sidebar-close svg:hover {
  color: #1a4fa0;
  transform: rotate(90deg);
}

@media (max-width: 768px) {
  .custom-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 280px;
    z-index: 1000;
    transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    background: linear-gradient(135deg, #f4f8fc 0%, #e8f2ff 100%);
  }

  .custom-sidebar.collapsed {
    transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .custom-sidebar.expanded {
    transform: translateX(0);
    transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .custom-sidebar-close {
    display: flex;
  }

  .custom-sidebar-menu {
    padding-bottom: 2rem;
  }
}

.custom-sidebar-menu {
  list-style: none;
  padding: 12px 0;
  margin: 0;
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
}

.custom-sidebar-menu::-webkit-scrollbar {
  width: 6px;
}

.custom-sidebar-menu::-webkit-scrollbar-track {
  background: rgba(36, 102, 191, 0.1);
  border-radius: 3px;
}

.custom-sidebar-menu::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, rgba(36, 102, 191, 0.4), rgba(36, 102, 191, 0.6));
  border-radius: 3px;
  transition: background 0.3s ease;
}

.custom-sidebar-menu::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(135deg, rgba(36, 102, 191, 0.6), rgba(36, 102, 191, 0.8));
}

.custom-sidebar-submenu.expanded::-webkit-scrollbar {
  width: 4px;
}

.custom-sidebar-submenu.expanded::-webkit-scrollbar-thumb {
  background: rgba(36, 102, 191, 0.3);
  border-radius: 2px;
}

.custom-sidebar.collapsed .custom-sidebar-menu {
  overflow: hidden;
}

/* Text fade animation for collapsed state */
.custom-sidebar-link span:not(.custom-sidebar-icon):not(.custom-sidebar-chevron) {
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  opacity: 1;
  transform: translateX(0);
}

.custom-sidebar.collapsed .custom-sidebar-link span:not(.custom-sidebar-icon):not(.custom-sidebar-chevron) {
  opacity: 0;
  transform: translateX(-10px);
}

/* Hover tooltip for collapsed sidebar */
.custom-sidebar.collapsed .custom-sidebar-link {
  position: relative;
}

.custom-sidebar.collapsed .custom-sidebar-link::after {
  content: attr(data-tooltip);
  position: absolute;
  left: 100%;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 8px 12px;
  border-radius: 6px;
  font-size: 0.85rem;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  z-index: 1000;
  margin-left: 10px;
}

.custom-sidebar.collapsed .custom-sidebar-link:hover::after {
  opacity: 1;
}

/* Stagger animation for menu items */
.custom-sidebar-item {
  animation: slideInLeft 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
  opacity: 0;
  transform: translateX(-20px);
}

.custom-sidebar-item:nth-child(1) { animation-delay: 0.1s; }
.custom-sidebar-item:nth-child(2) { animation-delay: 0.15s; }
.custom-sidebar-item:nth-child(3) { animation-delay: 0.2s; }
.custom-sidebar-item:nth-child(4) { animation-delay: 0.25s; }
.custom-sidebar-item:nth-child(5) { animation-delay: 0.3s; }
.custom-sidebar-item:nth-child(6) { animation-delay: 0.35s; }

@keyframes slideInLeft {
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* Submenu items stagger animation */
.custom-sidebar-submenu.expanded .custom-sidebar-sublink {
  animation: fadeInUp 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
  opacity: 0;
  transform: translateY(10px);
}

.custom-sidebar-submenu.expanded .custom-sidebar-sublink:nth-child(1) { animation-delay: 0.1s; }
.custom-sidebar-submenu.expanded .custom-sidebar-sublink:nth-child(2) { animation-delay: 0.15s; }
.custom-sidebar-submenu.expanded .custom-sidebar-sublink:nth-child(3) { animation-delay: 0.2s; }
.custom-sidebar-submenu.expanded .custom-sidebar-sublink:nth-child(4) { animation-delay: 0.25s; }

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
