import React, { useState } from 'react';
import DatePicker from 'react-datepicker';
import { format, addDays, setHours, setMinutes } from 'date-fns';
import 'react-datepicker/dist/react-datepicker.css';

const AppointmentModal = ({ isOpen, onClose, onConfirm }) => {
  const [appointments, setAppointments] = useState([
    { date: null, time: null },
    { date: null, time: null },
    { date: null, time: null },
    { date: null, time: null }
  ]);

  const [activeDatePicker, setActiveDatePicker] = useState(null);

  // Generate time slots (4 specific slots as requested)
  const generateTimeSlots = (date) => {
    if (!date) return [];
    
    return [
      {
        start: setHours(setMinutes(new Date(date), 0), 10), // 10:00 AM
        end: setHours(setMinutes(new Date(date), 0), 11),  // 11:00 AM
        display: '10:00 AM - 11:00 AM'
      },
      {
        start: setHours(setMinutes(new Date(date), 0), 12), // 12:00 PM
        end: setHours(setMinutes(new Date(date), 0), 13),   // 1:00 PM
        display: '12:00 PM - 1:00 PM'
      },
      {
        start: setHours(setMinutes(new Date(date), 0), 15), // 3:00 PM
        end: setHours(setMinutes(new Date(date), 0), 16),    // 4:00 PM
        display: '3:00 PM - 4:00 PM'
      },
      {
        start: setHours(setMinutes(new Date(date), 0), 16), // 4:00 PM
        end: setHours(setMinutes(new Date(date), 0), 17),   // 5:00 PM
        display: '4:00 PM - 5:00 PM'
      }
    ];
  };

  const handleDateChange = (date, index) => {
    const newAppointments = [...appointments];
    newAppointments[index] = { ...newAppointments[index], date, time: null };
    setAppointments(newAppointments);
    setActiveDatePicker(null);
  };

  const handleTimeSelect = (time, index) => {
    const newAppointments = [...appointments];
    newAppointments[index] = { ...newAppointments[index], time };
    setAppointments(newAppointments);
  };

  const handleConfirm = () => {
    const validAppointments = appointments.filter(appt => appt.date && appt.time);
    if (validAppointments.length > 0 && onConfirm) {
      onConfirm(validAppointments);
      onClose();
    }
  };

  if (!isOpen) return null;

  return (
    <div className="modal-overlay">
      <div className="appointment-modal">
        <div className="modal-header">
          <h2>Schedule Appointments</h2>
          <button className="close-button" onClick={onClose}>×</button>
        </div>
        
        <div className="modal-body">
          <div className="appointments-grid">
            {appointments.map((appt, index) => {
              const timeSlots = generateTimeSlots(appt.date);
              
              return (
                <div key={index} className="appointment-slot">
                  <div className="date-selection">
                    <label>Date</label>
                    <div 
                      className="date-display"
                      onClick={() => setActiveDatePicker(index)}
                    >
                      {appt.date ? format(appt.date, 'MMM d, yyyy') : 'Select date'}
                    </div>
                    {activeDatePicker === index && (
                      <div className="date-picker-container">
                        <DatePicker
                          selected={appt.date}
                          onChange={(date) => handleDateChange(date, index)}
                          minDate={new Date()}
                          inline
                          calendarClassName="custom-calendar"
                        />
                      </div>
                    )}
                  </div>
                  
                  <div className="time-selection">
                    <label>Time</label>
                    {appt.date ? (
                      <div className="time-slots">
                        {timeSlots.map((slot, slotIndex) => (
                          <button
                            key={slotIndex}
                            className={`time-slot ${
                              appt.time?.display === slot.display ? 'selected' : ''
                            }`}
                            onClick={() => handleTimeSelect(slot, index)}
                          >
                            {slot.display}
                          </button>
                        ))}
                      </div>
                    ) : (
                      <div className="time-placeholder">Select date first</div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
        
        <div className="modal-footer">
          <button className="cancel-button" onClick={onClose}>Cancel</button>
          <button 
            className="confirm-button"
            onClick={handleConfirm}
            disabled={!appointments.some(appt => appt.date && appt.time)}
          >
            Confirm Appointments
          </button>
        </div>
      </div>
    </div>
  );
};

export default AppointmentModal;
