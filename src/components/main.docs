/* SurveyTrackerCard.css */

.survey-tracker-card {
  grid-column: span 2;
  height: 100%;
}

.survey-tracker-card .status-card-content {
  padding: 15px;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.card-header-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.card-header-text {
  margin-left: 12px;
}

.calendar-wrapper {
  margin-top: 5px;
  width: 100%;
  flex: 1;
  min-height: 0;
}

/* Calendar Styling */
.survey-calendar {
  width: 100% !important;
  height: 100% !important;
  font-family: inherit !important;
  border: none !important;
  background: transparent !important;
  display: flex;
  flex-direction: column;
}

.survey-calendar .react-datepicker__month-container {
  width: 100%;
  height: 100%;
  float: none;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.survey-calendar .react-datepicker__header {
  background-color: transparent;
  border-bottom: none;
  padding: 0 0 5px 0;
}

.survey-calendar .react-datepicker__day-names {
  display: flex;
  justify-content: space-around;
  margin: 0;
  padding: 0;
}

.survey-calendar .react-datepicker__day-name {
  color: #666;
  font-weight: 500;
  font-size: 0.65rem;
  margin: 0;
  width: 1.8em;
  line-height: 1.8em;
}

.survey-calendar .react-datepicker__month {
  margin: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.survey-calendar .react-datepicker__week {
  display: flex;
  justify-content: space-around;
  flex: 1;
}

.survey-calendar .react-datepicker__day {
  margin: 0;
  width: 1.8em;
  line-height: 1.8em;
  font-size: 0.7rem;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.survey-calendar .react-datepicker__day--selected,
.survey-calendar .react-datepicker__day--keyboard-selected {
  background-color: #6f42c1;
  color: white;
}

.survey-calendar .react-datepicker__day--today .day-number {
  color: #fff;
  background-color: #0d6efd;
  border-radius: 50%;
  width: 1.8em;
  height: 1.8em;
  display: flex;
  align-items: center;
  justify-content: center;
}

.survey-calendar .react-datepicker__navigation {
  top: 0.3em;
  width: 1.5em;
  height: 1.5em;
}

/* Day Container */
.day-container {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.day-number {
  font-size: 0.7rem;
  width: 1.8em;
  height: 1.8em;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Event Indicators */
.event-indicators {
  position: absolute;
  bottom: 2px;
  display: flex;
  gap: 2px;
}

.event-indicator {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.react-datepicker__day:hover .event-indicator {
  transform: scale(1.5);
}

/* Event Legend */
.event-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid #eee;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 0.7rem;
}

.legend-color {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  margin-right: 5px;
}

.legend-text {
  text-transform: capitalize;
  color: #555;
}

/* Left Border Color */
.status-card {
  position: relative;
  overflow: hidden;
}

.status-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background-color: inherit;
}

.survey-tracker-card::before {
  background-color: #6f42c1;
}
