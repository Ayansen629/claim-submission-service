import React, { useState } from "react";
import { Button, Card, Form, Modal } from "react-bootstrap";
import { BsPlus, BsEye, BsTrash, BsDownload } from "react-icons/bs";
import { useTranslation } from "react-i18next";
import ActionTable from "../../../common/ActionTable.tsx";

const ReportsSection = () => {
  const { t } = useTranslation();
  const [showFileModal, setShowFileModal] = useState(false);
  const [currentReportType, setCurrentReportType] = useState("");
  const [reports, setReports] = useState({
    materialTest: [
      {
        id: 1,
        fileName: "material_test_1.pdf",
        description: "Initial material test results",
        remarks: "Approved",
      },
    ],
    radiography: [
      {
        id: 1,
        fileName: "radiography_report_1.pdf",
        description: "X-ray inspection results",
        remarks: "Pending review",
      },
    ],
    inspection: [
      {
        id: 1,
        fileName: "inspection_report_1.pdf",
        description: "Quarterly inspection",
        remarks: "Completed",
      },
    ],
    other: [
      {
        id: 1,
        fileName: "other_report_1.pdf",
        description: "Additional documentation",
        remarks: "N/A",
      },
    ],
  });

  const REPORT_COLUMNS = [
    {
      colName: "Add Attachment",
      fieldName: "fileName",
      clsName: "column-text-start",
    },
    {
      colName: "Description",
      fieldName: "description",
      clsName: "column-text-start",
    },
    {
      colName: "Remarks",
      fieldName: "remarks",
      clsName: "column-text-start",
    },
    {
      colName: "Action",
      fieldName: "action",
      actions: ['view', 'delete', 'download'],
      clsName: "col-sm-2 column-text-start actions-column",
    },
  ];

  const handleAddReport = (reportType) => {
    setCurrentReportType(reportType);
    setShowFileModal(true);
  };

  const handleFileUpload = (e) => {
    e.preventDefault();
    const file = e.target.file.files[0];
    if (file) {
      const newReport = {
        id: Date.now(),
        fileName: file.name,
        description: e.target.description.value || "No description",
        remarks: e.target.remarks.value || "No remarks",
      };

      setReports((prev) => ({
        ...prev,
        [currentReportType]: [...prev[currentReportType], newReport],
      }));

      setShowFileModal(false);
    }
  };

  const handleTableAction = (action, rowData, reportType) => {
    switch (action) {
      case 'view':
        // Handle view action - you might want to open a modal or new tab
        console.log("View report:", rowData);
        break;
      case 'delete':
        // Handle delete action
        setReports(prev => ({
          ...prev,
          [reportType]: prev[reportType].filter(report => report.id !== rowData.id)
        }));
        break;
      case 'download':
        // Handle download action
        console.log("Download report:", rowData);
        break;
      default:
        break;
    }
  };

  const renderReportTable = (reportType, reportData) => {
    const translatedColumns = REPORT_COLUMNS.map(col => ({
      ...col,
      colName: t(col.colName)
    }));

    return (
      <div className="mb-4">
        <div className="d-flex justify-content-between align-items-center mb-3">
          <h5 className="mb-0">
            {t(
              reportType
                .replace(/([A-Z])/g, " $1")
                .replace(/^./, (str) => str.toUpperCase()) + " Report"
            )}
          </h5>
          <Button
            variant="primary"
            size="sm"
            onClick={() => handleAddReport(reportType)}
          >
            <BsPlus size={20} /> {t("Add")}
          </Button>
        </div>

        <ActionTable
          columns={translatedColumns}
          rowData={reportData}
          tableHeader={null}
          hideExportBtn={true}
          hideSearchBar={true}
          pagination={false}
          onActionClick={(action, rowData) => handleTableAction(action, rowData, reportType)}
          noDataText={t("No reports available")}
        />
      </div>
    );
  };

  return (
    <Card className="mt-4">
      <Card.Header className="dashboard-card-header">
        <h5>{t("Reports")}</h5>
      </Card.Header>
      <Card.Body>
        <div className="reports-section">
          {renderReportTable("materialTest", reports.materialTest)}
          {renderReportTable("radiography", reports.radiography)}
          {renderReportTable("inspection", reports.inspection)}
          {renderReportTable("other", reports.other)}

          <div className="d-flex justify-content-end mt-4">
            <Button variant="secondary" className="me-2">
              {t("Reset")}
            </Button>
            <Button variant="primary">{t("Save")}</Button>
          </div>
        </div>
      </Card.Body>

      {/* File Upload Modal */}
      <Modal show={showFileModal} onHide={() => setShowFileModal(false)}>
        <Modal.Header closeButton>
          <Modal.Title>
            {t("Upload")}{" "}
            {currentReportType
              .replace(/([A-Z])/g, " $1")
              .replace(/^./, (str) => str.toUpperCase())}{" "}
            {t("Report")}
          </Modal.Title>
        </Modal.Header>
        <Form onSubmit={handleFileUpload}>
          <Modal.Body>
            <Form.Group className="mb-3">
              <Form.Label>{t("Select File")}</Form.Label>
              <Form.Control type="file" name="file" required />
            </Form.Group>
            <Form.Group className="mb-3">
              <Form.Label>{t("Description")}</Form.Label>
              <Form.Control
                as="textarea"
                rows={3}
                name="description"
                placeholder={t("Enter description")}
              />
            </Form.Group>
            <Form.Group className="mb-3">
              <Form.Label>{t("Remarks")}</Form.Label>
              <Form.Control
                type="text"
                name="remarks"
                placeholder={t("Enter remarks")}
              />
            </Form.Group>
          </Modal.Body>
          <Modal.Footer>
            <Button variant="secondary" onClick={() => setShowFileModal(false)}>
              {t("Cancel")}
            </Button>
            <Button variant="primary" type="submit">
              {t("Upload")}
            </Button>
          </Modal.Footer>
        </Form>
      </Modal>
    </Card>
  );
};

export default ReportsSection;
