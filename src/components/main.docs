// ReviewStep.js
import React from "react";
import { Container, Row, Col, Spinner } from "react-bootstrap";
import Collapsible from "./formCommon/Collapsible";
import { useFormData } from "../../context/FormDataContext"; // Import the hook
import PreviewCard from "../../private/Dashboard/PreviewCard"; // Import the PreviewCard component

const ReviewStep = () => {
  const { formData } = useFormData(); // Access formData from Context
  console.log(formData, "Review formdata");

  const renderPreviewSection = (fields) => (
    <Container fluid>
      <Row className="g-3">
        {Object.entries(fields).map(([key, value]) => (
          <Col key={key} xs={12} sm={6} md={3} className="mb-3">
            <PreviewCard title={key} value={value} />
          </Col>
        ))}
      </Row>
    </Container>
  );

  const renderCard = (title, fields) => (
    <div className="mb-3">
      <h5 style={{ fontWeight: 600 }}>{title}</h5>
      {renderPreviewSection(fields)}
    </div>
  );

  // Only render the UI if formData is populated
  if (!formData || Object.keys(formData).length === 0) {
    return (
      <div className="d-flex justify-content-center align-items-center" style={{ height: "100vh" }}>
        <Spinner animation="border" />
      </div>
    );
  }

  return (
    <div className="form-stepper">
      <Collapsible title="Step 1: Creditor and Identification Details">
        {renderCard("Creditor Details", {
          "Creditor Name": formData.CreditorName,
          "Total Claim Amount": formData.totalClaimAmount,
          "Debt Details": formData.debtDetails,
          "Mutual Credit Details": formData.mutualCreditDetails,
        })}
        {renderCard("Identification Details", {
          "Identification Type": formData.identificationType,
          "Identification Number": formData.identificationNumber,
          "Identification Document": formData.identificationDocument?.path,
        })}
      </Collapsible>

      <Collapsible title="Step 2: Financial and Beneficiary Details">
        {renderCard("Financial Details", {
          "Security Interest Amount": formData.securityInterestAmount,
          "Guarantee Amount": formData.guaranteeAmount,
          "Guarantor Name": formData.guarantorName,
          "Guarantor Address": formData.guarantorAddress,
          "Creditor Address": formData.creditorAddress,
          "Creditor Email": formData.creditorEmail,
        })}
        {renderCard("Beneficiary Details", {
          "Beneficiary Name": formData.beneficiaryName,
          "Beneficiary Address": formData.beneficiaryAddress,
          "Corporate Debtor Claim Amount": formData.corporateDebtorClaimAmount,
          "Corporate Debtor Security Amount": formData.corporateDebtorSecurityAmount,
          "Corporate Debtor Guarantee Amount": formData.corporateDebtorGuaranteeAmount,
        })}
        {renderCard("Bank Details", {
          "Principal Borrower Name": formData.principalBorrowerName,
          "Principal Borrower Address": formData.principalBorrowerAddress,
          "Account Number": formData.accountNumber,
          "IFSC Code": formData.ifscCode,
          "Branch Name": formData.branchName,
          "Address Proof": formData.addressProof?.path,
        })}
      </Collapsible>

      <Collapsible title="Step 3: Signatory Details">
        {renderCard("Signatory Details", {
          "Signatory Name": formData.signatoryName,
          "Signatory Position": formData.signatoryPosition,
          "Signatory Address": formData.signatoryAddress,
          "Signatory Document": formData.signatoryDocument?.path,
        })}
      </Collapsible>
    </div>
  );
};

