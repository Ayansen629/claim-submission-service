// Check if tonnage and stability booklets are required
const isTonnageRequired = () => {
  if (editMode) {
    const existingTonnageFile = getValues("tonnageBooklets");
    const hasFileId = existingTonnageFile?.id;
    const hasGrtValue = grossTonnage && grossTonnage.trim() !== "";
    
    // Required if: has file ID OR has GRT value (when GRT is changed in edit mode)
    return !!(hasFileId || hasGrtValue);
  }
  return false;
};

const isStabilityRequired = () => {
  if (editMode) {
    const existingStabilityFile = getValues("stabilityBooklets");
    const hasFileId = existingStabilityFile?.id;
    const hasGrtValue = grossTonnage && grossTonnage.trim() !== "";
    
    // Required if: has file ID OR has GRT value (when GRT is changed in edit mode)
    return !!(hasFileId || hasGrtValue);
  }
  return false;
};

// Trigger validation when GRT changes in edit mode
useEffect(() => {
  if (editMode && grossTonnage && grossTonnage.trim() !== "") {
    setTimeout(() => {
      const tonnageFile = getValues("tonnageBooklets");
      const stabilityFile = getValues("stabilityBooklets");
      
      // When GRT has value in edit mode, both files become mandatory
      if (!tonnageFile || !tonnageFile.name) {
        setError("tonnageBooklets", {
          type: "required",
          message: t('Tonnage Booklets is required when GRT value is provided')
        });
      } else {
        clearErrors("tonnageBooklets");
      }
      
      if (!stabilityFile || !stabilityFile.name) {
        setError("stabilityBooklets", {
          type: "required", 
          message: t('Stability Booklets is required when GRT value is provided')
        });
      } else {
        clearErrors("stabilityBooklets");
      }
    }, 100);
  } else if (editMode) {
    // In edit mode but no GRT value, check only file IDs
    setTimeout(() => {
      const tonnageFile = getValues("tonnageBooklets");
      const stabilityFile = getValues("stabilityBooklets");
      
      // Only required if file has ID
      if (tonnageFile?.id && (!tonnageFile || !tonnageFile.name)) {
        setError("tonnageBooklets", {
          type: "required",
          message: t('Tonnage Booklets is required')
        });
      } else {
        clearErrors("tonnageBooklets");
      }
      
      if (stabilityFile?.id && (!stabilityFile || !stabilityFile.name)) {
        setError("stabilityBooklets", {
          type: "required", 
          message: t('Stability Booklets is required')
        });
      } else {
        clearErrors("stabilityBooklets");
      }
    }, 100);
  } else {
    // Clear errors in normal mode
    clearErrors(["tonnageBooklets", "stabilityBooklets"]);
  }
}, [grossTonnage, editMode, getValues, setError, clearErrors, t]);
