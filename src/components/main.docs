const handleFileChange = async (e, documentType) => {
  if (viewMode) return;
  const file = e?.target?.files[0];
  if (!file) return;

  const maxSize = 10 * 1024 * 1024;
  if (file.size > maxSize) {
    toast.error("File size must be less than or equal to 10 MB.");
    e.target.value = null;
    return;
  }

  loaderRef.current?.show();

  try {
    const formData = new FormData();
    formData.append("file", file);

    const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
    const response = await postFORMdata(uploadUrl, formData);

    const fileStoreId = response?.data?.files[0]?.fileStoreId;

    if (fileStoreId) {
      // Get file extension from original file
      const fileExtension = file.name.substring(file.name.lastIndexOf('.'));
      
      const getStandardizedFileName = (docType, extension) => {
        const baseNames = {
          authorizationFile: "Authorization of Authorised Person",
          paymentChallan: "Payment Challan_Acknowledgement", 
          builderCertificate: "Builder Certificate",
          lastCertificateCopy: "Copy of last Certificate of Survey",
          registrationCertificateCopy: "Copy of Certificate of Registration",
          testCertificate: "Test Certificate",
        };
        return `${baseNames[docType] || docType}${extension}`;
      };

      const standardizedName = getStandardizedFileName(documentType, fileExtension);

      setFileStates((prev) => ({
        ...prev,
        [documentType]: {
          name: standardizedName,
          fileStoreId,
          originalName: file.name,
          file: file, // Store the actual file object
        },
      }));
      
      setValue(`enclosure.${documentType}`, file); // Set the actual file object
      setValue(`enclosure.${documentType}FileStoreId`, fileStoreId);
      setValue(`enclosure.${documentType}OriginalName`, file.name);
      clearErrors(`enclosure.${documentType}`);
      toast.success("File uploaded successfully!");
    }
  } catch (err) {
    console.error("File upload failed:", err);
    toast.error("File upload failed. Please try again.");
    setFileStates((prev) => ({ ...prev, [documentType]: null }));
    setValue(`enclosure.${documentType}`, null);
    setValue(`enclosure.${documentType}FileStoreId`, null);
    e.target.value = null;
  } finally {
    loaderRef.current?.hide();
  }
};

const renderFileField = (docType, label) => {
  if (viewMode) {
    return (
      <>
        <label className="form-label">{t(label)}</label>
        {fileStates[docType] ? (
          <div
            className="d-flex align-items-center p-2 border rounded"
            style={{ backgroundColor: "#f8f9fa" }}
          >
            <span className="me-2">{fileStates[docType].name}</span>
            <button
              type="button"
              className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
              onClick={() =>
                handleFileDownload(
                  fileStates[docType].fileStoreId,
                  fileStates[docType].name,
                  fileStates[docType].originalName
                )
              }
              title="Download file"
              style={{ width: "24px", height: "24px", padding: "0" }}
            >
              <FaDownload size={10} />
            </button>
          </div>
        ) : (
          <div
            className="p-2 border rounded text-muted"
            style={{ backgroundColor: "#f8f9fa" }}
          >
            No file uploaded
          </div>
        )}
      </>
    );
  }

  return (
    <>
      <div style={{ display: "flex" }}>
        <InputFile
          name={`enclosure.${docType}`}
          label={t(label)}
          id={docType}
          style={{ width: "100%" }}
          register={register(`enclosure.${docType}`, {
            required: !fileStates[docType] && t(`${label} is required`),
          })}
          errors={errors}
          required={!fileStates[docType]}
          clearErrors={clearErrors}
          onChange={(e) => handleFileChange(e, docType)}
          watch={watch}
          defaultValue={fileStates[docType]?.file || watch(`enclosure.${docType}`)}
        />

        {fileStates[docType] && (
          <FaTimesCircle
            className="text-danger position-relative"
            style={{
              top: "3rem",
              right: "3.5rem",
              cursor: "pointer",
            }}
            size={18}
            title="Remove file"
            onClick={() => {
              setFileStates((prev) => ({
                ...prev,
                [docType]: null,
              }));
              setValue(`enclosure.${docType}`, null);
              setValue(`enclosure.${docType}FileStoreId`, null);
              setValue(`enclosure.${docType}OriginalName`, null);
              clearErrors(`enclosure.${docType}`);
              
              // Clear the file input
              const fileInput = document.getElementById(docType);
              if (fileInput) fileInput.value = '';
            }}
          />
        )}
      </div>

      {fileStates[docType] && (
        <div className="d-flex align-items-center mt-1 mb-1">
          <small className="text-success me-2">
            ✓ {fileStates[docType].name}
          </small>
          <button
            type="button"
            className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
            onClick={() =>
              handleFileDownload(
                fileStates[docType].fileStoreId,
                fileStates[docType].name,
                fileStates[docType].originalName
              )
            }
            title="Download file"
            style={{ width: "24px", height: "24px", padding: "0" }}
          >
            <FaDownload size={10} />
          </button>
        </div>
      )}
    </>
  );
};

// Update the extractEnclosures function in VesselSurveyRegistration component
const extractEnclosures = (formValue, applicationNumber) => {
  const mapping = {
    authorizationFile: {
      type: "SURVEY_AUTHORIZATION",
      description: "Authorization file",
    },
    paymentChallan: {
      type: "SURVEY_PAYMENT_CHALLAN", 
      description: "Payment challan",
    },
    builderCertificate: {
      type: "SURVEY_BUILDER_CERTIFICATE",
      description: "Builder certificate",
    },
    lastCertificateCopy: {
      type: "SURVEY_COPY_OF_LAST_CERTIFICATE_OF_SURVEY",
      description: "Last certificate copy",
    },
    registrationCertificateCopy: {
      type: "SURVEY_COPY_OF_CERTIFICATE_OF_REGISTRATION",
      description: "Registration certificate copy",
    },
    testCertificate: {
      type: "SURVEY_TEST_CERTIFICATE",
      description: "Test certificate",
    },
  };

  return Object.entries(mapping).map(([key, meta]) => {
    const fileStoreId = formValue[`${key}FileStoreId`];
    const originalName = formValue[`${key}OriginalName`];
    const file = formValue[key];
    
    // Use original filename if available, otherwise use file name or default
    let documentName = originalName || (file?.name) || meta.description;
    
    return {
      id: "",
      documentName,
      documentType: meta.type,
      applicationNumber,
      fileStoreId: fileStoreId ?? "",
      documentSource: "SURVEY_ENCLOSURE",
      description: meta.description,
      active: true,
    };
  });
};
