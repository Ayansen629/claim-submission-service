import React, { useState } from "react";
import { Box, Typography, Paper, Button, Chip } from "@mui/material";
import { FaArrowLeft, FaEye, FaDownload, FaChevronDown } from "react-icons/fa";
import { useNavigate } from "react-router-dom";
import styles from './ApplicationView.module.css';

const ApplicationView = () => {
  const navigate = useNavigate();

  const vesselData = [
    { id: 1, name: "Gangadhara", number: "WB001", status: "pending" },
    { id: 2, name: "Subamarekha", number: "WB002", status: "approved" },
    { id: 3, name: "Nabajattra", number: "WB345", status: "pending" },
    { id: 4, name: "Alakananda", number: "WB234", status: "rejected" },
  ];

  const paymentData = [
    {
      id: "WB/IWT/REG/25-26/001014",
      type: "Owner Name Change",
      amount: "****",
      date: "22-09-2026",
      status: "Pending"
    }
  ];

  const getStatusColor = (status) => {
    switch (status) {
      case 'approved': return '#4CAF50';
      case 'pending': return '#FF9800';
      case 'rejected': return '#F44336';
      default: return '#757575';
    }
  };

  const getStatusIcon = (status) => {
    switch (status) {
      case 'approved': return '✓';
      case 'pending': return '○';
      case 'rejected': return '✗';
      default: return '○';
    }
  };

  return (
    <div className={styles.container}>
      <div className={styles.mainContent}>
        <div className={styles.topSection}>
          <div className={styles.headerRow}>
            <Button
              startIcon={<FaArrowLeft />}
              onClick={() => navigate(-1)}
              className={styles.backButton}
            >
            </Button>
            <Typography variant="h5" className={styles.title}>
              Application Details Update
            </Typography>
            <div className={styles.applicationId}>
              WB-IWT/REG/2025/302748
            </div>
          </div>
          
          <div className={styles.statusBanner}>
            Company name has been updated from ABC Pvt. Limited to [New Company Name].
          </div>
        </div>

        {/* Updated name cards layout */}
        <div className={styles.cardsRow}>
          <Paper className={styles.namesCard}>
            <div className={styles.nameField}>
              <Typography className={styles.fieldLabel}>Existing Name</Typography>
              <div className={styles.fieldValue}>Anirban Mukherjee</div>
            </div>
            <div className={styles.nameField}>
              <Typography className={styles.fieldLabel}>New Name</Typography>
              <div className={styles.fieldValue}>Anindita Choudhury</div>
            </div>
          </Paper>

          <Paper className={styles.fileCard}>
            <Typography className={styles.warningText}>
              Valid documents for name change have been uploaded by the owner for your verification.
            </Typography>
            <div className={styles.fileRow}>
              <Typography className={styles.fileName}>File Name</Typography>
              <div className={styles.fileActions}>
                <button className={styles.iconButton}>
                  <FaEye />
                </button>
                <button className={styles.iconButton}>
                  <FaDownload />
                </button>
              </div>
            </div>
          </Paper>
        </div>

        {/* Updated vessel table with SL column */}
        <div className={styles.vesselSection}>
          <div className={styles.vesselHeader}>
            <Typography className={styles.sectionTitle}>SL</Typography>
            <Typography className={styles.sectionTitle}>Vessel Name</Typography>
            <Typography className={styles.sectionTitle}>Registration Number</Typography>
            <Typography className={styles.sectionTitle}>Existing Book of Registration</Typography>
            <Typography className={styles.sectionTitle}>Existing Registration Certificate</Typography>
            <Typography className={styles.sectionTitle}>New Registration Certificate</Typography>
          </div>

          {vesselData.map((vessel, index) => (
            <div key={vessel.id} className={styles.vesselRow}>
              <div className={styles.vesselCell}>
                <Typography className={styles.vesselNumber}>{index + 1}</Typography>
              </div>
              <div className={styles.vesselCell}>
                <Typography className={styles.vesselName}>{vessel.name}</Typography>
              </div>
              <div className={styles.vesselCell}>
                <Typography>{vessel.number}</Typography>
              </div>
              <div className={styles.vesselCell}>
                <div className={styles.vesselActions}>
                  <button className={styles.vesselIconButton}>
                    <FaEye />
                  </button>
                  <button className={styles.vesselIconButton}>
                    <FaDownload />
                  </button>
                </div>
              </div>
              <div className={styles.vesselCell}>
                <div className={styles.vesselActions}>
                  <button className={styles.vesselIconButton}>
                    <FaEye />
                  </button>
                  <button className={styles.vesselIconButton}>
                    <FaDownload />
                  </button>
                </div>
              </div>
              <div className={styles.vesselCell}>
                <div className={styles.vesselActions}>
                  <button className={styles.vesselIconButton}>
                    <FaEye />
                  </button>
                  <button className={styles.vesselIconButton}>
                    <FaDownload />
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div className={styles.paymentSection}>
          <div className={styles.paymentHeader}>
            <Box className={styles.paymentIcon}>💳</Box>
            <Typography className={styles.paymentTitle}>Payment Details</Typography>
          </div>
          
          <div className={styles.paymentTableHeader}>
            <Typography className={styles.tableHeaderCell}>Payment Id</Typography>
            <Typography className={styles.tableHeaderCell}>Payment Type</Typography>
            <Typography className={styles.tableHeaderCell}>Amount</Typography>
            <Typography className={styles.tableHeaderCell}>Payment Date</Typography>
            <Typography className={styles.tableHeaderCell}>Status</Typography>
            <Typography className={styles.tableHeaderCell}>Receipt</Typography>
          </div>

          {paymentData.map((payment) => (
            <div key={payment.id} className={styles.paymentRow}>
              <Typography className={styles.paymentCell}>{payment.id}</Typography>
              <Typography className={styles.paymentCell}>{payment.type}</Typography>
              <Typography className={styles.paymentCell}>{payment.amount}</Typography>
              <Typography className={styles.paymentCell}>{payment.date}</Typography>
              <Typography className={styles.paymentCell}>
                <Chip 
                  label={payment.status} 
                  size="small"
                  className={styles.statusChip}
                />
              </Typography>
              <div className={styles.paymentCell}>
                <button className={styles.tableIconButton}>
                  <FaEye />
                </button>
                <button className={styles.tableIconButton}>
                  <FaDownload />
                </button>
              </div>
            </div>
          ))}
        </div>

        <div className={styles.actionSection}>
          <Button 
            variant="contained" 
            className={styles.takeActionButton}
            endIcon={<FaChevronDown />}
          >
            Take Action
          </Button>
        </div>
      </div>
    </div>
  );
};

export default ApplicationView;
