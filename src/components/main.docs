step3: [
  // Filter out documents that already have data from API to avoid duplicates
  ...getDocumentsForOwner({categoryOfOwner: formData.categoryOfOwnerCode}, null, t)
    .filter(doc => !formData[doc.name]) // Only show if no data exists
    .map(doc => ({
      ...doc,
      type: "file",
      disabled: true,
      inputClassName: "disabled-field",
    })),
  
  // Show documents that have actual data from API
  ...Object.keys(formData)
    .filter(key => 
      key !== 'additionalDocuments' && 
      key !== 'existingDocuments' &&
      formData[key] && 
      typeof formData[key] === 'object' && 
      formData[key].fileName
    )
    .map(key => ({
      name: key,
      label: formData[key].fileName.replace(/\.(pdf|jpg|jpeg|png)$/i, ''),
      type: "file",
      colSize: 6,
      disabled: true,
      inputClassName: "disabled-field",
    })),

  ...(formData.existingUser === "Yes" && formData.existingDocuments ? [{
    name: "existingDocuments",
    label: t("vesselOwnerRegistration.Existing Documents"),
    type: "file",
    colSize: 6,
    disabled: true,
    inputClassName: "disabled-field",
  }] : []),
  
  {
    name: "additionalDocuments",
    label: t("vesselOwnerRegistration.Additional_Documents"),
    type: "additional_docs",
    colSize: 12,
  },
],
