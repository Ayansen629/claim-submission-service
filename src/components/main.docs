const getStatusColor = (status) => {
  switch (status?.toLowerCase()) {
    case 'draft':
      return '#6c757d'; // Gray
      case 'accepted as contingent':
      return '#dc3545'; // Red
    case 'sent back':
      return '#dc3545'; // Red
    case 'pending':
      return '#ffc107'; // Yellow/Amber
    case 'approved by rp':
      return '#28a745'; // Green
        case 'rejected':
      return '#28a745'; // Green
    default:
      return '#6c757d'; // Default gray
  }
};
