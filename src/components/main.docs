  //               filesWithData.map((fileInput) => {
  //                 const fileData = watch(`${type}_file_${fileInput.id}`);
  //                 const descData = watch(`${type}_desc_${fileInput.id}`);
                  
  //                 return (
  //                   <DocumentCard
  //                     key={fileInput.id}
  //                     fileName={fileData.name}
