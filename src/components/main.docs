.submitStep {
  padding: 40px 20px;
  text-align: center;
}

.submitContent {
  max-width: 600px;
  margin: 0 auto;
}

.submitContent h4 {
  color: #1A61C1;
  margin-bottom: 20px;
}

.submitContent p {
  color: #666;
  margin-bottom: 30px;
}

.summaryBox {
  background: #f8f9fa;
  border: 1px solid #dee2e6;
  border-radius: 8px;
  padding: 20px;
  text-align: left;
  margin-top: 20px;
}

.summaryBox h6 {
  color: #1A61C1;
  margin-bottom: 15px;
  font-weight: 600;
}

.summaryBox p {
  margin-bottom: 10px;
  color: #333;
}

@media (max-width: 768px) {
  .submitStep {
    padding: 20px 15px;
  }
  
  .summaryBox {
    padding: 15px;
  }
}
