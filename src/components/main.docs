import React, { useEffect } from "react";
import { useForm } from "react-hook-form";
import { Row, Col } from "react-bootstrap";
import InputText from "../../../../../common/InputText.tsx";
import InputSelect from "../../../../../common/InputSelect.tsx";
import Collapsible from "../../../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import { FaShip, FaCog, FaExchangeAlt } from "react-icons/fa";

const BookOfRegistrationForm = ({ formMethods, viewMode = false, registrationData, intialSurveyData, originalRegistrationData }) => {
  const { t } = useTranslation();
  
  const defaultMethods = useForm({ 
    mode: "onTouched"
  });
  
  const methods = formMethods || defaultMethods;
  const { register, formState: { errors }, setValue } = methods;

  useEffect(() => {
      const populateBookOfRegistration = () => {
        const reg = registrationData ? {...registrationData} : "";
        const survey = intialSurveyData ? {...intialSurveyData} : "";
        
        // Vessel Identification
        setValue("bookOfRegistration.vesselInfo.officialNo", reg?.vessel?.registrationNo || "");
        setValue("bookOfRegistration.vesselInfo.vesselName", reg?.vessel?.vesselName || "");
        setValue("bookOfRegistration.vesselInfo.portOfRegistry", survey?.BasicVesselInformation?.portOfRegistry || "");
        setValue("bookOfRegistration.vesselInfo.yearOfRegistry", new Date().getFullYear().toString());
        setValue("bookOfRegistration.vesselInfo.ownerName", reg?.owner?.name || "");
        setValue("bookOfRegistration.vesselInfo.ownerAddress", reg?.owner?.address || "");

        // Vessel Description
        setValue("bookOfRegistration.vesselDescription.typeOfVessel", reg?.vessel?.type || "");
        setValue("bookOfRegistration.vesselDescription.categoryOfVessel", reg?.vessel?.category || "");
        setValue("bookOfRegistration.vesselDescription.grossTonnage", reg?.vessel?.grt || "");
        setValue("bookOfRegistration.vesselDescription.registeredTonnage", survey?.BasicVesselInformation?.netTonnage?.toString() || "");
        setValue("bookOfRegistration.vesselDescription.yearOfBuild", reg?.vessel?.yearOfBuild || "");
        setValue("bookOfRegistration.vesselDescription.placeOfBuild", reg?.vessel?.placeOfBuild || "");

        // Vessel Particulars
        setValue("bookOfRegistration.vesselParticulars.lengthOverall", survey?.BasicVesselInformation?.lengthOfVessel || "");
        setValue("bookOfRegistration.vesselParticulars.breadthExtreme", survey?.BasicVesselInformation?.breadthOfVessel || "");
        setValue("bookOfRegistration.vesselParticulars.depthOfDeck", survey?.BasicVesselInformation?.depthOfVessel || "");
        setValue("bookOfRegistration.vesselParticulars.builderName", reg?.builder?.name || "");
        setValue("bookOfRegistration.vesselParticulars.builderAddress", reg?.builder?.address || "");
        setValue("bookOfRegistration.vesselParticulars.yearOfBuild", reg?.vessel?.yearOfBuild || "");
        setValue("bookOfRegistration.vesselParticulars.hullMaterial", survey?.HullParticulars?.hullMaterial || "");
        setValue("bookOfRegistration.vesselParticulars.numberOfDecks", survey?.BasicVesselInformation?.numberOfDecks?.toString() || "");
        setValue("bookOfRegistration.vesselParticulars.numberOfBulkheads", survey?.HullParticulars?.noOfBulkheads?.toString() || "");

        // Engine Details
        setValue("bookOfRegistration.engine.numberOfSets", survey?.DetailsofPropulsionofEngine?.noOfSet?.toString() || "");
        setValue("bookOfRegistration.engine.madeBy", survey?.DetailsofPropulsionofEngine?.engineMake || "");
        setValue("bookOfRegistration.engine.yearOfMake", survey?.DetailsofPropulsionofEngine?.yearOfMake || "");
        setValue("bookOfRegistration.engine.cylinderDiameter", survey?.DetailsofPropulsionofEngine?.engineCylinder?.toString() || "");
        setValue("bookOfRegistration.engine.strokeInches", survey?.DetailsofPropulsionofEngine?.stroke || "");
        setValue("bookOfRegistration.engine.rpm", survey?.DetailsofPropulsionofEngine?.rpm?.toString() || "");
        setValue("bookOfRegistration.engine.bhp", survey?.DetailsofPropulsionofEngine?.horsepower?.toString() || "");

        // Propulsion
        setValue("bookOfRegistration.propulsion.propellerType", survey?.DetailsofPropulsionofEngine?.propellerType || "");
        setValue("bookOfRegistration.propulsion.revolutionMints", survey?.DetailsofPropulsionofEngine?.rpm?.toString() || "");
        setValue("bookOfRegistration.propulsion.vesselSpeed", survey?.DetailsofPropulsionofEngine?.vesselSpeed?.toString() || "");
        setValue("bookOfRegistration.propulsion.gearType", survey?.DetailsofPropulsionofEngine?.gearType || "");
        setValue("bookOfRegistration.propulsion.numberOfGear", survey?.DetailsofPropulsionofEngine?.noOfGear?.toString() || "");
      };
      populateBookOfRegistration();
    
  }, [registrationData, intialSurveyData, setValue]);

  useEffect(() => {
    if (originalRegistrationData && registrationData && intialSurveyData) {
      const engineDetails = originalRegistrationData?.engineDetails;
     
      if (engineDetails) {
        setValue("bookOfRegistration.engine.engineNo", engineDetails?.internalCombustionEngineNo || "");
        setValue("bookOfRegistration.engine.description", engineDetails?.description || "");
        setValue("bookOfRegistration.engine.cylindersPerSet", engineDetails?.noOfCylindersPerSet || "");
        setValue("bookOfRegistration.engine.nhp", engineDetails?.nhp?.toString() || "");
        setValue("bookOfRegistration.engine.ihp", engineDetails?.ihp?.toString() || "");
        setValue("bookOfRegistration.propulsion.propulsionType", engineDetails?.propulsionType || "");
      }
    }
  }, [originalRegistrationData, registrationData, intialSurveyData, setValue]);

  return (
    <form autoComplete="off">
      {/* Basic Vessel Information */}
      <Collapsible
        title={
          <>
            <FaShip className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("VESSEL IDENTIFICATION")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Official No. of the Vessel")}
              name="bookOfRegistration.vesselInfo.officialNo"
              register={register("bookOfRegistration.vesselInfo.officialNo")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Name of Vessel")}
              name="bookOfRegistration.vesselInfo.vesselName"
              register={register("bookOfRegistration.vesselInfo.vesselName")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Port of Registry of Vessel")}
              name="bookOfRegistration.vesselInfo.portOfRegistry"
              register={register("bookOfRegistration.vesselInfo.portOfRegistry")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Year of Registry")}
              name="bookOfRegistration.vesselInfo.yearOfRegistry"
              register={register("bookOfRegistration.vesselInfo.yearOfRegistry")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Name of Owner")}
              name="bookOfRegistration.vesselInfo.ownerName"
              register={register("bookOfRegistration.vesselInfo.ownerName")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Address of Owner")}
              name="bookOfRegistration.vesselInfo.ownerAddress"
              register={register("bookOfRegistration.vesselInfo.ownerAddress")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Description of Inland Vessel */}
      <Collapsible
        title={
          <>
            <FaShip className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("DESCRIPTION OF INLAND VESSEL")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Type of Vessel")}
              name="bookOfRegistration.vesselDescription.typeOfVessel"
              register={register("bookOfRegistration.vesselDescription.typeOfVessel")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Category of Vessel")}
              name="bookOfRegistration.vesselDescription.categoryOfVessel"
              register={register("bookOfRegistration.vesselDescription.categoryOfVessel")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Gross Tonnage")}
              name="bookOfRegistration.vesselDescription.grossTonnage"
              register={register("bookOfRegistration.vesselDescription.grossTonnage")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Registered Tonnage")}
              name="bookOfRegistration.vesselDescription.registeredTonnage"
              register={register("bookOfRegistration.vesselDescription.registeredTonnage")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Year of Build")}
              name="bookOfRegistration.vesselDescription.yearOfBuild"
              register={register("bookOfRegistration.vesselDescription.yearOfBuild")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Place of Build")}
              name="bookOfRegistration.vesselDescription.placeOfBuild"
              register={register("bookOfRegistration.vesselDescription.placeOfBuild")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Particulars of Vessels */}
      <Collapsible
        title={
          <>
            <FaShip className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("PARTICULARS OF VESSELS")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Length overall")}
              name="bookOfRegistration.vesselParticulars.lengthOverall"
              register={register("bookOfRegistration.vesselParticulars.lengthOverall")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Breadth Extreme")}
              name="bookOfRegistration.vesselParticulars.breadthExtreme"
              register={register("bookOfRegistration.vesselParticulars.breadthExtreme")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Depth of underside of deck amid ships, at side")}
              name="bookOfRegistration.vesselParticulars.depthOfDeck"
              register={register("bookOfRegistration.vesselParticulars.depthOfDeck")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Name of Builder")}
              name="bookOfRegistration.vesselParticulars.builderName"
              register={register("bookOfRegistration.vesselParticulars.builderName")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Address of Builder")}
              name="bookOfRegistration.vesselParticulars.builderAddress"
              register={register("bookOfRegistration.vesselParticulars.builderAddress")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Year of Build")}
              name="bookOfRegistration.vesselParticulars.yearOfBuild"
              register={register("bookOfRegistration.vesselParticulars.yearOfBuild")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Hull Material")}
              name="bookOfRegistration.vesselParticulars.hullMaterial"
              register={register("bookOfRegistration.vesselParticulars.hullMaterial")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Number of Decks")}
              name="bookOfRegistration.vesselParticulars.numberOfDecks"
              register={register("bookOfRegistration.vesselParticulars.numberOfDecks")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("No. of Bulkheads")}
              name="bookOfRegistration.vesselParticulars.numberOfBulkheads"
              register={register("bookOfRegistration.vesselParticulars.numberOfBulkheads")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Engine Details */}
      <Collapsible
        title={
          <>
            <FaCog className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("ENGINE")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Internal combustion engine No")}
              name="bookOfRegistration.engine.engineNo"
              placeholder={t("Enter Engine No")}
              register={register("bookOfRegistration.engine.engineNo")}
              disabled={false}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Description")}
              name="bookOfRegistration.engine.description"
              placeholder={t("Enter Description")}
              register={register("bookOfRegistration.engine.description")}
              disabled={false}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("No. of sets")}
              name="bookOfRegistration.engine.numberOfSets"
              register={register("bookOfRegistration.engine.numberOfSets")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Made by")}
              name="bookOfRegistration.engine.madeBy"
              register={register("bookOfRegistration.engine.madeBy")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Year of Make")}
              name="bookOfRegistration.engine.yearOfMake"
              register={register("bookOfRegistration.engine.yearOfMake")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("No. of cylinders per set")}
              name="bookOfRegistration.engine.cylindersPerSet"
              placeholder={t("Enter No. of cylinders")}
              register={register("bookOfRegistration.engine.cylindersPerSet")}
              disabled={false}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Diameter of cylinder in MM")}
              name="bookOfRegistration.engine.cylinderDiameter"
              register={register("bookOfRegistration.engine.cylinderDiameter")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Stroke in inches")}
              name="bookOfRegistration.engine.strokeInches"
              register={register("bookOfRegistration.engine.strokeInches")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("RPM")}
              name="bookOfRegistration.engine.rpm"
              register={register("bookOfRegistration.engine.rpm")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("N.H.P.")}
              name="bookOfRegistration.engine.nhp"
              placeholder={t("Enter N.H.P.")}
              register={register("bookOfRegistration.engine.nhp")}
              disabled={false}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("B.H.P.")}
              name="bookOfRegistration.engine.bhp"
              register={register("bookOfRegistration.engine.bhp")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("I.H.P.")}
              name="bookOfRegistration.engine.ihp"
              placeholder={t("Enter I.H.P.")}
              register={register("bookOfRegistration.engine.ihp")}
              disabled={false}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Propulsion */}
      <Collapsible
        title={
          <>
            <FaCog className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("PROPULSION")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Propeller Type")}
              name="bookOfRegistration.propulsion.propellerType"
              register={register("bookOfRegistration.propulsion.propellerType")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Revolution/mints")}
              name="bookOfRegistration.propulsion.revolutionMints"
              register={register("bookOfRegistration.propulsion.revolutionMints")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Vessel Speed")}
              name="bookOfRegistration.propulsion.vesselSpeed"
              register={register("bookOfRegistration.propulsion.vesselSpeed")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Gear Type")}
              name="bookOfRegistration.propulsion.gearType"
              register={register("bookOfRegistration.propulsion.gearType")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("No. of Gear")}
              name="bookOfRegistration.propulsion.numberOfGear"
              register={register("bookOfRegistration.propulsion.numberOfGear")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Propulsion Type")}
              name="bookOfRegistration.propulsion.propulsionType"
              placeholder={t("Enter Propulsion Type")}
              register={register("bookOfRegistration.propulsion.propulsionType")}
              disabled={false}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Transaction */}
      <Collapsible
        title={
          <>
            <FaExchangeAlt className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("TRANSACTION")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={12}>
            <InputText
              label={t("Name of person from whom title is derived")}
              name="bookOfRegistration.transaction.personName"
              register={register("bookOfRegistration.transaction.personName")}
              disabled={true}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("No. of shares affected")}
              name="bookOfRegistration.transaction.sharesAffected"
              register={register("bookOfRegistration.transaction.sharesAffected")}
              disabled={true}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Date of Registry")}
              name="bookOfRegistration.transaction.registryDate"
              type="date"
              register={register("bookOfRegistration.transaction.registryDate")}
              disabled={true}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Hour of Registry")}
              name="bookOfRegistration.transaction.registryHour"
              type="time"
              register={register("bookOfRegistration.transaction.registryHour")}
              disabled={true}
            />
          </Col>
        </Row>
      </Collapsible> 

      {/* Subsequent to Registration */}
      <Collapsible
        title={
          <>
            <FaExchangeAlt className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("TRANSACTION SUBSEQUENT TO REGISTRATION")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={6}>
            <InputText
              label={t("Nature of transaction")}
              name="bookOfRegistration.subsequentTransaction.natureOfTransaction"
              register={register("bookOfRegistration.subsequentTransaction.natureOfTransaction")}
              disabled={true}
            />
          </Col>
          <Col md={6}>
            <InputText
              label={t("Date of transaction")}
              name="bookOfRegistration.subsequentTransaction.transactionDate"
              type="date"
              register={register("bookOfRegistration.subsequentTransaction.transactionDate")}
              disabled={true}
            />
          </Col>
          <Col md={8}>
            <InputText
              label={t("Name, residence and occupation of transferee or mortgagee or other person acquiring title or power")}
              name="bookOfRegistration.subsequentTransaction.transfereeName"
              register={register("bookOfRegistration.subsequentTransaction.transfereeName")}
              disabled={true}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Number of transaction")}
              name="bookOfRegistration.subsequentTransaction.transactionNumber"
              register={register("bookOfRegistration.subsequentTransaction.transactionNumber")}
              disabled={true}
            />
          </Col>
        </Row>
      </Collapsible>
    </form>
  );
};

export default BookOfRegistrationForm;
