import axios from 'axios';

const API_BASE_URL = process.env.REACT_APP_USER_SERVICE || 'http://localhost:5000/api';

export const uploadDocument = async (file, docType = 'identification') => {
  const formData = new FormData();
  formData.append('file', file);
  formData.append('docType', docType);
  formData.append('uploadSource', 'web_upload');

  try {
    const response = await axios.post(`${API_BASE_URL}documents/upload`, formData, {
      headers: {
        'Content-Type': 'multipart/form-data',
        'Authorization': `Bearer ${localStorage.getItem('token')}` // If using auth
      }
    });

    return {
      success: true,
      fileId: response.data.fileId,
      docName: response.data.originalName,
      docType: response.data.docType,
      docSource: response.data.source,
      fileUrl: response.data.fileUrl
    };
  } catch (error) {
    console.error('Upload error:', error);
    throw new Error(error.response?.data?.message || 'Failed to upload document');
  }
};

