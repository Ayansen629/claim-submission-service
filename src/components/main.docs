import { useNavigate } from "react-router-dom";
import "react-toastify/dist/ReactToastify.css";
import { useTranslation } from "react-i18next";
import { useEffect, useState, useRef } from "react";
import ActionTable from "../../../common/ActionTable.tsx";
import { toast } from "react-toastify";
import { useForm } from "react-hook-form";
import { USER_REGIS_MASTER } from "./userManagConst.ts";
import { Card, Row, Col } from "react-bootstrap";
import InputSelect from "../../../common/InputSelect.tsx";
import InputText from "../../../common/InputText.tsx";
import NewLoader from "../../../common/NewLoader.js";
import { useMasterData } from "../../../context/MasterDataContext.js";
import { Typography, Stack } from "@mui/material";
import { handleErrorMessage } from "../../../../utils/errorMessageHandler.js";
import { postData } from "../../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import { allowOnlyInteger } from "../../../../utils/constants.ts";
// import { useAlert } from "../../../context/AlertHelper.js";
import { useLanguageContext } from "../../../common/LanguageContext.js";

const UserManagement = () => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const navigate = useNavigate();
  const [rowData, setRowData] = useState([]);
  const loaderRef = useRef();
  const { masterData } = useMasterData();
  // const { showAlert } = useAlert();

  const {
    register,
    handleSubmit,
    formState: { errors },
    reset,
    setValue,
    watch,
    trigger
  } = useForm({
    defaultValues: {
      empId: "",
      userName: "",
      designation: "",
      status: "",
      phoneNumber: "",
    },
  });
  useEffect(()=>{
    trigger();
  },[changeLanguage])

  const fetchedUserDetails = useRef(false);
  useEffect(() => {
    if (fetchedUserDetails.current) return;
    getUserDetails();
    fetchedUserDetails.current = true;
  }, []);

const columns = USER_REGIS_MASTER.USER_INFO_COLUMNS.map(col => ({
  ...col,
  colName: t(col.colName)
}));
  const getUserDetails = async (payload) => {
    
    try {
      const URL =
        process.env.REACT_APP_AUTH_URL + URLS_ENDPOINT.USER_SERVICE.EMP_DASHBOARD_SEARCH;

      loaderRef.current?.show();
      const result = await postData(URL, payload);
      console.log("result-search", result);
      const rData = result?.data?.data || [];

      if (result?.status === 200 && rData?.length > 0) {
        loaderRef?.current?.hide();
        const updatedData = rData?.map(
          ({ registrationNumber,employeeName, isActive,designation, ...rest }) => ({
            ...rest,
            registrationNumber,
          
            isActive,
            userId: registrationNumber || "",
            empName: employeeName || "",
            status: isActive ? "Active" : "Inactive",
            designation: designation|| "",
          })
        );
        setRowData(updatedData);
      } else {
        loaderRef?.current?.hide();
        toast.info(
          result?.data?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err?.response?.data);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const handleRowClick = (e) => {};

  const handleAddEmployee = () => {
    // showAlert({
    //   type: "info",
    //   title: "Employee Registration",
    //   message: "Please fill in the employee details to complete registration.",
    //   autoDismiss: true,
    //   buttons: [
    //     {
    //       label: "OK",
    //       onClick: () => {
    //         navigate("/employee-registration");
    //       },
    //     },
    //   ],
    // });
    navigate("/employee-registration");
  };

  const handleEditRow = (row) => {
    navigate(`/employee-registration/edit/${row?.userId}`, {
      state: { employee: row },
    });
  };

  const onSubmitFilterForm = async (data) => {
    if (data && Object.keys(data)?.length > 0) {
      getUserDetails(data);
    }
  };

  return (
    <>
      <NewLoader ref={loaderRef} />

      <Row className="mt-2">
        <Col md={9}>
          <Stack spacing={0.5} style={{ padding: "0.5rem" }}>
            <Typography
              sx={{
                fontWeight: 550,
                color: "#2E57A7",
                fontSize: "1.2rem",
              }}
            >
              {t("employeeRegistration.Manage Employee(s)")} &nbsp;
              <span style={{ color: "#666", fontSize: "0.65rem" }}>
                {t("employeeRegistration.(Fill in the employee details to complete registration)")}
              </span>
            </Typography>
          </Stack>
        </Col>
        <Col md={3} className="d-flex justify-content-end">
          <button
            className="generic-btn-submit"
            type="button"
            onClick={handleAddEmployee}
          >
            <i className="fa fa-plus" aria-hidden="true"></i> {t("employeeRegistration.New Employee")}
          </button>
        </Col>
      </Row>

      <div className="w-full">
        <Card>
          <form
            style={{ padding: "2rem", margin: 0 }}
            onSubmit={handleSubmit(onSubmitFilterForm)}
          >
            <Row>
              <Col md={2}>
                <InputText
                  type="text"
                  name="empId"
                  maxlength={13}
                  label={t("employeeRegistration.Employee Id")}
                  placeholder={t("employeeRegistration.Employee Id..")}
                  register={{
                    ...register("empId", {}),
                  }}
                  errors={errors}
                />
              </Col>

              <Col md={2}>
                <InputText
                  type="text"
                  name="userName"
                  label={t("employeeRegistration.Employee Name")}
                  maxlength={80}
                  placeholder={t("employeeRegistration.Employee name..")}
                  register={{
                    ...register("userName", {}),
                  }}
                  errors={errors}
                />
              </Col>

              <Col md={3}>
                <InputSelect
                  label={t("employeeRegistration.Designation")}
                  name="designation"
                  options={
                    masterData?.designations?.map((type) => ({
                      value: type.valueCode,
                      label: type.valueLabel,
                    })) || []
                  }
                  register={register}
                  errors={errors}
                  value={watch("designation")}
                  onChange={(val) => setValue("designation", val)}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label={t("employeeRegistration.Status")}
                  name="status"
                  placeholder={t("employeeRegistration.Status")}
                  options={[
                    { value: "", label: "--Select--" },
                    { value: "active", label: t("employeeRegistration.Active") },
                    { value: "inactive", label: t("employeeRegistration.Inactive") },
                  ]}
                  register={register}
                  errors={errors}
                  value={watch("status")}
                  onChange={(val) => setValue("status", val)}
                />
              </Col>

              <Col md={3}>
                <InputText
                  type="text"
                  name="phoneNumber"
                  label={t("employeeRegistration.Phone Number")}
                  maxlength={10}
                  placeholder={t("employeeRegistration.Enter Phone Number")}
                  register={{
                    ...register("phoneNumber", {}),
                  }}
                  onKeyDown={(e) => {
                    if (!allowOnlyInteger(e)) e.preventDefault();
                  }}
                  errors={errors}
                />
              </Col>
            </Row>

            <Col
              md={4}
              style={{ display: "flex", gap: "10px", float: "right" }}
            >
              <div className="w48">
                <button
                  className="generic-btn-cancel"
                  type="reset"
                  onClick={() => {
                    reset();
                  }}
                >
                  {t("employeeRegistration.Reset")}
                </button>
              </div>
              <div className="w48">
                <button className="generic-btn-submit" type="submit">
                 {t("employeeRegistration.Filter")}
                </button>
              </div>
            </Col>
          </form>
        </Card>

        <ActionTable
          tableHeader={t("employeeRegistration.Employee List")}
          columns={columns}
          rowData={rowData}
          additionalMethod={handleRowClick}
          showCustomBtn={true}
          btnName={t("employeeRegistration.Add")}
          handleBtnClick={handleAddEmployee}
          handleEditRow={handleEditRow}
          hideExportBtn={true}
          searchBarPlaceholder={t("Table.SEARCH_BY")}
        />
      </div>
    </>
  );
};

export default UserManagement;

export const USER_REGIS_MASTER = {
  USER_INFO_COLUMNS: [
    {
      colName: "Sl#",
      fieldName: "slNo",
      clsName: "column-text-start",
      isClickable: false,
      minWidth: "4rem",
    },
    {
      colName: "ID",
      fieldName: "userId",
      clsName: "column-text-start",
      isClickable: false,
    },
    {
      colName: "Name",
      fieldName: "empName",
      clsName: "column-text-start",
      minWidth: "10rem",
    },
    {
      colName: "Designation",
      fieldName: "designation",
      clsName: "column-text-start",
      minWidth: "10rem",
    },
    {
      colName: "ContactNo.",
      fieldName: "phoneNumber",
      clsName: "column-text-start",
      minWidth: "10rem",
    },
    {
      colName: "Email",
      fieldName: "emailId",
      clsName: "column-text-start",
      minWidth: "15rem",
    },
    {
      colName: "Status",
      fieldName: "status",
      clsName: "column-text-start",
      isClickable: false,
    },
    {
      colName: "Action",
      fieldName: "action",
      actions: ["edit"],
      clsName: "column-text-start actions-column",
    },
  ],

  // Table configuration
  TABLE_CONFIG: {
    defaultRowsPerPage: 5,
    paginationOptions: [5, 10, 25, 50, 100],
  },

  // Mock data for 100 users
  MOCK_USER_DATA: Array.from({ length: 100 }, (_, i) => ({
    // slNo: i + 1,
    userId: `EMP${10000 + i}`,
    nameAsPerAadhar: `User ${i + 1}`,
    roleName:
      i % 5 === 0
        ? "Manager"
        : i % 4 === 0
        ? "Developer"
        : i % 3 === 0
        ? "Designer"
        : i % 2 === 0
        ? "Analyst"
        : "Assistant",
    mobileNumber: `9${Math.floor(Math.random() * 900000000 + 100000000)}`,
    status:
      i % 6 === 0
        ? "Active"
        : i % 6 === 1
        ? "Pending"
        : i % 6 === 2
        ? "Rejected"
        : i % 6 === 3
        ? "Draft"
        : i % 6 === 4
        ? "Completed"
        : "Inactive",
    action: ["edit", "view"],
  })),
};

