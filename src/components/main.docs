const actionDropdown =
  isViewMode && isOfficerLogin && actionsFromAPI?.length > 0 ? (
    <div style={{ display: "flex", gap: "0.4rem", alignItems: "center" }}>
      <Button
        variant="contained"
        onClick={() => handleFormSubmit({ index: 1, getFormData: () => methods?.getValues() })}
        style={{
          backgroundColor: "#1f4ea0",
          fontWeight: "bold",
          borderRadius: "0.5rem",
          minWidth: "6rem",
          fontSize: "0.8rem",
          color: "#fff",
          padding: "4px 12px",
          height: "32px",
        }}
      >
        Save
      </Button>
      
      {userRole === USER_ROLES?.OFFICER_L3 && showOfficerActions && (
        <>
          <Button
            variant="outlined"
            onClick={() => handleProvisionModalOpen("survey")}
            style={{
              background: "linear-gradient(90deg, #bbf7d0 0%, #f0fdfa 100%)",
              color: "#166534",
              borderColor: "#86efac",
              fontWeight: "500",
              borderRadius: "4px",
              minWidth: "3.5rem",
              fontSize: "0.65rem",
              padding: "4px 6px",
              height: "26px",
              border: "1px solid #86efac",
            }}
          >
            Survey
          </Button>
          <Button
            variant="outlined"
            onClick={() => handleProvisionModalOpen("registration")}
            style={{
              background: "linear-gradient(90deg, #bbf7d0 0%, #f0fdfa 100%)",
              color: "#166534",
              borderColor: "#86efac",
              fontWeight: "500",
              borderRadius: "4px",
              minWidth: "3.5rem",
              fontSize: "0.65rem",
              padding: "4px 6px",
              height: "26px",
              border: "1px solid #86efac",
            }}
          >
            Register
          </Button>
        </>
      )}
      
      <ActionDropdown
        actions={actionsFromAPI}
        onActionClick={handleWorkflowActionClick}
        variant="contained"
        sx={{
          backgroundColor: "#2E57A7",
          fontWeight: "bold",
          borderRadius: "0.5rem",
          minWidth: "6rem",
          fontSize: "0.8rem",
          color: "#fff",
          height: "32px",
          "&:hover": {
            backgroundColor: "#1f4ea0",
          },
        }}
      />
    </div>
  ) : null;
