const CurvingMarkingNote = ({ registrationData, onSubmitAppointments }) => {
  const { t } = useTranslation();
  const [showModal, setShowModal] = useState(false);
  
  // Check if any appointment is booked
  const hasBookedAppointment = registrationData?.appointmentSlots?.some(slot => slot.isBooked);
  
  const [displayAppointment, setDisplayAppointment] = useState(
    registrationData?.appointmentSlots?.length > 0 && !hasBookedAppointment ? false : !hasBookedAppointment
  );

  const userRole = getFromLocalStorage("userRole") || "";
  const isOfficer = userRole === USER_ROLES.OFFICER_L3 || userRole === USER_ROLES.OFFICER_L4;

  // ... rest of the component remains the same until the button render

  return (
    <Container fluid className="p-0">
      <Card className="mb-1">
        <Card.Body>
          <div className="d-flex justify-content-between align-items-center mb-4">
            <div>
              <h6 style={{ color: "#2466BF", marginBottom: "0.5rem" }}>
                {t("Curving & Marking Note")}
              </h6>
              <p style={{ color: "#64748b", fontSize: "0.9rem", margin: 0 }}>
                {t("Vessel Registration Details")}
              </p>
            </div>
            {(displayAppointment || userRole === USER_ROLES.VESSEL_OWNER) && !hasBookedAppointment && (
              <Button
                variant="primary"
                onClick={() => setShowModal(true)}
                className="d-flex align-items-center gap-2"
                style={{
                  backgroundColor: "#2E57A7",
                  borderColor: "#2E57A7",
                  fontWeight: 600,
                  padding: "10px 24px",
                  borderRadius: "8px",
                  fontSize: "0.9rem",
                  boxShadow: "0 4px 12px rgba(46, 87, 167, 0.2)",
                  transition: "all 0.3s ease",
                }}
              >
                <BsCalendarCheck size={16} />
                {isOfficer ? "Propose Appointments" : "Schedule Appointment"}
              </Button>
            )}
          </div>

          {/* Rest of the component remains the same */}
        </Card.Body>
      </Card>

      {/* Modals remain the same */}
    </Container>
  );
};
