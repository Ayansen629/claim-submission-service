import React, { useState } from "react";
import { useForm, useFieldArray } from "react-hook-form";
import { Button, TextField, MenuItem, Box, Stepper, Step, StepLabel, Typography } from "@mui/material";

const categories = ["Individual", "Company"];

const RegistrationForm = () => {
  const {
    register,
    control,
    handleSubmit,
    watch,
    formState: { errors },
  } = useForm({
    defaultValues: {
      category: "",
      ownerName: "",
      email: "",
      phone: "",
      pan: "",
      gst: "",
      address1: "",
      address2: "",
      pin: "",
      district: "",
      state: "",
      country: "",
      authorizedPersons: [
        {
          firstName: "",
          lastName: "",
          mobile: "",
          email: "",
        },
      ],
      documents: {
        panCard: null,
        gstCertificate: null,
        addressProof: null,
        companyRegCert: null,
        cin: "",
        din: "",
        moa: null,
        aoa: null,
      },
    },
  });

  const { fields, append, remove } = useFieldArray({
    name: "authorizedPersons",
    control,
  });

  const [activeStep, setActiveStep] = useState(0);

  const nextStep = () => setActiveStep((prev) => prev + 1);
  const prevStep = () => setActiveStep((prev) => prev - 1);

  const onSubmit = (data) => {
    console.log("Form Data:", data);
    alert("Form submitted successfully!");
  };

  // Simulate auto-populating district/state/country based on PIN
  const handlePinChange = (e) => {
    const pin = e.target.value;
    if (pin.length === 6) {
      // Mock API call
      register("district").onChange({ target: { value: "Mumbai" } });
      register("state").onChange({ target: { value: "Maharashtra" } });
      register("country").onChange({ target: { value: "India" } });
    }
  };

  const isCompany = watch("category") === "Company";

  return (
    <Box sx={{ width: "100%", maxWidth: 600, margin: "auto", mt: 4 }}>
      <Stepper activeStep={activeStep}>
        <Step>
          <StepLabel>Vessel Owner</StepLabel>
        </Step>
        <Step>
          <StepLabel>Authorized Person</StepLabel>
        </Step>
        <Step>
          <StepLabel>Documents</StepLabel>
        </Step>
      </Stepper>

      <form onSubmit={handleSubmit(onSubmit)}>
        {activeStep === 0 && (
          <Box>
            <TextField
              label="Category of Owner"
              select
              fullWidth
              {...register("category")}
              margin="normal"
              error={!!errors.category}
              helperText={errors.category?.message}
            >
              {categories.map((cat) => (
                <MenuItem key={cat} value={cat}>
                  {cat}
                </MenuItem>
              ))}
            </TextField>

            <TextField label="Owner/Company Name" fullWidth {...register("ownerName")} margin="normal" />
            <TextField label="Email ID" fullWidth {...register("email")} margin="normal" type="email" />
            <TextField label="Phone Number" fullWidth {...register("phone")} margin="normal" />
            <TextField label="PAN Number" fullWidth {...register("pan")} margin="normal" />
            <TextField label="GST Number" fullWidth {...register("gst")} margin="normal" />

            <Typography variant="h6" sx={{ mt: 2 }}>Address Details</Typography>
            <TextField label="Address Line-1" fullWidth {...register("address1")} margin="normal" />
            <TextField label="Address Line-2" fullWidth {...register("address2")} margin="normal" />
            <TextField
              label="PIN"
              fullWidth
              {...register("pin")}
              onChange={(e) => {
                register("pin").onChange(e);
                handlePinChange(e);
              }}
              margin="normal"
            />
            <TextField label="District" fullWidth {...register("district")} margin="normal" disabled />
            <TextField label="State/UT" fullWidth {...register("state")} margin="normal" disabled />
            <TextField label="Country" fullWidth {...register("country")} margin="normal" disabled />
          </Box>
        )}

        {activeStep === 1 && (
          <Box>
            <Typography variant="h6">Authorized Persons</Typography>
            {fields.map((field, index) => (
              <Box key={field.id} sx={{ mb: 2, p: 2, border: "1px solid #ccc", borderRadius: 1 }}>
                <TextField label="First Name" fullWidth {...register(`authorizedPersons.${index}.firstName`)} margin="normal" />
                <TextField label="Last Name" fullWidth {...register(`authorizedPersons.${index}.lastName`)} margin="normal" />
                <TextField label="Mobile Number" fullWidth {...register(`authorizedPersons.${index}.mobile`)} margin="normal" />
                <TextField label="Email ID" fullWidth {...register(`authorizedPersons.${index}.email`)} margin="normal" type="email" />
                <Button variant="outlined" color="error" onClick={() => remove(index)}>Remove</Button>
              </Box>
            ))}

            <Button
              variant="contained"
              onClick={() => append({ firstName: "", lastName: "", mobile: "", email: "" })}
              sx={{ mt: 2 }}
            >
              Add Authorized Person
            </Button>
          </Box>
        )}

        {activeStep === 2 && (
          <Box>
            <Typography variant="h6">Document Uploads</Typography>

            <input type="file" {...register("documents.panCard")} />
            <input type="file" {...register("documents.gstCertificate")} />
            <input type="file" {...register("documents.addressProof")} />

            {!isCompany && <input type="file" {...register("documents.companyRegCert")} />}

            <TextField label="CIN Number" fullWidth {...register("documents.cin")} margin="normal" />
            <TextField label="DIN Number" fullWidth {...register("documents.din")} margin="normal" />
            <input type="file" {...register("documents.moa")} />
            <input type="file" {...register("documents.aoa")} />
          </Box>
        )}

        <Box sx={{ display: "flex", justifyContent: "space-between", mt: 3 }}>
          <Button disabled={activeStep === 0} onClick={prevStep}>Back</Button>
          {activeStep < 2 ? (
            <Button variant="contained" onClick={nextStep}>Next</Button>
          ) : (
            <Button variant="contained" type="submit">Submit</Button>
          )}
        </Box>
      </form>
    </Box>
  );
};

export default RegistrationForm;
