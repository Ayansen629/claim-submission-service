// Updated EmployeeDashboard.jsx - Card.Body part only
<Card.Body>
  <div className="row g-3">
    {getStatData().map((item, index) => (
      <div 
        className="col-md-4 col-lg-3 col-sm-12" 
        key={index}
        style={item.isCalendar ? { flex: '0 0 auto', width: '50%' } : {}}
      >
        {item.isCalendar ? (
          <SurveyTrackerCard events={item.events} color={item.color || "#6f42c1"} />
        ) : (
          <StatusCard {...item} />
        )}
      </div>
    ))}
  </div>
</Card.Body>
