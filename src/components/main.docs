// Add validation for registration certificate
if (isRegistration) {
  const requiredFields = [
    { field: "expiryDate", message: "Expiry date is required" },
    { field: "numberOfTenthShares", message: "Number of tenth shares is required" }
  ];

  for (const { field, message } of requiredFields) {
    if (!formData[field] || formData[field].toString().trim() === "") {
      toast.error(message);
      return;
    }
  }

  // Validate tenth shares format (e.g., "10/10")
  const sharesPattern = /^\d+\/\d+$/;
  if (!sharesPattern.test(formData.numberOfTenthShares)) {
    toast.error("Number of tenth shares must be in format like '10/10'");
    return;
  }
}
