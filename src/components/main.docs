const ProvisionModal = ({
  show,
  onHide = () => {},
  onGenerateCertificate = () => {},
  type,
  preFilledCertData = {},
  registrationData,
}) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  const certificateRef = useRef();

  const handleGenerateCertificate = () => {
    if (type === "survey") {
      if (certificateRef.current && !certificateRef.current.validate()) {
        return; // Stop if validation fails
      }
    }
    onGenerateCertificate(formData);
  };

  return (
    <Modal show={show} onHide={onHide} size="lg" centered backdrop="static">
      <Modal.Header className="border-0 pb-0" style={{background: "linear-gradient(to right, #0c5dcf 10%, #91daff 50%, #0c5dcf 100%)", borderRadius: "0.5rem 0.5rem 0 0"}}>
        <div className="d-flex align-items-center w-100">
          <h5 className="mb-0 fw-bold flex-grow-1" style={{ color: "#001044" }}>
            {type === "survey" ? "PROVISIONAL CERTIFICATE OF SURVEY" : "PROVISIONAL CERTIFICATE OF REGISTRATION"}
          </h5>
          <Button variant="link" onClick={onHide} className="p-2" style={{color: "#ffffff", textDecoration: "none", borderRadius: "50%", transition: "all 0.2s ease"}}>
            <BsX size={24} />
          </Button>
        </div>
      </Modal.Header>

      <Modal.Body className="pt-4">
        {type === "survey" ? (
          <ProvisionalCertificateOfSurvey
            ref={certificateRef}
            registrationData={registrationData}
            preFilledCertData={preFilledCertData}
            onDataChange={setFormData}
          />
        ) : (
          <ProvisionalCertificateOfRegistration
            registrationData={registrationData}
            preFilledCertData={preFilledCertData}
            onDataChange={setFormData}
          />
        )}
      </Modal.Body>

      <Modal.Footer className="border-0 pt-0 pb-4" style={{ background: "#f8f9fa" }}>
        <Button variant="outline-secondary" onClick={onHide} className="me-3 px-4 py-2" style={{borderRadius: "8px", fontWeight: "500", transition: "all 0.2s ease"}}>
          Cancel
        </Button>
        <Button
          onClick={handleGenerateCertificate}
          className="px-4 py-2"
          style={{
            background: "linear-gradient(135deg, #2E57A7 0%, #1e3a8a 100%)",
            border: "none",
            borderRadius: "8px",
            fontWeight: "500",
            boxShadow: "0 4px 12px rgba(46, 87, 167, 0.3)",
            transition: "all 0.2s ease",
          }}
        >
          Generate Certificate
        </Button>
      </Modal.Footer>
    </Modal>
  );
};
