// Check if tonnage and stability booklets are required
const isTonnageRequired = () => {
  if (editMode) {
    const existingTonnageFile = getValues("tonnageBooklets");
    // Required if: has existing file ID OR has GRT value
    return !!(existingTonnageFile?.id || (grossTonnage && grossTonnage.trim() !== ""));
  }
  // In create mode, only required if grossTonnage has value
  return !!(grossTonnage && grossTonnage.trim() !== "");
};

const isStabilityRequired = () => {
  if (editMode) {
    const existingStabilityFile = getValues("stabilityBooklets");
    // Required if: has existing file ID OR has GRT value
    return !!(existingStabilityFile?.id || (grossTonnage && grossTonnage.trim() !== ""));
  }
  // In create mode, only required if grossTonnage has value
  return !!(grossTonnage && grossTonnage.trim() !== "");
};
