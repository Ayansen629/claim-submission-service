import React from "react";
import { Card, Table, Row, Col, Button } from "react-bootstrap";
import { useTranslation } from "react-i18next";

const InvoiceBreakdown = ({ invoiceBreakupInfo, summary }) => {
  const { t } = useTranslation();

  return (
    <div className="container py-4">
      <h2 className="mb-4" style={{ color: "#2466BF", fontWeight: 600 }}>
        {t("Invoice Breakdown")}
      </h2>
      <Row className="justify-content-center">
        <Col md={10}>
          <Card className="shadow-sm">
            <Card.Header style={{ background: "#EAF1FB", color: "#2466BF", fontWeight: 600 }}>
              {t("Invoice Details")}
            </Card.Header>
            <Card.Body>
              <Table bordered hover responsive className="mb-4">
                <thead style={{ background: "#f8f9fa" }}>
                  <tr>
                    <th width="40%">{t("Item Description")}</th>
                    <th width="30%">{t("Components")}</th>
                    <th width="30%" className="text-end">
                      {t("Amount (₹)")}
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {invoiceBreakupInfo.map((item) => (
                    <tr key={item.id}>
                      <td style={{ fontWeight: 500 }}>{item.label}</td>
                      <td>
                        {item.components ? (
                          <ul className="list-unstyled mb-0">
                            {item.components.map((comp, idx) => (
                              <li key={idx}>
                                <small>
                                  {comp.name}: ₹{comp.amount.toFixed(2)}
                                </small>
                              </li>
                            ))}
                          </ul>
                        ) : (
                          "-"
                        )}
                      </td>
                      <td className="text-end">
                        {item.amount
                          ? `₹${item.amount.toFixed(2)}`
                          : item.components
                          ? `₹${item.components.reduce((sum, comp) => sum + comp.amount, 0).toFixed(2)}`
                          : "-"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </Table>

              <Card className="border-0 shadow-sm">
                <Card.Body>
                  <Row>
                    <Col md={6}>
                      <div className="d-flex justify-content-between mb-2">
                        <span>{t("Sub Total:")}</span>
                        <span style={{ fontWeight: 500 }}>₹{summary.subTotal.toFixed(2)}</span>
                      </div>
                      <div className="d-flex justify-content-between mb-2">
                        <span>{t("CGST (9%):")}</span>
                        <span style={{ fontWeight: 500 }}>₹{summary.cgst.toFixed(2)}</span>
                      </div>
                      <div className="d-flex justify-content-between mb-2">
                        <span>{t("SGST (9%):")}</span>
                        <span style={{ fontWeight: 500 }}>₹{summary.sgst.toFixed(2)}</span>
                      </div>
                    </Col>
                    <Col md={6}>
                      <div
                        className="p-3"
                        style={{ background: "#EAF1FB", borderRadius: "5px" }}
                      >
                        <div className="d-flex justify-content-between mb-1">
                          <span style={{ fontWeight: 600 }}>{t("Total Payable:")}</span>
                          <span style={{ fontWeight: 600, color: "#2466BF", fontSize: "1.1rem" }}>
                            ₹{summary.totalPayable.toFixed(2)}
                          </span>
                        </div>
                        <small className="text-muted">
                          {t("All amounts are in Indian Rupees")}
                        </small>
                      </div>
                    </Col>
                  </Row>
                </Card.Body>
              </Card>

              <div className="d-flex justify-content-end mt-4">
                <Button
                  variant="primary"
                  size="lg"
                  style={{ background: "#2466BF", border: "none", padding: "0.5rem 2rem" }}
                >
                  {t("Proceed to Payment")}
                </Button>
              </div>
            </Card.Body>
          </Card>
        </Col>
      </Row>
    </div>
  );
};

export default InvoiceBreakdown;
