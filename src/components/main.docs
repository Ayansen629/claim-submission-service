import React from "react";
import { useTranslation } from "react-i18next";
import { BsFileEarmarkPdf, BsDownload } from "react-icons/bs";
import { Card, Row, Col, Button } from "react-bootstrap";
import Collapsible from "../../../../common/Collapsible.js";

const VesselBasicDetailsView = ({ formData, isPreview = true, registrationData }) => {
  const { t } = useTranslation();

  const getDisplayData = () => {
    if (registrationData) {
      const { basicDetails, vesselDetails } = registrationData;
      
      return {
        ownerDetails: {
          ownerName: basicDetails?.ownerDetails?.ownerCompanyName || "N/A",
          ownerAddress: basicDetails?.ownerDetails ? 
            `${basicDetails.ownerDetails.addressLine1}, ${basicDetails.ownerDetails.addressLine2}` : "N/A",
          mobile: basicDetails?.ownerDetails?.phoneNumber || "N/A",
          email: basicDetails?.ownerDetails?.emailId || "N/A",
          pan: basicDetails?.ownerDetails?.panNo || "N/A",
          aadhar: basicDetails?.ownerDetails?.aadharNumber || "N/A",
          tradeLicence: basicDetails?.ownerDetails?.tradeLicenseNumber || "N/A",
          gst: basicDetails?.ownerDetails?.gstNo || "N/A",
        },
        vesselDetails: {
          grt: vesselDetails?.grossTonnage?.toString() || "N/A",
          workOrderValue: vesselDetails?.workOrderValue || "N/A",
          vesselType: vesselDetails?.typeOfVessel || "N/A",
          category: vesselDetails?.categoryOfVessel || "N/A",
          zone: vesselDetails?.zone || "N/A",
          supervisionAuthority: vesselDetails?.supervisionAuthority || "N/A",
          purchaseType: vesselDetails?.purchaseType || "N/A",
          classificationSociety: vesselDetails?.nameOfClassificationSociety || "N/A",
          constructedBy: basicDetails?.constructedBy || "N/A",
        },
        builderDetails: basicDetails?.builderDetails ? {
          builderName: basicDetails.builderDetails.builderName || "N/A",
          builderAddress: basicDetails.builderDetails ? 
            `${basicDetails.builderDetails.addressLine1}, ${basicDetails.builderDetails.addressLine2}` : "N/A",
          builderEmail: basicDetails.builderDetails.emailId || "N/A",
          builderMobile: basicDetails.builderDetails.phone || "N/A",
          builderTradeLicence: basicDetails.builderDetails.tradeLicenseNumber || "N/A",
          builderGST: basicDetails.builderDetails.gstNo || "N/A",
          builderAuth: basicDetails.builderAuthorization || "N/A",
        } : null,
        documents: {
          workOrderFiles: getWorkOrderFiles(registrationData.documents),
          drawingFiles: getDrawingFiles(registrationData.documents),
          tonnageBooklets: getTonnageBooklets(registrationData.documents),
          stabilityBooklets: getStabilityBooklets(registrationData.documents),
          authLetter: getAuthLetter(registrationData.documents),
        }
      };
    }
    
    return {
      ownerDetails: {
        ownerName: formData?.ownerName || "John Doe",
        ownerAddress: formData?.ownerAddress || "123 Main Street, Harbor City, State 12345",
        mobile: formData?.mobile || "9876543210",
        email: formData?.email || "john.doe@example.com",
        pan: formData?.pan || "ABCDE1234F",
        aadhar: formData?.aadhar || "123456789012",
        tradeLicence: formData?.tradeLicence || "TL123456789",
        gst: formData?.gst || "GST123456789012",
      },
      vesselDetails: {
        grt: formData?.grt || "500",
        workOrderValue: formData?.workOrderValue || "1000000",
        vesselType: formData?.vesselType || "New Vessel",
        category: formData?.category || "Category A",
        zone: formData?.zone || "Zone 1",
        supervisionAuthority: formData?.supervisionAuthority || "IWT",
        purchaseType: formData?.purchaseType || "New",
        classificationSociety: formData?.classificationSociety || "Lloyd's Register",
        constructedBy: formData?.constructedBy === "1" ? "Self" : "Builder",
      },
      builderDetails: {
        builderName: formData?.builderName || "ABC Marine Shipyard Pvt Ltd",
        builderAddress: formData?.builderAddress || "456 Port Road, Shipyard Complex",
        builderEmail: formData?.builderEmail || "contact@abcshipyard.com",
        builderMobile: formData?.builderMobile || "9876543211",
        builderTradeLicence: formData?.builderTradeLicence || "BTL789012345",
        builderGST: formData?.builderGST || "BGST987654321098",
        builderAuth: formData?.builderAuth || "Authorized",
      },
      documents: {
        workOrderFiles: [{ name: "Work_Order_Document_01.pdf", description: "Main contract document", size: "1.2 MB" }],
        drawingFiles: [{ name: "Technical_Drawing_01.pdf", description: "General arrangement plan", size: "2.1 MB" }],
        tonnageBooklets: { name: "Tonnage_Booklets.pdf", size: "0.5 MB" },
        stabilityBooklets: { name: "Stability_Booklets.pdf", size: "0.7 MB" },
        authLetter: { name: "Authorization_Letter.pdf", size: "0.3 MB" },
      }
    };
  };

  function getWorkOrderFiles(documents) {
    if (!documents) return [];
    return documents
      .filter(doc => doc.documentType === "WORK_ORDER")
      .map(doc => ({
        name: doc.documentName,
        description: doc.description || "Work order document",
        size: "1.2 MB",
      }));
  }

  function getDrawingFiles(documents) {
    if (!documents) return [];
    return documents
      .filter(doc => doc.documentType === "DRAWINGS")
      .map(doc => ({
        name: doc.documentName,
        description: doc.description || "Technical drawing",
        size: "2.1 MB",
      }));
  }

  function getTonnageBooklets(documents) {
    if (!documents) return { name: "Tonnage_Booklets.pdf", size: "0.5 MB" };
    const doc = documents.find(d => d.documentType === "TONNAGE_BOOKLETS");
    return doc ? { name: doc.documentName, size: "0.5 MB" } : { name: "Tonnage_Booklets.pdf", size: "0.5 MB" };
  }

  function getStabilityBooklets(documents) {
    if (!documents) return { name: "Stability_Booklets.pdf", size: "0.7 MB" };
    const doc = documents.find(d => d.documentType === "STABILITY_BOOKLETS");
    return doc ? { name: doc.documentName, size: "0.7 MB" } : { name: "Stability_Booklets.pdf", size: "0.7 MB" };
  }

  function getAuthLetter(documents) {
    if (!documents) return { name: "Authorization_Letter.pdf", size: "0.3 MB" };
    const doc = documents.find(d => d.documentType === "AUTHORIZATION_LETTER");
    return doc ? { name: doc.documentName, size: "0.3 MB" } : { name: "Authorization_Letter.pdf", size: "0.3 MB" };
  }

  const previewData = getDisplayData();

  const handleDownload = (fileName) => {
    const link = document.createElement("a");
    link.href = "#";
    link.download = fileName;
    link.click();
  };

  const DocumentCard = ({ fileName, description, fileSize }) => (
    <Card className="mb-2 border-0 shadow-sm">
      <Card.Body className="p-3">
        <div className="d-flex justify-content-between align-items-center">
          <div className="d-flex align-items-center flex-grow-1">
            <div className="bg-danger bg-opacity-10 rounded-circle p-2 me-3">
              <BsFileEarmarkPdf className="text-danger" size={16} />
            </div>
            <div className="flex-grow-1">
              <h6 className="mb-1 text-primary fw-semibold" style={{ fontSize: "0.75rem" }}>
                {fileName}
              </h6>
              <p className="mb-0 text-muted" style={{ fontSize: "0.7rem" }}>
                {description}
                <span className="ms-2 badge bg-light text-dark" style={{ fontSize: "0.65rem" }}>
                  {fileSize}
                </span>
              </p>
            </div>
          </div>
          <Button
            variant="outline-primary"
            size="sm"
            onClick={() => handleDownload(fileName)}
            className="rounded-pill"
            style={{ padding: "4px 8px" }}
          >
            <BsDownload size={12} />
          </Button>
        </div>
      </Card.Body>
    </Card>
  );

  return (
    <>
      <Collapsible title={t("Owner Details")} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <Row>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Name of Owner")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.ownerName}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Address of Owner")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.ownerAddress}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Mobile")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.mobile}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Email Id")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.email}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("PAN")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.pan}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Aadhar")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.aadhar}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Trade Licence")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.tradeLicence}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("GST")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.gst}</div>
              </div>
            </Col>
          </Row>
        </div>
      </Collapsible>

      <Collapsible title={t("Vessel Details")} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <Row>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Gross Tonnage (GRT)")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.grt}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Work Order Value")}</label>
                <div className="form-control bg-light">Rs. {previewData.vesselDetails.workOrderValue}/-</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Type of Vessel")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.vesselType}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Category")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.category}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Zone")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.zone}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Supervision Authority")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.supervisionAuthority}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Purchase Type")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.purchaseType}</div>
              </div>
            </Col>
            <Col md={8}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Name of the Classification Society")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.classificationSociety}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Constructed By")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.constructedBy}</div>
              </div>
            </Col>
          </Row>
        </div>
      </Collapsible>

      {previewData.builderDetails && (
        <Collapsible title={t("Builder Details")} openStat={true}>
          <div style={{ padding: "1rem" }}>
            <Row>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Builder Name")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderName}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Builder Address")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderAddress}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Builder Email Id")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderEmail}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Mobile")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderMobile}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Trade Licence")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderTradeLicence}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("GST")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderGST}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Builder Authorization")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderAuth}</div>
                </div>
              </Col>
              <Col md={8}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Authorization Letter")}</label>
                  <DocumentCard
                    fileName={previewData.documents.authLetter.name}
                    description="Builder authorization document"
                    fileSize={previewData.documents.authLetter.size}
                  />
                </div>
              </Col>
            </Row>
          </div>
        </Collapsible>
      )}

      <Collapsible title={t("Documents")} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <Row className="g-4">
            <Col lg={6} md={12}>
              <Card className="h-100 shadow-sm border-0">
                <Card.Header className="bg-light border-0 py-3">
                  <h5 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: "0.8rem" }}>
                    <BsFileEarmarkPdf className="text-primary me-2" size={16} />
                    {t("Work Order")} ({previewData.documents.workOrderFiles.length})
                  </h5>
                </Card.Header>
                <Card.Body className="p-3" style={{ maxHeight: "400px", overflowY: "auto" }}>
                  {previewData.documents.workOrderFiles.map((file, index) => (
                    <DocumentCard
                      key={index}
                      fileName={file.name}
                      description={file.description}
                      fileSize={file.size}
                    />
                  ))}
                </Card.Body>
              </Card>
            </Col>

            <Col lg={6} md={12}>
              <Card className="h-100 shadow-sm border-0">
                <Card.Header className="bg-light border-0 py-3">
                  <h5 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: "0.8rem" }}>
                    <BsFileEarmarkPdf className="text-success me-2" size={16} />
                    {t("Drawings")} ({previewData.documents.drawingFiles.length})
                  </h5>
                </Card.Header>
                <Card.Body className="p-3" style={{ maxHeight: "400px", overflowY: "auto" }}>
                  {previewData.documents.drawingFiles.map((file, index) => (
                    <DocumentCard
                      key={index}
                      fileName={file.name}
                      description={file.description}
                      fileSize={file.size}
                    />
                  ))}
                </Card.Body>
              </Card>
            </Col>

            <Col md={6}>
              <Card className="h-100 shadow-sm border-0">
                <Card.Header className="bg-light border-0 py-3">
                  <h5 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: "0.8rem" }}>
                    <BsFileEarmarkPdf className="text-warning me-2" size={16} />
                    {t("Tonnage Booklets")}
                  </h5>
                </Card.Header>
                <Card.Body className="p-3">
                  <DocumentCard
                    fileName={previewData.documents.tonnageBooklets.name}
                    description="Tonnage certification document"
                    fileSize={previewData.documents.tonnageBooklets.size}
                  />
                </Card.Body>
              </Card>
            </Col>

            <Col md={6}>
              <Card className="h-100 shadow-sm border-0">
                <Card.Header className="bg-light border-0 py-3">
                  <h5 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: "0.8rem" }}>
                    <BsFileEarmarkPdf className="text-info me-2" size={16} />
                    {t("Stability Booklets")}
                  </h5>
                </Card.Header>
                <Card.Body className="p-3">
                  <DocumentCard
                    fileName={previewData.documents.stabilityBooklets.name}
                    description="Stability certification document"
                    fileSize={previewData.documents.stabilityBooklets.size}
                  />
                </Card.Body>
              </Card>
            </Col>
          </Row>
        </div>
      </Collapsible>
    </>
  );
};

export default VesselBasicDetailsView;
