import React, { useState, useEffect, useRef } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFilePdf, FaFileImage, FaTrash, FaTimes } from "react-icons/fa";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
  defaultValue?: string | File;
  autoFocus?: boolean;
  clearErrors?: (fieldName: string) => void;
  register?: any;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  watch,
  defaultValue,
  clearErrors,
  register
}) => {
  const hasError = errors && errors[name];
  const fileInputRef = useRef<HTMLInputElement>(null);
  const [fileSelected, setFileSelected] = useState(false);
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  const currentFile = watch ? watch(name) : null;

  useEffect(() => {
    if (currentFile && fileSelected) {
      clearErrors && clearErrors(name);
    }
  }, [currentFile, fileSelected, name, clearErrors]);

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files[0]) {
      setFileSelected(true);
      if (onChange) {
        onChange(e);
      }
    }
  };

  const handleRemoveFile = () => {
    if (fileInputRef.current) {
      fileInputRef.current.value = '';
    }
    setFileSelected(false);
    
    // Create a fake event to trigger onChange with empty file
    const fakeEvent = {
      target: {
        files: null,
        value: ''
      }
    } as any;
    
    if (onChange) {
      onChange(fakeEvent);
    }
  };

  const getFileIcon = (fileName: string) => {
    if (fileName.toLowerCase().includes('.pdf')) {
      return <FaFilePdf className="text-danger" size={16} />;
    }
    return <FaFileImage className="text-success" size={16} />;
  };

  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold text-dark mb-2">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      {currentFile ? (
        // File Selected State
        <div className={`border rounded-3 p-3 ${hasError ? 'border-danger bg-danger-subtle' : 'border-success bg-success-subtle'}`}>
          <div className="d-flex align-items-center justify-content-between">
            <div className="d-flex align-items-center flex-grow-1 me-3">
              <div className="me-3">
                {getFileIcon(currentFile.name)}
              </div>
              <div className="flex-grow-1 min-width-0">
                <div className="fw-semibold text-success small mb-1">
                  {t("File Selected")}
                </div>
                <div 
                  className="text-dark fw-medium"
                  style={{ 
                    fontSize: '0.9rem',
                    overflow: 'hidden', 
                    textOverflow: 'ellipsis', 
                    whiteSpace: 'nowrap' 
                  }}
                  title={currentFile.name}
                >
                  {currentFile.name}
                </div>
                {currentFile.size && (
                  <div className="text-muted small">
                    {(currentFile.size / 1024 / 1024).toFixed(2)} MB
                  </div>
                )}
              </div>
            </div>
            <div className="d-flex gap-2">
              <label
                htmlFor={name}
                className="btn btn-outline-primary btn-sm rounded-pill px-3"
                style={{ cursor: disabled ? 'not-allowed' : 'pointer' }}
              >
                <FaUpload size={12} className="me-1" />
                {t("Change")}
              </label>
              <button
                type="button"
                className="btn btn-outline-danger btn-sm rounded-pill px-3"
                onClick={handleRemoveFile}
                disabled={disabled}
              >
                <FaTrash size={12} className="me-1" />
                {t("Remove")}
              </button>
            </div>
          </div>
        </div>
      ) : (
        // No File Selected State
        <div className={`border-2 border-dashed rounded-3 p-4 text-center ${hasError ? 'border-danger' : 'border-primary'}`}>
          <div className="mb-3">
            <FaUpload 
              size={24} 
              className={hasError ? 'text-danger' : 'text-primary'} 
            />
          </div>
          <div className="mb-3">
            <div className={`fw-semibold ${hasError ? 'text-danger' : 'text-dark'}`}>
              {t("Choose a file to upload")}
            </div>
            <div className="text-muted small mt-1">
              {t("PDF, JPG, PNG files (Max: 10MB)")}
            </div>
          </div>
          <label
            htmlFor={name}
            className={`btn ${hasError ? 'btn-outline-danger' : 'btn-primary'} rounded-pill px-4`}
            style={{ cursor: disabled ? 'not-allowed' : 'pointer' }}
          >
            <FaUpload size={14} className="me-2" />
            {t("Browse Files")}
          </label>
        </div>
      )}

      <input
        ref={fileInputRef}
        type="file"
        id={name}
        onChange={handleFileChange}
        accept={accept}
        disabled={disabled}
        className="d-none"
        {...(register && register)}
      />

      {hasError && (
        <div className="text-danger small mt-2 d-flex align-items-center">
          <FaTimes size={12} className="me-1" />
          {errors[name]?.message}
        </div>
      )}
    </Form.Group>
  );
};

export default InputFile;
