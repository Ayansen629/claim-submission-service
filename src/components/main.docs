import React, { useState } from "react";
import { Modal, Button, Container, Row, Col, Table } from "react-bootstrap";
import { FaDownload, FaClipboardList, FaFilePdf, FaBuilding, FaUser, FaIdCard, FaMoneyBillWave, FaUniversity, FaSignature, FaFileAlt, FaUsers, FaCheckCircle, FaHome } from "react-icons/fa";
import { PDFDownloadLink, Document, Page, Text, View, StyleSheet } from '@react-pdf/renderer';
import PreviewCard from "../../private/stepperForm/common-design/PreviewCard";
import Collapsible from "../../private/stepperForm/common-design/Collapsible";
import "./ApplicationDetailsView.css";

// PDF Styles
const pdfStyles = StyleSheet.create({
  page: {
    padding: 30,
  },
  header: {
    fontSize: 24,
    marginBottom: 10,
    textAlign: 'center',
    fontWeight: 'bold',
  },
  subHeader: {
    fontSize: 16,
    marginBottom: 5,
    textAlign: 'center',
    fontWeight: '600',
  },
  subject: {
    fontSize: 14,
    marginTop: 5,
    marginBottom: 5,
    fontWeight: '600',
  },
  sectionHeader: {
    fontSize: 18,
    marginTop: 15,
    marginBottom: 10,
    fontWeight: 'bold',
    borderBottom: '1 solid #000',
  },
  text: {
    fontSize: 12,
    marginBottom: 5,
  },
  section: {
    marginTop: 10,
  },
  table: {
    display: "table",
    width: "100%",
    marginTop: 10,
  },
  tableRow: {
    flexDirection: "row",
  },
  tableCell: {
    flex: 1,
    padding: 5,
    fontSize: 10,
  },
  tableHeader: {
    fontWeight: "bold",
    backgroundColor: "#f0f0f0",
  },
  rowBetween: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
  }
});

const ClaimFormPdf = ({ applicationData }) => {
  // Extract data from the API response
  const creditorBasic = applicationData?.creditorBasicDetails || {};
  const claimDetails = applicationData?.claimDetails || {};
  const signatoryDetails = applicationData?.signatoryDetails || {};
  const supportingDocs = applicationData?.supportingDocument?.documents || [];
  
  const creditorName = creditorBasic.financialCreditorName || "N/A";
  const creditorEmail = creditorBasic.financialCreditorEmail || "N/A";
  const address = `${creditorBasic.addressDetails?.addressLine1 || ""}, ${creditorBasic.addressDetails?.addressLine2 || ""}, ${creditorBasic.addressDetails?.city || ""}, ${creditorBasic.addressDetails?.state || ""} - ${creditorBasic.addressDetails?.pincode || ""}`;
  const city = creditorBasic.addressDetails?.city || "N/A";
  const claimAmount = claimDetails.claimAmount ? `₹${claimDetails.claimAmount}` : "N/A";
  const securityAmount = claimDetails.securityValue ? `₹${claimDetails.securityValue}` : "N/A";
  const guaranteeAmount = claimDetails.guaranteeValue ? `₹${claimDetails.guaranteeValue}` : "N/A";
  
  // Handle different claim types
  let entityData = [];
  let entityLabel = "";
  
  if (claimDetails.claimType === "PRINCIPAL_BORROWER") {
    entityData = claimDetails.guarantorDetails || [];
    entityLabel = "Guarantor";
  } else if (claimDetails.claimType === "GUARANTOR") {
    entityData = claimDetails.principalBorrowerDetails || [];
    entityLabel = "Principal Borrower";
  } else if (claimDetails.claimType === "BENEFICIARY") {
    entityData = claimDetails.beneficiaryDetails || [];
    entityLabel = "Beneficiary";
  }
  
  const debtDetails = claimDetails.debtIncurredDetails || "N/A";
  const debtDate = claimDetails.debtIncurredDate || "N/A";
  
  const signatoryName = signatoryDetails.financialCreditorName || "N/A";
  const signatoryPosition = signatoryDetails.positionOfCreditor || "N/A";
  const signatoryAddress = signatoryDetails.addressOfSigningPerson || "N/A";

  return (
    <Document>
      <Page style={pdfStyles.page}>
        <View style={pdfStyles.section}>
          <Text style={pdfStyles.header}>FORM C</Text>
          <Text style={pdfStyles.subHeader}>SUBMISSION OF CLAIM BY FINANCIAL CREDITORS</Text>
          <Text style={pdfStyles.subject}>Subject: Submission of claim and proof of claim.</Text>
          <Text style={pdfStyles.text}>
            {creditorName}, hereby submits this claim in respect of the corporate{"\n"}
            insolvency resolution process. The details for the same{"\n"}
            are setout below:
          </Text>

          <View style={pdfStyles.table}>
            <View style={pdfStyles.tableRow}>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Name of the financial creditor</Text>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Email address</Text>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Address for correspondence</Text>
            </View>
            <View style={pdfStyles.tableRow}>
              <Text style={pdfStyles.tableCell}>{creditorName}</Text>
              <Text style={pdfStyles.tableCell}>{creditorEmail}</Text>
              <Text style={pdfStyles.tableCell}>{address}</Text>
            </View>
          </View>

          <View style={pdfStyles.table}>
            <View style={pdfStyles.tableRow}>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Amount of claim</Text>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Amount covered by security interest</Text>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Amount covered by guarantee</Text>
            </View>
            <View style={pdfStyles.tableRow}>
              <Text style={pdfStyles.tableCell}>{claimAmount}</Text>
              <Text style={pdfStyles.tableCell}>{securityAmount}</Text>
              <Text style={pdfStyles.tableCell}>{guaranteeAmount}</Text>
            </View>
          </View>

          {entityData.length > 0 && (
            <View style={pdfStyles.table}>
              <View style={pdfStyles.tableRow}>
                <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>{entityLabel} Name</Text>
                <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>{entityLabel} Address</Text>
              </View>
              {entityData.map((entity, index) => (
                <View key={index} style={pdfStyles.tableRow}>
                  <Text style={pdfStyles.tableCell}>{entity.name || "N/A"}</Text>
                  <Text style={pdfStyles.tableCell}>{entity.address || "N/A"}</Text>
                </View>
              ))}
            </View>
          )}

          <View style={pdfStyles.table}>
            <View style={pdfStyles.tableRow}>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Signatory Name</Text>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Position</Text>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Address</Text>
            </View>
            <View style={pdfStyles.tableRow}>
              <Text style={pdfStyles.tableCell}>{signatoryName}</Text>
              <Text style={pdfStyles.tableCell}>{signatoryPosition}</Text>
              <Text style={pdfStyles.tableCell}>{signatoryAddress}</Text>
            </View>
          </View>

          <View style={pdfStyles.section}>
            <Text style={pdfStyles.sectionHeader}>Supporting Documents</Text>
            {supportingDocs.map((doc, index) => (
              <View key={index} style={pdfStyles.tableRow}>
                <Text style={[pdfStyles.tableCell, { flex: 0.3 }]}>Document {index + 1}:</Text>
                <Text style={[pdfStyles.tableCell, { flex: 0.7 }]}>
                  {doc.docType} ({doc.docSource})
                </Text>
              </View>
            ))}
          </View>

          <Text style={pdfStyles.subHeader}>DECLARATION</Text>
          <Text style={pdfStyles.text}>
            I, {signatoryName}, currently residing at {signatoryAddress}, do hereby declare and state as follows: -
          </Text>
          <Text style={pdfStyles.text}>1. The corporate debtor was, at the insolvency commencement date, actually indebted to me for a sum of {claimAmount}.</Text>
          <Text style={pdfStyles.text}>2. In respect of my claim of the said sum or any part thereof, I have relied on the documents specified above.</Text>
          <Text style={pdfStyles.text}>3. The said documents are true, valid and genuine to the best of my knowledge, information and belief.</Text>
          <Text style={pdfStyles.text}>4. I undertake to update my claim as and when the claim is satisfied, partly or fully.</Text>

          <View style={[pdfStyles.rowBetween, { marginTop: 20 }]}>
            <Text style={pdfStyles.text}>Place: {city}</Text>
            <Text style={pdfStyles.text}>Signature of the claimant</Text>
          </View>
          
          <View style={[pdfStyles.rowBetween, { marginTop: 40 }]}>
            <Text style={pdfStyles.text}>Date: {new Date().toLocaleDateString()}</Text>
            <Text style={pdfStyles.text}>_________________________</Text>
          </View>
        </View>
      </Page>
    </Document>
  );
};

const ApplicationDetailsView = ({ show, onHide, modalData, fullModelData, handleDownload }) => {
  const [showDocumentModal, setShowDocumentModal] = useState(false);
  
  if (!fullModelData) return null;

  const formatDate = (dateString) => {
    if (!dateString) return 'N/A';
    const options = { 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    };
    return new Date(dateString).toLocaleDateString('en-US', options);
  };

  const getStatusBadgeClass = (status) => {
    switch (status?.toLowerCase()) {
      case 'submitted':
      case 'pending':
        return 'status-badge pending';
      case 'approved':
        return 'status-badge approved';
      case 'rejected':
      case 'sent back':
        return 'status-badge rejected';
      default:
        return 'status-badge';
    }
  };

  // Get entity labels based on claim type
  const getEntityLabels = (claimType) => {
    switch (claimType) {
      case "PRINCIPAL_BORROWER":
        return {
          nameLabel: "Name of the guarantor",
          addressLabel: "Address of the guarantor",
          sectionTitle: "Guarantor Details"
        };
      case "GUARANTOR":
        return {
          nameLabel: "Name of the Principal Borrower",
          addressLabel: "Address of the Principal Borrower",
          sectionTitle: "Principal Borrower Details"
        };
      case "BENEFICIARY":
        return {
          nameLabel: "Name of the Beneficiary",
          addressLabel: "Address of the Beneficiary",
          sectionTitle: "Beneficiary Details"
        };
      default:
        return {
          nameLabel: "Name",
          addressLabel: "Address",
          sectionTitle: "Entity Details"
        };
    }
  };

  const entityLabels = getEntityLabels(fullModelData?.claimDetails?.claimType);

  // Get entity data based on claim type
  const getEntityData = () => {
    if (!fullModelData?.claimDetails) return [];
    
    switch (fullModelData.claimDetails.claimType) {
      case "PRINCIPAL_BORROWER":
        return fullModelData.claimDetails.guarantorDetails || [];
      case "GUARANTOR":
        return fullModelData.claimDetails.principalBorrowerDetails || [];
      case "BENEFICIARY":
        return fullModelData.claimDetails.beneficiaryDetails || [];
      default:
        return [];
    }
  };

  const entityData = getEntityData();

  return (
    <Modal
      show={show}
      onHide={onHide}
      dialogClassName="modal-1110w application-details-modal"
      aria-labelledby="application-details-title"
      centered
    >
      <Modal.Header closeButton className="modal-header">
        <Modal.Title id="application-details-title" className="modal-title">
          <FaFileAlt className="modal-title-icon" />
          Application Details
        </Modal.Title>
      </Modal.Header>
      
      <Modal.Body className="modal-body">
        <div className="application-header-container">
          <div className="application-number-container">
            <h4 className="application-number-label">Application Number:</h4>
            <div className="application-number-value">
              {fullModelData.applicationNumber || "N/A"}
            </div>
          </div>
          
          <div className="application-status-container">
            <span className={`status-badge ${getStatusBadgeClass(fullModelData.status)}`}>
              {fullModelData.status || "N/A"}
            </span>
          </div>
        </div>

        <div className="success-actions">
          <PDFDownloadLink
            document={<ClaimFormPdf applicationData={fullModelData} />}
            fileName={`claim_form_${fullModelData.applicationNumber || 'application'}.pdf`}
          >
            {({ blob, url, loading, error }) => (
              <Button
                variant="primary"
                className="action-button download-button"
                disabled={loading}
              >
                <FaDownload className="button-icon" />
                {loading ? 'Generating PDF...' : 'Download Application'}
              </Button>
            )}
          </PDFDownloadLink>

          <Button
            variant="light"
            className="action-button"
            onClick={onHide}
          >
            <FaHome className="button-icon" />
            Return to Dashboard
          </Button>
        </div>

        {/* Creditor & Identification Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaUser className="me-2" />
              <span>Creditor & Identification Details</span>
            </div>
          } 
          defaultOpen={true}
        >
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaUser className="details-card-title-icon" />
                Creditor Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Debtor Name" value={fullModelData.creditorBasicDetails?.financialDebtorName || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Creditor Name" value={fullModelData.creditorBasicDetails?.financialCreditorName || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Creditor Email" value={fullModelData.creditorBasicDetails?.financialCreditorEmail || "N/A"} />
                  </Col>
                </Row>
              </Container>
            </div>
          </div>
          
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaBuilding className="details-card-title-icon" />
                Address Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Address Line 1" value={fullModelData.creditorBasicDetails?.addressDetails?.addressLine1 || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Address Line 2" value={fullModelData.creditorBasicDetails?.addressDetails?.addressLine2 || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="City" value={fullModelData.creditorBasicDetails?.addressDetails?.city || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="State" value={fullModelData.creditorBasicDetails?.addressDetails?.state || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Pincode" value={fullModelData.creditorBasicDetails?.addressDetails?.pincode || "N/A"} />
                  </Col>
                </Row>
              </Container>
            </div>
          </div>
          
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaIdCard className="details-card-title-icon" />
                Identification Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                {fullModelData?.creditorBasicDetails?.identificationTypeDetails?.identificationType && (
                  <div className="mb-3">
                    <PreviewCard 
                      title="Identification Type" 
                      value={fullModelData.creditorBasicDetails.identificationTypeDetails.identificationType === "INCORPORATED" 
                        ? "Incorporated Body" 
                        : "Partnership or Individual"} 
                    />
                  </div>
                )}
                
                {fullModelData?.creditorBasicDetails
