/* Document Upload Styling */
.document-upload-container {
  margin-bottom: 1.5rem;
}

.file-input-wrapper {
  position: relative;
  overflow: hidden;
  display: inline-block;
  width: 100%;
}

.file-input {
  position: absolute;
  font-size: 100px;
  opacity: 0;
  right: 0;
  top: 0;
}

.file-input-label {
  display: flex;
  width: 100%;
  border: 1px solid #ced4da;
  border-radius: 0.375rem;
  background-color: #fff;
  overflow: hidden;
}

.file-input-text {
  padding: 0.375rem 0.75rem;
  flex-grow: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #495057;
}

.file-input-button {
  padding: 0.375rem 0.75rem;
  background-color: #f8f9fa;
  border-left: 1px solid #ced4da;
  color: #495057;
  cursor: pointer;
}

.file-input-label:hover {
  border-color: #86b7fe;
}

.file-input-label:focus-within {
  border-color: #86b7fe;
  box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
}

.is-invalid + .file-input-label {
  border-color: #dc3545;
}

.download-link {
  display: flex;
  align-items: center;
}

.download-link svg {
  margin-right: 5px;
}
