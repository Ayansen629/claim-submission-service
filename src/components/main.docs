.formContent {
  padding: 25px;
}

.formRow {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
  margin-bottom: 25px;
}

.warningText {
  color: #dc2626;
  font-size: 14px;
  margin-bottom: 20px;
  font-weight: 500;
}

.uploadSection {
  margin-top: 20px;
}

.uploadLabel {
  color: #333;
  font-weight: 500;
  font-size: 14px;
  margin-bottom: 10px;
  display: block;
}

.uploadBox {
  border: 2px dashed #ddd;
  border-radius: 8px;
  padding: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fafafa;
  transition: border-color 0.3s ease;
}

.uploadBoxError {
  border-color: #dc2626;
  background: #fef2f2;
}

.fileName {
  color: #666;
  font-size: 14px;
  flex: 1;
}

.uploadButtons {
  display: flex;
  gap: 10px;
}

.viewButton {
  background: #00A3E0 !important;
  color: white !important;
  text-transform: none !important;
  font-size: 12px !important;
  padding: 6px 12px !important;
  min-width: auto !important;
}

.uploadButton {
  background: #00A3E0 !important;
  color: white !important;
  text-transform: none !important;
  font-size: 12px !important;
  padding: 6px 12px !important;
  min-width: auto !important;
}

.fileError {
  color: #dc2626;
  font-size: 12px;
  margin-top: 5px;
  font-weight: 500;
}

@media (max-width: 768px) {
  .formRow {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  
  .formContent {
    padding: 20px 15px;
  }
  
  .uploadBox {
    flex-direction: column;
    gap: 15px;
    align-items: stretch;
  }
  
  .uploadButtons {
    justify-content: center;
  }
}
