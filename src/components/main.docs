const toggleSubMenu = (menuName) => {
  setExpandedMenus((prev) => {
    // Close all other menus and only toggle the clicked one
    const newExpanded = {};
    newExpanded[menuName] = !prev[menuName];
    
    // Only animate when opening
    if (!prev[menuName]) {
      setAnimatingMenus((prevAnim) => ({
        [menuName]: true, // Only animate the opening menu
      }));
      
      // Remove animation class after animation completes
      setTimeout(() => {
        setAnimatingMenus({});
      }, 1000);
    } else {
      setAnimatingMenus({});
    }
    
    return newExpanded;
  });
};
