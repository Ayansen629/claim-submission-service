import React, { useState, useRef, useCallback } from "react";
import { Button } from "react-bootstrap";
import { Box, Typography, Stack } from "@mui/material";
import { BsArrowLeft } from "react-icons/bs";
import { useNavigate, useLocation } from "react-router-dom";
import Stepper from "../../../common/Stepper";
import NameChange from "./NameChange";
import Invoicing from "../../../common/Invoicing";

const ApplicationDetailsUpdate = () => {
  const navigate = useNavigate();
  const location = useLocation();
  const stepperRef = useRef();
  const nameChangeRef = useRef();
  const selectedOption = location.state?.selectedOption || "";
  
  const [isValid, setIsValid] = useState(false);
  const [formData, setFormData] = useState({});
  const [savedFormData, setSavedFormData] = useState({}); // Store saved data

  const mockPaymentData = {
    summary: {
      subTotal: 1000,
      cgst: 90,
      sgst: 90,
      igst: 0,
      totalPayable: 1180
    },
    invoiceBreakupInfo: [
      {
        id: 1,
        categoryHeader: "Registration Charges",
        label: "Application processing fee",
        amount: 500
      },
      {
        id: 2,
        categoryHeader: "Documentation Charges",
        label: "Certificate issuance fee",
        amount: 300
      },
      {
        id: 3,
        categoryHeader: "Processing Fees",
        label: "Administrative charges",
        amount: 200
      }
    ]
  };

  const handleValidationChange = useCallback((valid) => {
    setIsValid(valid);
  }, []);

  const handleDataChange = useCallback((data) => {
    setFormData(data);
  }, []);

  const validateStep = async () => {
    if (nameChangeRef.current?.validateForm) {
      return await nameChangeRef.current.validateForm();
    }
    return isValid;
  };

  const getFormData = () => {
    return formData;
  };

  const handleSaveAndNext = (stepInfo) => {
    console.log("Saving step data:", stepInfo);
    // Save form data when moving to next step
    setSavedFormData(formData);
  };

  const handlePayNow = () => {
    console.log("Proceeding to payment...");
  };

  const steps = [
    {
      label: "Registration Information",
      component: (
        <NameChange 
          ref={nameChangeRef}
          selectedOption={selectedOption}
          onValidationChange={handleValidationChange}
          onDataChange={handleDataChange}
          initialData={savedFormData} // Pass saved data back
        />
      ),
      validate: validateStep,
      getFormData: getFormData,
      showSavaAndNextButton: true,
      hasActions: true
    },
    {
      label: "Invoicing",
      component: (
        <Invoicing
          supervisionAuthority="iwt"
          onPayNow={handlePayNow}
          paymentData={mockPaymentData}
        />
      ),
      validate: () => true,
      getFormData: () => ({}),
      showPayBtn: true
    }
  ];

  return (
    <Box sx={{ p: 2, backgroundColor: "#f8f9fa", minHeight: "100vh" }}>
      <Box
        sx={{
          display: "flex",
          alignItems: "center",
          mb: 3,
          padding: "16px 20px",
          background: "#ffffff",
          borderRadius: "12px",
          boxShadow: "0 2px 12px rgba(0, 0, 0, 0.08)",
          border: "1px solid #e9ecef",
        }}
      >
        <Button
          variant="outline-primary"
          onClick={() => navigate(-1)}
          style={{
            borderRadius: "10px",
            width: 40,
            height: 40,
            border: "2px solid #2E57A7",
            color: "#2E57A7",
            backgroundColor: "#fff",
            transition: "all 0.3s ease",
            padding: 0,
            marginRight: 16,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
          }}
          onMouseEnter={(e) => {
            e.target.style.backgroundColor = "#2E57A7";
            e.target.style.color = "#fff";
            e.target.style.transform = "translateY(-2px)";
            e.target.style.boxShadow = "0 4px 12px rgba(46, 87, 167, 0.3)";
          }}
          onMouseLeave={(e) => {
            e.target.style.backgroundColor = "#fff";
            e.target.style.color = "#2E57A7";
            e.target.style.transform = "translateY(0)";
            e.target.style.boxShadow = "none";
          }}
        >
          <BsArrowLeft size={16} />
        </Button>
        
        <Stack direction="row" spacing={2} alignItems="center">
          <Typography
            sx={{
              fontWeight: 600,
              color: "#2E57A7",
              fontSize: "1.3rem",
              lineHeight: 1.3,
            }}
          >
            Application Details Update
          </Typography>

          <Box
            sx={{
              background: "linear-gradient(135deg, #e3f2fd, #f3e5f5)",
              borderRadius: "8px",
              padding: "6px 12px",
              border: "1px solid #bbdefb",
            }}
          >
            <Typography
              sx={{ color: "#1976d2", fontSize: "0.9rem", fontWeight: 600 }}
            >
              WB-IWT/REG/2025/302748
            </Typography>
          </Box>
        </Stack>
      </Box>
      
      <Stepper
        ref={stepperRef}
        steps={steps}
        onSyncData={handleSaveAndNext}
        onPayNow={handlePayNow}
        viewMode={true}
        editMode={false}
        initialStep={0}
      />
    </Box>
  );
};

export default ApplicationDetailsUpdate;
