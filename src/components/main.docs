                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Make & Model")}
                name="polutionControl.othersMakeModel"
                placeholder={!viewMode ? t("Enter make & model") : ""}
                register={register("polutionControl.othersMakeModel")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
          </Row>
        </Collapsible>


        {/* Crew Details */}
        <Collapsible
          title={
            <>
              <FaUsers className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Crew Details")}</span>
            </>
          }
          openStat={true}
        >
          <div style={{ padding: "1rem" }}>
            {/* Total Crew Fields - Single Row */}
            <Row className="gy-3 mb-4 p-3 border rounded" style={{ backgroundColor: "#f8f9fa" }}>
              <Col md={6}>
                <InputText
                  label={t("Total No. of Deck Crew")}
                  name="crewDetails.totalDeckCrew"
                  type="number"

                  placeholder={!viewMode ? t("Enter total no. of deck crew") : ""}
                  register={register("crewDetails.totalDeckCrew")}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={6}>
                <InputText
                  label={t("Total No. of Engine Crew")}
                  name="crewDetails.totalEngineCrew"
                  type="number"
                  placeholder={!viewMode ? t("Enter total no. of engine crew") : ""}

                  register={register("crewDetails.totalEngineCrew")}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
            </Row>

            {/* Individual Crew Members */}
            {fields.map((field, index) => (
              <Row key={field.id} className="gy-3 mb-3 border-bottom pb-3">
                <Col md={3}>
                  <InputSelect
                    label={t("Crew Type")}
                    required={true}
                    name={`crewDetails.crewDetails.${index}.crewType`}
                    options={[
                      { value: "", label: "-- Select --" },
                      ...(masterData?.crewTypes?.map((type) => ({
                        value: type.valueCode,
                        label: type.valueLabel,
                      })) || []),
                    ]}
                    register={register(`crewDetails.crewDetails.${index}.crewType`, {
                      required: t("Crew Type is required"),
                    })}
                    errors={errors}
                    value={watch(`crewDetails.crewDetails.${index}.crewType`) || ""}
                    onChange={(value) =>
                      !viewMode &&
                      handleSelectChange(`crewDetails.crewDetails.${index}.crewType`, value)
                    }
                    disabled={viewMode}
                  />
                </Col>
                <Col md={3}>
                  <InputText
                    label={t("Name")}
                    required={true}
                    name={`crewDetails.crewDetails.${index}.name`}
                    placeholder={!viewMode ? t("Enter Name") : ""}

                    register={register(`crewDetails.crewDetails.${index}.name`, {
                      required: t("Name is required"),
                    })}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Rank")}
                    name={`crewDetails.crewDetails.${index}.rank`}
                    placeholder={!viewMode ? t("Enter Rank") : ""}

                    register={register(`crewDetails.crewDetails.${index}.rank`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("COC No.")}
                    name={`crewDetails.crewDetails.${index}.cocNo`}
                    placeholder={!viewMode ? t("Enter COC No.") : ""}

                    register={register(`crewDetails.crewDetails.${index}.cocNo`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Validity")}
                    name={`crewDetails.crewDetails.${index}.validity`}
                    placeholder={!viewMode ? t("Enter Validity") : ""}

                    register={register(`crewDetails.crewDetails.${index}.validity`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={6}>
                  <InputText
                    label={t("Place of Issue")}
                    name={`crewDetails.crewDetails.${index}.placeOfIssue`}
                    placeholder={!viewMode ? t("Enter Place of Issue") : ""}

                    register={register(`crewDetails.crewDetails.${index}.placeOfIssue`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                {!viewMode && index > 0 && (
                  <Col md={6} className="text-end">
                    <Button
                      variant="danger"
                      size="sm"
                      onClick={() => remove(index)}
                      className="mt-1"
                    >
                      <FaTrash /> Remove
                    </Button>
                  </Col>
                )}
              </Row>
            ))}
            {!viewMode && (
              <Button
                variant="outline-primary"
                onClick={() =>
                  append({
                    crewType: "",
                    name: "",
                    rank: "",
                    cocNo: "",
                    validity: "",
                    placeOfIssue: "",
                  })
                }
                className="mt-2"
              >
                <FaPlus className="me-2" /> Add Crew Member
              </Button>
            )}
          </div>
        </Collapsible>

        {/* Enclosure */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>{t("ENCLOSURE")}</span>
            </div>
          }
          defaultOpen={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "authorizationFile",
                    t("Authorization of Authorised Person")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "paymentChallan",
                    t("Payment Challan/Acknowledgement")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "builderCertificate",
                    t("Builder Certificate")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "lastCertificateCopy",
                    t("Copy of last Certificate of Survey")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "registrationCertificateCopy",
                    t("Copy of Certificate of Registration")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("testCertificate", t("Test Certificate"))}
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>
        {/* Provisional Certificates */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>
                {t("Provisional Certificates")}
              </span>
            </div>
          }
          defaultOpen={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col xs={12} md={6}>
                  <div className="form-check">
                    <input
                      className="form-check-input"
                      type="checkbox"
                      id="provisionalSurveyCertificate"
                      {...register("provisionalCertificates.surveyCertificate")}
                      disabled={viewMode}
                    />
                    <label
                      className="form-check-label"
                      htmlFor="provisionalSurveyCertificate"
                    >
                      {t("Provisional Survey Certificate")}
                    </label>
                  </div>
                </Col>
                <Col xs={12} md={6}>
                  <div className="form-check">
                    <input
                      className="form-check-input"
                      type="checkbox"
                      id="provisionalRegistrationCertificate"
                      {...register(
                        "provisionalCertificates.registrationCertificate"
                      )}
                      disabled={viewMode}
                    />
                    <label
                      className="form-check-label"
                      htmlFor="provisionalRegistrationCertificate"
                    >
                      {t("Provisional Registration Certificate")}
                    </label>
                  </div>
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>
      </form>
    </>
  );
};

export default RenewalSurveyForm;
Type of Survey field populate v alue from masterdata response -->
surveyTypes have renewal survey 
please populate renewal survey in the dropdown and disable that 
