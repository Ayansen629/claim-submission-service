  console.log("certificates--reg", registrationData)
  const getSurveyDetails = async (vesselId) => {
    try {
      loaderRef.current?.show();
      const apiUrl =
        SERVICE_BASE.IWT_SURVEY_SERVICE +
        URLS_ENDPOINT.SURVEY_SERVICE.SURVEY_SEARCH;

      const response = await postData(apiUrl, {
        iwtVesRegBasicDetailsTFk: [vesselId],
      });

      if (response?.status === 200 || response?.status === 201) {
        const surveyData = response?.data[0] || {};

        setInitialRegistryData(surveyData);
        setGeneratedCertificates({
          survey: surveyData?.BasicVesselInformation?.enableprovisonalsurveycert || false,
          registration: surveyData?.BasicVesselInformation?.enableprovisonalregistrationcert || false,
        });

        if (isOfficerLogin) {
          const hasActions =
            surveyData?.processActionMapResponce?.[0]?.processs?.[0]?.actions?.length > 0;
          setShowOfficerActions(hasActions);

          if (hasActions) {
            setActionsFromAPI(surveyData.processActionMapResponce[0].processs[0].actions);
          }
        }
        populateFormWithSurveyData(surveyData);
      } else {
        toast.error(
          response?.data?.responseStatus?.message || "Failed to fetch survey details."
        );
      }
    } catch (err) {
      handleErrorMessage(
        err?.response?.data || "Failed to fetch survey details. Check console for details."
      );
    } finally {
      loaderRef?.current?.hide();
    }
  };

  const populateFormWithSurveyData = (data) => {
    if (!data) return;

    const safe = (val, fallback = "") => val ?? fallback;

    const mappings = {
      basicVesselInfo: {
        typeOfSurvey: "BasicVesselInformation.typeOfSurveyId",
        placeYardNo: "BasicVesselInformation.placeYardNo",
        netTonnage: "BasicVesselInformation.netTonnage",
        agentName: "BasicVesselInformation.agentsName",
        agentAddress: "BasicVesselInformation.agentsAddress",
        agentTelephone: "BasicVesselInformation.agentsTelephone",
        placeOfLastSurvey: "BasicVesselInformation.placeOfLastSurvey",
        dateOfLastSurvey: "BasicVesselInformation.dateOfLastSurvey",
        dateOfProposedVisit: "BasicVesselInformation.dateOfProposedVisitSurveyor",
        lengthOfVessel: "BasicVesselInformation.lengthOfVessel",
        breadthOfVessel: "BasicVesselInformation.breadthOfVessel",
        depthOfVessel: "BasicVesselInformation.depthOfVessel",
        draft: "BasicVesselInformation.draft",
        yearOfBuild: "BasicVesselInformation.yearOfBuild",
        numberOfDecks: "BasicVesselInformation.numberOfDecks",
      },
      hullParticulars: {
        frameMaterial: "HullParticulars.frameMaterial",
        frameThickness: "HullParticulars.frameThickness",
        floorMaterial: "HullParticulars.floorMaterial",
        hullMaterial: "HullParticulars.hullMaterial",
        hullPlatingMaterial: "HullParticulars.hullPlatingMaterial",
        hullPlattingThickness: "HullParticulars.hullPlatingThickness",
        keelLayingDate: "HullParticulars.keelLayingDate",
        numberOfBulkheads: "HullParticulars.noOfBulkheads",
        bulkheadPlacement: "HullParticulars.bulkheadPlacement",
        bulkheadThickness: "HullParticulars.bulkheadThickness",
        floorThickness: "HullParticulars.floorThickness",
        stern: "HullParticulars.stern",

      },
      navigationEquipment: {
        magneticCompass: "RadioandNavigationEquipment.magneticCompass",
        vhfRadio: "RadioandNavigationEquipment.vhfRadio",
        classBAutoAIS: "RadioandNavigationEquipment.aisIdentifiSystem",
        gpsNavigator: "RadioandNavigationEquipment.gps",
        binocular: "RadioandNavigationEquipment.binocular",
        aldisLamp: "RadioandNavigationEquipment.aldisLamp",
        rudderAngleIndicator:
          "RadioandNavigationEquipment.rudderAngleIndicator",
        othersNavigation: "RadioandNavigationEquipment.others",
      },
      polutionControl: {
        bilgeWaterSeparator: "PollutionControlDevices.bilgeWaterSeperator",
        bilgeCapacity: "PollutionControlDevices.capacity",
        bilgeMakeModel: "PollutionControlDevices.makeModel",
        sewageTreatmentPlant: "PollutionControlDevices.stp",
        sewageCapacity: "PollutionControlDevices.stpCapacity",
        sewageMakeModel: "PollutionControlDevices.stpMakeModel",
        oilyWaterFilter: "PollutionControlDevices.owf",
        oilyCapacity: "PollutionControlDevices.owfCapacity",
        oilyMakeModel: "PollutionControlDevices.owfMakeModel",
        exhaustGasCleaning: "PollutionControlDevices.egasCleaningSystm",
        exhaustCapacity: "PollutionControlDevices.egasCleaningSystmCapacity",
        exhaustMakeModel: "PollutionControlDevices.egasCleaningSystmMakeModel",
        othersPollution: "PollutionControlDevices.other",
        othersCapacity: "PollutionControlDevices.otherCapacity",
        othersMakeModel: "PollutionControlDevices.otherMakeModel",
      },

      detailsOfPropulsion: {
        typeOfEngine: "DetailsofPropulsionofEngine.engineType",
        engineMake: "DetailsofPropulsionofEngine.engineMake",
        engineMakerAddress: "DetailsofPropulsionofEngine.makerAddress",
        horsepower: "DetailsofPropulsionofEngine.horsepower",
        speedRPM: "DetailsofPropulsionofEngine.speed",
        yearOfMake: "DetailsofPropulsionofEngine.yearOfMake",
        modelNo: "DetailsofPropulsionofEngine.modelNo",
        numberOfSetFitted: "DetailsofPropulsionofEngine.noOfSet",
        numberOfEngine: "DetailsofPropulsionofEngine.numberOfEngine",
        setSrNo: "DetailsofPropulsionofEngine.setSerialNo",
        propellerType: "DetailsofPropulsionofEngine.propellerType",
        gearType: "DetailsofPropulsionofEngine.gearType",
        noOfGear: "DetailsofPropulsionofEngine.noOfGear",
        vesselSpeed: "DetailsofPropulsionofEngine.vesselSpeed",
        revolutionMints: "DetailsofPropulsionofEngine.rpm",
        engineCylinderDiameter: "DetailsofPropulsionofEngine.engineCylinder",
        strokeEngine: "DetailsofPropulsionofEngine.stroke",
        cylindersRotary:
          "DetailsofPropulsionofEngine.noOfCylinderPerSetRotaryEngine",
        cylindersReciprocating:
          "DetailsofPropulsionofEngine.noOfCylinderPerSetReciprocatingEngine",
        numberOfShaft: "DetailsofPropulsionofEngine.noOfShaft",
        lengthEngineRoom: "DetailsofPropulsionofEngine.lengthOfEngineRoom",
      },
    };

    Object.entries(mappings).forEach(([formKey, map]) => {
      Object.entries(map)?.forEach(([field, path]) => {
        const value = path?.split(".")?.reduce((acc, k) => acc?.[k], data);
        setValue(`${formKey}.${field}`, safe(value));
      });
    });

    // --- Crew Details ---
    const crewDetails = Array.isArray(data?.CrewDetails)
      ? data.CrewDetails
      : [];
    setValue(
      "crewDetails.crewDetails",
      crewDetails.map((crew) => ({
        crewType: safe(crew?.crewType),
        name: safe(crew?.name),
        rank: safe(crew?.rank),
        cocNo: safe(crew?.cocNo),
        validity: safe(crew?.validity),
        experience: safe(crew?.experience),
        status: crew?.status || "ACTIVE",
      }))
    );

    if (data?.BasicVesselInformation) {
      setValue(
        "crewDetails.totalDeckCrew",
        data?.BasicVesselInformation?.totalNoOfDeckCrew || ""
      );
      setValue(
        "crewDetails.totalEngineCrew",
        data?.BasicVesselInformation?.totalNoOfEngineCrew || ""
      );
    }

    // --- Enclosures ---
    const enclosureMap = {};
    (Array.isArray(data?.Enclosure) ? data.Enclosure : []).forEach((doc) => {
      const typeMap = {
        SURVEY_AUTHORIZATION_OF_AUTHORISED_PERSON: "authorizationFile",
        SURVEY_PAYMENT_CHALLAN: "paymentChallan",
        SURVEY_BUILDER_CERTIFICATE: "builderCertificate",
        SURVEY_COPY_OF_LAST_CERTIFICATE_OF_SURVEY: "lastCertificateCopy",
        SURVEY_COPY_OF_CERTIFICATE_OF_REGISTRATION:
          "registrationCertificateCopy",
        SURVEY_TEST_CERTIFICATE: "testCertificate",
      };
      const key = typeMap[doc.documentType];
      if (key) {
        enclosureMap[key] = {
          name: doc.documentName,
          fileStoreId: doc.fileStoreId,
        };
      }
    });

    Object.entries(enclosureMap).forEach(([key, value]) => {
      setValue(`enclosure.${key}`, value);
      setValue(`enclosure.${key}FileStoreId`, value.fileStoreId);
      setValue(`enclosure.${key}OriginalName`, value.name);
    });

    // --- Equipment Inventory from SurveyEquipments ---
    if (data?.SurveyEquipments) {
      const equipmentData = {};

      Object.keys(data.SurveyEquipments).forEach((equipmentKey) => {
        const equipmentArray = data.SurveyEquipments[equipmentKey];
        if (Array.isArray(equipmentArray)) {
          equipmentArray.forEach((item) => {
            const equipmentId = getEquipmentIdFromKey(equipmentKey);
            if (equipmentId) {
              if (!equipmentData[equipmentId]) {
                equipmentData[equipmentId] = {};
              }
              equipmentData[equipmentId][item.categoryCode] = {
                number: item.number?.toString() || "",
                type: item.type || "",
                location: item.location || "",
                capacity: item.capacity || "",
                condition: item.condition || "",
                remarks: item.remarks || "",
              };
            }
          });
        }
      });

      setValue("equipment", equipmentData);
    }

    if (
      data?.passengerDistributionMaxLoad &&
      Array.isArray(data.passengerDistributionMaxLoad)
    ) {
      setValue(
        "deckSpaces",
        data.passengerDistributionMaxLoad.map((deck) => ({
          deckType: deck.deckName || deck.spaceType || "",
          size: deck.sizeSqm?.toString() || "",
          function: deck.function || "",
          maxPassengers: deck.maxPassengers?.toString() || "",
          remarks: deck.remarks || "",
        }))
      );
    }

    if (data?.vesselFreeboardData) {
      setValue("freeboard", {
        minFreeboard:
          data.vesselFreeboardData.minimumFreeboard?.toString() || "",
        numPassengers:
          data.vesselFreeboardData.numberOfPassengers?.toString() || "",
        cargo: data.vesselFreeboardData.cargoTonnes?.toString() || "",
      });
    }

    // --- Provisional Certificates ---

    if (data?.BasicVesselInformation) {
      setValue(
        "provisionalCertificates.surveyCertificate",
        data.BasicVesselInformation.enableprovisonalsurveycert || false
      );
      setValue(
        "provisionalCertificates.registrationCertificate",
        data.BasicVesselInformation.enableprovisonalregistrationcert || false
      );
    }
  };

  const getEquipmentIdFromKey = (equipmentKey) => {
    const equipmentKeyMap = {
      "Fire Fighting Items": "EquipmentFireFightingItems",
      Equipments: "Equipments",
      "Navigational Equipments": "EquipmentNavigationalEquipments",
      "Life-Saving Equipment": "EquipmentLifeSavingEquipment",
      "Machinery/Electrical": "EquipmentMachineryElectrical",
      "Accommodation/Safety": "EquipmentAccommodationSafety",
    };

    const equipmentName = Object.keys(equipmentKeyMap).find(
      (name) => equipmentKeyMap[name] === equipmentKey
    );

    if (equipmentName) {
      const equipment = masterData?.equipmentCategories?.find(
        (eq) => eq.equipmentName === equipmentName
      );
      return equipment?.id;
    }

    return null;
  };

  const validateSurveyForm = async () => {
    return true;
    // console.log("validateSurveyForm Data -> ", methods?.getValues());
    // if (isViewMode) return true;

    // const requiredFields = [
    //   "basicVesselInfo.typeOfSurvey",
    //   "basicVesselInfo.placeYardNo",
    //   "basicVesselInfo.netTonnage",
    // ];

    // const isValid = await trigger(requiredFields);

    // // Check crew details
    // const crewDetails = getValues("crewDetails.crewDetails") || [];
    // let hasValidCrew = true;
    // crewDetails.forEach((crew, index) => {
    //   if (!crew.crewType) {
    //     setError(`crewDetails.crewDetails.${index}.crewType`, {
    //       type: "required",
    //       message: t("Crew Type is required"),
    //     });
    //     hasValidCrew = false;
    //   }
    //   if (!crew.name) {
    //     setError(`crewDetails.crewDetails.${index}.name`, {
    //       type: "required",
    //       message: t("Crew Name is required"),
    //     });
    //     hasValidCrew = false;
    //   }
    // });
    // // Check file uploads
    // const requiredFiles = [
    //   "enclosure.authorizationFile",
    //   "enclosure.paymentChallan",
    //   "enclosure.lastCertificateCopy",
    //   "enclosure.registrationCertificateCopy",
    //   "enclosure.builderCertificate",
    //   "enclosure.testCertificate",
    // ];
    // let hasFileErrors = false;

    // if (!isEditMode) {
    //   requiredFiles.forEach((fieldName) => {
    //     const fieldValue = getValues(fieldName);
    //     if (!fieldValue) {
    //       setError(fieldName, {
    //         type: "required",
    //         message: t(`${fieldName} is required`),
    //       });
    //       hasFileErrors = true;
    //     }
    //   });

    //   await trigger(requiredFiles);
    // }

    // return isValid && hasValidCrew && !hasFileErrors;
  };

  const validateEquipmentForm = async () => {
    if (isViewMode) return true;
    return true;
  };


  const validateBookForm = async () => {
    console.log("validateBookForm -> ", methods?.getValues());
    const requiredFields = [
      "bookOfRegistration.engine.engineNo",
    ];

    const isValid = await trigger(requiredFields);
    return isValid;
  };

  const validateCertificateForm = async () => {
    console.log("validateCertificateForm -> ", methods?.getValues());
    const requiredFields = [
      "certificateOfRegistration.basicInfo.indianOrForeignBuilt",
    ];

    const isValid = await trigger(requiredFields);
    return isValid;
  };

  const buildSurveyPayload = (formData, registrationData) => {
    const payload = {
      surveyId: initialRegistryData?.surveyId || "",
      BasicVesselInformation: {
        id: initialRegistryData?.BasicVesselInformation?.id || "",
        typeOfSurveyId: formData?.basicVesselInfo?.typeOfSurvey || "",
        placeYardNo: formData?.basicVesselInfo?.placeYardNo || "",
        netTonnage: parseFloat(formData?.basicVesselInfo?.netTonnage) || null,
        agentsName: formData?.basicVesselInfo?.agentName || "",
        agentsAddress: formData?.basicVesselInfo?.agentAddress || "",
        agentsTelephone: formData?.basicVesselInfo?.agentTelephone || "",
        placeOfLastSurvey: formData?.basicVesselInfo?.placeOfLastSurvey || "",
        dateOfLastSurvey: formData?.basicVesselInfo?.dateOfLastSurvey || "",
        dateOfProposedVisitSurveyor:
          formData?.basicVesselInfo?.dateOfProposedVisit || "",
        iwtVesRegBasicDetailsTFk:
          registrationData?.vessel?.iwtVesselBasicDetailsTFk || "",
        status: "ACTIVE",
        lengthOfVessel: formData?.basicVesselInfo?.lengthOfVessel || "",
        breadthOfVessel: formData?.basicVesselInfo?.breadthOfVessel || "",
        depthOfVessel: formData?.basicVesselInfo?.depthOfVessel || "",
        draft: formData?.basicVesselInfo?.draft || "",
        numberOfDecks: parseInt(formData?.basicVesselInfo?.numberOfDecks) || null,
        enableprovisonalsurveycert:
          formData?.provisionalCertificates?.surveyCertificate || false,
        enableprovisonalregistrationcert:
          formData?.provisionalCertificates?.registrationCertificate || false,
        totalNoOfDeckCrew: parseInt(formData?.crewDetails?.totalDeckCrew) || "",
        totalNoOfEngineCrew:
          parseInt(formData?.crewDetails?.totalEngineCrew) || "",
      },

      HullParticulars: {
        id: initialRegistryData?.HullParticulars?.id || "",
        frameMaterial: formData?.hullParticulars?.frameMaterial || "",
        frameThickness:
          parseFloat(formData?.hullParticulars?.frameThickness) || "",
        floorMaterial: formData?.hullParticulars?.floorMaterial || "",
        hullMaterial: formData?.hullParticulars?.hullMaterial || "",
        hullPlatingThickness:
          parseFloat(formData?.hullParticulars?.hullPlattingThickness) || "",
        keelLayingDate: formData?.hullParticulars?.keelLayingDate || "",
        iwtVesBasicSurveyDetTFk:
          initialRegistryData?.HullParticulars?.iwtVesBasicSurveyDetTFk || "",
        status: "ACTIVE",
        hullPlatingMaterial:
          formData?.hullParticulars?.hullPlatingMaterial || "",
        noOfBulkheads:
          parseInt(formData?.hullParticulars?.numberOfBulkheads) || "",
        bulkheadPlacement: formData?.hullParticulars?.bulkheadPlacement || "",
        bulkheadThickness:
          parseFloat(formData?.hullParticulars?.bulkheadThickness) || "",
        floorThickness:
          parseFloat(formData?.hullParticulars?.floorThickness) || "",
        stern: formData?.hullParticulars?.stern || "",
      },

      RadioandNavigationEquipment: {
        id: initialRegistryData?.RadioandNavigationEquipment?.id || "",
        magneticCompass:
          parseInt(formData?.navigationEquipment?.magneticCompass) || null,
        vhfRadio: parseInt(formData?.navigationEquipment?.vhfRadio) || null,
        aisIdentifiSystem:
          parseInt(formData?.navigationEquipment?.classBAutoAIS) || null,
        gps: parseInt(formData?.navigationEquipment?.gpsNavigator) || null,
        binocular: parseInt(formData?.navigationEquipment?.binocular) || null,
        aldisLamp: parseInt(formData?.navigationEquipment?.aldisLamp) || null,
        rudderAngleIndicator:
          parseInt(formData?.navigationEquipment?.rudderAngleIndicator) || null,
        others:
          parseInt(formData?.navigationEquipment?.othersNavigation) || null,
        iwtVesBasicSurveyDetTFk:
          initialRegistryData?.RadioandNavigationEquipment
            ?.iwtVesBasicSurveyDetTFk || "",
        status: "ACTIVE",
      },

      PollutionControlDevices: {
        id: initialRegistryData?.PollutionControlDevices?.id || "",
        bilgeWaterSeperator:
          parseInt(formData?.polutionControl?.bilgeWaterSeparator) || null,
        capacity: formData?.polutionControl?.bilgeCapacity || "",
        makeModel: formData?.polutionControl?.bilgeMakeModel || "",
        stp: parseInt(formData?.polutionControl?.sewageTreatmentPlant) || null,
        stpCapacity: formData?.polutionControl?.sewageCapacity || "",
        stpMakeModel: formData?.polutionControl?.sewageMakeModel || "",
        owf: parseInt(formData?.polutionControl?.oilyWaterFilter) || null,
        owfCapacity: formData?.polutionControl?.oilyCapacity || "",
        owfMakeModel: formData?.polutionControl?.oilyMakeModel || "",
        egasCleaningSystm:
          parseInt(formData?.polutionControl?.exhaustGasCleaning) || null,
        egasCleaningSystmCapacity:
          formData?.polutionControl?.exhaustCapacity || "",
        egasCleaningSystmMakeModel:
          formData?.polutionControl?.exhaustMakeModel || "",
        other: parseInt(formData?.polutionControl?.othersPollution) || null,
        otherCapacity: formData?.polutionControl?.othersCapacity || "",
        otherMakeModel: formData?.polutionControl?.othersMakeModel || "",
        status: "ACTIVE",
        iwtVesBasicSurveyDetTFk:
          initialRegistryData?.PollutionControlDevices?.iwtVesBasicSurveyDetTFk ||
          "",
      },

      CrewDetails: extractCrewDetails(formData?.crewDetails?.crewDetails),
      equipmentInventoryDetails: null,
      Enclosure: extractEnclosures(
        formData?.enclosure,
        registrationData?.applicationNumber ||
        registrationData?.vessel?.applicationNumber ||
        "",
        initialRegistryData?.Enclosure || []
      ),

      DetailsofPropulsionofEngine: {
        id: initialRegistryData?.DetailsofPropulsionofEngine?.id || "",
        yearOfBuild: formData?.basicVesselInfo?.yearOfBuild || "",
        engineType: formData?.detailsOfPropulsion?.typeOfEngine || "",
        engineMake: formData?.detailsOfPropulsion?.engineMake || "",
        makerAddress: formData?.detailsOfPropulsion?.engineMakerAddress || "",
        pin: registrationData?.engine?.pin || "",
        mobile: registrationData?.engine?.mobile || "",
        email: registrationData?.engine?.email || "",
        horsepower: parseInt(formData?.detailsOfPropulsion?.horsepower) || null,
        speed: parseInt(formData?.detailsOfPropulsion?.speedRPM) || null,
        yearOfMake: formData?.detailsOfPropulsion?.yearOfMake || "",
        applRegistrationTFk:
          registrationData?.vessel?.iwtVesselBasicDetailsTFk || "",
        modelNo: formData?.detailsOfPropulsion?.modelNo || "",
        noOfSet: formData?.detailsOfPropulsion?.numberOfSetFitted || null,
        numberOfEngine:
          parseInt(formData?.detailsOfPropulsion?.numberOfEngine) || null,
        setSerialNo: formData?.detailsOfPropulsion?.setSrNo || "",
        propellerType: formData?.detailsOfPropulsion?.propellerType || "",
        gearType: formData?.detailsOfPropulsion?.gearType || "",
        noOfGear: formData?.detailsOfPropulsion?.noOfGear || null,
        vesselSpeed: formData?.detailsOfPropulsion?.vesselSpeed || null,
        rpm: formData?.detailsOfPropulsion?.revolutionMints || null,
        engineCylinder:
          formData?.detailsOfPropulsion?.engineCylinderDiameter || null,
        stroke: formData?.detailsOfPropulsion?.strokeEngine || null,
        noOfCylinderPerSetRotaryEngine:
          parseInt(formData?.detailsOfPropulsion?.cylindersRotary) || null,
        noOfCylinderPerSetReciprocatingEngine:
          parseInt(formData?.detailsOfPropulsion?.cylindersReciprocating) ||
          null,
        noOfShaft:
          parseInt(formData?.detailsOfPropulsion?.numberOfShaft) || null,
        lengthOfEngineRoom:
          parseFloat(formData?.detailsOfPropulsion?.lengthEngineRoom) || null,
        iwtVesBasicSurveyDetTFk:
          initialRegistryData?.DetailsofPropulsionofEngine
            ?.iwtVesBasicSurveyDetTFk || "",
      },
    };

    if (initialRegistryData?.SurveyEquipments) {
      payload.SurveyEquipments = initialRegistryData.SurveyEquipments;
    }

    if (initialRegistryData?.passengerDistributionMaxLoad) {
      payload.passengerDistributionMaxLoad =
        initialRegistryData.passengerDistributionMaxLoad;
    }

    if (initialRegistryData?.vesselFreeboardData) {
      payload.vesselFreeboardData = initialRegistryData.vesselFreeboardData;
    }

    return payload;
  };

  const extractEnclosures = (
    formValue = {},
    applicationNumber = "",
    initialEnclosures = []
  ) => {
    const mapping = {
      authorizationFile: {
        type: "SURVEY_AUTHORIZATION_OF_AUTHORISED_PERSON",
        description: "Authorization file",
      },
      paymentChallan: {
        type: "SURVEY_PAYMENT_CHALLAN",
        description: "Payment challan",
      },
      builderCertificate: {
        type: "SURVEY_BUILDER_CERTIFICATE",
        description: "Builder certificate",
      },
      lastCertificateCopy: {
        type: "SURVEY_COPY_OF_LAST_CERTIFICATE_OF_SURVEY",
        description: "Last certificate copy",
      },
      registrationCertificateCopy: {
        type: "SURVEY_COPY_OF_CERTIFICATE_OF_REGISTRATION",
        description: "Registration certificate copy",
      },
      testCertificate: {
        type: "SURVEY_TEST_CERTIFICATE",
        description: "Test certificate",
      },
    };

    const initialMap = (
      Array.isArray(initialEnclosures) ? initialEnclosures : []
    ).reduce((acc, item) => {
      if (!item) return acc;
      acc[item.documentType] = item.id ?? "";
      return acc;
    }, {});

    return Object.entries(mapping).map(([key, { type, description }]) => {
      const fileStoreId = formValue[`${key}FileStoreId`] ?? "";
      const documentName =
        formValue[key]?.name || formValue[`${key}OriginalName`] || description;

      return {
        id: initialMap[type] ?? "",
        documentName,
        documentType: type,
        applicationNumber,
        fileStoreId,
        documentSource: "SURVEY_ENCLOSURE",
        description,
        active: true,
      };
    });
  };

  const extractCrewDetails = (crewDetails = []) => {
    if (!crewDetails || crewDetails?.length === 0) return [];

    const initialMap = (
      Array.isArray(initialRegistryData?.CrewDetails)
        ? initialRegistryData?.CrewDetails
        : []
    )?.reduce((acc, item) => {
      if (!item) return acc;
      //  const key = `${item.crewType ?? ""}_${item.name ?? ""}`.toLowerCase();
      // acc[key] = item;

      acc[item.name?.toLowerCase() || `crew_${Object.keys(acc).length}`] = item;
      return acc;
    }, {});

    return crewDetails?.map((crew = {}, index) => {
      //  const key = `${crew.crewType ?? ""}_${crew.name ?? ""}`.toLowerCase();
      // const initial = initialMap[key] ?? {};
      const matchKey = crew.name?.toLowerCase() || `crew_${index}`;
      const initial =
        initialMap[matchKey] || initialRegistryData?.CrewDetails?.[index] || {};

      return {
        id: initial?.id || "",
        crewType: crew.crewType ?? "",
        name: crew.name ?? "",
        rank: crew.rank ?? "",
        cocNo: crew.cocNo ?? "",
        validity: crew.validity ?? "",
        experience: crew.experience ?? null,
        iwtVesBasicSurveyDetTFk: initial?.iwtVesBasicSurveyDetTFk || "",
        status: crew.status ?? "ACTIVE",
      };
    });
  };

  const buildEquipmentPayload = (formData, existingSurveyData) => {
    const transformEquipmentData = (equipmentData) => {
      const hasExistingEquipment =
        existingSurveyData?.SurveyEquipments &&
        Object.values(existingSurveyData.SurveyEquipments).some(
          (arr) => Array.isArray(arr) && arr.length > 0
        );

      if (isOfficerLogin) {
        const transformed = {};

        if (existingSurveyData?.SurveyEquipments) {
          Object.keys(existingSurveyData.SurveyEquipments).forEach((key) => {
            transformed[key] = existingSurveyData.SurveyEquipments[key] || [];
          });
        }

        if (equipmentData) {
          Object.keys(equipmentData).forEach((equipmentId) => {
            const equipmentCategories = equipmentData[equipmentId];
            Object.keys(equipmentCategories).forEach((categoryCode) => {
              const categoryData = equipmentCategories[categoryCode];

              const equipment = masterData?.equipmentCategories?.find(
                (eq) => eq.id == equipmentId
              );
              const equipmentName = equipment?.equipmentName;

              if (equipmentName) {
                const equipmentKeyMap = {
                  "Fire Fighting Items": "EquipmentFireFightingItems",
                  Equipments: "Equipments",
                  "Navigational Equipments": "EquipmentNavigationalEquipments",
                  "Life-Saving Equipment": "EquipmentLifeSavingEquipment",
                  "Machinery/Electrical": "EquipmentMachineryElectrical",
                  "Accommodation/Safety": "EquipmentAccommodationSafety",
                };

                const apiKey = equipmentKeyMap[equipmentName];
                if (apiKey && transformed[apiKey]) {
                  transformed[apiKey] = transformed[apiKey].map(
                    (existingItem) => {
                      if (existingItem.categoryCode === categoryCode) {
                        return {
                          ...existingItem,
                          condition:
                            categoryData.condition ||
                            existingItem.condition ||
                            "",
                          remarks:
                            categoryData.remarks || existingItem.remarks || "",
                        };
                      }
                      return existingItem;
                    }
                  );
                }
              }
            });
          });
        }

        return transformed;
      }

      if (hasExistingEquipment) {
        const transformed = {};

        if (existingSurveyData?.SurveyEquipments) {
          Object.keys(existingSurveyData.SurveyEquipments).forEach((key) => {
            transformed[key] = existingSurveyData.SurveyEquipments[key] || [];
          });
        }

        if (equipmentData) {
          Object.keys(equipmentData).forEach((equipmentId) => {
            const equipmentCategories = equipmentData[equipmentId];
            Object.keys(equipmentCategories).forEach((categoryCode) => {
              const categoryData = equipmentCategories[categoryCode];

              const equipment = masterData?.equipmentCategories?.find(
                (eq) => eq.id == equipmentId
              );
              const equipmentName = equipment?.equipmentName;

              if (equipmentName) {
                const equipmentKeyMap = {
                  "Fire Fighting Items": "EquipmentFireFightingItems",
                  Equipments: "Equipments",
                  "Navigational Equipments": "EquipmentNavigationalEquipments",
                  "Life-Saving Equipment": "EquipmentLifeSavingEquipment",
                  "Machinery/Electrical": "EquipmentMachineryElectrical",
                  "Accommodation/Safety": "EquipmentAccommodationSafety",
                };

                const apiKey = equipmentKeyMap[equipmentName];
                if (apiKey && transformed[apiKey]) {
                  transformed[apiKey] = transformed[apiKey].map(
                    (existingItem) => {
                      if (existingItem.categoryCode === categoryCode) {
                        return {
                          ...existingItem,
                          number:
                            parseInt(categoryData.number) ||
                            existingItem.number ||
                            "",
                          type: categoryData.type || existingItem.type || "",
                          location:
                            categoryData.location ||
                            existingItem.location ||
                            "",
                          condition:
                            categoryData.condition ||
                            existingItem.condition ||
                            "",
                          capacity:
                            categoryData.capacity ||
                            existingItem.capacity ||
                            "",
                          remarks:
                            categoryData.remarks || existingItem.remarks || "",
                        };
                      }
                      return existingItem;
                    }
                  );
                }
              }
            });
          });
        }

        return transformed;
      } else {
        const transformed = {};

        if (equipmentData) {
          Object.keys(equipmentData).forEach((equipmentId) => {
            const equipmentCategories = equipmentData[equipmentId];
            Object.keys(equipmentCategories).forEach((categoryCode) => {
              const categoryData = equipmentCategories[categoryCode];

              const equipment = masterData?.equipmentCategories?.find(
                (eq) => eq.id == equipmentId
              );
              const equipmentName = equipment?.equipmentName;

              if (equipmentName) {
                const equipmentKeyMap = {
                  "Fire Fighting Items": "EquipmentFireFightingItems",
                  Equipments: "Equipments",
                  "Navigational Equipments": "EquipmentNavigationalEquipments",
                  "Life-Saving Equipment": "EquipmentLifeSavingEquipment",
                  "Machinery/Electrical": "EquipmentMachineryElectrical",
                  "Accommodation/Safety": "EquipmentAccommodationSafety",
                };

                const apiKey = equipmentKeyMap[equipmentName];
                if (apiKey) {
                  if (!transformed[apiKey]) {
                    transformed[apiKey] = [];
                  }

                  transformed[apiKey].push({
                    id: "",
                    source: apiKey,
                    surveyId: existingSurveyData?.surveyId || "",
                    categoryCode: categoryCode,
                    number: parseInt(categoryData.number) || "",
                    type: categoryData.type || "",
                    location: categoryData.location || "",
                    condition: categoryData.condition || "",
                    capacity: categoryData.capacity || "",
                    remarks: categoryData.remarks || "",
                    status: "ACTIVE",
                    basicDetailsFk: "",
                    auditDetails: null,
                  });
                }
              }
            });
          });
        }

        return transformed;
      }
    };

    const transformDeckSpaces = (deckSpaces) => {
      if (!deckSpaces || !Array.isArray(deckSpaces)) {
        return existingSurveyData?.passengerDistributionMaxLoad || [];
      }

      return deckSpaces?.map((deck, index) => {
        const existingDeck =
          existingSurveyData?.passengerDistributionMaxLoad?.[index] || {};

        return {
          id: existingDeck?.id || "",
          iwtVesRegBasicDetailsTFk:
            existingDeck?.iwtVesRegBasicDetailsTFk ||
            existingSurveyData?.BasicVesselInformation
              ?.iwtVesRegBasicDetailsTFk ||
            "",
          surveyId:
            existingDeck?.surveyId || existingSurveyData?.surveyId || "",
          deckName: deck.deckType || existingDeck.deckName || "",
          spaceType: deck.deckType || existingDeck.spaceType || "",
          maxPassengers:
            parseInt(deck.maxPassengers) || existingDeck.maxPassengers || null,
          sizeSqm: parseFloat(deck?.size) || existingDeck.sizeSqm || null,
          function: deck.function || existingDeck.function || "",
          source: existingDeck.source || "Manual Entry",
          condition: existingDeck.condition || "Good",
          remarks: deck.remarks || existingDeck.remarks || "",
        };
      });
    };

    const transformFreeboardData = (freeboard) => {
      if (!freeboard) return existingSurveyData?.vesselFreeboardData || null;

      const existing = existingSurveyData?.vesselFreeboardData || {};
      return {
        id: existing.id || "",
        minimumFreeboard:
          parseFloat(freeboard.minFreeboard) ||
          existing.minimumFreeboard ||
          null,
        numberOfPassengers:
          parseInt(freeboard.numPassengers) ||
          existing.numberOfPassengers ||
          null,
        cargoTonnes: parseFloat(freeboard.cargo) || existing.cargoTonnes || 0,
      };
    };

    const equipmentData = transformEquipmentData(formData.equipment);

    return {
      ...existingSurveyData,
      SurveyEquipments:
        Object.keys(equipmentData).length > 0
          ? equipmentData
          : existingSurveyData?.SurveyEquipments || {},
      passengerDistributionMaxLoad: transformDeckSpaces(formData.deckSpaces),
      vesselFreeboardData: transformFreeboardData(formData.freeboard),
    };
  };

  const submitSetp1 = async (formValues) => {
    const authLetterFile = formValues?.authLetter;
    const authLetterFileName =
      authLetterFile?.name || "Authorization Letter.pdf";

    let request = {
