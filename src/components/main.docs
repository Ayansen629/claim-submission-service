import React, { useState } from 'react';
import { Modal, Button, Form, Row, Col } from 'react-bootstrap';
import { FaUser, FaGraduationCap, FaBriefcase, FaFileUpload, FaChevronDown, FaChevronUp, FaPlus } from 'react-icons/fa';
import './EmployeeRegistrationModal.css';

const EmployeeRegistrationModal = ({ show, onHide }) => {
  const [activeSection, setActiveSection] = useState('personal');
  const [educationList, setEducationList] = useState([{ qualification: '', stream: '', yearOfPassing: '' }]);
  
  // Handle adding new education entry
  const addEducation = () => {
    setEducationList([...educationList, { qualification: '', stream: '', yearOfPassing: '' }]);
  };
  
  // Handle education field changes
  const handleEducationChange = (index, field, value) => {
    const newList = [...educationList];
    newList[index][field] = value;
    setEducationList(newList);
  };
  
  // Handle PIN code change to auto-populate district, state, country
  const handlePinChange = (e) => {
    const pin = e.target.value;
    if (pin.length === 6) {
      // In a real app, you would fetch data based on PIN
      document.getElementById('district').value = 'Sample District';
      document.getElementById('state').value = 'Sample State';
      document.getElementById('country').value = 'India';
    }
  };
  
  // Toggle section visibility
  const toggleSection = (section) => {
    setActiveSection(activeSection === section ? '' : section);
  };
  
  return (
    <Modal show={show} onHide={onHide} size="xl" centered>
      <Modal.Header closeButton>
        <Modal.Title>Employee Registration</Modal.Title>
      </Modal.Header>
      <Modal.Body className="employee-registration-modal">
        {/* Personal Details Section */}
        <div className="form-section">
          <div 
            className={`section-header ${activeSection === 'personal' ? 'active' : ''}`}
            onClick={() => toggleSection('personal')}
          >
            <div className="section-title">
              <FaUser className="section-icon" />
              <h5>Personal Details</h5>
            </div>
            {activeSection === 'personal' ? <FaChevronUp /> : <FaChevronDown />}
          </div>
          
          {activeSection === 'personal' && (
            <div className="section-content">
              <Row>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>First Name <span className="required">*</span></Form.Label>
                    <Form.Control type="text" placeholder="Enter first name" required />
                  </Form.Group>
                </Col>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>Last Name <span className="required">*</span></Form.Label>
                    <Form.Control type="text" placeholder="Enter last name" required />
                  </Form.Group>
                </Col>
              </Row>
              
              <Row>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>Email ID <span className="required">*</span></Form.Label>
                    <Form.Control type="email" placeholder="Enter email address" required />
                  </Form.Group>
                </Col>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>Phone Number <span className="required">*</span></Form.Label>
                    <Form.Control type="text" placeholder="Enter phone number" required />
                  </Form.Group>
                </Col>
              </Row>
              
              <Row>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>Gender <span className="required">*</span></Form.Label>
                    <Form.Select required>
                      <option value="">Select Gender</option>
                      <option value="male">Male</option>
                      <option value="female">Female</option>
                      <option value="other">Other</option>
                    </Form.Select>
                  </Form.Group>
                </Col>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>Date of Birth <span className="required">*</span></Form.Label>
                    <Form.Control type="date" required />
                  </Form.Group>
                </Col>
              </Row>
              
              <div className="sub-section">
                <h6>Address Details</h6>
                <Row>
                  <Col md={6}>
                    <Form.Group className="mb-3">
                      <Form.Label>Address Line-1 <span className="required">*</span></Form.Label>
                      <Form.Control type="text" placeholder="Enter address line 1" required />
                    </Form.Group>
                  </Col>
                  <Col md={6}>
                    <Form.Group className="mb-3">
                      <Form.Label>Address Line-2</Form.Label>
                      <Form.Control type="text" placeholder="Enter address line 2" />
                    </Form.Group>
                  </Col>
                </Row>
                
                <Row>
                  <Col md={6}>
                    <Form.Group className="mb-3">
                      <Form.Label>PIN <span className="required">*</span></Form.Label>
                      <Form.Control 
                        type="text" 
                        placeholder="Enter PIN code" 
                        required 
                        onChange={handlePinChange}
                        maxLength={6}
                      />
                    </Form.Group>
                  </Col>
                  <Col md={6}>
                    <Form.Group className="mb-3">
                      <Form.Label>District</Form.Label>
                      <Form.Control 
                        type="text" 
                        placeholder="Auto-populated" 
                        id="district" 
                        readOnly 
                        className="auto-populated"
                      />
                    </Form.Group>
                  </Col>
                </Row>
                
                <Row>
                  <Col md={6}>
                    <Form.Group className="mb-3">
                      <Form.Label>State/UT</Form.Label>
                      <Form.Control 
                        type="text" 
                        placeholder="Auto-populated" 
                        id="state" 
                        readOnly 
                        className="auto-populated"
                      />
                    </Form.Group>
                  </Col>
                  <Col md={6}>
                    <Form.Group className="mb-3">
                      <Form.Label>Country</Form.Label>
                      <Form.Control 
                        type="text" 
                        placeholder="Auto-populated" 
                        id="country" 
                        readOnly 
                        className="auto-populated"
                      />
                    </Form.Group>
                  </Col>
                </Row>
              </div>
            </div>
          )}
        </div>
        
        {/* Education Details Section */}
        <div className="form-section">
          <div 
            className={`section-header ${activeSection === 'education' ? 'active' : ''}`}
            onClick={() => toggleSection('education')}
          >
            <div className="section-title">
              <FaGraduationCap className="section-icon" />
              <h5>Education Details</h5>
            </div>
            {activeSection === 'education' ? <FaChevronUp /> : <FaChevronDown />}
          </div>
          
          {activeSection === 'education' && (
            <div className="section-content">
              {educationList.map((edu, index) => (
                <div key={index} className="education-entry">
                  {index > 0 && <div className="entry-divider"></div>}
                  <Row>
                    <Col md={4}>
                      <Form.Group className="mb-3">
                        <Form.Label>Qualification {index === 0 && <span className="required">*</span>}</Form.Label>
                        <Form.Control 
                          type="text" 
                          placeholder="Enter qualification" 
                          required={index === 0}
                          value={edu.qualification}
                          onChange={(e) => handleEducationChange(index, 'qualification', e.target.value)}
                        />
                      </Form.Group>
                    </Col>
                    <Col md={4}>
                      <Form.Group className="mb-3">
                        <Form.Label>Stream {index === 0 && <span className="required">*</span>}</Form.Label>
                        <Form.Control 
                          type="text" 
                          placeholder="Enter stream" 
                          required={index === 0}
                          value={edu.stream}
                          onChange={(e) => handleEducationChange(index, 'stream', e.target.value)}
                        />
                      </Form.Group>
                    </Col>
                    <Col md={4}>
                      <Form.Group className="mb-3">
                        <Form.Label>Year of Passing {index === 0 && <span className="required">*</span>}</Form.Label>
                        <Form.Control 
                          type="number" 
                          placeholder="Enter year" 
                          required={index === 0}
                          value={edu.yearOfPassing}
                          onChange={(e) => handleEducationChange(index, 'yearOfPassing', e.target.value)}
                          min="1950"
                          max={new Date().getFullYear()}
                        />
                      </Form.Group>
                    </Col>
                  </Row>
                </div>
              ))}
              
              <div className="text-end">
                <Button 
                  variant="outline-primary" 
                  size="sm" 
                  onClick={addEducation}
                  className="add-education-btn"
                >
                  <FaPlus className="me-1" /> Add Education Details
                </Button>
              </div>
            </div>
          )}
        </div>
        
        {/* Professional Details Section */}
        <div className="form-section">
          <div 
            className={`section-header ${activeSection === 'professional' ? 'active' : ''}`}
            onClick={() => toggleSection('professional')}
          >
            <div className="section-title">
              <FaBriefcase className="section-icon" />
              <h5>Professional Details</h5>
            </div>
            {activeSection === 'professional' ? <FaChevronUp /> : <FaChevronDown />}
          </div>
          
          {activeSection === 'professional' && (
            <div className="section-content">
              <Row>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>Appointment Date <span className="required">*</span></Form.Label>
                    <Form.Control type="date" required />
                  </Form.Group>
                </Col>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>Employee Type <span className="required">*</span></Form.Label>
                    <Form.Select required>
                      <option value="">Select Employee Type</option>
                      <option value="permanent">Permanent</option>
                      <option value="contract">Contract</option>
                      <option value="temporary">Temporary</option>
                    </Form.Select>
                  </Form.Group>
                </Col>
              </Row>
              
              <Row>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>Employee Status <span className="required">*</span></Form.Label>
                    <Form.Select required>
                      <option value="">Select Status</option>
                      <option value="active">Active</option>
                      <option value="inactive">Inactive</option>
                      <option value="onLeave">On Leave</option>
                    </Form.Select>
                  </Form.Group>
                </Col>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>Designation <span className="required">*</span></Form.Label>
                    <Form.Select required>
                      <option value="">Select Designation</option>
                      <option value="manager">Manager</option>
                      <option value="developer">Developer</option>
                      <option value="analyst">Analyst</option>
                      <option value="admin">Administrator</option>
                    </Form.Select>
                  </Form.Group>
                </Col>
              </Row>
              
              <Row>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>Department</Form.Label>
                    <Form.Control type="text" placeholder="Auto-populated" readOnly className="auto-populated" />
                  </Form.Group>
                </Col>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>Section <span className="required">*</span></Form.Label>
                    <Form.Control type="text" placeholder="Enter section" required />
                  </Form.Group>
                </Col>
              </Row>
              
              <Row>
                <Col md={6}>
                  <Form.Group className="mb-3">
                    <Form.Label>Roles <span className="required">*</span></Form.Label>
                    <Form.Select required>
                      <option value="">Select Role</option>
                      <option value="admin">Admin</option>
                      <option value="user">User</option>
                      <option value="manager">Manager</option>
                      <option value="supervisor">Supervisor</option>
                    </Form.Select>
                  </Form.Group>
                </Col>
              </Row>
            </div>
          )}
        </div>
        
        {/* Documents Upload Section */}
        <div className="form-section">
          <div 
            className={`section-header ${activeSection === 'documents' ? 'active' : ''}`}
            onClick={() => toggleSection('documents')}
          >
            <div className="section-title">
              <FaFileUpload className="section-icon" />
              <h5>Documents Upload</h5>
            </div>
            {activeSection === 'documents' ? <FaChevronUp /> : <FaChevronDown />}
          </div>
          
          {activeSection === 'documents' && (
            <div className="section-content">
              <Row>
                <Col md={4}>
                  <Form.Group className="mb-3">
                    <Form.Label>Address Proof <span className="required">*</span></Form.Label>
                    <div className="custom-file-upload">
                      <Form.Control type="file" required />
                      <div className="file-upload-info">
                        <small>Upload PDF, JPG or PNG (Max: 2MB)</small>
                      </div>
                    </div>
                  </Form.Group>
                </Col>
                <Col md={4}>
                  <Form.Group className="mb-3">
                    <Form.Label>Identity Proof <span className="required">*</span></Form.Label>
                    <div className="custom-file-upload">
                      <Form.Control type="file" required />
                      <div className="file-upload-info">
                        <small>Upload PDF, JPG or PNG (Max: 2MB)</small>
                      </div>
                    </div>
                  </Form.Group>
                </Col>
                <Col md={4}>
                  <Form.Group className="mb-3">
                    <Form.Label>Joining/Appointment Letter <span className="required">*</span></Form.Label>
                    <div className="custom-file-upload">
                      <Form.Control type="file" required />
                      <div className="file-upload-info">
                        <small>Upload PDF, JPG or PNG (Max: 2MB)</small>
                      </div>
                    </div>
                  </Form.Group>
                </Col>
              </Row>
            </div>
          )}
        </div>
      </Modal.Body>
      <Modal.Footer>
        <Button variant="secondary" onClick={onHide}>
          Cancel
        </Button>
        <Button variant="primary" type="submit">
          Submit
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default EmployeeRegistrationModal;


/////////////////
/* EmployeeRegistrationModal.css */
.employee-registration-modal {
  max-height: 70vh;
  overflow-y: auto;
  padding: 0 1rem;
}

.form-section {
  margin-bottom: 1rem;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
  background-color: #f8f9fa;
  cursor: pointer;
  transition: all 0.3s ease;
}

.section-header:hover {
  background-color: #e9ecef;
}

.section-header.active {
  background-color: #e7f1ff;
  border-bottom: 1px solid #dee2e6;
}

.section-title {
  display: flex;
  align-items: center;
}

.section-icon {
  margin-right: 10px;
  font-size: 1.2rem;
  color: #0d6efd;
}

.section-content {
  padding: 1.5rem;
  background-color: #fff;
}

.sub-section {
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px dashed #dee2e6;
}

.sub-section h6 {
  margin-bottom: 1rem;
  color: #495057;
  font-weight: 600;
}

.required {
  color: #dc3545;
}

.auto-populated {
  background-color: #f8f9fa;
  color: #6c757d;
}

.education-entry {
  padding: 1rem 0;
}

.entry-divider {
  margin: 1rem 0;
  border-top: 1px dashed #dee2e6;
}

.add-education-btn {
  margin-top: 1rem;
}

.custom-file-upload {
  position: relative;
}

.file-upload-info {
  margin-top: 0.5rem;
  color: #6c757d;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .employee-registration-modal {
    max-height: 80vh;
  }
}
//////////////////
// In UserManagement.jsx
import EmployeeRegistrationModal from './EmployeeRegistrationModal';

// Inside your UserManagement component
const [showEmployeeModal, setShowEmployeeModal] = useState(false);

// Update handleBtnClick
const handleBtnClick = (e) => {
  setShowEmployeeModal(true);
};

// Add this to your return statement
return (
  <>
    {/* Your existing code */}
    
    <EmployeeRegistrationModal 
      show={showEmployeeModal} 
      onHide={() => setShowEmployeeModal(false)} 
    />
  </>
);
