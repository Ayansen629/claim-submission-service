import React, { useState } from "react";
import { Container, Row, Col, Card, Button, Badge } from "react-bootstrap";
import { FaArrowLeft, FaEye, FaDownload } from "react-icons/fa";
import { useNavigate } from "react-router-dom";
import ActionDropdown from "../common/ActionDropdown";
import styles from './ApplicationView.module.css';

const ApplicationView = () => {
  const navigate = useNavigate();

  const vesselData = [
    { id: 1, name: "Gangadhara", number: "WB001", status: "pending" },
    { id: 2, name: "Subamarekha", number: "WB002", status: "approved" },
    { id: 3, name: "Nabajattra", number: "WB345", status: "pending" },
    { id: 4, name: "Alakananda", number: "WB234", status: "rejected" },
  ];

  const paymentData = [
    {
      id: "WB/IWT/REG/25-26/001014",
      type: "Owner Name Change",
      amount: "****",
      date: "22-09-2026",
      status: "Pending"
    }
  ];

  const actionOptions = [
    { actionName: "Approve Application" },
    { actionName: "Reject Application" },
    { actionName: "Send Back for Correction" },
    { actionName: "Forward to Next Level" },
    { actionName: "View Details" }
  ];

  const handleActionClick = (action) => {
    console.log("Action clicked:", action);
  };

  return (
    <div className={styles.container}>
      <div className={styles.mainContent}>
        <div className={styles.topSection}>
          <div className={styles.headerRow}>
            <Button
              variant="outline-primary"
              onClick={() => navigate(-1)}
              className={styles.backButton}
            >
              <FaArrowLeft />
            </Button>
            <h5 className={styles.title}>
              Application Details Update
            </h5>
            <div className={styles.applicationId}>
              WB-IWT/REG/2025/302748
            </div>
          </div>
          
          <div className={styles.statusBanner}>
            Company name has been updated from ABC Pvt. Limited to [New Company Name].
          </div>
        </div>

        <Row className="mb-4">
          <Col lg={6} className="mb-3">
            <Card className={styles.namesCard}>
              <Card.Body>
                <div className={styles.nameField}>
                  <div className={styles.fieldLabel}>Existing Name</div>
                  <div className={styles.fieldValue}>Anirban Mukherjee</div>
                </div>
                <div className={styles.nameField}>
                  <div className={styles.fieldLabel}>New Name</div>
                  <div className={styles.fieldValue}>Anindita Choudhury</div>
                </div>
              </Card.Body>
            </Card>
          </Col>

          <Col lg={6} className="mb-3">
            <Card className={styles.fileCard}>
              <Card.Body>
                <div className={styles.warningText}>
                  Valid documents for name change have been uploaded by the owner for your verification.
                </div>
                <div className={styles.fileRow}>
                  <span className={styles.fileName}>File Name</span>
                  <div className={styles.fileActions}>
                    <button className={styles.iconButton}>
                      <FaEye />
                    </button>
                    <button className={styles.iconButton}>
                      <FaDownload />
                    </button>
                  </div>
                </div>
              </Card.Body>
            </Card>
          </Col>
        </Row>

        <div className={styles.vesselSection}>
          <div className={styles.vesselHeader}>
            <div className={styles.sectionTitle}>SL</div>
            <div className={styles.sectionTitle}>Vessel Name</div>
            <div className={styles.sectionTitle}>Registration Number</div>
            <div className={styles.sectionTitle}>Existing Book of Registration</div>
            <div className={styles.sectionTitle}>Existing Registration Certificate</div>
            <div className={styles.sectionTitle}>New Registration Certificate</div>
          </div>

          {vesselData.map((vessel, index) => (
            <div key={vessel.id} className={styles.vesselRow} data-label="">
              <div className={styles.vesselCell} data-label="SL">
                <span className={styles.vesselNumber}>{index + 1}</span>
              </div>
              <div className={styles.vesselCell} data-label="Vessel Name">
                <span className={styles.vesselName}>{vessel.name}</span>
              </div>
              <div className={styles.vesselCell} data-label="Registration Number">
                <span>{vessel.number}</span>
              </div>
              <div className={styles.vesselCell} data-label="Existing Book">
                <div className={styles.vesselActions}>
                  <button className={styles.vesselIconButton}>
                    <FaEye />
                  </button>
                  <button className={styles.vesselIconButton}>
                    <FaDownload />
                  </button>
                </div>
              </div>
              <div className={styles.vesselCell} data-label="Existing Certificate">
                <div className={styles.vesselActions}>
                  <button className={styles.vesselIconButton}>
                    <FaEye />
                  </button>
                  <button className={styles.vesselIconButton}>
                    <FaDownload />
                  </button>
                </div>
              </div>
              <div className={styles.vesselCell} data-label="New Certificate">
                <div className={styles.vesselActions}>
                  <button className={styles.vesselIconButton}>
                    <FaEye />
                  </button>
                  <button className={styles.vesselIconButton}>
                    <FaDownload />
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div className={styles.paymentSection}>
          <div className={styles.paymentHeader}>
            <span className={styles.paymentIcon}>💳</span>
            <span className={styles.paymentTitle}>Payment Details</span>
          </div>
          
          <div className={styles.paymentTableHeader}>
            <div className={styles.tableHeaderCell}>Payment Id</div>
            <div className={styles.tableHeaderCell}>Payment Type</div>
            <div className={styles.tableHeaderCell}>Amount</div>
            <div className={styles.tableHeaderCell}>Payment Date</div>
            <div className={styles.tableHeaderCell}>Status</div>
            <div className={styles.tableHeaderCell}>Receipt</div>
          </div>

          {paymentData.map((payment) => (
            <div key={payment.id} className={styles.paymentRow}>
              <div className={styles.paymentCell} data-label="Payment ID">{payment.id}</div>
              <div className={styles.paymentCell} data-label="Payment Type">{payment.type}</div>
              <div className={styles.paymentCell} data-label="Amount">{payment.amount}</div>
              <div className={styles.paymentCell} data-label="Payment Date">{payment.date}</div>
              <div className={styles.paymentCell} data-label="Status">
                <Badge bg="warning" text="dark">
                  {payment.status}
                </Badge>
              </div>
              <div className={styles.paymentCell} data-label="Receipt">
                <button className={styles.tableIconButton}>
                  <FaEye />
                </button>
                <button className={styles.tableIconButton}>
                  <FaDownload />
                </button>
              </div>
            </div>
          ))}
        </div>

        <div className={styles.actionSection}>
          <ActionDropdown 
            actions={actionOptions}
            onActionClick={handleActionClick}
          />
        </div>
      </div>
    </div>
  );
};

export default ApplicationView;
