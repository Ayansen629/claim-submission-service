import React, { useState } from "react";
import { Button, Offcanvas, Form, Card } from "react-bootstrap";
import { BsSticky, BsPlus, BsTrash2 } from "react-icons/bs";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";

const NoteSheet = ({ show, onHide, initialNotes = [] }) => {
  const { t } = useTranslation();
  const [notes, setNotes] = useState(initialNotes);
  const [newNote, setNewNote] = useState({ title: "", content: "" });

  const addNote = () => {
    if (newNote.title.trim() && newNote.content.trim()) {
      const note = {
        id: Date.now(),
        title: newNote.title,
        content: newNote.content,
        date: new Date().toISOString().split('T')[0],
        author: "Current User"
      };
      setNotes([note, ...notes]);
      setNewNote({ title: "", content: "" });
      toast.success(t("Note added successfully"));
    }
  };

  const deleteNote = (id) => {
    setNotes(notes.filter(note => note.id !== id));
    toast.success(t("Note deleted successfully"));
  };

  return (
    <Offcanvas 
      show={show} 
      onHide={onHide} 
      placement="end"
      style={{ width: "450px" }}
    >
      <Offcanvas.Header 
        closeButton 
        className="text-white border-0"
        style={{ 
          background: "linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%)",
          padding: "1rem 1.5rem"
        }}
      >
        <Offcanvas.Title className="fw-bold d-flex align-items-center">
          <BsSticky className="me-2" size={20} />
          {t("Note Sheet")}
        </Offcanvas.Title>
      </Offcanvas.Header>
      
      <Offcanvas.Body 
        className="p-0" 
        style={{ 
          background: "#f8f9fa",
          overflowX: "hidden"
        }}
      >
        {/* Add New Note Section */}
        <div className="p-4 bg-white border-bottom shadow-sm">
          <h6 className="fw-bold mb-3 text-primary">{t("Add New Note")}</h6>
          <Form.Group className="mb-3">
            <Form.Label className="fw-semibold small text-muted">{t("Title")}</Form.Label>
            <Form.Control
              type="text"
              placeholder={t("Enter note title...")}
              value={newNote.title}
              onChange={(e) => setNewNote({...newNote, title: e.target.value})}
              className="border-0 shadow-sm"
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Form.Group>
          <Form.Group className="mb-3">
            <Form.Label className="fw-semibold small text-muted">{t("Content")}</Form.Label>
            <Form.Control
              as="textarea"
              rows={4}
              placeholder={t("Write your note here...")}
              value={newNote.content}
              onChange={(e) => setNewNote({...newNote, content: e.target.value})}
              className="border-0 shadow-sm"
              style={{ backgroundColor: "#f8f9fa", resize: "none" }}
            />
          </Form.Group>
          <Button 
            variant="primary" 
            onClick={addNote}
            disabled={!newNote.title.trim() || !newNote.content.trim()}
            className="w-100 fw-semibold"
            style={{
              background: "linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%)",
              border: "none",
              borderRadius: "8px",
              padding: "10px"
            }}
          >
            <BsPlus className="me-2" size={18} />
            {t("Add Note")}
          </Button>
        </div>

        {/* Notes List */}
        <div className="p-4">
          <div className="d-flex justify-content-between align-items-center mb-4">
            <h6 className="fw-bold mb-0 text-primary">{t("Notes")}</h6>
            <span className="badge bg-primary rounded-pill">{notes.length}</span>
          </div>
          
          <div 
            style={{ 
              maxHeight: "calc(100vh - 400px)", 
              overflowY: "auto",
              overflowX: "hidden",
              paddingRight: "8px"
            }}
            className="notes-container"
          >
            {notes.length === 0 ? (
              <div className="text-center text-muted py-5">
                <div className="bg-light rounded-circle p-4 d-inline-flex mb-3">
                  <BsSticky size={48} className="opacity-25" />
                </div>
                <p className="mb-0">{t("No notes yet")}</p>
                <small className="text-muted">{t("Add your first note above")}</small>
              </div>
            ) : (
              notes.map((note) => (
                <Card key={note.id} className="mb-3 shadow-sm border-0 position-relative">
                  <Card.Body className="p-3">
                    <div className="d-flex align-items-start">
                      <div className="flex-grow-1 pe-5">
                        <h6 className="fw-bold mb-2 text-primary" style={{ fontSize: "0.95rem" }}>
                          {note.title}
                        </h6>
                        <p className="mb-3 text-dark" style={{ fontSize: "0.9rem", lineHeight: "1.5" }}>
                          {note.content}
                        </p>
                        <div className="d-flex justify-content-between align-items-center pt-2 border-top">
                          <small className="text-muted fw-medium">{note.author}</small>
                          <small className="text-muted">{note.date}</small>
                        </div>
                      </div>
                      
                      {/* Delete Button - Positioned absolutely */}
                      <Button
                        variant="outline-danger"
                        size="sm"
                        onClick={() => deleteNote(note.id)}
                        className="position-absolute rounded-circle d-flex align-items-center justify-content-center"
                        style={{ 
                          top: "12px",
                          right: "12px",
                          width: "32px", 
                          height: "32px", 
                          minWidth: "32px",
                          border: "1px solid #dc3545",
                          backgroundColor: "white",
                          zIndex: 1
                        }}
                        title={t("Delete Note")}
                      >
                        <BsTrash2 size={14} className="text-danger" />
                      </Button>
                    </div>
                  </Card.Body>
                </Card>
              ))
            )}
          </div>
        </div>
      </Offcanvas.Body>

      {/* Custom CSS for scrollbar */}
      <style jsx>{`
        .notes-container::-webkit-scrollbar {
          width: 6px;
        }
        .notes-container::-webkit-scrollbar-track {
          background: #f1f1f1;
          border-radius: 10px;
        }
        .notes-container::-webkit-scrollbar-thumb {
          background: #c1c1c1;
          border-radius: 10px;
        }
        .notes-container::-webkit-scrollbar-thumb:hover {
          background: #a8a8a8;
        }
      `}</style>
    </Offcanvas>
  );
};

export default NoteSheet;
