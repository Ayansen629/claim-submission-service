import React, { useState } from "react";
import { Form, InputGroup, OverlayTrigger, Tooltip } from "react-bootstrap";
import { FaEye, FaEyeSlash } from "react-icons/fa";
import classNames from "classnames";

interface InputTextProps {
  label: string;
  required?: boolean;
  name: string;
  type?: string;
  placeholder?: string;
  register?: any;
  disabled?: boolean;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  maxlength?: number;
  readOnly?: boolean;
  errors?: any;
  className?: string;
  onKeyDown?: (e: React.KeyboardEvent<HTMLInputElement>) => void;
  icon?: React.ElementType;
  description?: string;
  style?: React.CSSProperties;
}

const InputText: React.FC<InputTextProps> = ({
  label,
  required,
  name,
  type = "text",
  placeholder,
  register,
  disabled,
  onChange,
  maxlength,
  readOnly,
  errors,
  className = "",
  onKeyDown,
  icon: IconComponent,
  description,
  style = {}
}) => {
  const [showPassword, setShowPassword] = useState(false);
  const isPassword = type === "password";
  const inputType = isPassword ? (showPassword ? "text" : "password") : type;

  const hasError = errors && errors[name];
  const inputClasses = classNames("shadow-sm", {
    "is-invalid": hasError,
    "border-start-0": IconComponent,
    "border-end-0": isPassword,
  });

  const combinedStyle = {
    ...style,
    borderColor: hasError ? '#dc3545' : '#ced4da',
    backgroundColor: hasError ? '#fff8f8' : 'white',
    height: '50px',
    borderRadius: '8px'
  };

  const togglePasswordVisibility = () => setShowPassword((prev) => !prev);

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      {label && (
        <Form.Label className="fw-bold text-dark">
          {label}
          {required && <span className="text-danger ms-1">*</span>}
        </Form.Label>
      )}

      <InputGroup className="input-with-icon">
        {IconComponent && (
          <InputGroup.Text 
            className={`bg-white ${hasError ? 'border-danger' : ''}`}
            style={{
              borderRight: 'none',
              borderColor: hasError ? '#dc3545' : '#ced4da',
              height: '50px'
            }}
          >
            <IconComponent 
              className={hasError ? 'text-danger' : 'text-primary'} 
              size={18} 
            />
          </InputGroup.Text>
        )}

        <Form.Control
          type={inputType}
          name={name}
          placeholder={placeholder}
          {...register}
          disabled={disabled}
          onChange={onChange}
          maxLength={maxlength}
          readOnly={readOnly}
          onKeyDown={onKeyDown}
          className={inputClasses}
          aria-label={label}
          style={combinedStyle}
        />

        {isPassword && (
          <OverlayTrigger
            placement="top"
            overlay={
              <Tooltip id={`tooltip-${name}`}>
                {showPassword ? "Hide password" : "Show password"}
              </Tooltip>
            }
          >
            <InputGroup.Text
              className={`bg-white ${hasError ? 'border-danger' : ''}`}
              style={{
                borderLeft: 'none',
                borderColor: hasError ? '#dc3545' : '#ced4da',
                height: '50px',
                cursor: "pointer"
              }}
              onClick={togglePasswordVisibility}
              aria-label="Toggle password visibility"
            >
              {showPassword ? 
                <FaEyeSlash size={18} color={hasError ? '#dc3545' : '#387AD4'} /> : 
                <FaEye size={18} color={hasError ? '#dc3545' : '#387AD4'} />
              }
            </InputGroup.Text>
          </OverlayTrigger>
        )}
      </InputGroup>

      {description && (
        <Form.Text className="text-muted small mt-1">
          {description}
        </Form.Text>
      )}

      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputText;

///////////////
import React from "react";
import { Form } from "react-bootstrap";
import { FaUpload } from "react-icons/fa";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  register?: any;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  register,
  errors,
  onChange,
  accept,
  disabled,
  className = "",
  style = {},
  watch
}) => {
  const hasError = errors && errors[name];
  
  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      <div 
        className={`file-upload border rounded p-3 ${hasError ? 'border-danger' : ''}`} 
        style={{
          ...style,
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderRadius: '8px'
        }}
      >
        <input 
          type="file" 
          id={name}
          {...register}
          onChange={onChange}
          accept={accept}
          disabled={disabled}
          className="file-input d-none"
        />
        <label 
          htmlFor={name} 
          className={`file-label btn btn-outline-primary mb-0 d-inline-flex align-items-center ${hasError ? 'border-danger' : ''}`} 
          style={{ borderRadius: '6px' }}
        >
          <FaUpload className={`file-icon me-2 ${hasError ? 'text-danger' : ''}`} />
          <span className={`file-text ${hasError ? 'text-danger' : ''}`}>Choose File</span>
        </label>
        <span className={`file-name ms-3 ${hasError ? 'text-danger' : 'text-muted'}`}>
          {watch?.(name) ? watch(name) : 'No file chosen'}
        </span>
      </div>
      
      <Form.Text className="text-muted small mt-1">
        Upload PDF, JPG or PNG file (Max size: 2MB)
      </Form.Text>
      
      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
//////////////
import React from "react";
import { Form } from "react-bootstrap";

interface InputSelectProps {
  label: string;
  required?: boolean;
  name: string;
  options: Array<{ value: string | number; label: string }>;
  register?: any;
  errors?: any;
  disabled?: boolean;
  onChange?: (e: React.ChangeEvent<HTMLSelectElement>) => void;
  className?: string;
  style?: React.CSSProperties;
  icon?: React.ElementType;
  defaultValue?: string | number;
}

const InputSelect: React.FC<InputSelectProps> = ({
  label,
  required,
  name,
  options,
  register,
  errors,
  disabled,
  onChange,
  className = "",
  style = {},
  icon: IconComponent,
  defaultValue
}) => {
  const hasError = errors && errors[name];
  
  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      <div className="input-with-icon">
        {IconComponent && (
          <div 
            className={`input-icon-container ${hasError ? 'text-danger' : 'text-primary'}`}
            style={{
              position: 'absolute',
              left: '10px',
              top: '50%',
              transform: 'translateY(-50%)',
              zIndex: 4
            }}
          >
            <IconComponent size={18} />
          </div>
        )}
        
        <Form.Select
          {...register}
          disabled={disabled}
          onChange={onChange}
          className={`form-select ${hasError ? 'is-invalid border-danger' : ''}`}
          style={{
            ...style,
            height: '50px',
            borderRadius: '8px',
            borderColor: hasError ? '#dc3545' : '#ced4da',
            backgroundColor: hasError ? '#fff8f8' : 'white',
            paddingLeft: IconComponent ? '40px' : '12px'
          }}
          defaultValue={defaultValue}
        >
          {options.map((option, index) => (
            <option key={index} value={option.value}>
              {option.label}
            </option>
          ))}
        </Form.Select>
      </div>
      
      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;
///////////////
case 'select':
  return (
    <InputSelect
      label={field.label}
      required={field.required}
      name={field.name}
      options={field.options}
      register={register(field.name, {
        ...field.validation,
        onChange: handleChange
      })}
      errors={errors}
      icon={field.icon}
      className="mb-4"
    />
  );
