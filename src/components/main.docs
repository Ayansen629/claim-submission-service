const handlePreview = async () => {
  setIsPreviewLoading(true);
  try {
    const currentStepData = currentSubmitHandler ? await currentSubmitHandler() : {};
    
    if (!validateStepData(currentStep, currentStepData)) {
      setIsPreviewLoading(false);
      return;
    }

    const updatedFormData = {
      ...formData,
      [`step${currentStep}`]: { 
        ...formData[`step${currentStep}`], 
        ...currentStepData 
      }
    };
    
    setFormData(updatedFormData);
    updateRegistrationData(`step${currentStep}`, updatedFormData[`step${currentStep}`], id);

    // Generate unique IDs for file uploads
    const generateFileId = () => `file-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`;

    // Prepare API payload with the updated structure
    const payload = {
      claimDetails: {
        debtorName: updatedFormData.step1?.debtorName || staticFormData.step1.debtorName,
        creditorName: updatedFormData.step1?.CreditorName || staticFormData.step1.CreditorName,
        totalClaimAmount: parseFloat(updatedFormData.step1?.totalClaimAmount || staticFormData.step1.totalClaimAmount || 0),
        debtDetails: updatedFormData.step1?.debtDetails || staticFormData.step1.debtDetails,
        mutualCreditDetails: updatedFormData.step1?.mutualCreditDetails || staticFormData.step1.mutualCreditDetails,
      },
      identificationDetails: {
        type: updatedFormData.step1?.identificationType || staticFormData.step1.identificationType,
        number: updatedFormData.step1?.identificationNumber || staticFormData.step1.identificationNumber,
        document: {
          uploadfileId: generateFileId(),
          fileType: "identification",
          fileName: "identification_document.pdf",
          filePath: updatedFormData.step1?.identificationDocument?.path || staticFormData.step1.identificationDocument.path,
          uploadedAt: new Date().toISOString(),
        },
      },
      securityAndGuarantee: {
        securityInterestAmount: parseFloat(updatedFormData.step2?.securityInterestAmount || staticFormData.step2.securityInterestAmount || 0),
        guaranteeAmount: parseFloat(updatedFormData.step2?.guaranteeAmount || staticFormData.step2.guaranteeAmount || 0),
        guarantorName: updatedFormData.step2?.guarantorName || staticFormData.step2.guarantorName,
        guarantorAddress: updatedFormData.step2?.guarantorAddress || staticFormData.step2.guarantorAddress,
      },
      creditorDetails: {
        address: updatedFormData.step2?.creditorAddress || staticFormData.step2.creditorAddress,
        email: updatedFormData.step2?.creditorEmail || staticFormData.step2.creditorEmail,
        beneficiaryName: updatedFormData.step2?.beneficiaryName || staticFormData.step2.beneficiaryName,
        beneficiaryAddress: updatedFormData.step2?.beneficiaryAddress || staticFormData.step2.beneficiaryAddress,
      },
      corporateDebtorDetails: {
        securityAmount: parseFloat(updatedFormData.step2?.corporateDebtorSecurityAmount || staticFormData.step2.corporateDebtorSecurityAmount || 0),
        guaranteeAmount: parseFloat(updatedFormData.step2?.corporateDebtorGuaranteeAmount || staticFormData.step2.corporateDebtorGuaranteeAmount || 0),
      },
      principalBorrower: {
        name: updatedFormData.step2?.principalBorrowerName || staticFormData.step2.principalBorrowerName,
        address: updatedFormData.step2?.principalBorrowerAddress || staticFormData.step2.principalBorrowerAddress,
      },
      bankDetails: {
        accountNumber: updatedFormData.step2?.accountNumber || staticFormData.step2.accountNumber,
        ifscCode: updatedFormData.step2?.ifscCode || staticFormData.step2.ifscCode,
        branchName: updatedFormData.step2?.branchName || staticFormData.step2.branchName,
        addressProof: {
          uploadfileId: generateFileId(),
          fileType: "address_proof",
          fileName: "address_proof.pdf",
          filePath: updatedFormData.step2?.addressProof?.path || staticFormData.step2.addressProof.path,
          uploadedAt: new Date().toISOString(),
        },
      },
      signatoryDetails: {
        name: updatedFormData.step3?.signatoryName || staticFormData.step3.signatoryName,
        position: updatedFormData.step3?.signatoryPosition || staticFormData.step3.signatoryPosition,
        address: updatedFormData.step3?.signatoryAddress || staticFormData.step3.signatoryAddress,
        document: {
          uploadfileId: generateFileId(),
          fileType: "signatory_document",
          fileName: "signatory_document.pdf",
          filePath: updatedFormData.step3?.signatoryDocument?.path || staticFormData.step3.signatoryDocument.path,
          uploadedAt: new Date().toISOString(),
        },
      },
      metadata: {
        formType: userFormData?.formType,
        userId: userFormData?.userId,
        draftId: id || null,
        createdAt: new Date().toISOString(),
      },
    };

    // Make API call
    const response = await fetch('https://api.example.com/submit-preview', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${userFormData?.token}`,
      },
      body: JSON.stringify(payload),
    });

    if (!response.ok) {
      throw new Error('API request failed');
    }

    const responseData = await response.json();
    console.log('API Response:', responseData);

    // Proceed to next step
    setCurrentStep((prevStep) => prevStep + 1);
    toast.success('Preview generated successfully');
    
  } catch (error) {
    console.error('Preview API error:', error);
    toast.error('Failed to generate preview');
  } finally {
    setIsPreviewLoading(false);
  }
};
