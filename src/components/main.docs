.registrationCertificateContainer {
  background: white;
  border: 2px solid #2466BF;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 12px rgba(36, 102, 191, 0.15);
  margin-top: 1rem;
}

.certificateHeader {
  background: linear-gradient(135deg, #2466BF 0%, #1a4fa0 100%);
  padding: 1rem;
  text-align: center;
}

.certificateTitle {
  color: white;
  font-weight: 700;
  font-size: 1.3rem;
  margin: 0;
  letter-spacing: 1px;
}

.certificateBody {
  padding: 2rem;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
}

.expirySection, .issuedBySection {
  text-align: center;
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 6px;
  border: 1px solid #dee2e6;
  margin-bottom: 1rem;
}

.expiryLabel, .issuedLabel {
  font-weight: 600;
  color: #2466BF;
  font-size: 1rem;
}

.editableDate {
  border: 1px solid #2466BF;
  border-radius: 4px;
  padding: 0.25rem 0.5rem;
  font-size: 0.9rem;
  margin-left: 0.5rem;
  width: 120px;
}

.sectionTitle {
  color: #2466BF;
  font-weight: 700;
  font-size: 1.1rem;
  text-align: center;
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-bottom: 2px solid #2466BF;
  padding-bottom: 0.5rem;
}

.particularsTable {
  font-size: 0.8rem;
  margin-bottom: 0;
}

.labelCell {
  background: #2466BF;
  color: white;
  font-weight: 600;
  padding: 0.5rem;
  text-align: center;
  width: 12.5%;
  vertical-align: middle;
}

.valueCell {
  background: white;
  color: #333;
  font-weight: 600;
  padding: 0.5rem;
  text-align: center;
  width: 12.5%;
  vertical-align: middle;
}

.autoPopulateCell {
  background: #fbfdff!important;
  color: #072957!important;
  font-weight: 700;
  padding: 0.5rem;
  text-align: center;
  width: 12.5%;
  vertical-align: middle;
  font-style: italic;
}

.editableCell {
  background: #fff8dc;
  padding: 0.5rem;
  text-align: center;
  width: 12.5%;
  vertical-align: middle;
}

.editableCell input {
  border: 1px solid #dee2e6;
  border-radius: 3px;
  padding: 0.25rem;
  width: 100%;
  text-align: center;
  font-size: 0.75rem;
}

.surveyNote {
  background: #fff3cd;
  border: 1px solid #ffeaa7;
  padding: 1rem;
  border-radius: 6px;
  text-align: center;
}

.noteText {
  margin: 0;
  font-weight: 600;
  color: #856404;
}

.crewSection {
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 6px;
  border-left: 4px solid #2466BF;
}

.crewInfo {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.crewLabel {
  font-weight: 600;
  color: #666;
}

.crewValue {
  font-weight: 700;
  color: #2466BF;
  font-size: 1.1rem;
}

.autoPopulateTag {
  background: #28a745;
  color: white;
  font-size: 0.7rem;
  padding: 0.2rem 0.4rem;
  border-radius: 3px;
  margin-left: 0.5rem;
  font-weight: 600;
}

.certificationStatement {
  background: #f8f9fa;
  padding: 1.5rem;
  border-radius: 6px;
  border-left: 4px solid #2466BF;
}

.statementText {
  text-align: justify;
  line-height: 1.6;
  margin: 0;
  color: #333;
}

.ownerTable {
  font-size: 0.9rem;
}

.ownerHeader, .sharesHeader {
  background: #2466BF;
  color: white;
  text-align: center;
  font-weight: 600;
  padding: 0.75rem;
}

.ownerInfo {
  padding: 1rem;
  line-height: 1.6;
  background: #e8f4fd;
}

.ownerInfo div {
  margin-bottom: 0.5rem;
}

.sharesValue {
  text-align: center;
  font-weight: 700;
  color: #2466BF;
  font-size: 1.1rem;
  vertical-align: middle;
}

@media (max-width: 768px) {
  .certificateBody {
    padding: 1rem;
  }
  
  .particularsTable {
    font-size: 0.7rem;
  }
  
  .labelCell, .valueCell, .autoPopulateCell, .editableCell {
    padding: 0.25rem;
  }
  
  .crewInfo {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
}
