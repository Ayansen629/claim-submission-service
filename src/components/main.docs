import React, { useState, useEffect } from "react";
import { Row, Col, Form, Button, Pagination, InputGroup } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile.tsx";
import InputText from "../../../common/InputText.tsx";
import { renameFile } from "../../../../utils/constants.ts";
import { BsDownload, BsSearch } from "react-icons/bs";

const Documents = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  const [workOrderFiles, setWorkOrderFiles] = useState([{ id: 1 }]);
  const [drawingsFiles, setDrawingsFiles] = useState([{ id: 1 }]);
  
  // Pagination and search states
  const [workOrderPage, setWorkOrderPage] = useState(1);
  const [drawingsPage, setDrawingsPage] = useState(1);
  const [workOrderSearch, setWorkOrderSearch] = useState("");
  const [drawingsSearch, setDrawingsSearch] = useState("");
  const itemsPerPage = 5;
  
  const {
    register,
    watch,
    setValue,
    clearErrors,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");

  useEffect(() => {
    if (viewMode) {
      const workOrderIds = [];
      const drawingIds = [];
      
      for (let i = 1; i <= 1000; i++) {
        if (watch(`workOrder_file_${i}`)) {
          workOrderIds.push({ id: i });
        }
        if (watch(`drawings_file_${i}`)) {
          drawingIds.push({ id: i });
        }
      }
      
      if (workOrderIds.length > 0) setWorkOrderFiles(workOrderIds);
      if (drawingIds.length > 0) setDrawingsFiles(drawingIds);
    }
  }, [viewMode, watch]);

  const getFilteredFiles = (files, searchTerm, type) => {
    return files.filter(file => {
      const fileName = watch(`${type}_file_${file.id}`)?.name || "";
      const description = watch(`${type}_desc_${file.id}`) || "";
      return fileName.toLowerCase().includes(searchTerm.toLowerCase()) ||
             description.toLowerCase().includes(searchTerm.toLowerCase());
    });
  };

  const getPaginatedFiles = (files, page) => {
    const startIndex = (page - 1) * itemsPerPage;
    return files.slice(startIndex, startIndex + itemsPerPage);
  };

  const DocumentViewCard = ({ fileName, description, onDownload }) => (
    <div className="mb-2 p-2 border rounded" style={{ backgroundColor: "white" }}>
      <div className="d-flex justify-content-between align-items-center">
        <div className="flex-grow-1 me-2">
          <div className="fw-bold text-primary" style={{ fontSize: "0.85rem" }}>
            {fileName}
          </div>
          <div className="text-muted" style={{ fontSize: "0.75rem" }}>
            {description}
          </div>
        </div>
        <Button
          variant="outline-primary"
          size="sm"
          onClick={() => onDownload(fileName)}
          style={{ padding: "0.25rem 0.5rem" }}
        >
          <BsDownload size={14} />
        </Button>
      </div>
    </div>
  );

  const FileSection = ({ title, files, searchTerm, setSearchTerm, page, setPage, type }) => {
    const filteredFiles = getFilteredFiles(files, searchTerm, type);
    const paginatedFiles = getPaginatedFiles(filteredFiles, page);
    const totalPages = Math.ceil(filteredFiles.length / itemsPerPage);

    return (
      <div className="border rounded p-3" style={{ backgroundColor: "#f8f9fa" }}>
        <div className="d-flex justify-content-between align-items-center mb-3">
          <h6 className="mb-0 fw-bold text-primary">{title}</h6>
          <span className="badge bg-secondary">{filteredFiles.length} files</span>
        </div>
        
        {viewMode && filteredFiles.length > 5 && (
          <InputGroup className="mb-3" size="sm">
            <InputGroup.Text><BsSearch /></InputGroup.Text>
            <Form.Control
              placeholder={`Search ${title.toLowerCase()}...`}
              value={searchTerm}
              onChange={(e) => {
                setSearchTerm(e.target.value);
                setPage(1);
              }}
            />
          </InputGroup>
        )}

        <div style={{ maxHeight: "400px", overflowY: "auto" }}>
          {paginatedFiles.map((fileInput, idx) => {
            const fileData = watch(`${type}_file_${fileInput.id}`);
            const descData = watch(`${type}_desc_${fileInput.id}`);
            
            if (viewMode) {
              if (fileData && fileData.name) {
                return (
                  <DocumentViewCard
                    key={fileInput.id}
                    fileName={fileData.name}
                    description={descData || `${title} document ${fileInput.id}`}
                    onDownload={() => handleDownload(fileData.name)}
                  />
                );
              }
              return null;
            }
            
            return (
              <div key={fileInput.id} className="mb-3 p-2 border rounded" style={{ backgroundColor: "white" }}>
                <div className="mb-2">
                  <InputFile
                    label={`${t("Choose File")} ${(page - 1) * itemsPerPage + idx + 1}`}
                    name={`${type}_file_${fileInput.id}`}
                    register={register(`${type}_file_${fileInput.id}`)}
                    errors={errors}
                    onChange={(e) => {
                      if (e.target.files && e?.target?.files[0]) {
                        const file = e.target.files[0];
                        
                        if (file.size > 10 * 1024 * 1024) {
                          setError(`${type}_file_${fileInput.id}`, {
                            type: 'manual',
                            message: t('File size should not exceed 10MB')
                          });
                          return;
                        }
                        
                        const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                        const fileName = `${title}${extension}`;
                        file.originalName = fileName;
                        const renamedFile = renameFile(file, fileName);

                        clearErrors(`${type}_file_${fileInput.id}`);
                        setValue(`${type}_file_${fileInput.id}`, renamedFile, { shouldValidate: true });
                        setFormData((prev) => ({
                          ...prev,
                          [`${type}_file_${fileInput.id}`]: renamedFile
                        }));
                      }
                    }}
                    watch={watch}
                    defaultValue={watch(`${type}_file_${fileInput.id}`)}
                    clearErrors={clearErrors}
                  />
                </div>
                <div className="mb-2">
                  <InputText
                    label={t("Description")}
                    name={`${type}_desc_${fileInput.id}`}
                    placeholder={t("Enter file description")}
                    register={register(`${type}_desc_${fileInput.id}`)}
                    errors={errors}
                    onChange={() => clearErrors(`${type}_desc_${fileInput.id}`)}
                  />
                </div>
                {files.length > 1 && (
                  <div className="text-end">
                    <Button
                      variant="outline-danger"
                      size="sm"
                      onClick={() => removeFileInput(type, fileInput.id)}
                    >
                      Remove
                    </Button>
                  </div>
                )}
              </div>
            );
          })}
        </div>

        {totalPages > 1 && (
          <div className="d-flex justify-content-center mt-3">
            <Pagination size="sm">
              <Pagination.Prev 
                disabled={page === 1}
                onClick={() => setPage(page - 1)}
              />
              {[...Array(Math.min(5, totalPages))].map((_, i) => {
                const pageNum = Math.max(1, Math.min(page - 2 + i, totalPages - 4 + i));
                return (
                  <Pagination.Item
                    key={pageNum}
                    active={pageNum === page}
                    onClick={() => setPage(pageNum)}
                  >
                    {pageNum}
                  </Pagination.Item>
                );
              })}
              <Pagination.Next 
                disabled={page === totalPages}
                onClick={() => setPage(page + 1)}
              />
            </Pagination>
          </div>
        )}

        {!viewMode && (
          <div className="text-center mt-3">
            <Button
              variant="primary"
              size="sm"
              onClick={() => addFileInput(type)}
              style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
            >
              + Add {title}
            </Button>
          </div>
        )}
      </div>
    );
  };

  const addFileInput = (type) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      const newId = workOrderFiles.length > 0 ? Math.max(...workOrderFiles.map(f => f.id)) + 1 : 1;
      setWorkOrderFiles([...workOrderFiles, { id: newId }]);
    } else if (type === 'drawings') {
      const newId = drawingsFiles.length > 0 ? Math.max(...drawingsFiles.map(f => f.id)) + 1 : 1;
      setDrawingsFiles([...drawingsFiles, { id: newId }]);
    }
  };

  const removeFileInput = (type, id) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      setWorkOrderFiles(workOrderFiles.filter(file => file.id !== id));
    } else if (type === 'drawings') {
      setDrawingsFiles(drawingsFiles.filter(file => file.id !== id));
    }
    setValue(`${type}_file_${id}`, null);
    setValue(`${type}_desc_${id}`, "");
    clearErrors([`${type}_file_${id}`, `${type}_desc_${id}`]);
  };

  const handleDownload = (fileName) => {
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
  };

  return (
    <div>
      <Collapsible title={t("Documents")} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <Row className="gy-4">
            <Col lg={6} md={12}>
              <FileSection
                title={t("Work Order")}
                files={workOrderFiles}
                searchTerm={workOrderSearch}
                setSearchTerm={setWorkOrderSearch}
                page={workOrderPage}
                setPage={setWorkOrderPage}
                type="workOrder"
              />
            </Col>

            <Col lg={6} md={12}>
              <FileSection
                title={t("Drawings")}
                files={drawingsFiles}
                searchTerm={drawingsSearch}
                setSearchTerm={setDrawingsSearch}
                page={drawingsPage}
                setPage={setDrawingsPage}
                type="drawings"
              />
            </Col>

            <Col md={6}>
              <InputFile
                label={t('Tonnage Booklets')}
                required={true}
                name="tonnageBooklets"
                register={register("tonnageBooklets")}
                errors={errors}
                onChange={(e) => {
                  if (e.target.files && e?.target?.files[0]) {
                    const file = e.target.files[0];
                    if (file.size > 10 * 1024 * 1024) {
                      setError("tonnageBooklets", {
                        type: 'manual',
                        message: t('File size should not exceed 10MB')
                      });
                      return;
                    }
                    const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                    const fileName = `Tonnage Booklets${extension}`;
                    file.originalName = fileName;
                    const renamedFile = renameFile(file, fileName);
                    clearErrors("tonnageBooklets");
                    setValue("tonnageBooklets", renamedFile, { shouldValidate: true });
                  }
                }}
                watch={watch}
                accept=".pdf,.jpg,.jpeg,.png"
                defaultValue={watch("tonnageBooklets")}
                clearErrors={clearErrors}
              />
            </Col>

            <Col md={6}>
              <InputFile
                label={t('Stability Booklets')}
                required={true}
                name="stabilityBooklets"
                register={register("stabilityBooklets")}
                errors={errors}
                onChange={(e) => {
                  if (e.target.files && e?.target?.files[0]) {
                    const file = e.target.files[0];
                    if (file.size > 10 * 1024 * 1024) {
                      setError("stabilityBooklets", {
                        type: 'manual',
                        message: t('File size should not exceed 10MB')
                      });
                      return;
                    }
                    const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                    const fileName = `Stability Booklets${extension}`;
                    file.originalName = fileName;
                    const renamedFile = renameFile(file, fileName);
                    clearErrors("stabilityBooklets");
                    setValue("stabilityBooklets", renamedFile, { shouldValidate: true });
                  }
                }}
                watch={watch}
                accept=".pdf,.jpg,.jpeg,.png"
                defaultValue={watch("stabilityBooklets")}
                clearErrors={clearErrors}
              />
            </Col>

            <Col md={12}>
              <div className="mb-3">
                <div className="d-flex align-items-start">
                  <input
                    type="checkbox"
                    id="termsAccepted"
                    className="me-2 mt-1"
                    {...register("termsAccepted", { required: t('You must accept the terms and conditions') })}
                    disabled={viewMode}
                    checked={viewMode ? watch("termsAccepted") : undefined}
                  />
                  <div>
                    <label
                      htmlFor="termsAccepted"
                      className="mb-0"
                      style={{ fontWeight: 500, color: "#333", cursor: viewMode ? "default" : "pointer" }}
                    >
                      {t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.')}
                    </label>
                    {errors.termsAccepted && !viewMode && (
                      <div className="text-danger small mt-1">
                        {errors.termsAccepted.message}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </Col>
          </Row>
        </div>
      </Collapsible>
    </div>
  );
};

export default Documents;
