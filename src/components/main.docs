import React, { useState, useContext, useEffect } from "react";
import { useForm } from "react-hook-form";
import { useNavigate } from "react-router-dom";
import { toast } from "react-toastify";
import FormInputRenderer from "../../common/FormInputRenderer";
import { UserContext } from "../../components/context/UserContext.js";
import "./Login.css";

const LoginPage = () => {
  const {
    register,
    handleSubmit,
    watch,
    formState: { errors },
    setValue,
    reset,
  } = useForm();
  const navigate = useNavigate();
  const { setUserData } = useContext(UserContext);

  const [otpSent, setOtpSent] = useState(false);
  const [otpVerified, setOtpVerified] = useState(false);
  const [otp, setOtp] = useState("");
  const [loading, setLoading] = useState(false);
  const [selectedRadio, setSelectedRadio] = useState("corporateDebtor");

  const username = watch("username");
  const email = watch("email");
  const password = watch("password");
  const userType = watch("userType");
  const financialCreditorType = watch("financialCreditorType");
  const operationalCreditorType = watch("operationalCreditorType");
  const processType = watch("processType");
  const corporateDebtorName = watch("corporateDebtorName");

  useEffect(() => {
    reset({
      username: "",
      email: "",
      password: "",
      userType: "",
      financialCreditorType: "",
      operationalCreditorType: "",
      processType: "",
      corporateDebtorName: "",
    });
    setOtpSent(false);
    setOtp("");
  }, [selectedRadio, reset]);

  const isValidUsername = (username) => {
    const mobileRegex = /^[6-9]\d{9}$/;
    return mobileRegex.test(username);
  };

  const isValidEmail = (email) => {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return emailRegex.test(email);
  };

  const isClaimantsFormValid = () => {
    if (selectedRadio === "claimants") {
      if (!isValidUsername(username) || !userType || !processType || !corporateDebtorName) return false;

      if (userType === "Financial Creditors" && !financialCreditorType) return false;
      if (userType === "Operational Creditors" && !operationalCreditorType) return false;

      return true;
    }
    return false;
  };

  const isCorporateDebtorFormValid = () => {
    if (selectedRadio === "corporateDebtor") {
      return (
        isValidEmail(email) && 
        password?.length >= 6 && 
        watch("termsAccepted")
      );
    }
    return false;
  };

  const handleSendOTP = async () => {
    if (selectedRadio === "claimants" && isClaimantsFormValid()) {
      setLoading(true);

      setTimeout(() => {
        const payload = {
          userType: "CLM",
          userId: username,
          processType: processType,
          corporateDebtorName: corporateDebtorName,
          claimantType: userType || "",
          claimantCategoryType:
            userType === "Financial Creditors"
              ? financialCreditorType
              : userType === "Operational Creditors"
              ? operationalCreditorType
              : "",
          otp: "123456",
        };

        console.log("Payload for Send OTP:", payload);
        toast.success("OTP Sent", { position: "top-right" });
        setOtpSent(true);
        setLoading(false);
      }, 1000);
    } else {
      toast.error("Please provide valid details.");
    }
  };

  const handleVerifyOTP = async (data) => {
    if (!otp) {
      toast.error("Please enter your OTP first.", { position: "top-right" });
      return;
    }
    if (!data.termsAccepted) {
      toast.info("Please accept the terms and conditions.", {
        position: "top-right",
      });
      return;
    }
  
    setLoading(true);
  
    setTimeout(() => {
      if (otp === "123456") {
        const payload = {
          userType: "CLM",
          userId: username,
          processType: processType,
          corporateDebtorName: corporateDebtorName,
          claimantType: userType || "",
          claimantCategoryType:
            userType === "Financial Creditors"
              ? financialCreditorType
              : userType === "Operational Creditors"
              ? operationalCreditorType
              : "",
        };
  
        setUserData(payload);
        localStorage.setItem("userFormData", JSON.stringify(payload));
        toast.success("OTP Verified Successfully", { position: "top-right" });
        navigate("/dashboard");
      } else {
        toast.error("Failed to verify OTP. Please try again.", {
          position: "top-right",
        });
      }
      setLoading(false);
    }, 1000);
  };

  const handleCorporateDebtorLogin = async (data) => {
    setLoading(true);
    
    setTimeout(() => {
      const payload = {
        userType: "CD",
        email: data.email,
      };

      setUserData(payload);
      localStorage.setItem("userFormData", JSON.stringify(payload));
      toast.success("Login Successful", { position: "top-right" });
      navigate("/dashboard");
      setLoading(false);
    }, 1000);
  };

  const processTypeOptions = [
    { value: "CIRP", label: "Corporate Insolvency Resolution Process (CIRP)" },
    { value: "Liquidation", label: "Liquidation" },
    { value: "Voluntary Liquidation", label: "Voluntary Liquidation" },
    { value: "PPIRP", label: "Pre-packaged Insolvency Resolution Process (PPIRP)" },
  ];

  const corporateDebtorOptions = [
    { value: "Jalpower Corporation Limited", label: "Jalpower Corporation Limited" },
    { value: "Neesa Leisure Limited", label: "Neesa Leisure Limited" },
    { value: "Empathy Infra and Engineering Private Limited", label: "Empathy Infra and Engineering Private Limited" },
    { value: "Simpa Energy India Private Limited", label: "Simpa Energy India Private Limited" },
    { value: "Eicher Polaris Private Limited", label: "Eicher Polaris Private Limited" },
  ];

  const claimantsOptions = [
    { value: "Financial Creditors", label: "Financial Creditors" },
    { value: "Operational Creditors", label: "Operational Creditors" },
    { value: "Employees and Workmen", label: "Employees and Workmen" },
    {
      value: "Employees and Workmen – Through Authorised Representative",
      label: "Employees and Workmen – Through Authorised Representative",
    },
    {
      value: "Other Creditors (other than financial and operational creditors)",
      label: "Other Creditors (other than financial and operational creditors)",
    },
  ];

  const financialCreditorOptions = [
    {
      value: "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)",
      label: "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)",
    },
    {
      value: "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)",
      label: "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)",
    },
    {
      value: "Unsecured Financial Creditors in Class of Creditors (Homebuyers)",
      label: "Unsecured Financial Creditors in Class of Creditors (Homebuyers)",
    },
    {
      value: "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)",
      label: "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)",
    },
  ];

  const operationalCreditorOptions = [
    {
      value: "Operational Creditors – (Other than Govt Authorities)",
      label: "Operational Creditors – (Other than Govt Authorities)",
    },
    {
      value: "Operational Creditors – Govt Authorities",
      label: "Operational Creditors – Govt Authorities",
    },
  ];

  const ClaimantsInputFields = [
    {
      type: "text",
      name: "username",
      label: "Mobile Number",
      placeholder: "Enter your 10-digit mobile number",
      validation: {
        required: "Mobile number is required",
        pattern: {
          value: /^[6-9]\d{9}$/,
          message: "Please enter a valid 10-digit mobile number"
        }
      }
    },
    {
      type: "dropdown",
      name: "processType",
      label: "Process Type",
      options: processTypeOptions,
      validation: { required: "Process type is required" }
    },
    {
      type: "dropdown",
      name: "corporateDebtorName",
      label: "Corporate Debtor Name",
      options: corporateDebtorOptions,
      validation: { required: "Corporate Debtor name is required" }
    },
    {
      type: "dropdown",
      name: "userType",
      label: "Claimant Type",
      options: claimantsOptions,
      validation: { required: "Claimant type is required" }
    },
  ];

  const CorporateDebtorInputFields = [
    {
      type: "text",
      name: "email",
      label: "Email ID",
      placeholder: "Enter your email address",
      validation: {
        required: "Email is required",
        pattern: {
          value: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
          message: "Please enter a valid email address"
        }
      }
    },
    {
      type: "password",
      name: "password",
      label: "Password",
      placeholder: "Enter your password (min 6 characters)",
      validation: {
        required: "Password is required",
        minLength: {
          value: 6,
          message: "Password must be at least 6 characters"
        }
      }
    },
  ];

  return (
    <div className="login-page">
      <div className="login-container">
        <div className="Login-header">
          <div className="login-text">LOG IN</div>
        </div>
        <div className="radio-options">
          <div className="radio-op">
            <input
              type="radio"
              id="corporateDebtor"
              name="radioGroup"
              value="corporateDebtor"
              checked={selectedRadio === "corporateDebtor"}
              onChange={() => setSelectedRadio("corporateDebtor")}
            />
            <label htmlFor="corporateDebtor">Corporate Debtor</label>
          </div>
          <div className="radio-op">
            <input
              type="radio"
              id="claimants"
              name="radioGroup"
              value="claimants"
              checked={selectedRadio === "claimants"}
              onChange={() => setSelectedRadio("claimants")}
            />
            <label htmlFor="claimants">Claimants</label>
          </div>
        </div>
        <div className="login-form">
          {selectedRadio === "claimants" ? (
            <form onSubmit={handleSubmit(handleVerifyOTP)}>
              {ClaimantsInputFields.map((field) => (
                <div key={field.name}>
                  <FormInputRenderer
                    field={field}
                    register={register}
                    errors={errors}
                    watch={watch}
                    setValue={setValue}
                  />
                  {errors[field.name] && (
                    <p className="error-message">{errors[field.name].message}</p>
                  )}
                </div>
              ))}

              {userType === "Financial Creditors" && (
                <div className="dropdown-container">
                  <select
                    className="dropdown-select"
                    {...register("financialCreditorType", { 
                      required: "Financial creditor type is required" 
                    })}
                  >
                    <option value="">Select Financial Creditor Type</option>
                    {financialCreditorOptions.map((option) => (
                      <option key={option.value} value={option.value}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                  {errors.financialCreditorType && (
                    <p className="error-message">{errors.financialCreditorType.message}</p>
                  )}
                </div>
              )}

              {userType === "Operational Creditors" && (
                <div className="dropdown-container">
                  <select
                    className="dropdown-select"
                    {...register("operationalCreditorType", { 
                      required: "Operational creditor type is required" 
                    })}
                  >
                    <option value="">Select Operational Creditor Type</option>
                    {operationalCreditorOptions.map((option) => (
                      <option key={option.value} value={option.value}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                  {errors.operationalCreditorType && (
                    <p className="error-message">{errors.operationalCreditorType.message}</p>
                  )}
                </div>
              )}

              {!otpSent ? (
                <button
                  type="button"
                  className={`send-otp-btn ${
                    isClaimantsFormValid() ? "" : "disabled"
                  }`}
                  onClick={handleSendOTP}
                  disabled={!isClaimantsFormValid()}
                >
                  Send OTP
                </button>
              ) : (
                <div className="otp-verification">
                  <input
                    type="password"
                    placeholder="Enter OTP here..."
                    value={otp}
                    onChange={(e) => setOtp(e.target.value)}
                  />
                </div>
              )}

              <div className="login-footer">
                <div className="terms-conditions">
                  <input
                    type="checkbox"
                    id="termsAccepted"
                    {...register("termsAccepted", {
                      required: "You must accept the terms",
                    })}
                  />
                  <label htmlFor="termsAccepted">
                    I accept the{" "}
                    <a href="/terms-and-conditions">Terms & Conditions</a>
                  </label>
                  {errors.termsAccepted && (
                    <p className="error-message">{errors.termsAccepted.message}</p>
                  )}
                </div>
                <button
                  type="submit"
                  className="login-btn"
                  disabled={!otpSent || !otp || loading || !watch("termsAccepted")}
                >
                  {loading ? "Logging in..." : "Verify OTP & Login"}
                </button>
                <div className="register-text" onClick={() => navigate("/register")}>
                  Don't have an account? <span className="register-link">Register here</span>
                </div>
              </div>
            </form>
          ) : (
            <form onSubmit={handleSubmit(handleCorporateDebtorLogin)}>
              {CorporateDebtorInputFields.map((field) => (
                <div key={field.name}>
                  <FormInputRenderer
                    field={field}
                    register={register}
                    errors={errors}
                    watch={watch}
                    setValue={setValue}
                  />
                  {errors[field.name] && (
                    <p className="error-message">{errors[field.name].message}</p>
                  )}
                </div>
              ))}

              <div className="login-footer">
                <div className="terms-conditions">
                  <input
                    type="checkbox"
                    id="termsAccepted"
                    {...register("termsAccepted", {
                      required: "You must accept the terms",
                    })}
                  />
                  <label htmlFor="termsAccepted">
                    I accept the{" "}
                    <a href="/terms-and-conditions">Terms & Conditions</a>
                  </label>
                  {errors.termsAccepted && (
                    <p className="error-message">{errors.termsAccepted.message}</p>
                  )}
                </div>
                <button
                  type="submit"
                  className="login-btn"
                  disabled={!isCorporateDebtorFormValid() || loading}
                >
                  {loading ? "Logging in..." : "Login"}
                </button>
                <div className="register-text" onClick={() => navigate("/register")}>
                  Don't have an account? <span className="register-link">Register here</span>
                </div>
              </div>
            </form>
          )}
        </div>
      </div>
    </div>
  );
};

export default LoginPage;
