                label={t("Propeller Type")}
                name="detailsOfPropulsion.propellerType"
                options={[
                  {
                    value: "",
                    label: "-- Select --",
                  },
                  ...(masterData?.propellerTypes?.map((type) => ({
                    value: type.valueCode,
                    label: type.valueLabel,
                  })) || []),
                ]}
                register={register("detailsOfPropulsion.propellerType")}
                errors={errors}
                value={watch("detailsOfPropulsion.propellerType") || ""}
                onChange={(value) =>
                  !viewMode &&
                  handleSelectChange("detailsOfPropulsion.propellerType", value)
                }
