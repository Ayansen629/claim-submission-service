import React, { useState, useEffect } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Button, Card, Image } from 'react-bootstrap';
import {
  FaBuilding, FaFileUpload, FaCheck, FaArrowRight,
  FaArrowLeft, FaPrint, FaDownload
} from 'react-icons/fa';
import './UserRegistration.css';
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";
import NewLoader from '../../common/NewLoader.js';
import DynamicFormFields from '../../common/DynamicFormFields';
import createFormFieldsConfig from '../../common/FormFieldsConfig';
import { useLocation, useNavigate } from 'react-router-dom';

const OfficerViewPage = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(true);
  const location = useLocation();
  const navigate = useNavigate();
  const totalSteps = 2;

  // Mock data - in real app this would come from API based on application ID
  const mockApplicationData = {
    firstName: "John",
    lastName: "Doe",
    emailId: "john.doe@example.com",
    phoneNumber: "9876543210",
    panNumber: "ABCDE1234F",
    gstNumber: "22ABCDE1234F1Z5",
    addressLine1: "123 Main Street",
    addressLine2: "Building A",
    pin: "700001",
    district: "Kolkata",
    stateUt: "West Bengal",
    country: "India",
    addressProof: "address_proof.pdf",
    panCardUpload: "pan_card.pdf",
    gstCertificate: "gst_certificate.pdf"
  };

  useEffect(() => {
    // Simulate API call to fetch application data
    const fetchApplicationData = () => {
      setTimeout(() => {
        setFormData(mockApplicationData);
        setIsLoading(false);
      }, 1000);
    };

    fetchApplicationData();
  }, []);

  const methods = useForm({
    mode: 'onBlur',
    defaultValues: { country: 'India' }
  });

  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading) {
      Object.keys(formData).forEach(key => {
        if (formData[key]) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }
  }, [isLoading, formData, setValue]);

  // Modified form config to make all fields disabled
  const getDisabledFormFieldsConfig = () => {
    const originalConfig = createFormFieldsConfig(() => {});
    
    // Make all fields disabled
    const disabledStep1 = originalConfig.step1.map(field => ({
      ...field,
      disabled: true
    }));
    
    const disabledStep2 = originalConfig.step2.map(field => ({
      ...field,
      disabled: true,
      // For file fields, we'll show the filename instead of file input
      render: (value) => (
        <div className="file-display">
          <span>{value || 'No file uploaded'}</span>
          {value && (
            <Button variant="link" size="sm" onClick={() => handleDownload(value)}>
              <FaDownload /> Download
            </Button>
          )}
        </div>
      )
    }));
    
    return {
      step1: disabledStep1,
      step2: disabledStep2
    };
  };

  const formFields = getDisabledFormFieldsConfig();

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      default: return [];
    }
  };

  const handleNext = () => {
    if (currentStep < totalSteps) {
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const handleDownload = (filename) => {
    // In real app, this would download the actual file from server
    console.log(`Downloading ${filename}`);
    alert(`Downloading ${filename}`);
  };

  const handlePrint = () => {
    window.print();
  };

  const handleBackToList = () => {
    navigate('/officerRoleDashboard');
  };

  const stepTitles = [
    { title: "Vessel Builder Details", icon: FaBuilding },
    { title: "Documents", icon: FaFileUpload }
  ];

  if (isLoading) {
    return <NewLoader show={true} />;
  }

  return (
    <Container fluid className="registration-container py-5">
      <Row className="justify-content-center">
        <Col md={10} xl={9}>
          <Card className="registration-card">
            <Card.Header className="registration-header p-0">
              <div className="registration-header-content">
                <div className="header-logo-container">
                  <Image
                    src={IWT_FULL_IMG}
                    alt="IWT Logo"
                    className="header-logo"
                  />
                </div>
                <h3 className="header-title">
                  Application Details (View Mode)
                </h3>
              </div>
            </Card.Header>

            <Card.Body className="registration-body p-4 p-md-5">
              <FormProvider {...methods}>
                <form>
                  <div className="d-flex justify-content-between mb-4">
                    <div>
                      <h5>Application No: APP-2025-001</h5>
                      <p className="text-muted">Status: <span className="badge bg-success">Approved</span></p>
                    </div>
                    <div>
                      <Button variant="outline-primary" onClick={handlePrint} className="me-2">
                        <FaPrint className="me-2" /> Print
                      </Button>
                      <Button variant="outline-secondary" onClick={handleBackToList}>
                        Back to List
                      </Button>
                    </div>
                  </div>

                  <div className="stepper-container mb-5">
                    <div className="stepper d-flex justify-content-between">
                      {[1, 2].map((step) => (
                        <React.Fragment key={step}>
                          <div className={`step ${currentStep >= step ? 'active' : ''} ${currentStep > step ? 'completed' : ''} flex-grow-1 text-center`}>
                            <div
                              className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2"
                              style={{
                                width: '60px',
                                height: '60px',
                                borderRadius: '50%',
                                fontSize: '20px',
                                fontWeight: 'bold',
                                boxShadow: currentStep >= step ? '0 5px 15px rgba(0, 119, 182, 0.3)' : '0 4px 10px rgba(0, 0, 0, 0.1)',
                                background: currentStep >= step ?
                                  (currentStep > step ? 'linear-gradient(135deg, #28a745, #20c997)' : 'linear-gradient(135deg, #0077b6, #023e8a)') :
                                  '#ffffff',
                                border: currentStep >= step ? 'none' : '2px solid #e9ecef',
                                color: currentStep >= step ? '#fff' : '#6c757d',
                                transition: 'all 0.4s ease'
                              }}>
                              {currentStep > step ? <FaCheck size={22} /> : React.createElement(stepTitles[step - 1].icon, { size: 18 })}
                            </div>
                            <div className="step-label fw-bold"
                              style={{
                                color: currentStep >= step ? (currentStep > step ? '#28a745' : '#0077b6') : '#6c757d',
                                fontSize: '0.9em',
                                transition: 'all 0.3s ease'
                              }}>
                              {stepTitles[step - 1].title}
                            </div>
                          </div>
                          {step < 2 && (
                            <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                              <div className={`connector-line w-100 ${currentStep > step ? 'active' : ''}`}
                                style={{
                                  height: '4px',
                                  background: currentStep > step ? 'linear-gradient(to right, #28a745, #20c997)' : '#e9ecef',
                                  borderRadius: '2px',
                                  transition: 'all 0.5s ease'
                                }}></div>
                            </div>
                          )}
                        </React.Fragment>
                      ))}
                    </div>
                  </div>

                  <div className="step-content">
                    <div className="form-section p-4 rounded mb-4">
                      <div className="form-content">
                        <DynamicFormFields 
                          fields={getCurrentStepFields()} 
                          setFormData={setFormData} 
                        />
                      </div>
                    </div>
                  </div>

                  <div className="form-navigation mt-4" style={{ display: 'block' }}>
                    {currentStep > 1 &&
                      <Button
                        variant="outline-secondary"
                        onClick={handlePrevious}
                        className="prev-btn"
                        style={{ 'float': 'left' }}
                      >
                        <FaArrowLeft className="btn-icon me-2" /> Previous
                      </Button>
                    }

                    {currentStep < totalSteps && (
                      <Button
                        variant="primary"
                        onClick={handleNext}
                        className="next-btn"
                        style={{ 'float': 'right' }}
                      >
                        Next
                        <FaArrowRight className="btn-icon ms-2" />
                      </Button>
                    )}
                  </div>
                </form>
              </FormProvider>
            </Card.Body>
          </Card>
        </Col>
      </Row>
    </Container>
  );
};

export default OfficerViewPage;
