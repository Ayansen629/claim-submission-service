.custom-sidebar {
  background-color: #f4f8fc;
  color: #2466bf;
  height: calc(100vh - 60px);
  transition: width 0.3s ease;
  overflow: hidden;
  padding-top: 0;
  box-shadow: 2px 0 10px rgba(0, 0, 0, 0.08);
  border-right: 1px solid #e1eaf5;
  position: fixed;
  top: 75px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.custom-sidebar.collapsed {
  width: 60px;
}

.custom-sidebar.expanded {
  width: 17rem;
}

.custom-sidebar-menu,
.custom-sidebar-submenu-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.custom-sidebar-item {
  transition: background 0.3s ease;
}

.custom-sidebar-item.active > .custom-sidebar-link {
  background-color: #d6e6f9;
  font-weight: 600;
}

/* Link inside main menu */
.custom-sidebar-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 18px;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.3s ease;
  border-radius: 0 20px 20px 0;
}

.custom-sidebar-link:hover {
  background-color: #e8f1fc;
}

.custom-sidebar-link-content {
  display: flex;
  align-items: center;
}

.custom-sidebar-icon {
  margin-right: 12px;
  font-size: 1.1rem;
}

/* Chevron icon */
.custom-sidebar-chevron {
  margin-left: auto;
  transition: transform 0.3s ease;
}

.custom-sidebar-chevron.rotate {
  transform: rotate(90deg);
}

.custom-sidebar-submenu {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transform: translateY(-5px);
  transition: max-height 0.35s ease, opacity 0.35s ease, transform 0.35s ease;
}

.custom-sidebar-submenu.expanded {
  max-height: 500px;
  opacity: 1;
  transform: translateY(0);
}

.custom-sidebar-submenu.expanded::-webkit-scrollbar {
  display: none;
}

/* Submenu list */
.custom-sidebar-submenu-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

/* Submenu link */
.custom-sidebar-sublink {
  margin: 5px 5px 0 5px;
  display: block;
  padding: 10px 35px;
  color: #2466bf;
  text-decoration: none;
  font-size: 0.85rem;
  border-radius: 0 20px 20px 0;
  transition: background 0.3s ease, color 0.3s ease;
}

.custom-sidebar-sublink:hover {
  background-color: #e1ecfb;
  color: #1d4f9b;
}

.custom-sidebar-sublink.active {
  background-color: #d6e6f9;
  color: #1d4f9b;
}

/* Mobile backdrop (optional if using overlay) */
.custom-sidebar-backdrop {
  position: fixed;
  inset: 0;
  z-index: 999;
}

/* Close button */
.custom-sidebar-close {
  display: none;
  justify-content: flex-end;
  padding: 0.75rem 1rem;
}

.custom-sidebar-close svg {
  cursor: pointer;
  font-size: 1.25rem;
  color: #2466bf;
}

/* Mobile behavior */
@media (max-width: 768px) {
  .custom-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 250px;
    z-index: 1000;
    transition: transform 0.3s ease;
    background-color: #f4f8fc;
  }

  .custom-sidebar.collapsed {
    transform: translateX(-100%);
  }

  .custom-sidebar.expanded {
    transform: translateX(0);
  }

  .custom-sidebar-close {
    display: flex;
  }

  .custom-sidebar-menu {
    padding-bottom: 2rem;
  }
}


.custom-sidebar-menu {
  list-style: none;
  padding: 0;
  margin: 0;
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
}

.custom-sidebar-menu::-webkit-scrollbar {
  width: 6px;
}
.custom-sidebar-menu::-webkit-scrollbar-thumb {
  background-color: rgba(36, 102, 191, 0.3);
  border-radius: 4px;
}

.custom-sidebar-submenu {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transform: translateY(-5px);
  transition: max-height 0.35s ease, opacity 0.35s ease, transform 0.35s ease;
}

.custom-sidebar-submenu.expanded {
  max-height: 500px;
  opacity: 1;
  transform: translateY(0);
  overflow-y: auto;
}

.custom-sidebar-submenu.expanded::-webkit-scrollbar {
  width: 6px;
}
.custom-sidebar-submenu.expanded::-webkit-scrollbar-thumb {
  background-color: rgba(36, 102, 191, 0.25);
  border-radius: 4px;
}

.custom-sidebar.collapsed .custom-sidebar-menu {
  overflow: hidden;
}

