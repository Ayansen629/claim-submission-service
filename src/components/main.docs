/* Dropdown toggle button */
.dropdownToggle {
  background: transparent;
  border: none;
  color: #6c757d;
  padding: 4px 8px;
  border-radius: 4px;
  transition: all 0.2s ease;
}

.dropdownToggle:hover {
  background-color: #f8f9fa;
  color: #0d6efd;
}

.dropdownToggle:focus {
  box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
}

/* Dropdown menu */
.dropdownMenu {
  border: none;
  border-radius: 8px;
  padding: 8px 0;
  min-width: 220px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Dropdown items */
.dropdownItem {
  display: flex;
  align-items: center;
  padding: 10px 16px;
  font-size: 14px;
  color: #212529;
  transition: all 0.2s ease;
  cursor: pointer;
}

.dropdownItem:hover {
  background: linear-gradient(135deg, #0d6efd, #0a58ca);
  color: white;
}

.dropdownIcon {
  margin-right: 12px;
  width: 16px;
  height: 16px;
  transition: all 0.2s ease;
}

.dropdownItem:hover .dropdownIcon {
  color: white;
  transform: scale(1.1);
}

/* Special styling for delete item */
.deleteItem:hover {
  background: linear-gradient(135deg, #dc3545, #bd2130);
}
