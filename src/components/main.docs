const formatRawData = (rawData) => {
  if (!rawData) return null;

  // Format identification type details
  const identificationDetails = rawData.creditorBasicDetails?.identificationTypeDetails?.identifications?.map((item, index) => ({
    id: index + 1,
    details: item.identificationRecord || "",
    proof: {
      fileId: item.proofOfIdentificationDocuments?.docId || "",
      fileName: item.proofOfIdentificationDocuments?.docName || "",
      fileType: "application/pdf" // Default, adjust if needed
    }
  }));

  // Format entity data (guarantors, principal borrowers, beneficiaries)
  const guarantors = (rawData.claimDetails?.guarantorDetails || []).map((item, index) => ({
    id: index + 1,
    name: item.name || "",
    address: item.address || "",
    type: "GUARANTOR"
  }));

  const principalBorrowers = (rawData.claimDetails?.principalBorrowerDetails || []).map((item, index) => ({
    id: index + 1,
    name: item.name || "",
    address: item.address || "",
    type: "PRINCIPAL_BORROWER"
  }));

  const beneficiaries = (rawData.claimDetails?.beneficiaryDetails || []).map((item, index) => ({
    id: index + 1,
    name: item.name || "",
    address: item.address || "",
    type: "BENEFICIARY"
  }));

  // Combine all entities
  const allEntities = [...guarantors, ...principalBorrowers, ...beneficiaries];

  console.log("Processed entities:", allEntities); // Debug log

  return {
    step1: {
      corporateDebtorName: rawData.creditorBasicDetails?.financialDebtorName || "",
      identificationType: rawData.creditorBasicDetails?.identificationTypeDetails?.identificationType || "",
      financialCreditorName: rawData.creditorBasicDetails?.financialCreditorName || "",
      financialCreditorEmail: rawData.creditorBasicDetails?.financialCreditorEmail || "",
      addressLine1: rawData.creditorBasicDetails?.addressDetails?.addressLine1 || "",
      addressLine2: rawData.creditorBasicDetails?.addressDetails?.addressLine2 || "",
      city: rawData.creditorBasicDetails?.addressDetails?.city || "",
      state: rawData.creditorBasicDetails?.addressDetails?.state || "",
      pincode: rawData.creditorBasicDetails?.addressDetails?.pincode || "",
      identificationtype_details: identificationDetails || []
    },
    step2: {
      claimType: rawData.claimDetails?.claimType || "",
      claimAmount: rawData.claimDetails?.claimAmount?.toString() || "",
      hasSecurityInterest: rawData.claimDetails?.isAmountOfClaimCoverdBySecurityInterest ? "yes" : "no",
      hasGuarantee: rawData.claimDetails?.isAmountOfClaimCoverdByGuarantee ? "yes" : "no",
      securityValue: rawData.claimDetails?.securityValue?.toString() || "",
      securityDate: rawData.claimDetails?.securityDate || "",
      guaranteeValue: rawData.claimDetails?.guaranteeValue?.toString() || "",
      guaranteeDate: rawData.claimDetails?.guaranteeDate || "",
      debtDetails: rawData.claimDetails?.debtIncurredDetails || "",
      debtDate: rawData.claimDetails?.debtIncurredDate || "",
      mutualDetails: rawData.claimDetails?.mutualDealingDetailsAgainstTheClaim || "",
      accountNumber: rawData.claimDetails?.bankAccountDetails?.bankAccountNumber || "",
      bankName: rawData.claimDetails?.bankAccountDetails?.bankName || "",
      branchName: rawData.claimDetails?.bankAccountDetails?.bankBranchName || "",
      branchAddress: rawData.claimDetails?.bankAccountDetails?.branchAddress || "",
      city: rawData.claimDetails?.bankAccountDetails?.city || "",
      state: rawData.claimDetails?.bankAccountDetails?.state || "",
      district: rawData.claimDetails?.bankAccountDetails?.district || "",
      ifscCode: rawData.claimDetails?.bankAccountDetails?.bankIfscCode || "",
      entityData: allEntities // This will now contain the guarantor data
    },
    // ... rest of your step3 and step4 code
  };
};
