import React, { useState, useEffect } from "react";
import { Row, Col, Table } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { formatDate } from "../../../../../utils/constants.ts";
import styles from "../../../../common/styles/ProvisionalCertificateOfSurvey.module.css";

const ProvisionalCertificateOfSurvey = ({ registrationData, surveyData, preFilledCertData }) => {
  const { t } = useTranslation();

  const currentDate = new Date();
  const expiryDate = new Date(currentDate.getTime() + (60 * 24 * 60 * 60 * 1000));

  // Initialize editable fields with pre-filled data
  const [editableData, setEditableData] = useState({
    expiryDay: '',
    expiryMonth: '',
    expiryYear: '',
    certificateNo: '',
    loadingMarksOnSide: 'Yes',
    plyingLimits: '12',
    notExtendingBeyondNauticalMiles: '12',
    masterName: '',
    masterCocGrade: '',
    masterCocNo: '',
    masterPlaceOfIssue: '',
    engineerName: '',
    engineerCocGrade: '',
    engineerCocNo: '',
    engineerPlaceOfIssue: '',
    safetyEquipment: {
      noOfBoats: '',
      noOfBuoyantApparatus: '',
      noOfLifebuoys: '',
      noOfLifejackets: '',
      fireExtinguishersFoamType: '',
      fireExtinguishersSodaAcid: '',
      fireExtinguishersDryCarbonPowder: '',
      anchorCable: '',
      hose: ''
    }
  });

  // Populate data when preFilledCertData changes
  useEffect(() => {
    if (preFilledCertData) {
      setEditableData(prev => ({
        ...prev,
        expiryDay: preFilledCertData.expiryDay || expiryDate.getDate().toString().padStart(2, '0'),
        expiryMonth: preFilledCertData.expiryMonth || (expiryDate.getMonth() + 1).toString().padStart(2, '0'),
        expiryYear: preFilledCertData.expiryYear || expiryDate.getFullYear().toString(),
        certificateNo: preFilledCertData.certificateNo || '',
        loadingMarksOnSide: preFilledCertData.loadingMarksOnSide || 'Yes',
        plyingLimits: preFilledCertData.plyingLimits || '12',
        notExtendingBeyondNauticalMiles: preFilledCertData.notExtendingBeyondNauticalMiles || '12',
        masterName: preFilledCertData.masterName || '',
        masterCocGrade: preFilledCertData.masterCocGrade || '',
        masterCocNo: preFilledCertData.masterCocNo || '',
        masterPlaceOfIssue: preFilledCertData.masterPlaceOfIssue || '',
        engineerName: preFilledCertData.engineerName || '',
        engineerCocGrade: preFilledCertData.engineerCocGrade || '',
        engineerCocNo: preFilledCertData.engineerCocNo || '',
        engineerPlaceOfIssue: preFilledCertData.engineerPlaceOfIssue || '',
        safetyEquipment: {
          noOfBoats: preFilledCertData.noOfBoats || '',
          noOfBuoyantApparatus: preFilledCertData.noOfBuoyantApparatus || '',
          noOfLifebuoys: preFilledCertData.noOfLifebuoys || '',
          noOfLifejackets: preFilledCertData.noOfLifejackets || '',
          fireExtinguishersFoamType: preFilledCertData.fireExtinguishersFoamType || '',
          fireExtinguishersSodaAcid: preFilledCertData.fireExtinguishersSodaAcid || '',
          fireExtinguishersDryCarbonPowder: preFilledCertData.fireExtinguishersDryCarbonPowder || '',
          anchorCable: preFilledCertData.anchorCable || '',
          hose: preFilledCertData.hose || ''
        }
      }));
    }
  }, [preFilledCertData]);

  const handleInputChange = (field, value) => {
    if (field.includes('.')) {
      const [parent, child] = field.split('.');
      setEditableData(prev => ({
        ...prev,
        [parent]: {
          ...prev[parent],
          [child]: value
        }
      }));
    } else {
      setEditableData(prev => ({
        ...prev,
        [field]: value
      }));
    }
  };

  return (
    <div className={styles.certificateBody}>
      {/* Basic Certificate Info */}
      <Row className="mb-3">
        <Col xs={12} md={3} className="mb-2 mb-md-0">
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Category")}:</span>
            <span className={styles.fieldValue}>{preFilledCertData?.category || "A"}</span>
          </div>
        </Col>
        <Col xs={12} md={9}>
          <div className={styles.expirySection}>
            <span className={styles.fieldLabel}>{t("Expiry on or before the")}:</span>
            <div className={styles.dateFields}>
              <input
                type="text"
                className={styles.dateInput}
                value={editableData.expiryDay}
                onChange={(e) => handleInputChange('expiryDay', e.target.value)}
                maxLength="2"
                placeholder="DD"
              />
              <span>-</span>
              <input
                type="text"
                className={styles.dateInput}
                value={editableData.expiryMonth}
                onChange={(e) => handleInputChange('expiryMonth', e.target.value)}
                maxLength="2"
                placeholder="MM"
              />
              <span>-</span>
              <input
                type="text"
                className={styles.dateInput}
                value={editableData.expiryYear}
                onChange={(e) => handleInputChange('expiryYear', e.target.value)}
                maxLength="4"
                placeholder="YYYY"
              />
            </div>
          </div>
        </Col>
      </Row>

      <Row className="mb-3">
        <Col xs={12} md={6} className="mb-2 mb-md-0">
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Provisional Certificate of Survey No.")}:</span>
            <input
              type="text"
              className={styles.editableField}
              value={editableData.certificateNo}
              onChange={(e) => handleInputChange('certificateNo', e.target.value)}
              placeholder="Enter Certificate No."
            />
          </div>
        </Col>
        <Col xs={12} md={6}>
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Zone of operation")}:</span>
            <span className={styles.fieldValue}>{preFilledCertData?.zoneOfOperation || "Zone 1"}</span>
          </div>
        </Col>
      </Row>

      <Row className="mb-4">
        <Col xs={12} md={6} className="mb-2 mb-md-0">
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Date of Issue")}:</span>
            <span className={styles.fieldValue}>{preFilledCertData?.dateOfIssue || formatDate(currentDate)}</span>
          </div>
        </Col>
        <Col xs={12} md={6}>
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Date of Expiry")}:</span>
            <span className={styles.fieldValue}>{preFilledCertData?.dateOfExpiry || formatDate(expiryDate)}</span>
          </div>
        </Col>
      </Row>

      <div className={styles.certificateStatement}>
        <p>{t("This Provisional Certificate of Survey has been issued subsequent to Survey carried out of the below detailed inland vessel.")}</p>
      </div>

      {/* Vessel Details */}
      <div className="vessel-details mb-4">
        <Row className="mb-2">
          <Col xs={12} md={6} className="mb-2 mb-md-0">
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Name of the Vessel")}:</span>
              <span className={styles.fieldValue}>{preFilledCertData?.vesselName || "N/A"}</span>
            </div>
          </Col>
          <Col xs={12} md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Official No.")}:</span>
              <span className={styles.fieldValue}>{preFilledCertData?.officialNo || "N/A"}</span>
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col xs={12} md={6} className="mb-2 mb-md-0">
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Port of Registry")}:</span>
              <span className={styles.fieldValue}>{preFilledCertData?.portOfRegistry || "N/A"}</span>
            </div>
          </Col>
          <Col xs={12} md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Certificate of Registry No.")}:</span>
              <span className={styles.fieldValue}>{preFilledCertData?.certificateOfRegistryNo || "N/A"}</span>
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col xs={12} md={6} className="mb-2 mb-md-0">
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Gross Tonnage")}:</span>
              <span className={styles.fieldValue}>{preFilledCertData?.grossTonnage || "N/A"}</span>
            </div>
          </Col>
          <Col xs={12} md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Registered Tonnage")}:</span>
              <span className={styles.fieldValue}>{preFilledCertData?.registeredTonnage || "N/A"}</span>
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col xs={12} md={6} className="mb-2 mb-md-0">
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Freeboard Assigned")}:</span>
              <span className={styles.fieldValue}>{preFilledCertData?.freeboardAssigned || "N/A"}</span>
            </div>
          </Col>
          <Col xs={12} md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Loading marks placed on the vessel's side")}:</span>
              <select
                className={styles.editableField}
                value={editableData.loadingMarksOnSide}
                onChange={(e) => handleInputChange('loadingMarksOnSide', e.target.value)}
              >
                <option value="Yes">Yes</option>
                <option value="No">No</option>
              </select>
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col xs={12} md={6} className="mb-2 mb-md-0">
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Name of the Master")}:</span>
              <input
                type="text"
                className={styles.editableField}
                value={editableData.masterName}
                onChange={(e) => handleInputChange('masterName', e.target.value)}
                placeholder="Enter Master Name"
              />
            </div>
          </Col>
          <Col xs={12} md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Master's COC Grade")}:</span>
              <input
                type="text"
                className={styles.editableField}
                value={editableData.masterCocGrade}
                onChange={(e) => handleInputChange('masterCocGrade', e.target.value)}
                placeholder="Enter COC Grade"
              />
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col xs={12} md={6} className="mb-2 mb-md-0">
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("COC No.")}:</span>
              <input
                type="text"
                className={styles.editableField}
                value={editableData.masterCocNo}
                onChange={(e) => handleInputChange('masterCocNo', e.target.value)}
                placeholder="Enter COC No."
              />
            </div>
          </Col>
          <Col xs={12} md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Place of Issue")}:</span>
              <input
                type="text"
                className={styles.editableField}
                value={editableData.masterPlaceOfIssue}
                onChange={(e) => handleInputChange('masterPlaceOfIssue', e.target.value)}
                placeholder="Enter Place of Issue"
              />
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col xs={12} md={6} className="mb-2 mb-md-0">
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Name of the Engineer or Engine Driver")}:</span>
              <input
                type="text"
                className={styles.editableField}
                value={editableData.engineerName}
                onChange={(e) => handleInputChange('engineerName', e.target.value)}
                placeholder="Enter Engineer Name"
              />
            </div>
          </Col>
          <Col xs={12} md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("COC Grade of the Engineer or Engine Driver")}:</span>
              <input
                type="text"
                className={styles.editableField}
                value={editableData.engineerCocGrade}
                onChange={(e) => handleInputChange('engineerCocGrade', e.target.value)}
                placeholder="Enter COC Grade"
              />
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col xs={12} md={6} className="mb-2 mb-md-0">
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("COC No.")}:</span>
              <input
                type="text"
                className={styles.editableField}
                value={editableData.engineerCocNo}
                onChange={(e) => handleInputChange('engineerCocNo', e.target.value)}
                placeholder="Enter COC No."
              />
            </div>
          </Col>
          <Col xs={12} md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Place of Issue")}:</span>
              <input
                type="text"
                className={styles.editableField}
                value={editableData.engineerPlaceOfIssue}
                onChange={(e) => handleInputChange('engineerPlaceOfIssue', e.target.value)}
                placeholder="Enter Place of Issue"
              />
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col xs={12} md={6} className="mb-2 mb-md-0">
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Name of Owner")}:</span>
              <span className={styles.fieldValue}>{preFilledCertData?.ownerName || "N/A"}</span>
            </div>
          </Col>
          <Col xs={12} md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Address of Owner")}:</span>
              <span className={styles.fieldValue}>{preFilledCertData?.ownerAddress || "N/A"}</span>
            </div>
          </Col>
        </Row>
      </div>

      {/* Survey Details */}
      <Row className="mb-4">
        <Col xs={12} md={6} className="mb-2 mb-md-0">
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Date of Survey carried out")}:</span>
            <span className={styles.fieldValue}>{preFilledCertData?.dateOfSurveyCarriedOut || formatDate(currentDate)}</span>
          </div>
        </Col>
        <Col xs={12} md={6}>
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Place of survey carried out")}:</span>
            <span className={styles.fieldValue}>{preFilledCertData?.placeOfSurveyCarriedOut || "N/A"}</span>
          </div>
        </Col>
      </Row>

      {/* Plying Limits */}
      <div className="plying-limits mb-4">
        <h6 className={styles.sectionTitle}>{t("PLYING LIMITS (as applicable):")}</h6>
        <div className={styles.infoField}>
          <span className={styles.fieldLabel}>{t("Within inland waters limits")}:</span>
          <span className={styles.fieldValue}>{preFilledCertData?.zoneOfOperation || "Zone 1"}</span>
          <span className={styles.fieldLabel} style={{ marginLeft: '1rem' }}>{t("not extending beyond")}:</span>
          <input
            type="text"
            className={styles.editableField}
            value={editableData.notExtendingBeyondNauticalMiles}
            onChange={(e) => handleInputChange('notExtendingBeyondNauticalMiles', e.target.value)}
            style={{ width: '80px', margin: '0 0.5rem' }}
          />
          <span>{t("Nautical Miles from the nearest shore.")}</span>
        </div>
      </div>

      {/* Cargo/Passenger Capacity */}
      <div className="capacity-section mb-4">
        <h6 className={styles.sectionTitle}>{t("CARGO/PASSENGER CAPACITY")}</h6>
        <div className={styles.infoField}>
          <span className={styles.fieldLabel}>{t("Maximum permissible cargo carriage capacity")}:</span>
          <span className={styles.fieldValue}>{preFilledCertData?.cargoCapacity || "N/A"}</span>
          <span className={styles.fieldLabel} style={{ marginLeft: '1rem' }}>{t("Passengers")}:</span>
          <span className={styles.fieldValue}>{preFilledCertData?.passengerCapacity || "N/A"}</span>
          <span className={styles.fieldLabel} style={{ marginLeft: '1rem' }}>{t("Crew")}:</span>
          <span className={styles.fieldValue}>{preFilledCertData?.crewCapacity || "N/A"}</span>
        </div>
      </div>

      {/* Safety Equipment Table */}
      <div className="safety-equipment mb-4">
        <h6 className={styles.sectionTitle}>{t("Safety equipment carried on the vessel:")}</h6>
        <div className="table-responsive">
          <Table bordered className={styles.safetyTable}>
            <thead>
              <tr>
                <th>{t("No. of boats size and cubic capacity")}</th>
                <th>{t("No. of Buoyant apparatus or Life rafts")}</th>
                <th colSpan="2">{t("No. of Lifebuoys and lifejackets")}</th>
                <th colSpan="3">{t("Fire extinguishers")}</th>
                <th colSpan="2">{t("No. of Anchor with their weight")}</th>
              </tr>
              <tr>
                <th></th>
                <th></th>
                <th>{t("Lifebuoys")}</th>
                <th>{t("Lifejackets")}</th>
                <th>{t("Foam Type")}</th>
                <th>{t("Soda Acid")}</th>
                <th>{t("Dry Carbon Powder")}</th>
                <th>{t("Anchor Cable")}</th>
                <th>{t("Hose")}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableData.safetyEquipment.noOfBoats}
                    onChange={(e) => handleInputChange('safetyEquipment.noOfBoats', e.target.value)}
                    placeholder="Enter value"
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableData.safetyEquipment.noOfBuoyantApparatus}
                    onChange={(e) => handleInputChange('safetyEquipment.noOfBuoyantApparatus', e.target.value)}
                    placeholder="Enter value"
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableData.safetyEquipment.noOfLifebuoys}
                    onChange={(e) => handleInputChange('safetyEquipment.noOfLifebuoys', e.target.value)}
                    placeholder="Enter value"
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableData.safetyEquipment.noOfLifejackets}
                    onChange={(e) => handleInputChange('safetyEquipment.noOfLifejackets', e.target.value)}
                    placeholder="Enter value"
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableData.safetyEquipment.fireExtinguishersFoamType}
                    onChange={(e) => handleInputChange('safetyEquipment.fireExtinguishersFoamType', e.target.value)}
                    placeholder="Enter value"
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableData.safetyEquipment.fireExtinguishersSodaAcid}
                    onChange={(e) => handleInputChange('safetyEquipment.fireExtinguishersSodaAcid', e.target.value)}
                    placeholder="Enter value"
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableData.safetyEquipment.fireExtinguishersDryCarbonPowder}
                    onChange={(e) => handleInputChange('safetyEquipment.fireExtinguishersDryCarbonPowder', e.target.value)}
                    placeholder="Enter value"
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableData.safetyEquipment.anchorCable}
                    onChange={(e) => handleInputChange('safetyEquipment.anchorCable', e.target.value)}
                    placeholder="Enter value"
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableData.safetyEquipment.hose}
                    onChange={(e) => handleInputChange('safetyEquipment.hose', e.target.value)}
                    placeholder="Enter value"
                  />
                </td>
              </tr>
            </tbody>
          </Table>
        </div>
      </div>

      {/* Certificate Statement */}
      <div className={styles.certificateStatement}>
        <p>
          <strong>{t("THIS IS TO CERTIFY")}</strong> {t("that the provisions of the rules with respect to the survey of the above mentioned Inland Vessel and the Transmission of declaration in respect thereof, have been complied with.")}
        </p>
      </div>

      <div className={styles.validityStatement}>
        <p>
          {t("This Provisional Certificate of Survey, issued under the provisions of section 13(1) of the Inland Vessels Act, 2021 continues to be in force only until the")} <strong>({editableData.expiryDay}-{editableData.expiryMonth}-{editableData.expiryYear})</strong>
        </p>
      </div>
    </div>
  );
};

export default ProvisionalCertificateOfSurvey;
