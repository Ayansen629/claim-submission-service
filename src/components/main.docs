.register-page {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  width: 100vw;
  background-image: url("../../assests/images/Backgroundlogin.jpg");
  padding: 20px;
  box-sizing: border-box;
}

.register-container {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 400px;
  padding: 30px;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0px 6px 30px rgba(0, 0, 0, 0.2);
  border-radius: 16px;
  animation: slideIn 0.5s ease-in-out;
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.register-header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20px;
  text-align: center;
  padding: 0 10px;
}

.register-textmain {
  font-size: 22px;
  font-weight: 700;
  color: #269ccc;
  text-transform: uppercase;
  letter-spacing: 1px;
  width: 100%;
}

.register-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.user-input {
  width: 100%;
  padding: 10px 12px;
  border: 2px solid #e6e6e6;
  border-radius: 8px;
  font-size: 14px;
  outline: none;
  transition: border-color 0.3s ease;
  box-sizing: border-box;
}

.user-input:focus {
  border-color: #269ccc;
}

.register-btn {
  width: 100%;
  padding: 12px;
  border: none;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  color: white;
  background-color: #269ccc;
  cursor: pointer;
  transition: all 0.3s ease;
  margin-top: 15px;
}

.register-btn:hover:not(:disabled) {
  background-color: #1e8ab8;
  transform: translateY(-2px);
}

.register-btn:disabled {
  background-color: #cccccc;
  cursor: not-allowed;
  opacity: 0.7;
}

.login-link {
  font-size: 14px;
  color: #333;
  text-align: center;
  margin-top: 20px;
}

.login-link a {
  color: #269ccc;
  font-weight: 600;
  text-decoration: none;
}

.login-link a:hover {
  text-decoration: underline;
}

.error {
  color: #e74c3c;
  font-size: 12px;
  margin-top: 4px;
  display: block;
}

.dropdown-select {
  width: 100%;
  padding: 10px 12px;
  border: 2px solid #e6e6e6;
  border-radius: 8px;
  font-size: 14px;
  outline: none;
  transition: border-color 0.3s ease;
  background-color: white;
  color: #333;
  cursor: pointer;
}

.dropdown-select:focus {
  border-color: #269ccc;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .register-container {
    padding: 25px;
    max-width: 90%;
  }

  .register-textmain {
    font-size: 20px;
  }

  .user-input, .dropdown-select {
    padding: 9px 11px;
    font-size: 13px;
  }

  .register-btn {
    padding: 11px;
    font-size: 15px;
  }
}

@media (max-width: 480px) {
  .register-container {
    padding: 20px;
  }

  .register-textmain {
    font-size: 18px;
  }

  .user-input, .dropdown-select {
    padding: 8px 10px;
    font-size: 12px;
  }

  .register-btn {
    padding: 10px;
    font-size: 14px;
  }
}
import React, { useState } from 'react';
import { useForm } from 'react-hook-form';
import { Link, useNavigate } from 'react-router-dom';
import { toast } from 'react-toastify';
import 'react-toastify/dist/ReactToastify.css';
import './Register.css';

const CorporateDebtorRegister = () => {
  const navigate = useNavigate();
  const [loading, setLoading] = useState(false);
  
  const {
    register,
    handleSubmit,
    watch,
    formState: { errors, isValid, isDirty }
  } = useForm({
    mode: 'onChange' // This enables validation on change
  });

  const processTypeOptions = [
    { value: 'CIRP', label: 'Corporate Insolvency Resolution Process (CIRP)' },
    { value: 'Liquidation', label: 'Liquidation' },
    { value: 'VoluntaryLiquidation', label: 'Voluntary Liquidation' },
    { value: 'PPIRP', label: 'Pre-Packaged Insolvency Resolution Process (PPIRP)' },
  ];

  const onSubmit = async (data) => {
    setLoading(true);
    setTimeout(() => {
      console.log('Registration Data:', {
        name: data.name,
        email: data.email,
        mobile: data.mobile,
        cin: data.cin,
        processType: data.processType
      });
      toast.success('Registration successful!');
      setLoading(false);
      navigate('/login');
    }, 1500);
  };

  const password = watch("password");

  return (
    <div className='register-page'>
      <div className="register-container">
        <div className="register-header">
          <h1 className="register-textmain">Corporate Debtor Registration</h1>
        </div>

        <form className="register-form" onSubmit={handleSubmit(onSubmit)}>
          {/* Name */}
          <div className="form-group">
            <input
              type="text"
              {...register("name", { required: "Company name is required" })}
              placeholder="Company Name"
              className="user-input"
            />
            {errors.name && <span className="error">{errors.name.message}</span>}
          </div>

          {/* Email */}
          <div className="form-group">
            <input
              type="email"
              {...register("email", { 
                required: "Email is required",
                pattern: {
                  value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                  message: "Invalid email address"
                }
              })}
              placeholder="Email ID"
              className="user-input"
            />
            {errors.email && <span className="error">{errors.email.message}</span>}
          </div>

          {/* Mobile Number */}
          <div className="form-group">
            <input
              type="tel"
              {...register("mobile", { 
                required: "Mobile number is required",
                pattern: {
                  value: /^[6-9]\d{9}$/,
                  message: "Invalid Indian mobile number"
                }
              })}
              placeholder="Mobile Number"
              className="user-input"
            />
            {errors.mobile && <span className="error">{errors.mobile.message}</span>}
          </div>

          {/* CIN Number */}
          <div className="form-group">
            <input
              type="text"
              {...register("cin", { 
                required: "CIN is required",
                pattern: {
                  value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
                  message: "Invalid CIN format (e.g., U12345AB6789CDE12345)"
                }
              })}
              placeholder="CIN Number"
              className="user-input"
            />
            {errors.cin && <span className="error">{errors.cin.message}</span>}
          </div>

          {/* Process Type */}
          <div className="form-group">
            <select
              className="dropdown-select"
              {...register("processType", { required: "Process type is required" })}
            >
              <option value="">Select Process Type</option>
              {processTypeOptions.map(opt => (
                <option key={opt.value} value={opt.value}>{opt.label}</option>
              ))}
            </select>
            {errors.processType && <span className="error">{errors.processType.message}</span>}
          </div>

          {/* Password */}
          <div className="form-group">
            <input
              type="password"
              {...register("password", { 
                required: "Password is required",
                minLength: {
                  value: 8,
                  message: "Password must be at least 8 characters"
                }
              })}
              placeholder="Password"
              className="user-input"
            />
            {errors.password && <span className="error">{errors.password.message}</span>}
          </div>

          {/* Confirm Password */}
          <div className="form-group">
            <input
              type="password"
              {...register("confirmPassword", { 
                required: "Please confirm your password",
                validate: value => 
                  value === password || "Passwords do not match"
              })}
              placeholder="Confirm Password"
              className="user-input"
            />
            {errors.confirmPassword && <span className="error">{errors.confirmPassword.message}</span>}
          </div>

          {/* Register Button */}
          <button
            type="submit"
            className="register-btn"
            disabled={!isValid || loading}
          >
            {loading ? "Registering..." : "Register"}
          </button>
        </form>

        <div className="login-link">
          Already have an account? <Link to="/login">Login here</Link>
        </div>
      </div>
    </div>
  );
};

export default CorporateDebtorRegister;
