export const VESSEL_COLUMNS = [
    {
        colName: "Registration No.",
        fieldName: "registrationNo",
        clsName: "column-text-start",
    },
    {
        colName: "Vessel Name",
        fieldName: "vesselName",
        clsName: "column-text-start",
    },
    {
        colName: "Registered Year",
        fieldName: "registeredYear",
        clsName: "column-text-start",
    },
    {
        colName: "Last Survey Date",
        fieldName: "lastSurveyDate",
        clsName: "column-text-start",
    },
     {
    colName: "Action",
    fieldName: "action",
    actions: ['view'],
    clsName: "col-sm-2 column-text-start actions-column",
  },
];


export const INBOX_COLUMNS = [
    {
        colName: "Application No",
        fieldName: "appNo",
        clsName: "column-text-start",
    },
    {
        colName: "Application Type",
        fieldName: "appType",
        clsName: "column-text-start",
    },
    {
        colName: "Date of Submission",
        fieldName: "date",
        clsName: "column-text-start",
    },
    {
        colName: "Status",
        fieldName: "status",
        clsName: "column-text-start",
        render: (value) => (
            <span className={`status-badge ${value.toLowerCase()}`}>{value}</span>
        ),
    },
    {
        colName: "Pending With",
        fieldName: "pendingWith",
        clsName: "column-text-start",
    },
];



export const TRANSACTION_COLUMNS = [
    {
        colName: "Name of person from whom title is derived",
        fieldName: "from",
        clsName: "column-text-start",
    },
    {
        colName: "No. of shares Affected",
        fieldName: "shares",
        clsName: "column-text-start",
    },
    {
        colName: "Date and Hours of Registry",
        fieldName: "dateAndHour",
        clsName: "column-text-start",
    },
    {
        colName: "Nature and Date of Transaction",
        fieldName: "nature",
        clsName: "column-text-start",
    },
    {
        colName:
            "Name, Residence and Occupation of Transferee, Mortgagee or other person acquiring Title or power",
        fieldName: "transferee",
        clsName: "column-text-start",
    },
    {
        colName: "Number of Transaction",
        fieldName: "transactionNo",
        clsName: "column-text-start",
    },
    { colName: "Remarks", fieldName: "remarks", clsName: "column-text-start" },
];


export const MOCK_TRANSACTION_DATA = Array.from({ length: 20 }, (_, i) => ({
    from: `Person ${i + 1}`,
    shares: `${(i % 10) + 1}`,
    dateAndHour: `2025-0${(i % 9) + 1}-${(i % 28) + 1} ${8 + (i % 10)}:00`,
    nature: ["Transfer", "Mortgage", "Sale"][i % 3] + ` - 2025-0${(i % 9) + 1}`,
    transferee: `Transferee ${i + 1}, City ${i % 5}, Occupation ${["Business", "Bank", "Govt"][i % 3]
        }`,
    transactionNo: `${i + 1}`,
    remarks: ["First transfer", "Mortgage created", "Ownership changed"][i % 3],
}));



