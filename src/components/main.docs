/* Hero Section Responsive Fixes */
.heroSection {
  position: relative;
  width: 100%;
  min-height: 100vh;
  height: auto;
  background: url("/src/assets/images/homeBgImage1.jpg") no-repeat center center/cover;
  display: flex;
  justify-content: center;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #0F55B2 0%, rgba(15, 85, 178, 0.66) 37.98%, rgba(255, 255, 255, 0) 100%);
  z-index: 1;
}

.headerRow {
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
}

/* Top Navigation Column */
.topNavCol {
  position: relative;
  padding: 0;
  margin-bottom: 1rem;
}

/* Navigation Links */
.navLinkItems {
  color: white !important;
  font-size: 14px;
  padding: 0.5rem 0.8rem !important;
  z-index: 1075;
}

.navLinkItems:hover {
  color: #2466BF !important;
}

/* Brand Name */
.brandName {
  font-family: "Aptos", sans-serif;
  font-weight: 400;
  font-size: 22px;
  line-height: 28px;
  color: white;
  margin: 0;
  text-align: center;
}

/* Login Button */
.homeLoginBtn {
  border-radius: 4px;
  color: #1A61C1;
  background: white;
  border: none;
  padding: 8px 16px;
  font-size: 14px;
  margin-top: 1rem;
}

.homeLoginBtn:hover {
  color: white !important;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.43) 0%, rgba(0, 210, 224, 0.43) 47.12%, rgba(0, 163, 224, 0.43) 100%) !important;
}

/* Bengal Logo */
.bengalLogo {
  width: 4.25rem;
  height: 5rem;
  position: absolute;
  top: -17px;
  right: 0;
}

/* Mobile specific styles */
@media (max-width: 768px) {
  .heroSection {
    min-height: 80vh;
    height: auto;
    padding-bottom: 2rem;
  }
  
  .headerRow {
    padding: 1rem 0.5rem;
  }
  
  .brandName {
    font-size: 18px;
    line-height: 24px;
  }
  
  .navLinkItems {
    font-size: 12px;
    padding: 0.4rem 0.6rem !important;
  }
  
  /* Mobile navigation wrapper */
  .topNavCol > div:first-child {
    width: 100%;
    margin-bottom: 1.5rem;
  }
  
  /* Bengal logo for mobile */
  .bengalLogo {
    position: relative;
    width: 3.5rem;
    height: 4rem;
    top: 0;
    margin: 0 auto 1rem;
    display: block;
  }
  
  /* Mobile login button positioning */
  .homeLoginBtn {
    margin: 1rem auto;
    display: block;
    width: fit-content;
  }
}

/* Tablet specific styles */
@media (min-width: 769px) and (max-width: 1024px) {
  .heroSection {
    min-height: 90vh;
  }
  
  .brandName {
    font-size: 20px;
  }
  
  .navLinkItems {
    font-size: 13px;
    padding: 0.4rem 0.7rem !important;
  }
  
  .bengalLogo {
    width: 4rem;
    height: 4.5rem;
    top: -15px;
  }
}

/* Small mobile devices */
@media (max-width: 576px) {
  .heroSection {
    min-height: 70vh;
  }
  
  .brandName {
    font-size: 16px;
    line-height: 22px;
  }
  
  /* Stack navigation items vertically on very small screens */
  .nav {
    flex-direction: column;
    align-items: center;
  }
  
  .navLinkItems {
    padding: 0.5rem 0 !important;
    margin: 0.2rem 0;
  }
  
  .bengalLogo {
    width: 3rem;
    height: 3.5rem;
  }
  
  .homeLoginBtn {
    padding: 6px 12px;
    font-size: 12px;
  }
}

/* Medium mobile devices */
@media (min-width: 577px) and (max-width: 768px) {
  .nav {
    flex-wrap: wrap;
    justify-content: center;
  }
  
  .navLinkItems {
    margin: 0.2rem;
  }
}

/* Ensure content doesn't get cut off on mobile */
@media (max-width: 768px) {
  .container-fluid {
    overflow-x: hidden;
  }
  
  .headerRow > div {
    width: 100%;
    margin-bottom: 1.5rem;
  }
  
  .headerRow > div:last-child {
    margin-bottom: 0;
  }
}

/* Fix for BengalLogo display on all screens */
.d-none.d-md-block {
  position: relative;
}

/* Make sure the logo is visible on mobile */
@media (max-width: 768px) {
  .d-none.d-md-block {
    display: flex !important;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    margin-top: 1rem;
  }
  
  .d-none.d-md-block .homeLoginBtn {
    position: relative;
    right: auto;
    top: auto;
  }
}

/* IWT Icon sizing for mobile */
@media (max-width: 768px) {
  .headerRow img[alt="Logo"] {
    width: 4.5rem !important;
    margin-bottom: 0.5rem;
  }
}
