<Modal
  show={isViewModalOpen}
  onHide={() => setIsViewModalOpen(false)}
  dialogClassName="modal-1110w"
  aria-labelledby="example-custom-modal-styling-title"
>
  <Modal.Header closeButton>
    <Modal.Title id="example-custom-modal-styling-title">
      Application Details
    </Modal.Title>
  </Modal.Header>
  <Modal.Body>
    {modalData ? (
      <>
        <div className="d-flex justify-content-between align-items-center mb-3" style={{width: "100%"}}>
          <h4 className="mb-0">Application Number:</h4>
          
          <div
            style={{
              backgroundColor: "#f0f8ff",
              color: "#4682b4",
              padding: "8px 15px",
              borderRadius: "5px",
              fontWeight: "bold",
              fontSize: "1.1rem",
              border: "1px solid #add8e6",
              marginRight:"auto",
              marginLeft:"10px",
            }}
          >
            {modalData.applicationNumber || "N/A"}
          </div>

          <button onClick={handleOpenModal} style={{
            display: "flex",
            alignItems: "center",
            padding: "0.5rem",
            backgroundColor: "rgb(7 76 101)",
            color: "white",
            border: "none",
            borderRadius: "8px",
            cursor: "pointer",
            fontSize: "1 rem",
            width: "40px",
            height: "40px",
          }}><FaClipboardList /></button>
        </div>

        {showModal && (
          <div
            style={{
              position: "fixed",
              top: 0,
              left: 0,
              height: "100%",
              width: "100%",
              backgroundColor: "rgba(0,0,0,0.5)",
              display: "flex",
              justifyContent: "center",
              alignItems: "center",
              zIndex: 1000,
            }}
          >
            <div
              style={{
                backgroundColor: "white",
                padding: "2rem",
                borderRadius: "10px",
                minWidth: "600px",
                maxWidth: "90%",
                maxHeight: "80vh",
                overflowY: "auto",
              }}
            >
              <div className="d-flex justify-content-between align-items-center mb-4">
                <h2 className="mb-0">
                  Documents for Application: 
                </h2>
                <button 
                  onClick={handleCloseModal}
                  style={{
                    background: "none",
                    border: "none",
                    fontSize: "1.5rem",
                    cursor: "pointer",
                    color: "#6c757d",
                  }}
                >
                  &times;
                </button>
              </div>

              <Table striped bordered hover responsive>
                <thead>
                  <tr>
                    <th style={{ width: "10%" }}>SL #</th>
                    <th style={{ width: "70%" }}>Document Name</th>
                    <th style={{ width: "20%" }}>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>1</td>
                    <td>
                      <div className="d-flex align-items-center">
                        <FaFilePdf className="me-2" style={{ color: "red" }} />
                        {modalData.applicationNumber || "N/A"}
                      </div>
                    </td>
                    <td>
                      <Button
                        variant="outline-primary"
                        size="sm"
                        className="d-flex align-items-center justify-content-center"
                        style={{ width: "100%" }}
                      >
                        <FaDownload className="me-2" />
                        Download
                      </Button>
                    </td>
                  </tr>
                </tbody>
              </Table>

              <div className="d-flex justify-content-end mt-3">
                <Button variant="secondary" onClick={handleCloseModal}>
                  Close
                </Button>
              </div>
            </div>
          </div>
        )}

        <Collapsible title="Creditor & Identification Details">
          <div className="card mb-4 tiles_Size">
            <div className="card-body">
              <h5 style={{ fontWeight: 600 }}>Creditor Details</h5>
              <br />
              <Container fluid>
                <Row className="g-3">
                  {modalData.step1?.creditorDetails && Object.entries(modalData.step1.creditorDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
          <div className="card mb-4 tiles_Size">
            <div className="card-body">
              <h5 style={{ fontWeight: 600 }}>Identification Details</h5>
              <br />
              <Container fluid>
                <Row className="g-3">
                  {modalData.step1?.identificationDetails && Object.entries(modalData.step1.identificationDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard 
                        title={key} 
                        value={
                          key === "Document Name" && modalData.step1?.identificationDetails?.document?.docId ? (
                            <div className="d-flex align-items-center">
                              <span className="me-2">{value}</span>
                              <Button 
                                variant="link" 
                                size="sm" 
                                className="p-0"
                                onClick={() => handleDownload(
                                  modalData.step1.identificationDetails.document.docId,
                                  modalData.step1.identificationDetails.document.docName
                                )}
                              >
                                <FaDownload className="text-primary" />
                              </Button>
                            </div>
                          ) : value || "N/A"
                        } 
                      />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
        </Collapsible>

        <Collapsible title="Financial & Beneficiary Details">
          <div className="card mb-4 tiles_Size">
            <div className="card-body">
              <h5 style={{ fontWeight: 600 }}>Financial Details</h5>
              <br />
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.financialDetails && Object.entries(modalData.step2.financialDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
          <div className="card mb-4 tiles_Size">
            <div className="card-body">
              <h5 style={{ fontWeight: 600 }}>Beneficiary Details</h5>
              <br />
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.beneficiaryDetails && Object.entries(modalData.step2.beneficiaryDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
          <div className="card mb-4 tiles_Size">
            <div className="card-body">
              <h5 style={{ fontWeight: 600 }}>Address Proof Details</h5>
              <br />
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.addressproofDetails && Object.entries(modalData.step2.addressproofDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard 
                        title={key} 
                        value={
                          key === "Address Proof Document" && modalData.step2?.addressproofDetails?.document?.docId ? (
                            <div className="d-flex align-items-center">
                              <span className="me-2">{value}</span>
                              <Button 
                                variant="link" 
                                size="sm" 
                                className="p-0"
                                onClick={() => handleDownload(
                                  modalData.step2.addressproofDetails.document.docId,
                                  modalData.step2.addressproofDetails.document.docName
                                )}
                              >
                                <FaDownload className="text-primary" />
                              </Button>
                            </div>
                          ) : value || "N/A"
                        } 
                      />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
          <div className="card mb-4 tiles_Size">
            <div className="card-body">
              <h5 style={{ fontWeight: 600 }}>Bank Details</h5>
              <br />
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.bankDetails && Object.entries(modalData.step2.bankDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
        </Collapsible>

        <Collapsible title="Signatory Details">
          <div className="card mb-4 tiles_Size">
            <div className="card-body">
              <h5 style={{ fontWeight: 600 }}>Signatory Information</h5>
              <br />
              <Container fluid>
                <Row className="g-3">
                  {modalData.step3?.signatoryDetails && Object.entries(modalData.step3.signatoryDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard 
                        title={key} 
                        value={
                          key === "Signatory Document" && modalData.step3?.signatoryDetails?.document?.docId ? (
                            <div className="d-flex align-items-center">
                              <span className="me-2">{value}</span>
                              <Button 
                                variant="link" 
                                size="sm" 
                                className="p-0"
                                onClick={() => handleDownload(
                                  modalData.step3.signatoryDetails.document.docId,
                                  modalData.step3.signatoryDetails.document.docName
                                )}
                              >
                                <FaDownload className="text-primary" />
                              </Button>
                            </div>
                          ) : value || "N/A"
                        } 
                      />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
        </Collapsible>
      </>
    ) : (
      <p>No data available.</p>
    )}
  </Modal.Body>
  <Modal.Footer>
    <Button variant="secondary" onClick={() => setIsViewModalOpen(false)}>
      Close
    </Button>
  </Modal.Footer>
</Modal>


const [downloading, setDownloading] = useState({});

const handleDownload = async (fileId, fileName) => {
  try {
    setDownloading(prev => ({ ...prev, [fileId]: true }));
    
    const response = await axios.get(
      `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileId}`,
      { responseType: 'blob' }
    );

    // Create download link
    const url = window.URL.createObjectURL(new Blob([response.data]));
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', fileName || 'document');
    document.body.appendChild(link);
    link.click();
    link.remove();
    
  } catch (error) {
    console.error('Error downloading file:', error);
    toast.error('Failed to download document', { position: "top-right" });
  } finally {
    setDownloading(prev => ({ ...prev, [fileId]: false }));
  }
};
