// Port of Registry
<InputText
  label={t("Port of Registry of Vessel")}
  name="vesselDetails.portOfRegistry"
  placeholder={!viewMode ? t("Enter Port of Registry of Vessel") : ""}
  register={register("vesselDetails.portOfRegistry")}
  errors={errors}
  disabled={viewMode || !!vesselData?.portOfRegistry}
  style={{ backgroundColor: "#f8f9fa" }}
/>

