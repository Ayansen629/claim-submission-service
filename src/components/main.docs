// Add this import at the top
import RequestApplication from "./RequestApplication.js";

// Update the getSteps function to add the 3rd step
const getSteps = () => {
  const baseSteps = [
    {
      label: t("Consent for Alteration & Modifications"),
      component: (
        <ConsentForm
          formMethods={methods}
          viewMode={isViewMode}
          editMode={isEditMode}
          registrationData={registrationData}
          initialRegistryData={initialRegistryData}
        />
      ),
      validate: validateConsentForm,
      getFormData: () => methods?.getValues(),
    },
    {
      label: t("Request/Application for Registration of Alteration"),
      component: (
        <RequestApplication
          formMethods={methods}
          viewMode={isViewMode}
          editMode={isEditMode}
          registrationData={registrationData}
        />
      ),
      validate: () => true,
      getFormData: () => methods?.getValues(),
    },
  ];

  if (!isOfficerLogin && !viewMode && userRole === USER_ROLES.VESSEL_OWNER) {
    baseSteps.push({
      label: t("vesselDetails.Invoicing"),
      component: (
        <Invoicing
          supervisionAuthority={
            registrationData?.vessel?.supervisionAuthority ||
            "CLASSIFICATION SOCIETY"
          }
          onPayNow={handlePayNow}
          vesselData={registrationData}
          paymentData={paymentData}
        />
      ),
      showPayBtn: true,
      validate: () => true,
    });
  }
  return baseSteps;
};
