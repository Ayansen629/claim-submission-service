const validateStep = async () => {
  const currentFields = getCurrentStepFields();
  const requiredFields = currentFields
    .filter(field => field.required && (!field.showIf || field.showIf()));

  // Validate required fields
  let hasErrors = false;
  
  requiredFields.forEach(field => {
    const value = getValues(field.name);
    
    // Check if field is empty
    if (!value || value === '') {
      setError(field.name, {
        type: 'required',
        message: `${field.label} is required`
      });
      hasErrors = true;
    } 
    // Validate file fields - only check type and size if file exists
    else if (field.type === 'file' && value instanceof File) {
      const file = value;
      const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
      
      if (!validTypes.includes(file.type)) {
        setError(field.name, {
          type: 'fileType',
          message: 'Only PDF, JPG or PNG files are allowed'
        });
        hasErrors = true;
      }
      else if (file.size > 2 * 1024 * 1024) {
        setError(field.name, {
          type: 'fileSize',
          message: 'File size should not exceed 2MB'
        });
        hasErrors = true;
      }
      // If file is valid, explicitly clear any errors
      else {
        clearErrors(field.name);
      }
    } 
    // Validate pattern for text fields
    else if (field.validation && field.validation.pattern && typeof value === 'string') {
      const pattern = field.validation.pattern.value;
      if (!pattern.test(value)) {
        setError(field.name, {
          type: 'pattern',
          message: field.validation.pattern.message
        });
        hasErrors = true;
      }
    }
  });

  // Trigger validation for all fields in current step
  const fieldsToValidate = currentFields
    .filter(field => !field.showIf || field.showIf())
    .map(field => field.name);

  const result = await trigger(fieldsToValidate);
  return result && !hasErrors;
};
