                              options={
                                masterData?.departments?.map((type) => ({
                                  value: type.valueCode,
                                  label: type.valueLabel,
                                })) || []
                              }
                              register={register(
                                `professionalDetails.${index}.department`,
                                { required: t("Department is required") }
                              )}
                              errors={
                                errors?.professionalDetails?.[index] || {}
                              }
                              value={
                                watch(
                                  `professionalDetails.${index}.department`
                                ) || ""
                              }
