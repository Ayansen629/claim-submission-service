// In DynamicFormFields.js
const DynamicFormFields = ({ fields, setFormData }) => {
  const { register, formState: { errors }, setValue, watch, setError } = useFormContext();

  const handleDownload = (filename) => {
    // Implement actual download logic here
    console.log(`Downloading ${filename}`);
    // In a real implementation, you would fetch the file from the server
    // For demo purposes, we'll just log it
    const link = document.createElement('a');
    link.href = `#${filename}`; // Replace with actual file URL
    link.download = filename;
    link.click();
  };

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'file':
        if (field.disabled || field.displayOnly) {
          const value = watch(field.name);
          return (
            <div className="mb-4">
              <label className="form-label fw-semibold">{field.label}</label>
              <div className="file-display d-flex align-items-center justify-content-between p-2 bg-light rounded">
                <span className="text-truncate me-2" style={{ maxWidth: '200px' }}>
                  {value || 'No file uploaded'}
                </span>
                {value && (
                  <Button 
                    variant="outline-primary" 
                    size="sm" 
                    onClick={() => handleDownload(value)}
                    className="ms-2"
                  >
                    <FaDownload className="me-1" /> Download
                  </Button>
                )}
              </div>
              {/* Hidden disabled file input for form state */}
              <input
                type="file"
                className="d-none"
                disabled
                {...register(field.name)}
              />
            </div>
          );
        }
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
                const fileName = `${field.label}${extension}`;
                file.originalName = fileName;
                setValue(field.name, renameFile(file, fileName));
                setFormData(prev => {
                  const updated = { ...prev, [field.name]: file };
                  return updated;
                });

                const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'Only PDF, JPG or PNG files are allowed'
                  });
                }

                if (file.size > 2 * 1024 * 1024) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'File size should not exceed 2MB'
                  });
                }
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={watch(field.name)}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...field.validation,
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className="mb-4"
            style={{
              borderColor: errors[field.name] ? '#dc3545' : '#ced4da',
              backgroundColor: errors[field.name] ? '#fff8f8' : 'white'
            }}
          />
        );
    }
  };

  return (
    <Row className="g-3">
      {fields.map((field, index) => (
        <Col key={index} md={field.colSize || 12}>
          {renderField(field)}
        </Col>
      ))}
    </Row>
  );
};
/////////////
/* In your CSS file */
.file-display {
  padding: 10px 16px;
  background-color: #f8f9fa;
  border-radius: 6px;
  border: 1px solid #dee2e6;
  font-size: 0.95rem;
  width: 100%;
  transition: all 0.2s;
  min-height: 44px;
}

.file-display:hover {
  background-color: #e9ecef;
}

.disabled-file-input {
  background-color: #f8f9fa !important;
  color: #495057 !important;
  cursor: not-allowed !important;
  border: 1px solid #e3eafc !important;
  border-radius: 6px !important;
  padding: 10px 12px;
}

.form-label {
  font-weight: 500;
  margin-bottom: 8px;
  color: #495057;
}
