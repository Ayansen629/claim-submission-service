// DynamicViewFields.jsx
import React from 'react';
import { Row, Col, Button } from 'react-bootstrap';
import { useFormContext } from 'react-hook-form';
import { FaFileAlt, FaDownload } from 'react-icons/fa';

const DynamicViewFields = ({ fields, setFormData }) => {
  const { register, formState: { errors }, watch } = useFormContext();

  const handleDownload = (filename) => {
    console.log(`Downloading ${filename}`);
    const link = document.createElement('a');
    link.href = `#${filename}`;
    link.download = filename;
    link.click();
  };

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    // Special handling for file fields
    if (field.type === 'file') {
      const fileName = watch(field.name);
      return (
        <div className="mb-3">
          <label className="form-label fw-medium">{field.label}{field.required && <span className="text-danger">*</span>}</label>
          <div className="file-display d-flex align-items-center justify-content-between">
            <div className="d-flex align-items-center">
              <FaFileAlt className="me-2 text-primary" />
              <span>{fileName || 'No file uploaded'}</span>
            </div>
            {fileName && (
              <Button 
                variant="outline-primary" 
                size="sm" 
                onClick={() => handleDownload(fileName)}
              >
                <FaDownload className="me-1" /> Download
              </Button>
            )}
          </div>
        </div>
      );
    }

    // For regular text fields
    return (
      <div className="mb-3">
        <label className="form-label fw-medium">{field.label}{field.required && <span className="text-danger">*</span>}</label>
        <input
          type={field.type}
          className={`form-control ${field.inputClassName || ''}`}
          placeholder={field.placeholder}
          disabled={true}
          readOnly={true}
          value={watch(field.name) || ''}
        />
      </div>
    );
  };

  return (
    <>
      {fields.map((field, index) => (
        <Col key={index} md={field.colSize || 12}>
          {renderField(field)}
        </Col>
      ))}
    </>
  );
};

export default DynamicViewFields;
