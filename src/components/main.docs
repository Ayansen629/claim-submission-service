.registration-view-container {
  background: linear-gradient(120deg, #f5f7fa 60%, #e3eafc 100%);
  min-height: 100vh;
}

.registration-card {
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(13,110,253,0.06);
  border: none;
}

.registration-header {
  background-color: #0d6efd;
  color: white;
  padding: 1.5rem;
}

.registration-header-content {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.header-logo-container {
  margin-right: 20px;
}

.header-logo {
  height: 60px;
}

.header-title {
  margin: 0;
  font-size: 1.8rem;
  font-weight: 600;
}

.registration-body {
  background-color: #f8f9fa;
}

.back-button {
  min-width: 140px;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.application-label {
  font-size: 1.1rem;
  font-family: 'Roboto', sans-serif;
}

.application-number {
  background: linear-gradient(90deg, #e3eafc 0%, #b6d0fe 100%);
  color: #0d6efd;
  font-size: 1.05rem;
  font-family: 'Roboto Mono', monospace;
  border: 1.5px solid #b6d0fe;
}

.status-badge {
  font-size: 1rem;
  padding: 0.5em 1.2em;
  border-radius: 2em;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.stepper-container {
  margin-bottom: 32px;
}

.stepper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
}

.step {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 120px;
}

.step-connector {
  flex: 1;
}

.connector-line {
  height: 4px;
  background: #e9ecef;
  border-radius: 2px;
}

.connector-line.active {
  background: linear-gradient(to right, #28a745, #20c997);
}

.step-icon {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: bold;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  background: #ffffff;
  border: 2px solid #e9ecef;
  color: #6c757d;
  transition: all 0.4s ease;
}

.step.active .step-icon {
  background: linear-gradient(135deg, #0077b6, #023e8a);
  border: none;
  color: #fff;
  box-shadow: 0 5px 15px rgba(0, 119, 182, 0.3);
}

.step.completed .step-icon {
  background: linear-gradient(135deg, #28a745, #20c997);
  border: none;
  color: #fff;
  box-shadow: 0 5px 15px rgba(40, 167, 69, 0.3);
}

.step-label {
  color: #6c757d;
  font-size: 0.9rem;
  transition: all 0.3s ease;
}

.step.active .step-label {
  color: #0077b6;
}

.step.completed .step-label {
  color: #28a745;
}

.form-section {
  background-color: white;
  border: 1px solid #e9ecef;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 1.5rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid #e9ecef;
}

.section-icon {
  margin-right: 12px;
  color: #0d6efd;
  font-size: 1.5rem;
}

.form-navigation {
  clear: both;
}

.prev-btn, .next-btn {
  min-width: 150px;
  padding: 10px 20px;
  font-weight: 500;
}

.btn-icon {
  font-size: 1rem;
}

.file-display {
  padding: 10px 16px;
  background-color: #f8f9fa;
  border-radius: 6px;
  border: 1.5px solid #dee2e6;
  font-size: 0.97rem;
  min-width: 180px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.file-name {
  font-weight: 500;
  color: #0d6efd;
  font-family: 'Roboto Mono', monospace;
  font-size: 1rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140px;
}

.file-download-btn {
  color: #198754 !important;
  margin-left: 8px;
  padding: 0 6px;
}

.disabled-field {
  background-color: #f8f9fa !important;
  color: #495057 !important;
  cursor: not-allowed !important;
  border: 1.5px solid #e3eafc !important;
  border-radius: 6px !important;
}

@media (max-width: 768px) {
  .header-title {
    font-size: 1.4rem;
  }
  
  .stepper {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .step {
    flex-direction: row;
    margin-bottom: 18px;
    width: 100%;
    min-width: 0;
  }
  
  .step-connector {
    display: none;
  }
  
  .step-icon {
    margin-right: 15px;
    margin-bottom: 0;
  }
  
  .step-label {
    margin-top: 3px;
    text-align: left;
  }
  
  .prev-btn, .next-btn {
    width: 100%;
    margin-bottom: 10px;
  }
}
