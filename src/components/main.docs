    // Get fields for current step that should be visible
    const getCurrentStepFields = () => {
      const stepFields = currentStep === 1 ? formFields.step1 : 
                       currentStep === 2 ? formFields.step2 : 
                       formFields.step3;
      
      return stepFields.filter(field => {
        if (!field.showIf) return true;
        return field.showIf();
      });
    };
  
    // Validate current step
    const validateStep = async () => {
      const fieldsToValidate = getCurrentStepFields()
        .filter(field => field.required)
        .map(field => field.name);
      
      const isValid = await trigger(fieldsToValidate);
      
      if (!isValid) {
        const firstError = Object.keys(errors)[0];
        if (firstError) {
          const element = document.getElementsByName(firstError)[0];
          if (element) {
            element.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }
        
        // Generate validation message
        const missingFields = getCurrentStepFields()
          .filter(field => field.required && errors[field.name])
          .map(field => field.label);
        
        if (missingFields.length > 0) {
          setValidationMessage(`Please fill all mandatory fields: ${missingFields.join(', ')}`);
        }
      } else {
        setValidationMessage("");
      }
      
      return isValid;
    };
  
    // Handle next button click
    const handleNext = async () => {
      const isStepValid = await validateStep();
      
      if (isStepValid) {
        const currentValues = getValues();
        setFormData(prev => ({ ...prev, ...currentValues }));
        
        if (currentStep < totalSteps) {
          setCurrentStep(currentStep + 1);
          window.scrollTo(0, 0);
        } else {
          handleSubmit(onSubmit)();
        }
      }
    };
  
    // Handle previous button click
    const handlePrevious = () => {
      const currentValues = getValues();
      setFormData(prev => ({ ...prev, ...currentValues }));
      setCurrentStep(Math.max(1, currentStep - 1));
      window.scrollTo(0, 0);
      setValidationMessage("");
    };
  
    // Handle form submission
    const onSubmit = (data) => {
      const finalData = { ...formData, ...data };
      console.log('Form submitted with data:', JSON.stringify(finalData, null, 2));
      setIsSubmitted(true);
      window.scrollTo(0, 0);
    };
  
    // Dynamic Field Component
    const DynamicField = ({ field }) => {
      if (field.showIf && !field.showIf()) return null;
  
      const handleChange = (e) => {
        if (field.onChange) field.onChange(e);
        
        // Clear error when user starts typing
        if (e.target.value && errors[field.name]) {
          clearErrors(field.name);
          setValidationMessage("");
        }
      };
  
      switch(field.type) {
        case 'select':
          // return (
          //   <Form.Group className="form-group mb-4">
          //     <Form.Label className="fw-bold text-dark">
          //       {field.label} {field.required && <span className="required text-danger">*</span>}
          //     </Form.Label>
          //     <div className="input-with-icon">
          //       <Form.Select 
          //         {...register(field.name, {
          //           ...field.validation,
          //           onChange: handleChange
          //         })}
          //         className={`form-select custom-select ${errors[field.name] ? 'is-invalid border-danger' : ''}`}
          //         disabled={field.readOnly}
          //         style={{ 
          //           height: '50px', 
          //           borderRadius: '8px',
          //           borderColor: errors[field.name] ? '#dc3545' : '#ced4da',
          //           backgroundColor: errors[field.name] ? '#fff8f8' : 'white'
          //         }}
          //       >
          //         {field.options.map((option, idx) => (
          //           <option key={idx} value={option.value}>{option.label}</option>
          //         ))}
          //       </Form.Select>
          //       {field.icon && <field.icon className="input-icon text-primary" />}
          //     </div>
          //     {errors[field.name] && (
          //       <div className="error-message text-danger small mt-1">
          //         {errors[field.name].message}
          //       </div>
          //     )}
          //   </Form.Group>
          // );
           return (
    <InputSelect
      label={field.label}
      required={field.required}
      name={field.name}
      options={field.options}
      register={register(field.name, {
        ...field.validation,
        onChange: handleChange
      })}
      errors={errors}
      icon={field.icon}
      className="mb-4"
    />
  );
        
        case 'file':
          return (
            // <Form.Group className="form-group mb-4">
            //   <Form.Label className="fw-bold text-dark">
            //     {field.label} {field.required && <span className="required text-danger">*</span>}
            //   </Form.Label>
            //   <div className={`file-upload border rounded p-3 ${errors[field.name] ? 'border-danger' : ''}`} 
            //        style={{ borderRadius: '8px', backgroundColor: errors[field.name] ? '#fff8f8' : 'white' }}>
            //     <input 
            //       type="file" 
            //       id={field.name}
            //       {...register(field.name, field.validation)}
            //       onChange={(e) => {
            //         if (e.target.files?.[0]) {
            //           setValue(field.name, e.target.files[0].name);
            //           clearErrors(field.name);
            //           setValidationMessage("");
            //         }
            //       }}
            //       className="file-input d-none"
            //     />
            //     <label htmlFor={field.name} className="file-label btn btn-outline-primary mb-0 d-inline-flex align-items-center" style={{ borderRadius: '6px' }}>
            //       <FaUpload className="file-icon me-2" />
            //       <span className="file-text">Choose File</span>
            //     </label>
            //     <span className="file-name ms-3 text-muted">
            //       {watch(field.name) ? watch(field.name) : 'No file chosen'}
            //     </span>
            //   </div>
            //   <div className="file-help-text text-muted small mt-1">Upload PDF, JPG or PNG file (Max size: 2MB)</div>
            //   {errors[field.name] && (
            //     <div className="error-message text-danger small mt-1">
            //       {errors[field.name].message}
            //     </div>
            //   )}
            // </Form.Group>


             
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            register={register(field.name, field.validation)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files[0]) {
                setValue(field.name, e.target.files[0].name);
                clearErrors(field.name);
                // Check if all required fields are filled
                validateStep();
              }
            }}
            className="mb-4"
            style={{
              borderColor: errors[field.name] ? '#dc3545' : '#ced4da',
              backgroundColor: errors[field.name] ? '#fff8f8' : 'white'
            }}
          />
        
          );
        
        default:
          return (
            <InputText
              label={field.label}
              required={field.required}
              name={field.name}
              type={field.type}
              placeholder={field.placeholder}
              register={register(field.name, {
                ...field.validation,
                onChange: handleChange
              })}
              errors={errors}
              readOnly={field.readOnly}
              icon={field.icon}
              className="mb-4"
              style={{
                borderColor: errors[field.name] ? '#dc3545' : '#ced4da',
                backgroundColor: errors[field.name] ? '#fff8f8' : 'white'
              }}
            />
          );
      }
    };
  


  // Step titles
  const stepTitles = [
    { title: "Vessel Owner Details", icon: FaBuilding },
    { title: "Authorized Person's Details", icon: FaUser },
    { title: "Documents Upload", icon: FaFileUpload }
  ];

  // Custom styles
  const cardStyle = {
    borderRadius: '15px',
    overflow: 'hidden',
    boxShadow: '0 10px 30px rgba(0, 0, 0, 0.1)'
  };

  const headerStyle = {
    height: '140px',
    overflow: 'hidden',
    background: 'linear-gradient(135deg, #f8f9fa, #e9ecef)'
  };

  const buttonGradient = {
    background: 'linear-gradient(135deg, #0077b6, #023e8a)',
    border: 'none',
    boxShadow: '0 4px 15px rgba(0, 119, 182, 0.3)',
    borderRadius: '8px',
    padding: '12px 24px',
    fontWeight: '600',
    transition: 'all 0.3s ease'
  };

  const outlineButtonStyle = {
    borderRadius: '8px',
    padding: '12px 24px',
    fontWeight: '600',
    boxShadow: '0 4px 15px rgba(108, 117, 125, 0.15)',
    transition: 'all 0.3s ease'
  };

  const stepIconStyle = {
    width: '45px',
    height: '45px',
    borderRadius: '50%',
    fontSize: '18px',
    boxShadow: '0 4px 10px rgba(0, 0, 0, 0.1)'
  };

  return (
    <Container fluid className="registration-container py-5">
      <Row className="justify-content-center">
        <Col lg={10} xl={9}>
          <Card className="registration-card" style={cardStyle}>
            <Card.Header className="registration-header p-0">
              <div className="d-flex justify-content-between align-items-center p-3" 
                style={{ 
                  background: 'linear-gradient(135deg, #0077b6, #023e8a)',
                  borderTopLeftRadius: '15px',
                  borderTopRightRadius: '15px',
                  boxShadow: '0 4px 10px rgba(0, 0, 0, 0.1)'
                }}>
                <div className="d-flex align-items-center">
                  <Image 
                    src={IWT_FULL_IMG} 
                    alt="IWT Logo" 
                    style={{ height: '60px', objectFit: 'contain', marginRight: '15px' }} 
                  />
                </div>
                <h3 className="mb-0 fw-bold d-flex align-items-center" style={{ color: '#ffffff' }}>
                  Vessel Owner Registration
                </h3>
              </div>
            </Card.Header>
            
            <Card.Body className="registration-body p-4 p-md-5">
              {isSubmitted ? (
                <div className="success-container text-center py-5">
                  <div className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style={{ width: '90px', height: '90px', boxShadow: '0 10px 20px rgba(40, 167, 69, 0.3)' }}>
                    <FaCheck className="success-icon text-white fs-1" />
                  </div>
                  <h4 className="success-title text-success mb-3 fw-bold">Registration Successful!</h4>
                  <p className="success-message mb-4 text-muted fs-5">
                    Your vessel owner registration has been submitted successfully. 
                    You will receive a confirmation email shortly.
                  </p>
                  <div className="registration-id p-4 bg-light rounded mb-4" style={{ borderLeft: '4px solid #0077b6' }}>
                    <strong>Registration ID:</strong> {Math.random().toString(36).substring(2, 10).toUpperCase()}
                  </div>
                  <Button 
                    variant="primary" 
                    size="lg"
                    className="mt-2 px-5"
                    style={buttonGradient}
                    onClick={() => window.location.href = '/dashboard'}
                  >
                    Go to Dashboard
                  </Button>
                </div>
              ) : (
                <FormProvider {...methods}>
                  <form>
                    {/* Form instruction - removed duplicate title */}
                    <div className="text-center mb-4">
                      <p className="text-muted">Please complete all required information to register your vessel</p>
                    </div>
                    
                    {/* Validation Error Message */}
                    {validationMessage && (
                      <Alert variant="danger" className="mb-4 d-flex align-items-center">
                        <div className="me-3">
                          <FaIdCard size={24} />
                        </div>
                        <div>
                          <h5 className="mb-1">Please fill all mandatory fields:</h5>
                          <p className="mb-0">Category of Owner, Owner/Company Name, Email ID, Phone Number, PAN Number, Address Line-1, PIN</p>
                        </div>
                      </Alert>
                    )}
                    
                    {/* Stepper */}
                    <div className="stepper-container mb-5">
                      <div className="stepper d-flex justify-content-between">
                        {[1, 2, 3].map((step) => (
                          <React.Fragment key={step}>
                            <div className={`step ${currentStep >= step ? 'active' : ''} ${currentStep > step ? 'completed' : ''} flex-grow-1 text-center`}>
                              <div 
                                className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2" 
                                style={{
                                  width: '60px',
                                  height: '60px',
                                  borderRadius: '50%',
                                  fontSize: '20px',
                                  fontWeight: 'bold',
                                  boxShadow: currentStep >= step ? '0 5px 15px rgba(0, 119, 182, 0.3)' : '0 4px 10px rgba(0, 0, 0, 0.1)',
                                  background: currentStep >= step ? 
                                    (currentStep > step ? 'linear-gradient(135deg, #28a745, #20c997)' : 'linear-gradient(135deg, #0077b6, #023e8a)') : 
                                    '#ffffff',
                                  border: currentStep >= step ? 'none' : '2px solid #e9ecef',
                                  color: currentStep >= step ? '#fff' : '#6c757d',
                                  transition: 'all 0.4s ease'
                                }}>
                                {currentStep > step ? <FaCheck size={22} /> : React.createElement(stepTitles[step-1].icon, { size: 22 })}
                              </div>
                              <div className="step-label fw-bold" 
                                style={{ 
                                  color: currentStep >= step ? (currentStep > step ? '#28a745' : '#0077b6') : '#6c757d',
                                  fontSize: '0.9rem',
                                  transition: 'all 0.3s ease'
                                }}>
                                {stepTitles[step-1].title}
                              </div>
                            </div>
                            {step < 3 && (
                              <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                                <div className={`connector-line w-100 ${currentStep > step ? 'active' : ''}`} 
                                  style={{ 
                                    height: '4px', 
                                    background: currentStep > step ? 'linear-gradient(to right, #28a745, #20c997)' : '#e9ecef',
                                    borderRadius: '2px',
                                    transition: 'all 0.5s ease'
                                  }}></div>
                              </div>
                            )}
                          </React.Fragment>
                        ))}
                      </div>
                    </div>
                    
                    {/* Step Content */}
                    <div className="step-content">
                      <div className="form-section bg-light p-4 rounded mb-4" style={{ borderRadius: '12px', boxShadow: '0 5px 15px rgba(0, 0, 0, 0.05)' }}>
                        <div className="section-title d-flex align-items-center mb-4 pb-2 border-bottom">
                          {React.createElement(stepTitles[currentStep-1].icon, { className: "section-icon text-primary me-2 fs-4" })}
                          <h4 className="mb-0 fw-bold">{stepTitles[currentStep-1].title}</h4>
                        </div>
                        
                        <div className="form-content">
                          <Row className="g-3">
                            {getCurrentStepFields().map((field, index) => (
                              <Col key={index} md={field.colSize || 12}>
                                <DynamicField field={field} />
                              </Col>
                            ))}
                          </Row>
                        </div>
                      </div>
                    </div>
                    
                    {/* Navigation Buttons */}
                    <div className="form-navigation d-flex justify-content-between mt-4">
                      <Button 
                        variant="outline-secondary" 
                        onClick={handlePrevious}
                        disabled={currentStep === 1}
                        className="prev-btn d-flex align-items-center"
                        size="lg"
                        style={outlineButtonStyle}
                      >
                        <FaArrowLeft className="btn-icon me-2" /> Previous
                      </Button>
                      
                      <Button 
                        variant="primary" 
                        onClick={handleNext}
                        className="next-btn d-flex align-items-center"
                        size="lg"
                        style={buttonGradient}
                      >
                        {currentStep === totalSteps ? 'Submit Registration' : 'Next'} 
                        {currentStep !== totalSteps && <FaArrowRight className="btn-icon ms-2" />}
                      </Button>
                    </div>
                  </form>
                </FormProvider>
              )}
            </Card.Body>
          </Card>
        </Col>
      </Row>
    </Container>
  );
};

export default VesselOwnerRegistrationPage;
