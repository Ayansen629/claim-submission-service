.dashboard-stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
}

.dashboard-stat-cell {
  height: 100%;
  min-width: 0;
}

.status-card,
.survey-tracker-card {
  min-height: 320px;
  height: 100%;
  display: flex;
  flex-direction: column;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  background: #fff;
  border: none;
  transition: all 0.3s ease;
}

.status-card-content {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  padding: 24px;
  height: 100%;
}

.survey-tracker-card .status-card-content {
  padding-bottom: 0;
}

.survey-tracker-card .calendar-wrapper {
  flex: 1 1 auto;
  min-height: 160px;
  max-height: 180px;
  overflow: auto;
  margin-top: 8px;
  margin-bottom: 8px;
}

.survey-calendar {
  width: 100% !important;
  font-size: 13px;
  border: none !important;
  background: transparent !important;
}
