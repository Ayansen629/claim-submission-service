/* Add to employeeDashboard.css */
.row.g-3 {
  display: flex;
  flex-wrap: wrap;
  margin-right: -0.5rem;
  margin-left: -0.5rem;
}

.row.g-3 > [class*="col-"] {
  padding-right: 0.5rem;
  padding-left: 0.5rem;
  margin-bottom: 1rem;
  display: flex;
}

.status-card {
  height: 100%;
  min-height: 220px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  border: none;
  background: #fff;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  width: 100%;
}

.status-card-content {
  padding: 20px;
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* Media queries for responsive layout */
@media (max-width: 992px) {
  .row.g-3 > [class*="col-lg-6"] {
    flex: 0 0 100%;
    max-width: 100%;
  }
}

@media (max-width: 768px) {
  .row.g-3 > [class*="col-md-8"] {
    flex: 0 0 100%;
    max-width: 100%;
  }
}
