import { toast } from "react-toastify";
import VesselInfo from "../common/VesselInfo";
import { useNavigate } from "react-router-dom";

const TransferOfRegistry = () => {
    const navigate = useNavigate();
    const handleViewRegistry = (rowData) => {
        console.log("Viewing registry for:", rowData);
        const regNo = rowData?.registrationNo || "";
        if (!regNo) {
            toast.warning("Registration Number missing...", {
                position: "top-right",
            });
            return;
        }
        navigate(`/vessel-registration/transfer-of-registry-application?applicationNo=${regNo}`, {
            state: {
                rowData: { ...rowData },
            },
        });
    };
    return (
        <>
            <VesselInfo handleViewAction={handleViewRegistry}/>
        </>
    );
};
export default TransferOfRegistry;
import { useTranslation } from "react-i18next";
import { headerStyle } from "../../../../utils/constants.ts";
// import {
//     VESSEL_COLUMNS,
// } from "../../dashboard/vessel-owner/vesselconstants";
import { useEffect, useState } from "react";
import Collapsible from "../../../common/Collapsible.js";
import { FaClipboardList } from "react-icons/fa";
import { Button, Card, Col, Form, InputGroup, Row } from "react-bootstrap";
import InputText from "../../../common/InputText.tsx";
import InputDateRangePicker from "../../../common/InputDateRangePicker.jsx";
import { BsFilter, BsSearch } from "react-icons/bs";
import ActionTable from "../../../common/ActionTable.tsx";
import "../../dashboard/vessel-owner/vesselOwner.css";
import "../../employee/employeeDashboard.css";
import vesselIcon from "../../../../assets/images/svg-images/shipIcon.svg";

const generateVesselData = (count = 20) => {
    const vesselNames = [
        "Sea Explorer",
        "Ocean Pearl",
        "River Queen",
        "Blue Horizon",
        "Mariner Spirit",
        "Harbor Star",
        "Atlantic Voyager",
        "Pacific Dream",
        "Golden Wave",
        "Silver Tide",
    ];

    const vesselTypes = [
        "Passenger",
        "Non-Passenger",
        "Cargo",
        "Fishing",
        "Ferry",
        "Container",
    ];

    return Array.from({ length: count }, (_, i) => {
        const registeredYear = 2015 + Math.floor(Math.random() * 11); // 2015 - 2025
        const lastSurveyDate = new Date(
            registeredYear + Math.floor(Math.random() * 10), // survey after registration
            Math.floor(Math.random() * 12),
            Math.floor(Math.random() * 28) + 1
        )
            .toISOString()
            .split("T")[0];

        return {
            id: i + 1,
            registrationNo: `WB${String(1000 + i).padStart(4, "0")}`,
            vesselName: vesselNames[Math.floor(Math.random() * vesselNames.length)],
            registeredYear,
            lastSurveyDate,
            vesselType: vesselTypes[Math.floor(Math.random() * vesselTypes.length)],
        };
    });
};

const VesselInfo = ({ handleViewAction = (rowData) => { } }) => {
    const { t } = useTranslation();

    const [filterParams, setFilterParams] = useState({
        applicationNumbers: [""],
        vesselName: "",
        toDate: "",
        fromDate: "",
    });
    const [vesselData, setVesselData] = useState([]);

    const [vesselSearchTerm, setVesselSearchTerm] = useState("");
    const [filteredVesselData, setFilteredVesselData] = useState([]);
    const [vesselCurrentPage, setVesselCurrentPage] = useState(2);
    // For Vessel Table
    const VESSEL_COLUMNS = [
        {
            colName: "sl",
            fieldName: "slNo",
            clsName: "column-text-start",
            minWidth: '3rem'
        },
        {
            colName: "Registration No",
            fieldName: "registrationNo",
            clsName: "column-text-start",
            isLink: true,
        },
        {
            colName: "Vessel Type",
            fieldName: "vesselType",
            clsName: "column-text-start",
        },
        {
            colName: "Vessel Name",
            fieldName: "vesselName",
            clsName: "column-text-start",
        },
        {
            colName: "RegistrationDate",
            fieldName: "registeredYear",
            clsName: "column-text-center",
        },
        {
            colName: "Last Survey Date",
            fieldName: "lastSurveyDate",
            clsName: "column-text-center",
        },

    ]
    const vesselColumns = VESSEL_COLUMNS.map((col) => ({
        ...col,
        colName: t(`dashboard.${col.colName}`),
    }));
    console.log("vesselColumns ", vesselColumns);
    const [dateRange, setDateRange] = useState({
        startDate: null,
        endDate: null,
        key: "selection",
    });

    useEffect(() => {
        const data = generateVesselData(15);
        setVesselData(data);
        setFilteredVesselData(data);
    }, []);

    useEffect(() => {
        const results = vesselData?.filter(
            (item) =>
                item.registrationNo
                    ?.toLowerCase()
                    ?.includes(vesselSearchTerm?.toLowerCase()) ||
                item.vesselName
                    ?.toLowerCase()
                    ?.includes(vesselSearchTerm?.toLowerCase()) ||
                item.registeredYear
                    ?.toString()
                    ?.toLowerCase()
                    ?.includes(vesselSearchTerm?.toLowerCase()) ||
                item.lastSurveyDate
                    ?.toLowerCase()
                    ?.includes(vesselSearchTerm?.toLowerCase()) ||
                item.vesselType
                    ?.toLowerCase()
                    ?.includes(vesselSearchTerm?.toLowerCase())
        );
        setFilteredVesselData(results);
        setVesselCurrentPage(1);
    }, [vesselSearchTerm, vesselData]);

    function formatDate(dateStr) {
        const date = new Date(dateStr);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
    }

    const handleChangeFilter = (key, value) => {
        setFilterParams((prev) => {
            const newParams = { ...prev };
            if (key === "applicationNumbers") {
                newParams.applicationNumbers = [value ? value : ""];
            } else if (key === "dateRange") {
                const startDate = value?.startDate ? formatDate(value.startDate) : "";
                const endDate = value?.endDate ? formatDate(value.endDate) : "";
                newParams.fromDate = startDate;
                newParams.toDate = endDate;
            } else {
                newParams[key] = value ? value : "";
            }
            return newParams;
        });
    };
    const itemsVesselPerPage = 5;
    const handleVesselTablePageChange = (page) => {
        setVesselCurrentPage(page);
    };
    return (
        <Collapsible
            title={
                <>
                    <img
                        src={vesselIcon}
                        alt="Vessel-Icon"
                        className="me-2"
                        style={{
                            width: "2rem",
                            height: "2rem",
                            maxWidth: "100%",
                        }}
                    />
                    <span>{t("dashboard.Vessel Information")}</span>
                </>
            }
            newDesign={true}
            openStat={true}>

            <form
                style={{ padding: "2rem", margin: 0 }}
            // onSubmit={handleSubmit(onSubmitFilterForm)}
            >
                <Row>
                    <Col md={3}>
                        <InputText
                            type="text"
                            name="applicationNumbers"
                            label={t("dashboard.Registration No.")}
                            placeholder={t("dashboard.Enter Registration No.")}
                            value={filterParams.applicationNumbers[0]}
                            onChange={(e) =>
                                handleChangeFilter("applicationNumbers", e.target.value)
                            }
                        />
                    </Col>
                    <Col md={3}>
                        <InputText
                            type="text"
                            name="vesselName"
                            label={t("dashboard.Vessel Name")}
                            placeholder={t("dashboard.Enter Vessel name..")}
                            value={filterParams.vesselName}
                            onChange={(e) =>
                                handleChangeFilter("vesselName", e.target.value)
                            }
                        />
                    </Col>
                    <Col md={4}>
                        <InputDateRangePicker
                            label={t("dashboard.Date Range")}
                            value={dateRange}
                            onChange={(range) => {
                                handleChangeFilter("dateRange", range);
                            }}
                            // register={register}
                            name="dateRange"
                        // error={errors.dateRange}
                        />
                    </Col>
                    <Col md={2}>
                        <button
                            style={{ position: "relative", top: "1.8rem" }}
                            className="generic-btn-submit search-btn"
                            type="button"
                        // onClick={fetchDashboardData}
                        >
                            {t("dashboard.Filter")}
                        </button>
                    </Col>
                </Row>
            </form>

            <Card className="bg-transparent dashboard-card">
                <Card.Header
                    style={headerStyle}
                    className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
                >
                    <div className="d-flex align-items-center">
                        <h6 className="mb-0 me-2">{t("dashboard.Vessel List")}</h6>
                    </div>
                    <div className="d-flex align-items-center">
                        {/* <Button variant="outline-secondary" className="filter-btn me-2">
                            <BsFilter size={18} />
                            <span className="ms-1 d-none d-sm-inline">
                                {t("dashboard.Filter")}
                            </span>
                        </Button> */}
                        <Form className="inbox-search">
  <InputGroup>
    <InputGroup.Text className="search-icon-wrapper">
      <BsFilter size={16} />
    </InputGroup.Text>
    <Form.Control
      type="text"
      placeholder={t("dashboard.Search Vessels...")}
      aria-label="Search"
      value={vesselSearchTerm}
      onChange={(e) => setVesselSearchTerm(e.target.value)}
    />
    <Button className="search-btn">
      <BsSearch />
    </Button>
  </InputGroup>
</Form>
                    </div>
                </Card.Header>

                <div style={{ position: "relative", bottom: "2rem" }}>
                    <ActionTable
                        columns={vesselColumns}
                        // handleEditRow={handleEditAction}
                        // onApplyInitialSurvey={handleApplySurvey}
                        // onPaySupervisionFee={handlePaySupervisionFeePayment}
                        onViewRow={(row) => handleViewAction(row)}
                        islink={true}
                        // onUploadReports={(row) =>
                        //   handleButtonBasedEvents(row, "uploadReports")
                        // }
                        // onVesselRegistration={(row) =>
                        //   handleButtonBasedEvents(row, "vesselRegistration")
                        // }
                        rowData={filteredVesselData}
                        tableHeader={null}
                        hideExportBtn={true}
                        hideSearchBar={true}
                        pagination={true}
                        inboxCurrentPage={vesselCurrentPage}
                        itemsInboxPerPage={itemsVesselPerPage}
                        onPageChange={handleVesselTablePageChange}
                        noDataText={
                            <div className="no-results text-center py-4">
                                <BsSearch size={24} className="mb-2" />
                                <p>No results found</p>
                                <small>
                                    Try adjusting your search to find what you're looking for.
                                </small>
                            </div>
                        }
                    // onDownloadCMN={handleDownloadCMN}
                    // onSlotBooking={(row) => handleSlotBooking(row, "slotBooking")}
                    />
                </div>
                <div style={{ height: "3rem" }}>     </div>
            </Card>

        </Collapsible>
    );
};
export default VesselInfo;
