import React, { useState } from 'react';
import { Modal, Button } from 'react-bootstrap';
import { format, addDays, setHours, setMinutes } from 'date-fns';
import 'bootstrap/dist/css/bootstrap.min.css';
import './AppointmentModal.css';

const AppointmentModal = ({ show, handleClose, handleConfirm }) => {
  // Generate date and time slots
  const generateSlots = () => {
    const slots = [];
    const today = new Date();
    
    // For each of the next 7 days
    for (let i = 0; i < 7; i++) {
      const date = addDays(today, i);
      const dateFormatted = format(date, 'MMM d, yyyy');
      const daySlots = [];
      
      // Generate different number of slots for each day (example pattern)
      const slotCount = i === 0 ? 4 : i === 1 ? 3 : i === 2 ? 5 : 4;
      
      for (let j = 0; j < slotCount; j++) {
        const hour = 9 + j; // Starting at 9 AM
        const startTime = setHours(setMinutes(date, 0), hour);
        const endTime = setHours(setMinutes(date, 0), hour + 1);
        
        daySlots.push({
          id: `${date.getTime()}-${j}`,
          start: startTime,
          end: endTime,
          display: `${hour}:00 AM - ${hour + 1}:00 AM`,
          dateDisplay: dateFormatted,
          fullDisplay: `${hour}:00 AM - ${hour + 1}:00 AM, ${dateFormatted}`
        });
      }
      
      slots.push(...daySlots);
    }
    
    return slots;
  };

  const [selectedSlot, setSelectedSlot] = useState(null);
  const timeSlots = generateSlots();

  return (
    <Modal show={show} onHide={handleClose} centered size="md">
      <Modal.Header closeButton className="border-bottom-0 pb-0">
        <Modal.Title className="fs-5">Select Appointment Slot</Modal.Title>
      </Modal.Header>
      
      <Modal.Body className="pt-1">
        <div className="slots-list">
          {timeSlots.map((slot) => (
            <div 
              key={slot.id}
              className={`slot-item p-2 mb-2 rounded ${selectedSlot?.id === slot.id ? 'selected' : ''}`}
              onClick={() => setSelectedSlot(slot)}
            >
              <div className="d-flex justify-content-between align-items-center">
                <div>
                  <span className="fw-medium">{slot.display}</span>
                  <span className="text-muted ms-2">{slot.dateDisplay}</span>
                </div>
                {selectedSlot?.id === slot.id && (
                  <i className="bi bi-check-circle-fill text-primary"></i>
                )}
              </div>
            </div>
          ))}
        </div>
      </Modal.Body>
      
      <Modal.Footer className="border-top-0 pt-0">
        <Button variant="outline-secondary" size="sm" onClick={handleClose}>
          Cancel
        </Button>
        <Button 
          variant="primary" 
          size="sm"
          onClick={() => {
            if (selectedSlot) {
              handleConfirm(selectedSlot);
              handleClose();
            }
          }}
          disabled={!selectedSlot}
        >
          Confirm Appointment
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default AppointmentModal;
