import React from "react";
import {
  Container,
  Row,
  Col,
  Card,
  Button,
  Navbar,
  Nav,
} from "react-bootstrap";
import { NavDropdown } from "react-bootstrap";
import Banner from "../../assets/images/Banner.png";
import Ship from "../../assets/images/ship.png";
import Tower from "../../assets/images/tower.jpg";
import Map from "../../assets/images/map.png";
import vector from "../../assets/images/Vector.png";
import transfer from "../../assets/images/transfer.png";
import Navigation from "../../assets/images/Navigation.png";
import Suitcase from "../../assets/images/suitcase.png";
import Profile from "../../assets/images/pic.png";
import Notebook from "../../assets/images/note.svg";
import tick from "../../assets/images/tick.png";
import iwtnote from "../../assets/images/iwtnote.svg";
import Shield from "../../assets/images/Shield.png";
import Arrow from "../../assets/images/arrow.png";
import LastIcon from "../../assets/images/lasticon.png";
import Linkedin from "../../assets/images/Linkedin.png";
import Instagram from "../../assets/images/Instagram.png";
import HeaderLogo from "../../assets/images/bengal-logo.png";
import Login from "../../assets/images/iwtlogin.png";

const IWTHomePage = () => {
  // ... (keep all your existing constants and data arrays same as before)

  return (
    <div className="iwt-homepage">
      {/* Updated Header Section */}
      <div className="hero-banner" style={{ backgroundImage: `url(${Banner})` }}>
        <Navbar expand="lg" variant="dark" className="transparent-navbar">
          <Container fluid className="px-4">
            <Navbar.Brand href="#home" className="d-flex align-items-center">
              <img
                src={HeaderLogo}
                alt="Logo"
                className="navbar-logo"
                style={{ width: "60px", height: "60px" }}
              />
              <span className="ms-3 d-block" style={{ fontSize: "1.2rem", lineHeight: "1.2" }}>
                Inland Water Transport
                <br />
                <small className="text-muted" style={{ fontSize: "0.9rem" }}>Government of West Bengal</small>
              </span>
            </Navbar.Brand>

            {/* Keep navbar toggle and collapse same */}

          </Container>
        </Navbar>
      </div>

      {/* Updated Vessel Registration Section */}
      <section className="vessel-registration py-5 bg-light">
        <Container fluid="xxl" className="px-4">
          <div className="section-header mb-5">
            <h2 className="section-title">Vessel Registration</h2>
            {/* Keep description same */}
          </div>
          <Row className="align-items-stretch g-4">
            <Col xl={6} className="mb-4 mb-xl-0">
              <Row className="g-3 h-100">
                {vesselRegistrationItems.map((item, index) => (
                  <Col md={6} key={index}>
                    <Card className="h-100 service-card">
                      <Card.Body className="d-flex flex-column">
                        <div className="d-flex align-items-start">
                          <div className="icon-container me-3">
                            <img 
                              src={item.icon} 
                              alt={item.title}
                              className="zoom-icon"
                            />
                          </div>
                          <div className="content-wrapper">
                            <h5 className="service-title">{item.title}</h5>
                            <p className="service-description">{item.description}</p>
                          </div>
                        </div>
                        <Button variant="link" className="service-link p-0 mt-auto align-self-start">
                          <img src={Navigation} alt="Navigate" className="nav-icon"/>
                        </Button>
                      </Card.Body>
                    </Card>
                  </Col>
                ))}
              </Row>
            </Col>
            <Col xl={6} className="h-100 d-flex align-items-stretch">
              <div className="image-container h-100 w-100">
                <img 
                  src={Ship} 
                  alt="IWT Ship" 
                  className="img-fluid h-100 w-100" 
                  style={{ 
                    objectFit: 'cover', 
                    borderRadius: '10px',
                    minHeight: '600px' 
                  }} 
                />
              </div>
            </Col>
          </Row>
        </Container>
      </section>

      {/* Updated Vessel Survey Section */}
      <section className="vessel-survey py-5">
        <Container fluid="xxl" className="px-4">
          <div className="section-header mb-5">
            <h2 className="section-title">Vessel Survey</h2>
            {/* Keep description same */}
          </div>
          <Row className="align-items-stretch g-4">
            <Col lg={6} className="order-lg-2 h-100 mb-4 mb-lg-0">
              <Row className="g-3 h-100">
                {vesselSurveyItems.map((item, index) => (
                  <Col md={6} key={index}>
                    <Card className="h-100 service-card">
                      <Card.Body className="d-flex flex-column">
                        <div className="d-flex align-items-start">
                          <div className="icon-container me-3">
                            <img 
                              src={item.icon} 
                              alt={item.title}
                              className="zoom-icon"
                            />
                          </div>
                          <div className="content-wrapper">
                            <h5 className="service-title">{item.title}</h5>
                            <p className="service-description">{item.description}</p>
                          </div>
                        </div>
                        <Button variant="link" className="service-link p-0 mt-auto align-self-start">
                          <img src={Navigation} alt="Navigate" className="nav-icon"/>
                        </Button>
                      </Card.Body>
                    </Card>
                  </Col>
                ))}
              </Row>
            </Col>
            <Col lg={6} className="order-lg-1 h-100 d-flex align-items-stretch">
              <div className="image-container h-100 w-100">
                <img 
                  src={Tower} 
                  alt="Survey Tower" 
                  className="img-fluid h-100 w-100" 
                  style={{ 
                    borderRadius: '10px',
                    objectFit: 'cover',
                    minHeight: '600px'
                  }} 
                />
              </div>
            </Col>
          </Row>
        </Container>
      </section>

      {/* Updated Social Feed Section */}
      <section className="social-news py-5 bg-light">
        <Container>
          <Row className="gx-4">
            <Col lg={8} className="mb-5 mb-lg-0">
              <div className="section-header mb-4">
                <h2 className="section-title">Social Feed</h2>
              </div>
              <Card className="social-card h-100 shadow-sm">
                <Card.Body className="p-4 d-flex flex-column">
                  <Row className="h-100">
                    <Col md={6} className="border-end pe-md-4 mb-4 mb-md-0" style={{ paddingRight: "2rem" }}>
                      {/* LinkedIn Content */}
                    </Col>
                    <Col md={6} className="ps-md-4" style={{ paddingLeft: "2rem" }}>
                      {/* Instagram Content */}
                    </Col>
                  </Row>
                </Card.Body>
              </Card>
            </Col>
            {/* Keep news section same */}
          </Row>
        </Container>
      </section>

      {/* Keep other sections same */}

      {/* Updated CSS */}
      <style jsx>{`
        .iwt-homepage {
          font-size: 1rem;
          line-height: 1.5;
        }

        .service-card {
          height: 100%;
          min-height: 180px;
          display: flex;
          flex-direction: column;
          transition: transform 0.3s, box-shadow 0.3s;
        }
        
        .service-card .card-body {
          flex: 1;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
        }
        
        .image-container {
          position: relative;
          overflow: hidden;
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }
        
        .social-card .col-md-6:not(:last-child) {
          margin-right: 1rem;
        }
        
        .social-card .col-md-6:not(:first-child) {
          margin-left: 1rem;
        }

        .icon-container {
          width: 3em;
          height: 3em;
          min-width: 3em;
          padding: 0.5em;
          background: #f0f7ff;
          border-radius: 0.5em;
          display: flex;
          align-items: center;
          justify-content: center;
        }

        .zoom-icon {
          width: 1.5em;
          height: 1.5em;
          object-fit: contain;
        }

        .nav-icon {
          width: 1.25em;
          height: 1.25em;
        }

        @media (max-width: 768px) {
          .image-container {
            min-height: 400px;
          }
        }
      `}</style>
    </div>
  );
};

export default IWTHomePage;
