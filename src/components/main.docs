import React, { useState, useCallback, useMemo, memo } from "react";
import { Table, Button, Form } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { FaFire, FaCog, FaCompass, FaUsers, FaShieldAlt, FaBolt, FaHome, FaPlus, FaTrash } from "react-icons/fa";

// Mock components to replace the imports
const Collapsible = ({ title, openStat, children }) => (
  <div className="collapsible mb-3">
    <div className="collapsible-header bg-light p-3 d-flex align-items-center">
      {title}
    </div>
    <div className="collapsible-content p-3 border">
      {children}
    </div>
  </div>
);

const InputText = ({ name, type = "text", placeholder, register, errors, disabled }) => (
  <Form.Control
    type={type}
    placeholder={placeholder}
    isInvalid={errors && errors[name]}
    disabled={disabled}
    {...register(name)}
  />
);

const InputSelect = ({ name, options, value, onChange, errors, disabled, style }) => {
  const handleChange = (e) => {
    onChange(e.target.value);
  };

  return (
    <Form.Select
      value={value || ""}
      onChange={handleChange}
      isInvalid={errors && errors[name]}
      disabled={disabled}
      style={style}
    >
      {options.map((option) => (
        <option key={option.value} value={option.value}>
          {option.label}
        </option>
      ))}
    </Form.Select>
  );
};

// Mock context and utils
const useMasterData = () => ({
  masterData: {
    equipmentCategories: [
      {
        id: 1,
        equipmentName: "Fire Fighting Items",
        equipmentCategories: [
          { categoryCode: "fireFightingPlan", categoryLable: "Fire Fighting Plan" },
          { categoryCode: "firePumpsMech", categoryLable: "Fire Pumps (Mech)" }
        ]
      },
      {
        id: 2,
        equipmentName: "Life-Saving Equipment",
        equipmentCategories: [
          { categoryCode: "lifejackets", categoryLable: "Life jackets" },
          { categoryCode: "liferafts", categoryLable: "Life rafts" }
        ]
      }
    ]
  }
});

const getFromLocalStorage = (key) => "VESSEL_OWNER";

// Constants
export const conditionOptions = [
  { value: "", label: "Select Condition" },
  { value: "GOOD", label: "Good" },
  { value: "FAIR", label: "Fair" },
  { value: "POOR", label: "Poor" },
  { value: "NOT_AVAILABLE", label: "Not Available" },
];

export const initialEquipementData = {
  equipment: {},
  deckSpaces: [
    {
      deckType: "",
      size: "",
      function: "",
      maxPassengers: "",
      remarks: ""
    }
  ],
  freeboard: {
    minFreeboard: "",
    numPassengers: "",
    cargo: ""
  }
};

const EquipmentTableRow = memo(({ 
  category, 
  fieldName, 
  register, 
  errors, 
  watch, 
  handleConditionChange, 
  isFieldDisabled,
  viewMode 
}) => {
  // Watch the current condition value to ensure proper display
  const currentCondition = watch(`${fieldName}.condition`);
  
  return (
    <tr>
      <td>{category.categoryLable}</td>
      <td>
        <InputText
          name={`${fieldName}.number`}
          type="number"
          placeholder="Enter number"
          register={register}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`${fieldName}.type`}
          placeholder="Enter type"
          register={register}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`${fieldName}.capacity`}
          placeholder="Enter capacity"
          register={register}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`${fieldName}.location`}
          placeholder="Enter location"
          register={register}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      {viewMode && (
        <>
          <td>
            <InputSelect
              name={`${fieldName}.condition`}
              options={conditionOptions}
              value={currentCondition || ""}
              onChange={(value) => handleConditionChange(`${fieldName}.condition`, value)}
              errors={errors}
              disabled={false}
              style={{ minWidth: "150px", width: "100%" }}
            />
          </td>
          <td>
            <InputText
              name={`${fieldName}.remarks`}
              placeholder="Enter remarks"
              register={register}
              errors={errors}
              disabled={false}
            />
          </td>
        </>
      )}
    </tr>
  );
});

const DeckSpaceRow = memo(({ 
  index, 
  register, 
  errors, 
  isFieldDisabled, 
  handleRemoveDeck, 
  deckFields 
}) => {
  return (
    <tr>
      <td>
        <InputText
          name={`deckSpaces.${index}.deckType`}
          placeholder="Enter Deck/Space Type"
          register={register}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`deckSpaces.${index}.size`}
          placeholder="Enter Size"
          register={register}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`deckSpaces.${index}.function`}
          placeholder="Enter Function"
          register={register}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`deckSpaces.${index}.maxPassengers`}
          type="number"
          placeholder="Enter Max. No. of Passenger"
          register={register}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`deckSpaces.${index}.remarks`}
          placeholder="Enter Remarks"
          register={register}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      {deckFields?.length > 1 && !isFieldDisabled && (
        <td className="text-center align-middle">
          <Button
            variant="outline-danger"
            onClick={() => handleRemoveDeck(index)}
            type="button"
            className="deck-remove-btn"
          >
            <FaTrash className="me-2" /> Remove
          </Button>
        </td>
      )}
    </tr>
  );
});

const RenderDynamicEquipmentTable = memo(({ equipment, register, errors, watch, handleConditionChange, isFieldDisabled, viewMode, getEquipmentIcon }) => {
  return (
    <Collapsible
      title={
        <>
          {getEquipmentIcon(equipment.equipmentName)}
          <span>{equipment.equipmentName}</span>
        </>
      }
      openStat={true}
    >
      <div className="table-container">
        <Table striped bordered hover responsive className="mb-0 equipment-table">
          <thead>
            <tr>
              <th>{equipment.equipmentName}</th>
              <th>Number</th>
              <th>Type</th>
              <th>Capacity</th>
              <th>Location</th>
              {viewMode && (
                <>
                  <th>Condition</th>
                  <th>Remarks</th>
                </>
              )}
            </tr>
          </thead>
          <tbody>
            {equipment.equipmentCategories.map((category) => {
              const fieldName = `equipment.${equipment.id}.${category.categoryCode}`;
              return (
                <EquipmentTableRow
                  key={category.categoryCode}
                  category={category}
                  fieldName={fieldName}
                  register={register}
                  errors={errors}
                  watch={watch}
                  handleConditionChange={handleConditionChange}
                  isFieldDisabled={isFieldDisabled}
                  viewMode={viewMode}
                />
              );
            })}
          </tbody>
        </Table>
      </div>
    </Collapsible>
  );
});

const VesselEquipmentForm = ({ formMethods, viewMode = false, editMode = false }) => {
  const { t } = useTranslation();
  const { masterData } = useMasterData();
  
  const userRole = getFromLocalStorage("userRole");
  const isVesselOwner = userRole === "VESSEL_OWNER";
  
  const isFieldDisabled = viewMode || (isVesselOwner && !editMode);

  // Mock useForm hook
  const [formData, setFormData] = useState({
    equipment: {
      1: {
        fireFightingPlan: { number: "", type: "", capacity: "", location: "", condition: "", remarks: "" },
        firePumpsMech: { number: "", type: "", capacity: "", location: "", condition: "", remarks: "" }
      },
      2: {
        lifejackets: { number: "", type: "", capacity: "", location: "", condition: "", remarks: "" },
        liferafts: { number: "", type: "", capacity: "", location: "", condition: "", remarks: "" }
      }
    },
    deckSpaces: initialEquipementData.deckSpaces,
    freeboard: initialEquipementData.freeboard
  });

  const handleChange = (field, value) => {
    const fieldParts = field.split('.');
    setFormData(prev => {
      const newData = {...prev};
      let current = newData;
      
      for (let i = 0; i < fieldParts.length - 1; i++) {
        current = current[fieldParts[i]];
      }
      
      current[fieldParts[fieldParts.length - 1]] = value;
      return newData;
    });
  };

  const handleConditionChange = useCallback((fieldName, value) => {
    handleChange(fieldName, value);
  }, []);

  const handleAddDeck = useCallback(() => {
    setFormData(prev => ({
      ...prev,
      deckSpaces: [...prev.deckSpaces, {...initialEquipementData.deckSpaces[0]}]
    }));
  }, []);

  const handleRemoveDeck = useCallback((index) => {
    setFormData(prev => ({
      ...prev,
      deckSpaces: prev.deckSpaces.filter((_, i) => i !== index)
    }));
  }, []);

  // Mock register function
  const register = (fieldName) => {
    const fieldParts = fieldName.split('.');
    let value = formData;
    
    for (const part of fieldParts) {
      value = value[part];
    }
    
    return {
      value: value || "",
      onChange: (e) => handleChange(fieldName, e.target.value)
    };
  };

  // Mock watch function
  const watch = (fieldName) => {
    const fieldParts = fieldName.split('.');
    let value = formData;
    
    for (const part of fieldParts) {
      value = value[part];
      if (value === undefined) return "";
    }
    
    return value;
  };

  // Memoize equipment icons to prevent re-renders
  const getEquipmentIcon = useMemo(() => {
    const iconMap = {
      "Fire Fighting Items": <FaFire className="me-2" style={{ color: "#2466BF" }} />,
      "Equipments": <FaCog className="me-2" style={{ color: "#2466BF" }} />,
      "Navigational Equipments": <FaCompass className="me-2" style={{ color: "#2466BF" }} />,
      "Life-Saving Equipment": <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />,
      "Machinery/Electrical": <FaBolt className="me-2" style={{ color: "#2466BF" }} />,
      "Accommodation/Safety": <FaHome className="me-2" style={{ color: "#2466BF" }} />
    };
    return (equipmentName) => iconMap[equipmentName] || <FaCog className="me-2" style={{ color: "#2466BF" }} />;
  }, []);

  const equipmentTables = useMemo(() => {
    if (!masterData?.equipmentCategories) return null;
    
    return masterData.equipmentCategories.map((equipment) => (
      <RenderDynamicEquipmentTable
        key={equipment.id}
        equipment={equipment}
        register={register}
        errors={{}}
        watch={watch}
        handleConditionChange={handleConditionChange}
        isFieldDisabled={isFieldDisabled}
        viewMode={viewMode}
        getEquipmentIcon={getEquipmentIcon}
      />
    ));
  }, [masterData?.equipmentCategories, isFieldDisabled, viewMode, getEquipmentIcon, handleConditionChange]);

  const deckRows = useMemo(() => {
    return formData.deckSpaces.map((deck, index) => (
      <DeckSpaceRow
        key={index}
        index={index}
        register={register}
        errors={{}}
        isFieldDisabled={isFieldDisabled}
        handleRemoveDeck={handleRemoveDeck}
        deckFields={formData.deckSpaces}
      />
    ));
  }, [formData.deckSpaces, isFieldDisabled, handleRemoveDeck]);

  return (
    <div className="vessel-equipment-form p-4">
      <style>
        {`
          .vessel-equipment-form {
            overflow-anchor: none;
          }
          
          .table-container {
            max-height: 400px;
            overflow-y: auto;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
          }
          
          .equipment-table {
            margin-bottom: 0;
          }
          
          .equipment-table thead th {
            position: sticky;
            top: 0;
            background-color: #f8f9fa;
            z-index: 10;
            color: #2466BF;
            font-weight: 600;
          }
          
          .equipment-table td {
            min-width: 150px;
            vertical-align: middle;
            padding: 8px;
          }
          
          .equipment-table select {
            min-width: 150px !important;
            width: 100% !important;
          }
          
          .equipment-table .form-select {
            min-width: 150px !important;
            width: 100% !important;
          }
          
          .deck-remove-btn {
            transition: all 0.2s ease;
            min-width: 100px;
          }
          
          .deck-remove-btn:hover {
            transform: scale(1.05);
          }
          
          .table-container::-webkit-scrollbar {
            width: 8px;
            height: 8px;
          }
          
          .table-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
          }
          
          .table-container::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 4px;
          }
          
          .table-container::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
          }

          .collapsible-header {
            cursor: pointer;
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
          }
          
          .collapsible-content {
            border: 1px solid #dee2e6;
            border-top: none;
            border-radius: 0 0 0.375rem 0.375rem;
          }
        `}
      </style>
      
      <h3 className="mb-4">Vessel Equipment Form</h3>
      
      {equipmentTables}

      <Collapsible
        title={
          <>
            <FaUsers className="me-2" style={{ color: "#2466BF" }} />
            <span>Location of passengers on specific decks and spaces in maximum loaded condition</span>
          </>
        }
        openStat={true}
      >
        <div className="p-3">
          <div className="table-container">
            <Table striped bordered hover responsive className="mb-0">
              <thead>
                <tr>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>Deck/Space Type</th>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>Size</th>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>Function</th>
                  <th style={{ fontWeight: "600", color: "#2466BF", minWidth: "200px" }}>Max. No. of Passenger</th>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>Remarks</th>
                  {formData.deckSpaces?.length > 1 && !isFieldDisabled && (
                    <th style={{ fontWeight: "600", color: "#2466BF", minWidth: "150px" }}>Actions</th>
                  )}
                </tr>
              </thead>
              <tbody>
                {deckRows}
              </tbody>
            </Table>
          </div>
          {!isFieldDisabled && (
            <Button
              variant="outline-primary"
              onClick={handleAddDeck}
              className="mt-3"
              type="button"
            >
              <FaPlus className="me-2" /> Add Deck/Space
            </Button>
          )}
        </div>
      </Collapsible>

      <Collapsible
        title={
          <>
            <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />
            <span>Freeboard</span>
          </>
        }
        openStat={true}
      >
        <div className="p-3">
          <Table striped bordered hover responsive className="mb-0">
            <thead>
              <tr>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>Minimum freeboard</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>Number of Passengers</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>Cargo (Tonne)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <InputText
                    name={'freeboard.minFreeboard'}
                    placeholder={'Enter Minimum Freeboard'}
                    register={register}
                    errors={{}}
                    disabled={isFieldDisabled}
                  />
                </td>
                <td>
                  <InputText
                    name={'freeboard.numPassengers'}
                    type={"number"}
                    placeholder={'Enter Number of Passengers'}
                    register={register}
                    errors={{}}
                    disabled={isFieldDisabled}
                  />
                </td>
                <td>
                  <InputText
                    name={'freeboard.cargo'}
                    placeholder={'Enter Cargo (Tonne)'}
                    register={register}
                    errors={{}}
                    disabled={isFieldDisabled}
                  />
                </td>
              </tr>
            </tbody>
          </Table>
        </div>
      </Collapsible>

      <div className="mt-4">
        <Button variant="primary" className="me-2">Save</Button>
        <Button variant="secondary">Cancel</Button>
      </div>
    </div>
  );
};

export default VesselEquipmentForm;
