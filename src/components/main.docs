useEffect(() => {
  if (!registrationData?.enclosers) return;

  console.log("Processing enclosers for form population:", registrationData.enclosers);

  const typeMap = {
    'REGISTRATION_CERTIFICATE': 'certificateOfRegistration',
    'NOC_FROM_ORIGINAL_REGISTRATION_AUTHORITY': 'NOCfromOriginalRegistrationAuthority', 
    'SURVEY_COPY_OF_LAST_CERTIFICATE_OF_SURVEY': 'lastSurveyCertificate',
    'TONNAGE_BOOKLETS': 'tonnageBooklet',
    'STABILITY_BOOKLETS': 'stabilityBooklet',
    'INSURANCE_CERTIFICATE': 'insuranceCertificate',
    'PAYMENT_CHALLAN_OR_ACKNOWLEDGEMENT': 'paymentChallan'
  };

  // Process single file documents
  registrationData.enclosers.forEach(doc => {
    const fieldName = typeMap[doc.documentType];
    
    if (fieldName && doc.fileStoreId) {
      const fileObject = {
        name: doc.documentName,
        fileStoreId: doc.fileStoreId,
        originalName: doc.documentName
      };

      console.log(`Setting enclosure.${fieldName} with:`, fileObject);
      
      // Set the main file object
      setValue(`enclosure.${fieldName}`, fileObject);
      
      // Set the fileStoreId separately
      setValue(`enclosure.${fieldName}FileStoreId`, doc.fileStoreId);
      
      // Set the original name
      setValue(`enclosure.${fieldName}OriginalName`, doc.documentName);

      // Update fileStates for UI
      setFileStates(prev => ({
        ...prev,
        [fieldName]: fileObject
      }));
    }
  });

}, [registrationData?.enclosers, setValue]);
