import React, { useState } from "react";
import { Button, Card } from "react-bootstrap";
import { BsPlus } from "react-icons/bs";
import { useTranslation } from "react-i18next";
import ActionTable from "../../../../../common/ActionTable.tsx";
import FileReportsUploadModal from "../../../../../common/FileReportsUploadModal.jsx";
import Collapsible from "../../../../../common/Collapsible.js";

const ReportsDashboard = () => {
  const { t } = useTranslation();
  const [showFileModal, setShowFileModal] = useState(false);
  const [currentReportType, setCurrentReportType] = useState("");
  const [reports, setReports] = useState({
    materialTest: [
      {
        id: 1,
        fileName: "material_test_1.pdf",
        description: t("Initial material test results"),
        remarks: t("Approved"),
      },
      {
        id: 2,
        fileName: "material_test_2.pdf",
        description: t("Follow-up material analysis"),
        remarks: t("Pending review"),
      },
    ],
    radiography: [
      {
        id: 1,
        fileName: "radiography_report_1.pdf",
        description: t("X-ray inspection results"),
        remarks: t("Completed"),
      },
      {
        id: 2,
        fileName: "radiography_report_2.pdf",
        description: t("Ultrasonic testing report"),
        remarks: t("Approved"),
      },
    ],
    inspection: [
      {
        id: 1,
        fileName: "inspection_report_1.pdf",
        description: t("Quarterly inspection"),
        remarks: t("Completed"),
      },
      {
        id: 2,
        fileName: "inspection_report_2.pdf",
        description: t("Annual safety check"),
        remarks: t("Pending corrections"),
      },
    ],
    other: [
      {
        id: 1,
        fileName: "other_report_1.pdf",
        description: t("Additional documentation"),
        remarks: t("N/A"),
      },
      {
        id: 2,
        fileName: "other_report_2.pdf",
        description: t("Supplementary notes"),
        remarks: t("For reference"),
      },
    ],
  });

  const REPORT_COLUMNS = [
    {
      colName: t("Add Attachment"),
      fieldName: "fileName",
      clsName: "column-text-start",
    },
    {
      colName: t("Description"),
      fieldName: "description",
      clsName: "column-text-start",
    },
    {
      colName: t("Action"),
      fieldName: "action",
      actions: [ 'delete', 'download'],
      clsName: "col-sm-2 column-text-start actions-column",
    },
  ];

  const handleAddReport = (reportType) => {
    setCurrentReportType(reportType);
    setShowFileModal(true);
  };

  const handleFileUpload = (uploadedReport) => {
    if (uploadedReport) {
      const newReport = {
        id: Date.now(),
        fileName: uploadedReport.documentName,
        description: uploadedReport.description || t("No description"),
        remarks: t("Uploaded"),
      };

      setReports((prev) => ({
        ...prev,
        [currentReportType]: [...prev[currentReportType], newReport],
      }));
    }
  };

  const handleViewReport = (rowData, reportType) => {
    console.log("View report:", rowData, reportType);
    alert(t("Viewing report") + `: ${rowData.fileName}`);
  };

  const handleDeleteReport = (rowData, reportType) => {
    if (window.confirm(t("Are you sure you want to delete this report?"))) {
      setReports(prev => ({
        ...prev,
        [reportType]: prev[reportType].filter(report => report.id !== rowData.id)
      }));
    }
  };

  const handleDownloadReport = (rowData, reportType) => {
    console.log("Download report:", rowData, reportType);
    alert(t("Downloading report") + `: ${rowData.fileName}`);
  };

  const renderReportTable = (reportType, reportData, title) => {
    return (
      <Collapsible title={title} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <div className="d-flex justify-content-end mb-3">
            <Button
              variant="primary"
              size="sm"
              onClick={() => handleAddReport(reportType)}
            >
              <BsPlus size={20} /> {t("Add")}
            </Button>
          </div>

          <ActionTable
            columns={REPORT_COLUMNS}
            rowData={reportData}
            tableHeader={null}
            hideExportBtn={true}
            hideSearchBar={true}
            pagination={false}
            onViewRow={(rowData) => handleViewReport(rowData, reportType)}
            onDeleteRow={(rowData) => handleDeleteReport(rowData, reportType)}
            download={(rowData) => handleDownloadReport(rowData, reportType)}
            noDataText={t("No reports available")}
          />
        </div>
      </Collapsible>
    );
  };

  return (
    <Card className="mt-4">
      <Card.Body style={{ padding: 0 }}>
        <div className="reports-section">
          {renderReportTable("materialTest", reports.materialTest, t("Material Test Report"))}
          {renderReportTable("radiography", reports.radiography, t("Radiography Report"))}
          {renderReportTable("inspection", reports.inspection, t("Inspection Report"))}
          {renderReportTable("other", reports.other, t("Other Report"))}
        </div>
      </Card.Body>

      <FileReportsUploadModal
        show={showFileModal}
        onHide={() => setShowFileModal(false)}
        reportType={currentReportType}
        onSubmit={handleFileUpload}
      />
    </Card>
  );
};

export default ReportsDashboard;
