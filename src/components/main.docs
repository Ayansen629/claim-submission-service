import React, { useState } from "react";
import { Row, Col, Table } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { formatDate } from "../../../../../utils/constants.ts";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import styles from "./ProvisionalCertificate.module.css";

const ProvisionalCertificateOfSurvey = ({ registrationData, surveyData }) => {
  const { t } = useTranslation();
  
  const employeeDetailsString = getFromLocalStorage("employeeDetails");
  const employeeDetails = employeeDetailsString ? JSON.parse(employeeDetailsString) : {};
  
  const currentDate = new Date();
  const expiryDate = new Date(currentDate.getTime() + (60 * 24 * 60 * 60 * 1000)); 
  
  const certificateNo = `PCS/${new Date().getFullYear()}/${Math.floor(Math.random() * 10000).toString().padStart(4, '0')}`;

  // State for editable fields
  const [editableFields, setEditableFields] = useState({
    category: registrationData?.vessel?.category || "A",
    expiryDay: expiryDate.getDate().toString().padStart(2, '0'),
    expiryMonth: (expiryDate.getMonth() + 1).toString().padStart(2, '0'),
    expiryYear: expiryDate.getFullYear().toString(),
    zoneOfOperation: registrationData?.vessel?.zone || "Zone 1",
    loadingMarks: "Yes",
    plyingLimit: "12",
    cargoCapacity: surveyData?.freeboard?.cargo || "100",
    passengers: surveyData?.freeboard?.numPassengers || "50",
    crew: "5",
    lifeboats: "2",
    buoyantApparatus: "4",
    lifebuoys: "12",
    lifejackets: "25",
    foamExtinguishers: "3",
    sodaAcidExtinguishers: "2",
    carbonPowderExtinguishers: "4",
    anchors: "2",
    anchorCable: "50m",
    hose: "30m"
  });

  const handleFieldChange = (fieldName, value) => {
    setEditableFields({
      ...editableFields,
      [fieldName]: value
    });
  };

  return (
    <div className={styles.certificateContainer}>
      <div className={styles.certificateHeader}>
        <h4 className={styles.certificateTitle}>{t("Provisional Certificate of Survey")}</h4>
      </div>

      <div className={styles.certificateBody}>
        {/* Basic Certificate Info */}
        <Row className={styles.mb3}>
          <Col md={3}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Category")}:</span>
              <input
                type="text"
                className={styles.editableField}
                value={editableFields.category}
                onChange={(e) => handleFieldChange("category", e.target.value)}
              />
            </div>
          </Col>
          <Col md={9}>
            <div className={styles.expirySection}>
              <span className={styles.fieldLabel}>{t("Expiry on or before the")}:</span>
              <span className={styles.dateFields}>
                <input
                  type="text"
                  className={styles.dateInput}
                  value={editableFields.expiryDay}
                  onChange={(e) => handleFieldChange("expiryDay", e.target.value)}
                />
                <span className={styles.dateSeparator}>-</span>
                <input
                  type="text"
                  className={styles.dateInput}
                  value={editableFields.expiryMonth}
                  onChange={(e) => handleFieldChange("expiryMonth", e.target.value)}
                />
                <span className={styles.dateSeparator}>-</span>
                <input
                  type="text"
                  className={styles.dateInput}
                  value={editableFields.expiryYear}
                  onChange={(e) => handleFieldChange("expiryYear", e.target.value)}
                />
              </span>
            </div>
          </Col>
        </Row>

        <Row className={styles.mb3}>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Provisional Certificate of Survey No.")}:</span>
              <span className={styles.fieldValue}>{certificateNo}</span>
            </div>
          </Col>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Zone of operation")}:</span>
              <input
                type="text"
                className={styles.editableField}
                value={editableFields.zoneOfOperation}
                onChange={(e) => handleFieldChange("zoneOfOperation", e.target.value)}
              />
            </div>
          </Col>
        </Row>

        <Row className={styles.mb4}>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Date of Issue")}:</span>
              <span className={styles.fieldValue}>{formatDate(currentDate)}</span>
            </div>
          </Col>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Date of Expiry")}:</span>
              <span className={styles.fieldValue}>{formatDate(expiryDate)}</span>
            </div>
          </Col>
        </Row>

        <div className={`${styles.certificateStatement} ${styles.mb4}`}>
          <p>{t("This Provisional Certificate of Survey has been issued subsequent to Survey carried out of the below detailed inland vessel.")}</p>
        </div>

        {/* Vessel Details */}
        <div className={`${styles.vesselDetails} ${styles.mb4}`}>
          <Row className={styles.mb2}>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Name of the Vessel")}:</span>
                <span className={styles.fieldValue}>{registrationData?.vessel?.vesselName || "N/A"}</span>
              </div>
            </Col>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Official No.")}:</span>
                <span className={styles.fieldValue}>{registrationData?.vessel?.registrationNo || "N/A"}</span>
              </div>
            </Col>
          </Row>

          <Row className={styles.mb2}>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Port of Registry")}:</span>
                <span className={styles.fieldValue}>{registrationData?.vessel?.registry || "N/A"}</span>
              </div>
            </Col>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Certificate of Registry No.")}:</span>
                <span className={styles.fieldValue}>{registrationData?.vessel?.certificateNo || "N/A"}</span>
              </div>
            </Col>
          </Row>

          <Row className={styles.mb2}>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Gross Tonnage")}:</span>
                <span className={styles.fieldValue}>{registrationData?.vessel?.grt || "N/A"}</span>
              </div>
            </Col>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Registered Tonnage")}:</span>
                <span className={styles.fieldValue}>{surveyData?.basicVesselInfo?.netTonnage || "N/A"}</span>
              </div>
            </Col>
          </Row>

          <Row className={styles.mb2}>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Freeboard Assigned")}:</span>
                <span className={styles.fieldValue}>{surveyData?.freeboard?.minFreeboard || "N/A"}</span>
              </div>
            </Col>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Loading marks placed on the vessel's side")}:</span>
                <select
                  className={styles.editableSelect}
                  value={editableFields.loadingMarks}
                  onChange={(e) => handleFieldChange("loadingMarks", e.target.value)}
                >
                  <option value="Yes">Yes</option>
                  <option value="No">No</option>
                </select>
              </div>
            </Col>
          </Row>

          <Row className={styles.mb2}>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Name of the Master")}:</span>
                <span className={styles.fieldValue}>{registrationData?.vessel?.nameOfMaster || "N/A"}</span>
              </div>
            </Col>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Master's COC Grade")}:</span>
                <span className={styles.fieldValue}>Grade II</span>
              </div>
            </Col>
          </Row>

          <Row className={styles.mb2}>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("COC No.")}:</span>
                <span className={styles.fieldValue}>COC123456</span>
              </div>
            </Col>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Place of Issue")}:</span>
                <span className={styles.fieldValue}>{registrationData?.vessel?.placeOfBuild || "N/A"}</span>
              </div>
            </Col>
          </Row>

          <Row className={styles.mb2}>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Name of the Engineer or Engine Driver")}:</span>
                <span className={styles.fieldValue}>Engineer Name</span>
              </div>
            </Col>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("COC Grade of the Engineer or Engine Driver")}:</span>
                <span className={styles.fieldValue}>Grade I</span>
              </div>
            </Col>
          </Row>

          <Row className={styles.mb2}>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("COC No.")}:</span>
                <span className={styles.fieldValue}>ENG789012</span>
              </div>
            </Col>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Place of Issue")}:</span>
                <span className={styles.fieldValue}>{registrationData?.vessel?.placeOfBuild || "N/A"}</span>
              </div>
            </Col>
          </Row>

          <Row className={styles.mb2}>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Name of Owner")}:</span>
                <span className={styles.fieldValue}>{registrationData?.owner?.name || "N/A"}</span>
              </div>
            </Col>
            <Col md={6}>
              <div className={styles.infoField}>
                <span className={styles.fieldLabel}>{t("Address of Owner")}:</span>
                <span className={styles.fieldValue}>{registrationData?.owner?.address || "N/A"}</span>
              </div>
            </Col>
          </Row>
        </div>

        {/* Survey Details */}
        <Row className={styles.mb4}>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Date of Survey carried out")}:</span>
              <span className={styles.fieldValue}>{formatDate(currentDate)}</span>
            </div>
          </Col>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Place of survey carried out")}:</span>
              <span className={styles.fieldValue}>{surveyData?.basicVesselInfo?.placeYardNo || "N/A"}</span>
            </div>
          </Col>
        </Row>

        {/* Plying Limits */}
        <div className={`${styles.plyingLimits} ${styles.mb4}`}>
          <h6 className={styles.sectionTitle}>{t("PLYING LIMITS (as applicable):")}</h6>
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Within inland waters limits")}:</span>
            <span className={styles.plyingInputContainer}>
              <input
                type="text"
                className={styles.plyingInput}
                value={editableFields.plyingLimit}
                onChange={(e) => handleFieldChange("plyingLimit", e.target.value)}
              />
              <span className={styles.plyingText}>{t("Nautical Miles from the nearest shore.")}</span>
            </span>
          </div>
        </div>

        {/* Cargo/Passenger Capacity */}
        <div className={`${styles.capacitySection} ${styles.mb4}`}>
          <h6 className={styles.sectionTitle}>{t("CARGO/PASSENGER CAPACITY")}</h6>
          <div className={styles.capacityFields}>
            <div className={styles.capacityField}>
              <span className={styles.capacityLabel}>{t("Maximum permissible cargo carriage capacity")}:</span>
              <input
                type="text"
                className={styles.capacityInput}
                value={editableFields.cargoCapacity}
                onChange={(e) => handleFieldChange("cargoCapacity", e.target.value)}
              />
            </div>
            <div className={styles.capacityField}>
              <span className={styles.capacityLabel}>{t("Passengers")}:</span>
              <input
                type="text"
                className={styles.capacityInput}
                value={editableFields.passengers}
                onChange={(e) => handleFieldChange("passengers", e.target.value)}
              />
            </div>
            <div className={styles.capacityField}>
              <span className={styles.capacityLabel}>{t("Crew")}:</span>
              <input
                type="text"
                className={styles.capacityInput}
                value={editableFields.crew}
                onChange={(e) => handleFieldChange("crew", e.target.value)}
              />
            </div>
          </div>
        </div>

        {/* Safety Equipment Table */}
        <div className={`${styles.safetyEquipment} ${styles.mb4}`}>
          <h6 className={styles.sectionTitle}>{t("Safety equipment carried on the vessel:")}</h6>
          <Table bordered className={styles.safetyTable}>
            <thead>
              <tr>
                <th>{t("No. of boats size and cubic capacity")}</th>
                <th>{t("No. of Buoyant apparatus or Life rafts")}</th>
                <th colSpan="2">{t("No. of Lifebuoys and lifejackets")}</th>
                <th colSpan="3">{t("Fire extinguishers")}</th>
                <th colSpan="3">{t("No. of Anchor with their weight")}</th>
              </tr>
              <tr>
                <th></th>
                <th></th>
                <th>{t("Lifebuoys")}</th>
                <th>{t("Lifejackets")}</th>
                <th>{t("Foam Type")}</th>
                <th>{t("Soda Acid")}</th>
                <th>{t("Dry Carbon Powder")}</th>
                <th>{t("Anchor Cable")}</th>
                <th>{t("Length Size")}</th>
                <th>{t("Hose")}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableFields.lifeboats}
                    onChange={(e) => handleFieldChange("lifeboats", e.target.value)}
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableFields.buoyantApparatus}
                    onChange={(e) => handleFieldChange("buoyantApparatus", e.target.value)}
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableFields.lifebuoys}
                    onChange={(e) => handleFieldChange("lifebuoys", e.target.value)}
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableFields.lifejackets}
                    onChange={(e) => handleFieldChange("lifejackets", e.target.value)}
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableFields.foamExtinguishers}
                    onChange={(e) => handleFieldChange("foamExtinguishers", e.target.value)}
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableFields.sodaAcidExtinguishers}
                    onChange={(e) => handleFieldChange("sodaAcidExtinguishers", e.target.value)}
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableFields.carbonPowderExtinguishers}
                    onChange={(e) => handleFieldChange("carbonPowderExtinguishers", e.target.value)}
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableFields.anchors}
                    onChange={(e) => handleFieldChange("anchors", e.target.value)}
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableFields.anchorCable}
                    onChange={(e) => handleFieldChange("anchorCable", e.target.value)}
                  />
                </td>
                <td>
                  <input
                    type="text"
                    className={styles.tableInput}
                    value={editableFields.hose}
                    onChange={(e) => handleFieldChange("hose", e.target.value)}
                  />
                </td>
              </tr>
            </tbody>
          </Table>
        </div>

        {/* Certificate Statement */}
        <div className={`${styles.certificateStatement} ${styles.mb4}`}>
          <p className={styles.certificationText}>
            <strong>{t("THIS IS TO CERTIFY")}</strong> {t("that the provisions of the rules with respect to the survey of the above mentioned Inland Vessel and the Transmission of declaration in respect thereof, have been complied with.")}
          </p>
        </div>

        <div className={`${styles.validityStatement} ${styles.mb4}`}>
          <p>
            {t("This Provisional Certificate of Survey, issued under the provisions of section 13(1) of the Inland Vessels Act, 2021 continues to be in force only until the")} <strong>({formatDate(expiryDate)})</strong>
          </p>
        </div>
      </div>
    </div>
  );
};

export default ProvisionalCertificateOfSurvey;
