import React, { useState, useEffect, useRef } from "react";
import { useForm, FormProvider } from "react-hook-form";
import { Container, Row, Col, Button, Card, Badge } from "react-bootstrap";
import {
  FaFileUpload,
  FaArrowLeft,
  FaArrowRight,
  FaArrowAltCircleLeft,
  FaCheckCircle,
  FaUser,
  FaBuilding,
} from "react-icons/fa";
import { BsFileEarmarkPdf, BsDownload } from "react-icons/bs";
import { useNavigate, useParams, useLocation } from "react-router-dom";
import ActionDropdown from "../../../common/ActionDropdown";
import ApprovalModal from "../../../common/ApprovalModal";
import "./userViewPage.css";
import NewLoader from "../../../common/NewLoader";
import DynamicViewFields from "../../../common/DynamicViewFields";
import { useTranslation } from "react-i18next";
import { getFromLocalStorage } from "../../../../utils/localStorageUtils";
import {
  SERVICE_BASE,
  URLS_ENDPOINT,
} from "../../../../utils/urlsConstants.ts";
import { toast } from "react-toastify";
import { postData } from "../../../../services/http.service.ts";
import { handleErrorMessage } from "../../../../utils/errorMessageHandler";
import { getDocumentsForOwner } from "../../../public/user-registration/registration-docs.config.js";

const UserViewPage = () => {
  const { t } = useTranslation();
  const { type, id } = useParams();
  const location = useLocation();
  const applicationInfo = location.state?.application;
  const userRole = getFromLocalStorage("userRole");
  const userDetails = getFromLocalStorage("userDetails")
    ? JSON.parse(getFromLocalStorage("userDetails"))
    : "";
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(true);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [completedSteps, setCompletedSteps] = useState(new Set());
  const navigate = useNavigate();
  const [actionsFromAPI, setActionsFromAPI] = useState([]);
  const loaderRef = useRef();

  const isOwner = applicationInfo?.userType === "VESSEL_OWNER";
  const isBuilder = applicationInfo?.userType === "VESSEL_BUILDER";
  const totalSteps = isOwner ? 3 : 2;

  const mapFilesByFieldName = (fileStoreMap = []) => {
    const mappingConfig = {
      pancard: "panCardUpload",
      gstcertificate: "gstCertificate", 
      addressproof: "addressProof",
      letterofauthorization: "authorizationLetter",
      companyregistrationcertificate: "companyRegistrationCertificate",
      moacertificate: "moaCertificate",
      aoacertificate: "aoaCertificate",
      tradelicense: "tradeLicenseUpload",
      aadhaar: "aadhaarUpload",
      "driving license": "dlUpload",
      // Company specific documents
      "cos_reg_cert": "cosRegCertUpload",
      "cos_resolution": "cosResolutionUpload",
      "be_cos_reg_docs": "beCosRegDocsUpload",
      "be_cos_gov_docs": "beCosGovDocsUpload",
      "be_cos_resolution": "beCosResolutionUpload",
      "comp_reg_cert": "compRegCertUpload",
      "comp_moa_aoa": "compMoaAoaUpload",
      "comp_board_resolution": "compBoardResUpload",
      "partner_reg_cert": "partnerRegCertUpload",
      "partner_deed": "partnerDeedUpload",
      "trust_reg_cert": "trustRegCertUpload",
      "trust_deed": "trustDeedUpload",
      "fdi_reg_cert": "fdiRegCertUpload",
      "fdi_resolution": "fdiResolutionUpload",
      "fdi_proof": "fdiProofUpload",
      "vsl_bareboat": "vslBareboatUpload",
      "vsl_charterer_proof": "vslChartererProofUpload",
      "state_aoa": "stateAoaUpload",
      "state_moa": "stateMoaUpload",
      "cent_aoa": "centralAoaUpload",
      "cent_moa": "centralMoaUpload",
      "local_aoa": "localAoaUpload",
      "local_moa": "localMoaUpload",
      "other_pan": "otherPanUpload",
      "other_gst": "otherGstUpload",
      // Builder documents
      "company details": "companyDetails",
      "pan card": "panCardUpload",
      "factory license": "factoryLicense",
      "fire certificate": "fireCertificate",
      "esipf registration": "esipfRegistration",
      "iso 9001": "iso9001",
      "iso 14001": "iso14001",
      "iso 45001": "iso45001",
      "pollution certificate": "pollutionCertificate",
      "experience certificate": "experienceCertificate",
      "address proof": "addressProof",
      "gst certificate": "gstCertificate",
    };

    const regularFiles = {};
    const additionalFiles = [];

    fileStoreMap.forEach(file => {
      const fieldName = file?.fieldName?.toLowerCase();
      if (!fieldName) return;

      // Check if it's an additional document
      if (fieldName.includes('additional_docs')) {
        additionalFiles.push(file);
        return;
      }

      
      const matchedKey = Object.keys(mappingConfig).find(key =>
        fieldName.includes(key)
      );

      if (matchedKey) {
        regularFiles[mappingConfig[matchedKey]] = file;
      }
    });

    return { regularFiles, additionalFiles };
  };

  useEffect(() => {
    setIsLoading(true);
    loaderRef.current?.show?.();

    if (applicationInfo) {
      let processedData = {};

      if (isOwner && applicationInfo.ownerDetails) {
        const ownerData = applicationInfo.ownerDetails;
        const { regularFiles, additionalFiles } = mapFilesByFieldName(ownerData.fileStoreMap);

        processedData = {
          categoryOfOwner: ownerData.categoryOfOwner,
          ownerCompanyName: ownerData.ownerCompanyName,
          emailId: ownerData.emailId,
          phoneNumber: ownerData.phoneNumber,
          panNo: ownerData.panNo,
          gstNo: ownerData.gstNo,
          addressLine1: ownerData.addressLine1,
          addressLine2: ownerData.addressLine2,
          pin: ownerData.pin,
          district: ownerData.district,
          state: ownerData.state,
          country: ownerData.country,
          authorisedFname: ownerData.authorisedFname,
          authorisedLname: ownerData.authorisedLname,
          authorisedMob: ownerData.authorisedMob,
          authorisedEmail: ownerData.authorisedEmail,
          aadharNumber: ownerData.aadharNumber,
          tradeLicenseNumber: ownerData.tradeLicenseNumber,
          cinNo: ownerData.cinNo,
          dinNo: ownerData.dinNo,
          registrationNumber: applicationInfo.userBasicDetails.registrationNumber,
          status: applicationInfo.userBasicDetails.isActive ? "Approved" : "Pending Review",
          fileStoreMap: ownerData.fileStoreMap || [],
          additionalDocuments: additionalFiles,
          ...regularFiles,
        };
      } else if (isBuilder && applicationInfo.builderDetails) {
        const builderData = applicationInfo.builderDetails;
        const { regularFiles, additionalFiles } = mapFilesByFieldName(builderData.fileStoreMap);

        processedData = {
          builderName: builderData.builderName,
          emailId: builderData.emailId,
          phoneNumber: builderData.phone,
          panNo: builderData.panNo,
          gstNo: builderData.gstNo,
          addressLine1: builderData.addressLine1,
          addressLine2: builderData.addressLine2,
          pin: builderData.pin,
          district: builderData.district,
          state: builderData.state,
          country: builderData.country,
          registrationNumber: applicationInfo.userBasicDetails.registrationNumber,
          status: applicationInfo.userBasicDetails.isActive ? "Approved" : "Pending Review",
          fileStoreMap: builderData.fileStoreMap || [],
          additionalDocuments: additionalFiles,
          ...regularFiles,
        };
      }

      setFormData(processedData);
      setActionsFromAPI(
        applicationInfo?.processActionMapResponce?.processs[0]?.actions || []
      );
      setCompletedSteps(new Set([1]));
    }

    setTimeout(() => {
      setIsLoading(false);
      loaderRef.current?.hide?.();
    }, 500);
  }, [applicationInfo, isOwner, isBuilder]);

  const methods = useForm({ defaultValues: { country: "India" } });
  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading && Object.keys(formData)?.length > 0) {
      Object?.keys(formData)?.forEach((key) => {
        if (formData[key] !== undefined && formData[key] !== null) {
          setValue(key, formData[key]);
        }
      });
    }
  }, [isLoading, formData, setValue]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const workflowApplicationSubmit = async (modalFormData) => {
    loaderRef?.current?.show();

    try {
      const URL = `${SERVICE_BASE.IWT_WORKFLOW}${URLS_ENDPOINT.WORK_FLOW_SERVICE.WORKFLOW_ACTION}`;

      const userName =
        userDetails?.userName ||
        JSON.parse(getFromLocalStorage("userDetails"))?.userName ||
        "";

      const payload = {
        applicationNo: applicationInfo?.userBasicDetails?.registrationNumber,
        processId: applicationInfo?.processActionMapResponce?.processs?.[0]?.processId,
        actionId: selectedAction?.actionId,
        assignerRole: userRole,
        assignerName: userName,
        fileId: modalFormData?.document?.url ?? "",
        remarks: modalFormData?.reason ?? "",
      };

      const { status, data } = await postData(URL, payload);
      const { responseStatus } = data || {};

      if (status === 200 && responseStatus?.status === "200") {
        toast.success(responseStatus?.message || "Action submitted successfully");
        handleCloseModal();

        setTimeout(() => navigate("/user-registration/view"), 2000);
      } else {
        toast.info(responseStatus?.message || "Something went wrong..", {
          position: "top-right",
        });
      }
    } catch (err) {
      console.error(err);
      handleErrorMessage(err?.response?.data);
    } finally {
      loaderRef?.current?.hide();
    }
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const getFormFieldsConfig = () => {
    if (isOwner) {
      return {
        step1: [
          {
            name: "categoryOfOwner",
            label: t("vesselOwnerRegistration.Category of Owner"),
            type: "text",
            colSize: 6,
          },
