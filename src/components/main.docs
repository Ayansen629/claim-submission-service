  const handleFormSubmit = async (stepInfo) => {
    window.scrollTo({ top: 0, behavior: "smooth" });
    const formValues = stepInfo?.getFormData?.() || {};
    const newFormVals = {
      ...formValues, mainDrawingAndOtherDrawings: extractDocuments(formValues, ["DRAWING"]),
      radiographyReport: extractDocuments(formValues, ["RADIOGRAPHY_REPORT"]),
      materialTestReport: extractDocuments(formValues, ["MATERIAL_TEST_REPORT"]),
      otherInspectionReport: extractDocuments(formValues, ["OTHER_INSPECTION_REPORT"]),
      otherTechnicalDocument: extractDocuments(formValues, ["OTHER_TECH_DOC"]),
    }
    if (stepInfo.index === 0) {
