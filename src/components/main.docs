import React, { useState, useEffect } from "react";
import { Row, Col, Form, Button, InputGroup, ListGroup } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile.tsx";
import InputText from "../../../common/InputText.tsx";
import { renameFile } from "../../../../utils/constants.ts";
import { BsDownload, BsSearch, BsFileEarmarkPdf } from "react-icons/bs";

const Documents = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  const [workOrderFiles, setWorkOrderFiles] = useState([{ id: 1 }]);
  const [drawingsFiles, setDrawingsFiles] = useState([{ id: 1 }]);
  
  // Search states
  const [workOrderSearch, setWorkOrderSearch] = useState("");
  const [drawingsSearch, setDrawingsSearch] = useState("");
  
  const {
    register,
    watch,
    setValue,
    clearErrors,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  useEffect(() => {
    if (viewMode) {
      const workOrderIds = [];
      const drawingIds = [];
      
      for (let i = 1; i <= 50; i++) {
        if (watch(`workOrder_file_${i}`)) {
          workOrderIds.push({ id: i });
        }
        if (watch(`drawings_file_${i}`)) {
          drawingIds.push({ id: i });
        }
      }
      
      if (workOrderIds.length > 0) setWorkOrderFiles(workOrderIds);
      if (drawingIds.length > 0) setDrawingsFiles(drawingIds);
    }
  }, [viewMode, watch]);

  const getFilteredFiles = (files, searchTerm, type) => {
    if (!searchTerm) return files;
    return files.filter(file => {
      const fileName = watch(`${type}_file_${file.id}`)?.name || "";
      const description = watch(`${type}_desc_${file.id}`) || "";
      return fileName.toLowerCase().includes(searchTerm.toLowerCase()) ||
             description.toLowerCase().includes(searchTerm.toLowerCase());
    });
  };

  const DocumentListItem = ({ fileName, description, onDownload, fileSize }) => (
    <ListGroup.Item className="d-flex justify-content-between align-items-center py-2 px-3">
      <div className="d-flex align-items-center flex-grow-1">
        <BsFileEarmarkPdf className="text-danger me-2" size={20} />
        <div className="flex-grow-1">
          <div className="fw-semibold text-primary mb-1" style={{ fontSize: "0.9rem" }}>
            {fileName}
          </div>
          <div className="text-muted small">
            {description}
            {fileSize && <span className="ms-2 badge bg-light text-dark">{(fileSize / 1024 / 1024).toFixed(1)} MB</span>}
          </div>
        </div>
      </div>
      <Button
        variant="outline-primary"
        size="sm"
        onClick={() => onDownload(fileName)}
        className="ms-2"
        style={{ minWidth: "80px" }}
      >
        <BsDownload className="me-1" size={14} />
        Download
      </Button>
    </ListGroup.Item>
  );

  const FileSection = ({ title, files, searchTerm, setSearchTerm, type }) => {
    const filteredFiles = getFilteredFiles(files, searchTerm, type);
    const filesWithData = filteredFiles.filter(file => {
      const fileData = watch(`${type}_file_${file.id}`);
      return fileData && fileData.name;
    });

    return (
      <div className="border rounded-3 overflow-hidden" style={{ backgroundColor: "#ffffff", boxShadow: "0 2px 8px rgba(0,0,0,0.1)" }}>
        <div className="bg-light p-3 border-bottom">
          <div className="d-flex justify-content-between align-items-center mb-2">
            <h6 className="mb-0 fw-bold text-primary d-flex align-items-center">
              <BsFileEarmarkPdf className="me-2" />
              {title}
            </h6>
            <span className="badge bg-primary">{filesWithData.length} files</span>
          </div>
          
          {viewMode && filesWithData.length > 5 && (
            <InputGroup size="sm">
              <InputGroup.Text className="bg-white border-end-0">
                <BsSearch className="text-muted" />
              </InputGroup.Text>
              <Form.Control
                placeholder={`Search ${title.toLowerCase()}...`}
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                className="border-start-0"
                style={{ boxShadow: "none" }}
              />
            </InputGroup>
          )}
        </div>

        <div style={{ maxHeight: "500px", overflowY: "auto" }}>
          {viewMode ? (
            filesWithData.length > 0 ? (
              <ListGroup variant="flush">
                {filteredFiles.map((fileInput) => {
                  const fileData = watch(`${type}_file_${fileInput.id}`);
                  const descData = watch(`${type}_desc_${fileInput.id}`);
                  
                  if (fileData && fileData.name) {
                    return (
                      <DocumentListItem
                        key={fileInput.id}
                        fileName={fileData.name}
                        description={descData || `${title} document ${fileInput.id}`}
                        fileSize={fileData.size}
                        onDownload={() => handleDownload(fileData.name)}
                      />
                    );
                  }
                  return null;
                })}
              </ListGroup>
            ) : (
              <div className="text-center py-4 text-muted">
                <BsFileEarmarkPdf size={48} className="mb-2 opacity-50" />
                <div>No files found</div>
              </div>
            )
          ) : (
            <div className="p-3">
              {files.map((fileInput, idx) => (
                <div key={fileInput.id} className="mb-3 p-3 border rounded-2 bg-light">
                  <div className="mb-3">
                    <InputFile
                      label={`${t("Choose File")} ${idx + 1}`}
                      name={`${type}_file_${fileInput.id}`}
                      register={register(`${type}_file_${fileInput.id}`)}
                      errors={errors}
                      onChange={(e) => {
                        if (e.target.files && e?.target?.files[0]) {
                          const file = e.target.files[0];
                          
                          if (file.size > 10 * 1024 * 1024) {
                            setError(`${type}_file_${fileInput.id}`, {
                              type: 'manual',
                              message: t('File size should not exceed 10MB')
                            });
                            return;
                          }
                          
                          const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                          const fileName = `${title}${extension}`;
                          file.originalName = fileName;
                          const renamedFile = renameFile(file, fileName);

                          clearErrors(`${type}_file_${fileInput.id}`);
                          setValue(`${type}_file_${fileInput.id}`, renamedFile, { shouldValidate: true });
                          setFormData((prev) => ({
                            ...prev,
                            [`${type}_file_${fileInput.id}`]: renamedFile
                          }));
                        }
                      }}
                      watch={watch}
                      defaultValue={watch(`${type}_file_${fileInput.id}`)}
                      clearErrors={clearErrors}
                    />
                  </div>
                  <div className="mb-3">
                    <InputText
                      label={t("Description")}
                      name={`${type}_desc_${fileInput.id}`}
                      placeholder={t("Enter file description")}
                      register={register(`${type}_desc_${fileInput.id}`)}
                      errors={errors}
                      onChange={() => clearErrors(`${type}_desc_${fileInput.id}`)}
                    />
                  </div>
                  {files.length > 1 && (
                    <div className="text-end">
                      <Button
                        variant="outline-danger"
                        size="sm"
                        onClick={() => removeFileInput(type, fileInput.id)}
                      >
                        Remove
                      </Button>
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>

        {!viewMode && (
          <div className="p-3 bg-light border-top text-center">
            <Button
              variant="primary"
              size="sm"
              onClick={() => addFileInput(type)}
              style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
            >
              + Add {title}
            </Button>
          </div>
        )}
      </div>
    );
  };

  const addFileInput = (type) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      const newId = workOrderFiles.length > 0 ? Math.max(...workOrderFiles.map(f => f.id)) + 1 : 1;
      setWorkOrderFiles([...workOrderFiles, { id: newId }]);
    } else if (type === 'drawings') {
      const newId = drawingsFiles.length > 0 ? Math.max(...drawingsFiles.map(f => f.id)) + 1 : 1;
      setDrawingsFiles([...drawingsFiles, { id: newId }]);
    }
  };

  const removeFileInput = (type, id) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      setWorkOrderFiles(workOrderFiles.filter(file => file.id !== id));
    } else if (type === 'drawings') {
      setDrawingsFiles(drawingsFiles.filter(file => file.id !== id));
    }
    setValue(`${type}_file_${id}`, null);
    setValue(`${type}_desc_${id}`, "");
    clearErrors([`${type}_file_${id}`, `${type}_desc_${id}`]);
  };

  const handleDownload = (fileName) => {
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
  };

  return (
    <div>
      <Collapsible title={t("Documents")} openStat={true}>
        <div style={{ padding: "1.5rem", backgroundColor: "#f8f9fa" }}>
          <Row className="g-4">
            <Col lg={6} md={12}>
              <FileSection
                title={t("Work Order")}
                files={workOrderFiles}
                searchTerm={workOrderSearch}
                setSearchTerm={setWorkOrderSearch}
                type="workOrder"
              />
            </Col>

            <Col lg={6} md={12}>
              <FileSection
                title={t("Drawings")}
                files={drawingsFiles}
                searchTerm={drawingsSearch}
                setSearchTerm={setDrawingsSearch}
                type="drawings"
              />
            </Col>

            <Col md={6}>
              <div className="border rounded-3 p-3 bg-white" style={{ boxShadow: "0 2px 8px rgba(0,0,0,0.1)" }}>
                <InputFile
                  label={t('Tonnage Booklets')}
                  required={true}
                  name="tonnageBooklets"
                  register={register("tonnageBooklets")}
                  errors={errors}
                  onChange={(e) => {
                    if (e.target.files && e?.target?.files[0]) {
                      const file = e.target.files[0];
                      if (file.size > 10 * 1024 * 1024) {
                        setError("tonnageBooklets", {
                          type: 'manual',
                          message: t('File size should not exceed 10MB')
                        });
                        return;
                      }
                      const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                      const fileName = `Tonnage Booklets${extension}`;
                      file.originalName = fileName;
                      const renamedFile = renameFile(file, fileName);
                      clearErrors("tonnageBooklets");
                      setValue("tonnageBooklets", renamedFile, { shouldValidate: true });
                    }
                  }}
                  watch={watch}
                  accept=".pdf,.jpg,.jpeg,.png"
                  defaultValue={watch("tonnageBooklets")}
                  clearErrors={clearErrors}
                />
              </div>
            </Col>

            <Col md={6}>
              <div className="border rounded-3 p-3 bg-white" style={{ boxShadow: "0 2px 8px rgba(0,0,0,0.1)" }}>
                <InputFile
                  label={t('Stability Booklets')}
                  required={true}
                  name="stabilityBooklets"
                  register={register("stabilityBooklets")}
                  errors={errors}
                  onChange={(e) => {
                    if (e.target.files && e?.target?.files[0]) {
                      const file = e.target.files[0];
                      if (file.size > 10 * 1024 * 1024) {
                        setError("stabilityBooklets", {
                          type: 'manual',
                          message: t('File size should not exceed 10MB')
                        });
                        return;
                      }
                      const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                      const fileName = `Stability Booklets${extension}`;
                      file.originalName = fileName;
                      const renamedFile = renameFile(file, fileName);
                      clearErrors("stabilityBooklets");
                      setValue("stabilityBooklets", renamedFile, { shouldValidate: true });
                    }
                  }}
                  watch={watch}
                  accept=".pdf,.jpg,.jpeg,.png"
                  defaultValue={watch("stabilityBooklets")}
                  clearErrors={clearErrors}
                />
              </div>
            </Col>

            <Col md={12}>
              <div className="border rounded-3 p-3 bg-white" style={{ boxShadow: "0 2px 8px rgba(0,0,0,0.1)" }}>
                <div className="d-flex align-items-start">
                  <input
                    type="checkbox"
                    id="termsAccepted"
                    className="me-3 mt-1"
                    {...register("termsAccepted", { required: t('You must accept the terms and conditions') })}
                    disabled={viewMode}
                    checked={viewMode ? watch("termsAccepted") : undefined}
                  />
                  <div>
                    <label
                      htmlFor="termsAccepted"
                      className="mb-0 fw-medium"
                      style={{ color: "#333", cursor: viewMode ? "default" : "pointer", lineHeight: "1.4" }}
                    >
                      {t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.')}
                    </label>
                    {errors.termsAccepted && !viewMode && (
                      <div className="text-danger small mt-2">
                        {errors.termsAccepted.message}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </Col>
          </Row>
        </div>
      </Collapsible>
    </div>
  );
};

export default Documents;
