/* Dropdown toggle button */
.dropdownToggle {
  background: transparent;
  border: none;
  color: #6c757d;
  padding: 6px 10px;
  border-radius: 6px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dropdownToggle:hover {
  background-color: rgba(13, 110, 253, 0.08);
  color: #0d6efd;
  transform: translateY(-1px);
}

.dropdownToggle:focus {
  box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
}

.dotsContainer {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background-color: #6c757d;
  transition: all 0.3s ease;
}

.dropdownToggle:hover .dot {
  background-color: #0d6efd;
  transform: scale(1.2);
}

/* Dropdown menu */
.dropdownMenu {
  border: none;
  border-radius: 12px;
  padding: 8px;
  min-width: 240px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1), 0 5px 15px rgba(0, 0, 0, 0.07);
  animation: slideIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  background: #fff;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(8px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.dropdownHeader {
  padding: 12px 16px 8px;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #6c757d;
}

.headerDivider {
  height: 1px;
  background: linear-gradient(to right, transparent 0%, #e9ecef 20%, #e9ecef 80%, transparent 100%);
  margin: 8px 0 4px;
}

.menuItems {
  padding: 4px 0;
}

/* Dropdown items */
.dropdownItem {
  padding: 0;
  border-radius: 8px;
  margin: 4px 0;
  transition: all 0.2s ease;
  border: none;
}

.dropdownItem:hover {
  background: linear-gradient(135deg, #0d6efd, #0a58ca);
  transform: translateX(4px);
}

.itemContent {
  display: flex;
  align-items: center;
  padding: 10px 16px;
  font-size: 14px;
  color: #212529;
  transition: all 0.2s ease;
}

.dropdownItem:hover .itemContent {
  color: white;
}

.iconWrapper {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background-color: rgba(13, 110, 253, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  transition: all 0.3s ease;
}

.dropdownItem:hover .iconWrapper {
  background-color: rgba(255, 255, 255, 0.2);
  transform: scale(1.1);
}

.iconWrapper svg {
  color: #0d6efd;
  transition: all 0.3s ease;
}

.dropdownItem:hover .iconWrapper svg {
  color: white;
}

/* Special styling for delete item */
.deleteItem:hover {
  background: linear-gradient(135deg, #dc3545, #bd2130);
}

.deleteItem .iconWrapper {
  background-color: rgba(220, 53, 69, 0.1);
}

.deleteItem .iconWrapper svg {
  color: #dc3545;
}

/* Focus states for accessibility */
.dropdownItem:focus {
  outline: none;
}

.dropdownItem:focus .itemContent {
  background-color: rgba(13, 110, 253, 0.1);
  border-radius: 8px;
}
