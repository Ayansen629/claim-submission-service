const handleConfirm = async (appointments) => {
  setShowModal(false);
  try {
    const formattedAppointments = appointments.map(apt => ({
      date: apt.date.toLocaleDateString('en-GB'), // Format as DD/MM/YYYY
      timeSlot: apt.time,
      appointmentStatus: "PENDING",
      isBooked: false,
      bookedBy: null
    }));

    // Call parent component's handleSubmit with appointment data
    await onSubmitAppointments(formattedAppointments);
  } catch (error) {
    console.error("Error submitting appointments:", error);
  }
};
