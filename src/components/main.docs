const handleSaveDraft = async () => {
  setIsSavingDraft(true);
  try {
    const currentStepData = currentSubmitHandler ? await currentSubmitHandler() : {};
    const processedStepData = await processFileUploads(currentStepData, currentStep);

    // Get the last draft response from localStorage if available
    const lastDraftResponse = JSON.parse(localStorage.getItem("draftResponse") || "null");
    const draftId = lastDraftResponse?.data?.applicationDetails?.applicationNumber || "";

    // Prepare the draft data with existing UUIDs or generate new ones if not available
    const creditorBasicDetailsUuid = formData.creditorBasicDetailsUuid || uuidv4();
    const claimDetailsUuid = formData.claimDetailsUuid || uuidv4();
    const signatoryDetailsUuid = formData.signatoryDetailsUuid || uuidv4();

    const draftData = {
      ...formData,
      creditorBasicDetailsUuid,
      claimDetailsUuid,
      signatoryDetailsUuid,
      [`step${currentStep}`]: {
        ...formData[`step${currentStep}`],
        ...processedStepData,
      },
      id: draftId,
      status: "draft",
      lastSaved: new Date().toISOString(),
      currentStep,
      formType: userFormData?.formType,
      userType: userFormData?.userType,
    };

    // Create the draft payload - use last draft response data if available
    const draftPayload = lastDraftResponse 
      ? {
          ...lastDraftResponse.data,
          applicationDetails: {
            ...lastDraftResponse.data.applicationDetails,
            // Update with current form data
            creditorBasicDetails: {
              ...lastDraftResponse.data.applicationDetails.creditorBasicDetails,
              ...createFormPayload(draftData, false, userFormData, draftId, false).creditorBasicDetails
            },
            claimDetails: {
              ...lastDraftResponse.data.applicationDetails.claimDetails,
              ...createFormPayload(draftData, false, userFormData, draftId, false).claimDetails
            },
            signatoryDetails: {
              ...lastDraftResponse.data.applicationDetails.signatoryDetails,
              ...createFormPayload(draftData, false, userFormData, draftId, false).signatoryDetails
            }
          }
        }
      : {
          status: {
            code: "",
            message: ""
          },
          userInfo: userFormData?.fullloginDetails || {},
          applicationDetails: createFormPayload(draftData, false, userFormData, draftId, false),
        };

    console.log("Draft Payload:", draftPayload);

    // Make API call to save draft
    const REQUEST = `${process.env.REACT_APP_APPLICATION_SERVICE}${URLS_ENDPOINT.APP_SERVICES.APPLICATION_FORMSUBMIT}`;
    const response = await postData(REQUEST, draftPayload);

    if (response.data.status.code === "200") {
      // Save the response to localStorage for future updates
      localStorage.setItem("draftResponse", JSON.stringify(response));
      setDraftResponse(response); // Store in state

      // Update form data with the response data
      setFormData(prev => ({
        ...prev,
        creditorBasicDetailsUuid: response.data.applicationDetails.creditorBasicDetails.uuid,
        claimDetailsUuid: response.data.applicationDetails.claimDetails.uuid,
        signatoryDetailsUuid: response.data.applicationDetails.signatoryDetails.uuid,
        applicationNumber: response.data.applicationDetails.applicationNumber
      }));

      setHasPreviewed(true); // Enable preview after saving draft
      toast.success("Draft saved successfully");
    } else {
      toast.error(`Failed to save draft: ${response.data.status.message}`);
    }
  } catch (error) {
    console.error("Error saving draft:", error);
    toast.error("Failed to save draft");
  } finally {
    setIsSavingDraft(false);
  }
};
