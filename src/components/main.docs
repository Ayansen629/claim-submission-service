import React, {
  useRef,
  useState,
  useEffect,
  forwardRef,
  useImperativeHandle,
  use,
} from "react";
import { useNavigate, useParams, useLocation } from "react-router-dom";
import { useForm } from "react-hook-form";
import { Container, Row, Col, Card, Button } from "react-bootstrap";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";
import { FaUser, FaLock, FaDownload, FaTrash } from "react-icons/fa";
import InputFile from "../../../../common/InputFile.tsx";
import InputText from "../../../../common/InputText.tsx";
import InputSelect from "../../../../common/InputSelect.tsx";

import Collapsible from "../../../../common/Collapsible.js";
import { CONSTANT_REGEX, renameFile } from "../../../../../utils/constants.ts";
import { useMasterData } from "../../../../context/MasterDataContext.js";
import NewLoader from "../../../../common/NewLoader.js";
import {
  getData,
  postData,
  postFORMdata,
} from "../../../../../services/http.service.ts";
import {
  BASE_IP,
  SERVICE_BASE,
  URLS_ENDPOINT,
} from "../../../../../utils/urlsConstants.ts";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import axios from "axios";
import styles from "./RegistrationApplicationForm.module.css";
import { deleteFile } from "../../../../../utils/deleteFile.js";
import { BsEyeFill } from "react-icons/bs";
import { fetchAndViewFile } from "../../../../../utils/constants.ts";

const RegistrationApplicationForm = forwardRef(
  ({ registrationData, isViewMode = false, isFormSubmitted = false }, ref) => {
    const { t } = useTranslation();
    const { id } = useParams();
    const loaderRef = useRef();
    const { masterData } = useMasterData();
    const [isDataLoaded, setIsDataLoaded] = useState(false);
    const [suggestions, setSuggestions] = useState([]);
    const [isDeclarationEditable, setIsDeclarationEditable] = useState(false);

    const {
      register,
      formState: { errors },
      setValue,
      watch,
      clearErrors,
      trigger,
      setError,
    } = useForm({
      mode: "onChange",
      defaultValues: {
        ownerName: "",
        address: "",
        ownerType: "",
        builderEmail: "",
        applicantphoneNumber: "",
        ownerpin: "",
        // ownercity: "",
        ownerdistrict: "",
        ownerstateUt: "",
        occupation: "",
        originalPlaceOfBusiness: "",
        nameOfMaster: "",
        certificateNo: "",
        nameOfRegistry: "",
        registrationNo: "",
        vesselName: "",
        kindOfVessel: "",
        typeOfVessel: "",
        categoryOfVessel: "",
        zone: "",
        mortgage: "",
        placeOfBuild: "",
        detailsOfInsurance: "",
        vesselyearOfBuild: "",
        protectionAndIndemnityClubNo: "",
        protectionAndIndemnityClubName: "",
        insuranceValidUpto: "",
        yearOfBuild: "",
        typeOfEngine: "",
        engineMake: "",
        engineMakerAddress: "",
        enginepin: "",
        enginephoneNumber: "",
        engineemail: "",
        horsepower: "",
        speed: "",
        yearOfMake: "",
        builderName: "",
        builderAddress: "",
        builderemail: "",
        builderphoneNumber: "",
        pin: "",
        // city: "",
        district: "",
        stateUt: "",
        country: "India",
        workOrderDate: "",
      },
    });

    console.log("Values", watch());

    useImperativeHandle(ref, () => ({
      validateForm: async () => {
        if (isViewMode) return true;
        const isValid = await trigger();
        if (!isValid) {
          const firstErrorField = Object.keys(errors)[0];
          if (firstErrorField) {
            const element = document.querySelector(
              `[name="${firstErrorField}"]`
            );
            if (element) {
              element.scrollIntoView({ behavior: "smooth", block: "center" });
              element.focus();
            }
          }
        }
        return isValid;
      },
      getFormData: () => watch(),
      //update
      fileStates: fileStates,
    }));

    const [fileStates, setFileStates] = useState({
      thirdPartyInsurance: null,
      builderCertificate: null,
      instrumentOfSale: null,
      mortgageDetails: null,
      pniInsurance: null,
      declarationOfOwnership: null,
      challan: null,
    });

    const hasValue = (value) => {
      return (
        value !== null && value !== undefined && value !== "" && value !== "N/A"
      );
    };

    const isOwnerFieldDisabled = (fieldName) => {
      if (isViewMode) return true;
      if (!isDataLoaded || !registrationData?.basicDetails?.ownerDetails)
        return false;
      const owner = registrationData.basicDetails.ownerDetails;

      switch (fieldName) {
        case "ownerName":
          return hasValue(owner.ownerCompanyName);
        case "address":
          return hasValue(owner.addressLine1);
        case "ownerType":
          return hasValue(owner.categoryOfOwner);
        case "builderEmail":
          return hasValue(owner.emailId);
        case "applicantphoneNumber":
          return hasValue(owner.phoneNumber);
        case "ownerpin":
          return hasValue(owner.pin);
        // case 'ownercity':
        //   return hasValue(owner.city);
        case "ownerdistrict":
          return hasValue(owner.district);
        case "ownerstateUt":
          return hasValue(owner.state);
        case "occupation":
          return false;
        case "originalPlaceOfBusiness":
          return false;
        default:
          return false;
      }
    };

    const vesselKindOptions =
      masterData?.kindOfVessels?.map((type) => ({
        value: type.valueCode,
        label: type.valueLabel,
      })) || [];
    const vesselTypeOptions =
      masterData?.vesselTypes?.map((type) => ({
        value: type.valueCode,
        label: type.valueLabel,
      })) || [];

    const categoryOptions =
      masterData?.vesselCategories?.map((category) => ({
        value: category.valueCode,
        label: category.valueLabel,
      })) || [];

    const zoneOptions =
      masterData?.zones?.map((zone) => ({
        value: zone.valueCode,
        label: zone.valueLabel,
      })) || [];
    const mortgageOptions =
      masterData?.mortgageTypes?.map((mortgage) => ({
        value: mortgage.valueCode,
        label: mortgage.valueLabel,
      })) || [];

    const isBuilderFieldDisabled = (fieldName) => {
      if (isViewMode) return true;
      if (!isDataLoaded || !registrationData?.basicDetails?.builderDetails)
        return false;
      const builder = registrationData.basicDetails.builderDetails;

      switch (fieldName) {
        case "builderName":
          return hasValue(builder.builderName);
        case "builderAddress":
          return hasValue(builder.addressLine1);
        case "builderemail":
          return hasValue(builder.emailId);
        case "builderphoneNumber":
          return hasValue(builder.phone);
        case "pin":
          return hasValue(builder.pin);
        // case 'city':
        //   return hasValue(builder.city);
        case "district":
          return hasValue(builder.district);
        case "stateUt":
          return hasValue(builder.state);
        default:
          return false;
      }
    };

    const hasOwnerData =
      isDataLoaded &&
      registrationData?.basicDetails?.ownerDetails &&
      Object.values(registrationData.basicDetails.ownerDetails).some((value) =>
        hasValue(value)
      );

    const hasBuilderData =
      isDataLoaded &&
      registrationData?.basicDetails?.builderDetails &&
      Object.values(registrationData.basicDetails.builderDetails).some(
        (value) => hasValue(value)
      );

    const getFileDisplayName = (documentType) => {
      const fileState = fileStates[documentType];
      return fileState?.name || "";
    };

    useEffect(() => {
      if (registrationData && !isDataLoaded) {
        const { basicDetails, vesselDetails, engineDetails, enclosers } =
          registrationData;
        // Basic Details
        if (basicDetails?.ownerDetails) {
          const owner = basicDetails.ownerDetails;
          setValue("ownerName", owner.ownerCompanyName || "");
          setValue("address", owner.addressLine1 || "");
          setValue("ownerType", owner.categoryOfOwner || "");
          setValue("builderEmail", owner.emailId || "");
          setValue("applicantphoneNumber", owner.phoneNumber || "");
          setValue("ownerpin", owner.pin?.toString() || "");
          // setValue("ownercity", owner.city || "N/A");
          setValue("ownerdistrict", owner.district || "");
          setValue("ownerstateUt", owner.state || "");
          setValue("occupation", basicDetails.occupation || "");
          setValue(
            "originalPlaceOfBusiness",
            basicDetails.originalPlaceBusiness || ""
          );
        }
        // Vessel Details

        if (vesselDetails) {
          setValue("nameOfMaster", vesselDetails.nameOfMaster || "");
          setValue("certificateNo", vesselDetails.certficateNumber || "");
          setValue("nameOfRegistry", vesselDetails.nameOfRegistry || "");
          setValue("registrationNo", vesselDetails.registrationNumber || "");
          setValue("vesselName", vesselDetails.vesselName || "");
          setValue("kindOfVessel", vesselDetails.kindOfVessel || "");
          setValue("mortgage", vesselDetails.mortgage || "");
          setValue("placeOfBuild", vesselDetails.placeOfBuild || "");
          setValue("detailsOfInsurance", vesselDetails.insuranceDetails || "");
          setValue(
            "vesselyearOfBuild",
            vesselDetails.yearOfBuild?.toString() || ""
          );
          setValue(
            "protectionAndIndemnityClubNo",
            vesselDetails.pniClubNo || ""
          );
          setValue(
            "protectionAndIndemnityClubName",
            vesselDetails.pniClubName || ""
          );
          setValue(
            "insuranceValidUpto",
            vesselDetails?.insuranceValidDate || ""
          );
          setValue(
            "workOrderValue",
            vesselDetails.workOrderValue?.toString() || ""
          );
          setValue("workOrderDate", vesselDetails.declarationWorkOrderDate || "");
        }
        // Engine Details

        if (engineDetails) {
          setValue("yearOfBuild", engineDetails.yearOfBuild || "");
          setValue("typeOfEngine", engineDetails.engineType || "");
          setValue("engineMake", engineDetails.engineMake || "");
          setValue("engineMakerAddress", engineDetails.makerAddress || "");
          setValue("enginepin", engineDetails.pin || "");
          setValue("enginephoneNumber", engineDetails.mobile || "");
          setValue("engineemail", engineDetails.email || "");
          setValue("horsepower", engineDetails.horsepower?.toString() || "");
          setValue("speed", engineDetails.speed?.toString() || "");
          setValue("yearOfMake", engineDetails.yearOfMake || "");
        }
        // Builder Details

        if (basicDetails?.builderDetails) {
          const builder = basicDetails.builderDetails;
          setValue("builderName", builder.builderName || "");
          setValue("builderAddress", builder.addressLine1 || "");
          setValue("builderemail", builder.emailId || "");
          setValue("builderphoneNumber", builder.phone || "");
          setValue("pin", builder.pin?.toString() || "");
          // setValue("ownercity", owner.city || "N/A");
          setValue("district", builder.district || "");
          setValue("stateUt", builder.state || "");
        }

        if (enclosers && Array.isArray(enclosers)) {
          const fileMapping = {
            THIRD_PARTY_INSURANCE: "thirdPartyInsurance",
            BUILDERS_CERTIFICATE: "builderCertificate",
            INSTRUMENT_OF_SALE: "instrumentOfSale",
            MORTGAGE_DETAILS: "mortgageDetails",
            PREOTECTION_AND_INDEMNITY_INSURANCE_NO: "pniInsurance",
            DECLARATION_OF_OWNERSHIP: "declarationOfOwnership",
            CHALLAN: "challan",
          };

          enclosers.forEach((encloser) => {
            const fieldName = fileMapping[encloser.documentType];
            if (fieldName && encloser.fileStoreId) {
              setFileStates((prev) => ({
                ...prev,
                [fieldName]: {
                  name: encloser.documentName,
                  fileStoreId: encloser.fileStoreId,
                  fileViewURL: encloser?.fileViewURL,
                },
              }));
              setValue(`${fieldName}FileStoreId`, encloser.fileStoreId);
            }
          });
        }

        setIsDataLoaded(true);
      }
    }, [registrationData, setValue, isDataLoaded]);

    useEffect(() => {
      if (registrationData?.vesselDetails && masterData && isDataLoaded) {
        const vesselDetails = registrationData.vesselDetails;

        const findValueCode = (apiValue, masterArray) => {
          if (!apiValue || !masterArray) return "";
          const found = masterArray.find(
            (item) =>
              item.valueLabel === apiValue || item.valueCode === apiValue
          );
          return found?.valueCode || "";
        };

        setValue(
          "typeOfVessel",
          findValueCode(vesselDetails.typeOfVessel, masterData.vesselTypes)
        );
        setValue(
          "categoryOfVessel",
          findValueCode(
            vesselDetails.categoryOfVessel,
            masterData.vesselCategories
          )
        );
        setValue("zone", findValueCode(vesselDetails.zone, masterData.zones));
        setValue(
          "kindOfVessel",
          findValueCode(vesselDetails.kindOfVessel, masterData.kindOfVessels)
        );
      }
    }, [masterData, registrationData, isDataLoaded, setValue]);

    const fetchAddressDetails = async (pin, prefix = "") => {
      if (isViewMode) return;
      try {
        loaderRef.current?.show();
        const URL =
          process.env.REACT_APP_PUBLIC_URL +
          URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE +
          pin;
        const response = await getData(URL);

        if (response?.status === 200 && response?.data?.length > 0) {
          const data = response.data[0];
          if (prefix) {
            // setValue(`${prefix}city`, data.district);

            setValue(`${prefix}district`, data.district);
            setValue(`${prefix}stateUt`, data.stateName);
            // clearErrors(`${prefix}city`);
            clearErrors(`${prefix}district`);
            clearErrors(`${prefix}stateUt`);
          } else {
            // setValue("city", data.district);
            setValue("district", data.district);
            setValue("stateUt", data.stateName);
            // clearErrors("city");
            clearErrors("district");
            clearErrors("stateUt");
          }
          setValue("country", "India");
        } else {
          toast.info("No data found for this PIN code");
        }
      } catch (error) {
        toast.error("Error fetching address details");
      } finally {
        loaderRef.current?.hide();
      }
    };

    const handleDropdownChange = (name, value) => {
      if (isViewMode) return;
      setValue(name, value, { shouldValidate: true });
      clearErrors(name);
    };
    // const handleFileChange = async (e, documentType) => {
    //   if (isViewMode) return;
    //   const file = e?.target?.files[0];
    //   if (!file) return;

    //   const maxSize = 10 * 1024 * 1024;
    //   if (file.size > maxSize) {
    //     toast.error("File size must be less than or equal to 10 MB.");
    //     e.target.value = null;
    //     return;
    //   }

    //   loaderRef.current?.show();

    //   try {
    //     const formData = new FormData();
    //     formData.append("file", file);

    //     const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
    //     const response = await postFORMdata(uploadUrl, formData);

    //     const fileStoreId = response?.data?.files[0]?.fileStoreId;

    //     if (fileStoreId) {
    //       const getStandardizedFileName = (docType) => {
    //         const fileNames = {
    //           "thirdPartyInsurance": "Third Party Insurance.pdf",
    //           "builderCertificate": "Builder's Certificate.pdf",
    //           "instrumentOfSale": "Instrument of Sale.pdf",
    //           "mortgageDetails": "Mortgage Details.pdf",
    //           "pniInsurance": "Protection & Indemnity Insurance.pdf",
    //           "declarationOfOwnership": "Declaration of Ownership.pdf",
    //           "challan": "Challan.pdf"
    //         };
    //         return fileNames[docType] || file.name;
    //       };

    //       const standardizedName = getStandardizedFileName(documentType);

    //       setFileStates(prev => ({
    //         ...prev,
    //         [documentType]: {
    //           name: standardizedName,
    //           fileStoreId,
    //           originalName: file.name
    //         }
    //       }));
    //       setValue(`${documentType}FileStoreId`, fileStoreId);
    //       toast.success("File uploaded successfully!");
    //     }
    //   } catch (err) {
    //     console.error("File upload failed:", err);
    //     toast.error("File upload failed. Please try again.");
    //     setFileStates(prev => ({ ...prev, [documentType]: null }));
    //     e.target.value = null;
    //   } finally {
    //     loaderRef.current?.hide();
    //   }
    // };

    const handleFileChange = async (e, documentType) => {
      if (isViewMode) return;
      const file = e?.target?.files[0];
      console.log("file ", file);
      if (!file) return;

      const maxSize = 10 * 1024 * 1024;
      if (file.size > maxSize) {
        toast.error("File size must be less than or equal to 10 MB.");
        e.target.value = null;
        return;
      }

      loaderRef.current?.show();

      try {
        const formData = new FormData();
        formData.append("file", file);

        const uploadUrl =
          BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
        const response = await postFORMdata(uploadUrl, formData);

        const fileStoreId = response?.data?.files[0]?.fileStoreId;

        if (fileStoreId) {
          const getDisplayFileName = (docType, originalFileName) => {
            const fileExtension = originalFileName.split(".").pop();
            const labelNames = {
              thirdPartyInsurance: "Insurance",
              builderCertificate: "Builder's Certificate",
              instrumentOfSale: "Instrument of Sale",
              mortgageDetails: "Mortgage Details",
              pniInsurance: "Protection & Insurance",
              declarationOfOwnership: "Declaration of Ownership",
              challan: "Challan",
            };
            return `${labelNames[docType] || docType}.${fileExtension}`;
          };

          const displayName = getDisplayFileName(documentType, file.name);

          setFileStates((prev) => ({
            ...prev,
            [documentType]: {
              name: displayName,
              fileStoreId,
              originalName: file.name,
              fileViewURL: file?.fileViewURL,
            },
          }));
          const renamedFile = renameFile(file, displayName);
          setValue(documentType, renamedFile);
          setValue(`${documentType}FileStoreId`, fileStoreId);
          toast.success("File uploaded successfully!");
        }
      } catch (err) {
        console.error("File upload failed:", err);
        toast.error("File upload failed. Please try again.");
        setFileStates((prev) => ({ ...prev, [documentType]: null }));
        e.target.value = null;
      } finally {
        loaderRef.current?.hide();
      }
    };

    const handleFileDownload = async (fileStoreId, fileName, originalName) => {
      try {
        if (!fileStoreId) return;
        const url = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${fileStoreId}`;

        loaderRef.current?.show();

        const accessToken = getFromLocalStorage("access_token");
        const tokenDetails = getFromLocalStorage("tokenDetails");
        const sessionState = tokenDetails
          ? JSON.parse(tokenDetails)?.session_state
          : "";

        const response = await axios({
          method: "GET",
          url: url,
          responseType: "blob",
          headers: {
            Authorization: `Bearer ${accessToken}`,
            "X-Request-ID": sessionState,
            Accept: "application/octet-stream",
          },
        });

        if (response.data) {
          let filename = fileName || "document";
          const contentDisposition = response.headers["content-disposition"];
          if (contentDisposition) {
            const filenameMatch = contentDisposition.match(
              /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
            );
            if (filenameMatch && filenameMatch[1]) {
              filename = filenameMatch[1].replace(/['"]/g, "");
            }
          }

          const blob = new Blob([response.data], {
            type:
              response.headers["content-type"] || "application/octet-stream",
          });
          const blobUrl = window.URL.createObjectURL(blob);

          const link = document.createElement("a");
          link.href = blobUrl;
          link.setAttribute("download", filename);
          document.body.appendChild(link);
          link.click();

          setTimeout(() => {
            document.body.removeChild(link);
            window.URL.revokeObjectURL(blobUrl);
          }, 100);
        }
      } catch (error) {
        console.error("Error downloading file:", error);
        toast.error("Failed to download file. Please try again.");
      } finally {
        loaderRef.current?.hide();
      }
    };

    const handleDeleteFile = async (fileStoreId, documentType) => {
      const res = await deleteFile(fileStoreId, loaderRef);
      if (res) {
        setFileStates((prev) => ({ ...prev, [documentType]: null }));
        setValue(documentType, null);
        setValue(`${documentType}FileStoreId`, null);
      }
    };

    const getVesselNameSuggestions = async (value) => {
      if (isViewMode) return true;
      try {
        const vesselName = value.trim();
        if (!vesselName) return;
        const applicationNo = registrationData?.vesselDetails?.applicationNo;
        const regId = registrationData?.vesselDetails?.id;
        if (!applicationNo || !regId) return;

        loaderRef.current?.show();

        const apiUrl =
          SERVICE_BASE.IWT_REGISTRATION +
          URLS_ENDPOINT.VESSEL_SERVICE.VESSELNAME_SEARCH +
          `?vesselName=${encodeURIComponent(vesselName)}`;

        const response = await postData(apiUrl, {
          vesselRegistrationId: regId,
          applicationNumber: applicationNo,
          vesselName: vesselName,
        });

        setSuggestions([]);
        clearErrors("vesselName");
        loaderRef.current?.hide();

        return true;
      } catch (error) {
        const suggestions = error?.response?.data?.data?.suggestions || [];
        setSuggestions(suggestions);
        toast.error(
          error?.response?.data?.responseStatus?.message ||
          "The Vessel is not available please try with another name"
        );
        setError("vesselName", {
          type: "manual",
          message: t(
            "The Vessel is not available please try with another name"
          ),
        });
        loaderRef.current?.hide();

        return false;
      }
    };

    const checkVesselNameError = () => {
      if (errors?.vesselName) {
        return false;
      }
      return true;
    };

    const values = watch();

    useEffect(() => {
      if (isViewMode) return;
      const timer = setTimeout(() => {
        getVesselNameSuggestions(values.vesselName);
      }, 1000);

      return () => clearTimeout(timer);
    }, [values.vesselName, isViewMode]);

    const shouldShowBuilderDetails = () => {
      return (
        registrationData?.basicDetails?.builderDetails !== null &&
        registrationData?.basicDetails?.builderDetails?.builderName !== null &&
        registrationData?.basicDetails?.constructedBy !== "1"
      );
    };

    const hasRegistrationNumber = () => {
      return hasValue(registrationData?.vesselDetails?.registrationNumber);
    };

    const isVesselFieldDisabled = (fieldName) => {
      if (isViewMode) return true;
      if (!isDataLoaded || !registrationData?.vesselDetails) return false;
      const vessel = registrationData.vesselDetails;

      const hasRegistrationNumber = hasValue(vessel.registrationNumber);
      return !hasRegistrationNumber;
    };

    const handleGenerateDeclaration = async () => {
      try {
        loaderRef.current?.show();
        const formValues = watch();
        const currentDate = new Date();
        const payload = {
          formType: "DECLARATIONOFOWNERSHIP",
          ownerName: formValues.ownerName || "",
          permanentAddress: formValues.address || "",
          businessAddress: formValues.originalPlaceOfBusiness || "",
          vesselName: formValues.vesselName || "",
          builtAt: formValues.placeOfBuild || "",
          builtYear: formValues.vesselyearOfBuild || "",
          purchaseDate: formValues.workOrderDate ? new Date(formValues.workOrderDate).toLocaleDateString('en-GB') : "",
          purchaseAmount: formValues.workOrderValue || "",
          portOfRegistration: formValues.nameOfRegistry || "",
          // day: currentDate.getDate().toString(),
          // month: currentDate.toLocaleString('default', { month: 'long' }),
          // year: currentDate.getFullYear().toString().slice(-2),
          // witnessName: "Mr. Witness Name"
        };

        const accessToken = getFromLocalStorage("access_token");
        const tokenDetails = JSON.parse(getFromLocalStorage("tokenDetails") || "{}");
        const sessionState = tokenDetails.session_state || "";

        if (!accessToken) {
          toast.error("Authentication token missing. Please login again.");
          return;
        }

        const apiUrl = SERVICE_BASE.IWT_PDFSERVICE + URLS_ENDPOINT.VESSEL_SERVICE.INVOICE_DOWNLOAD;

        const response = await fetch(apiUrl, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${accessToken}`,
            "X-Request-ID": sessionState,
          },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          const errorMsg = await response.text();
          throw new Error(errorMsg || "Failed to generate declaration");
        }

        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = url;
        link.download = `Declaration_of_Ownership_${formValues.vesselName || "vessel"}.pdf`;
        document.body.appendChild(link);
        link.click();
        link.remove();

        toast.success("Declaration PDF generated successfully!");
        window.URL.revokeObjectURL(url);

      } catch (error) {
        console.error("Declaration generation error:", error);
        toast.error(error.message || "Failed to generate declaration PDF");
      } finally {
        loaderRef.current?.hide();
      }
    };

    const renderFileField = (docType, label) => {
      if (isViewMode) {
        return (
          <div>
            <label className="form-label">{t(label)}</label>
            {fileStates[docType] ? (
              <div
                className="d-flex align-items-center p-2 border rounded"
                style={{ backgroundColor: "#f8f9fa" }}
              >
                <span className="me-2">{fileStates[docType].name}</span>
                <button
                  type="button"
                  onClick={() => fetchAndViewFile(fileStates[docType].fileStoreId || "")}
                  className="btn btn-sm btn-success rounded-circle d-flex align-items-center justify-content-center me-2"
                  title="View file"
                  style={{ width: "24px", height: "24px", padding: "0" }}
                >
                  <BsEyeFill size={10} />
                </button>
                <button
                  type="button"
                  className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
                  onClick={() =>
                    handleFileDownload(
                      fileStates[docType].fileStoreId,
                      fileStates[docType].name,
                      fileStates[docType].originalName
                    )
                  }
                  title="Download file"
                  style={{ width: "24px", height: "24px", padding: "0" }}
                >
                  <FaDownload size={10} />
                </button>
              </div>
            ) : (
              <div
                className="p-2 border rounded text-muted"
                style={{ backgroundColor: "#f8f9fa" }}
              >
                No file uploaded
              </div>
            )}
          </div>
        );
      }

      return (
        <>
          <InputFile
            name={docType}
            label={t(label)}
            id={docType}
            watch={watch}
            defaultValue={watch(docType)}
            register={register(
              docType
              //    {
              //   required: !fileStates[docType] && t(`${label} is required`),
              // }
            )}
            errors={errors}
            // required={!fileStates[docType]}
            clearErrors={clearErrors}
            onChange={(e) => handleFileChange(e, docType)}
          />
          {fileStates[docType] && (
            <div className="d-flex align-items-center mt-2">
              <small className="text-success me-2">
                ✓ {fileStates[docType].name}
              </small>
              <button
                type="button"
                onClick={() => fetchAndViewFile(fileStates[docType].fileStoreId || "")}
                className="btn btn-sm btn-success rounded-circle d-flex align-items-center justify-content-center me-2"
                title="View file"
                style={{ width: "24px", height: "24px", padding: "0" }}
              >
                <BsEyeFill size={10} />
              </button>
              <button
                type="button"
                className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center me-2"
                onClick={() =>
                  handleFileDownload(
                    fileStates[docType].fileStoreId,
                    fileStates[docType].name,
                    fileStates[docType].originalName
                  )
                }
                title="Download file"
                style={{ width: "24px", height: "24px", padding: "0" }}
              >
                <FaDownload size={10} />
              </button>
              <button
                type="button"
                className="btn btn-sm btn-danger rounded-circle d-flex align-items-center justify-content-center"
                onClick={() =>
                  handleDeleteFile(fileStates[docType].fileStoreId, docType)
                }
                title="Delete file"
                style={{ width: "24px", height: "24px", padding: "0" }}
              >
                <FaTrash size={10} />
              </button>
            </div>
          )}
        </>
      );
    };

    return (
      <>
        <NewLoader ref={loaderRef} />
        <Container fluid className="p-0">
          <Card className="mb-1">
            <Card.Body>
              <form className="employee-form">
                <div className="d-flex align-items-center">
                  <h6 style={{ color: "#2466BF" }}>{t("FORM-2")}</h6>
                </div>

                {/* APPLICANT DETAILS */}
                <Collapsible
                  title={
                    <div className="d-flex align-items-center">
                      <FaUser className="me-2" style={{ color: "#2466BF" }} />
                      <span style={{ color: "#2466BF" }}>
                        {t("APPLICANT DETAILS")}
                      </span>
                      {hasOwnerData && (
                        <FaLock
                          className="ms-2"
                          style={{ color: "#6c757d" }}
                          title="Some fields are auto-populated and cannot be edited"
                        />
                      )}
                    </div>
                  }
                  defaultOpen={true}
                >
                  <Card className="form-section-card">
                    <Card.Body>
                      <Row className="g-3">
                        <Col md={4}>
                          <InputText
                            name="ownerName"
                            label={t("Owner Name")}
                            placeholder={
                              !isViewMode ? t("Enter owner name") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("ownerName", {
                                // required: !isViewMode && t("Owner Name is required"),
                                minLength: {
                                  value: 3,
                                  message: t("Minimum 3 characters required"),
                                },
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isOwnerFieldDisabled("ownerName")}
                            disabled={isOwnerFieldDisabled("ownerName")}
                            style={{
                              backgroundColor: isOwnerFieldDisabled("ownerName")
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isOwnerFieldDisabled("ownerName")
                                ? "not-allowed"
                                : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="address"
                            label={t("Address")}
                            placeholder={!isViewMode ? t("Enter address") : ""}
                            // required={!isViewMode}
                            register={{
                              ...register("address", {
                                // required: !isViewMode && t("Address is required"),
                                minLength: {
                                  value: 5,
                                  message: t("Minimum 5 characters required"),
                                },
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isOwnerFieldDisabled("address")}
                            disabled={isOwnerFieldDisabled("address")}
                            style={{
                              backgroundColor: isOwnerFieldDisabled("address")
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isOwnerFieldDisabled("address")
                                ? "not-allowed"
                                : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="ownerType"
                            label={t("Owner Type")}
                            placeholder={
                              !isViewMode ? t("Enter owner type") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("ownerType", {
                                // required: !isViewMode && t("Owner Type is required"),
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isOwnerFieldDisabled("ownerType")}
                            disabled={isOwnerFieldDisabled("ownerType")}
                            style={{
                              backgroundColor: isOwnerFieldDisabled("ownerType")
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isOwnerFieldDisabled("ownerType")
                                ? "not-allowed"
                                : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="builderEmail"
                            label={t("Email ID")}
                            type="email"
                            placeholder={
                              !isViewMode ? t("Enter email address") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("builderEmail", {
                                // required: !isViewMode && t("Email is required"),
                                pattern: {
                                  value: CONSTANT_REGEX.EMAIL,
                                  message: t("Invalid email address"),
                                },
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isOwnerFieldDisabled("builderEmail")}
                            disabled={isOwnerFieldDisabled("builderEmail")}
                            style={{
                              backgroundColor: isOwnerFieldDisabled(
                                "builderEmail"
                              )
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isOwnerFieldDisabled("builderEmail")
                                ? "not-allowed"
                                : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="applicantphoneNumber"
                            label={t("Phone Number")}
                            placeholder={
                              !isViewMode
                                ? t("Enter 10-digit phone number")
                                : ""
                            }
                            // required={!isViewMode}
                            maxlength={10}
                            register={{
                              ...register("applicantphoneNumber", {
                                // required: !isViewMode && t("Phone Number is required"),
                                pattern: {
                                  value: CONSTANT_REGEX.MOBILE,
                                  message: t("Phone number must be 10 digits"),
                                },
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isOwnerFieldDisabled(
                              "applicantphoneNumber"
                            )}
                            disabled={isOwnerFieldDisabled(
                              "applicantphoneNumber"
                            )}
                            style={{
                              backgroundColor: isOwnerFieldDisabled(
                                "applicantphoneNumber"
                              )
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isOwnerFieldDisabled(
                                "applicantphoneNumber"
                              )
                                ? "not-allowed"
                                : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="ownerpin"
                            label={t("PIN")}
                            placeholder={
                              !isViewMode ? t("Enter 6-digit PIN code") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("ownerpin", {
                                // required: !isViewMode && t("PIN Code is required"),
                                pattern: {
                                  value: /^[0-9]{6}$/,
                                  message: t("PIN must be 6 digits"),
                                },
                              }),
                            }}
                            onChange={async (e) => {
                              const pinValue = e.target.value;
                              if (
                                pinValue.length === 6 &&
                                !isOwnerFieldDisabled("ownerpin")
                              ) {
                                await fetchAddressDetails(pinValue, "owner");
                              }
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isOwnerFieldDisabled("ownerpin")}
                            disabled={isOwnerFieldDisabled("ownerpin")}
                            style={{
                              backgroundColor: isOwnerFieldDisabled("ownerpin")
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isOwnerFieldDisabled("ownerpin")
                                ? "not-allowed"
                                : "text",
                            }}
                          />
                        </Col>
                        {/* <Col md={4}>
                        <InputText
                          name="ownercity"
                          label={t("City")}
                          required={true}
                          placeholder={t("Auto-populated")}
                          register={{
                            ...register("ownercity", { required: t("City is required") }),
                          }}
                          errors={errors}
                          readOnly={true}
                          clearErrors={clearErrors}
                          style={{ backgroundColor: '#e9ecef', cursor: 'not-allowed' }}
                        />
                      </Col> */}
                        <Col md={4}>
                          <InputText
                            name="ownerdistrict"
                            label={t("District")}
                            // required={!isViewMode}
                            // placeholder={t("Auto-populated")}
                            register={{
                              ...register(
                                "ownerdistrict"
                                //  { required: !isViewMode && t("District is required") }
                              ),
                            }}
                            errors={errors}
                            readOnly={true}
                            disabled={true}
                            clearErrors={clearErrors}
                            style={{
                              backgroundColor: "#e9ecef",
                              cursor: "not-allowed",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="ownerstateUt"
                            label={t("State/UT")}
                            // required={!isViewMode}
                            // placeholder={t("Auto-populated")}
                            register={{
                              ...register(
                                "ownerstateUt"
                                // { required: !isViewMode && t("State/UT is required") }
                              ),
                            }}
                            errors={errors}
                            readOnly={true}
                            disabled={true}
                            clearErrors={clearErrors}
                            style={{
                              backgroundColor: "#e9ecef",
                              cursor: "not-allowed",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="occupation"
                            label={t("Occupation")}
                            placeholder={!isViewMode ? t("Occupation") : ""}
                            register={{ ...register("occupation") }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isOwnerFieldDisabled("occupation")}
                            disabled={isOwnerFieldDisabled("occupation")}
                            style={{
                              backgroundColor: isOwnerFieldDisabled(
                                "occupation"
                              )
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isOwnerFieldDisabled("occupation")
                                ? "not-allowed"
                                : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="originalPlaceOfBusiness"
                            label={t("Original Place of Business")}
                            placeholder={
                              !isViewMode ? t("Original Place of Business") : ""
                            }
                            register={{
                              ...register("originalPlaceOfBusiness"),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isOwnerFieldDisabled(
                              "originalPlaceOfBusiness"
                            )}
                            disabled={isOwnerFieldDisabled(
                              "originalPlaceOfBusiness"
                            )}
                            style={{
                              backgroundColor: isOwnerFieldDisabled(
                                "originalPlaceOfBusiness"
                              )
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isOwnerFieldDisabled(
                                "originalPlaceOfBusiness"
                              )
                                ? "not-allowed"
                                : "text",
                            }}
                          />
                        </Col>
                      </Row>
                    </Card.Body>
                  </Card>
                </Collapsible>

                {/* VESSEL DETAILS */}
                <Collapsible
                  title={
                    <div className="d-flex align-items-center">
                      <FaUser className="me-2" style={{ color: "#2466BF" }} />
                      <span style={{ color: "#2466BF" }}>
                        {t("VESSEL DETAILS")}
                      </span>
                    </div>
                  }
                  defaultOpen={true}
                >
                  <Card className="form-section-card">
                    <Card.Body>
                      <Row className="g-3">
                        <Col md={4}>
                          <InputText
                            name="nameOfMaster"
                            label={t("Name of Master")}
                            placeholder={
                              !isViewMode ? t("Enter name of master") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register(
                                "nameOfMaster"
                                // { required: !isViewMode && t("Name of Master is required") }
                              ),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="certificateNo"
                            label={t("Certificate No.")}
                            placeholder={
                              !isViewMode ? t("Enter certificate number") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register(
                                "certificateNo"
                                // { required: !isViewMode && t("Certificate No. is required") }
                              ),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="nameOfRegistry"
                            label={t("Name of Registry")}
                            placeholder={
                              !isViewMode ? t("Enter name of registry") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register(
                                "nameOfRegistry"
                                // { required: !isViewMode && t("Name of Registry is required") }
                              ),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="registrationNo"
                            label={t("Registration No.")}
                            // placeholder={
                            //   !isViewMode ? t("Enter registration number") : ""
                            // }
                            // required={!isViewMode && hasRegistrationNumber()}
                            register={{
                              ...register(
                                "registrationNo"
                                // (!isViewMode && hasRegistrationNumber()) ? { required: t("Registration No. is required") } : {}
                              ),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isVesselFieldDisabled("registrationNo")}
                            disabled={isVesselFieldDisabled("registrationNo")}
                            style={{
                              backgroundColor: isVesselFieldDisabled(
                                "registrationNo"
                              )
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isVesselFieldDisabled("registrationNo")
                                ? "not-allowed"
                                : "text",
                            }}
                          />
                        </Col>
                        <Col md={4} className="position-relative">
                          <InputText
                            name="vesselName"
                            label={t("Vessel Name")}
                            placeholder={
                              !isViewMode ? t("Enter vessel name") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("vesselName", {
                                // required: !isViewMode && t("Vessel Name is required"),
                                validate: async (value) => {
                                  if (isViewMode) return true;
                                  const isValid = checkVesselNameError();
                                  if (!isValid) {
                                    return t(
                                      "The Vessel is not available please try with another name"
                                    );
                                  }
                                },
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                          {!isViewMode && suggestions.length > 0 && (
                            <div
                              className={`${styles.suggestionCard} border rounded mt-1 bg-white w-100`}
                              style={{
                                top: `${errors?.vesselName
                                  ? errors?.vesselName?.type === "validate"
                                    ? "90%"
                                    : "60%"
                                  : "60%"
                                  }`,
                              }}
                            >
                              <div
                                className="px-3 py-2 border-bottom bg-light"
                                style={{
                                  fontWeight: "600",
                                  fontSize: "0.875rem",
                                  color: "#545D69",
                                }}
                              >
                                {t("Suggestions")}
                              </div>
                              {suggestions.map((suggestion, index) => (
                                <div
                                  key={suggestion + index}
                                  className={`${styles.suggestionItem} px-3 py-2 suggestion-item`}
                                  onClick={() => {
                                    setValue("vesselName", suggestion);
                                    setSuggestions([]);
                                    clearErrors("vesselName");
                                  }}
                                >
                                  {suggestion}
                                </div>
                              ))}
                            </div>
                          )}
                        </Col>

                        <Col md={4}>
                          <InputSelect
                            name="kindOfVessel"
                            label={t("Kind of Vessel")}
                            // required={!isViewMode}
                            placeholder={
                              !isViewMode ? t("Select kind of vessel") : ""
                            }
                            options={vesselKindOptions}
                            register={register(
                              "kindOfVessel"
                              //  { required: !isViewMode && t("Kind of Vessel is required") }
                            )}
                            errors={errors}
                            value={watch("kindOfVessel") || ""}
                            onChange={(val) =>
                              handleDropdownChange("kindOfVessel", val)
                            }
                            clearErrors={clearErrors}
                            disabled={isViewMode}
                            style={{
                              ...(isViewMode
                                ? {
                                  backgroundColor: "#f5f5f5",
                                  cursor: "not-allowed !important",
                                  color: "black",
                                  fontWeight: 550,
                                }
                                : {}),
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputSelect
                            name="typeOfVessel"
                            label={t("Type of Vessel")}
                            // required={!isViewMode}
                            placeholder={
                              !isViewMode ? t("Select type of vessel") : ""
                            }
                            options={vesselTypeOptions}
                            register={register(
                              "typeOfVessel"
                              //  { required: !isViewMode && t("Type of Vessel is required") }
                            )}
                            errors={errors}
                            value={watch("typeOfVessel") || ""}
                            onChange={(val) =>
                              handleDropdownChange("typeOfVessel", val)
                            }
                            clearErrors={clearErrors}
                            disabled={isViewMode}
                            style={{
                              ...(isViewMode
                                ? {
                                  backgroundColor: "#f5f5f5",
                                  cursor: "not-allowed",
                                  color: "black",
                                  fontWeight: 550,
                                }
                                : {}),
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputSelect
                            name="categoryOfVessel"
                            label={t("Category of Vessel")}
                            // required={!isViewMode}
                            placeholder={
                              !isViewMode ? t("Select category of vessel") : ""
                            }
                            options={categoryOptions}
                            register={register(
                              "categoryOfVessel"
                              //  { required: !isViewMode && t("Category of Vessel is required") }
                            )}
                            errors={errors}
                            value={watch("categoryOfVessel") || ""}
                            onChange={(val) =>
                              handleDropdownChange("categoryOfVessel", val)
                            }
                            clearErrors={clearErrors}
                            disabled={isViewMode}
                            style={{
                              ...(isViewMode
                                ? {
                                  backgroundColor: "#f5f5f5",
                                  cursor: "not-allowed",
                                  color: "black",
                                  fontWeight: 550,
                                }
                                : {}),
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputSelect
                            name="zone"
                            label={t("Zone")}
                            // required={!isViewMode}
                            placeholder={!isViewMode ? t("Select zone") : ""}
                            options={zoneOptions}
                            register={register(
                              "zone"
                              // { required: !isViewMode && t("Zone is required") }
                            )}
                            errors={errors}
                            value={watch("zone") || ""}
                            onChange={(val) =>
                              handleDropdownChange("zone", val)
                            }
                            clearErrors={clearErrors}
                            disabled={isViewMode}
                            style={{
                              ...(isViewMode
                                ? {
                                  backgroundColor: "#f5f5f5",
                                  cursor: "not-allowed",
                                  color: "black",
                                  fontWeight: 550,
                                }
                                : {}),
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputSelect
                            name="mortgage"
                            label={t("Mortgage")}
                            // required={!isViewMode
                            placeholder={
                              !isViewMode ? t("Select Mortgage") : ""
                            }
                            // options={[
                            //   { value: "yes", label: "Yes" },
                            //   { value: "no", label: "No" },
                            // ]}
                            options={mortgageOptions}
                            register={register(
                              "mortgage"
                              // { required: !isViewMode && t("Mortgage is required") }
                            )}
                            errors={errors}
                            value={watch("mortgage") || ""}
                            onChange={(val) =>
                              handleDropdownChange("mortgage", val)
                            }
                            clearErrors={clearErrors}
                            disabled={isViewMode}
                            style={{
                              ...(isViewMode
                                ? {
                                  backgroundColor: "#f5f5f5",
                                  cursor: "not-allowed",
                                  color: "black",
                                  fontWeight: 550,
                                }
                                : {}),
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="placeOfBuild"
                            label={t("Place of Build")}
                            placeholder={
                              !isViewMode ? t("Enter place of build") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register(
                                "placeOfBuild"
                                //  { required: !isViewMode && t("Place of Build is required") }
                              ),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="detailsOfInsurance"
                            label={t("Details of Insurance")}
                            placeholder={
                              !isViewMode ? t("Enter details of insurance") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register(
                                "detailsOfInsurance"
                                //  { required: !isViewMode && t("Details of Insurance is required") }
                              ),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="vesselyearOfBuild"
                            label={t("Year of Build")}
                            placeholder={
                              !isViewMode ? t("Enter year of build") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("vesselyearOfBuild", {
                                // required: !isViewMode && t("Year of Build is required"),
                                pattern: {
                                  value: /^[0-9]{4}$/,
                                  message: t("Enter a valid year (YYYY)"),
                                },
                                min: {
                                  value: 1900,
                                  message: t("Year must be after 1900"),
                                },
                                max: {
                                  value: new Date().getFullYear(),
                                  message: t("Year cannot be in the future"),
                                },
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="protectionAndIndemnityClubNo"
                            label={t("Protection & Indemnity Club No.")}
                            placeholder={
                              !isViewMode ? t("Enter PNI Club No.") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("protectionAndIndemnityClubNo", {
                                // required: !isViewMode && t("PNI Club No. is required"),
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="protectionAndIndemnityClubName"
                            label={t("Protection & Indemnity Club Name")}
                            placeholder={
                              !isViewMode ? t("Enter PNI Club Name") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("protectionAndIndemnityClubName", {
                                // required: !isViewMode && t("PNI Club Name is required"),
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>

                        <Col md={4}>
                          <InputText
                            label={t("Insurance Valid Upto")}
                            name="insuranceValidUpto"
                            type="date"
                            maxDate=""
                            register={{
                              ...register("insuranceValidUpto"),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "pointer",
                            }}
                          />

                          {/* <InputText
                            name="insuranceValidUpto"
                            type="number"
                            label={t("Insurance Valid Upto")}
                            placeholder={
                              !isViewMode ? t("Enter insurance valid upto") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("insuranceValidUpto", {
                                // required: !isViewMode && t("Insurance Valid Upto is required"),
                                min: {
                                  value: new Date().getFullYear(),
                                  message: t(
                                    "Year should not be less than the current year"
                                  ),
                                },
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          /> */}
                        </Col>
                      </Row>
                    </Card.Body>
                  </Card>
                </Collapsible>

                {/* ENGINE DETAILS */}
                <Collapsible
                  title={
                    <div className="d-flex align-items-center">
                      <FaUser className="me-2" style={{ color: "#2466BF" }} />
                      <span style={{ color: "#2466BF" }}>
                        {t("Engine Details")}
                      </span>
                    </div>
                  }
                  defaultOpen={true}
                >
                  <Card className="form-section-card">
                    <Card.Body>
                      <Row className="g-3">
                        {/* <Col md={4}>
                        <InputText
                          name="yearOfBuild"
                          type="number"
                          label={t("Year of Build")}
                          placeholder={!isViewMode ? t("Enter year of build") : ""}
                           // required={!isViewMode}
                          register={{
                            ...register("yearOfBuild", {
                              // required: !isViewMode && t("Year of Build is required"),
                              pattern: { value: /^[0-9]{4}$/, message: t("Enter a valid year (YYYY)"), },
                              min: { value: 1900, message: t("Year must be after 1900") },
                              max: { value: new Date().getFullYear(), message: t("Year cannot be in the future") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isViewMode}
                          disabled={isViewMode}
                          style={{
                            backgroundColor: isViewMode ? '#e9ecef' : '#ffffff',
                            cursor: isViewMode ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col> */}
                        <Col md={4}>
                          <InputText
                            name="typeOfEngine"
                            label={t("Type of Engine")}
                            placeholder={
                              !isViewMode ? t("Enter type of engine") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register(
                                "typeOfEngine"
                                //  { required: !isViewMode && t("Type of Engine is required") }
                              ),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="engineMake"
                            label={t("Engine Make")}
                            placeholder={
                              !isViewMode ? t("Enter engine make") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register(
                                "engineMake"
                                // { required: !isViewMode && t("Engine Make is required") }
                              ),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="engineMakerAddress"
                            label={t("Engine Maker Address")}
                            placeholder={
                              !isViewMode ? t("Enter engine maker address") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register(
                                "engineMakerAddress"
                                // { required: !isViewMode && t("Engine Maker Address is required") }
                              ),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="enginepin"
                            label={t("PIN")}
                            placeholder={
                              !isViewMode ? t("Enter 6-digit PIN code") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("enginepin", {
                                // required: !isViewMode && t("PIN Code is required"),
                                pattern: {
                                  value: /^[0-9]{6}$/,
                                  message: t("PIN must be 6 digits"),
                                },
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="enginephoneNumber"
                            label={t("Phone Number")}
                            placeholder={
                              !isViewMode
                                ? t("Enter 10-digit phone number")
                                : ""
                            }
                            // required={!isViewMode}
                            maxlength={10}
                            register={{
                              ...register("enginephoneNumber", {
                                // required: !isViewMode && t("Phone Number is required"),
                                pattern: {
                                  value: CONSTANT_REGEX.MOBILE,
                                  message: t("Phone number must be 10 digits"),
                                },
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="engineemail"
                            label={t("Email ID")}
                            type="email"
                            placeholder={
                              !isViewMode ? t("Enter email address") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("engineemail", {
                                // required: !isViewMode && t("Email is required"),
                                pattern: {
                                  value: CONSTANT_REGEX.EMAIL,
                                  message: t("Invalid email address"),
                                },
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="horsepower"
                            label={t("Horsepower")}
                            type="number"
                            placeholder={
                              !isViewMode ? t("Enter horsepower") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("horsepower", {
                                // required: !isViewMode && t("Horsepower is required"),
                                min: {
                                  value: 1,
                                  message: t("Horsepower must be positive"),
                                },
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="speed"
                            label={t("Speed")}
                            placeholder={!isViewMode ? t("Enter speed") : ""}
                            // required={!isViewMode}
                            register={{
                              ...register(
                                "speed"
                                // { required: !isViewMode && t("Speed is required") }
                              ),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name="yearOfMake"
                            label={t("Year of Make")}
                            placeholder={
                              !isViewMode ? t("Enter year of make") : ""
                            }
                            // required={!isViewMode}
                            register={{
                              ...register("yearOfMake", {
                                // required: !isViewMode && t("Year of Make is required"),
                                pattern: {
                                  value: /^[0-9]{4}$/,
                                  message: t("Enter a valid year (YYYY)"),
                                },
                              }),
                            }}
                            errors={errors}
                            clearErrors={clearErrors}
                            readOnly={isViewMode}
                            disabled={isViewMode}
                            style={{
                              backgroundColor: isViewMode
                                ? "#e9ecef"
                                : "#ffffff",
                              cursor: isViewMode ? "not-allowed" : "text",
                            }}
                          />
                        </Col>
                      </Row>
                    </Card.Body>
                  </Card>
                </Collapsible>

                {/* BUILDER DETAILS */}
                {shouldShowBuilderDetails() && (
                  <Collapsible
                    title={
                      <div className="d-flex align-items-center">
                        <FaUser className="me-2" style={{ color: "#2466BF" }} />
                        <span style={{ color: "#2466BF" }}>
                          {t("Builder Details")}
                        </span>
                        {hasBuilderData && (
                          <FaLock
                            className="ms-2"
                            style={{ color: "#6c757d" }}
                            title="Some fields are auto-populated and cannot be edited"
                          />
                        )}
                      </div>
                    }
                    defaultOpen={true}
                  >
                    <Card className="form-section-card">
                      <Card.Body>
                        <Row className="g-3">
                          <Col md={4}>
                            <InputText
                              name="builderName"
                              label={t("Name of Builder")}
                              placeholder={
                                !isViewMode ? t("Enter name of builder") : ""
                              }
                              // required={!isViewMode}
                              register={{
                                ...register(
                                  "builderName"
                                  // { required: !isViewMode && t("Name of Builder is required") }
                                ),
                              }}
                              errors={errors}
                              clearErrors={clearErrors}
                              readOnly={isBuilderFieldDisabled("builderName")}
                              disabled={isBuilderFieldDisabled("builderName")}
                              style={{
                                backgroundColor: isBuilderFieldDisabled(
                                  "builderName"
                                )
                                  ? "#e9ecef"
                                  : "#ffffff",
                                cursor: isBuilderFieldDisabled("builderName")
                                  ? "not-allowed"
                                  : "text",
                              }}
                            />
                          </Col>
                          <Col md={4}>
                            <InputText
                              name="builderAddress"
                              label={t("Address of Builder")}
                              placeholder={
                                !isViewMode ? t("Enter address of builder") : ""
                              }
                              // required={!isViewMode}
                              register={{
                                ...register(
                                  "builderAddress"
                                  // { required: !isViewMode && t("Address of Builder is required") }
                                ),
                              }}
                              errors={errors}
                              clearErrors={clearErrors}
                              readOnly={isBuilderFieldDisabled(
                                "builderAddress"
                              )}
                              disabled={isBuilderFieldDisabled(
                                "builderAddress"
                              )}
                              style={{
                                backgroundColor: isBuilderFieldDisabled(
                                  "builderAddress"
                                )
                                  ? "#e9ecef"
                                  : "#ffffff",
                                cursor: isBuilderFieldDisabled("builderAddress")
                                  ? "not-allowed"
                                  : "text",
                              }}
                            />
                          </Col>
                          <Col md={4}>
                            <InputText
                              name="builderemail"
                              label={t("Email ID")}
                              type="email"
                              placeholder={
                                !isViewMode ? t("Enter email address") : ""
                              }
                              // required={!isViewMode}
                              register={{
                                ...register("builderemail", {
                                  // required: !isViewMode && t("Email is required"),
                                  pattern: {
                                    value: CONSTANT_REGEX.EMAIL,
                                    message: t("Invalid email address"),
                                  },
                                }),
                              }}
                              errors={errors}
                              clearErrors={clearErrors}
                              readOnly={isBuilderFieldDisabled("builderemail")}
                              disabled={isBuilderFieldDisabled("builderemail")}
                              style={{
                                backgroundColor: isBuilderFieldDisabled(
                                  "builderemail"
                                )
                                  ? "#e9ecef"
                                  : "#ffffff",
                                cursor: isBuilderFieldDisabled("builderemail")
                                  ? "not-allowed"
                                  : "text",
                              }}
                            />
                          </Col>
                          <Col md={4}>
                            <InputText
                              name="builderphoneNumber"
                              label={t("Phone Number")}
                              placeholder={
                                !isViewMode
                                  ? t("Enter 10-digit phone number")
                                  : ""
                              }
                              // required={!isViewMode}
                              maxlength={10}
                              register={{
                                ...register("builderphoneNumber", {
                                  // required: !isViewMode && t("Phone Number is required"),
                                  pattern: {
                                    value: CONSTANT_REGEX.MOBILE,
                                    message: t(
                                      "Phone number must be 10 digits"
                                    ),
                                  },
                                }),
                              }}
                              errors={errors}
                              clearErrors={clearErrors}
                              readOnly={isBuilderFieldDisabled(
                                "builderphoneNumber"
                              )}
                              disabled={isBuilderFieldDisabled(
                                "builderphoneNumber"
                              )}
                              style={{
                                backgroundColor: isBuilderFieldDisabled(
                                  "builderphoneNumber"
                                )
                                  ? "#e9ecef"
                                  : "#ffffff",
                                cursor: isBuilderFieldDisabled(
                                  "builderphoneNumber"
                                )
                                  ? "not-allowed"
                                  : "text",
                              }}
                            />
                          </Col>
                          <Col md={4}>
                            <InputText
                              name="pin"
                              label={t("PIN")}
                              placeholder={
                                !isViewMode ? t("Enter 6-digit PIN code") : ""
                              }
                              // required={!isViewMode}
                              register={{
                                ...register("pin", {
                                  // required: !isViewMode && t("PIN Code is required"),
                                  pattern: {
                                    value: /^[0-9]{6}$/,
                                    message: t("PIN must be 6 digits"),
                                  },
                                }),
                              }}
                              onChange={(e) => {
                                const pinValue = e.target.value;
                                if (
                                  pinValue.length === 6 &&
                                  !isBuilderFieldDisabled("pin")
                                ) {
                                  fetchAddressDetails(pinValue);
                                }
                              }}
                              errors={errors}
                              clearErrors={clearErrors}
                              readOnly={isBuilderFieldDisabled("pin")}
                              disabled={isBuilderFieldDisabled("pin")}
                              style={{
                                backgroundColor: isBuilderFieldDisabled("pin")
                                  ? "#e9ecef"
                                  : "#ffffff",
                                cursor: isBuilderFieldDisabled("pin")
                                  ? "not-allowed"
                                  : "text",
                              }}
                            />
                          </Col>
                          {/* <Col md={4}>
                        <InputText
                          name="city"
                          label={t("City")}
                          required={true}
                          placeholder={t("Auto-populated")}
                          register={{
                            ...register("city", { required: t("City is required") }),
                          }}
                          errors={errors}
                          readOnly={true}
                          clearErrors={clearErrors}
                          style={{ backgroundColor: '#e9ecef', cursor: 'not-allowed' }}
                        />
                      </Col> */}
                          <Col md={4}>
                            <InputText
                              name="district"
                              label={t("District")}
                              // required={!isViewMode}
                              // placeholder={t("Auto-populated")}
                              register={{
                                ...register(
                                  "district"
                                  // { required: !isViewMode && t("District is required") }
                                ),
                              }}
                              errors={errors}
                              readOnly={true}
                              clearErrors={clearErrors}
                              style={{
                                backgroundColor: "#e9ecef",
                                cursor: "not-allowed",
                              }}
                            />
                          </Col>
                          <Col md={4}>
                            <InputText
                              name="stateUt"
                              label={t("State/UT")}
                              // required={!isViewMode}
                              // placeholder={t("Auto-populated")}
                              register={{
                                ...register(
                                  "stateUt"
                                  // { required: !isViewMode && t("State/UT is required") }
                                ),
                              }}
                              errors={errors}
                              readOnly={true}
                              clearErrors={clearErrors}
                              style={{
                                backgroundColor: "#e9ecef",
                                cursor: "not-allowed",
                              }}
                            />
                          </Col>
                        </Row>
                      </Card.Body>
                    </Card>
                  </Collapsible>
                )}

                {/* DECLARATION OF OWNERSHIP */}
                <Collapsible
                  title={
                    <div className="d-flex align-items-center">
                      <FaUser className="me-2" style={{ color: "#2466BF" }} />
                      <span style={{ color: "#2466BF" }}>
                        {t("DECLARATION OF OWNERSHIP")}
                      </span>
                    </div>
                  }
                  defaultOpen={true}
                >
                  <Card className="form-section-card">
                    <Card.Body>
                      <div className="declaration-wrapper">
                        <div className="d-flex justify-content-end mb-3">
                          {!isViewMode && (
                            <>
                              {!isFormSubmitted && !isDeclarationEditable && !watch("workOrderDate") && (
                                <Button
                                  size="sm"
                                  onClick={() => setIsDeclarationEditable(true)}
                                  style={{
                                    backgroundColor: "#007bff !important",
                                    borderColor: "#007bff !important",
                                    color: "#ffffff !important",
                                    marginRight: "10px"
                                  }}
                                >
                                  Select Work Order Date
                                </Button>
                              )}
                              {!isFormSubmitted && isDeclarationEditable && (
                                <Button
                                  size="sm"
                                  onClick={() => {
                                    if (!watch("workOrderDate")) {
                                      toast.error("Please select work order date first");
                                      return;
                                    }
                                    setIsDeclarationEditable(false);
                                    toast.success("Work order date saved successfully!");
                                  }}
                                  style={{
                                    backgroundColor: "#28a745 !important",
                                    borderColor: "#28a745 !important",
                                    color: "#ffffff !important",
                                    marginRight: "10px"
                                  }}
                                >
                                  Save Date
                                </Button>
                              )}
                              {!isFormSubmitted && watch("workOrderDate") && !isDeclarationEditable && (
                                <Button
                                  size="sm"
                                  onClick={() => setIsDeclarationEditable(true)}
                                  style={{
                                    backgroundColor: "#ffc107 !important",
                                    borderColor: "#ffc107 !important",
                                    color: "#000000 !important",
                                    marginRight: "10px"
                                  }}
                                >
                                  Edit Date
                                </Button>
                              )}
                              {watch("workOrderDate") && (
                                <Button
                                  size="sm"
                                  onClick={handleGenerateDeclaration}
                                  style={{
                                    backgroundColor: "#00A3E0 !important",
                                    borderColor: "#00A3E0 !important",
                                    color: "#ffffff !important",
                                  }}
                                >
                                  Generate Declaration
                                </Button>
                              )}
                            </>
                          )}
                        </div>

                        <div className="declaration-content">
                          <div className="declaration-text">

                            <p className="mb-3">
                              I/We <span
                                className={`highlight-field ${watch("ownerName") ? "auto-populated" : ""}`}
                                style={{ fontWeight: 'bold !important', fontStyle: 'italic !important' }}
                              >
                                <strong><em>{watch("ownerName") || "[Owner Name]"}</em></strong>
                              </span> residing permanently at{" "}
                              <span
                                className={`highlight-field ${watch("address") ? "auto-populated" : ""}`}
                                style={{ fontWeight: 'bold !important', fontStyle: 'italic !important' }}
                              >
                                <strong><em>{watch("address") || "[Address of Owner]"}</em></strong>
                              </span> having original place of business at{" "}
                              <span
                                className={`highlight-field ${watch("originalPlaceOfBusiness") ? "auto-populated" : ""}`}
                                style={{ fontWeight: 'bold !important', fontStyle: 'italic !important' }}
                              >
                                <strong><em>{watch("originalPlaceOfBusiness") || "[Place of Business]"}</em></strong>
                              </span>
                            </p>

                            <p className="mb-3">
                              do hereby declare that vessel named <span
                                className={`highlight-field ${watch("vesselName") ? "auto-populated" : ""}`}
                                style={{ fontWeight: 'bold !important', fontStyle: 'italic !important' }}
                              >
                                <strong><em>{watch("vesselName") || "[Vessel Name]"}</em></strong>
                              </span> was built at{" "}
                              <span
                                className={`highlight-field ${watch("placeOfBuild") ? "auto-populated" : ""}`}
                                style={{ fontWeight: 'bold !important', fontStyle: 'italic !important' }}
                              >
                                <strong><em>{watch("placeOfBuild") || "[Place of Build]"}</em></strong>
                              </span>
                            </p>

                            <p className="mb-3">
                              in the year <span
                                className={`highlight-field ${watch("vesselyearOfBuild") ? "auto-populated" : ""}`}
                                style={{ fontWeight: 'bold !important', fontStyle: 'italic !important' }}
                              >
                                <strong><em>{watch("vesselyearOfBuild") || "[Year of Build]"}</em></strong>
                              </span> and was purchased by me on{" "}
                              {isDeclarationEditable ? (
                                <InputText
                                  name="workOrderDate"
                                  type="date"
                                  register={register("workOrderDate", {
                                    required: "Work order date is required"
                                  })}
                                  maxDate=""
                                  errors={errors}
                                  clearErrors={clearErrors}
                                  className="d-inline-block"
                                  style={{
                                    width: "auto",
                                    display: "inline-block",
                                    minWidth: "150px",
                                    margin: "0 4px"
                                  }}
                                />
                              ) : (
                                <span
                                  className="highlight-field editable-field"
                                  style={{ fontWeight: 'bold !important', fontStyle: 'italic !important' }}
                                >
                                  <strong><em>{watch("workOrderDate") ? new Date(watch("workOrderDate")).toLocaleDateString('en-GB') : "[Work Order Date]"}</em></strong>
                                </span>
                              )}
                              {" "}for rupees <span
                                className={`highlight-field ${watch("workOrderValue") ? "auto-populated" : ""}`}
                                style={{ fontWeight: 'bold !important', fontStyle: 'italic !important' }}
                              >
                                <strong><em>{watch("workOrderValue") || "[Work Order Value]"}</em></strong>
                              </span> and wish to have the same registered in my name at the port of{" "}
                              <span
                                className={`highlight-field ${watch("nameOfRegistry") ? "auto-populated" : ""}`}
                                style={{ fontWeight: 'bold !important', fontStyle: 'italic !important' }}
                              >
                                <strong><em>{watch("nameOfRegistry") || "[Port of Registry]"}</em></strong>
                              </span> and that I am the owner of the same.
                            </p>

                          </div>
                        </div>
                      </div>
                    </Card.Body>
                  </Card>
                </Collapsible>

                {/* FORM-3 - Enclosers */}
                <div className="d-flex align-items-center mb-3 mt-4">
                  <h6 style={{ color: "#2466BF" }}>{t("FORM-3")}</h6>
                </div>
                <Collapsible
                  title={
                    <div className="d-flex align-items-center">
                      <FaUser className="me-2" style={{ color: "#2466BF" }} />
                      <span style={{ color: "#2466BF" }}>
                        {t("Enclosers")}
                      </span>
                    </div>
                  }
                  defaultOpen={true}
                >
                  <Card className="form-section-card">
                    <Card.Body>
                      <Row className="g-3">
                        <Col md={6}>
                          <div className="position-relative">
                            {renderFileField(
                              "thirdPartyInsurance",
                              "Insurance"
                            )}
                          </div>
                        </Col>
                        <Col md={6}>
                          <div className="position-relative">
                            {renderFileField(
                              "builderCertificate",
                              "Builder's Certificate"
                            )}
                          </div>
                        </Col>
                        <Col md={6}>
                          <div className="position-relative">
                            {renderFileField(
                              "instrumentOfSale",
                              "Instrument of Sale"
                            )}
                          </div>
                        </Col>
                        <Col md={6}>
                          <div className="position-relative">
                            {renderFileField(
                              "mortgageDetails",
                              "Mortgage Details"
                            )}
                          </div>
                        </Col>
                        <Col md={6}>
                          <div className="position-relative">
                            {renderFileField(
                              "pniInsurance",
                              "Protection & Indemnity Insurance"
                            )}
                          </div>
                        </Col>
                        <Col md={6}>
                          <div className="position-relative">
                            {renderFileField(
                              "declarationOfOwnership",
                              "Declaration of Ownership"
                            )}
                          </div>
                        </Col>
                        <Col md={6}>
                          <div className="position-relative">
                            {renderFileField("challan", "Challan")}
                          </div>
                        </Col>
                      </Row>
                    </Card.Body>
                  </Card>
                </Collapsible>
              </form>
            </Card.Body>
          </Card>
        </Container>
      </>
    );
  }
);

export default RegistrationApplicationForm;
