import React from "react";
import { useFormContext, Controller } from "react-hook-form";
import { Form, Row, Col, Card, Button } from "react-bootstrap";
import 'bootstrap/dist/css/bootstrap.min.css';

const DocumentUpload = () => {
  const { control, watch, setValue, formState: { errors } } = useFormContext();

  const documentTypes = [
    { value: "identity_proof", label: "Identity Proof" },
    { value: "address_proof", label: "Address Proof" }
  ];

  const watchedFiles = watch(["documentFile", "signatureFile"]);

  const handleFileChange = (fieldName, e) => {
    const file = e.target.files[0];
    if (file) {
      setValue(fieldName, file);
    }
  };

  const removeFile = (fieldName) => {
    setValue(fieldName, null);
  };

  return (
    <Card className="mb-4">
      <Card.Header className="bg-light">
        <h5 className="mb-0">Document Upload</h5>
      </Card.Header>
      <Card.Body>
        <Row className="mb-4">
          <Col md={6}>
            <Form.Group controlId="documentType">
              <Form.Label>Document Type <span className="text-danger">*</span></Form.Label>
              <Controller
                name="documentType"
                control={control}
                rules={{ required: "Document type is required" }}
                render={({ field }) => (
                  <Form.Select 
                    {...field} 
                    isInvalid={!!errors.documentType}
                  >
                    <option value="">Select document type</option>
                    {documentTypes.map((type) => (
                      <option key={type.value} value={type.value}>
                        {type.label}
                      </option>
                    ))}
                  </Form.Select>
                )}
              />
              {errors.documentType && (
                <Form.Control.Feedback type="invalid" className="d-block">
                  {errors.documentType.message}
                </Form.Control.Feedback>
              )}
            </Form.Group>
          </Col>
        </Row>

        <Row className="mb-4">
          <Col md={6}>
            <Form.Group controlId="documentFile">
              <Form.Label>Upload Document <span className="text-danger">*</span></Form.Label>
              <div className="border rounded p-3">
                {watchedFiles[0] ? (
                  <div className="d-flex justify-content-between align-items-center">
                    <div>
                      <i className="bi bi-file-earmark-text me-2"></i>
                      {watchedFiles[0].name}
                    </div>
                    <Button 
                      variant="outline-danger" 
                      size="sm"
                      onClick={() => removeFile("documentFile")}
                    >
                      <i className="bi bi-trash"></i>
                    </Button>
                  </div>
                ) : (
                  <div>
                    <input
                      type="file"
                      id="documentFile"
                      accept=".pdf,.jpg,.jpeg,.png"
                      onChange={(e) => handleFileChange("documentFile", e)}
                      className="d-none"
                    />
                    <label htmlFor="documentFile" className="btn btn-outline-primary w-100">
                      <i className="bi bi-cloud-arrow-up me-2"></i>Choose File
                    </label>
                    <div className="small text-muted mt-2">
                      Accepted formats: PDF, JPG, PNG (Max 5MB)
                    </div>
                  </div>
                )}
              </div>
              {errors.documentFile && (
                <Form.Control.Feedback type="invalid" className="d-block">
                  {errors.documentFile.message}
                </Form.Control.Feedback>
              )}
            </Form.Group>
          </Col>
        </Row>

        <Row>
          <Col>
            <Card className="border-primary">
              <Card.Header className="bg-primary text-white">
                Signature Upload
              </Card.Header>
              <Card.Body>
                <Form.Group controlId="signatureFile">
                  <Form.Label>Upload Signature (if any)</Form.Label>
                  <div className="border rounded p-3">
                    {watchedFiles[1] ? (
                      <div className="d-flex justify-content-between align-items-center">
                        <div>
                          <i className="bi bi-file-earmark-image me-2"></i>
                          {watchedFiles[1].name}
                        </div>
                        <Button 
                          variant="outline-danger" 
                          size="sm"
                          onClick={() => removeFile("signatureFile")}
                        >
                          <i className="bi bi-trash"></i>
                        </Button>
                      </div>
                    ) : (
                      <div>
                        <input
                          type="file"
                          id="signatureFile"
                          accept=".jpg,.jpeg,.png"
                          onChange={(e) => handleFileChange("signatureFile", e)}
                          className="d-none"
                        />
                        <label htmlFor="signatureFile" className="btn btn-outline-secondary w-100">
                          <i className="bi bi-pen me-2"></i>Upload Signature
                        </label>
                        <div className="small text-muted mt-2">
                          Accepted formats: JPG, PNG (Max 2MB)
                        </div>
                      </div>
                    )}
                  </div>
                </Form.Group>
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Card.Body>
    </Card>
  );
};

export default DocumentUpload;
