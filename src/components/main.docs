const ActionDropdown = ({ actions, onActionClick }) => {
  return (
    <>
      <Dropdown as={ButtonGroup}>
        <Button 
          variant="dd-primary"
          data-tooltip-id="action-tooltip"
          data-tooltip-content="Select an action to perform on this item"
          style={{
            height: "32px",
            minWidth: "100px",
            maxWidth: "100px",
            fontSize: "0.75rem",
            fontWeight: "600",
            padding: "6px 8px",
            textTransform: "none",
            borderTopRightRadius: "0",
            borderBottomRightRadius: "0",
            whiteSpace: "nowrap",
            overflow: "hidden",
            textOverflow: "ellipsis",
          }}
        >
          Take Action
        </Button>
        <Dropdown.Toggle 
          split 
          variant="dd-primary" 
          id="dropdown-split-basic"
          style={{
            height: "32px",
            minWidth: "20px",
            maxWidth: "20px",
            padding: "6px 4px",
            borderTopLeftRadius: "0",
            borderBottomLeftRadius: "0",
          }}
        />

        <Dropdown.Menu className="dd-primary-menu show-fade">
          {actions?.map((action, idx) => (
            <Dropdown.Item
              key={idx}
              className="dd-primary-item"
              onClick={() => onActionClick(action)}
            >
              {getIconForAction(action?.actionName)} {action?.actionName}
            </Dropdown.Item>
          ))}
        </Dropdown.Menu>
      </Dropdown>
      
      <Tooltip 
        id="action-tooltip" 
        place="top"
        style={{
          backgroundColor: "#333",
          color: "#fff",
          fontSize: "0.75rem",
          padding: "4px 8px",
          borderRadius: "4px",
          zIndex: 9999
        }}
      />
    </>
  );
};
