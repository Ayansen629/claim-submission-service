import React, { useState, useEffect } from 'react';
import { Table, Dropdown, Form, Button, Tooltip, OverlayTrigger } from 'react-bootstrap';
import {
    PencilSquare,
    Eye,
    Trash3,
    GeoAlt,
    Plus,
    ArrowDown,
    ArrowUp,
    Database,
    Check,
    Calendar,
    FileEarmarkText,
    GeoAltFill
} from 'react-bootstrap-icons';
import { useNavigate } from 'react-router-dom';
import './ActionTable.module.css';

const ActionTable = (props) => {
    // ... (keep all your existing state and effect hooks)

    // ... (keep all your existing handler functions)

    return (
        <div className="mb-5 px-0 mx-0 generic-action-table pt-3">
            {/* Search and Filter Controls - keep as is */}

            {/* Table */}
            <div className="table-responsive mb-3" style={{ overflowX: 'hidden' }}>
                <Table className="table align-middle" style={{ width: '100%', tableLayout: 'fixed', marginBottom: '0' }}>
                    <thead className="table-primary">
                        <tr>
                            {/* Checkbox column - keep as is */}
                            
                            {props.columns?.map((data) => (
                                !hideColumns.includes(data.fieldName) && (
                                    <th
                                        key={data.fieldName}
                                        className="text-center"
                                        style={{ 
                                            minWidth: data.minWidth || '120px',
                                            width: data.width || 'auto',
                                            padding: '12px 8px'
                                        }}
                                        onClick={() => sortByColumn(data.fieldName)}
                                    >
                                        <div className="d-flex justify-content-center align-items-center">
                                            <span>{data.titleCode || data.colName}</span>
                                            {showSortedColumnIcon(data.fieldName)}
                                        </div>
                                    </th>
                                )
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        {currentItems.length > 0 ? (
                            currentItems.map((row) => (
                                <tr key={row.id} className={isSelected(row.id) ? 'selected-row' : ''} style={{ borderBottom: '1px solid #e9ecef' }}>
                                    {/* Checkbox cell - keep as is */}
                                    
                                    {props.columns.map((col) => {
                                        if (hideColumns.includes(col.fieldName)) return null;

                                        const cellValue = col.fieldName.split('.').reduce((obj, key) => obj?.[key], row);
                                        const displayValue = cellValue?.toString() || '';
                                        const firstWord = displayValue.split(' ')[0];

                                        if (col.fieldName === 'action') {
                                            return (
                                                <td key="actions" className="text-center" style={{ padding: '8px' }}>
                                                    <div className="d-flex justify-content-center gap-2">
                                                        {/* Action buttons - keep as is but update track icon */}
                                                        {col.actions?.includes("track") && (
                                                            <OverlayTrigger overlay={<Tooltip>Track</Tooltip>}>
                                                                <Button variant="outline-primary" size="sm" onClick={() => handleTrack(row)}>
                                                                    <GeoAltFill className="action-icon" />
                                                                </Button>
                                                            </OverlayTrigger>
                                                        )}
                                                        {/* Other action buttons */}
                                                    </div>
                                                </td>
                                            );
                                        }

                                        // Special handling for claim number (show first word with tooltip)
                                        if (col.fieldName === 'claimNumber') {
                                            return (
                                                <td key={col.fieldName} className="text-center" style={{ padding: '8px' }}>
                                                    <OverlayTrigger overlay={<Tooltip>{displayValue}</Tooltip>}>
                                                        <div className="text-truncate" style={{ maxWidth: '120px', display: 'inline-block' }}>
                                                            {userData?.userType === "CRP" ? (
                                                                <a
                                                                    href={`/apply-claim/${row.uuid}`}
                                                                    onClick={(e) => { e.preventDefault(); navigate(`/apply-claim/${row.uuid}`); }}
                                                                    className="text-primary"
                                                                >
                                                                    {firstWord || 'N/A'}
                                                                </a>
                                                            ) : firstWord || 'N/A'}
                                                        </div>
                                                    </OverlayTrigger>
                                                </td>
                                            );
                                        }

                                        // Special handling for comment (show first word with tooltip)
                                        if (col.fieldName === 'comment') {
                                            return (
                                                <td key={col.fieldName} className="text-center" style={{ padding: '8px' }}>
                                                    <OverlayTrigger overlay={<Tooltip>{displayValue || 'No comment'}</Tooltip>}>
                                                        <div className="text-truncate" style={{ maxWidth: '120px', display: 'inline-block' }}>
                                                            {firstWord || (
                                                                <span className="text-muted">
                                                                    <FileEarmarkText className="me-1" />
                                                                    None
                                                                </span>
                                                            )}
                                                        </div>
                                                    </OverlayTrigger>
                                                </td>
                                            );
                                        }

                                        // Default cell rendering (show full content)
                                        return (
                                            <td key={col.fieldName} className="text-center" style={{ padding: '8px' }}>
                                                <div className="cell-content">
                                                    {displayValue || (
                                                        <span className="text-muted">
                                                            <FileEarmarkText className="me-1" />
                                                            None
                                                        </span>
                                                    )}
                                                </div>
                                            </td>
                                        );
                                    })}
                                </tr>
                            ))
                        ) : (
                            <tr>
                                <td colSpan={props.columns.length + 1} className="text-center py-5">
                                    <div className="d-flex flex-column justify-content-center align-items-center">
                                        <Database size={48} className="text-muted mb-3" />
                                        <h5 className="text-muted">No records found</h5>
                                        <p className="text-muted">Try adjusting your search or filter criteria</p>
                                    </div>
                                </td>
                            </tr>
                        )}
                    </tbody>
                </Table>
            </div>

            {/* Table Footer - keep as is */}
        </div>
    );
};

export default ActionTable;

/* Table Container */
.generic-action-table {
  background-color: #fff;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  width: 100%;
  padding: 0 15px;
}

/* Table Structure */
.table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 0;
  table-layout: fixed;
}

/* Table Header */
.table thead th {
  position: sticky;
  top: 0;
  background-color: #269ccc;
  color: white;
  font-weight: 500;
  vertical-align: middle;
  text-align: center;
  border: none;
  padding: 12px 8px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 0.9rem;
}

/* Table Body */
.table tbody td {
  vertical-align: middle;
  padding: 8px;
  border-bottom: 1px solid #e9ecef;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 0.85rem;
}

/* Compact table cells */
.table td, .table th {
  padding: 8px;
}

/* Cell content styling */
.cell-content {
  white-space: normal;
  word-wrap: break-word;
  max-width: 100%;
  display: inline-block;
  line-height: 1.4;
}

/* Truncated cells for claim number and comment */
.text-truncate {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: inline-block;
  vertical-align: middle;
  max-width: 100%;
}

/* Checkbox Column */
.table th:first-child,
.table td:first-child {
  width: 50px;
  min-width: 50px;
  max-width: 50px;
  padding-left: 12px;
  padding-right: 12px;
}

/* Selected Row */
.selected-row {
  background-color: #f8f9fa;
}

/* Action Buttons */
.action-icon {
  font-size: 1rem;
}

/* Track button styling */
.btn-outline-primary .geo-alt-fill {
  color: #269ccc;
}

/* Status cell styling */
.status-cell {
  font-weight: 500;
  padding: 4px 8px;
  border-radius: 4px;
  display: inline-block;
}

/* No data styling */
.text-muted {
  color: #6c757d !important;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
}

/* Tooltip styling */
.tooltip-inner {
  max-width: 300px;
  padding: 8px 12px;
  font-size: 0.8rem;
  background-color: #333;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .generic-action-table {
    padding: 0 8px;
  }
  
  .table thead th,
  .table tbody td {
    padding: 8px 4px;
    font-size: 0.75rem;
  }
  
  .action-icon {
    font-size: 0.9rem;
  }
}
