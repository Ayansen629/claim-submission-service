const handleActionClick = (action) => {
  if (action?.actionName === "Generate CMN") {
    setShowCmnStepper(true);
    
    // Get all original actions from API response
    const originalActions = registrationData?.processActionMapResponce?.[0]?.processs?.[0]?.actions || [];
    
    // Filter out "Generate CMN" and keep all other actions including "Forward"
    const updatedActions = originalActions.filter(item => item.actionName !== "Generate CMN");
    
    setActionsFromAPI(updatedActions);
    
    toast.success(
      "CMN Generated successfully. Please proceed with the next step."
    );
    return;
  }

  setSelectedAction(action);
  setShowApprovalModal(true);
};
