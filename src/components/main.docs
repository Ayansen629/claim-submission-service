import React, { useEffect, useState } from "react";
import { Link, useLocation } from "react-router-dom";
import {
  FaHome,
  FaUser,
  FaCog,
  FaChevronRight,
  FaShip,
  FaDatabase,
  FaTimes,
  FaFileAlt,
  FaUsers,
  FaUpload
} from "react-icons/fa";
import "./styles/Sidebar.css";

const Sidebar = ({ isSidebarOpen, onMenuClick, onClose, userRole }) => {
  const location = useLocation();
  const [activeMenu, setActiveMenu] = useState("");
  const [expandedMenus, setExpandedMenus] = useState({});

  // Define menu items based on user role
  const getMenuItems = () => {
    const commonItems = [
      {
        name: "dashboard",
        label: "Dashboard",
        icon: <FaHome />,
        path: "/dashboard"
      },
      {
        name: "settings",
        label: "Settings",
        icon: <FaCog />,
        subMenu: [
          { name: "profile", label: "Profile", path: "/settings/profile" },
          { name: "security", label: "Security", path: "/settings/security" },
        ],
      }
    ];

    if (userRole === "admin") {
      return [
        ...commonItems,
        {
          name: "vessel-registration",
          label: "Vessel Registration",
          path: "/vessel-registration/new-vessel",
          icon: <FaShip />,
          subMenu: [
            { 
              name: "new-vessel", 
              label: "New Vessel Registration", 
              path: "/vessel-registration/new-vessel",
              icon: <FaFileAlt />
            },
            { 
              name: "name-change", 
              label: "Name Change of Vessel", 
              path: "/vessel-registration/name-change",
              icon: <FaFileAlt />
            },
            { 
              name: "upload-legacy-data", 
              label: "Upload Legacy Data", 
              path: "/vessel-registration/upload-legacy-data",
              icon: <FaUpload />
            },
          ],
        },
        {
          name: "master",
          label: "Master",
          icon: <FaDatabase />,
          subMenu: [
            { 
              name: "manage-employee", 
              label: "Employee Management", 
              path: "/iwt/employee-management",
              icon: <FaUsers />
            },
          ],
        }
      ];
    }
    else if (["L1", "L2", "L3"].includes(userRole)) {
      // Officer roles only see dashboard and settings
      return commonItems;
    }
    else {
      // Other roles (vessel_owner, builder, employee)
      return [
        ...commonItems,
        {
          name: "vessel-registration",
          label: "Vessel Registration",
          path: "/vessel-registration/new-vessel",
          icon: <FaShip />,
          subMenu: [
            { 
              name: "new-vessel", 
              label: "New Vessel Registration", 
              path: "/vessel-registration/new-vessel",
              icon: <FaFileAlt />
            },
            { 
              name: "modification", 
              label: "Vessel Modification", 
              path: "/vessel-registration/modification",
              icon: <FaFileAlt />
            },
          ],
        }
      ];
    }
  };

  const menuItems = getMenuItems();

  useEffect(() => {
    const current = menuItems.find((item) => {
      if (item.subMenu) {
        return item.subMenu.some((sub) => sub.path === location.pathname);
      }
      return item.path === location.pathname;
    });
    setActiveMenu(current?.name || "");
  }, [location, menuItems]);

  const toggleSubMenu = (menuName) => {
    setExpandedMenus((prev) => ({
      ...prev,
      [menuName]: !prev[menuName],
    }));
  };

  return (
    <>
      <div
        className={`custom-sidebar ${isSidebarOpen ? "expanded" : "collapsed"}`}
      >
        {isSidebarOpen && (
          <div className="custom-sidebar-close">
            <FaTimes onClick={onClose} />
          </div>
        )}

        <ul className="custom-sidebar-menu">
          {menuItems.map((item, index) => {
            const isActive = activeMenu === item.name;
            const hasSubMenu = !!item.subMenu;
            const isSubMenuExpanded = expandedMenus[item.name];

            return (
              <li 
                key={`${item.name}-${index}`} 
                className={`custom-sidebar-item ${isActive ? "active" : ""}`}
              >
                <div
                  className="custom-sidebar-link"
                  onClick={() => {
                    if (hasSubMenu) {
                      toggleSubMenu(item.name);
                    } else {
                      onMenuClick(item.name);
                      if (item.path) {
                        // Handle navigation if needed
                      }
                    }
                  }}
                >
                  <div className="custom-sidebar-link-content">
                    <span className="custom-sidebar-icon">{item.icon}</span>
                    {isSidebarOpen && <span>{item.label}</span>}
                  </div>
                  {hasSubMenu && isSidebarOpen && (
                    <span className={`custom-sidebar-chevron ${isSubMenuExpanded ? "rotate" : ""}`}>
                      <FaChevronRight size={12} />
                    </span>
                  )}
                </div>

                {hasSubMenu && isSubMenuExpanded && isSidebarOpen && (
                  <div className="custom-sidebar-submenu">
                    {item.subMenu.map((subItem, subIndex) => (
                      <Link
                        key={`${subItem.name}-${subIndex}`}
                        to={subItem.path}
                        className={`custom-sidebar-sublink ${
                          location.pathname === subItem.path ? "active" : ""
                        }`}
                        onClick={() => onMenuClick(subItem.name)}
                      >
                        <span className="custom-sidebar-subicon">
                          {subItem.icon}
                        </span>
                        <span>{subItem.label}</span>
                      </Link>
                    ))}
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </>
  );
};

export default Sidebar;
