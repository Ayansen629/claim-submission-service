import React, { useState, useEffect } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Form, Button, Card, Image, Alert } from 'react-bootstrap';
import { 
  FaUser, FaBuilding, FaFileUpload, FaCheck, FaArrowRight, 
  FaArrowLeft, FaIdCard, FaEnvelope, FaPhone, FaMapMarkerAlt, FaUpload, FaShip 
} from 'react-icons/fa';
import './UserRegistration.css';
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";

import InputText from '../../common/InputText.tsx';
import InputFile from '../../common/InputFile';

const VesselOwnerRegistrationPage = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [validationMessage, setValidationMessage] = useState("");
  
  const methods = useForm({
    mode: 'onBlur',
    defaultValues: { ownerCategory: 'company', country: 'India' }
  });
  
  const { register, handleSubmit, formState: { errors }, trigger, setValue, getValues, watch, clearErrors, setError } = methods;
  const totalSteps = 3;
  const ownerCategory = watch('ownerCategory');

  const formFields = {
    step1: [
      // ... (keep your existing step1 fields unchanged)
    ],
    step2: [
      // ... (keep your existing step2 fields unchanged)
    ],
    step3: [
      {
        name: 'panCardUpload',
        label: 'PAN Card',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'gstCertificate',
        label: 'GST Certificate',
        type: 'file',
        required: false,
        colSize: 6
      },
      {
        name: 'addressProof',
        label: 'Address Proof',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'companyRegistrationCertificate',
        label: 'Company Registration Certificate',
        type: 'file',
        required: false,
        colSize: 6,
        showIf: () => ownerCategory === 'company' || ownerCategory === 'organization'
      },
      {
        name: 'cinNumber',
        label: 'CIN Number',
        type: 'text',
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter CIN number',
        validation: { 
          pattern: {
            value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
            message: 'Invalid CIN format'
          }
        },
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'dinNumber',
        label: 'DIN Number',
        type: 'text',
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter DIN number',
        validation: { 
          pattern: {
            value: /^[0-9]{8}$/,
            message: 'DIN must be 8 digits'
          }
        },
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'moaCertificate',
        label: 'MOA Certificate',
        type: 'file',
        required: false,
        colSize: 6,
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'aoaCertificate',
        label: 'AOA Certificate',
        type: 'file',
        required: false,
        colSize: 6,
        showIf: () => ownerCategory === 'company'
      }
    ]
  };

  // Get fields for current step that should be visible
  const getCurrentStepFields = () => {
    const stepFields = currentStep === 1 ? formFields.step1 : 
                     currentStep === 2 ? formFields.step2 : 
                     formFields.step3;
    
    return stepFields.filter(field => {
      if (!field.showIf) return true;
      return field.showIf();
    });
  };

  // Validate current step
  const validateStep = async () => {
    const fieldsToValidate = getCurrentStepFields()
      .filter(field => field.required)
      .map(field => field.name);
    
    const isValid = await trigger(fieldsToValidate);
    
    if (!isValid) {
      const firstError = Object.keys(errors)[0];
      if (firstError) {
        const element = document.getElementsByName(firstError)[0];
        if (element) {
          element.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
      
      // Generate validation message
      const missingFields = getCurrentStepFields()
        .filter(field => field.required && errors[field.name])
        .map(field => field.label);
      
      if (missingFields.length > 0) {
        setValidationMessage(`Please fill all mandatory fields: ${missingFields.join(', ')}`);
      }
    } else {
      setValidationMessage("");
    }
    
    return isValid;
  };

  // Handle next button click
  const handleNext = async () => {
    const isStepValid = await validateStep();
    
    if (isStepValid) {
      const currentValues = getValues();
      setFormData(prev => ({ ...prev, ...currentValues }));
      
      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    }
  };

  // Handle previous button click
  const handlePrevious = () => {
    const currentValues = getValues();
    setFormData(prev => ({ ...prev, ...currentValues }));
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
    setValidationMessage("");
  };

  // Handle form submission
  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };
    console.log('Form submitted with data:', JSON.stringify(finalData, null, 2));
    setIsSubmitted(true);
    window.scrollTo(0, 0);
  };

  // Dynamic Field Component
  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field.onChange) field.onChange(e);
      
      // Clear error when user starts typing
      if (e.target.value && errors[field.name]) {
        clearErrors(field.name);
        setValidationMessage("");
      }
    };

    switch(field.type) {
      case 'select':
        return (
          <Form.Group className="form-group mb-4">
            <Form.Label className="fw-bold text-dark">
              {field.label} {field.required && <span className="required text-danger">*</span>}
            </Form.Label>
            <div className="input-with-icon">
              <Form.Select 
                {...register(field.name, {
                  ...field.validation,
                  onChange: handleChange
                })}
                className={`form-select custom-select ${errors[field.name] ? 'is-invalid border-danger' : ''}`}
                disabled={field.readOnly}
                style={{ 
                  height: '50px', 
                  borderRadius: '8px',
                  borderColor: errors[field.name] ? '#dc3545' : '#ced4da',
                  backgroundColor: errors[field.name] ? '#fff8f8' : 'white'
                }}
              >
                {field.options.map((option, idx) => (
                  <option key={idx} value={option.value}>{option.label}</option>
                ))}
              </Form.Select>
              {field.icon && <field.icon className="input-icon text-primary" />}
            </div>
            {errors[field.name] && (
              <div className="error-message text-danger small mt-1">
                {errors[field.name].message}
              </div>
            )}
          </Form.Group>
        );
      
      case 'file':
        return (
          <Form.Group className="form-group mb-4">
            <Form.Label className="fw-bold text-dark">
              {field.label} {field.required && <span className="required text-danger">*</span>}
            </Form.Label>
            <div className={`file-upload border rounded p-3 ${errors[field.name] ? 'border-danger' : ''}`} 
                 style={{ borderRadius: '8px', backgroundColor: errors[field.name] ? '#fff8f8' : 'white' }}>
              <input 
                type="file" 
                id={field.name}
                {...register(field.name, field.validation)}
                onChange={(e) => {
                  if (e.target.files?.[0]) {
                    setValue(field.name, e.target.files[0].name);
                    clearErrors(field.name);
                    setValidationMessage("");
                  }
                }}
                className="file-input d-none"
              />
              <label htmlFor={field.name} className="file-label btn btn-outline-primary mb-0 d-inline-flex align-items-center" style={{ borderRadius: '6px' }}>
                <FaUpload className="file-icon me-2" />
                <span className="file-text">Choose File</span>
              </label>
              <span className="file-name ms-3 text-muted">
                {watch(field.name) ? watch(field.name) : 'No file chosen'}
              </span>
            </div>
            <div className="file-help-text text-muted small mt-1">Upload PDF, JPG or PNG file (Max size: 2MB)</div>
            {errors[field.name] && (
              <div className="error-message text-danger small mt-1">
                {errors[field.name].message}
              </div>
            )}
          </Form.Group>
        );
      
      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field.name, {
              ...field.validation,
              onChange: handleChange
            })}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            className="mb-4"
            style={{
              borderColor: errors[field.name] ? '#dc3545' : '#ced4da',
              backgroundColor: errors[field.name] ? '#fff8f8' : 'white'
            }}
          />
        );
    }
  };

  // ... rest of your component code remains the same ...

  return (
    <Container fluid className="registration-container py-5">
      {/* ... your existing JSX ... */}
    </Container>
  );
};

export default VesselOwnerRegistrationPage;

import React, { useState } from "react";
import { Form, InputGroup, OverlayTrigger, Tooltip } from "react-bootstrap";
import { FaEye, FaEyeSlash } from "react-icons/fa";
import classNames from "classnames";

interface InputTextProps {
  label: string;
  required?: boolean;
  name: string;
  type?: string;
  placeholder?: string;
  register?: any;
  disabled?: boolean;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  maxlength?: number;
  readOnly?: boolean;
  errors?: Record<string, { message?: string }>;
  className?: string;
  onKeyDown?: (e: React.KeyboardEvent<HTMLInputElement>) => void;
  icon?: React.ElementType;
  description?: string;
  style?: React.CSSProperties;
}

const InputText: React.FC<InputTextProps> = ({
  label,
  required,
  name,
  type = "text",
  placeholder,
  register,
  disabled,
  onChange,
  maxlength,
  readOnly,
  errors,
  className = "",
  onKeyDown,
  icon: IconComponent,
  description,
  style = {}
}) => {
  const [showPassword, setShowPassword] = useState(false);

  const isPassword = type === "password";
  const inputType = isPassword ? (showPassword ? "text" : "password") : type;

  const togglePasswordVisibility = () => setShowPassword((prev) => !prev);

  const inputClasses = classNames("shadow-sm", {
    "is-invalid": errors?.[name],
    "border-start-0": IconComponent,
    "border-end-0": isPassword,
  });

  const visibilityIcon = showPassword ? (
    <FaEyeSlash className="fade-icon" size={18} color="#387AD4" />
  ) : (
    <FaEye className="fade-icon" size={18} color="#387AD4" />
  );

  const combinedStyle = {
    ...style,
    borderColor: errors?.[name] ? '#dc3545' : undefined,
    backgroundColor: errors?.[name] ? '#fff8f8' : undefined
  };

  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      {label && (
        <Form.Label className="fw-semibold">
          {label}
          {required && <span className="text-danger ms-1">*</span>}
        </Form.Label>
      )}

      <InputGroup className="flex-nowrap">
        {IconComponent && (
          <InputGroup.Text className="bg-white border-end-0">
            <IconComponent size={18} color="#387AD4" />
          </InputGroup.Text>
        )}

        <Form.Control
          type={inputType}
          name={name}
          placeholder={placeholder}
          {...register}
          disabled={disabled}
          onChange={onChange}
          maxLength={maxlength}
          readOnly={readOnly}
          onKeyDown={onKeyDown}
          min={0}
          className={inputClasses}
          aria-label={label}
          style={combinedStyle}
        />

        {isPassword && (
          <OverlayTrigger
            placement="top"
            overlay={
              <Tooltip id={`tooltip-${name}`}>
                {showPassword ? "Hide password" : "Show password"}
              </Tooltip>
            }
          >
            <InputGroup.Text
              className="bg-white border-start-0"
              role="button"
              onClick={togglePasswordVisibility}
              aria-label="Toggle password visibility"
              style={{ cursor: "pointer" }}
            >
              {visibilityIcon}
            </InputGroup.Text>
          </OverlayTrigger>
        )}
      </InputGroup>

      {description && (
        <Form.Text style={{ color: "#5A67D8" }} className="d-block mt-1">
          {description}
        </Form.Text>
      )}

      {errors?.[name]?.message && (
        <Form.Text className="text-danger d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputText;
