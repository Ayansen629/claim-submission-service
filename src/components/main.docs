import { useNavigate } from "react-router-dom";
import "react-toastify/dist/ReactToastify.css";
import { postData } from "../../../../services/http.service.ts";
import { useTranslation } from "react-i18next";
import { useEffect, useState } from "react";
import ActionTable from "../../../common/ActionTable.tsx";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import { toast } from "react-toastify";
import ActionModal from "../../../common/ActionModal.tsx";
import {
  APP_MESSAGES,
  CONSTANT_REGEX_SAMPLE,
} from "../../../../utils/constants.ts";
import UserManageForm from "./userManageForm";
import EmployeeRegistrationForm from "../../../common/EmployeeRegistrationForm.js";

import { FormProvider, useForm } from "react-hook-form";
import { USER_REGIS_MASTER } from "./userManagConst.ts";
import { Card, Row, Col, Button } from "react-bootstrap";

import InputSelect from "../../../common/InputSelect.tsx";
import InputText from "../../../common/InputText.tsx";
const formData: any = {
  salutation: "",
  nameAsPerAadhar: "",
  userName: "",
  firstName: "",
  middleName: "",
  lastName: "",
  mobileNumber: "",
  aadharNumber: "",
  password: "",
  plainPassword: "",
  active: true,
  isBlocked: false,
  blockedAt: "",
  alternateMobileNumber: "",
  emailId: "",
  gender: "",
  panNumber: "",
  voterIdNumber: "",
  drivingLicense: "",
  address: "",
  gurdianName: "",
  gurdianRelation: "",
  type: "",
  dob: "",
  ageOnDate: "",
  bloodGroup: "",
  photo: "",
  identificationMark: "",
  nationality: "",
  educationQualification: "",
  individualTypeDesignation: "",
  panAttachmentUrl: "",
  passwordExpiryDate: "",
  rolesCode: "",
  districtName: "",
  blockName: "",
  panchayatName: "",
  projectCode: "",
  projectName: "",
  ifscCode: "",
  bankName: "",
  bankType: "",
};

type EmployeeSearchFormData = {
  empId?: string;
  empName?: string;
  designation?: string;
  status?: string;
  phoneNumber?: string;
};

const UserManagement = () => {
  const { t } = useTranslation();
  let navigate = useNavigate();
  const [rowData, setRowData] = useState([]);
  const [modal, setModal] = useState(false);
  const [modalAction, setModalAction] = useState("");
  const [userFormData, setuserFormData] = useState(formData);
  const [modalTitle, setModalTitle] = useState(t("AddUser"));
const [showEmployeeModal, setShowEmployeeModal] = useState(false);

  const {
    register,
    control,
    handleSubmit,
    watch,
    reset,
    setValue,
    formState: { errors },
  } = useForm<EmployeeSearchFormData>();

  const methods = useForm({
      defaultValues: {
        personal: {
          firstName: "",
          lastName: "",
          email: "",
          phoneNumber: "",
          gender: "",
          dob: ""
        },
        address: {
          line1: "",
          line2: "",
          pin: "",
          district: "",
          state: "",
          country: ""
        },
        educationDetails: [{
          qualification: "",
          stream: "",
          yearOfPassing: ""
        }],
        professional: {
          appointmentDate: "",
          employeeType: "",
          employeeStatus: "",
          designation: "",
          department: "",
          section: "",
          roles: ""
        },
        documents: {
          addressProof: null,
          identityProof: null,
          appointmentLetter: null
        }
      }
    });

  const userBaseURL: any = process.env.REACT_APP_USER_SERVICE;
  const userServiceEndPoint: any = URLS_ENDPOINT?.USER_SERVICE;

  useEffect(() => {
    setuserFormData([]);
    getUserDetails();
  }, []);
  const columns = USER_REGIS_MASTER.USER_INFO_COLUMNS;
    const userMockData:any=USER_REGIS_MASTER.MOCK_USER_DATA;
     const [isLoading, setIsLoading] = useState(false);
 
 const getUserDetails = async () => {
  setIsLoading(true);
  try {
    // Use the mock data from USER_REGIS_MASTER
    setTimeout(() => {
      setRowData(userMockData);
      setIsLoading(false);
    }, 500);
  } catch (error) {
    console.error("Error fetching user details:", error);
    toast.error(t("Error fetching user details"));
    setIsLoading(false);
  }
};
  const handleRowClick = (e: any) => {};
  const handleBtnClick = (e: any) => {
    setModal(!modal);
  };

//  const handleBtnClick = (e) => {
//   setShowEmployeeModal(true);
// };


  const handleModalSubmit = (e: any) => {
    // setModalAction(e)
    // handleFormSubmit(userFormData)
  };
  const handleEditRow = (e: any) => {
    setModalTitle(t("EditUser"));
    setuserFormData(e);
    console.log(e);
    console.log(userFormData);
    setModal(!modal);
  };
  const Toggle = () => {
    setuserFormData(formData);
    setModal(!modal);
  };

  const onSubmitFilterForm = async (e: any) => {
    if (e && Object.keys(e).length > 0) {
    }
  };
 const handleFormSubmit = async (data) => {
    try {
      const formData = new FormData();
      
      // Append all form data
      Object.entries(data).forEach(([key, value]) => {
        if (key === "documents") {
          Object.entries(value).forEach(([docKey, docValue]) => {
            if (docValue) formData.append(docKey, docValue[0]);
          });
        } else {
          formData.append(key, JSON.stringify(value));
        }
      });

      // Submit formData to your API
      await postData("your-api-endpoint", formData);
      toast.success("Employee registered successfully!");
      Toggle();
    } catch (error) {
      toast.error("Error submitting form");
    }
  };
  

  return (
    <>
      <div className="w-full">
        <Card>
          <form
            style={{ padding: "2rem", margin: 0 }}
            onSubmit={handleSubmit(onSubmitFilterForm)}
          >
            <Row>
              <Col md={2}>
                <InputText
                  type="text"
                  name="empId"
                  maxlength={10}
                  label="Employee Id"
                  placeholder="Enter Employee Id"
                  register={{
                    ...register("empId", {}),
                  }}
                  errors={errors}
                  onKeyDown={(e) => {
                    if (!/^\d$/.test(e.key)) {
                      e.preventDefault();
                    }
                  }}
                />
              </Col>

              <Col md={2}>
                <InputText
                  type="text"
                  name="empName"
                  label="Employee Name"
                  placeholder="Enter employee name"
                  register={{
                    ...register("empName", {}),
                  }}
                  errors={errors}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label="Designation"
                  name="designation"
                  options={[
                    { value: 1, label: "Senior Engg" },
                    { value: 2, label: "Junior Engg" },
                    { value: 3, label: "Vessel Owner" },
                  ]}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected Desig :", val)}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label="Status"
                  name="status"
                  options={[
                    { value: "active", label: "Active" },
                    { value: "inactive", label: "Inactive" },
                  ]}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected:", val)}
                />
              </Col>

              <Col md={2}>
                <InputText
                  type="text"
                  name="phoneNumber"
                  label="Phone Number"
                  maxlength={10}
                  placeholder="Enter Phone Number"
                  register={{
                    ...register("phoneNumber", {}),
                  }}
                  onKeyDown={(e) => {
                    if (!/^\d$/.test(e.key)) {
                      e.preventDefault();
                    }
                  }}
                  errors={errors}
                />
              </Col>

              <Col
                md={2}
                style={{ display: "flex", position: "relative", top: "2rem" }}
              >
                <Col>
                  <button className="generic-btn-submit" type="submit">
                    Filter
                  </button>
                </Col>
                &nbsp;&nbsp;
                <Col>
                  <button
                    className="generic-btn-cancel"
                    type="reset"
                    onClick={() => {
                      reset();
                    }}
                  >
                    {t("login.reset")}
                  </button>
                </Col>
              </Col>
            </Row>
            <Row className="mt-2">
              <Col md={{ span: 2, offset: 10 }} className="d-flex justify-content-end">
                <button
                  className="generic-btn-submit"
                  type="button"
                  onClick={handleBtnClick}
                >
                  <i className="fa fa-plus" aria-hidden="true"></i> {t("Add")}
                </button>
              </Col>
            </Row>
          </form>
        </Card>
        <>
          <ActionTable
            tableHeader="Employee List"
            columns={columns}
            rowData={rowData}
            additionalMethod={handleRowClick}
            showCustomBtn={true}
            btnName={t("Add")}
            handleBtnClick={handleBtnClick}
            handleEditRow={handleEditRow}
            hideExportBtn={true}
            searchBarPlaceholder={t("Table.SEARCH_BY")}
          />
        </>

        <ActionModal
          show={modal}
          close={Toggle}
          handleModalSubmit={methods.handleSubmit(handleFormSubmit)}
          title={modalTitle}
          action={modalAction}
          isFooterHide={true}
          size={"lg"}
        >
           <FormProvider {...methods}>
                    <form onSubmit={methods.handleSubmit(handleFormSubmit)}>
                      <EmployeeRegistrationForm/>
                      <div className="text-center mt-4">
                        <Button variant="primary" type="submit">
                          Submit
                        </Button>
                      </div>
                    </form>
                  </FormProvider>
          {/* <UserManageForm
            userFormData={userFormData}
            onFormSubmit={handleFormSubmit}
            action={modalAction}
          /> */}
        </ActionModal>
      </div>
    </>
  );
};

export default UserManagement;
////////////////

import { useEffect } from "react";
import { useFieldArray, useFormContext } from "react-hook-form";
import { Card, Row, Col, Button } from "react-bootstrap";
import InputSelect from "../common/InputSelect.tsx";
import InputText from "../common/InputText.tsx";
import Collapsible from "../common/Collapsible";

const EmployeeRegistrationForm = () => {
  const { control, register, setValue, watch, formState: { errors } } = useFormContext();
  const { fields, append, remove } = useFieldArray({
    control,
    name: "educationDetails"
  });

  const watchPin = watch("address.pin");
  
 
 // Auto-populate address details
  useEffect(() => {
    const fetchAddressDetails = async (pin) => {
      if (pin?.length === 6) {
        try {
          // Simulated API call
          const response = await fetch(`https://api.postalpincode.in/pincode/${pin}`);
          const data = await response.json();
          
          if(data[0].Status === "Success") {
            const postOffice = data[0].PostOffice[0];
            setValue("address.district", postOffice.District);
            setValue("address.state", postOffice.State);
            setValue("address.country", postOffice.Country);
          }
        } catch (error) {
          console.error("Error fetching address details:", error);
        }
      }
    };

    fetchAddressDetails(watchPin);
  }, [watchPin, setValue]);


  return (
    <div className="employee-registration-form">
      {/* Personal Details Section */}
      <Collapsible title="Personal Details" defaultOpen={true}>
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={4}>
                <InputText
                  name="personal.firstName"
                  label="First Name"
                  register={register}
                  errors={errors}
                  validation={{ required: "First Name is required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.lastName"
                  label="Last Name"
                  register={register}
                  errors={errors}
                  validation={{ required: "Last Name is required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.email"
                  label="Email ID"
                  type="email"
                  register={register}
                  errors={errors}
                  validation={{
                    required: "Email is required",
                    pattern: {
                      value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                      message: "Invalid email address"
                    }
                  }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.phoneNumber"
                  label="Phone Number"
                  register={register}
                  errors={errors}
                  validation={{
                    required: "Phone Number is required",
                    pattern: {
                      value: /^\d{10}$/,
                      message: "Invalid phone number"
                    }
                  }}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="personal.gender"
                  label="Gender"
                  options={[
                    { value: "male", label: "Male" },
                    { value: "female", label: "Female" },
                    { value: "other", label: "Other" }
                  ]}
                  register={register}
                  errors={errors}
                  validation={{ required: "Gender is required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.dob"
                  label="Date of Birth"
                  type="date"
                  register={register}
                  errors={errors}
                  validation={{ required: "Date of Birth is required" }}
                />
              </Col>
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Address Details Section */}
    <Collapsible title="Address Details">
      <Card className="form-section-card">
        <Card.Body>
          <Row className="g-3">
            {/* Other address fields */}
            <Col md={4}>
              <InputText
                name="address.pin"  // Correct nested field name
                label="PIN Code"
                register={register}
                errors={errors}
                validation={{
                  required: "PIN Code is required",
                  pattern: {
                    value: /^\d{6}$/,
                    message: "Invalid PIN code (must be 6 digits)"
                  }
                }}
              />
            </Col>
            {/* Auto-populated fields */}
            <Col md={4}>
              <InputText
                name="address.district"
                label="District"
                register={register}
                errors={errors}
                readOnly
              />
            </Col>
            <Col md={4}>
              <InputText
                name="address.state"
                label="State/UT"
                register={register}
                errors={errors}
                readOnly
              />
            </Col>
            <Col md={4}>
              <InputText
                name="address.country"
                label="Country"
                register={register}
                errors={errors}
                readOnly
              />
            </Col>
          </Row>
        </Card.Body>
      </Card>
    </Collapsible>

      {/* Education Details Section */}
      <Collapsible title="Education Details">
        <Card className="form-section-card">
          <Card.Body>
            {fields.map((field, index) => (
              <div key={field.id} className="education-entry mb-4">
                <Row className="g-3">
                  <Col md={4}>
                    <InputText
                      name={`educationDetails.${index}.qualification`}
                      label="Qualification"
                      register={register}
                      errors={errors}
                      validation={{ required: "Qualification is required" }}
                    />
                  </Col>
                  <Col md={4}>
                    <InputText
                      name={`educationDetails.${index}.stream`}
                      label="Stream"
                      register={register}
                      errors={errors}
                    />
                  </Col>
                  <Col md={3}>
                    <InputText
                      name={`educationDetails.${index}.yearOfPassing`}
                      label="Year of Passing"
                      type="number"
                      register={register}
                      errors={errors}
                      validation={{
                        required: "Year of Passing is required",
                        min: { value: 1900, message: "Invalid year" },
                        max: { value: new Date().getFullYear(), message: "Invalid year" }
                      }}
                    />
                  </Col>
                  <Col md={1} className="d-flex align-items-end">
                    {index > 0 && (
                      <Button
                        variant="danger"
                        onClick={() => remove(index)}
                        className="mt-1"
                      >
                        ×
                      </Button>
                    )}
                  </Col>
                </Row>
              </div>
            ))}
            <Button
              variant="primary"
              onClick={() => append({ qualification: "", stream: "", yearOfPassing: "" })}
            >
              Add Education Details
            </Button>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Professional Details Section */}
      <Collapsible title="Professional Details">
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={4}>
                <InputText
                  name="professional.appointmentDate"
                  label="Appointment Date"
                  type="date"
                  register={register}
                  errors={errors}
                  validation={{ required: "Appointment Date is required" }}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.employeeType"
                  label="Employee Type"
                  options={[
                    { value: "full-time", label: "Full Time" },
                    { value: "part-time", label: "Part Time" },
                    { value: "contract", label: "Contract" }
                  ]}
                  register={register}
                  errors={errors}
                  validation={{ required: "Employee Type is required" }}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.employeeStatus"
                  label="Employee Status"
                  options={[
                    { value: "active", label: "Active" },
                    { value: "on-leave", label: "On Leave" },
                    { value: "terminated", label: "Terminated" }
                  ]}
                  register={register}
                  errors={errors}
                  validation={{ required: "Employee Status is required" }}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.designation"
                  label="Designation"
                  options={[
                    { value: "manager", label: "Manager" },
                    { value: "developer", label: "Developer" },
                    { value: "designer", label: "Designer" }
                  ]}
                  register={register}
                  errors={errors}
                  validation={{ required: "Designation is required" }}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.department"
                  label="Department"
                  options={[
                    { value: "it", label: "IT" },
                    { value: "hr", label: "HR" },
                    { value: "finance", label: "Finance" }
                  ]}
                  register={register}
                  errors={errors}
                  validation={{ required: "Department is required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="professional.section"
                  label="Section"
                  register={register}
                  errors={errors}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.roles"
                  label="Roles"
                  options={[
                    { value: "admin", label: "Admin" },
                    { value: "user", label: "User" },
                    { value: "manager", label: "Manager" }
                  ]}
                  register={register}
                  errors={errors}
                  isMulti
                  validation={{ required: "At least one role is required" }}
                />
              </Col>
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Documents Upload Section */}
      <Collapsible title="Documents Upload">
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={4}>
                <InputText
                  name="documents.addressProof"
                  label="Address Proof"
                  type="file"
                  register={register}
                  errors={errors}
                  validation={{ required: "Address Proof is required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="documents.identityProof"
                  label="Identity Proof"
                  type="file"
                  register={register}
                  errors={errors}
                  validation={{ required: "Identity Proof is required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="documents.appointmentLetter"
                  label="Appointment Letter"
                  type="file"
                  register={register}
                  errors={errors}
                  validation={{ required: "Appointment Letter is required" }}
                />
              </Col>
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>
    </div>
  );
};

export default EmployeeRegistrationForm;
