import React, { useState, useEffect, useRef } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Button, Card, Badge, Stack } from 'react-bootstrap';
import { FaFileAlt, FaFileUpload, FaArrowLeft, FaArrowRight, FaArrowAltCircleLeft, FaCheckCircle, FaUser, FaBuilding, FaEye, FaDownload } from 'react-icons/fa';
import { BsFileEarmarkX } from 'react-icons/bs';
import { useNavigate, useParams, useLocation } from 'react-router-dom';
import ActionDropdown from '../../../common/ActionDropdown';
import ApprovalModal from '../../../common/ApprovalModal';
import './userViewPage.css';
import NewLoader from '../../../common/NewLoader';
import DynamicViewFields from '../../../common/DynamicViewFields';
import { useTranslation } from 'react-i18next';

const UserViewPage = () => {
  const { t } = useTranslation();
  const { type, id } = useParams();
  const location = useLocation();
  const applicationInfo = location.state?.application;

  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(true);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [completedSteps, setCompletedSteps] = useState(new Set());
  const navigate = useNavigate();
  const [actionsFromAPI, setActionsFromAPI] = useState([]);
  const [originalActions, setOriginalActions] = useState([]);
  const loaderRef = useRef();

  const isOwner = applicationInfo?.userType === 'VESSEL_OWNER';
  const isBuilder = applicationInfo?.userType === 'VESSEL_BUILDER';
  const totalSteps = isOwner ? 3 : 2;

  const mapFilesByFieldName = (fileStoreMap) => {
    const fileMap = {};
    
    fileStoreMap?.forEach(file => {
      const fieldName = file.fieldName?.toLowerCase();
      
      if (fieldName?.includes('pancard')) {
        fileMap.panCardUpload = file;
      } else if (fieldName?.includes('gstcertificate')) {
        fileMap.gstCertificate = file;
      } else if (fieldName?.includes('addressproof')) {
        fileMap.addressProof = file;
      } else if (fieldName?.includes('letterofauthorization')) {
        fileMap.authorizationLetter = file;
      } else if (fieldName?.includes('companyregistrationcertificate')) {
        fileMap.companyRegistrationCertificate = file;
      } else if (fieldName?.includes('moacertificate')) {
        fileMap.moaCertificate = file;
      } else if (fieldName?.includes('aoacertificate')) {
        fileMap.aoaCertificate = file;
      } else if (fieldName?.includes('companyDetails')) {
        fileMap.companyDetails = file;
      } else if (fieldName?.includes('panCardUpload')) {
        fileMap.panCardUpload = file;
      } else if (fieldName?.includes('factoryLicense')) {
        fileMap.factoryLicense = file;
      } else if (fieldName?.includes('fireCertificate')) {
        fileMap.fireCertificate = file;
      } else if (fieldName?.includes('esipfRegistration')) {
        fileMap.esipfRegistration = file;
      } else if (fieldName?.includes('iso9001')) {
        fileMap.iso9001 = file;
      } else if (fieldName?.includes('iso14001')) {
        fileMap.iso14001 = file;
      } else if (fieldName?.includes('iso45001')) {
        fileMap.iso45001 = file;
      } else if (fieldName?.includes('pollutionCertificate')) {
        fileMap.pollutionCertificate = file;
      } else if (fieldName?.includes('experienceCertificate')) {
        fileMap.experienceCertificate = file;
      }
    });
    
    return fileMap;
  };

  useEffect(() => {
    setIsLoading(true);
    loaderRef.current?.show?.();
    
    if (applicationInfo) {
      let processedData = {};
      
      if (isOwner && applicationInfo.ownerDetails) {
        const ownerData = applicationInfo.ownerDetails;
        const mappedFiles = mapFilesByFieldName(ownerData.fileStoreMap);
        
        processedData = {
          categoryOfOwner: ownerData.categoryOfOwner,
          ownerCompanyName: ownerData.ownerCompanyName,
          emailId: ownerData.emailId,
          phoneNumber: ownerData.phoneNumber,
          panNo: ownerData.panNo,
          gstNo: ownerData.gstNo,
          addressLine1: ownerData.addressLine1,
          addressLine2: ownerData.addressLine2,
          pin: ownerData.pin,
          district: ownerData.district,
          state: ownerData.state,
          country: ownerData.country,
          authorisedFname: ownerData.authorisedFname,
          authorisedLname: ownerData.authorisedLname,
          authorisedMob: ownerData.authorisedMob,
          authorisedEmail: ownerData.authorisedEmail,
          aadharNumber: ownerData.aadharNumber,
          tradeLicenseNumber: ownerData.tradeLicenseNumber,
          cinNo: ownerData.cinNo,
          dinNo: ownerData.dinNo,
          registrationNumber: applicationInfo.userBasicDetails.registrationNumber,
          status: applicationInfo.userBasicDetails.isActive ? "Approved" : "Pending Review",
          fileStoreMap: ownerData.fileStoreMap || [],
          ...mappedFiles
        };
      } else if (isBuilder && applicationInfo.builderDetails) {
        const builderData = applicationInfo.builderDetails;
        const mappedFiles = mapFilesByFieldName(builderData.fileStoreMap);
        
        processedData = {
          builderName: builderData.builderName,
          emailId: builderData.emailId,
          phoneNumber: builderData.phone,
          panNo: builderData.panNo,
          gstNo: builderData.gstNo,
          addressLine1: builderData.addressLine1,
          addressLine2: builderData.addressLine2,
          pin: builderData.pin,
          district: builderData.district,
          state: builderData.state,
          country: builderData.country,
          registrationNumber: applicationInfo.userBasicDetails.registrationNumber,
          status: applicationInfo.userBasicDetails.isActive ? "Approved" : "Pending Review",
          fileStoreMap: builderData.fileStoreMap || [],
          ...mappedFiles
        };
      }

      setFormData(processedData);
      
      const actionsList = applicationInfo?.processActionMapResponce?.processs?.[0]?.actions || [];
      setOriginalActions(actionsList);
      const actionNames = actionsList.map(action => action.actionName || action.actionDescription || action);
      setActionsFromAPI(actionNames);
      
      setCompletedSteps(new Set([1]));
    }
    
    setTimeout(() => {
      setIsLoading(false);
      loaderRef.current?.hide?.();
    }, 500);
  }, [applicationInfo, isOwner, isBuilder]);

  const methods = useForm({ defaultValues: { country: 'India' } });
  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading && Object.keys(formData).length > 0) {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined && formData[key] !== null) {
          setValue(key, formData[key]);
        }
      });
    }
  }, [isLoading, formData, setValue]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (modalFormData) => {
    const fullActionObject = originalActions.find(
      action => action.actionName === selectedAction || action.actionDescription === selectedAction
    );

    const payload = {
      applicationNo: formData.registrationNumber,
      action: selectedAction,
      processId: applicationInfo?.processActionMapResponce?.processs?.[0]?.processId,
      actionId: fullActionObject?.actionId,
      processName: applicationInfo?.processActionMapResponce?.processs?.[0]?.processName,
      ...modalFormData,
    };
    console.log("Action submitted:", payload);
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const getFormFieldsConfig = () => {
    if (isOwner) {
      return {
        step1: [
          { name: "categoryOfOwner", label: t("vesselOwnerRegistration.Category of Owner"), type: "text", colSize: 6 },
          { name: "ownerCompanyName", label: t("vesselOwnerRegistration.Owner/Company Name"), type: "text", colSize: 6 },
          { name: "emailId", label: t("vesselOwnerRegistration.Email ID"), type: "email", colSize: 6 },
          { name: "phoneNumber", label: t("vesselOwnerRegistration.Phone Number"), type: "text", colSize: 6 },
          { name: "panNo", label: t("vesselOwnerRegistration.PAN Number"), type: "text", colSize: 6 },
          { name: "aadharNumber", label: t("vesselOwnerRegistration.Aadhar Number"), type: "text", colSize: 6 },
          { name: "tradeLicenseNumber", label: t("vesselOwnerRegistration.Trade License Number"), type: "text", colSize: 6 },
          { name: "gstNo", label: t("vesselOwnerRegistration.GST Number"), type: "text", colSize: 6 },
          { name: "addressLine1", label: t("vesselOwnerRegistration.Address Line-1"), type: "text", colSize: 6 },
          { name: "addressLine2", label: t("vesselOwnerRegistration.Address Line-2"), type: "text", colSize: 6 },
          { name: "pin", label: t("vesselOwnerRegistration.PIN"), type: "text", colSize: 6 },
          { name: "district", label: t("vesselOwnerRegistration.District"), type: "text", colSize: 6 },
          { name: "state", label: t("vesselOwnerRegistration.State / UT"), type: "text", colSize: 6 },
          { name: "country", label: t("vesselOwnerRegistration.Country"), type: "text", colSize: 6 },
        ],
        step2: [
          { name: "authorisedFname", label: t("vesselOwnerRegistration.First Name"), type: "text", colSize: 6 },
          { name: "authorisedLname", label: t("vesselOwnerRegistration.Last Name"), type: "text", colSize: 6 },
          { name: "authorisedMob", label: t("vesselOwnerRegistration.Primary Mobile Number"), type: "text", colSize: 6 },
          { name: "authorisedEmail", label: t("vesselOwnerRegistration.Email ID"), type: "email", colSize: 6 },
          { name: "authorizationLetter", label: t("vesselOwnerRegistration.Letter of Authorization"), type: "file", colSize: 12 },
        ],
        step3: [
          { name: "panCardUpload", label: t("vesselOwnerRegistration.PAN Card"), type: "file", colSize: 6 },
          { name: "gstCertificate", label: t("vesselOwnerRegistration.GST Certificate"), type: "file", colSize: 6 },
          { name: "addressProof", label: t("vesselOwnerRegistration.Address Proof"), type: "file", colSize: 6 },
          { name: "companyRegistrationCertificate", label: t("vesselOwnerRegistration.Company Registration Certificate"), type: "file", colSize: 6 },
          { name: "moaCertificate", label: t("vesselOwnerRegistration.MOA Certificate"), type: "file", colSize: 6 },
          { name: "aoaCertificate", label: t("vesselOwnerRegistration.AOA Certificate"), type: "file", colSize: 6 },
        ]
      };
    } else {
      return {
        step1: [
          { name: "builderName", label: t("builderRegistration.builderName"), type: "text", colSize: 6 },
          { name: "emailId", label: t("builderRegistration.Email ID"), type: "email", colSize: 6 },
          { name: "phoneNumber", label: t("builderRegistration.Phone Number"), type: "text", colSize: 6 },
          { name: "panNo", label: t("builderRegistration.PAN Number"), type: "text", colSize: 6 },
          { name: "gstNo", label: t("builderRegistration.GST Number"), type: "text", colSize: 6 },
          { name: "addressLine1", label: t("builderRegistration.Address Line-1"), type: "text", colSize: 6 },
          { name: "addressLine2", label: t("builderRegistration.Address Line-2"), type: "text", colSize: 6 },
          { name: "pin", label: t("builderRegistration.PIN"), type: "text", colSize: 6 },
          { name: "district", label: t("builderRegistration.District"), type: "text", colSize: 6 },
          { name: "state", label: t("builderRegistration.State / UT"), type: "text", colSize: 6 },
          { name: "country", label: t("builderRegistration.Country"), type: "text", colSize: 6 },
        ],
        step2: [
          { name: "companyDetails", label: t("builderRegistration.Company Details"), type: "file", colSize: 6 },
          { name: "gstCertificate", label: t("builderRegistration.GST Certificate"), type: "file", colSize: 6 },
          { name: "panCardUpload", label: t("builderRegistration.PAN Card"), type: "file", colSize: 6 },
          { name: "factoryLicense", label: t("builderRegistration.Factory License"), type: "file", colSize: 6 },
          { name: "addressProof", label: t("builderRegistration.Address Proof"), type: "file", colSize: 6 },
          { name: "fireCertificate", label: t("builderRegistration.Fire Certificate"), type: "file", colSize: 6 },
          { name: "esipfRegistration", label: t("builderRegistration.ESIPF Registration"), type: "file", colSize: 6 },
          { name: "iso9001", label: t("builderRegistration.ISO 9001 Certificate"), type: "file", colSize: 6 },
          { name: "iso14001", label: t("builderRegistration.ISO 14001 Certificate"), type: "file", colSize: 6 },
          { name: "iso45001", label: t("builderRegistration.ISO 45001 Certificate"), type: "file", colSize: 6 },
          { name: "pollutionCertificate", label: t("builderRegistration.Pollution Certificate"), type: "file", colSize: 6 },
          { name: "experienceCertificate", label: t("builderRegistration.Experience Certificate"), type: "file", colSize: 6 },
        ]
      };
    }
  };

  const formFields = getFormFieldsConfig();

  const getDisabledFormFieldsConfig = () => {
    const config = {};
    Object.keys(formFields).forEach(stepKey => {
      config[stepKey] = formFields[stepKey].map(field => ({
        ...field,
        disabled: true,
        inputClassName: 'disabled-field'
      }));
    });
    return config;
  };

  const disabledFormFields = getDisabledFormFieldsConfig();

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return disabledFormFields.step1;
      case 2: return disabledFormFields.step2;
      case 3: return disabledFormFields.step3 || [];
      default: return [];
    }
  };

  const handleNext = () => {
    if (currentStep < totalSteps) {
      setCompletedSteps(prev => new Set([...prev, currentStep]));
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const handleBackToList = () => {
    navigate('/user-registration/view');
  };

  const getStatusBadge = (status) => {
    const statusMap = {
      'Pending Review': 'warning',
      'Pending': 'warning',
      'Approved': 'success',
      'Completed': 'success',
      'Rejected': 'danger',
      'Processing': 'info'
    };
    return <Badge bg={statusMap[status] || 'secondary'} className="status-badge">{status}</Badge>;
  };

  const getStepIcon = (stepNumber) => {
    if (completedSteps.has(stepNumber)) {
      return <FaCheckCircle className="text-white" size={18} />;
    }
    
    if (isOwner) {
      const ownerIcons = [FaUser, FaUser, FaFileUpload];
      return currentStep === stepNumber ? 
        React.createElement(ownerIcons[stepNumber - 1], { className: "text-white", size: 16 }) : 
        stepNumber;
    } else {
      const builderIcons = [FaBuilding, FaFileUpload];
      return currentStep === stepNumber ? 
        React.createElement(builderIcons[stepNumber - 1], { className: "text-white", size: 16 }) : 
        stepNumber;
    }
  };

  const getStepTitles = () => {
    if (isOwner) {
      return [
        t("vesselOwnerRegistration.Vessel Owner Details"),
        t("vesselOwnerRegistration.Authorized Person's Details"),
        t("vesselOwnerRegistration.Documents Upload")
      ];
    } else {
      return [
        t("builderRegistration.Vessel Builder Details"),
        t("builderRegistration.Documents Upload")
      ];
    }
  };

  const stepTitles = getStepTitles();

  if (isLoading) {
    return <NewLoader ref={loaderRef} />;
  }

  return (
    <>
      <Container fluid className="py-4 officer-view-container">
        <Row className="justify-content-center">
          <Col size={12}>
            <Card className="shadow-lg border-0 modern-card">
              <Card.Header className="modern-header">
                <div className="header-content">
                  <div className="header-left">
                    <button className="back-btn" onClick={handleBackToList}>
                      <FaArrowAltCircleLeft size={24} />
                    </button>
                  </div>
                  
                  <div className="header-center">
                    <div className="app-info">
                      <h4 className="app-title">Application Details</h4>
                      <div className="app-number">
                        <span className="app-label">ID:</span>
                        <span className="app-id">{formData.registrationNumber || 'N/A'}</span>
                      </div>
                    </div>
                  </div>
                  
                  <div className="header-right">
                    {getStatusBadge(formData.status)}
                  </div>
                </div>
              </Card.Header>

              <Card.Body className="modern-body">
                <div className="stepper-container">
                  {Array.from({ length: totalSteps }, (_, i) => i + 1).map((step, index) => (
                    <React.Fragment key={step}>
                      <div className={`stepper-step ${currentStep === step ? 'active' : ''} ${completedSteps.has(step) ? 'completed' : ''}`}>
                        <div className="step-circle">
                          {getStepIcon(step)}
                        </div>
                        <div className="step-label">{stepTitles[step - 1]}</div>
                      </div>
                      
                      {index < totalSteps - 1 && (
                        <div className="step-connector"></div>
                      )}
                    </React.Fragment>
                  ))}
                </div>

                <FormProvider {...methods}>
                  <form>
                    <div className="form-section">
                      <Row className="g-4">
                        <DynamicViewFields
                          fields={getCurrentStepFields()}
                          setFormData={setFormData}
                        />
                      </Row>
                    </div>

                    <div className="form-actions">
                      <Button
                        variant="outline-secondary"
                        onClick={handlePrevious}
                        disabled={currentStep === 1}
                        className="action-btn prev-btn"
                      >
                        <FaArrowLeft size={12} className="me-2" /> Previous
                      </Button>
                      
                      {currentStep < totalSteps ? (
                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="action-btn next-btn"
                        >
                          Next <FaArrowRight size={12} className="ms-2" />
                        </Button>
                      ) : (
                        <ActionDropdown
                          actions={actionsFromAPI}
                          onActionClick={handleActionClick}
                          variant="success"
                          className="action-dropdown"
                        />
                      )}
                    </div>
                  </form>
                </FormProvider>
              </Card.Body>
            </Card>
          </Col>
        </Row>

        <ApprovalModal
          show={showApprovalModal}
          handleClose={handleCloseModal}
          handleSubmitData={handleActionSubmit}
          selectedAction={selectedAction}
        />
      </Container>
    </>
  );
};

export default UserViewPage;

.officer-view-container {
  background: linear-gradient(to right, #0c5dcf 10%, #91daff 50%, #0c5dcf 100%);
  min-height: 100vh;
  padding: 2rem 1rem;
}

.modern-card {
  border-radius: 20px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  border: none;
  overflow: hidden;
}

.modern-header {
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  border-bottom: 2px solid #e2e8f0;
  padding: 2rem;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

.header-left {
  flex-shrink: 0;
}

.back-btn {
  background: #2466BF;
  border: none;
  color: white;
  padding: 0.75rem;
  border-radius: 50%;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(36, 102, 191, 0.3);
}

.back-btn:hover {
  transform: translateY(-2px) scale(1.05);
  box-shadow: 0 6px 20px rgba(36, 102, 191, 0.4);
  background: #1e5aa8;
}

.header-center {
  flex: 1;
  text-align: center;
}

.app-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.app-title {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 700;
  background: linear-gradient(to right, #0c5dcf 10%, #2466BF 50%, #0c5dcf 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.app-number {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.app-label {
  font-size: 0.9rem;
  color: #64748b;
  font-weight: 600;
}

.app-id {
  background: #2466BF;
  color: white;
  padding: 0.4rem 1rem;
  border-radius: 20px;
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.5px;
  box-shadow: 0 3px 10px rgba(36, 102, 191, 0.3);
}

.header-right {
  flex-shrink: 0;
}

.status-badge {
  font-size: 0.8rem;
  padding: 0.5rem 1rem;
  border-radius: 15px;
  font-weight: 600;
  letter-spacing: 0.5px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.modern-body {
  padding: 2.5rem;
  background: #ffffff;
}

.stepper-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 3rem;
  position: relative;
}

.stepper-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
}

.step-connector {
  flex: 1;
  height: 2px;
  background: #e2e8f0;
  margin: 0 2rem;
  border-radius: 2px;
  position: relative;
}

.stepper-step.completed ~ .step-connector::before,
.stepper-step.active ~ .step-connector::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: #2466BF;
  border-radius: 2px;
  width: 100%;
  transition: width 0.5s ease;
}

.step-circle {
  width: 45px;
  height: 45px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.9rem;
  margin-bottom: 0.75rem;
  transition: all 0.3s ease;
  background: #e2e8f0;
  color: #64748b;
  border: 2px solid #e2e8f0;
}

.stepper-step.active .step-circle {
  background: #2466BF;
  color: white;
  border-color: #2466BF;
  box-shadow: 0 4px 15px rgba(36, 102, 191, 0.3);
  transform: scale(1.1);
}

.stepper-step.completed .step-circle {
  background: #10b981;
  color: white;
  border-color: #10b981;
  box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
}

.step-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #64748b;
  text-align: center;
  letter-spacing: 0.025em;
}

.stepper-step.active .step-label {
  color: #2466BF;
  font-weight: 700;
}

.stepper-step.completed .step-label {
  color: #10b981;
  font-weight: 700;
}

.form-section {
  padding: 1.5rem 0;
}

/* Text Field Styling */
.text-field {
  margin-bottom: 1.5rem;
}

.disabled-field {
  background-color: #f8fafc !important;
  border: 1.5px solid #e2e8f0 !important;
  border-radius: 6px !important;
  color: #475569 !important;
  font-weight: 500;
  font-size: 0.9rem;
  padding: 0.75rem !important;
}

/* File Field Styling */
.file-field {
  margin-bottom: 1.5rem;
}

.field-label {
  display: block;
  font-weight: 600;
  color: #374151;
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
}

.file-display {
  border: 2px solid #e5e7eb;
  border-radius: 8px;
  padding: 0.75rem;
  background: white;
  transition: all 0.2s ease;
}

.file-display:hover {
  border-color: #d1d5db;
}

.no-file {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #9ca3af;
  font-size: 0.85rem;
  font-style: italic;
}

.no-file-icon {
  color: #d1d5db;
}

.file-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.file-info {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex: 1;
  min-width: 0;
}

.file-icon {
  color: #2466BF;
  flex-shrink: 0;
}

.file-name {
  font-weight: 500;
  color: #374151;
  font-size: 0.85rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-actions {
  display: flex;
  gap: 0.5rem;
  flex-shrink: 0;
}

.file-btn {
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  border-width: 1px;
  transition: all 0.2s ease;
  min-width: 32px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.view-btn {
  border-color: #2466BF;
  color: #2466BF;
}

.view-btn:hover {
  background: #2466BF;
  border-color: #2466BF;
  color: white;
  transform: scale(1.05);
}

.download-btn:hover {
  background: #10b981;
  border-color: #10b981;
  color: white;
  transform: scale(1.05);
}

.form-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 2rem;
  border-top: 2px solid #f1f5f9;
}

.action-btn {
  padding: 0.75rem 2rem;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.9rem;
  letter-spacing: 0.025em;
  transition: all 0.3s ease;
  border-width: 2px;
}

.prev-btn {
  border-color: #6b7280;
  color: #6b7280;
  background: white;
}

.prev-btn:hover:not(:disabled) {
  background: #6b7280;
  border-color: #6b7280;
  color: white;
  transform: translateX(-2px);
}

.next-btn {
  background: #2466BF;
  border-color: #2466BF;
  color: white;
  box-shadow: 0 4px 15px rgba(36, 102, 191, 0.3);
}

.next-btn:hover {
  background: #1e5aa8;
  border-color: #1e5aa8;
  transform: translateX(2px);
  box-shadow: 0 6px 20px rgba(36, 102, 191, 0.4);
}

.action-dropdown {
  padding: 0.75rem 2rem;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.9rem;
}

@media (max-width: 768px) {
  .officer-view-container {
    padding: 1rem 0.5rem;
  }
  
  .modern-header {
    padding: 1.5rem;
  }
  
  .header-content {
    flex-direction: column;
    gap: 1rem;
  }
  
  .app-title {
    font-size: 1.25rem;
  }
  
  .modern-body {
    padding: 1.5rem;
  }
  
  .stepper-container {
    flex-direction: column;
    gap: 1rem;
  }
  
  .step-connector {
    width: 2px;
    height: 2rem;
    margin: 0;
  }
  
  .form-actions {
    flex-direction: column;
    gap: 1rem;
  }
  
  .action-btn {
    width: 100%;
    justify-content: center;
  }
  
  .file-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  
  .file-actions {
    align-self: stretch;
    justify-content: flex-end;
  }
}

@media (max-width: 576px) {
  .file-name {
    max-width: 120px;
  }
  
  .app-number {
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .step-label {
    font-size: 0.75rem;
  }
}
import React from 'react';
import { Row, Col, Button } from 'react-bootstrap';
import { useFormContext } from 'react-hook-form';
import InputText from './InputText.tsx';
import InputFile from './InputFile.tsx';
import { FaDownload, FaEye, FaFileAlt } from 'react-icons/fa';
import { BsFileEarmarkX } from 'react-icons/bs';
import { renameFile } from '../../utils/constants.ts';

const DynamicViewFields = ({ fields, setFormData }) => {
  const { register, formState: { errors }, setValue, watch, setError } = useFormContext();

  const handleDownload = (fileData) => {
    if (fileData && fileData.downLoadFile) {
      window.open(fileData.downLoadFile, '_blank');
    } else {
      console.warn("No download URL available for file");
    }
  };

  const handleView = (fileData) => {
    if (fileData && fileData.downLoadFile) {
      window.open(fileData.downLoadFile, '_blank');
    } else {
      console.warn("No view URL available for file");
    }
  };

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'file':
        if (field.disabled || field.displayOnly) {
          const value = watch(field.name);
          const hasFile = value && (value.fileName || value.downLoadFile);
          
          return (
            <div className="file-field">
              <label className="field-label">{field.label}</label>
              <div className="file-display">
                {!hasFile ? (
                  <div className="no-file">
                    <BsFileEarmarkX size={14} className="no-file-icon" />
                    <span>No document uploaded</span>
                  </div>
                ) : (
                  <div className="file-item">
                    <div className="file-info">
                      <FaFileAlt size={14} className="file-icon" />
                      <span className="file-name">
                        {value.fileName || `${field.label}.pdf`}
                      </span>
                    </div>
                    <div className="file-actions">
                      <Button 
                        variant="outline-primary" 
                        size="sm" 
                        onClick={() => handleView(value)}
                        className="file-btn view-btn"
                        title="View"
                      >
                        <FaEye size={10} />
                      </Button>
                      <Button 
                        variant="outline-success" 
                        size="sm" 
                        onClick={() => handleDownload(value)}
                        className="file-btn download-btn"
                        title="Download"
                      >
                        <FaDownload size={10} />
                      </Button>
                    </div>
                  </div>
                )}
              </div>
              <input
                type="file"
                className="d-none"
                disabled
                {...register(field.name)}
              />
            </div>
          );
        }
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
                const fileName = `${field.label}${extension}`;
                file.originalName = fileName;
                setValue(field.name, renameFile(file, fileName));
                setFormData(prev => {
                  const updated = { ...prev, [field.name]: file };
                  return updated;
                });

                const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'Only PDF, JPG or PNG files are allowed'
                  });
                }

                if (file.size > 2 * 1024 * 1024) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'File size should not exceed 2MB'
                  });
                }
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={watch(field.name)}
          />
        );

      default:
        return (
          <div className="text-field">
            <InputText
              label={field.label}
              required={field.required}
              name={field.name}
              key={field.name}
              type={field.type}
              placeholder={field.placeholder}
              register={register(field?.name, {
                ...field.validation,
              })}
              onChange={handleChange}
              errors={errors}
              readOnly={field.readOnly}
              icon={field.icon}
              maxlength={field?.maxlength}
              onKeyDown={field?.keyDown}
              disabled={field?.disabled || false}
              className="form-input"
            />
          </div>
        );
    }
  };

  return (
    <Row className="g-3">
      {fields.map((field, index) => (
        <Col key={index} md={field.colSize || 12}>
          {renderField(field)}
        </Col>
      ))}
    </Row>
  );
};

export default DynamicViewFields;

