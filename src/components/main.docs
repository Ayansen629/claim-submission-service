<style>
  {`
    .vessel-equipment-form { overflow-anchor: none; }
    .table-container {
      max-height: 400px;
      overflow-y: auto;
      border: 1px solid #dee2e6;
      border-radius: 0.375rem;
    }
    .equipment-table { margin-bottom: 0; }
    .equipment-table thead th {
      position: sticky;
      top: 0;
      background-color: #f8f9fa;
      z-index: 10;
      color: #2466BF;
      font-weight: 600;
    }
    .equipment-table td {
      min-width: 150px;
      vertical-align: middle;
      padding: 8px;
    }
    .equipment-table select, .equipment-table .form-select {
      min-width: 150px !important;
      width: 100% !important;
    }
    .equipment-table select:disabled, .equipment-table .form-select:disabled {
      background-color: #e9ecef !important;
      opacity: 0.65 !important;
      cursor: not-allowed !important;
    }
    .equipment-table textarea:disabled {
      background-color: #e9ecef !important;
      opacity: 0.65 !important;
      cursor: not-allowed !important;
    }
    .deck-remove-btn {
      transition: all 0.2s ease;
      min-width: 100px;
    }
    .deck-remove-btn:hover { transform: scale(1.05); }
    .table-container::-webkit-scrollbar { width: 8px; height: 8px; }
    .table-container::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 4px;
    }
    .table-container::-webkit-scrollbar-thumb {
      background: #c1c1c1;
      border-radius: 4px;
    }
    .table-container::-webkit-scrollbar-thumb:hover { background: #a8a8a8; }
  `}
</style>
