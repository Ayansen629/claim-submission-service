                            cursor: isViewMode ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="enginephoneNumber"
                          label={t("Phone Number")}
                          placeholder={t("Enter 10-digit phone number")}
                          maxlength={10}
                          register={{
                            ...register("enginephoneNumber", {
                              pattern: { value: CONSTANT_REGEX.MOBILE, message: t("Phone number must be 10 digits") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isViewMode}
                          disabled={isViewMode}
                          style={{
                            backgroundColor: isViewMode ? '#e9ecef' : '#ffffff',
                            cursor: isViewMode ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="engineemail"
                          label={t("Email ID")}
                          type="email"
                          placeholder={t("Enter email address")}
                          register={{
                            ...register("engineemail", {
                              pattern: { value: CONSTANT_REGEX.EMAIL, message: t("Invalid email address") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isViewMode}
                          disabled={isViewMode}
                          style={{
                            backgroundColor: isViewMode ? '#e9ecef' : '#ffffff',
                            cursor: isViewMode ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="horsepower"
                          label={t("Horsepower")}
                          type="number"
                          placeholder={t("Enter horsepower")}
                          register={{
                            ...register("horsepower", {
                              min: { value: 1, message: t("Horsepower must be positive") },
                            }),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isViewMode}
                          disabled={isViewMode}
                          style={{
                            backgroundColor: isViewMode ? '#e9ecef' : '#ffffff',
                            cursor: isViewMode ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="speed"
                          label={t("Speed")}
                          placeholder={t("Enter speed")}
                          register={{
                            ...register("speed"),
                          }}
                          errors={errors}
                          clearErrors={clearErrors}
                          readOnly={isViewMode}
                          disabled={isViewMode}
                          style={{
                            backgroundColor: isViewMode ? '#e9ecef' : '#ffffff',
                            cursor: isViewMode ? 'not-allowed' : 'text'
                          }}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="yearOfMake"
                          label={t("Year of Make")}
                          placeholder={t("Enter year of make")}
                          register={{
                            ...register("yearOfMake", {
                              pattern: { value: /^[0-9]{4}$/, message: t("Enter a valid year (YYYY)") },
