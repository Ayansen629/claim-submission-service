<Col lg={6} md={4} sm={12} className="d-flex align-items-end justify-content-end">
  <div style={{ display: "flex", gap: "10px", width: "100%" }}>
    <div className="w48">
      <button
        className="generic-btn-cancel"
        type="reset"
        onClick={() => {
          reset();
        }}
        style={{ width: "100%" }}
      >
        {t("employeeRegistration.Reset")}
      </button>
    </div>
    <div className="w48">
      <button 
        className="generic-btn-submit" 
        type="submit"
        style={{ width: "100%" }}
      >
        {t("employeeRegistration.Filter")}
      </button>
    </div>
  </div>
</Col>
