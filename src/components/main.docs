import React, { useState, useEffect, useRef } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams, useLocation, useNavigate } from "react-router-dom";
import Stepper from "../../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import Documents from "./Documents.js";
import NoteSheet from "./NoteSheet.js";
import { useForm } from "react-hook-form";
import Invoicing from "../../../common/Invoicing.js";
import PaymentModal from "../../../common/PaymentModal.js";
import ActionDropdown from "../../../common/ActionDropdown";
import ApprovalModal from "../../../common/ApprovalModal";
import NewVesselRegistrationSuccess from "./newVesselRegistrationSuccess.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import { toast } from "react-toastify";
import { Button } from "react-bootstrap";
import { BsSticky, BsArrowLeft } from "react-icons/bs";
import PaymentDetailsView from "./paymentDetailsView.js";
import { getFromLocalStorage } from "../../../../utils/localStorageUtils.js";
import { handleErrorMessage } from "../../../../utils/errorMessageHandler.js";
import { postData, postFORMdata } from "../../../../services/http.service.ts";
import {
  SERVICE_BASE,
  URLS_ENDPOINT,
} from "../../../../utils/urlsConstants.ts";
import NewLoader from "../../../common/NewLoader.js";
// import VesselRegistrationPreview from "./VesselRegistrationPreview.js";

const NewVesselRegistration = () => {
  const { t } = useTranslation();
  const { id } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  const ownerDetails = getFromLocalStorage("ownerDetails")
    ? JSON.parse(getFromLocalStorage("ownerDetails"))
    : "";
  const isEditMode = !!id && location.pathname.includes("/edit/");
  const isViewMode = !!id && location.pathname.includes("/view/");
  const isNormalMode = !isEditMode && !isViewMode;
  const stepperRef = useRef();

  const methods = useForm({ mode: "onTouched" });
  const { trigger, getValues, setError, setValue, reset } = methods;

  const [showModal, setShowModal] = useState(false);
  const [paymentMode, setPaymentMode] = useState("offline");
  const [challanFile, setChallanFile] = useState(null);
  const [isLoading, setIsLoading] = useState(false);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [showNoteSheet, setShowNoteSheet] = useState(false);

  const loaderRef = useRef();

  const [vesselRegisData, setVesselRegisData] = useState({});

  const actionsFromAPI = ["Approve", "Reject", "Request Changes"];

  const [originalGRT, setOriginalGRT] = useState(null);

  const initialNotes = [
    {
      id: 1,
      title: "Initial Review",
      content:
        "Document verification completed successfully. All required documents are present and properly formatted.",
      date: "2024-01-15",
      author: "John Doe",
    },
    {
      id: 2,
      title: "Technical Assessment",
      content:
        "All technical drawings have been reviewed and approved by the engineering team.",
      date: "2024-01-16",
      author: "Jane Smith",
    },
  ];

  const staticData = {
    ownerName: "John Doe",
    ownerAddress: "123 Main Street, Harbor City, State 12345",
    mobile: "9876543210",
    email: "john.doe@example.com",
    pan: "ABCDE1234F",
    aadhar: "123456789012",
    tradeLicence: "TL123456789",
    gst: "GST123456789012",
    grt: "500",
    workOrderValue: "1000000",
    vesselType: "new",
    category: "A",
    zone: "1",
    supervisionAuthority: "classificationSociety",
    purchaseType: "new",
    classificationSociety: "Lloyd's Register Classification Society",
    constructedBy: "2",
    builder: "builder1",
    builderName: "ABC Marine Shipyard Pvt Ltd",
    builderAddress: "456 Port Road, Shipyard Complex, Harbor City 54321",
    builderEmail: "contact@abcshipyard.com",
    builderMobile: "9876543211",
    builderTradeLicence: "BTL789012345",
    builderGST: "BGST987654321098",
    builderAuth: "auth",
    termsAccepted: true,
    // ...workOrder and drawings files...
    ...Array.from({ length: 50 }, (_, i) => ({
      [`workOrder_file_${i + 1}`]: {
        name: `WorkOrder_${String(i + 1).padStart(2, "0")}.pdf`,
        size: Math.floor(Math.random() * 2000000) + 500000,
      },
      [`workOrder_desc_${i + 1}`]: `Work order document ${i + 1} - ${[
          "Main contract document",
          "Amendment and modifications",
          "Technical specifications",
          "Timeline and milestones",
          "Budget breakdown",
          "Quality requirements",
          "Safety protocols",
          "Environmental compliance",
          "Material specifications",
          "Equipment details",
        ][i % 10]
        }`,
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    ...Array.from({ length: 50 }, (_, i) => ({
      [`drawings_file_${i + 1}`]: {
        name: `Drawing_${String(i + 1).padStart(2, "0")}.pdf`,
        size: Math.floor(Math.random() * 3000000) + 800000,
      },
      [`drawings_desc_${i + 1}`]: `Technical drawing ${i + 1} - ${[
          "General arrangement plan",
          "Hull structure details",
          "Machinery layout",
          "Electrical schematic",
          "Piping diagram",
          "Safety equipment layout",
          "Navigation equipment",
          "Interior arrangement",
          "Deck plan",
          "Cross-section view",
        ][i % 10]
        }`,
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    // tonnageBooklets: { name: "Tonnage_Booklets.pdf", size: 512000 },
    // stabilityBooklets: { name: "Stability_Booklets.pdf", size: 768000 },
    authLetter: { name: "Authorization_Letter.pdf", size: 256000 },
  };

  useEffect(() => {
    if (isNormalMode) {
      reset();
    } else if (isEditMode || isViewMode) {
      setTimeout(() => {
        Object.keys(staticData).forEach((key) => {
          setValue(key, staticData[key]);
        });
        if (isEditMode) {
          setOriginalGRT(staticData.grt);
        }
      }, 100);
    }
  }, [isEditMode, isViewMode, isNormalMode, setValue, reset]);

  useEffect(() => {
    const timeoutId = setTimeout(() => {
      if (!ownerDetails || !isNormalMode) return;

      const userInfoFields = {
        ownerName: ownerDetails.ownerCompanyName || "",
        ownerAddress: [ownerDetails.addressLine1, ownerDetails.addressLine2]
          .filter(Boolean)
          .join(" , "),
        mobile: ownerDetails.phoneNumber || "",
        email: ownerDetails.emailId || "",
        pan: ownerDetails.panNo || "",
        gst: ownerDetails.gstNo || "",
        category: ownerDetails.categoryOfOwner || "",
        aadhar: ownerDetails.aadharNumber || "",
        tradeLicence: ownerDetails.tradeLicenseNumber || "",
      };

      Object.entries(userInfoFields).forEach(([key, value]) => {
        setValue(key, value, { shouldDirty: false, shouldTouch: false });
      });
    });

    return () => clearTimeout(timeoutId);
  }, []);

  const validateDocuments = async () => {
    if (isViewMode) return true;
    if (isNormalMode) return true;

    const requiredFields = [];
    const tonnageBooklets = getValues("tonnageBooklets");
    const stabilityBooklets = getValues("stabilityBooklets");
    const termsAccepted = getValues("termsAccepted");
    const currentGRT = getValues("grt");

    const isFilePresent = (fileObj) =>
      !!fileObj && (fileObj.name || fileObj.filestoreId);

    if (
      isEditMode &&
      originalGRT !== null &&
      currentGRT !== undefined &&
      String(currentGRT) !== String(originalGRT)
    ) {
      if (!isFilePresent(tonnageBooklets)) {
        requiredFields.push("tonnageBooklets");
      }
      if (!isFilePresent(stabilityBooklets)) {
        requiredFields.push("stabilityBooklets");
      }
    }

    if (!termsAccepted) {
      requiredFields.push("termsAccepted");
    }

    let hasErrors = false;
    requiredFields.forEach((fieldName) => {
      const fieldValue = getValues(fieldName);
      if (
        !fieldValue ||
        (fieldValue instanceof FileList && fieldValue.length === 0)
      ) {
        setError(fieldName, {
          type: "required",
          message: `${fieldName} is required`,
        });
        hasErrors = true;
      }
    });

    return !hasErrors;
  };

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      comments: formData.comments,
    };

    console.log("Action submitted:", payload);
    toast.success(`${selectedAction} action submitted successfully`);

    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleChallanUpload = (e) => {
    setChallanFile(e.target.files?.[0] || null);
  };

  const handleOnlinePay = () => {
    setIsLoading(true);
    setShowModal(false);

    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", {
        state: { registrationId: "VR2024001" },
      });
    }, 1500);
  };

  const handleOfflineSubmit = () => {
    setShowModal(false);
    setIsLoading(true);

    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", {
        state: { registrationId: "VR2024001" },
      });
    }, 1500);
  };

  const handlePayNow = () => {
    setShowModal(true);
  };

  // Validation functions
  const validateVesselDetails = async () => {
    if (isViewMode) return true;
    const basicFields = [
      "ownerName",
      "ownerAddress",
      "mobile",
      "email",
      "pan",
      "aadhar",
      "tradeLicence",
      "gst",
      "grt",
      "workOrderValue",
      "vesselType",
      "category",
      "purchaseType",
      "constructedBy",
    ];

    const constructedBy = getValues("constructedBy");
    if (constructedBy === "2") {
      basicFields.push(
        "builderName",
        "builderAddress",
        "builderEmail",
        "builderMobile",
        "builderTradeLicence",
        "builderGST",
        "builderAuth"
      );

      const authLetter = getValues("authLetter");
      if (!authLetter && !isEditMode) {
        basicFields.push("authLetter");
      }
    }

    const valid = await trigger(basicFields);
    return valid;
  };
  const tonnageRequired =
    isEditMode &&
    originalGRT !== null &&
    getValues("grt") !== undefined &&
    String(getValues("grt")) !== String(originalGRT) &&
    !getValues("tonnageBooklets");

  const stabilityRequired =
    isEditMode &&
    originalGRT !== null &&
    getValues("grt") !== undefined &&
    String(getValues("grt")) !== String(originalGRT) &&
    !getValues("stabilityBooklets");
  const supervisionAuthority = methods.watch("supervisionAuthority");

  const steps = isViewMode
    ? [
      {
        label: t("Vessel Details"),
        component: (
          <VesselDetails
            formMethods={methods}
            viewMode={isViewMode}
            editMode={isEditMode}
          />
        ),
        validate: validateVesselDetails,
      },
      {
        label: t("Documents"),
        component: (
          <Documents
            formMethods={methods}
            viewMode={isViewMode}
            editMode={isEditMode}
            vesselRegisData={vesselRegisData}
          />
        ),
        validate: validateDocuments,
      },
      {
        label: t("Payment Details"),
        component: (
          <PaymentDetailsView
            supervisionAuthority={supervisionAuthority}
            formData={methods.getValues()}
            vesselRegisData={vesselRegisData}
          />
        ),
        validate: () => true,
      },
    ]
    : [
      {
        label: t("vesselDetails.Vessel Details"),
        component: (
          <VesselDetails
            formMethods={methods}
            viewMode={isViewMode}
            editMode={isEditMode}
          />
        ),
        validate: validateVesselDetails,
        getFormData: () => methods?.getValues(),
      },
      {
        label: t("vesselDetails.Documents"),
        component: (
          <Documents
            formMethods={methods}
            viewMode={isViewMode}
            editMode={isEditMode}
            vesselRegisData={vesselRegisData}
            tonnageRequired={tonnageRequired}
            stabilityRequired={stabilityRequired}
          />
        ),
        validate: validateDocuments,
        getFormData: () => methods?.getValues(),
      },
      //  {
      //   label : t("Preview"),
      //   component: <VesselRegistrationPreview formData={methods.getValues()} isPreview={true}
      // />
      // },
      {
        label: t("vesselDetails.Invoicing"),
        component: (
          <Invoicing
            supervisionAuthority={supervisionAuthority}
            onPayNow={handlePayNow}
            vesselRegisData={vesselRegisData}
          />
        ),
        validate: () => true,
      },
    ];

  const extractDocuments = (formData, isEdit) => {
    const documents = [];

    // Static documents
    const staticDocs = [
      {
        key: "TONNAGE_BOOKLETS",
        name: "Tonnage Booklet",
        description: "Tonnage document",
      },
      {
        key: "STABILITY_BOOKLETS",
        name: "Stability Booklet",
        description: "Stability document",
      },
    ];

    staticDocs.forEach(({ key, name, description }) => {
      const fileStoreId = formData?.[`${key}_fileStoreId`];
      const fileObj = formData?.[`${key}`];
      if (fileStoreId) {
        documents.push({
          id: "", //--- UPDATE
          fileStoreId,
          documentName: fileObj.name,
          documentType: key,
          documentSource: key,
          description,
        });
      }
    });

    const dynamicTypes = ["WORK_ORDER", "DRAWINGS"];
    dynamicTypes.forEach((type) => {
      Object.keys(formData)
        .filter((key) => key.startsWith(`${type}_fileStoreId_`))
        .forEach((storeKey) => {
          const index = storeKey.split("_").pop();
          const fileStoreId = formData[storeKey];
          const description = formData[`${type}_desc_${index}`] || "";
          const fileObj = formData?.[`${type}_file_${index}`];

          if (fileStoreId) {
            documents.push({
              id: "", /// --- UPDATE API CALL
              fileStoreId,
              documentName: fileObj.name,
              documentType: type,
              documentSource: type,
              description,
            });
          }
        });
    });

    return documents;
  };

  //--- SAVE / UPDATE  API CALLS ------------
  const onVesselRegisFormSubmit = async (stepInfo) => {
    const formValues = stepInfo?.getFormData?.() || {};
    console.log("formValues ", formValues);

    // In edit adding this condition --->for testing --AS
    if (isEditMode) {
      stepperRef?.current?.goToNextStep();
      return;
    }

    //-- First Step or Second Step
    if (stepInfo.index === 0 || stepInfo.index === 1) {
      let request = {
        id: vesselRegisData?.basicDetails?.id || "", //--- UPDATE
        applicationNumber: vesselRegisData?.applicationNumber, //--- UPDATE
        basicDetails: {
          id: vesselRegisData?.basicDetails?.id || "", //--- UPDATE
          applicationNumber: vesselRegisData?.applicationNumber || "", //--- UPDATE
          status: "", //--- UPDATE
          constructedBy: formValues?.constructedBy,
          ownerDetails: {
            id: ownerDetails?.id,
          },
          builderDetails: {
            id: formValues?.builder,
          },
          builderAuthorization: formValues?.builderAuth,
          authorizationLetter: {
            id: vesselRegisData?.basicDetails?.authorizationLetter?.id || "", //--- UPDATE
            fileStoreId: formValues?.authLetterFileStoreId,
            documentName: "Authorization_Letter.pdf",
            documentType: "AUTHORIZATION_LETTER",
            documentSource: "AUTHORIZATION_LETTER",
            descriptions: "",
          },
        },
        vesselDetails: {
          id: vesselRegisData?.vesselDetails?.id || "", //--- UPDATE
          typeOfVessel: formValues?.vesselType,
          categoryOfVessel: formValues?.category,
          zone: formValues?.zone,
          grossTonnage: formValues?.grt,
          workOrderValue: formValues?.workOrderValue,
          purchaseType: formValues?.purchaseType,
          supervisionAuthority: formValues?.supervisionAuthority,
          nameOfMaster: "",
          certficateNumber: "",
          nameOfRegistry: "",
          registrationNumber: "",
          vesselName: "",
          kindOfVessel: "",
          mortgage: "",
          placeOfBuild: "",
          insuranceDetails: "",
          yearOfBuild: null,
          pniClubNo: "",
          pniClubName: "",
          applicationNo: "",
          nameOfClassificationSociety: formValues?.classificationSociety,
          iwtVesselBasicDetailsTFk: "",
          insuranceValidDate: "",
        },
      };

      if (stepInfo.index === 1) {
        request = { ...request, documents: extractDocuments(formValues) };
      }

      try {
        loaderRef?.current?.show();
        const URL =
          SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.VESSEL_SERVICE.CREATE;

        const response = await postData(URL, request);
        const apiRes = { ...response?.data };
        if (response?.status === 200 && apiRes?.responseStatus) {
          loaderRef?.current?.hide();
          setVesselRegisData(apiRes?.data ? { ...apiRes?.data } : "");
          toast.success(
            apiRes?.responseStatus?.message ||
            "Vessel details saved successfully.",
            { position: "top-right" }
          );

          setTimeout(() => {
            stepperRef?.current?.goToNextStep();
            window.scrollTo(0, 0);
          }, 1000);
        } else {
          loaderRef?.current?.hide();
          toast.warning(
            apiRes?.responseStatus?.message || "Something went wrong..",
            { position: "top-right" }
          );
        }
      } catch (err) {
        loaderRef?.current?.hide();
        handleErrorMessage(err?.response?.data);
      }
    }
  };

  const handleSave = () => {
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", {
        state: { registrationId: "VR2024001" },
      });
    }, 1500);
  };

  const actionDropdown = isViewMode ? (
    <ActionDropdown
      actions={actionsFromAPI}
      onActionClick={handleActionClick}
      variant="contained"
      sx={{
        backgroundColor: "#2E57A7",
        fontWeight: "bold",
        borderRadius: "0.5rem",
        minWidth: "8rem",
        fontSize: "0.9rem",
        color: "#fff",
        "&:hover": {
          backgroundColor: "#1f4ea0",
        },
      }}
    />
  ) : null;

  return (
    <>
      <NewLoader ref={loaderRef} />

      <Box
        sx={{
          padding: "1rem 0.5rem 0 0.5rem",
          backgroundColor: "#f5f6fa",
          minHeight: "100vh",
        }}
      >
        <div className="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
          <div
            className="d-flex align-items-center flex-grow-1"
            style={{ gap: "20px" }}
          >
            <Button
              variant="outline-primary"
              size="sm"
              onClick={() => navigate("/dashboard")}
              className="d-flex align-items-center shadow-sm"
              style={{
                borderRadius: "8px",
                // padding: "10px 18px",
                fontSize: "0.6rem",
                fontWeight: "200",
                border: "2px solid #2E57A7",
                color: "#2E57A7",
                backgroundColor: "#fff",
                transition: "all 0.3s ease",
                minWidth: "auto",
                whiteSpace: "nowrap",
              }}
              onMouseEnter={(e) => {
                e.target.style.backgroundColor = "#2E57A7";
                e.target.style.color = "#fff";
                e.target.style.transform = "translateY(-1px)";
              }}
              onMouseLeave={(e) => {
                e.target.style.backgroundColor = "#fff";
                e.target.style.color = "#2E57A7";
                e.target.style.transform = "translateY(0)";
              }}
            >
              <BsArrowLeft className="me-2" size={10} />
              Back
            </Button>
            <Stack spacing={0.5} className="flex-grow-1">
              <Typography
                sx={{
                  fontWeight: 550,
                  color: "#2E57A7",
                  fontSize: { xs: "1rem", sm: "1.1rem", md: "1.2rem" },
                  lineHeight: 1.2,
                }}
              >
                {isViewMode
                  ? t("View Vessel Registration") + ` - ${id}`
                  : isEditMode
                    ? t("Edit Vessel Registration") + ` - ${id}`
                    : t("vesselDetails.New Vessel Registration")}
              </Typography>
              <Typography
                sx={{
                  color: "#666",
                  fontSize: { xs: "0.6rem", sm: "0.65rem" },
                  lineHeight: 1.3,
                }}
              >
                {isViewMode
                  ? t("(View vessel registration details)")
                  : isEditMode
                    ? t("(Update vessel registration details)")
                    : t(
                      "vesselDetails.(Fill in the vessel details to complete registration)"
                    )}
              </Typography>
            </Stack>
          </div>
          {/* Note Sheet Button - Only for View Mode */}
          {/* {isViewMode && (
                <Button
                  variant="primary"
                  className="d-flex align-items-center shadow-sm flex-shrink-0"
                  style={{
                    background:
                      "linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%)",
                    border: "none",
                    borderRadius: "8px",
                    padding: "6px 12px",
                    fontSize: "0.8rem",
                    fontWeight: "600",
                    minWidth: "auto",
                    whiteSpace: "nowrap",
                  }}
                  onClick={() => setShowNoteSheet(true)}
                >
                  <BsSticky className="me-1 me-sm-2" size={14} />
                  <span className="d-none d-sm-inline">{t("Note Sheet")}</span>
                  <span className="d-sm-none">{t("Notes")}</span>
                </Button>
              )} */}
        </div>

        <Stepper
          ref={stepperRef}
          steps={steps}
          onSave={handleSave}
          viewMode={isViewMode}
          actionComponent={actionDropdown}
          onPayNow={handlePayNow}
          onSyncData={onVesselRegisFormSubmit}
        />
        {/* <NoteSheet
              show={showNoteSheet}
              onHide={() => setShowNoteSheet(false)}
              initialNotes={initialNotes}
            /> */}

        {!isViewMode && (
          <PaymentModal
            show={showModal}
            onHide={() => setShowModal(false)}
            paymentMode={paymentMode}
            setPaymentMode={setPaymentMode}
            challanFile={challanFile}
            onChallanUpload={handleChallanUpload}
            onOnlinePay={handleOnlinePay}
            onOfflineSubmit={handleOfflineSubmit}
            isLoading={isLoading}
            formMethods={methods}
          />
        )}

        {isViewMode && (
          <ApprovalModal
            show={showApprovalModal}
            handleClose={handleCloseModal}
            handleSubmitData={handleActionSubmit}
            selectedAction={selectedAction}
          />
        )}
      </Box>
    </>
  );
};

export default NewVesselRegistration;
import React, { useState, useEffect, useRef } from "react";
import { Row, Col, Button, Card } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile.tsx";
import InputText from "../../../common/InputText.tsx";
import { renameFile } from "../../../../utils/constants.ts";
import { BsDownload, BsFileEarmarkPdf, BsPlus, BsTrash } from "react-icons/bs";
import { BASE_IP, URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import { postFORMdata } from "../../../../services/http.service.ts";
import { FaTimesCircle } from "react-icons/fa";
import { toast } from "react-toastify";
import NewLoader from "../../../common/NewLoader.js";

const Documents = ({
  formMethods,
  viewMode = false,
  editMode = false,
  vesselRegisData,
  tonnageRequired,
  stabilityRequired,
}) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  const [workOrderFiles, setWorkOrderFiles] = useState([{ id: 1 }]);
  const [drawingsFiles, setDrawingsFiles] = useState([{ id: 1 }]);
  const [regVesselData, setRegVesselData] = useState(vesselRegisData);
  const loaderRef = useRef();

  const {
    register,
    watch,
    setValue,
    clearErrors,
    getValues,
    setError,
    formState: { errors },
    unregister
  } = formMethods;

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach((key) => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  useEffect(() => {
    if (viewMode || editMode) {
      const workOrderIds = [];
      const drawingIds = [];

      for (let i = 1; i <= 50; i++) {
        const workOrderFile = getValues(`WORK_ORDER_file_${i}`);
        const drawingFile = getValues(`DRAWINGS_file_${i}`);

        if (workOrderFile && workOrderFile.name) {
          workOrderIds.push({ id: i });
        }
        if (drawingFile && drawingFile.name) {
          drawingIds.push({ id: i });
        }
      }

      if (workOrderIds.length > 0) setWorkOrderFiles(workOrderIds);
      if (drawingIds.length > 0) setDrawingsFiles(drawingIds);
    }
  }, [viewMode, editMode, getValues]);

  const DocumentCard = ({
    fileName,
    description,
    onDownload,
    fileSize,
    onRemove,
    showRemove = false,
  }) => {
    const [isMobile, setIsMobile] = useState(window.innerWidth <= 768);

    useEffect(() => {
      const handleResize = () => setIsMobile(window.innerWidth <= 768);
      window.addEventListener("resize", handleResize);
      return () => window.removeEventListener("resize", handleResize);
    }, []);

    return (
      <Card className="mb-1 border-0 shadow-sm">
        <Card.Body className="p-2">
          <div className="d-flex justify-content-between align-items-center">
            <div
              className="d-flex align-items-center flex-grow-1 me-2"
              style={{ minWidth: 0 }}
            >
              {!isMobile && (
                <div className="bg-danger bg-opacity-10 rounded-circle p-1 me-2 flex-shrink-0">
                  <BsFileEarmarkPdf className="text-danger" size={10} />
                </div>
              )}
              <div style={{ minWidth: 0 }}>
                <div
                  className="text-primary fw-semibold"
                  style={{
                    fontSize: isMobile ? "0.8rem" : "0.7rem",
                    overflow: "hidden",
                    textOverflow: "ellipsis",
                    whiteSpace: "nowrap",
                    lineHeight: "1.3",
                    marginBottom: isMobile ? "0" : "4px",
                  }}
                  title={fileName}
                >
                  {fileName}
                </div>
                {!isMobile && (
                  <>
                    <p
                      className="mb-0 text-muted"
                      style={{
                        fontSize: "0.6rem",
                        overflow: "hidden",
                        textOverflow: "ellipsis",
                        whiteSpace: "nowrap",
                      }}
                    >
                      {description}
                    </p>
                    {fileSize && (
                      <span
                        className="badge bg-light text-dark mt-1"
                        style={{ fontSize: "0.55rem" }}
                      >
                        {(fileSize / 1024 / 1024).toFixed(1)} MB
                      </span>
                    )}
                  </>
                )}
              </div>
            </div>
            <div className="flex-shrink-0">
              <Button
                variant="outline-primary"
                size="sm"
                onClick={() => onDownload(fileName)}
                className="rounded-pill d-flex align-items-center"
                style={{
                  minWidth: "auto",
                  fontSize: "0.6rem",
                  padding: isMobile ? "6px 8px" : "4px 6px",
                }}
              >
                {isMobile && <BsFileEarmarkPdf className="me-1" size={12} />}
                <BsDownload size={isMobile ? 12 : 8} />
                {!isMobile && <span className="ms-1">{t("Download")}</span>}
              </Button>
              {showRemove && (
                <Button
                  variant="outline-danger"
                  size="sm"
                  onClick={onRemove}
                  className="rounded-pill ms-1"
                  style={{ minWidth: "auto", padding: "4px 6px" }}
                >
                  <BsTrash size={8} />
                </Button>
              )}
            </div>
          </div>
        </Card.Body>
      </Card>
    );
  };

  const FileUploadCard = ({
    label,
    name,
    onRemove,
    showRemove = false,
    fileIndex,
  }) => (
    <Card className="mb-2 border-2 border-dashed border-primary border-opacity-25">
      <Card.Body className="p-2">
        <div className="mb-2">
          <div style={{ fontSize: "0.75rem" }}>
            <InputFile
              label={label}
              name={name}
              register={register(name)}
              errors={errors}
              onChange={(e) => {
                if (e?.target?.files && e?.target?.files[0]) {
                  const file = e.target.files[0];

                  if (file.size > 30 * 1024 * 1024) {
                    setError(name, {
                      type: "manual",
                      message: t(
                        "vesselDetails..File size should not exceed 30MB"
                      ),
                    });
                    return;
                  }

                  const extension = file?.name?.substring(
                    file?.name?.lastIndexOf(".")
                  );
                  const fileType = name.includes("WORK_ORDER")
                    ? "WORK_ORDER"
                    : "DRAWINGS";
                  const fileName = `${fileType}_${String(fileIndex).padStart(
                    2,
                    "0"
                  )}${extension}`;
                  file.originalName = fileName;
                  const renamedFile = renameFile(file, fileName);
                  uploadFile(file, name, renamedFile, fileType, fileIndex);
                }
              }}
              watch={watch}
              defaultValue={watch(name)}
              clearErrors={clearErrors}
              accept=".pdf,.jpg,.jpeg,.png"
              className="mobile-file-input"
            />
          </div>
        </div>
        <div className="mb-2">
          <div style={{ fontSize: "0.75rem" }}>
            <InputText
              label={t("vesselDetails.Description")}
              name={name?.replace("_file_", "_desc_")}
              placeholder={t("vesselDetails.Enter file description")}
              register={register(name.replace("_file_", "_desc_"))}
              errors={errors}
              className="mobile-text-input"
            />
          </div>
        </div>
        {showRemove && (
          <div className="text-end">
            <Button
              variant="outline-danger"
              size="sm"
              onClick={onRemove}
              className="rounded-pill"
              style={{ fontSize: "0.65rem", padding: "2px 6px" }}
            >
              <BsTrash className="me-1" size={8} />
              <span className="d-none d-sm-inline">Remove</span>
              <span className="d-sm-none">×</span>
            </Button>
          </div>
        )}
      </Card.Body>
    </Card>
  );

  const FileSection = ({ title, files, type, icon }) => {
    const [isMobile, setIsMobile] = useState(window.innerWidth <= 768);

    useEffect(() => {
      const handleResize = () => setIsMobile(window.innerWidth <= 768);
      window.addEventListener("resize", handleResize);
      return () => window.removeEventListener("resize", handleResize);
    }, []);

    const filesWithData = files.filter((file) => {
      const fileData = watch(`${type}_file_${file.id}`);
      return fileData && fileData.name;
    });

    return (
      <Card className="h-100 shadow-sm border-0">
        <Card.Header className="bg-light border-0 py-2">
          <div className="d-flex justify-content-between align-items-center">
            <h6
              className="mb-0 text-primary fw-bold d-flex align-items-center"
              style={{ fontSize: isMobile ? "0.8rem" : "0.75rem" }}
            >
              {icon}
              <span className="ms-2">{title}</span>
            </h6>
            <span
              className="badge bg-primary rounded-pill"
              style={{ fontSize: "0.6rem" }}
            >
              {viewMode ? filesWithData.length : files.length} files
            </span>
          </div>
        </Card.Header>

        <Card.Body className="p-1">
          <div
            style={{
              maxHeight: isMobile ? "350px" : "250px",
              overflowY: "auto",
            }}
          >
            {viewMode ? (
              filesWithData.length > 0 ? (
                filesWithData.map((fileInput, index) => {
                  const fileData = watch(`${type}_file_${fileInput.id}`);
                  const descData = watch(`${type}_desc_${fileInput.id}`);

                  return (
                    <DocumentCard
                      key={fileInput.id}
                      fileName={fileData.name}
                      description={descData || `${title} document ${index + 1}`}
                      fileSize={fileData.size}
                      onDownload={() => handleDownload(fileData.name)}
                    />
                  );
                })
              ) : (
                <div className="text-center py-3 text-muted">
                  <div className="bg-light rounded-circle p-2 d-inline-flex mb-2">
                    <BsFileEarmarkPdf size={20} className="opacity-50" />
                  </div>
                  <p className="mb-0" style={{ fontSize: "0.7rem" }}>
                    No files uploaded
                  </p>
                </div>
              )
            ) : (
              files.map((fileInput, idx) => (
                <FileUploadCard
                  key={fileInput.id}
                  label={`${t("vesselDetails.Choose File")} ${idx + 1}`}
                  name={`${type}_file_${fileInput.id}`}
                  fileIndex={idx + 1}
                  onRemove={() => removeFileInput(type, fileInput.id)}
                  showRemove={files.length > 1}
                />
              ))
            )}
          </div>
        </Card.Body>

        {!viewMode && (
          <Card.Footer className="bg-light border-0 text-center py-1">
            <Button
              variant="primary"
              size="sm"
              onClick={() => addFileInput(type)}
              className="rounded-pill px-2"
              style={{ fontSize: "0.65rem" }}
            >
              <BsPlus className="me-1" size={10} />
              <span className={isMobile ? "d-none" : ""}>Add {title}</span>
              <span className={isMobile ? "" : "d-none"}>+</span>
            </Button>
          </Card.Footer>
        )}
      </Card>
    );
  };

  const SingleFileSection = ({
    title,
    fileName,
    onDownload,
    fileSize,
    icon,
  }) => (
    <Card className="h-100 shadow-sm border-0">
      <Card.Header className="bg-light border-0 py-2">
        <h6
          className="mb-0 text-primary fw-bold d-flex align-items-center"
          style={{ fontSize: "0.75rem" }}
        >
          {icon}
          <span className="ms-2">{title}</span>
        </h6>
      </Card.Header>
      <Card.Body className="p-2">
        {fileName ? (
          <DocumentCard
            fileName={fileName}
            description={`${title} document`}
            fileSize={fileSize}
            onDownload={() => onDownload(fileName)}
          />
        ) : (
          <div className="text-center py-2 text-muted">
            <div className="bg-light rounded-circle p-2 d-inline-flex mb-2">
              <BsFileEarmarkPdf size={20} className="opacity-50" />
            </div>
            <p className="mb-0" style={{ fontSize: "0.7rem" }}>
              No file uploaded
            </p>
          </div>
        )}
      </Card.Body>
    </Card>
  );

  const addFileInput = (type) => {
    if (viewMode) return;
    if (type === "WORK_ORDER") {
      const newId =
        workOrderFiles.length > 0
          ? Math.max(...workOrderFiles.map((f) => f.id)) + 1
          : 1;
      setWorkOrderFiles([...workOrderFiles, { id: newId }]);
    } else if (type === "DRAWINGS") {
      const newId =
        drawingsFiles.length > 0
          ? Math.max(...drawingsFiles.map((f) => f.id)) + 1
          : 1;
      setDrawingsFiles([...drawingsFiles, { id: newId }]);
    }
  };

  const removeFileInput = (type, id) => {
    if (viewMode) return;
    if (type === "WORK_ORDER") {
      setWorkOrderFiles(workOrderFiles.filter((file) => file.id !== id));
    } else if (type === "DRAWINGS") {
      setDrawingsFiles(drawingsFiles.filter((file) => file.id !== id));
    }
    // setValue(`${type}_file_${id}`, null);
    // setValue(`${type}_desc_${id}`, "");

    unregister(`${type}_file_${id}`);
    unregister(`${type}_desc_${id}`);
    unregister(`${type}_fileStoreId_${id}`);
    clearErrors([`${type}_file_${id}`, `${type}_desc_${id}`]);
  };

  const handleDownload = (fileName) => {
    const link = document.createElement("a");
    link.href = "#";
    link.download = fileName;
    link.click();
  };

  const uploadFile = async (
    file,
    formValueName,
    renamedFile,
    fileType,
    fileIndex
  ) => {
    try {
      loaderRef?.current?.show();
      const formData = new FormData();
      formData.append("file", file);
      const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
      const response = await postFORMdata(uploadUrl, formData);
      const fileStoreId = response?.data?.files[0]?.fileStoreId;
      console.log("fileStoreId ", fileStoreId);

      clearErrors(formValueName);
      setValue(formValueName, renamedFile, { shouldValidate: true });

      if (fileType === 'STABILITY_BOOKLETS' || fileType === 'TONNAGE_BOOKLETS') {
        setValue(fileType + "_fileStoreId", fileStoreId);
      } else {
        setValue(fileType + "_fileStoreId_" + fileIndex, fileStoreId);
        setFormData((prev) => ({
          ...prev,
          [formValueName]: renamedFile,
        }));
      }

      loaderRef?.current?.hide();

    } catch (err) {
      
      loaderRef?.current?.hide();
      console.error(err);
      setError(formValueName, {
        type: "manual",
        message: t("File upload failed"),
      });
      toast.error("File upload failed...");
    }
  };

  return (
    <>
      <NewLoader ref={loaderRef} />
      <style jsx>{`
        @media (max-width: 768px) {
          .mobile-file-input .file-upload {
            padding: 0.5rem !important;
          }

          .mobile-file-input .file-label {
            font-size: 0.7rem !important;
            padding: 4px 8px !important;
            min-width: 80px !important;
          }

          .mobile-file-input .file-name-container {
            font-size: 0.65rem !important;
            padding: 4px 8px !important;
          }

          .mobile-text-input .form-control {
            font-size: 0.75rem !important;
            padding: 0.25rem 0.5rem !important;
          }

          .mobile-text-input .form-label {
            font-size: 0.7rem !important;
            margin-bottom: 0.25rem !important;
          }
        }
      `}</style>
      <Collapsible title={t("vesselDetails.Documents")} openStat={true}>
        <div style={{ padding: "1rem", backgroundColor: "#f8f9fa" }}>
          <Row className="g-3">
            <Col lg={6} md={12}>
              <FileSection
                title={t("vesselDetails.Work Order")}
                files={workOrderFiles}
                type="WORK_ORDER"
                icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
              />
            </Col>

            <Col lg={6} md={12}>
              <FileSection
                title={t("vesselDetails.Drawings")}
                files={drawingsFiles}
                type="DRAWINGS"
                icon={<BsFileEarmarkPdf className="text-success" size={12} />}
              />
            </Col>

            <Col md={6}>
              {viewMode ? (
                <SingleFileSection
                  title={t("vesselDetails.Tonnage Booklets")}
                  fileName={watch("TONNAGE_BOOKLETS")?.name}
                  fileSize={watch("TONNAGE_BOOKLETS")?.size}
                  onDownload={handleDownload}
                  icon={<BsFileEarmarkPdf className="text-warning" size={12} />}
                />
              ) : (
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-2">
                    <h6
                      className="mb-0 text-primary fw-bold d-flex align-items-center"
                      style={{ fontSize: "0.75rem" }}
                    >
                      <BsFileEarmarkPdf
                        className="text-warning me-2"
                        size={12}
                      />
                      {t("vesselDetails.Tonnage Booklets")}
                    </h6>
                  </Card.Header>
                  <Card.Body className="p-2">
                    <div style={{ fontSize: "0.75rem", display: "flex" }}>
                      <InputFile
                        label={t("vesselDetails.Tonnage Booklets")}
                        required={tonnageRequired}
                        name="TONNAGE_BOOKLETS"
                        register={register("TONNAGE_BOOKLETS")}
                        errors={errors}
                        style={{ width: "100%" }}
                        onChange={(e) => {
                          if (e.target.files && e?.target?.files[0]) {
                            const file = e.target.files[0];
                            if (file.size > 30 * 1024 * 1024) {
                              setError("TONNAGE_BOOKLETS", {
                                type: "manual",
                                message: t("File size should not exceed 30MB"),
                              });
                              return;
                            }
                            const extension = file?.name?.substring(
                              file?.name?.lastIndexOf(".")
                            );
                            const fileName = `Tonnage Booklets${extension}`;
                            file.originalName = fileName;
                            const renamedFile = renameFile(file, fileName);

                            uploadFile(file, "TONNAGE_BOOKLETS", renamedFile, 'TONNAGE_BOOKLETS');


                            // clearErrors("TONNAGE_BOOKLETS");
                            // setValue("TONNAGE_BOOKLETS", renamedFile, {
                            //   shouldValidate: true,
                            // });
                          }
                        }}
                        watch={watch}
                        accept=".pdf,.jpg,.jpeg,.png"
                        defaultValue={watch("TONNAGE_BOOKLETS")}
                        clearErrors={clearErrors}
                        className="mobile-file-input"
                      />

                      {watch("TONNAGE_BOOKLETS") && !viewMode && (
                        <FaTimesCircle
                          className="text-danger position-relative"
                          style={{
                            top: "3rem",
                            right: "3.5rem",
                            cursor: "pointer",
                          }}
                          size={18}
                          title="Remove file"
                          onClick={() => {
                            clearErrors("TONNAGE_BOOKLETS");
                            setValue("TONNAGE_BOOKLETS", null);
                            setValue("TONNAGE_BOOKLETS_fileStoreId", null);
                          }}
                        />
                      )}
                    </div>
                  </Card.Body>
                </Card>
              )}
            </Col>

            <Col md={6}>
              {viewMode ? (
                <SingleFileSection
                  title={t("vesselDetails.Stability Booklets")}
                  fileName={watch("STABILITY_BOOKLETS")?.name}
                  fileSize={watch("STABILITY_BOOKLETS")?.size}
                  onDownload={handleDownload}
                  icon={<BsFileEarmarkPdf className="text-info" size={12} />}
                />
              ) : (
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-2">
                    <h6
                      className="mb-0 text-primary fw-bold d-flex align-items-center"
                      style={{ fontSize: "0.75rem" }}
                    >
                      <BsFileEarmarkPdf className="text-info me-2" size={12} />
                      {t("vesselDetails.Stability Booklets")}
                    </h6>
                  </Card.Header>
                  <Card.Body className="p-2">
                    <div style={{ fontSize: "0.75rem", display: "flex" }}>
                      <InputFile
                        label={t("vesselDetails.Stability Booklets")}
                        required={stabilityRequired}
                        name="STABILITY_BOOKLETS"
                        register={register("STABILITY_BOOKLETS")}
                        errors={errors}
                        style={{ width: '100%' }}
                        onChange={(e) => {
                          if (e.target.files && e?.target?.files[0]) {
                            const file = e.target.files[0];
                            if (file.size > 30 * 1024 * 1024) {
                              setError("STABILITY_BOOKLETS", {
                                type: "manual",
                                message: t("File size should not exceed 30MB"),
                              });
                              return;
                            }
                            const extension = file?.name?.substring(
                              file?.name?.lastIndexOf(".")
                            );
                            const fileName = `Stability Booklets${extension}`;
                            file.originalName = fileName;
                            const renamedFile = renameFile(file, fileName);
                            // clearErrors("STABILITY_BOOKLETS");
                            // setValue("STABILITY_BOOKLETS", renamedFile, {
                            //   shouldValidate: true,
                            // });
                            uploadFile(file, "STABILITY_BOOKLETS", renamedFile, 'STABILITY_BOOKLETS');

                          }
                        }}
                        watch={watch}
                        accept=".pdf,.jpg,.jpeg,.png"
                        defaultValue={watch("STABILITY_BOOKLETS")}
                        clearErrors={clearErrors}
                        className="mobile-file-input"
                      />

                      {watch("STABILITY_BOOKLETS") && !viewMode && (
                        <FaTimesCircle
                          className="text-danger position-relative"
                          style={{
                            top: "3rem",
                            right: "3.5rem",
                            cursor: "pointer",
                          }}
                          size={18}
                          title="Remove file"
                          onClick={() => {
                            clearErrors("STABILITY_BOOKLETS");
                            setValue("STABILITY_BOOKLETS", null);
                            setValue("STABILITY_BOOKLETS_fileStoreId", null);
                          }}
                        />
                      )}

                    </div>
                  </Card.Body>
                </Card>
              )}
            </Col>

            <Col md={12}>
              <Card className="shadow-sm border-0">
                <Card.Body className="p-3">
                  <div className="d-flex align-items-start">
                    <input
                      type="checkbox"
                      id="termsAccepted"
                      className="me-3 mt-1"
                      {...register("termsAccepted", {
                        required: t("You must accept the terms and conditions"),
                      })}
                      disabled={viewMode}
                      checked={viewMode ? true : watch("termsAccepted")}
                    />
                    <div>
                      <label
                        htmlFor="termsAccepted"
                        className="mb-0 fw-medium"
                        style={{
                          color: "#333",
                          cursor: viewMode ? "default" : "pointer",
                          lineHeight: "1.5",
                          fontSize: "0.85rem",
                        }}
                      >
                        {t(
                          "vesselDetails.I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule."
                        )}
                      </label>
                      {errors.termsAccepted && !viewMode && (
                        <div className="text-danger small mt-2">
                          {t(errors.termsAccepted.message)}
                        </div>
                      )}
                    </div>
                  </div>
                </Card.Body>
              </Card>
            </Col>
          </Row>
        </div>
      </Collapsible>
    </>
  );
};

export default Documents;
import React, { useImperativeHandle, forwardRef, useState } from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";

const themeColor = "#2E57A7";
const successColor = "#28a745";

const Stepper = forwardRef(
  (
    {
      steps,
      onSave,
      viewMode = false,
      editMode = false,
      actionComponent = null,
      onNext,
      onBack,
      onPayNow,
      onSyncData,
      disableStepNavigation = false,
    },
    ref
  ) => {
    const { t } = useTranslation();
    const [activeStep, setActiveStep] = useState(0);
    const [completed, setCompleted] = useState({});
    const [errors, setErrors] = useState({});

    const totalSteps = steps.length;
    const currentStep = steps[activeStep];

    const buttonStyle = {
      fontWeight: "bold",
      borderRadius: "0.5rem",
      minWidth: "8rem",
      fontSize: "0.9rem",
      color: "#fff",
      backgroundColor: themeColor,
      "&:hover": {
        backgroundColor: "#1f4ea0",
      },
    };

    useImperativeHandle(ref, () => ({
      goToNextStep,
      goToStep,
    }));

    const goToNextStep = () => {
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
    };

    const markStepCompleted = () => {
      setCompleted((prev) => ({ ...prev, [activeStep]: true }));
    };

    const validateAndProceed = async (callback) => {
      if (currentStep.validate) {
        const isValid = await currentStep.validate();
        setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));

        if (!isValid) {
          toast.error("Please fix the errors before proceeding.");
          return;
        }
      }

      markStepCompleted();
      callback();
    };

    const handleNext = () => {
      if (viewMode || steps?.goToNextStepNoValidtion || editMode) {
        goToNextStep();
        markStepCompleted();
      } else {
        validateAndProceed(() => {
          goToNextStep();
          onNext?.(activeStep);
        });
      }
    };

    const handleBack = () => {
      setActiveStep((prev) => Math.max(prev - 1, 0));
      onBack?.(activeStep);
    };

    const handleSave = () => {
      if (viewMode) return;

      if (steps[activeStep]?.goToNextStepNoValidtion || editMode) {
        goToNextStep();
        markStepCompleted();
        return;
      }


      validateAndProceed(() => {
        if (activeStep < totalSteps - 1) {
          const currentStepInfo = {
            index: activeStep,
            label: currentStep?.label,
            component: currentStep?.component,
            validate: currentStep?.validate,
            isLastStep: activeStep === totalSteps - 1,
            completedSteps: completed,
            getFormData: currentStep?.getFormData,
          };
          onSyncData?.(currentStepInfo);

          // goToNextStep();
        } else {
          onSave?.();
        }
      });
    };

    const handlePayNow = () => {
      onPayNow?.() || currentStep?.component?.props?.onPayNow?.();
    };

    const renderActionButton = () => {
      if (viewMode) {
        return activeStep === totalSteps - 1 ? (
          actionComponent || (
            <Button variant="contained" sx={buttonStyle}>
              Submit
            </Button>
          )
        ) : (
          <Button variant="contained" sx={buttonStyle} onClick={handleNext}>
            {t("Next")}
          </Button>
        );
      }

      return activeStep === totalSteps - 1 ? (
        <Button variant="contained" sx={buttonStyle} onClick={handlePayNow}>
          {t("Pay Now")}
        </Button>
      ) : (
        <Button variant="contained" sx={buttonStyle} onClick={handleSave}>
          {t("Save & Next")}
        </Button>
      );
    };

    const goToStep = (index) => {
      if (index >= 0 && index < totalSteps) {
        setActiveStep(index);
      }
    };

    return (
      <Box sx={{ width: "100%", padding: "1rem" }}>
        <Paper
          elevation={3}
          sx={{
            padding: "0.75rem 1.5rem",
            borderRadius: "0.75rem",
            overflowX: "auto",
            whiteSpace: "nowrap",
            backgroundColor: "#fafafa",
          }}
        >
          <Stack direction="row" alignItems="center" spacing={1}>
            {steps?.map((step, index) => (
              <React.Fragment key={index}>
                <Stack
                  direction="row"
                  alignItems="center"
                  spacing={0.5}
                  sx={{ cursor: "pointer" }}
                  onClick={() => {
                    if (
                      !disableStepNavigation &&
                      (viewMode || completed[index] || editMode)
                    ) {
                      goToStep(index);
                    }
                  }}
                >
                  {completed[index] ? (
                    <CheckCircleFill size={18} color={successColor} />
                  ) : (
                    <Typography
                      sx={{
                        fontSize: "0.875rem",
                        width: "1.5rem",
                        height: "1.5rem",
                        textAlign: "center",
                        borderRadius: "50%",
                        backgroundColor: "#e0e0e0",
                        display: "inline-flex",
                        alignItems: "center",
                        justifyContent: "center",
                        fontWeight: "bold",
                        color: "#666",
                      }}
                    >
                      {index + 1}
                    </Typography>
                  )}
                  <Typography
                    sx={{
                      fontWeight:
                        index === activeStep || completed[index]
                          ? "bold"
                          : "normal",
                      color: index === activeStep ? themeColor : "#999",
                      fontSize: "0.875rem",
                      whiteSpace: "nowrap",
                    }}
                  >
                    {step.label}
                  </Typography>
                </Stack>
                {index < steps.length - 1 && (
                  <ChevronRight size={14} color="green" />
                )}
              </React.Fragment>
            ))}
          </Stack>
        </Paper>

        <Paper
          elevation={2}
          sx={{
            marginTop: "1rem",
            borderRadius: "0.75rem",
            backgroundColor: "#fff",
            width: "100%",
          }}
        >
          {currentStep.component}
          {errors[activeStep]}
        </Paper>

        <Divider sx={{ margin: "2rem 0" }} />

        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            gap: "1rem",
            flexDirection: { xs: "column", sm: "row" },
            alignItems: { xs: "stretch", sm: "center" },
          }}
        >
          <Button
            variant="outlined"
            onClick={handleBack}
            disabled={activeStep === 0}
            sx={{
              color: themeColor,
              borderColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: { xs: "100%", sm: "8rem" },
              fontSize: "0.9rem",
            }}
          >
            {t("Previous")}
          </Button>

          {renderActionButton()}
        </Box>
      </Box>
    );
  }
);

export default Stepper;


