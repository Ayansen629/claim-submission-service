import React, { useState, useEffect, useCallback } from "react";
import { useForm, FormProvider, Controller } from "react-hook-form";
import Collapsible from "../formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip";
import { FaInfoCircle, FaPlus, FaMinus } from "react-icons/fa";
import axios from "axios";
import "./FormC.css";

// ... (keep all the existing component definitions like DynamicField, IFSCSearch, etc.)

const FormCDetails = ({ provideSubmitHandler, formData, onValidationComplete }) => {
  const methods = useForm({ mode: "onChange" });
  const { 
    register, 
    handleSubmit, 
    formState: { errors, isValid }, 
    control, 
    setValue, 
    getValues, 
    watch, 
    reset, 
    trigger 
  } = methods;
  
  const [selectedClaimType, setSelectedClaimType] = useState("");
  const [showDetails, setShowDetails] = useState(false);

  const bankAccountFields = [
    // ... (keep existing bank account fields)
  ];

  const claimTypeOptions = [
    { value: "", label: "Select Claim Type", disabled: true },
    { value: "principalBorrower", label: "Corporate Debtor as Principal Borrower" },
    { value: "guarantor", label: "Corporate Debtor as Guarantor" },
    { value: "financialDebt", label: "Financial Debt Covered" },
  ];

  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    if (!isValid) {
      console.error("Validation failed");
      return false;
    }
    return getValues();
  }, [trigger, getValues]);

  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        setValue(key, formData[key]);
      });
      if (formData.claimType) {
        setSelectedClaimType(formData.claimType);
        setShowDetails(true);
      }
    }
  }, [formData, setValue]);

  const handleClaimTypeChange = async (value) => {
    setSelectedClaimType(value);
    setShowDetails(value !== "");
    reset({
      claimType: value,
      hasSecurityInterest: "",
      hasGuarantee: ""
    });
    await trigger();
  };

  const getClaimTitle = () => {
    switch (selectedClaimType) {
      case "principalBorrower":
        return "Corporate Debtor as Principal Borrower Details";
      case "guarantor":
        return "Corporate Debtor as Guarantor Details";
      case "financialDebt":
        return "Financial Debt Covered Details";
      default:
        return "Claim Details";
    }
  };

  useEffect(() => {
    if (provideSubmitHandler) {
      provideSubmitHandler(onSubmit);
    }
  }, [provideSubmitHandler, onSubmit]);

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        {/* Claim Type Selection - Always shown */}
        <div className="form-section">
          <div className="form-group">
            <label className="form-label">
              Select Claim Type <span className="required-asterisk">*</span>
            </label>
            <select
              {...register("claimType", { required: "Claim type is required" })}
              className={`form-control ${errors.claimType ? "is-invalid" : ""}`}
              onChange={(e) => handleClaimTypeChange(e.target.value)}
              value={selectedClaimType}
            >
              {claimTypeOptions.map((option) => (
                <option key={option.value} value={option.value} disabled={option.disabled}>
                  {option.label}
                </option>
              ))}
            </select>
            {errors.claimType && <div className="invalid-feedback">{errors.claimType.message}</div>}
          </div>
        </div>

        {/* Only show other fields after claim type is selected */}
        {showDetails && (
          <>
            {/* Claim Details Section - Two fields per row */}
            <div className="form-section">
              <Collapsible title="Details of Claim" defaultOpen={true}>
                <div className="form-grid">
                  <div className="form-row">
                    <div className="form-col">
                      <div className="form-group">
                        <label className="form-label">
                          Claim Type <span className="required-asterisk">*</span>
                        </label>
                        <input
                          {...register("claimTypeDisplay", { required: "Claim type is required" })}
                          type="text"
                          className={`form-control ${errors.claimTypeDisplay ? "is-invalid" : ""}`}
                          value={selectedClaimType ? 
                            claimTypeOptions.find(opt => opt.value === selectedClaimType)?.label || "" 
                            : ""}
                          readOnly
                        />
                      </div>
                    </div>
                    
                    <div className="form-col">
                      <DynamicField
                        fieldConfig={{
                          name: "debtDate",
                          label: "Date of debt incurred",
                          type: "date",
                          rules: { 
                            required: "This field is required",
                            validate: value => {
                              const today = new Date().toISOString().split('T')[0];
                              return value <= today || "Date cannot be in the future";
                            }
                          },
                          placeholder: "Select date"
                        }}
                        control={control}
                        register={register}
                        errors={errors}
                        setValue={setValue}
                        getValues={getValues}
                        watch={watch}
                      />
                    </div>
                  </div>

                  <div className="form-row">
                    <div className="form-col full-width">
                      <DynamicField
                        fieldConfig={{
                          name: "debtDetails",
                          label: "Details of how debt incurred",
                          type: "textarea",
                          rules: { required: "This field is required" },
                          placeholder: "Enter details of how debt was incurred",
                          rows: 3
                        }}
                        control={control}
                        register={register}
                        errors={errors}
                        setValue={setValue}
                        getValues={getValues}
                        watch={watch}
                      />
                    </div>
                  </div>

                  <div className="form-row">
                    <div className="form-col full-width">
                      <DynamicField
                        fieldConfig={{
                          name: "mutualDetails",
                          label: "Details of any mutual credit, mutual debts, or other mutual dealings between the corporate debtor and the creditor which may be set-off against the claim",
                          type: "textarea",
                          rows: 5,
                          placeholder: "Enter details of any mutual dealings"
                        }}
                        control={control}
                        register={register}
                        errors={errors}
                        setValue={setValue}
                        getValues={getValues}
                        watch={watch}
                      />
                    </div>
                  </div>
                </div>
              </Collapsible>
            </div>

            {/* Claim Type Specific Fields */}
            <div className="form-section">
              <Collapsible title={getClaimTitle()} defaultOpen={true}>
                <ClaimTypeFields 
                  claimType={selectedClaimType}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  getValues={getValues}
                  watch={watch}
                  trigger={trigger}
                />
              </Collapsible>
            </div>

            {/* Bank Account Details Section */}
            <div className="form-section">
              <Collapsible title="Bank Account Details" defaultOpen={true}>
                <div className="form-grid">
                  <div className="form-row">
                    {bankAccountFields.slice(0, 2).map((field) => (
                      <div className="form-col" key={field.name}>
                        {field.component ? (
                          <field.component
                            fieldConfig={field}
                            register={register}
                            errors={errors}
                            setValue={setValue}
                            trigger={trigger}
                          />
                        ) : (
                          <DynamicField
                            fieldConfig={field}
                            control={control}
                            register={register}
                            errors={errors}
                            setValue={setValue}
                            getValues={getValues}
                            watch={watch}
                          />
                        )}
                      </div>
                    ))}
                  </div>
                  
                  <div className="form-row">
                    {bankAccountFields.slice(2, 4).map((field) => (
                      <div className="form-col" key={field.name}>
                        <DynamicField
                          fieldConfig={field}
                          control={control}
                          register={register}
                          errors={errors}
                          setValue={setValue}
                          getValues={getValues}
                          watch={watch}
                        />
                      </div>
                    ))}
                  </div>
                  
                  <div className="form-row">
                    {bankAccountFields.slice(4, 6).map((field) => (
                      <div className="form-col" key={field.name}>
                        <DynamicField
                          fieldConfig={field}
                          control={control}
                          register={register}
                          errors={errors}
                          setValue={setValue}
                          getValues={getValues}
                          watch={watch}
                        />
                      </div>
                    ))}
                  </div>
                  
                  <div className="form-row">
                    {bankAccountFields.slice(6).map((field) => (
                      <div className="form-col" key={field.name}>
                        <DynamicField
                          fieldConfig={field}
                          control={control}
                          register={register}
                          errors={errors}
                          setValue={setValue}
                          getValues={getValues}
                          watch={watch}
                        />
                      </div>
                    ))}
                  </div>
                </div>
              </Collapsible>
            </div>
          </>
        )}
      </form>
    </FormProvider>
  );
};

export default FormCDetails;
