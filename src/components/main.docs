<Col md={6}>
  <InputFile
    label={t("Authorization Letter")}
    required={!isEditMode && !viewMode}
    name="authLetter"
    register={register("authLetter", {
      required: (!isEditMode && !viewMode && !watch("authLetter")) ? t("Authorization Letter is required") : false
    })}
    errors={errors}
    onChange={(e) => {
      if (viewMode) return;
      if (e.target.files && e?.target?.files[0]) {
        handleFileChange("authLetter", e.target.files[0]);
      } else if (!e.target.files || e.target.files.length === 0) {
        setValue("authLetter", null);
        clearErrors("authLetter");
      }
    }}
    disabled={viewMode}
    watch={watch}
    defaultValue={watch("authLetter")}
    clearErrors={clearErrors}
    accept=".pdf,.jpg,.jpeg,.png"
  />
</Col>
