import React, { useState, useEffect, useRef, useCallback } from "react";
import style from "./ActionTable.module.css";
import _ from "lodash";
import editIcon from "../../../assests/icons/edit.svg";
import viewIcon from "../../../assests/icons/view.svg";
import deleteIcon from "../../../assests/icons/delete.svg";
import upload from "../../../assests/icons/upload.svg";
import download from "../../../assests/icons/download.svg";
import { BsGeoAltFill } from "react-icons/bs";
import Tooltip from "@mui/material/Tooltip";
import { Dropdown } from "react-bootstrap";

const ActionTable = (props) => {
  const [searchedData, setSearchedData] = useState(props.rowData || []);
  const [currentPage, setCurrentPage] = useState(1);
  const [selected, setSelected] = useState([]);
  const [sortedColumn, setSortedColumn] = useState(null);
  const [sortOrder, setSortOrder] = useState("");
  const hideColumns = props.hideColumns || [];
  const [searchQuery, setSearchQuery] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");
  const [dateSort, setDateSort] = useState("none");
  const [itemsPerPage, setItemPerPage] = useState(10);

  useEffect(() => {
    if (props.rowData) {
      setSearchedData(props.rowData);
      setCurrentPage(1);
      const selectedRows = props.rowData
        .filter((item) => item.isChecked)
        .map((item) => item.id);
      setSelected(selectedRows);
    }
  }, [props.rowData]);

  // Apply filters and sorting
  useEffect(() => {
    let filteredData = [...(props.rowData || [])];
    
    // Apply status filter
    if (statusFilter !== "all") {
      filteredData = filteredData.filter(item => item.status === statusFilter);
    }
    
    // Apply search query
    if (searchQuery) {
      const searchValue = searchQuery.toLowerCase();
      filteredData = filteredData.filter(item => 
        Object.values(item).some(value => 
          value?.toString().toLowerCase().includes(searchValue)
        )
      );
    }
    
    // Apply date sorting
    if (dateSort !== "none") {
      filteredData.sort((a, b) => {
        console.log(a,"first")
        console.log(b,"second")
        const dateA = new Date(a.dateSubmitted || a.createdAt || a.date);
        const dateB = new Date(b.dateSubmitted || b.createdAt || b.date);
        return dateSort === "asc" ? dateA - dateB : dateB - dateA;
      });
    }
    
    setSearchedData(filteredData);
    setCurrentPage(1);
  }, [props.rowData, statusFilter, searchQuery, dateSort]);

  const indexOfLastItem = currentPage * itemsPerPage;
  const indexOfFirstItem = indexOfLastItem - itemsPerPage;
  const currentItems = searchedData.slice(indexOfFirstItem, indexOfLastItem);
  const totalPages = Math.ceil((searchedData?.length || 0) / itemsPerPage);

  const handleNextPage = () => {
    setCurrentPage((prevPage) => Math.min(prevPage + 1, totalPages));
  };

  const handlePrevPage = () => {
    setCurrentPage((prevPage) => Math.max(prevPage - 1, 1));
  };

  const handleOnSearch = (e) => {
    setSearchQuery(e.target.value);
  };

  const sortByColumn = (column) => {
    if (sortedColumn === column) {
      setSortOrder(sortOrder === "asc" ? "desc" : "asc");
    } else {
      setSortedColumn(column);
      setSortOrder("asc");
    }
  };

  const showSortedColumnIcon = (columnName) => {
    return sortedColumn === columnName ? (
      sortOrder === "asc" ? (
        <i className="fa fa-long-arrow-up table-arrow" aria-hidden="true" />
      ) : (
        <i className="fa fa-long-arrow-down table-arrow" aria-hidden="true" />
      )
    ) : (
      <></>
    );
  };

  const handleDeleteRow = (rowData) => {
    props.onDeleteRow?.(rowData);
  };

  const handleTrack = (rowData) => {
    props.onTrackRow?.(rowData);
  };

  const handleView = (rowData) => {
    props.onViewRow?.(rowData);
  };

  const handleEdit = (rowData) => {
    props.handleEditRow?.(rowData);
  };

  const handleDownload = (rowData) => {
    props.download?.(rowData);
  };

  const handleSelectAll = (e) => {
    if (e.target.checked) {
      const newSelecteds = currentItems.map(n => n.id);
      setSelected(newSelecteds);
      props.onCheckHandler?.(newSelecteds);
    } else {
      setSelected([]);
      props.onCheckHandler?.([]);
    }
  };

  const handleRowSelect = (e, row) => {
    const selectedId = row.id;
    if (e.target.checked) {
      const newSelected = [...selected, selectedId];
      setSelected(newSelected);
      props.onCheckHandler?.(newSelected);
    } else {
      const newSelected = selected.filter(id => id !== selectedId);
      setSelected(newSelected);
      props.onCheckHandler?.(newSelected);
    }
  };

  const isSelected = (id) => {
    return selected.includes(id);
  };

  const getStatusOptions = () => {
    const statuses = [...new Set(props.rowData?.map(item => item.status))];
    return ["all", ...statuses].filter(Boolean);
  };

  const StatusFilterDropdown = () => (
    <Dropdown className="ms-2">
      <Dropdown.Toggle 
        variant="outline-secondary" 
        id="status-filter-dropdown"
        className="d-flex align-items-center"
      >
        <i className="fa fa-filter me-2" />
        Status: {statusFilter === "all" ? "All" : statusFilter}
      </Dropdown.Toggle>
      <Dropdown.Menu className="dropdown-menu-end">
        {getStatusOptions().map((status, index) => (
          <Dropdown.Item 
            key={index} 
            onClick={() => setStatusFilter(status)}
            active={status === statusFilter}
            className="d-flex align-items-center"
          >
            {status === "all" ? "All Statuses" : status}
            {status === statusFilter && <i className="fa fa-check ms-2" />}
          </Dropdown.Item>
        ))}
      </Dropdown.Menu>
    </Dropdown>
  );

  const DateSortDropdown = () => (
    <Dropdown className="ms-2">
      <Dropdown.Toggle 
        variant="outline-secondary" 
        id="date-sort-dropdown"
        className="d-flex align-items-center"
      >
        <i className="fa fa-calendar me-2" />
        Date: {dateSort === "none" ? "Default" : dateSort === "asc" ? "Oldest First" : "Newest First"}
      </Dropdown.Toggle>
      <Dropdown.Menu className="dropdown-menu-end">
        <Dropdown.Item 
          onClick={() => setDateSort("none")} 
          active={dateSort === "none"}
          className="d-flex align-items-center"
        >
          Default Order
          {dateSort === "none" && <i className="fa fa-check ms-2" />}
        </Dropdown.Item>
        <Dropdown.Item 
          onClick={() => setDateSort("asc")} 
          active={dateSort === "asc"}
          className="d-flex align-items-center"
        >
          Oldest First
          {dateSort === "asc" && <i className="fa fa-check ms-2" />}
        </Dropdown.Item>
        <Dropdown.Item 
          onClick={() => setDateSort("desc")} 
          active={dateSort === "desc"}
          className="d-flex align-items-center"
        >
          Newest First
          {dateSort === "desc" && <i className="fa fa-check ms-2" />}
        </Dropdown.Item>
      </Dropdown.Menu>
    </Dropdown>
  );

  const PaginationOptions = () => {
    const [isShow, setIsShow] = useState(false);
    const exportRef = useRef(null);

    useEffect(() => {
      const handleOutsideClick = (e) => {
        if (exportRef.current && !exportRef.current.contains(e.target)) {
          setIsShow(false);
        }
      };
      document.addEventListener("click", handleOutsideClick);
      return () => {
        document.removeEventListener("click", handleOutsideClick);
      };
    }, []);

    return (
      <div
        id="export_button"
        ref={exportRef}
        className="d-inline-flex flex-row align-items-center"
      >
        <div className="pe-2">Rows per page</div>
        <Dropdown>
          <Dropdown.Toggle
            variant="outline-secondary"
            id="dropdownMenuButton1"
            className="d-flex align-items-center"
          >
            <span>{itemsPerPage}</span>
          </Dropdown.Toggle>

          <Dropdown.Menu>
            {[10, 25, 50, 100].map((item, i) => (
              <Dropdown.Item
                key={i}
                onClick={() => {
                  setItemPerPage(item);
                  setCurrentPage(1);
                }}
                active={itemsPerPage === item}
                className="d-flex align-items-center"
              >
                {item}
                {itemsPerPage === item && <i className="fa fa-check ms-2" />}
              </Dropdown.Item>
            ))}
          </Dropdown.Menu>
        </Dropdown>
      </div>
    );
  };

  const userData = JSON.parse(localStorage.getItem("userFormData")) || {};

  return (
    <div className="mb-5 px-0 mx-0 generic-action-table pt-3">
      {/* Search and Filter Controls */}
      <div className={`row ${style.table_controls} ${props.hideSearchBar ? "justify-content-end mb-3" : "justify-content-between"}`}>
        {!props.hideSearchBar && (
          <div className="col-md-6 mb-3">
            <div className="input-group">
              {/* <span className="input-group-text bg-white border-end-0">
                <i className="fa fa-search text-muted" />
              </span> */}
              <input
                type="search"
                value={searchQuery}
                onChange={handleOnSearch}
                placeholder="Search records..."
                className="form-control"
              />
             

            </div>
          </div>
        )}
        
        <div className="col-md-6 d-flex flex-wrap justify-content-end align-items-center mb-3">
          <div className="d-flex">
            <StatusFilterDropdown />
            <DateSortDropdown />
          </div>
          
          {props.showCustomBtn && (
            <button
              onClick={props.handleBtnClick}
              type="button"
              disabled={props.isCustomBtnDisabled}
              className="btn btn-primary ms-3 d-flex align-items-center"
            >
              <i className="fa fa-plus me-2" />
              <span>{props.btnName}</span>
            </button>
          )}
        </div>
      </div>

      {/* Table */}
      <div className={`${style.table_container} mb-3`}>
        <table className={`table ${style.table}`}>
          <thead>
            <tr className={style.table_header}>
              <th className="px-3 py-2" style={{ width: "50px" }}>
                <input
                  type="checkbox"
                  checked={selected.length > 0 && selected.length === currentItems.length}
                  onChange={handleSelectAll}
                  ref={input => {
                    if (input) {
                      input.indeterminate = selected.length > 0 && selected.length < currentItems.length;
                    }
                  }}
                />
              </th>
              
              {props.columns?.map((data, colIndx) => {
                return !hideColumns.includes(data.fieldName) ? (
                  <th
                    key={colIndx}
                    className={`px-3 py-2 ${data.clsName} ${style.sortable_header}`}
                    style={{ minWidth: data.minWidth || "150px" }}
                    onClick={() => sortByColumn(data.fieldName)}
                  >
                    <div className="d-flex align-items-center">
                      <span>{data.titleCode || data.colName}</span>
                      {showSortedColumnIcon(data.fieldName)}
                    </div>
                  </th>
                ) : null;
              })}
            </tr>
          </thead>
          <tbody>
            {currentItems.length > 0 ? (
              currentItems.map((row, index) => {
                const isItemSelected = isSelected(row.id);
                return (
                  <tr 
                    key={index} 
                    className={`${style.table_datarow} ${isItemSelected ? style.selected_row : ''}`}
                  >
                    <td className="px-3 py-2">
                      <input
                        type="checkbox"
                        checked={isItemSelected}
                        onChange={(e) => handleRowSelect(e, row)}
                      />
                    </td>
                    
                    {props.columns.map((o, colIndex) =>
                      o.isClickable ? (
                        <td
                          key={colIndex}
                          className={`px-3 py-2 ${o.clsName} ${style.clickable_cell}`}
                          onClick={(e) => props.additionalMethod?.(row)}
                        >
                          <span className={row.isRead === false ? style.unread : ''}>
                            {_.get(row, o.fieldName)}
                          </span>
                        </td>
                      ) : !hideColumns.includes(o.fieldName) && o.fieldName !== "action" ? (
                        <td
                          key={colIndex}
                          className={`px-3 py-2 ${o.clsName}`}
                        >
                          {o.colName === "Status" ? (
                            <span className={`${style.status_badge} ${style[_.get(row, o.fieldName) + '_status'] || ''}`}>
                              {_.get(row, o.fieldName) || "No Status"}
                            </span>
                          ) : (
                            <span className={row.isRead === false ? style.unread : ''}>
                              {_.get(row, o.fieldName)}
                              {o.fieldName2 ? _.get(row, o.fieldName2) : ""}
                            </span>
                          )}
                        </td>
                      ) : !hideColumns.includes(o.fieldName) && o.fieldName === "action" ? (
                        <td key={colIndex} className={`px-3 py-2 ${o.clsName} ${style.action_cell}`}>
                          <div className="d-flex justify-content-center" style={{ gap: "8px" }}>
                            {o.actions.includes("edit") && userData?.userType !== "CRP" && (
                              <Tooltip title="Edit" placement="top" arrow>
                                <button
                                  className={`btn btn-sm ${style.action_button} ${style.edit_button}`}
                                  onClick={() => handleEdit(row)}
                                  type="button"
                                  disabled={row.applicationStatus !== "Sent back" && row.applicationStatus !== "Draft"}
                                >
                                  <img src={editIcon} alt="edit" />
                                </button>
                              </Tooltip>
                            )}
                            
                            {o.actions.includes("view") && (
                              <Tooltip title="View" placement="top" arrow>
                                <button
                                  className={`btn btn-sm ${style.action_button} ${style.view_button}`}
                                  onClick={() => handleView(row)}
                                  type="button"
                                >
                                  <img src={viewIcon} alt="view" />
                                </button>
                              </Tooltip>
                            )}
                            
                            {o.actions.includes("track") && userData?.userType !== "CRP" && (
                              <Tooltip title="Track" placement="top" arrow>
                                <button
                                  className={`btn btn-sm ${style.action_button} ${style.track_button}`}
                                  onClick={() => handleTrack(row)}
                                  type="button"
                                >
                                  <BsGeoAltFill />
                                </button>
                              </Tooltip>
                            )}
                               {/* Delete Button */}
                          {o.actions.includes("delete") && (
                            <Tooltip title="Delete this item" placement="top" arrow>
                              <button
                                className="btn btn-danger btn-sm"
                                onClick={() => handleDeleteRow(row)}
                                type="button"
                              >
                                <img src={deleteIcon} alt="delete" className="table-action-icon" />
                              </button>
                            </Tooltip>
                          )}
                          </div>
                        </td>
                      ) : null
                    )}
                  </tr>
                );
              })
            ) : (
              <tr>
                <td colSpan={props.columns.length + 1} className="text-center py-5">
                  <div className={style.no_records}>
                    <i className="fa fa-database me-2" />
                    No records found matching your criteria
                  </div>
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      {/* Table Footer */}
      <div className={`${style.table_footer} py-3`}>
        <div className="d-flex justify-content-between align-items-center">
          <div className={style.selection_info}>
            Showing {indexOfFirstItem + 1}-{Math.min(indexOfLastItem, searchedData.length)} of {searchedData.length} entries
            {selected.length > 0 && (
              <span className="ms-2">
                (<span className="fw-bold">{selected.length}</span> selected)
              </span>
            )}
          </div>
          
          <div className="d-flex align-items-center">
            <PaginationOptions />
            
            <div className="btn-group ms-3">
              <button
                onClick={handlePrevPage}
                disabled={currentPage === 1}
                className={`btn btn-outline-secondary ${style.pagination_button}`}
              >
                <i className="fa fa-chevron-left" />
              </button>
              
              <div className={`px-3 d-flex align-items-center ${style.page_number}`}>
                Page {currentPage} of {totalPages || 1}
              </div>
              
              <button
                onClick={handleNextPage}
                disabled={currentPage === totalPages || totalPages === 0}
                className={`btn btn-outline-secondary ${style.pagination_button}`}
              >
                <i className="fa fa-chevron-right" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default ActionTable;

/* Table Container */
.table-container {
  width: 100%;
  overflow-x: auto;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  margin-top: 20px;
  background-color: #ffffff;
}


/* Pagination Number */
.page_number {
  background: #ffffff;
  color: #269ccc;
  border-radius: 50px;
  padding: 6px 12px;
  font-size: 14px;
  border: 1px solid #269ccc;
}

.page_number:hover {
  background: #269ccc;
  color: #ffffff;
}

/* Status Column */
.status-column {
  padding: 5px 10px;
  border-radius: 16px;
  font-size: 13px;
}

.approve-status {
  background: #e8f7e7;
  color: #27ae60;
}

.initiate-status {
  background: #d0e7f5;
  color: #2980b9;
}

.pending-status {
  background: #fff3e0;
  color: #e67e22;
}

/* Search Container */
.search-container {
  margin-bottom: 20px;
  display: flex;
  justify-content: center;
}

.search-container input[type="text"] {
  width: 100%;
  max-width: 400px;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-size: 14px;
  outline: none;
  transition: border-color 0.3s ease;
}

.search-container input[type="text"]:focus {
  border-color: #269ccc;
}

/* Media Queries for Smaller Screens */
@media (max-width: 768px) {
  .table_header,
  .table_footer {
    padding: 12px;
  }

  .table_data {
    font-size: 12px;
    padding: 8px 12px;
  }

  .search-container input[type="text"] {
    width: 100%;
  }
}

/* Action Buttons */
.action_button {
  background: none;
  border: none;
  cursor: pointer;
}

.action_button img {
  width: 20px;
  height: 20px;
}

.action_button:disabled img {
  filter: grayscale(100%);
  opacity: 0.5;
}

.action_button:disabled {
  cursor: not-allowed;
}

/* Tooltip */
.tooltip {
  display: inline-block;
  position: relative;
}

.tooltip .tooltiptext {
  visibility: hidden;
  width: 120px;
  background-color: #555;
  color: #fff;
  text-align: center;
  border-radius: 6px;
  padding: 5px;
  position: absolute;
  z-index: 1;
  bottom: 125%;
  left: 50%;
  margin-left: -60px;
  opacity: 0;
  transition: opacity 0.3s;
}

.tooltip:hover .tooltiptext {
  visibility: visible;
  opacity: 1;
}

/* Sortable Header */
.sortable_header {
  cursor: pointer;
}

.sortable_header .table-arrow {
  margin-left: 5px;
}

/* Selection Info */
.selection_info {
  font-size: 14px;
  color: #34495e;
}

/* Pagination Buttons */
.pagination_button {
  background: none;
  border: none;
  color: #269ccc;
  font-size: 14px;
  cursor: pointer;
}

.pagination_button:disabled {
  color: #ccc;
  cursor: not-allowed;
}

.action_button:disabled img {
  filter: grayscale(100%);
  opacity: 0.5;
}

.action_button:disabled {
  cursor: not-allowed;
}

.table {
  width: 100%;
  border-collapse: collapse;
  background-color: #ffffff;
}

.table th,
.table td {
  padding: 12px 16px;
  text-align: left;
  border-bottom: 1px solid #ecf0f1;
  vertical-align: middle;
}

.table th {
  background: #269ccc;
  color: #ffffff;
  font-weight: 900;
  font-size: 18px;
}

.table_datarow {
  background-color: #f9f9f9;
  transition: background-color 0.3s ease;
}

.table_datarow:nth-child(even) {
  background-color: #ffffff;
}

.table_datarow:hover {
  background-color: #f1f8ff;
}

