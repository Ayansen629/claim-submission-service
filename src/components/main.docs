const onSubmit = useCallback(async () => {
  const isValid = await trigger();
  if (!isValid) {
    console.error("Validation failed");
    return false;
  }
  
  // Get all form values
  const formValues = getValues();
  
  // Create a clean version without individual entity fields
  const cleanFormData = {
    ...formValues,
    step2: {
      ...formValues.step2
    }
  };

  // Remove any individual entity fields that might exist
  if (formValues.claimType) {
    const prefix = formValues.claimType;
    Object.keys(formValues.step2).forEach(key => {
      if (key.startsWith(`${prefix}Name`) || key.startsWith(`${prefix}Address`)) {
        delete cleanFormData.step2[key];
      }
    });
  }

  return cleanFormData;
}, [trigger, getValues]);

useEffect(() => {
  if (formData) {
    const cleanFormData = { ...formData };
    
    // Remove individual entity fields if they exist
    if (formData.claimType) {
      const prefix = formData.claimType;
      Object.keys(formData.step2 || {}).forEach(key => {
        if (key.startsWith(`${prefix}Name`) || key.startsWith(`${prefix}Address`)) {
          delete cleanFormData.step2[key];
        }
      });
    }
    
    // Set the cleaned form data
    Object.keys(cleanFormData).forEach((key) => {
      setValue(key, cleanFormData[key]);
    });
    
    if (formData.claimType) {
      setSelectedClaimType(formData.claimType);
    }
  }
}, [formData, setValue]);
