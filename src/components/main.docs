{
  name: "companyRegistrationCertificate",
  label: t("vesselOwnerRegistration.Company Registration Certificate"),
  type: "file",
  colSize: 6,
  showIf: () => {
    const excludeCategories = ["INDIVIDUAL", "OTHERS"];
    return !excludeCategories.includes(formData.categoryOfOwner);
  },
},
