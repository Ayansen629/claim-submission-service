const VesselEquipmentForm = ({ formMethods, viewMode = false, editMode = false, registrationData, intialSurveyData }) => {
  const { t } = useTranslation();
  const { masterData } = useMasterData();
  
  const userRole = getFromLocalStorage("userRole");
  const isL3Officer = userRole === USER_ROLES.OFFICER_L3;
  const isFieldDisabled = viewMode;
  const isConditionDisabled = !intialSurveyData?.processActionMapResponce;

  const internalFormMethods = useForm({ mode: "onTouched" });
  const methods = formMethods || internalFormMethods;
  const { register, watch, setValue, formState: { errors }, control } = methods;

  const { fields: deckFields, append: appendDeck, remove: removeDeck } = useFieldArray({
    control,
    name: "deckSpaces"
  });

  const values = watch();
 
  const getEquipmentIcon = useMemo(() => {
    const iconMap = {
      "Fire Fighting Items": <FaFire className="me-2" style={{ color: "#2466BF" }} />,
      "Equipments": <FaCog className="me-2" style={{ color: "#2466BF" }} />,
      "Navigational Equipments": <FaCompass className="me-2" style={{ color: "#2466BF" }} />,
      "Life-Saving Equipment": <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />,
      "Machinery/Electrical": <FaBolt className="me-2" style={{ color: "#2466BF" }} />,
      "Accommodation/Safety": <FaHome className="me-2" style={{ color: "#2466BF" }} />
    };
    return (equipmentName) => iconMap[equipmentName] || <FaCog className="me-2" style={{ color: "#2466BF" }} />;
  }, []);

  const handleConditionChange = useCallback((fieldName, value) => {
    setValue(fieldName, value, { shouldValidate: true, shouldDirty: true });
  }, [setValue]);

  const handleAddDeck = useCallback(() => {
    appendDeck(initialEquipementData?.deckSpaces?.[0]);
  }, [appendDeck]);

  const handleRemoveDeck = useCallback((index) => {
    removeDeck(index);
  }, [removeDeck]);

  const equipmentTables = useMemo(() => {
    if (!masterData?.equipmentCategories) return null;
    console.log("changed");
    return masterData.equipmentCategories.map((equipment) => (
      <RenderDynamicEquipmentTable
        key={equipment.id}
        equipment={equipment}
        register={register}
        errors={errors}
        watch={watch}
        handleConditionChange={handleConditionChange}
        isFieldDisabled={isFieldDisabled}
        viewMode={viewMode}
        getEquipmentIcon={getEquipmentIcon}
        values={values}
        isConditionDisabled={isConditionDisabled}
      />
    ));
  }, [masterData?.equipmentCategories, register, errors, watch, handleConditionChange, isFieldDisabled, viewMode, getEquipmentIcon, values, isConditionDisabled]);

  const deckRows = useMemo(() => {
    return deckFields.map((deck, index) => (
      <DeckSpaceRow
        key={deck.id || index}
        index={index}
        register={register}
        errors={errors}
        isFieldDisabled={isFieldDisabled}
        handleRemoveDeck={handleRemoveDeck}
        deckFields={deckFields}
      />
    ));
  }, [deckFields, register, errors, isFieldDisabled, handleRemoveDeck]);

  return (
    <form autoComplete="off" className="vessel-equipment-form">
      <style>
        {`
          .vessel-equipment-form { overflow-anchor: none; }
          .table-container {
            max-height: 400px;
            overflow-y: auto;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
          }
          .equipment-table { margin-bottom: 0; }
          .equipment-table thead th {
            position: sticky;
            top: 0;
            background-color: #f8f9fa;
            z-index: 10;
            color: #2466BF;
            font-weight: 600;
          }
          .equipment-table td {
            min-width: 150px;
            vertical-align: middle;
            padding: 8px;
          }
          .equipment-table select, .equipment-table .form-select {
            min-width: 150px !important;
            width: 100% !important;
          }
          .deck-remove-btn {
            transition: all 0.2s ease;
            min-width: 100px;
          }
          .deck-remove-btn:hover { transform: scale(1.05); }
          .table-container::-webkit-scrollbar { width: 8px; height: 8px; }
          .table-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
          }
          .table-container::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 4px;
          }
          .table-container::-webkit-scrollbar-thumb:hover { background: #a8a8a8; }
        `}
      </style>
      
      {equipmentTables}

      <Collapsible
        title={
          <>
            <FaUsers className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Location of passengers on specific decks and spaces in maximum loaded condition")}</span>
          </>
        }
        openStat={true}
      >
        <div className="p-3">
          <div className="table-container">
            <Table striped bordered hover responsive className="mb-0">
              <thead>
                <tr>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Deck/Space Type")}</th>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Size")}</th>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Function")}</th>
                  <th style={{ fontWeight: "600", color: "#2466BF", minWidth: "200px" }}>{t("Max. No. of Passenger")}</th>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Remarks")}</th>
                  {deckFields?.length > 1 && !isFieldDisabled && (
                    <th style={{ fontWeight: "600", color: "#2466BF", minWidth: "150px" }}>{t("Actions")}</th>
                  )}
                </tr>
              </thead>
              <tbody>
                {deckRows}
              </tbody>
            </Table>
          </div>
          {!isFieldDisabled && (
            <Button
              variant="outline-primary"
              onClick={handleAddDeck}
              className="mt-3"
              type="button"
            >
              <FaPlus className="me-2" /> Add Deck/Space
            </Button>
          )}
        </div>
      </Collapsible>

      <Collapsible
        title={
          <>
            <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Freeboard")}</span>
          </>
        }
        openStat={true}
      >
        <div className="p-3">
          <Table striped bordered hover responsive className="mb-0">
            <thead>
              <tr>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Minimum freeboard")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Number of Passengers")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Cargo (Tonne)")}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <InputText
                    name={'freeboard.minFreeboard'}
                    placeholder={t('Enter Minimum Freeboard')}
                    register={register('freeboard.minFreeboard')}
                    errors={errors}
                    disabled={isFieldDisabled}
                  />
                </td>
                <td>
                  <InputText
                    name={'freeboard.numPassengers'}
                    type={"number"}
                    placeholder={t('Enter Number of Passengers')}
                    register={register('freeboard.numPassengers')}
                    errors={errors}
                    disabled={isFieldDisabled}
                  />
                </td>
                <td>
                  <InputText
                    name={'freeboard.cargo'}
                    placeholder={t('Enter Cargo (Tonne)')}
                    register={register('freeboard.cargo')}
                    errors={errors}
                    disabled={isFieldDisabled}
                  />
                </td>
              </tr>
            </tbody>
          </Table>
        </div>
      </Collapsible>

      {isL3Officer && (
        <Collapsible
          title={
            <>
              <FaFileContract className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Declaration of Survey")}</span>
            </>
          }
          openStat={true}
        >
          <DeclarationOfSurvey registrationData={registrationData} />
        </Collapsible>
      )}
    </form>
  );
};
