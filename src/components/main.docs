const onSubmit = async (data) => {
  try {
    loaderRef.current?.show();
    
    // Create a copy of existing files
    let updatedFiles = [];
    
    if (isEditMode && employeeData?.files) {
      updatedFiles = employeeData.files.map((file, index) => {
        // Create a base file object with all original properties
        const fileObj = {
          fileStoreId: file.fileStoreId,
          alfrescoId: file.alfrescoId,
          registrationNumber: file.registrationNumber,
          fileName: file.fileName,
          module: file.module,
          tenantId: file.tenantId,
          tag: file.tag,
          fieldName: file.fieldName,
          downLoadFile: file.downLoadFile
        };
        
        // Update fileName if a new file was selected
        if (index === 0 && addressProofFile) {
          fileObj.fileName = addressProofFile.name;
        } else if (index === 1 && identityProofFile) {
          fileObj.fileName = identityProofFile.name;
        } else if (index === 2 && appointmentLetterFile) {
          fileObj.fileName = appointmentLetterFile.name;
        }
        
        return fileObj;
      });
    }
    
    const uInfo = {
      userType: "EMPLOYEE",
      userBasicDetails: {},
      employeeDetails: {
        id: isEditMode ? employeeData?.id : "",
        firstName: data.firstName,
        lastName: data.lastName,
        emailId: data.email,
        phoneNumber: data.phoneNumber,
        addressLine1: data.addressLine1,
        addressLine2: data.addressLine2,
        pin: data.pin,
        district: data.district,
        state: data.stateUt,
        country: data.country,
        isActive: data?.isActive,
        dateOfBirth: data.dateOfBirth,
        gender: data.gender,
        appointmentDate: data.appointmentDate,
        employeeType: data.employeeType,
        employeeStatus: data.employeeStatus,
        designation: data.designation,
        department: data.department,
        section: data.section,
        roles: data.roles,
        educationDetails: data?.educationDetails?.map((ed) => ({
          uuid: isEditMode ? ed.uuid : "",
          qualification: ed.qualification,
          stream: ed.stream,
          yearOfPassing: ed.yearOfPassing,
        })),
        files: isEditMode ? updatedFiles : []
      },
    };

    const formData = new FormData();
    formData.append(
      "request",
      new Blob([JSON.stringify(uInfo)], {
        type: "application/json",
      })
    );

    // Append any new files that were selected
    [addressProofFile, identityProofFile, appointmentLetterFile].forEach(
      (file) => {
        if (file) {
          formData.append("files", file);
        }
      }
    );

    await submitEmpDetails(formData);
  } catch (error) {
    loaderRef.current?.hide();
    toast.error(
      error?.response?.data?.message ||
        "Error submitting form. Please try again."
    );
  }
};
