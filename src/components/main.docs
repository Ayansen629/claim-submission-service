import React, { useState } from "react";
import { Row, Col, Table } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { formatDate } from "../../../../../utils/constants.ts";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import styles from "../../../../common/styles/ProvisionalCertificateOfSurvey.module.css";

const ProvisionalCertificateOfSurvey = ({ registrationData, surveyData, preFilledCertData }) => {
  console.log("Pre-filled Certificate Data:", preFilledCertData);
  const { t } = useTranslation();

  const currentDate = new Date();
  const expiryDate = new Date(currentDate.getTime() + (60 * 24 * 60 * 60 * 1000));
  const certificateNo = `PCS/${new Date().getFullYear()}/${Math.floor(Math.random() * 10000).toString().padStart(4, '0')}`;

  // Editable fields state
  const [editableData, setEditableData] = useState({
    expiryDay: expiryDate.getDate().toString().padStart(2, '0'),
    expiryMonth: (expiryDate.getMonth() + 1).toString().padStart(2, '0'),
    expiryYear: expiryDate.getFullYear().toString(),
    certificateRegistryNo: '',
    loadingMarks: 'Yes',
    plyingLimits: '12',
    safetyEquipment: {
      boats: '',
      lifeRafts: '',
      lifebuoys: '',
      lifejackets: '',
      foamExtinguisher: '',
      sodaAcid: '',
      dryPowder: '',
      anchorCable: '',
      lengthSize: '',
      hose: ''
    }
  });

  const handleInputChange = (field, value) => {
    if (field.includes('.')) {
      const [parent, child] = field.split('.');
      setEditableData(prev => ({
        ...prev,
        [parent]: {
          ...prev[parent],
          [child]: value
        }
      }));
    } else {
      setEditableData(prev => ({
        ...prev,
        [field]: value
      }));
    }
  };

  return (
    <div className={styles.certificateBody}>
      {/* Basic Certificate Info */}
      <Row className="mb-3">
        <Col md={3}>
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Category")}:</span>
            <span className={styles.fieldValue}>{registrationData?.vessel?.category || "A"}</span>
          </div>
        </Col>
        <Col md={9}>
          <div className={styles.expirySection}>
            <span className={styles.fieldLabel}>{t("Expiry on or before the")}:</span>
            <div className={styles.dateFields}>
              <input
                type="text"
                className={styles.dateInput}
                value={editableData.expiryDay}
                onChange={(e) => handleInputChange('expiryDay', e.target.value)}
                maxLength="2"
                placeholder="DD"
              />
              <span>-</span>
              <input
                type="text"
                className={styles.dateInput}
                value={editableData.expiryMonth}
                onChange={(e) => handleInputChange('expiryMonth', e.target.value)}
                maxLength="2"
                placeholder="MM"
              />
              <span>-</span>
              <input
                type="text"
                className={styles.dateInput}
                value={editableData.expiryYear}
                onChange={(e) => handleInputChange('expiryYear', e.target.value)}
                maxLength="4"
                placeholder="YYYY"
              />
            </div>
          </div>
        </Col>
      </Row>

      <Row className="mb-3">
        <Col md={6}>
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Provisional Certificate of Survey No.")}:</span>
            <input
              type="text"
              className={styles.editableField}
              value={editableData.certificateRegistryNo}
              onChange={(e) => handleInputChange('certificateRegistryNo', e.target.value)}
              placeholder="Enter Certificate of Survey No."
            />
          </div>
        </Col>
        <Col md={6}>
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Zone of operation")}:</span>
            <span className={styles.fieldValue}>{registrationData?.vessel?.zone || "Zone 1"}</span>
          </div>
        </Col>
      </Row>

      <Row className="mb-4">
        <Col md={6}>
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Date of Issue")}:</span>
            <span className={styles.fieldValue}>{formatDate(currentDate)}</span>
          </div>
        </Col>
        <Col md={6}>
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Date of Expiry")}:</span>
            <span className={styles.fieldValue}>{formatDate(expiryDate)}</span>
          </div>
        </Col>
      </Row>

      <div className={styles.certificateStatement}>
        <p>{t("This Provisional Certificate of Survey has been issued subsequent to Survey carried out of the below detailed inland vessel.")}</p>
      </div>

      {/* Vessel Details */}
      <div className="vessel-details mb-4">
        <Row className="mb-2">
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Name of the Vessel")}:</span>
              <span className={styles.fieldValue}>{registrationData?.vessel?.vesselName || "N/A"}</span>
            </div>
          </Col>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Official No.")}:</span>
              <span className={styles.fieldValue}>{registrationData?.vessel?.registrationNo || "N/A"}</span>
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Port of Registry")}:</span>
              <span className={styles.fieldValue}>{registrationData?.vessel?.registry || "N/A"}</span>
            </div>
          </Col>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Certificate of Registry No.")}:</span>
              <input
                type="text"
                className={styles.editableField}
                value={editableData.certificateRegistryNo}
                onChange={(e) => handleInputChange('certificateRegistryNo', e.target.value)}
                placeholder="Enter Certificate No."
              />
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Gross Tonnage")}:</span>
              <span className={styles.fieldValue}>{registrationData?.vessel?.grt || "N/A"}</span>
            </div>
          </Col>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Registered Tonnage")}:</span>
              <span className={styles.fieldValue}>{surveyData?.basicVesselInfo?.netTonnage || "N/A"}</span>
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Freeboard Assigned")}:</span>
              <span className={styles.fieldValue}>{surveyData?.freeboard?.minFreeboard || "N/A"}</span>
            </div>
          </Col>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Loading marks placed on the vessel's side")}:</span>
              <select
                className={styles.editableField}
                value={editableData.loadingMarks}
                onChange={(e) => handleInputChange('loadingMarks', e.target.value)}
              >
                <option value="Yes">Yes</option>
                <option value="No">No</option>
              </select>
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Name of the Master")}:</span>
              <span className={styles.fieldValue}>{registrationData?.vessel?.nameOfMaster || "N/A"}</span>
            </div>
          </Col>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Master's COC Grade")}:</span>
              <span className={styles.fieldValue}>Grade II</span>
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("COC No.")}:</span>
              <span className={styles.fieldValue}>COC123456</span>
            </div>
          </Col>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Place of Issue")}:</span>
              <span className={styles.fieldValue}>{registrationData?.vessel?.placeOfBuild || "N/A"}</span>
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Name of the Engineer or Engine Driver")}:</span>
              <span className={styles.fieldValue}>Engineer Name</span>
            </div>
          </Col>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("COC Grade of the Engineer or Engine Driver")}:</span>
              <span className={styles.fieldValue}>Grade I</span>
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("COC No.")}:</span>
              <span className={styles.fieldValue}>ENG789012</span>
            </div>
          </Col>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Place of Issue")}:</span>
              <span className={styles.fieldValue}>{registrationData?.vessel?.placeOfBuild || "N/A"}</span>
            </div>
          </Col>
        </Row>

        <Row className="mb-2">
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Name of Owner")}:</span>
              <span className={styles.fieldValue}>{registrationData?.owner?.name || "N/A"}</span>
            </div>
          </Col>
          <Col md={6}>
            <div className={styles.infoField}>
              <span className={styles.fieldLabel}>{t("Address of Owner")}:</span>
              <span className={styles.fieldValue}>{registrationData?.owner?.address || "N/A"}</span>
            </div>
          </Col>
        </Row>
      </div>

      {/* Survey Details */}
      <Row className="mb-4">
        <Col md={6}>
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Date of Survey carried out")}:</span>
            <span className={styles.fieldValue}>{formatDate(currentDate)}</span>
          </div>
        </Col>
        <Col md={6}>
          <div className={styles.infoField}>
            <span className={styles.fieldLabel}>{t("Place of survey carried out")}:</span>
            <span className={styles.fieldValue}>{surveyData?.basicVesselInfo?.placeYardNo || "N/A"}</span>
          </div>
        </Col>
      </Row>

      {/* Plying Limits */}
      <div className="plying-limits mb-4">
        <h6 className={styles.sectionTitle}>{t("PLYING LIMITS (as applicable):")}</h6>
        <div className={styles.infoField}>
          <span className={styles.fieldLabel}>{t("Within inland waters limits")}:</span>
          <span className={styles.fieldValue}>{registrationData?.vessel?.zone || "Zone 1"}</span>
          <span className={styles.fieldLabel} style={{ marginLeft: '1rem' }}>{t("not extending beyond")}:</span>
          <input
            type="text"
            className={styles.editableField}
            value={editableData.plyingLimits}
            onChange={(e) => handleInputChange('plyingLimits', e.target.value)}
            style={{ width: '80px', margin: '0 0.5rem' }}
          />
          <span>{t("Nautical Miles from the nearest shore.")}</span>
        </div>
      </div>

      {/* Cargo/Passenger Capacity */}
      <div className="capacity-section mb-4">
        <h6 className={styles.sectionTitle}>{t("CARGO/PASSENGER CAPACITY")}</h6>
        <div className={styles.infoField}>
          <span className={styles.fieldLabel}>{t("Maximum permissible cargo carriage capacity")}:</span>
          <span className={styles.fieldValue}>{surveyData?.freeboard?.cargo || "N/A"}</span>
          <span className={styles.fieldLabel} style={{ marginLeft: '1rem' }}>{t("Passengers")}:</span>
          <span className={styles.fieldValue}>{surveyData?.freeboard?.numPassengers || "N/A"}</span>
          <span className={styles.fieldLabel} style={{ marginLeft: '1rem' }}>{t("Crew")}:</span>
          <span className={styles.fieldValue}>5</span>
        </div>
      </div>

      {/* Safety Equipment Table */}
      <div className="safety-equipment mb-4">
        <h6 className={styles.sectionTitle}>{t("Safety equipment carried on the vessel:")}</h6>
        <Table bordered className={styles.safetyTable}>
          <thead>
            <tr>
              <th>{t("No. of boats size and cubic capacity")}</th>
              <th>{t("No. of Buoyant apparatus or Life rafts")}</th>
              <th colSpan="2">{t("No. of Lifebuoys and lifejackets")}</th>
              <th colSpan="3">{t("Fire extinguishers")}</th>
              <th colSpan="3">{t("No. of Anchor with their weight")}</th>
            </tr>
            <tr>
              <th></th>
              <th></th>
              <th>{t("Lifebuoys")}</th>
              <th>{t("Lifejackets")}</th>
              <th>{t("Foam Type")}</th>
              <th>{t("Soda Acid")}</th>
              <th>{t("Dry Carbon Powder")}</th>
              <th>{t("Anchor Cable")}</th>
              <th>{t("Length Size")}</th>
              <th>{t("Hose")}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td className={styles.autoPopulateCell}>
                {editableData.safetyEquipment.boats || "Auto Populate"}
              </td>
              <td className={styles.autoPopulateCell}>
                {editableData.safetyEquipment.lifeRafts || "Auto Populate"}
              </td>
              <td className={styles.autoPopulateCell}>
                {editableData.safetyEquipment.lifebuoys || "Auto Populate"}
              </td>
              <td className={styles.autoPopulateCell}>
                {editableData.safetyEquipment.lifejackets || "Auto Populate"}
              </td>
              <td className={styles.autoPopulateCell}>
                {editableData.safetyEquipment.foamExtinguisher || "Auto Populate"}
              </td>
              <td className={styles.autoPopulateCell}>
                {editableData.safetyEquipment.sodaAcid || "Auto Populate"}
              </td>
              <td className={styles.autoPopulateCell}>
                {editableData.safetyEquipment.dryPowder || "Auto Populate"}
              </td>
              <td className={styles.autoPopulateCell}>
                {editableData.safetyEquipment.anchorCable || "Auto Populate"}
              </td>
              <td className={styles.autoPopulateCell}>
                {editableData.safetyEquipment.lengthSize || "Auto Populate"}
              </td>
              <td className={styles.autoPopulateCell}>
                {editableData.safetyEquipment.hose || "Auto Populate"}
              </td>
            </tr>
          </tbody>
        </Table>
      </div>

      {/* Certificate Statement */}
      <div className={styles.certificateStatement}>
        <p>
          <strong>{t("THIS IS TO CERTIFY")}</strong> {t("that the provisions of the rules with respect to the survey of the above mentioned Inland Vessel and the Transmission of declaration in respect thereof, have been complied with.")}
        </p>
      </div>

      <div className={styles.validityStatement}>
        <p>
          {t("This Provisional Certificate of Survey, issued under the provisions of section 13(1) of the Inland Vessels Act, 2021 continues to be in force only until the")} <strong>({editableData.expiryDay}-{editableData.expiryMonth}-{editableData.expiryYear})</strong>
        </p>
      </div>
    </div>
  );
};

