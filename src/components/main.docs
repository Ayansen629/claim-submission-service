const [isExistingUser, setIsExistingUser] = useState(false);
const [existingDocuments, setExistingDocuments] = useState([]);
case "select":
  return (
    <InputSelect
      label={field.label}
      required={field.required}
      name={field.name}
      options={field.options}
      register={register(field?.name, {
        ...field.validation,
      })}
      errors={errors}
      icon={field.icon}
      className="mb-3"
      onChange={(value, selObj) => {
        if (field?.name === "categoryOfOwner") {
          setIsCompany(selObj?.isCompany || false);
          const isIndividual = value?.toLowerCase()?.includes("indv") || "";
          setIsExemptCategory(!isIndividual);
          setValue(field.name, value);
          if (!isIndividual) {
            clearErrors(["panNo", "aadharNumber", "tradeLicenseNumber"]);
          } else {
            trigger(["panNo", "aadharNumber", "tradeLicenseNumber"]);
          }
          if (errors[field.name]) {
            clearErrors(field.name);
          }
          setFormData((prev) => ({
            ...prev,
            [field.name]: value,
          }));
        } else if (field?.name === "existingUser") {
          setIsExistingUser(value === "Y");
          setValue(field.name, value);
          if (value === "Y") {
            toast.info("You need to add existing documents", {
              position: "top-right",
            });
            // Add existing document fields
            setExistingDocuments([
              { id: 1, name: "existingDoc1", label: "Existing Document 1" },
              { id: 2, name: "existingDoc2", label: "Existing Document 2" },
              { id: 3, name: "existingDoc3", label: "Existing Document 3" },
            ]);
          } else {
            setExistingDocuments([]);
          }
          setFormData((prev) => ({
            ...prev,
            [field.name]: value,
          }));
        } else {
          setValue(field.name, value);
          if (errors[field.name]) clearErrors(field.name);
          setFormData((prev) => ({
            ...prev,
            [field.name]: value,
          }));
        }
      }}
      value={formData[field.name] || watch(field.name)}
      autoFocus={field.autoFocus}
    />
  );
