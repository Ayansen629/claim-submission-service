                type="number"
                placeholder={t("Enter Frame Thickness (mm)")}
                register={register("hullParticulars.frameThickness")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Floor Material")}
                name="hullParticulars.floorMaterial"
