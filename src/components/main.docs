import React, { useState } from "react";
import { Row, Col, Table } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { formatDate } from "../../../../../utils/constants.ts";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import styles from "./ProvisionalCertificateOfRegistration.module.css";

const ProvisionalCertificateOfRegistration = ({ registrationData, surveyData }) => {
  const { t } = useTranslation();
  
  const currentDate = new Date();
  const expiryDate = new Date(currentDate.getTime() + (365 * 24 * 60 * 60 * 1000));

  // Editable fields state
  const [editableData, setEditableData] = useState({
    expiryDate: formatDate(expiryDate),
    lengthEngineRoom: '8m',
    numberOfDeck: '1',
    stern: 'Transom',
    numberOfCrew: '5'
  });

  const handleInputChange = (field, value) => {
    setEditableData(prev => ({
      ...prev,
      [field]: value
    }));
  };

  return (
    <div className={styles.registrationCertificateContainer}>
      <div className={styles.certificateHeader}>
        <h4 className={styles.certificateTitle}>{t("PROVISIONAL CERTIFICATE OF REGISTRATION")}</h4>
      </div>

      <div className={styles.certificateBody}>
        {/* Expiry Date */}
        <div className={styles.expirySection}>
          <span className={styles.expiryLabel}>
            {t("Expiry on or before the")}
            <input
              type="date"
              className={styles.editableDate}
              value={editableData.expiryDate}
              onChange={(e) => handleInputChange('expiryDate', e.target.value)}
            />
          </span>
        </div>

        {/* Issued By */}
        <div className={styles.issuedBySection}>
          <span className={styles.issuedLabel}>{t("Issued by")} ({t("IWT Authority")})</span>
        </div>

        {/* Particulars of Vessel */}
        <div className="vessel-particulars mb-4">
          <h5 className={styles.sectionTitle}>{t("PARTICULARS OF VESSEL")}</h5>
          
          <Table bordered className={styles.particularsTable}>
            <tbody>
              <tr>
                <td className={styles.labelCell}>{t("Official Number")}</td>
                <td className={styles.autoPopulateCell}>
                  {registrationData?.vessel?.registrationNo || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Registration Date")}</td>
                <td className={styles.editableCell}>
                  <input
                    type="date"
                    defaultValue={formatDate(currentDate)}
                  />
                </td>
                <td className={styles.labelCell}>{t("Name of the Vessel")}</td>
                <td className={styles.autoPopulateCell}>
                  {registrationData?.vessel?.vesselName || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Port of Registry")}</td>
                <td className={styles.autoPopulateCell}>
                  {registrationData?.vessel?.registry || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Previous Registration No.")}</td>
                <td className={styles.editableCell}>
                  <input type="text" placeholder="Enter if any" />
                </td>
                <td className={styles.labelCell}>{t("Date of Previous Registry")}</td>
                <td className={styles.editableCell}>
                  <input type="date" />
                </td>
                <td className={styles.labelCell}>{t("Port of Previous Registry")}</td>
                <td className={styles.editableCell}>
                  <input type="text" placeholder="Enter if any" />
                </td>
                <td className={styles.labelCell}>{t("Name of Builder")}</td>
                <td className={styles.autoPopulateCell}>
                  {registrationData?.builder?.name || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Address of Builder")}</td>
                <td className={styles.autoPopulateCell}>
                  {registrationData?.builder?.address || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Where Built")}</td>
                <td className={styles.autoPopulateCell}>
                  {registrationData?.vessel?.placeOfBuild || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Propulsion Type")}</td>
                <td className={styles.autoPopulateCell}>
                  {registrationData?.engine?.type || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Number of Deck")}</td>
                <td className={styles.autoPopulateCell}>
                  {editableData.numberOfDeck}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Material Description")}</td>
                <td className={styles.autoPopulateCell}>
                  {surveyData?.hullParticulars?.hullMaterial || "Steel"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Number of Bulkheads")}</td>
                <td className={styles.autoPopulateCell}>
                  {surveyData?.hullParticulars?.numberOfBulkheads || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Stern")}</td>
                <td className={styles.autoPopulateCell}>
                  {editableData.stern}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Build")}</td>
                <td className={styles.editableCell}>
                  <input
                    type="text"
                    defaultValue={registrationData?.vessel?.yearOfBuild || ""}
                    placeholder="Year"
                  />
                </td>
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Length")}</td>
                <td className={styles.autoPopulateCell}>
                  {surveyData?.basicVesselInfo?.lengthOfVessel || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Breadth")}</td>
                <td className={styles.autoPopulateCell}>
                  {surveyData?.basicVesselInfo?.breadthOfVessel || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Depth")}</td>
                <td className={styles.autoPopulateCell}>
                  {surveyData?.basicVesselInfo?.depthOfVessel || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Draft")}</td>
                <td className={styles.autoPopulateCell}>
                  {surveyData?.basicVesselInfo?.draft || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Length of the Engine Room")}</td>
                <td className={styles.editableCell}>
                  <input
                    type="text"
                    value={editableData.lengthEngineRoom}
                    onChange={(e) => handleInputChange('lengthEngineRoom', e.target.value)}
                  />
                </td>
                <td className={styles.labelCell}>{t("GROSS TONNAGE")}</td>
                <td className={styles.autoPopulateCell}>
                  {registrationData?.vessel?.grt || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("NET TONNAGE")}</td>
                <td className={styles.autoPopulateCell}>
                  {surveyData?.basicVesselInfo?.netTonnage || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Number of crew")}</td>
                <td className={styles.autoPopulateCell}>
                  {editableData.numberOfCrew}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Number of Engines:")}</td>
                <td className={styles.autoPopulateCell}>
                  {surveyData?.detailsOfPropulsion?.numberOfEngine || "1"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Combined Power")}</td>
                <td className={styles.autoPopulateCell}>
                  {registrationData?.engine?.horsepower || "N/A"} HP
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Name of Engine Maker")}</td>
                <td className={styles.autoPopulateCell}>
                  {registrationData?.engine?.make || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.labelCell}>{t("Address of Engine Maker")}</td>
                <td className={styles.autoPopulateCell}>
                  {registrationData?.engine?.makerAddress || "N/A"}
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
              </tr>
            </tbody>
          </Table>
        </div>

        {/* Survey Certificate Note */}
        <div className={styles.surveyNote}>
          <p className={styles.noteText}>
            {t("A detailed summary of the tonnages for this vessel is shown on the Certificate of Survey")}
          </p>
        </div>

        {/* Crew Accommodation */}
        <div className={styles.crewSection}>
          <div className={styles.crewInfo}>
            <span className={styles.crewLabel}>{t("The Number of crew for whom accommodation is certified")}</span>
            <span className={styles.crewValue}>
              {editableData.numberOfCrew}
              <span className={styles.autoPopulateTag}>Auto Populate</span>
            </span>
          </div>
        </div>

        {/* Certification Statement */}
        <div className={styles.certificationStatement}>
          <p className={styles.statementText}>
            {t("I, the undersigned, Registering Authority at the Port of")} <strong>{registrationData?.vessel?.registry || "N/A"}</strong> {t("in")} <strong>West Bengal</strong> {t("here by certify that the Inland Vessel the Description of which is prefixed to this Provisional certificate, has been duly surveyed, and that the above Description is true; that")} <strong>{registrationData?.vessel?.nameOfMaster || "N/A"}</strong> {t("whose Certificate of Competency of Service is No")} <strong>COC123456</strong>, {t("is the Master of the said Vessel, and that the Name")} <strong>{registrationData?.owner?.name || "N/A"}</strong> {t("Residence of")} <strong>{registrationData?.owner?.address || "N/A"}</strong>, {t("owner of")} <strong>{registrationData?.vessel?.vesselName || "N/A"}</strong>, {t("Number of Tenth Shares Held by are as follows")} :-
          </p>
        </div>

        {/* Owner Details Table */}
        <div className="owner-details">
          <Table bordered className={styles.ownerTable}>
            <thead>
              <tr>
                <th className={styles.ownerHeader}>{t("Name Residence and Occupation of the Owner")}</th>
                <th className={styles.sharesHeader}>{t("Number of Tenth Shares")}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td className={styles.ownerInfo}>
                  <div><strong>{t("Name")}:</strong> {registrationData?.owner?.name || "N/A"}</div>
                  <div><strong>{t("Residence")}:</strong> {registrationData?.owner?.address || "N/A"}</div>
                  <div><strong>{t("Occupation")}:</strong> {registrationData?.other?.occupation || "Business"}</div>
                  <span className={styles.autoPopulateTag}>Auto Populate</span>
                </td>
                <td className={styles.sharesValue}>10/10</td>
              </tr>
            </tbody>
          </Table>
        </div>
      </div>
    </div>
  );
};

export default ProvisionalCertificateOfRegistration;
