                <span>✓</span>
              ) : (
                index + 1
              )}
            </div>
            <div className="step-name">{step.name}</div>
          </div>
        ))}

        <div
          className="progress-bar"
          style={{
            marginLeft: margins.marginLeft,
            marginRight: margins.marginRight,
          }}
        >
          <div
            className="progress"
            style={{ width: `${calculateProgressBarWidth()}%` }}
          ></div>
        </div>
      </div>

      {ActiveComponent && (
        <ActiveComponent
          formData={formData[`step${currentStep}`] || {}}
          provideSubmitHandler={updateSubmitHandler}
          // setFormData={setFormData}
          setFormData={(newStepData) => {
            setFormData(prev => ({
              ...prev,
              [`step${currentStep}`]: newStepData
            }));
          }}
          isEditMode={isEditMode}
        />
      )}

      {shouldRenderReviewStep && !isCRPUser && (
        <ReviewStep />
      )}

      {currentStep === filteredStepsConfig.length && !isCRPUser && (
        <div className="confirmation-container">
          <Form.Group controlId="formConfirmation" className="mt-3 confirmation-checkbox">
            <Form.Check
              type="checkbox"
              label="I confirm that the information provided is correct."
              checked={isConfirmed}
              onChange={(e) => setIsConfirmed(e.target.checked)}
            />
          </Form.Group>
        </div>
      )}

      <div className="stepper-buttons">
        {currentStep > 1 && (
          <button className="buttonplus previous-button" onClick={handlePrevious}>
            Previous
          </button>
        )}
        {currentStep === 1 && (
          <button className="buttonplus cancel-button" onClick={handleCancel}>
            Cancel
          </button>
        )}

        {currentStep === 4 && !isCRPUser && (
          <div className="last-step-buttons">
            {/* <button
              className="buttonplus draft-button"
              onClick={handleSaveDraft}
              disabled={isSavingDraft}
            >
              {isSavingDraft ? "Saving..." : "Save as Draft"}
            </button> */}
            

<button
className="buttonplus preview-button"
onClick={handlePreview}
// disabled={!hasPreviewed }
>
Preview
</button>

            

           
          </div>
        )}

        {currentStep !== 4 && currentStep !== filteredStepsConfig.length && (
          <button
            className="buttonplus next-button"
            onClick={handleNext}
            disabled={isComplete}
          >
            Save & Next
          </button>
        )}

        {currentStep === filteredStepsConfig.length && isCRPUser ? (
          <>
            <button
              className="buttonplus sendback-button"
              onClick={() => handleActionClick("Sendback To Claimants")}
            >
              Sendback To Claimants
            </button>
            <button
              className="buttonplus accept-contingent-button"
              onClick={() => handleActionClick("Accept as Contingent")}
            >
              Accept as Contingent
            </button>
            <button
              className="buttonplus accept-button"
              onClick={() => handleActionClick("Accept")}
            >
              Accept
            </button>
            <button
              className="buttonplus reject-button"
              onClick={() => handleActionClick("Reject")}
            >
              Reject
            </button>
          </>
        ) : currentStep === filteredStepsConfig.length ? (
          <button
            className="buttonplus next-button"
            onClick={handleNext}
            disabled={!isConfirmed || isComplete}
          >
            Submit
          </button>
        ) : null}
      </div>

      <Modal show={showModal} onHide={handleModalClose} centered>
        <Modal.Header closeButton>
          <Modal.Title>{actionType} Form</Modal.Title>
        </Modal.Header>
        <Modal.Body>
          <Form>
            <Form.Group controlId="comments">
              <Form.Label>Comments</Form.Label>
              <Form.Control
                as="textarea"
                rows={3}
                value={comments}
                onChange={(e) => setComments(e.target.value)}
                placeholder="Enter your comments..."
              />
            </Form.Group>
          </Form>
        </Modal.Body>
        <Modal.Footer>
          <Button className="modal-close-button" onClick={handleModalClose}>
            Close
          </Button>
          <Button
            className="modal-submit-button"
            onClick={handleActionSubmit}
            disabled={!comments.trim()}
          >
            Submit
          </Button>
        </Modal.Footer>
      </Modal>
    </FormDataProvider>
  );
};

export default Stepper;
