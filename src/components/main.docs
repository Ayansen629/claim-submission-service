/* Main modal styling */
.appointment-modal .modal-content {
  border-radius: 12px;
  overflow: hidden;
  border: none;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

/* Slots grid layout */
.slots-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 15px;
  max-height: 60vh;
  overflow-y: auto;
  padding: 10px 5px;
}

/* Slot card styling */
.slot-card {
  position: relative;
  padding: 15px;
  border-radius: 10px;
  background: white;
  border: 1px solid #e0e0e0;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.slot-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
  border-color: #86b7fe;
}

.slot-card.selected {
  background: #f0f7ff;
  border: 2px solid #0d6efd;
  box-shadow: 0 5px 15px rgba(13, 110, 253, 0.2);
}

/* Slot content styling */
.slot-day {
  font-size: 14px;
  font-weight: 600;
  color: #6c757d;
  margin-bottom: 5px;
}

.slot-date {
  font-size: 16px;
  font-weight: 700;
  color: #212529;
  margin-bottom: 8px;
}

.slot-time {
  font-size: 15px;
  font-weight: 500;
  color: #495057;
  padding: 6px 0;
  border-top: 1px dashed #e9ecef;
}

/* Selected badge */
.selected-badge {
  position: absolute;
  top: -8px;
  right: -8px;
  background: white;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
}

.selected-badge i {
  color: #0d6efd;
  font-size: 16px;
}

/* Custom scrollbar */
.slots-grid::-webkit-scrollbar {
  width: 8px;
}

.slots-grid::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 10px;
}

.slots-grid::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 10px;
}

.slots-grid::-webkit-scrollbar-thumb:hover {
  background: #a8a8a8;
}

/* Confirm button */
.confirm-btn {
  min-width: 180px;
  padding: 10px 20px;
  font-weight: 600;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .slots-grid {
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }
  
  .slot-card {
    padding: 12px;
  }
}
