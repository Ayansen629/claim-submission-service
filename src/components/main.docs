const validateStep = async () => {
  const currentFields = getCurrentStepFields();
  const currentValues = getValues();
  
  // Trigger validation for all fields in the current step
  const isValid = await trigger(currentFields.map(field => field.name));
  
  // Additional manual validation for file fields
  const fileFields = currentFields.filter(field => field.type === 'file' && field.required);
  
  for (const field of fileFields) {
    const file = currentValues[field.name];
    
    if (!file) {
      setError(field.name, {
        type: 'required',
        message: `${field.label} is required`
      });
      return false;
    }
    
    // Validate file type
    const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
    if (!validTypes.includes(file.type)) {
      setError(field.name, {
        type: 'fileType',
        message: 'Only PDF, JPG or PNG files are allowed'
      });
      return false;
    }
    
    // Validate file size
    if (file.size > 2 * 1024 * 1024) {
      setError(field.name, {
        type: 'fileSize',
        message: 'File size should not exceed 2MB'
      });
      return false;
    }
    
    // If we get here, the file is valid - clear any errors
    if (errors[field.name]) {
      clearErrors(field.name);
    }
  }
  
  return isValid;
};
