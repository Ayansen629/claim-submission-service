const validateDocuments = async () => {
  if (isViewMode) return true;

  const grossTonnage = getValues("grt");
  let hasErrors = false;

  // Only validate in edit mode
  if (isEditMode) {
    // Check tonnage booklets requirement
    const tonnageBooklets = getValues("tonnageBooklets");
    const tonnageHasFileId = tonnageBooklets?.id;
    const hasGrtValue = grossTonnage && grossTonnage.trim() !== "";
    const isTonnageRequired = !!(tonnageHasFileId || hasGrtValue);

    if (isTonnageRequired && !tonnageBooklets) {
      setError("tonnageBooklets", {
        type: "required",
        message: t("Tonnage Booklets is required"),
      });
      hasErrors = true;
    }

    // Check stability booklets requirement
    const stabilityBooklets = getValues("stabilityBooklets");
    const stabilityHasFileId = stabilityBooklets?.id;
    const isStabilityRequired = !!(stabilityHasFileId || hasGrtValue);

    if (isStabilityRequired && !stabilityBooklets) {
      setError("stabilityBooklets", {
        type: "required",
        message: t("Stability Booklets is required"),
      });
      hasErrors = true;
    }

    // Force trigger validation for edit mode
    await trigger(["tonnageBooklets", "stabilityBooklets"]);
  }

  // Terms acceptance is always required
  const termsAccepted = getValues("termsAccepted");
  if (!termsAccepted) {
    setError("termsAccepted", {
      type: "required",
      message: t("You must accept the terms and conditions"),
    });
    hasErrors = true;
  }

  await trigger(["termsAccepted"]);
  return !hasErrors;
};

// Update the steps configuration
const steps = isViewMode
  ? [
      {
        label: t("Vessel Details"),
        component: (
          <VesselDetails
            formMethods={methods}
            viewMode={isViewMode}
            editMode={isEditMode}
          />
        ),
        validate: validateVesselDetails,
      },
      {
        label: t("Documents"),
        component: (
          <Documents
            formMethods={methods}
            viewMode={isViewMode}
            editMode={isEditMode}
            id={id}
          />
        ),
        validate: validateDocuments,
      },
      {
        label: t("Payment Details"),
        component: (
          <PaymentDetailsView
            supervisionAuthority={supervisionAuthority}
            formData={methods.getValues()}
          />
        ),
        validate: () => true,
      },
    ]
  : [
      {
        label: t("vesselDetails.Vessel Details"),
        component: (
          <VesselDetails
            formMethods={methods}
            viewMode={isViewMode}
            editMode={isEditMode}
          />
        ),
        validate: validateVesselDetails,
        getFormData: () => methods?.getValues(),
      },
      {
        label: t("vesselDetails.Documents"),
        component: (
          <Documents
            formMethods={methods}
            viewMode={isViewMode}
            editMode={isEditMode}
            id={id}
          />
        ),
        validate: validateDocuments,
        getFormData: () => methods?.getValues(),
        // Remove goToNextStepNoValidtion for proper validation in edit mode
      },
      {
        label: t("vesselDetails.Invoicing"),
        component: (
          <Invoicing
            supervisionAuthority={supervisionAuthority}
            onPayNow={handlePayNow}
          />
        ),
        validate: () => true,
      },
    ];
