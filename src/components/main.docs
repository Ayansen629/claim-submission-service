// Add this state after existing states
const [showAppointmentMessage, setShowAppointmentMessage] = useState(false);

// Update the handleActionClick function
const handleActionClick = (action) => {
  if (action?.actionName === "Generate CMN") {
    setShowCmnStepper(true);

    const originalActions =
      registrationData?.processActionMapResponce?.[0]?.processs?.[0]
        ?.actions || [];

    const updatedActions = originalActions.filter(
      (item) => item.actionName !== "Generate CMN"
    );

    setActionsFromAPI(updatedActions);
    toast.success(
      "CMN Generated successfully. Please proceed with the next step."
    );
    return;
  }

  // Check if appointments need to be proposed first
  if (showCmnStepper && 
      (!registrationData?.appointmentSlots || registrationData.appointmentSlots.length === 0) &&
      isOfficer) {
    setShowAppointmentMessage(true);
    toast.warning("Please propose appointment slots before taking any action.");
    return;
  }

  setSelectedAction(action);
  setShowApprovalModal(true);
};

// Update the actionDropdown condition
const actionDropdown =
  isViewMode && isOfficerLogin && actionsFromAPI.length > 0 ? (
    <ActionDropdown
      actions={actionsFromAPI}
      onActionClick={handleActionClick}
      variant="contained"
      disabled={showAppointmentMessage}
      sx={{
        backgroundColor: showAppointmentMessage ? "#ccc" : "#2E57A7",
        fontWeight: "bold",
        borderRadius: "0.5rem",
        minWidth: "8rem",
        fontSize: "0.9rem",
        color: "#fff",
        "&:hover": {
          backgroundColor: showAppointmentMessage ? "#ccc" : "#1f4ea0",
        },
      }}
    />
  ) : null;
