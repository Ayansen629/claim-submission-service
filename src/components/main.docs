// Update the InputSelect usage in VesselDetails to include setValue and clearErrors:
<InputSelect
  label="Type of Vessel"
  name="vesselType"
  required
  options={[
    { value: "new", label: "New Vessel" },
    { value: "old", label: "Old Vessel" },
  ]}
  register={register}
  errors={errors}
  defaultValue={""}
  setValue={setValue}
  clearErrors={clearErrors}
/>

// Add padding to Documents collapsible content:
<Collapsible title="Documents" openStat={true}>
  <div style={{ padding: "1rem" }}>
    <Row className="gy-4">
      {/* Work Order & Drawings in one row */}
      <Col md={6}>
        <MultipleFileUpload
          title="Work Order"
          required={false}
          register={register}
          errors={errors}
          setValue={setValue}
          clearErrors={clearErrors}
          watch={watch}
        />
      </Col>
      <Col md={6}>
        <MultipleFileUpload
          title="Drawings"
          required={false}
          register={register}
          errors={errors}
          setValue={setValue}
          clearErrors={clearErrors}
          watch={watch}
        />
      </Col>
    </Row>
    <Row className="gy-4 mt-2">
      {/* Tonnage Booklets & Stability Booklets in one row */}
      <Col md={6}>
        <InputFile
          label="Tonnage Booklets"
          name="tonnageBooklets"
          register={register("tonnageBooklets")}
          errors={errors}
          value={tonnageBooklets?.[0]}
          onChange={e => {
            setValue("tonnageBooklets", e.target.files);
            clearErrors("tonnageBooklets");
          }}
        />
      </Col>
      <Col md={6}>
        <InputFile
          label="Stability Booklets"
          name="stabilityBooklets"
          register={register("stabilityBooklets")}
          errors={errors}
          value={stabilityBooklets?.[0]}
          onChange={e => {
            setValue("stabilityBooklets", e.target.files);
            clearErrors("stabilityBooklets");
          }}
        />
      </Col>
    </Row>
  </div>
</Collapsible>

// Fix Declaration section layout:
<Collapsible title="Declaration" openStat={true}>
  <div style={{ padding: "1rem" }}>
    <Form.Group className="mb-0">
      <div className="d-flex align-items-start">
        <Form.Check
          type="checkbox"
          id="termsAccepted"
          className="me-2 mt-1"
          {...register("termsAccepted", {
            required: "You must accept the terms and conditions",
          })}
          isInvalid={!!errors.termsAccepted}
          onChange={() => clearErrors("termsAccepted")}
        />
        <Form.Label
          htmlFor="termsAccepted"
          className="mb-0"
          style={{ fontWeight: 500, color: "#333", cursor: "pointer" }}
        >
          I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.
        </Form.Label>
      </div>
      {errors.termsAccepted && (
        <div className="text-danger small mt-2">
          {errors.termsAccepted.message}
        </div>
      )}
    </Form.Group>
  </div>
</Collapsible>
