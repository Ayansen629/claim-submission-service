/* ApplicationDetailsView.css - Professional Design */
:root {
  --primary-color: #00ggcc;
  --primary-dark: #076C75;
  --secondary-color: #09828D;
  --text-color: #333;
  --light-gray: #f9f9f9;
  --medium-gray: #e0e0e0;
  --dark-gray: #777;
  --white: #ffffff;
  --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  --border-radius: 8px;
  --transition: all 0.3s ease;
}

.application-details-modal .modal-content {
  border-radius: var(--border-radius);
  border: none;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  overflow: hidden;
}

.application-details-modal .modal-header {
  background: linear-gradient(to right, var(--primary-color), var(--primary-dark));
  color: var(--white);
  border-bottom: none;
  padding: 1.25rem 1.5rem;
}

.application-details-modal .modal-title {
  font-weight: 600;
  font-size: 1.25rem;
  display: flex;
  align-items: center;
}

.application-details-modal .modal-title-icon {
  margin-right: 0.75rem;
  font-size: 1.25rem;
}

.application-details-modal .modal-body {
  padding: 1.5rem;
}

.application-details-modal .modal-footer {
  border-top: 1px solid var(--medium-gray);
  padding: 1.25rem 1.5rem;
}

.application-details-modal .close-button {
  color: var(--white);
  opacity: 0.8;
  transition: var(--transition);
}

.application-details-modal .close-button:hover {
  opacity: 1;
  transform: scale(1.1);
}

.application-header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  padding: 1rem;
  background: var(--white);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow);
}

.application-number-container {
  display: flex;
  align-items: center;
}

.application-number-label {
  font-weight: 600;
  font-size: 1.1rem;
  margin-right: 0.75rem;
  color: var(--text-color);
}

.application-number-value {
  background: linear-gradient(to right, var(--primary-color), var(--primary-dark));
  color: var(--white);
  padding: 0.5rem 1rem;
  border-radius: 4px;
  font-weight: 600;
  font-size: 1rem;
  box-shadow: 0 2px 4px rgba(38, 156, 204, 0.2);
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(to right, var(--primary-color), var(--primary-dark));
  color: var(--white);
  border: none;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  cursor: pointer;
  transition: var(--transition);
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.action-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}

.action-button:active {
  transform: translateY(0);
}

.details-card {
  background-color: var(--white);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow);
  margin-bottom: 1.5rem;
  overflow: hidden;
  transition: var(--transition);
}

.details-card:hover {
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
}

.details-card-header {
  padding: 1rem 1.5rem;
  background-color: var(--light-gray);
  border-bottom: 1px solid var(--medium-gray);
}

.details-card-title {
  margin: 0;
  font-weight: 600;
  color: var(--primary-color);
  font-size: 1.1rem;
  display: flex;
  align-items: center;
}

.details-card-title-icon {
  margin-right: 0.75rem;
  color: var(--primary-color);
}

.details-card-body {
  padding: 1.5rem;
}

.document-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  margin-bottom: 1.5rem;
}

.document-table th,
.document-table td {
  padding: 0.75rem 1rem;
  text-align: left;
  vertical-align: middle;
}

.document-table th {
  background-color: var(--light-gray);
  font-weight: 600;
  color: var(--text-color);
  border-bottom: 2px solid var(--primary-color);
}

.document-table tr {
  transition: var(--transition);
}

.document-table tr:nth-child(even) {
  background-color: var(--light-gray);
}

.document-table tr:hover {
  background-color: rgba(38, 156, 204, 0.05);
}

.document-name {
  display: flex;
  align-items: center;
}

.document-icon {
  margin-right: 0.75rem;
  color: #e74c3c;
  font-size: 1.1rem;
}

.download-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--white);
  color: var(--primary-color);
  border: 1px solid var(--primary-color);
  border-radius: 4px;
  padding: 0.5rem 1rem;
  font-weight: 500;
  font-size: 0.9rem;
  cursor: pointer;
  transition: var(--transition);
  width: 100%;
}

.download-button:hover {
  background-color: var(--primary-color);
  color: var(--white);
  transform: translateY(-2px);
  box-shadow: 0 2px 5px rgba(38, 156, 204, 0.2);
}

.download-button:active {
  transform: translateY(0);
}

.download-icon {
  margin-right: 0.5rem;
}

/* Document modal styles */
.document-modal {
  position: fixed;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1050;
}

.document-modal-content {
  background-color: var(--white);
  padding: 2rem;
  border-radius: var(--border-radius);
  min-width: 600px;
  max-width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.document-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--medium-gray);
}

.document-modal-title {
  margin: 0;
  font-weight: 600;
  font-size: 1.5rem;
  color: var(--text-color);
}

.document-modal-close {
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: var(--dark-gray);
  transition: var(--transition);
}

.document-modal-close:hover {
  color: var(--text-color);
  transform: scale(1.1);
}

.document-modal-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid var(--medium-gray);
}

/* Responsive adjustments */
@media (max-width: 991.98px) {
  .application-header-container {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .application-number-container {
    margin-bottom: 1rem;
  }
  
  .document-modal-content {
    min-width: 90%;
  }
}

@media (max-width: 767.98px) {
  .application-number-label {
    font-size: 1rem;
  }
  
  .application-number-value {
    font-size: 0.9rem;
    padding: 0.4rem 0.8rem;
  }
  
  .details-card-header {
    padding: 0.75rem 1rem;
  }
  
  .details-card-title {
    font-size: 1rem;
  }
  
  .details-card-body {
    padding: 1rem;
  }
  
  .document-table th,
  .document-table td {
    padding: 0.6rem 0.8rem;
  }
}

@media (max-width: 575.98px) {
  .application-header-container {
    padding: 0.75rem;
  }
  
  .application-number-label {
    font-size: 0.9rem;
  }
  
  .application-number-value {
    font-size: 0.8rem;
    padding: 0.3rem 0.6rem;
  }
  
  .action-button {
    width: 36px;
    height: 36px;
  }
  
  .details-card-header {
    padding: 0.6rem 0.8rem;
  }
  
  .details-card-title {
    font-size: 0.9rem;
  }
  
  .details-card-body {
    padding: 0.8rem;
  }
  
  .document-table th,
  .document-table td {
    padding: 0.5rem 0.6rem;
    font-size: 0.85rem;
  }
  
  .download-button {
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
  }
}
