                placeholder={!viewMode ? t("Enter Speed/RPM") : ""}
                register={register("engineDetails.speed")}
                errors={errors}
                disabled={viewMode}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Stroke (Engine)")}
