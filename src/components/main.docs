const VesselEquipmentForm = ({ formMethods, viewMode = false, editMode = false, registrationData }) => {
  // ... existing code ...

  const isConditionDisabled = !intialSurveyData?.processActionMapResponce;

  // ... existing code ...

  return (
    <form autoComplete="off" className="vessel-equipment-form">
      {/* ... existing code ... */}
      
      {viewMode && (
        <>
          <td>
            <InputSelect
              name={`${fieldName}.condition`}
              options={conditionOptions}
              value={watch(`${fieldName}.condition`)}
              register={register(`${fieldName}.condition`)}
              onChange={(value) => handleConditionChange(`${fieldName}.condition`, value)}
              errors={errors}
              disabled={isConditionDisabled}
            />
          </td>
          <td>
            <textarea
              {...register(`${fieldName}.remarks`)}
              placeholder="Enter remarks"
              disabled={isConditionDisabled}
              style={{
                width: "100%",
                minHeight: "60px",
                padding: "8px",
                border: "1px solid #ced4da",
                borderRadius: "4px",
                resize: "vertical",
                fontSize: "14px"
              }}
            />
          </td>
        </>
      )}
    </form>
  );
};
