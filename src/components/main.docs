/* Mobile responsiveness for hero section */
@media (max-width: 768px) {
  .heroSection {
    height: 80vh;
  }

  .brandName {
    font-size: 18px;
    line-height: 24px;
    text-align: center;
  }

  .homeLoginBtn {
    position: static;
    right: auto;
    top: auto;
    margin: 1rem auto 0;
    display: block;
    width: fit-content;
  }

  .navLinkItems {
    font-size: 14px;
    padding: 0.25rem 0.5rem !important;
  }
}

@media (max-width: 576px) {
  .heroSection {
    height: 70vh;
  }

  .brandName {
    font-size: 16px;
    line-height: 20px;
  }

  .navLinkItems {
    font-size: 12px;
  }
}
