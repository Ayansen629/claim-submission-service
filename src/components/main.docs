 <nav className="navbar navbar-expand-lg custom-navbar fixed-top px-3">
      <div className="d-flex align-items-center gap-2 flex-shrink-0">
         {/* IWT Logo */}
        <img
          src={IWT_Icon}
          alt="IWT Logo"
          className="img-fluid"
          style={{ height: "4rem", borderRadius: "5px" }}
        />
        {/* Sidebar Toggle Button - always visible */}
        <button
          className="btn text-white me-2"
          onClick={toggleSidebar}
          aria-label="Toggle Sidebar"
          style={{
            fontSize: "1.5rem",
            zIndex: 1101,
            background: "none",
            border: "none",
            boxShadow: "none",
          }}
        >
          <FaBars />
        </button>
       
        {/* InlandWaterTransport image only when sidebar is open and on lg+ screens */}
        {isSidebarOpen && (
          <img
            src={InlandWaterTransport}
            alt="Inland Water Transport"
            className="d-none d-lg-block"
            style={{ height: "3.5rem", borderRadius: "5px", marginLeft: "10px" }}
          />
        )}
      </div>

      {/* Spacer for centering */}
      <div className="flex-grow-1 d-none d-md-block"></div>

      <div className="d-flex align-items-center gap-3 flex-shrink-0">
        <Dropdown>
          <Dropdown.Toggle
            variant="link"
            className="text-white nav-link p-0 d-flex align-items-center gap-1"
          >
            <FaGlobe />
          </Dropdown.Toggle>
          <Dropdown.Menu>
            <Dropdown.Item onClick={() => changeLanguage("en")}>
              English
            </Dropdown.Item>
            <Dropdown.Item onClick={() => changeLanguage("bn")}>
              Bengali
            </Dropdown.Item>
          </Dropdown.Menu>
        </Dropdown>

        <Dropdown align="end">
          <Dropdown.Toggle
            variant="link"
            className="d-flex align-items-center text-white nav-link p-0"
          >
            <img
              src={ProfileImg}
              alt="Profile"
              className="rounded-circle"
              style={{ width: "40px", height: "40px" }}
            />
          </Dropdown.Toggle>
          <Dropdown.Menu>
            <Dropdown.Item as={Link} to="/profile">Profile</Dropdown.Item>
            <Dropdown.Item className="text-danger" onClick={onLogout}>Logout</Dropdown.Item>
          </Dropdown.Menu>
        </Dropdown>

        <img
          src={GovtLogo}
          alt="Govt Logo"
          className="rounded-circle d-none d-sm-block"
          style={{ width: "4rem", height: "4rem" }}
        />
      </div>
    </nav>
