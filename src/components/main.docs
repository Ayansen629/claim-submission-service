import React, { useState, useEffect } from "react";
import { useParams } from "react-router-dom";
import { Box, Typography, Stack } from "@mui/material";
import Stepper from "../../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import Documents from "./Documents.js";
import { useForm } from "react-hook-form";
import Invoicing from "../../../common/Invoicing.js";
import PaymentModal from "../../../common/PaymentModal.js"; 
import PreviewPage from "../../../common/PreviewPage";
import { vesselData, previewSections } from "./vesselData";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";

// Mock data for editing
const MOCK_VESSEL_DATA = {
  1: {
    basicInfo: {
      ownerName: "Marine Shipping Co.",
      ownerAddress: "456 Harbor View, Mumbai",
      mobile: "9876543210",
      email: "info@marineshipping.com",
      pan: "MARIN1234E",
      aadhar: "987654321098",
      tradeLicence: "TRADEMSC456",
      gst: "27MARIN1234E1Z2",
      grt: "750",
      workOrderValue: "3500000",
      vesselType: "old",
      category: "B",
      zone: "2",
      supervisionAuthority: "iwt",
      purchaseType: "used",
      classificationSociety: "",
      constructedBy: "2",
      builderName: "Ocean Builders Ltd.",
      builderAddress: "789 Shipyard Road, Kochi",
      builderEmail: "contact@oceanbuilders.com",
      builderMobile: "8765432109",
      builderTradeLicence: "TRADEOBL789",
      builderGST: "29OCEAN4567B1Z3",
      builderAuth: "auth"
    },
    documents: {
      tonnageBooklets: { name: "tonnage_booklet.pdf" },
      stabilityBooklets: { name: "stability_booklet.pdf" },
      authLetter: { name: "authorization_letter.pdf" },
      termsAccepted: true,
      workOrders: [
        { file: { name: "work_order_1.pdf" }, description: "Primary work order" }
      ],
      drawings: [
        { file: { name: "structural_drawing.pdf" }, description: "Structural design" }
      ]
    }
  },
  2: {
    basicInfo: {
      ownerName: "Coastal Vessels Ltd.",
      ownerAddress: "321 Beach Road, Chennai",
      mobile: "8765432109",
      email: "contact@coastalvessels.com",
      pan: "COAST5678F",
      aadhar: "876543210987",
      tradeLicence: "TRADECVL789",
      gst: "33COAST5678F1Z4",
      grt: "1200",
      workOrderValue: "5000000",
      vesselType: "new",
      category: "A",
      zone: "1",
      supervisionAuthority: "classificationSociety",
      purchaseType: "new",
      classificationSociety: "Indian Register of Shipping",
      constructedBy: "1"
    },
    documents: {
      tonnageBooklets: { name: "tonnage_cert.pdf" },
      stabilityBooklets: { name: "stability_cert.pdf" },
      termsAccepted: true,
      workOrders: [
        { file: { name: "contract.pdf" }, description: "Main contract" }
      ],
      drawings: [
        { file: { name: "hull_design.pdf" }, description: "Hull design" },
        { file: { name: "deck_plan.pdf" }, description: "Deck plan" }
      ]
    }
  }
};

const NewVesselRegistration = ({ editMode = false }) => {
    const { id } = useParams();
    const [initialData, setInitialData] = useState(null);
    const { t } = useTranslation();
    const { changeLanguage } = useLanguageContext();
    const methods = useForm({ mode: "onTouched" });
    const { reset } = methods;
    
    // Payment modal state
    const [showModal, setShowModal] = useState(false);
    const [paymentMode, setPaymentMode] = useState("offline");
    const [challanFile, setChallanFile] = useState(null);
    const [showPreview, setShowPreview] = useState(false);
    const [isLoading, setIsLoading] = useState(false);

    useEffect(() => {
        if (editMode && id) {
            setIsLoading(true);
            // Simulate API call
            setTimeout(() => {
                const data = MOCK_VESSEL_DATA[id] || MOCK_VESSEL_DATA[1]; // Fallback to first item
                setInitialData(data);
                reset({
                    ...data.basicInfo,
                    ...data.documents
                });
                setIsLoading(false);
            }, 1000);
        }
    }, [editMode, id, reset]);

    const validateVesselDetails = async () => {
        const basicFields = [
            "ownerName", "ownerAddress", "mobile", "email", "pan", 
            "aadhar", "tradeLicence", "gst", "grt", "workOrderValue",
            "vesselType", "category", "purchaseType", "constructedBy"
        ];
        
        const constructedBy = methods.getValues("constructedBy");
        if (constructedBy === "2") {
            basicFields.push(
                "builderName", "builderAddress", "builderEmail", 
                "builderMobile", "builderTradeLicence", "builderGST", 
                "builderAuth", "authLetter"
            );
        }
        
        const valid = await methods.trigger(basicFields);
        return valid;
    };

    const validateDocuments = async () => {
        const requiredFields = ['tonnageBooklets', 'stabilityBooklets', 'termsAccepted'];
        const constructedBy = methods.getValues("constructedBy");
        
        if (constructedBy === "2") {
            requiredFields.push('authLetter');
        }
        
        let hasErrors = false;
        
        requiredFields.forEach(fieldName => {
            const fieldValue = methods.getValues(fieldName);
            
            if (!fieldValue || (fieldValue instanceof FileList && fieldValue.length === 0)) {
                methods.setError(fieldName, {
                    type: 'required',
                    message: `${fieldName} is required`
                });
                hasErrors = true;
            }
        });
        
        return !hasErrors;
    };

    const supervisionAuthority = methods.watch("supervisionAuthority");

    const handleChallanUpload = (e) => {
        setChallanFile(e.target.files?.[0] || null);
    };
    
    const handleShowPreview = () => {
        setShowPreview(true);
    };

    const handleOnlinePay = () => {
        setIsLoading(true);
        setShowModal(false);
       
        setTimeout(() => {
            setIsLoading(false);
            setShowPreview(true);
        }, 1500);
    };

    const steps = [
        {
            label: t("Vessel Details"),
            component: <VesselDetails formMethods={methods} viewMode={showPreview} initialData={initialData?.basicInfo} />,
            validate: validateVesselDetails,
        },
        {
            label: t("Documents"),
            component: <Documents formMethods={methods} viewMode={showPreview} initialDocs={initialData?.documents} />,
            validate: validateDocuments,
        },
        {
            label: t("Invoicing"),
            component: (
                <Invoicing
                    supervisionAuthority={supervisionAuthority}
                    onPayNow={() => setShowModal(true)}
                />
            ),
            validate: () => true,
        },
    ];

    const handleSave = () => {
        setIsLoading(true);
        setTimeout(() => {
            setIsLoading(false);
            setShowPreview(true);
        }, 1500);
    };

    if (showPreview) {
        return (
            <PreviewPage
                data={vesselData}
                sections={previewSections}
                title={editMode ? "Vessel Registration Update Preview" : "Vessel Registration Preview"}
                subtitle={editMode ? "Registration details updated successfully" : "Registration details submitted successfully"}
                onBack={() => setShowPreview(false)}
                submitButtonText="Take Action"
                onSubmit={() => alert(editMode ? "Updating vessel..." : "Registering vessel...")}
                icons={{ title: "vessel" }}
                viewMode={true}
            />
        );
    }

    return (
        <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
            {isLoading ? (
                <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
                    <div className="text-center">
                        <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
                            <span className="visually-hidden">Loading...</span>
                        </div>
                        <p className="mt-3">{editMode ? "Loading vessel data..." : "Processing your request..."}</p>
                    </div>
                </div>
            ) : (
                <>
                    <Stack spacing={0.5}>
                        <Typography
                            sx={{
                                fontWeight: 550,
                                color: "#2E57A7",
                                fontSize: "1.2rem",
                            }}
                        >
                            {editMode ? t("Edit Vessel Registration") : t("New Vessel Registration")}
                            &nbsp;
                            <span style={{ color: "#666", fontSize: "0.65rem" }}>
                                {editMode 
                                    ? t("(Edit the vessel details)") 
                                    : t("(Fill in the vessel details to complete registration)")}
                            </span>
                        </Typography>
                    </Stack>
                    <Stepper steps={steps} onSave={handleSave} />
                    <PaymentModal
                        show={showModal}
                        onHide={() => setShowModal(false)}
                        paymentMode={paymentMode}
                        setPaymentMode={setPaymentMode}
                        challanFile={challanFile}
                        onChallanUpload={handleChallanUpload}
                        onOnlinePay={handleOnlinePay}
                        isLoading={isLoading}
                        formMethods={methods}
                    />
                </>
            )}
        </Box>
    );
};

export default NewVesselRegistration;
