import React from "react";
import "../common/styles/AnalyticsCard.css";

const AnalyticsCard = ({
  title,
  value,
  subtitle,
  icon: Icon,
  imageSrc,
  backgroundColor = "#f5f5f5",
  color = "#333333",
  onClick,
}) => {

  return (
    <div
      className="analytics-card"
      style={{
        background: backgroundColor,
        color: color,
        border: "4px solid white",
        borderRadius: "16px",
        boxShadow: "0 8px 20px rgba(0, 0, 0, 0.15), 0 4px 8px rgba(0, 0, 0, 0.1)",
        padding: "20px",
        position: "relative",
        overflow: "hidden",
      }}
      onClick={onClick}
    >
      <div className="analytics-card-top">
        <h5 className="analytics-card-title" style={{ fontSize: "16px", fontWeight: "600", marginBottom: "15px" }}>
          {title}
        </h5>
        <div className="analytics-card-icon">
          {imageSrc ? (
            <img src={imageSrc} alt="icon" style={{ width: "32px", height: "32px" }} />
          ) : Icon ? (
            <Icon size={32} color={color} />
          ) : null}
        </div>
      </div>

      {value !== undefined && (
        <div className="analytics-card-value" style={{ fontSize: "32px", fontWeight: "bold", margin: "15px 0" }}>
          {value}
        </div>
      )}

      <div className="analytics-card-subtitle" style={{ fontSize: "14px", opacity: "0.9", lineHeight: "1.4" }}>
        {subtitle}
      </div>
    </div>
  );
};

export default AnalyticsCard;
