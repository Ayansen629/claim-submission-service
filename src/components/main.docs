{showModal && (
  <div
    style={{
      position: "fixed",
      top: 0,
      left: 0,
      height: "100%",
      width: "100%",
      backgroundColor: "rgba(0,0,0,0.5)",
      display: "flex",
      justifyContent: "center",
      alignItems: "center",
      zIndex: 1000,
    }}
  >
    <div
      style={{
        backgroundColor: "white",
        padding: "2rem",
        borderRadius: "10px",
        minWidth: "600px",
        maxWidth: "90%",
        maxHeight: "80vh",
        overflowY: "auto",
      }}
    >
      <div className="d-flex justify-content-between align-items-center mb-4">
        <h2 className="mb-0">
          Documents for Application: {modalData.applicationNumber || "N/A"}
        </h2>
        <button 
          onClick={handleCloseModal}
          style={{
            background: "none",
            border: "none",
            fontSize: "1.5rem",
            cursor: "pointer",
            color: "#6c757d",
          }}
        >
          &times;
        </button>
      </div>

      <Table striped bordered hover responsive>
        <thead>
          <tr>
            <th style={{ width: "10%" }}>SL #</th>
            <th style={{ width: "70%" }}>Document Name</th>
            <th style={{ width: "20%" }}>Action</th>
          </tr>
        </thead>
        <tbody>
          {documentListData?.length > 0 ? (
            documentListData.map((item, index) => (
              <tr key={index}>
                <td>{index + 1}</td>
                <td>
                  <div className="d-flex align-items-center">
                    <FaFilePdf className="me-2" style={{ color: "red" }} />
                    {item.documentName || `Document ${index + 1}`}
                  </div>
                </td>
                <td>
                  <Button
                    variant="outline-primary"
                    size="sm"
                    onClick={() => getDocumentFile(item)}
                    className="d-flex align-items-center justify-content-center"
                    style={{ width: "100%" }}
                  >
                    <FaDownload className="me-2" />
                    Download
                  </Button>
                </td>
              </tr>
            ))
          ) : (
            <tr>
              <td colSpan="3" className="text-center text-muted py-4">
                No documents available
              </td>
            </tr>
          )}
        </tbody>
      </Table>

      <div className="d-flex justify-content-end mt-3">
        <Button variant="secondary" onClick={handleCloseModal}>
          Close
        </Button>
      </div>
    </div>
  </div>
)}
