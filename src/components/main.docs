// In your SurveyorDashboard component

const generateInboxData = () => {
  const statuses = ["Completed", "Processing", "Rejected"];
  const appTypes = [
    "Annual Survey",
    "Renewal Survey", 
    "Special Survey",
    "Accident Survey",
    "Initial Survey"
  ];

  return Array.from({ length: 20 }, (_, i) => ({
    id: i + 1,
    appNo: `SUR-2025-${(i + 1).toString().padStart(3, "0")}`,
    appType: appTypes[Math.floor(Math.random() * appTypes.length)],
    date: new Date(2025, Math.floor(Math.random() * 12), Math.floor(Math.random() * 28) + 1)
      .toISOString()
      .split("T")[0],
    status: statuses[Math.floor(Math.random() * statuses.length)],
    action: <Button variant="outline-primary" size="sm">View</Button>
  }));
};

// Update your useEffect for filtering
useEffect(() => {
  const results = inboxData.filter((item) => {
    // Add null checks for each property
    const appNo = item.appNo ? item.appNo.toLowerCase() : '';
    const appType = item.appType ? item.appType.toLowerCase() : '';
    const status = item.status ? item.status.toLowerCase() : '';
    const search = searchTerm.toLowerCase();
    
    return (
      appNo.includes(search) ||
      appType.includes(search) ||
      status.includes(search)
    );
  });
  setFilteredData(results);
  setCurrentPage(1);
}, [searchTerm, inboxData]);

// ActionTable component with proper props
<ActionTable
  columns={INBOX_COLUMNS}
  rowData={filteredData}
  tableHeader={null}
  hideExportBtn={true}
  hideSearchBar={true}
  pagination={true}
  currentPage={currentPage}
  itemsPerPage={itemsPerPage}
  onPageChange={handleTablePageChange}
  noDataText={
    <div className="no-results text-center py-4">
      <BsSearch size={24} className="mb-2" />
      <p>No results found</p>
      <small>Try adjusting your search to find what you're looking for.</small>
    </div>
  }
/>
