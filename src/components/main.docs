const renderActionButton = () => {
  if (viewMode) {
    if (steps[activeStep]?.showSavaAndNextButton) {
      // For Book of Registration - show Next if no actions
      if (!currentStep?.hasActions) {
        return (
          <Button
            variant="contained"
            sx={buttonStyle}
            onClick={handleNext}
            title="Go to next step"
          >
            {t("Next")}
          </Button>
        );
      }
      
      return (
        <Button
          variant="contained"
          sx={buttonStyle}
          onClick={handleSave}
          title="Save current step and continue"
        >
          {t("Save & Next")}
        </Button>
      );
    }

    if (steps[activeStep]?.showSubmitButton) {
      // For Certificate of Registration - hide Save as Draft if no actions
      if (!currentStep?.hasActions) {
        return null; // Hide button completely
      }

      return (
        <div style={{ display: "flex", gap: "8px" }}>
          <Button
            variant="contained"
            sx={buttonStyle}
            onClick={handleSubmit}
            title="Submit Certification of Registration"
          >
            {t("Save as Draft")}
          </Button>
          {activeStep === totalSteps - 1 && actionComponent}
        </div>
      );
    }

    // Rest remains the same...
    return activeStep === totalSteps - 1 ? (
      actionComponent || (
        <>
          <Button
            variant="contained"
            sx={buttonStyle}
            onClick={() => navigate("/dashboard")}
            title="Close and return to dashboard"
          >
            Close
          </Button>
        </>
      )
    ) : (
      <Button
        variant="contained"
        sx={buttonStyle}
        onClick={handleNext}
        title="Go to next step"
      >
        {t("Next")}
      </Button>
    );
  }

  // Non-view mode logic remains unchanged...
  return activeStep === totalSteps - 1 ? (
    currentStep?.showCloseButton ? (
      <Button
        variant="contained"
        sx={buttonStyle}
        onClick={() => navigate("/dashboard")}
        title="Close and return to dashboard"
      >
        Close
      </Button>
    ) : currentStep?.showSubmitWithInvoice ? (
      <>
        {!omitSubmitButton ? (
          <div style={{ display: "flex", gap: "8px" }}>
            <Button
              disabled={disableSubmit}
              variant="contained"
              sx={buttonStyle}
              onClick={handleSubmit}
              title="Submit the form"
            >
              Submit
            </Button>
            {disableSubmit && (
              <Button
                variant="contained"
                sx={buttonStyle}
                onClick={handleGetInvoice}
                title="Get invoice for payment"
              >
                {t("Get Invoice")}
              </Button>
            )}
          </div>
        ) : null}
      </>
    ) : (
      <Button
        variant="contained"
        sx={buttonStyle}
        onClick={handlePayNow}
        title="Proceed to payment"
      >
        {t("Proceed to Pay")}
      </Button>
    )
  ) : (
    <Button
      variant="contained"
      sx={buttonStyle}
      onClick={handleSave}
      title="Save current step and continue"
    >
      {t("Save & Next")}
    </Button>
  );
};
