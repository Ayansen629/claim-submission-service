import React, { useState } from 'react';
import { Modal, Button } from 'react-bootstrap';
import DatePicker from 'react-datepicker';
import { format, setHours, setMinutes } from 'date-fns';
import 'react-datepicker/dist/react-datepicker.css';
import 'bootstrap/dist/css/bootstrap.min.css';

const AppointmentModal = ({ show, handleClose, handleConfirm }) => {
  const [appointments, setAppointments] = useState([
    { date: null, time: null },
    { date: null, time: null },
    { date: null, time: null },
    { date: null, time: null }
  ]);

  const [activeDatePicker, setActiveDatePicker] = useState(null);

  const generateTimeSlots = (date) => {
    if (!date) return [];
    
    return [
      { start: setHours(setMinutes(new Date(date), 0), 10), end: setHours(setMinutes(new Date(date), 0), 11), display: '10:00 AM - 11:00 AM' },
      { start: setHours(setMinutes(new Date(date), 0), 12), end: setHours(setMinutes(new Date(date), 0), 13), display: '12:00 PM - 1:00 PM' },
      { start: setHours(setMinutes(new Date(date), 0), 15), end: setHours(setMinutes(new Date(date), 0), 16), display: '3:00 PM - 4:00 PM' },
      { start: setHours(setMinutes(new Date(date), 0), 16), end: setHours(setMinutes(new Date(date), 0), 17), display: '4:00 PM - 5:00 PM' }
    ];
  };

  const handleDateChange = (date, index) => {
    const newAppointments = [...appointments];
    newAppointments[index] = { ...newAppointments[index], date, time: null };
    setAppointments(newAppointments);
    setActiveDatePicker(null);
  };

  const handleTimeSelect = (time, index) => {
    const newAppointments = [...appointments];
    newAppointments[index] = { ...newAppointments[index], time };
    setAppointments(newAppointments);
  };

  const onConfirm = () => {
    const validAppointments = appointments.filter(appt => appt.date && appt.time);
    if (validAppointments.length > 0) {
      handleConfirm(validAppointments);
      handleClose();
    }
  };

  return (
    <Modal show={show} onHide={handleClose} size="lg" centered>
      <Modal.Header closeButton>
        <Modal.Title>Schedule Appointments</Modal.Title>
      </Modal.Header>
      
      <Modal.Body style={{ maxHeight: '70vh', overflowY: 'auto' }}>
        <div className="appointments-grid">
          {appointments.map((appt, index) => {
            const timeSlots = generateTimeSlots(appt.date);
            
            return (
              <div key={index} className="appointment-slot mb-3 p-3 border rounded">
                <div className="row">
                  <div className="col-md-4">
                    <div className="date-selection">
                      <label className="form-label">Date</label>
                      <div 
                        className="date-display form-control"
                        onClick={() => setActiveDatePicker(activeDatePicker === index ? null : index)}
                      >
                        {appt.date ? format(appt.date, 'MMM d, yyyy') : 'Select date'}
                      </div>
                      {activeDatePicker === index && (
                        <div className="date-picker-container mt-2">
                          <DatePicker
                            selected={appt.date}
                            onChange={(date) => handleDateChange(date, index)}
                            minDate={new Date()}
                            inline
                            calendarClassName="custom-calendar"
                          />
                        </div>
                      )}
                    </div>
                  </div>
                  
                  <div className="col-md-8">
                    <div className="time-selection">
                      <label className="form-label">Time</label>
                      {appt.date ? (
                        <div className="time-slots d-grid gap-2">
                          {timeSlots.map((slot, slotIndex) => (
                            <button
                              key={slotIndex}
                              className={`time-slot btn ${
                                appt.time?.display === slot.display ? 'btn-primary' : 'btn-outline-primary'
                              }`}
                              onClick={() => handleTimeSelect(slot, index)}
                              type="button"
                            >
                              {slot.display}
                            </button>
                          ))}
                        </div>
                      ) : (
                        <div className="time-placeholder text-muted p-2 bg-light rounded">
                          Select date first
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </Modal.Body>
      
      <Modal.Footer>
        <Button variant="secondary" onClick={handleClose}>
          Cancel
        </Button>
        <Button 
          variant="primary" 
          onClick={onConfirm}
          disabled={!appointments.some(appt => appt.date && appt.time)}
        >
          Confirm Appointments
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default AppointmentModal;
