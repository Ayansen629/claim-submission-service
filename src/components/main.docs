import React, { useState, useRef } from "react";
import { Button } from "@mui/material";
import { FaArrowLeft, FaEye, FaUpload } from "react-icons/fa";
import { useNavigate, useLocation } from "react-router-dom";
import { useForm } from "react-hook-form";
import Stepper from "../../common/Stepper";
import Collapsible from "../../common/Collapsible";
import InputText from "../../common/InputText";
import styles from './ApplicationDetailsUpdate.module.css';

const ApplicationDetailsUpdate = () => {
  const navigate = useNavigate();
  const location = useLocation();
  const stepperRef = useRef();
  const selectedOption = location.state?.selectedOption || "";
  
  const {
    register,
    formState: { errors },
    watch,
    setValue,
    trigger
  } = useForm({
    mode: "onChange",
    defaultValues: {
      previousName: "",
      updatedNewName: ""
    }
  });

  const [uploadedFile, setUploadedFile] = useState(null);

  const handleFileUpload = (event) => {
    const file = event.target.files[0];
    if (file) {
      setUploadedFile(file);
    }
  };

  const validateStep = () => {
    const formData = watch();
    return formData.previousName && formData.updatedNewName && uploadedFile;
  };

  const getFormData = () => {
    return watch();
  };

  const handleSaveAndNext = (stepInfo) => {
    console.log("Saving step data:", stepInfo);
  };

  const RegistrationInformationStep = () => (
    <Collapsible
      title="Registration Information"
      openStat={true}
      newDesign={true}
    >
      <div className={styles.formContent}>
        <div className={styles.formRow}>
          <InputText
            label="Previous Name"
            name="previousName"
            placeholder="Enter previous name"
            register={register("previousName", {
              required: "Previous name is required"
            })}
            errors={errors}
            required={true}
          />
          
          <InputText
            label="Updated New Name"
            name="updatedNewName"
            placeholder="Enter updated new name"
            register={register("updatedNewName", {
              required: "Updated new name is required"
            })}
            errors={errors}
            required={true}
          />
        </div>
        
        <div className={styles.warningText}>
          Applicant must upload valid supporting documents for the selected change ({selectedOption})
        </div>
        
        <div className={styles.uploadSection}>
          <label className={styles.uploadLabel}>*Valid Supporting Documents</label>
          <div className={styles.uploadBox}>
            <input
              type="file"
              id="fileUpload"
              style={{ display: 'none' }}
              onChange={handleFileUpload}
              accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
            />
            <div className={styles.fileName}>
              {uploadedFile ? uploadedFile.name : "File Name"}
            </div>
            <div className={styles.uploadButtons}>
              <Button
                variant="contained"
                size="small"
                startIcon={<FaEye />}
                className={styles.viewButton}
                disabled={!uploadedFile}
              >
                View
              </Button>
              <Button
                variant="contained"
                size="small"
                startIcon={<FaUpload />}
                className={styles.uploadButton}
                onClick={() => document.getElementById('fileUpload').click()}
              >
                Upload
              </Button>
            </div>
          </div>
        </div>
      </div>
    </Collapsible>
  );

  const steps = [
    {
      label: "Registration Information",
      component: <RegistrationInformationStep />,
      validate: validateStep,
      getFormData: getFormData
    }
  ];

  return (
    <div className={styles.container}>
      <div className={styles.header}>
        <Button
          startIcon={<FaArrowLeft />}
          onClick={() => navigate(-1)}
          className={styles.backButton}
        >
        </Button>
        <h5 className={styles.title}>
          Application Details Update - {selectedOption}
        </h5>
        <div className={styles.applicationId}>
          WB-IWT/REG/2025/302748
        </div>
      </div>
      
      <Stepper
        ref={stepperRef}
        steps={steps}
        onSyncData={handleSaveAndNext}
        viewMode={false}
        editMode={false}
        initialStep={0}
      />
    </div>
  );
};

export default ApplicationDetailsUpdate;
