.radioButtonGroup {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.radioButton {
  display: flex;
  align-items: center;
  background-color: #f2f8ff;
  border: 2px solid #cbdaf7;
  border-radius: 15px;
  padding: 8px 20px;
  cursor: pointer;
  transition: all 0.2s ease;
  font-weight: 500;
  color: #2466bf;
}

.radioButton:hover {
  background-color: #e1edff;
  border-color: #4695ff;
}

.radioInput {
  display: none;
}

.radioInput:checked + .radioLabel {
  background-color: #4695ff;
  color: #fff;
  border-radius: 10px;
  padding: 5px 15px;
}

.radioLabel {
  transition: all 0.2s ease;
}
