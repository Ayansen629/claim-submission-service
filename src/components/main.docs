import React, { useState, useEffect } from 'react';
import { Container, Row, Col, Card, Form, Button, Alert } from 'react-bootstrap';
import { 
  FaLanguage, 
  FaPalette, 
  FaCheck, 
  FaSun, 
  FaMoon, 
  FaDesktop, 
  FaFont, 
  FaCalendarAlt,
  FaFlag,
  FaGlobe
} from 'react-icons/fa';
import './css/Settings.css';

const Settings = () => {
  // State for settings
  const [settings, setSettings] = useState({
    // Appearance settings
    theme: 'light',
    fontSize: 'medium',
    
    // Language settings
    language: 'english',
    dateFormat: 'MM/DD/YYYY',
  });

  // State for alerts
  const [showAlert, setShowAlert] = useState(false);
  const [alertVariant, setAlertVariant] = useState('success');
  const [alertMessage, setAlertMessage] = useState('');

  // Load settings from localStorage on component mount
  useEffect(() => {
    const savedSettings = localStorage.getItem('userSettings');
    if (savedSettings) {
      setSettings(JSON.parse(savedSettings));
    }
    
    // Apply theme from localStorage or default
    applyTheme(savedSettings ? JSON.parse(savedSettings).theme : 'light');
    
    // Apply language from localStorage or default
    applyLanguage(savedSettings ? JSON.parse(savedSettings).language : 'english');
    
    // Apply font size
    applyFontSize(savedSettings ? JSON.parse(savedSettings).fontSize : 'medium');
  }, []);

  // Apply theme function
  const applyTheme = (theme) => {
    const root = document.documentElement;
    
    // Remove any existing theme classes
    document.body.classList.remove('theme-light', 'theme-dark');
    
    if (theme === 'system') {
      // Check system preference
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.body.classList.add(prefersDark ? 'theme-dark' : 'theme-light');
      
      // Set CSS variables based on system preference
      if (prefersDark) {
        root.style.setProperty('--bg-color', '#121212');
        root.style.setProperty('--text-color', '#f5f5f5');
        root.style.setProperty('--card-bg', '#1e1e1e');
        root.style.setProperty('--border-color', '#333');
      } else {
        root.style.setProperty('--bg-color', '#f8f9fa');
        root.style.setProperty('--text-color', '#212529');
        root.style.setProperty('--card-bg', '#ffffff');
        root.style.setProperty('--border-color', '#dee2e6');
      }
    } else {
      // Apply specific theme
      document.body.classList.add(`theme-${theme}`);
      
      // Set CSS variables based on theme
      if (theme === 'dark') {
        root.style.setProperty('--bg-color', '#121212');
        root.style.setProperty('--text-color', '#f5f5f5');
        root.style.setProperty('--card-bg', '#1e1e1e');
        root.style.setProperty('--border-color', '#333');
      } else {
        root.style.setProperty('--bg-color', '#f8f9fa');
        root.style.setProperty('--text-color', '#212529');
        root.style.setProperty('--card-bg', '#ffffff');
        root.style.setProperty('--border-color', '#dee2e6');
      }
    }
  };

  // Apply language function
  const applyLanguage = (language) => {
    // In a real app, this would load language files or use i18n
    // For this demo, we'll just store the language preference
    localStorage.setItem('userLanguage', language);
    
    // Example of how you might update the page title based on language
    const titles = {
      english: 'Settings - Claims Management System',
      spanish: 'Configuración - Sistema de Gestión de Reclamaciones',
      french: 'Paramètres - Système de Gestion des Réclamations',
      german: 'Einstellungen - Anspruchsverwaltungssystem'
    };
    
    document.title = titles[language] || titles.english;
    
    // Apply font size
    applyFontSize(settings.fontSize);
  };

  // Apply font size function
  const applyFontSize = (size) => {
    const root = document.documentElement;
    const sizes = {
      small: '14px',
      medium: '16px',
      large: '18px'
    };
    
    root.style.setProperty('--base-font-size', sizes[size] || sizes.medium);
    document.body.style.fontSize = sizes[size] || sizes.medium;
  };

  // Handle theme selection
  const handleThemeSelect = (theme) => {
    const newSettings = {
      ...settings,
      theme
    };
    
    setSettings(newSettings);
    applyTheme(theme);
    localStorage.setItem('userSettings', JSON.stringify(newSettings));
  };

  // Handle language selection
  const handleLanguageSelect = (language) => {
    const newSettings = {
      ...settings,
      language
    };
    
    setSettings(newSettings);
    applyLanguage(language);
    localStorage.setItem('userSettings', JSON.stringify(newSettings));
  };

  // Handle font size selection
  const handleFontSizeSelect = (fontSize) => {
    const newSettings = {
      ...settings,
      fontSize
    };
    
    setSettings(newSettings);
    applyFontSize(fontSize);
    localStorage.setItem('userSettings', JSON.stringify(newSettings));
  };

  // Handle date format selection
  const handleDateFormatSelect = (dateFormat) => {
    const newSettings = {
      ...settings,
      dateFormat
    };
    
    setSettings(newSettings);
    localStorage.setItem('userSettings', JSON.stringify(newSettings));
  };

  // Handle form submission
  const handleSubmit = (e) => {
    e.preventDefault();
    
    // Apply theme and language settings
    applyTheme(settings.theme);
    applyLanguage(settings.language);
    applyFontSize(settings.fontSize);
    
    // Save settings to localStorage
    localStorage.setItem('userSettings', JSON.stringify(settings));
    
    // Show success message
    setAlertVariant('success');
    setAlertMessage('Settings saved successfully!');
    setShowAlert(true);
    
    // Hide alert after 3 seconds
    setTimeout(() => {
      setShowAlert(false);
    }, 3000);
  };

  // Reset settings to default
  const handleReset = () => {
    const defaultSettings = {
      theme: 'light',
      fontSize: 'medium',
      language: 'english',
      dateFormat: 'MM/DD/YYYY',
    };
    
    setSettings(defaultSettings);
    
    // Apply default theme and language
    applyTheme('light');
    applyLanguage('english');
    applyFontSize('medium');
    
    // Save default settings to localStorage
    localStorage.setItem('userSettings', JSON.stringify(defaultSettings));
    
    setAlertVariant('info');
    setAlertMessage('Settings reset to default values');
    setShowAlert(true);
    
    setTimeout(() => {
      setShowAlert(false);
    }, 3000);
  };

  // Translations for the current language
  const getTranslations = () => {
    const translations = {
      english: {
        title: 'Settings',
        subtitle: 'Manage your account settings and preferences',
        appearance: 'Appearance Settings',
        language: 'Language & Region',
        save: 'Save Changes',
        reset: 'Reset to Default'
      },
      spanish: {
        title: 'Configuración',
        subtitle: 'Administre la configuración y preferencias de su cuenta',
        appearance: 'Configuración de Apariencia',
        language: 'Idioma y Región',
        save: 'Guardar Cambios',
        reset: 'Restablecer Valores Predeterminados'
      },
      french: {
        title: 'Paramètres',
        subtitle: 'Gérez les paramètres et préférences de votre compte',
        appearance: 'Paramètres d\'Apparence',
        language: 'Langue et Région',
        save: 'Enregistrer les Modifications',
        reset: 'Réinitialiser par Défaut'
      },
      german: {
        title: 'Einstellungen',
        subtitle: 'Verwalten Sie Ihre Kontoeinstellungen und Präferenzen',
        appearance: 'Erscheinungsbild',
        language: 'Sprache & Region',
        save: 'Änderungen Speichern',
        reset: 'Auf Standard Zurücksetzen'
      }
    };
    
    return translations[settings.language] || translations.english;
  };

  const t = getTranslations();

  // Language flags and names
  const languages = {
    english: { flag: '🇺🇸', native: 'English' },
    spanish: { flag: '🇪🇸', native: 'Español' },
    french: { flag: '🇫🇷', native: 'Français' },
    german: { flag: '🇩🇪', native: 'Deutsch' }
  };

  return (
    <Container className="settings-container">
      <div className="settings-header">
        <h1 className="settings-title">{t.title}</h1>
        <p className="settings-subtitle">{t.subtitle}</p>
      </div>

      {showAlert && (
        <Alert 
          variant={alertVariant} 
          onClose={() => setShowAlert(false)} 
          dismissible
          className="settings-alert"
        >
          {alertMessage}
        </Alert>
      )}

      <Form onSubmit={handleSubmit}>
        <Row>
          <Col md={6} className="mb-4">
            <Card className="settings-card">
              <Card.Header>
                <FaPalette className="me-2" /> {t.appearance}
              </Card.Header>
              <Card.Body>
                <Form.Group className="mb-4">
                  <Form.Label>Theme</Form.Label>
                  
                  <div className="theme-selector">
                    <div 
                      className={`theme-option theme-option-light ${settings.theme === 'light' ? 'selected' : ''}`}
                      onClick={() => handleThemeSelect('light')}
                    >
                      <div className="theme-option-label">
                        <FaSun className="me-1" /> Light
                      </div>
                      {settings.theme === 'light' && <FaCheck className="theme-option-check" />}
                    </div>
                    
                    <div 
                      className={`theme-option theme-option-dark ${settings.theme === 'dark' ? 'selected' : ''}`}
                      onClick={() => handleThemeSelect('dark')}
                    >
                      <div className="theme-option-label">
                        <FaMoon className="me-1" /> Dark
                      </div>
                      {settings.theme === 'dark' && <FaCheck className="theme-option-check" />}
                    </div>
                    
                    <div 
                      className={`theme-option theme-option-system ${settings.theme === 'system' ? 'selected' : ''}`}
                      onClick={() => handleThemeSelect('system')}
                    >
                      <div className="theme-option-label">
                        <FaDesktop className="me-1" /> System
                      </div>
                      {settings.theme === 'system' && <FaCheck className="theme-option-check" />}
                    </div>
                  </div>
                </Form.Group>

                <Form.Group className="mb-3">
                  <Form.Label>Font Size</Form.Label>
                  
                  <div className="font-size-selector">
                    <div 
                      className={`font-size-option font-size-small ${settings.fontSize === 'small' ? 'selected' : ''}`}
                      onClick={() => handleFontSizeSelect('small')}
                    >
                      <span className="font-size-label">Small</span>
                    </div>
                    
                    <div 
                      className={`font-size-option font-size-medium ${settings.fontSize === 'medium' ? 'selected' : ''}`}
                      onClick={() => handleFontSizeSelect('medium')}
                    >
                      <span className="font-size-label">Medium</span>
                    </div>
                    
                    <div 
                      className={`font-size-option font-size-large ${settings.fontSize === 'large' ? 'selected' : ''}`}
                      onClick={() => handleFontSizeSelect('large')}
                    >
                      <span className="font-size-label">Large</span>
                    </div>
                  </div>
                  
                  <div className="font-preview">
                    <span className={`font-sample font-${settings.fontSize}`}>
                      Sample Text - The quick brown fox jumps over the lazy dog
                    </span>
                  </div>
                </Form.Group>
              </Card.Body>
            </Card>
          </Col>

          <Col md={6} className="mb-4">
            <Card className="settings-card">
              <Card.Header>
                <FaLanguage className="me-2" /> {t.language}
              </Card.Header>
              <Card.Body>
                <Form.Group className="mb-4">
                  <Form.Label>Language</Form.Label>
                  
                  <div className="language-selector">
                    {Object.entries(languages).map(([code, { flag, native }]) => (
                      <div 
                        key={code}
                        className={`language-option ${settings.language === code ? 'selected' : ''}`}
                        onClick={() => handleLanguageSelect(code)}
                      >
                        <div className="language-flag">{flag}</div>
                        <span className="language-name">{code.charAt(0).toUpperCase() + code.slice(1)}</span>
                        <span className="language-native">{native}</span>
                        {settings.language === code && <FaCheck className="ms-2" />}
                      </div>
                    ))}
                  </div>
                </Form.Group>

                <Form.Group className="mb-3">
                  <Form.Label>Date Format</Form.Label>
                  
                  <div className="date-format-selector">
                    <div 
                      className={`date-format-option ${settings.dateFormat === 'MM/DD/YYYY' ? 'selected' : ''}`}
                      onClick={() => handleDateFormatSelect('MM/DD/YYYY')}
                    >
                      <span className="date-format-label">MM/DD/YYYY</span>
                      <span className="date-format-example">{formatDate(new Date(), 'MM/DD/YYYY')}</span>
                    </div>
                    
                    <div 
                      className={`date-format-option ${settings.dateFormat === 'DD/MM/YYYY' ? 'selected' : ''}`}
                      onClick={() => handleDateFormatSelect('DD/MM/YYYY')}
                    >
                      <span className="date-format-label">DD/MM/YYYY</span>
                      <span className="date-format-example">{formatDate(new Date(), 'DD/MM/YYYY')}</span>
                    </div>
                    
                    <div 
                      className={`date-format-option ${settings.dateFormat === 'YYYY-MM-DD' ? 'selected' : ''}`}
                      onClick={() => handleDateFormatSelect('YYYY-MM-DD')}
                    >
                      <span className="date-format-label">YYYY-MM-DD</span>
                      <span className="date-format-example">{formatDate(new Date(), 'YYYY-MM-DD')}</span>
                    </div>
                  </div>
                </Form.Group>
              </Card.Body>
            </Card>
          </Col>
        </Row>

        <div className="settings-actions">
          <Button variant="primary" type="submit">
            {t.save}
          </Button>
          <Button variant="outline-secondary" onClick={handleReset}>
            {t.reset}
          </Button>
        </div>
      </Form>
    </Container>
  );
};

// Helper function to format date based on selected format
function formatDate(date, format) {
  const day = date.getDate().toString().padStart(2, '0');
  const month = (date.getMonth() + 1).toString().padStart(2, '0');
  const year = date.getFullYear();
  
  switch (format) {
    case 'MM/DD/YYYY':
      return `${month}/${day}/${year}`;
    case 'DD/MM/YYYY':
      return `${day}/${month}/${year}`;
    case 'YYYY-MM-DD':
      return `${year}-${month}-${day}`;
    default:
      return `${month}/${day}/${year}`;
  }
}

export default Settings;
