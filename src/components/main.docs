const IWTHomePage = () => {
  // ... keep existing data arrays and other code

  return (
    <div className="iwt-homepage">
      {/* Simplified Header */}
      <Navbar bg="primary" variant="dark" expand="lg" className="py-3">
        <Container>
          <Navbar.Brand href="#home" className="d-flex align-items-center">
            <img
              src={HeaderLogo}
              alt="Logo"
              className="navbar-logo"
              style={{ width: '60px', height: '60px' }}
            />
            <div className="ms-3 text-white">
              <h4 className="mb-0">West Bengal Inland Water Service</h4>
              <small className="d-block mt-1">
                <a href="https://wbtransport.gov.in" className="text-white text-decoration-underline">
                  www.wmzhengnyFTHsBqrPbxOEa6m2vYYN/West-Bengal-Inland-Water-Services/node-id-1-1702/
                </a>
              </small>
            </div>
          </Navbar.Brand>
        </Container>
      </Navbar>

      {/* Main Content Sections */}

      {/* Stats Footer */}
      <footer className="footer py-5 bg-primary text-white">
        <Container>
          <Row className="g-4 text-center">
            <Col md={3}>
              <h5 className="mb-3">Citizen Centered Governance</h5>
              <p className="mb-0">Way to connect Indian Citizens</p>
            </Col>
            
            <Col md={9}>
              <Row className="g-4">
                <Col xs={6} md={3}>
                  <div className="stat-item">
                    <h3 className="mb-0">5000+</h3>
                    <p className="mb-0">Total Registered Person</p>
                  </div>
                </Col>
                <Col xs={6} md={3}>
                  <div className="stat-item">
                    <h3 className="mb-0">2600+</h3>
                    <p className="mb-0">Total Registered Party</p>
                  </div>
                </Col>
                <Col xs={6} md={3}>
                  <div className="stat-item">
                    <h3 className="mb-0">2550+</h3>
                    <p className="mb-0">Total Registered Councillor Ship</p>
                  </div>
                </Col>
                <Col xs={6} md={3}>
                  <div className="stat-item">
                    <h3 className="mb-0">900+</h3>
                    <p className="mb-0">Total Registered House</p>
                  </div>
                </Col>
              </Row>
            </Col>
          </Row>

          <div className="mt-4 text-center border-top pt-4">
            <h5 className="mb-3">Vessel Registration</h5>
            <Button variant="light" size="sm" className="rounded-pill px-4">
              Ask to Edit
            </Button>
          </div>
        </Container>
      </footer>

      {/* Keep existing styles but add these modifications */}
      <style jsx>{`
        .navbar-logo {
          background: white;
          border-radius: 8px;
          padding: 5px;
        }
        
        .stat-item {
          background: rgba(255,255,255,0.1);
          padding: 1rem;
          border-radius: 8px;
        }
        
        .stat-item h3 {
          font-weight: 700;
          color: #fff;
        }
        
        .stat-item p {
          font-size: 0.9rem;
          color: rgba(255,255,255,0.9);
        }
        
        .footer {
          background: #00429c !important;
        }
        
        .footer h5 {
          font-weight: 600;
          letter-spacing: 0.5px;
        }
      `}</style>
    </div>
  );
};
