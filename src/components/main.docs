import React, { useState, useEffect, useRef } from "react";
import { Button } from "@/components/ui/button";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Input } from "@/components/ui/input";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Tooltip,
  TooltipContent,
  TooltipProvider,
  TooltipTrigger,
} from "@/components/ui/tooltip";
import {
  ChevronDown,
  ChevronUp,
  Edit,
  Eye,
  Trash2,
  MapPin,
  Plus,
  Database,
  Check,
  Calendar
} from "lucide-react";
import { cn } from "@/lib/utils";
import { useNavigate } from 'react-router-dom';

const ActionTable = (props) => {
  const [searchedData, setSearchedData] = useState(props.rowData || []);
  const [currentPage, setCurrentPage] = useState(1);
  const [selected, setSelected] = useState([]);
  const [sortedColumn, setSortedColumn] = useState(null);
  const [sortOrder, setSortOrder] = useState("");
  const hideColumns = props.hideColumns || [];
  const [searchQuery, setSearchQuery] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");
  const [dateSort, setDateSort] = useState("none");
  const [itemsPerPage, setItemPerPage] = useState(10);
  const [totalPages, setTotalPages] = useState(0);
  const navigate = useNavigate();

  useEffect(() => {
    if (props.rowData) {
      setSearchedData(props.rowData);
      setCurrentPage(1);
      const selectedRows = props.rowData
        .filter((item) => item.isChecked)
        .map((item) => item.id);
      setSelected(selectedRows);
    }
  }, [props.rowData]);

  // Apply filters and sorting
  useEffect(() => {
    let filteredData = [...(props.rowData || [])];

    // Apply status filter
    if (statusFilter !== "all") {
      filteredData = filteredData.filter((item) => item.status === statusFilter);
    }

    // Apply search query
    if (searchQuery) {
      const searchValue = searchQuery.toLowerCase();
      filteredData = filteredData.filter((item) =>
        Object.values(item).some((value) =>
          value?.toString().toLowerCase().includes(searchValue)
        )
      );
    }

    // Apply date sorting
    if (dateSort !== "none") {
      filteredData.sort((a, b) => {
        // Function to parse date from multiple possible fields
        const parseDate = (obj) => {
          const dateFormats = [
            "dd-MM-yy",
            "dd/MM/yy",
            "dd.MM.yy",
            "yyyy-MM-dd",
            "yyyy/MM/dd",
            "yyyy.MM.dd",
          ];

          const dateFields = [
            "dateSubmitted",
            "createdAt",
            "date",
            "submissionDate",
          ];

          for (const field of dateFields) {
            if (obj[field]) {
              // Try parsing with different formats
              for (const format of dateFormats) {
                const parsedDate = parseDateFromFormat(obj[field], format);
                if (parsedDate && !isNaN(parsedDate.getTime())) {
                  return parsedDate;
                }
              }

              // Fallback to native Date parsing
              const date = new Date(obj[field]);
              if (!isNaN(date.getTime())) {
                return date;
              }
            }
          }

          // If no valid date found, return a very old date (will sort to bottom)
          return new Date(0);
        };

        const dateA = parseDate(a);
        const dateB = parseDate(b);

        // For newest first (descending)
        if (dateSort === "desc") {
          return dateB - dateA; // Newest dates first
        }
        // For oldest first (ascending)
        else {
          return dateA - dateB; // Oldest dates first
        }
      });
    }

    // Helper function to parse date from specific format
    function parseDateFromFormat(dateString, format) {
      if (!dateString) return null;

      // Handle dd-MM-yy format
      if (format === "dd-MM-yy") {
        const parts = dateString.split("-");
        if (parts.length === 3) {
          const day = parseInt(parts[0], 10);
          const month = parseInt(parts[1], 10) - 1;
          const year = 2000 + parseInt(parts[2], 10);
          return new Date(year, month, day);
        }
      }

      // Handle other formats similarly...

      // Fallback to native parsing
      return new Date(dateString);
    }

    setSearchedData(filteredData);
    setCurrentPage(1);
    setTotalPages(Math.ceil((filteredData?.length || 0) / itemsPerPage)); // Calculate total pages here
  }, [props.rowData, statusFilter, searchQuery, dateSort, itemsPerPage]); // itemsPerPage added

  const indexOfLastItem = currentPage * itemsPerPage;
  const indexOfFirstItem = indexOfLastItem - itemsPerPage;
  const currentItems = searchedData.slice(indexOfFirstItem, indexOfLastItem);
  // const totalPages = Math.ceil((searchedData?.length || 0) / itemsPerPage);  Remove this line

  const handleNextPage = () => {
    setCurrentPage((prevPage) => Math.min(prevPage + 1, totalPages));
  };

  const handlePrevPage = () => {
    setCurrentPage((prevPage) => Math.max(prevPage - 1, 1));
  };

  const handleOnSearch = (e) => {
    setSearchQuery(e.target.value);
  };

  const sortByColumn = (column) => {
    if (sortedColumn === column) {
      setSortOrder(sortOrder === "asc" ? "desc" : "asc");
    } else {
      setSortedColumn(column);
      setSortOrder("asc");
    }
  };

  const showSortedColumnIcon = (columnName) => {
    return sortedColumn === columnName ? (
      sortOrder === "asc" ? (
        <ChevronUp className="w-4 h-4 ml-1 text-blue-500" />
      ) : (
        <ChevronDown className="w-4 h-4 ml-1 text-blue-500" />
      )
    ) : (
      <></>
    );
  };

  const handleDeleteRow = (rowData) => {
    props.onDeleteRow?.(rowData);
  };

  const handleTrack = (rowData) => {
    props.onTrackRow?.(rowData);
  };

  const handleView = (rowData) => {
    props.onViewRow?.(rowData);
  };

  const handleEdit = (rowData) => {
    props.handleEditRow?.(rowData);
  };

  const handleDownload = (rowData) => {
    props.download?.(rowData);
  };

  const handleSelectAll = (e) => {
    if (e.target.checked) {
      const newSelecteds = currentItems.map((n) => n.id);
      setSelected(newSelecteds);
      props.onCheckHandler?.(newSelecteds);
    } else {
      setSelected([]);
      props.onCheckHandler?.([]);
    }
  };

  const handleRowSelect = (e, row) => {
    const selectedId = row.id;
    if (e.target.checked) {
      const newSelected = [...selected, selectedId];
      setSelected(newSelected);
      props.onCheckHandler?.(newSelected);
    } else {
      const newSelected = selected.filter((id) => id !== selectedId);
      setSelected(newSelected);
      props.onCheckHandler?.(newSelected);
    }
  };

  const isSelected = (id) => {
    return selected.includes(id);
  };

  const getStatusOptions = () => {
    const statuses = [...new Set(props.rowData?.map((item) => item.status))];
    return ["all", ...statuses].filter(Boolean);
  };

  const StatusFilterDropdown = () => (
    <Select
      value={statusFilter}
      onValueChange={(value) => setStatusFilter(value)}
    >
      <SelectTrigger
        className="w-[180px] bg-white border-blue-500 text-blue-500 hover:bg-blue-50 hover:text-blue-600"
      >
        <SelectValue placeholder="Filter by Status" />
      </SelectTrigger>
      <SelectContent className="bg-white border-blue-500">
        <SelectItem value="all">All Statuses</SelectItem>
        {getStatusOptions().map((status, index) => (
          <SelectItem key={index} value={status}>
            {status}
          </SelectItem>
        ))}
      </SelectContent>
    </Select>
  );

  const DateSortDropdown = () => (
    <Select value={dateSort} onValueChange={(value) => setDateSort(value)}>
      <SelectTrigger
        className="w-[180px] bg-white border-blue-500 text-blue-500 hover:bg-blue-50 hover:text-blue-600"
      >
        <SelectValue placeholder="Sort by Date" />
      </SelectTrigger>
      <SelectContent className="bg-white border-blue-500">
        <SelectItem value="none">Default Order</SelectItem>
        <SelectItem value="asc">Oldest First</SelectItem>
        <SelectItem value="desc">Newest First</SelectItem>
      </SelectContent>
    </Select>
  );

  const PaginationOptions = () => {
    return (
      <Select
        value={String(itemsPerPage)}
        onValueChange={(value) => {
          setItemPerPage(Number(value));
          setCurrentPage(1);
        }}
      >
        <SelectTrigger
          className="w-[100px] bg-white border-blue-500 text-blue-500 hover:bg-blue-50 hover:text-blue-600"
        >
          <SelectValue placeholder="Per Page" />
        </SelectTrigger>
        <SelectContent className="bg-white border-blue-500">
          {[10, 25, 50, 100].map((item, i) => (
            <SelectItem key={i} value={String(item)}>
              {item}
            </SelectItem>
          ))}
        </SelectContent>
      </Select>
    );
  };

  const userData = JSON.parse(localStorage.getItem("userFormData")) || {};

  return (
    <div className="p-4 rounded-lg bg-white shadow-md">
      {/* Search and Filter Controls */}
      <div className="flex flex-wrap items-center justify-between gap-4 mb-4">
        {!props.hideSearchBar && (
          <Input
            type="search"
            value={searchQuery}
            onChange={handleOnSearch}
            placeholder="Search records..."
            className="w-full md:w-[300px] bg-white border-blue-500 text-blue-500 placeholder:text-blue-400"
          />
        )}

        <div className="flex flex-wrap items-center gap-4">
          <StatusFilterDropdown />
          <DateSortDropdown />
          {props.showCustomBtn && (
            <Button
              onClick={props.handleBtnClick}
              disabled={props.isCustomBtnDisabled}
              className="bg-blue-500 text-white hover:bg-blue-600 flex items-center gap-2"
            >
              <Plus className="w-4 h-4" />
              <span>{props.btnName}</span>
            </Button>
          )}
        </div>
      </div>

      {/* Table */}
      <div className="rounded-md border border-gray-200 overflow-x-auto">
        <Table>
          <TableHeader className="bg-blue-500 text-white">
            <TableRow>
              <TableHead className="w-[50px] px-4 py-3">
                <input
                  type="checkbox"
                  checked={
                    selected.length > 0 &&
                    selected.length === currentItems.length
                  }
                  onChange={handleSelectAll}
                  ref={(input) => {
                    if (input) {
                      input.indeterminate =
                        selected.length > 0 &&
                        selected.length < currentItems.length;
                    }
                  }}
                  className="mr-2"
                />
              </TableHead>

              {props.columns?.map((data, colIndx) => {
                return !hideColumns.includes(data.fieldName) ? (
                  <TableHead
                    key={colIndx}
                    className={cn("px-4 py-3", data.clsName, "cursor-pointer")}
                    style={{ minWidth: data.minWidth || "150px" }}
                    onClick={() => sortByColumn(data.fieldName)}
                  >
                    <div className="flex items-center justify-center">
                      <span>{data.titleCode || data.colName}</span>
                      {showSortedColumnIcon(data.fieldName)}
                    </div>
                  </TableHead>
                ) : null;
              })}
            </TableRow>
          </TableHeader>
          <TableBody>
            {currentItems.length > 0 ? (
              currentItems.map((row, index) => {
                const isItemSelected = isSelected(row.id);
                return (
                  <TableRow
                    key={index}
                    className={cn(
                      "transition-colors",
                      isItemSelected ? "bg-blue-100/50" : "hover:bg-gray-50"
                    )}
                  >
                    <TableCell className="px-4 py-3">
                      <input
                        type="checkbox"
                        checked={isItemSelected}
                        onChange={(e) => handleRowSelect(e, row)}
                        className="mr-2"
                      />
                    </TableCell>

                    {props.columns.map((o, colIndex) => {
                      const cellValue = _.get(row, o.fieldName);
                      const displayValue =
                        cellValue?.toString().split(" ")[0];
                      let tooltipTitle = cellValue;
                      const uuid = row.uuid; // Assuming your row object has a 'uuid' property

                      // Special handling for Status, Claim Number, and Comment
                      if (o.colName === "Status") {
                        tooltipTitle = cellValue || "No Status";
                      } else if (o.colName === "Claim Number") {
                        tooltipTitle = cellValue;
                      } else if (o.colName === "Comment") {
                        tooltipTitle = cellValue;
                      }

                      return o.isClickable ? (
                        <TableCell
                          key={colIndex}
                          className={cn("px-4 py-3", o.clsName, "cursor-pointer text-blue-600")}
                          onClick={(e) => props.additionalMethod?.(row)}
                        >
                          <TooltipProvider>
                            <Tooltip>
                              <TooltipTrigger asChild>
                                <span className={row.isRead === false ? "font-semibold" : ""}>
                                  {displayValue}
                                </span>
                              </TooltipTrigger>
                              <TooltipContent>{tooltipTitle}</TooltipContent>
                            </Tooltip>
                          </TooltipProvider>
                        </TableCell>
                      ) : !hideColumns.includes(o.fieldName) &&
                        o.fieldName !== "action" ? (
                        <TableCell key={colIndex} className={cn("px-4 py-3", o.clsName)}>
                          <TooltipProvider>
                            <Tooltip>
                              <TooltipTrigger asChild>
                                <span className={row.isRead === false ? "font-semibold" : ""}>
                                  {o.colName === "Claim Number" &&
                                  userData?.userType === "CRP" ? ( // Apply link only for CRP
                                    <a
                                      href={`/apply-claim/${uuid}`} // Use uuid here
                                      onClick={(e) => {
                                        e.preventDefault(); // Prevent default link behavior
                                        navigate(`/apply-claim/${uuid}`); // Use navigate
                                      }}
                                      className="text-blue-500 hover:underline" // Style as a link
                                    >
                                      {displayValue}
                                    </a>
                                  ) : (
                                    <>
                                      {displayValue}
                                      {o.fieldName2 ? _.get(row, o.fieldName2) : ""}
                                    </>
                                  )}
                                </span>
                              </TooltipTrigger>
                              <TooltipContent>{tooltipTitle}</TooltipContent>
                            </Tooltip>
                          </TooltipProvider>
                        </TableCell>
                      ) : !hideColumns.includes(o.fieldName) &&
                        o.fieldName === "action" ? (
                        <TableCell key={colIndex} className={cn("px-4 py-3", o.clsName)}>
                          <div className="flex justify-center gap-2">
                            {o.actions.includes("edit") &&
                              userData?.userType !== "CRP" && (
                                <TooltipProvider>
                                  <Tooltip>
                                    <TooltipTrigger asChild>
                                      <Button
                                        variant="ghost"
                                        size="icon"
                                        className={cn(
                                          "text-blue-500 hover:bg-blue-50/50",
                                          row.applicationStatus !==
                                            "Sent back" &&
                                            row.applicationStatus !== "Draft"
                                            ? "opacity-50 cursor-not-allowed"
                                            : ""
                                        )}
                                        onClick={() => handleEdit(row)}
                                        disabled={
                                          row.applicationStatus !==
                                            "Sent back" &&
                                          row.applicationStatus !== "Draft"
                                        }
                                      >
                                        <Edit className="w-4 h-4" />
                                      </Button>
                                    </TooltipTrigger>
                                    <TooltipContent>Edit</TooltipContent>
                                  </Tooltip>
                                </TooltipProvider>
                              )}

                            {o.actions.includes("view") && (
                              <TooltipProvider>
                                <Tooltip>
                                  <TooltipTrigger asChild>
                                    <Button
                                      variant="ghost"
                                      size="icon"
                                      className="text-blue-500 hover:bg-blue-50/50"
                                      onClick={() => handleView(row)}
                                    >
                                      <Eye className="w-4 h-4" />
                                    </Button>
                                  </TooltipTrigger>
                                  <TooltipContent>View</TooltipContent>
                                </Tooltip>
                              </TooltipProvider>
                            )}

                            {/* Show track button for CRP and non-CRP */}
                            {o.actions.includes("track") && (
                              <TooltipProvider>
                                <Tooltip>
                                  <TooltipTrigger asChild>
                                    <Button
                                      variant="ghost"
                                      size="icon"
                                      className="text-blue-500 hover:bg-blue-50/50"
                                      onClick={() => handleTrack(row)}
                                    >
                                      <MapPin className="w-4 h-4" />
                                    </Button>
                                  </TooltipTrigger>
                                  <TooltipContent>Track</TooltipContent>
                                </Tooltip>
                              </TooltipProvider>
                            )}
                            {/* Delete Button */}
                            {o.actions.includes("delete") &&
                              userData?.userType !== "CRP" && (
                                <TooltipProvider>
                                  <Tooltip>
                                    <TooltipTrigger asChild>
                                      <Button
                                        variant="ghost"
                                        size="icon"
                                        className="text-red-500 hover:bg-red-50/50"
                                        onClick={() => handleDeleteRow(row)}
                                      >
                                        <Trash2 className="w-4 h-4" />
                                      </Button>
                                    </TooltipTrigger>
                                    <TooltipContent>Delete</TooltipContent>
                                  </Tooltip>
                                </TooltipProvider>
                              )}
                          </div>
                        </TableCell>
                      ) : null;
                    })}
                  </TableRow>
                );
              })
            ) : (
              <TableRow>
                <TableCell
                  colSpan={props.columns.length + 1}
                  className="text-center py-5"
                >
                  <div className="flex items-center justify-center gap-2 text-gray-500">
                    <Database className="w-5 h-5" />
                    No records found matching your criteria
                  </div>
                </TableCell>
              </TableRow>
            )}
          </TableBody>
        </Table>
      </div>

      {/* Table Footer */}
      <div className="flex items-center justify-between mt-4">
        <div className="text-sm text-gray-500">
          Showing {indexOfFirstItem + 1}-
          {Math.min(indexOfLastItem, searchedData.length)} of{" "}
          {searchedData.length} entries
          {selected.length > 0 && (
            <span className="ml-2">
              (<span className="font-semibold text-blue-500">{selected.length}</span>{" "}
              selected)
            </span>
          )}
        </div>

        <div className="flex items-center gap-4">
          <PaginationOptions />

          <div className="flex items-center gap-2">
            <Button
              variant="outline"
              size="icon"
              onClick={handlePrevPage}
              disabled={currentPage === 1}
              className="text-blue-500 hover:bg-blue-50/50"
            >
              <ChevronDown className="w-4 h-4 rotate-90" />
            </Button>
            <span className="text-sm text-gray-700">
              Page {currentPage} of {totalPages || 1}
            </span>
            <Button
              variant="outline"
              size="icon"
              onClick={handleNextPage}
              disabled={currentPage === totalPages || totalPages === 0}
              className="text-blue-500 hover:bg-blue-50/50"
            >
              <ChevronDown className="w-4 h-4 -rotate-90" />
            </Button>
          </div>
        </div>
      </div>
    </div>
  );
};

export default ActionTable;

