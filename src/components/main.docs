const TrackingModal = ({ show, onHide, trackData }) => {
  if (!trackData) return null;

  return (
    <Modal
      show={show}
      onHide={onHide}
      size="lg"
      centered
      aria-labelledby="tracking-modal-title"
      style={{ fontFamily: "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif" }}
    >
      <Modal.Header 
        closeButton 
        style={{
          backgroundColor: '#f8f9fa',
          borderBottom: '1px solid #dee2e6',
          padding: '1rem 1.5rem'
        }}
      >
        <Modal.Title 
          id="tracking-modal-title" 
          style={{
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            width: '100%'
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center' }}>
            <div style={{
              backgroundColor: '#0d6efd',
              width: '40px',
              height: '40px',
              borderRadius: '50%',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              marginRight: '15px'
            }}>
              <FaClipboardList style={{ color: 'white', fontSize: '1.2rem' }} />
            </div>
            <div>
              <h5 style={{ margin: 0, color: '#212529', fontWeight: 600 }}>Claim Tracking</h5>
              <small style={{ color: '#6c757d' }}>Detailed progress of your claim</small>
            </div>
          </div>
          <div style={{
            backgroundColor: '#e9f5ff',
            color: '#0a58ca',
            padding: '0.35rem 0.75rem',
            borderRadius: '20px',
            fontWeight: 500,
            fontSize: '0.85rem'
          }}>
            {trackData.applicationNumber}
          </div>
        </Modal.Title>
      </Modal.Header>
      
      <Modal.Body style={{ padding: '1.5rem', maxHeight: '70vh', overflowY: 'auto' }}>
        <div style={{ position: 'relative', paddingLeft: '30px' }}>
          {/* Vertical timeline */}
          <div style={{
            position: 'absolute',
            left: '45px',
            top: '20px',
            bottom: '20px',
            width: '3px',
            backgroundColor: '#e9ecef',
            borderRadius: '3px'
          }}></div>
          
          {trackData.trackingSteps?.map((step, index) => (
            <div 
              key={index}
              style={{
                position: 'relative',
                marginBottom: '25px',
                paddingLeft: '60px'
              }}
            >
              {/* Timeline dot */}
              <div style={{
                position: 'absolute',
                left: '35px',
                top: '5px',
                width: '20px',
                height: '20px',
                borderRadius: '50%',
                backgroundColor: step.isCurrentStatus ? '#0d6efd' : '#adb5bd',
                border: `3px solid ${step.isCurrentStatus ? '#b6d4fe' : '#e9ecef'`,
                zIndex: 2,
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center'
              }}>
                {step.isCurrentStatus ? (
                  <FaCheckCircle style={{ color: 'white', fontSize: '0.7rem' }} />
                ) : (
                  <FaClock style={{ color: 'white', fontSize: '0.7rem' }} />
                )}
              </div>
              
              {/* Timeline card */}
              <div style={{
                backgroundColor: 'white',
                borderRadius: '8px',
                boxShadow: '0 2px 8px rgba(0,0,0,0.1)',
                borderLeft: `4px solid ${step.isCurrentStatus ? '#0d6efd' : '#dee2e6'}`,
                padding: '1rem',
                transition: 'all 0.3s ease'
              }}>
                <div style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center',
                  marginBottom: '0.5rem'
                }}>
                  <h6 style={{
                    margin: 0,
                    color: step.isCurrentStatus ? '#0d6efd' : '#495057',
                    fontWeight: 600,
                    fontSize: '1rem'
                  }}>
                    {step.step}
                  </h6>
                  <span style={{
                    color: '#6c757d',
                    fontSize: '0.8rem',
                    display: 'flex',
                    alignItems: 'center'
                  }}>
                    <FaClock style={{ marginRight: '5px', fontSize: '0.7rem' }} />
                    {step.date}
                  </span>
                </div>
                
                <p style={{
                  margin: '0.5rem 0',
                  color: '#212529',
                  fontSize: '0.9rem'
                }}>
                  {step.description}
                </p>
                
                {step.comments && (
                  <div style={{
                    backgroundColor: '#f8f9fa',
                    borderLeft: '3px solid #0d6efd',
                    padding: '0.75rem',
                    borderRadius: '4px',
                    marginTop: '0.75rem'
                  }}>
                    <div style={{
                      display: 'flex',
                      alignItems: 'center',
                      marginBottom: '0.25rem'
                    }}>
                      <FaFile style={{ 
                        color: '#6c757d', 
                        fontSize: '0.8rem',
                        marginRight: '5px'
                      }} />
                      <small style={{
                        color: '#6c757d',
                        fontWeight: 500
                      }}>
                        Comments
                      </small>
                    </div>
                    <p style={{
                      margin: 0,
                      color: '#495057',
                      fontSize: '0.85rem'
                    }}>
                      {step.comments}
                    </p>
                  </div>
                )}
                
                <div style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  marginTop: '0.75rem',
                  paddingTop: '0.5rem',
                  borderTop: '1px dashed #dee2e6'
                }}>
                  <small style={{
                    color: '#6c757d',
                    fontSize: '0.75rem',
                    display: 'flex',
                    alignItems: 'center'
                  }}>
                    <span style={{ fontWeight: 500 }}>From:</span> {step.submittedBy}
                  </small>
                  {step.submittedTo && (
                    <small style={{
                      color: '#6c757d',
                      fontSize: '0.75rem',
                      display: 'flex',
                      alignItems: 'center'
                    }}>
                      <span style={{ fontWeight: 500 }}>To:</span> {step.submittedTo}
                    </small>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </Modal.Body>
      
      <Modal.Footer style={{
        backgroundColor: '#f8f9fa',
        borderTop: '1px solid #dee2e6',
        padding: '1rem 1.5rem',
        justifyContent: 'flex-end'
      }}>
        <button 
          onClick={onHide}
          style={{
            backgroundColor: '#0d6efd',
            color: 'white',
            border: 'none',
            borderRadius: '6px',
            padding: '0.5rem 1.25rem',
            fontWeight: 500,
            cursor: 'pointer',
            transition: 'all 0.2s',
            ':hover': {
              backgroundColor: '#0b5ed7'
            }
          }}
        >
          Close
        </button>
      </Modal.Footer>
    </Modal>
  );
};
