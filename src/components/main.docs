
import React, { useState } from "react";
import { Box, Typography, Stack } from "@mui/material";
import Stepper from "../../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import { useForm } from "react-hook-form";
import Invoicing from "../../../common/Invoicing.js";
import PaymentModal from "../../../common/PaymentModal.js"; 
import PreviewPage from "../../../common/PreviewPage";
import { vesselData, previewSections } from "./vesselData";

const NewVesselRegistration = () => {
  const methods = useForm({ mode: "onTouched" });
  const { trigger } = methods;

  // Payment modal state
  const [showModal, setShowModal] = useState(false);
  const [paymentMode, setPaymentMode] = useState("offline");
  const [challanFile, setChallanFile] = useState(null);
  const [showPreview, setShowPreview] = useState(false);
  const [isLoading, setIsLoading] = useState(false);

  const validateVesselDetails = async () => {
    const valid = await trigger();
    return valid;
  };

  const supervisionAuthority = methods.watch("supervisionAuthority");

  const handleChallanUpload = (e) => {
    setChallanFile(e.target.files?.[0] || null);
  };
  
  const handleShowPreview = () => {
    setShowPreview(true);
  };

  const handleOnlinePay = () => {
    setIsLoading(true);
    setShowModal(false);
   
    setTimeout(() => {
      setIsLoading(false);
      setShowPreview(true);
    }, 1500);
  };

  const steps = [
    {
      label: "Vessel Details",
      component: <VesselDetails formMethods={methods} />,
      validate: validateVesselDetails,
    },
    {
      label: "Invoicing",
      component: (
        <Invoicing
          supervisionAuthority={supervisionAuthority}
          onPayNow={() => setShowModal(true)}
        />
      ),
      validate: () => true,
    },
  ];

  const handleSave = () => {
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      setShowPreview(true);
    }, 1500);
  };

  if (showPreview) {
    return (
      <PreviewPage
        data={vesselData}
        sections={previewSections}
        title="Vessel Registration Preview"
        subtitle="Registration details submitted successfully"
        onBack={() => setShowPreview(false)}
        submitButtonText="Take Action"
        onSubmit={() => alert("Taking action...")}
        icons={{ title: "vessel" }}
      />
    );
  }

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {isLoading ? (
        <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
          <div className="text-center">
            <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
              <span className="visually-hidden">Loading...</span>
            </div>
            <p className="mt-3">Processing your request...</p>
          </div>
        </div>
      ) : (
        <>
          <Stack spacing={0.5}>
            <Typography
              sx={{
                fontWeight: 550,
                color: "#2E57A7",
                fontSize: "1.2rem",
              }}
            >
              New Vessel Registration
              &nbsp;
              <span style={{ color: "#666", fontSize: "0.65rem" }}>
                (Fill in the vessel details to complete registration)
              </span>
            </Typography>
          </Stack>
          <Stepper steps={steps} onSave={handleSave} />
          <PaymentModal
            show={showModal}
            onHide={() => setShowModal(false)}
            paymentMode={paymentMode}
            setPaymentMode={setPaymentMode}
            challanFile={challanFile}
            onChallanUpload={handleChallanUpload}
            onOnlinePay={handleOnlinePay}
            isLoading={isLoading}
          />
        </>
      )}
    </Box>
  );
};

export default NewVesselRegistration;


import React, { useState } from "react";
import { useForm } from "react-hook-form";
import { Row, Col, Card, Button, Form } from "react-bootstrap";
import InputText from "../../../common/InputText.tsx";
import InputSelect from "../../../common/InputSelect.tsx";
import InputRadio from "../../../common/InputRadio.tsx";
import InputFile from "../../../common/InputFile";
import { headerStyle } from "../../../../utils/constants.ts";
import Collapsible from "../../../common/Collapsible.js"; // Import the Collapsible component

const MultipleFileUpload = ({
  title,
  description = true,
  required = true,
  register,
  errors,
  setValue,
  clearErrors,
  watch,
}) => {
  const [files, setFiles] = useState([{ id: 1 }]);

  const addFileInput = () => {
    const newId = files.length > 0 ? Math.max(...files.map(f => f.id)) + 1 : 1;
    setFiles([...files, { id: newId }]);
  };

  const removeFileInput = (id) => {
    setFiles(files.filter(file => file.id !== id));
    setValue(`${title.replace(/\s+/g, '')}_file_${id}`, null);
    setValue(`${title.replace(/\s+/g, '')}_desc_${id}`, "");
    clearErrors([`${title.replace(/\s+/g, '')}_file_${id}`, `${title.replace(/\s+/g, '')}_desc_${id}`]);
  };

  return (
    <div className="mb-4">
      <div className="d-flex justify-content-between align-items-center mb-2">
        <h6 className="mb-0">{title}</h6>
        {description && (
          <Button
            variant="primary"
            size="sm"
            onClick={addFileInput}
            style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
          >
            + Add
          </Button>
        )}
      </div>
      {files.map((fileInput, idx) => (
        <Row key={fileInput.id} className="mb-2 align-items-center">
          <Col md={description ? 8 : 12}>
            <InputFile
              label=""
              name={`${title.replace(/\s+/g, '')}_file_${fileInput.id}`}
              register={register(`${title.replace(/\s+/g, '')}_file_${fileInput.id}`)}
              errors={errors}
              value={watch(`${title.replace(/\s+/g, '')}_file_${fileInput.id}`)?.[0]}
              onChange={e => {
                setValue(`${title.replace(/\s+/g, '')}_file_${fileInput.id}`, e.target.files);
                clearErrors(`${title.replace(/\s+/g, '')}_file_${fileInput.id}`);
              }}
            />
          </Col>
          {description && (
            <Col md={4}>
              <InputText
                label=""
                name={`${title.replace(/\s+/g, '')}_desc_${fileInput.id}`}
                placeholder="Description of File"
                register={register(`${title.replace(/\s+/g, '')}_desc_${fileInput.id}`)}
                errors={errors}
                onChange={() => clearErrors(`${title.replace(/\s+/g, '')}_desc_${fileInput.id}`)}
              />
            </Col>
          )}
          {description && files.length > 1 && (
            <Col md={12}>
              <Button
                variant="outline-danger"
                size="sm"
                onClick={() => removeFileInput(fileInput.id)}
                className="mt-2"
              >
                Remove
              </Button>
            </Col>
          )}
        </Row>
      ))}
    </div>
  );
};

const VesselDetails = ({ formMethods }) => {
  const defaultValues = {
    ownerName: "",
    ownerAddress: "",
    mobile: "",
    email: "",
    pan: "",
    aadhar: "",
    tradeLicence: "",
    gst: "",
    grt: "",
    vesselType: "",
    category: "",
    zone: "",
    supervisionAuthority: "",
    purchaseType: "",
    classificationSociety: "",
    constructedBy: "",
    builder: "",
    builderName: "",
    builderAddress: "",
    builderEmail: "",
    builderMobile: "",
    builderTradeLicence: "",
    builderGST: "",
    builderAuth: "",
    authLetter: "",
    workOrderValue: "",
    termsAccepted: false,
    tonnageBooklets: null,
    stabilityBooklets: null,
  };

  const internalFormMethods = useForm({
    defaultValues,
    mode: "onTouched",
  });

  const methods = formMethods || internalFormMethods;

  const {
    register,
    handleSubmit,
    watch,
    setValue,
    clearErrors,
    formState: { errors },
  } = methods;

  const constructedBy = watch("constructedBy");
  const supervisionAuthority = watch("supervisionAuthority");
  const tonnageBooklets = watch("tonnageBooklets");
  const stabilityBooklets = watch("stabilityBooklets");

  const onSubmit = (data) => {
    console.log("Form Submitted:", data);
  };
console.log( "errors in VesselDetails component:", errors);
  return (
    <form onSubmit={handleSubmit(onSubmit)} autoComplete="off">
      {/* Basic Information Collapsible */}
      <Collapsible title="Basic Information" openStat={true}>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label="Name of Owner"
              name="ownerName"
              placeholder="Please enter Name of Owner"
              required
              register={register("ownerName", { required: "Name is required" })}
              errors={errors}
              onChange={() => clearErrors("ownerName")}
            />
          </Col>
          <Col md={4}>
            <InputText
              label="Address of Owner"
              name="ownerAddress"
              placeholder="Please enter Address of Owner"
              required
              register={register("ownerAddress", { required: "Address is required" })}
              errors={errors}
              onChange={() => clearErrors("ownerAddress")}
            />
          </Col>
          <Col md={4}>
            <InputText
              label="Mobile"
              name="mobile"
              placeholder="Please enter Mobile"
              required
              register={register("mobile", { required: "Mobile is required" })}
              errors={errors}
              onChange={() => clearErrors("mobile")}
            />
          </Col>
          <Col md={4}>
            <InputText
              label="Email Id"
              name="email"
              placeholder="Please enter Email Id"
              required
              register={register("email", { required: "Email is required" })}
              errors={errors}
              onChange={() => clearErrors("email")}
            />
          </Col>
          <Col md={4}>
            <InputText
              label="PAN"
              name="pan"
              placeholder="Please enter PAN"
              required
              register={register("pan", { required: "PAN is required" })}
              errors={errors}
              onChange={() => clearErrors("pan")}
            />
          </Col>
          <Col md={4}>
            <InputText
              label="Aadhar"
              name="aadhar"
              placeholder="Please enter Aadhar"
              required
              register={register("aadhar", { required: "Aadhar is required" })}
              errors={errors}
              onChange={() => clearErrors("aadhar")}
            />
          </Col>
        </Row>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label="Trade Licence"
              name="tradeLicence"
              placeholder="Please enter Trade Licence"
              required
              register={register("tradeLicence", { required: "Trade Licence is required" })}
              errors={errors}
              onChange={() => clearErrors("tradeLicence")}
            />
          </Col>
          <Col md={4}>
            <InputText
              label="GST"
              name="gst"
              placeholder="Please enter GST"
              required
              register={register("gst", { required: "GST is required" })}
              errors={errors}
              onChange={() => clearErrors("gst")}
            />
          </Col>
          <Col md={4}>
            <InputText
              label="Gross Tonnage (GRT)"
              name="grt"
              placeholder="Please enter GRT"
              required
              register={register("grt", { required: "GRT is required" })}
              errors={errors}
              onChange={() => clearErrors("grt")}
            />
          </Col>
        </Row>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputSelect
              label="Type of Vessel"
              name="vesselType"
              required= {true}
              options={[
                { value: "new", label: "New Vessel" },
                { value: "old", label: "Old Vessel" },
              ]}
              register={register("vesselType", { required: "vesselType is required" })}

              errors={errors}
              // defaultValue={""}
              value={watch("vesselType") || ""}
              onChange={(value) => {
                setValue("vesselType", value,{ shouldValidate: true });
               
clearErrors("vesselType");
              }
                }
            />
          </Col>
          <Col md={4}>
          <InputSelect
  label="Category"
  name="category"
  required={true}
  options={[
    { value: "A", label: "Category A" },
    { value: "B", label: "Category B" },
    { value: "C", label: "Category C" },
  ]}

  register={register("category", { required: "category is required" })}

  errors={errors}
  value={watch("category") || ""}
  onChange={(value) => {
    setValue("category", value, { shouldValidate: true });
    clearErrors("category");
  }}
/>
          </Col>
          <Col md={4}>
           <InputSelect
  label="Zone"
  name="zone"
  required={true}
  options={[
    { value: "1", label: "Zone 1" },
    { value: "2", label: "Zone 2" },
    { value: "3", label: "Zone 3" },
  ]}

  register={register("zone", { required: "zone is required" })}
  errors={errors}
  value={watch("zone") || ""}
  onChange={(value) => {
    setValue("zone", value, { shouldValidate: true });
    clearErrors("zone");
  }}
/>
          </Col>
          <Col md={4}>
           <InputSelect
  label="Supervision Authority"
  name="supervisionAuthority"
  options={[
    { value: "iwt", label: "IWT" },
    { value: "classificationSociety", label: "Classification Society" },
  ]}
  required={true}

  register={register("supervisionAuthority", { required: "Supervision Authority is required" })}
  errors={errors}
  value={watch("supervisionAuthority") || ""}
  onChange={(value) => {
    setValue("supervisionAuthority", value, { shouldValidate: true });
    clearErrors("supervisionAuthority");
  }}
/>
          </Col>
          <Col md={4}>
          <InputSelect
  label="Purchase Type"
  name="purchaseType"
  options={[
    { value: "new", label: "New" },
    { value: "used", label: "Used" },
  ]}
  required={true}
  register={register("purchaseType", { required: "Purchase Type is required" })}
  errors={errors}
  value={watch("purchaseType") || ""}
  onChange={(value) => {
    setValue("purchaseType", value, { shouldValidate: true });
    clearErrors("purchaseType");
  }}
/>
          </Col>
          <Col md={4}>
            <InputText
              label="Name of the Classification Society"
              name="classificationSociety"
              placeholder="Please enter Name of the Classification Society"
              register={register("classificationSociety")}
              errors={errors}
              onChange={() => clearErrors("classificationSociety")}
            />
          </Col>
        </Row>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={6}>
            <InputRadio
              name="constructedBy"
              label="Constructed By ?"
              options={[
                { label: "Self", value: "1" },
                { label: "Builder", value: "2" },
              ]}
              register={register}
              rules={{ required: "Please select a Contructor Type" }}
              errors={errors}
              onChange={() => clearErrors("constructedBy")}
            />
          </Col>
          {constructedBy === "2" && (
            <Col md={6}>
             <InputSelect
    label="Builder"
    name="builder"
    required
    options={[
      { value: "builder1", label: "Builder 1" },
      { value: "builder2", label: "Builder 2" },
    ]}
    register={register}
    errors={errors}
    value={watch("builder") || ""}
    onChange={(value) => {
      setValue("builder", value, { shouldValidate: true });
      clearErrors("builder");
    }}
  />
            </Col>
          )}
        </Row>
      </Collapsible>

      {/* Builder Details Collapsible  */}
      {constructedBy === "2" && (
        <Collapsible title="Builder Details" openStat={true}>
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label="Builder Name"
                name="builderName"
                required
                placeholder="Please enter Builder Name"
                register={register("builderName", {
                  required: constructedBy === "2" && "Builder Name is required",
                })}
                errors={errors}
                onChange={() => clearErrors("builderName")}
              />
            </Col>
            <Col md={4}>
              <InputText
                label="Builder Address"
                name="builderAddress"
                required
                placeholder="Please enter Builder Address"
                register={register("builderAddress", {
                  required: constructedBy === "2" && "Builder Address is required",
                })}
                errors={errors}
                onChange={() => clearErrors("builderAddress")}
              />
            </Col>
            <Col md={4}>
              <InputText
                label="Builder Email Id"
                name="builderEmail"
                required
                placeholder="Please enter Builder Email Id"
                register={register("builderEmail", {
                  required: constructedBy === "2" && "Builder Email is required",
                  pattern: constructedBy === "2" && {
                    value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                    message: "Invalid email address",
                  },
                })}
                errors={errors}
                onChange={() => clearErrors("builderEmail")}
              />
            </Col>
            <Col md={4}>
              <InputText
                label="Mobile"
                name="builderMobile"
                required
                placeholder="Please enter Mobile"
                register={register("builderMobile", {
                  required: constructedBy === "2" && "Builder Mobile is required",
                  pattern: constructedBy === "2" && {
                    value: /^[0-9]{10}$/,
                    message: "Invalid mobile number",
                  },
                })}
                errors={errors}
                onChange={() => clearErrors("builderMobile")}
              />
            </Col>
            <Col md={4}>
              <InputText
                label="Trade Licence"
                name="builderTradeLicence"
                required
                placeholder="Please enter Trade Licence"
                register={register("builderTradeLicence", {
                  required: constructedBy === "2" && "Builder Trade Licence is required",
                })}
                errors={errors}
                onChange={() => clearErrors("builderTradeLicence")}
              />
            </Col>
            <Col md={4}>
              <InputText
                label="GST"
                name="builderGST"
                required
                placeholder="Please enter GST"
                register={register("builderGST", {
                  required: constructedBy === "2" && "Builder GST is required",
                })}
                errors={errors}
                onChange={() => clearErrors("builderGST")}
              />
            </Col>
            <Col md={4}>
               <InputSelect
    label="Builder Authorization"
    name="builderAuth"
    required
    options={[
      { value: "auth", label: "Authorized" },
      { value: "rejected", label: "Rejected" },
    ]}
    register={register}
    errors={errors}
    value={watch("builderAuth") || ""}
    onChange={(value) => {
      setValue("builderAuth", value, { shouldValidate: true });
      clearErrors("builderAuth");
    }}
  />
            </Col>
            <Col md={4}>
              <InputFile
                label="Authorisation Letter"
                name="authLetter"
                required={constructedBy === "2"}
                placeholder="Please upload Authorisation Letter"
                register={register("authLetter", {
                  required: constructedBy === "2" && "Authorization Letter is required",
                })}
                errors={errors}
                value={watch("authLetter")?.[0]}
                onChange={e => {
                  setValue("authLetter", e.target.files);
                  clearErrors("authLetter");
                }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label="Work Order Value"
                name="workOrderValue"
                required
                placeholder="Enter Work Order Value"
                register={register("workOrderValue", {
                  required: constructedBy === "2" && "Work Order Value is required",
                  pattern: constructedBy === "2" && {
                    value: /^[0-9]+$/,
                    message: "Please enter a valid number",
                  },
                })}
                errors={errors}
                onChange={() => clearErrors("workOrderValue")}
              />
            </Col>
          </Row>
        </Collapsible>
      )}

      {/* Documents Collapsible */}
      <Collapsible title="Documents" openStat={true}>
        <Row className="gy-4">
         
          <Col md={6}>
            <MultipleFileUpload
              title="Work Order"
              required={false}
              register={register}
              errors={errors}
              setValue={setValue}
              clearErrors={clearErrors}
              watch={watch}
            />
          </Col>
          <Col md={6}>
            <MultipleFileUpload
              title="Drawings"
              required={false}
              register={register}
              errors={errors}
              setValue={setValue}
              clearErrors={clearErrors}
              watch={watch}
            />
          </Col>
        </Row>
        <Row className="gy-4 mt-2">
       
          <Col md={6}>
            <InputFile
              label="Tonnage Booklets"
              name="tonnageBooklets"
              register={register("tonnageBooklets")}
              errors={errors}
              value={tonnageBooklets?.[0]}
              onChange={e => {
                setValue("tonnageBooklets", e.target.files);
                clearErrors("tonnageBooklets");
              }}
            />
          </Col>
          <Col md={6}>
            <InputFile
              label="Stability Booklets"
              name="stabilityBooklets"
              register={register("stabilityBooklets")}
              errors={errors}
              value={stabilityBooklets?.[0]}
              onChange={e => {
                setValue("stabilityBooklets", e.target.files);
                clearErrors("stabilityBooklets");
              }}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Declaration Collapsible */}
      <Collapsible title="Declaration" openStat={true}>
        <Form.Group className="mb-0 d-flex align-items-center">
          <Form.Check
            type="checkbox"
            id="termsAccepted"
            className="me-2"
            {...register("termsAccepted", {
              required: "You must accept the terms and conditions",
            })}
            isInvalid={!!errors.termsAccepted}
            onChange={() => clearErrors("termsAccepted")}
          />
          <Form.Label
            htmlFor="termsAccepted"
            className="mb-0"
            style={{ fontWeight: 500, color: "#333", cursor: "pointer" }}
          >
            I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.
          </Form.Label>
          {errors.termsAccepted && (
            <Form.Control.Feedback type="invalid" style={{ display: "block" }}>
              {errors.termsAccepted.message}
            </Form.Control.Feedback>
          )}
        </Form.Group>
      </Collapsible>
    </form>
  );
};

export default VesselDetails;
