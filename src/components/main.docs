const SurveyorContent = () => {
  const [surveyData, setSurveyData] = useState([]);
  const [filteredSurveyData, setFilteredSurveyData] = useState([]);
  const [currentPage, setCurrentPage] = useState(1);
  const [searchTerm, setSearchTerm] = useState("");
  const itemsPerPage = 5;
  const [isChartModalOpen, setIsChartModalOpen] = useState(false);
  const [selectedDate, setSelectedDate] = useState(new Date().toISOString().split('T')[0]);
  const [isLoading, setIsLoading] = useState(true);

  // Load data on component mount
  useEffect(() => {
    const loadData = async () => {
      try {
        setIsLoading(true);
        // Simulate API call delay
        await new Promise(resolve => setTimeout(resolve, 500));
        const data = generateSurveyData();
        setSurveyData(data);
        setFilteredSurveyData(data);
      } catch (error) {
        console.error("Error loading survey data:", error);
      } finally {
        setIsLoading(false);
      }
    };
    
    loadData();
  }, []);

  // Filter data when search term changes
  useEffect(() => {
    if (!searchTerm) {
      setFilteredSurveyData(surveyData);
      return;
    }

    const lowerCaseSearch = searchTerm.toLowerCase();
    const results = surveyData.filter(
      (item) =>
        item.id?.toLowerCase().includes(lowerCaseSearch) ||
        item.surveyType?.toLowerCase().includes(lowerCaseSearch) ||
        item.vesselName?.toLowerCase().includes(lowerCaseSearch) ||
        item.vesselType?.toLowerCase().includes(lowerCaseSearch) ||
        item.status?.toLowerCase().includes(lowerCaseSearch)
    );
    
    setFilteredSurveyData(results);
    setCurrentPage(1);
  }, [searchTerm, surveyData]);

  // ... rest of your component code ...

  return (
    <>
      {/* Status cards code... */}

      <Card className="bg-transparent mt-4 dashboard-card">
        <Card.Header className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap">
          <div className="d-flex align-items-center">
            <h5 className="mb-0 me-2">Survey Applications</h5>
            {!isLoading && (
              <span className="badge bg-primary rounded-pill">
                {filteredSurveyData.length}
              </span>
            )}
          </div>
          {/* Search/filter code... */}
        </Card.Header>

        <div style={{ position: "relative", bottom: "2rem" }}>
          {isLoading ? (
            <div className="text-center py-5">
              <div className="spinner-border text-primary" role="status">
                <span className="visually-hidden">Loading...</span>
              </div>
              <p className="mt-2">Loading survey data...</p>
            </div>
          ) : (
            <ActionTable
              columns={SURVEY_TABLE_COLUMNS}
              rowData={filteredSurveyData}
              tableHeader={null}
              hideExportBtn={true}
              hideSearchBar={true}
              pagination={true}
              currentPage={currentPage}
              itemsPerPage={itemsPerPage}
              onPageChange={handleTablePageChange}
              noDataText={
                <div className="no-results text-center py-4">
                  <BsSearch size={24} className="mb-2" />
                  <p>No survey data found</p>
                  <small>
                    {searchTerm ? (
                      'Try adjusting your search query'
                    ) : (
                      'No surveys available at the moment'
                    )}
                  </small>
                </div>
              }
            />
          )}
        </div>
      </Card>

      {/* Modal code... */}
    </>
  );
};
