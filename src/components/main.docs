.form-stepper {
  max-width: 1200px;
  margin: 0 auto;
}

.required-asterisk {
  color: red;
}

.form-text {
  font-size: 0.875em;
  margin-top: 0.25rem;
}

.btn-sm {
  padding: 0.25rem 0.5rem;
  font-size: 0.875rem;
}

.border {
  border: 1px solid #ddd;
}

.rounded {
  border-radius: 0.25rem;
}

.mb-4 {
  margin-bottom: 1.5rem !important;
}

.g-3 {
  gap: 1rem;
}
