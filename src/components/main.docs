.suggestionCard {
    position: absolute;
    z-index: 1000;
    max-height: 200px;
    overflow-y: auto;
    left: 0.5%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.suggestionItem {
    cursor: pointer;
    font-size: 0.875rem;
}

.suggestionItem:hover {
    background-color: #80bdff;
}

.declaration-wrapper {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 12px;
  padding: 1.5rem;
  border: 2px solid #e3f2fd;
}

.declaration-content {
  background: white;
  padding: 1.5rem;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.declaration-text {
  font-size: 1rem;
  line-height: 1.8;
  color: #333;
}

.highlight-field {
  background: linear-gradient(120deg, #2466BF 0%, #1976d2 100%);
  color: white;
  padding: 2px 8px;
  border-radius: 4px;
  
  font-weight: bold !important;
  display: inline-block;
  margin: 0 2px;
  font-style: italic !important; 
}

.highlight-field.auto-populated {
  font-weight:bold !important;
  font-style: italic !important;
  background: linear-gradient(120deg, #1976d2 0%, #0d47a1 100%);
}

.editable-field {
  background: linear-gradient(120deg, #28a745 0%, #20c997 100%) !important;
  cursor: pointer;
  transition: all 0.3s ease;
  font-weight: bold!important; 
  font-style: italic;
}

.editable-field:hover {
  transform: translateY(-1px);
  box-shadow: 0 2px 4px rgba(40, 167, 69, 0.3);
}

.declaration-text p {
  text-align: justify;
  margin-bottom: 1rem;
}

