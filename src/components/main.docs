const renderActionButton = () => {
  if (viewMode) {
    return activeStep === totalSteps - 1 ? (
      actionComponent || (
        <>
          {showOfficerActions && ( // Add this condition
            <>
              {displayProvision && (
                <>
                  <Button
                    variant="contained"
                    sx={buttonStyle}
                    onClick={() => handleProvisionModalOpen("survey")}
                  >
                    Provisional Certificate of Survey
                  </Button>
                  <Button
                    variant="contained"
                    sx={buttonStyle}
                    onClick={() => handleProvisionModalOpen("registration")}
                  >
                    PROVISIONAL CERTIFICATE OF REGISTRATION
                  </Button>
                </>
              )}
              <Button
                variant="contained"
                sx={buttonStyle}
                onClick={handleSave}
              >
                Save
              </Button>
            </>
          )}
          <Button
            variant="contained"
            sx={buttonStyle}
            onClick={() => navigate("/dashboard")}
          >
            Close
          </Button>
        </>
      )
    ) : (
      <Button variant="contained" sx={buttonStyle} onClick={handleNext}>
        {t("Next")}
      </Button>
    );
  }

  // ... rest of the existing code remains the same ...
};
