import React, { useState } from 'react';
import "./Register.css";
import { useForm } from "react-hook-form";
import { Link, useNavigate } from 'react-router-dom';
import { ToastContainer, toast } from 'react-toastify';
import 'react-toastify/dist/ReactToastify.css';

const Register = () => {
  const navigate = useNavigate();
  const [otpSent, setOtpSent] = useState(false);
  const [otp, setOtp] = useState("");
  const [loading, setLoading] = useState(false);
  const [selectedRadio, setSelectedRadio] = useState("individual");

  const {
    register,
    handleSubmit,
    watch,
    reset,
    formState: { errors },
  } = useForm({
    defaultValues: {
      firstName: "",
      lastName: "",
      email: "",
      mobilenumber: "",
      aadhar: "",
      pancard: "",
      cinNumber: "",
      tanNumber: "",
      userType: "individual", 
    },
  });

  const formValues = watch();

  const isFormComplete = () => {
    if (selectedRadio === "individual") {
      return (
        formValues.firstName &&
        formValues.lastName &&
        formValues.email &&
        formValues.mobilenumber &&
        formValues.aadhar &&
        formValues.pancard
      );
    } else {
      return (
        formValues.firstName &&
        formValues.lastName &&
        formValues.email &&
        formValues.mobilenumber &&
        formValues.cinNumber &&
        formValues.tanNumber &&
        formValues.pancard
      );
    }
  };

  const handleSendOTP = async () => {
    setLoading(true);

    // Simulate OTP sending
    setTimeout(() => {
      toast.success("OTP Sent", { position: 'top-right' });
      setOtpSent(true); // Show OTP input box
      setLoading(false);
    }, 1000);
  };

  const onSubmit = async (data) => {
    if (!otp) {
      toast.error("Please enter the OTP");
      return;
    }

    if (otp !== "123456") {
      toast.error("Invalid OTP. Please enter the correct OTP.");
      return;
    }

    // Prepare payload
    const payload = {
      firstName: data.firstName,
      lastName: data.lastName,
      email: data.email,
      mobilenumber: data.mobilenumber,
      pancard: data.pancard,
      userType: selectedRadio === "individual" ? "INDV" : "CORP",
      ...(selectedRadio === "individual" 
        ? { aadhar: data.aadhar }
        : { 
            cinNumber: data.cinNumber,
            tanNumber: data.tanNumber 
          }
      )
    };

    console.log("Registration Payload:", payload);
    toast.success("Registration successful!", { position: 'top-right' });

    // Reset form and OTP state
    reset();
    setOtp("");
    setOtpSent(false);

    // Navigate to login after a delay
    setTimeout(() => {
      navigate("/login");
    }, 1000);
  };

  return (
    <div className='register-page'>
      <div className="register-container">
        <div className="register-header">
          <div className="register-textmain">Register</div>
        </div>
        <form className="register-form" onSubmit={handleSubmit(onSubmit)}>
          <div className="radio-options">
            <div className={`radio-op ${selectedRadio === "individual" ? "active" : ""}`}>
              <input
                type="radio"
                id="individual"
                name="userType"
                value="individual"
                checked={selectedRadio === "individual"}
                onChange={() => setSelectedRadio("individual")}
              />
              <label htmlFor="individual">Individual</label>
            </div>
            <div className={`radio-op ${selectedRadio === "corporate" ? "active" : ""}`}>
              <input
                type="radio"
                id="corporate"
                name="userType"
                value="corporate"
                checked={selectedRadio === "corporate"}
                onChange={() => setSelectedRadio("corporate")}
              />
              <label htmlFor="corporate">Corporate</label>
            </div>
          </div>

          <div className="form-grid">
            <div className="form-column">
              <input
                type="text"
                {...register("firstName", { required: true })}
                placeholder="First Name"
                className="user-input"
              />
              {errors.firstName && <span className="error">First Name is required</span>}
              
              <input
                type="text"
                {...register("lastName", { required: true })}
                placeholder="Last Name"
                className="user-input"
              />
              {errors.lastName && <span className="error">Last Name is required</span>}

              <input
                type="email"
                {...register("email", { 
                  required: "Email is required",
                  pattern: {
                    value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                    message: "Invalid email address"
                  }
                })}
                placeholder="Email Address"
                className="user-input"
              />
              {errors.email && <span className="error">{errors.email.message}</span>}

              {selectedRadio === "individual" ? (
                <input
                  type="text"
                  {...register("aadhar", { 
                    required: "Aadhar number is required",
                    pattern: {
                      value: /^[2-9]{1}[0-9]{11}$/,
                      message: "Invalid Aadhar number"
                    }
                  })}
                  placeholder="Aadhar Number"
                  className="user-input"
                />
              ) : (
                <>
                  <input
                    type="text"
                    {...register("cinNumber", { 
                      required: "CIN is required",
                      pattern: {
                        value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
                        message: "Invalid CIN format (e.g., U12345AB6789CDE12345)"
                      }
                    })}
                    placeholder="CIN Number"
                    className="user-input"
                  />
                  {errors.cinNumber && <span className="error">{errors.cinNumber.message}</span>}
                  
                  <input
                    type="text"
                    {...register("tanNumber", { 
                      required: "TAN is required",
                      pattern: {
                        value: /^[A-Z]{4}[0-9]{5}[A-Z]{1}$/,
                        message: "Invalid TAN format (e.g., ABCD12345E)"
                      }
                    })}
                    placeholder="TAN Number"
                    className="user-input"
                  />
                  {errors.tanNumber && <span className="error">{errors.tanNumber.message}</span>}
                </>
              )}
              {selectedRadio === "individual" && errors.aadhar && (
                <span className="error">{errors.aadhar.message}</span>
              )}
            </div>
            
            <div className="form-column">
              <input
                type="text"
                {...register("pancard", { 
                  required: "PAN is required",
                  pattern: {
                    value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
                    message: "Invalid PAN format (e.g., ABCDE1234F)"
                  }
                })}
                placeholder="Pancard Number"
                className="user-input"
              />
              {errors.pancard && <span className="error">{errors.pancard.message}</span>}

              <input
                type="text"
                {...register("mobilenumber", { 
                  required: "Mobile number is required",
                  pattern: {
                    value: /^[6-9][0-9]{9}$/,
                    message: "Invalid Indian mobile number"
                  }
                })}
                placeholder="Mobile Number"
                className="user-input"
              />
              {errors.mobilenumber && <span className="error">{errors.mobilenumber.message}</span>}
            </div>
          </div>

          {/* OTP Section */}
          {!otpSent && (
            <button
              type="button"
              className="send-otp-btn"
              onClick={handleSendOTP}
              disabled={!isFormComplete() || loading}
            >
              {loading ? "Sending OTP..." : "Send OTP"}
            </button>
          )}

          {otpSent && (
            <div className="otp-verification">
              <input
                type="text"
                placeholder="Enter OTP"
                value={otp}
                onChange={(e) => setOtp(e.target.value)}
                className="user-input"
              />
            </div>
          )}

          {/* Register Button */}
          <button
            type="submit"
            className={`register-btn ${!otpSent || otp !== "123456" || loading ? 'disabled' : ''}`}
            disabled={!otpSent || otp !== "123456" || loading}
          >
            {loading ? "Registering..." : "Register"}
          </button>
        </form>

        {/* Login Link */}
        <p className="login-link">
          Already have an account? <Link to="/login">Login here</Link>
        </p>
      </div>
      <ToastContainer />
    </div>
  );
};

export default Register;
.register-page {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  width: 100vw;
  background-image: url("../../assests/images/Backgroundlogin.jpg");
  padding: 20px;
  box-sizing: border-box;
}

.register-container {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 400px;
  padding: 20px;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0px 6px 30px rgba(0, 0, 0, 0.2);
  border-radius: 16px;
  animation: slideIn 0.5s ease-in-out;
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.register-header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
}

.register-textmain {
  font-size: 20px;
  font-weight: 700;
  color: #269ccc;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.radio-options {
  display: flex;
  justify-content: space-between;
  padding: 8px;
  background: #f3f3f3;
  border-radius: 30px;
  margin-bottom: 10px;
  gap: 8px;
}

.radio-op {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px 12px;
  border-radius: 24px;
  cursor: pointer;
  flex: 1;
  transition: all 0.3s ease;
  text-align: center;
  font-size: 12px; 
  font-weight: 500;
  background: #f3f3f3;
}

.radio-op input[type="radio"] {
  display: none;
}

.radio-op label {
  width: 100%;
  cursor: pointer;
  text-align: center;
  color: #333;
}

.radio-op input[type="radio"]:checked + label {
  background-color: #269ccc;
  color: white;
  border-radius: 24px;
  padding: 6px;
}

.register-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.user-input {
  width: 100%;
  padding: 6px;
  border: 2px solid #e6e6e6;
  border-radius: 8px;
  font-size: 12px; 
  outline: none;
  transition: border-color 0.3s ease;
  margin-bottom: 6px; 
  box-sizing: border-box;
}

.user-input:focus {
  border-color: #269ccc;
}

.send-otp-btn,
.register-btn {
  width: 100%;
  padding: 8px;
  border: none;
  border-radius: 8px;
  font-size: 12px; 
  font-weight: 600;
  color: white;
  background-color: #269ccc;
  cursor: pointer;
  transition: all 0.3s ease;
  margin-top: 8px;
}

.send-otp-btn:hover,
.register-btn:hover {
  background-color: #269ccc;
  transform: scale(1.02);
}

.send-otp-btn:disabled,
.register-btn:disabled {
  background-color: #cccccc;
  cursor: not-allowed;
}

.otp-verification input {
  width: 100%;
  padding: 6px; 
  border: 2px solid #e6e6e6;
  border-radius: 8px;
  font-size: 12px;
  outline: none;
  transition: border-color 0.3s ease;
  margin-bottom: 6px;
  box-sizing: border-box;
}

.login-link {
  font-size: 12px; 
  color: #333;
  text-align: center;
  margin-top: 10px;
  cursor: pointer;
  transition: color 0.3s ease;
}

.login-link a {
  color: #269ccc;
  font-weight: 600;
  text-decoration: none;
}

.login-link a:hover {
  text-decoration: underline;
}

.error {
  color: red;
  font-size: 11px; 
  margin-bottom: 6px; 
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Responsive Adjustments */
@media (max-width: 768px) {
  .register-container {
    padding: 15px;
    max-width: 90%;
    margin: 0 auto;
    border-radius: 12px;
  }

  .register-textmain {
    font-size: 18px; 
  }

  .radio-options {
    flex-direction: column;
    gap: 8px;
    padding: 6px;
  }

  .radio-op {
    padding: 6px 10px;
    font-size: 11px;
  }

  .user-input {
    padding: 5px; 
    font-size: 11px; 
  }

  .send-otp-btn,
  .register-btn {
    padding: 6px;
    font-size: 11px; 
  }
}

@media (max-width: 480px) {
  .register-container {
    padding: 10px;
    border-radius: 10px;
  }

  .register-textmain {
    font-size: 16px;
  }

  .radio-op {
    padding: 5px 8px;
    font-size: 10px; 
  }

  .user-input {
    padding: 4px; 
    font-size: 10px; 
  }

  .send-otp-btn,
  .register-btn {
    padding: 5px;
    font-size: 10px;
  }
}
