<div className="d-flex mt-4 justify-content-center gap-3 flex-wrap">
  <Button 
    variant="success" 
    onClick={handleDownloadReceipt}
    disabled={downloadLoading || !txnId}
    style={{
      backgroundColor: "#28a745",
      borderColor: "#28a745",
      padding: "10px 20px",
      fontWeight: "500"
    }}
  >
    {downloadLoading ? (
      <Spinner animation="border" size="sm" className="me-2" />
    ) : (
      <FileDownload className="me-2" />
    )}
    {downloadLoading ? "Generating..." : "Download Receipt"}
  </Button>
  <Button 
    variant="outline-secondary" 
    onClick={goHome}
    style={{
      borderColor: "#6c757d",
      color: "#6c757d",
      padding: "10px 20px",
      fontWeight: "500",
      transition: "all 0.3s ease"
    }}
    onMouseEnter={(e) => {
      e.target.style.backgroundColor = "#6c757d";
      e.target.style.color = "#fff";
    }}
    onMouseLeave={(e) => {
      e.target.style.backgroundColor = "transparent";
      e.target.style.color = "#6c757d";
    }}
  >
    <ArrowBack className="me-2" />
    Go Back
  </Button>
</div>
