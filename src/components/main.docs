// In your VesselBuilderRegistrationPage component, update the validateStep function:
const validateStep = async () => {
  const currentFields = getCurrentStepFields();
  const requiredFields = currentFields
    .filter(field => field.required && (!field.showIf || field.showIf()));

  // First validate all required fields
  const validationResults = await Promise.all(
    requiredFields.map(field => trigger(field.name))
  );

  // Check if all validations passed
  const isStepValid = validationResults.every(result => result);

  if (!isStepValid) {
    // Find the first error and scroll to it
    const firstErrorField = requiredFields.find(field => errors[field.name]);
    if (firstErrorField) {
      const element = document.getElementById(firstErrorField.name);
      if (element) {
        element.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      setValidationMessage("Please fill all required fields correctly");
    }
    return false;
  }

  return true;
};

// And update your onSubmit function to ensure all files are properly included:
const onSubmit = (data) => {
  const finalData = { ...formData, ...data };
  finalData.userCategory = 'Ship-Builder';
  finalData.userType = 'Builder';
  
  // Validate required files
  const requiredFiles = formFields.step2
    .filter(field => field.type === 'file' && field.required)
    .map(field => field.name);
  
  const missingFiles = requiredFiles.filter(fileName => !finalData[fileName]);
  
  if (missingFiles.length > 0) {
    missingFiles.forEach(fileName => {
      setError(fileName, {
        type: 'required',
        message: `${fileName} is required`
      });
    });
    setValidationMessage("Please upload all required documents");
    setCurrentStep(2); // Go back to documents step
    window.scrollTo(0, 0);
    return;
  }

  const formDetails = mapToVesselUserDetails({ ...finalData });
  
  const filesToUpload = [
    finalData?.companyDetails,
    finalData?.gstCertificate,
    finalData?.panCardUpload,
    finalData?.factoryLicense,
    finalData?.addressProof,
    finalData?.fireCertificate,
    finalData?.esipfRegistration,
    finalData?.iso9001,
    finalData?.iso14001,
    finalData?.iso45001,
    finalData?.pollutionCertificate,
    finalData?.experienceCertificate
  ].filter(file => file); 

  const fd = new FormData();
  fd.append("request", new Blob([JSON.stringify(formDetails)], { type: 'application/json' }));
  filesToUpload?.forEach((file) => {
    if (file) {
      fd.append(`files`, file);
    }
  });
  submitUserDetails(fd);
};
