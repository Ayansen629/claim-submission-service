<Card.Body>
  <div className="dashboard-stats-grid">
    {getStatData().map((item, index) => (
      <div key={index} className="dashboard-stat-cell">
        {item.isCalendar ? (
          <SurveyTrackerCard events={item.events} color={item.color} />
        ) : (
          <StatusCard {...item} />
        )}
      </div>
    ))}
  </div>
</Card.Body>
