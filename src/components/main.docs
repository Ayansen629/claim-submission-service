import React, { useRef, useState } from "react";
import { useNavigate, useParams } from "react-router-dom";
import { useForm, useFieldArray, Controller } from "react-hook-form";
import { Container, Row, Col, Card, Button } from "react-bootstrap";
import { toast } from "react-toastify";
import axios from "axios";
import {
  FaUser,
  FaMapMarkerAlt,
  FaBriefcase,
  FaFileUpload,
  FaGraduationCap,
  FaPlus,
  FaTrash,
  FaArrowLeft,
} from "react-icons/fa";
import InputText from "../../../common/InputText.tsx";
import { handleErrorMessage } from "../../../../utils/errorMessageHandler.js";
import InputSelect from "../../../common/InputSelect.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { CONSTANT_REGEX } from "../../../../utils/constants.ts";
import { useMasterData } from "../../../context/MasterDataContext.js";
import NewLoader from "../../../common/NewLoader.js";
import "./EmployeeRegistration.css";
import { getData, postFORMdata } from "../../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import AppToggleButton from "../../../common/AppToggleButton.js";

const EmployeeRegistration = () => {
  const navigate = useNavigate();
  const { id } = useParams();
  const isEditMode = !!id;
  const loaderRef = useRef();
  const { masterData } = useMasterData();

  const {
    register,
    handleSubmit,
    control,
    formState: { errors },
    setValue,
    watch,
    reset,
  } = useForm({
    mode: "onSubmit",
    defaultValues: {
      firstName: "",
      lastName: "",
      email: "",
      phoneNumber: "",
      gender: "",
      dateOfBirth: "",
      addressLine1: "",
      addressLine2: "",
      pin: "",
      district: "",
      stateUt: "",
      country: "India",
      appointmentDate: "",
      employeeType: "",
      designation: "",
      addressProof: "",
      identityProof: "",
      appointmentLetter: "",
      educationDetails: [{ qualification: "", stream: "", yearOfPassing: "" }],
      professionalDetails: [
        {
          appointmentDate: "",
          employeeType: "",
          employeeStatus: "",
          designation: "",
          department: "",
          section: "",
          roles: "",
        },
      ],
    },
  });
  const [addressProofFile, setAddressProofFile] = useState(null);
  const [identityProofFile, setIdentityProofFile] = useState(null);
  const [appointmentLetterFile, setAppointmentLetterFile] = useState(null);

  const { fields, append, remove } = useFieldArray({
    control,
    name: "educationDetails",
  });

  const {
    fields: professionalFields,
    append: appendProfessional,
    remove: removeProfessional,
  } = useFieldArray({
    control,
    name: "professionalDetails",
  });

  const fetchAddressDetails = async (pin) => {
    try {
      const URL =
        process.env.REACT_APP_PUBLIC_URL +
        URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE +
        pin;
      const response = await getData(URL);
      if (response?.status === 200 && response?.data?.length > 0) {
        setValue("district", response?.data[0]?.district);
        setValue("stateUt", response?.data[0]?.stateName);
        setValue("country", "India");
      } else {
        setValue("district", "");
        setValue("stateUt", "");
        setValue("country", "");
        toast.info("No data found for this PIN code");
      }
      loaderRef.current?.hide();
    } catch (error) {
      setValue("district", "");
      setValue("stateUt", "");
      setValue("country", "");
      loaderRef.current?.hide();
      toast.error("Error fetching address details");
    }
  };

  const onSubmit = async (data) => {
    try {
      loaderRef.current?.show();

      const vesselUserDetails = {
        id: "",
        userType: "",
        userCategory: "",
        firstName: data.firstName,
        lastName: data.lastName,
        emailId: data.email,
        phoneNumber: data.phoneNumber,
        panNumber: data.panNumber || "",
        gstNumber: data.gstNumber || "",
        addressDetails: data.addressLine1 + (data.addressLine2 ? ", " + data.addressLine2 : ""),
        addressLine1: data.addressLine1,
        addressLine2: data.addressLine2,
        pin: data.pin,
        district: data.district,
        stateUt: data.stateUt,
        country: data.country,
        isActive: data?.isActive,
        keycloakId: "",
        dateOfBirth: data.dateOfBirth,
        gender: data.gender,
        authorizedPerson: null,
        companyRegistration: null,
        educationDetails: data?.educationDetails?.map((ed) => ({
          uuid: "",
          employeeUUID: "",
          qualification: ed.qualification,
          stream: ed.stream,
          yearOfPassing: ed.yearOfPassing,
          additionalEducationDetails: ed.additionalEducationDetails || "",
        })),
        professionalDetails: data?.professionalDetails?.map((pd) => ({
          uuid: "",
          employeeUUID: "",
          appointmentDate: pd.appointmentDate,
          employeeType: pd.employeeType,
          employeeStatus: pd.employeeStatus,
          designation: pd.designation,
          department: pd.department,
          section: pd.section,
          role: pd.roles,
        })),
        aadharNumber: data.aadharNumber || "",
      };

      const formData = new FormData();
      formData.append("request", new Blob([JSON.stringify(vesselUserDetails)], { type: 'application/json' }));

      if (addressProofFile) {
        formData.append("files", addressProofFile);
      }
      if (identityProofFile) {
        formData.append("files", identityProofFile);
      }
      if (appointmentLetterFile) {
        formData.append("files", appointmentLetterFile);
      }
      
      await submitEmpDetails(formData);

    } catch (error) {
      loaderRef.current?.hide();
      toast.error(
        error?.response?.data?.message ||
        "Error submitting form. Please try again."
      );
    }
  };

  const submitEmpDetails = async (payload) => {
    try {
      const URL = process.env.REACT_APP_AUTH_URL + URLS_ENDPOINT.USER_SERVICE.CREATE_EMP;
      loaderRef.current?.show();
      const response = await postFORMdata(URL, payload);
      const apiRes = response?.data ? { ...response?.data } : null;
      if (apiRes?.responseStatus?.status === "200") {
        loaderRef?.current?.hide();
        toast.success(
          apiRes?.responseStatus?.message || "Employee registered successfully!",
          { position: "top-right" }
        );
        handleCancel();
      } else {
        loaderRef?.current?.hide();
        toast.info(
          apiRes?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const handleCancel = () => {
    navigate("/iwt/employee-management");
  };

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="p-4">
        <Card className="mb-4">
          <Card.Header
            className="bg-primary text-white d-flex align-items-center justify-content-center position-relative"
            style={{
              minHeight: 56,
              background: "linear-gradient(135deg, rgb(0, 119, 182), rgb(2, 62, 138))",
              border: "none",
            }}
          >
            <Button
              variant="link"
              className="p-0 me-2"
              style={{
                color: "white",
                textDecoration: "none",
                position: "absolute",
                left: 0,
                top: "50%",
                transform: "translateY(-50%)",
              }}
              onClick={() => navigate("/iwt/employee-management")}
            >
              <FaArrowLeft size={22} />
            </Button>
            <div style={{ fontWeight: 600, fontSize: 22, color: "#fff" }}>
              {isEditMode ? "Edit Employee" : "Add Employee"}
            </div>
            <div style={{ width: 40 }}></div>
          </Card.Header>
          <Card.Body>
            <form onSubmit={handleSubmit(onSubmit)} className="employee-form">
              {/* Personal Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaUser className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>Personal Details</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="firstName"
                          label="First Name"
                          placeholder="Enter first name"
                          required={true}
                          register={{
                            ...register("firstName", {
                              required: "First Name is required",
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="lastName"
                          label="Last Name"
                          placeholder="Enter last name"
                          required={true}
                          register={{
                            ...register("lastName", {
                              required: "Last Name is required",
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="email"
                          label="Email ID"
                          type="email"
                          placeholder="Enter email address"
                          required={true}
                          register={{
                            ...register("email", {
                              required: "Email is required",
                              pattern: {
                                value: CONSTANT_REGEX.EMAIL,
                                message: "Invalid email address",
                              },
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="phoneNumber"
                          label="Phone Number"
                          placeholder="Enter 10-digit phone number"
                          required={true}
                          register={{
                            ...register("phoneNumber", {
                              required: "Phone Number is required",
                              pattern: {
                                value: CONSTANT_REGEX.MOBILE,
                                message: "Phone number must be 10 digits",
                              },
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <Controller
                          name="gender"
                          control={control}
                          rules={{ required: "Gender is required" }}
                          render={({ field, fieldState: { error } }) => (
                            <InputSelect
                              {...field}
                              name="gender"
                              label="Gender *"
                              required={true}
                              options={[
                                { value: "", label: "Select Gender" },
                                ...(masterData?.genders?.map((type) => ({
                                  value: type.valueCode,
                                  label: type.valueLabel,
                                })) || [
                                    { value: "male", label: "Male" },
                                    { value: "female", label: "Female" },
                                    { value: "other", label: "Other" },
                                  ]),
                              ]}
                              error={error?.message}
                              value={field.value}
                              onChange={(value) => field.onChange(value)}
                              isInvalid={!!error}
                            />
                          )}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="dateOfBirth"
                          label="Date of Birth"
                          type="date"
                          placeholder="Select date of birth"
                          required={true}
                          register={{
                            ...register("dateOfBirth", {
                              required: "Date of Birth is required",
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Address Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaMapMarkerAlt className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>Address Details</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={6}>
                        <InputText
                          name="addressLine1"
                          label="Address Line-1"
                          placeholder="Enter address line 1"
                          required={true}
                          register={{
                            ...register("addressLine1", {
                              required: "Address Line-1 is required",
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={6}>
                        <InputText
                          name="addressLine2"
                          label="Address Line-2"
                          placeholder="Enter address line 2 (optional)"
                          register={{
                            ...register("addressLine2"),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="pin"
                          label="PIN"
                          placeholder="Enter 6-digit PIN code"
                          required={true}
                          register={{
                            ...register("pin", {
                              required: "PIN Code is required",
                              pattern: {
                                value: /^[0-9]{6}$/,
                                message: "PIN must be 6 digits",
                              },
                            }),
                          }}
                          onChange={(e) => {
                            const pinValue = e.target.value;
                            if (pinValue.length === 6) {
                              loaderRef.current?.show();
                              fetchAddressDetails(pinValue);
                            }
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="district"
                          label="District"
                          placeholder="Auto-populated"
                          register={{
                            ...register("district"),
                          }}
                          errors={errors}
                          readOnly
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="stateUt"
                          label="State/UT"
                          placeholder="Auto-populated"
                          register={{
                            ...register("stateUt"),
                          }}
                          errors={errors}
                          readOnly
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="country"
                          label="Country"
                          placeholder="Auto-populated"
                          register={{
                            ...register("country"),
                          }}
                          errors={errors}
                          readOnly
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Education Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaGraduationCap className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>Education Details</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    {fields.map((field, index) => (
                      <div key={field.id} className="education-entry mb-4">
                        <Row className="g-3">
                          <Col md={4}>
                            <InputText
                              name={`educationDetails.${index}.qualification`}
                              label={`Qualification${index === 0 ? " *" : ""}`}
                              placeholder="Enter qualification"
                              required={index === 0}
                              register={register(
                                `educationDetails.${index}.qualification`,
                                {
                                  required: index === 0 ? "Qualification is required" : false
                                }
                              )}
                              errors={{
                                ...errors,
                                ...(errors?.educationDetails?.[index]?.qualification && {
                                  educationDetails: {
                                    [index]: {
                                      qualification: {
                                        message: errors.educationDetails[index].qualification.message
                                      }
                                    }
                                  }
                                })
                              }}
                              className={errors?.educationDetails?.[index]?.qualification ? "is-invalid" : ""}
                            />
                            {errors?.educationDetails?.[index]?.qualification && (
                              <div className="invalid-feedback">
                                {errors.educationDetails[index].qualification.message}
                              </div>
                            )}
                          </Col>
                          <Col md={4}>
                            <InputText
                              name={`educationDetails.${index}.stream`}
                              label={`Stream${index === 0 ? " *" : ""}`}
                              placeholder="Enter stream"
                              required={index === 0}
                              register={register(
                                `educationDetails.${index}.stream`,
                                {
                                  required: index === 0 ? "Stream is required" : false
                                }
                              )}
                              errors={{
                                ...errors,
                                ...(errors?.educationDetails?.[index]?.stream && {
                                  educationDetails: {
                                    [index]: {
                                      stream: {
                                        message: errors.educationDetails[index].stream.message
                                      }
                                    }
                                  }
                                })
                              }}
                              className={errors?.educationDetails?.[index]?.stream ? "is-invalid" : ""}
                            />
                            {errors?.educationDetails?.[index]?.stream && (
                              <div className="invalid-feedback">
                                {errors.educationDetails[index].stream.message}
                              </div>
                            )}
                          </Col>
                          <Col md={3}>
                            <InputText
                              name={`educationDetails.${index}.yearOfPassing`}
                              label={`Year of Passing${index === 0 ? " *" : ""}`}
                              placeholder="Enter year"
                              type="number"
                              required={index === 0}
                              register={register(
                                `educationDetails.${index}.yearOfPassing`,
                                {
                                  required: index === 0 ? "Year of Passing is required" : false,
                                  min: {
                                    value: 1900,
                                    message: "Invalid year",
                                  },
                                  max: {
                                    value: new Date().getFullYear(),
                                    message: "Invalid year",
                                  },
                                }
                              )}
                              errors={{
                                ...errors,
                                ...(errors?.educationDetails?.[index]?.yearOfPassing && {
                                  educationDetails: {
                                    [index]: {
                                      yearOfPassing: {
                                        message: errors.educationDetails[index].yearOfPassing.message
                                      }
                                    }
                                  }
                                })
                              }}
                              className={errors?.educationDetails?.[index]?.yearOfPassing ? "is-invalid" : ""}
                            />
                            {errors?.educationDetails?.[index]?.yearOfPassing && (
                              <div className="invalid-feedback">
                                {errors.educationDetails[index].yearOfPassing.message}
                              </div>
                            )}
                          </Col>
                          <Col md={1} className="d-flex align-items-end">
                            {index > 0 && (
                              <Button
                                variant="danger"
                                size="sm"
                                onClick={() => remove(index)}
                                className="mt-1"
                              >
                                <FaTrash />
                              </Button>
                            )}
                          </Col>
                        </Row>
                      </div>
                    ))}
                    <Button
                      variant="outline-primary"
                      onClick={() =>
                        append({
                          qualification: "",
                          stream: "",
                          yearOfPassing: "",
                        })
                      }
                      className="add-education-btn"
                    >
                      <FaPlus className="me-2" /> Add Education Details
                    </Button>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Professional Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaBriefcase className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>
                      Professional Details
                    </span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    {professionalFields.map((field, index) => (
                      <div key={field.id} className="professional-entry mb-4">
                        <Row className="g-3">
                          <Col md={4}>
                            <InputText
                              name={`professionalDetails.${index}.appointmentDate`}
                              label="Appointment Date *"
                              type="date"
                              placeholder="Select appointment date"
                              required={true}
                              register={register(
                                `professionalDetails.${index}.appointmentDate`,
                                { required: "Appointment Date is required" }
                              )}
                              errors={{
                                ...errors,
                                ...(errors?.professionalDetails?.[index]?.appointmentDate && {
                                  professionalDetails: {
                                    [index]: {
                                      appointmentDate: {
                                        message: errors.professionalDetails[index].appointmentDate.message
                                      }
                                    }
                                  }
                                })
                              }}
                              className={errors?.professionalDetails?.[index]?.appointmentDate ? "is-invalid" : ""}
                            />
                            {errors?.professionalDetails?.[index]?.appointmentDate && (
                              <div className="invalid-feedback">
                                {errors.professionalDetails[index].appointmentDate.message}
                              </div>
                            )}
                          </Col>
                          <Col md={4}>
                            <Controller
                              name={`professionalDetails.${index}.employeeType`}
                              control={control}
                              rules={{ required: "Employee Type is required" }}
                              render={({ field, fieldState: { error } }) => (
                                <InputSelect
                                  {...field}
                                  name={`professionalDetails.${index}.employeeType`}
                                  label="Employee Type *"
                                  required={true}
                                  options={
                                    masterData?.employeeTypes?.map((type) => ({
                                      value: type.valueCode,
                                      label: type.valueLabel,
                                    })) || []
                                  }
                                  error={error?.message}
                                  value={field.value}
                                  onChange={(value) => field.onChange(value)}
                                  isInvalid={!!error}
                                />
                              )}
                            />
                          </Col>
                          <Col md={4}>
                            <Controller
                              name={`professionalDetails.${index}.employeeStatus`}
                              control={control}
                              rules={{ required: "Employee Status is required" }}
                              render={({ field, fieldState: { error } }) => (
                                <InputSelect
                                  {...field}
                                  name={`professionalDetails.${index}.employeeStatus`}
                                  label="Employee Status *"
                                  required={true}
                                  options={
                                    masterData?.employeeStatuses?.map((type) => ({
                                      value: type.valueCode,
                                      label: type.valueLabel,
                                    })) || []
                                  }
                                  error={error?.message}
                                  value={field.value}
                                  onChange={(value) => field.onChange(value)}
                                  isInvalid={!!error}
                                />
                              )}
                            />
                          </Col>
                          <Col md={4}>
                            <Controller
                              name={`professionalDetails.${index}.designation`}
                              control={control}
                              rules={{ required: "Designation is required" }}
                              render={({ field, fieldState: { error } }) => (
                                <InputSelect
                                  {...field}
                                  name={`professionalDetails.${index}.designation`}
                                  label="Designation *"
                                  required={true}
                                  options={
                                    masterData?.designations?.map((type) => ({
                                      value: type.valueCode,
                                      label: type.valueLabel,
                                    })) || []
                                  }
                                  error={error?.message}
                                  value={field.value}
                                  onChange={(value) => field.onChange(value)}
                                  isInvalid={!!error}
                                />
                              )}
                            />
                          </Col>
                          <Col md={4}>
                            <InputText
                              name={`professionalDetails.${index}.department`}
                              label="Department"
                              placeholder="Enter department"
                              register={register(
                                `professionalDetails.${index}.department`
                              )}
                              errors={errors}
                            />
                          </Col>
                          <Col md={4}>
                            <InputText
                              name={`professionalDetails.${index}.section`}
                              label="Section"
                              placeholder="Enter section"
                              register={register(
                                `professionalDetails.${index}.section`
                              )}
                              errors={errors}
                            />
                          </Col>
                          <Col md={4}>
                            <Controller
                              name={`professionalDetails.${index}.roles`}
                              control={control}
                              rules={{ required: "Role is required" }}
                              render={({ field, fieldState: { error } }) => (
                                <InputSelect
                                  {...field}
                                  name={`professionalDetails.${index}.roles`}
                                  label="Roles *"
                                  required={true}
                                  options={
                                    masterData?.roles?.map((type) => ({
                                      value: type.valueCode,
                                      label: type.valueLabel,
                                    })) || []
                                  }
                                  error={error?.message}
                                  value={field.value}
                                  onChange={(value) => field.onChange(value)}
                                  isInvalid={!!error}
                                />
                              )}
                            />
                          </Col>
                          <Col md={1} className="d-flex align-items-end">
                            {index > 0 && (
                              <Button
                                variant="danger"
                                size="sm"
                                onClick={() => removeProfessional(index)}
                                className="mt-1"
                              >
                                <FaTrash />
                              </Button>
                            )}
                          </Col>
                        </Row>
                      </div>
                    ))}
                    <Button
                      variant="outline-primary"
                      onClick={() =>
                        appendProfessional({
                          appointmentDate: "",
                          employeeType: "",
                          employeeStatus: "",
                          designation: "",
                          department: "",
                          section: "",
                          roles: "",
                        })
                      }
                      className="add-education-btn"
                    >
                      <FaPlus className="me-2" /> Add Professional Details
                    </Button>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Documents Upload Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>
                      Documents Upload
                    </span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="addressProof"
                          label="Address Proof"
                          type="file"
                          required={true}
                          register={register("addressProof", {
                            required: "Address Proof is required",
                          })}
                          errors={errors}
                          onChange={(e) => setAddressProofFile(e.target.files[0])}
                        />
                        {errors.addressProof && (
                          <div className="invalid-feedback d-block">
                            {errors.addressProof.message}
                          </div>
                        )}
                        <small className="text-muted">
                          Upload PDF, JPG or PNG (Max: 2MB)
                        </small>
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="identityProof"
                          label="Identity Proof"
                          type="file"
                          required={true}
                          register={register("identityProof", {
                            required: "Identity Proof is required",
                          })}
                          errors={errors}
                          onChange={(e) => setIdentityProofFile(e.target.files[0])}
                        />
                        {errors.identityProof && (
                          <div className="invalid-feedback d-block">
                            {errors.identityProof.message}
                          </div>
                        )}
                        <small className="text-muted">
                          Upload PDF, JPG or PNG (Max: 2MB)
                        </small>
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="appointmentLetter"
                          label="Appointment Letter"
                          type="file"
                          required={true}
                          register={register("appointmentLetter", {
                            required: "Appointment Letter is required",
                          })}
                          errors={errors}
                          onChange={(e) => setAppointmentLetterFile(e.target.files[0])}
                        />
                        {errors.appointmentLetter && (
                          <div className="invalid-feedback d-block">
                            {errors.appointmentLetter.message}
                          </div>
                        )}
                        <small className="text-muted">
                          Upload PDF, JPG or PNG (Max: 2MB)
                        </small>
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Form Actions */}
              <div className="d-flex justify-content-end mt-4 gap-2">
                <Col style={{ display: "flex" }}>
                  <strong style={{ marginTop: "5px" }}>User Status : </strong>
                  &nbsp; &nbsp;
                  <Controller
                    name="toggleChoice"
                    control={control}
                    render={({ field }) => (
                      <AppToggleButton labels={["In-Active", "Active"]} {...field} />
                    )}
                  />
                </Col>

                <Button variant="secondary" onClick={handleCancel}>
                  Cancel
                </Button>
                <Button
                  variant="primary"
                  type="submit"
                  style={{
                    background: "linear-gradient(135deg, #0077b6, #023e8a)",
                    border: "none",
                    boxShadow: "0 4px 6px rgba(0, 0, 0, 0.1)",
                    padding: "8px 20px",
                  }}
                >
                  {isEditMode ? "Update" : "Submit"}
                </Button>
              </div>
            </form>
          </Card.Body>
        </Card>
      </Container>
    </>
  );
};

export default EmployeeRegistration;
