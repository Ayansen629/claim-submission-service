const submitIntialSurveyData = async (surveyPayload, stepInfo = null) => {
  try {
    loaderRef.current?.show();
    const apiUrl =
      SERVICE_BASE.IWT_SURVEY_SERVICE +
      URLS_ENDPOINT.SURVEY_SERVICE.SURVEY_CREATE;

    // If we have a survey ID, this is an update operation
    if (surveyPayload.surveyId) {
      surveyPayload.isUpdate = true;
    }

    const response = await postData(apiUrl, surveyPayload);

    if (response?.status === 200 || response?.status === 201) {
      setIntialSurveyData(response?.data || []);

      if (isOfficerLogin && isViewMode && !stepInfo) {
        toast.success("Survey form data updated successfully!");
      } else {
        toast.success(
          response?.data?.responseStatus?.message ||
          "Survey data submitted successfully!"
        );
      }

      if (stepInfo) {
        stepperRef.current?.goToNextStep();
        if (stepInfo?.index === 1) {
          fetchPaymentDetails();
        }
      }
    } else {
      toast.error(
        response?.data?.responseStatus?.message ||
        "Failed to submit survey data."
      );
    }
  } catch (err) {
    handleErrorMessage(
      err?.response?.data ||
      "Failed to save survey. Check console for details."
    );
  } finally {
    loaderRef?.current?.hide();
  }
};
