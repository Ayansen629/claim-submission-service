import React, { useState, useEffect } from "react";
import { Card, Form, InputGroup, Button } from "react-bootstrap";
import WelcomeBox from "../../common/WelcomeBox";
import "./employeeDashboard.css";

import { BsSearch, BsFilter } from "react-icons/bs";
import ActionTable from "../../common/ActionTable.tsx";
import { useNavigate } from "react-router-dom";
import StatusCard from "../../common/StatusCard";
import SurveyTrackerCard from "./SurveyTrackerCard.js";
import {
  EMPLOYEE_STAT_DATA,
  OFFICER_L1_STAT_DATA,
  INBOX_COLUMNS,
  OFFICER_L2_STAT_DATA,
  generateInboxData,
} from "./employeeDashboardConstants";
import { getUserRoleName, headerStyle } from "../../../utils/constants.ts";
import { FaUsersBetweenLines } from "react-icons/fa6";
import { USER_ROLES } from "../../../utils/constants.ts";

const EmployeeDashboard = ({ userDetails, userRole }) => {
  const [inboxData, setInboxData] = useState([]);
  const [filteredData, setFilteredData] = useState([]);
  const [currentPage, setCurrentPage] = useState(1);
  const [searchTerm, setSearchTerm] = useState("");

  const itemsPerPage = 5;
  const navigate = useNavigate();

  useEffect(() => {
    const data = generateInboxData();
    setInboxData(data);
    setFilteredData(data);
  }, []);

  useEffect(() => {
    const results = inboxData.filter(
      (item) =>
        item.appNo.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.appType.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.owner.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.vesselNo.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.status.toLowerCase().includes(searchTerm.toLowerCase())
    );
    setFilteredData(results);
    setCurrentPage(1);
  }, [searchTerm, inboxData]);

  const handleTablePageChange = (page) => {
    setCurrentPage(page);
  };

  const getStatData = () => {
    switch (userRole) {
      case USER_ROLES.OFFICER_L1:
        return OFFICER_L1_STAT_DATA;
      case USER_ROLES.OFFICER_L2:
        return OFFICER_L2_STAT_DATA;
      case USER_ROLES.ADMIN:
      default:
        return EMPLOYEE_STAT_DATA;
    }
  };

  // const getDashboardTitle = () => {
  //   switch (userRole) {
  //     case USER_ROLES.OFFICER_L1:
  //       return "Officer L1 Dashboard";
  //     case USER_ROLES.OFFICER_L2:
  //       return "Officer L2 Dashboard";
  //     case USER_ROLES.ADMIN:
  //       return "Admin Dashboard";
  //     default:
  //       return "My WorkDesk";
  //   }
  // };

  return (
    <>
      <WelcomeBox
        userName={
          userDetails ? `${userDetails.firstName} ${userDetails.lastName}` : ""
        }
        title={ getUserRoleName(userRole)}
        desc="Here's your Dashboard overview."
      />

      <Card className="bg-transparent mb-4 dashboard-card">
        {userRole === USER_ROLES.ADMIN && (
          <Card.Header className="dashboard-card-header">
            <div style={{ float: "right", width: 180 }}>
              <button
                className="generic-btn-submit"
                type="button"
                onClick={() =>
                  navigate(
                    "/dashboard/employee-dashboard/employee-applications"
                  )
                }
              >
                View Applications &nbsp;{" "}
                <FaUsersBetweenLines size={15} color={"#fff"} />
              </button>
            </div>
          </Card.Header>
        )}

        <Card.Body>
          <div className="row g-3">
            {getStatData().map((item, index) => (
              <div
                className={
                  item.isCalendar
                    ? "col-md-8 col-lg-6 col-sm-12"
                    : "col-md-4 col-lg-3 col-sm-12"
                }
                key={index}
              >
                {item.isCalendar ? (
                  <SurveyTrackerCard
                    events={item.events}
                    color={item.color || "#6f42c1"}
                  />
                ) : (
                  <StatusCard {...item} />
                )}
              </div>
            ))}
          </div>
        </Card.Body>
      </Card>

      <Card className="bg-transparent mt-4 dashboard-card">
        <Card.Header
          style={headerStyle}
          className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
        >
          <div className="d-flex align-items-center">
            <h5 className="mb-0 me-2">Inbox</h5>
            <span className="badge bg-primary rounded-pill">
              {filteredData.length}
            </span>
          </div>
          <div className="d-flex align-items-center">
            <Button variant="outline-secondary" className="filter-btn me-2">
              <BsFilter size={18} />
              <span className="ms-1 d-none d-sm-inline">Filter</span>
            </Button>
            <Form className="inbox-search">
              <InputGroup>
                <Form.Control
                  type="text"
                  placeholder="Search inbox..."
                  aria-label="Search inbox"
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                />
                <Button variant="primary">
                  <BsSearch />
                </Button>
              </InputGroup>
            </Form>
          </div>
        </Card.Header>
        <div style={{ position: "relative", bottom: "2rem" }}>
          <ActionTable
            columns={INBOX_COLUMNS}
            rowData={filteredData}
            tableHeader={null}
            hideExportBtn={true}
            hideSearchBar={true}
            pagination={true}
            currentPage={currentPage}
            itemsPerPage={itemsPerPage}
            onPageChange={handleTablePageChange}
            noDataText={
              <div className="no-results text-center py-4">
                <BsSearch size={24} className="mb-2" />
                <p>No results found</p>
                <small>
                  Try adjusting your search to find what you're looking for.
                </small>
              </div>
            }
          />
        </div>
      </Card>
    </>
  );
};

export default EmployeeDashboard;

import React, { useEffect, useState } from "react";
import WelcomeBox from "../../../common/WelcomeBox.js";
import StatusCard from "../../../common/StatusCard.js";
import ActionTable from "../../../common/ActionTable.tsx";
import {
    BsExclamationTriangle,
    BsClipboardData,
    BsSearch,
    BsFilter,
    BsCalendarEvent,
    BsCheckCircle,
    BsFileEarmarkCheck
} from "react-icons/bs";
import "./surveyorDashboard.css";
import {
    Card,
    Form,
    InputGroup,
    Button,
    Row,
    Col,
} from "react-bootstrap";
import { CHART_OPTIONS, CHART_TYPES } from "../../../../utils/constants.ts";
import chart_icon from "../../../../assets/icons/chart_icon.png";
import { INBOX_COLUMNS, surveyStatsChartData } from "./surveyorConstants.js";
import ActionModal from "../../../common/ActionModal.tsx";
import DynamicChart from "../../../common/DynamicChart";

const generateInboxData = () => {
    const statuses = ["Completed", "Processing", "Rejected"];
    const appTypes = [
        "Annual Survey",
        "Renewal Survey",
        "Special Survey",
        "Accident Survey",
        "Initial Survey"
    ];

    return Array.from({ length: 20 }, (_, i) => ({
        id: i + 1,
        appNo: `SUR-2025-${(i + 1).toString().padStart(3, "0")}`,
        appType: appTypes[Math.floor(Math.random() * appTypes.length)],
        date: new Date(
            2025,
            Math.floor(Math.random() * 12),
            Math.floor(Math.random() * 28) + 1
        )
            .toISOString()
            .split("T")[0],
        status: statuses[Math.floor(Math.random() * statuses.length)],
        action: <Button variant="outline-primary" size="sm">View</Button>
    }));
};

const SurveyorDashboard = ({ userDetails }) => {
    return (
        <>
            <WelcomeBox
                userName={
                    userDetails
                        ? userDetails?.firstName + " " + userDetails?.lastName + " User"
                        : ""
                }
                title={userDetails?.userType}
                desc="Here's your survey performance overview."
            />
            <SurveyorContent />
        </>
    );
};

const SurveyorContent = () => {
    const [inboxData, setInboxData] = useState([]);
    const [filteredInboxData, setFilteredInboxData] = useState([]);
    const [inboxCurrentPage, setInboxCurrentPage] = useState(1);
    const [inboxSearchTerm, setInboxSearchTerm] = useState("");
    const itemsInboxPerPage = 5;
    const [isChartModalOpen, setIsChartModalOpen] = useState(false);
    const [selectedDate, setSelectedDate] = useState(new Date().toISOString().split('T')[0]);

    // Mock upcoming surveys data
    const upcomingSurveys = [
        { date: "2025-06-15", title: "Annual Survey - MV Sea Hawk" },
        { date: "2025-06-18", title: "Renewal Survey - MV Blue Pearl" },
        { date: "2025-06-22", title: "Special Survey - MV Ocean Spirit" },
        { date: "2025-06-25", title: "Accident Survey - MV Wave Rider" },
        { date: "2025-06-28", title: "Initial Survey - MV Aqua Nova" },
    ];

    // Filter surveys for selected date
    const filteredSurveys = upcomingSurveys.filter(survey => survey.date === selectedDate);

    useEffect(() => {
        const data = generateInboxData();
        setInboxData(data);
        setFilteredInboxData(data);
    }, []);

    useEffect(() => {
        const results = inboxData.filter(
            (item) =>
                item.appNo?.toLowerCase()?.includes(inboxSearchTerm?.toLowerCase()) ||
                item.appType?.toLowerCase()?.includes(inboxSearchTerm?.toLowerCase()) ||
                item.status?.toLowerCase()?.includes(inboxSearchTerm?.toLowerCase())
        );
        setFilteredInboxData(results);
        setInboxCurrentPage(1);
    }, [inboxSearchTerm, inboxData]);

    const handleTablePageChange = (page) => {
        setInboxCurrentPage(page);
    };

    const handleCardClick = (cardInfo, index) => {
        if (index === 4) { // Survey Statistics chart
            setIsChartModalOpen(true);
        }
    };

    const statData = [
        {
            title: "Total Registered Vessel Count",
            value: 125,
            icon: BsClipboardData,
            color: "#28a745",
            subtitle: "(Total Number of Registered Vessels)",
        },
        {
            title: "Pending Survey Application",
            value: 28,
            icon: BsExclamationTriangle,
            color: "#ffc107",
            subtitle: "(Applications awaiting your review)",
        },
        {
            title: "Pending Registration Application",
            value: 15,
            icon: BsExclamationTriangle,
            color: "#fd7e14",
            subtitle: "(New vessel registrations pending)",
        },
        {
            title: "Pending Drawing Approvals",
            value: 7,
            icon: BsExclamationTriangle,
            color: "#dc3545",
            subtitle: "(Vessel drawings awaiting approval)",
        },
        {
            title: "Survey Statistics",
            imageSrc: chart_icon,
            color: "#6ec1e4",
            subtitle: "(Survey types breakdown)",
        },
        {
            title: "Survey Scheduled",
            value: 42,
            icon: BsCalendarEvent,
            color: "#17a2b8",
            subtitle: "(Surveys scheduled for next 30 days)",
        },
        {
            title: "Survey Completed",
            value: 86,
            icon: BsCheckCircle,
            color: "#28a745",
            subtitle: "(Surveys completed this year)",
        },
        {
            title: "Survey Certificate Issued",
            value: 78,
            icon: BsFileEarmarkCheck,
            color: "#6f42c1",
            subtitle: "(Certificates issued this year)",
        },
        {
            title: "Upcoming Surveys",
            customContent: (
                <div className="upcoming-surveys-container">
                    <Form.Control
                        type="date"
                        value={selectedDate}
                        onChange={(e) => setSelectedDate(e.target.value)}
                        className="mb-2"
                    />
                    {filteredSurveys.length > 0 ? (
                        <div className="upcoming-surveys-list">
                            {filteredSurveys.map((survey, index) => (
                                <div key={index} className="survey-item">
                                    <div className="survey-date">{survey.date}</div>
                                    <div className="survey-title">{survey.title}</div>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <div className="no-surveys">No surveys scheduled for this date</div>
                    )}
                </div>
            ),
            color: "#20c997",
            subtitle: "(Highlighted upcoming surveys)",
        }
    ];

    return (
        <>
            <div className="row g-3">
                {statData.map((item, index) => (
                    <div className="col-md-4 col-lg-3 col-sm-12" key={index}>
                        <StatusCard
                            {...item}
                            onClick={() => handleCardClick(item, index)}
                        />
                    </div>
                ))}
            </div>

            <br />

            <Card className="bg-transparent mt-4 dashboard-card">
                <Card.Header className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap">
                    <div className="d-flex align-items-center">
                        <h5 className="mb-0 me-2">Survey Applications</h5>
                        <span className="badge bg-primary rounded-pill">
                            {filteredInboxData.length}
                        </span>
                    </div>
                    <div className="d-flex align-items-center">
                        <Button variant="outline-secondary" className="filter-btn me-2">
                            <BsFilter size={18} />
                            <span className="ms-1 d-none d-sm-inline">Filter</span>
                        </Button>
                        <Form className="inbox-search">
                            <InputGroup>
                                <Form.Control
                                    type="text"
                                    placeholder="Search applications..."
                                    aria-label="Search applications"
                                    value={inboxSearchTerm}
                                    onChange={(e) => setInboxSearchTerm(e.target.value)}
                                />
                                <Button variant="primary">
                                    <BsSearch />
                                </Button>
                            </InputGroup>
                        </Form>
                    </div>
                </Card.Header>

                <div style={{ position: "relative", bottom: "2rem" }}>
                    <ActionTable
                        columns={INBOX_COLUMNS}
                        rowData={filteredInboxData}
                        tableHeader={null}
                        hideExportBtn={true}
                        hideSearchBar={true}
                        pagination={true}
                        inboxCurrentPage={inboxCurrentPage}
                        itemsInboxPerPage={itemsInboxPerPage}
                        onPageChange={handleTablePageChange}
                        noDataText={
                            <div className="no-results text-center py-4">
                                <BsSearch size={24} className="mb-2" />
                                <p>No results found</p>
                                <small>
                                    Try adjusting your search to find what you're looking for.
                                </small>
                            </div>
                        }
                    />
                </div>
            </Card>

            <ActionModal
                show={isChartModalOpen}
                close={setIsChartModalOpen}
                title="Survey Statistics"
                size={"md"}
                isFooterHide={true}>
                <DynamicChart
                    type={CHART_TYPES[3]}
                    data={surveyStatsChartData}
                    options={CHART_OPTIONS}
                />
            </ActionModal>
        </>
    );
};

export default SurveyorDashboard;
export const INBOX_COLUMNS = [
    {
        colName: "Application No",
        fieldName: "appNo",
        clsName: "column-text-start",
    },
    {
        colName: "Application Type",
        fieldName: "appType",
        clsName: "column-text-start",
    },
    {
        colName: "Date of Submission",
        fieldName: "date",
        clsName: "column-text-start",
    },
    {
        colName: "Status",
        fieldName: "status",
        clsName: "column-text-start",
        render: (value) => (
            <span className={`status-badge ${value.toLowerCase()}`}>{value}</span>
        ),
    },
    {
        colName: "Action",
        fieldName: "action",
        clsName: "column-text-start",
    },
];

export const surveyStatsChartData = {
    labels: ['Annual', 'Renewal', 'Special', 'Accident'],
    datasets: [
        {
            label: 'Survey Statistics',
            data: [45, 30, 15, 10],
            backgroundColor: [
                '#36A2EB',
                '#FF6384',
                '#FFCE56',
                '#4BC0C0'
            ],
            borderWidth: 1,
        },
    ],
};
import {
