const handleActionClick = (action) => {
  if (action?.actionName === "Generate CMN") {
    setShowCmnStepper(true);
    
    // Filter out "Generate CMN" and show "Forward" action
    setActionsFromAPI((prevActions) => 
      prevActions.filter(item => item.actionName !== "Generate CMN")
    );
    
    toast.success(
      "CMN Generated successfully. Please proceed with the next step."
    );
    return;
  }

  setSelectedAction(action);
  setShowApprovalModal(true);
};
