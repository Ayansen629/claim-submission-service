// In Basic Vessel Information section, add after draft field:
<Col md={4}>
  <InputText
    label={t("Number of Decks")}
    name="basicVesselInfo.numberOfDecks"
    type="number"
    placeholder={t("Enter Number of Decks")}
    register={register("basicVesselInfo.numberOfDecks")}
    errors={errors}
    disabled={viewMode}
  />
</Col>

// In Hull Particulars section, add after floorThickness field:
<Col md={4}>
  <InputText
    label={t("Stern")}
    name="hullParticulars.stern"
    placeholder={t("Enter Stern")}
    register={register("hullParticulars.stern")}
    errors={errors}
    disabled={viewMode}
  />
</Col>
