import React, { useEffect } from "react";
import { FaClipboardList } from "react-icons/fa";
import Collapsible from "../../../../../common/Collapsible";
import { Col, Row } from "react-bootstrap";
import InputText from "../../../../../common/InputText.tsx";
import { useTranslation } from "react-i18next";
import { useForm } from "react-hook-form";

const CertificateOfRegistrationForm8 = ({
  formMethods,
  viewMode = false,
  registrationData,
  intialSurveyData,
  originalRegistrationData,
  provisionalCertData,
}) => {
  const { t } = useTranslation();

  const defaultMethods = useForm({ mode: "onTouched" });
  const methods = formMethods || defaultMethods;
  const {
    register,
    setValue,
    formState: { errors },
  } = methods;

  // Check processActionMapResponce from provisionalCertData
  const hasProcessActions = provisionalCertData?.processActionMapResponce?.[0]?.processs?.[0]?.actions?.length > 0;
  const shouldDisableFields = !hasProcessActions;

  useEffect(() => {

      const regData = originalRegistrationData;
      const survey = intialSurveyData;
      const provData = provisionalCertData?.certificateRequestWrapper?.registrationCertificateDetails || {};

      // Basic Information
      setValue("certificateOfRegistration.basicInfo.issuedBy",  provisionalCertData?.certificateRequestWrapper?.issuedBy || "");
      setValue(
        "certificateOfRegistration.basicInfo.officialNo",
        provData?.officialNumber ||
        regData?.vesselDetails?.registrationNumber ||
        ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.nameOfVessel",
        provData?.vesselName || regData?.vesselDetails?.vesselName || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.portOfRegistry",
        provData?.portOfRegistry || regData?.vesselDetails?.portOfRegistry || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.dateOfRegistry",
          provisionalCertData?.certificateRequestWrapper?.registrationDate || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.dateOfPreviousRegistry",
        provData?.dateOfPreviousRegisty || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.previousRegistryPort",
        provData?.portOfPreviousRegisty || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.whereBuilt",
        provData?.placeOfBuilt || regData?.vesselDetails?.placeOfBuild || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.nameOfBuilder",
        provData?.nameOfBuilder ||
        regData?.basicDetails?.builderDetails?.builderName ||
        ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.addressOfBuilder",
        provData?.addressOfBuilder || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.propulsionType",
        provData?.propulsionType || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.material",
        provData?.materialDescription || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.numberOfDecks",
        provData?.numberOfDeck?.toString() ||
        survey?.BasicVesselInformation?.numberOfDecks?.toString() ||
        ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.numberOfBulkheads",
        provData?.numberOfBulkHeads?.toString() || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.stern",
        survey?.HullParticulars?.stern || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.length",
        provData?.length || survey?.BasicVesselInformation?.lengthOfVessel || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.breadth",
        provData?.breadth ||
        survey?.BasicVesselInformation?.breadthOfVessel ||
        ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.depth",
        provData?.depth || survey?.BasicVesselInformation?.depthOfVessel || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.draft",
        provData?.draft || survey?.BasicVesselInformation?.draft || ""
      );
      setValue(
        "certificateOfRegistration.basicInfo.lengthOfEngineRoom",
        survey?.DetailsofPropulsionofEngine?.lengthOfEngineRoom?.toString() ||
        ""
      );

      setValue(
        "certificateOfRegistration.summary",
        provData?.summaryDescriptionOfTonnage
      )

      // Particulars of Engine
      setValue(
        "certificateOfRegistration.particularsOfEngine.noOfSets",
        survey?.DetailsofPropulsionofEngine?.noOfSet?.toString() || ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.description",
        regData?.engineDetails?.engineType || ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.indianOrForeignBuilt",
        ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.yearOfMake",
        regData?.engineDetails?.yearOfMake || ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.madeBy",
        provData?.nameOfEngineMaker || regData?.engineDetails?.engineMake || ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.engineMakerAddress",
        provData?.addressOfEngineMaker ||
        regData?.engineDetails?.makerAddress ||
        ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.cylindersPerSetReciprocating",
        survey?.DetailsofPropulsionofEngine?.noOfCylinderPerSetReciprocatingEngine?.toString() ||
        ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.diameterOfCylinder",
        survey?.DetailsofPropulsionofEngine?.engineCylinder?.toString() || ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.cylindersPerSetRotary",
        survey?.DetailsofPropulsionofEngine?.noOfCylinderPerSetRotaryEngine?.toString() ||
        ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.bhp",
        provData?.combinedPower?.toString() ||
        regData?.engineDetails?.horsepower?.toString() ||
        ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.noOfShaft",
        survey?.DetailsofPropulsionofEngine?.noOfShaft?.toString() || ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.lengthOfStroke",
        survey?.DetailsofPropulsionofEngine?.stroke || ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.vesselSpeed",
        regData?.engineDetails?.vesselSpeed?.toString() || ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.rpm",
        survey?.DetailsofPropulsionofEngine?.rpm?.toString() || ""
      );
      setValue(
        "certificateOfRegistration.particularsOfEngine.propellerType",
        regData?.engineDetails?.propellerType || ""
      );

      // Particulars of Boilers
      setValue(
        "certificateOfRegistration.particularsOfBoilers.description",
        ""
      );
      setValue("certificateOfRegistration.particularsOfBoilers.number", "");
      setValue(
        "certificateOfRegistration.particularsOfBoilers.loadedPressure",
        ""
      );

      // Particulars of Tonnage
      setValue(
        "certificateOfRegistration.particularsOfTonnage.grossTonnage",
        provData?.grossTonnage?.toString() ||
        regData?.vesselDetails?.grossTonnage?.toString() ||
        ""
      );
      setValue(
        "certificateOfRegistration.particularsOfTonnage.netTonnage",
        provData?.netTonnage?.toString() ||
        survey?.BasicVesselInformation?.netTonnage?.toString() ||
        ""
      );
      setValue(
        "certificateOfRegistration.particularsOfTonnage.numberOfCrew",
        provData?.numberOfCrew?.toString() ||
        (
          survey?.BasicVesselInformation?.totalNoOfDeckCrew +
          survey?.BasicVesselInformation?.totalNoOfEngineCrew
        )?.toString() ||
        ""
      );

      // Summary
      setValue("certificateOfRegistration.summary", provData?.summaryDescriptionOfTonnage || "");
    
  }, [
    originalRegistrationData,
    intialSurveyData,
    provisionalCertData,
    setValue,
  ]);

  return (
    <form autoComplete="off">
      <Collapsible
        title={
          <>
            <FaClipboardList className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Basic Information")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Issued by")}
              name="certificateOfRegistration.basicInfo.issuedBy"
              register={register(
                "certificateOfRegistration.basicInfo.issuedBy"
              )}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Official No. of the Vessel")}
              placeholder={t("Enter Official No. of the Vessel")}
              name="certificateOfRegistration.basicInfo.officialNo"
              register={register(
                "certificateOfRegistration.basicInfo.officialNo"
              )}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Name of Vessel")}
              name="certificateOfRegistration.basicInfo.nameOfVessel"
              register={register(
                "certificateOfRegistration.basicInfo.nameOfVessel"
              )}
              errors={errors}
              placeholder={t("Enter Name of Vessel")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Port of Registry of Vessel")}
              name="certificateOfRegistration.basicInfo.portOfRegistry"
              register={register(
                "certificateOfRegistration.basicInfo.portOfRegistry"
              )}
              errors={errors}
              placeholder={t("Enter Port of Registry of Vessel")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Date of Registry")}
              name="certificateOfRegistration.basicInfo.dateOfRegistry"
              register={register(
                "certificateOfRegistration.basicInfo.dateOfRegistry"
              )}
              type="date"
              errors={errors}
              placeholder={t("Enter Date of Registry")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Date of Previous Registry (If any)")}
              name="certificateOfRegistration.basicInfo.dateOfPreviousRegistry"
              type="date"
              register={register(
                "certificateOfRegistration.basicInfo.dateOfPreviousRegistry"
              )}
              errors={errors}
              placeholder={t("Enter Date of Previous Registry")}
              disabled={false}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Previous Registry Port (If any)")}
              name="certificateOfRegistration.basicInfo.previousRegistryPort"
              register={register(
                "certificateOfRegistration.basicInfo.previousRegistryPort"
              )}
              errors={errors}
              placeholder={shouldDisableFields ? "" : t("Enter Previous Registry Port")}
              disabled={shouldDisableFields}
              style={shouldDisableFields ? { backgroundColor: "#f8f9fa" } : {}}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Where Built")}
              name="certificateOfRegistration.basicInfo.whereBuilt"
              register={register(
                "certificateOfRegistration.basicInfo.whereBuilt"
              )}
              errors={errors}
              placeholder={t("Enter Where Built")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Name of Builder")}
              name="certificateOfRegistration.basicInfo.nameOfBuilder"
              register={register(
                "certificateOfRegistration.basicInfo.nameOfBuilder"
              )}
              errors={errors}
              placeholder={t("Enter Name of Builder")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Address of Builder")}
              name="certificateOfRegistration.basicInfo.addressOfBuilder"
              register={register(
                "certificateOfRegistration.basicInfo.addressOfBuilder"
              )}
              errors={errors}
              placeholder={t("Enter Address of Builder")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              required={true}
              label={t("Whether Indian or Foreign Built")}
              name="certificateOfRegistration.basicInfo.indianOrForeignBuilt"
              register={register(
                "certificateOfRegistration.basicInfo.indianOrForeignBuilt",
                {
                  required: t("Whether Indian or Foreign Built is required"),
                }
              )}
              errors={errors}
              placeholder={shouldDisableFields ? "" : t("Enter Indian or Foreign Built")}
              disabled={shouldDisableFields}
              style={shouldDisableFields ? { backgroundColor: "#f8f9fa" } : {
                borderColor: errors?.certificateOfRegistration?.basicInfo
                  ?.indianOrForeignBuilt
                  ? "#dc3545"
                  : "",
              }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Whether Self Propelled Propulsion Type")}
              name="certificateOfRegistration.basicInfo.propulsionType"
              register={register(
                "certificateOfRegistration.basicInfo.propulsionType"
              )}
              errors={errors}
              placeholder={t("Enter Propulsion Type")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Material")}
              name="certificateOfRegistration.basicInfo.material"
              register={register(
                "certificateOfRegistration.basicInfo.material"
              )}
              errors={errors}
              placeholder={t("Enter Material")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Numbers of Decks")}
              name="certificateOfRegistration.basicInfo.numberOfDecks"
              register={register(
                "certificateOfRegistration.basicInfo.numberOfDecks"
              )}
              errors={errors}
              placeholder={t("Enter Numbers of Decks")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Number of Bulkheads")}
              name="certificateOfRegistration.basicInfo.numberOfBulkheads"
              register={register(
                "certificateOfRegistration.basicInfo.numberOfBulkheads"
              )}
              errors={errors}
              placeholder={t("Enter Number of Bulkheads")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Stern")}
              name="certificateOfRegistration.basicInfo.stern"
              register={register("certificateOfRegistration.basicInfo.stern")}
              errors={errors}
              placeholder={shouldDisableFields ? "" : t("Enter Stern")}
              disabled={shouldDisableFields}
              style={shouldDisableFields ? { backgroundColor: "#f8f9fa" } : {}}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Length (Meter)")}
              name="certificateOfRegistration.basicInfo.length"
              register={register("certificateOfRegistration.basicInfo.length")}
              errors={errors}
              placeholder={t("Enter Length (Meter)")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Breadth (Meter)")}
              name="certificateOfRegistration.basicInfo.breadth"
              register={register("certificateOfRegistration.basicInfo.breadth")}
              errors={errors}
              placeholder={t("Enter Breadth (Meter)")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Depth (Meter)")}
              name="certificateOfRegistration.basicInfo.depth"
              register={register("certificateOfRegistration.basicInfo.depth")}
              errors={errors}
              placeholder={t("Enter Depth (Meter)")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Draft (Meter)")}
              name="certificateOfRegistration.basicInfo.draft"
              register={register("certificateOfRegistration.basicInfo.draft")}
              errors={errors}
              placeholder={t("Enter Draft (Meter)")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Length of Engine Room")}
              name="certificateOfRegistration.basicInfo.lengthOfEngineRoom"
              register={register(
                "certificateOfRegistration.basicInfo.lengthOfEngineRoom"
              )}
              errors={errors}
              placeholder={shouldDisableFields ? "" : t("Enter Length of Engine Room")}
              disabled={shouldDisableFields}
              style={shouldDisableFields ? { backgroundColor: "#f8f9fa" } : {}}
            />
          </Col>
        </Row>
      </Collapsible>

      <Collapsible
        title={
          <>
            <FaClipboardList className="me-2" style={{ color: "#2466BF" }} />
            <span>
              {t(
                "PARTICULARS OF PROPELLING ENGINES, & MACHINERY as supplied by Builders, Owners, or Engine Makers"
              )}
            </span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("No. of Sets")}
              name="certificateOfRegistration.particularsOfEngine.noOfSets"
              register={register(
                "certificateOfRegistration.particularsOfEngine.noOfSets"
              )}
              errors={errors}
              placeholder={t("Enter No. of Sets")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Description")}
              name="certificateOfRegistration.particularsOfEngine.description"
              register={register(
                "certificateOfRegistration.particularsOfEngine.description"
              )}
              errors={errors}
              placeholder={t("Enter Description")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Whether Indian or Foreign Built")}
              name="certificateOfRegistration.particularsOfEngine.indianOrForeignBuilt"
              register={register(
                "certificateOfRegistration.particularsOfEngine.indianOrForeignBuilt"
              )}
              errors={errors}
              placeholder={t("Enter Indian or Foreign Built")}
              disabled={false}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Year of Make")}
              name="certificateOfRegistration.particularsOfEngine.yearOfMake"
              register={register(
                "certificateOfRegistration.particularsOfEngine.yearOfMake"
              )}
              errors={errors}
              placeholder={t("Enter Year of Make")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Made by")}
              name="certificateOfRegistration.particularsOfEngine.madeBy"
              register={register(
                "certificateOfRegistration.particularsOfEngine.madeBy"
              )}
              errors={errors}
              placeholder={t("Enter Made by")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Engine Maker Address")}
              name="certificateOfRegistration.particularsOfEngine.engineMakerAddress"
              register={register(
                "certificateOfRegistration.particularsOfEngine.engineMakerAddress"
              )}
              errors={errors}
              placeholder={t("Enter Engine Maker Address")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("No. of Cylinders per Set for Reciprocating Engine")}
              name="certificateOfRegistration.particularsOfEngine.cylindersPerSetReciprocating"
              register={register(
                "certificateOfRegistration.particularsOfEngine.cylindersPerSetReciprocating"
              )}
              errors={errors}
              placeholder={t("Enter No. of Cylinders per Set (Reciprocating)")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Diameter of Cylinder (MM)")}
              name="certificateOfRegistration.particularsOfEngine.diameterOfCylinder"
              register={register(
                "certificateOfRegistration.particularsOfEngine.diameterOfCylinder"
              )}
              errors={errors}
              placeholder={t("Enter Diameter of Cylinder (MM)")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("No. of Cylinders per Set for Rotary Engine")}
              name="certificateOfRegistration.particularsOfEngine.cylindersPerSetRotary"
              register={register(
                "certificateOfRegistration.particularsOfEngine.cylindersPerSetRotary"
              )}
              errors={errors}
              placeholder={t("Enter No. of Cylinders per Set (Rotary)")}
              disabled={false}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("B.H.P.")}
              name="certificateOfRegistration.particularsOfEngine.bhp"
              register={register(
                "certificateOfRegistration.particularsOfEngine.bhp"
              )}
              errors={errors}
              placeholder={t("Enter B.H.P.")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("No. of Shaft")}
              name="certificateOfRegistration.particularsOfEngine.noOfShaft"
              register={register(
                "certificateOfRegistration.particularsOfEngine.noOfShaft"
              )}
              errors={errors}
              placeholder={t("Enter No. of Shaft")}
              disabled={false}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Length of Stroke")}
              name="certificateOfRegistration.particularsOfEngine.lengthOfStroke"
              register={register(
                "certificateOfRegistration.particularsOfEngine.lengthOfStroke"
              )}
              errors={errors}
              placeholder={t("Enter Length of Stroke")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Vessel Speed")}
              name="certificateOfRegistration.particularsOfEngine.vesselSpeed"
              register={register(
                "certificateOfRegistration.particularsOfEngine.vesselSpeed"
              )}
              errors={errors}
              placeholder={t("Enter Vessel Speed")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("RPM")}
              name="certificateOfRegistration.particularsOfEngine.rpm"
              register={register(
                "certificateOfRegistration.particularsOfEngine.rpm"
              )}
              errors={errors}
              placeholder={t("Enter RPM")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Propeller Type")}
              name="certificateOfRegistration.particularsOfEngine.propellerType"
              register={register(
                "certificateOfRegistration.particularsOfEngine.propellerType"
              )}
              errors={errors}
              placeholder={t("Enter Propeller Type")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
        </Row>
      </Collapsible>

      <Collapsible
        title={
          <>
            <FaClipboardList className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("PARTICULARS OF BOILERS (IF ANY)")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Description")}
              name="certificateOfRegistration.particularsOfBoilers.description"
              register={register(
                "certificateOfRegistration.particularsOfBoilers.description"
              )}
              errors={errors}
              placeholder={shouldDisableFields ? "" : t("Enter Description")}
              disabled={shouldDisableFields}
              style={shouldDisableFields ? { backgroundColor: "#f8f9fa" } : {}}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Number")}
              name="certificateOfRegistration.particularsOfBoilers.number"
              register={register(
                "certificateOfRegistration.particularsOfBoilers.number"
              )}
              errors={errors}
              placeholder={shouldDisableFields ? "" : t("Enter Number")}
              disabled={shouldDisableFields}
              style={shouldDisableFields ? { backgroundColor: "#f8f9fa" } : {}}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Loaded Pressure")}
              name="certificateOfRegistration.particularsOfBoilers.loadedPressure"
              register={register(
                "certificateOfRegistration.particularsOfBoilers.loadedPressure"
              )}
              errors={errors}
              placeholder={shouldDisableFields ? "" : t("Enter Loaded Pressure")}
              disabled={shouldDisableFields}
              style={shouldDisableFields ? { backgroundColor: "#f8f9fa" } : {}}
            />
          </Col>
        </Row>
      </Collapsible>

      <Collapsible
        title={
          <>
            <FaClipboardList className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("PARTICULARS OF TONNAGE")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Gross Tonnage")}
              name="certificateOfRegistration.particularsOfTonnage.grossTonnage"
              register={register(
                "certificateOfRegistration.particularsOfTonnage.grossTonnage"
              )}
              errors={errors}
              placeholder={t("Enter Gross Tonnage")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Net Tonnage")}
              name="certificateOfRegistration.particularsOfTonnage.netTonnage"
              register={register(
                "certificateOfRegistration.particularsOfTonnage.netTonnage"
              )}
              errors={errors}
              placeholder={t("Enter Net Tonnage")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Number of Crew")}
              name="certificateOfRegistration.particularsOfTonnage.numberOfCrew"
              register={register(
                "certificateOfRegistration.particularsOfTonnage.numberOfCrew"
              )}
              errors={errors}
              placeholder={t("Enter Number of Crew")}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
        </Row>
      </Collapsible>

      <Collapsible
        title={
          <>
            <FaClipboardList className="me-2" style={{ color: "#2466BF" }} />
            <span>
              {t("A detailed summary of the tonnages for this vessel")}
            </span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={12}>
            <div className="mb-3">
              <label htmlFor="summary" className="form-label fw-semibold">
                {t("Summary")}
              </label>
              <textarea
                className="form-control"
                {...register("certificateOfRegistration.summary")}
                placeholder={shouldDisableFields ? "" : t("Enter Summary")}
                id="summary"
                rows="3"
                disabled={shouldDisableFields}
                style={shouldDisableFields ? { backgroundColor: "#f8f9fa" } : {}}
              />
            </div>
          </Col>
        </Row>
      </Collapsible>
    </form>
  );
};

export default CertificateOfRegistrationForm8;
