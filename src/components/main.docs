case 'file':
  return (
    <div style={{ width: '100%' }}>
      <label className="form-label" style={{ fontSize: '14px', fontWeight: '500', marginBottom: '8px', display: 'block' }}>
        {field.label} {field.required && <span style={{ color: 'red' }}>*</span>}
      </label>
      <div style={{
        border: errors[field.name] ? '1px solid #dc3545' : (watch(field.name) ? '1px solid #28a745' : '1px solid #ced4da'),
        borderRadius: '4px',
        padding: '8px 12px',
        backgroundColor: viewMode ? '#f8f9fa' : '#fff',
        position: 'relative',
        minHeight: '38px',
        display: 'flex',
        alignItems: 'center'
      }}>
        <input
          type="file"
          id={field.name}
          accept=".pdf,.jpg,.jpeg,.png"
          disabled={viewMode}
          style={{ display: 'none' }}
          onChange={(e) => {
            if (viewMode) return;
            const file = e.target.files?.[0];
            if (file) {
              // Validate type
              const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
              if (!validTypes.includes(file.type)) {
                setError(field.name, {
                  type: 'manual',
                  message: t('Only PDF, JPG or PNG files are allowed')
                });
                setValue(field.name, null, { shouldValidate: true });
                return;
              }
              // Validate size
              if (file.size > 2 * 1024 * 1024) {
                setError(field.name, {
                  type: 'manual',
                  message: t('File size should not exceed 2MB')
                });
                setValue(field.name, null, { shouldValidate: true });
                return;
              }
              // Rename and set file
              const extension = file.name.substring(file.name.lastIndexOf('.'));
              const fileName = `${field.label}${extension}`;
              file.originalName = fileName;
              const renamedFile = renameFile(file, fileName);
              setValue(field.name, renamedFile, { shouldValidate: true });
              setFormData(prev => ({
                ...prev,
                [field.name]: renamedFile
              }));
              clearErrors(field.name); // <-- Clear error immediately
            } else {
              setValue(field.name, null, { shouldValidate: true });
            }
          }}
        />
        <label
          htmlFor={field.name}
          style={{
            backgroundColor: '#007bff',
            color: 'white',
            padding: '4px 12px',
            borderRadius: '4px',
            cursor: viewMode ? 'not-allowed' : 'pointer',
            fontSize: '12px',
            border: 'none',
            marginRight: '10px',
            opacity: viewMode ? 0.6 : 1
          }}
        >
          {t("Choose File")}
        </label>
        <span style={{
          fontSize: '13px',
          color: '#6c757d',
          overflow: 'hidden',
          textOverflow: 'ellipsis',
          whiteSpace: 'nowrap',
          flex: 1
        }}>
          {watch(field.name)?.name || formData[field.name]?.name || t('No file chosen')}
        </span>
      </div>
      {errors[field.name] && (
        <div style={{ color: '#dc3545', fontSize: '12px', marginTop: '4px' }}>
          {errors[field.name].message}
        </div>
      )}
    </div>
  );
