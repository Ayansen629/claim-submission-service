import React from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";

const themeColor = "#2E57A7";
const successColor = "#28a745";

const Stepper = ({ steps, onSave }) => {
  const { t } = useTranslation();
  const [activeStep, setActiveStep] = useState(0);
  const [completed, setCompleted] = useState({});
  const [errors, setErrors] = useState({});

  const totalSteps = steps.length;

  const handleNext = async () => {
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
      } else {
        toast.error(t("Please fix the errors before proceeding."));
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
    }
  };

  const handleBack = () => {
    setActiveStep((prev) => Math.max(prev - 1, 0));
  };

  const handleStepClick = (index) => {
    // Only allow navigation to completed steps
    if (completed[index] || index < activeStep) {
      setActiveStep(index);
    }
  };

  return (
    <Box sx={{ width: "100%", padding: "1rem" }}>
      {/* Step Header */}
      <Paper
        elevation={3}
        sx={{
          padding: "0.75rem 1.5rem",
          borderRadius: "0.75rem",
          overflowX: "auto",
          whiteSpace: "nowrap",
          backgroundColor: "#fafafa",
          mb: 3
        }}
      >
        <Stack direction="row" alignItems="center" spacing={1}>
          {steps.map((step, index) => (
            <React.Fragment key={index}>
              <Stack
                direction="row"
                alignItems="center"
                spacing={0.5}
                sx={{ cursor: "pointer" }}
                onClick={() => handleStepClick(index)}
              >
                {completed[index] ? (
                  <CheckCircleFill size={18} color={successColor} />
                ) : (
                  <Typography
                    sx={{
                      fontSize: "0.875rem",
                      width: "1.5rem",
                      height: "1.5rem",
                      textAlign: "center",
                      borderRadius: "50%",
                      backgroundColor: "#e0e0e0",
                      display: "inline-flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: "bold",
                      color: "#666",
                    }}
                  >
                    {index + 1}
                  </Typography>
                )}
                <Typography
                  sx={{
                    fontWeight: index === activeStep ? "bold" : "normal",
                    color: index === activeStep ? themeColor : "#999",
                    fontSize: "0.875rem",
                    whiteSpace: "nowrap",
                  }}
                >
                  {step.label}
                </Typography>
              </Stack>
              {index < steps.length - 1 && <ChevronRight size={14} color="#ccc" />}
            </React.Fragment>
          ))}
        </Stack>
      </Paper>

      {/* Step Content */}
      <Paper
        elevation={2}
        sx={{
          marginTop: "1rem",
          borderRadius: "0.75rem",
          backgroundColor: "#fff",
          width: "100%",
          p: 3
        }}
      >
        {steps[activeStep].component}
      </Paper>

      <Divider sx={{ margin: "2rem 0" }} />

      {/* Navigation Buttons */}
      <Box
        sx={{
          display: "flex",
          justifyContent: "space-between",
          gap: "1rem",
          flexWrap: "wrap",
        }}
      >
        <Button
          variant="outlined"
          onClick={handleBack}
          disabled={activeStep === 0}
          sx={{
            color: themeColor,
            borderColor: themeColor,
            fontWeight: "bold",
            borderRadius: "0.5rem",
            minWidth: "8rem",
            fontSize: "0.9rem",
          }}
        >
          {t("Previous")}
        </Button>
        
        {activeStep === totalSteps - 1 ? (
          <Button
            variant="contained"
            onClick={onSave}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            {t("Submit")}
          </Button>
        ) : (
          <Button
            variant="contained"
            onClick={handleNext}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            {t("Next")}
          </Button>
        )}
      </Box>
    </Box>
  );
};

export default Stepper;
