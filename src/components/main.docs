.tableHeaderGroup {
  background: #e9ecef;
  color: #333;
  font-weight: 600;
  padding: 8px 6px;
  text-align: center;
  border: 1px solid #ddd;
  font-size: 0.75rem;
  vertical-align: middle;
}

.tableSubHeader {
  background: #f8f9fa;
  color: #333;
  font-weight: 500;
  padding: 6px 4px;
  text-align: center;
  border: 1px solid #ddd;
  font-size: 0.7rem;
  vertical-align: middle;
}

.safetyTable {
  margin: 0;
  border-collapse: collapse;
  width: 100%;
  border: 1px solid #ddd;
  min-width: 800px;
}

.tableHeader {
  background: #f8f9fa;
  color: #333;
  font-weight: 600;
  padding: 8px 6px;
  text-align: center;
  border: 1px solid #ddd;
  font-size: 0.7rem;
  vertical-align: middle;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .safetyTable {
    min-width: 600px;
  }
  
  .tableHeaderGroup, .tableSubHeader, .tableHeader {
    font-size: 0.65rem;
    padding: 4px 2px;
  }
}
