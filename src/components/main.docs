import React, { createContext, useContext, useState, useEffect } from "react";
import { toast } from "react-toastify";
import { APP_MESSAGES } from "../../utils/constants.ts";
import axios from "axios";

const formatFileInfo = (fileData) => {
  if (!fileData) return "No file uploaded";
  if (typeof fileData === "string") return fileData;
  return fileData.name || fileData.fileName || "File uploaded";
};

// Create the Registration Context
const RegistrationContext = createContext();

// Custom hook to use the Registration Context
export const useRegistration = () => {
  return useContext(RegistrationContext);
};

// ApplicationContextProvider
export const ApplicationContextProvider = ({ children }) => {
  const [registrationData, setRegistrationData] = useState({});
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [isDataLoaded, setIsDataLoaded] = useState(false);

  const getLocalStorageKey = (id) => `registrationData-${id}`;

  const fetchApplicationData = async (uuid) => {
    try {
      setLoading(true);
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullLoginDetails?.userInfo;
      
      if (!userInfo) {
        throw new Error("User information not found");
      }

      const response = await axios.post('/cms-application-service/_application/_search', {
        userInfo: userInfo,
        uuids: [uuid]
      });

      if (response.data?.status?.code !== "200") {
        throw new Error(response.data?.status?.message || "Failed to fetch application data");
      }

      const appDetails = response.data?.applicationDetails?.[0];
      if (!appDetails) {
        throw new Error("No application details found");
      }

      // Transform API response to our form structure
      const transformedData = {
        step1: {
          debtorName: appDetails.creditorBasicDetails?.debtorName || "",
          creditorName: appDetails.creditorBasicDetails?.creditorName || "",
          totalClaimAmount: appDetails.creditorBasicDetails?.totalClaimAmount?.toString() || "",
          debtDetails: appDetails.creditorBasicDetails?.debtDetails || "",
          mutualCreditDetails: appDetails.creditorBasicDetails?.mutualCreditDetails || "",
          identificationType: appDetails.creditorBasicDetails?.document?.docType || "",
          identificationNumber: appDetails.creditorBasicDetails?.identificationNumber || "",
          identificationDocument: formatFileInfo(appDetails.creditorBasicDetails?.document?.docName || "")
        },
        step2: {
          securityInterestAmount: appDetails.claimDetails?.securityInterestAmount?.toString() || "",
          guaranteeAmount: appDetails.claimDetails?.guaranteeAmount?.toString() || "",
          guarantorName: appDetails.claimDetails?.guarantorName || "",
          guarantorAddress: appDetails.claimDetails?.guarantorAddress || "",
          creditorAddress: appDetails.claimDetails?.creditorAddress || "",
          creditorEmail: appDetails.claimDetails?.creditorEmail || "",
          beneficiaryClaimAmount: "", // Not in API response
          beneficiaryName: appDetails.claimDetails?.beneficiaryName || "",
          beneficiaryAddress: appDetails.claimDetails?.beneficiaryAddress || "",
          corporateDebtorClaimAmount: "", // Not in API response
          corporateDebtorSecurityAmount: appDetails.claimDetails?.corporateDebtorSecurityAmount?.toString() || "",
          corporateDebtorGuaranteeAmount: appDetails.claimDetails?.corporateDebtorGuaranteeAmount?.toString() || "",
          principalBorrowerName: appDetails.claimDetails?.principalBorrowerName || "",
          principalBorrowerAddress: appDetails.claimDetails?.principalBorrowerAddress || "",
          accountNumber: appDetails.claimDetails?.bankAccountNumber || "",
          ifscCode: appDetails.claimDetails?.bankIfscCode || "",
          branchName: appDetails.claimDetails?.bankBranchName || "",
          addressProofNumber: appDetails.claimDetails?.addressProofNumber || "",
          addressProofType: "", // Not in API response
          addressProofDocument: formatFileInfo("") // Not in API response
        },
        step3: {
          signatoryName: appDetails.signatoryDetails?.name || "",
          signatoryPosition: appDetails.signatoryDetails?.position || "",
          signatoryAddress: appDetails.signatoryDetails?.address || "",
          signatoryDocument: formatFileInfo(appDetails.signatoryDetails?.document?.docName || "")
        }
      };

      return transformedData;
    } catch (err) {
      console.error("Error fetching application data:", err);
      throw err;
    } finally {
      setLoading(false);
    }
  };

  const loadDataFromLocalStorage = async (id) => {
    try {
      setLoading(true);
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const isCRPUser = userFormData?.userType === "CRP";

      // For CRP users viewing a form (with ID), fetch data from API
      if (isCRPUser && id && !id.startsWith('draft-')) {
        const apiData = await fetchApplicationData(id);
        setRegistrationData(apiData);
        setIsDataLoaded(true);
        return;
      }

      // For drafts, use the draft data from localStorage
      if (id && id.startsWith('draft-')) {
        const drafts = JSON.parse(localStorage.getItem('formDrafts') || '[]');
        const draftData = drafts.find(draft => draft.id === id);
        if (draftData) {
          setRegistrationData(draftData);
          setIsDataLoaded(true);
          return;
        }
      }
      
      // For regular saved data
      const savedData = localStorage.getItem(getLocalStorageKey(id));
      if (savedData) {
        setRegistrationData(JSON.parse(savedData));
      }
      setIsDataLoaded(true);
    } catch (err) {
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setError(err.message || "Error loading data");
    } finally {
      setLoading(false);
    }
  };

  const saveDataToLocalStorage = (id, data) => {
    localStorage.setItem(getLocalStorageKey(id), JSON.stringify(data));
  };

  const handleStepDataFetch = async (stepId, id) => {
    try {
      setLoading(true);
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const isCRPUser = userFormData?.userType === "CRP";

      // For CRP users, fetch data from API
      if (isCRPUser && id && !id.startsWith('draft-')) {
        const apiData = await fetchApplicationData(id);
        setRegistrationData(prev => ({
          ...prev,
          [stepId]: apiData[stepId]
        }));
        return;
      }

      // For drafts, use the draft data directly
      if (id && id.startsWith('draft-')) {
        const drafts = JSON.parse(localStorage.getItem('formDrafts') || '[]');
        const draftData = drafts.find(draft => draft.id === id);
        if (draftData && draftData[stepId]) {
          setRegistrationData(prev => ({
            ...prev,
            [stepId]: draftData[stepId]
          }));
          return;
        }
      }
      
      // For regular data
      const savedData = localStorage.getItem(getLocalStorageKey(id));
      if (savedData) {
        const parsedData = JSON.parse(savedData);
        if (parsedData[stepId]) {
          setRegistrationData(prev => ({
            ...prev,
            [stepId]: parsedData[stepId]
          }));
        }
      }
    } catch (err) {
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setError(err.message || "Error fetching step data");
    } finally {
      setLoading(false);
    }
  };

  const updateRegistrationData = (stepId, updatedData, id) => {
    setRegistrationData(prev => ({
      ...prev,
      [stepId]: updatedData
    }));
    
    if (id) {
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const isCRPUser = userFormData?.userType === "CRP";

      // Don't save updates for CRP users viewing forms
      if (isCRPUser && id && !id.startsWith('draft-')) {
        return;
      }

      if (id.startsWith('draft-')) {
        // Update draft data
        const drafts = JSON.parse(localStorage.getItem('formDrafts') || '[]');
        const draftIndex = drafts.findIndex(draft => draft.id === id);
        
        if (draftIndex >= 0) {
          const updatedDraft = {
            ...drafts[draftIndex],
            [stepId]: updatedData,
            lastSaved: new Date().toISOString()
          };
          
          drafts[draftIndex] = updatedDraft;
          localStorage.setItem('formDrafts', JSON.stringify(drafts));
        }
      } else {
        // Update regular data
        saveDataToLocalStorage(id, {
          ...registrationData,
          [stepId]: updatedData
        });
      }
    }
  };

  const handleFileUpload = (stepId, fieldName, file, id) => {
    const userFormData = JSON.parse(localStorage.getItem("userFormData"));
    const isCRPUser = userFormData?.userType === "CRP";

    // Don't allow file uploads for CRP users viewing forms
    if (isCRPUser && id && !id.startsWith('draft-')) {
      toast.info("CRP users cannot modify submitted forms");
      return;
    }

    const filePath = URL.createObjectURL(file);
    const updatedData = {
      ...registrationData[stepId],
      [fieldName]: {
        path: filePath,
        file
      }
    };
    
    updateRegistrationData(stepId, updatedData, id);
  };

  return (
    <RegistrationContext.Provider
      value={{
        registrationData,
        loading,
        error,
        isViewModalOpen,
        setIsViewModalOpen,
        handleStepDataFetch,
        updateRegistrationData,
        handleFileUpload,
        setRegistrationData,
        loadDataFromLocalStorage,
        isDataLoaded,
      }}
    >
      {children}
    </RegistrationContext.Provider>
  );
};
