import React, { useEffect } from "react";
import {
    FaCheckCircle,
    FaTimesCircle,
    FaExclamationCircle,
    FaInfoCircle,
} from "react-icons/fa";
import "../common/styles/AlertBox.css";

const iconMap = {
    success: <FaCheckCircle />,
    error: <FaTimesCircle />,
    warning: <FaExclamationCircle />,
    info: <FaInfoCircle />,
};

const AlertBox = ({
    type = "info",
    title,
    message,
    buttons = [],
    onClose,
    closeOnBackdrop = true,
    autoDismiss = false,
    dismissTime = 3000,
}) => {
    useEffect(() => {
        let timer;
        if (autoDismiss && onClose) {
            timer = setTimeout(() => {
                onClose();
            }, dismissTime);
        }
        return () => clearTimeout(timer);
    }, [autoDismiss, dismissTime, onClose]);

    const handleBackdropClick = () => {
        if (closeOnBackdrop && onClose) onClose();
    };

    return (
        <div className="alert-backdrop" onClick={handleBackdropClick}>
            <div
                className={`alert-box alert-${type}`}
                onClick={(e) => e.stopPropagation()}
            >
                <div className="alert-icon">{iconMap[type]}</div>
                <div className="alert-content">
                    {title && <h4 className="alert-title">{title}</h4>}
                    <p className="alert-message">{message}</p>
                </div>
                <div className="alert-buttons">
                    {buttons.map((btn, idx) => (
                        <button
                            key={idx}
                            className={`alert-btn alert-btn-${btn.variant || "primary"}`}
                            onClick={btn.onClick}
                        >
                            {btn.label}
                        </button>
                    ))}
                </div>
            </div>
        </div>
    );
};

export default AlertBox;
