      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Status",
      minWidth: "10rem",
    },
    {
      colName: "Amount",
      fieldName: "amount",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Amount",
      minWidth: "10rem",
    },
    {
      colName: "Date Submitted",
      fieldName: "dateSubmitted",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Date Submitted",
      minWidth: "10rem",
    },
    {
      colName: "Action",
      fieldName: "action",
      actions: ["view", "edit"],
      clsName: "col-sm-2 column-text-start actions-column",
    },
  ];

  // const handleAddButtonClick = () => {
