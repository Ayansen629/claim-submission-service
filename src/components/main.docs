const [editableData, setEditableData] = useState({
  expiryDay: expiryDate.getDate().toString().padStart(2, '0'),
  expiryMonth: (expiryDate.getMonth() + 1).toString().padStart(2, '0'),
  expiryYear: expiryDate.getFullYear().toString(),
  certificateNo: '',
  loadingMarksOnSide: 'Yes',
  notExtendingBeyondNauticalMiles: '',
  plyingLimits: '',
  certificationConfirmed: false, // Add this
  validityConfirmed: false, // Add this
  safetyEquipment: {
    // ... existing safety equipment fields
  }
});

const validateRequiredFields = () => {
  const newErrors = {};
  
  // ... existing validations
  
  if (!editableData.certificationConfirmed) {
    newErrors.certificationConfirmed = 'You must confirm the certification statement';
  }
  if (!editableData.validityConfirmed) {
    newErrors.validityConfirmed = 'You must confirm the validity statement';
  }

  // ... rest of existing validation logic
  
  setErrors(newErrors);
  return Object.keys(newErrors).length === 0;
};

// Update the Certificate Statement section:
{/* Certificate Statement */}
<div className={styles.certificationBox}>
  <h6 className={styles.certificationTitle}>{t("THIS IS TO CERTIFY")}</h6>
  <p className={styles.certificationText}>
    {t("that the provisions of the rules with respect to the survey of the above mentioned Inland Vessel and the Transmission of declaration in respect thereof, have been complied with.")}
  </p>
  
  <div className={styles.checkboxContainer}>
    <label className={styles.checkboxLabel}>
      <input
        type="checkbox"
        className={styles.checkbox}
        checked={editableData.certificationConfirmed}
        onChange={(e) => handleInputChange('certificationConfirmed', e.target.checked)}
      />
      <span className={styles.checkboxText}>
        I confirm that the above certification statement is accurate and complete. <span className={styles.asterisk}>*</span>
      </span>
    </label>
    {errors.certificationConfirmed && (
      <div className={styles.errorMessage}>{errors.certificationConfirmed}</div>
    )}
  </div>
</div>

{/* Validity Statement */}
<div className={styles.validityBox}>
  <p>
    {t("This Provisional Certificate of Survey, issued under the provisions of section 13(1) of the Inland Vessels Act, 2021 continues to be in force only until the")} 
    <strong> ({editableData.expiryDay}-{editableData.expiryMonth}-{editableData.expiryYear})</strong>
  </p>
  
  <div className={styles.checkboxContainer}>
    <label className={styles.checkboxLabel}>
      <input
        type="checkbox"
        className={styles.checkbox}
        checked={editableData.validityConfirmed}
        onChange={(e) => handleInputChange('validityConfirmed', e.target.checked)}
      />
      <span className={styles.checkboxText}>
        I acknowledge and understand the validity period of this certificate. <span className={styles.asterisk}>*</span>
      </span>
    </label>
    {errors.validityConfirmed && (
      <div className={styles.errorMessage}>{errors.validityConfirmed}</div>
    )}
  </div>
</div>
