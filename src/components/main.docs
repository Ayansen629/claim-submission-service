{col.actions?.includes("track") && (
  <OverlayTrigger overlay={<Tooltip>Track</Tooltip>}>
    <Button 
      variant="outline-primary" 
      size="sm" 
      onClick={() => handleTrack(row)}
      style={{ 
        padding: '0.25rem',
        // Normal state styles
        '--normal-icon-color': 'brightness(0) saturate(100%) invert(35%) sepia(98%) saturate(1248%) hue-rotate(183deg) brightness(93%) contrast(96%)',
        // Hover state styles
        '--hover-icon-color': 'brightness(0) invert(1)'
      }}
    >
      <img 
        src={trackIcon} 
        alt="track" 
        style={{ 
          width: "16px", 
          height: "16px",
          filter: 'var(--normal-icon-color)',
          transition: 'filter 0.3s ease'
        }} 
        onMouseEnter={(e) => e.currentTarget.style.filter = 'var(--hover-icon-color)'}
        onMouseLeave={(e) => e.currentTarget.style.filter = 'var(--normal-icon-color)'}
      />
    </Button>
  </OverlayTrigger>
)}
