import React, { useState, useContext, useEffect } from "react";
import { useForm } from "react-hook-form";
import { useNavigate } from "react-router-dom";
import { toast } from "react-toastify";
import { UserContext } from "../../components/context/UserContext.js";
import "./Login.css";
// import axios from "axios";

import { URLS_ENDPOINT } from "../../utils/urlsConstants.ts";
import { postData } from "../../services/http.service.ts";

const LoginPage = () => {
  const {
    register,
    handleSubmit,
    watch,
    formState: { errors },
    reset,
    setValue,
  } = useForm();
  const navigate = useNavigate();
  const { setUserData } = useContext(UserContext);

  const [otpSent, setOtpSent] = useState(false);
  const [otp, setOtp] = useState("");
  const [loading, setLoading] = useState(false);
  const [selectedRadio, setSelectedRadio] = useState("corporateDebtor");
  const [claimantTypes, setClaimantTypes] = useState([]);
  const [claimantCategories, setClaimantCategories] = useState([]);
  const [apiLoading, setApiLoading] = useState(false);

  const username = watch("username");
  const email = watch("email");
  const password = watch("password");
  const userType = watch("userType");
  const financialCreditorType = watch("financialCreditorType");
  const operationalCreditorType = watch("operationalCreditorType");
  const processType = watch("processType");
  const corporateDebtorName = watch("corporateDebtorName");

  useEffect(() => {
    reset({
      username: "",
      email: "",
      password: "",
      userType: "",
      financialCreditorType: "",
      operationalCreditorType: "",
      processType: "",
      corporateDebtorName: "",
    });
    setOtpSent(false);
    setOtp("");
  }, [selectedRadio, reset]);

  // Fetch initial claimant types when component mounts
  useEffect(() => {
    if (selectedRadio === "claimants") {
      fetchClaimantTypes();
    }
  }, [selectedRadio]);

  // Fetch claimant categories when userType changes
  useEffect(() => {
    if (userType && selectedRadio === "claimants") {
      const selectedType = claimantTypes.find(type => type.claimantName === userType);
      if (selectedType) {
        fetchClaimantCategories(selectedType.claimantCode);
      } else {
        setClaimantCategories([]);
        setValue("financialCreditorType", "");
        setValue("operationalCreditorType", "");
      }
    }
  }, [userType, claimantTypes]);

  const fetchClaimantTypes = async () => {
    try {
      setApiLoading(true);
      const DROPDOWNLIST =
      process.env.REACT_APP_MASTER_SERVICE +
      URLS_ENDPOINT.MASTER_SERVICES.USER_CLAIMANT_DROPDOWNLIST ;
 
    const response = await postData(DROPDOWNLIST, {});
      console.log("Claimant Types Response:", response);
    ;
    // const response= await axios.post("http://15.206.115.75:8001/cms-common-service/cms/claimantsMasterData");
 
      if (response.data.status.code === "200") {
        setClaimantTypes(response.data.claimantMasterData.claimantTypes
          || []);
      } else {
        toast.error(response.data.status.message || "Failed to fetch claimant types");

      }
    } catch (error) {
      console.error("Error fetching claimant types:", error);
      toast.error(error.response.data.status.message||"Error fetching claimant types");
    } finally {
      setApiLoading(false);
    }
  };

  const fetchClaimantCategories = async (claimantCode) => {
    console.log("Claimant Code:", claimantCode);
    try {
      setApiLoading(true);
      const DROPDOWNLIST_DATA =
      process.env.REACT_APP_MASTER_SERVICE +
      URLS_ENDPOINT.MASTER_SERVICES.USER_CLAIMANTWISE_DROPDOWNLIST + claimantCode;
      const response = await postData(DROPDOWNLIST_DATA, {});
      ;
   
      if (response.data.status.code === "200") {
        setClaimantCategories(response.data.claimantMasterData.claimantCategories || []);
      } else {
        toast.error("Failed to fetch claimant categories");
      }
    } catch (error) {
      console.error("Error fetching claimant categories:", error);
      toast.error("Error fetching claimant categories");
    } finally {
      setApiLoading(false);
    }
  };

  const isValidUsername = (username) => /^[6-9]\d{9}$/.test(username);
  const isValidEmail = (email) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

  const isClaimantsFormValid = () => {
    if (selectedRadio === "claimants") {
      return (
        isValidUsername(username) &&
        userType &&
        processType &&
        corporateDebtorName &&
        (userType !== "Financial Creditors" || financialCreditorType) &&
        (userType !== "Operational Creditors" || operationalCreditorType)
      );
    }
    return false;
  };

  const isCorporateDebtorFormValid = () => {
    if (selectedRadio === "corporateDebtor") {
      return isValidEmail(email) && password?.length >= 6 && watch("termsAccepted");
    }
    return false;
  };

  const handleSendOTP = async () => {
    if (!isClaimantsFormValid()) {
      toast.error("Please provide valid details.");
      return;
    }

    setLoading(true);
    setTimeout(() => {
      const payload = {
        userType: "CLM",
        userId: username,
        processType,
        corporateDebtorName,
        claimantType: userType,
        claimantCategoryType: userType === "Financial Creditors" 
          ? financialCreditorType 
          : operationalCreditorType,
        otp: "123456",
      };

      console.log("OTP Payload:", payload);
      toast.success("OTP Sent");
      setOtpSent(true);
      setLoading(false);
    }, 1000);
  };

  const handleVerifyOTP = async (data) => {
    if (!otp) {
      toast.error("Please enter OTP");
      return;
    }
    if (!data.termsAccepted) {
      toast.info("Please accept terms");
      return;
    }

    setLoading(true);
    setTimeout(() => {
      if (otp === "123456") {
        const payload = {
          userType: "CLM",
          userId: username,
          processType,
          corporateDebtorName,
          claimantType: userType,
          claimantCategoryType: userType === "Financial Creditors" 
            ? financialCreditorType 
            : operationalCreditorType,
        };

        setUserData(payload);
        localStorage.setItem("userFormData", JSON.stringify(payload));
        toast.success("Login Successful");
        navigate("/dashboard");
      } else {
        toast.error("Invalid OTP");
      }
      setLoading(false);
    }, 1000);
  };

  const handleCorporateDebtorLogin = async (data) => {
    setLoading(true);
    setTimeout(() => {
      const payload = {
        userType: "CRP",
        email: data.email,
      };
      console.log("Corporate Debtor Payload:", payload);
      setUserData(payload);
      localStorage.setItem("userFormData", JSON.stringify(payload));
      toast.success("Login Successful");
      navigate("/dashboard");
      setLoading(false);
    }, 1000);
  };

  // Options data
  const processTypeOptions = [
    { value: "CIRP", label: "Corporate Insolvency Resolution Process (CIRP)" },
    { value: "Liquidation", label: "Liquidation" },
    { value: "Voluntary Liquidation", label: "Voluntary Liquidation" },
    { value: "PPIRP", label: "Pre-packaged Insolvency Resolution Process (PPIRP)" },
  ];

  const corporateDebtorOptions = [
    { value: "Jalpower Corporation Limited", label: "Jalpower Corporation Limited" },
    { value: "Neesa Leisure Limited", label: "Neesa Leisure Limited" },
    { value: "Empathy Infra and Engineering Private Limited", label: "Empathy Infra and Engineering Private Limited" },
    { value: "Simpa Energy India Private Limited", label: "Simpa Energy India Private Limited" },
    { value: "Eicher Polaris Private Limited", label: "Eicher Polaris Private Limited" },
  ];

  return (
    <div className="login-page">
      <div className="login-container">
        <div className="Login-header">
          <div className="login-text">LOG IN</div>
        </div>
        
        <div className="radio-options">
          <div className={`radio-op ${selectedRadio === "corporateDebtor" ? "active" : ""}`}>
            <input
              type="radio"
              id="corporateDebtor"
              name="radioGroup"
              checked={selectedRadio === "corporateDebtor"}
              onChange={() => setSelectedRadio("corporateDebtor")}
            />
            <label htmlFor="corporateDebtor">Corporate Debtor</label>
          </div>
          <div className={`radio-op ${selectedRadio === "claimants" ? "active" : ""}`}>
            <input
              type="radio"
              id="claimants"
              name="radioGroup"
              checked={selectedRadio === "claimants"}
              onChange={() => setSelectedRadio("claimants")}
            />
            <label htmlFor="claimants">Claimants</label>
          </div>
        </div>

        <div className="login-form">
          {selectedRadio === "claimants" ? (
            <form onSubmit={handleSubmit(handleVerifyOTP)}>
              {/* Mobile Number */}
              <div className="form-group">
                <input
                  className="user-input"
                  type="text"
                  {...register("username", {
                    required: "Mobile number is required",
                    pattern: {
                      value: /^[6-9]\d{9}$/,
                      message: "Invalid mobile number"
                    }
                  })}
                  placeholder="Mobile Number"
                />
                {errors.username && <p className="error-message">{errors.username.message}</p>}
              </div>

              {/* Process Type */}
              <div className="dropdown-container">
                <select
                  className="dropdown-select"
                  {...register("processType", { required: "Process type is required" })}
                >
                  <option value="">Process Type</option>
                  {processTypeOptions.map(opt => (
                    <option key={opt.value} value={opt.value}>{opt.label}</option>
                  ))}
                </select>
                {errors.processType && <p className="error-message">{errors.processType.message}</p>}
              </div>

              {/* Corporate Debtor Name */}
              <div className="dropdown-container">
                <select
                  className="dropdown-select"
                  {...register("corporateDebtorName", { required: "Corporate Debtor name is required" })}
                >
                  <option value="">Corporate Debtor Name</option>
                  {corporateDebtorOptions.map(opt => (
                    <option key={opt.value} value={opt.value}>{opt.label}</option>
                  ))}
                </select>
                {errors.corporateDebtorName && <p className="error-message">{errors.corporateDebtorName.message}</p>}
              </div>

              {/* Claimant Type */}
              <div className="dropdown-container">
                <select
                  className="dropdown-select"
                  {...register("userType", { 
                    required: "Claimant type is required",
                    onChange: (e) => {
                      setValue("financialCreditorType", "");
                      setValue("operationalCreditorType", "");
                    }
                  })}
                  disabled={apiLoading}
                >
                  <option value="">Claimant Type</option>
                  {claimantTypes?.map(opt => (
                    <option key={opt.uuid} value={opt.claimantName}>{opt.claimantName}</option>
                  ))}
                </select>
                {errors.userType && <p className="error-message">{errors.userType.message}</p>}
              </div>

              {/* Financial Creditor Type (conditional) */}
              {userType === "Financial Creditors" && (
                <div className="dropdown-container">
                  <select
                    className="dropdown-select"
                    {...register("financialCreditorType", { required: "Financial creditor type is required" })}
                    disabled={apiLoading}
                  >
                    <option value="">Financial Creditor Type</option>
                    {claimantCategories.map(opt => (
                      <option key={opt.uuid} value={opt.claimantCategoryName}>{opt.claimantCategoryName}</option>
                    ))}
                  </select>
                  {errors.financialCreditorType && <p className="error-message">{errors.financialCreditorType.message}</p>}
                </div>
              )}

              {/* Operational Creditor Type (conditional) */}
              {userType === "Operational Creditors" && (
                <div className="dropdown-container">
                  <select
                    className="dropdown-select"
                    {...register("operationalCreditorType", { required: "Operational creditor type is required" })}
                    disabled={apiLoading}
                  >
                    <option value="">Operational Creditor Type</option>
                    {claimantCategories.map(opt => (
                      <option key={opt.uuid} value={opt.claimantCategoryName}>{opt.claimantCategoryName}</option>
                    ))}
                  </select>
                  {errors.operationalCreditorType && <p className="error-message">{errors.operationalCreditorType.message}</p>}
                </div>
              )}

              {/* OTP Section */}
              {!otpSent ? (
                <button
                  type="button"
                  className="send-otp-btn"
                  onClick={handleSendOTP}
                  disabled={!isClaimantsFormValid() || loading || apiLoading}
                >
                  {loading ? "Sending..." : "Send OTP"}
                </button>
              ) : (
                <div className="otp-verification">
                  <input
                    type="text"
                    value={otp}
                    onChange={(e) => setOtp(e.target.value)}
                    placeholder="Enter OTP"
                    className="user-input"
                  />
                </div>
              )}

              {/* Terms and Submit */}
              <div className="terms-conditions">
                <input
                  type="checkbox"
                  id="termsAccepted"
                  {...register("termsAccepted", { required: "You must accept terms" })}
                />
                <label htmlFor="termsAccepted">
                  I accept the <a href="/terms">Terms & Conditions</a>
                </label>
                {errors.termsAccepted && <p className="error-message">{errors.termsAccepted.message}</p>}
              </div>

              <button
                type="submit"
                className="login-btn"
                disabled={!otpSent || !otp || loading || !watch("termsAccepted") || apiLoading}
              >
                {loading ? "Verifying..." : "Verify OTP & Login"}
              </button>

              <div className="register-text" onClick={() => navigate("/register/claimants")}>
                Don't have an account? <span className="register-link">Register here</span>
              </div>
            </form>
          ) : (
            <form onSubmit={handleSubmit(handleCorporateDebtorLogin)}>
              {/* Email Field */}
              <div className="form-group">
                <input
                  className="user-input"
                  type="email"
                  {...register("email", {
                    required: "Email is required",
                    pattern: {
                      value: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
                      message: "Invalid email format"
                    }
                  })}
                  placeholder="Email ID"
                />
                {errors.email && <p className="error-message">{errors.email.message}</p>}
              </div>

              {/* Password Field */}
              <div className="form-group">
                <input
                  className="user-input"
                  type="password"
                  {...register("password", {
                    required: "Password is required",
                    minLength: {
                      value: 6,
                      message: "Password must be at least 6 characters"
                    }
                  })}
                  placeholder="Password"
                />
                {errors.password && <p className="error-message">{errors.password.message}</p>}
              </div>

              {/* Terms and Submit */}
              <div className="terms-conditions">
                <input
                  type="checkbox"
                  id="termsAccepted"
                  {...register("termsAccepted", { required: "You must accept terms" })}
                />
                <label htmlFor="termsAccepted">
                  I accept the <a href="/terms">Terms & Conditions</a>
                </label>
                {errors.termsAccepted && <p className="error-message">{errors.termsAccepted.message}</p>}
              </div>

              <button
                type="submit"
                className="login-btn"
                disabled={!isCorporateDebtorFormValid() || loading}
              >
                {loading ? "Logging in..." : "Login"}
              </button>

              <div className="register-text" onClick={() => navigate("/register/corporate-debtor")}>
                Don't have an account? <span className="register-link">Register here</span>
              </div>
            </form>
          )}
        </div>
      </div>
    </div>
  );
};

