   color: #1A61C1;
  transform: scale(1.1);
}

.option {
  cursor: pointer;
  transition: all 0.3s ease;
}

.option:hover {
  background: rgba(26, 97, 193, 0.05);
  border-radius: 8px;
  padding: 8px;
  margin: -8px;
}

/* Modal Styles */
.modalOverlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modalContent {
  background: white;
  border-radius: 20px;
  max-width: 500px;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  position: relative;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
}

.modalHeader {
  position: relative;
  padding: 20px 20px 0 20px;
}

.closeButton {
  position: absolute;
  top: 15px;
  right: 15px;
  background: none;
  border: none;
  font-size: 20px;
  color: #666;
  cursor: pointer;
  padding: 5px;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.closeButton:hover {
  background: #f0f0f0;
  color: #333;
}

.modalBody {
  padding: 20px 30px;
  text-align: center;
}

.modalImage {
  width: 80px;
  height: 80px;
  margin: 0 auto 20px;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid #1A61C1;
}

.modalImage img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.modalTitle {
  color: #1A61C1;
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 20px;
}

.modalText {
  color: #333;
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 20px;
  line-height: 1.5;
}

.modalList {
  text-align: left;
  color: #555;
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 30px;
  padding-left: 0;
}

.modalList li {
  margin-bottom: 12px;
  padding-left: 20px;
  position: relative;
}

.modalList li::before {
  content: '•';
  color: #1A61C1;
  font-weight: bold;
  position: absolute;
  left: 0;
}

.modalFooter {
  display: flex;
  justify-content: center;
  gap: 20px;
  padding: 0 30px 30px;
}

.cancelButton {
  background: transparent;
  color: #dc2626;
  border: 2px solid #dc2626;
  padding: 12px 24px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 16px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.cancelButton:hover {
  background: #dc2626;
  color: white;
}

.proceedNowButton {
  background: #1A61C1;
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 16px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.proceedNowButton:hover {
  background: #1548a0;
  transform: translateY(-1px);
}



.proceedButton {
  background:#1A61C1;
  color: white;
  border: none;
  padding: 12px 30px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 16px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.proceedButton:hover {
  background: #1A61C1;
  transform: translateY(-1px);
}

/* Modal Responsive Styles */
@media (max-width: 768px) {
  .modalContent {
    width: 95%;
    max-width: none;
  }
  
  .modalBody {
    padding: 15px 20px;
  }
  
  .modalTitle {
    font-size: 20px;
  }
  
  .modalText {
    font-size: 14px;
  }
  
  .modalList {
    font-size: 13px;
  }
  
  .modalFooter {
    flex-direction: column;
    padding: 0 20px 20px;
  }
  
  .cancelButton,
  .proceedNowButton {
    width: 100%;
    padding: 12px;
  }
}

@media (max-width: 480px) {
  .modalContent {
    width: 98%;
    border-radius: 15px;
  }
  
  .modalImage {
    width: 60px;
    height: 60px;
  }
  
  .modalTitle {
    font-size: 18px;
  }
  
  .modalText {
    font-size: 13px;
  }
  
  .modalList {
    font-size: 12px;
  }
  
  .cancelButton,
  .proceedNowButton {
    font-size: 14px;
    padding: 10px;
  }
}

/* Large tablets */
@media (max-width: 1024px) {
  .container {
    padding: 15px;
  }
  
  .card {
    max-width: 500px;
    padding: 50px 25px 25px 25px;
  }
}

/* Tablets */
@media (max-width: 768px) {
  .container {
    padding: 10px;
    min-height: 100vh;
  }
  
  .card {
    max-width: 90%;
    padding: 50px 20px 25px 20px;
    margin-top: 50px;
  }
  
  .circularImage {
    width: 100px;
    height: 100px;
    top: -50px;
  }
  
  .companyName {
    font-size: 28px;
    margin: 30px 0 20px 0;
  }
  
  .contactRow {
    flex-direction: column;
    gap: 15px;
  }
  
  .documentRow {
    flex-direction: column;
    gap: 10px;
  }
  
  .optionsSection {
    flex-direction: column;
    gap: 15px;
    align-items: center;
    padding: 15px;
  }
}

/* Mobile landscape */
@media (max-width: 640px) {
  .container {
    padding: 8px;
    align-items: flex-start;
    padding-top: 20px;
  }
  
  .card {
    max-width: 95%;
    padding: 45px 15px 20px 15px;
    margin-top: 40px;
    border-radius: 15px;
  }
  
  .circularImage {
    width: 90px;
    height: 90px;
    top: -45px;
  }
  
  .companyName {
    font-size: 24px;
    margin: 25px 0 15px 0;
  }
  
  .contactRow {
    gap: 12px;
  }
  
  .contactItem {
    font-size: 14px;
  }
  
  .docLabel {
    font-size: 12px;
  }
  
  .optionsSection {
    padding: 12px;
  }
  
  .proceedButton {
    padding: 10px 25px;
    font-size: 14px;
  }
}

/* Small mobile phones */
@media (max-width: 480px) {
  .container {
    padding: 5px;
    min-height: 100vh;
  }
  
  .card {
    max-width: 98%;
    padding: 40px 12px 18px 12px;
    margin-top: 35px;
    border-radius: 12px;
  }
  
  .circularImage {
    width: 80px;
    height: 80px;
    top: -40px;
    border: 3px solid white;
  }
  
  .companyName {
    font-size: 22px;
    margin: 20px 0 12px 0;
  }
  
  .contactRow {
    gap: 10px;
  }
  
  .contactItem {
    font-size: 13px;
  }
  
  .documentRow {
    gap: 8px;
  }
  
  .docBox {
    padding: 6px 8px;
  }
  
  .docLabel {
    font-size: 11px;
  }
  
  .vesselHeader {
    font-size: 14px;
  }
  
  .optionsSection {
    padding: 10px;
    gap: 12px;
  }
  
  .option span {
    font-size: 14px;
  }
  
  .proceedButton {
    padding: 8px 20px;
    font-size: 13px;
  }
}

/* Extra small phones */
@media (max-width: 360px) {
  .container {
    padding: 3px;
  }
  
  .card {
    max-width: 99%;
    padding: 35px 10px 15px 10px;
    margin-top: 30px;
  }
  
  .circularImage {
    width: 70px;
    height: 70px;
    top: -35px;
  }
  
  .companyName {
    font-size: 20px;
    margin: 18px 0 10px 0;
  }
  
  .contactItem {
    font-size: 12px;
  }
  
  .docLabel {
    font-size: 10px;
  }
  
  .vesselHeader {
    font-size: 13px;
  }
  
  .option span {
    font-size: 13px;
  }
  
  .proceedButton {
    padding: 7px 18px;
    font-size: 12px;
  }
}
