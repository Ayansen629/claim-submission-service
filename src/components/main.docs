        {/* Crew Details */}
        <Collapsible
          title={
            <>
              <FaUsers className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Crew Details")}</span>
            </>
          }
          openStat={true}
        >
          <div style={{ padding: "1rem" }}>
            {fields.map((field, index) => (
              <Row key={field.id} className="gy-3 mb-3 border-bottom pb-3">
                <Col md={4}>
                  <InputText
                    label={t("Total No. of Deck Crew")}
                    name={`crewDetails.crewDetails.${index}.totalDeckCrew`}
                    type="number"
                    placeholder={t("Enter total no. of deck crew")}
                    register={register(
                      `crewDetails.crewDetails.${index}.totalDeckCrew`
                    )}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={4}>
                  <InputText
                    label={t("Total No. of Engine Crew")}
                    name={`crewDetails.crewDetails.${index}.totalEngineCrew`}
                    type="number"
                    placeholder={t("Enter total no. of engine crew")}
                    register={register(
                      `crewDetails.crewDetails.${index}.totalEngineCrew`
                    )}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputSelect
                    label={t("Crew Type")}
                    required={true}
                    name={`crewDetails.crewDetails.${index}.crewType`}
                    options={[
                      {
                        value: "",
                        label: "-- Select --",
                      },
                      ...(masterData?.crewTypes?.map((type) => ({
                        value: type.valueCode,
                        label: type.valueLabel,
                      })) || []),
                    ]}
                    register={register(
                      `crewDetails.crewDetails.${index}.crewType`,
                      {
                        required: t("Crew Type is required"),
                      }
                    )}
                    errors={errors}
                    value={
                      watch(`crewDetails.crewDetails.${index}.crewType`) || ""
                    }
                    onChange={(value) =>
                      !viewMode &&
                      handleSelectChange(
                        `crewDetails.crewDetails.${index}.crewType`,
                        value
                      )
                    }
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Name")}
                    required={true}
                    name={`crewDetails.crewDetails.${index}.name`}
                    placeholder={t("Enter Name")}
                    register={register(
                      `crewDetails.crewDetails.${index}.name`,
                      {
                        required: t("Name is required"),
                      }
                    )}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Rank")}
                    name={`crewDetails.crewDetails.${index}.rank`}
                    placeholder={t("Enter Rank")}
                    register={register(`crewDetails.crewDetails.${index}.rank`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("COC No.")}
                    name={`crewDetails.crewDetails.${index}.cocNo`}
                    placeholder={t("Enter COC No.")}
                    register={register(
                      `crewDetails.crewDetails.${index}.cocNo`
                    )}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Validity")}
                    name={`crewDetails.crewDetails.${index}.validity`}
                    placeholder={t("Enter Validity")}
                    register={register(
                      `crewDetails.crewDetails.${index}.validity`
                    )}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Place of Issue")}
                    name={`crewDetails.crewDetails.${index}.placeOfIssue`}
                    placeholder={t("Enter Place of Issue")}
                    register={register(
                      `crewDetails.crewDetails.${index}.placeOfIssue`
                    )}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                {!viewMode && index > 0 && (
                  <Col md={12} className="text-end">
                    <Button
                      variant="danger"
                      size="sm"
                      onClick={() => remove(index)}
                      className="mt-1"
                    >
                      <FaTrash /> Remove
                    </Button>
                  </Col>
                )}
              </Row>
            ))}
            {!viewMode && (
              <Button
                variant="outline-primary"
                onClick={() =>
                  append({
                    totalDeckCrew: "",
                    totalEngineCrew: "",
                    crewType: "",
                    name: "",
                    rank: "",
                    cocNo: "",
                    validity: "",
                    experience: "",
                  })
                }
                className="mt-2"
              >
                <FaPlus className="me-2" /> Add Crew Member
              </Button>
            )}
          </div>
        </Collapsible>

        {/* Enclosure */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>{t("ENCLOSURE")}</span>
            </div>
          }
          defaultOpen={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "authorizationFile",
                    t("Authorization of Authorised Person")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "paymentChallan",
                    t("Payment Challan/Acknowledgement")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "builderCertificate",
                    t("Builder Certificate")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "lastCertificateCopy",
                    t("Copy of last Certificate of Survey")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "registrationCertificateCopy",
                    t("Copy of Certificate of Registration")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("testCertificate", t("Test Certificate"))}
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>
        {/* Provisional Certificates */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>
                {t("Provisional Certificates")}
              </span>
            </div>
          }
          defaultOpen={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col xs={12} md={6}>
                  <div className="form-check">
                    <input
                      className="form-check-input"
                      type="checkbox"
                      id="provisionalSurveyCertificate"
                      {...register("provisionalCertificates.surveyCertificate")}
                      disabled={viewMode}
                    />
                    <label
                      className="form-check-label"
                      htmlFor="provisionalSurveyCertificate"
                    >
                      {t("Provisional Survey Certificate")}
                    </label>
                  </div>
                </Col>
                <Col xs={12} md={6}>
                  <div className="form-check">
                    <input
                      className="form-check-input"
                      type="checkbox"
                      id="provisionalRegistrationCertificate"
                      {...register(
                        "provisionalCertificates.registrationCertificate"
                      )}
                      disabled={viewMode}
                    />
                    <label
                      className="form-check-label"
                      htmlFor="provisionalRegistrationCertificate"
                    >
                      {t("Provisional Registration Certificate")}
                    </label>
                  </div>
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>
      </form>
    </>
  );
};

export default VesselSurveyForm;
