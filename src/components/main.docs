                register={register("navigationEquipment.othersNavigation")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
          </Row>
        </Collapsible>

        {/* Pollution Control Devices */}
        <Collapsible
          title={
            <>
              <FaLeaf className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Pollution Control Devices")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Bilge Water Separator")}
                name="polutionControl.bilgeWaterSeparator"
