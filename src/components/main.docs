import { useNavigate } from "react-router-dom";
import "react-toastify/dist/ReactToastify.css";
import { postData } from "../../../../services/http.service";
import { useTranslation } from "react-i18next";
import { useEffect, useState } from "react";
import ActionTable from "../../../common/ActionTable.tsx";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import { toast } from "react-toastify";
import ActionModal from "../../../common/ActionModal.tsx";
import {
  APP_MESSAGES,
  CONSTANT_REGEX_SAMPLE,
} from "../../../../utils/constants.ts";
import UserManageForm from "./userManageForm";
import { USER_REGIS_MASTER } from "./userManagConst.ts";
import { Card, Row, Col, Button } from "react-bootstrap";
import { useForm } from "react-hook-form";
import InputSelect from "../../../common/InputSelect.tsx";
import InputText from "../../../common/InputText.tsx";
const formData: any = {
  salutation: "",
  nameAsPerAadhar: "",
  userName: "",
  firstName: "",
  middleName: "",
  lastName: "",
  mobileNumber: "",
  aadharNumber: "",
  password: "",
  plainPassword: "",
  active: true,
  isBlocked: false,
  blockedAt: "",
  alternateMobileNumber: "",
  emailId: "",
  gender: "",
  panNumber: "",
  voterIdNumber: "",
  drivingLicense: "",
  address: "",
  gurdianName: "",
  gurdianRelation: "",
  type: "",
  dob: "",
  ageOnDate: "",
  bloodGroup: "",
  photo: "",
  identificationMark: "",
  nationality: "",
  educationQualification: "",
  individualTypeDesignation: "",
  panAttachmentUrl: "",
  passwordExpiryDate: "",
  rolesCode: "",
  districtName: "",
  blockName: "",
  panchayatName: "",
  projectCode: "",
  projectName: "",
  ifscCode: "",
  bankName: "",
  bankType: "",
};

type EmployeeSearchFormData = {
  empId?: string;
  empName?: string;
  designation?: string;
  status?: string;
  phoneNumber?: string;
};

const UserManagement = () => {
  const { t } = useTranslation();
  let navigate = useNavigate();
  const [rowData, setRowData] = useState([]);
  const [modal, setModal] = useState(false);
  const [modalAction, setModalAction] = useState("");
  const [userFormData, setuserFormData] = useState(formData);
  const [modalTitle, setModalTitle] = useState(t("AddUser"));

  const {
    register,
    control,
    handleSubmit,
    watch,
    reset,
    setValue,
    formState: { errors },
  } = useForm<EmployeeSearchFormData>();

  const userBaseURL: any = process.env.REACT_APP_USER_SERVICE;
  const userServiceEndPoint: any = URLS_ENDPOINT?.USER_SERVICE;

  useEffect(() => {
    setuserFormData([]);
    getUserDetails();
  }, []);
  const columns = USER_REGIS_MASTER.USER_INFO_COLUMNS;
    const userMockData:any=USER_REGIS_MASTER.MOCK_USER_DATA;
     const [isLoading, setIsLoading] = useState(false);
 
 const getUserDetails = async () => {
  setIsLoading(true);
  try {
    // Use the mock data from USER_REGIS_MASTER
    setTimeout(() => {
      setRowData(userMockData);
      setIsLoading(false);
    }, 500);
  } catch (error) {
    console.error("Error fetching user details:", error);
    toast.error(t("Error fetching user details"));
    setIsLoading(false);
  }
};
  const handleRowClick = (e: any) => {};
  const handleBtnClick = (e: any) => {
    setModal(!modal);
  };
  const handleModalSubmit = (e: any) => {
    // setModalAction(e)
    // handleFormSubmit(userFormData)
  };
  const handleEditRow = (e: any) => {
    setModalTitle(t("EditUser"));
    setuserFormData(e);
    console.log(e);
    console.log(userFormData);
    setModal(!modal);
  };
  const Toggle = () => {
    setuserFormData(formData);
    setModal(!modal);
  };

  const onSubmitFilterForm = async (e: any) => {
    if (e && Object.keys(e).length > 0) {
    }
  };

  

  return (
    <>
      <div className="w-full">
        <Card>
          <form
            style={{ padding: "2rem", margin: 0 }}
            onSubmit={handleSubmit(onSubmitFilterForm)}
          >
            <Row>
              <Col md={2}>
                <InputText
                  type="text"
                  name="empId"
                  maxlength={10}
                  label="Employee Id"
                  placeholder="Enter Employee Id"
                  register={{
                    ...register("empId", {}),
                  }}
                  errors={errors}
                  onKeyDown={(e) => {
                    if (!/^\d$/.test(e.key)) {
                      e.preventDefault();
                    }
                  }}
                />
              </Col>

              <Col md={2}>
                <InputText
                  type="text"
                  name="empName"
                  label="Employee Name"
                  placeholder="Enter employee name"
                  register={{
                    ...register("empName", {}),
                  }}
                  errors={errors}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label="Designation"
                  name="designation"
                  options={[
                    { value: 1, label: "Senior Engg" },
                    { value: 2, label: "Junior Engg" },
                    { value: 3, label: "Vessel Owner" },
                  ]}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected Desig :", val)}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label="Status"
                  name="status"
                  options={[
                    { value: "active", label: "Active" },
                    { value: "inactive", label: "Inactive" },
                  ]}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected:", val)}
                />
              </Col>

              <Col md={2}>
                <InputText
                  type="text"
                  name="phoneNumber"
                  label="Phone Number"
                  maxlength={10}
                  placeholder="Enter Phone Number"
                  register={{
                    ...register("phoneNumber", {}),
                  }}
                  onKeyDown={(e) => {
                    if (!/^\d$/.test(e.key)) {
                      e.preventDefault();
                    }
                  }}
                  errors={errors}
                />
              </Col>

              <Col
                md={2}
                style={{ display: "flex", position: "relative", top: "2rem" }}
              >
                <Col>
                  <button className="generic-btn-submit" type="submit">
                    Filter
                  </button>
                </Col>
                &nbsp;&nbsp;
                <Col>
                  <button
                    className="generic-btn-cancel"
                    type="reset"
                    onClick={() => {
                      reset();
                    }}
                  >
                    {t("login.reset")}
                  </button>
                </Col>
              </Col>
            </Row>
            <Row className="mt-2">
              <Col md={{ span: 2, offset: 10 }} className="d-flex justify-content-end">
                <button
                  className="generic-btn-submit"
                  type="button"
                  onClick={handleBtnClick}
                >
                  <i className="fa fa-plus" aria-hidden="true"></i> {t("Add")}
                </button>
              </Col>
            </Row>
          </form>
        </Card>
        <>
          <ActionTable
            tableHeader="Employee List"
            columns={columns}
            rowData={rowData}
            additionalMethod={handleRowClick}
            showCustomBtn={true}
            btnName={t("Add")}
            handleBtnClick={handleBtnClick}
            handleEditRow={handleEditRow}
            hideExportBtn={true}
            searchBarPlaceholder={t("Table.SEARCH_BY")}
          />
        </>

        <ActionModal
          show={modal}
          close={Toggle}
          handleModalSubmit={handleModalSubmit}
          title={modalTitle}
          action={modalAction}
          isFooterHide={true}
          size={"lg"}
        >
          {/* <UserManageForm
            userFormData={userFormData}
            onFormSubmit={handleFormSubmit}
            action={modalAction}
          /> */}
        </ActionModal>
      </div>
    </>
  );
};

export default UserManagement;
//////////
import React, { useState } from "react";
import { Modal, Button, Container, Row, Col, Table } from "react-bootstrap";
import { FaDownload, FaClipboardList, FaFilePdf, FaBuilding, FaUser, FaIdCard, FaMoneyBillWave, FaUniversity, FaSignature, FaFileAlt, FaUsers } from "react-icons/fa";
import { PDFDownloadLink, Document, Page, Text, View, StyleSheet } from '@react-pdf/renderer';
import PreviewCard from "../../private/stepperForm/common-design/PreviewCard";
import Collapsible from "../../private/stepperForm/common-design/Collapsible";
import "./ApplicationDetailsView.css";

const ApplicationDetailsView = ({ show, onHide, modalData, fullModelData, handleDownload }) => {
  console.log("modalData", modalData);

  console.log(fullModelData,"fullModelData");
  const [showDocumentModal, setShowDocumentModal] = useState(false);
  
 


  // Helper function to get entity labels based on claim type
  const getEntityLabels = (claimType) => {
    switch (claimType) {
      case "PRINCIPAL_BORROWER":
        return {
          nameLabel: "Name of the guarantor",
          addressLabel: "Address of the guarantor",
          sectionTitle: "Guarantor Details"
        };
      case "GUARANTOR":
        return {
          nameLabel: "Name of the Principal Borrower",
          addressLabel: "Address of the Principal Borrower",
          sectionTitle: "Principal Borrower Details"
        };
      case "BENEFICIARY":
        return {
          nameLabel: "Name of the Beneficiary",
          addressLabel: "Address of the Beneficiary",
          sectionTitle: "Beneficiary Details"
        };
      default:
        return {
          nameLabel: "Name",
          addressLabel: "Address",
          sectionTitle: "Entity Details"
        };
    }
  };

  if (!modalData) return null;

  // Get entity labels based on claim type
  const entityLabels = getEntityLabels(fullModelData?.claimDetails?.claimType);

  // Get entity data based on claim type
  const getEntityData = () => {
    if (!fullModelData?.claimDetails) return [];
    
    switch (fullModelData.claimDetails.claimType) {
      case "PRINCIPAL_BORROWER":
        return fullModelData.claimDetails.guarantorDetails || [];
      case "GUARANTOR":
        return fullModelData.claimDetails.principalBorrowerDetails || [];
      case "BENEFICIARY":
        return fullModelData.claimDetails.beneficiaryDetails || [];
      default:
        return [];
    }
  };

  const entityData = getEntityData();
  
// Format claim type for display
  const formatClaimType = (type) => {
    switch(type) {
      case "PRINCIPAL_BORROWER":
        return "Principal Borrower";
      case "GUARANTOR":
        return "Guarantor";
      case "BENEFICIARY":
        return "Beneficiary";
      default:
        return type || "N/A";
    }
  };
  
  const displayClaimType = formatClaimType(fullModelData.claimDetails?.claimType);




  return (
    <Modal
      show={show}
      onHide={onHide}
      dialogClassName="modal-1110w application-details-modal"
      aria-labelledby="application-details-title"
      centered
    >
      <Modal.Header closeButton className="modal-header">
        <Modal.Title id="application-details-title" className="modal-title">
          <FaFileAlt className="modal-title-icon" />
          Application Details
        </Modal.Title>
      </Modal.Header>
      
      <Modal.Body className="modal-body">
        <div className="application-header-container">
          <div className="application-number-container">
            <h4 className="application-number-label">Application Number:</h4>
            <div className="application-number-value">
              {modalData.applicationNumber || "N/A"}
            </div>
          </div>
          
          <button 
            className="action-button"
            onClick={() => setShowDocumentModal(true)}
            aria-label="View Documents"
          >
            <FaClipboardList />
          </button>
        </div>

     

        {/* Creditor & Identification Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaUser className="me-2" />
              <span>Creditor & Identification Details</span>
            </div>
          } 
          defaultOpen={true}
        >
          {/* <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaUser className="details-card-title-icon" />
                Creditor Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step1?.creditorDetails && Object.entries(modalData.step1.creditorDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div> */}
         
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaUser className="details-card-title-icon" />
                Creditor Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Debtor Name" value={fullModelData.creditorBasicDetails?.financialDebtorName || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Creditor Name" value={fullModelData.creditorBasicDetails?.financialCreditorName || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Creditor Email" value={fullModelData.creditorBasicDetails?.financialCreditorEmail || "N/A"} />
                  </Col>
                </Row>
              </Container>
            </div>
          </div>
          
    {/* <div className="details-card-header">
      <h5 className="details-card-title">
        <FaUser className="details-card-title-icon" />
        Creditor Details
      </h5>
    </div> */}
   
  
  
  {/* Address Details */}
  <div className="details-card">
    <div className="details-card-header">
      <h5 className="details-card-title">
        <FaBuilding className="details-card-title-icon" />
        Address Details
      </h5>
    </div>
    <div className="details-card-body">
      <Container fluid>
        <Row className="g-3">
          <Col xs={12} sm={6} md={4} className="mb-3">
            <PreviewCard title="Address Line 1" value={fullModelData.creditorBasicDetails?.addressDetails?.addressLine1 || "N/A"} />
          </Col>
          <Col xs={12} sm={6} md={4} className="mb-3">
            <PreviewCard title="Address Line 2" value={fullModelData.creditorBasicDetails?.addressDetails?.addressLine2 || "N/A"} />
          </Col>
          <Col xs={12} sm={6} md={4} className="mb-3">
            <PreviewCard title="City" value={fullModelData.creditorBasicDetails?.addressDetails?.city || "N/A"} />
          </Col>
          <Col xs={12} sm={6} md={4} className="mb-3">
            <PreviewCard title="State" value={fullModelData.creditorBasicDetails?.addressDetails?.state || "N/A"} />
          </Col>
          <Col xs={12} sm={6} md={4} className="mb-3">
            <PreviewCard title="Pincode" value={fullModelData.creditorBasicDetails?.addressDetails?.pincode || "N/A"} />
          </Col>
        </Row>
      </Container>
    </div>
  </div>
          
          {/* Identification Details */}
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaIdCard className="details-card-title-icon" />
                Identification Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                {fullModelData?.creditorBasicDetails?.identificationTypeDetails?.identificationType && (
                  <div className="mb-3">
                    <PreviewCard 
                      title="Identification Type" 
                      value={fullModelData.creditorBasicDetails.identificationTypeDetails.identificationType === "INCORPORATED" 
                        ? "Incorporated Body" 
                        : "Partnership or Individual"} 
                    />
                  </div>
                )}
                
                {fullModelData?.creditorBasicDetails?.identificationTypeDetails?.identifications?.length > 0 && (
                  <div className="identification-records">
                    <h6 className="mb-3">Identification Records</h6>
                    {fullModelData.creditorBasicDetails.identificationTypeDetails.identifications.map((record, index) => (
                      <div key={index} className="mb-4 p-3 border rounded bg-light">
                        <h6 className="mb-3">Record {index + 1}</h6>
                        <Row className="g-3">
                          <Col xs={12} sm={6}>
                            <PreviewCard title="Identification Record" value={record.identificationRecord || "N/A"} />
                          </Col>
                          <Col xs={12} sm={6}>
                            <PreviewCard 
                              title="Proof Document" 
                              value={
                                record.proofOfIdentificationDocuments ? (
                                  <div className="d-flex align-items-center">
                                    <span className="me-2">{record.proofOfIdentificationDocuments.docName || "Document"}</span>
                                    {record.proofOfIdentificationDocuments.docId && (
                                      <Button 
                                        variant="link" 
                                        size="sm" 
                                        className="download-btn p-0"
                                        onClick={() => handleDownload(
                                          record.proofOfIdentificationDocuments.docId,
                                          record.proofOfIdentificationDocuments.docName
                                        )}
                                      >
                                        <FaDownload />
                                      </Button>
                                    )}
                                  </div>
                                ) : "N/A"
                              } 
                            />
                          </Col>
                        </Row>
                      </div>
                    ))}
                  </div>
                )}
              </Container>
            </div>
          </div>
        </Collapsible>

        {/* Claim Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaMoneyBillWave className="me-2" />
              <span>Claim Details</span>
            </div>
          }
          defaultOpen={true}
        >
          {/* <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaMoneyBillWave className="details-card-title-icon" />
                Claim Information
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.claimDetails && Object.entries(modalData.step2.claimDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div> */}
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaMoneyBillWave className="details-card-title-icon" />
                Claim Information
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Claim Type" value={displayClaimType|| "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Claim Amount" value={fullModelData.claimDetails?.claimAmount || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Security Interest" value={fullModelData.claimDetails?.isAmountOfClaimCoverdBySecurityInterest ? "Yes" : "No"} />
                  </Col>
                  {fullModelData.claimDetails?.isAmountOfClaimCoverdBySecurityInterest && (
                    <>
                      <Col xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title="Security Value" value={fullModelData.claimDetails?.securityValue || "N/A"} />
                      </Col>
                      <Col xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title="Security Date" value={fullModelData.claimDetails?.securityDate || "N/A"} />
                      </Col>
                    </>
                  )}
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Guarantee" value={fullModelData.claimDetails?.isAmountOfClaimCoverdByGuarantee ? "Yes" : "No"} />
                  </Col>
                  {fullModelData.claimDetails?.isAmountOfClaimCoverdByGuarantee && (
                    <>
                      <Col xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title="Guarantee Value" value={fullModelData.claimDetails?.guaranteeValue || "N/A"} />
                      </Col>
                      <Col xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title="Guarantee Date" value={fullModelData.claimDetails?.guaranteeDate || "N/A"} />
                      </Col>
                    </>
                  )}
                </Row>
              </Container>
            </div>
          </div>
          {/* Entity Details Section */}
          {fullModelData?.claimDetails?.claimType && (
            <div className="details-card">
              <div className="details-card-header">
                <h5 className="details-card-title">
                  <FaUsers className="details-card-title-icon" />
                  {entityLabels.sectionTitle}
                </h5>
              </div>
              <div className="details-card-body">
                <Container fluid>
                  {entityData.length > 0 ? (
                    entityData.map((entity, index) => (
                      <div key={index} className="mb-4 p-3 border rounded bg-light">
                        <h6 className="mb-3">{entityLabels.sectionTitle.replace(" Details", "")} {index + 1}</h6>
                        <Row className="g-3">
                          <Col xs={12} sm={6}>
                            <PreviewCard title={entityLabels.nameLabel} value={entity.name || "N/A"} />
                          </Col>
                          <Col xs={12} sm={6}>
                            <PreviewCard title={entityLabels.addressLabel} value={entity.address || "N/A"} />
                          </Col>
                        </Row>
                      </div>
                    ))
                  ) : (
                    <div className="alert alert-info">
                      No {entityLabels.sectionTitle.toLowerCase()} found
                    </div>
                  )}
                </Container>
              </div>
            </div>
          )}
          
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaUniversity className="details-card-title-icon" />
                Bank Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.bankDetails && Object.entries(modalData.step2.bankDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
        </Collapsible>

      

        {/* Signatory Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaSignature className="me-2" />
              <span>Signatory Details</span>
            </div>
          }
          defaultOpen={true}
        >
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaSignature className="details-card-title-icon" />
                Signatory Information
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step3?.signatoryDetails && Object.entries(modalData.step3.signatoryDetails)
                    .filter(([key]) => key !== "Signature Document") // Filter out signature document to display separately
                    .map(([key, value]) => (
                      <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                        <PreviewCard title={key} value={value || "N/A"} />
                      </Col>
                    ))
                  }
                </Row>
                
                {/* Display signature document separately */}
                {fullModelData?.signatoryDetails?.document?.docId && (
                  <div className="mt-4 p-3 border rounded bg-light">
                    <h6 className="mb-3">Signature Document</h6>
                    <div className="d-flex align-items-center">
                      <span className="me-2">{fullModelData.signatoryDetails.document.docName || "Signature"}</span>
                      <Button 
                        variant="link" 
                        size="sm" 
                        className="download-btn p-0"
                        onClick={() => handleDownload(
                          fullModelData.signatoryDetails.document.docId,
                          fullModelData.signatoryDetails.document.docName
                        )}
                      >
                        <FaDownload />
                      </Button>
                    </div>
                  </div>
                )}
              </Container>
            </div>
          </div>
        </Collapsible>

          {/* Supporting Documents */}
          <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaFileAlt className="me-2" />
              <span>Supporting Documents</span>
            </div>
          }
          defaultOpen={true}
        >
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaFileAlt className="details-card-title-icon" />
                Documents
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                {fullModelData?.supportingDocument?.documents?.length > 0 ? (
                  fullModelData.supportingDocument.documents.map((doc, index) => (
                    <div key={index} className="mb-4 p-3 border rounded bg-light">
                      <Row className="g-3">
                        <Col xs={12} sm={6}>
                          <PreviewCard 
                            title="Document Type" 
                            value={doc.docSource === "identity_proof" ? "Identity Proof" : 
                                  doc.docSource === "address_proof" ? "Address Proof" : 
                                  doc.docSource} 
                          />
                        </Col>
                        <Col xs={12} sm={6}>
                          <PreviewCard 
                            title="Document" 
                            value={
                              <div className="d-flex align-items-center">
                                <span className="me-2">{doc.docName || "Document"}</span>
                                {doc.docId && (
                                  <Button 
                                    variant="link" 
                                    size="sm" 
                                    className="download-btn p-0"
                                    onClick={() => handleDownload(doc.docId, doc.docName)}
                                  >
                                    <FaDownload />
                                  </Button>
                                )}
                              </div>
                            } 
                          />
                        </Col>
                      </Row>
                    </div>
                  ))
                ) : (
                  <div className="alert alert-info">
                    No supporting documents found
                  </div>
                )}
              </Container>
            </div>
          </div>
        </Collapsible>
      </Modal.Body>
      
      <Modal.Footer className="modal-footer">
        <Button variant="secondary" onClick={onHide}>
          Close
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default ApplicationDetailsView;
