{col.actions?.includes("track") && (
  <OverlayTrigger overlay={<Tooltip>Track</Tooltip>}>
    <Button 
      variant="outline-primary" 
      size="sm" 
      onClick={() => handleTrack(row)}
      style={{ 
        transition: 'all 0.3s',
        padding: '0.25rem',
        '--icon-filter': 'brightness(0) saturate(100%) invert(35%) sepia(98%) saturate(1248%) hue-rotate(183deg) brightness(93%) contrast(96%)',
        '--icon-filter-hover': 'brightness(0) invert(1)'
      }}
    >
      <img 
        src={trackIcon} 
        alt="track" 
        style={{ 
          width: "16px", 
          height: "16px",
          filter: 'var(--icon-filter)'
        }} 
        onMouseEnter={(e) => e.currentTarget.style.filter = 'var(--icon-filter-hover)'}
        onMouseLeave={(e) => e.currentTarget.style.filter = 'var(--icon-filter)'}
      />
    </Button>
  </OverlayTrigger>
)}
