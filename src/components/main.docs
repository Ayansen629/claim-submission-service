{/* Hero Section */}
<div className={styles.heroSection}>
  <div className={styles.overlay}></div>
  
  <div className="container-fluid position-relative z-2">
    <div className={`row g-0 pt-4 px-4 ${styles.headerRow}`}>
      
      {/* Nav Links Section */}
      <div className={`${styles.topNavCol} mb-0 col-12 position-relative`}>
        <div className="d-flex flex-column align-items-center w-100">
          {/* Wrapper around Nav + underline */}
          <div className="d-flex flex-column align-items-center">
            <Nav className="d-flex flex-wrap justify-content-center">
              <Nav.Link className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                {t("home2.home")}
              </Nav.Link>
              <Nav.Link onClick={() => navigate("/about-us")} className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                {t("home2.aboutUs")}
              </Nav.Link>
              <Nav.Link onClick={() => navigate("/our-services")} className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                {t("home2.services")}
              </Nav.Link>
              <Nav.Link onClick={() => navigate("/rules-and-act")} className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                {t("home2.RulesAndAct")}
              </Nav.Link>
              <Nav.Link onClick={() => navigate("/gallery")} className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                {t("home2.Gallery")}
              </Nav.Link>
              <Nav.Link onClick={() => navigate("/important-link")} className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                {t("home2.ImportantLink")}
              </Nav.Link>
              <Nav.Link onClick={() => navigate("/contact-us")} className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                {t("home2.contactUs")}
              </Nav.Link>
            </Nav>

            {/* underline directly under Nav */}
            <div className="border-top border-white mt-1 w-100"></div>
          </div>
        </div>

        {/* Desktop Logo and Login */}
        <div className="d-none d-lg-block">
          <img
            src={BengalLogo}
            alt="Logo"
            style={{ width: "4.25rem", height: "5rem", position: "absolute", top: "-17px", right: "0" }}
          />
          <Button
            variant="light"
            className={`${styles.homeLoginBtn}`}
            onClick={() => navigate("/login")}
          >
            {t("home2.Login")}
          </Button>
        </div>

        {/* Mobile/Tablet Logo */}
        <div className="d-block d-lg-none text-center mt-2">
          <img
            src={BengalLogo}
            alt="Logo"
            style={{ width: "3rem", height: "3.5rem" }}
          />
        </div>
      </div>

      {/* Left Side: Logo + Brand Name */}
      <div className="mt-0 col-12 d-flex flex-column align-items-center align-items-lg-start">
        <div className="d-flex align-items-center justify-content-center" style={{ marginTop: "-2rem" }}>
          <img className="me-2" src={IWTIcon} alt="Logo" style={{ width: "5.5rem", borderRadius: "0px" }} />
        </div>
        <div className="text-center text-lg-start">
          <p className={`${styles.brandName} mt-1`}>{t("home2.InlandWaterTransportServices")}</p>
          <p className={`${styles.brandName} mt-1`}>{t("home2.departmentOfWB")}</p>
        </div>

        {/* Mobile/Tablet Login Button */}
        <Button variant="light" className={`${styles.homeLoginBtn} d-block d-lg-none`} onClick={() => navigate("/login")}>
          {t("home2.Login")}
        </Button>
      </div>
    </div>
  </div>
</div>
