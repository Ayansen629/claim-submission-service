import React, { useState, useEffect } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Form, Button, Card, Image, Alert } from 'react-bootstrap';
import { 
  FaUser, FaBuilding, FaFileUpload, FaCheck, FaArrowRight, 
  FaArrowLeft, FaIdCard, FaEnvelope, FaPhone, FaMapMarkerAlt, FaUpload, FaShip 
} from 'react-icons/fa';
import './UserRegistration.css';
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";


import InputText from '../../common/InputText.tsx';
import InputFile from '../../common/InputFile.tsx';
import InputSelect from '../../common/InputSelect.tsx';

const VesselOwnerRegistrationPage = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [validationMessage, setValidationMessage] = useState("");
  
  const methods = useForm({
    mode: 'onBlur',
    defaultValues: { ownerCategory: 'company', country: 'India' }
  });
  
  const { register, handleSubmit, formState: { errors }, trigger, setValue, getValues, watch, clearErrors, setError } = methods;
  const totalSteps = 3;
  const ownerCategory = watch('ownerCategory');

  
  useEffect(() => {
   
    setTimeout(() => {
     
      Object.keys(formData).forEach(key => {
        if (formData[key]) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [currentStep]);

  const formFields = {
    step1: [
      {
        name: 'ownerCategory',
        label: 'Category of Owner',
        type: 'select',
        options: [
          { value: '', label: 'Select Category' },
          { value: 'individual', label: 'Individual' },
          { value: 'company', label: 'Company' },
          { value: 'organization', label: 'Organization' }
        ],
        required: true,
        icon: FaBuilding,
        colSize: 6,
        validation: { required: 'Owner category is required' }
      },
      {
        name: 'ownerName',
        label: 'Owner/Company Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter owner or company name',
        validation: { required: 'Owner name is required' }
      },
      {
        name: 'email',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: { 
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      {
        name: 'phoneNumber',
        label: 'Phone Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        placeholder: 'Enter 10-digit phone number',
        validation: { 
          required: 'Phone number is required',
          pattern: {
            value: /^[0-9]{10}$/,
            message: 'Phone number must be 10 digits'
          }
        }
      },
      {
        name: 'panNumber',
        label: 'PAN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter PAN number (e.g., ABCDE1234F)',
        validation: { 
          required: 'PAN number is required',
          pattern: {
            value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
            message: 'Invalid PAN format'
          }
        }
      },
      {
        name: 'gstNumber',
        label: 'GST Number',
        type: 'text',
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter GST number (if applicable)',
        validation: { 
          pattern: {
            value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
            message: 'Invalid GST format'
          }
        }
      },
      {
        name: 'addressLine1',
        label: 'Address Line-1',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 1',
        validation: { required: 'Address is required' }
      },
      {
        name: 'addressLine2',
        label: 'Address Line-2',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 2 (optional)'
      },
      {
        name: 'pincode',
        label: 'PIN',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter 6-digit PIN code',
        validation: { 
          required: 'PIN code is required',
          pattern: {
            value: /^[0-9]{6}$/,
            message: 'PIN must be 6 digits'
          }
        },
        onChange: (e) => {
          if (e.target.value.length === 6) {
            setValue('district', 'Sample District');
            setValue('state', 'Sample State');
            setValue('country', 'India');
          }
        }
      },
      {
        name: 'district',
        label: 'District',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter district',
      },
      {
        name: 'state',
        label: 'State/UT',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter state',
      },
      {
        name: 'country',
        label: 'Country',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter country',
      }
    ],
    step2: [
      {
        name: 'firstName',
        label: 'First Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter first name',
        validation: { required: 'First name is required' }
      },
      {
        name: 'lastName',
        label: 'Last Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter last name',
        validation: { required: 'Last name is required' }
      },
      {
        name: 'mobileNumber',
        label: 'Primary Mobile Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        placeholder: 'Enter 10-digit mobile number',
        validation: { 
          required: 'Mobile number is required',
          pattern: {
            value: /^[0-9]{10}$/,
            message: 'Mobile number must be 10 digits'
          }
        }
      },
      {
        name: 'authorizedEmail',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: { 
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      {
        name: 'authorizationLetter',
        label: 'Upload Letter of Authorization',
        type: 'file',
        required: false,
        colSize: 12,
      }
    ],
    step3: [
      {
        name: 'panCardUpload',
        label: 'PAN Card',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'gstCertificate',
        label: 'GST Certificate',
        type: 'file',
        required: false,
        colSize: 6
      },
      {
        name: 'addressProof',
        label: 'Address Proof',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'companyRegistrationCertificate',
        label: 'Company Registration Certificate',
        type: 'file',
        required: false,
        colSize: 6,
        showIf: () => ownerCategory !== 'organization'
      },
      {
        name: 'cinNumber',
        label: 'CIN Number',
        type: 'text',
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter CIN number',
        validation: { 
          pattern: {
            value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
            message: 'Invalid CIN format'
          }
        },
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'dinNumber',
        label: 'DIN Number',
        type: 'text',
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter DIN number',
        validation: { 
          pattern: {
            value: /^[0-9]{8}$/,
            message: 'DIN must be 8 digits'
          }
        },
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'moaCertificate',
        label: 'MOA Certificate',
        type: 'file',
        required: false,
        colSize: 6,
        validation: {},
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'aoaCertificate',
        label: 'AOA Certificate',
        type: 'file',
        required: false,
        colSize: 6,
        validation: {},
        showIf: () => ownerCategory === 'company'
      }
    ]
  };

  // Get fields for current step
  const getCurrentStepFields = () => {
    switch(currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      case 3: return formFields.step3;
      default: return [];
    }
  };

  // Validate current step
  const validateStep = async () => {
    // Get all required fields for current step
    const requiredFields = getCurrentStepFields()
      .filter(field => field.required && (!field.showIf || field.showIf()));
    
    // Check for empty required fields
    let missingFields = [];
    requiredFields.forEach(field => {
      const value = getValues(field.name);
      if (!value || value === '') {
        missingFields.push(field.label);
        setError(field.name, { 
          type: 'required', 
          message: `${field.label} is required` 
        });
      }
    });
    
    // if (missingFields.length > 0) {
    //   setValidationMessage(`Please fill all mandatory fields: Category of Owner, Owner/Company Name, Email ID, Phone Number, PAN Number, Address Line-1, PIN`);
    // } else {
    //   // Clear validation message if all required fields are filled
    //   setValidationMessage("");
    // }
    
    // Validate all fields in current step
    const fieldsToValidate = requiredFields.map(field => field.name);
    return await trigger(fieldsToValidate);
  };

  // Handle next button click
  const handleNext = async () => {
    const isStepValid = await validateStep();
    
    if (isStepValid) {
      // Clear validation message when all fields are valid
      setValidationMessage("");
      
      // Save all form values including file selections
      const currentValues = getValues();
      
      
      const fileFields = getCurrentStepFields().filter(field => field.type === 'file');
      fileFields.forEach(field => {
        if (currentValues[field.name]) {
         
          setFormData(prev => ({ 
            ...prev, 
            [field.name]: currentValues[field.name]
          }));
        }
      });
      
      // Save all other form values
      setFormData(prev => ({ ...prev, ...currentValues }));
      
      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    }
  };

  // Handle previous button click
  const handlePrevious = () => {
    // Save current values before navigating
    const currentValues = getValues();
    

    const fileFields = getCurrentStepFields().filter(field => field.type === 'file');
    fileFields.forEach(field => {
      if (currentValues[field.name]) {
  
        setFormData(prev => ({ 
          ...prev, 
          [field.name]: currentValues[field.name]
        }));
      }
    });
    
    // Save all other form values
    setFormData(prev => ({ ...prev, ...currentValues }));
    
    // Navigate to previous step
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
    setValidationMessage("");
  };

  // Handle form submission
  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };
    console.log('Form submitted with data:', JSON.stringify(finalData, null, 2));
    setIsSubmitted(true);
    window.scrollTo(0, 0);
  };

  // Dynamic Field Component
  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field.onChange) field.onChange(e);
      
      // Clear error when user starts typing
      if (e.target.value && errors[field.name]) {
        clearErrors(field.name);
        setValidationMessage("");
      }
    };

    switch(field.type) {
      case 'select':
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register(field.name, {
              ...field.validation,
              onChange: handleChange
            })}
            errors={errors}
            icon={field.icon}
            className="mb-4"
          />
        );
        
      case 'file':
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            register={register(field.name, {
              ...field.validation,
              onChange: (e) => {
                if (e.target.files && e.target.files[0]) {
                  const file = e.target.files[0];
                  
                 
                  setValue(field.name, file.name, { shouldValidate: true });
                  setFormData(prev => ({ ...prev, [field.name]: file.name }));
                  clearErrors(field.name);
                  
                  // File type validation
                  const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                  if (!validTypes.includes(file.type)) {
                    setError(field.name, {
                      type: 'manual',
                      message: 'Only PDF, JPG or PNG files are allowed'
                    });
                  }
                  
                  // File size validation (max 2MB)
                  if (file.size > 2 * 1024 * 1024) {
                    setError(field.name, {
                      type: 'manual',
                      message: 'File size should not exceed 2MB'
                    });
                  }
                }
              }
            })}
            errors={errors}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
          />
        );
        
      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field.name, {
              ...field.validation,
              onChange: handleChange
            })}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            className="mb-4"
            style={{
              borderColor: errors[field.name] ? '#dc3545' : '#ced4da',
              backgroundColor: errors[field.name] ? '#fff8f8' : 'white'
            }}
          />
        );
    }
  };

  // Step titles
  const stepTitles = [
    { title: "Vessel Owner Details", icon: FaBuilding },
    { title: "Authorized Person's Details", icon: FaUser },
    { title: "Documents Upload", icon: FaFileUpload }
  ];

  return (
    <Container fluid className="registration-container py-5">
      <Row className="justify-content-center">
        <Col lg={10} xl={9}>
          <Card className="registration-card">
            <Card.Header className="registration-header p-0">
              <div className="registration-header-content">
                <div className="header-logo-container">
                  <Image 
                    src={IWT_FULL_IMG} 
                    alt="IWT Logo" 
                    className="header-logo"
                  />
                </div>
                <h3 className="header-title">
                  Vessel Owner Registration
                </h3>
              </div>
            </Card.Header>
            
            <Card.Body className="registration-body p-4 p-md-5">
              {isSubmitted ? (
                <div className="success-container text-center py-5">
                  <div className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style={{ width: '90px', height: '90px', boxShadow: '0 10px 20px rgba(40, 167, 69, 0.3)' }}>
                    <FaCheck className="success-icon text-white fs-1" />
                  </div>
                  <h4 className="success-title text-success mb-3 fw-bold">Registration Successful!</h4>
                  <p className="success-message mb-4 text-muted fs-5">
                    Your vessel owner registration has been submitted successfully. 
                    You will receive a confirmation email shortly.
                  </p>
                  <div className="registration-id p-4 bg-light rounded mb-4" style={{ borderLeft: '4px solid #0077b6' }}>
                    <strong>Registration ID:</strong> {Math.random().toString(36).substring(2, 10).toUpperCase()}
                  </div>
                  <Button 
                    variant="primary" 
                    size="lg"
                    className="mt-2 d-flex align-items-center justify-content-center mx-auto"
                    style={{
                      background: 'linear-gradient(135deg, #0077b6, #023e8a)',
                      border: 'none',
                      boxShadow: '0 4px 15px rgba(0, 119, 182, 0.3)',
                      borderRadius: '8px',
                      padding: '12px 30px',
                      fontWeight: '600',
                      transition: 'all 0.3s ease',
                      minWidth: '150px',
                      height: '50px'
                    }}
                    onClick={() => window.location.href = '/dashboard'}
                  >
                    Go to Dashboard
                  </Button>
                </div>
              ) : (
                <FormProvider {...methods}>
                  <form>
                    <div className="text-center mb-4">
                      <p className="text-muted">Please complete all required information to register your vessel</p>
                    </div>
                    
                    {/* {validationMessage && (
                      <Alert variant="danger" className="mb-4 d-flex align-items-center">
                        <div className="me-3">
                          <FaIdCard size={24} />
                        </div>
                        <div>
                          <h5 className="mb-1">Please fill all mandatory fields:</h5>
                          <p className="mb-0">Category of Owner, Owner/Company Name, Email ID, Phone Number, PAN Number, Address Line-1, PIN</p>
                        </div>
                      </Alert>
                    )} */}
                    
                    <div className="stepper-container mb-5">
                      <div className="stepper d-flex justify-content-between">
                        {[1, 2, 3].map((step) => (
                          <React.Fragment key={step}>
                            <div className={`step ${currentStep >= step ? 'active' : ''} ${currentStep > step ? 'completed' : ''} flex-grow-1 text-center`}>
                              <div 
                                className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2" 
                                style={{
                                  width: '60px',
                                  height: '60px',
                                  borderRadius: '50%',
                                  fontSize: '20px',
                                  fontWeight: 'bold',
                                  boxShadow: currentStep >= step ? '0 5px 15px rgba(0, 119, 182, 0.3)' : '0 4px 10px rgba(0, 0, 0, 0.1)',
                                  background: currentStep >= step ? 
                                    (currentStep > step ? 'linear-gradient(135deg, #28a745, #20c997)' : 'linear-gradient(135deg, #0077b6, #023e8a)') : 
                                    '#ffffff',
                                  border: currentStep >= step ? 'none' : '2px solid #e9ecef',
                                  color: currentStep >= step ? '#fff' : '#6c757d',
                                  transition: 'all 0.4s ease'
                                }}>
                                {currentStep > step ? <FaCheck size={22} /> : React.createElement(stepTitles[step-1].icon, { size: 22 })}
                              </div>
                              <div className="step-label fw-bold" 
                                style={{ 
                                  color: currentStep >= step ? (currentStep > step ? '#28a745' : '#0077b6') : '#6c757d',
                                  fontSize: '0.9rem',
                                  transition: 'all 0.3s ease'
                                }}>
                                {stepTitles[step-1].title}
                              </div>
                            </div>
                            {step < 3 && (
                              <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                                <div className={`connector-line w-100 ${currentStep > step ? 'active' : ''}`} 
                                  style={{ 
                                    height: '4px', 
                                    background: currentStep > step ? 'linear-gradient(to right, #28a745, #20c997)' : '#e9ecef',
                                    borderRadius: '2px',
                                    transition: 'all 0.5s ease'
                                  }}></div>
                              </div>
                            )}
                          </React.Fragment>
                        ))}
                      </div>
                    </div>
                    
                    <div className="step-content">
                      <div className="form-section p-4 rounded mb-4">
                        <div className="section-title">
                          {React.createElement(stepTitles[currentStep-1].icon, { className: "section-icon" })}
                          <h4 className="mb-0 fw-bold">{stepTitles[currentStep-1].title}</h4>
                        </div>
                        
                        <div className="form-content">
                          <Row className="g-3">
                            {getCurrentStepFields().map((field, index) => (
                              <Col key={index} md={field.colSize || 12}>
                                <DynamicField field={field} />
                              </Col>
                            ))}
                          </Row>
                        </div>
                      </div>
                    </div>
                    
                    <div className="form-navigation d-flex justify-content-between mt-4">
                      <Button 
                        variant="outline-secondary" 
                        onClick={handlePrevious}
                        disabled={currentStep === 1}
                        className="prev-btn"
                      >
                        <FaArrowLeft className="btn-icon me-2" /> Previous
                      </Button>
                      
                      <Button 
                        variant="primary" 
                        onClick={handleNext}
                        className="next-btn"
                      >
                        {currentStep === totalSteps ? 'Submit Registration' : 'Next'} 
                        {currentStep !== totalSteps && <FaArrowRight className="btn-icon ms-2" />}
                      </Button>
                    </div>
                  </form>
                </FormProvider>
              )}
            </Card.Body>
          </Card>
        </Col>
      </Row>
    </Container>
  );
};

export default VesselOwnerRegistrationPage;
/////////////////////
import React, { useState, useEffect } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaCheckCircle } from "react-icons/fa";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  register?: any;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  register,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  style = {},
  watch
}) => {
  const hasError = errors && errors[name];
  const [fileName, setFileName] = useState<string>("");
  const watchedValue = watch ? watch(name) : null;
  
  // Update fileName when watchedValue changes or component mounts
  useEffect(() => {
    if (typeof watchedValue === 'string' && watchedValue) {
      setFileName(watchedValue);
    }
  }, [watchedValue, name]);
  
  // Handle file change internally
  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files[0]) {
      const file = e.target.files[0];
      setFileName(file.name);
    }
    
    // Call the parent onChange handler if provided
    if (onChange) {
      onChange(e);
    }
  };
  
  // Get file icon based on extension
  const getFileIcon = () => {
    if (!fileName) return <FaFile color="#0d6efd" />;
    
    const extension = fileName.split('.').pop()?.toLowerCase();
    
    if (extension === 'pdf') return <FaFilePdf color="#dc3545" />;
    if (['jpg', 'jpeg', 'png', 'gif'].includes(extension || '')) return <FaFileImage color="#28a745" />;
    return <FaFile color="#0d6efd" />;
  };
  
  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      <div 
        className={`file-upload border rounded p-3 ${hasError ? 'border-danger' : ''}`} 
        style={{
          ...style,
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderColor: hasError ? '#dc3545' : '#ced4da',
          borderRadius: '8px',
          transition: 'all 0.3s ease'
        }}
      >
        <div className="d-flex align-items-center justify-content-between">
          <label 
            htmlFor={name} 
            className={`file-label btn ${hasError ? 'btn-outline-danger' : 'btn-primary'} mb-0 d-inline-flex align-items-center`}
            style={{ 
              borderRadius: '6px',
              padding: '8px 16px',
              cursor: 'pointer',
              boxShadow: '0 2px 5px rgba(0,0,0,0.1)',
              transition: 'all 0.3s ease',
              minWidth: '120px'
            }}
          >
            <FaUpload className="file-icon me-2" />
            <span className="file-text">Choose File</span>
          </label>
          
          <div 
            className={`file-name-container ms-3 flex-grow-1 border rounded px-3 py-2 ${fileName ? 'bg-light-success' : 'bg-light'} d-flex align-items-center ${hasError ? 'border-danger' : fileName ? 'border-success' : ''}`}
            style={{
              backgroundColor: fileName ? '#f0f9f0' : '#f8f9fa'
            }}
          >
            {fileName ? (
              <>
                <FaCheckCircle className="text-success me-2" />
                <div>
                  <span className="text-success fw-bold" style={{ fontSize: '0.8rem' }}>Selected File:</span>
                  <div className="d-flex align-items-center">
                    <span className="file-icon-preview me-2">{getFileIcon()}</span>
                    <span className="text-dark fw-semibold" style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                      {fileName}
                    </span>
                  </div>
                </div>
              </>
            ) : (
              <span className="text-muted">No file chosen</span>
            )}
          </div>
        </div>
        
        <input 
          type="file" 
          id={name}
          {...register}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="file-input d-none"
        />
      </div>
      
      <Form.Text className="text-muted small mt-1">
        Upload PDF, JPG or PNG file (Max size: 2MB)
      </Form.Text>
      
      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
