        userInfo: userFormData?.fullloginDetails || {}, 
        applicationDetails:createFormPayload(draftData, false, userFormData, draftId,false),
      }
  
      // const existingDraft = JSON.parse(localStorage.getItem("formDrafts") || "[]");
      // const updatedDrafts = [
      //   ...existingDraft.filter((draft) => draft.id !== draftId),
      //   draftData,
      // ];
      // localStorage.setItem("formDrafts", JSON.stringify(updatedDrafts));
      console.log(" Drafts payload:", draftPayload);
  
      // Save the draft data to local storage
      localStorage.setItem(draftId, JSON.stringify(draftPayload));

      // api call to save draft

      const REQUEST = `${process.env.REACT_APP_APPLICATION_SERVICE}${URLS_ENDPOINT.APP_SERVICES.APPLICATION_FORMSUBMIT}`;
     const response = await postData(REQUEST, draftPayload);
     console.log("response", response);


  ;
     if(response.data.status.code === "200") {

      localStorage.setItem("draftResponse", JSON.stringify(response));
       setHasPreviewed(true); // Enable preview after saving draft

      
      // //update form data with the response data if needed
      const updatedFormData = { ...formData, 
        creditorBasicDetailsUuid: response.data.applicationDetails.creditorBasicDetails.uuid,
        claimDetailsUuid: response.data.applicationDetails.claimDetails.uuid,
        signatoryDetailsUuid: response.data.applicationDetails.signatoryDetails.uuid,
        applicationNumber: response.data.applicationDetails.applicationNumber,
         };
      setFormData(updatedFormData);

    toast.success("Draft saved successfully");
      } else {
        toast.error(`Failed to save draft: ${response.status.message}`);
      }
    } catch (error) {
      console.error("Error saving draft:", error);
      toast.error("Failed to save draft");
    } finally {
      setIsSavingDraft(false);
    }
  };
  

  // const handleSaveDraft = async () => {
  //   setIsSavingDraft(true);
  //   try {
  //     const currentStepData = currentSubmitHandler ? await currentSubmitHandler() : {};
  //     const processedStepData = await processFileUploads(currentStepData, currentStep);

  //     const draftId = id || `draft-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`;

  //     // Generate uuids if they don't exist
  //     const creditorBasicDetailsUuid = formData.creditorBasicDetailsUuid || uuidv4();
  //     const claimDetailsUuid = formData.claimDetailsUuid || uuidv4();
  //     const signatoryDetailsUuid = formData.signatoryDetailsUuid || uuidv4();

  //     const draftData = {
  //       ...formData,
  //       creditorBasicDetailsUuid: creditorBasicDetailsUuid,
  //       claimDetailsUuid: claimDetailsUuid,
  //       signatoryDetailsUuid: signatoryDetailsUuid,
  //       [`step${currentStep}`]: {
  //         ...formData[`step${currentStep}`],
  //         ...processedStepData,
  //       },
  //       id: draftId,
  //       status: "draft",
  //       lastSaved: new Date().toISOString(),
  //       currentStep,
  //       formType: userFormData?.formType,
  //       userType: userFormData?.userType,
  //     };

  //     const draftPayload = createFormPayload(draftData, false, userFormData, draftId);

  //     const existingDraft = JSON.parse(localStorage.getItem("formDrafts") || "[]");
  //     const updatedDrafts = [
  //       ...existingDraft.filter((draft) => draft.id !== draftId),
  //       draftData,
  //     ];
  //     localStorage.setItem("formDrafts", JSON.stringify(updatedDrafts));
  //     console.log(" Drafts payload:", draftPayload);

  //     // Save the draft data to local storage
  //     localStorage.setItem(draftId, JSON.stringify(draftPayload)); // Save with isFinalSubmit: false

  //     toast.success("Draft saved successfully");
  //     setFormData(draftData); // Update form data.
  //     setHasPreviewed(true); // Enable preview after saving draft
  //   } catch (error) {
  //     console.error("Error saving draft:", error);
