const generateVesselData = (count = 20) => {
  const vesselNames = [
    "MA  Durga",
    "MA  Annapurna",
    "MA  Saraswati",
    "MA  Jagadhatri",
    "MV  Rocket",
    "MV  Kanchan",
    "MV  Rabindra Nath Tagore",
    "MV  ICHASAKTI",
    "MV  ALOR RANI",
    "MV  MAHESHKANYA",
  ];

  const vesselTypes = ["Passenger", "Non-Passenger", "Cargo", "RO-RO"];

  return Array.from({ length: count }, (_, i) => {
    const yearIN = 2015 + Math.floor(Math.random() * 11); // 2015 - 2025

    const registeredYear = new Date(
      yearIN + Math.floor(Math.random() * 10), // survey after registration
      Math.floor(Math.random() * 12),
      Math.floor(Math.random() * 28) + 1
    )
      .toISOString()
      .split("T")[0];

    const lastSurveyDate = new Date(
      new Date(registeredYear).getFullYear() + Math.floor(Math.random() * 10), // survey after registration
      Math.floor(Math.random() * 12),
      Math.floor(Math.random() * 28) + 1
    )
      .toISOString()
      .split("T")[0];

    return {
      id: i + 1,
      registrationNo: `WB${String(1000 + i).padStart(4, "0")}`,
      vesselName: vesselNames[Math.floor(Math.random() * vesselNames.length)],
      registeredYear,
      lastSurveyDate,
      vesselType: vesselTypes[Math.floor(Math.random() * vesselTypes.length)],
    };
  });
};

const VesselOwner = ({ userDetails, userRole }) => {
  //   const tabs = Array.from({ length: 8 }, (_, i) => ({
  //     title: `Vessel ${i + 1}`,
  //     content: <VesselContent />,
  //     onLoad: () => console.log(`Loading Vessel ${i + 1}...`),
  //   }));
  const { t } = useTranslation();
  const navigate = useNavigate();

  return (
    <>
      <WelcomeBox
        userName={
          userDetails
            ? // ? userDetails?.firstName + " " + userDetails?.lastName + " User"
              userDetails?.ownerCompanyName
            : ""
        }
        title={getUserRoleName(userRole)}
        desc={t("dashboard.Here’s your vessel performance overview.")}
      />

      {/* <DynamicTabs
        tabs={tabs}
        onTabChange={(i) => console.log(`Switched to tab ${i}`)}
      /> */}

      <VesselContent navigate={navigate} />
    </>
  );
};

const VesselContent = ({ vesselNumber }) => {
  const loaderRef = useRef();
  const { t } = useTranslation();

  const [showSupervisionInvoiceModal, setShowSupervisionInvoiceModal] =
    useState(false);
  const [supervisionPaymentData, setSupervisionPaymentData] = useState(null);
  const [supervisionFullPaymentData, setSupervisionFullPaymentData] = useState(
    {}
  );
  const [currentApplicationNumber, setCurrentApplicationNumber] = useState("");
  const [filterParams, setFilterParams] = useState({
    applicationNumbers: [""],
    vesselName: "",
    toDate: "",
    fromDate: "",
  });
  const [dateRange, setDateRange] = useState({
    startDate: null,
    endDate: null,
    key: "selection",
  });

  // For Vessel Table
  const vesselColumns = VESSEL_COLUMNS.map((col) => ({
    ...col,
    colName: t(`dashboard.${col.colName}`),
  }));

  // For Inbox Table
  const inboxColumns = INBOX_COLUMNS.map((col) => ({
    ...col,
    colName: t(`dashboard.${col.colName}`),
  }));

  const [inboxData, setInboxData] = useState([]);
  const [filteredInboxData, setFilteredInboxData] = useState([]);
  const [inboxCurrentPage, setInboxCurrentPage] = useState(1);
  const [inboxSearchTerm, setInboxSearchTerm] = useState("");
  const itemsInboxPerPage = 5;

  const [vesselData, setVesselData] = useState([]);
  const [filteredVesselData, setFilteredVesselData] = useState([]);
  const [vesselCurrentPage, setVesselCurrentPage] = useState(1);
  const [vesselSearchTerm, setVesselSearchTerm] = useState("");
  const itemsVesselPerPage = 5;
  const [isModalOpen, setIsModalOpen] = useState(false);
  const navigate = useNavigate();

  //  supervision fee payment API function
  const fetchSupervisionPaymentDetails = async (applicationNumber) => {
    try {
      const payload = {
        category: "SUPERVISION",
        paymentProcess: "SUPERVISIONCHARGE",
        application_no: applicationNumber || "",
      };

      const apiUrl =
        SERVICE_BASE.IWT_REGISTRATION +
        URLS_ENDPOINT.VESSEL_SERVICE.PAYMENT_GENERATE;
      const response = await postData(apiUrl, payload);

      if (
        response?.status === 200 &&
        response?.data?.responseStatus?.status === "FeeSlab found successfully"
      ) {
        const apiData = response.data.data;

        const formattedData = {
          invoiceBreakupInfo:
            apiData.feesDetailsl?.map((fee, index) => ({
              id: fee.id || index.toString(),
              label: fee.category_description || fee.category_name,
              amount: fee.totalCalucation || fee.old_data,
              categoryHeader: fee.catHeaderName,
            })) || [],
          summary: {
            subTotal: apiData.totalAmount || 0,
            cgst: apiData.cgst || 0,
            sgst: apiData.sgst || 0,
            igst: apiData.igst || 0,
            totalPayable: apiData.totalAmountAtergst || 0,
          },
        };

        setSupervisionPaymentData(formattedData);
        setSupervisionFullPaymentData(response.data);
      }
    } catch (error) {
      console.error("Error fetching supervision payment details:", error);
      toast.error("Failed to fetch payment details");
    }
  };

  const handleViewAction = (rowData) => {
    const regNo = rowData?.applicationNumber || "";
    if (!regNo) {
      toast.warning("Application Number missing...", {
        position: "top-right",
      });
      return;
    }
    navigate(`/vessel-info/vessel-registration/view?applicationNo=${regNo}`, {
      state: {
        rowData: { ...rowData },
      },
    });
  };

  const handleEditAction = (rowData) => {
    const regNo = rowData?.applicationNumber || "";
    if (!regNo) {
      toast.warning("Application Number missing...", {
        position: "top-right",
      });
      return;
    }

    navigate(`/vessel-registration/new-vessel/edit?applicationNo=${regNo}`);
  };

  const handleApplySurvey = (rowData) => {
    const regNo = rowData?.applicationNumber || "";
    if (!regNo) {
      toast.warning("Application Number missing...", {
        position: "top-right",
      });
      return;
    }
    navigate(
      `/vessel-registration/apply-intital-vessel-survey?applicationNo=${regNo}`
    );
  };

  const handleButtonBasedEvents = (rowData, pageName) => {
    const regNo = rowData?.applicationNumber || "";
    if (!regNo) {
      toast.warning("Application Number missing...", {
        position: "top-right",
      });
      return;
    }
    navigate(
      `/vessel-registration/new-vessel/reports-and-forms?applicationNo=${regNo}`,
      {
        state: {
          rowData: { ...rowData },
          pageName: pageName,
        },
      }
    );
  };

  const handlePaySupervisionFeePayment = async (row) => {
    console.log("Pay Supervision Fee Payment", row);
    const applicationNumber = row?.applicationNumber || "";
    if (!applicationNumber) {
      toast.warning("Application Number missing...", {
        position: "top-right",
      });
      return;
    }

    setCurrentApplicationNumber(applicationNumber);
    await fetchSupervisionPaymentDetails(applicationNumber);
    setShowSupervisionInvoiceModal(true);
  };

  const handleSupervisionProceedToPay = () => {
    setShowSupervisionInvoiceModal(false);
    if (supervisionPaymentData && currentApplicationNumber) {
      navigate(`/payment?applicationNo=${currentApplicationNumber}`, {
        state: {
          paymentData: supervisionPaymentData,
          applicationNumber: currentApplicationNumber,
          fullPaymentData: supervisionFullPaymentData,
        },
      });
    }
  };

  const fetchDashboardData = async () => {
    try {
      const URL =
        SERVICE_BASE.IWT_REGISTRATION +
        URLS_ENDPOINT.VESSEL_SERVICE.VESSEL_OWNER_DASH;

      loaderRef.current?.show();

      const payload = {};
      if (filterParams.applicationNumbers[0] !== "") {
        payload.applicationNumbers = filterParams.applicationNumbers;
      }
      if (filterParams.vesselName !== "") {
        payload.vesselName = filterParams.vesselName;
      }
      if (filterParams.fromDate !== "" && filterParams.toDate !== "") {
        payload.fromDate = filterParams.fromDate;
        payload.toDate = filterParams.toDate;
      }

      const response = await postData(URL, payload);

      if (response?.status === 200 && response?.data?.data) {
        const apiRes = [...response?.data?.data];
        // setVesselData(apiRes || []);
        // setFilteredVesselData(apiRes || []);

        setInboxData(apiRes || []);
        setFilteredInboxData(apiRes || []);

        loaderRef?.current?.hide();
      } else {
        loaderRef?.current?.hide();
        toast.info(
          response?.data?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  useEffect(() => {
    const data = generateVesselData(15);
    // setInboxData(data);
    // setFilteredInboxData(data);
    setVesselData(data);
    setFilteredVesselData(data);
    fetchDashboardData();
  }, []);

  useEffect(() => {
    const results = inboxData?.filter(
      (item) =>
        item?.applicationNumber
          ?.toString()
          ?.toLowerCase()
          ?.includes(inboxSearchTerm?.toLowerCase()) ||
        item?.vesselName
          ?.toLowerCase()
          ?.includes(inboxSearchTerm?.toLowerCase()) ||
        item?.registeredYear
          ?.toString()
          ?.toLowerCase()
          ?.includes(inboxSearchTerm?.toLowerCase()) ||
        item?.status
          ?.toString()
          ?.toLowerCase()
          ?.includes(inboxSearchTerm?.toLowerCase()) ||
        item?.lastSurveyDate
          ?.toLowerCase()
          ?.includes(inboxSearchTerm?.toLowerCase())
    );
    setFilteredInboxData(results);
    setInboxCurrentPage(1);
  }, [inboxSearchTerm, inboxData]);

  const handleTablePageChange = (page) => {
    setInboxCurrentPage(page);
  };

  useEffect(() => {
    const results = vesselData?.filter(
      (item) =>
        item?.registrationNo
          ?.toLowerCase()
          ?.includes(vesselSearchTerm?.toLowerCase()) ||
        item.vesselName
          ?.toLowerCase()
          ?.includes(vesselSearchTerm?.toLowerCase()) ||
        item?.registeredYear
          ?.toString()
          ?.toLowerCase()
          ?.includes(vesselSearchTerm?.toLowerCase()) ||
        item?.lastSurveyDate
          ?.toLowerCase()
          ?.includes(vesselSearchTerm?.toLowerCase()) ||
        item?.status
          ?.toLowerCase()
          ?.includes(vesselSearchTerm?.toLowerCase()) ||
        item?.vesselType
          ?.toLowerCase()
          ?.includes(vesselSearchTerm?.toLowerCase())
    );
    setFilteredVesselData(results);
    setVesselCurrentPage(1);
  }, [vesselSearchTerm, vesselData]);

  const handleVesselTablePageChange = (page) => {
    setVesselCurrentPage(page);
  };

  const handleCardClick = (cardInfo, index) => {
    if (index === 0) {
      // navigate("/user-registration/view");
    } else if (index === 1) {
      setIsModalOpen(true);
    }
  };
  // const statData = [
  //   {
  //     title: t("dashboard.Total Registered Vessel Count"),
  //     value: 35,
  //     icon: BsClipboardData,
  //     color: "#28a745",
  //     subtitle: t("dashboard.(Total Number of Registered Vessels)"),
  //   },

  //   {
  //     title: t("dashboard.Graphical Representation"),
  //     imageSrc: chart_icon,
  //     color: "#6ec1e4",
  //     subtitle: t(
  //       "dashboard.(Total number of registered vessel as per 'Type')"
  //     ),
  //   },

  //   {
  //     title: t("dashboard.Survey Due"),
  //     value: 20,
  //     icon: BsExclamationTriangle,
  //     color: "#E8B60E",
  //     subtitle: t(
  //       "dashboard.(Total Number of Vessel having Survey due within next 30Days)"
  //     ),
  //   },
  //   {
  //     title: t("dashboard.Insurance Due"),
  //     value: 15,
  //     icon: BsExclamationTriangle,
  //     color: "#902424",
  //     subtitle: t(
  //       "dashboard.(Total Number of Vessel having Insurance due within next 30Days)"
  //     ),
  //   },
  // ];

  const statData = [
    {
      title: t("dashboard.Total Registered Vessel Count"),
      value: 35,
      // icon: BsClipboardData,
      imageSrc: Survey,
      // color: "#065a1aff",
      color: "#ffffff",
      subtitle: t("dashboard.(Total Number of Registered Vessels)"),
      backgroundColor:
        // "linear-gradient(to right, #68bc7c 10%, #bbdbc2 50%, #68bc7c 100%)",
        "#0070C0",
    },
    {
      title: t("dashboard.Graphical Representation"),
      // icon: BsBarChartFill,
      imageSrc: Piechart,
      // color: "#045c81ff",
      color: "#ffffff",
      subtitle: t(
        "dashboard.(Total number of registered vessel as per 'Type')"
      ),
      backgroundColor: "#20AEE4",
      // "linear-gradient(to right, #61bbed 10%, #d8f1ff 50%, #61bbed 100%)",
      checkIcon: true,
    },
    {
      title: t("dashboard.Survey Due"),
      value: 20,
      // icon: BsExclamationTriangle,
      imageSrc: caution,
      // color: "#826402ff",
      color: "#ffffff",
      subtitle: t(
        "dashboard.(Total Number of Vessel having Survey due within next 30Days)"
      ),
      backgroundColor: "#1CBF97",
      // "linear-gradient(to right, #fdd251ff 10%, #fff59d 50%, #f9d976 100%)",
    },
    {
      title: t("dashboard.Insurance Due"),
      value: 15,
      imageSrc: caution,
      // icon: BsExclamationTriangle,
      // color: "#861212ff",
      color: "#ffffff",
      subtitle: t(
        "dashboard.(Total Number of Vessel having Insurance due within next 30Days)"
      ),
      backgroundColor: "#00D2E0",
      // "linear-gradient(to right, #ed9161 10%, #f3bda0 50%, #ed9161 100%)",
    },
  ];

  const handleDownloadCMN = async (rowData) => {
    loaderRef.current?.show();
    try {
      const payload = {
        applicationNumbers: [rowData?.applicationNumber ?? ""],
      };
      const apiUrl = `${SERVICE_BASE.IWT_REGISTRATION}${URLS_ENDPOINT.USER_SERVICE.REGISTRATION_SEARCH_BY_ID}`;
      const { status, data } = await postData(apiUrl, payload);

      const resData = data?.data?.[0] ?? {};
      // const statusMessage = res?.responseStatus?.status;

      if (status !== 200) {
        toast.error("Unable to fetch registration details.");
        return;
      }

      const fileStoreId = resData?.carvingmakingNote?.fileStoreId;

      if (!fileStoreId) {
        toast.error("Unable to find the file.");
        return;
      }

      const url = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${fileStoreId}`;

      const accessToken = getFromLocalStorage("access_token");
      const tokenDetails = getFromLocalStorage("tokenDetails");
      const sessionState = tokenDetails
        ? JSON.parse(tokenDetails)?.session_state
        : "";

      const response = await axios({
        method: "GET",
        url: url,
        responseType: "blob",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "X-Request-ID": sessionState,
          Accept: "application/octet-stream",
        },
      });

      if (response.data) {
        let filename = "CMN";
        const contentDisposition = response.headers["content-disposition"];
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(
            /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
          );
          if (filenameMatch && filenameMatch[1]) {
            filename = filenameMatch[1].replace(/['"]/g, "");
          }
        }

        const blob = new Blob([response.data], {
          type: response.headers["content-type"] || "application/octet-stream",
        });
        const blobUrl = window.URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = blobUrl;
        link.setAttribute("download", filename);
        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          window.URL.revokeObjectURL(blobUrl);
        }, 100);
      }
    } catch (err) {
      console.error("Error:", err);
      toast.error("Failed to download file.");
    } finally {
      loaderRef.current?.hide();
    }
  };

  const handleSlotBooking = (rowData, pageName) => {
    const regNo = rowData?.applicationNumber || "";
    if (!regNo) {
      toast.warning("Application Number missing...", {
        position: "top-right",
      });
      return;
    }
    navigate(`/vessel-owner/vessel-registration/view/?applicationNo=${regNo}`, {
      state: {
        rowData: { ...rowData },
        pageName: pageName,
      },
    });
  };

  const handleChangeFilter = (key, value) => {
    setFilterParams((prev) => {
      const newParams = { ...prev };
      if (key === "applicationNumbers") {
        newParams.applicationNumbers = [value ? value : ""];
      } else if (key === "dateRange") {
        const startDate = value?.startDate ? formatDate(value.startDate) : "";
        const endDate = value?.endDate ? formatDate(value.endDate) : "";
        newParams.fromDate = startDate;
        newParams.toDate = endDate;
      } else {
        newParams[key] = value ? value : "";
      }
      return newParams;
    });
  };

  function formatDate(dateStr) {
    const date = new Date(dateStr);
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  }

  const downloadCertificates = async (rowData, filetype) => {
    try {
      const certificateMap = {
        provsurvey: "provisionalSurveyCertificate",
        provregistration: "provisionalRegistrationCertificate",
        survey: "surveyCertificate",
        registration: "registrationCertificate",
      };

      const certKey = certificateMap[filetype];
      const certificate = rowData?.certificateDetails?.[certKey];

      if (!certificate || !certificate?.fileStoreId) {
        toast.error("Unable to find the file. Please contact Admin.");
        return;
      }

      const defaultNames = {
        provregistration: `${
          rowData?.applicationNumber || "App"
        }_Provisional-Registration-Certificate.pdf`,
        provsurvey: `${
          rowData?.applicationNumber || "App"
        }_Provisional-Survey-Certificate.pdf`,
        survey: `${rowData?.applicationNumber || "App"}_Survey-Certificate.pdf`,
        registration: `${
          rowData?.applicationNumber || "App"
        }_Registration-Certificate.pdf`,
      };

      let filename =
        defaultNames[filetype] ||
        `${rowData?.applicationNumber || "App"}-${filetype}-Certificate.pdf`;

      const url = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${certificate.fileStoreId}`;
      const accessToken = getFromLocalStorage("access_token");
      const tokenDetails = getFromLocalStorage("tokenDetails");
      const sessionState = tokenDetails
        ? JSON.parse(tokenDetails)?.session_state
        : "";

      loaderRef.current?.show();

      const response = await axios.get(url, {
        responseType: "blob",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "X-Request-ID": sessionState,
          Accept: "application/octet-stream",
        },
      });

      if (response?.data) {
        const contentDisposition = response?.headers["content-disposition"];
        if (contentDisposition) {
          const match = contentDisposition.match(
            /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
          );
          if (match?.[1]) {
            filename = match[1].replace(/['"]/g, "");
          }
        }

        const blob = new Blob([response.data], {
          type: response.headers["content-type"] || "application/octet-stream",
        });
        const blobUrl = URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = blobUrl;
        link.download = filename;
        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          URL.revokeObjectURL(blobUrl);
        }, 100);
      }
    } catch (err) {
      console.error("Download error:", err);
      toast.error("Failed to download file.");
    } finally {
      loaderRef.current?.hide();
    }
  };

  return (
    <>
      <NewLoader ref={loaderRef} />
      <div className="row g-3">
        {statData?.map((item, index) => (
          <div className="col-md-4 col-lg-3 col-sm-12" key={index}>
            <AnalyticsCard
              key={index}
              {...item}
              onClick={() => handleCardClick(item, index)}
            />
          </div>
        ))}
      </div>
      <br />

      {/* -----------------------------------   VESSEL SEARCH    --------------------------- */}
      {/* <Card>
        <Card.Header
          style={headerStyle}
          className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
        >
          <div className="d-flex align-items-center">
            <h6 className="mb-0 me-2">{t("dashboard.Vessel Information")}</h6>
          </div>
        </Card.Header>
      </Card> */}

      <Collapsible
        title={
          <div className="d-flex align-items-center">
            <img
              src={vesselIcon}
              alt="Vessel-Icon"
              className="me-2"
              style={{
                width: "2rem",
                height: "2rem",
                maxWidth: "100%",
              }}
            />
            <span className="fs-6 fs-md-5">
              {t("dashboard.Vessel Information")}
            </span>
          </div>
        }
        newDesign={true}
        openStat={true}
      >
        <form
          style={{ padding: "2rem", margin: 0 }}
          // onSubmit={handleSubmit(onSubmitFilterForm)}
        >
          <Row>
            <Col md={3}>
              <InputText
                type="text"
                name="applicationNumbers"
                label={t("dashboard.Registration No.")}
                placeholder={t("dashboard.Enter Registration No.")}
                value={filterParams.applicationNumbers[0]}
                onChange={(e) =>
                  handleChangeFilter("applicationNumbers", e.target.value)
                }
              />
            </Col>
            <Col md={3}>
              <InputText
                type="text"
                name="vesselName"
                label={t("dashboard.Vessel Name")}
                placeholder={t("dashboard.Enter Vessel name..")}
                value={filterParams.vesselName}
                onChange={(e) =>
                  handleChangeFilter("vesselName", e.target.value)
                }
              />
            </Col>
            <Col md={4}>
              <InputDateRangePicker
                label={t("dashboard.Date Range")}
                value={dateRange}
                onChange={(range) => {
                  handleChangeFilter("dateRange", range);
                }}
                // register={register}
                name="dateRange"
                // error={errors.dateRange}
              />
            </Col>
            <Col md={2}>
              <button
                style={{ position: "relative", top: "1.8rem" }}
                className="generic-btn-submit search-btn"
                type="button"
                // onClick={fetchDashboardData}
              >
                {t("dashboard.Filter")}
              </button>
            </Col>
          </Row>
        </form>

        <Card className="bg-transparent dashboard-card">
          <Card.Header
            style={headerStyle}
            className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
          >
            <div className="d-flex align-items-center">
              <h6 className="mb-0 me-2 fw-bold" style={{ color: "#1056B2" }}>
                {t("dashboard.Vessel List")}
              </h6>
            </div>
            <div className="d-flex align-items-center">
              {/* <Button variant="outline-secondary" className="filter-btn me-2">
                <BsFilter size={18} />
                <span className="ms-1 d-none d-sm-inline">
                  {t("dashboard.Filter")}
                </span>
              </Button> */}
            <Form className="inbox-search">
  <InputGroup>
    <InputGroup.Text className="search-icon-wrapper">
      <BsFilter size={16} />
    </InputGroup.Text>
    <Form.Control
      type="text"
      placeholder={t("dashboard.Search Vessels...")}
      aria-label="Search"
      value={vesselSearchTerm}
      onChange={(e) => setVesselSearchTerm(e.target.value)}
    />
    <Button className="search-btn">
      <BsSearch />
    </Button>
  </InputGroup>
</Form>
            </div>
          </Card.Header>

          <div style={{ position: "relative", bottom: "2rem" }}>
            <ActionTable
              columns={vesselColumns}
              // handleEditRow={handleEditAction}
              // onApplyInitialSurvey={handleApplySurvey}
              // onPaySupervisionFee={handlePaySupervisionFeePayment}
              onViewRow={(row) => console.log(row)}
              // onUploadReports={(row) =>
              //   handleButtonBasedEvents(row, "uploadReports")
              // }
              // onVesselRegistration={(row) =>
              //   handleButtonBasedEvents(row, "vesselRegistration")
              // }
              rowData={filteredVesselData}
              tableHeader={null}
              hideExportBtn={true}
              hideSearchBar={true}
              pagination={true}
              inboxCurrentPage={vesselCurrentPage}
              itemsInboxPerPage={itemsVesselPerPage}
              onPageChange={handleVesselTablePageChange}
              noDataText={
                <div className="no-results text-center py-4">
                  <BsSearch size={24} className="mb-2" />
                  <p>No results found</p>
                  <small>
                    Try adjusting your search to find what you're looking for.
                  </small>
                </div>
              }
              // onDownloadCMN={handleDownloadCMN}
              // onSlotBooking={(row) => handleSlotBooking(row, "slotBooking")}
            />
          </div>
        </Card>
      </Collapsible>

      {/* -----------------------------------  VESSEL SEARCH END  --------------------------- */}

      {/* -----------------------------------   INBOX    --------------------------- */}
      <Card className="bg-transparent mt-4 dashboard-card">
        <Card.Header
          style={headerStyle}
          className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
        >
          <div className="d-flex align-items-center">
            <h5 className="mb-0 me-2">{t("dashboard.Inbox")}</h5>
            <div
              className={`d-flex align-items-center justify-content-between badge`}
              style={{ backgroundColor: "#20B2AA" }}
            >
              <img
                src={bell}
                alt="Inbox Icon"
                style={{ width: "12px", height: "12px" }}
              />
              <span className="ms-1">{filteredInboxData.length}</span>
            </div>
          </div>
          <div className="d-flex align-items-center">
            {/* <Button variant="outline-secondary" className="filter-btn me-2">
              <BsFilter size={18} />
              <span className="ms-1 d-none d-sm-inline">
                {t("dashboard.Filter")}
              </span>
            </Button> */}
            <Form className="inbox-search">
  <InputGroup>
    <InputGroup.Text className="search-icon-wrapper">
      <BsFilter size={16} />
    </InputGroup.Text>
    <Form.Control
      type="text"
      placeholder="Search inbox..."
      aria-label="Search inbox"
      value={inboxSearchTerm}
      onChange={(e) => setInboxSearchTerm(e.target.value)}
    />
    <Button className="search-btn">
      <BsSearch />
    </Button>
  </InputGroup>
</Form>
          </div>
        </Card.Header>

        <div style={{ position: "relative", bottom: "2rem" }}>
          <ActionTable
            columns={inboxColumns}
            rowData={filteredInboxData}
            handleEditRow={handleEditAction}
            onApplyInitialSurvey={handleApplySurvey}
            onPaySupervisionFee={handlePaySupervisionFeePayment}
            onViewRow={handleViewAction}
            onUploadReports={(row) =>
              handleButtonBasedEvents(row, "uploadReports")
            }
            onVesselRegistration={(row) =>
              handleButtonBasedEvents(row, "vesselRegistration")
            }
            tableHeader={null}
            hideExportBtn={true}
            hideSearchBar={true}
            pagination={true}
            inboxCurrentPage={inboxCurrentPage}
            itemsInboxPerPage={itemsInboxPerPage}
            onPageChange={handleTablePageChange}
            // inboxCurrentPage={vesselCurrentPage}
            // itemsInboxPerPage={itemsVesselPerPage}
            // onPageChange={handleVesselTablePageChange}
            noDataText={
              <div className="no-results text-center py-4">
                <BsSearch size={24} className="mb-2" />
                <p>No results found</p>
                <small>
                  Try adjusting your search to find what you're looking for.
                </small>
              </div>
            }
            onDownloadCMN={handleDownloadCMN}
            onDownloadCerts={downloadCertificates}
            onSlotBooking={(row) => handleSlotBooking(row, "slotBooking")}
          />

          {/* <ActionTable
            columns={inboxColumns}
            rowData={filteredInboxData}
            tableHeader={null}
            hideExportBtn={true}
            hideSearchBar={true}
            pagination={true}
            inboxCurrentPage={inboxCurrentPage}
            itemsInboxPerPage={itemsInboxPerPage}
            onPageChange={handleTablePageChange}
            noDataText={
              <div className="no-results text-center py-4">
                <BsSearch size={24} className="mb-2" />
                <p>No results found</p>
                <small>
                  Try adjusting your search to find what you're looking for.
                </small>
              </div>
            }
          /> */}
        </div>
      </Card>

      {/* -----------------------------------   INBOX  END  --------------------------- */}

      {/* -----------------------------------   CHART    --------------------------- */}
      <ActionModal
        show={isModalOpen}
        close={setIsModalOpen}
        title="Inland Vessel Types"
        size={"md"}
        isFooterHide={true}
      >
        <DynamicChart
          type={CHART_TYPES[3]}
          data={vesselTypesChartData}
          options={getChartOptions("Distribution of Inland Vessel Types")}
        />
      </ActionModal>
      {/* -----------------------------------   CHART END  --------------------------- */}

      {/* SUPERVISION FEE INVOICE MODAL */}
      <InvoiceModal
        show={showSupervisionInvoiceModal}
        onHide={() => setShowSupervisionInvoiceModal(false)}
        paymentData={supervisionPaymentData}
        onProceedToPay={handleSupervisionProceedToPay}
        applicationNumber={currentApplicationNumber}
      />
    </>
  );
};

export default VesselOwner;
