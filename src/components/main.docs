// EmployeeRegistration.tsx
import React, { useRef, useState, useEffect } from "react";
import { useNavigate, useParams, useLocation } from "react-router-dom";
import { useForm, useFieldArray, Controller } from "react-hook-form";
import { Container, Row, Col, Card, Button } from "react-bootstrap";
import { toast } from "react-toastify";
import axios from "axios";
import {
  FaUser,
  FaMapMarkerAlt,
  FaBriefcase,
  FaFileUpload,
  FaGraduationCap,
  FaPlus,
  FaTrash,
  FaArrowLeft,
} from "react-icons/fa";
import InputText from "../../../common/InputText.tsx";
import { handleErrorMessage } from "../../../../utils/errorMessageHandler.js";
import InputSelect from "../../../common/InputSelect.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { CONSTANT_REGEX, renameFile } from "../../../../utils/constants.ts";
import { useMasterData } from "../../../context/MasterDataContext.js";
import NewLoader from "../../../common/NewLoader.js";
import "./EmployeeRegistration.css";
import { getData, postFORMdata } from "../../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import AppToggleButton from "../../../common/AppToggleButton.js";

const EmployeeRegistration = () => {
  const navigate = useNavigate();
  const { id } = useParams();
  const location = useLocation();
  const isEditMode = !!id;
  const loaderRef = useRef();
  const { masterData } = useMasterData();

  const [addressProofFile, setAddressProofFile] = useState(null);
  const [identityProofFile, setIdentityProofFile] = useState(null);
  const [appointmentLetterFile, setAppointmentLetterFile] = useState(null);
  const [toggleValue, setToggleValue] = useState(true);
  const [employeeData, setEmployeeData] = useState(null);

  const {
    register,
    handleSubmit,
    control,
    formState: { errors },
    setValue,
    watch,
    reset,
  } = useForm({
    mode: "onSubmit",
    defaultValues: {
      firstName: "",
      lastName: "",
      email: "",
      phoneNumber: "",
      gender: "",
      dateOfBirth: "",
      addressLine1: "",
      addressLine2: "",
      pin: "",
      district: "",
      stateUt: "",
      country: "India",
      appointmentDate: "",
      employeeType: "",
      designation: "",
      addressProof: "",
      identityProof: "",
      appointmentLetter: "",
      educationDetails: [{ qualification: "", stream: "", yearOfPassing: "" }],
      professionalDetails: [
        {
          appointmentDate: "",
          employeeType: "",
          employeeStatus: "",
          designation: "",
          department: "",
          section: "",
          roles: "",
        },
      ],
      isActive: true,
    },
  });

  const { fields, append, remove } = useFieldArray({
    control,
    name: "educationDetails",
  });

  const {
    fields: professionalFields,
    append: appendProfessional,
    remove: removeProfessional,
  } = useFieldArray({
    control,
    name: "professionalDetails",
  });

  useEffect(() => {
    if (isEditMode) {
      // Check if we have employee data passed via state
      if (location.state?.employeeData) {
        const employeeData = location.state.employeeData;
        setEmployeeData(employeeData);
        populateFormData(employeeData);
      } else {
        // If not, fetch the employee data
        fetchEmployeeData();
      }
    }
  }, [isEditMode, id, location.state]);

  const fetchEmployeeData = async () => {
    try {
      loaderRef.current?.show();
      const URL = process.env.REACT_APP_AUTH_URL + URLS_ENDPOINT.USER_SERVICE.GET_EMP_BY_ID + id;
      const response = await getData(URL);
      
      if (response?.status === 200) {
        const employeeData = response.data?.data;
        setEmployeeData(employeeData);
        populateFormData(employeeData);
      } else {
        toast.error("Failed to fetch employee data");
      }
    } catch (error) {
      console.error("Error fetching employee data:", error);
      toast.error("Error fetching employee data");
    } finally {
      loaderRef.current?.hide();
    }
  };

  const populateFormData = (employeeData) => {
    reset({
      firstName: employeeData.firstName,
      lastName: employeeData.lastName,
      email: employeeData.emailId,
      phoneNumber: employeeData.phoneNumber,
      gender: employeeData.gender,
      dateOfBirth: employeeData.dateOfBirth,
      addressLine1: employeeData.addressLine1,
      addressLine2: employeeData.addressLine2 || "",
      pin: employeeData.pin,
      district: employeeData.district,
      stateUt: employeeData.stateUt,
      country: employeeData.country,
      isActive: employeeData.isActive,
      educationDetails: employeeData.educationDetails?.map(ed => ({
        uuid: ed.uuid,
        qualification: ed.qualification,
        stream: ed.stream,
        yearOfPassing: ed.yearOfPassing,
        additionalEducationDetails: ed.additionalEducationDetails || ""
      })) || [{ qualification: "", stream: "", yearOfPassing: "" }],
      professionalDetails: employeeData.professionalDetails?.map(pd => ({
        uuid: pd.uuid,
        appointmentDate: pd.appointmentDate,
        employeeType: pd.employeeType,
        employeeStatus: pd.employeeStatus,
        designation: pd.designation,
        department: pd.department || "",
        section: pd.section || "",
        roles: pd.role || ""
      })) || [{
        appointmentDate: "",
        employeeType: "",
        employeeStatus: "",
        designation: "",
        department: "",
        section: "",
        roles: ""
      }]
    });
    setToggleValue(employeeData.isActive);
  };

  // Rest of your component code remains the same...
  // Only replace the static data references with employeeData

  // In the documents upload section, replace the static links with:
  {isEditMode && employeeData?.fileStoreMaps?.[0]?.downLoadFile && (
    <div className="mt-2">
      <a 
        href={employeeData.fileStoreMaps[0].downLoadFile} 
        target="_blank" 
        rel="noopener noreferrer"
        className="text-primary"
      >
        View current address proof
      </a>
    </div>
  )}

  // Similarly for identity proof and appointment letter
  {isEditMode && employeeData?.fileStoreMaps?.[1]?.downLoadFile && (
    <div className="mt-2">
      <a 
        href={employeeData.fileStoreMaps[1].downLoadFile} 
        target="_blank" 
        rel="noopener noreferrer"
        className="text-primary"
      >
        View current identity proof
      </a>
    </div>
  )}

  {isEditMode && employeeData?.fileStoreMaps?.[2]?.downLoadFile && (
    <div className="mt-2">
      <a 
        href={employeeData.fileStoreMaps[2].downLoadFile} 
        target="_blank" 
        rel="noopener noreferrer"
        className="text-primary"
      >
        View current appointment letter
      </a>
    </div>
  )}

  // ... rest of your component code

  return (
    // Your existing JSX
  );
};

export default EmployeeRegistration;
