// payloadUtils.js
export const prepareFormPayload = (formData) => {
  // Generate a unique claim ID
  const claimId = `CLM-${Date.now()}-${Math.random().toString(36).substring(2, 8)}`;
  
  // Process file uploads with unique IDs and metadata
  const processFileUpload = (fileObj, fieldName) => {
    if (!fileObj || !fileObj.file) return null;
    
    const fileId = `FILE-${Date.now()}-${Math.random().toString(36).substring(2, 8)}`;
    const fileExtension = fileObj.file.name.split('.').pop();
    const fileName = `${fieldName}_${fileId}.${fileExtension}`;
    
    return {
      fileId,
      fileName,
      fileType: fileObj.file.type,
      fileSize: fileObj.file.size,
      fieldName,
      uploadDate: new Date().toISOString(),
      // In a real implementation, you would also include the file content or upload URL
      // fileContent: await convertToBase64(fileObj.file),
      // or
      // uploadUrl: await getPresignedUrl(fileName)
    };
  };

  // Construct the professional payload
  const payload = {
    claimId,
    metadata: {
      submissionDate: new Date().toISOString(),
      status: "submitted",
      version: "1.0"
    },
    claimantInformation: {
      debtorDetails: {
        name: formData.step1.debtorName,
        identification: {
          type: formData.step1.identificationType,
          number: formData.step1.identificationNumber,
          document: processFileUpload(formData.step1.identificationDocument, 'identificationDocument')
        }
      },
      creditorDetails: {
        name: formData.step1.CreditorName,
        email: formData.step2.creditorEmail,
        address: formData.step2.creditorAddress,
        accountDetails: {
          accountNumber: formData.step2.accountNumber,
          ifscCode: formData.step2.ifscCode,
          branchName: formData.step2.branchName
        },
        addressProof: processFileUpload(formData.step2.addressProof, 'addressProof')
      }
    },
    claimDetails: {
      totalClaimAmount: parseFloat(formData.step1.totalClaimAmount),
      debtDescription: formData.step1.debtDetails,
      mutualCreditDetails: formData.step1.mutualCreditDetails,
      securityInterests: {
        amount: parseFloat(formData.step2.securityInterestAmount),
        corporateDebtorAmount: parseFloat(formData.step2.corporateDebtorSecurityAmount)
      },
      guarantees: {
        amount: parseFloat(formData.step2.guaranteeAmount),
        corporateDebtorAmount: parseFloat(formData.step2.corporateDebtorGuaranteeAmount),
        guarantorDetails: {
          name: formData.step2.guarantorName,
          address: formData.step2.guarantorAddress
        },
        principalBorrower: {
          name: formData.step2.principalBorrowerName,
          address: formData.step2.principalBorrowerAddress
        }
      },
      beneficiaryDetails: {
        name: formData.step2.beneficiaryName,
        address: formData.step2.beneficiaryAddress
      }
    },
    authorization: {
      signatoryDetails: {
        name: formData.step3.signatoryName,
        position: formData.step3.signatoryPosition,
        address: formData.step3.signatoryAddress,
        authorizationDocument: processFileUpload(formData.step3.signatoryDocument, 'signatoryDocument')
      },
      declaration: {
        confirmation: true, // This would come from your isConfirmed state
        date: new Date().toISOString()
      }
    },
    systemMetadata: {
      createdBy: "web-portal", // You might want to include user ID here
      createdAt: new Date().toISOString(),
      lastModified: new Date().toISOString()
    }
  };

  return payload;
};

// Helper function to convert file to base64 (uncomment if needed)
