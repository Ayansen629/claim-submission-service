import React from "react";
import { Card, Row, Col, Button } from "react-bootstrap";
import { useForm } from "react-hook-form";
import InputSelect from "../../../common/InputSelect.tsx";
import InputText from "../../../common/InputText.tsx";
import { headerStyle } from "../../../../utils/constants.ts";

const UserRegFilter = ({ onFilterSubmit }) => {
  const {
    register,
    handleSubmit,
    reset,
    watch,
    setValue,
    formState: { errors },
  } = useForm();

  // Watch select values to handle changes
  const applicationModule = watch("applicationModule");
  const applicationType = watch("applicationType");
  const applicationStatus = watch("applicationStatus");

  const onSubmitFilterForm = (data) => {
    onFilterSubmit(data);
  };

  // Handle select changes manually
  const handleSelectChange = (name: string, value: string) => {
    setValue(name, value);
  };

  return (
    <Card className="mb-4 filter-card">
      <Card.Header className="dashboard-card-header" style={headerStyle}>
        <h5>Filter Applications</h5>
      </Card.Header>
      <Card.Body>
        <form onSubmit={handleSubmit(onSubmitFilterForm)}>
          <Row>
            <Col md={3}>
              <InputSelect
                label="Application Module"
                name="applicationModule"
                options={[
                  { value: "", label: "All Modules" },
                  { value: "registration", label: "Registration" },
                  { value: "survey", label: "Survey" },
                  { value: "training", label: "Manning/Training & Certification" },
                ]}
                value={applicationModule || ""}
                onChange={(value) => handleSelectChange("applicationModule", value)}
                errors={errors}
              />
            </Col>

            <Col md={3}>
              <InputSelect
                label="Application Type"
                name="applicationType"
                options={[
                  { value: "", label: "All Types" },
                  { value: "ship_builder", label: "Ship Builder" },
                  { value: "vessel_owner", label: "Vessel Owner" },
                  { value: "duplicate", label: "Duplicate Certificate" },
                ]}
                value={applicationType || ""}
                onChange={(value) => handleSelectChange("applicationType", value)}
                errors={errors}
              />
            </Col>

            <Col md={3}>
              <InputSelect
                label="Application Status"
                name="applicationStatus"
                options={[
                  { value: "", label: "All Statuses" },
                  { value: "pending", label: "Pending" },
                  { value: "completed", label: "Completed" },
                  { value: "processing", label: "Processing" },
                  { value: "rejected", label: "Rejected" },
                ]}
                value={applicationStatus || ""}
                onChange={(value) => handleSelectChange("applicationStatus", value)}
                errors={errors}
              />
            </Col>

            <Col md={3}>
              <InputText
                type="text"
                name="applicationNumber"
                label="Application Number"
                maxLength={15}
                placeholder="e.g. APP-2025-001"
                register={register("applicationNumber")}
                errors={errors}
              />
            </Col>
          </Row>

          <Row className="mt-3">
            <Col md={3}>
              <InputText
                type="date"
                name="fromDate"
                label="From Date"
                register={register("fromDate")}
                errors={errors}
              />
            </Col>

            <Col md={3}>
              <InputText
                type="date"
                name="toDate"
                label="To Date"
                register={register("toDate")}
                errors={errors}
              />
            </Col>

            <Col md={3}>
              <InputText
                type="text"
                name="phoneNumber"
                label="Phone Number"
                maxLength={10}
                placeholder="Enter phone number"
                register={register("phoneNumber", {
                  pattern: {
                    value: /^[0-9]*$/,
                    message: "Only numbers are allowed",
                  },
                })}
                errors={errors}
              />
            </Col>

            <Col md={3} className="d-flex align-items-end">
              <div className="d-flex gap-2 w-100">
                <Button variant="primary" type="submit" className="w-50">
                  Apply Filters
                </Button>
                <Button
                  variant="outline-secondary"
                  type="button"
                  className="w-50"
                  onClick={() => {
                    reset({
                      applicationModule: "",
                      applicationType: "",
                      applicationStatus: "",
                      applicationNumber: "",
                      fromDate: "",
                      toDate: "",
                      phoneNumber: ""
                    });
                    onFilterSubmit({});
                  }}
                >
                  Reset
                </Button>
              </div>
            </Col>
          </Row>
        </form>
      </Card.Body>
    </Card>
  );
};

export default UserRegFilter;
