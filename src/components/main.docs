.declaration-text p {
  text-align: justify;
  margin-bottom: 1rem;
  word-wrap: break-word;
  overflow-wrap: break-word;
  hyphens: auto;
}

.highlight-field {
  background: linear-gradient(120deg, #2466BF 0%, #1976d2 100%);
  color: white !important;
  padding: 2px 8px;
  border-radius: 4px;
  font-weight: bold !important;
  font-style: italic !important;
  display: inline;
  margin: 0 2px;
  white-space: nowrap;
}
