import React, { useState, useEffect, useRef } from "react";
import WelcomeBox from "../../../common/WelcomeBox.js";
import { Card, Form, InputGroup, Button, Row, Col } from "react-bootstrap";
import { BsSearch, BsFilter } from "react-icons/bs";
import ActionTable from "../../../common/ActionTable.tsx";
import { useNavigate } from "react-router-dom";
import UserRegFilter from "./userRegFilter.js";
import { headerStyle, PROCESS_NAME } from "../../../../utils/constants.ts";
import { postData } from "../../../../services/http.service.ts";
import {
  SERVICE_BASE,
  URLS_ENDPOINT,
} from "../../../../utils/urlsConstants.ts";
import NewLoader from "../../../common/NewLoader.js";
import { handleErrorMessage } from "../../../../utils/errorMessageHandler.js";
import { toast } from "react-toastify";

const INBOX_COLUMNS = [
  {
    colName: "Application No",
    fieldName: "applicationNo",
    clsName: "column-text-start",
    isLink: true,
    minWidth: "11rem",
  },
  {
    colName: "Application Type",
    fieldName: "applicationType",
    clsName: "column-text-start",
  },

  {
    colName: "Name",
    fieldName: "companyName",
    clsName: "column-text-start",
    minWidth: "11rem",
  },
  {
    colName: "Phone No",
    fieldName: "phoneNumber",
    clsName: "column-text-start",
  },
  {
    colName: "State",
    fieldName: "state",
    clsName: "column-text-start",
  },
  {
    colName: "District",
    fieldName: "district",
    clsName: "column-text-start",
  },
  {
    colName: "Date of Submission",
    fieldName: "dateOfApplication",
    clsName: "column-text-start",
  },
  {
    colName: "Status",
    fieldName: "status",
    clsName: "column-text-start",
    render: (value) => (
      <span className={`status-badge ${value.toLowerCase()}`}>{value}</span>
    ),
  },
];

const UserRegDashboard = () => {
  const navigate = useNavigate();
  const [inboxData, setInboxData] = useState([]);
  const [filteredData, setFilteredData] = useState([]);
  const [currentPage, setCurrentPage] = useState(1);
  const [searchTerm, setSearchTerm] = useState("");
  const [filters, setFilters] = useState({});
  const itemsPerPage = 5;
  const loaderRef = useRef();

  // const generateInboxData = () => {
  //   const statuses = ["Pending", "Completed", "Processing", "Rejected"];
  //   const states = [
  //     "West Bengal",
  //     "Kerala",
  //     "Tamil Nadu",
  //     "Gujarat",
  //     "Maharashtra",
  //   ];
  //   const districts = [
  //     "Kolkata",
  //     "Howrah",
  //     "North 24 Parganas",
  //     "South 24 Parganas",
  //     "Hooghly",
  //   ];
  //   const phoneNumbers = [
  //     "9876543210",
  //     "8765432109",
  //     "7654321098",
  //     "6543210987",
  //     "9432109876",
  //   ];
  //   const ownerNames = [
  //     "John Doe Marine Services",
  //     "Ocean Ventures Ltd",
  //     "Coastal Shipping Co",
  //     "Marine Solutions Inc",
  //     "Blue Water Enterprises",
  //   ];
  //   const builderNames = [
  //     "Marine Shipyard Pvt Ltd",
  //     "Coastal Builders Corp",
  //     "Ocean Engineering Ltd",
  //     "Maritime Construction Co",
  //     "Shipbuilding Industries",
  //   ];

  //   return Array.from({ length: 20 }, (_, i) => ({
  //     id: i + 1,
  //     applicationNo: `${i % 2 === 0 ? "OWN" : "BLD"}-2025-${(i + 1)
  //       .toString()
  //       .padStart(3, "0")}`,
  //     applicationType: i % 2 === 0 ? "Vessel Owner" : "Ship Builder",
  //     companyName: i % 2 === 0 ? ownerNames[i % 5] : builderNames[i % 5],
  //     phoneNumber: phoneNumbers[i % 5],
  //     state: states[i % 5],
  //     district: districts[i % 5],
  //     dateOfApplication: new Date(
  //       2025,
  //       Math.floor(Math.random() * 12),
  //       Math.floor(Math.random() * 28) + 1
  //     )
  //       .toISOString()
  //       .split("T")[0],
  //     status: statuses[Math.floor(Math.random() * statuses.length)],
  //   }));
  // };

  useEffect(() => {
    // const data = generateInboxData();
    // setInboxData(data);
    // setFilteredData(data);

    fetchRegUserList();
  }, []);

  const fetchRegUserList = async () => {
    const URL =
      SERVICE_BASE.IWT_WORKFLOW +
      URLS_ENDPOINT.WORK_FLOW_SERVICE.DASHBOARD_WORK_LIST;

    try {
      loaderRef.current?.show();

      const response = await postData(URL, {
        processId: PROCESS_NAME.DASH_VIEW_ID,
      });

      if (response?.status !== 200 || !response?.data?.data) {
        toast.info(
          response?.data?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
        return;
      }

      const { userRegistrationWorkList = [] } = response.data.data;
      const userApplicationList =
        userRegistrationWorkList[0]?.userApplicationList ?? [];

      const mappedData = userApplicationList.map((item) => ({
        ...item,
        applicationType:
          item.applicationType === "Vessel_Owner"
            ? "Vessel Owner"
            : "Vessel Builder",
      }));

      setInboxData(mappedData);
      setFilteredData(mappedData);
    } catch (err) {
      console.error("fetchRegUserList error:", err);
      handleErrorMessage(err?.response?.data);
    } finally {
      loaderRef.current?.hide();
    }
  };

  useEffect(() => {
    const lowerSearch = (searchTerm || "")?.toLowerCase();

    const results =
      inboxData?.filter((item) => {
        const searchableFields = [
          item?.applicationNo,
          item?.applicationType,
          item?.companyName,
          item?.phoneNumber,
          item?.state,
          item?.district,
          item?.status,
          item?.dateOfApplication,
        ];

        return searchableFields.some((field) =>
          (field ?? "")?.toLowerCase()?.includes(lowerSearch)
        );
      }) ?? [];

    setFilteredData(results);
    setCurrentPage(1);
  }, [searchTerm, inboxData]);

  const applyFilters = async (filterData) => {
    setFilters(filterData);

    if (
      !filterData.filerCriteria ||
      Object.values(filterData.filerCriteria).every((val) => !val)
    ) {
      fetchRegUserList(); // Reset to original data
      return;
    }

    try {
      const URL =
        SERVICE_BASE.IWT_WORKFLOW +
        URLS_ENDPOINT.WORK_FLOW_SERVICE.DASHBOARD_FILTER;

      loaderRef.current?.show();
      const response = await postData(URL, filterData);
      let apiRes = {};

      if (response?.status === 200 && response?.data?.data) {
        apiRes = { ...response?.data?.data };

        const filteredResults =
          apiRes?.userRegistrationWorkList[0]?.userApplicationList.map(
            (item) => ({
              ...item,
              applicationType:
                item.applicationType === "Vessel_Owner"
                  ? "Vessel Owner"
                  : "Vessel Builder",
            })
          );

        setFilteredData(filteredResults);
        setCurrentPage(1);
      } else {
        toast.info("No results found for the applied filters");
        setFilteredData([]);
      }
      loaderRef.current?.hide();
    } catch (err) {
      console.log(err);
      loaderRef.current?.hide();
      handleErrorMessage(err?.response?.data);
      setFilteredData([]);
    }
  };

  const handleTablePageChange = (page) => {
    setCurrentPage(page);
  };

  const handleOnViewRow = async (rowData) => {
    const type =
      rowData?.applicationType === "Vessel Owner" ? "owner" : "builder";
    try {
      
      const URL =
      // SERVICE_BASE.IWT_USER + URLS_ENDPOINT.USER_SERVICE.SEARCH_USER;
      
        SERVICE_BASE.IWT_USER + URLS_ENDPOINT.USER_SERVICE.SEARCH_USER_V2;

      loaderRef.current?.show();

      const response = await postData(URL, {
        registrationNumbers: [rowData?.applicationNo],
      });

      if (response?.status === 200 && response?.data?.data) {
        console.log("Response data User By ID : ", response?.data?.data);

        navigate(`/user-dashboard/${type}/${rowData.id}`, {
          state: { application: response?.data?.data },
        });
      }
      loaderRef.current?.hide();
    } catch (err) {
      console.log("Error in handleOnViewRow: ", err);
      loaderRef.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  return (
    <>
      <NewLoader ref={loaderRef} />
      <UserRegFilter
        onFilterSubmit={applyFilters}
        handleGoBack={() => navigate("/dashboard")}
      />

      <Card className="bg-transparent mt-4 dashboard-card">
        <Card.Header
          style={headerStyle}
          className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
        >
          <div className="d-flex align-items-center">
            <h5 className="mb-0 me-2">Inbox</h5>
            <span className="badge bg-primary rounded-pill">
              {filteredData.length}
            </span>
          </div>
          <div className="d-flex align-items-center">
            <Button variant="outline-secondary" className="filter-btn me-2">
              <BsFilter size={18} />
              <span className="ms-1 d-none d-sm-inline">Filter</span>
            </Button>
            <Form className="inbox-search">
              <InputGroup>
                <Form.Control
                  type="text"
                  placeholder="Search inbox..."
                  aria-label="Search inbox"
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                />
                <Button variant="primary">
                  <BsSearch />
                </Button>
              </InputGroup>
            </Form>
          </div>
        </Card.Header>
        <div style={{ position: "relative", bottom: "2rem" }}>
          <ActionTable
            columns={INBOX_COLUMNS}
            rowData={filteredData}
            tableHeader={null}
            hideExportBtn={true}
            hideSearchBar={true}
            pagination={true}
            currentPage={currentPage}
            itemsPerPage={itemsPerPage}
            onPageChange={handleTablePageChange}
            onViewRow={handleOnViewRow}
            noDataText={
              <div className="no-results text-center py-4">
                <BsSearch size={24} className="mb-2" />
                <p>No results found</p>
                <small>
                  Try adjusting your search to find what you're looking for.
                </small>
              </div>
            }
          />
        </div>
      </Card>
    </>
  );
};

export default UserRegDashboard;
