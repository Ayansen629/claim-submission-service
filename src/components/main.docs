import axios, { AxiosInstance } from "axios";
import {
  getFromLocalStorage,
  setToLocalStorage,
} from "../../utils/localStorageUtils";
import { refreshAccessToken } from "../authService";
import { clearAppStorage } from "../../utils/constants";
import { toast } from "react-toastify";
import { isJwtExpired } from "../../utils/jwtUtils";

// Create regular axios instance for JSON responses
const axiosInstance = axios.create({
  baseURL: process.env.REACT_APP_BASE_URL,
  headers: {
    "Content-Type": "application/json",
  },
  responseType: "json",
});

// Create separate axios instance for blob responses
const axiosBlobInstance = axios.create({
  baseURL: process.env.REACT_APP_BASE_URL,
  responseType: "blob",
});

// Common request interceptor
const requestInterceptor = (config: any) => {
  const accessToken = getFromLocalStorage("access_token");
  const tokenDetails = getFromLocalStorage("tokenDetails");

  if (accessToken) {
    config.headers.Authorization = `Bearer ${accessToken}`;
    config.headers["X-Request-ID"] = JSON.parse(tokenDetails)?.session_state;
  }
  return config;
};

// Common response interceptor
const responseInterceptor = async (error: any) => {
  const originalRequest = error?.config;

  if (error.response && error.response.status === 401 && !originalRequest._retry) {
    originalRequest._retry = true;

    try {
      const refreshToken = getFromLocalStorage("refresh_token");

      if (isJwtExpired(refreshToken)) {
        toast.error("Session Expired. Please login again to continue..");
        setTimeout(() => {
          clearAppStorage();
          window.location.href = "/";
        }, 1500);
        return Promise.reject(error);
      }

      const newTokens = await refreshAccessToken(refreshToken);
      const tokenDetails = getFromLocalStorage("tokenDetails");

      setToLocalStorage("access_token", newTokens?.access_token);
      setToLocalStorage("refresh_token", newTokens?.refresh_token);

      originalRequest.headers.Authorization = `Bearer ${newTokens?.access_token}`;
      originalRequest.headers["X-Request-ID"] = JSON.parse(tokenDetails)?.session_state;

      return axiosInstance(originalRequest);
    } catch (err) {
      console.error("Error refreshing token", err);
      toast.error("Something went wrong. Please login again to continue...");
      setTimeout(() => {
        clearAppStorage();
        window.location.href = "/";
      }, 1500);
      return Promise.reject(err);
    }
  }

  return Promise.reject(error);
};

// Apply interceptors to both instances
axiosInstance.interceptors.request.use(requestInterceptor, (error) => Promise.reject(error));
axiosInstance.interceptors.response.use((response) => response, responseInterceptor);

axiosBlobInstance.interceptors.request.use(requestInterceptor, (error) => Promise.reject(error));
axiosBlobInstance.interceptors.response.use((response) => response, responseInterceptor);

export { axiosInstance, axiosBlobInstance };
