
import React, { useEffect, useState } from "react";
import { Link, useLocation } from "react-router-dom";
import {
  FaHome,
  FaUser,
  FaCog,
  FaChevronRight,
  FaShip,
  FaDatabase,
  FaTimes,
  FaFileAlt,
  FaUsers,
  FaUpload
} from "react-icons/fa";
import "./styles/Sidebar.css";

const Sidebar = ({ isSidebarOpen, onMenuClick, onClose, userRole }) => {
  const location = useLocation();
  const [activeMenu, setActiveMenu] = useState("");
  const [expandedMenus, setExpandedMenus] = useState({});

  // Define menu items based on user role
  const getMenuItems = () => {
    const commonItems = [
      {
        name: "dashboard",
        label: "Dashboard",
        icon: <FaHome />,
        path: "/dashboard",
        // subMenu: [
        //   { name: "vessel-owner", label: "Vessel Owner", path: "/dashboard" },
        //   { name: "employee-dashboard", label: "Employee", path: "/dashboard/employee-dashboard" },
        // ],
      },
       {
         name: "settings",
         label: "Settings",
         icon: <FaCog />,
         subMenu: [
           { name: "profile", label: "Profile", path: "/settings/profile" },
           { name: "security", label: "Security", path: "/settings/security" },
         ],
       },
    ];

    if (userRole === "admin") {
      return [
        ...commonItems,
        // {
        //    name: "vessel-registration",
        //    label: "Vessel Registration",
        //    path: "/vessel-registration/new-vessel",
        //    icon: <FaShip />,
        //    subMenu: [
        //      { name: "add-user", label: "New Vessel Registration", path: "/vessel-registration/new-vessel" },
        //      // { name: "manage-vessel", label: "View / Update", path: "/vessel-registration/manage-vessel" },
        //      { name: "", label: "Name Change of Vessel", path: "" },
        //      { name: "", label: "Registration for Alteration/Modification of Inland Vessels", path: "" },
        //      { name: "", label: "Transfer of Registry", path: "" },
        //      { name: "", label: "Transfer of Inland Vessel", path: "" },
        //      { name: "", label: "Cancellation of Registration", path: "" },
        //      { name: "", label: "Registration for Mortgage of mechanically propelled inland vessel (Hypothecation)", path: "" },
        //      { name: "", label: "De-registration for Mortgage of mechanically propelled inland vessel (De-hypothecation)", path: "" },
        //      { name: "", label: "Transfer for Mortgage of mechanically propelled inland vessel or share", path: "" },
        //      { name: "", label: "Duplicate Registration Certificatee", path: "" },
        //      { name: "upload-legacy-data", label: "Upload Legacy Data", path: "/vessel-registration/upload-legacy-data" },
       
       
        //    ],
        //  },
       {
          name: "master",
          label: "Master",
          icon: <FaDatabase />,
          subMenu: [
            { name: "manage-employee", label: "Employee Management", path: "/iwt/employee-management" },
          ],
        }
      ];
    }
    else if (["L1", "L2", "L3"].includes(userRole)) {
      // Officer roles only see dashboard and settings
      return commonItems;
    }
    else {
      // Other roles (vessel_owner, builder, employee)
      return [
        ...commonItems,
        {
          name: "vessel-registration",
          label: "Vessel Registration",
          path: "/vessel-registration/new-vessel",
          icon: <FaShip />,
          subMenu: [
            { name: "add-user", label: "New Vessel Registration", path: "/vessel-registration/new-vessel" },
            // { name: "manage-vessel", label: "View / Update", path: "/vessel-registration/manage-vessel" },
            { name: "", label: "Name Change of Vessel", path: "" },
            { name: "", label: "Registration for Alteration/Modification of Inland Vessels", path: "" },
            { name: "", label: "Transfer of Registry", path: "" },
            { name: "", label: "Transfer of Inland Vessel", path: "" },
            { name: "", label: "Cancellation of Registration", path: "" },
            { name: "", label: "Registration for Mortgage of mechanically propelled inland vessel (Hypothecation)", path: "" },
            { name: "", label: "De-registration for Mortgage of mechanically propelled inland vessel (De-hypothecation)", path: "" },
            { name: "", label: "Transfer for Mortgage of mechanically propelled inland vessel or share", path: "" },
            { name: "", label: "Duplicate Registration Certificatee", path: "" },
            { name: "upload-legacy-data", label: "Upload Legacy Data", path: "/vessel-registration/upload-legacy-data" },
      
      
          ],
        },
      ];
    }
  };

  const menuItems = getMenuItems();

  useEffect(() => {
     const current = menuItems.find((item) => {
       if (item.subMenu) {
         return item.subMenu.some((sub) => sub.path === location.pathname);
       }
       return item.path === location.pathname;
     });
     setActiveMenu(current?.name || "");
   }, [location]);
 
   const toggleSubMenu = (menuName) => {
     setExpandedMenus((prev) => ({
       ...prev,
       [menuName]: !prev[menuName],
     }));
   };

   return (
     <>
       {/* Mobile backdrop */}
       {/* {isSidebarOpen && (
         <div className="custom-sidebar-backdrop" onClick={onClose}></div>
       )} */}
 
       <div
         className={`custom-sidebar ${isSidebarOpen ? "expanded" : "collapsed"}`}
       >
         {/* Optional close button for mobile */}
         <div className="custom-sidebar-close">
           <FaTimes onClick={onClose} />
         </div>
 
         <ul className="custom-sidebar-menu">
           {menuItems?.map((item, index) => {
             const isActive = activeMenu === item.name;
             const hasSubMenu = !!item.subMenu;
 
             return (
               <li key={item.name+index} className={`custom-sidebar-item ${isActive ? "active" : ""}`}>
                 <div
                   className="custom-sidebar-link"
                   onClick={() => {
                     if (hasSubMenu) toggleSubMenu(item.name);
                     else onMenuClick(item.name);
                   }}
                   aria-expanded={!!expandedMenus[item.name]}
                 >
                   <div className="custom-sidebar-link-content">
                     <span className="custom-sidebar-icon">{item.icon}</span>
                     {isSidebarOpen && <span>{item.label}</span>}
                   </div>
                   {hasSubMenu && isSidebarOpen && (
                     <span className={`custom-sidebar-chevron ${expandedMenus[item.name] ? "rotate" : ""}`}>
                       <FaChevronRight size={12} />
                     </span>
                   )}
                 </div>
 
                 {hasSubMenu && (
                   <div className={`custom-sidebar-submenu ${expandedMenus[item.name] && isSidebarOpen ? "expanded" : "collapsed"}`}>
                     {item?.subMenu?.map((sub, index) => (
                       <Link
                         key={sub?.name+index}
                         to={sub?.path}
                         className={`custom-sidebar-sublink ${location.pathname === sub?.path ? "active" : ""}`}
                         onClick={() => {
                           onMenuClick(sub?.name);
                         }}
                       >
                         {sub?.label}
                       </Link>
                     ))}
                   </div>
                 )}
               </li>
             );
           })}
         </ul>
       </div>
     </>
   );
 };
 
 export default Sidebar;
 
import React, { useEffect, useRef } from 'react';
import VesselOwner from './vessel-owner/VesselOwner';
import NewLoader from '../../common/NewLoader';
import Employee from '../employee/employee';

const Dashboard = () => {
    const loaderRef = useRef(null);
    const userRole = localStorage?.getItem("userRole") || 'admin';
    
    useEffect(() => {
        // Show loader initially
        if (loaderRef.current) {
            loaderRef.current.show();
            
            // Hide loader after content is loaded
            setTimeout(() => {
                if (loaderRef.current) {
                    loaderRef.current.hide();
                }
            }, 1000);
        }
    }, []);

    useEffect(() => {
        window.scrollTo(0, 0);
    }, []);
    return (
        <>
            <NewLoader ref={loaderRef} />
            {
                userRole === 'admin'
                &&
                <Employee />
            }

            {
                userRole === 'vessel_owner'
                &&
                <VesselOwner />
            }

        </>
    );
};

export default Dashboard;
