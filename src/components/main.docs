// src/components/context/AuthContext.js
import { createContext, useContext, useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';

const AuthContext = createContext();

export const AuthProvider = ({ children }) => {
  const [user, setUser] = useState(null);
  const navigate = useNavigate();

  // Check if user is authenticated on initial load
  useEffect(() => {
    const storedUser = localStorage.getItem('user');
    if (storedUser) {
      setUser(JSON.parse(storedUser));
    }
  }, []);

  const login = (userData) => {
    setUser(userData);
    localStorage.setItem('user', JSON.stringify(userData));
    navigate('/dashboard');
  };

  const logout = () => {
    setUser(null);
    localStorage.removeItem('user');
    navigate('/login');
  };

  return (
    <AuthContext.Provider value={{ user, login, logout }}>
      {children}
    </AuthContext.Provider>
  );
};

export const useAuth = () => useContext(AuthContext);



// src/App.js
import { BrowserRouter } from "react-router-dom";
import "bootstrap/dist/css/bootstrap.min.css";
import "bootstrap/dist/js/bootstrap.bundle.min";
import PublicRoutes from "./routes/PublicRoutes";
import PrivateRoutes from "./routes/PrivateRoutes";
import { ToastContainer } from "react-toastify";
import { ApplicationContextProvider } from "./components/context/ApplicationContext";
import { AuthProvider } from "./components/context/AuthContext"; // Import AuthProvider

function App() {
  return (
    <BrowserRouter>
      <AuthProvider> {/* Wrap with AuthProvider */}
        <ApplicationContextProvider>
          <ToastContainer autoClose={2000} style={{ color: "black" }} />
          <PublicRoutes />
          <PrivateRoutes />
        </ApplicationContextProvider>
      </AuthProvider>
    </BrowserRouter>
  );
}

export default App;


// src/routes/PrivateRoutes.js
import { Routes, Route, Navigate, Outlet } from "react-router-dom";
import PrivateLayout from "../components/layouts/PrivateLayout";
import ClaimSubmissionSuccess from "../components/private/CliamSubmissionSuccess";
import AboutUs from "../components/private/AboutUs";
import CreateClaimPartA from "../components/private/ClaimDetails/CreateClaimPartA";
import CreateClaimPartB from "../components/private/ClaimDetails/CreateClaimPartB";
import CreateClaimPartC from "../components/private/ClaimDetails/CreateClaimPartC";
import ClaimForm from "../components/private/stepperForm/MainForm";
import MyProfile from "../components/private/MyProfile";
import ChangePassword from "../components/private/ChangePassword";
import Dashboard from "../components/private/Dashboard";
import DraftsPage from "../components/private/stepperForm/Drafts";
import { useAuth } from "../components/context/AuthContext";

const PrivateRoute = () => {
  const { user } = useAuth();
  
  return user ? (
    <PrivateLayout>
      <Outlet />
    </PrivateLayout>
  ) : (
    <Navigate to="/login" replace />
  );
};

const PrivateRoutes = () => {
  return (
    <Routes>
      <Route element={<PrivateRoute />}>
        <Route path="/dashboard" element={<Dashboard />} />
        <Route path="/claim-success" element={<ClaimSubmissionSuccess />} />
        <Route path="/create-claim/creditor" element={<CreateClaimPartA />} />
        <Route path="/create-claim/financial" element={<CreateClaimPartB />} />
        <Route path="/create-claim/homebuyer" element={<CreateClaimPartC />} />
        <Route path="/apply-claim" element={<ClaimForm />} /> 
        <Route path="/apply-claim/:id" element={<ClaimForm />} /> 
        <Route path="/about" element={<AboutUs />} />
        <Route path="/my-profile" element={<MyProfile />} />
        <Route path="/change-password" element={<ChangePassword />} />
        <Route path="/drafts" element={<DraftsPage />} />
      </Route>
    </Routes>
  );
};

export default PrivateRoutes;


// src/routes/PublicRoutes.js
import { Routes, Route, Navigate, Outlet } from "react-router-dom";
import PublicLayout from "../components/layouts/PublicLayout";
import Login from "../components/public/Login";
import Register from "../components/public/Register";
import CorporateDebtorRegister from "../components/public/CorporateRegister";
import { useAuth } from "../components/context/AuthContext";

const PublicRoute = () => {
  const { user } = useAuth();
  
  return !user ? (
    <PublicLayout>
      <Outlet />
    </PublicLayout>
  ) : (
    <Navigate to="/dashboard" replace />
  );
};

const PublicRoutes = () => {
  return (
    <Routes>
      <Route element={<PublicRoute />}>
        <Route path="/login" element={<Login />} />
        <Route path="/register/claimants" element={<Register />} />
        <Route path="/register/corporate-debtor" element={<CorporateDebtorRegister />} />
      </Route>
      <Route path="/" element={<Navigate to="/login" replace />} />
    </Routes>
  );
};

export default PublicRoutes;
