{showCMNFields && (
  <>
    <Col xs={12} lg={6}>
      {renderFileField(
        "newCMN",
        t("New CMN Upload"),
        true
      )}
    </Col>
    <Col xs={12} lg={6}>
      {renderFileField(
        "oldCMN",
        t("Old CMN Upload"),
        true
      )}
    </Col>
  </>
)}
<Col xs={12} lg={6}>
  {renderFileField("paymentChallan", t("Payment Challan/Acknowledgement"))}
</Col>
const extractAllEnclosures = (formValues) => {
  const enclosures = [];
  
  const singleFileTypes = [
    { field: "certificateOfRegistration", type: "REGISTRATION_CERTIFICATE", name: "Certificate of Registration" },
    { field: "NOCfromOriginalRegistrationAuthority", type: "NOC_FROM_ORIGINAL_REGISTRATION_AUTHORITY", name: "NOC from Original Registration Authority" },
    { field: "lastSurveyCertificate", type: "SURVEY_COPY_OF_LAST_CERTIFICATE_OF_SURVEY", name: "Last Survey Certificate" },
    { field: "tonnageBooklet", type: "TONNAGE_BOOKLETS", name: "Tonnage Booklet" },
    { field: "stabilityBooklet", type: "STABILITY_BOOKLETS", name: "Stability Booklet" },
    { field: "insuranceCertificate", type: "INSURANCE_CERTIFICATE", name: "Insurance Certificate" },
    { field: "paymentChallan", type: "PAYMENT_CHALLAN_OR_ACKNOWLEDGEMENT", name: "Payment Challan" },
    { field: "newCMN", type: "CARVING_MARKING_NOTE", name: "New CMN" },
    { field: "oldCMN", type: "OLD_CARVING_MARKING_NOTE", name: "Old CMN" }
  ];

  // ... rest of existing code
};
