const SurveyTrackerCard = ({ events, color = "#6f42c1" }) => {
  const today = new Date();
  
  const renderDayContents = (day, date) => {
    const dayEvents = events.filter(event => 
      isSameDay(parseISO(event.start), date)
    );
    const isCurrentDay = isToday(date);
    
    return (
      <div className={`day-container ${isCurrentDay ? 'today' : ''}`}>
        <div className="day-number">{format(date, 'd')}</div>
        {dayEvents.length > 0 && (
          <div className="event-indicators">
            {dayEvents.map((event, i) => (
              <div 
                key={i} 
                className="event-indicator" 
                style={{ 
                  backgroundColor: event.color || color,
                  width: '6px',
                  height: '6px'
                }}
                title={event.title}
              />
            ))}
          </div>
        )}
      </div>
    );
  };

  // Filter events for the current month
  const currentMonthEvents = events.filter(event => {
    const eventDate = parseISO(event.start);
    return eventDate.getMonth() === today.getMonth() && 
           eventDate.getFullYear() === today.getFullYear();
  });

  return (
    <div className="status-card survey-tracker-card" style={{ borderLeft: `4px solid ${color}` }}>
      <div className="status-card-content">
        <div className="card-header-wrapper">
          <div className="icon-wrapper" style={{ backgroundColor: `${color}20`, color }}>
            <BsCalendarEvent size={24} />
          </div>
          <div className="card-header-text">
            <div className="value">{currentMonthEvents.length}</div>
            <div className="title">Survey Tracker</div>
            <div className="subtitle">Upcoming surveys</div>
          </div>
        </div>
        <div className="calendar-wrapper">
          <DatePicker
            inline
            selected={today}
            renderDayContents={renderDayContents}
            calendarClassName="survey-calendar"
          />
        </div>
        <div className="event-legend">
          {Array.from(new Set(events.map(e => e.type))).map(type => {
            const event = events.find(e => e.type === type);
            return (
              <div key={type} className="legend-item">
                <span 
                  className="legend-color" 
                  style={{ backgroundColor: event.color }}
                />
                <span className="legend-text">{type}</span>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
};
