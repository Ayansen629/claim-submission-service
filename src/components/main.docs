@media (max-width: 715px) {
  .headerRow>div {
    width: 100% !important;
    margin-bottom: 2rem;
  }

  .headerRow>div:last-child {
    margin-bottom: 0;
  }
}

.customDropdownItem {
  background-color: white !important;
  color: black !important;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.customDropdownItem:hover,
.customDropdownItem:focus {
  background-color: rgb(15, 85, 178) !important;
  color: white !important;
  /* force text color */
}

/* Default state */
:global(.dropdown-menu .dropdown-item.customDropdownItem) {
  background-color: white !important;
  color: black !important;
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* Hover / focus */
:global(.dropdown-menu .dropdown-item.customDropdownItem:hover),
:global(.dropdown-menu .dropdown-item.customDropdownItem:focus) {
  background-color: rgb(15, 85, 178) !important;
  color: white !important;
}

.topNavWrapper {
  width: 100%;
  left: -23rem;
  position: absolute;
}

.advertiseLeftCol {
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.advertiseRightCol {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.advLeftColImg {
  max-height: 18rem;
  object-fit: cover;
  opacity: 0.2;
  mix-blend-mode: screen;
  position: absolute;
  left: 0;
  transform: rotate(582deg);
}

.advRightColImg {
  max-height: 24rem;
  object-fit: cover;
  opacity: 0.2;
  mix-blend-mode: screen;
  position: absolute;
  right: 0;
  transform: rotate(-4deg);

}

.advTitle {
