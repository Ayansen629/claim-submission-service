import React, { useState } from "react";
import { Button, Modal, Form } from "react-bootstrap";
import InputFile from "./InputFile";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

const PaymentModal = ({
  show,
  onHide,
  paymentMode,
  setPaymentMode,
  challanFile,
  onChallanUpload,
  onOnlinePay,
  onOfflineSubmit,
  isLoading,
  formMethods, 
  supervisionAuthority, 
}) => {
  const [submitting, setSubmitting] = useState(false);
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  const handleOfflineSubmit = (e) => {
    e.preventDefault();
    if (!challanFile) return;
    
    setSubmitting(true);
    
    setTimeout(() => {
      setSubmitting(false);
      onOfflineSubmit();
    }, 800);
  };

  return (
    <Modal show={show} onHide={onHide} centered>
      <Modal.Header closeButton>
        <Modal.Title>{t("Payment Option")}</Modal.Title>
      </Modal.Header>
      <Modal.Body>
        <Form onSubmit={handleOfflineSubmit}>
          <Form.Group>
            <Form.Label className="fw-semibold mb-2">
              {t("Select Payment Mode")}
            </Form.Label>
            <div className="d-flex gap-3 mb-3">
              <Form.Check
                type="radio"
                id="offline"
                label={t("Offline")}
                checked={paymentMode === "offline"}
                onChange={() => setPaymentMode("offline")}
                name="paymentMode"
              />
              <Form.Check
                type="radio"
                id="online"
                label={t("Online")}
                checked={paymentMode === "online"}
                onChange={() => setPaymentMode("online")}
                name="paymentMode"
              />
            </div>
          </Form.Group>
          {paymentMode === "offline" && (
            <div className="mb-3">
              <InputFile
                label={t("Upload Challan")}
                name="challan"
                required
                value={challanFile}
                onChange={onChallanUpload}
                errors={{}}
              />
            </div>
          )}
          <div className="d-flex justify-content-end gap-2 mt-4">
            <Button
              variant="secondary"
              onClick={onHide}
              style={{
                minWidth: 100,
                fontWeight: 500,
                borderRadius: 6,
                fontSize: "1rem",
              }}
              disabled={isLoading}
            >
             {t("Close")}
            </Button>
            {paymentMode === "offline" ? (
              <Button
                type="submit"
                variant="primary"
                disabled={submitting || isLoading || !challanFile}
                style={{
                  minWidth: 120,
                  fontWeight: 600,
                  borderRadius: 6,
                  fontSize: "1rem",
                }}
              >
                {submitting ? t("Submitting...") : t("Submit")}
              </Button>
            ) : (
              <Button
                variant="success"
                onClick={onOnlinePay}
                disabled={isLoading}
                style={{
                  minWidth: 160,
                  fontWeight: 600,
                  borderRadius: 6,
                  fontSize: "1rem",
                }}
              >
                {t("Proceed to Payment Gateway")}
              </Button>
            )}
          </div>
        </Form>
      </Modal.Body>
    </Modal>
  );
};

export default PaymentModal;
