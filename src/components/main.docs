import { EyeFill, PencilSquare } from 'react-bootstrap-icons';

// ... other imports remain the same

{/* Search Section Modified */}
<div className={`row px-1 ${style.application_search} ${props?.hideSearchBar ? "justify-content-end mb-1" : "justify-content-between"}`}>
  <div className="col-sm-6 my-1 fw-bold" style={{ width: "fit-content" }}>
    {props?.tableHeader ? props?.tableHeader : ""}
  </div>
  
  <div className="d-flex justify-content-end align-items-center" style={{ flex: 1, gap: '1rem' }}>
    {window.location.pathname.includes('/dashboard') && !window.location.pathname.includes('/employee') && (
      <DateRangePickerComponent onFilterDate={handleDateFilter}/>
    )}

    {!props.hideSearchBar && (
      <div className="my-1" style={{ marginLeft: 'auto' }}>
        <input
          type="search"
          onChange={handleOnSearch}
          placeholder="Search"
          className={`p-2 ${style.searchInput}`}
          style={{ width: '240px' }}
        />
      </div>
    )}

    {props.rowData?.length > 0 && !props.hideExportBtn && (
      <div className="my-1">
        <GenericExportDropdown
          columns={props.columns}
          rowData={props.rowData}
        />
      </div>
    )}
  </div>
</div>

// ... rest of the code

{/* Modified Action Buttons */}
<td
  key={colIndex}
  className={`px-3 py-2 ${style.actionTable_table_data}`}
  style={{ background: "#ffffff" }}
>
  <div className="d-flex" style={{ gap: "12px", justifyContent: "center" }}>
    {o.actions.includes("edit") && (
      <Tooltip title="Edit this item" placement="top" arrow>
        <button
          onClick={() => handleEdit(row)}
          type="button"
          className="btn btn-primary"
          style={{ padding: '6px 12px' }}
        >
          <PencilSquare color="white" size={18} />
        </button>
      </Tooltip>
    )}
    {o.actions.includes("view") && (
      <Tooltip title="View details" placement="top" arrow>
        <button 
          onClick={() => handleView(row)} 
          type="button" 
          className="btn btn-primary"
          style={{ padding: '6px 12px' }}
        >
          <EyeFill color="white" size={18} />
        </button>
      </Tooltip>
    )}
    {/* Other buttons remain similar */}
  </div>
</td>
