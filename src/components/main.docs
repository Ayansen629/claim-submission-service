.nav-btn {
  padding: 0.75rem 2rem;
  border-radius: 8px; /* Changed from 25px to normal rounded */
  font-weight: 600;
  font-size: 0.9rem;
  letter-spacing: 0.025em;
  transition: all 0.3s ease;
  border: 2px solid;
}

.next-btn {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  border-color: #3b82f6;
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  border-radius: 8px; /* Normal rounded shape */
}

.action-dropdown {
  padding: 0.75rem 2rem;
  border-radius: 8px; /* Normal rounded shape */
  font-weight: 600;
}

/* File download button - only icon */
.file-download-btn {
  color: #059669 !important;
  padding: 0.25rem 0.5rem !important;
  border-radius: 6px;
  transition: all 0.2s ease;
  text-decoration: none !important;
  min-width: auto;
}
