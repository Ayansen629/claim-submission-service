const [provisionalCertData, setProvisionalCertData] = useState("");
const [generatedCertificates, setGeneratedCertificates] = useState({
  survey: false,
  registration: false
});

const handleGenerateProvisionalCertificate = async (formData) => {
  console.log("Certificate Type - ", modalType);
  console.log("Form Data - ", formData);

  const isRegistration = modalType === "registration";
  const URL = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.CERT.CREATE;

  const request = {
    certificateType: isRegistration ? "PROV_REGISTRATION_CERTIFICATE" : "PROV_SURVEY_CERTIFICATE",
  };

  if (isRegistration) {
    request.registrationCertificateDetails = {
      certificateExpiryDate: formData?.expiryDate || "",
      applicationNumber: registrationData?.vessel?.applicationNumber || "",
      applicationId: registrationData?.applicationId || "",
      registrationDate: formData?.registrationDate || "",
      vesselName: provisionalCertData?.vesselName || "",
      portOfRegistry: provisionalCertData?.portOfRegistry || "",
      previousRegistrationNumber: formData?.previousRegistrationNo || "",
      dateOfPreviousRegisty: formData?.dateOfPreviousRegistry || "",
      portOfPreviousRegistry: formData?.portOfPreviousRegistry || "",
      nameOfBuilder: provisionalCertData?.nameOfBuilder || "",
      addressOfBuilder: provisionalCertData?.addressOfBuilder || "",
      placeOfBuilt: provisionalCertData?.placeOfBuilt || "",
      propulsionType: provisionalCertData?.propulsionType || "",
      numberOfDeck: provisionalCertData?.numberOfDeck || 0,
      materialDescription: provisionalCertData?.materialDescription || "",
      numberOfBulkHeads: provisionalCertData?.numberOfBulkHeads || 0,
      strengthOfDeck: provisionalCertData?.strengthOfDeck || "",
      build: formData?.build || "",
      length: provisionalCertData?.length || "0",
      breadth: provisionalCertData?.breadth || "0",
      depth: provisionalCertData?.depth || "0",
      draft: provisionalCertData?.draft || "0",
      lengthOfEngineRoom: parseFloat(formData?.lengthEngineRoom) || 0,
      grossTonnage: provisionalCertData?.grossTonnage || 0,
      netTonnage: provisionalCertData?.netTonnage || 0,
      numberOfCrew: provisionalCertData?.numberOfCrew || 0,
      numberOfEngines: provisionalCertData?.numberOfEngines || 0,
      combinedPower: provisionalCertData?.combinedPower || 0,
      nameOfEngineMaker: provisionalCertData?.nameOfEngineMaker || "",
      addressOfEngineMaker: provisionalCertData?.addressOfEngineMaker || "",
      summaryDescriptionOfTonnage: formData?.summaryDescriptionOfTonnage || "",
      state: provisionalCertData?.state || "",
      nameOfMaster: provisionalCertData?.nameOfMaster || "",
      cocNumber: provisionalCertData?.cocNumber || "",
      ownerName: provisionalCertData?.ownerName || "",
      addressOfOwner: provisionalCertData?.addressOfOwner || "",
      officialNumber: provisionalCertData?.officialNumber || "",
      numberOfTenthShares: formData?.numberOfTenthShares || "",
    };
  } else {
    request.surveyProvisionalCertificate = {
      surveyId: intialSurveyData?.surveyId || "",
      surveyNumber: intialSurveyData?.surveyNumber || "",
      category: provisionalCertData?.category || "",
      expiryDay: formData?.expiryDay || "",
      expiryMonth: formData?.expiryMonth || "",
      expiryYear: formData?.expiryYear || "",
      certificateNo: formData?.certificateNo || "",
      zoneOfOperation: provisionalCertData?.zoneOfOperation || "",
      dateOfIssue: provisionalCertData?.dateOfIssue || "",
      dateOfExpiry: provisionalCertData?.dateOfExpiry || "",
      vesselName: provisionalCertData?.vesselName || "",
      officialNo: provisionalCertData?.officialNo || "",
      portOfRegistry: provisionalCertData?.portOfRegistry || "",
      certificateOfRegistryNo: provisionalCertData?.certificateOfRegistryNo || "",
      grossTonnage: provisionalCertData?.grossTonnage || "",
      registeredTonnage: provisionalCertData?.registeredTonnage || "",
      freeboardAssigned: provisionalCertData?.freeboardAssigned || "",
      loadingMarksOnSide: formData?.loadingMarksOnSide || "N/A",
      masterName: provisionalCertData?.masterName || "",
      masterCocGrade: provisionalCertData?.masterCocGrade || "",
      masterCocNo: provisionalCertData?.masterCocNo || "",
      masterPlaceOfIssue: provisionalCertData?.masterPlaceOfIssue || "",
      engineerName: provisionalCertData?.engineerName || "",
      engineerCocGrade: provisionalCertData?.engineerCocGrade || "",
      engineerCocNo: provisionalCertData?.engineerCocNo || "",
      engineerPlaceOfIssue: provisionalCertData?.engineerPlaceOfIssue || "",
      ownerName: provisionalCertData?.ownerName || "",
      ownerAddress: provisionalCertData?.ownerAddress || "",
      dateOfSurveyCarriedOut: provisionalCertData?.dateOfSurveyCarriedOut || "",
      placeOfSurveyCarriedOut: provisionalCertData?.placeOfSurveyCarriedOut || "",
      plyingLimits: formData?.plyingLimits || "",
      notExtendingBeyondNauticalMiles: formData?.notExtendingBeyondNauticalMiles || "",
      cargoCapacity: provisionalCertData?.cargoCapacity || "",
      passengerCapacity: provisionalCertData?.passengerCapacity || "",
      crewCapacity: provisionalCertData?.crewCapacity || "",
      noOfBoats: formData?.safetyEquipment?.noOfBoats || provisionalCertData?.noOfBoats || "",
      noOfBuoyantApparatus: formData?.safetyEquipment?.noOfBuoyantApparatus || provisionalCertData?.noOfBuoyantApparatus || "",
      noOfLifebuoys: formData?.safetyEquipment?.noOfLifebuoys || provisionalCertData?.noOfLifebuoys || "",
      noOfLifejackets: formData?.safetyEquipment?.noOfLifejackets || provisionalCertData?.noOfLifejackets || "",
      fireExtinguishersFoamType: formData?.safetyEquipment?.fireExtinguishersFoamType || provisionalCertData?.fireExtinguishersFoamType || "",
      fireExtinguishersSodaAcid: formData?.safetyEquipment?.fireExtinguishersSodaAcid || provisionalCertData?.fireExtinguishersSodaAcid || "",
      fireExtinguishersDryCarbonPowder: formData?.safetyEquipment?.fireExtinguishersDryCarbonPowder || provisionalCertData?.fireExtinguishersDryCarbonPowder || "",
      noOfAnchorsWithWeight: formData?.safetyEquipment?.noOfAnchorsWithWeight || provisionalCertData?.noOfAnchorsWithWeight || "",
      anchorCable: formData?.safetyEquipment?.anchorCable || provisionalCertData?.anchorCable || "",
      hose: formData?.safetyEquipment?.hose || provisionalCertData?.hose || "",
      iwtBasicDetailsAppNo: registrationData?.vessel?.applicationNumber || "",
    };
  }

  try {
    loaderRef?.current?.show();
    const response = await postData(URL, request);
    const { status, data } = response || {};
    
    if ([200, 201, "200"].includes(status)) {
      toast.success(
        data?.responseStatus?.message || "Provisional certificate generated successfully",
        { position: "top-right" }
      );
      
      // Mark certificate as generated
      setGeneratedCertificates(prev => ({
        ...prev,
        [modalType]: true
      }));
      
      return Promise.resolve();
    } else {
      toast.error(
        data?.responseStatus?.message || "Failed to generate certificate",
        { position: "top-right" }
      );
      return Promise.reject(new Error("Generation failed"));
    }
  } catch (err) {
    console.error("Certificate Generation Error:", err);
    handleErrorMessage(err?.response?.data || "Failed to generate certificate");
    return Promise.reject(err);
  } finally {
    loaderRef?.current?.hide();
  }
};

// Updated action dropdown with conditional button rendering
const actionDropdown =
  isViewMode && isOfficerLogin && actionsFromAPI?.length > 0 ? (
    <div
      style={{
        display: "flex",
        gap: "6px",
        alignItems: "center",
        flexWrap: "wrap",
      }}
    >
      <Button
        variant="contained"
        onClick={() =>
          handleFormSubmit({
            index: 1,
            getFormData: () => methods?.getValues(),
          })
        }
        style={{
          backgroundColor: "#2E57A7",
          fontWeight: "600",
          borderRadius: "6px",
          fontSize: "0.75rem",
          color: "#fff",
          padding: "6px 16px",
          minHeight: "28px",
          minWidth: "4rem",
          textTransform: "none",
          boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
          transition: "all 0.2s ease",
        }}
      >
        Save
      </Button>

      {/* Provisional Certificate Buttons - Only show if not generated */}
      {userRole === USER_ROLES?.OFFICER_L3 && showOfficerActions && (
        <>
          {!generatedCertificates.survey && (
            <Button
              variant="contained"
              onClick={() => handleProvisionModalOpen("survey")}
              style={{
                background: "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                color: "#fff",
                fontWeight: "500",
                borderRadius: "4px",
                fontSize: "0.65rem",
                padding: "4px 8px",
                minHeight: "24px",
                minWidth: "3rem",
                textTransform: "none",
                border: "none",
                boxShadow: "0 1px 2px rgba(0,0,0,0.1)",
                transition: "all 0.2s ease",
              }}
            >
              Provisional Certificate of Survey
            </Button>
          )}
          
          {!generatedCertificates.registration && (
            <Button
              variant="contained"
              onClick={() => handleProvisionModalOpen("registration")}
              style={{
                background: "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                color: "#fff",
                fontWeight: "500",
                borderRadius: "4px",
                fontSize: "0.65rem",
                padding: "4px 8px",
                minHeight: "24px",
                minWidth: "3rem",
                textTransform: "none",
                border: "none",
                boxShadow: "0 1px 2px rgba(0,0,0,0.1)",
                transition: "all 0.2s ease",
              }}
            >
              Provisional Certificate of Registration
            </Button>
          )}
        </>
      )}

      <ActionDropdown
        actions={actionsFromAPI}
        onActionClick={handleWorkflowActionClick}
        variant="contained"
        sx={{
          backgroundColor: "#2E57A7",
          fontWeight: "600",
          borderRadius: "6px",
          fontSize: "0.75rem",
          color: "#fff",
          minHeight: "28px",
          minWidth: "4rem",
          textTransform: "none",
          boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
        }}
      />
    </div>
  ) : null;
