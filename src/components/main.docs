import React from "react";
import {
  Container,
  Row,
  Col,
  Card,
  Button,
  Navbar,
  Nav,
} from "react-bootstrap";
import { NavDropdown } from "react-bootstrap";
import Banner from "../../assets/images/Banner.png";
import Ship from "../../assets/images/ship.png";
import Tower from "../../assets/images/tower.jpg";
import Map from "../../assets/images/map.png";
import vector from "../../assets/images/Vector.png";
import transfer from "../../assets/images/transfer.png";
import Navigation from "../../assets/images/Navigation.png";
import Suitcase from "../../assets/images/suitcase.png";
import Profile from "../../assets/images/pic.png";
import Notebook from "../../assets/images/note.svg";
import tick from "../../assets/images/tick.png";
import iwtnote from "../../assets/images/iwtnote.svg";
import Shield from "../../assets/images/Shield.png";
import Arrow from "../../assets/images/arrow.png";
import LastIcon from "../../assets/images/lasticon.png";
import Linkedin from "../../assets/images/Linkedin.png";
import Instagram from "../../assets/images/Instagram.png";
import HeaderLogo from "../../assets/images/bengal-logo.png";
import Login from "../../assets/images/iwtlogin.png";

const IWTHomePage = () => {
  // ... (keep all your existing data arrays same)

  return (
    <div className="iwt-homepage">
      {/* Main Header */}
      <div className="hero-banner" style={{ backgroundImage: `url(${Banner})` }}>
        <Navbar expand="lg" variant="dark" className="transparent-navbar">
          <Container fluid className="px-4">
            <Navbar.Brand href="#home" className="d-flex align-items-center">
              <img
                src={HeaderLogo}
                alt="Logo"
                className="navbar-logo"
                style={{ width: "60px", height: "60px" }}
              />
              <span className="ms-3 d-block" style={{ fontSize: "1.2rem", lineHeight: "1.2" }}>
                Inland Water Transport
                <br />
                <small className="text-muted" style={{ fontSize: "0.9rem" }}>Government of West Bengal</small>
              </span>
            </Navbar.Brand>

            {/* Keep navbar items same */}

          </Container>
        </Navbar>
      </div>

      {/* Vessel Registration Section */}
      <section className="vessel-registration py-5 bg-light">
        <Container fluid="xxl">
          <div className="section-header d-flex align-items-center mb-5">
            <img
              src={HeaderLogo}
              alt="Logo"
              style={{ width: "60px", height: "60px", marginRight: "20px" }}
            />
            <div>
              <h2 className="section-title mb-0">Vessel Registration</h2>
              <p className="section-subtitle mb-0 mt-1">Government of West Bengal</p>
            </div>
          </div>
          <Row className="align-items-stretch g-4">
            {/* Keep registration content same */}
          </Row>
        </Container>
      </section>

      {/* Vessel Survey Section */}
      <section className="vessel-survey py-5">
        <Container fluid="xxl">
          <div className="section-header d-flex align-items-center mb-5">
            <img
              src={HeaderLogo}
              alt="Logo"
              style={{ width: "60px", height: "60px", marginRight: "20px" }}
            />
            <div>
              <h2 className="section-title mb-0">Vessel Survey</h2>
              <p className="section-subtitle mb-0 mt-1">Government of West Bengal</p>
            </div>
          </div>
          <Row className="align-items-stretch g-4">
            {/* Keep survey content same */}
          </Row>
        </Container>
      </section>

      {/* Social Feed Section */}
      <section className="social-news py-5 bg-light">
        <Container>
          <Row className="gx-5"> {/* Increased gutter */}
            <Col lg={8} className="mb-5 mb-lg-0">
              <Card className="social-card h-100 shadow-sm">
                <Card.Body className="p-4">
                  <Row className="gx-5 h-100"> {/* Added gutter */}
                    <Col md={6} className="pe-4 border-end">
                      <div className="h-100">
                        {/* LinkedIn Content */}
                      </div>
                    </Col>
                    <Col md={6} className="ps-4">
                      <div className="h-100">
                        {/* Instagram Content */}
                      </div>
                    </Col>
                  </Row>
                </Card.Body>
              </Card>
            </Col>
            {/* Keep news section same */}
          </Row>
        </Container>
      </section>

      {/* Keep other sections same */}

      <style jsx>{`
        /* Header Alignment */
        .section-header {
          padding: 2rem 0;
          border-bottom: 2px solid #00429C;
        }
        
        .section-title {
          font-size: 2rem;
          color: #00429C;
          font-weight: 700;
        }
        
        .section-subtitle {
          font-size: 1rem;
          color: #666;
        }

        /* Social Feed Spacing */
        .social-card .border-end {
          border-right: 2px solid #dee2e6 !important;
        }
        
        .social-card .pe-4 {
          padding-right: 2rem !important;
        }
        
        .social-card .ps-4 {
          padding-left: 2rem !important;
        }

        @media (max-width: 768px) {
          .section-header {
            flex-direction: column;
            text-align: center;
          }
          
          .section-header img {
            margin-right: 0;
            margin-bottom: 1rem;
          }
          
          .social-card .border-end {
            border-right: none !important;
            border-bottom: 2px solid #dee2e6;
            padding-bottom: 2rem;
            margin-bottom: 2rem;
          }
          
          .social-card .pe-4,
          .social-card .ps-4 {
            padding: 0 !important;
          }
        }

        /* Keep other existing styles */
      `}</style>
    </div>
  );
};

export default IWTHomePage;
