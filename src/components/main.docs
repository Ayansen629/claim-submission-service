{/* Desktop Logo and Login */}
<div className="d-none d-md-block">
  <img
    src={BengalLogo}
    alt="Logo"
    style={{ width: "4.25rem", height: "5rem", position: "absolute", top: "-17px", right: "0" }}
  />
  <Button
    variant="light"
    className={`${styles.homeLoginBtn}`}
    onClick={() => navigate("/login")}
  >
    {t("home2.Login")}
  </Button>
</div>

{/* Mobile Logo and Login */}
<div className="d-block d-md-none text-center mt-2">
  <img
    src={BengalLogo}
    alt="Logo"
    style={{ width: "3rem", height: "3.5rem" }}
  />
</div>
