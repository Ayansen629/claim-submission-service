import React from "react";
import {
  Container,
  Row,
  Col,
  Card,
  Button,
  Navbar,
  Nav,
} from "react-bootstrap";
import { NavDropdown } from "react-bootstrap";
import Banner from "../../assets/images/Banner.png";
import Ship from "../../assets/images/ship.png";
import Tower from "../../assets/images/tower.jpg";
import Map from "../../assets/images/map.png";
import vector from "../../assets/images/Vector.png";
import transfer from "../../assets/images/transfer.png";
import Navigation from "../../assets/images/Navigation.png";
import Suitcase from "../../assets/images/suitcase.png";
import Profile from "../../assets/images/pic.png";
import Notebook from "../../assets/images/note.svg";
import tick from "../../assets/images/tick.png";
import iwtnote from "../../assets/images/iwtnote.svg";
import Shield from "../../assets/images/Shield.png";
import Arrow from "../../assets/images/arrow.png";
import LastIcon from "../../assets/images/lasticon.png";
import Linkedin from "../../assets/images/Linkedin.png";
import Instagram from "../../assets/images/Instagram.png";
import HeaderLogo from "../../assets/images/bengal-logo.png";
import Login from "../../assets/images/iwtlogin.png";
import "./IWTHomePage.css"; // Add a CSS file for custom styles

const IWTHomePage = () => {
  const quickActionCards = [
    {
      id: 1,
      title: "Offences & Penalties",
      icon: iwtnote,
      buttonText: "Proceed",
    },
    {
      id: 2,
      title: "Investigation",
      icon: Shield,
      buttonText: "Proceed",
    },
    {
      id: 3,
      title: "Crew/Citizen Information",
      icon: Shield,
      buttonText: "Proceed",
    },
    {
      id: 4,
      title: "Manning,Training & Certification",
      icon: LastIcon,
      buttonText: "Proceed",
    },
  ];

  return (
    <Container fluid className="p-0">
      {/* Banner Section */}
      <div
        className="banner-section"
        style={{
          backgroundImage: `url(${Banner})`,
          backgroundSize: "cover",
          backgroundPosition: "center",
          position: "relative",
          height: "80vh",
          minHeight: "500px",
        }}
      >
        {/* Navbar Section */}
        <Navbar
          expand="lg"
          bg="transparent"
          variant="dark"
          className="navbar-custom"
        >
          <Container>
            <Navbar.Brand href="#home" className="d-flex align-items-center">
              <img
                src={HeaderLogo}
                alt="Logo"
                className="header-logo"
              />
            </Navbar.Brand>

            <Navbar.Toggle aria-controls="basic-navbar-nav" />

            <Navbar.Collapse id="basic-navbar-nav">
              <Nav className="ms-auto nav-links">
                <Nav.Link href="#home">Home</Nav.Link>
                <NavDropdown title="Vessel Registration" id="vessel-registration-dropdown">
                  <NavDropdown.Item href="#new-registration">New Registration</NavDropdown.Item>
                  <NavDropdown.Item href="#renewal">Renewal</NavDropdown.Item>
                </NavDropdown>
                <NavDropdown title="Vessel Survey" id="vessel-survey-dropdown">
                  <NavDropdown.Item href="#survey-schedule">Survey Schedule</NavDropdown.Item>
                  <NavDropdown.Item href="#survey-reports">Survey Reports</NavDropdown.Item>
                </NavDropdown>
                <Nav.Link href="#finance">Finance Accounts</Nav.Link>
                <Nav.Link href="#grievance">Grievance Redressal</Nav.Link>
                <NavDropdown title="Quick Links" id="quick-links-dropdown">
                  <NavDropdown.Item href="#link1">Link 1</NavDropdown.Item>
                  <NavDropdown.Item href="#link2">Link 2</NavDropdown.Item>
                </NavDropdown>
                <Nav.Link href="/login" className="login-link">
                  <img src={Login} alt="Login" className="login-icon" />
                </Nav.Link>
              </Nav>
            </Navbar.Collapse>
          </Container>
        </Navbar>
        
        {/* Banner Content - Optional */}
        <div className="banner-content">
          <Container>
            <h1 className="banner-title">Inland Waterways Transport</h1>
            <p className="banner-subtitle">Efficient, Reliable, Sustainable</p>
          </Container>
        </div>
      </div>

      {/* Stats Section */}
      <Row className="stats-section">
        {[...Array(4)].map((_, index) => (
          <Col key={index} md={3} sm={6} className="stat-item">
            <div className="stat-content">
              <h2 className="stat-number">5000+</h2>
              <h5 className="stat-title">Total Registered Vessel</h5>
              <p className="stat-description">
                Lorem Ipsum Dol sit amet. Lorem Ipsum Dol sit amet.
              </p>
            </div>
          </Col>
        ))}
      </Row>

      {/* Vessel Registration Section */}
      <section className="section-container">
        <Container>
          <div className="section-header">
            <h2 className="section-title">Vessel Registration</h2>
            <p className="section-description">
              Lorem Ipsum is simply dummy text of the printing and typesetting
              industry. Lorem Ipsum has been the industry's standard dummy text ever
              since the 1500s.
            </p>
          </div>
          
          <Row className="align-items-stretch">
            <Col lg={6} md={12}>
              <div className="registration-grid">
                {/* First Row */}
                <Row className="g-3">
                  {[
                    { icon: vector, title: "New Vessel Registration" },
                    { icon: Suitcase, title: "New Vessel Registration" }
                  ].map((item, index) => (
                    <Col md={6} sm={12} key={index}>
                      <div className="registration-card">
                        <div className="registration-icon">
                          <img src={item.icon} alt={item.title} />
                        </div>
                        <div className="registration-content">
                          <h5 className="registration-title">{item.title}</h5>
                          <p className="registration-text">
                            Lorem Ipsum is simply dummy text of the printing and typesetting industry.
                          </p>
                          <div className="registration-action">
                            <img src={Navigation} alt="Navigate" />
                          </div>
                        </div>
                      </div>
                    </Col>
                  ))}
                </Row>
                
                {/* Second Row */}
                <Row className="g-3 mt-3">
                  {[
                    { icon: transfer, title: "Transfer of Registry" },
                    { icon: Profile, title: "Transfer of Registry" }
                  ].map((item, index) => (
                    <Col md={6} sm={12} key={index}>
                      <div className="registration-card">
                        <div className="registration-icon">
                          <img src={item.icon} alt={item.title} />
                        </div>
                        <div className="registration-content">
                          <h5 className="registration-title">{item.title}</h5>
                          <p className="registration-text">
                            Lorem Ipsum is simply dummy text of the printing and typesetting industry.
                          </p>
                          <div className="registration-action">
                            <img src={Navigation} alt="Navigate" />
                          </div>
                        </div>
                      </div>
                    </Col>
                  ))}
                </Row>
                
                {/* Third Row */}
                <Row className="g-3 mt-3">
                  {[
                    { icon: Notebook, title: "Cancellation of Registration" },
                    { icon: tick, title: "Cancellation of Registration" }
                  ].map((item, index) => (
                    <Col md={6} sm={12} key={index}>
                      <div className="registration-card">
                        <div className="registration-icon">
                          <img src={item.icon} alt={item.title} />
                        </div>
                        <div className="registration-content">
                          <h5 className="registration-title">{item.title}</h5>
                          <p className="registration-text">
                            Lorem Ipsum is simply dummy text of the printing and typesetting industry.
                          </p>
                          <div className="registration-action">
                            <img src={Navigation} alt="Navigate" />
                          </div>
                        </div>
                      </div>
                    </Col>
                  ))}
                </Row>
              </div>
            </Col>
            
            <Col lg={6} md={12} className="mt-4 mt-lg-0">
              <div className="image-container">
                <img src={Ship} alt="IWT Ship" className="feature-image" />
              </div>
            </Col>
          </Row>
        </Container>
      </section>

      {/* Vessel Survey Section */}
      <section className="section-container bg-light">
        <Container>
          <div className="section-header">
            <h2 className="section-title">Vessel Survey</h2>
            <p className="section-description">
              Lorem Ipsum is simply dummy text of the printing and typesetting
              industry. Lorem Ipsum has been the industry's standard dummy text ever
              since the 1500s.
            </p>
          </div>
          
          <Row className="align-items-stretch">
            <Col lg={6} md={12} className="mb-4 mb-lg-0">
              <div className="image-container">
                <img src={Tower} alt="Tower" className="feature-image" />
              </div>
            </Col>
            
            <Col lg={6} md={12}>
              <div className="survey-grid">
                {/* First Row */}
                <Row className="g-3">
                  {[
                    { icon: vector, title: "New Vessel Registration" },
                    { icon: Suitcase, title: "New Vessel Registration" }
                  ].map((item, index) => (
                    <Col md={6} sm={12} key={index}>
                      <div className="survey-card">
                        <div className="survey-icon">
                          <img src={item.icon} alt={item.title} />
                        </div>
                        <div className="survey-content">
                          <h5 className="survey-title">{item.title}</h5>
                          <p className="survey-text">
                            Lorem Ipsum is simply dummy text of the printing and typesetting industry.
                          </p>
                          <div className="survey-action">
                            <img src={Navigation} alt="Navigate" />
                          </div>
                        </div>
                      </div>
                    </Col>
                  ))}
                </Row>
                
                {/* Second Row */}
                <Row className="g-3 mt-3">
                  {[
                    { icon: transfer, title: "Transfer of Registry" },
                    { icon: Profile, title: "Transfer of Registry" }
                  ].map((item, index) => (
                    <Col md={6} sm={12} key={index}>
                      <div className="survey-card">
                        <div className="survey-icon">
                          <img src={item.icon} alt={item.title} />
                        </div>
                        <div className="survey-content">
                          <h5 className="survey-title">{item.title}</h5>
                          <p className="survey-text">
                            Lorem Ipsum is simply dummy text of the printing and typesetting industry.
                          </p>
                          <div className="survey-action">
                            <img src={Navigation} alt="Navigate" />
                          </div>
                        </div>
                      </div>
                    </Col>
                  ))}
                </Row>
                
                {/* Third Row */}
                <Row className="g-3 mt-3">
                  {[
                    { icon: Notebook, title: "Cancellation of Registration" },
                    { icon: tick, title: "Cancellation of Registration" }
                  ].map((item, index) => (
                    <Col md={6} sm={12} key={index}>
                      <div className="survey-card">
                        <div className="survey-icon">
                          <img src={item.icon} alt={item.title} />
                        </div>
                        <div className="survey-content">
                          <h5 className="survey-title">{item.title}</h5>
                          <p className="survey-text">
                            Lorem Ipsum is simply dummy text of the printing and typesetting industry.
                          </p>
                          <div className="survey-action">
                            <img src={Navigation} alt="Navigate" />
                          </div>
                        </div>
                      </div>
                    </Col>
                  ))}
                </Row>
              </div>
            </Col>
          </Row>
        </Container>
      </section>

      {/* Quick Action Section */}
      <section className="section-container">
        <Container>
          <div className="section-header">
            <h2 className="section-title">Quick Action</h2>
          </div>
          
          <Row className="g-4">
            {quickActionCards.map((card) => (
              <Col key={card.id} lg={3} md={6} sm={6}>
                <div className="quick-action-card">
                  <div className="quick-action-icon">
                    <img src={card.icon} alt={card.title} />
                  </div>
                  <h5 className="quick-action-title">{card.title}</h5>
                  <Button className="quick-action-button">{card.buttonText}</Button>
                </div>
              </Col>
            ))}
          </Row>
        </Container>
      </section>

      {/* Map Information Section */}
      <section className="section-container bg-light">
        <Container>
          <div className="section-header">
            <h2 className="section-title">Map Information</h2>
          </div>
          
          <div className="map-container">
            <img src={Map} alt="Map" className="map-image" />
          </div>
        </Container>
      </section>

      {/* Social Feed & What's New Section */}
      <section className="section-container">
        <Container>
          <Row className="g-4">
            {/* Social Feed Section */}
            <Col lg={8} md={12}>
              <div className="section-header text-start">
                <h2 className="section-title">Social Feed</h2>
              </div>
              
              <div className="social-feed-container">
                <Row>
                  <Col md={6} className="social-feed-column">
                    <div className="social-feed-header">
                      <div className="social-feed-platform">
                        <img src={Linkedin} alt="LinkedIn" className="social-icon" />
                        <span>LinkedIn</span>
                      </div>
                      <a href="#" className="see-all-link">See All</a>
                    </div>
                    <div className="social-feed-content">
                      {/* LinkedIn content would go here */}
                      <p>Follow us on LinkedIn for the latest updates</p>
                    </div>
                  </Col>
                  
                  <Col md={6} className="social-feed-column">
                    <div className="social-feed-header">
                      <div className="social-feed-platform">
                        <img src={Instagram} alt="Instagram" className="social-icon" />
                        <span>Instagram</span>
                      </div>
                      <a href="#" className="see-all-link">See All</a>
                    </div>
                    <div className="social-feed-content">
                      {/* Instagram content would go here */}
                      <p>Follow us on Instagram for visual updates</p>
                    </div>
                  </Col>
                </Row>
              </div>
            </Col>
            
            {/* What's New Section */}
            <Col lg={4} md={12}>
              <div className="section-header text-start">
                <h2 className="section-title">What's New</h2>
              </div>
              
              <div className="whats-new-container">
                {[1, 2, 3].map((item, index) => (
                  <div key={index} className="news-item">
                    <div className="news-content">
                      <p className="news-text">
                        Lorem Ipsum is simply dummy text of the printing and
                        typesetting industry. Lorem Ipsum has been the industry's standard dummy text.
                      </p>
                      <p className="news-date">April 06, 2025</p>
                    </div>
                    <div className="news-badge">New</div>
                    {index < 2 && <div className="news-divider"></div>}
                  </div>
                ))}
              </div>
            </Col>
          </Row>
        </Container>
      </section>

      {/* Footer */}
      <footer className="footer">
        <Container>
          <Row className="g-4">
            <Col md={4} sm={6} xs={12}>
              <div className="footer-links">
                <h6 className="footer-title">HR</h6>
                <h6 className="footer-title">Tools</h6>
                <h6 className="footer-title">Career & Learning</h6>
                <h6 className="footer-title">Resources</h6>
                <h6 className="footer-title">IT Helpdesk</h6>
              </div>
            </Col>
            
            <Col md={4} sm={6} xs={12}>
              <div className="footer-links">
                <h6 className="footer-title">FAQS</h6>
                <h6 className="footer-title">About Us</h6>
                <h6 className="footer-title">Terms of Use</h6>
                <h6 className="footer-title">Morth</h6>
                <h6 className="footer-title">CMVR 1989</h6>
              </div>
            </Col>
            
            <Col md={4} sm={12} xs={12}>
              <div className="footer-links">
                <h6 className="footer-title">Privacy Policy</h6>
                <h6 className="footer-title">Hyperlink Policy</h6>
                <h6 className="footer-title">Website Policy</h6>
                <h6 className="footer-title">Content Policy</h6>
                <h6 className="footer-title">Contingency Plan</h6>
              </div>
            </Col>
          </Row>
          
          <div className="footer-bottom">
            <p>© 2023 Inland Waterways Transport. All Rights Reserved.</p>
          </div>
        </Container>
      </footer>
    </Container>
  );
};

export default IWTHomePage;


///
/* IWTHomePage.css */

/* General Styles */
:root {
  --primary-color: #0d6efd;
  --secondary-color: #6c757d;
  --accent-color: #fd7e14;
  --light-color: #f8f9fa;
  --dark-color: #212529;
  --border-color: #dee2e6;
  --success-color: #198754;
  --danger-color: #dc3545;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  color: var(--dark-color);
}

/* Banner Section */
.banner-section {
  position: relative;
  display: flex;
  flex-direction: column;
}

.navbar-custom {
  padding: 1rem 0;
  background-color: rgba(0, 0, 0, 0.5);
  width: 100%;
}

.header-logo {
  width: 60px;
  height: 60px;
  margin-right: 10px;
}

.nav-links .nav-link {
  color: white !important;
  font-weight: 500;
  padding: 0.5rem 1rem;
  transition: all 0.3s ease;
}

.nav-links .nav-link:hover {
  color: var(--accent-color) !important;
}

.login-icon {
  width: 50px;
  height: 50px;
  object-fit: contain;
  transition: transform 0.3s ease;
}

.login-link:hover .login-icon {
  transform: scale(1.1);
}

.banner-content {
  flex-grow: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: white;
  padding: 2rem;
}

.banner-title {
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 1rem;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.banner-subtitle {
  font-size: 1.5rem;
  font-weight: 300;
  text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
}

/* Stats Section */
.stats-section {
  background-color: var(--primary-color);
  color: white;
  margin: 0;
  padding: 2rem 0;
}

.stat-item {
  padding: 1.5rem;
  text-align: center;
}

.stat-number {
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.stat-title {
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.stat-description {
  font-size: 0.9rem;
  opacity: 0.8;
}

/* Section Containers */
.section-container {
  padding: 4rem 0;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-title {
  font-size: 2rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: var(--dark-color);
}

.section-description {
  font-size: 1rem;
  color: var(--secondary-color);
  max-width: 800px;
  margin: 0 auto;
}

/* Registration & Survey Cards */
.registration-card,
.survey-card {
  display: flex;
  align-items: flex-start;
  padding: 1.5rem;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  transition: all 0.3s ease;
  height: 100%;
  background-color: white;
}

.registration-card:hover,
.survey-card:hover {
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
  transform: translateY(-5px);
}

.registration-icon,
.survey-icon {
  width: 50px;
  height: 50px;
  min-width: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 1rem;
  background-color: var(--light-color);
  border-radius: 8px;
  padding: 10px;
}

.registration-icon img,
.survey-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.registration-content,
.survey-content {
  flex-grow: 1;
}

.registration-title,
.survey-title {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.registration-text,
.survey-text {
  font-size: 0.9rem;
  color: var(--secondary-color);
  margin-bottom: 1rem;
}

.registration-action,
.survey-action {
  text-align: right;
}

.registration-action img,
.survey-action img {
  width: 24px;
  height: 24px;
  cursor: pointer;
  transition: transform 0.3s ease;
}

.registration-action img:hover,
.survey-action img:hover {
  transform: translateX(5px);
}

/* Feature Images */
.image-container {
  height: 100%;
  border-radius: 8px;
  overflow: hidden;
}

.feature-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 8px;
  transition: transform 0.5s ease;
}

.image-container:hover .feature-image {
  transform: scale(1.05);
}

/* Quick Action Cards */
.quick-action-card {
  background-color: white;
  border-radius: 10px;
  padding: 2rem 1.5rem;
  text-align: center;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  height: 100%;
}

.quick-action-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
}

.quick-action-icon {
  width: 60px;
  height: 60px;
  margin: 0 auto 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-action-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.quick-action-title {
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 1.5rem;
  min-height: 2.8rem;
}

.quick-action-button {
  background-color: var(--primary-color);
  border: none;
  border-radius: 50px;
  padding: 0.5rem 1.5rem;
  font-weight: 500;
  transition: all 0.3s ease;
}

.quick-action-button:hover {
  background-color: #0b5ed7;
  transform: scale(1.05);
}

/* Map Section */
.map-container {
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
}

.map-image {
  width: 100%;
  height: 400px;
  object-fit: cover;
  display: block;
}

/* Social Feed Section */
.social-feed-container {
  background-color: white;
  border-radius: 10px;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
  padding: 1.5rem;
  height: 100%;
}

.social-feed-column {
  padding: 1rem;
}

.social-feed-column:first-child {
  border-right: 1px solid var(--border-color);
}

.social-feed-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.social-feed-platform {
  display: flex;
  align-items: center;
}

.social-icon {
  width: 30px;
  height: 30px;
  margin-right: 0.5rem;
}

.see-all-link {
  color: var(--primary-color);
  text-decoration: none;
  font-weight: 500;
  transition: color 0.3s ease;
}

.see-all-link:hover {
  color: #0b5ed7;
  text-decoration: underline;
}

.social-feed-content {
  min-height: 150px;
}

/* What's New Section */
.whats-new-container {
  background-color: white;
  border-radius: 10px;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
  padding: 1.5rem;
  height: 100%;
}

.news-item {
  position: relative;
  padding: 1rem 0;
}

.news-content {
  padding-right: 70px;
}

.news-text {
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
}

.news-date {
  font-size: 0.8rem;
  color: var(--secondary-color);
  margin-bottom: 0;
}

.news-badge {
  position: absolute;
  top: 1rem;
  right: 0;
  background-color: var(--danger-color);
  color: white;
  border-radius: 50px;
  padding: 0.25rem 0.75rem;
  font-size: 0.8rem;
  font-weight: 500;
}

.news-divider {
  margin: 1rem 0;
  border-bottom: 1px solid var(--border-color);
}

/* Footer */
.footer {
  background-color: var(--primary-color);
  color: white;
  padding: 3rem 0 1.5rem;
}

.footer-links {
  margin-bottom: 1.5rem;
}

.footer-title {
  font-size: 1rem;
  font-weight: 500;
  margin-bottom: 1rem;
  cursor: pointer;
  transition: opacity 0.3s ease;
}

.footer-title:hover {
  opacity: 0.8;
}

.footer-bottom {
  text-align: center;
  padding-top: 2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  margin-top: 2rem;
  font-size: 0.9rem;
  opacity: 0.8;
}

/* Responsive Adjustments */
@media (max-width: 992px) {
  .banner-title {
    font-size: 2.5rem;
  }
  
  .social-feed-column:first-child {
    border-right: none;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 1rem;
    padding-bottom: 1rem;
  }
}

@media (max-width: 768px) {
  .banner-title {
    font-size: 2rem;
  }
  
  .banner-subtitle {
    font-size: 1.2rem;
  }
  
  .section-title {
    font-size: 1.75rem;
  }
  
  .stat-number {
    font-size: 2rem;
  }
  
  .stat-title {
    font-size: 1rem;
  }
  
  .registration-card,
  .survey-card {
    flex-direction: column;
  }
  
  .registration-icon,
  .survey-icon {
    margin-right: 0;
    margin-bottom: 1rem;
  }
  
  .registration-action,
  .survey-action {
    text-align: left;
    margin-top: 1rem;
  }
  
  .quick-action-card {
    padding: 1.5rem 1rem;
  }
  
  .quick-action-title {
    font-size: 1rem;
    min-height: auto;
  }
  
  .map-image {
    height: 300px;
  }
}

@media (max-width: 576px) {
  .banner-section {
    height: 60vh;
  }
  
  .banner-title {
    font-size: 1.75rem;
  }
  
  .banner-subtitle {
    font-size: 1rem;
  }
  
  .section-container {
    padding: 3rem 0;
  }
  
  .section-header {
    margin-bottom: 2rem;
  }
  
  .stat-item {
    padding: 1rem;
  }
  
  .stat-number {
    font-size: 1.75rem;
  }
  
  .map-image {
    height: 250px;
  }
  
  .footer {
    padding: 2rem 0 1rem;
  }
}
