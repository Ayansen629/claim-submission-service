const handleFormSubmit = async (stepInfo) => {
  window.scrollTo({ top: 0, behavior: "smooth" });

  // Step 0: Initial Survey Form
  if (stepInfo.index === 0) {
    const formValues = stepInfo?.getFormData?.() || {};
    const surveyPayload = buildSurveyPayload(formValues, registrationData);
    submitIntialSurveyData(surveyPayload, stepInfo);
  }

  // Step 1: Equipment Form
  if (stepInfo.index === 1) {
    const formValues = stepInfo?.getFormData?.() || {};
    const equipmentPayload = buildEquipmentPayload(formValues, intialSurveyData);
    if (isOfficerLogin && isViewMode) {
      await submitIntialSurveyData(equipmentPayload, null);
      return;
    }
    submitIntialSurveyData(equipmentPayload, stepInfo);
  }

  // ADD THIS: Step 2: Book of Registration
  if (stepInfo.index === 2) {
    const success = await handleSubmit(); 
    if (success) {
      stepperRef.current?.goToNextStep(); 
    }
  }

  // Step 3: Certificate of Registration  
  if (stepInfo.index === 3) {
    const formValues = stepInfo?.getFormData?.() || {};
    console.log("=== CERTIFICATE PAYLOAD ===", formValues);
    stepperRef.current?.goToNextStep();
  }
};
