import React, { useRef ,useState} from "react";
import { useNavigate, useParams } from "react-router-dom";
import { useForm, useFieldArray, Controller } from "react-hook-form";
import { Container, Row, Col, Card, Button } from "react-bootstrap";
import { toast } from "react-toastify";
import axios from "axios";
import {
  FaUser,
  FaMapMarkerAlt,
  FaBriefcase,
  FaFileUpload,
  FaGraduationCap,
  FaPlus,
  FaTrash,
  FaArrowLeft,
} from "react-icons/fa";
import InputText from "../../../common/InputText.tsx";
import { handleErrorMessage } from "../../../../utils/errorMessageHandler.js";
import InputSelect from "../../../common/InputSelect.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { CONSTANT_REGEX } from "../../../../utils/constants.ts";
import { useMasterData } from "../../../context/MasterDataContext.js";
import NewLoader from "../../../common/NewLoader.js";
import "./EmployeeRegistration.css";
import { getData, postFORMdata } from "../../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import AppToggleButton from "../../../common/AppToggleButton.js";

const EmployeeRegistration = () => {
  const navigate = useNavigate();
  const { id } = useParams();
  const isEditMode = !!id;
  const loaderRef = useRef();
  const { masterData } = useMasterData();

  const {
    register,
    handleSubmit,
    control,
    formState: { errors },
    setValue,
    watch,
    reset,
  } = useForm({
    mode: "onSubmit",
    defaultValues: {
      firstName: "",
      lastName: "",
      email: "",
      phoneNumber: "",
      gender: "",
      dateOfBirth: "",
      addressLine1: "",
      addressLine2: "",
      pin: "",
      district: "",
      stateUt: "",
      country: "India",
      appointmentDate: "",
      employeeType: "",
      designation: "",
      addressProof: "",
      identityProof: "",
      appointmentLetter: "",
      educationDetails: [{ qualification: "", stream: "", yearOfPassing: "" }],
      professionalDetails: [
        {
          appointmentDate: "",
          employeeType: "",
          employeeStatus: "",
          designation: "",
          department: "",
          section: "",
          roles: "",
        },
      ],
    },
  });
 const [addressProofFile, setAddressProofFile] = useState(null);
  const [identityProofFile, setIdentityProofFile] = useState(null);
  const [appointmentLetterFile, setAppointmentLetterFile] = useState(null);

 
  const { fields, append, remove } = useFieldArray({
    control,
    name: "educationDetails",
  });

  const {
    fields: professionalFields,
    append: appendProfessional,
    remove: removeProfessional,
  } = useFieldArray({
    control,
    name: "professionalDetails",
  });

  // const watchPin = watch("pin");
  // const watchAddressProof = watch("addressProof");
  // const watchIdentityProof = watch("identityProof");
  // const watchAppointmentLetter = watch("appointmentLetter");

  const fetchAddressDetails = async (pin) => {
    try {
      const URL =
        process.env.REACT_APP_PUBLIC_URL +
        URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE +
        pin;
      const response = await getData(URL);
      if (response?.status === 200 && response?.data?.length > 0) {
        setValue("district", response?.data[0]?.district);
        setValue("stateUt", response?.data[0]?.stateName);
        setValue("country", "India");
      } else {
        setValue("district", "");
        setValue("stateUt", "");
        setValue("country", "");
        toast.info("No data found for this PIN code");
      }
      loaderRef.current?.hide();
    } catch (error) {
      setValue("district", "");
      setValue("stateUt", "");
      setValue("country", "");
      loaderRef.current?.hide();
      toast.error("Error fetching address details");
    }
  };
   console.log("field errors", errors);
  const onSubmit = async (data) => {
 
    try {
      loaderRef.current?.show();

      const vesselUserDetails = {
        id: "",
        userType: "",
        userCategory: "",
        firstName: data.firstName,
        lastName: data.lastName,
        emailId: data.email,
        phoneNumber: data.phoneNumber,
        panNumber: data.panNumber || "",
        gstNumber: data.gstNumber || "",
        addressDetails: data.addressLine1 + (data.addressLine2 ? ", " + data.addressLine2 : ""),
        addressLine1: data.addressLine1,
        addressLine2: data.addressLine2,
        pin: data.pin,
        district: data.district,
        stateUt: data.stateUt,
        country: data.country,
        isActive: data?.isActive,
        keycloakId: "",
        dateOfBirth: data.dateOfBirth,
        gender: data.gender,
        authorizedPerson: null,
        companyRegistration: null,
        educationDetails: data?.educationDetails?.map((ed) => ({
          uuid: "",
          employeeUUID: "",
          qualification: ed.qualification,
          stream: ed.stream,
          yearOfPassing: ed.yearOfPassing,
          additionalEducationDetails: ed.additionalEducationDetails || "",
        })),
        professionalDetails: data?.professionalDetails?.map((pd) => ({
          uuid: "",
          employeeUUID: "",
          appointmentDate: pd.appointmentDate,
          employeeType: pd.employeeType,
          employeeStatus: pd.employeeStatus,
          designation: pd.designation,
          department: pd.department,
          section: pd.section,
          role: pd.roles,
        })),
        aadharNumber: data.aadharNumber || "",
        // password: "admin",
      };

      const formData = new FormData();
      formData.append("request", new Blob([JSON.stringify(vesselUserDetails)], { type: 'application/json' }));

      // if (watchAddressProof && watchAddressProof[0]) {
      //   formData.append("files", watchAddressProof[0]);
      // }
      // if (watchIdentityProof && watchIdentityProof[0]) {
      //   formData.append("files", watchIdentityProof[0]);
      // }
      // if (watchAppointmentLetter && watchAppointmentLetter[0]) {
      //   formData.append("files", watchAppointmentLetter[0]);
      // }
      if (addressProofFile) {
        formData.append("files", addressProofFile);
      }
      if (identityProofFile) {
        formData.append("files", identityProofFile);
      }
      if (appointmentLetterFile) {
        formData.append("files", appointmentLetterFile);
      }
      console.log("Submitting payload to API :", formData);
      await submitEmpDetails(formData);

    } catch (error) {
      loaderRef.current?.hide();
      toast.error(
        error?.response?.data?.message ||
        "Error submitting form. Please try again."
      );
    }
  };

  const submitEmpDetails = async (payload) => {
    try {
      const URL = process.env.REACT_APP_AUTH_URL + URLS_ENDPOINT.USER_SERVICE.CREATE_EMP;
      loaderRef.current?.show();
      const response = await postFORMdata(URL, payload);
      const apiRes = response?.data ? { ...response?.data } : null;
      if (apiRes?.responseStatus?.status === "200") {
        loaderRef?.current?.hide();
        toast.success(
          apiRes?.responseStatus?.message || "Employee registered successfully!",
          { position: "top-right" }
        );
        handleCancel();
      } else {
        loaderRef?.current?.hide();
        toast.info(
          apiRes?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const handleCancel = () => {
    navigate("/iwt/employee-management");
  };

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="p-4">
        <Card className="mb-4">
          <Card.Header
            className="bg-primary text-white d-flex align-items-center justify-content-center position-relative"
            style={{
    minHeight: 56,
    background: "linear-gradient(135deg, rgb(0, 119, 182), rgb(2, 62, 138))",
    border: "none",
  }}
          >
            {/* Back Button */}
            <Button
              variant="link"
              className="p-0 me-2"
              style={{
                color: "white",
                textDecoration: "none",
                position: "absolute",
                left: 0,
                top: "50%",
                transform: "translateY(-50%)",
              }}
              onClick={() => navigate("/iwt/employee-management")}
            >
              <FaArrowLeft size={22} />
            </Button>
            {/* Centered Title */}
            <div style={{ fontWeight: 600, fontSize: 22, color: "#fff" }}>
              {isEditMode ? "Edit Employee" : "Add Employee"}
            </div>
            {/* Empty right side for spacing */}
            <div style={{ width: 40 }}></div>
          </Card.Header>
          <Card.Body>
            <form onSubmit={handleSubmit(onSubmit)} className="employee-form">
              {/* Personal Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaUser className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>Personal Details</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="firstName"
                          label="First Name"
                          placeholder="Enter first name"
                          required={true}
                          register={{
                            ...register("firstName", {
                              required: "First Name is required",
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="lastName"
                          label="Last Name"
                          placeholder="Enter last name"
                          required={true}
                          register={{
                            ...register("lastName", {
                              required: "Last Name is required",
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="email"
                          label="Email ID"
                          type="email"
                          placeholder="Enter email address"
                          required={true}
                          register={{
                            ...register("email", {
                              required: "Email is required",
                              pattern: {
                                value: CONSTANT_REGEX.EMAIL,
                                message: "Invalid email address",
                              },
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="phoneNumber"
                          label="Phone Number"
                          placeholder="Enter 10-digit phone number"
                          required={true}
                          register={{
                            ...register("phoneNumber", {
                              required: "Phone Number is required",
                              pattern: {
                                value: CONSTANT_REGEX.MOBILE,
                                message: "Phone number must be 10 digits",
                              },
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
  name="gender"
  label="Gender"
  required={true}
  options={[
    { value: "", label: "Select Gender" },
    ...(masterData?.genders?.map((type) => ({
      value: type.valueCode,
      label: type.valueLabel,
    })) || [
      { value: "male", label: "Male" },
      { value: "female", label: "Female" },
      { value: "other", label: "Other" },
    ]),
  ]}
  register={register("gender", {
    required: "Gender is required",
  })}
  errors={errors.gender}
value={watch("gender") || ""}
  onChange={(value) =>
    setValue("gender", value, { shouldValidate: true })
  }
/>
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="dateOfBirth"
                          label="Date of Birth"
                          type="date"
                          placeholder="Select date of birth"
                          required={true}
                          register={{
                            ...register("dateOfBirth", {
                              required: "Date of Birth is required",
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Address Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaMapMarkerAlt className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>Address Details</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={6}>
                        <InputText
                          name="addressLine1"
                          label="Address Line-1"
                          placeholder="Enter address line 1"
                          required={true}
                          register={{
                            ...register("addressLine1", {
                              required: "Address Line-1 is required",
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={6}>
                        <InputText
                          name="addressLine2"
                          label="Address Line-2"
                          placeholder="Enter address line 2 (optional)"
                          register={{
                            ...register("addressLine2"),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="pin"
                          label="PIN"
                          placeholder="Enter 6-digit PIN code"
                          required={true}
                          register={{
                            ...register("pin", {
                              required: "PIN Code is required",
                              pattern: {
                                value: /^[0-9]{6}$/,
                                message: "PIN must be 6 digits",
                              },
                            }),
                          }}
                          onChange={(e) => {
                            const pinValue = e.target.value;
                            if (pinValue.length === 6) {
                              loaderRef.current?.show();
                              fetchAddressDetails(pinValue);
                            }
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="district"
                          label="District"
                          placeholder="Auto-populated"
                          register={{
                            ...register("district"),
                          }}
                          errors={errors}
                          readOnly
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="stateUt"
                          label="State/UT"
                          placeholder="Auto-populated"
                          register={{
                            ...register("stateUt"),
                          }}
                          errors={errors}
                          readOnly
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="country"
                          label="Country"
                          placeholder="Auto-populated"
                          register={{
                            ...register("country"),
                          }}
                          errors={errors}
                          readOnly
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Education Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaGraduationCap className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>Education Details</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    {fields.map((field, index) => (
                      <div key={field.id} className="education-entry mb-4">
                        <Row className="g-3">
                          <Col md={4}>
                            <InputText
                              name={`educationDetails.${index}.qualification`}
                              label={`Qualification${index === 0 ? " *" : ""}`}
                              placeholder="Enter qualification"
                              register={register(
                                `educationDetails.${index}.qualification`,
                                {
                                  required:
                                    index === 0
                                      ? "Qualification is required"
                                      : false,
                                }
                              )}
                              errors={
                                errors?.educationDetails?.[index]?.qualification
                                  ? {
                                    educationDetails: {
                                      [index]: {
                                        qualification:
                                          errors.educationDetails[index]
                                            .qualification,
                                      },
                                    },
                                  }
                                  : {}
                              }
                              style={{
                                borderColor:
                                  errors?.educationDetails?.[index]
                                    ?.qualification && "#dc3545",
                                backgroundColor:
                                  errors?.educationDetails?.[index]
                                    ?.qualification && "#fff8f8",
                              }}
                            />
                          </Col>
                          <Col md={4}>
                            <InputText
                              name={`educationDetails.${index}.stream`}
                              label={`Stream${index === 0 ? " *" : ""}`}
                              placeholder="Enter stream"
                              register={register(
                                `educationDetails.${index}.stream`,
                                {
                                  required:
                                    index === 0
                                      ? "Stream is required"
                                      : false,
                                }
                              )}
                              errors={
                                errors?.educationDetails?.[index]?.stream
                                  ? {
                                    educationDetails: {
                                      [index]: {
                                        stream:
                                          errors.educationDetails[index]
                                            .stream,
                                      },
                                    },
                                  }
                                  : {}
                              }
                              style={{
                                borderColor:
                                  errors?.educationDetails?.[index]?.stream &&
                                  "#dc3545",
                                backgroundColor:
                                  errors?.educationDetails?.[index]?.stream &&
                                  "#fff8f8",
                              }}
                            />
                          </Col>
                          <Col md={3}>
                            <InputText
                              name={`educationDetails.${index}.yearOfPassing`}
                              label={`Year of Passing${index === 0 ? " *" : ""}`}
                              placeholder="Enter year"
                              type="number"
                              register={register(
                                `educationDetails.${index}.yearOfPassing`,
                                {
                                  required:
                                    index === 0
                                      ? "Year of Passing is required"
                                      : false,
                                  min: {
                                    value: 1900,
                                    message: "Invalid year",
                                  },
                                  max: {
                                    value: new Date().getFullYear(),
                                    message: "Invalid year",
                                  },
                                }
                              )}
                              errors={
                                errors?.educationDetails?.[index]?.yearOfPassing
                                  ? {
                                    educationDetails: {
                                      [index]: {
                                        yearOfPassing:
                                          errors.educationDetails[index]
                                            .yearOfPassing,
                                      },
                                    },
                                  }
                                  : {}
                              }
                              style={{
                                borderColor:
                                  errors?.educationDetails?.[index]
                                    ?.yearOfPassing && "#dc3545",
                                backgroundColor:
                                  errors?.educationDetails?.[index]
                                    ?.yearOfPassing && "#fff8f8",
                              }}
                            />
                          </Col>
                          <Col md={1} className="d-flex align-items-end">
                            {index > 0 && (
                              <Button
                                variant="danger"
                                size="sm"
                                onClick={() => remove(index)}
                                className="mt-1"
                              >
                                <FaTrash />
                              </Button>
                            )}
                          </Col>
                        </Row>
                      </div>
                    ))}
                    <Button
                      variant="outline-primary"
                      onClick={() =>
                        append({
                          qualification: "",
                          stream: "",
                          yearOfPassing: "",
                        })
                      }
                      className="add-education-btn"
                    >
                      <FaPlus className="me-2" /> Add Education Details
                    </Button>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Professional Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaBriefcase className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>
                      Professional Details
                    </span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    {professionalFields.map((field, index) => (
                      <div key={field.id} className="professional-entry mb-4">
                        <Row className="g-3">
                          <Col md={4}>
                            <InputText
                              name={`professionalDetails.${index}.appointmentDate`}
                              label="Appointment Date *"
                              type="date"
                              placeholder="Select appointment date"
                              register={register(
                                `professionalDetails.${index}.appointmentDate`,
                                { required: "Appointment Date is required" }
                              )}
                              errors={
                                errors?.professionalDetails?.[index]?.appointmentDate
                                  ? {
                                    professionalDetails: {
                                      [index]: {
                                        appointmentDate:
                                          errors.professionalDetails[index]
                                            .appointmentDate,
                                      },
                                    },
                                  }
                                  : {}
                              }
                              style={{
                                borderColor:
                                  errors?.professionalDetails?.[index]
                                    ?.appointmentDate && "#dc3545",
                                backgroundColor:
                                  errors?.professionalDetails?.[index]
                                    ?.appointmentDate && "#fff8f8",
                              }}
                            />
                          </Col>
                          <Col md={4}>
                            <InputSelect
                              name={`professionalDetails.${index}.employeeType`}
                              label="Employee Type *"
                              placeholder="Select employee type"
                              options={
                                masterData?.employeeTypes?.map((type) => ({
                                  value: type.valueCode,
                                  label: type.valueLabel,
                                })) || []
                              }
                              register={register(
                                `professionalDetails.${index}.employeeType`,
                                { required: "Employee Type is required" }
                              )}
                              errors={
                                errors?.professionalDetails?.[index]?.employeeType
                                  ? {
                                    professionalDetails: {
                                      [index]: {
                                        employeeType:
                                          errors.professionalDetails[index]
                                            .employeeType,
                                      },
                                    },
                                  }
                                  : {}
                              }
                              value={
                                watch(
                                  `professionalDetails.${index}.employeeType`
                                ) || ""
                              }
                              onChange={(val) =>
                                setValue(
                                  `professionalDetails.${index}.employeeType`,
                                  val,
                                  { shouldValidate: true }
                                )
                              }
                            />
                          </Col>
                          <Col md={4}>
                            <InputSelect
                              name={`professionalDetails.${index}.employeeStatus`}
                              label="Employee Status *"
                              placeholder="Select employee status"
                              options={
                                masterData?.employeeStatuses?.map((type) => ({
                                  value: type.valueCode,
                                  label: type.valueLabel,
                                })) || []
                              }
                              register={register(
                                `professionalDetails.${index}.employeeStatus`,
                                { required: "Employee Status is required" }
                              )}
                              errors={
                                errors?.professionalDetails?.[index]?.employeeStatus
                                  ? {
                                    professionalDetails: {
                                      [index]: {
                                        employeeStatus:
                                          errors.professionalDetails[index]
                                            .employeeStatus,
                                      },
                                    },
                                  }
                                  : {}
                              }
                              value={
                                watch(
                                  `professionalDetails.${index}.employeeStatus`
                                ) || ""
                              }
                              onChange={(val) =>
                                setValue(
                                  `professionalDetails.${index}.employeeStatus`,
                                  val,
                                  { shouldValidate: true }
                                )
                              }
                            />
                          </Col>
                          <Col md={4}>
                            <InputSelect
                              name={`professionalDetails.${index}.designation`}
                              label="Designation *"
                              placeholder="Select designation"
                              options={
                                masterData?.designations?.map((type) => ({
                                  value: type.valueCode,
                                  label: type.valueLabel,
                                })) || []
                              }
                              register={register(
                                `professionalDetails.${index}.designation`,
                                { required: "Designation is required" }
                              )}
                              errors={
                                errors?.professionalDetails?.[index]?.designation
                                  ? {
                                    professionalDetails: {
                                      [index]: {
                                        designation:
                                          errors.professionalDetails[index]
                                            .designation,
                                      },
                                    },
                                  }
                                  : {}
                              }
                              value={
                                watch(
                                  `professionalDetails.${index}.designation`
                                ) || ""
                              }
                              onChange={(val) =>
                                setValue(
                                  `professionalDetails.${index}.designation`,
                                  val,
                                  { shouldValidate: true }
                                )
                              }
                            />
                          </Col>
                          <Col md={4}>
                            <InputText
                              name={`professionalDetails.${index}.department`}
                              label="Department"
                              placeholder="Enter department"
                              register={register(
                                `professionalDetails.${index}.department`
                              )}
                              errors={
                                errors?.professionalDetails?.[index]?.department
                                  ? {
                                    professionalDetails: {
                                      [index]: {
                                        department:
                                          errors.professionalDetails[index]
                                            .department,
                                      },
                                    },
                                  }
                                  : {}
                              }
                            />
                          </Col>
                          <Col md={4}>
                            <InputText
                              name={`professionalDetails.${index}.section`}
                              label="Section"
                              placeholder="Enter section"
                              register={register(
                                `professionalDetails.${index}.section`
                              )}
                              errors={
                                errors?.professionalDetails?.[index]?.section
                                  ? {
                                    professionalDetails: {
                                      [index]: {
                                        section:
                                          errors.professionalDetails[index]
                                            .section,
                                      },
                                    },
                                  }
                                  : {}
                              }
                            />
                          </Col>
                          <Col md={4}>
                            <InputSelect
                              name={`professionalDetails.${index}.roles`}
                              label="Roles *"
                              placeholder="Select role"
                              options={
                                masterData?.roles?.map((type) => ({
                                  value: type.valueCode,
                                  label: type.valueLabel,
                                })) || []
                              }
                              register={register(
                                `professionalDetails.${index}.roles`,
                                { required: "Role is required" }
                              )}
                              errors={
                                errors?.professionalDetails?.[index]?.roles
                                  ? {
                                    professionalDetails: {
                                      [index]: {
                                        roles:
                                          errors.professionalDetails[index]
                                            .roles,
                                      },
                                    },
                                  }
                                  : {}
                              }
                              value={
                                watch(
                                  `professionalDetails.${index}.roles`
                                ) || ""
                              }
                              onChange={(val) =>
                                setValue(
                                  `professionalDetails.${index}.roles`,
                                  val,
                                  { shouldValidate: true }
                                )
                              }
                            />
                          </Col>
                          <Col md={1} className="d-flex align-items-end">
                            {index > 0 && (
                              <Button
                                variant="danger"
                                size="sm"
                                onClick={() => removeProfessional(index)}
                                className="mt-1"
                              >
                                <FaTrash />
                              </Button>
                            )}
                          </Col>
                        </Row>
                      </div>
                    ))}
                    <Button
                      variant="outline-primary"
                      onClick={() =>
                        appendProfessional({
                          appointmentDate: "",
                          employeeType: "",
                          employeeStatus: "",
                          designation: "",
                          department: "",
                          section: "",
                          roles: "",
                        })
                      }
                      className="add-education-btn"
                    >
                      <FaPlus className="me-2" /> Add Professional Details
                    </Button>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Documents Upload Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>
                      Documents Upload
                    </span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        {/* <InputText
                          name="addressProof"
                          label="Address Proof"
                          type="file"
                          required={true}
                          register={register("addressProof", {
                            required: "Address Proof is required",
                          })}
                          errors={errors}
                        /> */}
                        <InputText
  name="addressProof"
  label="Address Proof"
  type="file"
  required={true}
  register={register("addressProof", {
    required: "Address Proof is required",
  })}
  errors={errors}
  onChange={(e) => setAddressProofFile(e.target.files[0])}
/>
                        <small className="text-muted">
                          Upload PDF, JPG or PNG (Max: 2MB)
                        </small>
                      </Col>
                      <Col md={4}>
                        {/* <InputText
                          name="identityProof"
                          label="Identity Proof"
                          type="file"
                          required={true}
                          register={register("identityProof", {
                            required: "Identity Proof is required",
                          })}
                          errors={errors}
                        /> */}
                        <InputText
  name="identityProof"
  label="Identity Proof"
  type="file"
  required={true}
  register={register("identityProof", {
    required: "Identity Proof is required",
  })}
  errors={errors}
  onChange={(e) => setIdentityProofFile(e.target.files[0])}
/>
                        <small className="text-muted">
                          Upload PDF, JPG or PNG (Max: 2MB)
                        </small>
                      </Col>
                      <Col md={4}>
                        {/* <InputText
                          name="appointmentLetter"
                          label="Appointment Letter"
                          type="file"
                          required={true}
                          register={register("appointmentLetter", {
                            required: "Appointment Letter is required",
                          })}
                          errors={errors}
                        /> */}
                        <InputText
  name="appointmentLetter"
  label="Appointment Letter"
  type="file"
  required={true}
  register={register("appointmentLetter", {
    required: "Appointment Letter is required",
  })}
  errors={errors}
  onChange={(e) => setAppointmentLetterFile(e.target.files[0])}
/>
                        <small className="text-muted">
                          Upload PDF, JPG or PNG (Max: 2MB)
                        </small>
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Form Actions */}
              <div className="d-flex justify-content-end mt-4 gap-2">
                <Col style={{ display: "flex" }}>
                  <strong style={{ marginTop: "5px" }}>User Status : </strong>
                  &nbsp; &nbsp;
                  <Controller
                    name="toggleChoice"
                    control={control}
                    render={({ field }) => (
                      <AppToggleButton labels={["In-Active", "Active"]} {...field} />
                    )}
                  />
                </Col>

                <Button variant="secondary" onClick={handleCancel}>
                  Cancel
                </Button>
                <Button
                  variant="primary"
                  type="submit"
                  style={{
                    background: "linear-gradient(135deg, #0077b6, #023e8a)",
                    border: "none",
                    boxShadow: "0 4px 6px rgba(0, 0, 0, 0.1)",
                    padding: "8px 20px",
                  }}
                >
                  {isEditMode ? "Update" : "Submit"}
                </Button>
              </div>
            </form>
          </Card.Body>
        </Card>
      </Container>
    </>
  );
};

export default EmployeeRegistration;
import React from "react";
import Select from "react-select";
import { Form } from "react-bootstrap";
import "./InputSelect.css";

interface InputSelectProps {
  label: string;
  required?: boolean;
  name: string;
  options: Array<{ value: string | number; label: string }>;
  register?: any;
  errors?: any;
  disabled?: boolean;
  onChange?: (value: string | number, selObj?: any) => void;
  className?: string;
  style?: React.CSSProperties;
  icon?: React.ElementType;
  value?: any;
  isMulti?: boolean;
  isClearable?: boolean;
}

const InputSelect: React.FC<InputSelectProps> = ({
  label,
  required,
  name,
  options,
  register,
  errors,
  disabled,
  onChange,
  className = "",
  style = {},
  icon: IconComponent,
  value,
  isMulti = false,
  isClearable = false,
}) => {
  const hasError = !!(errors && errors[name]);
  // Find the selected option for react-select
  const selectedOption = options.find(opt => opt.value === value) || null;

  const handleChange = (selected: any) => {
    onChange?.(selected ? selected.value : "", selected);
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold d-block">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>

      <div className="position-relative">
        {IconComponent && (
          <div
            className={`input-icon position-absolute ${
              hasError ? "text-danger" : value ? "text-success" : "text-primary"
            }`}
            style={{
              left: "10px",
              top: "50%",
              transform: "translateY(-50%)",
              zIndex: 2,
            }}
          >
            <IconComponent size={18} />
          </div>
        )}

        <Select
          options={options}
          value={selectedOption}
          onChange={handleChange}
          isDisabled={disabled}
          isMulti={isMulti}
          isClearable={isClearable}
          className={`react-select-container ${hasError ? "is-invalid" : ""}`}
          classNamePrefix="react-select"
          styles={{
            control: (base, state) => ({
              ...base,
              borderColor: hasError
                ? "#dc3545"
                : state.isFocused
                ? "#80bdff"
                : "#ced4da",
              boxShadow:
                state.isFocused && !hasError
                  ? "0 0 0 0.2rem rgba(0, 123, 255, 0.25)"
                  : "none",
              paddingLeft: IconComponent ? "40px" : "12px",
              backgroundColor: hasError ? "#fff8f8" : "white",
              minHeight: "calc(1.5em + 1rem + 2px)",
              "&:hover": {
                borderColor: hasError ? "#dc3545" : "#ced4da",
              },
            }),
            menu: (base) => ({
              ...base,
              zIndex: 9999,
            }),
          }}
        />
      </div>

      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;
.form-section-card {
  border: 1px solid #e9ecef;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
  margin-bottom: 1.5rem;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 1.5rem;
  color: #2466BF;
  font-weight: 600;
}

.section-icon {
  margin-right: 0.75rem;
  font-size: 1.25rem;
}

/* Custom styling for validation */
.form-control.is-invalid {
  border-color: #dc3545 !important;
  background-color: #fff8f8 !important;
}

.invalid-feedback {
  display: block !important;
  color: #dc3545;
  font-size: 0.875rem;
  margin-top: 0.25rem;
}

/* Ensure error messages are always visible */
.form-control.is-invalid ~ .invalid-feedback,
.form-control.is-invalid ~ .invalid-tooltip, 
.was-validated .form-control:invalid ~ .invalid-feedback,
.was-validated .form-control:invalid ~ .invalid-tooltip {
  display: block !important;
}

/* Style for select inputs with errors */
.react-select-container.is-invalid .react-select__control {
  border-color: #dc3545 !important;
  background-color: #fff8f8 !important;
}

/* Success state styling */
.form-control.is-valid {
  border-color: #198754 !important;
  background-color: #f8fff9 !important;
}

.employee-form .btn-primary {
  background: linear-gradient(135deg, #0077b6, #023e8a);
  border: none;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  padding: 8px 20px;
}
