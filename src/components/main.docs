import React, { useRef, useEffect, useState } from "react";
import { Card, Row, Col, Table } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { OverlayTrigger, Tooltip } from "react-bootstrap";
import { BsFillInfoCircleFill, BsCheckCircleFill } from "react-icons/bs";
import NewLoader from "./NewLoader";
import { BsReceipt, BsCurrencyRupee } from "react-icons/bs";
import bb_bg from "../../assets/images/svg-images/bengal-logo.svg";

const Invoicing = ({
  supervisionAuthority,
  onPayNow,
  vesselRegisData,
  paymentData,
}) => {
  const { t } = useTranslation();
  const loaderRef = useRef();
  const [loading, setLoading] = useState(true);

  // console.log("supervisionAuthority", supervisionAuthority);
  // console.log("paymentData", paymentData);

  // const getIcon = (label) => {
  //   const iconMap = {
  //     "Tonnage Fees": <BsArchive className="text-primary" size={16} />,
  //     "Registration Charges": <BsClipboardCheck className="text-success" size={16} />,
  //     "Survey Fees": <BsFileText className="text-info" size={16} />,
  //     "Inspection Charges": <BsShieldCheck className="text-warning" size={16} />,
  //     "Processing Fees": <BsGear className="text-secondary" size={16} />,
  //     "Port Clearance Tax": <BsReceipt className="text-danger" size={16} />,
  //     "Manning Certification Fees": <BsAward className="text-purple" size={16} />,
  //     "Environmental Cess": <BsTreeFill className="text-success" size={16} />,
  //     "Duplicate Certificate Fees": <BsFiles className="text-muted" size={16} />,
  //     "Drawing Approval Fee": <BsFileText className="text-primary" size={16} />,
  //     "Supervision Fee": <BsShieldCheck className="text-warning" size={16} />,
  //     "Documentation Charges": <BsFiles className="text-info" size={16} />,
  //     "Drawing Scrutiny Fee": <BsClipboardCheck className="text-success" size={16} />
  //   };
  //   return iconMap[label] || <BsReceipt className="text-muted" size={16} />;
  // };

  useEffect(() => {
    if (!loaderRef?.current) return;

    if (paymentData) {
      loaderRef.current.hide();
      setLoading(false); // stop loading once data is available
    } else {
      loaderRef.current.show();
      setLoading(true);
    }
  }, [paymentData]);

  const formatCurrency = (amount) => {
    return new Intl.NumberFormat("en-IN", {
      style: "currency",
      currency: "INR",
      minimumFractionDigits: 2,
    }).format(amount);
  };

  if (loading) {
    return <NewLoader ref={loaderRef} />;
  }

  if (
    !paymentData?.summary?.totalPayable ||
    paymentData?.summary?.totalPayable === 0
  ) {
    return (
      <div className="container py-4 d-flex justify-content-center align-items-center border rounded-4 bg-light shadow-sm ">
        <Col xs={12} md={10} lg={8}>
          <div
            className="p-4 p-md-5 text-center fadeInUp position-relative overflow-hidden"
            style={{ minHeight: "300px" }}
          >
            <div
              style={{
                backgroundImage: `url(${bb_bg})`,
                backgroundSize: "contain",
                backgroundRepeat: "no-repeat",
                backgroundPosition: "center",
                opacity: 0.08,
                position: "absolute",
                inset: 0,
                zIndex: 1,
              }}
            />

            {/* Content always on top */}
            <div style={{ position: "relative", zIndex: 2 }}>
              <div className="mb-3">
                <BsCheckCircleFill
                  className="text-success"
                  size={48}
                  style={{ position: "relative", bottom: "1rem" }}
                />
              </div>
              <h4 className="fw-bold mb-2 mt-2">
                {t("inVoicing.noPaymentRequired")}
              </h4>
              <p className="text-muted mt-2 mb-0">
                {t("inVoicing.noOutstandingMsg") ||
                  "You currently have no outstanding payments."}
              </p>
            </div>
          </div>
        </Col>
      </div>
    );
  }

  return (
    <div className="container py-3">
      <NewLoader ref={loaderRef} />

      <Row className="justify-content-center">
        <Col lg={10} xl={9}>
          <div className="d-flex align-items-center justify-content-center mb-3">
            <div className="bg-primary bg-opacity-10 rounded-circle p-2 me-2">
              <BsReceipt size={20} className="text-primary" />
            </div>
            <h4 className="mb-0 text-primary fw-bold">
              {t("inVoicing.Invoice Details")}
            </h4>
          </div>

          <Card
            className="shadow-sm border-0 mb-3"
            style={{ borderRadius: "12px", overflow: "hidden" }}
          >
            <Card.Header
              className="py-2 border-0"
              style={{
                background: "linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%)",
              }}
            >
              <div className="d-flex align-items-center">
                <BsCurrencyRupee size={18} className="text-primary me-2" />
                <h6 className="mb-0 text-dark fw-semibold">
                  {t("inVoicing.Fee Breakdown")}
                </h6>
                <span className="ms-2 badge bg-primary bg-opacity-10 text-primary">
                  {supervisionAuthority === "iwt"
                    ? t("inVoicing.IWT")
                    : supervisionAuthority === "classificationSociety"
                    ? t("inVoicing.Classification Society")
                    : t("inVoicing.Standard")}
                </span>
              </div>
            </Card.Header>

            <Card.Body className="p-0">
              <Table responsive className="mb-0" style={{ fontSize: "0.9rem" }}>
                <tbody>
                  {paymentData?.invoiceBreakupInfo?.map((item) => (
                    <tr key={item.id} className="border-bottom">
                      <td className="py-3 px-4">
                        <div className="d-flex align-items-center">
                          <div>
                            <span className="fw-semibold">
                              {item.categoryHeader}
                            </span>
                            {/* {item.label && (
                              <div>
                                <small className="text-muted">
                                  {item.label}
                                </small>
                              </div>
                            )} */}
                            &nbsp; &nbsp;
                            {item?.label && (
                              <OverlayTrigger
                                placement="right"
                                overlay={
                                  <Tooltip
                                    placement="auto"
                                    id={`tooltip-${
                                      item?.id || item?.categoryHeader
                                    }`}
                                  >
                                    {item.label}
                                  </Tooltip>
                                }
                              >
                                <span role="button">
                                  <BsFillInfoCircleFill
                                    color="#0f6be4ff"
                                    size={18}
                                  />
                                </span>
                              </OverlayTrigger>
                            )}
                          </div>
                        </div>
                      </td>
                      <td className="py-3 px-4 text-end fw-bold text-primary">
                        {item.amount ? formatCurrency(item.amount) : ""}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </Table>
            </Card.Body>
          </Card>

          <Card
            className="shadow-sm border-0 w-100"
            style={{ borderRadius: "16px" }}
          >
            <div
              style={{
                backgroundImage: `url(${bb_bg})`, // use your background image
                backgroundSize: "contain",
                backgroundRepeat: "no-repeat",
                backgroundPosition: "center",
                opacity: 0.08,
                position: "absolute",
                top: 0,
                left: 0,
                height: "100%",
                width: "100%",
                zIndex: 1,
              }}
            />

            <Card.Body
              className="p-3 p-md-4"
              style={{
                background: "linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%)",
              }}
            >
              {/* Header */}
              <div className="text-center mb-4">
                <div
                  className="rounded-circle d-inline-flex p-3 mb-2"
                  style={{
                    background: "linear-gradient(135deg, #d4f8e8, #b3f0d0)",
                  }}
                >
                  <BsCurrencyRupee
                    size={22}
                    className="text-success d-md-none"
                  />
                  <BsCurrencyRupee
                    size={28}
                    className="text-success d-none d-md-block"
                  />
                </div>
                <h6 className="text-success fw-bold mb-0 fs-6 fs-md-5">
                  {t("inVoicing.Payment Summary")}
                </h6>
              </div>

              {/* Summary Section */}
              <div className="bg-light bg-opacity-50 rounded p-3 p-md-4">
                {[
                  {
                    label: t("inVoicing.Sub Total"),
                    value: paymentData.summary?.subTotal,
                  },
                  {
                    label: `${t("inVoicing.CGST")} (9%)`,
                    value: paymentData.summary?.cgst,
                  },
                  {
                    label: `${t("inVoicing.SGST")} (9%)`,
                    value: paymentData.summary?.sgst,
                  },
                  paymentData?.summary?.igst > 0 && {
                    label: `${t("inVoicing.IGST")} (18%)`,
                    value: paymentData.summary?.igst,
                  },
                ]
                  .filter(Boolean)
                  .map((row, idx, arr) => (
                    <div
                      key={idx}
                      className={`d-flex justify-content-between align-items-center flex-wrap py-2 ${
                        idx !== arr.length - 1 ? "border-bottom" : ""
                      }`}
                    >
                      <span className="fw-semibold small">{row.label}:</span>
                      <span className="fw-semibold small small-md-base">
                        {formatCurrency(row.value || 0)}
                      </span>
                    </div>
                  ))}

                {/* Total */}
                <div className="d-flex justify-content-between align-items-center pt-3 flex-wrap">
                  <span className="fw-bold fs-6 fs-md-5 text-dark">
                    {t("inVoicing.Total Payable")}:
                  </span>
                  <span className="fw-bold fs-5 fs-md-4 text-success">
                    {formatCurrency(paymentData.summary?.totalPayable || 0)}
                  </span>
                </div>
              </div>
            </Card.Body>
          </Card>
        </Col>
      </Row>
    </div>
  );
};

export default Invoicing;
import React, { useState, useRef, useCallback } from "react";
import { Button } from "@mui/material";
import { FaArrowLeft } from "react-icons/fa";
import { useNavigate, useLocation } from "react-router-dom";
import Stepper from "../../../common/Stepper";
import NameChange from "./NameChange";
import styles from './ApplicationDetailsUpdate.module.css';

const ApplicationDetailsUpdate = () => {
  const navigate = useNavigate();
  const location = useLocation();
  const stepperRef = useRef();
  const selectedOption = location.state?.selectedOption || "";
  
  const [isValid, setIsValid] = useState(false);
  const [formData, setFormData] = useState({});

  const handleValidationChange = useCallback((valid) => {
    setIsValid(valid);
  }, []);

  const handleDataChange = useCallback((data) => {
    setFormData(data);
  }, []);

  const validateStep = () => {
    return isValid;
  };

  const getFormData = () => {
    return formData;
  };

  const handleSaveAndNext = (stepInfo) => {
    console.log("Saving step data:", stepInfo);
  };

  const steps = [
    {
      label: "Registration Information",
      component: (
        <NameChange 
          selectedOption={selectedOption}
          onValidationChange={handleValidationChange}
          onDataChange={handleDataChange}
        />
      ),
      validate: validateStep,
      getFormData: getFormData,
      showSavaAndNextButton: true,
      hasActions: true
    }
  ];

  return (
    <div className={styles.container}>
      <div className={styles.header}>
        <Button
          startIcon={<FaArrowLeft />}
          onClick={() => navigate(-1)}
          className={styles.backButton}
        >
        </Button>
        <h5 className={styles.title}>
          Application Details Update - {selectedOption}
        </h5>
        <div className={styles.applicationId}>
          WB-IWT/REG/2025/302748
        </div>
      </div>
      
      <Stepper
        ref={stepperRef}
        steps={steps}
        onSyncData={handleSaveAndNext}
        viewMode={true}
        editMode={false}
        initialStep={0}
      />
    </div>
  );
};

export default ApplicationDetailsUpdate;
