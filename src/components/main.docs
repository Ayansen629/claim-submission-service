:root {
  /* Primary colors */
  --primary-color: #2466BF;
  --primary-dark: #00429c;
  --primary-light: #4695ff;
  --primary-gradient: linear-gradient(135deg, var(--primary-dark), var(--primary-light));
  
  /* Background colors */
  --light-bg: #f0f7ff;
  --section-bg: #f8f9fa;
  --map-bg: #f5f5f5;
  
  /* Text colors */
  --white: #fff;
  --dark-text: #333;
  --medium-text: #666;
  --light-text: rgba(255, 255, 255, 0.8);
  
  /* Overlay and shadows */
  --overlay: rgba(0, 0, 0, 0.5);
  --shadow-light: 0 4px 6px rgba(0, 0, 0, 0.1);
  --shadow-medium: 0 10px 20px rgba(0, 0, 0, 0.15);
  --shadow-dark: 0 10px 30px rgba(0, 0, 0, 0.1);
  
  /* Borders and accents */
  --border-color: #dee2e6;
  --footer-accent: rgba(255, 255, 255, 0.5);
  --social-bg: rgba(255, 255, 255, 0.1);
  --social-hover: rgba(255, 255, 255, 0.2);
}
