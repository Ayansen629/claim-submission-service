
import React, { useState, useEffect, useImperativeHandle, forwardRef } from "react";
import { Row, Col, Table } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { formatDate } from "../../../../../utils/constants.ts";
import styles from "../../../../common/styles/ProvisionalCertificateOfRegistration.module.css";

const ProvisionalCertificateOfRegistration = forwardRef(({
  registrationData,
  surveyData,
  preFilledCertData,
}, ref) => {
  const { t } = useTranslation();

  const currentDate = new Date();
  const expiryDate = new Date(currentDate.getTime() + 365 * 24 * 60 * 60 * 1000);

  const [editableData, setEditableData] = useState({
    expiryDate: formatDate(expiryDate),
    registrationDate: formatDate(currentDate),
    lengthEngineRoom: "",
    build: "",
    previousRegistrationNo: "",
    dateOfPreviousRegistry: "",
    portOfPreviousRegistry: "",
    numberOfTenthShares: "",
    summaryDescriptionOfTonnage: ""
  });

  const [errors, setErrors] = useState({});

  useEffect(() => {
    if (preFilledCertData) {
      setEditableData(prev => ({
        ...prev,
        expiryDate: preFilledCertData.expiryDate || prev.expiryDate,
        registrationDate: preFilledCertData.registrationDate || prev.registrationDate,
        lengthEngineRoom: preFilledCertData.lengthEngineRoom || "",
        build: preFilledCertData.build || "",
        previousRegistrationNo: preFilledCertData.previousRegistrationNo || "",
        dateOfPreviousRegistry: preFilledCertData.dateOfPreviousRegistry || "",
        portOfPreviousRegistry: preFilledCertData.portOfPreviousRegistry || "",
        numberOfTenthShares: preFilledCertData.numberOfTenthShares || "",
        summaryDescriptionOfTonnage: preFilledCertData.summaryDescriptionOfTonnage || ""
      }));
    }
  }, [preFilledCertData]);

 const validateRequiredFields = () => {
  const newErrors = {};
  
  if (!editableData.expiryDate.trim()) newErrors.expiryDate = 'Expiry date is required';
  if (!editableData.registrationDate.trim()) newErrors.registrationDate = 'Registration date is required';
  if (!editableData.lengthEngineRoom.trim()) newErrors.lengthEngineRoom = 'Length of engine room is required';
  if (!editableData.build.trim()) newErrors.build = 'Build year is required';
  if (!editableData.previousRegistrationNo.trim()) newErrors.previousRegistrationNo = 'Previous registration number is required';
  if (!editableData.dateOfPreviousRegistry.trim()) newErrors.dateOfPreviousRegistry = 'Date of previous registry is required';
  if (!editableData.portOfPreviousRegistry.trim()) newErrors.portOfPreviousRegistry = 'Port of previous registry is required';
  if (!editableData.numberOfTenthShares.trim()) newErrors.numberOfTenthShares = 'Number of tenth shares is required';
  if (!editableData.summaryDescriptionOfTonnage.trim()) newErrors.summaryDescriptionOfTonnage = 'Summary description of tonnage is required';

  setErrors(newErrors);
  return Object.keys(newErrors).length === 0;
};

  useImperativeHandle(ref, () => ({
    validate: validateRequiredFields,
    getFormData: () => editableData
  }));

  const handleInputChange = (field, value) => {
    setEditableData(prev => ({
      ...prev,
      [field]: value
    }));
    
    if (errors[field]) {
      setErrors(prev => {
        const newErrors = { ...prev };
        delete newErrors[field];
        return newErrors;
      });
    }
  };

  return (
    <div className={styles.certificateBody}>
      {/* Expiry Date */}
      <div className={styles.expirySection}>
        <span className={styles.expiryLabel}>
          {t("Expiry on or before the")} <span className={styles.asterisk}>*</span>
          <input
            type="date"
            className={`${styles.editableDate} ${errors.expiryDate ? styles.errorField : ''}`}
            value={editableData.expiryDate}
            onChange={(e) => handleInputChange("expiryDate", e.target.value)}
          />
          {errors.expiryDate && <div className={styles.errorMessage}>{errors.expiryDate}</div>}
        </span>
      </div>

      {/* Issued By */}
      <div className={styles.issuedBySection}>
        <span className={styles.issuedLabel}>
          {t("Issued by")} ({t("IWT Authority")})
        </span>
      </div>

      {/* Particulars of Vessel */}
      <div className="vessel-particulars mb-4">
        <h5 className={styles.sectionTitle}>{t("PARTICULARS OF VESSEL")}</h5>

        <Table bordered className={styles.particularsTable}>
          <tbody>
            <tr>
              <td className={styles.labelCell}>{t("Official Number")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.officialNumber || "N/A"}
              </td>
              <td className={styles.labelCell}>{t("Registration Date")} <span className={styles.asterisk}>*</span></td>
              <td className={styles.editableCell}>
                <input 
                  type="date" 
                  className={`${styles.editableInput} ${errors.registrationDate ? styles.errorField : ''}`}
                  value={editableData.registrationDate}
                  onChange={(e) => handleInputChange("registrationDate", e.target.value)}
                />
                {errors.registrationDate && <div className={styles.errorMessage}>{errors.registrationDate}</div>}
              </td>
              <td className={styles.labelCell}>{t("Name of the Vessel")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.vesselName || "N/A"}
              </td>
              <td className={styles.labelCell}>{t("Port of Registry")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.portOfRegistry || "N/A"}
              </td>
            </tr>
            <tr>
              <td className={styles.labelCell}>{t("Previous Registration No.")} <span className={styles.asterisk}>*</span></td>
              <td className={styles.editableCell}>
                <input 
                  type="text" 
                  className={`${styles.editableInput} ${errors.previousRegistrationNo ? styles.errorField : ''}`}
                  value={editableData.previousRegistrationNo}
                  onChange={(e) => handleInputChange("previousRegistrationNo", e.target.value)}
                  placeholder="Enter previous registration no." 
                />
                {errors.previousRegistrationNo && <div className={styles.errorMessage}>{errors.previousRegistrationNo}</div>}
              </td>
              <td className={styles.labelCell}>{t("Date of Previous Registry")} <span className={styles.asterisk}>*</span></td>
              <td className={styles.editableCell}>
                <input 
                  type="date" 
                  className={`${styles.editableInput} ${errors.dateOfPreviousRegistry ? styles.errorField : ''}`}
                  value={editableData.dateOfPreviousRegistry}
                  onChange={(e) => handleInputChange("dateOfPreviousRegistry", e.target.value)}
                />
                {errors.dateOfPreviousRegistry && <div className={styles.errorMessage}>{errors.dateOfPreviousRegistry}</div>}
              </td>
              <td className={styles.labelCell}>{t("Port of Previous Registry")} <span className={styles.asterisk}>*</span></td>
              <td className={styles.editableCell}>
                <input 
                  type="text" 
                  className={`${styles.editableInput} ${errors.portOfPreviousRegistry ? styles.errorField : ''}`}
                  value={editableData.portOfPreviousRegistry}
                  onChange={(e) => handleInputChange("portOfPreviousRegistry", e.target.value)}
                  placeholder="Enter port name" 
                />
                {errors.portOfPreviousRegistry && <div className={styles.errorMessage}>{errors.portOfPreviousRegistry}</div>}
              </td>
              <td className={styles.labelCell}>{t("Name of Builder")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.nameOfBuilder || "N/A"}
              </td>
            </tr>
            <tr>
              <td className={styles.labelCell}>{t("Address of Builder")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.addressOfBuilder || "N/A"}
              </td>
              <td className={styles.labelCell}>{t("Where Built")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.placeOfBuilt || "N/A"}
              </td>
              <td className={styles.labelCell}>{t("Propulsion Type")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.propulsionType || "N/A"}
              </td>
              <td className={styles.labelCell}>{t("Number of Deck")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.numberOfDeck ?? "N/A"}
              </td>
            </tr>
           
<tr>
  <td className={styles.labelCell}>{t("Material Description")}</td>
  <td className={styles.autoPopulateCell}>
    {preFilledCertData?.materialDescription || "N/A"}
  </td>
  <td className={styles.labelCell}>{t("Number of Bulkheads")}</td>
  <td className={styles.autoPopulateCell}>
    {preFilledCertData?.numberOfBulkHeads ?? "N/A"}
  </td>
  <td className={styles.labelCell}>{t("Stern")}</td>
  <td className={styles.autoPopulateCell}>
    {preFilledCertData?.strengthOfDeck || "N/A"}
  </td>
  <td className={styles.labelCell}>{t("Build")} <span className={styles.asterisk}>*</span></td>
  <td className={styles.editableCell}>
    <input
      type="text"
      className={`${styles.editableInput} ${errors.build ? styles.errorField : ''}`}
      value={editableData.build}
      onChange={(e) => handleInputChange("build", e.target.value)}
      placeholder="Enter year"
    />
    {errors.build && <div className={styles.errorMessage}>{errors.build}</div>}
  </td>
</tr>

            <tr>
              <td className={styles.labelCell}>{t("Length")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.length || "N/A"}
              </td>
              <td className={styles.labelCell}>{t("Breadth")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.breadth || "N/A"}
              </td>
              <td className={styles.labelCell}>{t("Depth")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.depth || "N/A"}
              </td>
              <td className={styles.labelCell}>{t("Draft")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.draft || "N/A"}
              </td>
            </tr>
            <tr>
              <td className={styles.labelCell}>{t("Length of the Engine Room")} <span className={styles.asterisk}>*</span></td>
              <td className={styles.editableCell}>
                <input
                  type="number"
                  className={`${styles.editableInput} ${errors.lengthEngineRoom ? styles.errorField : ''}`}
                  value={editableData.lengthEngineRoom}
                  onChange={(e) => handleInputChange("lengthEngineRoom", e.target.value)}
                  placeholder="Enter length"
                />
                {errors.lengthEngineRoom && <div className={styles.errorMessage}>{errors.lengthEngineRoom}</div>}
              </td>
              <td className={styles.labelCell}>{t("GROSS TONNAGE")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.grossTonnage ?? "N/A"}
              </td>
              <td className={styles.labelCell}>{t("NET TONNAGE")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.netTonnage ?? "N/A"}
              </td>
              <td className={styles.labelCell}>{t("Number of crew")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.numberOfCrew ?? "N/A"}
              </td>
            </tr>
            <tr>
              <td className={styles.labelCell}>{t("Number of Engines:")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.numberOfEngines ?? "N/A"}
              </td>
              <td className={styles.labelCell}>{t("Combined Power")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.combinedPower
                  ? `${preFilledCertData.combinedPower} HP`
                  : "N/A"}
              </td>
              <td className={styles.labelCell}>{t("Name of Engine Maker")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.nameOfEngineMaker || "N/A"}
              </td>
              <td className={styles.labelCell}>{t("Address of Engine Maker")}</td>
              <td className={styles.autoPopulateCell}>
                {preFilledCertData?.addressOfEngineMaker || "N/A"}
              </td>
            </tr>
          </tbody>
        </Table>
      </div>

      {/* Survey Certificate Note */}
      <div className={styles.surveyNote}>
        <p className={styles.noteText}>
          {t("A detailed summary of the tonnages for this vessel is shown on the Certificate of Survey")}
        </p>
      </div>

      <div className="mb-3">
        <label htmlFor="summaryDescription" className={`form-label ${styles.required}`}>
          {t("Summary Description of Tonnage")} <span className={styles.asterisk}>*</span>
        </label>
        <textarea
          className={`form-control ${errors.summaryDescriptionOfTonnage ? styles.errorField : ''}`}
          id="summaryDescription"
          rows="5"
          value={editableData.summaryDescriptionOfTonnage}
          onChange={(e) => handleInputChange("summaryDescriptionOfTonnage", e.target.value)}
          placeholder="Enter detailed summary of tonnage..."
        />
        {errors.summaryDescriptionOfTonnage && <div className={styles.errorMessage}>{errors.summaryDescriptionOfTonnage}</div>}
      </div>

      {/* Crew Accommodation */}
      <div className={styles.crewSection}>
        <div className={styles.crewInfo}>
          <span className={styles.crewLabel}>
            {t("The Number of crew for whom accommodation is certified")}
          </span>
          <span className={styles.crewValue}>
            {preFilledCertData?.numberOfCrew ?? "N/A"}
          </span>
        </div>
      </div>

      {/* Certification Statement */}
      <div className={styles.certificationStatement}>
        <p className={styles.statementText}>
          {t("I, the undersigned, Registering Authority at the Port of")}{" "}
          <strong>{preFilledCertData?.portOfRegistry || "N/A"}</strong>{" "}
          {t("in")} <strong>{preFilledCertData?.state || "West Bengal"}</strong>{" "}
          {t("here by certify that the Inland Vessel the Description of which is prefixed to this Provisional certificate, has been duly surveyed, and that the above Description is true; that")}{" "}
          <strong>{preFilledCertData?.nameOfMaster || "N/A"}</strong>{" "}
          {t("whose Certificate of Competency of Service is No")}{" "}
          <strong>{preFilledCertData?.cocNumber || "N/A"}</strong>,{" "}
          {t("is the Master of the said Vessel, and that the Name")}{" "}
          <strong>{preFilledCertData?.ownerName || "N/A"}</strong>{" "}
          {t("Residence of")}{" "}
          <strong>{preFilledCertData?.addressOfOwner || "N/A"}</strong>,{" "}
          {t("owner of")}{" "}
          <strong>{preFilledCertData?.vesselName || "N/A"}</strong>,{" "}
          {t("Number of Tenth Shares Held by are as follows")} :-
        </p>
      </div>

      {/* Owner Details Table */}
      <div className="owner-details">
        <Table bordered className={styles.ownerTable}>
          <thead>
            <tr>
              <th className={styles.ownerHeader}>
                {t("Name Residence and Occupation of the Owner")}
              </th>
              <th className={styles.sharesHeader}>
                {t("Number of Tenth Shares")} <span className={styles.asterisk}>*</span>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td className={styles.ownerInfo}>
                <div>
                  <strong>{t("Name")}:</strong> {preFilledCertData?.ownerName || "N/A"}
                </div>
                <div>
                  <strong>{t("Residence")}:</strong> {preFilledCertData?.addressOfOwner || "N/A"}
                </div>
                <div>
                  <strong>{t("Occupation")}:</strong> {registrationData?.other?.occupation || "Business"}
                </div>
              </td>
              <td className={styles.sharesValue}>
                <input
                  type="text"
                  className={`${styles.sharesInput} ${errors.numberOfTenthShares ? styles.errorField : ''}`}
                  value={editableData.numberOfTenthShares}
                  onChange={(e) => handleInputChange("numberOfTenthShares", e.target.value)}
                  placeholder="e.g., 10/10"
                />
                {errors.numberOfTenthShares && <div className={styles.errorMessage}>{errors.numberOfTenthShares}</div>}
              </td>
            </tr>
          </tbody>
        </Table>
      </div>
    </div>
  );
});

export default ProvisionalCertificateOfRegistration;
.registrationCertificateContainer {
  background: white;
  border: 2px solid #2466BF;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 12px rgba(36, 102, 191, 0.15);
  margin-top: 1rem;
}

.certificateHeader {
  background: linear-gradient(135deg, #2466BF 0%, #1a4fa0 100%);
  padding: 1rem;
  text-align: center;
}

.certificateTitle {
  color: white;
  font-weight: 700;
  font-size: 1.3rem;
  margin: 0;
  letter-spacing: 1px;
}

.certificateBody {
  padding: 2rem;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
}

.expirySection, .issuedBySection {
  text-align: center;
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 6px;
  border: 1px solid #dee2e6;
  margin-bottom: 1rem;
}

.expiryLabel, .issuedLabel {
  font-weight: 600;
  color: #2466BF;
  font-size: 1rem;
}

.editableDate {
  border: 1px solid #2466BF;
  border-radius: 4px;
  padding: 0.25rem 0.5rem;
  font-size: 0.9rem;
  margin-left: 0.5rem;
  width: 120px;
}

.sectionTitle {
  color: #2466BF;
  font-weight: 700;
  font-size: 1.1rem;
  text-align: center;
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-bottom: 2px solid #2466BF;
  padding-bottom: 0.5rem;
}

.particularsTable {
  font-size: 0.8rem;
  margin-bottom: 0;
}

.labelCell {
  background: #2466BF;
  color: white;
  font-weight: 600;
  padding: 0.5rem;
  text-align: center;
  width: 12.5%;
  vertical-align: middle;
}

.valueCell {
  background: white;
  color: #333;
  font-weight: 600;
  padding: 0.5rem;
  text-align: center;
  width: 12.5%;
  vertical-align: middle;
}

.autoPopulateCell {
  background: #fbfdff!important;
  color: #072957!important;
  font-weight: 700;
  padding: 0.5rem;
  text-align: center;
  width: 12.5%;
  vertical-align: middle;
  font-style: italic;
}

.editableCell {
  background: #fff8dc;
  padding: 0.5rem;
  text-align: center;
  width: 12.5%;
  vertical-align: middle;
}

.editableCell input {
  border: 1px solid #dee2e6;
  border-radius: 3px;
  padding: 0.25rem;
  width: 100%;
  text-align: center;
  font-size: 0.75rem;
}

.surveyNote {
  background: #fff3cd;
  border: 1px solid #ffeaa7;
  padding: 1rem;
  border-radius: 6px;
  text-align: center;
}

.noteText {
  margin: 0;
  font-weight: 600;
  color: #856404;
}

.crewSection {
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 6px;
  border-left: 4px solid #2466BF;
}

.crewInfo {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.crewLabel {
  font-weight: 600;
  color: #666;
}

.crewValue {
  font-weight: 700;
  color: #2466BF;
  font-size: 1.1rem;
}

.autoPopulateTag {
  background: #28a745;
  color: white;
  font-size: 0.7rem;
  padding: 0.2rem 0.4rem;
  border-radius: 3px;
  margin-left: 0.5rem;
  font-weight: 600;
}

.certificationStatement {
  background: #f8f9fa;
  padding: 1.5rem;
  border-radius: 6px;
  border-left: 4px solid #2466BF;
}

.statementText {
  text-align: justify;
  line-height: 1.6;
  margin: 0;
  color: #333;
}

.ownerTable {
  font-size: 0.9rem;
}

.ownerHeader, .sharesHeader {
  background: #2466BF;
  color: white;
  text-align: center;
  font-weight: 600;
  padding: 0.75rem;
}

.ownerInfo {
  padding: 1rem;
  line-height: 1.6;
  background: #e8f4fd;
}

.ownerInfo div {
  margin-bottom: 0.5rem;
}

.sharesValue {
  text-align: center;
  font-weight: 700;
  color: #2466BF;
  font-size: 1.1rem;
  vertical-align: middle;
}

@media (max-width: 768px) {
  .certificateBody {
    padding: 1rem;
  }
  
  .particularsTable {
    font-size: 0.7rem;
  }
  
  .labelCell, .valueCell, .autoPopulateCell, .editableCell {
    padding: 0.25rem;
  }
  
  .crewInfo {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
}

.asterisk {
  color: #dc3545;
  margin-left: 2px;
}

.errorField {
  border: 2px solid #dc3545 !important;
  background-color: #fff5f5;
}

.errorMessage {
  color: #dc3545;
  font-size: 0.75rem;
  margin-top: 4px;
  font-weight: 500;
}

.editableInput {
  width: 100%;
  padding: 0.4rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  font-size: 0.75rem;
}

.sharesInput {
  width: 80px;
  padding: 0.5rem;
  border: 2px solid #2466BF;
  border-radius: 4px;
  text-align: center;
  font-weight: bold;
}

.required {
  font-weight: 600;
}

