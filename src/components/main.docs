 <tbody>
                        {currentItems.length > 0 ? (
                            currentItems.map((row) => (
                                
                                <tr key={row.id} 
                                className={isSelected(row.id) ? 'selected-row' : ''} style={{ borderBottom: '1px solid #e9ecef' }}>
                                    <td style={{ padding: '15px' }}>
                                        <Form.Check
                                            type="checkbox"
                                            checked={isSelected(row.id)}
                                            onChange={(e) => handleRowSelect(e, row)}
                                        />
                                    </td>
                                    
                                    {props.columns.map((col) => {
                                        if (hideColumns.includes(col.fieldName)) return null;

                                        const cellValue = col.fieldName.split('.').reduce((obj, key) => obj?.[key], row);
                                        const displayValue = cellValue?.toString() || '';
                                        const firstWord = displayValue.split(' ')[0];

                                        if (col.fieldName === 'action') {
                                            return (
                                                <td key="actions" className="text-center" style={{ padding: '8px' }}>
                                                    <div className="d-flex justify-content-center gap-2">
                                                        {/* Edit Button */}
                                                        {col.actions?.includes("edit") && userData?.userType !== "CRP" && (
                                                            <OverlayTrigger overlay={<Tooltip>Edit</Tooltip>}>
                                                            <Button
                                                              variant={
                                                                row.applicationStatus !== "Sent back" && row.applicationStatus !== "Draft"
                                                                  ? "secondary" // looks like a disabled/muted button
                                                                  : "outline-primary"
                                                              }
                                                              size="sm"
                                                              disabled={row.applicationStatus !== "Sent back" && row.applicationStatus !== "Draft"}
                                                              onClick={() => handleEdit(row)}
                                                            >
                                                              <PencilSquare className="action-icon" />
                                                            </Button>
                                                          </OverlayTrigger>
                                                          
                                                        )}

                                                        {/* View Button */}
                                                        {col.actions?.includes("view") && (
                                                            <OverlayTrigger overlay={<Tooltip>View</Tooltip>}>
                                                                <Button variant="outline-primary" size="sm" onClick={() => handleView(row)}>
                                                                    <Eye className="action-icon" />
                                                                </Button>
                                                            </OverlayTrigger>
                                                        )}

                                                        {/* Track Button */}
                                                        {col.actions?.includes("track") && (
                                                          <OverlayTrigger overlay={<Tooltip>Track</Tooltip>}>
                                                            <Button variant="outline-primary" size="sm" onClick={() => handleTrack(row)}>
                                                            <img src={trackIcon} alt="track" style={{ width: "16px", height: "16px" }} />
                                                            </Button>
                                                          </OverlayTrigger>
                                                        )}

                                                        {/* Delete Button */}
                                                        {col.actions?.includes("delete") && userData?.userType !== "CRP" && (
                                                            <OverlayTrigger overlay={<Tooltip>Delete</Tooltip>}>
                                                                <Button variant="outline-danger" size="sm" onClick={() => handleDeleteRow(row)}>
                                                                    <Trash3 className="action-icon" />
                                                                </Button>
                                                            </OverlayTrigger>
                                                        )}

                                                        {/* Download Button */}
                                                        {col.actions?.includes("download") && (
                                                            <OverlayTrigger overlay={<Tooltip>Download</Tooltip>}>
                                                                <Button variant="outline-success" size="sm" onClick={() => handleDownload(row)}>
                                                                    <Download className="action-icon" />
                                                                </Button>
                                                            </OverlayTrigger>
                                                        )}
                                                    </div>
                                                </td>
                                            );
                                        }

                                        // Special handling for claim number (show first word with tooltip)
                                        if (col.fieldName === 'claimNumber') {
                                            return (
                                                <td key={col.fieldName} className="text-center" style={{ padding: '8px' }}>
                                                    <OverlayTrigger overlay={<Tooltip>{displayValue}</Tooltip>}>
                                                        <div className="text-truncate" style={{ maxWidth: '120px', display: 'inline-block' }}>
                                                            {userData?.userType === "CRP" ? (
                                                                <a
                                                                    href={`/apply-claim/${row.uuid}`}
                                                                    onClick={(e) => { e.preventDefault(); navigate(`/apply-claim/${row.uuid}`); }}
                                                                    className="text-primary"
                                                                >
                                                                    {firstWord || 'N/A'}
                                                                </a>
                                                            ) : firstWord || 'N/A'}
                                                        </div>
                                                    </OverlayTrigger>
                                                </td>
                                            );
                                        }

                                        // Special handling for comment (show first word with tooltip)
                                        if (col.fieldName === 'comment') {
                                            return (
                                                <td key={col.fieldName} className="text-center" style={{ padding: '8px' }}>
                                                    <OverlayTrigger overlay={<Tooltip>{displayValue || 'No comment'}</Tooltip>}>
                                                        <div className="text-truncate" style={{ maxWidth: '120px', display: 'inline-block' }}>
                                                            {firstWord || (
                                                                <span className="text-muted">
                                                                    <FileEarmarkText className="me-1" />
                                                                    None
                                                                </span>
                                                            )}
                                                        </div>
                                                    </OverlayTrigger>
                                                </td>
                                            );
                                        }

                                        // Default cell rendering (show full content)
                                        return (
                                            <td key={col.fieldName} className="text-center" style={{ padding: '8px' }}>
                                                <div className="cell-content">
                                                    {displayValue || (
                                                        <span className="text-muted">
                                                            <FileEarmarkText className="me-1" />
                                                            None
                                                        </span>
                                                    )}
                                                </div>
                                            </td>
                                        );
                                    })}
                                </tr>
                            ))
                        ) : (
                            <tr>
                                <td colSpan={props.columns.length + 1} className="text-center py-5">
                                    <div className="d-flex flex-column justify-content-center align-items-center">
                                        <Database size={48} className="text-muted mb-3" />
                                        <h5 className="text-muted">No records found</h5>
                                        <p className="text-muted">Try adjusting your search or filter criteria</p>
                                    </div>
                                </td>
                            </tr>
                        )}
                    </tbody>
