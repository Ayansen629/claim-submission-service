import { Link } from "react-router-dom";
import { useNavigate } from "react-router-dom";

const generateInboxData = () => {
    const statuses = ["Completed", "Processing", "Rejected"];
    const appTypes = [
        "Registration",
        "Survey",
        "Manning",
        "Certification",
        "Training",
    ];
    const owners = [
        "John Doe",
        "Jane Smith",
        "Robert Johnson",
        "Emily Davis",
        "Michael Wilson",
    ];

    const pendingWithLevels = [
        "Level 1 Approver",
        "Level 2 Approver",
        "Level 3 Approver",
    ];

    return Array.from({ length: 20 }, (_, i) => ({
        id: i + 1,
        appNo: `APP-2025-${(i + 1).toString().padStart(3, "0")}`,
        appType: appTypes[Math.floor(Math.random() * appTypes.length)],
        owner: owners[Math.floor(Math.random() * owners.length)],
        vesselNo: `WB${1420 + i}`,
        date: new Date(
            2025,
            Math.floor(Math.random() * 12),
            Math.floor(Math.random() * 28) + 1
        )
            .toISOString()
            .split("T")[0],
        status: statuses[Math.floor(Math.random() * statuses.length)],
        pendingWith:
            pendingWithLevels[Math.floor(Math.random() * pendingWithLevels.length)],
    }));
};

const generateVesselData = (count = 20) => {
    const vesselNames = [
        "Sea Hawk",
        "Blue Pearl",
        "Ocean Spirit",
        "Wave Rider",
        "Aqua Nova",
        "Neptune",
        "Storm Chaser",
        "Marine Star",
    ];

    return Array.from({ length: count }, (_, i) => {
        const regNo = `REG-${1000 + i}`;
        return {
            registrationNo: (
                <Link 
                    to={`/vessel-registration/new-vessel/edit/${regNo}`}
                    style={{ color: '#007bff', textDecoration: 'none' }}
                >
                    {regNo}
                </Link>
            ),
            vesselName: vesselNames[Math.floor(Math.random() * vesselNames.length)],
            registeredYear: Math.floor(Math.random() * 23) + 2000,
            lastSurveyDate: new Date(
                Date.now() - Math.random() * (Date.now() - new Date(2020, 0, 1))
            )
                .toISOString()
                .split("T")[0],
        };
    });
};

const VesselOwner = ({ userDetails, userRole }) => {
    //   const tabs = Array.from({ length: 8 }, (_, i) => ({
    //     title: `Vessel ${i + 1}`,
    //     content: <VesselContent />,
    //     onLoad: () => console.log(`Loading Vessel ${i + 1}...`),
    //   }));
    console.log(userRole);
    const { t } = useTranslation();
      const { changeLanguage } = useLanguageContext();
      

    return (
        <>
            <WelcomeBox
                userName={
                    userDetails
                        ? userDetails?.firstName + " " + userDetails?.lastName + " User"
                        : ""
                }
                title={getUserRoleName(userRole)}
                desc={t("Here’s your vessel performance overview.")}
            />

            {/* <DynamicTabs
        tabs={tabs}
        onTabChange={(i) => console.log(`Switched to tab ${i}`)}
      /> */}

            <VesselContent />
        </>
    );
};


const VesselContent = ({ vesselNumber }) => {
    const { t } = useTranslation();
      const { changeLanguage } = useLanguageContext();
      // For Vessel Table
const vesselColumns = VESSEL_COLUMNS.map(col => ({
  ...col,
  colName: t(col.colName)
}));

// For Inbox Table
const inboxColumns = INBOX_COLUMNS.map(col => ({
  ...col,
  colName: t(col.colName)
}));
    const [inboxData, setInboxData] = useState([]);
    const [filteredInboxData, setFilteredInboxData] = useState([]);
    const [inboxCurrentPage, setInboxCurrentPage] = useState(1);
    const [inboxSearchTerm, setInboxSearchTerm] = useState("");
    const itemsInboxPerPage = 5;

    const [vesselData, setVesselData] = useState([]);
    const [filteredVesselData, setFilteredVesselData] = useState([]);
    const [vesselCurrentPage, setVesselCurrentPage] = useState(1);
    const [vesselSearchTerm, setVesselSearchTerm] = useState("");
    const itemsVesselPerPage = 5;
    const [isModalOpen, setIsModalOpen] = useState(false);
     const navigate = useNavigate();

    //   const mockItems = [
    //     {
    //       id: 1,
    //       title: "Welcome to the Portal",
    //       description: "Scroll for updates",
    //       type: "text",
    //     },
    //     {
    //       id: 2,
    //       title: "Policy Update",
    //       type: "document",
    //       documentUrl: "/docs/policy.pdf",
    //     },
    //     {
    //       id: 3,
    //       title: "Release Notes",
    //       description: "Version 2.0 released",
    //       type: "text",
    //     },
    //     {
    //       id: 4,
    //       title: "HR Guidelines",
    //       type: "document",
    //       documentUrl: "/docs/hr-guidelines.pdf",
    //     },
    //   ];

    useEffect(() => {
        const data = generateInboxData();
        setInboxData(data);
        setFilteredInboxData(data);

        const vdata = generateVesselData();
        setVesselData(vdata);
        setFilteredVesselData(vdata);
    }, []);

    useEffect(() => {
        const results = inboxData?.filter(
            (item) =>
                item.appNo?.toLowerCase()?.includes(inboxSearchTerm?.toLowerCase()) ||
                item.appType?.toLowerCase()?.includes(inboxSearchTerm?.toLowerCase()) ||
                item.owner?.toLowerCase()?.includes(inboxSearchTerm?.toLowerCase()) ||
                item.vesselNo
                    ?.toLowerCase()
                    ?.includes(inboxSearchTerm?.toLowerCase()) ||
                item.status?.toLowerCase()?.includes(inboxSearchTerm?.toLowerCase()) ||
                item.pendingWith
                    ?.toLowerCase()
                    ?.includes(inboxSearchTerm?.toLowerCase())
        );
        setFilteredInboxData(results);
        setInboxCurrentPage(1);
    }, [inboxSearchTerm, inboxData]);

    const handleTablePageChange = (page) => {
        setInboxCurrentPage(page);
    };

    useEffect(() => {
        const results = vesselData?.filter(
            (item) =>
                item?.registrationNo
                    ?.toString()
                    ?.toLowerCase()
                    ?.includes(vesselSearchTerm?.toLowerCase()) ||
                item?.vesselName
                    ?.toLowerCase()
                    ?.includes(vesselSearchTerm?.toLowerCase()) ||
                item?.registeredYear
                    ?.toString()
                    ?.toLowerCase()
                    ?.includes(vesselSearchTerm?.toLowerCase()) ||
                item?.lastSurveyDate
                    ?.toLowerCase()
                    ?.includes(vesselSearchTerm?.toLowerCase())
        );
        setFilteredVesselData(results);
        setVesselCurrentPage(1);
    }, [vesselSearchTerm, vesselData]);

    const handleVesselTablePageChange = (page) => {
        setVesselCurrentPage(page);
    };

    const handleCardClick = (cardInfo, index) => {
        if (index === 0) {
            navigate("/user-registration/view");
        } else if (index === 1) {
            setIsModalOpen(true);
        }
    };

    const statData = [
        {
            title: t("Total Registered Vessel Count"),
            value: 35,
            icon: BsClipboardData,
            color: "#28a745",
            subtitle: t("(Total Number of Registered Vessels)"),
        },

        {
            title: t("Graphical Representation"),
            imageSrc: chart_icon,
            color: "#6ec1e4",
            subtitle: t("(Total number of registered vessel as per 'Type')"),
        },

        {
            title: t("Survey Due"),
            value: 20,
            icon: BsExclamationTriangle,
            color: "#E8B60E",
            subtitle: t("(Total Number of Vessel having Survey due within next 30Days)"),
        },
        {
            title: t("Insurance Due"),
            value: 15,
            icon: BsExclamationTriangle,
            color: "#902424",
            subtitle: t("(Total Number of Vessel having Insurance due within next 30Days)"),
        },
    ];
    //   const [transactionSearch, setTransactionSearch] = useState("");
    //   const tableData = {
    //     regNo: "WB1423",
    //     vesselName: "SALT AND LIGHT",
    //     vesselType: "Passenger",
    //     yearOfRegistry: "2007",
    //     currentStatus: "Active",
    //     portOfRegistry: "Kolkata",
    //     lastSurvey: "25-10-2025",
    //   };

    // Filtered data for Transaction Info
    // const filteredTransactionData = MOCK_TRANSACTION_DATA.filter((item) =>
    //     Object.values(item).some((val) =>
    //         String(val)?.toLowerCase()?.includes(transactionSearch.toLowerCase())
    //     )
    // );

    return (
        <>
            {/* Vessel Info table */}

            {/* <Card className="bg-transparent" style={{ marginBottom: 0 }}>
                <Card.Header style={headerStyle}>Vessel Information</Card.Header>
            </Card>
            <Table
                responsive="md"
                striped
                bordered
                hover
                className="custom-vessel-table"
            >
                <thead>
                    <tr className="custom-header">
                        <th>Regi No</th>
                        <th>Vessel Name</th>
                        <th>Vessel Type</th>
                        <th>Year of Registry</th>
                        <th>Current Status</th>
                        <th>Port of Registry</th>
                        <th>Last Survey</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{tableData.regNo}</td>
                        <td>{tableData.vesselName}</td>
                        <td>{tableData.vesselType}</td>
                        <td>{tableData.yearOfRegistry}</td>
                        <td>
                            <span className="status-badge">{tableData.currentStatus}</span>
                        </td>
                        <td>{tableData.portOfRegistry}</td>
                        <td>{tableData.lastSurvey}</td>
                    </tr>
                </tbody>
            </Table> */}

            <div className="row g-3">
                {statData.map((item, index) => (
                    <div className="col-md-4 col-lg-3 col-sm-12" key={index}>
                        <StatusCard
                            {...item}
                            onClick={() => handleCardClick(item, index)}
                        />
                    </div>
                ))}

                {/* <div className="col-md-4 col-lg-3 col-sm-12">
                    <VerticalMarquee items={mockItems} speed={40} />
                </div> */}
            </div>

            <br />

            {/*           Transaction Subsequent To Registration */}
            {/* <Card
                className="bg-transparent"
                style={{ marginBottom: 0, marginTop: "1rem" }}
            >
                <Card.Header style={headerStyle}>
                    Transaction Subsequent To Registration
                    <div style={{ float: "right", width: 260 }}>
                        <input
                            type="search"
                            value={transactionSearch}
                            onChange={(e) => setTransactionSearch(e.target.value)}
                            placeholder="Search Transactions"
                            className="form-control"
                        />
                    </div>
                </Card.Header>
                <div style={{ position: "relative", bottom: "2rem" }}>
                    <ActionTable
                        columns={TRANSACTION_COLUMNS}
                        rowData={filteredTransactionData}
                        tableHeader={null}
                        hideExportBtn={false}
                        hideSearchBar={true}
                        pagination={false}
                        noDataText="No transactions found."
                    />
                </div>
            </Card> */}


            {/* -----------------------------------   VESSEL SEARCH    --------------------------- */}

            <Card>
                <Card.Header
                    style={headerStyle}
                    className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
                >
                    <div className="d-flex align-items-center">
                        <h6 className="mb-0 me-2">{t("Vessel Information")}</h6>
                    </div>
                </Card.Header>

                <form
                    style={{ padding: "2rem", margin: 0 }}
                // onSubmit={handleSubmit(onSubmitFilterForm)}
                >
                    <Row>
                        <Col md={3}>
                            <InputText
                                type="text"
                                name="regisNo"
                                maxlength={13}
                                label={t("Registration No.")}
                                placeholder={t("Enter Registration No.")}
                            // register={{
                            //     ...register("regisNo", {}),
                            // }}
                            // errors={errors}
                            />
                        </Col>

                        <Col md={3}>
                            <InputText
                                type="text"
                                name="vesselName"
                                label={t("Vessel Name")}
                                maxlength={80}
                                placeholder={t("Enter Vessel name..")}
                            // register={{
                            //     ...register("vesselName", {}),
                            // }}
                            // errors={errors}
                            />
                        </Col>

                        <Col md={4}>
                            <InputDateRangePicker
                                label={t("Date Range")}
                                // value={selectedRange}
                                // onChange={(range) => setValue("dateRange", range)}
                                // register={register}
                                name="dateRange"
                            // error={errors.dateRange}
                            />
                        </Col>

                        <Col md={2}>
                            <button
                                style={{ position: "relative", top: "1.5rem" }}
                                className="generic-btn-submit"
                                type="button"
                            >
                                {t("Filter")}
                            </button>
                        </Col>
                    </Row>
                </form>

                <Card className="bg-transparent dashboard-card">
                    <Card.Header
                        style={headerStyle}
                        className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
                    >
                        <div className="d-flex align-items-center">
                            <h6 className="mb-0 me-2">{t("Vessel List")}</h6>
                        </div>
                        <div className="d-flex align-items-center">
                            <Button variant="outline-secondary" className="filter-btn me-2">
                                <BsFilter size={18} />
                                <span className="ms-1 d-none d-sm-inline">Filter</span>
                            </Button>
                            <Form className="inbox-search">
                                <InputGroup>
                                    <Form.Control
                                        type="text"
                                        placeholder="Search Vessels..."
                                        aria-label="Search"
                                        value={vesselSearchTerm}
                                        onChange={(e) => setVesselSearchTerm(e.target.value)}
                                    />
                                    <Button variant="primary">
                                        <BsSearch />
                                    </Button>
                                </InputGroup>
                            </Form>
                        </div>
                    </Card.Header>

                    <div style={{ position: "relative", bottom: "2rem" }}>
                        <ActionTable
                            columns={vesselColumns}
                            rowData={filteredVesselData}
                            tableHeader={null}
                            hideExportBtn={true}
                            hideSearchBar={true}
                            pagination={true}
                            inboxCurrentPage={vesselCurrentPage}
                            itemsInboxPerPage={itemsVesselPerPage}
                            onPageChange={handleVesselTablePageChange}
                            noDataText={
                                <div className="no-results text-center py-4">
                                    <BsSearch size={24} className="mb-2" />
                                    <p>No results found</p>
                                    <small>
                                        Try adjusting your search to find what you're looking for.
                                    </small>
                                </div>
                            }
                        />
                    </div>
                </Card>
            </Card>
            {/* -----------------------------------  VESSEL SEARCH END  --------------------------- */}


            {/* -----------------------------------   INBOX    --------------------------- */}

            <Card className="bg-transparent mt-4 dashboard-card">
                <Card.Header
                    style={headerStyle}
                    className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
                >
                    <div className="d-flex align-items-center">
                        <h5 className="mb-0 me-2">{t("Inbox")}</h5>
                        <span className="badge bg-primary rounded-pill">
                            {filteredInboxData.length}
                        </span>
                    </div>
                    <div className="d-flex align-items-center">
                        <Button variant="outline-secondary" className="filter-btn me-2">
                            <BsFilter size={18} />
                            <span className="ms-1 d-none d-sm-inline">{t("Filter")}</span>
                        </Button>
                        <Form className="inbox-search">
                            <InputGroup>
                                <Form.Control
                                    type="text"
                                    placeholder="Search inbox..."
                                    aria-label="Search inbox"
                                    value={inboxSearchTerm}
                                    onChange={(e) => setInboxSearchTerm(e.target.value)}
                                />
                                <Button variant="primary">
                                    <BsSearch />
                                </Button>
                            </InputGroup>
                        </Form>
                    </div>
                </Card.Header>

                <div style={{ position: "relative", bottom: "2rem" }}>
                    <ActionTable
                        columns={inboxColumns}
                        rowData={filteredInboxData}
                        tableHeader={null}
                        hideExportBtn={true}
                        hideSearchBar={true}
                        pagination={true}
                        inboxCurrentPage={inboxCurrentPage}
                        itemsInboxPerPage={itemsInboxPerPage}
                        onPageChange={handleTablePageChange}
                        noDataText={
                            <div className="no-results text-center py-4">
                                <BsSearch size={24} className="mb-2" />
                                <p>No results found</p>
                                <small>
                                    Try adjusting your search to find what you're looking for.
                                </small>
                            </div>
                        }
                    />
                </div>
            </Card>

            {/* -----------------------------------   INBOX  END  --------------------------- */}



            {/* -----------------------------------   CHART    --------------------------- */}
            <ActionModal
                show={isModalOpen}
                close={setIsModalOpen}
                title="Inland Vessel Types"
                size={"md"}
                isFooterHide={true}>

                <DynamicChart
                    type={CHART_TYPES[3]}
                    data={vesselTypesChartData}
                    options={CHART_OPTIONS}
                />
            </ActionModal>
            {/* -----------------------------------   CHART END  --------------------------- */}

        </>
    );
};

export default VesselOwner;
import React, { useState, useEffect } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams } from "react-router-dom";
import Stepper from "../../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import Documents from "./Documents.js";
import { useForm } from "react-hook-form";
import Invoicing from "../../../common/Invoicing.js";
import PaymentModal from "../../../common/PaymentModal.js"; 
import PreviewPage from "../../../common/PreviewPage";
import { vesselData, previewSections } from "./vesselData";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";

const NewVesselRegistration = () => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const { id } = useParams();
  const isEditMode = !!id;
  const methods = useForm({ mode: "onTouched" });
  const { trigger, getValues, setError, setValue } = methods;

  // Complete static data for all fields
  const staticData = {
    // Basic Info
    ownerName: "John Doe",
    ownerAddress: "123 Main Street, Harbor City, State 12345",
    mobile: "9876543210",
    email: "john.doe@example.com",
    pan: "ABCDE1234F",
    aadhar: "123456789012",
    tradeLicence: "TL123456789",
    gst: "GST123456789012",
    grt: "500",
    workOrderValue: "1000000",
    vesselType: "new",
    category: "A",
    zone: "1",
    supervisionAuthority: "classificationSociety",
    purchaseType: "new",
    classificationSociety: "Lloyd's Register Classification Society",
    constructedBy: "2",
    builder: "builder1",
    
    // Builder Details
    builderName: "ABC Marine Shipyard Pvt Ltd",
    builderAddress: "456 Port Road, Shipyard Complex, Harbor City 54321",
    builderEmail: "contact@abcshipyard.com",
    builderMobile: "9876543211",
    builderTradeLicence: "BTL789012345",
    builderGST: "BGST987654321098",
    builderAuth: "auth",
    
    // Documents
    termsAccepted: true,
    
    // Work Order Files (static file objects)
    workOrder_file_1: { name: "Work_Order_Document.pdf", size: 1024000 },
    workOrder_desc_1: "Main work order document for vessel construction",
    
    // Drawings Files (static file objects)
    drawings_file_1: { name: "Vessel_Technical_Drawings.pdf", size: 2048000 },
    drawings_desc_1: "Complete technical drawings and specifications",
    
    // Required Documents (static file objects)
    tonnageBooklets: { name: "Tonnage_Booklets.pdf", size: 512000 },
    stabilityBooklets: { name: "Stability_Booklets.pdf", size: 768000 },
    authLetter: { name: "Authorization_Letter.pdf", size: 256000 }
  };

  const [showModal, setShowModal] = useState(false);
  const [paymentMode, setPaymentMode] = useState("offline");
  const [challanFile, setChallanFile] = useState(null);
  const [showPreview, setShowPreview] = useState(false);
  const [isLoading, setIsLoading] = useState(false);

  useEffect(() => {
    if (isEditMode) {
      // Set all static data with a small delay to ensure form is ready
      setTimeout(() => {
        Object.keys(staticData).forEach(key => {
          setValue(key, staticData[key]);
        });
      }, 100);
    }
  }, [isEditMode, setValue]);

  const validateVesselDetails = async () => {
    const basicFields = [
      "ownerName", "ownerAddress", "mobile", "email", "pan", 
      "aadhar", "tradeLicence", "gst", "grt", "workOrderValue",
      "vesselType", "category", "purchaseType", "constructedBy"
    ];
    
    const constructedBy = getValues("constructedBy");
    if (constructedBy === "2") {
      basicFields.push(
        "builderName", "builderAddress", "builderEmail", 
        "builderMobile", "builderTradeLicence", "builderGST", 
        "builderAuth", "authLetter"
      );
    }
    
    const valid = await trigger(basicFields);
    return valid;
  };

  const validateDocuments = async () => {
    const requiredFields = ['tonnageBooklets', 'stabilityBooklets', 'termsAccepted'];
    const constructedBy = getValues("constructedBy");
    
    if (constructedBy === "2") {
      requiredFields.push('authLetter');
    }
    
    let hasErrors = false;
    
    requiredFields.forEach(fieldName => {
      const fieldValue = getValues(fieldName);
      
      if (!fieldValue || (fieldValue instanceof FileList && fieldValue.length === 0)) {
        setError(fieldName, {
          type: 'required',
          message: `${fieldName} is required`
        });
        hasErrors = true;
      }
    });
    
    return !hasErrors;
  };

  const supervisionAuthority = methods.watch("supervisionAuthority");

  const handleChallanUpload = (e) => {
    setChallanFile(e.target.files?.[0] || null);
  };

  const handleOnlinePay = () => {
    setIsLoading(true);
    setShowModal(false);
   
    setTimeout(() => {
      setIsLoading(false);
      setShowPreview(true);
    }, 1500);
  };

  const steps = [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={showPreview} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={showPreview} />,
      validate: validateDocuments,
    },
    {
      label: t("Invoicing"),
      component: (
        <Invoicing
          supervisionAuthority={supervisionAuthority}
          onPayNow={() => setShowModal(true)}
        />
      ),
      validate: () => true,
    },
  ];

  const handleSave = () => {
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      setShowPreview(true);
    }, 1500);
  };

  if (showPreview) {
    return (
      <PreviewPage
        data={vesselData}
        sections={previewSections}
        title="Vessel Registration Preview"
        subtitle={isEditMode ? "Registration details updated successfully" : "Registration details submitted successfully"}
        onBack={() => setShowPreview(false)}
        submitButtonText={isEditMode ? "Update Registration" : "Take Action"}
        onSubmit={() => alert(isEditMode ? "Registration updated..." : "Taking action...")}
        icons={{ title: "vessel" }}
        viewMode={true}
      />
    );
  }

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {isLoading ? (
        <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
          <div className="text-center">
            <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
              <span className="visually-hidden">Loading...</span>
            </div>
            <p className="mt-3">Processing your request...</p>
          </div>
        </div>
      ) : (
        <>
          <Stack spacing={0.5}>
            <Typography
              sx={{
                fontWeight: 550,
                color: "#2E57A7",
                fontSize: "1.2rem",
              }}
            >
             {isEditMode ? t("Edit Vessel Registration") + ` - ${id}` : t("New Vessel Registration")}
              &nbsp;
              <span style={{ color: "#666", fontSize: "0.65rem" }}>
                {isEditMode ? t("(Update vessel registration details)") : t("(Fill in the vessel details to complete registration)")}
              </span>
            </Typography>
          </Stack>
          <Stepper steps={steps} onSave={handleSave} />
          <PaymentModal
            show={showModal}
            onHide={() => setShowModal(false)}
            paymentMode={paymentMode}
            setPaymentMode={setPaymentMode}
            challanFile={challanFile}
            onChallanUpload={handleChallanUpload}
            onOnlinePay={handleOnlinePay}
            isLoading={isLoading}
            formMethods={methods}
          />
        </>
      )}
    </Box>
  );
};

export default NewVesselRegistration;

import React, { useState, useEffect } from "react";
import { Row, Col, Form, Button } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile.tsx";
import InputText from "../../../common/InputText.tsx";
import { renameFile } from "../../../../utils/constants.ts";

const Documents = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  const [workOrderFiles, setWorkOrderFiles] = useState([{ id: 1 }]);
  const [drawingsFiles, setDrawingsFiles] = useState([{ id: 1 }]);
  
  const {
    register,
    watch,
    setValue,
    clearErrors,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  const addFileInput = (type) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      const newId = workOrderFiles.length > 0 ? Math.max(...workOrderFiles.map(f => f.id)) + 1 : 1;
      setWorkOrderFiles([...workOrderFiles, { id: newId }]);
    } else if (type === 'drawings') {
      const newId = drawingsFiles.length > 0 ? Math.max(...drawingsFiles.map(f => f.id)) + 1 : 1;
      setDrawingsFiles([...drawingsFiles, { id: newId }]);
    }
  };

  const removeFileInput = (type, id) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      setWorkOrderFiles(workOrderFiles.filter(file => file.id !== id));
      setValue(`workOrder_file_${id}`, null);
      setValue(`workOrder_desc_${id}`, "");
      clearErrors([`workOrder_file_${id}`, `workOrder_desc_${id}`]);
    } else if (type === 'drawings') {
      setDrawingsFiles(drawingsFiles.filter(file => file.id !== id));
      setValue(`drawings_file_${id}`, null);
      setValue(`drawings_desc_${id}`, "");
      clearErrors([`drawings_file_${id}`, `drawings_desc_${id}`]);
    }
  };

  const formFields = [
    {
      name: 'tonnageBooklets',
      label: t('Tonnage Booklets'),
      type: 'file',
      required: true,
      colSize: 6,
      validation: { required: t('Tonnage Booklets are required') }
    },
    {
      name: 'stabilityBooklets',
      label: t('Stability Booklets'),
      type: 'file',
      required: true,
      colSize: 6,
      validation: { required: t('Stability Booklets are required') }
    },
    // {
    //   name: 'authLetter',
    //   label: t('Authorisation Letter'),
    //   type: 'file',
    //   required: false,
    //   colSize: 6,
    //   showIf: () => constructedBy === "2",
    //   validation: { required: constructedBy === "2" && t('Authorization Letter is required') }
    // },
    {
      name: 'termsAccepted',
      label: t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.'),
      type: 'checkbox',
      required: true,
      colSize: 12,
      validation: { required: t('You must accept the terms and conditions') }
    }
  ];

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    switch (field.type) {
      case "file":
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(
                  file?.name?.lastIndexOf(".")
                );
                const fileName = `${field.label}${extension}`;
                file.originalName = fileName;
                const renamedFile = renameFile(file, fileName);

                clearErrors(field.name);

                setValue(field.name, renamedFile, { shouldValidate: true });
                setFormData((prev) => {
                  const updated = { ...prev, [field.name]: renamedFile };
                  return updated;
                });
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={watch(field.name)}
            clearErrors={clearErrors}
          />
        );

      case 'checkbox':
        return (
          <div className="mb-3">
            <div className="d-flex align-items-start">
              <input
                type="checkbox"
                id={field.name}
                className="me-2 mt-1"
                {...register(field.name, field.validation)}
                disabled={viewMode}
              />
              <div>
                <label
                  htmlFor={field.name}
                  className="mb-0"
                  style={{ fontWeight: 500, color: "#333", cursor: "pointer" }}
                >
                  {field.label}
                </label>
                {errors[field.name] && (
                  <div className="text-danger small mt-1" style={{ display: "block" }}>
                    {errors[field.name].message}
                  </div>
                )}
              </div>
            </div>
          </div>
        );

      default:
        return null;
    }
  };

  return (
    <div>
      <Collapsible title={t("Documents")} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <Row className="gy-4">
            {/* Work Order Section */}
            <Col lg={6} md={12}>
              <div className="border rounded p-3" style={{ backgroundColor: "#f8f9fa" }}>
                <div className="d-flex justify-content-between align-items-center mb-3">
                  <h6 className="mb-0 fw-bold text-primary">{t("Work Order")}</h6>
                  {!viewMode && (
                    <Button
                      variant="primary"
                      size="sm"
                      onClick={() => addFileInput('workOrder')}
                      style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
                    >
                      + Add
                    </Button>
                  )}
                </div>
                {workOrderFiles.map((fileInput, idx) => (
                  <div key={fileInput.id} className="mb-3 p-2 border rounded" style={{ backgroundColor: "white" }}>
                    <div className="mb-2">
                      <InputFile
                        label={`${t("Choose File")} ${idx + 1}`}
                        name={`workOrder_file_${fileInput.id}`}
                        register={register(`workOrder_file_${fileInput.id}`)}
                        errors={errors}
                        onChange={(e) => {
                          if (e.target.files && e?.target?.files[0]) {
                            const file = e.target.files[0];
                            const extension = file?.name?.substring(
                              file?.name?.lastIndexOf(".")
                            );
                            const fileName = `Work Order${extension}`;
                            file.originalName = fileName;
                            const renamedFile = renameFile(file, fileName);

                            clearErrors(`workOrder_file_${fileInput.id}`);

                            setValue(`workOrder_file_${fileInput.id}`, renamedFile, { shouldValidate: true });
                            setFormData((prev) => {
                              const updated = { ...prev, [`workOrder_file_${fileInput.id}`]: renamedFile };
                              return updated;
                            });
                          }
                        }}
                        disabled={viewMode}
                        watch={watch}
                        defaultValue={watch(`workOrder_file_${fileInput.id}`)}
                        clearErrors={clearErrors}
                      />
                    </div>
                    <div className="mb-2">
                      <InputText
                        label={t("Description")}
                        name={`workOrder_desc_${fileInput.id}`}
                        placeholder={t("Enter file description")}
                        register={register(`workOrder_desc_${fileInput.id}`)}
                        errors={errors}
                        onChange={() => !viewMode && clearErrors(`workOrder_desc_${fileInput.id}`)}
                        disabled={viewMode}
                      />
                    </div>
                    {workOrderFiles.length > 1 && !viewMode && (
                      <div className="text-end">
                        <Button
                          variant="outline-danger"
                          size="sm"
                          onClick={() => removeFileInput('workOrder', fileInput.id)}
                        >
                          Remove
                        </Button>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </Col>

            {/* Drawings Section */}
            <Col lg={6} md={12}>
              <div className="border rounded p-3" style={{ backgroundColor: "#f8f9fa" }}>
                <div className="d-flex justify-content-between align-items-center mb-3">
                  <h6 className="mb-0 fw-bold text-primary">{t("Drawings")}</h6>
                  {!viewMode && (
                    <Button
                      variant="primary"
                      size="sm"
                      onClick={() => addFileInput('drawings')}
                      style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
                    >
                      + Add
                    </Button>
                  )}
                </div>
                {drawingsFiles.map((fileInput, idx) => (
                  <div key={fileInput.id} className="mb-3 p-2 border rounded" style={{ backgroundColor: "white" }}>
                    <div className="mb-2">
                      <InputFile
                        label={`${t("Choose File")} ${idx + 1}`}
                        name={`drawings_file_${fileInput.id}`}
                        register={register(`drawings_file_${fileInput.id}`)}
                        errors={errors}
                        onChange={(e) => {
                          if (e.target.files && e?.target?.files[0]) {
                            const file = e.target.files[0];
                            const extension = file?.name?.substring(
                              file?.name?.lastIndexOf(".")
                            );
                            const fileName = `Drawings${extension}`;
                            file.originalName = fileName;
                            const renamedFile = renameFile(file, fileName);

                            clearErrors(`drawings_file_${fileInput.id}`);

                            setValue(`drawings_file_${fileInput.id}`, renamedFile, { shouldValidate: true });
                            setFormData((prev) => {
                              const updated = { ...prev, [`drawings_file_${fileInput.id}`]: renamedFile };
                              return updated;
                            });
                          }
                        }}
                        disabled={viewMode}
                        watch={watch}
                        defaultValue={watch(`drawings_file_${fileInput.id}`)}
                        clearErrors={clearErrors}
                      />
                    </div>
                    <div className="mb-2">
                      <InputText
                        label={t("Description")}
                        name={`drawings_desc_${fileInput.id}`}
                        placeholder={t("Enter file description")}
                        register={register(`drawings_desc_${fileInput.id}`)}
                        errors={errors}
                        onChange={() => !viewMode && clearErrors(`drawings_desc_${fileInput.id}`)}
                        disabled={viewMode}
                      />
                    </div>
                    {drawingsFiles.length > 1 && !viewMode && (
                      <div className="text-end">
                        <Button
                          variant="outline-danger"
                          size="sm"
                          onClick={() => removeFileInput('drawings', fileInput.id)}
                        >
                          Remove
                        </Button>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </Col>

            {formFields.map((field, index) => (
              <Col key={index} md={field.colSize || 12} className="mb-2">
                {renderField(field)}
              </Col>
            ))}
          </Row>
        </div>
      </Collapsible>
    </div>
  );
};

export default Documents;

import React, { useState, useEffect, useRef } from "react";
import { useForm } from "react-hook-form";
import { Row, Col } from "react-bootstrap";
import InputText from "../../../common/InputText.tsx";
import InputSelect from "../../../common/InputSelect.tsx";
import InputRadio from "../../../common/InputRadio.tsx";
import InputFile from "../../../common/InputFile.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import { renameFile } from "../../../../utils/constants.ts";

const VesselDetails = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [formData, setFormData] = useState({});
  const isCompMount = useRef(true);

  const {
    register,
    watch,
    setValue,
    clearErrors,
    trigger,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");
  const category = watch("category");

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [changeLanguage]);

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  useEffect(() => {
    if (category === "A") {
      setValue("zone", "1", { shouldValidate: true });
      setValue("supervisionAuthority", "classificationSociety", { shouldValidate: true });
      clearErrors("zone");
      clearErrors("supervisionAuthority");
    }
  }, [category, setValue, clearErrors]);

  const formFields = {
    basicInfo: [
      {
        name: 'ownerName',
        label: t('Name of Owner'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Name of Owner'),
        validation: { required: t('Name is required') }
      },
      {
        name: 'ownerAddress',
        label: t('Address of Owner'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Address of Owner'),
        validation: { required: t('Address is required') }
      },
      {
        name: 'mobile',
        label: t('Mobile'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Mobile'),
        validation: { required: t('Mobile is required') }
      },
      {
        name: 'email',
        label: t('Email Id'),
        type: 'email',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Email Id'),
        validation: { required: t('Email is required') }
      },
      {
        name: 'pan',
        label: t('PAN'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter PAN'),
        validation: { required: t('PAN is required') }
      },
      {
        name: 'aadhar',
        label: t('Aadhar'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Aadhar'),
        validation: { required: t('Aadhar is required') }
      },
      {
        name: 'tradeLicence',
        label: t('Trade Licence'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Trade Licence'),
        validation: { required: t('Trade Licence is required') }
      },
      {
        name: 'gst',
        label: t('GST'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GST'),
        validation: { required: t('GST is required') }
      },
      {
        name: 'grt',
        label: t('Gross Tonnage (GRT)'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GRT'),
        validation: { required: t('GRT is required') }
      },
      {
        name: 'workOrderValue',
        label: t('Work Order Value'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Enter Work Order Value'),
        validation: {
          required: t('Work Order Value is required'),
          pattern: {
            value: /^[0-9]+$/,
            message: t('Please enter a valid number')
          }
        }
      },
      {
        name: 'vesselType',
        label: t('Type of Vessel'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'new', label: t('New Vessel') },
          { value: 'old', label: t('Old Vessel') }
        ],
        validation: { required: t('vesselType is required') }
      },
      {
        name: 'category',
        label: t('Category'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'A', label: t('Category A') },
          { value: 'B', label: t('Category B') },
          { value: 'C', label: t('Category C') }
        ],
        validation: { required: t('category is required') }
      },
      {
        name: 'zone',
        label: t('Zone'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: '1', label: t('Zone 1') },
          { value: '2', label: t('Zone 2') },
          { value: '3', label: t('Zone 3') }
        ],
        validation: { required: category !== "A" && t('zone is required') },
        disabled: category === "A"
      },
      {
        name: 'supervisionAuthority',
        label: t('Supervision Authority'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'iwt', label: t('IWT') },
          { value: 'classificationSociety', label: t('Classification Society') }
        ],
        validation: { required: category !== "A" && t('Supervision Authority is required') },
        disabled: category === "A"
      },
      {
        name: 'purchaseType',
        label: t('Purchase Type'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'new', label: t('New') },
          { value: 'used', label: t('Used') }
        ],
        validation: { required: t('Purchase Type is required') }
      },
      {
        name: 'classificationSociety',
        label: t('Name of the Classification Society'),
        type: 'text',
        required: false,
        colSize: 4,
        placeholder: t('Please enter Name of the Classification Society'),
        validation: {}
      },
      {
        name: 'constructedBy',
        label: t('Constructed By ?'),
        type: 'radio',
        required: true,
        colSize: 6,
        options: [
          { label: t('Self'), value: '1' },
          { label: t('Builder'), value: '2' }
        ],
        validation: { required: t('Please select a Constructor Type') }
      },
      {
        name: 'builder',
        label: t('Builder'),
        type: 'select',
        required: true,
        colSize: 6,
        options: [
          { value: 'builder1', label: t('Builder 1') },
          { value: 'builder2', label: t('Builder 2') }
        ],
        showIf: () => constructedBy === "2",
        validation: { required: t('Builder is required') }
      }
    ],
    builderDetails: [
      {
        name: 'builderName',
        label: t('Builder Name'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Name'),
        validation: { required: t('Builder Name is required') }
      },
      {
        name: 'builderAddress',
        label: t('Builder Address'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Address'),
        validation: { required: t('Builder Address is required') }
      },
      {
        name: 'builderEmail',
        label: t('Builder Email Id'),
        type: 'email',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Email Id'),
        validation: {
          required: t('Builder Email is required'),
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: t('Invalid email address')
          }
        }
      },
      {
        name: 'builderMobile',
        label: t('Mobile'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Mobile'),
        validation: {
          required: t('Builder Mobile is required'),
          pattern: {
            value: /^[0-9]{10}$/,
            message: t('Invalid mobile number')
          }
        }
      },
      {
        name: 'builderTradeLicence',
        label: t('Trade Licence'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Trade Licence'),
        validation: { required: t('Builder Trade Licence is required') }
      },
      {
        name: 'builderGST',
        label: t('GST'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GST'),
        validation: { required: t('Builder GST is required') }
      },
      {
        name: 'builderAuth',
        label: t('Builder Authorization'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'auth', label: t('Authorized') },
          { value: 'rejected', label: t('Rejected') }
        ],
        validation: { required: t('Builder Authorization is required') }
      },
      {
        name: 'authLetter',
        label: t('Authorization Letter'),
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: t('Authorization Letter is required') }
      }
    ]
  };

  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'select':
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register(field.name, field.validation)}
            errors={errors}
            value={formData[field.name] || watch(field.name) || ""}
            onChange={(value) => {
              if (viewMode || field.disabled) return;
              setValue(field.name, value, { shouldValidate: true });
              clearErrors(field.name);
              setFormData(prev => ({
                ...prev,
                [field.name]: value
              }));
            }}
            disabled={viewMode || field.disabled}
          />
        );

     case 'file':
  return (
    <div className="mb-2">
      <InputFile
        label={field.label}
        required={field.required}
        name={field.name}
        register={register(field.name, field.validation)}
        errors={errors}
        onChange={(e) => {
          if (viewMode) return;
          if (e.target.files && e?.target?.files[0]) {
            const file = e.target.files[0];
            
            // Validate type
            const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
            if (!validTypes.includes(file.type)) {
              setError(field.name, {
                type: 'manual',
                message: t('Only PDF, JPG or PNG files are allowed')
              });
              setValue(field.name, null);
              return;
            }
            
            // Validate size
            if (file.size > 2 * 1024 * 1024) {
              setError(field.name, {
                type: 'manual',
                message: t('File size should not exceed 2MB')
              });
              setValue(field.name, null);
              return;
            }
            
            // Process file
            const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
            const fileName = `${field.label}${extension}`;
            file.originalName = fileName;
            const renamedFile = renameFile(file, fileName);

            clearErrors(field.name);
            setValue(field.name, renamedFile, { shouldValidate: true });
            setFormData((prev) => ({
              ...prev,
              [field.name]: renamedFile
            }));
          }
        }}
        disabled={viewMode}
        watch={watch}
        defaultValue={watch(field.name)}
        clearErrors={clearErrors}
        accept=".pdf,.jpg,.jpeg,.png"
      />
    </div>
  );

      case 'radio':
        return (
          <InputRadio
            name={field.name}
            label={field.label}
            options={field.options}
            register={register}
            rules={field.validation}
            errors={errors}
            onChange={() => !viewMode && clearErrors(field.name)}
            disabled={viewMode}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field.name, field.validation)}
            onChange={handleChange}
            errors={errors}
            disabled={viewMode}
          />
        );
    }
  };

  return (
    <form autoComplete="off">
      <Collapsible title={t("Basic Information")} openStat={true}>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          {formFields.basicInfo.map((field, index) => (
            <Col key={index} md={field.colSize || 12}>
              <DynamicField field={field} />
            </Col>
          ))}
        </Row>
      </Collapsible>

      {constructedBy === "2" && (
        <Collapsible title={t("Builder Details")} openStat={true}>
          <Row className="gy-3" style={{ padding: "1rem" }}>
            {formFields.builderDetails.map((field, index) => (
              <Col key={index} md={field.colSize || 12}>
                <DynamicField field={field} />
              </Col>
            ))}
          </Row>
        </Collapsible>
      )}
    </form>
  );
};

export default VesselDetails;

import React, { useState } from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

const themeColor = "#2E57A7";
const successColor = "#28a745";

const Stepper = ({ steps, onSave }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [activeStep, setActiveStep] = useState(0);
  const [completed, setCompleted] = useState({});
  const [errors, setErrors] = useState({});

  const totalSteps = steps.length;

  const handleNext = async () => {
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
      } else {
        toast.error("Please fix the errors before proceeding.");
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
    }
  };

  const handleBack = () => {
    setActiveStep((prev) => Math.max(prev - 1, 0));
  };

  const handleSave = async () => {
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        if (activeStep < totalSteps - 1) {
          setActiveStep((prev) => prev + 1);
        } else {
          onSave();
        }
      } else {
        toast.error("Please fix the errors before proceeding.");
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      if (activeStep < totalSteps - 1) {
        setActiveStep((prev) => prev + 1);
      } else {
        onSave();
      }
    }
  };

  const handlePayNow = () => {
    if (
      steps[activeStep] &&
      steps[activeStep].component &&
      typeof steps[activeStep].component.props.onPayNow === "function"
    ) {
      steps[activeStep].component.props.onPayNow();
    }
  };

  return (
    <Box sx={{ width: "100%", padding: "1rem" }}>
      <Paper
        elevation={3}
        sx={{
          padding: "0.75rem 1.5rem",
          borderRadius: "0.75rem",
          overflowX: "auto",
          whiteSpace: "nowrap",
          backgroundColor: "#fafafa",
        }}
      >
        <Stack direction="row" alignItems="center" spacing={1}>
          {steps.map((step, index) => (
            <React.Fragment key={index}>
              <Stack
                direction="row"
                alignItems="center"
                spacing={0.5}
                sx={{ cursor: "pointer" }}
                onClick={() => setActiveStep(index)}
              >
                {completed[index] ? (
                  <CheckCircleFill size={18} color={successColor} />
                ) : (
                  <Typography
                    sx={{
                      fontSize: "0.875rem",
                      width: "1.5rem",
                      height: "1.5rem",
                      textAlign: "center",
                      borderRadius: "50%",
                      backgroundColor: "#e0e0e0",
                      display: "inline-flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: "bold",
                      color: "#666",
                    }}
                  >
                    {index + 1}
                  </Typography>
                )}
                <Typography
                  sx={{
                    fontWeight: index === activeStep ? "bold" : "normal",
                    color: index === activeStep ? themeColor : "#999",
                    fontSize: "0.875rem",
                    whiteSpace: "nowrap",
                  }}
                >
                  {step.label}
                </Typography>
              </Stack>
              {index < steps.length - 1 && <ChevronRight size={14} color="#ccc" />}
            </React.Fragment>
          ))}
        </Stack>
      </Paper>

      <Paper
        elevation={2}
        sx={{
          marginTop: "1rem",
          borderRadius: "0.75rem",
          backgroundColor: "#fff",
          width: "100%",
        }}
      >
        {steps[activeStep].component}
        {errors[activeStep]}
      </Paper>

      <Divider sx={{ margin: "2rem 0" }} />

      <Box
        sx={{
          display: "flex",
          justifyContent: "space-between",
          gap: "1rem",
          flexWrap: "wrap",
        }}
      >
        <Button
          variant="outlined"
          onClick={handleBack}
          disabled={activeStep === 0}
          sx={{
            color: themeColor,
            borderColor: themeColor,
            fontWeight: "bold",
            borderRadius: "0.5rem",
            minWidth: "8rem",
            fontSize: "0.9rem",
          }}
        >
          {t("Previous")}
        </Button>
        
        {activeStep === totalSteps - 1 ? (
          <Button
            variant="contained"
            onClick={handlePayNow}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            {t("Pay Now")}
          </Button>
        ) : (
          <Button
            variant="contained"
            onClick={activeStep === 1 ? handleSave : handleNext}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            {activeStep === 1 ? t("Save & Next") : t("Next")}
          </Button>
        )}
      </Box>
    </Box>
  );
};

export default Stepper;
