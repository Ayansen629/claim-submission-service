/* Mobile responsive styles */
@media (max-width: 767px) {
  .heroSection {
    height: auto;
    min-height: 100vh;
    padding: 1rem 0;
  }
  
  .headerRow {
    flex-direction: column;
  }
  
  .brandName {
    font-size: 14px;
    line-height: 1.2;
  }
  
  .navLinksContainer {
    flex-wrap: wrap;
    justify-content: center;
    margin: 0.5rem 0;
  }
  
  .navLinkItems {
    font-size: 12px;
    padding: 0.25rem 0.5rem;
  }
  
  .bengalLogo {
    width: 3.5rem !important;
    height: 4rem !important;
    position: relative !important;
    top: 0 !important;
    right: 0 !important;
  }
  
  .homeLoginBtn {
    position: relative !important;
    right: 0 !important;
    top: 0 !important;
    font-size: 12px;
    padding: 0.25rem 0.5rem;
  }
}

@media (max-width: 575px) {
  .brandName {
    font-size: 12px;
  }
  
  .navLinkItems {
    font-size: 11px;
    padding: 0.2rem 0.4rem;
  }
}

/* Ensure proper spacing on all devices */
.bengalLogo {
  width: 4.25rem;
  height: 5rem;
}

/* Navigation links container */
.navLinksContainer {
  width: 100%;
}
