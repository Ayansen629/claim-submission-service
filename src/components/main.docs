
import React from "react";
import { Card, Row, Col, Table } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";
import { 
  BsReceipt, 
  BsCurrencyRupee, 
  BsArchive, 
  BsClipboardCheck, 
  BsFileText, 
  BsGear,
  BsShieldCheck,
  BsAward,
  BsTreeFill,
  BsFiles
} from "react-icons/bs";

const Invoicing = ({ supervisionAuthority, onPayNow }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  // Icon mapping for different fee types
  const getIcon = (label) => {
    const iconMap = {
      "Tonnage Fees": <BsArchive className="text-primary" size={16} />,
      "Registration Charges": <BsClipboardCheck className="text-success" size={16} />,
      "Survey Fees": <BsFileText className="text-info" size={16} />,
      "Inspection Charges": <BsShieldCheck className="text-warning" size={16} />,
      "Processing Fees": <BsGear className="text-secondary" size={16} />,
      "Port Clearance Tax": <BsReceipt className="text-danger" size={16} />,
      "Manning Certification Fees": <BsAward className="text-purple" size={16} />,
      "Environmental Cess": <BsTreeFill className="text-success" size={16} />,
      "Duplicate Certificate Fees": <BsFiles className="text-muted" size={16} />,
      "Drawing Approval Fee": <BsFileText className="text-primary" size={16} />,
      "Supervision Fee": <BsShieldCheck className="text-warning" size={16} />,
      "Documentation Charges": <BsFiles className="text-info" size={16} />,
      "Drawing Scrutiny Fee": <BsClipboardCheck className="text-success" size={16} />
    };
    return iconMap[label] || <BsReceipt className="text-muted" size={16} />;
  };

  const getInvoiceData = () => {
    if (supervisionAuthority === "iwt") {
      return {
        invoiceBreakupInfo: [
          { id: "1", label: "Drawing Approval Fee", amount: 1000.0 },
          { id: "2", label: "Supervision Fee", amount: 10000.0 },
          { id: "3", label: "Processing Fees", amount: 500.0 },
          { id: "4", label: "Documentation Charges", amount: 300.0 }
        ],
        summary: {
          subTotal: 11800.0,
          cgst: 1062.0,
          sgst: 1062.0,
          totalPayable: 13924.0
        }
      };
    } else if (supervisionAuthority === "classificationSociety") {
      return {
        invoiceBreakupInfo: [
          { id: "1", label: "Drawing Scrutiny Fee", amount: 500.0 },
          { id: "2", label: "Processing Fees", amount: 300.0 },
          { id: "3", label: "Documentation Charges", amount: 200.0 }
        ],
        summary: {
          subTotal: 1000.0,
          cgst: 90.0,
          sgst: 90.0,
          totalPayable: 1180.0
        }
      };
    }
    
    return {
      invoiceBreakupInfo: [
        { id: "1", label: "Tonnage Fees", amount: 2000.0 },
        { id: "2", label: "Registration Charges", amount: 1500.0 },
        { id: "3", label: "Survey Fees", amount: 1200.0 },
        { 
          id: "4", 
          label: "Inspection Charges", 
          components: [
            { name: "Initial", amount: 800.0 },
            { name: "Follow-up", amount: 400.0 }
          ]
        },
        { id: "5", label: "Processing Fees", amount: 500.0 },
        { 
          id: "6", 
          label: "Port Clearance Tax", 
          components: [
            { name: "Primary", amount: 1000.0 },
            { name: "Additional", amount: 300.0 }
          ]
        },
        { id: "7", label: "Manning Certification Fees", amount: 750.0 },
        { id: "8", label: "Environmental Cess", amount: 350.0 },
        { id: "9", label: "Duplicate Certificate Fees", amount: 250.0 }
      ],
      summary: {
        subTotal: 9250.0,
        cgst: 832.5,
        sgst: 832.5,
        totalPayable: 10915.0
      }
    };
  };

  const invoiceData = getInvoiceData();

  const formatCurrency = (amount) => {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      minimumFractionDigits: 2
    }).format(amount);
  };

  return (
    <div className="container py-3">
      <Row className="justify-content-center">
        <Col lg={10} xl={9}>
          {/* Compact Header */}
          <div className="d-flex align-items-center justify-content-center mb-3">
            <div className="bg-primary bg-opacity-10 rounded-circle p-2 me-2">
              <BsReceipt size={20} className="text-primary" />
            </div>
            <h4 className="mb-0 text-primary fw-bold">{t("Invoice Details")}</h4>
          </div>

          {/* Fee Breakdown Card */}
          <Card className="shadow-sm border-0 mb-3" style={{ borderRadius: "12px", overflow: "hidden" }}>
            <Card.Header 
              className="py-2 border-0"
              style={{ background: "linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%)" }}
            >
              <div className="d-flex align-items-center">
                <BsCurrencyRupee size={18} className="text-primary me-2" />
                <h6 className="mb-0 text-dark fw-semibold">{t("Fee Breakdown")}</h6>
                <span className="ms-2 badge bg-primary bg-opacity-10 text-primary">
                  {supervisionAuthority === "iwt" ? t("IWT") : 
                   supervisionAuthority === "classificationSociety" ? t("Classification Society") : 
                   t("Standard")}
                </span>
              </div>
            </Card.Header>

            <Card.Body className="p-0">
              <Table responsive className="mb-0" style={{ fontSize: "0.9rem" }}>
                <tbody>
                  {invoiceData.invoiceBreakupInfo.map((item) => (
                    <React.Fragment key={item.id}>
                      <tr className="border-bottom">
                        <td className="py-3 px-4">
                          <div className="d-flex align-items-center">
                            <div className="me-3">
                              {getIcon(item.label)}
                            </div>
                            <span className="fw-semibold">{t(item.label)}</span>
                          </div>
                        </td>
                        <td className="py-3 px-4 text-end fw-bold text-primary">
                          {item.amount ? formatCurrency(item.amount) : ''}
                        </td>
                      </tr>
                      {item.components && item.components.map((component, idx) => (
                        <tr key={`${item.id}-${idx}`} className="bg-light bg-opacity-30">
                          <td className="py-2 px-4 ps-5">
                            <div className="d-flex align-items-center">
                              <div className="me-3">
                                <div className="bg-secondary bg-opacity-20 rounded-circle" style={{ width: "6px", height: "6px" }}></div>
                              </div>
                              <small className="text-muted">{t(component.name)}</small>
                            </div>
                          </td>
                          <td className="py-2 px-4 text-end">
                            <small className="text-muted fw-medium">{formatCurrency(component.amount)}</small>
                          </td>
                        </tr>
                      ))}
                    </React.Fragment>
                  ))}
                </tbody>
              </Table>
            </Card.Body>
          </Card>

          {/* Summary Card */}
          <Card className="shadow-sm border-0" style={{ borderRadius: "12px" }}>
            <Card.Body className="p-4">
              <div className="text-center mb-3">
                <div className="bg-success bg-opacity-10 rounded-circle d-inline-flex p-3 mb-2">
                  <BsCurrencyRupee size={24} className="text-success" />
                </div>
                <h6 className="text-success fw-bold mb-0">{t("Payment Summary")}</h6>
              </div>
              
              <div className="bg-light bg-opacity-50 rounded p-3">
                <div className="d-flex justify-content-between py-2">
                  <span className="text-muted">{t("Sub Total")}:</span>
                  <span className="fw-semibold">{formatCurrency(invoiceData.summary.subTotal)}</span>
                </div>
                <div className="d-flex justify-content-between py-2">
                  <span className="text-muted">{t("CGST")} (9%):</span>
                  <span className="fw-semibold">{formatCurrency(invoiceData.summary.cgst)}</span>
                </div>
                <div className="d-flex justify-content-between py-2 border-bottom">
                  <span className="text-muted">{t("SGST")} (9%):</span>
                  <span className="fw-semibold">{formatCurrency(invoiceData.summary.sgst)}</span>
                </div>
                <div className="d-flex justify-content-between py-3">
                  <span className="fw-bold fs-5 text-dark">{t("Total Payable")}:</span>
                  <span className="fw-bold fs-4 text-success">{formatCurrency(invoiceData.summary.totalPayable)}</span>
                </div>
              </div>
            </Card.Body>
          </Card>
        </Col>
      </Row>
    </div>
  );
};

export default Invoicing;
