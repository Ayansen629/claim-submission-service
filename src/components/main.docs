import React, { useState } from "react";
import { Row, Col, Table, Form } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import Collapsible from "../../../../common/Collapsible.js";
import { FaFire, FaCog, FaCompass, FaUsers, FaShieldAlt, FaBolt, FaHome } from "react-icons/fa";

const VesselEquipmentForm = ({ formMethods, viewMode = false, editMode = false }) => {
  const { t } = useTranslation();
  const { register, watch, setValue, formState: { errors } } = formMethods;

  const [equipmentData, setEquipmentData] = useState({
    fireFighting: {
      fireFightingPlan: { number: "", type: "", location: "", condition: "", remarks: "" },
      firePumpsMech: { number: "", type: "", location: "", condition: "", remarks: "" },
      firePumpsHand: { number: "", type: "", location: "", condition: "", remarks: "" },
      portableExtinguishers: { number: "", type: "", location: "", condition: "", remarks: "" },
      fixedExtinguishing: { number: "", type: "", location: "", condition: "", remarks: "" },
      fireBuckets: { number: "", type: "", location: "", condition: "", remarks: "" },
      sandBoxes: { number: "", type: "", location: "", condition: "", remarks: "" },
      hydrants: { number: "", type: "", location: "", condition: "", remarks: "" },
      hosesAndFittings: { number: "", type: "", location: "", condition: "", remarks: "" }
    },
    equipment: {
      anchors: { number: "", type: "", location: "", condition: "", remarks: "" },
      anchorCables: { number: "", type: "", location: "", condition: "", remarks: "" },
      bilgePumps: { number: "", type: "", location: "", condition: "", remarks: "" },
      winches: { number: "", type: "", location: "", condition: "", remarks: "" },
      cranes: { number: "", type: "", location: "", condition: "", remarks: "" },
      derricks: { number: "", type: "", location: "", condition: "", remarks: "" },
      towingEquipment: { number: "", type: "", location: "", condition: "", remarks: "" },
      ropesAndLines: { number: "", type: "", location: "", condition: "", remarks: "" },
      collisionMat: { number: "", type: "", location: "", condition: "", remarks: "" },
      gangway: { number: "", type: "", location: "", condition: "", remarks: "" },
      fenders: { number: "", type: "", location: "", condition: "", remarks: "" },
      boatHook: { number: "", type: "", location: "", condition: "", remarks: "" },
      firstAidKit: { number: "", type: "", location: "", condition: "", remarks: "" },
      binoculars: { number: "", type: "", location: "", condition: "", remarks: "" },
      wasteContainers: { number: "", type: "", location: "", condition: "", remarks: "" },
      heavingLine: { number: "", type: "", location: "", condition: "", remarks: "" },
      axe: { number: "", type: "", location: "", condition: "", remarks: "" },
      torch: { number: "", type: "", location: "", condition: "", remarks: "" }
    },
    navigation: {
      navigationLights: { number: "", type: "", location: "", condition: "", remarks: "" },
      soundSignals: { number: "", type: "", location: "", condition: "", remarks: "" },
      shapes: { number: "", type: "", location: "", condition: "", remarks: "" },
      magneticCompass: { number: "", type: "", location: "", condition: "", remarks: "" },
      classBais: { number: "", type: "", location: "", condition: "", remarks: "" },
      communicationEquipment: { number: "", type: "", location: "", condition: "", remarks: "" },
      nauticalPublications: { number: "", type: "", location: "", condition: "", remarks: "" }
    },
    lifeSaving: {
      lifejackets: { number: "", type: "", location: "", condition: "", remarks: "" },
      liferafts: { number: "", type: "", location: "", condition: "", remarks: "" },
      launchingArrangements: { number: "", type: "", location: "", condition: "", remarks: "" },
      flotationDevices: { number: "", type: "", location: "", condition: "", remarks: "" },
      lifebuoys: { number: "", type: "", location: "", condition: "", remarks: "" },
      flaresParachute: { number: "", type: "", location: "", condition: "", remarks: "" },
      flaresHandHeld: { number: "", type: "", location: "", condition: "", remarks: "" },
      smokeSignals: { number: "", type: "", location: "", condition: "", remarks: "" },
      lifeRaftEquipment: { number: "", type: "", location: "", condition: "", remarks: "" },
      emergencyCommunications: { number: "", type: "", location: "", condition: "", remarks: "" }
    },
    machinery: {
      mainMachinery: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      mainGenerator: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      emergencyGenerator: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      mainSteeringGear: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      auxiliarySteeringGear: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      switchboard: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      shoreConnection: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      batteries: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      signalLightSwitches: { bhp: "", type: "", location: "", condition: "", remarks: "" }
    },
    accommodation: {
      escapeRoutes: { number: "", type: "", location: "", condition: "", remarks: "" },
      washrooms: { number: "", type: "", location: "", condition: "", remarks: "" },
      toilets: { number: "", type: "", location: "", condition: "", remarks: "" },
      galley: { number: "", type: "", location: "", condition: "", remarks: "" },
      messroom: { number: "", type: "", location: "", condition: "", remarks: "" },
      waterTanks: { number: "", type: "", location: "", condition: "", remarks: "" },
      hvac: { number: "", type: "", location: "", condition: "", remarks: "" },
      berthLocker: { number: "", type: "", location: "", condition: "", remarks: "" },
      accessToAccommodation: { number: "", type: "", location: "", condition: "", remarks: "" },
      lighting: { number: "", type: "", location: "", condition: "", remarks: "" },
      machineryGuards: { number: "", type: "", location: "", condition: "", remarks: "" },
      guardRails: { number: "", type: "", location: "", condition: "", remarks: "" },
      nonSlipSurfaces: { number: "", type: "", location: "", condition: "", remarks: "" },
      laddersCompanionways: { number: "", type: "", location: "", condition: "", remarks: "" },
      noiseInsulation: { number: "", type: "", location: "", condition: "", remarks: "" },
      foamFlotation: { number: "", type: "", location: "", condition: "", remarks: "" }
    }
  });

  const [passengerDecks, setPassengerDecks] = useState([
    { deckType: "", size: "", function: "", maxPassengers: "", remarks: "" }
  ]);

  const [freeboardData, setFreeboardData] = useState([
    { minFreeboard: "", passengers: "", cargo: "" }
  ]);

  const handleInputChange = (section, item, field, value) => {
    if (viewMode) return;
    setEquipmentData(prev => ({
      ...prev,
      [section]: {
        ...prev[section],
        [item]: {
          ...prev[section][item],
          [field]: value
        }
      }
    }));
  };

  const renderEquipmentTable = (title, icon, section, data, isNumberField = true) => (
    <Collapsible
      title={
        <>
          {icon}
          <span>{t(title)}</span>
        </>
      }
      openStat={true}
    >
      <div style={{ padding: "1rem", overflowX: "auto" }}>
        <Table striped bordered hover responsive className="mb-0">
          <thead style={{ backgroundColor: "#f8f9fa" }}>
            <tr>
              <th style={{ minWidth: "200px", fontWeight: "600", color: "#2466BF" }}>
                {t("Equipment")}
              </th>
              <th style={{ minWidth: "100px", fontWeight: "600", color: "#2466BF" }}>
                {isNumberField ? t("Number") : t("BHP")}
              </th>
              <th style={{ minWidth: "150px", fontWeight: "600", color: "#2466BF" }}>
                {t("Type")}
              </th>
              <th style={{ minWidth: "150px", fontWeight: "600", color: "#2466BF" }}>
                {t("Location")}
              </th>
              <th style={{ minWidth: "120px", fontWeight: "600", color: "#2466BF" }}>
                {t("Condition")}
              </th>
              <th style={{ minWidth: "200px", fontWeight: "600", color: "#2466BF" }}>
                {t("Remarks")}
              </th>
            </tr>
          </thead>
          <tbody>
            {Object.entries(data).map(([key, item]) => (
              <tr key={key}>
                <td style={{ fontWeight: "500", backgroundColor: "#fafafa" }}>
                  {t(key.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()))}
                </td>
                <td>
                  <Form.Control
                    size="sm"
                    type={isNumberField ? "number" : "text"}
                    value={item[isNumberField ? 'number' : 'bhp']}
                    onChange={(e) => handleInputChange(section, key, isNumberField ? 'number' : 'bhp', e.target.value)}
                    disabled={viewMode}
                    style={{ border: "1px solid #ddd", borderRadius: "4px" }}
                  />
                </td>
                <td>
                  <Form.Control
                    size="sm"
                    type="text"
                    value={item.type}
                    onChange={(e) => handleInputChange(section, key, 'type', e.target.value)}
                    disabled={viewMode}
                    style={{ border: "1px solid #ddd", borderRadius: "4px" }}
                  />
                </td>
                <td>
                  <Form.Control
                    size="sm"
                    type="text"
                    value={item.location}
                    onChange={(e) => handleInputChange(section, key, 'location', e.target.value)}
                    disabled={viewMode}
                    style={{ border: "1px solid #ddd", borderRadius: "4px" }}
                  />
                </td>
                <td>
                  <Form.Select
                    size="sm"
                    value={item.condition}
                    onChange={(e) => handleInputChange(section, key, 'condition', e.target.value)}
                    disabled={viewMode}
                    style={{ border: "1px solid #ddd", borderRadius: "4px" }}
                  >
                    <option value="">Select</option>
                    <option value="Good">Good</option>
                    <option value="Fair">Fair</option>
                    <option value="Poor">Poor</option>
                    <option value="N/A">N/A</option>
                  </Form.Select>
                </td>
                <td>
                  <Form.Control
                    size="sm"
                    type="text"
                    value={item.remarks}
                    onChange={(e) => handleInputChange(section, key, 'remarks', e.target.value)}
                    disabled={viewMode}
                    style={{ border: "1px solid #ddd", borderRadius: "4px" }}
                  />
                </td>
              </tr>
            ))}
          </tbody>
        </Table>
      </div>
    </Collapsible>
  );

  return (
    <form autoComplete="off">
      {/* Fire Fighting Items */}
      {renderEquipmentTable(
        "Fire Fighting Items",
        <FaFire className="me-2" style={{ color: "#2466BF" }} />,
        "fireFighting",
        equipmentData.fireFighting
      )}

      {/* Equipment */}
      {renderEquipmentTable(
        "Equipment",
        <FaCog className="me-2" style={{ color: "#2466BF" }} />,
        "equipment",
        equipmentData.equipment
      )}

      {/* Navigational Equipment */}
      {renderEquipmentTable(
        "Navigational Equipment",
        <FaCompass className="me-2" style={{ color: "#2466BF" }} />,
        "navigation",
        equipmentData.navigation
      )}

      {/* Passenger Location */}
      <Collapsible
        title={
          <>
            <FaUsers className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Location of passengers on specific decks and spaces in maximum loaded condition")}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem", overflowX: "auto" }}>
          <Table striped bordered hover responsive className="mb-0">
            <thead style={{ backgroundColor: "#f8f9fa" }}>
              <tr>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Deck/Space Type")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Size")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Function")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Max. No. of Passenger")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Remarks")}</th>
              </tr>
            </thead>
            <tbody>
              {passengerDecks.map((deck, index) => (
                <tr key={index}>
                  <td>
                    <Form.Control
                      size="sm"
                      type="text"
                      value={deck.deckType}
                      onChange={(e) => {
                        const newDecks = [...passengerDecks];
                        newDecks[index].deckType = e.target.value;
                        setPassengerDecks(newDecks);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <Form.Control
                      size="sm"
                      type="text"
                      value={deck.size}
                      onChange={(e) => {
                        const newDecks = [...passengerDecks];
                        newDecks[index].size = e.target.value;
                        setPassengerDecks(newDecks);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <Form.Control
                      size="sm"
                      type="text"
                      value={deck.function}
                      onChange={(e) => {
                        const newDecks = [...passengerDecks];
                        newDecks[index].function = e.target.value;
                        setPassengerDecks(newDecks);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <Form.Control
                      size="sm"
                      type="number"
                      value={deck.maxPassengers}
                      onChange={(e) => {
                        const newDecks = [...passengerDecks];
                        newDecks[index].maxPassengers = e.target.value;
                        setPassengerDecks(newDecks);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <Form.Control
                      size="sm"
                      type="text"
                      value={deck.remarks}
                      onChange={(e) => {
                        const newDecks = [...passengerDecks];
                        newDecks[index].remarks = e.target.value;
                        setPassengerDecks(newDecks);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                </tr>
              ))}
            </tbody>
          </Table>
        </div>
      </Collapsible>

      {/* Freeboard */}
      <Collapsible
        title={
          <>
            <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Freeboard")}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem", overflowX: "auto" }}>
          <Table striped bordered hover responsive className="mb-0">
            <thead style={{ backgroundColor: "#f8f9fa" }}>
              <tr>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Minimum freeboard")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Number of Passengers")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Cargo (Tonne)")}</th>
              </tr>
            </thead>
            <tbody>
              {freeboardData.map((item, index) => (
                <tr key={index}>
                  <td>
                    <Form.Control
                      size="sm"
                      type="text"
                      value={item.minFreeboard}
                      onChange={(e) => {
                        const newData = [...freeboardData];
                        newData[index].minFreeboard = e.target.value;
                        setFreeboardData(newData);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <Form.Control
                      size="sm"
                      type="number"
                      value={item.passengers}
                      onChange={(e) => {
                        const newData = [...freeboardData];
                        newData[index].passengers = e.target.value;
                        setFreeboardData(newData);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <Form.Control
                      size="sm"
                      type="number"
                      value={item.cargo}
                      onChange={(e) => {
                        const newData = [...freeboardData];
                        newData[index].cargo = e.target.value;
                        setFreeboardData(newData);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                </tr>
              ))}
            </tbody>
          </Table>
        </div>
      </Collapsible>

      {/* Life-Saving Equipment */}
      {renderEquipmentTable(
        "Life-Saving Equipment",
        <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />,
        "lifeSaving",
        equipmentData.lifeSaving
      )}

      {/* Machinery/Electrical */}
      {renderEquipmentTable(
        "Machinery/Electrical",
        <FaBolt className="me-2" style={{ color: "#2466BF" }} />,
        "machinery",
        equipmentData.machinery,
        false
      )}

      {/* Accommodation/Safety */}
      {renderEquipmentTable(
        "Accommodation/Safety",
        <FaHome className="me-2" style={{ color: "#2466BF" }} />,
        "accommodation",
        equipmentData.accommodation
      )}
    </form>
  );
};

export default VesselEquipmentForm;
