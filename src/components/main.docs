
import React, { useState, useEffect, useRef } from "react";
import { Row, Col, Button, Card } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile.tsx";
import InputText from "../../../common/InputText.tsx";
import { renameFile } from "../../../../utils/constants.ts";
import { BsDownload, BsFileEarmarkPdf, BsPlus, BsTrash } from "react-icons/bs";
import { BASE_IP, URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import { postFORMdata } from "../../../../services/http.service.ts";
import { FaTimesCircle } from "react-icons/fa";
import { toast } from "react-toastify";
import NewLoader from "../../../common/NewLoader.js";

const Documents = ({
  formMethods,
  viewMode = false,
  editMode = false,
  vesselRegisData,
  tonnageRequired,
  stabilityRequired,
}) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  const [workOrderFiles, setWorkOrderFiles] = useState([{ id: 1 }]);
  const [drawingsFiles, setDrawingsFiles] = useState([{ id: 1 }]);
  const [regVesselData, setRegVesselData] = useState(vesselRegisData);
  const loaderRef = useRef();

  const {
    register,
    watch,
    setValue,
    clearErrors,
    getValues,
    setError,
    formState: { errors },
    unregister
  } = formMethods;

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach((key) => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  // Initialize files based on mode and existing form data
  useEffect(() => {
    const initializeFiles = () => {
      const workOrderIds = [];
      const drawingIds = [];

      if (viewMode || editMode) {
        // For view/edit mode, check existing files in form data
        for (let i = 1; i <= 50; i++) {
          const workOrderFile = getValues(`WORK_ORDER_file_${i}`);
          const drawingFile = getValues(`DRAWINGS_file_${i}`);

          if (workOrderFile && (workOrderFile.name || workOrderFile.size)) {
            workOrderIds.push({ id: i });
          }
          if (drawingFile && (drawingFile.name || drawingFile.size)) {
            drawingIds.push({ id: i });
          }
        }

        // Set the file arrays based on existing data
        if (workOrderIds.length > 0) {
          setWorkOrderFiles(workOrderIds);
        } else if (editMode) {
          // In edit mode, if no files exist, show empty slots for adding
          setWorkOrderFiles([{ id: 1 }]);
        }

        if (drawingIds.length > 0) {
          setDrawingsFiles(drawingIds);
        } else if (editMode) {
          // In edit mode, if no files exist, show empty slots for adding
          setDrawingsFiles([{ id: 1 }]);
        }
      } else {
        // Normal mode - check for any existing files from navigation
        for (let i = 1; i <= 50; i++) {
          const workOrderFile = getValues(`WORK_ORDER_file_${i}`);
          const drawingFile = getValues(`DRAWINGS_file_${i}`);

          if (workOrderFile && (workOrderFile.name || workOrderFile.size)) {
            workOrderIds.push({ id: i });
          }
          if (drawingFile && (drawingFile.name || drawingFile.size)) {
            drawingIds.push({ id: i });
          }
        }

        if (workOrderIds.length > 0) {
          setWorkOrderFiles(workOrderIds);
        }
        if (drawingIds.length > 0) {
          setDrawingsFiles(drawingIds);
        }
      }
    };

    // Add a small delay to ensure form values are set
    const timer = setTimeout(initializeFiles, 200);
    return () => clearTimeout(timer);
  }, [viewMode, editMode, getValues]);

  // Watch for changes in form values to maintain file state (only in normal mode)
  useEffect(() => {
    if (!viewMode) {
      const subscription = watch((value, { name, type }) => {
        if (name && name.includes('_file_')) {
          const fileType = name.includes('WORK_ORDER') ? 'WORK_ORDER' : 'DRAWINGS';
          const fileId = parseInt(name.split('_').pop());
          
          if (type === 'change' && value[name]) {
            if (fileType === 'WORK_ORDER') {
              setWorkOrderFiles(prev => {
                const exists = prev.some(f => f.id === fileId);
                if (!exists) {
                  return [...prev, { id: fileId }].sort((a, b) => a.id - b.id);
                }
                return prev;
              });
            } else if (fileType === 'DRAWINGS') {
              setDrawingsFiles(prev => {
                const exists = prev.some(f => f.id === fileId);
                if (!exists) {
                  return [...prev, { id: fileId }].sort((a, b) => a.id - b.id);
                }
                return prev;
              });
            }
          }
        }
      });

      return () => subscription.unsubscribe();
    }
  }, [watch, viewMode]);

  const DocumentCard = ({
    fileName,
    description,
    onDownload,
    fileSize,
    onRemove,
    showRemove = false,
  }) => {
    const [isMobile, setIsMobile] = useState(window.innerWidth <= 768);

    useEffect(() => {
      const handleResize = () => setIsMobile(window.innerWidth <= 768);
      window.addEventListener("resize", handleResize);
      return () => window.removeEventListener("resize", handleResize);
    }, []);

    return (
      <Card className="mb-1 border-0 shadow-sm">
        <Card.Body className="p-2">
          <div className="d-flex justify-content-between align-items-center">
            <div
              className="d-flex align-items-center flex-grow-1 me-2"
              style={{ minWidth: 0 }}
            >
              {!isMobile && (
                <div className="bg-danger bg-opacity-10 rounded-circle p-1 me-2 flex-shrink-0">
                  <BsFileEarmarkPdf className="text-danger" size={10} />
                </div>
              )}
              <div style={{ minWidth: 0 }}>
                <div
                  className="text-primary fw-semibold"
                  style={{
                    fontSize: isMobile ? "0.8rem" : "0.7rem",
                    overflow: "hidden",
                    textOverflow: "ellipsis",
                    whiteSpace: "nowrap",
                    lineHeight: "1.3",
                    marginBottom: isMobile ? "0" : "4px",
                  }}
                  title={fileName}
                >
                  {fileName}
                </div>
                {!isMobile && (
                  <>
                    <p
                      className="mb-0 text-muted"
                      style={{
                        fontSize: "0.6rem",
                        overflow: "hidden",
                        textOverflow: "ellipsis",
                        whiteSpace: "nowrap",
                      }}
                    >
                      {description}
                    </p>
                    {fileSize && (
                      <span
                        className="badge bg-light text-dark mt-1"
                        style={{ fontSize: "0.55rem" }}
                      >
                        {(fileSize / 1024 / 1024).toFixed(1)} MB
                      </span>
                    )}
                  </>
                )}
              </div>
            </div>
            <div className="flex-shrink-0">
              <Button
                variant="outline-primary"
                size="sm"
                onClick={() => onDownload(fileName)}
                className="rounded-pill d-flex align-items-center"
                style={{
                  minWidth: "auto",
                  fontSize: "0.6rem",
                  padding: isMobile ? "6px 8px" : "4px 6px",
                }}
              >
                {isMobile && <BsFileEarmarkPdf className="me-1" size={12} />}
                <BsDownload size={isMobile ? 12 : 8} />
                {!isMobile && <span className="ms-1">{t("Download")}</span>}
              </Button>
              {showRemove && (
                <Button
                  variant="outline-danger"
                  size="sm"
                  onClick={onRemove}
                  className="rounded-pill ms-1"
                  style={{ minWidth: "auto", padding: "4px 6px" }}
                >
                  <BsTrash size={8} />
                </Button>
              )}
            </div>
          </div>
        </Card.Body>
      </Card>
    );
  };

  const FileUploadCard = ({
    label,
    name,
    onRemove,
    showRemove = false,
    fileIndex,
  }) => (
    <Card className="mb-2 border-2 border-dashed border-primary border-opacity-25">
      <Card.Body className="p-2">
        <div className="mb-2">
          <div style={{ fontSize: "0.75rem" }}>
            <InputFile
              label={label}
              name={name}
              register={register(name)}
              errors={errors}
              onChange={(e) => {
                if (e?.target?.files && e?.target?.files[0]) {
                  const file = e.target.files[0];

                  if (file.size > 30 * 1024 * 1024) {
                    setError(name, {
                      type: "manual",
                      message: t(
                        "vesselDetails..File size should not exceed 30MB"
                      ),
                    });
                    return;
                  }

                  const extension = file?.name?.substring(
                    file?.name?.lastIndexOf(".")
                  );
                  const fileType = name.includes("WORK_ORDER")
                    ? "WORK_ORDER"
                    : "DRAWINGS";
                  const fileName = `${fileType}_${String(fileIndex).padStart(
                    2,
                    "0"
                  )}${extension}`;
                  file.originalName = fileName;
                  const renamedFile = renameFile(file, fileName);
                  uploadFile(file, name, renamedFile, fileType, fileIndex);
                }
              }}
              watch={watch}
              defaultValue={watch(name)}
              clearErrors={clearErrors}
              accept=".pdf,.jpg,.jpeg,.png"
              className="mobile-file-input"
            />
          </div>
        </div>
        <div className="mb-2">
          <div style={{ fontSize: "0.75rem" }}>
            <InputText
              label={t("vesselDetails.Description")}
              name={name?.replace("_file_", "_desc_")}
              placeholder={t("vesselDetails.Enter file description")}
              register={register(name.replace("_file_", "_desc_"))}
              errors={errors}
              className="mobile-text-input"
            />
          </div>
        </div>
        {showRemove && (
          <div className="text-end">
            <Button
              variant="outline-danger"
              size="sm"
              onClick={onRemove}
              className="rounded-pill"
              style={{ fontSize: "0.65rem", padding: "2px 6px" }}
            >
              <BsTrash className="me-1" size={8} />
              <span className="d-none d-sm-inline">Remove</span>
              <span className="d-sm-none">×</span>
            </Button>
          </div>
        )}
      </Card.Body>
    </Card>
  );

  const FileSection = ({ title, files, type, icon }) => {
    const [isMobile, setIsMobile] = useState(window.innerWidth <= 768);

    useEffect(() => {
      const handleResize = () => setIsMobile(window.innerWidth <= 768);
      window.addEventListener("resize", handleResize);
      return () => window.removeEventListener("resize", handleResize);
    }, []);

    const filesWithData = files.filter((file) => {
      const fileData = watch(`${type}_file_${file.id}`);
      return fileData && (fileData.name || fileData.size);
    });

    return (
      <Card className="h-100 shadow-sm border-0">
        <Card.Header className="bg-light border-0 py-2">
          <div className="d-flex justify-content-between align-items-center">
            <h6
              className="mb-0 text-primary fw-bold d-flex align-items-center"
              style={{ fontSize: isMobile ? "0.8rem" : "0.75rem" }}
            >
              {icon}
              <span className="ms-2">{title}</span>
            </h6>
            <span
              className="badge bg-primary rounded-pill"
              style={{ fontSize: "0.6rem" }}
            >
              {viewMode ? filesWithData.length : files.length} files
            </span>
          </div>
        </Card.Header>

        <Card.Body className="p-1">
          <div
            style={{
              maxHeight: isMobile ? "350px" : "250px",
              overflowY: "auto",
            }}
          >
            {viewMode ? (
              filesWithData.length > 0 ? (
                filesWithData.map((fileInput, index) => {
                  const fileData = watch(`${type}_file_${fileInput.id}`);
                  const descData = watch(`${type}_desc_${fileInput.id}`);

                  return (
                    <DocumentCard
                      key={fileInput.id}
                      fileName={fileData.name}
                      description={descData || `${title} document ${index + 1}`}
                      fileSize={fileData.size}
                      onDownload={() => handleDownload(fileData.name)}
                    />
                  );
                })
              ) : (
                <div className="text-center py-3 text-muted">
                  <div className="bg-light rounded-circle p-2 d-inline-flex mb-2">
                    <BsFileEarmarkPdf size={20} className="opacity-50" />
                  </div>
                  <p className="mb-0" style={{ fontSize: "0.7rem" }}>
                    No files uploaded
                  </p>
                </div>
              )
            ) : (
              files.map((fileInput, idx) => {
                const fileData = watch(`${type}_file_${fileInput.id}`);
                const hasFile = fileData && (fileData.name || fileData.size);
                
                return (
                  <div key={fileInput.id}>
                    {editMode && hasFile ? (
                      // Show existing file in edit mode
                      <DocumentCard
                        fileName={fileData.name}
                        description={watch(`${type}_desc_${fileInput.id}`) || `${title} document ${fileInput.id}`}
                        fileSize={fileData.size}
                        onDownload={() => handleDownload(fileData.name)}
                        onRemove={() => removeFileInput(type, fileInput.id)}
                        showRemove={true}
                      />
                    ) : (
                      // Show upload card for new files or empty slots
                      <FileUploadCard
                        label={`${t("vesselDetails.Choose File")} ${fileInput.id}`}
                        name={`${type}_file_${fileInput.id}`}
                        fileIndex={fileInput.id}
                        onRemove={() => removeFileInput(type, fileInput.id)}
                        showRemove={files.length > 1}
                      />
                    )}
                  </div>
                );
              })
            )}
          </div>
        </Card.Body>

        {!viewMode && (
          <Card.Footer className="bg-light border-0 text-center py-1">
            <Button
              variant="primary"
              size="sm"
              onClick={() => addFileInput(type)}
              className="rounded-pill px-2"
              style={{ fontSize: "0.65rem" }}
            >
              <BsPlus className="me-1" size={10} />
              <span className={isMobile ? "d-none" : ""}>Add {title}</span>
              <span className={isMobile ? "" : "d-none"}>+</span>
            </Button>
          </Card.Footer>
        )}
      </Card>
    );
  };

  const SingleFileSection = ({
    title,
    fileName,
    onDownload,
    fileSize,
    icon,
  }) => (
    <Card className="h-100 shadow-sm border-0">
      <Card.Header className="bg-light border-0 py-2">
        <h6
          className="mb-0 text-primary fw-bold d-flex align-items-center"
          style={{ fontSize: "0.75rem" }}
        >
          {icon}
          <span className="ms-2">{title}</span>
        </h6>
      </Card.Header>
      <Card.Body className="p-2">
        {fileName ? (
          <DocumentCard
            fileName={fileName}
            description={`${title} document`}
            fileSize={fileSize}
            onDownload={() => onDownload(fileName)}
          />
        ) : (
          <div className="text-center py-2 text-muted">
            <div className="bg-light rounded-circle p-2 d-inline-flex mb-2">
              <BsFileEarmarkPdf size={20} className="opacity-50" />
            </div>
            <p className="mb-0" style={{ fontSize: "0.7rem" }}>
              No file uploaded
            </p>
          </div>
        )}
      </Card.Body>
    </Card>
  );

  const addFileInput = (type) => {
    if (viewMode) return;
    
    if (type === "WORK_ORDER") {
      const maxId = workOrderFiles.length > 0 
        ? Math.max(...workOrderFiles.map((f) => f.id)) 
        : 0;
      const newId = maxId + 1;
      setWorkOrderFiles(prev => [...prev, { id: newId }]);
    } else if (type === "DRAWINGS") {
      const maxId = drawingsFiles.length > 0 
        ? Math.max(...drawingsFiles.map((f) => f.id)) 
        : 0;
      const newId = maxId + 1;
      setDrawingsFiles(prev => [...prev, { id: newId }]);
    }
  };

  const removeFileInput = (type, id) => {
    if (viewMode) return;
    
    if (type === "WORK_ORDER") {
      setWorkOrderFiles(prev => prev.filter((file) => file.id !== id));
    } else if (type === "DRAWINGS") {
      setDrawingsFiles(prev => prev.filter((file) => file.id !== id));
    }

    unregister(`${type}_file_${id}`);
    unregister(`${type}_desc_${id}`);
    unregister(`${type}_fileStoreId_${id}`);
    clearErrors([`${type}_file_${id}`, `${type}_desc_${id}`]);
    
    setValue(`${type}_file_${id}`, null);
    setValue(`${type}_desc_${id}`, "");
    setValue(`${type}_fileStoreId_${id}`, null);
  };

  const handleDownload = (fileName) => {
    const link = document.createElement("a");
    link.href = "#";
    link.download = fileName;
    link.click();
  };

  const uploadFile = async (
    file,
    formValueName,
    renamedFile,
    fileType,
    fileIndex
  ) => {
    try {
      loaderRef?.current?.show();
      const formData = new FormData();
      formData.append("file", file);
      const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
      const response = await postFORMdata(uploadUrl, formData);
      const fileStoreId = response?.data?.files[0]?.fileStoreId;

      clearErrors(formValueName);
      setValue(formValueName, renamedFile, { shouldValidate: true });

      if (fileType === 'STABILITY_BOOKLETS' || fileType === 'TONNAGE_BOOKLETS') {
        setValue(fileType + "_fileStoreId", fileStoreId);
      } else {
        setValue(fileType + "_fileStoreId_" + fileIndex, fileStoreId);
        setFormData((prev) => ({
          ...prev,
          [formValueName]: renamedFile,
        }));
      }

      loaderRef?.current?.hide();

    } catch (err) {
      loaderRef?.current?.hide();
      console.error(err);
      setError(formValueName, {
        type: "manual",
        message: t("File upload failed"),
      });
      toast.error("File upload failed...");
    }
  };

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Collapsible title={t("vesselDetails.Documents")} openStat={true}>
        <div style={{ padding: "1rem", backgroundColor: "#f8f9fa" }}>
          <Row className="g-3">
            <Col lg={6} md={12}>
              <FileSection
                title={t("vesselDetails.Work Order")}
                files={workOrderFiles}
                type="WORK_ORDER"
                icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
              />
            </Col>

            <Col lg={6} md={12}>
              <FileSection
                title={t("vesselDetails.Drawings")}
                files={drawingsFiles}
                type="DRAWINGS"
                icon={<BsFileEarmarkPdf className="text-success" size={12} />}
              />
            </Col>

            <Col md={6}>
              {viewMode ? (
                <SingleFileSection
                  title={t("vesselDetails.Tonnage Booklets")}
                  fileName={watch("TONNAGE_BOOKLETS")?.name}
                  fileSize={watch("TONNAGE_BOOKLETS")?.size}
                  onDownload={handleDownload}
                  icon={<BsFileEarmarkPdf className="text-warning" size={12} />}
                />
              ) : (
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-2">
                    <h6
                      className="mb-0 text-primary fw-bold d-flex align-items-center"
                      style={{ fontSize: "0.75rem" }}
                    >
                      <BsFileEarmarkPdf
                        className="text-warning me-2"
                        size={12}
                      />
                      {t("vesselDetails.Tonnage Booklets")}
                    </h6>
                  </Card.Header>
                  <Card.Body className="p-2">
                    <div style={{ fontSize: "0.75rem", display: "flex" }}>
                      <InputFile
                        label={t("vesselDetails.Tonnage Booklets")}
                        required={tonnageRequired}
                        name="TONNAGE_BOOKLETS"
                        register={register("TONNAGE_BOOKLETS")}
                        errors={errors}
                        style={{ width: "100%" }}
                        onChange={(e) => {
                          if (e.target.files && e?.target?.files[0]) {
                            const file = e.target.files[0];
                            if (file.size > 30 * 1024 * 1024) {
                              setError("TONNAGE_BOOKLETS", {
                                type: "manual",
                                message: t("File size should not exceed 30MB"),
                              });
                              return;
                            }
                            const extension = file?.name?.substring(
                              file?.name?.lastIndexOf(".")
                            );
                            const fileName = `Tonnage Booklets${extension}`;
                            file.originalName = fileName;
                            const renamedFile = renameFile(file, fileName);
                            uploadFile(file, "TONNAGE_BOOKLETS", renamedFile, 'TONNAGE_BOOKLETS');
                          }
                        }}
                        watch={watch}
                        accept=".pdf,.jpg,.jpeg,.png"
                        defaultValue={watch("TONNAGE_BOOKLETS")}
                        clearErrors={clearErrors}
                        className="mobile-file-input"
                      />

                      {watch("TONNAGE_BOOKLETS") && !viewMode && (
                        <FaTimesCircle
                          className="text-danger position-relative"
                          style={{
                            top: "3rem",
                            right: "3.5rem",
                            cursor: "pointer",
                          }}
                          size={18}
                          title="Remove file"
                          onClick={() => {
                            clearErrors("TONNAGE_BOOKLETS");
                            setValue("TONNAGE_BOOKLETS", null);
                            setValue("TONNAGE_BOOKLETS_fileStoreId", null);
                          }}
                        />
                      )}
                    </div>
                  </Card.Body>
                </Card>
              )}
            </Col>

            <Col md={6}>
              {viewMode ? (
                <SingleFileSection
                  title={t("vesselDetails.Stability Booklets")}
                  fileName={watch("STABILITY_BOOKLETS")?.name}
                  fileSize={watch("STABILITY_BOOKLETS")?.size}
                  onDownload={handleDownload}
                  icon={<BsFileEarmarkPdf className="text-info" size={12} />}
                />
              ) : (
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-2">
                    <h6
                      className="mb-0 text-primary fw-bold d-flex align-items-center"
                      style={{ fontSize: "0.75rem" }}
                    >
                      <BsFileEarmarkPdf className="text-info me-2" size={12} />
                      {t("vesselDetails.Stability Booklets")}
                    </h6>
                  </Card.Header>
                  <Card.Body className="p-2">
                    <div style={{ fontSize: "0.75rem", display: "flex" }}>
                      <InputFile
                        label={t("vesselDetails.Stability Booklets")}
                        required={stabilityRequired}
                        name="STABILITY_BOOKLETS"
                        register={register("STABILITY_BOOKLETS")}
                        errors={errors}
                        style={{ width: '100%' }}
                        onChange={(e) => {
                          if (e.target.files && e?.target?.files[0]) {
                            const file = e.target.files[0];
                            if (file.size > 30 * 1024 * 1024) {
                              setError("STABILITY_BOOKLETS", {
                                type: "manual",
                                message: t("File size should not exceed 30MB"),
                              });
                              return;
                            }
                            const extension = file?.name?.substring(
                              file?.name?.lastIndexOf(".")
                            );
                            const fileName = `Stability Booklets${extension}`;
                            file.originalName = fileName;
                            const renamedFile = renameFile(file, fileName);
                            uploadFile(file, "STABILITY_BOOKLETS", renamedFile, 'STABILITY_BOOKLETS');
                          }
                        }}
                        watch={watch}
                        accept=".pdf,.jpg,.jpeg,.png"
                        defaultValue={watch("STABILITY_BOOKLETS")}
                        clearErrors={clearErrors}
                        className="mobile-file-input"
                      />

                      {watch("STABILITY_BOOKLETS") && !viewMode && (
                        <FaTimesCircle
                          className="text-danger position-relative"
                          style={{
                            top: "3rem",
                            right: "3.5rem",
                            cursor: "pointer",
                          }}
                          size={18}
                          title="Remove file"
                          onClick={() => {
                            clearErrors("STABILITY_BOOKLETS");
                            setValue("STABILITY_BOOKLETS", null);
                            setValue("STABILITY_BOOKLETS_fileStoreId", null);
                          }}
                        />
                      )}
                    </div>
                  </Card.Body>
                </Card>
              )}
            </Col>

            <Col md={12}>
              <Card className="shadow-sm border-0">
                <Card.Body className="p-3">
                  <div className="d-flex align-items-start">
                    <input
                      type="checkbox"
                      id="termsAccepted"
                      className="me-3 mt-1"
                      {...register("termsAccepted", {
                        required: t("You must accept the terms and conditions"),
                      })}
                      disabled={viewMode}
                      checked={viewMode ? true : watch("termsAccepted")}
                    />
                    <div>
                      <label
                        htmlFor="termsAccepted"
                        className="mb-0 fw-medium"
                        style={{
                          color: "#333",
                          cursor: viewMode ? "default" : "pointer",
                          lineHeight: "1.5",
                          fontSize: "0.85rem",
                        }}
                      >
                        {t(
                          "vesselDetails.I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule."
                        )}
                      </label>
                      {errors.termsAccepted && !viewMode && (
                        <div className="text-danger small mt-2">
                          {t(errors.termsAccepted.message)}
                        </div>
                      )}
                    </div>
                  </div>
                </Card.Body>
              </Card>
            </Col>
          </Row>
        </div>
      </Collapsible>
    </>
  );
};

export default Documents;
