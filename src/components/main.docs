import React, { useEffect, useMemo, useState } from "react";
import { Container, Row, Col, Spinner, Badge, Button, Card } from "react-bootstrap";
import Collapsible from "./formCommon/Collapsible";
import { useFormData } from "../../context/FormDataContext";
import PreviewCard from "../../private/Dashboard/PreviewCard";
import { FaDownload, FaFileUpload } from "react-icons/fa";
import axios from "axios";

const ReviewStep = () => {
  const { formData } = useFormData();
  const [draftResponse, setDraftResponse] = useState(null);
  const [loading, setLoading] = useState(true);
  const [downloading, setDownloading] = useState({});

  // Load draft data from localStorage on mount
  useEffect(() => {
    const savedDraft = localStorage.getItem("draftResponse");
    if (savedDraft) {
      try {
        const parsedDraft = JSON.parse(savedDraft);
        setDraftResponse(parsedDraft);
      } catch (error) {
        console.error("Error parsing draft data:", error);
      }
    }
    setLoading(false);
  }, []);

  // Handle document download
  const handleDownload = async (fileId, fileName) => {
    try {
      setDownloading(prev => ({ ...prev, [fileId]: true }));
      
      const response = await axios.get(
        `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileId}`,
        { responseType: 'blob' }
      );

      const url = window.URL.createObjectURL(new Blob([response.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', fileName || 'document');
      document.body.appendChild(link);
      link.click();
      link.remove();
      
    } catch (error) {
      console.error('Error downloading file:', error);
      alert('Failed to download document');
    } finally {
      setDownloading(prev => ({ ...prev, [fileId]: false }));
    }
  };

  // Format file display with improved design
  const FileDisplay = ({ fileData }) => {
    if (!fileData) return <span className="text-muted">No file uploaded</span>;
    
    const fileName = fileData.fileName || fileData.docName || "Document";
    const fileId = fileData.fileId || fileData.docId;
    
    return (
      <Card className="file-card p-2 mb-2">
        <div className="d-flex justify-content-between align-items-center">
          <div className="d-flex align-items-center">
            <FaFileUpload className="text-primary me-2" />
            <span className="text-truncate" style={{ maxWidth: '150px' }}>{fileName}</span>
          </div>
          <Button 
            variant="outline-primary" 
            size="sm"
            onClick={() => handleDownload(fileId, fileName)}
            disabled={downloading[fileId]}
          >
            {downloading[fileId] ? (
              <Spinner animation="border" size="sm" />
            ) : (
              <FaDownload />
            )}
          </Button>
        </div>
      </Card>
    );
  };

  // Transform the form data for display
  const formattedData = useMemo(() => {
    if (!formData) return null;

    return {
      step1: {
        creditorInfo: {
          "Creditor Legal Name": formData.step1.financialCreditorName,
          "Creditor Email": formData.step1.financialCreditorEmail,
          "Registered Address": (
            <div>
              <div>{formData.step1.addressLine1}</div>
              {formData.step1.addressLine2 && <div>{formData.step1.addressLine2}</div>}
              <div>{`${formData.step1.city}, ${formData.step1.state} - ${formData.step1.pincode}`}</div>
            </div>
          )
        },
        identificationInfo: {
          "Entity Type": formData.step1.identificationType,
          "Registration Details": formData.step1.identificationtype_details?.map(detail => (
            <div key={detail.id} className="mb-3">
              <div><strong>Registration #:</strong> {detail.details}</div>
              <div className="mt-2"><FileDisplay fileData={detail.proof} /></div>
            </div>
          )) || "N/A"
        }
      },
      step2: {
        claimInfo: {
          "Claim Type": formData.step2.claimType,
          "Total Claim Amount (₹)": formData.step2.claimAmount,
          "Security Interest Amount (₹)": formData.step2.securityValue,
          "Guarantee Amount (₹)": formData.step2.guaranteeValue,
          "Principal Borrower": formData.step2.principalBorrowerName1,
          "Borrower Address": formData.step2.principalBorrowerAddress1,
          "Debt Description": formData.step2.debtDetails,
          "Date of Debt": formData.step2.debtDate,
          "Mutual Credit Details": formData.step2.mutualDetails
        },
        bankingInfo: {
          "Account Number": formData.step2.accountNumber,
          "IFSC Code": formData.step2.ifscCode,
          "Bank Name": formData.step2.bankName,
          "Branch Name": formData.step2.branchName,
          "Branch Address": (
            <div>
              <div>{formData.step2.branchAddress.split(',')[0]}</div>
              <div>{`${formData.step2.city}, ${formData.step2.state}`}</div>
              <div>{`District: ${formData.step2.district}`}</div>
            </div>
          )
        }
      },
      step3: {
        signatoryInfo: {
          "Authorized Signatory Name": formData.step3.creditorName,
          "Designation": formData.step3.creditorPosition,
          "Signature": formData.step3.creditorSignatureText,
          "Signatory Address": formData.step3.creditorAddress,
          "Signature Proof": <FileDisplay fileData={formData.step3.signatureFile} />
        }
      },
      step4: {
        verificationDocs: {
          "Identity Proof Type": formData.step4.identityProofType,
          "Identity Document": <FileDisplay fileData={formData.step4.identityProofFile} />,
          "Address Proof Type": formData.step4.addressProofType,
          "Address Document": <FileDisplay fileData={formData.step4.addressProofFile} />
        }
      }
    };
  }, [formData, downloading]);

  if (loading) {
    return (
      <div className="d-flex justify-content-center align-items-center" style={{ height: "100vh" }}>
        <Spinner animation="border" />
      </div>
    );
  }

  if (!formattedData) {
    return (
      <div className="alert alert-info">
        No form data available for review
      </div>
    );
  }

  const renderPreviewSection = (fields) => (
    <Container fluid>
      <Row className="g-3">
        {Object.entries(fields).map(([key, value]) => (
          <Col key={key} xs={12} sm={6} className="mb-3">
            <PreviewCard 
              title={key} 
              value={value} 
            />
          </Col>
        ))}
      </Row>
    </Container>
  );

  const renderCard = (title, fields) => (
    <div className="mb-4">
      <h5 className="section-header">{title}</h5>
      {renderPreviewSection(fields)}
    </div>
  );

  return (
    <div className="form-stepper">
      {draftResponse && (
        <div className="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded">
          <div>
            <span className="text-muted">Application Reference:</span>
            <span className="ms-2 fw-bold">{applicationNumber}</span>
          </div>
          <Badge bg="warning" className="text-dark">
            Draft Application
          </Badge>
        </div>
      )}

      <Collapsible title="1. Creditor Information" defaultOpen>
        {renderCard("Legal Details", formattedData.step1.creditorInfo)}
        {renderCard("Registration Proof", formattedData.step1.identificationInfo)}
      </Collapsible>

      <Collapsible title="2. Claim & Banking Information">
        {renderCard("Claim Details", formattedData.step2.claimInfo)}
        {renderCard("Bank Account Details", formattedData.step2.bankingInfo)}
      </Collapsible>

      <Collapsible title="3. Signatory Authorization">
        {renderCard("Authorized Signatory", formattedData.step3.signatoryInfo)}
      </Collapsible>

      <Collapsible title="4. Document Verification">
        {renderCard("Supporting Documents", formattedData.step4.verificationDocs)}
      </Collapsible>
    </div>
  );
};

export default React.memo(ReviewStep);
