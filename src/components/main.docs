<Dropdown align="end">
  <OverlayTrigger
    placement="top"
    overlay={
      <BSTooltip id={`tooltip-${row?.id}`}>
        More Actions
      </BSTooltip>
    }
  >
    <Dropdown.Toggle
      variant="link"
      id={`dropdown-${row?.id}`}
      className={`${style.dropdownToggle} action-toggle`}
    >
      <ThreeDots size={20} />
    </Dropdown.Toggle>
  </OverlayTrigger>

  <Dropdown.Menu className={`${style.dropdownMenu} shadow-lg`}>
    {(o.actions.includes("edit") || row?.isEditable) && (
      <Dropdown.Item
        onClick={() => handleEdit(row)}
        className={style.dropdownItem}
      >
        <PencilSquare size={16} className={style.dropdownIcon} />
        Edit
      </Dropdown.Item>
    )}

    {o.actions.includes("view") && (
      <Dropdown.Item
        onClick={() => handleView(row)}
        className={style.dropdownItem}
      >
        <FaEye size={16} className={style.dropdownIcon} />
        View
      </Dropdown.Item>
    )}

    {o.actions.includes("delete") && (
      <Dropdown.Item
        onClick={() => handleDeleteRow(row)}
        className={`${style.dropdownItem} ${style.deleteItem}`}
      >
        <FaTrash size={16} className={style.dropdownIcon} />
        Delete
      </Dropdown.Item>
    )}

    {o.actions.includes("download") && (
      <Dropdown.Item
        onClick={() => handleDownload(row)}
        className={style.dropdownItem}
      >
        <FaDownload size={16} className={style.dropdownIcon} />
        Download
      </Dropdown.Item>
    )}

    {o.actions.includes("upload") && (
      <Dropdown.Item
        onClick={() => handleView(row)}
        className={style.dropdownItem}
      >
        <FaUpload size={16} className={style.dropdownIcon} />
        Upload
      </Dropdown.Item>
    )}

    {(o.actions.includes("uploadReports") || row?.isEnableUploadReports) && (
      <Dropdown.Item
        onClick={() => handleUploadReports(row)}
        className={style.dropdownItem}
      >
        <Upload size={16} className={style.dropdownIcon} />
        Upload Reports
      </Dropdown.Item>
    )}

    {(o.actions.includes("vesselRegistration") || row?.isEnableApplicationRegistration) && (
      <Dropdown.Item
        onClick={() => handleVesselRegistration(row)}
        className={style.dropdownItem}
      >
        <FileEarmarkText size={16} className={style.dropdownIcon} />
        Vessel Registration
      </Dropdown.Item>
    )}

    {(o.actions.includes("provisionalCertificate") || row?.isEnableProvisionalCertificate) && (
      <Dropdown.Item
        onClick={() => handleProvisionalCertificate(row)}
        className={style.dropdownItem}
      >
        <Award size={16} className={style.dropdownIcon} />
        Provisional Certificate
      </Dropdown.Item>
    )}

    {o.actions.includes("revisedDrawing") && (
      <Dropdown.Item
        onClick={() => handleRevisedDrawing(row)}
        className={style.dropdownItem}
      >
        <Pencil size={16} className={style.dropdownIcon} />
        Revised Drawing
      </Dropdown.Item>
    )}

    {(o.actions.includes("paySupervisionFee") || !row?.isEnableSupervisionFee) && (
      <Dropdown.Item
        onClick={() => handlePaySupervisionFee(row)}
        className={style.dropdownItem}
      >
        <CreditCard size={16} className={style.dropdownIcon} />
        Pay Supervision Fee
      </Dropdown.Item>
    )}

    {o.actions.includes("applyInitialSurvey") || (row?.enableInitialSurvey && (
      <Dropdown.Item
        onClick={() => handleApplyInitialSurvey(row)}
        className={style.dropdownItem}
      >
        <ClipboardCheck size={16} className={style.dropdownIcon} />
        Apply Initial Survey
      </Dropdown.Item>
    ))}
    
    {row?.isCMNGenerated && (
      <Dropdown.Item
        onClick={() => handleDownloadCMN(row)}
        className={style.dropdownItem}
      >
        <Download size={16} className={style.dropdownIcon} />
        Download CMN
      </Dropdown.Item>
    )}

    {row?.isCMNGenerated && !row.enableInitialSurvey && (
      <Dropdown.Item
        onClick={() => handleSlotBooking(row)}
        className={style.dropdownItem}
      >
        <Calendar2Check size={16} className={style.dropdownIcon} />
        Slot Booking
      </Dropdown.Item>
    )}
  </Dropdown.Menu>
</Dropdown>
