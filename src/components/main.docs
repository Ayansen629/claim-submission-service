import React, { useCallback, useState, useEffect } from "react";
import { useForm, FormProvider, Controller } from "react-hook-form";
import DatePicker from "react-datepicker";
import "react-datepicker/dist/react-datepicker.css";
import Collapsible from "../formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip";
import { FaInfoCircle } from "react-icons/fa";
import { uploadDocument } from "../../../../services/documentUploadService";

// ... (keep all the existing imports and DynamicField component as is)

const FormCDetails = ({ provideSubmitHandler, formData }) => {
  const [isUploading, setIsUploading] = useState(false);
  const [uploadError, setUploadError] = useState(null);
  const [selectedClaimType, setSelectedClaimType] = useState("");
  
  const methods = useForm();
  const { register, handleSubmit, formState: { errors }, trigger, clearErrors, setValue, control, getValues, watch, reset } = methods;

  // Claim type options for checkboxes
  const claimTypeOptions = [
    { value: "principalBorrower", label: "Corporate Debtor as Principal Borrower" },
    { value: "beneficiary", label: "Corporate Debtor as Beneficiary" },
    { value: "guarantor", label: "Corporate Debtor as Guarantor" },
  ];

  // Handle checkbox change
  const handleClaimTypeChange = (value) => {
    setSelectedClaimType(value);
    setValue("claimType", value);
    
    // Reset all fields except claimType when changing claim type
    const currentValues = getValues();
    reset({ claimType: value });
  };

  // ... (keep all other existing functions and effects as is)

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        {/* Claim Type Selection - Now using checkboxes */}
        <div className="mb-4 bg-light">
          <div className="flex-item">
            <label className="checkbox-group-label">
              Select Claim Type <span className="required-asterisk">*</span>
            </label>
            <div className="checkbox-group">
              {claimTypeOptions.map((option) => (
                <div key={option.value} className="checkbox-item">
                  <input
                    type="checkbox"
                    id={`claimType-${option.value}`}
                    checked={selectedClaimType === option.value}
                    onChange={() => handleClaimTypeChange(option.value)}
                    className={`form-checkbox ${errors.claimType ? "input-error" : ""}`}
                  />
                  <label htmlFor={`claimType-${option.value}`}>
                    {option.label}
                  </label>
                </div>
              ))}
            </div>
            <input
              type="hidden"
              {...register("claimType", { required: "Claim type is required" })}
            />
            {errors.claimType && <p className="error-message">{errors.claimType.message}</p>}
          </div>
        </div>

        {/* ... (keep all the rest of the JSX as is) */}
      </form>
    </FormProvider>
  );
};

export default FormCDetails;

.checkbox-group-label {
  display: block;
  margin-bottom: 8px;
  font-weight: bold;
}

.checkbox-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.checkbox-item {
  display: flex;
  align-items: center;
  gap: 8px;
}

.form-checkbox {
  width: 16px;
  height: 16px;
  accent-color: #4CAF50; /* Green color for checked state */
}

.form-checkbox.input-error {
  outline: 2px solid #f44336; /* Red outline for error state */
}
