const getStatusColor = (status) => {
  switch (status?.toLowerCase()) {
    case 'draft':
      return '#95a5a6'; // Soft gray - neutral for in-progress items
    case 'accepted as contingent':
      return '#e67e22'; // Orange - indicates conditional/temporary state
    case 'sent back':
      return '#e74c3c'; // Vibrant red - requires attention
    case 'pending':
      return '#f39c12'; // Gold/yellow - waiting state
    case 'approved by rp':
      return '#27ae60'; // Green - success/completion
    case 'rejected':
      return '#c0392b'; // Dark red - clear negative outcome
    default:
      return '#bdc3c7'; // Light gray - neutral default
  }
};
