<Col md={6}>
  {viewMode ? (
    watch("authLetter") && watch("authLetter").name ? (
      <div className="mb-3">
        <label className="form-label fw-bold">
          {t("Authorization Letter")}
        </label>
        <div
          className="p-3 border rounded bg-light"
          style={{ backgroundColor: "#f8f9fa" }}
        >
          <div className="d-flex justify-content-between align-items-center">
            <div className="flex-grow-1 me-2">
              <div className="fw-semibold text-primary mb-1" style={{ fontSize: "0.9rem" }}>
                {watch("authLetter").name}
              </div>
              <small className="text-muted">
                {((watch("authLetter").size || 0) / 1024 / 1024).toFixed(1)} MB
              </small>
            </div>
            <button
              type="button"
              className="btn btn-outline-primary btn-sm d-flex align-items-center"
              onClick={() => handleDownload(watch("authLetter").name)}
            >
              <BsDownload size={14} className="me-1" />
              <span className="d-none d-sm-inline">{t("Download")}</span>
            </button>
          </div>
        </div>
      </div>
    ) : (
      <div className="mb-3">
        <label className="form-label fw-bold">{t("Authorization Letter")}</label>
        <div className="p-3 border rounded bg-light text-muted text-center">
          {t("No file uploaded")}
        </div>
      </div>
    )
  ) : (
    <div className="mb-2">
      <InputFile
        label={t("Authorization Letter")}
        required={true}
        name="authLetter"
        register={register("authLetter", {
          required: t("Authorization Letter is required"),
        })}
        errors={errors}
        onChange={(e) => {
          if (viewMode) return;
          if (e.target.files && e?.target?.files[0]) {
            handleFileChange("authLetter", e.target.files[0]);
          }
        }}
        disabled={viewMode}
        watch={watch}
        defaultValue={watch("authLetter")}
        clearErrors={clearErrors}
        accept=".pdf,.jpg,.jpeg,.png"
      />
    </div>
  )}
</Col>
