.application-container {
  min-height: 100vh;
  background: #f8fafc;
  padding: 1rem;
}

.application-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  background: white;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.application-header {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  padding: 1.5rem 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: white;
}

.header-left .back-button {
  background: rgba(255, 255, 255, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: white;
  padding: 0.5rem 1rem;
  border-radius: 25px;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-weight: 500;
  font-size: 0.9rem;
  transition: all 0.3s ease;
}

.back-button:hover {
  background: rgba(255, 255, 255, 0.25);
}

.header-center {
  flex: 1;
  text-align: center;
}

.application-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
}

.application-title {
  font-size: 1.5rem;
  font-weight: 700;
  margin: 0;
}

.application-number {
  background: rgba(255, 255, 255, 0.15);
  padding: 0.5rem 1.5rem;
  border-radius: 25px;
  font-size: 0.9rem;
}

.number-label {
  opacity: 0.9;
  margin-right: 0.5rem;
}

.number-value {
  font-weight: 700;
  background: rgba(255, 255, 255, 0.2);
  padding: 0.25rem 0.75rem;
  border-radius: 15px;
  margin-left: 0.5rem;
}

.status-badge {
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-weight: 600;
  font-size: 0.85rem;
}

.application-content {
  padding: 2rem;
}

.progress-stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2rem;
  padding: 1.5rem;
  background: #f8fafc;
  border-radius: 12px;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
}

.step-number {
  width: 45px;
  height: 45px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.9rem;
  margin-bottom: 0.75rem;
  transition: all 0.3s ease;
  background: white;
  color: #64748b;
  border: 2px solid #e2e8f0;
}

.step-item.active .step-number {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  color: white;
  border-color: #1e40af;
  transform: scale(1.05);
}

.step-item.completed .step-number {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: white;
  border-color: #10b981;
}

.step-title {
  font-size: 0.8rem;
  font-weight: 600;
  color: #64748b;
  text-align: center;
  max-width: 120px;
  line-height: 1.2;
}

.step-item.active .step-title {
  color: #1e40af;
  font-weight: 700;
}

.step-item.completed .step-title {
  color: #10b981;
  font-weight: 700;
}

.step-line {
  flex: 1;
  height: 3px;
  background: #e2e8f0;
  margin: 0 1.5rem;
  border-radius: 2px;
  position: relative;
}

.step-line.completed::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
  background: linear-gradient(90deg, #10b981 0%, #3b82f6 100%);
  border-radius: 2px;
}

.form-container {
  background: white;
  border-radius: 12px;
  padding: 2rem;
  border: 1px solid #f1f5f9;
}

.form-content {
  margin-bottom: 2rem;
}

/* Compact Form Field Styles */
.text-field {
  margin-bottom: 1.25rem;
}

.form-label {
  display: block;
  font-weight: 600;
  color: #374151;
  margin-bottom: 0.5rem;
  font-size: 0.875rem;
}

.disabled-field {
  background: #f8fafc !important;
  border: 1px solid #e2e8f0 !important;
  border-radius: 8px !important;
  color: #374151 !important;
  font-weight: 500;
  font-size: 0.875rem;
  padding: 0.75rem !important;
  transition: all 0.3s ease;
}

.disabled-field:focus {
  border-color: #cbd5e1 !important;
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.1) !important;
}

/* Compact File Field Styles */
.file-field {
  margin-bottom: 1.25rem;
}

.field-label {
  display: block;
  font-weight: 600;
  color: #374151;
  margin-bottom: 0.5rem;
  font-size: 0.875rem;
}

.file-display {
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 1rem;
  background: #f8fafc;
  transition: all 0.3s ease;
}

.file-display:hover {
  border-color: #cbd5e1;
}

.no-file {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  color: #9ca3af;
  font-size: 0.875rem;
  padding: 1.5rem;
  background: #f9fafb;
  border-radius: 6px;
  border: 1px dashed #d1d5db;
}

.file-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.75rem;
  background: white;
  border-radius: 6px;
  border: 1px solid #f3f4f6;
}

.file-info {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex: 1;
  min-width: 0;
}

.file-icon {
  color: #3b82f6;
  flex-shrink: 0;
}

.file-name {
  font-weight: 600;
  color: #374151;
  font-size: 0.875rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-actions {
  display: flex;
  gap: 0.5rem;
  flex-shrink: 0;
}

.file-btn {
  padding: 0.375rem 0.75rem;
  border-radius: 6px;
  border: 1px solid;
  transition: all 0.3s ease;
  font-weight: 600;
  font-size: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.375rem;
}

.view-btn {
  border-color: #3b82f6;
  color: #3b82f6;
  background: rgba(59, 130, 246, 0.05);
}

.view-btn:hover {
  background: #3b82f6;
  color: white;
}

.download-btn {
  border-color: #10b981;
  color: #10b981;
  background: rgba(16, 185, 129, 0.05);
}

.download-btn:hover {
  background: #10b981;
  color: white;
}

.form-navigation {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1.5rem;
  border-top: 1px solid #f1f5f9;
}

.nav-button {
  padding: 0.75rem 1.5rem;
  border-radius: 25px;
  font-weight: 600;
  font-size: 0.875rem;
  transition: all 0.3s ease;
  border: 1px solid;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.prev-button {
  border-color: #6b7280;
  color: #6b7280;
  background: white;
}

.prev-button:hover:not(:disabled) {
  background: #6b7280;
  color: white;
}

.prev-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.next-button {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  border-color: #1e40af;
  color: white;
}

.next-button:hover {
  background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
}

.action-button {
  padding: 0.75rem 1.5rem;
  border-radius: 25px;
  font-weight: 600;
  font-size: 0.875rem;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-color: #10b981;
}

.action-button:hover {
  background: linear-gradient(135deg, #059669 0%, #047857 100%);
}

/* Responsive Design */
@media (max-width: 768px) {
  .application-container {
    padding: 0.5rem;
  }
  
  .application-header {
    padding: 1rem;
    flex-direction: column;
    gap: 1rem;
  }
  
  .application-title {
    font-size: 1.25rem;
  }
  
  .application-content {
    padding: 1.5rem;
  }
  
  .progress-stepper {
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem 1rem;
  }
  
  .step-line {
    width: 3px;
    height: 2rem;
    margin: 0;
  }
  
  .form-container {
    padding: 1.5rem;
  }
  
  .form-navigation {
    flex-direction: column;
    gap: 1rem;
  }
  
  .nav-button {
    width: 100%;
    justify-content: center;
  }
  
  .file-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  
  .file-actions {
    align-self: stretch;
    justify-content: flex-end;
  }
}

@media (max-width: 576px) {
  .application-header {
    padding: 0.75rem;
  }
  
  .application-content {
    padding: 1rem;
  }
  
  .form-container {
    padding: 1rem;
  }
  
  .step-number {
    width: 40px;
    height: 40px;
  }
  
  .step-title {
    font-size: 0.75rem;
    max-width: 100px;
  }
}
