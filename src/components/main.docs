import React, { useState } from "react";
import { Link, useLocation, useNavigate } from "react-router-dom";
import Dropdown from "react-bootstrap/Dropdown";
import { FaBars, FaGlobe, FaKey } from "react-icons/fa";
import GovtLogo from "../../assets/images/GovtLogo.png";
import ProfileImg from "../../assets/images/Profile.png";
import InlandWaterTransport from "../../assets/images/Inland-Water-Transport.jpg";
import { useLanguageContext } from "./LanguageContext";
import { useTranslation } from "react-i18next";
import styles from "./styles/Header.module.css";
import "./styles/ChangePassword.css";
import IWT_Icon from "../../assets/images/IWT_Icon.jpg";
import { clearAppStorage } from "../../utils/constants.ts";
import ChangePassword from "./ChangePassword";

const Header = ({ toggleSidebar, onLogout, isSidebarOpen }) => {
  
  const { changeLanguage } = useLanguageContext();
  const navigate = useNavigate();
  const { t } = useTranslation();
  const [showChangePassword, setShowChangePassword] = useState(false);

  const doLogout = () => {
      clearAppStorage();
      navigate("/");
  }

  return (
    <>
    <nav className={`navbar navbar-expand-lg ${styles.customNavbar} fixed-top px-3`}>
      <div className="d-flex align-items-center gap-2 flex-shrink-0">
        <img
          src={IWT_Icon}
          alt="IWT Logo"
          className={`img-fluid ${styles.mobileLogo}`}
          style={{ height: "3rem", borderRadius: "5px" }}
        />
        
        <button
          className={`btn text-white me-2 ${styles.sidebarToggle}`}
          onClick={toggleSidebar}
          aria-label="Toggle Sidebar"
        >
          <FaBars />
        </button>
        
        {isSidebarOpen && (
          <svg width="100%" height="43px" viewBox="0 0 800 200" xmlns="http://www.w3.org/2000/svg" className="d-none d-md-block">
            <rect width="800" height="200" fill="#2466BF" />
            <text x="50%" y="90" dominantBaseline="middle" textAnchor="middle"
                  fontSize="69" fill="white" fontFamily="Segoe UI, sans-serif">
              {t("Inland Water Transport")}
            </text>
            <text x="50%" y="140" dominantBaseline="middle" textAnchor="middle"
                  fontSize="30" fill="white" fontFamily="Segoe UI, sans-serif">
              {t("Transport Department, Government of West Bengal")}
            </text>
          </svg>
        )}
      </div>

      <div className={`${styles.flexGrow1} d-none d-md-block`}></div>

      <div className={styles.headerRight}>
        <Dropdown>
          <Dropdown.Toggle
            variant="link"
            className={`text-white nav-link p-0 d-flex align-items-center gap-1 ${styles.languageDropdown}`}
          >
            <FaGlobe />
          </Dropdown.Toggle>
          <Dropdown.Menu className={styles.dropdownMenu}>
            <Dropdown.Item className={styles.dropdownItem} onClick={() => changeLanguage("en")}>
              English
            </Dropdown.Item>
            <Dropdown.Item className={styles.dropdownItem} onClick={() => changeLanguage("bn")}>
              Bengali
            </Dropdown.Item>
          </Dropdown.Menu>
        </Dropdown>
        
        <Dropdown align="end">
          <Dropdown.Toggle
            variant="link"
            className="d-flex align-items-center text-white nav-link p-0"
          >
            <img
              src={ProfileImg}
              alt="Profile"
              className={`rounded-circle ${styles.profileImg}`}
              style={{ width: "40px", height: "40px" }}
            />
          </Dropdown.Toggle>
          <Dropdown.Menu className={styles.dropdownMenu}>
            <Dropdown.Item className={styles.dropdownItem} as={Link} to="/profile">{t("Profile")}</Dropdown.Item>
            <Dropdown.Item className={styles.dropdownItem} onClick={() => setShowChangePassword(true)}>
              <FaKey className="me-2" /> {t("Change Password")}
            </Dropdown.Item>
            <Dropdown.Divider />
            <Dropdown.Item className={`${styles.dropdownItem} text-danger`} onClick={doLogout}>{t("Logout")}</Dropdown.Item>
          </Dropdown.Menu>
        </Dropdown>
        
        <img
          src={GovtLogo}
          alt="Govt Logo"
          className={`rounded-circle d-none d-sm-block ${styles.govtLogo}`}
          style={{ width: "3.5rem", height: "3.5rem" }}
        />
      </div>
    </nav>
    
    <ChangePassword 
      show={showChangePassword} 
      onHide={() => setShowChangePassword(false)} 
    />
    </>
  );
};

export default Header;
