const validateDocuments = async () => {
  const values = methods.getValues();
  
  // Check if files are actually uploaded
  const hasTonnageBooklets = !!values.tonnageBooklets;
  const hasStabilityBooklets = !!values.stabilityBooklets;
  const hasAuthLetter = values.constructedBy !== "2" || !!values.authLetter;
  const hasTermsAccepted = !!values.termsAccepted;

  // Clear all errors first
  methods.clearErrors("tonnageBooklets");
  methods.clearErrors("stabilityBooklets");
  methods.clearErrors("authLetter");
  methods.clearErrors("termsAccepted");

  if (!hasTonnageBooklets) {
    methods.setError("tonnageBooklets", {
      type: "required",
      message: "Tonnage Booklets are required"
    });
  }

  if (!hasStabilityBooklets) {
    methods.setError("stabilityBooklets", {
      type: "required",
      message: "Stability Booklets are required"
    });
  }

  if (values.constructedBy === "2" && !hasAuthLetter) {
    methods.setError("authLetter", {
      type: "required",
      message: "Authorization Letter is required"
    });
  }

  if (!hasTermsAccepted) {
    methods.setError("termsAccepted", {
      type: "required",
      message: "You must accept the terms and conditions"
    });
  }

  return hasTonnageBooklets && hasStabilityBooklets && hasAuthLetter && hasTermsAccepted;
};
