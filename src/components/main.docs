.iwt-homepage {
  font-size: 1rem;
  line-height: 1.5;
}

#quick-links-dropdown .dropdown-item {
  background: red;
}

.zoom-responsive-title {
  font-size: clamp(1.5rem, 3vw, 2.5rem);
}

.stat-label {
  color: white !important;
}

/* Icon container fixes */
.icon-container {
  width: 50px;
  height: 50px;
  min-width: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f7ff;
  border-radius: 8px;
  padding: 10px;
}

.icon-container img,
.service-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.nav-icon {
  width: 24px;
  height: 24px;
}

/* Service card fixes */
.service-card {
  height: 80%;
  padding: 1.25rem;
  margin-bottom: 1rem;
  display: flex;
}

.service-card .card-body {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* Container width */
@media (min-width: 1200px) {
  .container-fluid {
    max-width: 1600px;
  }
}

/* High DPI screen adjustments */
@media screen and (min-resolution: 1.5dppx) {
  .iwt-homepage {
    font-size: 0.9em;
  }

  .service-card {
    margin-bottom: 1.5em;
  }

  .icon-container {
    width: 3.5em;
    height: 3.5em;
  }
}

/* Bootstrap overrides */
.row {
  --bs-gutter-x: 1.5rem;
  margin-right: calc(-0.5 * var(--bs-gutter-x));
  margin-left: calc(-0.5 * var(--bs-gutter-x));
}

[class*="col"] {
  padding-right: calc(var(--bs-gutter-x) * 0.5);
  padding-left: calc(var(--bs-gutter-x) * 0.5);
}

/* Image container fixes */
.vessel-image-container,
.survey-image-container {
  height: 94%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.vessel-image-container img,
.survey-image-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Button styling */
.btn {
  font-size: 0.9em;
  padding: 0.5em 1.2em;
  border-radius: 0.5em;
}

/* Hero banner */
.hero-banner .carousel-item img {
  height: 600px;
  object-fit: cover;
}

.carousel-item {
  height: 600px;
}

.carousel-item img {
  height: 100%;
  object-fit: cover;
}

.hero-banner::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.transparent-navbar {
  padding: 5px 0;
  background: linear-gradient(135deg, #00429c, #4695ff);
}

.navbar-logo {
  width: 50px;
  height: 50px;
  margin-right: 10px;
}

.hero-content {
  position: absolute;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: center;
  padding: 60px 0;
  bottom: 10%;
  left: 5%;
  color: white;
}

.hero-content h1 {
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 20px;
}

.hero-content .lead {
  font-size: 1.25rem;
  max-width: 600px;
}

/* Stats section with gradient */
.stats-section {
  background: #f8f9fa;
}

.stat-card {
  border: none;
  border-radius: 10px;
  transition: transform 0.3s;
  background: linear-gradient(135deg, #00429c, #4695ff);
  height: 100%;
}

.stat-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
}

.stat-value,
.stat-label,
.stat-description {
  color: #fff;
}

.stat-value {
  font-weight: 700;
  font-size: 2.5rem;
}

.stat-label {
  font-weight: 600;
}

.stat-description {
  font-size: 0.9rem;
}

/* Section styling */
.section-header {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
}

.section-title {
  font-weight: 700;
  color: #333;
  margin-bottom: 15px;
}

.section-description {
  color: #666;
  font-size: 1.1rem;
}

/* Service cards */
.service-card {
  border: none;
  border-radius: 10px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s;
}

.service-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
}

.service-icon {
  width: 50px;
  height: 50px;
  min-width: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f7ff;
  border-radius: 8px;
  padding: 10px;
  flex-shrink: 0;
}

.service-title {
  font-size: 1rem;
  font-weight: 600;
  color: #333;
}

.service-description {
  font-size: 0.85rem;
  color: #666;
}

.service-link img {
  width: 20px;
  height: 20px;
}

.content-wrapper {
  height: 100%;
}

/* Quick action cards */
.quick-action-card {
  border: none;
  border-radius: 10px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
}

.quick-action-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
}

.action-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 80px;
  height: 80px;
  background: #f0f7ff;
  border-radius: 50%;
  margin: 0 auto;
}

.action-title {
  font-weight: 600;
  color: #333;
}

.action-btn {
  border-radius: 20px;
  padding: 8px 25px;
  font-weight: 500;
}

/* Map container */
.map-container {
  height: 400px;
  background: #f5f5f5;
}

.map-container img {
  height: 100%;
  object-fit: cover;
  max-height: 400px;
}

/* Social and news cards */
.social-card,
.news-card {
  border: none;
  border-radius: 10px;
}

.social-icon {
  width: 40px;
  height: 40px;
}

.news-item {
  padding: 10px 0;
}

.news-text {
  font-size: 0.9rem;
  margin-right: 10px;
}

.news-date {
  font-size: 0.8rem;
}

/* Footer styling */
.footer {
  background: linear-gradient(135deg, #00429c, #4695ff);
}

.footer-heading {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 20px;
  position: relative;
  padding-bottom: 10px;
}

.footer-heading::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 50px;
  height: 2px;
  background: rgba(255, 255, 255, 0.5);
}

.footer-links {
  list-style: none;
  padding: 0;
}

.footer-links li {
  margin-bottom: 10px;
}

.footer-links a {
  color: rgba(255, 255, 255, 0.8);
  text-decoration: none;
  transition: color 0.3s;
}

.footer-links a:hover {
  color: white;
}

.social-icons a {
  display: inline-block;
  width: 36px;
  height: 36px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  text-align: center;
  line-height: 36px;
  transition: background 0.3s;
}

.social-icons a:hover {
  background: rgba(255, 255, 255, 0.2);
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .hero-content h1 {
    font-size: 2.2rem;
  }

  .hero-content .lead {
    font-size: 1rem;
  }

  .section-title {
    font-size: 1.5rem;
  }

  .section-description {
    font-size: 1rem;
  }

  .vessel-image-container,
  .survey-image-container {
    min-height: 300px;
    margin-top: 1rem;
  }

  .social-column:first-child {
    border-right: none;
    border-bottom: 1px solid #dee2e6;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
  }
}

.navbar-nav {
  display: flex;
  align-items: center;
}

.nav-link {
  display: flex;
  align-items: center;
}

.login-btn {
  margin: 0;
  padding: 0.375rem 0.75rem;
}

.login-icon {
  width: 24px;
  height: 24px;
}

.hero-banner-wrapper {
  position: relative;
}

.carousel-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
  pointer-events: none;
}

.transparent-navbar,
.hero-content {
  pointer-events: auto;
}
