import React, { useState, useEffect } from "react";
import { useForm, FormProvider, Controller } from "react-hook-form";
import Collapsible from "../formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip";
import { FaInfoCircle } from "react-icons/fa";
import axios from "axios";

// ... (Existing DynamicField and IFSCSearch components remain unchanged)

const ClaimTypeFields = ({ 
    claimType, 
    control, 
    register, 
    errors, 
    setValue, 
    getValues, 
    watch 
  }) => {
    const [showSecurityFields, setShowSecurityFields] = useState(false);
    const [showGuaranteeFields, setShowGuaranteeFields] = useState(false);
    const [entityFields, setEntityFields] = useState([1]);

    const handleSecurityInterestChange = (value) => {
      setShowSecurityFields(value === "yes");
    };

    const handleGuaranteeChange = (value) => {
      setShowGuaranteeFields(value === "yes");
    };

    const addEntityField = () => {
      setEntityFields([...entityFields, entityFields.length + 1]);
    };

    const removeEntityField = (index) => {
      if (entityFields.length <= 1) return;
      const newFields = [...entityFields];
      newFields.splice(index, 1);
      setEntityFields(newFields);
      // Clear the removed entity's data
      const entityNum = index + 1;
      setValue(`${claimType}Name${entityNum}`, undefined);
      setValue(`${claimType}Address${entityNum}`, undefined);
    };

    // Common fields for all claim types
    const commonClaimFields = [
      {
        name: "claimAmount",
        label: "Amount of claim",
        type: "number",
        rules: { required: "Claim amount is required" },
        placeholder: "Enter claim amount"
      }
    ];

    // Additional fields for principalBorrower and guarantor
    const additionalFields = [
      {
        name: "hasSecurityInterest",
        label: "Amount of claim covered by security interest",
        type: "radio",
        options: [
          { value: "yes", label: "Yes" },
          { value: "no", label: "No" }
        ],
        rules: { required: "This field is required" },
        onChange: handleSecurityInterestChange,
        show: claimType !== "financialDebt"
      },
      {
        name: "securityValue",
        label: "Value of the security",
        type: "number",
        rules: showSecurityFields ? { required: "Security value is required" } : {},
        placeholder: "Enter security value",
        show: showSecurityFields && claimType !== "financialDebt"
      },
      {
        name: "securityDate",
        label: "Date of the security",
        type: "date",
        rules: showSecurityFields ? { required: "Security date is required" } : {},
        placeholder: "Select security date",
        show: showSecurityFields && claimType !== "financialDebt"
      },
      {
        name: "hasGuarantee",
        label: "Amount of claim covered by guarantee",
        type: "radio",
        options: [
          { value: "yes", label: "Yes" },
          { value: "no", label: "No" }
        ],
        rules: { required: "This field is required" },
        onChange: handleGuaranteeChange,
        show: claimType !== "financialDebt"
      },
      {
        name: "guaranteeValue",
        label: "Value of the guarantee",
        type: "number",
        rules: showGuaranteeFields ? { required: "Guarantee value is required" } : {},
        placeholder: "Enter guarantee value",
        show: showGuaranteeFields && claimType !== "financialDebt"
      },
      {
        name: "guaranteeDate",
        label: "Date of the guarantee",
        type: "date",
        rules: showGuaranteeFields ? { required: "Guarantee date is required" } : {},
        placeholder: "Select guarantee date",
        show: showGuaranteeFields && claimType !== "financialDebt"
      }
    ];

    // Determine field labels based on claim type
    const getEntityFieldLabels = () => {
      switch (claimType) {
        case "principalBorrower":
          return {
            nameLabel: "Name of the Guarantee",
            addressLabel: "Address of the Guarantee"
          };
        case "guarantor":
          return {
            nameLabel: "Name of the Principal Borrower",
            addressLabel: "Address of the Principal Borrower"
          };
        case "financialDebt":
          return {
            nameLabel: "Name of the Beneficiary",
            addressLabel: "Address of the Beneficiary"
          };
        default:
          return {
            nameLabel: "Name",
            addressLabel: "Address"
          };
      }
    };

    const { nameLabel, addressLabel } = getEntityFieldLabels();

    return (
      <div className="flex-container">
        {/* Common fields (amount of claim) */}
        {commonClaimFields.map((field) => (
          <DynamicField
            key={field.name}
            fieldConfig={field}
            control={control}
            register={register}
            errors={errors}
            setValue={setValue}
            getValues={getValues}
            watch={watch}
          />
        ))}

        {/* Additional fields for principalBorrower and guarantor */}
        {additionalFields.map((field) => (
          <DynamicField
            key={field.name}
            fieldConfig={field}
            control={control}
            register={register}
            errors={errors}
            setValue={setValue}
            getValues={getValues}
            watch={watch}
          />
        ))}

        {/* Entity fields (Principal Borrower/Guarantee/Beneficiary) */}
        {entityFields.map((entityNum, index) => (
          <React.Fragment key={entityNum}>
            <div className="flex-item-with-button">
              <DynamicField
                fieldConfig={{
                  name: `${claimType}Name${entityNum}`,
                  label: `${nameLabel} ${entityNum}`,
                  type: "text",
                  rules: { required: "This field is required" },
                  placeholder: `Enter ${nameLabel.toLowerCase()}`
                }}
                control={control}
                register={register}
                errors={errors}
                setValue={setValue}
                getValues={getValues}
                watch={watch}
              />
              {index > 0 && claimType === "financialDebt" && (
                <button 
                  type="button" 
                  className="remove-btn"
                  onClick={() => removeEntityField(index)}
                >
                  Remove
                </button>
              )}
            </div>
            <DynamicField
              fieldConfig={{
                name: `${claimType}Address${entityNum}`,
                label: `${addressLabel} ${entityNum}`,
                type: "text",
                rules: { required: "This field is required" },
                placeholder: `Enter ${addressLabel.toLowerCase()}`
              }}
              control={control}
              register={register}
              errors={errors}
              setValue={setValue}
              getValues={getValues}
              watch={watch}
            />
          </React.Fragment>
        ))}
        {claimType === "financialDebt" && (
          <button 
            type="button" 
            className="add-more-btn" 
            onClick={addEntityField}
          >
            + Add Beneficiary
          </button>
        )}
      </div>
    );
  };

const FormCDetails = ({ provideSubmitHandler, formData }) => {
  const methods = useForm();
  const { register, handleSubmit, formState: { errors }, control, setValue, getValues, watch, reset } = methods;
  const [selectedClaimType, setSelectedClaimType] = useState("");

  const bankAccountFields = [
    // ... (Existing bank account fields)
  ];

  const claimTypeOptions = [
    { value: "", label: "Select Claim Type", disabled: true },
    { value: "principalBorrower", label: "Corporate Debtor as Principal Borrower" },
    { value: "guarantor", label: "Corporate Debtor as Guarantor" },
    { value: "financialDebt", label: "Financial Debt Covered" },
  ];

  const onSubmit = (data) => {
    if (provideSubmitHandler) {
      provideSubmitHandler(data);
    }
  };

  useEffect(() => {
    if (formData) {
      reset(formData);
      if (formData.claimType) {
        setSelectedClaimType(formData.claimType);
      }
    }
  }, [formData, reset]);

  const handleClaimTypeChange = (value) => {
    setSelectedClaimType(value);
    // Reset form when claim type changes
    reset({
      claimType: value,
      hasSecurityInterest: "",
      hasGuarantee: ""
    });
  };

  const getClaimTitle = () => {
    switch (selectedClaimType) {
      case "principalBorrower":
        return "Details of claim: Corporate Debtor as Principal Borrower";
      case "guarantor":
        return "Details of claim: Corporate Debtor as Guarantor";
      case "financialDebt":
        return "Details of claim: Financial Debt Covered";
      default:
        return "Details of claim";
    }
  };

  const handleNextClick = () => {
    const isValid = Object.keys(errors).length === 0;
    if (isValid) {
      alert("Form is valid. Proceeding to the next step...");
      // Logic to navigate to the next page
    } else {
      alert("Please fill in all required fields.");
    }
  };

  return (
    <FormProvider {...methods}>
      <form className="form-stepper" onSubmit={handleSubmit(onSubmit)}>
        {/* Claim Type Selection */}
        <div className="mb-4 bg-light">
          <div className="flex-item">
            <label>
              Select Claim Type <span className="required-asterisk">*</span>
            </label>
            <select
              {...register("claimType", { required: "Claim type is required" })}
              className={`form-input ${errors.claimType ? "input-error" : ""}`}
              onChange={(e) => handleClaimTypeChange(e.target.value)}
              value={selectedClaimType}
            >
              {claimTypeOptions.map((option) => (
                <option key={option.value} value={option.value} disabled={option.disabled}>
                  {option.label}
                </option>
              ))}
            </select>
            {errors.claimType && <p className="error-message">{errors.claimType.message}</p>}
          </div>
        </div>

        {/* Claim Details Section */}
        {selectedClaimType && (
          <div className="mb-4 bg-light">
            <Collapsible title={getClaimTitle()}>
              <ClaimTypeFields 
                claimType={selectedClaimType}
                control={control}
                register={register}
                errors={errors}
                setValue={setValue}
                getValues={getValues}
                watch={watch}
              />
            </Collapsible>
          </div>
        )}

        {/* Bank Account Details Section (always shown) */}
        <div className="mb-4 bg-light">
          <Collapsible title="Bank Account Details">
            <div className="flex-container">
              {bankAccountFields.map((field) => (
                field.component ? (
                  <field.component
                    key={field.name}
                    fieldConfig={field}
                    control={control}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    getValues={getValues}
                    watch={watch}
                  />
                ) : (
                  <DynamicField
                    key={field.name}
                    fieldConfig={field}
                    control={control}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    getValues={getValues}
                    watch={watch}
                  />
                )
              ))}
            </div>
          </Collapsible>
        </div>

        {/* Next Button */}
        <div className="next-button-container">
          <button 
            type="button" 
            className="next-btn" 
            onClick={handleNextClick}
          >
            Next
          </button>
        </div>
      </form>
    </FormProvider>
  );
};

export default FormCDetails;
