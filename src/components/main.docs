return (
  <Box sx={{ width: "100%", padding: "1rem" }}>
    <Paper
      elevation={3}
      sx={{
        padding: "0.75rem 1.5rem",
        borderRadius: "0.75rem",
        overflowX: "auto",
        whiteSpace: "nowrap",
        backgroundColor: "#fafafa",
      }}
    >
      <Stack direction="row" alignItems="center" spacing={1}>
        {steps?.map((step, index) => (
          <React.Fragment key={index}>
            <Stack
              direction="row"
              alignItems="center"
              spacing={0.5}
              sx={{ cursor: "pointer" }}
              onClick={() => {
                if (
                  !disableStepNavigation &&
                  (viewMode || completed[index] || editMode)
                ) {
                  goToStep(index);
                }
              }}
            >
              {completed[index] ? (
                <CheckCircleFill size={18} color={successColor} />
              ) : (
                <Typography
                  sx={{
                    fontSize: "0.875rem",
                    width: "1.5rem",
                    height: "1.5rem",
                    textAlign: "center",
                    borderRadius: "50%",
                    backgroundColor: "#e0e0e0",
                    display: "inline-flex",
                    alignItems: "center",
                    justifyContent: "center",
                    fontWeight: "bold",
                    color: "#666",
                  }}
                >
                  {index + 1}
                </Typography>
              )}
              <Typography
                sx={{
                  fontWeight:
                    index === activeStep || completed[index]
                      ? "bold"
                      : "normal",
                  color: index === activeStep ? themeColor : "#999",
                  fontSize: "0.875rem",
                  whiteSpace: "nowrap",
                }}
              >
                {step.label}
              </Typography>
            </Stack>
            {index < steps.length - 1 && (
              <ChevronRight size={14} color="green" />
            )}
          </React.Fragment>
        ))}
      </Stack>
    </Paper>

    {/* Add safety check here */}
    {currentStep ? (
      <Paper
        elevation={2}
        sx={{
          marginTop: "1rem",
          borderRadius: "0.75rem",
          backgroundColor: "#fff",
          width: "100%",
        }}
      >
        {currentStep.component}
        {errors[activeStep]}
      </Paper>
    ) : (
      <Paper
        elevation={2}
        sx={{
          marginTop: "1rem",
          borderRadius: "0.75rem",
          backgroundColor: "#fff",
          width: "100%",
          padding: "2rem",
          textAlign: "center",
        }}
      >
        <Typography>Loading step...</Typography>
      </Paper>
    )}

    <Divider sx={{ margin: "2rem 0" }} />

    <Box
      sx={{
        display: "flex",
        justifyContent: "space-between",
        gap: "1rem",
        flexDirection: { xs: "column", sm: "row" },
        alignItems: { xs: "stretch", sm: "center" },
      }}
    >
      <Button
        variant="outlined"
        onClick={handleBack}
        disabled={activeStep === 0}
        sx={{
          color: themeColor,
          borderColor: themeColor,
          fontWeight: "bold",
          borderRadius: "0.5rem",
          minWidth: { xs: "100%", sm: "8rem" },
          fontSize: "0.9rem",
        }}
      >
        {t("Previous")}
      </Button>

      {currentStep && renderActionButton()}
    </Box>
  </Box>
);
