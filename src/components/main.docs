details
import React, { forwardRef } from "react";
import { useTranslation } from "react-i18next";
import { BsFileEarmarkPdf, BsDownload } from "react-icons/bs";
import { Card, Row, Col, Button } from "react-bootstrap";
import Collapsible from "../../../../common/Collapsible.js";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import { toast } from 'react-toastify';
import axios from "axios";
// import { BASE_IP } from "../../../../../utils/urlsConstants.js";


const VesselBasicDetailsView = forwardRef(({ formData, isPreview = true, registrationData, BASE_IP }, loaderRef) => {
  const { t } = useTranslation();

  const getDisplayData = () => {
    if (!registrationData) {
      return {
        ownerDetails: {},
        vesselDetails: {},
        builderDetails: null,
        documents: {
          workOrderFiles: [],
          drawingFiles: [],
          tonnageBooklets: null,
          stabilityBooklets: null,
          authLetter: null,
        }
      };
    }

    const { basicDetails, vesselDetails } = registrationData;
    
    return {
      ownerDetails: {
        ownerName: basicDetails?.ownerDetails?.ownerCompanyName || "N/A",
        ownerAddress: basicDetails?.ownerDetails ? 
          `${basicDetails.ownerDetails.addressLine1}, ${basicDetails.ownerDetails.addressLine2}` : "N/A",
        mobile: basicDetails?.ownerDetails?.phoneNumber || "N/A",
        email: basicDetails?.ownerDetails?.emailId || "N/A",
        pan: basicDetails?.ownerDetails?.panNo || "N/A",
        aadhar: basicDetails?.ownerDetails?.aadharNumber || "N/A",
        tradeLicence: basicDetails?.ownerDetails?.tradeLicenseNumber || "N/A",
        gst: basicDetails?.ownerDetails?.gstNo || "N/A",
      },
      vesselDetails: {
        grt: vesselDetails?.grossTonnage?.toString() || "N/A",
        workOrderValue: vesselDetails?.workOrderValue || "N/A",
        vesselType: vesselDetails?.typeOfVessel || "N/A",
        category: vesselDetails?.categoryOfVessel || "N/A",
        zone: vesselDetails?.zone || "N/A",
        supervisionAuthority: vesselDetails?.supervisionAuthority || "N/A",
        purchaseType: vesselDetails?.purchaseType || "N/A",
        classificationSociety: vesselDetails?.nameOfClassificationSociety || "N/A",
        constructedBy: basicDetails?.constructedBy || "N/A",
      },
      builderDetails: basicDetails?.builderDetails ? {
        builderName: basicDetails.builderDetails.builderName || "N/A",
        builderAddress: basicDetails.builderDetails ? 
          `${basicDetails.builderDetails.addressLine1}, ${basicDetails.builderDetails.addressLine2}` : "N/A",
        builderEmail: basicDetails.builderDetails.emailId || "N/A",
        builderMobile: basicDetails.builderDetails.phone || "N/A",
        builderTradeLicence: basicDetails.builderDetails.tradeLicenseNumber || "N/A",
        builderGST: basicDetails.builderDetails.gstNo || "N/A",
        builderAuth: basicDetails.builderAuthorization || "N/A",
      } : null,
      documents: {
        workOrderFiles: getWorkOrderFiles(registrationData.documents),
        drawingFiles: getDrawingFiles(registrationData.documents),
        tonnageBooklets: getTonnageBooklets(registrationData.documents),
        stabilityBooklets: getStabilityBooklets(registrationData.documents),
        authLetter: getAuthLetter(registrationData.documents),
      }
    };
  };

  function getWorkOrderFiles(documents) {
    if (!documents) return [];
    return documents
      .filter(doc => doc.documentType === "WORK_ORDER")
      .map(doc => ({
        name: doc.documentName,
        description: doc.description || "Work order document",
        size: "1.2 MB",
        fileStoreId: doc.fileStoreId
      }));
  }

  function getDrawingFiles(documents) {
    if (!documents) return [];
    return documents
      .filter(doc => doc.documentType === "DRAWINGS")
      .map(doc => ({
        name: doc.documentName,
        description: doc.description || "Technical drawing",
        size: "2.1 MB",
        fileStoreId: doc.fileStoreId
      }));
  }

  function getTonnageBooklets(documents) {
    if (!documents) return null;
    const doc = documents.find(d => d.documentType === "TONNAGE_BOOKLETS");
    return doc ? { name: doc.documentName, size: "0.5 MB", fileStoreId: doc.fileStoreId } : null;
  }

  function getStabilityBooklets(documents) {
    if (!documents) return null;
    const doc = documents.find(d => d.documentType === "STABILITY_BOOKLETS");
    return doc ? { name: doc.documentName, size: "0.7 MB", fileStoreId: doc.fileStoreId } : null;
  }

  function getAuthLetter(documents) {
    if (!documents) return null;
    const doc = documents.find(d => d.documentType === "AUTHORIZATION_LETTER");
    return doc ? { name: doc.documentName, size: "0.3 MB", fileStoreId: doc.fileStoreId } : null;
  }

  const previewData = getDisplayData();

  const handleDownload = async (fileStoreId, fileName) => {
    try {
      if (!fileStoreId) return;
      const url = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${fileStoreId}`;

      loaderRef.current?.show();

      const accessToken = getFromLocalStorage("access_token");
      const tokenDetails = getFromLocalStorage("tokenDetails");
      const sessionState = tokenDetails
        ? JSON.parse(tokenDetails)?.session_state
        : "";

      const response = await axios({
        method: "GET",
        url: url,
        responseType: "blob",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "X-Request-ID": sessionState,
          Accept: "application/octet-stream",
        },
      });

      if (response.data) {
        let filename = fileName || "document";
        const contentDisposition = response.headers["content-disposition"];
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(
            /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
          );
          if (filenameMatch && filenameMatch[1]) {
            filename = filenameMatch[1].replace(/['"]/g, "");
          }
        }

        const blob = new Blob([response.data], {
          type: response.headers["content-type"] || "application/octet-stream",
        });
        const blobUrl = window.URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = blobUrl;
        link.setAttribute("download", filename);
        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          window.URL.revokeObjectURL(blobUrl);
        }, 100);
      }
    } catch (error) {
      console.error("Error downloading file:", error);
      toast.error("Failed to download file. Please try again.");
    } finally {
      loaderRef.current?.hide();
    }
  };

  const DocumentCard = ({ fileName, description, fileSize, fileStoreId }) => (
    <Card className="mb-2 border-0 shadow-sm">
      <Card.Body className="p-3">
        <div className="d-flex justify-content-between align-items-center">
          <div className="d-flex align-items-center flex-grow-1">
            <div className="bg-danger bg-opacity-10 rounded-circle p-2 me-3">
              <BsFileEarmarkPdf className="text-danger" size={16} />
            </div>
            <div className="flex-grow-1">
              <h6 className="mb-1 text-primary fw-semibold" style={{ fontSize: "0.75rem" }}>
                {fileName}
              </h6>
              <p className="mb-0 text-muted" style={{ fontSize: "0.7rem" }}>
                {description}
                <span className="ms-2 badge bg-light text-dark" style={{ fontSize: "0.65rem" }}>
                  {fileSize}
                </span>
              </p>
            </div>
          </div>
          <Button
            variant="outline-primary"
            size="sm"
            onClick={() => handleDownload(fileStoreId,fileName)}
            className="rounded-pill"
            style={{ padding: "3px 8px" }}
          >
            <BsDownload size={12} />
          </Button>
        </div>
      </Card.Body>
    </Card>
  );

  return (
    // <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
    //   <Stack spacing={0.5}>
    //     <Typography
    //       sx={{
    //         fontWeight: 550,
    //         color: "#2E57A7",
    //         fontSize: "1.2rem",
    //       }}
    //     >
    //       {t("Vessel Registration Preview")}
    //       &nbsp;
    //       <span style={{ color: "#666", fontSize: "0.65rem" }}>
    //         {t("(Review all vessel registration details before submission)")}
    //       </span>
    //     </Typography>
    //   </Stack>

    // <div className="container py-4">
    <>
      {/* Owner Details Section */}
      <Collapsible title={t("Owner Details")} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <Row>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Name of Owner")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.ownerName}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Address of Owner")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.ownerAddress}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Mobile")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.mobile}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Email Id")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.email}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("PAN")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.pan}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Aadhar")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.aadhar}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Trade Licence")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.tradeLicence}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("GST")}</label>
                <div className="form-control bg-light">{previewData.ownerDetails.gst}</div>
              </div>
            </Col>
          </Row>
        </div>
      </Collapsible>

      {/* Vessel Details Section */}
      <Collapsible title={t("Vessel Details")} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <Row>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Gross Tonnage (GRT)")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.grt}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Work Order Value")}</label>
                <div className="form-control bg-light">Rs. {previewData.vesselDetails.workOrderValue}/-</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Type of Vessel")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.vesselType}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Category")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.category}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Zone")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.zone}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Supervision Authority")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.supervisionAuthority}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Purchase Type")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.purchaseType}</div>
              </div>
            </Col>
            <Col md={8}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Name of the Classification Society")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.classificationSociety}</div>
              </div>
            </Col>
            <Col md={4}>
              <div className="mb-3">
                <label className="form-label fw-semibold">{t("Constructed By")}</label>
                <div className="form-control bg-light">{previewData.vesselDetails.constructedBy}</div>
              </div>
            </Col>
          </Row>
        </div>
      </Collapsible>

      {/* Builder Details Section */}
      {previewData.builderDetails && (
        <Collapsible title={t("Builder Details")} openStat={true}>
          <div style={{ padding: "1rem" }}>
            <Row>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Builder Name")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderName}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Builder Address")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderAddress}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Builder Email Id")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderEmail}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Mobile")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderMobile}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Trade Licence")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderTradeLicence}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("GST")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderGST}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Builder Authorization")}</label>
                  <div className="form-control bg-light">{previewData.builderDetails.builderAuth}</div>
                </div>
              </Col>
              {previewData.documents.authLetter && (
                <Col md={8}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Authorization Letter")}</label>
                    <DocumentCard
                      fileName={previewData.documents.authLetter.name}
                      fileStoreId={previewData.documents.authLetter.fileStoreId}
                      description="Builder authorization document"
                      fileSize={previewData.documents.authLetter.size}
                    />
                  </div>
                </Col>
              )}
            </Row>
          </div>
        </Collapsible>
      )}

      <Collapsible title={t("Documents")} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <Row className="g-4">
            <Col lg={6} md={12}>
              <Card className="h-100 shadow-sm border-0">
                <Card.Header className="bg-light border-0 py-3">
                  <h5 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: "0.8rem" }}>
                    <BsFileEarmarkPdf className="text-primary me-2" size={16} />
                    {t("Work Order")} ({previewData.documents.workOrderFiles.length})
                  </h5>
                </Card.Header>
                <Card.Body className="p-3" style={{ maxHeight: "400px", overflowY: "auto" }}>
                  {previewData.documents.workOrderFiles.map((file, index) => (
                    <DocumentCard
                      key={index}
                      fileName={file.name}
                      fileStoreId={file.fileStoreId}
                      description={file.description}
                      fileSize={file.size}
                    />
                  ))}
                </Card.Body>
              </Card>
            </Col>

            <Col lg={6} md={12}>
              <Card className="h-100 shadow-sm border-0">
                <Card.Header className="bg-light border-0 py-3">
                  <h5 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: "0.8rem" }}>
                    <BsFileEarmarkPdf className="text-success me-2" size={16} />
                    {t("Drawings")} ({previewData.documents.drawingFiles.length})
                  </h5>
                </Card.Header>
                <Card.Body className="p-3" style={{ maxHeight: "400px", overflowY: "auto" }}>
                  {previewData.documents.drawingFiles.map((file, index) => (
                    <DocumentCard
                      key={index}
                      fileName={file.name}
                      fileStoreId={file.fileStoreId}
                      description={file.description}
                      fileSize={file.size}
                    />
                  ))}
                </Card.Body>
              </Card>
            </Col>

            {previewData.documents.tonnageBooklets && (
              <Col md={6}>
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-3">
                    <h5 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: "0.8rem" }}>
                      <BsFileEarmarkPdf className="text-warning me-2" size={16} />
                      {t("Tonnage Booklets")}
                    </h5>
                  </Card.Header>
                  <Card.Body className="p-3">
                    <DocumentCard
                      fileName={previewData.documents.tonnageBooklets.name}
                      fileStoreId={previewData.documents.tonnageBooklets.fileStoreId}
                      description="Tonnage certification document"
                      fileSize={previewData.documents.tonnageBooklets.size}
                    />
                  </Card.Body>
                </Card>
              </Col>
            )}

            {previewData.documents.stabilityBooklets && (
              <Col md={6}>
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-3">
                    <h5 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: "0.8rem" }}>
                      <BsFileEarmarkPdf className="text-info me-2" size={16} />
                      {t("Stability Booklets")}
                    </h5>
                  </Card.Header>
                  <Card.Body className="p-3">
                    <DocumentCard
                      fileName={previewData.documents.stabilityBooklets.name}
                      fileStoreId={previewData.documents.stabilityBooklets.fileStoreId}
                      description="Stability certification document"
                      fileSize={previewData.documents.stabilityBooklets.size}
                    />
                  </Card.Body>
                </Card>
              </Col>
            )}
          </Row>
        </div>
      </Collapsible>
      {/* Payment Details Section
      <Collapsible title={t("Payment Summary")} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <Row>
            <Col md={6}>
              <div className="mb-3">
                <label className="form-label fw-semibold">
                  {t("Supervision Authority")}
                </label>
                <div className="form-control bg-light">
                  {previewData.paymentDetails.supervisionAuthority}
                </div>
              </div>
            </Col>
            <Col md={6}>
              <div className="mb-3">
                <label className="form-label fw-semibold">
                  {t("Total Amount")}
                </label>
                <div className="form-control bg-success text-white fw-bold">
                  {previewData.paymentDetails.amount}
                </div>
              </div>
            </Col>
          </Row>
        </div>
      </Collapsible> */}
      {/* </div> */}
    </>
     // </Box>

  );
});

export default VesselBasicDetailsView;
import React, { useRef, useState, useEffect, forwardRef, useImperativeHandle, use } from "react";
import { useNavigate, useParams, useLocation } from "react-router-dom";
import { useForm } from "react-hook-form";
import { Container, Row, Col, Card } from "react-bootstrap";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";
import { FaUser, FaLock, FaDownload } from "react-icons/fa";
import InputFile from "../../../../common/InputFile.jsx";
import InputText from "../../../../common/InputText.tsx";
import InputSelect from "../../../../common/InputSelect.tsx";
import Collapsible from "../../../../common/Collapsible.js";
import { CONSTANT_REGEX, renameFile } from "../../../../../utils/constants.ts";
import { useMasterData } from "../../../../context/MasterDataContext.js";
import NewLoader from "../../../../common/NewLoader.js";
import { getData, postData, postFORMdata } from "../../../../../services/http.service.ts";
import { BASE_IP, SERVICE_BASE, URLS_ENDPOINT } from "../../../../../utils/urlsConstants.ts";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import axios from "axios";
import styles from "./RegistrationApplicationForm.module.css";

const RegistrationApplicationForm = forwardRef(({ registrationData }, ref) => {
  const { t } = useTranslation();
  const { id } = useParams();
  const loaderRef = useRef();
  const { masterData } = useMasterData();
  const [isDataLoaded, setIsDataLoaded] = useState(false);
  const [suggestions, setSuggestions] = useState([]);

  const {
    register,
    formState: { errors },
    setValue,
    watch,
    clearErrors,
    trigger,
    setError,
  } = useForm({
    mode: "onChange",
    defaultValues: {
      ownerName: "", address: "", ownerType: "", builderEmail: "",
      applicantphoneNumber: "", ownerpin: "",
      // ownercity: "",
      ownerdistrict: "",
      ownerstateUt: "", occupation: "", originalPlaceOfBusiness: "",
      nameOfMaster: "", certificateNo: "", nameOfRegistry: "", registrationNo: "",
      vesselName: "", kindOfVessel: "", typeOfVessel: "", categoryOfVessel: "",
      zone: "", mortgage: "", placeOfBuild: "", detailsOfInsurance: "",
      vesselyearOfBuild: "", protectionAndIndemnityClubNo: "", protectionAndIndemnityClubName: "",
      insuranceValidUpto: "", yearOfBuild: "", typeOfEngine: "", engineMake: "",
      engineMakerAddress: "", enginepin: "", enginephoneNumber: "", engineemail: "",
      horsepower: "", speed: "", yearOfMake: "", builderName: "", builderAddress: "",
      builderemail: "", builderphoneNumber: "", pin: "",
      // city: "", 
      district: "",
      stateUt: "", country: "India",
    },
  });

  useImperativeHandle(ref, () => ({
    validateForm: async () => {
      const isValid = await trigger();
      if (!isValid) {
        const firstErrorField = Object.keys(errors)[0];
        if (firstErrorField) {
          const element = document.querySelector(`[name="${firstErrorField}"]`);
          if (element) {
            element.scrollIntoView({ behavior: 'smooth', block: 'center' });
            element.focus();
          }
        }
      }
      return isValid;
    },
    getFormData: () => watch(),
  }));


  const [fileStates, setFileStates] = useState({
    thirdPartyInsurance: null,
    builderCertificate: null,
    instrumentOfSale: null,
    mortgageDetails: null,
    pniInsurance: null,
    declarationOfOwnership: null,
    challan: null,
  });

  const hasValue = (value) => {
    return value !== null && value !== undefined && value !== "" && value !== "N/A";
  };

  const isOwnerFieldDisabled = (fieldName) => {
    if (!isDataLoaded || !registrationData?.basicDetails?.ownerDetails) return false;
    const owner = registrationData.basicDetails.ownerDetails;

    switch (fieldName) {
      case 'ownerName':
        return hasValue(owner.ownerCompanyName);
      case 'address':
        return hasValue(owner.addressLine1);
      case 'ownerType':
        return hasValue(owner.categoryOfOwner);
      case 'builderEmail':
        return hasValue(owner.emailId);
      case 'applicantphoneNumber':
        return hasValue(owner.phoneNumber);
      case 'ownerpin':
        return hasValue(owner.pin);
      // case 'ownercity':
      //   return hasValue(owner.city);
      case 'ownerdistrict':
        return hasValue(owner.district);
      case 'ownerstateUt':
        return hasValue(owner.state);
      case 'occupation':
        return false;
      case 'originalPlaceOfBusiness':
        return false;
      default:
        return false;
    }
  };
  const vesselKindOptions = masterData?.kindOfVessels?.map(type => ({
    value: type.valueCode,
    label: type.valueLabel
  })) || [];
  const vesselTypeOptions = masterData?.vesselTypes?.map(type => ({
    value: type.valueCode,
    label: type.valueLabel
  })) || [];

  const categoryOptions = masterData?.vesselCategories?.map(category => ({
    value: category.valueCode,
    label: category.valueLabel
  })) || [];

  const zoneOptions = masterData?.zones?.map(zone => ({
    value: zone.valueCode,
    label: zone.valueLabel
  })) || [];

  const isBuilderFieldDisabled = (fieldName) => {
    if (!isDataLoaded || !registrationData?.basicDetails?.builderDetails) return false;
    const builder = registrationData.basicDetails.builderDetails;

    switch (fieldName) {
      case 'builderName':
        return hasValue(builder.builderName);
      case 'builderAddress':
        return hasValue(builder.addressLine1);
      case 'builderemail':
        return hasValue(builder.emailId);
      case 'builderphoneNumber':
        return hasValue(builder.phone);
      case 'pin':
        return hasValue(builder.pin);
      // case 'city':
      //   return hasValue(builder.city);
      case 'district':
        return hasValue(builder.district);
      case 'stateUt':
        return hasValue(builder.state);
      default:
        return false;
    }
  };

  const hasOwnerData = isDataLoaded && registrationData?.basicDetails?.ownerDetails &&
    Object.values(registrationData.basicDetails.ownerDetails).some(value => hasValue(value));

  const hasBuilderData = isDataLoaded && registrationData?.basicDetails?.builderDetails &&
    Object.values(registrationData.basicDetails.builderDetails).some(value => hasValue(value));

  const getFileDisplayName = (documentType) => {
    const fileState = fileStates[documentType];
    return fileState?.name || "";
  };


  useEffect(() => {
    if (registrationData && !isDataLoaded) {
      const { basicDetails, vesselDetails, engineDetails, enclosers } = registrationData;

      // Basic Details
      if (basicDetails?.ownerDetails) {
        const owner = basicDetails.ownerDetails;
        setValue("ownerName", owner.ownerCompanyName || "");
        setValue("address", owner.addressLine1 || "");
        setValue("ownerType", owner.categoryOfOwner || "");
        setValue("builderEmail", owner.emailId || "");
        setValue("applicantphoneNumber", owner.phoneNumber || "");
        setValue("ownerpin", owner.pin?.toString() || "");
        // setValue("ownercity", owner.city || "N/A");
        setValue("ownerdistrict", owner.district || "");
        setValue("ownerstateUt", owner.state || "");
        setValue("occupation", basicDetails.occupation || "");
        setValue("originalPlaceOfBusiness", basicDetails.originalPlaceBusiness || "");
      }

      // Vessel Details 
      if (vesselDetails) {
        setValue("nameOfMaster", vesselDetails.nameOfMaster || "");
        setValue("certificateNo", vesselDetails.certficateNumber || "");
        setValue("nameOfRegistry", vesselDetails.nameOfRegistry || "");
        setValue("registrationNo", vesselDetails.registrationNumber || "");
        setValue("vesselName", vesselDetails.vesselName || "");
        setValue("kindOfVessel", vesselDetails.kindOfVessel || "");
        setValue("mortgage", vesselDetails.mortgage || "");
        setValue("placeOfBuild", vesselDetails.placeOfBuild || "");
        setValue("detailsOfInsurance", vesselDetails.insuranceDetails || "");
        setValue("vesselyearOfBuild", vesselDetails.yearOfBuild?.toString() || "");
        setValue("protectionAndIndemnityClubNo", vesselDetails.pniClubNo || "");
        setValue("protectionAndIndemnityClubName", vesselDetails.pniClubName || "");
        setValue("insuranceValidUpto", vesselDetails.insuranceValidDate || "");
      }

      // Engine Details
      if (engineDetails) {
        setValue("yearOfBuild", engineDetails.yearOfBuild || "");
        setValue("typeOfEngine", engineDetails.engineType || "");
        setValue("engineMake", engineDetails.engineMake || "");
        setValue("engineMakerAddress", engineDetails.makerAddress || "");
        setValue("enginepin", engineDetails.pin || "");
        setValue("enginephoneNumber", engineDetails.mobile || "");
        setValue("engineemail", engineDetails.email || "");
        setValue("horsepower", engineDetails.horsepower?.toString() || "");
        setValue("speed", engineDetails.speed?.toString() || "");
        setValue("yearOfMake", engineDetails.yearOfMake || "");
      }

      // Builder Details
      if (basicDetails?.builderDetails) {
        const builder = basicDetails.builderDetails;
        setValue("builderName", builder.builderName || "");
        setValue("builderAddress", builder.addressLine1 || "");
        setValue("builderemail", builder.emailId || "");
        setValue("builderphoneNumber", builder.phone || "");
        setValue("pin", builder.pin?.toString() || "");
        // setValue("city", builder.city || "N/A");
        setValue("district", builder.district || "");
        setValue("stateUt", builder.state || "");
      }


      if (enclosers && Array.isArray(enclosers)) {
        const fileMapping = {
          "THIRD_PARTY_INSURANCE": "thirdPartyInsurance",
          "BUILDERS_CERTIFICATE": "builderCertificate",
          "INSTRUMENT_OF_SALE": "instrumentOfSale",
          "MORTGAGE_DETAILS": "mortgageDetails",
          "PREOTECTION_AND_INDEMNITY_INSURANCE_NO": "pniInsurance",
          "DECLARATION_OF_OWNERSHIP": "declarationOfOwnership",
          "CHALLAN": "challan"
        };

        enclosers.forEach(encloser => {
          const fieldName = fileMapping[encloser.documentType];
          if (fieldName && encloser.fileStoreId) {
            setFileStates(prev => ({
              ...prev,
              [fieldName]: {
                name: encloser.documentName,
                fileStoreId: encloser.fileStoreId
              }
            }));
            setValue(`${fieldName}FileStoreId`, encloser.fileStoreId);
          }
        });
      }

      setIsDataLoaded(true);
    }
  }, [registrationData, setValue, isDataLoaded]);


  useEffect(() => {
    if (registrationData?.vesselDetails && masterData && isDataLoaded) {
      const vesselDetails = registrationData.vesselDetails;

      const findValueCode = (apiValue, masterArray) => {
        if (!apiValue || !masterArray) return "";
        const found = masterArray.find(item =>
          item.valueLabel === apiValue || item.valueCode === apiValue
        );
        return found?.valueCode || "";
      };

      setValue("typeOfVessel", findValueCode(vesselDetails.typeOfVessel, masterData.vesselTypes));
      setValue("categoryOfVessel", findValueCode(vesselDetails.categoryOfVessel, masterData.vesselCategories));
      setValue("zone", findValueCode(vesselDetails.zone, masterData.zones));
      setValue("kindOfVessel", findValueCode(vesselDetails.kindOfVessel, masterData.kindOfVessels));
    }
  }, [masterData, registrationData, isDataLoaded, setValue]);

  const fetchAddressDetails = async (pin, prefix = "") => {
    try {
      loaderRef.current?.show();
      const URL = process.env.REACT_APP_PUBLIC_URL + URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE + pin;
      const response = await getData(URL);

      if (response?.status === 200 && response?.data?.length > 0) {
        const data = response.data[0];
        if (prefix) {
          // setValue(`${prefix}city`, data.district);
          setValue(`${prefix}district`, data.district);
          setValue(`${prefix}stateUt`, data.stateName);
          // clearErrors(`${prefix}city`);
          clearErrors(`${prefix}district`);
          clearErrors(`${prefix}stateUt`);
        } else {
          // setValue("city", data.district);
          setValue("district", data.district);
          setValue("stateUt", data.stateName);
          // clearErrors("city");
          clearErrors("district");
          clearErrors("stateUt");
        }
        setValue("country", "India");
      } else {
        toast.info("No data found for this PIN code");
      }
    } catch (error) {
      toast.error("Error fetching address details");
    } finally {
      loaderRef.current?.hide();
    }
  };

  const handleDropdownChange = (name, value) => {
    setValue(name, value, { shouldValidate: true });
    clearErrors(name);
  };

  const handleFileChange = async (e, documentType) => {
    const file = e?.target?.files[0];
    if (!file) return;

    const maxSize = 10 * 1024 * 1024;
    if (file.size > maxSize) {
      toast.error("File size must be less than or equal to 10 MB.");
      e.target.value = null;
      return;
    }

    loaderRef.current?.show();

    try {
      const formData = new FormData();
      formData.append("file", file);

      const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
      const response = await postFORMdata(uploadUrl, formData);

      const fileStoreId = response?.data?.files[0]?.fileStoreId;

      if (fileStoreId) {

        const getStandardizedFileName = (docType) => {
          const fileNames = {
            "thirdPartyInsurance": "Third Party Insurance.pdf",
            "builderCertificate": "Builder's Certificate.pdf",
            "instrumentOfSale": "Instrument of Sale.pdf",
            "mortgageDetails": "Mortgage Details.pdf",
            "pniInsurance": "Protection & Indemnity Insurance.pdf",
            "declarationOfOwnership": "Declaration of Ownership.pdf",
            "challan": "Challan.pdf"
          };
          return fileNames[docType] || file.name;
        };

        const standardizedName = getStandardizedFileName(documentType);

        setFileStates(prev => ({
          ...prev,
          [documentType]: {
            name: standardizedName,
            fileStoreId,
            originalName: file.name
          }
        }));
        setValue(`${documentType}FileStoreId`, fileStoreId);
        toast.success("File uploaded successfully!");
      }
    } catch (err) {
      console.error("File upload failed:", err);
      toast.error("File upload failed. Please try again.");
      setFileStates(prev => ({ ...prev, [documentType]: null }));
      e.target.value = null;
    } finally {
      loaderRef.current?.hide();
    }
  };

  // const handleFileDownload = (fileStoreId, fileName, originalName) => {
  //   if (fileStoreId) {
  //     const downloadUrl = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${fileStoreId}`;
  //     const link = document.createElement('a');
  //     link.href = downloadUrl;
  //     link.download = originalName || fileName; 
  //     link.target = '_blank';
  //     document.body.appendChild(link);
  //     link.click();
  //     document.body.removeChild(link);
  //   }
  // };

  const handleFileDownload = async (fileStoreId, fileName, originalName) => {
    try {
      if (!fileStoreId) return;
      const url = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${fileStoreId}`;

      loaderRef.current?.show();

      const accessToken = getFromLocalStorage("access_token");
      const tokenDetails = getFromLocalStorage("tokenDetails");
      const sessionState = tokenDetails
        ? JSON.parse(tokenDetails)?.session_state
        : "";

      const response = await axios({
        method: "GET",
        url: url,
        responseType: "blob",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "X-Request-ID": sessionState,
          Accept: "application/octet-stream",
        },
      });

      if (response.data) {
        let filename = fileName || "document";
        const contentDisposition = response.headers["content-disposition"];
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(
            /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
          );
          if (filenameMatch && filenameMatch[1]) {
            filename = filenameMatch[1].replace(/['"]/g, "");
          }
        }

        const blob = new Blob([response.data], {
          type: response.headers["content-type"] || "application/octet-stream",
        });
        const blobUrl = window.URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = blobUrl;
        link.setAttribute("download", filename);
        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          window.URL.revokeObjectURL(blobUrl);
        }, 100);
      }
    } catch (error) {
      console.error("Error downloading file:", error);
      toast.error("Failed to download file. Please try again.");
    } finally {
      loaderRef.current?.hide();
    }
  };

  const getVesselNameSuggestions = async (value) => {
    try {
      const vesselName = value.trim();
      if (!vesselName) return;
      const applicationNo = registrationData?.vesselDetails?.applicationNo;
      const regId = registrationData?.vesselDetails?.id;
      if (!applicationNo || !regId) return;

      loaderRef.current?.show();

      const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.VESSEL_SERVICE.VESSELNAME_SEARCH + `?vesselName=${encodeURIComponent(vesselName)}`;

      const response = await postData(apiUrl, {
        vesselRegistrationId: regId,
        applicationNumber: applicationNo,
        vesselName: vesselName
      });

      setSuggestions([]);
      clearErrors("vesselName");
      loaderRef.current?.hide();

      return true;

    } catch (error) {

      const suggestions = error?.response?.data?.data?.suggestions || [];
      setSuggestions(suggestions);
      toast.error(error?.response?.data?.responseStatus?.message || "The Vessel is not available please try with another name");
      setError("vesselName", {
        type: "manual",
        message: t("The Vessel is not available please try with another name"),
      });
      loaderRef.current?.hide();

      return false;
    }
  };

  const checkVesselNameError = () => {
    if (errors?.vesselName) {
      return false;
    }
    return true;
  }

  const values = watch();

  useEffect(() => {
    const timer = setTimeout(() => {
      getVesselNameSuggestions(values.vesselName);
    }, 1000);

    return () => clearTimeout(timer);
  }, [values.vesselName]);

  return (
