
import React from 'react';
import { Container, Row, Col, Card, Badge, Table } from 'react-bootstrap';
import { BsClock, BsCheckCircle, BsCalendar2Event } from 'react-icons/bs';
import { useForm } from 'react-hook-form';
import { useTranslation } from 'react-i18next';
import InputText from '../../../../common/InputText.tsx';

const CurvingMarkingNoteL5 = ({ registrationData }) => {
  const { t } = useTranslation();

  console.log(registrationData,"curving-reg")
  const {
    register,
    formState: { errors },
    clearErrors,
  } = useForm({
    mode: "onChange",
    defaultValues: {
      vesselName: registrationData?.vesselDetails?.vesselName || '',
      officialNo: registrationData?.vesselDetails?.registrationNumber || '',
      portOfRegistry: registrationData?.vesselDetails?.nameOfRegistry || '',
      yearOfRegistry: registrationData?.vesselDetails?.yearOfBuild || ''
    },
  });

  const scheduledAppointments = [
    {
      id: 1,
      date: '2024-01-15',
      time: '10:00 AM - 11:00 AM',
      status: 'Confirmed',
      officer: 'Engineer John Doe',
      type: 'Initial Inspection'
    },
    {
      id: 2,
      date: '2024-01-18',
      time: '02:00 PM - 03:00 PM',
      status: 'Pending',
      officer: 'Engineer Jane Smith',
      type: 'Final Review'
    },
    {
      id: 3,
      date: '2024-01-20',
      time: '11:00 AM - 12:00 PM',
      status: 'Scheduled',
      officer: 'Senior Inspector Mike',
      type: 'Documentation Check'
    }
  ];

  return (
    <Container fluid className="p-0">
      {/* Curving & Marking Note Details */}
      <Card className="mb-4" style={{ border: '1px solid #e2e8f0', borderRadius: '12px' }}>
        <Card.Body>
          <div className="mb-4">
            <h6 style={{ color: "#2466BF", marginBottom: "0.5rem" }}>
              {t("Curving & Marking Note Details")}
            </h6>
            <p style={{ color: "#64748b", fontSize: "0.9rem", margin: 0 }}>
              {t("Vessel registration information for director review")}
            </p>
          </div>
          
          <form className="employee-form">
            <Card className="form-section-card">
              <Card.Body>
                <Row className="g-3">
                  <Col md={6}>
                    <InputText
                      name="vesselName"
                      label={t("Name of the Vessel")}
                      placeholder={t("Enter vessel name")}
                      required={false}
                      register={{
                        ...register("vesselName"),
                      }}
                      errors={errors}
                      clearErrors={clearErrors}
                      readOnly={true}
                      style={{ backgroundColor: '#f8fafc', cursor: 'not-allowed' }}
                    />
                  </Col>
                  
                  <Col md={6}>
                    <InputText
                      name="officialNo"
                      label={t("Official No.")}
                      placeholder={t("Enter official number")}
                      required={false}
                      register={{
                        ...register("officialNo"),
                      }}
                      errors={errors}
                      clearErrors={clearErrors}
                      readOnly={true}
                      style={{ backgroundColor: '#f8fafc', cursor: 'not-allowed' }}
                    />
                  </Col>
                  
                  <Col md={6}>
                    <InputText
                      name="portOfRegistry"
                      label={t("Port of Registry")}
                      placeholder={t("Enter port of registry")}
                      required={false}
                      register={{
                        ...register("portOfRegistry"),
                      }}
                      errors={errors}
                      clearErrors={clearErrors}
                      readOnly={true}
                      style={{ backgroundColor: '#f8fafc', cursor: 'not-allowed' }}
                    />
                  </Col>
                  
                  <Col md={6}>
                    <InputText
                      name="yearOfRegistry"
                      label={t("Year of Registry")}
                      placeholder={t("Enter year of registry")}
                      required={false}
                      register={{
                        ...register("yearOfRegistry"),
                      }}
                      errors={errors}
                      clearErrors={clearErrors}
                      readOnly={true}
                      style={{ backgroundColor: '#f8fafc', cursor: 'not-allowed' }}
                    />
                  </Col>
                </Row>
              </Card.Body>
            </Card>
          </form>
        </Card.Body>
      </Card>

      {/* Scheduled Appointments */}
      <Card style={{ border: '1px solid #e2e8f0', borderRadius: '12px' }}>
        <Card.Body style={{ padding: '2rem' }}>
          <div className="d-flex align-items-center mb-4">
            <BsCalendar2Event size={20} style={{ color: '#2466BF', marginRight: '0.75rem' }} />
            <h6 style={{ color: "#2466BF", margin: 0 }}>
              {t("Scheduled Appointments")}
            </h6>
          </div>
          
          <Table responsive className="mb-0">
            <thead style={{ backgroundColor: '#f8fafc' }}>
              <tr>
                <th style={{ border: 'none', padding: '1rem', color: '#374151', fontWeight: 600 }}>
                  Date & Time
                </th>
                <th style={{ border: 'none', padding: '1rem', color: '#374151', fontWeight: 600 }}>
                  Officer
                </th>
                <th style={{ border: 'none', padding: '1rem', color: '#374151', fontWeight: 600 }}>
                  Type
                </th>
                <th style={{ border: 'none', padding: '1rem', color: '#374151', fontWeight: 600 }}>
                  Status
                </th>
              </tr>
            </thead>
            <tbody>
              {scheduledAppointments.map((appointment) => (
                <tr key={appointment.id}>
                  <td style={{ border: 'none', padding: '1rem', borderBottom: '1px solid #e2e8f0' }}>
                    <div className="d-flex align-items-center">
                      <BsClock size={16} style={{ color: '#64748b', marginRight: '0.5rem' }} />
                      <div>
                        <div style={{ fontWeight: 600, color: '#2E57A7' }}>
                          {appointment.date}
                        </div>
                        <small style={{ color: '#64748b' }}>
                          {appointment.time}
                        </small>
                      </div>
                    </div>
                  </td>
                  <td style={{ border: 'none', padding: '1rem', borderBottom: '1px solid #e2e8f0' }}>
                    <span style={{ color: '#374151', fontWeight: 500 }}>
                      {appointment.officer}
                    </span>
                  </td>
                  <td style={{ border: 'none', padding: '1rem', borderBottom: '1px solid #e2e8f0' }}>
                    <span style={{ color: '#64748b' }}>
                      {appointment.type}
                    </span>
                  </td>
                  <td style={{ border: 'none', padding: '1rem', borderBottom: '1px solid #e2e8f0' }}>
                    <Badge 
                      bg={appointment.status === 'Confirmed' ? 'success' : 
                          appointment.status === 'Pending' ? 'warning' : 'primary'}
                      className="d-flex align-items-center gap-1"
                      style={{ 
                        fontSize: '0.8rem', 
                        fontWeight: 500,
                        width: 'fit-content'
                      }}
                    >
                      <BsCheckCircle size={12} />
                      {appointment.status}
                    </Badge>
                  </td>
                </tr>
              ))}
            </tbody>
          </Table>
        </Card.Body>
      </Card>
    </Container>
  );
};

export default CurvingMarkingNoteL5;
