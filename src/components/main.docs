// Add state for provisional registration cert data
const [provisionalRegCertData, setProvisionalRegCertData] = useState(null);

// Update handleProvisionModalOpen to capture registration cert data
const handleProvisionModalOpen = async (type) => {
  const isRegistration = type === "registration";

  const URL = isRegistration
    ? SERVICE_BASE.IWT_REGISTRATION +
    URLS_ENDPOINT.VESSEL_SERVICE.GET_REG_PROVISIONAL_CERT_DETAILS
    : SERVICE_BASE.IWT_SURVEY_SERVICE +
    URLS_ENDPOINT.SURVEY_SERVICE.GET_SURVEY_PROVISIONAL_CERT_DETAILS;

  const payload = isRegistration
    ? {
      applicationNumbers: [
        registrationData?.vessel?.applicationNumber || "",
      ],
    }
    : { surveyId: intialSurveyData?.surveyId || "" };

  try {
    loaderRef?.current?.show();

    const response = await postData(URL, payload);
    const { status, data } = response || {};

    if (
      (isRegistration &&
        status === 200 &&
        data?.data?.registrationCertificateDetails) ||
      (!isRegistration && (status === 200 || status === 201) && data)
    ) {
      const certData = isRegistration ? data?.data?.registrationCertificateDetails : data;
      
      // Store the provisional cert data
      if (isRegistration) {
        setProvisionalRegCertData(certData);
      }
      
      setProvisionalCertData(certData);
      setModalType(type);
      setOpenCertificateModal(true);
      return;
    }

    toast.info(data?.responseStatus?.message || "Something went wrong..", {
      position: "top-right",
    });
  } catch (err) {
    console.error("Provision Modal Error:", err);
    handleErrorMessage(err?.response?.data);
  } finally {
    loaderRef?.current?.hide();
  }
};

// Update Certificate of Registration component call
baseSteps.push({
  label: t("Certificate of Registration"),
  component: (
    <CertificateOfRegistrationForm8
      formMethods={methods}
      viewMode={isOfficerLogin ? false : isViewMode}
      registrationData={registrationData}
      intialSurveyData={intialSurveyData}
      originalRegistrationData={originalRegistrationData}
      provisionalCertData={provisionalRegCertData} // Pass the provisional cert data
    />
  ),
  validate: validateCertificateForm,
  getFormData: () => methods?.getValues(),
  showSubmitButton: true,
});
