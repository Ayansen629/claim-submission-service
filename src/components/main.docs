
import React, { useState } from "react";
import { Box, Typography, Stack } from "@mui/material";
import Stepper from "../../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import { useForm } from "react-hook-form";
import Invoicing from "../../../common/Invoicing.js";
import PaymentModal from "../../../common/PaymentModal.js"; 
import PreviewPage from "../../../common/PreviewPage";
import { vesselData, previewSections } from "./vesselData";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";

const NewVesselRegistration = () => {
   const { t } = useTranslation();
    const { changeLanguage } = useLanguageContext();
  const methods = useForm({ mode: "onTouched" });
  const { trigger } = methods;

  // Payment modal state
  const [showModal, setShowModal] = useState(false);
  const [paymentMode, setPaymentMode] = useState("offline");
  const [challanFile, setChallanFile] = useState(null);
  const [showPreview, setShowPreview] = useState(false);
  const [isLoading, setIsLoading] = useState(false);

  const validateVesselDetails = async () => {
    const valid = await trigger();
    return valid;
  };

  const supervisionAuthority = methods.watch("supervisionAuthority");

  const handleChallanUpload = (e) => {
    setChallanFile(e.target.files?.[0] || null);
  };
  
  const handleShowPreview = () => {
    setShowPreview(true);
  };

  const handleOnlinePay = () => {
    setIsLoading(true);
    setShowModal(false);
   
    setTimeout(() => {
      setIsLoading(false);
      setShowPreview(true);
    }, 1500);
  };

  const steps = [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} 
       viewMode={showPreview} 
       />,
      validate: validateVesselDetails,
    },
    {
      label: t("Invoicing"),
      component: (
        <Invoicing
          supervisionAuthority={supervisionAuthority}
          onPayNow={() => setShowModal(true)}
        />
      ),
      validate: () => true,
    },
  ];

  const handleSave = () => {
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      setShowPreview(true);
    }, 1500);
  };

  if (showPreview) {
    return (
      <PreviewPage
        data={vesselData}
        sections={previewSections}
        title="Vessel Registration Preview"
        subtitle="Registration details submitted successfully"
        onBack={() => setShowPreview(false)}
        submitButtonText="Take Action"
        onSubmit={() => alert("Taking action...")}
        icons={{ title: "vessel" }}
        viewMode={true}
      />
    );
  }

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {isLoading ? (
        <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
          <div className="text-center">
            <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
              <span className="visually-hidden">Loading...</span>
            </div>
            <p className="mt-3">Processing your request...</p>
          </div>
        </div>
      ) : (
        <>
          <Stack spacing={0.5}>
            <Typography
              sx={{
                fontWeight: 550,
                color: "#2E57A7",
                fontSize: "1.2rem",
              }}
            >
             {t("New Vessel Registration")}
              &nbsp;
              <span style={{ color: "#666", fontSize: "0.65rem" }}>
                {t("(Fill in the vessel details to complete registration)")}
              </span>
            </Typography>
          </Stack>
          <Stepper steps={steps} onSave={handleSave} />
          <PaymentModal
            show={showModal}
            onHide={() => setShowModal(false)}
            paymentMode={paymentMode}
            setPaymentMode={setPaymentMode}
            challanFile={challanFile}
            onChallanUpload={handleChallanUpload}
            onOnlinePay={handleOnlinePay}
            isLoading={isLoading}
            formMethods={methods}
          />
        </>
      )}
    </Box>
  );
};

export default NewVesselRegistration;

import React, { useState, useEffect, useRef } from "react";
import { useForm } from "react-hook-form";
import { Row, Col, Card, Button, Form } from "react-bootstrap";
import InputText from "../../../common/InputText.tsx";
import InputSelect from "../../../common/InputSelect.tsx";
import InputRadio from "../../../common/InputRadio.tsx";
import InputFile from "../../../common/InputFile";
import { headerStyle } from "../../../../utils/constants.ts";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
const MultipleFileUpload = ({
  title,
  description = true,
  required = true,
  register,
  errors,
  setValue,
  clearErrors,
  watch,
  disabled = false,
}) => {
  const [files, setFiles] = useState([{ id: 1 }]);

  const addFileInput = () => {
    if (disabled) return;
    const newId = files.length > 0 ? Math.max(...files.map(f => f.id)) + 1 : 1;
    setFiles([...files, { id: newId }]);
  };

  const removeFileInput = (id) => {
    if (disabled) return;
    setFiles(files.filter(file => file.id !== id));
    setValue(`${title.replace(/\s+/g, '')}_file_${id}`, null);
    setValue(`${title.replace(/\s+/g, '')}_desc_${id}`, "");
    clearErrors([`${title.replace(/\s+/g, '')}_file_${id}`, `${title.replace(/\s+/g, '')}_desc_${id}`]);
  };

  return (
    <div className="mb-4">
      <div className="d-flex justify-content-between align-items-center mb-2">
        <h6 className="mb-0">{title}</h6>
        {description && !disabled && (
          <Button
            variant="primary"
            size="sm"
            onClick={addFileInput}
            style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
          >
            + Add
          </Button>
        )}
      </div>
      {files.map((fileInput, idx) => (
        <Row key={fileInput.id} className="mb-2 align-items-center">
          <Col md={description ? 8 : 12}>
            <InputFile
              label=""
              name={`${title.replace(/\s+/g, '')}_file_${fileInput.id}`}
              register={register(`${title.replace(/\s+/g, '')}_file_${fileInput.id}`)}
              errors={errors}
              value={watch(`${title.replace(/\s+/g, '')}_file_${fileInput.id}`)?.[0]}
              onChange={e => {
                if (disabled) return;
                setValue(`${title.replace(/\s+/g, '')}_file_${fileInput.id}`, e.target.files);
                clearErrors(`${title.replace(/\s+/g, '')}_file_${fileInput.id}`);
              }}
              disabled={disabled}
            />
          </Col>
          {description && (
            <Col md={4}>
              <InputText
                label=""
                name={`${title.replace(/\s+/g, '')}_desc_${fileInput.id}`}
                placeholder="Description of File"
                register={register(`${title.replace(/\s+/g, '')}_desc_${fileInput.id}`)}
                errors={errors}
                onChange={() => !disabled && clearErrors(`${title.replace(/\s+/g, '')}_desc_${fileInput.id}`)}
                disabled={disabled}
              />
            </Col>
          )}
          {description && files.length > 1 && !disabled && (
            <Col md={12}>
              <Button
                variant="outline-danger"
                size="sm"
                onClick={() => removeFileInput(fileInput.id)}
                className="mt-2"
              >
                Remove
              </Button>
            </Col>
          )}
        </Row>
      ))}
    </div>
  );
};

const VesselDetails = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const defaultValues = {
    ownerName: "",
    ownerAddress: "",
    mobile: "",
    email: "",
    pan: "",
    aadhar: "",
    tradeLicence: "",
    gst: "",
    grt: "",
    workOrderValue: "",
    vesselType: "",
    category: "",
    zone: "",
    supervisionAuthority: "",
    purchaseType: "",
    classificationSociety: "",
    constructedBy: "",
    builder: "",
    builderName: "",
    builderAddress: "",
    builderEmail: "",
    builderMobile: "",
    builderTradeLicence: "",
    builderGST: "",
    builderAuth: "",
    authLetter: "",
    termsAccepted: false,
    tonnageBooklets: null,
    stabilityBooklets: null,
  };

  const internalFormMethods = useForm({
    defaultValues,
    mode: "onTouched",

  });

  const methods = formMethods || internalFormMethods;
  const isCompMount = useRef(true);



  const {
    register,
    handleSubmit,
    watch,
    setValue,
    clearErrors,
    trigger,
    formState: { errors, touchedFields },
  } = methods;

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [changeLanguage]);

  const constructedBy = watch("constructedBy");
  const supervisionAuthority = watch("supervisionAuthority");
  const tonnageBooklets = watch("tonnageBooklets");
  const stabilityBooklets = watch("stabilityBooklets");
  const category = watch("category");
  const zone = watch("zone");

  // Effect to handle category change
  useEffect(() => {
    if (category === "A") {
      setValue("zone", "1", { shouldValidate: true });
      setValue("supervisionAuthority", "classificationSociety", { shouldValidate: true });
      // setValue("classificationSociety", "Indian Register of Shipping", { shouldValidate: true });

      // Clear errors for these fields
      clearErrors("zone");
      clearErrors("supervisionAuthority");
      // clearErrors("classificationSociety");
    }
  }, [category, setValue, clearErrors]);



  const onSubmit = (data) => {
    console.log("Form Submitted:vessel details", data);
  };

  return (
    <form onSubmit={handleSubmit(onSubmit)} autoComplete="off">
      {/* Basic Information Collapsible */}
      <Collapsible title={t("Basic Information")} openStat={true}>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Name of Owner")}
              name="ownerName"
              placeholder={t("Please enter Name of Owner")}
              required
              register={register("ownerName", { required: t("Name is required") })}
              errors={errors}
              onChange={() => !viewMode && clearErrors("ownerName")}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Address of Owner")}
              name="ownerAddress"
              placeholder={t("Please enter Address of Owner")}
              required
              register={register("ownerAddress", { required: t("Address is required") })}
              errors={errors}
              onChange={() => !viewMode && clearErrors("ownerAddress")}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Mobile")}
              name="mobile"
              placeholder={t("Please enter Mobile")}
              required
              register={register("mobile", { required: t("Mobile is required") })}
              errors={errors}
              onChange={() => !viewMode && clearErrors("mobile")}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Email Id")}
              name="email"
              placeholder={t("Please enter Email Id")}
              required
              register={register("email", { required: t("Email is required") })}
              errors={errors}
              onChange={() => !viewMode && clearErrors("email")}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("PAN")}
              name="pan"
              placeholder={t("Please enter PAN")}
              required
              register={register("pan", { required: t("PAN is required") })}
              errors={errors}
              onChange={() => !viewMode && clearErrors("pan")}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Aadhar")}
              name="aadhar"
              placeholder={t("Please enter Aadhar")}
              required
              register={register("aadhar", { required: t("Aadhar is required") })}
              errors={errors}
              onChange={() => !viewMode && clearErrors("aadhar")}
              disabled={viewMode}
            />
          </Col>
        </Row>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Trade Licence")}
              name="tradeLicence"
              placeholder={t("Please enter Trade Licence")}
              required
              register={register("tradeLicence", { required: t("Trade Licence is required") })}
              errors={errors}
              onChange={() => !viewMode && clearErrors("tradeLicence")}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("GST")}
              name="gst"
              placeholder={t("Please enter GST")}
              required
              register={register("gst", { required: t("GST is required") })}
              errors={errors}
              onChange={() => !viewMode && clearErrors("gst")}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Gross Tonnage (GRT)")}
              name="grt"
              placeholder={t("Please enter GRT")}
              required
              register={register("grt", { required: t("GRT is required") })}
              errors={errors}
              onChange={() => !viewMode && clearErrors("grt")}
              disabled={viewMode}
            />
          </Col>
        </Row>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Work Order Value")}
              name="workOrderValue"
              placeholder={t("Enter Work Order Value")}
              required
              register={register("workOrderValue", {
                required: t("Work Order Value is required"),
                pattern: {
                  value: /^[0-9]+$/,
                  message: t("Please enter a valid number"),
                },
              })}
              errors={errors}
              onChange={() => !viewMode && clearErrors("workOrderValue")}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputSelect
              label={t("Type of Vessel")}
              name="vesselType"
              required={true}
              options={[
                { value: "new", label: t("New Vessel") },
                { value: "old", label: t("Old Vessel") },
              ]}
              register={register("vesselType", { required: t("vesselType is required") })}
              errors={errors}
              value={watch("vesselType") || ""}
              onChange={(value) => {
                if (viewMode) return;
                setValue("vesselType", value, { shouldValidate: true });
                clearErrors("vesselType");
              }}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputSelect
              label={t("Category")}
              name="category"
              required={true}
              options={[
                { value: "A", label: t("Category A") },
                { value: "B", label: t("Category B") },
                { value: "C", label: t("Category C") },
              ]}
              register={register("category", { required: t("category is required") })}
              errors={errors}
              value={watch("category") || ""}
              onChange={(value) => {
                if (viewMode) return;
                setValue("category", value, { shouldValidate: true });
                clearErrors("category");
              }}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputSelect
              label={t("Zone")}
              name="zone"
              required={true}
              options={[
                { value: "1", label: t("Zone 1") },
                { value: "2", label: t("Zone 2") },
                { value: "3", label: t("Zone 3") },
              ]}
              register={register("zone", {
                required: category !== "A" && t("zone is required")
              })}
              errors={category !== "A" ? errors : {}}
              value={watch("zone") || ""}
              onChange={(value) => {
                if (viewMode || category === "A") return;
                setValue("zone", value, { shouldValidate: true });
                clearErrors("zone");
              }}
              disabled={viewMode || category === "A"}
            />
          </Col>
          <Col md={4}>
            <InputSelect
              label={t("Supervision Authority")}
              name="supervisionAuthority"
              options={[
                { value: "iwt", label: t("IWT") },
                { value: "classificationSociety", label: t("Classification Society") },
              ]}
              required={true}
              register={register("supervisionAuthority", {
                required: category !== "A" && t("Supervision Authority is required")
              })}
              errors={category !== "A" ? errors : {}}
              value={watch("supervisionAuthority") || ""}
              onChange={(value) => {
                if (viewMode || category === "A") return;
                setValue("supervisionAuthority", value, { shouldValidate: true });
                clearErrors("supervisionAuthority");
              }}
              disabled={viewMode || category === "A"}
            />
          </Col>
          <Col md={4}>
            <InputSelect
              label={t("Purchase Type")}
              name="purchaseType"
              options={[
                { value: "new", label: t("New") },
                { value: "used", label: t("Used") },
              ]}
              required={true}
              register={register("purchaseType", { required: t("Purchase Type is required") })}
              errors={errors}
              value={watch("purchaseType") || ""}
              onChange={(value) => {
                if (viewMode) return;
                setValue("purchaseType", value, { shouldValidate: true });
                clearErrors("purchaseType");
              }}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Name of the Classification Society")}
              name="classificationSociety"
              placeholder={t("Please enter Name of the Classification Society")}
              register={register("classificationSociety"
                // , 
                //   {
                //   required: category === "A" ? false : "Classification Society is required"
                // }
              )}
              // errors={category === "A" ? {} : errors}
              errors={errors}
              onChange={() => !viewMode && clearErrors("classificationSociety")}
              disabled={viewMode
                // || category === "A"
              }
            // value={category === "A" ? "Indian Register of Shipping" : watch("classificationSociety")}
            />
          </Col>
        </Row>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={6}>
            <InputRadio
              name="constructedBy"
              label={t("Constructed By ?")}
              options={[
                { label: t("Self"), value: "1" },
                { label: t("Builder"), value: "2" },
              ]}
              register={register}
              rules={{ required: t("Please select a Contructor Type") }}
              errors={errors}
              onChange={() => !viewMode && clearErrors("constructedBy")}
              disabled={viewMode}
            />
          </Col>
          {constructedBy === "2" && (
            <Col md={6}>
              <InputSelect
                label={t("Builder")}
                name="builder"
                required
                options={[
                  { value: "builder1", label: t("Builder 1") },
                  { value: "builder2", label: t("Builder 2") },
                ]}
                register={register}
                errors={errors}
                value={watch("builder") || ""}
                onChange={(value) => {
                  if (viewMode) return;
                  setValue("builder", value, { shouldValidate: true });
                  clearErrors("builder");
                }}
                disabled={viewMode}
              />
            </Col>
          )}
        </Row>
      </Collapsible>

      {/* Builder Details Collapsible */}
      {constructedBy === "2" && (
        <Collapsible title="Builder Details" openStat={true}>
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Builder Name")}
                name="builderName"
                required
                placeholder={t("Please enter Builder Name")}
                register={register("builderName", {
                  required: constructedBy === "2" && t("Builder Name is required"),
                })}
                errors={errors}
                onChange={() => !viewMode && clearErrors("builderName")}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Builder Address")}
                name="builderAddress"
                required
                placeholder={t("Please enter Builder Address")}
                register={register("builderAddress", {
                  required: constructedBy === "2" && t("Builder Address is required"),
                })}
                errors={errors}
                onChange={() => !viewMode && clearErrors("builderAddress")}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Builder Email Id")}
                name="builderEmail"
                required
                placeholder={t("Please enter Builder Email Id")}
                register={register("builderEmail", {
                  required: constructedBy === "2" && t("Builder Email is required"),
                  pattern: constructedBy === "2" && {
                    value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                    message: t("Invalid email address"),
                  },
                })}
                errors={errors}
                onChange={() => !viewMode && clearErrors("builderEmail")}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Mobile")}
                name="builderMobile"
                required
                placeholder={t("Please enter Mobile")}
                register={register("builderMobile", {
                  required: constructedBy === "2" && t("Builder Mobile is required"),
                  pattern: constructedBy === "2" && {
                    value: /^[0-9]{10}$/,
                    message: t("Invalid mobile number"),
                  },
                })}
                errors={errors}
                onChange={() => !viewMode && clearErrors("builderMobile")}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Trade Licence")}
                name="builderTradeLicence"
                required
                placeholder={t("Please enter Trade Licence")}
                register={register("builderTradeLicence", {
                  required: constructedBy === "2" && t("Builder Trade Licence is required"),
                })}
                errors={errors}
                onChange={() => !viewMode && clearErrors("builderTradeLicence")}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("GST")}
                name="builderGST"
                required
                placeholder={t("Please enter GST")}
                register={register("builderGST", {
                  required: constructedBy === "2" && t("Builder GST is required"),
                })}
                errors={errors}
                onChange={() => !viewMode && clearErrors("builderGST")}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputSelect
                label={t("Builder Authorization")}
                name="builderAuth"
                required
                options={[
                  { value: "auth", label: t("Authorized") },
                  { value: "rejected", label: t("Rejected") },
                ]}
                register={register}
                errors={errors}
                value={watch("builderAuth") || ""}
                onChange={(value) => {
                  if (viewMode) return;
                  setValue("builderAuth", value, { shouldValidate: true });
                  clearErrors("builderAuth");
                }}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputFile
                label={t("Authorisation Letter")}
                name="authLetter"
                required={constructedBy === "2"}
                placeholder={t("Please upload Authorisation Letter")}
                register={register("authLetter", {
                  required: constructedBy === "2" && t("Authorization Letter is required"),
                })}
                errors={errors}
                value={watch("authLetter")?.[0]}
                onChange={e => {
                  if (viewMode) return;
                  setValue("authLetter", e.target.files);
                  clearErrors("authLetter");
                }}
                disabled={viewMode}
              />
            </Col>
          </Row>
        </Collapsible>
      )}

      {/* Documents Collapsible */}
      <Collapsible title={t("Documents")} openStat={true}>
        <Row className="gy-4">
          <Col md={6}>
            <MultipleFileUpload
              title={t("Work Order")}
              required={false}
              register={register}
              errors={errors}
              setValue={setValue}
              clearErrors={clearErrors}
              watch={watch}
              disabled={viewMode}
            />
          </Col>
          <Col md={6}>
            <MultipleFileUpload
              title={t("Drawings")}
              required={false}
              register={register}
              errors={errors}
              setValue={setValue}
              clearErrors={clearErrors}
              watch={watch}
              disabled={viewMode}
            />
          </Col>
        </Row>
        <Row className="gy-4 mt-2">
          <Col md={6}>
            <InputFile
              label={t("Tonnage Booklets")}
              name="tonnageBooklets"
              register={register("tonnageBooklets")}
              errors={errors}
              value={tonnageBooklets?.[0]}
              onChange={e => {
                if (viewMode) return;
                setValue("tonnageBooklets", e.target.files);
                clearErrors("tonnageBooklets");
              }}
              disabled={viewMode}
            />
          </Col>
          <Col md={6}>
            <InputFile
              label={t("Stability Booklets")}
              name="stabilityBooklets"
              register={register("stabilityBooklets")}
              errors={errors}
              value={stabilityBooklets?.[0]}
              onChange={e => {
                if (viewMode) return;
                setValue("stabilityBooklets", e.target.files);
                clearErrors("stabilityBooklets");
              }}
              disabled={viewMode}
            />
          </Col>
        </Row>
      </Collapsible>
      {/* Declaration Collapsible */}
      <Collapsible title={t("Declaration")} openStat={true}>
        <div className="mb-3">
          <div className="d-flex align-items-start">
            <Form.Check
              type="checkbox"
              id="termsAccepted"
              className="me-2 mt-1"
              {...register("termsAccepted", {
                required: t("You must accept the terms and conditions"),
              })}
              isInvalid={!!errors.termsAccepted}
              onChange={() => !viewMode && clearErrors("termsAccepted")}
              disabled={viewMode}
            />
            <div>
              <Form.Label
                htmlFor="termsAccepted"
                className="mb-0"
                style={{ fontWeight: 500, color: "#333", cursor: "pointer" }}
              >
                {t("I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.")}
              </Form.Label>
              {errors.termsAccepted && (
                <div className="text-danger small mt-1" style={{ display: "block" }}>
                  {errors.termsAccepted.message}
                </div>
              )}
            </div>
          </div>
        </div>
      </Collapsible>
    </form>
  );
};

export default VesselDetails;
import React from "react";
import { Card, Row, Col, Table } from "react-bootstrap";

const Invoicing = ({ supervisionAuthority, onPayNow }) => {
  return (
    <div className="container py-4">
      <h2 className="mb-4" style={{ color: "#2466BF", fontWeight: 600 }}>
        Invoicing
      </h2>
      <Row className="mb-4 justify-content-center">
        {supervisionAuthority === "iwt" && (
          <Col md={8}>
            <Card className="shadow-sm">
              <Card.Header style={{ background: "#EAF1FB", color: "#2466BF", fontWeight: 600 }}>
                Supervision Authority: IWT
              </Card.Header>
              <Card.Body>
                <Table bordered responsive className="mb-0">
                  <thead>
                    <tr>
                      <th>Payment</th>
                      <th>Fee Structure</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>Drawing Approval Fee</td>
                      <td>
                        Rs. 0.1% of the work order value<br />
                        <span style={{ color: "#888" }}>Minimum Rs. 500/- + GST</span>
                      </td>
                    </tr>
                    <tr>
                      <td>Supervision Fee</td>
                      <td>
                        <div>
                          1% of the Contract Price up to 10 lac<br />
                          <span style={{ color: "#888" }}>(Minimum Rs. 1000)</span>
                        </div>
                        <div className="mt-2">
                          Above Rs. 10 lac to 40 lac: <br />
                          <span style={{ color: "#2466BF" }}>Rs. 10,000/- + ½% of the cost above 10 lac</span>
                        </div>
                        <div className="mt-2">
                          Above Rs. 40 lac: <br />
                          <span style={{ color: "#2466BF" }}>Rs. 25,000/- + ¼% of the cost above 40 lac</span>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </Table>
              </Card.Body>
            </Card>
          </Col>
        )}
        {supervisionAuthority === "classificationSociety" && (
          <Col md={8}>
            <Card className="shadow-sm">
              <Card.Header style={{ background: "#EAF1FB", color: "#2466BF", fontWeight: 600 }}>
                Supervision Authority: Classification Society
              </Card.Header>
              <Card.Body>
                <Table bordered responsive className="mb-0">
                  <thead>
                    <tr>
                      <th>Payment</th>
                      <th>Fee Structure</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>Drawing Scrutiny Fee</td>
                      <td>
                        0.05% of the work order value<br />
                        <span style={{ color: "#888" }}>Minimum Rs. 500/-</span>
                      </td>
                    </tr>
                  </tbody>
                </Table>
              </Card.Body>
            </Card>
          </Col>
        )}
        {!supervisionAuthority && (
          <Col md={8}>
            <Card className="shadow-sm">
              <Card.Body>
                <div style={{ color: "#888", textAlign: "center" }}>
                  Please select a Supervision Authority in Step 1 to view invoicing details.
                </div>
              </Card.Body>
            </Card>
          </Col>
        )}
      </Row>
    </div>
  );
};

export default Invoicing;
