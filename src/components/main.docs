import React, { useCallback, useEffect, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepFirst.css";
import 'bootstrap/dist/css/bootstrap.min.css';
import { FaPlus, FaTimes, FaDownload } from "react-icons/fa";

const StepFirst = ({ provideSubmitHandler, formData, onValidationComplete }) => {
  const [isUploading, setIsUploading] = useState(false);
  const [uploadError, setUploadError] = useState(null);
  const methods = useForm({
    mode: "onChange",
    defaultValues: {
      identificationType: "incorporated",
      financialCreditorName: "",
      financialCreditorEmail: "",
      addressLine1: "",
      addressLine2: "",
      city: "",
      state: "",
      pincode: "",
      identificationtype_details: [{ id: 1, details: "", proof: null }]
    }
  });

  const {
    register,
    handleSubmit,
    formState: { errors, isValid },
    trigger,
    setValue,
    control,
    getValues,
    watch,
    resetField
  } = methods;

  const watchIdentificationType = watch("identificationType", "incorporated");
  const identificationDetails = watch("identificationtype_details", []);
  const [initialLoad, setInitialLoad] = useState(true);

  // Initialize form on first load only
  useEffect(() => {
    if (formData && initialLoad) {
      const cleanData = { ...formData };

      Object.keys(cleanData).forEach(key => {
        setValue(key, cleanData[key]);
      });

      if (!cleanData.identificationtype_details || cleanData.identificationtype_details.length === 0) {
        setValue("identificationtype_details", [{ id: 1, details: "", proof: null }]);
      }

      setInitialLoad(false);
    }
  }, [formData, setValue, initialLoad]);

  // Clear all data when switching between Identification Types
  useEffect(() => {
    if (!initialLoad) {
      setValue("identificationtype_details", [{ id: 1, details: "", proof: null }]);
    }
  }, [watchIdentificationType, setValue, initialLoad]);

  // Upload handler
  const handleFileUpload = async (file) => {
    try {
      setIsUploading(true);
      setUploadError(null);
      const result = await uploadDocument(file, 'identification');
      return {
        fileId: result.fileId,
        fileName: file.name,
        fileType: file.type
      };
    } catch (error) {
      setUploadError(error.message);
      throw error;
    } finally {
      setIsUploading(false);
    }
  };

  // Add new record
  const addIdentificationRecord = () => {
    const newId = identificationDetails.length > 0
      ? Math.max(...identificationDetails.map(r => r.id)) + 1
      : 1;
    const newRecord = { id: newId, details: "", proof: null };
    setValue("identificationtype_details", [...identificationDetails, newRecord]);
  };

  // Remove record
  const removeIdentificationRecord = (id) => {
    if (identificationDetails.length > 1) {
      const updatedRecords = identificationDetails.filter(record => record.id !== id);
      setValue("identificationtype_details", updatedRecords);
    }
  };

  // Update details
  const updateRecordDetails = (id, value) => {
    const updated = identificationDetails.map(rec =>
      rec.id === id ? { ...rec, details: value } : rec
    );
    setValue("identificationtype_details", updated);
  };

  // Upload proof
  const updateRecordProof = async (e, id) => {
    const file = e.target.files[0];
    if (!file) return;
    try {
      const doc = await handleFileUpload(file);
      const updated = identificationDetails.map(rec =>
        rec.id === id ? { ...rec, proof: doc } : rec
      );
      setValue("identificationtype_details", updated);
    } catch (err) {
      console.error("Upload failed:", err);
    }
  };

  // Remove proof
  const handleRemoveProof = (id) => {
    const updated = identificationDetails.map(rec =>
      rec.id === id ? { ...rec, proof: null } : rec
    );
    setValue("identificationtype_details", updated);
  };

  // Submit handler
  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    if (!isValid) return false;

    const values = getValues();

    return {
      step1: {
        identificationType: values.identificationType,
        financialCreditorName: values.financialCreditorName,
        financialCreditorEmail: values.financialCreditorEmail,
        addressLine1: values.addressLine1,
        addressLine2: values.addressLine2,
        city: values.city,
        state: values.state,
        pincode: values.pincode,
        identificationtype_details: values.identificationtype_details
      }
    };
  }, [trigger, getValues]);

  // Provide submit handler to parent
  useEffect(() => {
    if (provideSubmitHandler) provideSubmitHandler(onSubmit);
  }, [provideSubmitHandler, onSubmit]);

  // Handle validation status
  useEffect(() => {
    if (onValidationComplete) onValidationComplete(isValid);
  }, [isValid, onValidationComplete]);

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        <div className="mb-4 bg-light p-4 rounded-3">
          <Collapsible title="Basic Details" defaultOpen>
            <div className="container-fluid">
              <div className="row g-3">
                {/* Basic Fields */}
                {[
                  {
                    name: "financialCreditorName",
                    label: <>Name of the financial creditor <span className="required-asterisk">*</span></>,
                    rules: { required: "Name is required" }
                  },
                  {
                    name: "financialCreditorEmail",
                    label: <>Email address <span className="required-asterisk">*</span></>,
                    type: "email",
                    rules: {
                      required: "Email is required",
                      pattern: {
                        value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                        message: "Invalid email"
                      }
                    }
                  },
                  {
                    name: "identificationType",
                    label: <>Identification Type <span className="required-asterisk">*</span></>,
                    type: "radio",
                    options: [
                      { value: "incorporated", label: "Incorporated body" },
                      { value: "partnership", label: "Partnership or individual" }
                    ],
                    rules: { required: "Select an option" }
                  }
                ].map((f) => (
                  <div key={f.name} className="col-md-6">
                    <DynamicField
                      fieldConfig={f}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      trigger={trigger}
                      getValues={getValues}
                    />
                  </div>
                ))}
              </div>

              <div className="mt-3">
                <h5>
                  {watchIdentificationType === "incorporated" ? "Incorporation Details" : "Partnership Records"}
                </h5>

                {identificationDetails.map((record, index) => (
                  <div key={record.id} className="mb-4 p-3 border rounded">
                    {watchIdentificationType === "partnership" && (
                      <div className="d-flex justify-content-between align-items-center mb-3">
                        <h6>Record {index + 1}</h6>
                        {identificationDetails.length > 1 && (
                          <button
                            type="button"
                            className="btn btn-sm btn-danger"
                            onClick={() => removeIdentificationRecord(record.id)}
                          >
                            <FaTimes /> Remove
                          </button>
                        )}
                      </div>
                    )}

                    <div className="row g-3">
                      <div className="col-12">
                        <label>
                          {watchIdentificationType === "incorporated" 
                            ? "Identification Number" 
                            : "Partner Name / Details"}{" "}
                          <span className="required-asterisk">*</span>
                        </label>
                        <input
                          type="text"
                          className={`form-control ${errors.identificationtype_details?.[index]?.details ? 'is-invalid' : ''}`}
                          value={record.details}
                          onChange={(e) => updateRecordDetails(record.id, e.target.value)}
                          placeholder={
                            watchIdentificationType === "incorporated" 
                              ? "Enter Identification Number" 
                              : "Enter Partner Details"
                          }
                        />
                        {errors.identificationtype_details?.[index]?.details && (
                          <div className="invalid-feedback d-block">
                            {errors.identificationtype_details[index].details.message}
                          </div>
                        )}
                      </div>

                      <div className="col-12">
                        <label>
                          Proof of Identification <span className="required-asterisk">*</span>
                        </label>
                        {record.proof ? (
                          <div className="d-flex align-items-center mt-2">
                            <span className="me-2">{record.proof.fileName}</span>
                            <a
                              href={`${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${record.proof.fileId}`}
                              target="_blank"
                              rel="noopener noreferrer"
                              className="btn btn-sm btn-outline-primary me-2"
                            >
                              <FaDownload /> Download
                            </a>
                            <button
                              type="button"
                              className="btn btn-sm btn-outline-danger"
                              onClick={() => handleRemoveProof(record.id)}
                            >
                              <FaTimes /> Remove
                            </button>
                          </div>
                        ) : null}

                        <input
                          type="file"
                          id={`proof_${record.id}`}
                          onChange={(e) => updateRecordProof(e, record.id)}
                          className="d-none"
                          disabled={isUploading}
                        />
                        <label htmlFor={`proof_${record.id}`} className="btn btn-outline-primary w-100 mt-2">
                          {isUploading ? (
                            <>
                              <span className="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                              Uploading...
                            </>
                          ) : "Choose File"}
                        </label>

                        {errors.identificationtype_details?.[index]?.proof && (
                          <div className="invalid-feedback d-block">
                            {errors.identificationtype_details[index].proof.message}
                          </div>
                        )}
                        <small className="form-text text-muted mt-1">Max file size: 5MB (PDF, JPEG, PNG)</small>
                      </div>
                    </div>
                  </div>
                ))}

                {watchIdentificationType === "partnership" && (
                  <button
                    type="button"
                    className="btn btn-outline-primary mt-2"
                    onClick={addIdentificationRecord}
                  >
                    <FaPlus /> Add Another Record
                  </button>
                )}
              </div>
            </div>
          </Collapsible>

          {/* Address Section */}
          <Collapsible title="Address Details" defaultOpen>
            <div className="container-fluid">
              <div className="row g-3">
                {[
                  { name: "addressLine1", label: <>Address line 1 <span className="required-asterisk">*</span></>, rules: { required: "Required" } },
                  { name: "addressLine2", label: "Address line 2" },
                  { name: "city", label: <>City <span className="required-asterisk">*</span></>, rules: { required: "Required" } },
                  { name: "state", label: <>State <span className="required-asterisk">*</span></>, rules: { required: "Required" } },
                  { name: "pincode", label: <>Pincode <span className="required-asterisk">*</span></>, rules: { required: "Required" } }
                ].map(f => (
                  <div key={f.name} className="col-md-6">
                    <DynamicField
                      fieldConfig={f}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      trigger={trigger}
                      getValues={getValues}
                    />
                  </div>
                ))}
              </div>
            </div>
          </Collapsible>
        </div>
      </form>
    </FormProvider>
  );
};

export default StepFirst;
