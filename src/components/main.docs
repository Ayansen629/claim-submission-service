import React, { useState, useEffect, useRef } from "react";
import { useForm, useFieldArray } from "react-hook-form";
import { Row, Col, Button, Card } from "react-bootstrap";
import InputText from "../../../../../common/InputText.tsx";
import InputSelect from "../../../../../common/InputSelect.tsx";
import Collapsible from "../../../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import { FaShip, FaCog, FaPlus, FaTrash, FaExchangeAlt } from "react-icons/fa";
import { Book } from "react-bootstrap-icons";

const BookOfRegistrationForm = ({ formMethods, viewMode = false, registrationData }) => {
  const { t } = useTranslation();
  
  const methods = formMethods || useForm({ mode: "onTouched" });
  const { register, watch, setValue, control, formState: { errors } } = methods;

  const { fields: transactionFields, append: appendTransaction, remove: removeTransaction } = useFieldArray({
    control,
    name: "transactions"
  });

  const { fields: subsequentFields, append: appendSubsequent, remove: removeSubsequent } = useFieldArray({
    control,
    name: "subsequentTransactions"
  });

  useEffect(() => {
    if (transactionFields.length === 0) {
      appendTransaction({
        personName: "",
        sharesAffected: "",
        registryDate: "",
        registryHour: ""
      });
    }
  }, [transactionFields.length, appendTransaction]);

  useEffect(() => {
    if (subsequentFields.length === 0) {
      appendSubsequent({
        natureOfTransaction: "",
        transactionDate: "",
        transfereeName: "",
        transactionNumber: ""
      });
    }
  }, [subsequentFields.length, appendSubsequent]);

  return (
    <form autoComplete="off">
      {/* Basic Vessel Information */}
      <Collapsible
        title={
          <>
            <FaShip className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("VESSEL IDENTIFICATION")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Official No. of the Vessel")}
              name="vesselInfo.officialNo"
              placeholder={t("Auto Populated")}
              register={register("vesselInfo.officialNo")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Name of Vessel")}
              name="vesselInfo.vesselName"
              placeholder={t("Auto Populated")}
              register={register("vesselInfo.vesselName")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Port of Registry of Vessel")}
              name="vesselInfo.portOfRegistry"
              placeholder={t("Auto Populated")}
              register={register("vesselInfo.portOfRegistry")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Year of Registry")}
              name="vesselInfo.yearOfRegistry"
              placeholder={t("Auto Generated")}
              register={register("vesselInfo.yearOfRegistry")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Name of Owner")}
              name="vesselInfo.ownerName"
              placeholder={t("Auto Populated")}
              register={register("vesselInfo.ownerName")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Address of Owner")}
              name="vesselInfo.ownerAddress"
              placeholder={t("Auto Populated")}
              register={register("vesselInfo.ownerAddress")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Description of Inland Vessel */}
      <Collapsible
        title={
          <>
            <FaShip className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("DESCRIPTION OF INLAND VESSEL")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Type of Vessel")}
              name="vesselDescription.typeOfVessel"
              placeholder={t("Auto Populated")}
              register={register("vesselDescription.typeOfVessel")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Category of Vessel")}
              name="vesselDescription.categoryOfVessel"
              placeholder={t("Auto Populated")}
              register={register("vesselDescription.categoryOfVessel")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Gross Tonnage")}
              name="vesselDescription.grossTonnage"
              placeholder={t("Auto Populated")}
              register={register("vesselDescription.grossTonnage")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Registered Tonnage")}
              name="vesselDescription.registeredTonnage"
              placeholder={t("Auto Populated")}
              register={register("vesselDescription.registeredTonnage")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Year of Build")}
              name="vesselDescription.yearOfBuild"
              placeholder={t("Auto Populated")}
              register={register("vesselDescription.yearOfBuild")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Place of Build")}
              name="vesselDescription.placeOfBuild"
              placeholder={t("Auto Populated")}
              register={register("vesselDescription.placeOfBuild")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Particulars of Vessels */}
      <Collapsible
        title={
          <>
            <FaShip className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("PARTICULARS OF VESSELS")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Length overall")}
              name="vesselParticulars.lengthOverall"
              placeholder={t("Auto Populated")}
              register={register("vesselParticulars.lengthOverall")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Breadth Extreme")}
              name="vesselParticulars.breadthExtreme"
              placeholder={t("Auto Populated")}
              register={register("vesselParticulars.breadthExtreme")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Depth of underside of deck amid ships, at side")}
              name="vesselParticulars.depthOfDeck"
              placeholder={t("Auto Populated")}
              register={register("vesselParticulars.depthOfDeck")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Name of Builder")}
              name="vesselParticulars.builderName"
              placeholder={t("Auto Populated")}
              register={register("vesselParticulars.builderName")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Address of Builder")}
              name="vesselParticulars.builderAddress"
              placeholder={t("Auto Populated")}
              register={register("vesselParticulars.builderAddress")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Year of Build")}
              name="vesselParticulars.yearOfBuild"
              placeholder={t("Auto Populated")}
              register={register("vesselParticulars.yearOfBuild")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Hull Material")}
              name="vesselParticulars.hullMaterial"
              placeholder={t("Auto Populated")}
              register={register("vesselParticulars.hullMaterial")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Number of Decks")}
              name="vesselParticulars.numberOfDecks"
              placeholder={t("Auto Populated")}
              register={register("vesselParticulars.numberOfDecks")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("No. of Bulkheads")}
              name="vesselParticulars.numberOfBulkheads"
              placeholder={t("Auto Populated")}
              register={register("vesselParticulars.numberOfBulkheads")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Engine Details */}
      <Collapsible
        title={
          <>
            <FaCog className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("ENGINE")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Internal combustion engine No")}
              name="engine.engineNo"
              placeholder={t("Enter Engine No")}
              register={register("engine.engineNo")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Description")}
              name="engine.description"
              placeholder={t("Enter Description")}
              register={register("engine.description")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("No. of sets")}
              name="engine.numberOfSets"
              placeholder={t("Auto Populated")}
              register={register("engine.numberOfSets")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Made by")}
              name="engine.madeBy"
              placeholder={t("Auto Populated")}
              register={register("engine.madeBy")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Year of Make")}
              name="engine.yearOfMake"
              placeholder={t("Auto Populated")}
              register={register("engine.yearOfMake")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("No. of cylinders per set")}
              name="engine.cylindersPerSet"
              placeholder={t("Enter No. of cylinders")}
              register={register("engine.cylindersPerSet")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Diameter of cylinder in MM")}
              name="engine.cylinderDiameter"
              placeholder={t("Auto Populated")}
              register={register("engine.cylinderDiameter")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Stroke in inches")}
              name="engine.strokeInches"
              placeholder={t("Auto Populated")}
              register={register("engine.strokeInches")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("RPM")}
              name="engine.rpm"
              placeholder={t("Auto Populated")}
              register={register("engine.rpm")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("N.H.P.")}
              name="engine.nhp"
              placeholder={t("Enter N.H.P.")}
              register={register("engine.nhp")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("B.H.P.")}
              name="engine.bhp"
              placeholder={t("Auto Populated")}
              register={register("engine.bhp")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("I.H.P.")}
              name="engine.ihp"
              placeholder={t("Enter I.H.P.")}
              register={register("engine.ihp")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Propulsion */}
      <Collapsible
        title={
          <>
            <FaCog className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("PROPULSION")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Propeller Type")}
              name="propulsion.propellerType"
              placeholder={t("Auto Populated")}
              register={register("propulsion.propellerType")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Revolution/mints")}
              name="propulsion.revolutionMints"
              placeholder={t("Auto Populated")}
              register={register("propulsion.revolutionMints")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Vessel Speed")}
              name="propulsion.vesselSpeed"
              placeholder={t("Auto Populated")}
              register={register("propulsion.vesselSpeed")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Gear Type")}
              name="propulsion.gearType"
              placeholder={t("Auto Populated")}
              register={register("propulsion.gearType")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("No. of Gear")}
              name="propulsion.numberOfGear"
              placeholder={t("Auto Populated")}
              register={register("propulsion.numberOfGear")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Propulsion Type")}
              name="propulsion.propulsionType"
              placeholder={t("Enter Propulsion Type")}
              register={register("propulsion.propulsionType")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Transaction */}
      <Collapsible
        title={
          <>
            <FaExchangeAlt className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("TRANSACTION")}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem" }}>
          {transactionFields.map((field, index) => (
            <Row key={field.id} className="gy-3 mb-3 border-bottom pb-3">
              <Col md={12}>
                <InputText
                  label={t("Name of person from whom title is derived")}
                  name={`transactions.${index}.personName`}
                  placeholder={t("Enter person name")}
                  register={register(`transactions.${index}.personName`)}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={4}>
                <InputText
                  label={t("No. of shares affected")}
                  name={`transactions.${index}.sharesAffected`}
                  placeholder={t("Enter shares affected")}
                  register={register(`transactions.${index}.sharesAffected`)}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={4}>
                <InputText
                  label={t("Date of Registry")}
                  name={`transactions.${index}.registryDate`}
                  type="date"
                  register={register(`transactions.${index}.registryDate`)}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={4}>
                <InputText
                  label={t("Hour of Registry")}
                  name={`transactions.${index}.registryHour`}
                  type="time"
                  register={register(`transactions.${index}.registryHour`)}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              {!viewMode && transactionFields.length > 1 && (
                <Col md={12} className="text-end">
                  <Button
                    variant="danger"
                    size="sm"
                    onClick={() => removeTransaction(index)}
                    className="mt-1"
                  >
                    <FaTrash /> Remove
                  </Button>
                </Col>
              )}
            </Row>
          ))}
          {!viewMode && (
            <Button
              variant="outline-primary"
              onClick={() => appendTransaction({
                personName: "",
                sharesAffected: "",
                registryDate: "",
                registryHour: ""
              })}
              className="mt-2"
            >
              <FaPlus className="me-2" /> Add Transaction
            </Button>
          )}
        </div>
      </Collapsible>

      {/* Subsequent to Registration */}
      <Collapsible
        title={
          <>
            <FaExchangeAlt className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("SUBSEQUENT TO REGISTRATION")}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem" }}>
          {subsequentFields.map((field, index) => (
            <Row key={field.id} className="gy-3 mb-3 border-bottom pb-3">
              <Col md={6}>
                <InputText
                  label={t("Nature of transaction")}
                  name={`subsequentTransactions.${index}.natureOfTransaction`}
                  placeholder={t("Enter nature of transaction")}
                  register={register(`subsequentTransactions.${index}.natureOfTransaction`)}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={6}>
                <InputText
                  label={t("Date of transaction")}
                  name={`subsequentTransactions.${index}.transactionDate`}
                  type="date"
                  register={register(`subsequentTransactions.${index}.transactionDate`)}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={8}>
                <InputText
                  label={t("Name, residence and occupation of transferee or mortgagee or other person acquiring title or power")}
                  name={`subsequentTransactions.${index}.transfereeName`}
                  placeholder={t("Enter transferee details")}
                  register={register(`subsequentTransactions.${index}.transfereeName`)}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={4}>
                <InputText
                  label={t("Number of transaction")}
                  name={`subsequentTransactions.${index}.transactionNumber`}
                  placeholder={t("Enter transaction number")}
                  register={register(`subsequentTransactions.${index}.transactionNumber`)}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              {!viewMode && subsequentFields.length > 1 && (
                <Col md={12} className="text-end">
                  <Button
                    variant="danger"
                    size="sm"
                    onClick={() => removeSubsequent(index)}
                    className="mt-1"
                  >
                    <FaTrash /> Remove
                  </Button>
                </Col>
              )}
            </Row>
          ))}
          {!viewMode && (
            <Button
              variant="outline-primary"
              onClick={() => appendSubsequent({
                natureOfTransaction: "",
                transactionDate: "",
                transfereeName: "",
                transactionNumber: ""
              })}
              className="mt-2"
            >
              <FaPlus className="me-2" /> Add Subsequent Transaction
            </Button>
          )}
        </div>
      </Collapsible>
    </form>
  );
};

export default BookOfRegistrationForm;
