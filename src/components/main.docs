import React from "react";
import { Box, Typography, Paper, Button, Chip } from "@mui/material";
import { FaArrowLeft, FaEye, FaDownload, FaChevronDown } from "react-icons/fa";
import { useNavigate } from "react-router-dom";
import './ApplicationView.css';

const ApplicationView = () => {
  const navigate = useNavigate();

  const vesselData = [
    { id: 1, name: "GingerDove", number: "WX001", status: "pending" },
    { id: 2, name: "Katarzewska", number: "WX002", status: "approved" },
    { id: 3, name: "Mashame", number: "WX003", status: "pending" },
    { id: 4, name: "Matsumoto", number: "WX004", status: "rejected" },
    { id: 5, name: "Sugaiika", number: "WX005", status: "approved" },
    { id: 6, name: "Padyaia", number: "WX006", status: "pending" }
  ];

  const paymentData = [
    {
      id: "WARNING/TEAS-BANKING",
      type: "Owner Name Change",
      amount: "++++/-",
      date: "22-09-2020",
      status: "Success"
    }
  ];

  return (
    <div className="application-container">
      <div className="application-main-content">
        <div className="application-top-section">
          <div className="application-header-row">
            <Button
              startIcon={<FaArrowLeft />}
              onClick={() => navigate(-1)}
              className="application-back-button"
            >
            </Button>
            <Typography variant="h5" className="application-title">
              Application Details Update
            </Typography>
            <div className="application-id">
              WB-IWT/REG/2025/302748
            </div>
          </div>
          
          <div className="application-status-banner">
            Company name has been updated from ABC P+. Limited to [New Company Name].
          </div>
        </div>

        <div className="application-description">
          <Typography variant="h6" className="description-title">
            Description
          </Typography>
          <Box className="action-tag">
            <Typography className="action-text">Action: Networks</Typography>
          </Box>
        </div>

        <div className="application-cards-row">
          <Paper className="application-names-card">
            <div className="application-name-field">
              <Typography className="application-field-label">Existing Name</Typography>
              <div className="application-field-value">ABC P+. Limited</div>
            </div>
            <div className="application-name-field">
              <Typography className="application-field-label">New Name</Typography>
              <div className="application-field-value">[New Company Name]</div>
            </div>
          </Paper>

          <Paper className="application-file-card">
            <Typography className="application-warning-text">
              Valid documents for name change have been uploaded by the owner for your verification.
            </Typography>
            <div className="application-file-row">
              <Typography className="application-file-name">File Name</Typography>
              <div className="application-file-actions">
                <button className="application-icon-button">
                  <FaEye />
                </button>
                <button className="application-icon-button">
                  <FaDownload />
                </button>
              </div>
            </div>
          </Paper>
        </div>

        <div className="application-vessel-section">
          <div className="application-vessel-header">
            <Typography className="application-section-title">Name</Typography>
            <Typography className="application-section-title">Registration Number</Typography>
            <Typography className="application-section-title">Display/Socket Registration</Typography>
            <Typography className="application-section-title">Settings (performed in Certificate)</Typography>
            <Typography className="application-section-title">New Registration Certificate</Typography>
          </div>

          {vesselData.map((vessel, index) => (
            <div key={vessel.id} className="application-vessel-row">
              <div className="application-vessel-cell">
                <Typography className="application-vessel-number">{index + 1}</Typography>
                <Typography className="application-vessel-name">{vessel.name}</Typography>
              </div>
              <div className="application-vessel-cell">
                <Typography>{vessel.number}</Typography>
              </div>
              <div className="application-vessel-cell">
                <Typography>○○</Typography>
              </div>
              <div className="application-vessel-cell">
                <Typography>○○</Typography>
              </div>
              <div className="application-vessel-cell">
                <Typography>○○</Typography>
              </div>
            </div>
          ))}
        </div>

        <div className="application-payment-section">
          <div className="application-payment-header">
            <Typography className="application-payment-title">Payment Details</Typography>
          </div>
          
          <div className="application-payment-table-header">
            <Typography className="application-table-header-cell">Payment Id</Typography>
            <Typography className="application-table-header-cell">Payment Type</Typography>
            <Typography className="application-table-header-cell">Amount</Typography>
            <Typography className="application-table-header-cell">Payment Date</Typography>
            <Typography className="application-table-header-cell">Status</Typography>
            <Typography className="application-table-header-cell">Recover</Typography>
          </div>

          {paymentData.map((payment) => (
            <div key={payment.id} className="application-payment-row">
              <Typography className="application-payment-cell">{payment.id}</Typography>
              <Typography className="application-payment-cell">{payment.type}</Typography>
              <Typography className="application-payment-cell">{payment.amount}</Typography>
              <Typography className="application-payment-cell">{payment.date}</Typography>
              <Typography className="application-payment-cell">
                <Chip 
                  label={payment.status} 
                  size="small"
                  className="application-status-chip"
                  style={{ backgroundColor: '#4CAF50', color: 'white' }}
                />
              </Typography>
              <div className="application-payment-cell">
                <span style={{ fontSize: '18px' }}>💶 💷</span>
              </div>
            </div>
          ))}
        </div>

        <div className="application-action-section">
          <Button 
            variant="contained" 
            className="application-take-action-button"
            endIcon={<FaChevronDown />}
          >
            Take Action
          </Button>
        </div>
      </div>
    </div>
  );
};

export default ApplicationView;
