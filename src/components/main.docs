import React from 'react';
import { Row, Col, Button } from 'react-bootstrap';
import { useFormContext } from 'react-hook-form';
import InputText from './InputText.tsx';
import InputFile from './InputFile.tsx';
import { FaDownload, FaEye, FaFileAlt } from 'react-icons/fa';
import { BsFileEarmarkX } from 'react-icons/bs';
import { renameFile } from '../../utils/constants.ts';

const DynamicViewFields = ({ fields, setFormData }) => {
  const { register, formState: { errors }, setValue, watch, setError } = useFormContext();

  const handleDownload = (fileData) => {
    if (fileData && fileData.downLoadFile && fileData.downLoadFile !== "#") {
      window.open(fileData.downLoadFile, '_blank');
    } else {
      alert("Document download would start here");
    }
  };

  const handleView = (fileData) => {
    if (fileData && fileData.downLoadFile && fileData.downLoadFile !== "#") {
      window.open(fileData.downLoadFile, '_blank');
    } else {
      alert("Document viewer would open here");
    }
  };

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'file':
        if (field.disabled || field.displayOnly) {
          const value = watch(field.name);
          const hasFile = value && (value.fileName || value.downLoadFile);
          
          return (
            <div className="file-field">
              <label className="field-label">{field.label}</label>
              <div className="file-display">
                {!hasFile ? (
                  <div className="no-file">
                    <BsFileEarmarkX size={20} className="no-file-icon" />
                    <span>No document uploaded</span>
                  </div>
                ) : (
                  <div className="file-item">
                    <div className="file-info">
                      <FaFileAlt size={18} className="file-icon" />
                      <span className="file-name">
                        {value.fileName || `${field.label.replace(/[^a-zA-Z0-9]/g, '_')}.pdf`}
                      </span>
                    </div>
                    <div className="file-actions">
                      <Button 
                        variant="outline-primary" 
                        size="sm" 
                        onClick={() => handleView(value)}
                        className="file-btn view-btn"
                        title="View Document"
                      >
                        <FaEye size={12} />
                        View
                      </Button>
                      <Button 
                        variant="outline-success" 
                        size="sm" 
                        onClick={() => handleDownload(value)}
                        className="file-btn download-btn"
                        title="Download Document"
                      >
                        <FaDownload size={12} />
                        Download
                      </Button>
                    </div>
                  </div>
                )}
              </div>
            </div>
          );
        }
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
                const fileName = `${field.label}${extension}`;
                file.originalName = fileName;
                setValue(field.name, renameFile(file, fileName));
                setFormData(prev => {
                  const updated = { ...prev, [field.name]: file };
                  return updated;
                });

                const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'Only PDF, JPG or PNG files are allowed'
                  });
                }

                if (file.size > 2 * 1024 * 1024) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'File size should not exceed 2MB'
                  });
                }
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={watch(field.name)}
          />
        );

      default:
        return (
          <div className="text-field">
            <label className="form-label">{field.label}</label>
            <InputText
              required={field.required}
              name={field.name}
              key={field.name}
              type={field.type}
              placeholder={field.placeholder}
              register={register(field?.name, {
                ...field.validation,
              })}
              onChange={handleChange}
              errors={errors}
              readOnly={field.readOnly}
              icon={field.icon}
              maxlength={field?.maxlength}
              onKeyDown={field?.keyDown}
              disabled={field?.disabled || false}
              className={`form-control ${field.disabled ? 'disabled-field' : ''}`}
            />
          </div>
        );
    }
  };

  return (
    <Row className="g-4">
      {fields.map((field, index) => (
        <Col key={index} lg={field.colSize === 12 ? 12 : field.colSize === 6 ? 6 : 4} md={field.colSize === 12 ? 12 : 6} sm={12}>
          {renderField(field)}
        </Col>
      ))}
    </Row>
  );
};

export default DynamicViewFields;
