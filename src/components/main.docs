.card {
    background: linear-gradient(135deg, #ffffff, #f4f8fc);
    border-radius: 1rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.07);
    padding: 1.5rem;
    transition: all 0.3s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    /* border-left: 4px solid var(--primary-color); */
}

.card:hover {
    transform: translateY(-4px) scale(1.01);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.1);
    /* border-left-color: #1e4fa1; */
}

.header h3 {
    font-size: 1.1rem;
    color: rgba(0, 0, 0, 0.6);
    ;
    margin-bottom: 0.35rem;
}

.mainValue {
    font-size: 2rem;
    font-weight: bold;
    color: #1a1a1a;
}

.subCards {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
}

.subCard {
    flex: 1 1 calc(33.33% - 1rem);
    border-radius: 1rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.07);
    padding: 1rem;
    text-align: center;
    border-left: 2px solid var(--primary-color);
    transition: transform 0.2s ease;
    background-color: #f4f8fc;
}

/* .subCard:hover {
    transform: scale(1.03);
} */

.subCard h5 {
    font-size: 1em;
    color: #333;
    margin-bottom: 0.5rem;
}

.subValue {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--primary-color);
}

.subCount {
    font-size: 0.85rem;
    color: #888;
}

@media (max-width: 768px) {
    .subCard {
        flex: 1 1 100%;
    }
}
import React, { useState, useEffect, useRef } from "react";
import { Card, Form, InputGroup, Button } from "react-bootstrap";
import WelcomeBox from "../../common/WelcomeBox";
import "./employeeDashboard.css";

import { BsSearch, BsFilter } from "react-icons/bs";
import ActionTable from "../../common/ActionTable.tsx";
import { useNavigate } from "react-router-dom";
import StatusCard from "../../common/StatusCard";
import SurveyTrackerCard from "./SurveyTrackerCard.js";
import {
  EMPLOYEE_STAT_DATA,
  OFFICER_L1_STAT_DATA,
  INBOX_COLUMNS,
  INBOX_COLUMNS_ADMIN,
  OFFICER_L2_STAT_DATA,
  generateInboxData,
  commonDashboardCards as staticCards,
} from "./employeeDashboardConstants";
import {
  getChartColors,
  getUserRoleName,
  headerStyle,
  PROCESS_NAME,
} from "../../../utils/constants.ts";
import { FaUsersBetweenLines } from "react-icons/fa6";
import { USER_ROLES } from "../../../utils/constants.ts";
import ChartCard from "../../common/ChartCard";
import DynamicChart from "../../common/DynamicChart.js";
import ActionCard from "../../common/ActionCard.js";
import NewLoader from "../../common/NewLoader";
import { postData } from "../../../services/http.service.ts";
import { SERVICE_BASE, URLS_ENDPOINT } from "../../../utils/urlsConstants.ts";
import { handleErrorMessage } from "../../../utils/errorMessageHandler.js";
import { toast } from "react-toastify";

const EmployeeDashboard = ({ userDetails, userRole }) => {
  const [inboxData, setInboxData] = useState([]);
  const [filteredData, setFilteredData] = useState([]);
  const [currentPage, setCurrentPage] = useState(1);
  const [searchTerm, setSearchTerm] = useState("");

  const [dashboardCards, setDashboardCards] = useState([]);
  const [userRegistrationWorkList, setUserRegistrationWorkList] = useState([]);

  const itemsPerPage = 5;
  const navigate = useNavigate();
  const loaderRef = useRef(null);

  useEffect(() => {
    // const data = generateInboxData();
    // setInboxData(data);
    // setFilteredData(data);
    setDashboardCards(staticCards);
    fetchDashboardData();
  }, []);

  const fetchDashboardData = async () => {
    const URL = `${SERVICE_BASE.IWT_WORKFLOW}${URLS_ENDPOINT.WORK_FLOW_SERVICE.DASHBOARD_WORK_LIST}`;
    const payload = {
      processId: PROCESS_NAME.DASH_WORKFLOW_LIST_PROCESS_ID,
    };

    loaderRef.current?.show();

    try {
      const { status, data } = await postData(URL, payload);
      const apiRes = data?.data || {};

      if (status === 200 && Object.keys(apiRes).length) {
        console.log("Dashboard Data Response:", apiRes);
        setUserRegistrationWorkList(apiRes?.userRegistrationWorkList || []);
        const vesselList =
          apiRes?.vesselRegistrationWorkList?.[0]
            ?.registrationApplicationList || [];
        setInboxData(vesselList);
        setFilteredData(vesselList);
        const updatedCards = staticCards.map((card) =>
          card.id === "appStatUser" && card.subCards
            ? {
              ...card,
              subCards: card.subCards.map((sub) => ({
                ...sub,
                value: apiRes.userRegistrationWorkList?.[0]?.[sub.key] ?? 0,
              })),
            }
            : card
        );

        setDashboardCards(updatedCards);
        // console.log("Updated Dashboard Cards:", updatedCards);

        window.scrollTo(0, 0);
      } else {
        toast.info(
          apiRes?.responseStatus?.message || "Something went wrong..",
          {
            position: "top-right",
          }
        );
      }
    } catch (err) {
      console.error("Dashboard API Error:", err);
      handleErrorMessage(err?.response?.data);
    } finally {
      loaderRef.current?.hide();
    }
  };

  useEffect(() => {
    const results = inboxData?.filter(
      (item) =>
        item?.applicationNumber
          ?.toLowerCase()
          .includes(searchTerm.toLowerCase()) ||
        item?.applicationType
          ?.toLowerCase()
          .includes(searchTerm.toLowerCase()) ||
        item?.vesselName?.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item?.vesselOwnerName
          ?.toLowerCase()
          .includes(searchTerm.toLowerCase()) ||
        item?.vesselRegistrationNumber
          ?.toLowerCase()
          .includes(searchTerm.toLowerCase()) ||
        item?.status?.toLowerCase().includes(searchTerm.toLowerCase())
    );
    setFilteredData(results);
    setCurrentPage(1);
  }, [searchTerm, inboxData]);

  const handleTablePageChange = (page) => {
    setCurrentPage(page);
  };
  // const getStatData = () => {
  //   switch (userRole) {
  //     case USER_ROLES.OFFICER_L1:
  //       return OFFICER_L1_STAT_DATA;
  //     case USER_ROLES.OFFICER_L2:
  //       return OFFICER_L2_STAT_DATA;
  //     case USER_ROLES.ADMIN:
  //     default:
  //       return EMPLOYEE_STAT_DATA;
  //   }
  // };

  const onActionCardClick = (e) => {
    console.log(e);
    navigate("/user-registration/view");
  };

  const handleViewAction = (rowData) => {
    console.log("Row Data:", rowData?.applicationNumber);
    const regNo = rowData?.applicationNumber;
    navigate(`/officer/vessel-registration/view?applicationNo=${regNo}`, {
      state: {
        rowData: { ...rowData },
      },
    });
  };

  const getInboxColumns = () => {
    return userRole === USER_ROLES.ADMIN ? INBOX_COLUMNS_ADMIN : INBOX_COLUMNS;
  };
  // const getDashboardTitle = () => {
  //   switch (userRole) {
  //     case USER_ROLES.OFFICER_L1:
  //       return "Officer L1 Dashboard";
  //     case USER_ROLES.OFFICER_L2:
  //       return "Officer L2 Dashboard";
  //     case USER_ROLES.ADMIN:
  //       return "Admin Dashboard";
  //     default:
  //       return "My WorkDesk";
  //   }
  // };

  return (
    <>
      <NewLoader ref={loaderRef} />

      <WelcomeBox
        userName={
          userDetails ? `${userDetails.firstName} ${userDetails.lastName}` : ""
        }
        title={getUserRoleName(userRole)}
        desc="Here's your Dashboard overview."
      />

      <Card
        style={{ bottom: "2rem", padding: 0 }}
        className="bg-transparent dashboard-card"
      >
        {userRole === USER_ROLES.ADMIN && (
          <Card.Header className="dashboard-card-header">
            <div style={{ float: "right", width: 180 }}>
              <button
                className="generic-btn-submit"
                type="button"
                onClick={() =>
                  navigate(
                    "/dashboard/employee-dashboard/employee-applications"
                  )
                }
              >
                View Applications &nbsp;{" "}
                <FaUsersBetweenLines size={15} color={"#fff"} />
              </button>
            </div>
          </Card.Header>
        )}

        <Card.Body>
          {/* <div className="row g-3">
            {getStatData().map((item, index) => (
              <div
                className={
                  item.isCalendar
                    ? "col-md-8 col-lg-6 col-sm-12"
                    : "col-md-4 col-lg-3 col-sm-12"
                }
                key={index}
              >
                {item.isCalendar ? (
                  <SurveyTrackerCard
                    events={item.events}
                    color={item.color || "#6f42c1"}
                  />
                ) : (
                  <StatusCard {...item} />
                )}
              </div>
            ))}
          </div> */}
          <div className="row g-3">
            {dashboardCards?.map((card, idx) => (
              <div className="col-md-4" key={idx}>
                {card.type === "chart" ? (
                  <ChartCard
                    title={card.title}
                    count={card.count}
                    label1={card.label1}
                    value1={card.value1}
                    label2={card.label2}
                    value2={card.value2}
                  >
                    <DynamicChart
                      type={card.chartProps.type}
                      data={card.chartProps.data}
                      options={card.chartProps.options}
                      height={card.chartProps.height}
                      barThickness={card.chartProps.barThickness}
                    />
                  </ChartCard>
                ) : (
                  <ActionCard
                    title={card.title}
                    subCards={card.subCards}
                    onClick={onActionCardClick}
                  />
                )}
              </div>
            ))}
          </div>
        </Card.Body>
      </Card>

      <Card className="bg-transparent mt-4 dashboard-card">
        <Card.Header
          style={headerStyle}
          className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
        >
          <div className="d-flex align-items-center">
            <h5 className="mb-0 me-2">Inbox</h5>
            <span className="badge bg-primary rounded-pill">
              {filteredData.length}
            </span>
          </div>
          <div className="d-flex align-items-center">
            <Button variant="outline-secondary" className="filter-btn me-2">
              <BsFilter size={18} />
              <span className="ms-1 d-none d-sm-inline">Filter</span>
            </Button>
            <Form className="inbox-search">
              <InputGroup>
                <Form.Control
                  type="text"
                  placeholder="Search inbox..."
                  aria-label="Search inbox"
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                />
                <Button variant="primary">
                  <BsSearch />
                </Button>
              </InputGroup>
            </Form>
          </div>
        </Card.Header>
        <div style={{ position: "relative", bottom: "2rem" }}>
          <ActionTable
            columns={getInboxColumns()}
            onViewRow={
              userRole !== USER_ROLES.ADMIN ? handleViewAction : undefined
            }
            rowData={filteredData}
            tableHeader={null}
            hideExportBtn={true}
            hideSearchBar={true}
            pagination={true}
            currentPage={currentPage}
            itemsPerPage={itemsPerPage}
            onPageChange={handleTablePageChange}
            noDataText={
              <div className="no-results text-center py-4">
                <BsSearch size={24} className="mb-2" />
                <p>No results found</p>
                <small>
                  Try adjusting your search to find what you're looking for.
                </small>
              </div>
            }
          />
        </div>
      </Card>
    </>
  );
};

export default EmployeeDashboard;

