import React, { useState, useEffect } from 'react';
import { Card, CardContent, Typography, Button, Box, Grid, TextField, IconButton } from '@mui/material';
import { CloudUpload, Delete, Visibility, Download } from '@mui/icons-material';

const EditModeFileCard = ({ file, onDescriptionChange, onRemove }) => (
  <Card sx={{ mb: 2, border: '1px solid #e0e0e0' }}>
    <CardContent sx={{ p: 2 }}>
      <Grid container spacing={2} alignItems="center">
        <Grid item xs={12} sm={6}>
          <Typography variant="body2" sx={{ fontWeight: 500 }}>
            {file.name}
          </Typography>
          <Typography variant="caption" color="text.secondary">
            {file.size ? `${(file.size / 1024).toFixed(1)} KB` : 'Existing file'}
          </Typography>
        </Grid>
        <Grid item xs={12} sm={4}>
          <TextField
            fullWidth
            size="small"
            placeholder="Enter description"
            value={file.description || ''}
            onChange={(e) => onDescriptionChange(file.id, e.target.value)}
          />
        </Grid>
        <Grid item xs={12} sm={2}>
          <Box sx={{ display: 'flex', gap: 1 }}>
            <IconButton size="small" color="primary">
              <Visibility />
            </IconButton>
            <IconButton size="small" color="error" onClick={() => onRemove(file.id)}>
              <Delete />
            </IconButton>
          </Box>
        </Grid>
      </Grid>
    </CardContent>
  </Card>
);

const FileUploadCard = ({ file, onDescriptionChange, onRemove }) => (
  <Card sx={{ mb: 2, border: '1px solid #e0e0e0' }}>
    <CardContent sx={{ p: 2 }}>
      <Grid container spacing={2} alignItems="center">
        <Grid item xs={12} sm={6}>
          <Typography variant="body2" sx={{ fontWeight: 500 }}>
            {file.name}
          </Typography>
          <Typography variant="caption" color="text.secondary">
            {(file.size / 1024).toFixed(1)} KB
          </Typography>
        </Grid>
        <Grid item xs={12} sm={4}>
          <TextField
            fullWidth
            size="small"
            placeholder="Enter description"
            value={file.description || ''}
            onChange={(e) => onDescriptionChange(file.id, e.target.value)}
          />
        </Grid>
        <Grid item xs={12} sm={2}>
          <IconButton size="small" color="error" onClick={() => onRemove(file.id)}>
            <Delete />
          </IconButton>
        </Grid>
      </Grid>
    </CardContent>
  </Card>
);

const Documents = ({ formData, setFormData, mode = 'normal' }) => {
  const [workOrderFiles, setWorkOrderFiles] = useState([]);
  const [drawingFiles, setDrawingFiles] = useState([]);
  const [tonnageFiles, setTonnageFiles] = useState([]);
  const [stabilityFiles, setStabilityFiles] = useState([]);

  useEffect(() => {
    if (mode === 'edit' && formData) {
      // Initialize work order files for edit mode
      const workOrderFilesList = [];
      for (let i = 1; i <= 50; i++) {
        const fileKey = `WORK_ORDER_file_${i}`;
        const descKey = `WORK_ORDER_file_${i}_description`;
        if (formData[fileKey]) {
          workOrderFilesList.push({
            id: i,
            name: formData[fileKey],
            description: formData[descKey] || '',
            isExisting: true
          });
        }
      }
      setWorkOrderFiles(workOrderFilesList);

      // Initialize drawing files for edit mode
      const drawingFilesList = [];
      for (let i = 1; i <= 50; i++) {
        const fileKey = `DRAWINGS_file_${i}`;
        const descKey = `DRAWINGS_file_${i}_description`;
        if (formData[fileKey]) {
          drawingFilesList.push({
            id: i,
            name: formData[fileKey],
            description: formData[descKey] || '',
            isExisting: true
          });
        }
      }
      setDrawingFiles(drawingFilesList);

      // Initialize tonnage files
      const tonnageFilesList = [];
      for (let i = 1; i <= 10; i++) {
        const fileKey = `TONNAGE_BOOKLET_file_${i}`;
        const descKey = `TONNAGE_BOOKLET_file_${i}_description`;
        if (formData[fileKey]) {
          tonnageFilesList.push({
            id: i,
            name: formData[fileKey],
            description: formData[descKey] || '',
            isExisting: true
          });
        }
      }
      setTonnageFiles(tonnageFilesList);

      // Initialize stability files
      const stabilityFilesList = [];
      for (let i = 1; i <= 10; i++) {
        const fileKey = `STABILITY_BOOKLET_file_${i}`;
        const descKey = `STABILITY_BOOKLET_file_${i}_description`;
        if (formData[fileKey]) {
          stabilityFilesList.push({
            id: i,
            name: formData[fileKey],
            description: formData[descKey] || '',
            isExisting: true
          });
        }
      }
      setStabilityFiles(stabilityFilesList);
    }
  }, [formData, mode]);

  const handleFileUpload = (event, type) => {
    const files = Array.from(event.target.files);
    const newFiles = files.map((file, index) => ({
      id: Date.now() + index,
      file,
      name: file.name,
      size: file.size,
      description: ''
    }));

    if (type === 'workOrder') {
      setWorkOrderFiles(prev => [...prev, ...newFiles]);
    } else if (type === 'drawings') {
      setDrawingFiles(prev => [...prev, ...newFiles]);
    } else if (type === 'tonnage') {
      setTonnageFiles(prev => [...prev, ...newFiles]);
    } else if (type === 'stability') {
      setStabilityFiles(prev => [...prev, ...newFiles]);
    }
  };

  const handleDescriptionChange = (fileId, description, type) => {
    if (type === 'workOrder') {
      setWorkOrderFiles(prev => prev.map(file => 
        file.id === fileId ? { ...file, description } : file
      ));
    } else if (type === 'drawings') {
      setDrawingFiles(prev => prev.map(file => 
        file.id === fileId ? { ...file, description } : file
      ));
    } else if (type === 'tonnage') {
      setTonnageFiles(prev => prev.map(file => 
        file.id === fileId ? { ...file, description } : file
      ));
    } else if (type === 'stability') {
      setStabilityFiles(prev => prev.map(file => 
        file.id === fileId ? { ...file, description } : file
      ));
    }
  };

  const handleRemoveFile = (fileId, type) => {
    if (type === 'workOrder') {
      setWorkOrderFiles(prev => prev.filter(file => file.id !== fileId));
    } else if (type === 'drawings') {
      setDrawingFiles(prev => prev.filter(file => file.id !== fileId));
    } else if (type === 'tonnage') {
      setTonnageFiles(prev => prev.filter(file => file.id !== fileId));
    } else if (type === 'stability') {
      setStabilityFiles(prev => prev.filter(file => file.id !== fileId));
    }
  };

  const renderFileSection = (title, files, type, maxFiles = 50) => (
    <Card sx={{ mb: 3 }}>
      <CardContent>
        <Typography variant="h6" sx={{ mb: 2, fontWeight: 600 }}>
          {title}
        </Typography>
        
        {mode !== 'view' && (
          <Box sx={{ mb: 3 }}>
            <input
              accept="*/*"
              style={{ display: 'none' }}
              id={`${type}-upload`}
              multiple
              type="file"
              onChange={(e) => handleFileUpload(e, type)}
            />
            <label htmlFor={`${type}-upload`}>
              <Button
                variant="outlined"
                component="span"
                startIcon={<CloudUpload />}
                sx={{ mb: 2 }}
              >
                Upload Files ({files.length}/{maxFiles})
              </Button>
            </label>
          </Box>
        )}

        {files.length > 0 ? (
          files.map((file) => (
            mode === 'edit' && file.isExisting ? (
              <EditModeFileCard
                key={file.id}
                file={file}
                onDescriptionChange={(id, desc) => handleDescriptionChange(id, desc, type)}
                onRemove={(id) => handleRemoveFile(id, type)}
              />
            ) : (
              <FileUploadCard
                key={file.id}
                file={file}
                onDescriptionChange={(id, desc) => handleDescriptionChange(id, desc, type)}
                onRemove={(id) => handleRemoveFile(id, type)}
              />
            )
          ))
        ) : (
          <Typography variant="body2" color="text.secondary">
            No files uploaded yet
          </Typography>
        )}
      </CardContent>
    </Card>
  );

  return (
    <Box sx={{ p: 3 }}>
      <Typography variant="h5" sx={{ mb: 3, fontWeight: 600 }}>
        Documents Upload
      </Typography>

      {renderFileSection('Work Order Files', workOrderFiles, 'workOrder', 50)}
      {renderFileSection('Drawing Files', drawingFiles, 'drawings', 50)}
      {renderFileSection('Tonnage Booklet', tonnageFiles, 'tonnage', 10)}
      {renderFileSection('Stability Booklet', stabilityFiles, 'stability', 10)}
    </Box>
  );
};

export default Documents;
