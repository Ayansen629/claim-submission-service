/* ActionTable.module.css */

/* Table Container */
.table_container {
  width: 100%;
  overflow-x: auto;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1); /* Slightly softer shadow */
  margin-bottom: 20px;
  background-color: #fff; /* Pure white background */
}

/* Table */
.table {
  width: 100%;
  border-collapse: collapse;
  background-color: #fff;
}

/* Table Header */
.table_header {
  background-color: #f8f9fa; /* Light gray background for header */
  color: #495057; /* Dark gray text for header */
  font-weight: 600; /* Semi-bold header text */
  padding: 12px 16px; /* Adjusted padding */
  text-align: left;
  font-size: 1rem; /* Standard font size */
  border-bottom: 1px solid #dee2e6; /* Light gray bottom border */
}

.sortable_header {
  cursor: pointer;
  user-select: none;
}

.sortable_header:hover {
  background-color: #e9ecef; /* Slightly darker on hover */
}

.table_arrow {
  margin-left: 0.5rem;
  font-size: 0.8rem;
  color: #6c757d; /* Muted arrow color */
}

/* Table Data Rows */
.table_datarow {
  background-color: #fff;
  transition: background-color 0.2s ease-in-out; /* Smoother transition */
}

.table_datarow:nth-child(even) {
  background-color: #f8f9fa; /* Light gray for even rows */
}

.selected_row {
  background-color: #e0f7fa !important; /* Light cyan for selected rows */
}

.table_datarow:hover {
  background-color: #f5f5f5; /* Light gray on hover */
}

.table_data {
  padding: 10px 16px; /* Adjusted padding */
  font-size: 0.9rem; /* Slightly smaller font */
  color: #333; /* Darker text color */
  border-bottom: 1px solid #eee; /* Very light gray border */
  text-align: left;
}

.clickable_cell {
  cursor: pointer;
  color: #007bff; /* Bootstrap primary color for clickable text */
}

.clickable_cell:hover {
  text-decoration: underline;
}

.unread {
  font-weight: 500; /* Slightly bolder for unread items */
}

/* Status Badge */
.status_badge {
  display: inline-block;
  padding: 0.25rem 0.5rem;
  border-radius: 0.25rem;
  font-size: 0.8rem;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
}

.approve_status {
  background-color: #d4edda;
  color: #155724;
}

.initiate_status {
  background-color: #cce5ff;
  color: #004085;
}

.pending_status {
  background-color: #fff3cd;
  color: #85640a;
}

/* Action Cell */
.action_cell {
  text-align: center;
}

.action_button {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  cursor: pointer;
}

.action_button:focus {
  outline: none;
}

.action_button img,
.action_button svg {
  width: 18px;
  height: 18px;
  vertical-align: middle;
  opacity: 0.8;
  transition: opacity 0.2s ease-in-out;
}

.action_button:hover img,
.action_button:hover svg {
  opacity: 1;
}

.edit_button:hover img {
  /* You can add specific hover styles for each action if needed */
}

.view_button:hover img {
}

.track_button svg {
  fill: #007bff; /* Bootstrap primary color for track icon */
}

.track_button:hover svg {
  fill: #0056b3;
}

/* Table Controls (Search, Filters, Button) */
.table_controls {
  align-items: center; /* Vertically align items in the control bar */
}

.table_controls .input-group {
  max-width: 400px; /* Limit the width of the search bar */
}

.table_controls .input-group-text {
  background-color: #e9ecef;
  border: 1px solid #ced4da;
  color: #495057;
}

.table_controls .form-control {
  border: 1px solid #ced4da;
}

.table_controls .form-control:focus {
  border-color: #007bff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.table_controls .btn-primary {
  background-color: #007bff;
  border-color: #007bff;
}

.table_controls .btn-primary:hover {
  background-color: #0056b3;
  border-color: #0056b3;
}

.table_controls .btn-primary:focus {
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.5);
}

.table_controls .btn-outline-secondary {
  color: #6c757d;
  border-color: #6c757d;
}

.table_controls .btn-outline-secondary:hover {
  background-color: #6c757d;
  border-color: #6c757d;
  color: #fff;
}

.table_controls .dropdown-toggle::after {
  vertical-align: middle; /* Align dropdown arrow */
}

.table_controls .dropdown-menu {
  border: 1px solid rgba(0, 0, 0, 0.15);
  box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.175);
}

.table_controls .dropdown-item.active,
.table_controls .dropdown-item:active {
  background-color: #007bff;
  color: #fff;
}

.table_controls .dropdown-item .fa-check {
  color: #28a745; /* Green checkmark for active item */
}

/* Table Footer */
.table_footer {
  background-color: #f8f9fa;
  color: #495057;
  padding: 10px 15px;
  border-top: 1px solid #dee2e6;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.875rem;
}

.selection_info {
  font-size: 0.875rem;
  color: #6c757d;
}

.pagination_button {
  padding: 0.25rem 0.5rem;
  font-size: 0.875rem;
  border-radius: 0.2rem;
}

.page_number {
  margin: 0 0.5rem;
  color: #495057;
}

/* No Records Found */
.no_records {
  padding: 2rem;
  text-align: center;
  color: #6c757d;
}

.no_records i {
  font-size: 1.5rem;
  margin-right: 0.5rem;
}

/* Pagination Options (Rows per page dropdown) */
#export_button { /* Keeping the ID for consistency with the component's ref */
  align-items: center;
}

#export_button .pe-2 {
  color: #6c757d;
  font-size: 0.875rem;
}

#export_button .dropdown-toggle {
  background-color: #fff;
  border: 1px solid #ced4da;
  color: #495057;
  padding: 0.25rem 0.5rem;
  font-size: 0.875rem;
  border-radius: 0.2rem;
}

#export_button .dropdown-toggle:hover {
  border-color: #007bff;
}

#export_button .dropdown-toggle:focus {
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

#export_button .dropdown-menu {
  border: 1px solid rgba(0, 0, 0, 0.15);
  box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.175);
}

#export_button .dropdown-item {
  font-size: 0.875rem;
  color: #495057;
}

#export_button .dropdown-item.active,
#export_button .dropdown-item:active {
  background-color: #007bff;
  color: #fff;
}

#export_button .dropdown-item .fa-check {
  color: #28a745;
}

/* Media Queries for Smaller Screens */
@media (max-width: 768px) {
  .table_header,
  .table_data,
  .table_footer,
  .selection_info,
  .pagination_button,
  .page_number,
  #export_button .pe-2,
  #export_button .dropdown-toggle,
  #export_button .dropdown-item {
    font-size: 0.8rem;
    padding: 8px 12px;
  }

  .table_controls {
    flex-direction: column; /* Stack controls on smaller screens */
    align-items: stretch;
  }

  .table_controls > div {
    margin-bottom: 0.5rem;
  }

  .table_controls .input-group {
    max-width: none; /* Allow search bar to take full width */
  }

  .action_button img,
  .action_button svg {
    width: 16px;
    height: 16px;
  }
}
