import React, { useState, useEffect, useRef, use } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useSearchParams, useLocation, useNavigate } from "react-router-dom";
import Stepper from "../../../../common/Stepper.jsx";
import { useForm } from "react-hook-form";
import ActionDropdown from "../../../../common/ActionDropdown";
import ApprovalModal from "../../../../common/ApprovalModal";
import { useTranslation } from "react-i18next";
import { toast } from "react-toastify";
import { postData } from "../../../../../services/http.service.ts";
import {
  SERVICE_BASE,
  URLS_ENDPOINT,
  BASE_IP,
} from "../../../../../utils/urlsConstants.ts";
import VesselBasicDetailsView from "./VesselBasicDetailsView.js";
import ReportsDashboard from "./reports/reportsDashboard.js";
import { Button } from "react-bootstrap";
import { BsArrowLeft } from "react-icons/bs";
import RegistrationApplicationForm from "./RegistrationApplicationForm.jsx";
import NewLoader from "../../../../common/NewLoader.js";
import InvoiceModal from "../../../../common/InvoiceModal.js";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import {
  APPLICATION_TYPES,
  OFFICER_ROLES,
  USER_ROLES,
} from "../../../../../utils/constants.ts";
import { handleErrorMessage } from "../../../../../utils/errorMessageHandler.js";
import CurvingMarkingNote from "../../new-vessel/common/CurvingMarkingNote.js";
import CurvingMarkingNoteL5 from "../../new-vessel/common/CurvingMarkingNoteL5.js";

// Import your custom toast system
import { toastShow, CustomToastContainer } from "../../../../common/toasts";

const VesselReportsAndDocs = ({
  applicationNo,
  viewMode = false,
  tabMode = false,
}) => {
  // ... existing state variables ...
  
  // Add state for appointment selection tracking
  const [hasSelectedAppointment, setHasSelectedAppointment] = useState(false);

  // ... existing useEffect and other functions ...

  // Update the handleActionClick function
  const handleActionClick = (action) => {
    if (action?.actionName === "Generate CMN") {
      setShowCmnStepper(true);
      
      const originalActions =
        registrationData?.processActionMapResponce?.[0]?.processs?.[0]
          ?.actions || [];

      const updatedActions = originalActions.filter(
        (item) => item.actionName !== "Generate CMN"
      );

      setActionsFromAPI(updatedActions);

      // Use your custom toast
      toastShow.notify("CMN Generated successfully. Please proceed with the next step.", {
        duration: 5,
        targetId: 'toast-container',
        type: 'success'
      });
      return;
    }

    // Check if appointments are required but not selected
    const hasAppointmentSlots = registrationData?.appointmentSlots?.length > 0;
    const hasBookedAppointment = registrationData?.appointmentSlots?.some(slot => slot.isBooked);
    
    // If CMN is generated but no appointments selected, show warning
    if (showCmnStepper && !hasAppointmentSlots && !hasSelectedAppointment) {
      toastShow.notify("Please select proposal appointments first before taking action.", {
        duration: 5,
        targetId: 'toast-container',
        type: 'warning'
      });
      return;
    }

    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  // Update handleSubmitAppointments function
  const handleSubmitAppointments = async (appointmentSlots) => {
    try {
      loaderRef.current?.show();

      const payload = {
        ...createRegistrationPayload(methods.getValues(), {}, appointmentSlots),
      };

      const apiUrl =
        SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.VESSEL_SERVICE.CREATE;
      const response = await postData(apiUrl, payload);

      if (response?.status === 200 && response?.data?.responseStatus) {
        // Mark that appointment has been selected
        setHasSelectedAppointment(true);
        
        toastShow.notify(
          response?.data?.responseStatus?.message ||
          "Appointment slots submitted successfully!",
          {
            duration: 5,
            targetId: 'toast-container',
            type: 'success'
          }
        );
        
        setActionsFromAPI((actions) => {
          const newActionsItems = actions?.filter(
            (item) => item.actionName !== "Generate CMN"
          );
          return newActionsItems;
        });
      } else {
        toastShow.notify(
          response?.data?.responseStatus?.message ||
          "Failed to submit appointment slots",
          {
            duration: 5,
            targetId: 'toast-container',
            type: 'error'
          }
        );
      }
    } catch (error) {
      console.error("Appointment submission error:", error);
      toastShow.notify("Failed to submit appointment slots. Please try again.", {
        duration: 5,
        targetId: 'toast-container',
        type: 'error'
      });
    } finally {
      loaderRef.current?.hide();
    }
  };

  // ... rest of your existing functions ...

  // Add the CustomToastContainer to the return JSX
  return (
    <Box
      sx={{
        padding: "1rem 0.5rem 0 0.5rem",
        backgroundColor: "#f5f6fa",
        minHeight: "100vh",
      }}
    >
      <NewLoader ref={loaderRef} />
      <CustomToastContainer />
      <>
        {!tabMode && (
          <div className="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
            {/* ... existing JSX ... */}
          </div>
        )}

        {steps?.length > 0 && (
          <Stepper
            ref={stepperRef}
            steps={steps}
            viewMode={isViewMode}
            actionComponent={actionDropdown}
            onSyncData={handleFormSubmit}
            onSave={handleFinalSubmit}
            onSubmit={handleSubmit}
            disableSubmit={disableSubmit}
            initialStep={initialStep}
            registrationData={registrationData}
            omitSubmitButton={
              pageName === "uploadReports" ||
              (isOfficerLogin &&
                actionsFromAPI?.length === 0 &&
                steps?.length === 1) ||
              (isOfficerLogin && actionsFromAPI?.length < 1) ||
              (userRole === USER_ROLES.VESSEL_OWNER && showCmnStepper)
            }
            pageName={pageName}
            onGetInvoice={handleGetInvoice}
          />
        )}
        {/* ... rest of your existing JSX ... */}
      </>
    </Box>
  );
};

export default VesselReportsAndDocs;
