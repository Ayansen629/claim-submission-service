import React, { useState, useEffect, useRef } from "react";
import { Form, Dropdown } from "react-bootstrap";
import { useClickOutside } from "./hooks/useClickOutside.ts"; // Custom hook explained below

interface InputSelectProps {
  label: string;
  required?: boolean;
  name: string;
  options: Array<{ value: string | number; label: string }>;
  register?: any;
  errors?: any;
  disabled?: boolean;
  onChange?: (value: string | number | (string | number)[]) => void;
  className?: string;
  style?: React.CSSProperties;
  icon?: React.ElementType;
  defaultValue?: string | number | (string | number)[];
  isMulti?: boolean;
  showCheckbox?: boolean;
  autoFocus?: boolean;
}

const InputSelect: React.FC<InputSelectProps> = ({
  label,
  required,
  name,
  options,
  register,
  errors,
  disabled,
  onChange,
  className = "",
  style = {},
  icon: IconComponent,
  defaultValue,
  isMulti = false,
  showCheckbox = false,
  autoFocus = false,
}) => {
  const [selectedValues, setSelectedValues] = useState<(string | number)[]>(
    Array.isArray(defaultValue)
      ? defaultValue
      : defaultValue
      ? [defaultValue]
      : []
  );
  const hasError = errors && errors[name];
  const dropdownRef = useRef(null);
  const selectRef = useRef<HTMLSelectElement>(null);
  const [showDropdown, setShowDropdown] = useState(false);
  
  useEffect(() => {
    if (autoFocus && selectRef.current) {
      selectRef.current.focus();
    }
  }, [autoFocus]);

  useClickOutside(dropdownRef, () => setShowDropdown(false));

  const handleCustomChange = (value: string | number) => {
    let updated: (string | number)[];
    if (selectedValues.includes(value)) {
      updated = selectedValues.filter((v) => v !== value);
    } else {
      updated = [...selectedValues, value];
    }
    setSelectedValues(updated);
    onChange?.(updated);
  };

  const renderCustomDropdown = () => (
    <div className="custom-multi-select" ref={dropdownRef}>
      <div
        className={`custom-dropdown-toggle border ${
          hasError ? "border-danger" : "border-secondary"
        }`}
        onClick={() => setShowDropdown((prev) => !prev)}
        style={{
          borderRadius: "8px",
          padding: "8px 12px",
          backgroundColor: disabled ? "#e9ecef" : "white",
          cursor: disabled ? "not-allowed" : "pointer",
          color: "#212529",
        }}
      >
        {selectedValues.length > 0
          ? options
              .filter((opt) => selectedValues.includes(opt.value))
              .map((opt) => opt.label)
              .join(", ")
          : "-- Select --"}
      </div>
      {showDropdown && (
        <div
          className="dropdown-menu show w-100 mt-1 border shadow-sm"
          style={{ maxHeight: "200px", overflowY: "auto", zIndex: 10 }}
        >
          {options.map((opt) => (
            <label
              key={opt.value}
              className="dropdown-item d-flex align-items-center gap-2"
            >
              <input
                type="checkbox"
                checked={selectedValues.includes(opt.value)}
                onChange={() => handleCustomChange(opt.value)}
                disabled={disabled}
              />
              {opt.label}
            </label>
          ))}
        </div>
      )}
    </div>
  );

  useEffect(() => {
    // Register with React Hook Form manually when using custom multi
    if (register && isMulti && showCheckbox && onChange) {
      register(name, { required });
    }
  }, [register, isMulti, showCheckbox, name]);

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
        <Form.Label className="fw-semibold d-block">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>

      <div className="position-relative">
        {IconComponent && (
          <div
            className={`input-icon position-absolute ${
              hasError ? "text-danger" : "text-primary"
            }`}
            style={{
              left: "10px",
              top: "50%",
              transform: "translateY(-50%)",
              zIndex: 2,
            }}
          >
            <IconComponent size={18} />
          </div>
        )}

        {isMulti && showCheckbox ? (
          renderCustomDropdown()
        ) : (
          <Form.Select
            ref={selectRef}
            {...(register
              ? register(name, { required: required && label+" is required" })
              : {})}
            multiple={isMulti}
            disabled={disabled}
            onChange={(e: React.ChangeEvent<HTMLSelectElement>) => {
              const value:any = isMulti
                ? Array.from(e.target.selectedOptions, (opt) => opt.value)
                : e;
              onChange?.(value);
            }}
            className={`form-select ${hasError ? "is-invalid" : ""}`}
            style={{
              ...style,
              borderRadius: "8px",
              borderColor: hasError ? "#dc3545" : "#ced4da",
              paddingLeft: IconComponent ? "40px" : "12px",
              backgroundColor: hasError ? "#fff8f8" : "white",
              cursor: "pointer",
              transition: "all 0.3s ease",
            }}
            defaultValue={
              isMulti ? undefined : (defaultValue as string | number)
            }
          >
            {!isMulti && <option value="">-- Select --</option>}
            {options.map((opt, idx) => (
              <option key={idx} value={opt.value}>
                {opt.label}
              </option>
            ))}
          </Form.Select>
        )}
      </div>

      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;

import React, { useState, useEffect, useRef } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Form, Button, Card, Image, Alert } from 'react-bootstrap';
import {
  FaUser, FaBuilding, FaFileUpload, FaCheck, FaArrowRight,
  FaArrowLeft, FaIdCard, FaEnvelope, FaPhone, FaMapMarkerAlt, FaUpload, FaShip
} from 'react-icons/fa';
import './UserRegistration.css';
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";
import { toast } from "react-toastify";
import { getData, postData, postFORMdata } from "../../../services/http.service.ts";
import { URLS_ENDPOINT } from '../../../utils/urlsConstants.ts';
import { handleErrorMessage } from '../../../utils/errorMessageHandler.js';
import { mapToVesselUserDetails } from '../model/mapToVesselModel.ts';
import NewLoader from '../../common/NewLoader.js';
import InputText from '../../common/InputText.tsx';
import InputFile from '../../common/InputFile.tsx';
import InputSelect from '../../common/InputSelect.tsx';
import { MasterDataProvider, useMasterData } from '../../context/MasterDataContext.js';

const VesselOwnerRegistrationPage = () => {
   const { masterData } = useMasterData();
   console.log("Master Data in Vessel Owner Registration Page: ", masterData?.data);
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [successMessage, setSuccessMessage] = useState("");

  const [validationMessage, setValidationMessage] = useState("");
  const loaderRef = useRef();
  const PUBLIC_URL = process.env.REACT_APP_PUBLIC_URL;
  const methods = useForm({
    mode: 'onBlur',
    defaultValues: { ownerCategory: '', country: 'India' }
  });

  const { register, handleSubmit, formState: { errors }, trigger, setValue, getValues, watch, clearErrors, setError } = methods;
  const totalSteps = 3;
  const ownerCategory = watch('ownerCategory');


  useEffect(() => {

    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key]) {
          // console.log("Setting value for", key, formData[key]);
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [currentStep, setValue, formData]);

  const formFields = {
    step1: [
      {
        name: 'ownerCategory',
        label: 'Category of Owner',
        type: 'select',
        options: [
          { value: '', label: 'Select Category' },
          ...(masterData?.data?.ownerTypes?.map(type => ({
            value: type.valueCode,
            label: type.valueLabel
          })) || [])
        ],
        required: true,
        icon: FaBuilding,
        colSize: 6,
        validation: { required: 'Owner category is required' }
      },
      {
        name: 'firstName',
        label: 'Owner/Company Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter owner or company name',
        validation: { required: 'Owner name is required' }
      },
      {
        name: 'emailId',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: {
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      //  {
      //         name: 'password',
      //         label: 'Password',
      //         type: 'password',
      //         required: true,
      //         icon: FaIdCard,
      //         colSize: 6,
      //         placeholder: 'Enter password',
      //         validation: {
      //           required: 'Password is required',
      //           minLength: {
      //             value: 8,
      //             message: 'Password must be at least 8 characters'
      //           },
      //           pattern: {
      //             value: /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/,
      //             message: 'Password must contain at least one uppercase letter, one lowercase letter, one number and one special character'
      //           }
      //         }
      //       },
      {
        name: 'phoneNumber',
        label: 'Phone Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        placeholder: 'Enter 10-digit phone number',
        validation: {
          required: 'Phone number is required',
          pattern: {
            value: /^[0-9]{10}$/,
            message: 'Phone number must be 10 digits'
          }
        }
      },
      // {
      //         name: 'cinNumber',
      //         label: 'CIN Number',
      //         type: 'text',
      //         required: false,
      //         icon: FaIdCard,
      //         colSize: 6,
      //         placeholder: 'Enter CIN number',
      //         validation: {
      //           pattern: {
      //             value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
      //             message: 'Invalid CIN format'
      //           }
      //         },
      //         showIf: () => ownerCategory === 'company'
      //       },
            // {
            //   name: 'dinNumber',
            //   label: 'DIN Number',
            //   type: 'text',
            //   required: false,
            //   icon: FaIdCard,
            //   colSize: 6,
            //   placeholder: 'Enter DIN number',
            //   validation: {
            //     pattern: {
            //       value: /^[0-9]{8}$/,
            //       message: 'DIN must be 8 digits'
            //     }
            //   },
            //   showIf: () => ownerCategory === 'company'
            // },
      {
        name: 'panNumber',
        label: 'PAN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter PAN number (e.g., ABCDE1234F)',
        validation: {
          required: 'PAN number is required',
          pattern: {
            value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
            message: 'Invalid PAN format'
          }
        }
      },
      {
        name: 'gstNumber',
        label: 'GST Number',
        type: 'text',
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter GST number (if applicable)',
        validation: {
          pattern: {
            value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
            message: 'Invalid GST format'
          }
        }
      },
      {
        name: 'addressLine1',
        label: 'Address Line-1',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 1',
        validation: { required: 'Address is required' }
      },
      {
        name: 'addressLine2',
        label: 'Address Line-2',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 2 (optional)'
      },
      {
        name: 'pin',
        label: 'PIN',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 6,
        placeholder: 'Enter 6-digit PIN code',
        validation: {
          required: 'PIN code is required',
          pattern: {
            value: /^[0-9]{6}$/,
            message: 'PIN must be 6 digits'
          }
        },
        onChange: (e, setValue, watch) => {
          const changedValue = e?.target?.value || "";
          if (changedValue?.length === 6) {
            setValue('district', '');
            setValue('stateUt', '');
            setValue('country', 'India');
            getDetailsByPIN(changedValue);
          }
        },
      },
      {
        name: 'district',
        label: 'District',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter district',
      },
      {
        name: 'stateUt',
        label: 'State / UT',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter state',
      },
      {
        name: 'country',
        label: 'Country',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter country',
      }
    ],
    step2: [
      {
        name: 'firstName',
        label: 'First Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter first name',
        validation: { required: 'First name is required' }
      },
      {
        name: 'lastName',
        label: 'Last Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter last name',
        validation: { required: 'Last name is required' }
      },
      {
        name: 'mobileNumber',
        label: 'Primary Mobile Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        placeholder: 'Enter 10-digit mobile number',
        validation: {
          required: 'Mobile number is required',
          pattern: {
            value: /^[0-9]{10}$/,
            message: 'Mobile number must be 10 digits'
          }
        }
      },
      {
        name: 'authorizedEmail',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: {
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      {
        name: 'authorizationLetter',
        label: ' Letter of Authorization',
        type: 'file',
        required: false,
        colSize: 12,
      }
    ],
    step3: [
      {
        name: 'panCardUpload',
        label: 'PAN Card',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'gstCertificate',
        label: 'GST Certificate',
        type: 'file',
        required: false,
        colSize: 6
      },
      {
        name: 'addressProof',
        label: 'Address Proof',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'companyRegistrationCertificate',
        label: 'Company Registration Certificate',
        type: 'file',
        required: false,
        colSize: 6,
        showIf: () => ownerCategory !== 'organization'
      },
      
      {
        name: 'moaCertificate',
        label: 'MOA Certificate',
        type: 'file',
        required: false,
        colSize: 6,
        validation: {},
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'aoaCertificate',
        label: 'AOA Certificate',
        type: 'file',
        required: false,
        colSize: 6,
        validation: {},
        showIf: () => ownerCategory === 'company'
      }
    ]
  };
  const getDetailsByPIN = async (pinCode) => {
    try {
      const URL = PUBLIC_URL + URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE + pinCode;
      loaderRef.current?.show();
      const response = await getData(URL);
      if (response?.status === 200 && response?.data?.length > 0) {
        setValue('district', response?.data[0]?.district);
        setValue('stateUt', response?.data[0]?.stateName);
        loaderRef?.current?.hide();
      } else {
        loaderRef?.current?.hide();
        toast.info("No Data Found! Pleasee enter manually..", { position: "top-right" });
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  }
  // Get fields for current step
  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      case 3: return formFields.step3;
      default: return [];
    }
  };

  const validateStep = async () => {
    const currentFields = getCurrentStepFields();
    const requiredFields = currentFields
      .filter(field => field.required && (!field.showIf || field.showIf()));

    // Set errors for empty required fields
    requiredFields.forEach(field => {
      const value = getValues(field.name);
      if (!value || value === '') {
        setError(field.name, {
          type: 'required',
          message: `${field.label} is required`
        });
      } else if (field.validation && field.validation.pattern) {
       
        const pattern = field.validation.pattern.value;
        if (!pattern.test(value)) {
          setError(field.name, {
            type: 'pattern',
            message: field.validation.pattern.message
          });
        }
      }
    });

    // Validate all fields in the current step
    const fieldsToValidate = currentFields
      .filter(field => !field.showIf || field.showIf())
      .map(field => field.name);
    
    return await trigger(fieldsToValidate);
  };

  const handleNext = async () => {
    const isStepValid = await validateStep();

    if (isStepValid) {
      setValidationMessage("");
      const currentValues = getValues();
      const fileFields = getCurrentStepFields().filter(field => field.type === 'file');
      fileFields.forEach(field => {
        if (currentValues[field.name]) {
          setFormData(prev => ({
            ...prev,
            [field.name]: currentValues[field.name]
          }));
        }
      });

      // Save all other form values
      setFormData(prev => ({ ...prev, ...currentValues }));

      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    }
  };

  // Handle previous button click
  const handlePrevious = () => {
    // Save current values before navigating
    const currentValues = getValues();


    const fileFields = getCurrentStepFields().filter(field => field.type === 'file');
    fileFields.forEach(field => {
      if (currentValues[field.name]) {

        setFormData(prev => ({
          ...prev,
          [field.name]: currentValues[field.name]
        }));
      }
    });

    // Save all other form values
    setFormData(prev => ({ ...prev, ...currentValues }));

    // Navigate to previous step
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
    setValidationMessage("");
  };



  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };
    console.log(finalData, "finalDatapayload");
    finalData.userCategory = finalData.ownerCategory;
;

    finalData.userType = 'Owner';
    const formDetails = mapToVesselUserDetails({ ...finalData });
    const files = [
      finalData?.addressProof,
      finalData?.panCardUpload,
      finalData?.gstCertificate,
      finalData?.authorizationLetter,
      finalData?.companyRegistrationCertificate,
      finalData?.moaCertificate,
      finalData?.aoaCertificate
    ];
    const fd = new FormData();
    fd.append("request", new Blob([JSON.stringify(formDetails)], { type: 'application/json' }));
    files?.forEach((file) => {
      if (file) {
        fd.append(`files`, file);
      }
    });
    submitUserDetails(fd);
  };


  const submitUserDetails = async (payload) => {
    try {
      const URL = process.env.REACT_APP_AUTH_URL + URLS_ENDPOINT.USER_SERVICE.CREATE_USER;
      loaderRef.current?.show();
      const response = await postFORMdata(URL, payload);
      const apiRes = { ...response?.data }
      if (response?.status === 200 && apiRes?.responseStatus?.status === '200') {
        loaderRef?.current?.hide();
        setIsSubmitted(true);
        setSuccessMessage(apiRes?.responseStatus?.message);
        window.scrollTo(0, 0);

      } else {
        loaderRef?.current?.hide();
        toast.info(apiRes?.responseStatus?.message || "Something went wrong..", { position: "top-right" });
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  }


  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      const fieldName = field?.name;
      const value = e?.target?.value || "";

      if (field?.onChange) field.onChange(e, setValue, watch);
      
      
    };


    switch (field.type) {
      case 'select':
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register}
            errors={errors}
            icon={field.icon}
            className="mb-4"
            onChange={handleChange}
            autoFocus={field.autoFocus}
          />
        );

      case 'file':
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e.target.files[0]) {
                const file = e.target.files[0];
                console.log("Selected file:", file);
                const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
                // const fileName = `${field.label}${extension}`;

                        const customFileName = `${field.label}${extension}`;
                        
                       
                        file.originalName = customFileName;
                setValue(field.name, file);

                setFormData(prev => {
                  const updated = { ...prev, [field.name]: file };
                  // console.log(`Updated formData with file ${field.name}:`, updated);
                  return updated;
                });

                // Clear any errors
                if (errors[field.name]) {
                  clearErrors(field.name);
                }

                // File type validation
                const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'Only PDF, JPG or PNG files are allowed'
                  });
                }

                // File size validation (max 2MB)
                if (file.size > 2 * 1024 * 1024) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'File size should not exceed 2MB'
                  });
                }
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={formData[field.name]}
            autoFocus={field.autoFocus}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...field.validation,
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className="mb-4"
            style={{
              borderColor: errors[field.name] ? '#dc3545' : '#ced4da',
              backgroundColor: errors[field.name] ? '#fff8f8' : 'white'
            }}
            autoFocus={field.autoFocus}
          />
        );
    }
  };


  // Step titles
  const stepTitles = [
    { title: "Vessel Owner Details", icon: FaBuilding },
    { title: "Authorized Person's Details", icon: FaUser },
    { title: "Documents Upload", icon: FaFileUpload }
  ];

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="registration-container py-5">
        <Row className="justify-content-center">
          <Col lg={10} xl={9}>
            <Card className="registration-card">
              <Card.Header className="registration-header p-0">
                <div className="registration-header-content">
                  <div className="header-logo-container">
                    <Image
                      src={IWT_FULL_IMG}
                      alt="IWT Logo"
                      className="header-logo"
                    />
                  </div>
                  <h3 className="header-title">
                    Vessel Owner Registration
                  </h3>
                </div>
              </Card.Header>

              <Card.Body className="registration-body p-4 p-md-5">
                {isSubmitted ? (
                  <div className="success-container text-center py-5">
                    <div className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style={{ width: '90px', height: '90px', boxShadow: '0 10px 20px rgba(40, 167, 69, 0.3)' }}>
                      <FaCheck className="success-icon text-white fs-1" />
                    </div>
                    <h4 className="success-title text-success mb-3 fw-bold">Registration Successful!</h4>
                    <div className="registration-id p-4 bg-light rounded mb-4" style={{ borderLeft: '4px solid #0077b6' }}>
                      {successMessage ||
                        'Your vessel builder registration has been submitted successfully. You will receive a confirmation email shortly.'
                      }
                    </div>
                    {/* <div className="registration-id p-4 bg-light rounded mb-4" style={{ borderLeft: '4px solid #0077b6' }}>
                                  <strong>Registration ID:</strong> {Math.random().toString(36).substring(2, 10).toUpperCase()}
                                </div> */}
                    <Button
                      variant="primary"
                      size="lg"
                      className="mt-2 d-flex align-items-center justify-content-center mx-auto"
                      style={{
                        background: 'linear-gradient(135deg, #0077b6, #023e8a)',
                        border: 'none',
                        boxShadow: '0 4px 15px rgba(0, 119, 182, 0.3)',
                        borderRadius: '8px',
                        padding: '12px 30px',
                        fontWeight: '600',
                        transition: 'all 0.3s ease',
                        minWidth: '150px',
                        height: '50px'
                      }}
                      onClick={() => window.location.href = '/'}
                    >
                      Go to Home
                    </Button>
                  </div>
                ) : (
                  <FormProvider {...methods}>
                    <form>
                      <div className="text-center mb-4">
                        <p className="text-muted">Please complete all required information to register your vessel</p>
                      </div>



                      <div className="stepper-container mb-5">
                        <div className="stepper d-flex justify-content-between">
                          {[1, 2, 3].map((step) => (
                            <React.Fragment key={step}>
                              <div className={`step ${currentStep >= step ? 'active' : ''} ${currentStep > step ? 'completed' : ''} flex-grow-1 text-center`}>
                                <div
                                  className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2"
                                  style={{
                                    width: '60px',
                                    height: '60px',
                                    borderRadius: '50%',
                                    fontSize: '20px',
                                    fontWeight: 'bold',
                                    boxShadow: currentStep >= step ? '0 5px 15px rgba(0, 119, 182, 0.3)' : '0 4px 10px rgba(0, 0, 0, 0.1)',
                                    background: currentStep >= step ?
                                      (currentStep > step ? 'linear-gradient(135deg, #28a745, #20c997)' : 'linear-gradient(135deg, #0077b6, #023e8a)') :
                                      '#ffffff',
                                    border: currentStep >= step ? 'none' : '2px solid #e9ecef',
                                    color: currentStep >= step ? '#fff' : '#6c757d',
                                    transition: 'all 0.4s ease'
                                  }}>
                                  {currentStep > step ? <FaCheck size={22} /> : React.createElement(stepTitles[step - 1].icon, { size: 22 })}
                                </div>
                                <div className="step-label fw-bold"
                                  style={{
                                    color: currentStep >= step ? (currentStep > step ? '#28a745' : '#0077b6') : '#6c757d',
                                    fontSize: '0.9rem',
                                    transition: 'all 0.3s ease'
                                  }}>
                                  {stepTitles[step - 1].title}
                                </div>
                              </div>
                              {step < 3 && (
                                <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                                  <div className={`connector-line w-100 ${currentStep > step ? 'active' : ''}`}
                                    style={{
                                      height: '4px',
                                      background: currentStep > step ? 'linear-gradient(to right, #28a745, #20c997)' : '#e9ecef',
                                      borderRadius: '2px',
                                      transition: 'all 0.5s ease'
                                    }}></div>
                                </div>
                              )}
                            </React.Fragment>
                          ))}
                        </div>
                      </div>

                      <div className="step-content">
                        <div className="form-section p-4 rounded mb-4">
                          <div className="section-title">
                            {React.createElement(stepTitles[currentStep - 1].icon, { className: "section-icon" })}
                            <h4 className="mb-0 fw-bold">{stepTitles[currentStep - 1].title}</h4>
                          </div>

                          <div className="form-content py-3">
                            <Row className="g-4">
                              {getCurrentStepFields().map((field, index) => (
                                <Col key={index} md={field.colSize || 12} className="mb-2">
                                  <DynamicField field={field} />
                                </Col>
                              ))}
                            </Row>
                          </div>
                        </div>
                      </div>

                      <div className="form-navigation  mt-4" style={{ display: 'block' }}>

                        {
                          currentStep > 1 &&
                          <Button
                            variant="outline-secondary"
                            onClick={handlePrevious}
                            // hidden={currentStep === 1}
                            className="prev-btn"
                            style={{ 'float': 'left' }}
                          >
                            <FaArrowLeft className="btn-icon me-2" /> Previous
                          </Button>
                        }


                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="next-btn"
                          style={{ 'float': 'right' }}

                        >
                          {currentStep === totalSteps ? 'Submit Registration' : 'Next'}
                          {currentStep !== totalSteps && <FaArrowRight className="btn-icon ms-2" />}
                        </Button>
                      </div>
                    </form>
                  </FormProvider>
                )}
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Container>
    </>
  );
};

export default VesselOwnerRegistrationPage;
