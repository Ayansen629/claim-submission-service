/* Add this to your existing CSS */
.file-field {
  padding-left: 12px; /* Add left gap for all file fields */
}

/* Specific adjustment for authorization letter */
.file-field.authorization-letter {
  padding-left: 12px; /* Consistent left gap */
}

.file-field.authorization-letter .file-display {
  max-width: 100%; /* Allow it to take full width but with padding */
}

/* Ensure consistent file display for all files */
.file-display {
  border-left: 3px solid #e9ecef; /* Subtle left border */
  padding-left: 12px; /* Space between border and content */
  margin-left: 8px; /* Additional left gap */
  max-width: calc(100% - 20px); /* Prevent full width */
}

/* Field label spacing */
.field-label {
  margin-left: 12px; /* Add left gap to match fields */
}

/* Text field left spacing */
.text-field {
  padding-left: 12px; /* Consistent left gap */
}
