{/* Hero Section */}
<div className={styles.heroSection}>
  <div className={styles.overlay}></div>

  <div className="container-fluid position-relative z-2">
    <div className={`row g-0 pt-4 px-4 ${styles.headerRow}`}>
      {/* Mobile-first responsive navigation */}
      <div className={`${styles.topNavCol} mb-0 col-12 position-relative`}>
        <div className={`d-flex flex-column flex-md-row justify-content-center align-items-center w-100 ${styles.navGroupWrapper}`}>
          {/* Mobile menu button (only shows on small screens) */}
          <div className="d-md-none d-flex justify-content-between align-items-center w-100 mb-2">
            <Button 
              variant="outline-light" 
              className="me-2"
              onClick={() => {/* Add mobile menu toggle functionality */}}
            >
              <i className="fas fa-bars"></i>
            </Button>
            <img 
              src={BengalLogo} 
              alt="Logo" 
              className={styles.mobileLogo}
            />
            <Button
              variant="light"
              className={`${styles.homeLoginBtn} ${styles.loginBtn}`}
              onClick={() => navigate("/login")}
            >
              {t("home2.Login")}
            </Button>
          </div>

          {/* Nav links + underline grouped - hidden on mobile, shown on desktop */}
          <div className="d-none d-md-flex flex-column align-items-center">
            <Nav className="d-flex">
              <Nav.Link className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                {t("home2.home")}
              </Nav.Link>
              <Nav.Link
                onClick={() => navigate("/about-us")}
                className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}
              >
                {t("home2.aboutUs")}
              </Nav.Link>
              <Nav.Link
                onClick={() => navigate("/our-services")}
                className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}
              >
                {t("home2.services")}
              </Nav.Link>
              <Nav.Link
                onClick={() => navigate("/rules-and-act")}
                className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}
              >
                {t("home2.RulesAndAct")}
              </Nav.Link>
              <Nav.Link
                onClick={() => navigate("/gallery")}
                className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}
              >
                {t("home2.Gallery")}
              </Nav.Link>
              <Nav.Link
                onClick={() => navigate("/important-link")}
                className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}
              >
                {t("home2.ImportantLink")}
              </Nav.Link>
              <Nav.Link
                onClick={() => navigate("/contact-us")}
                className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}
              >
                {t("home2.contactUs")}
              </Nav.Link>
            </Nav>

            {/* Underline only below nav links */}
            <div className="w-100 border-top border-white mt-1"></div>
          </div>

          {/* Desktop login button and logo */}
          <img 
            src={BengalLogo} 
            alt="Logo" 
            className={`d-none d-md-block ${styles.desktopLogo}`} 
          />
          <Button
            variant="light"
            className={`d-none d-md-block ${styles.homeLoginBtn} ${styles.loginBtn}`}
            onClick={() => navigate("/login")}
          >
            {t("home2.Login")}
          </Button>
        </div>
      </div>

      {/* Branding section - improved mobile layout */}
      <div className="mt-0 col-12 d-flex flex-column align-items-center align-items-md-start">
        <div className="d-flex align-items-center justify-content-center justify-content-md-around" style={{ marginTop: "-2rem" }}>
          <img 
            className="me-2" 
            src={IWTIcon} 
            alt="Logo" 
            style={{ width: "4.5rem", borderRadius: "0px" }} 
          />
        </div>
        <p className={`${styles.brandName} mt-1 text-center text-md-start`}>
          {t("home2.InlandWaterTransportServices")}
        </p>
        <p className={`${styles.brandName} mt-1 text-center text-md-start`}>
          {t("home2.departmentOfWB")}
        </p>
      </div>
    </div>
  </div>
</div>
