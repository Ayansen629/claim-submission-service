const handleConfirmAppointments = () => {
  const validAppointments = appointments.filter(apt => apt.date && apt.time);
  
  if (validAppointments.length < 2) {
    toast.error("Please select at least 2 appointment slots");
    return;
  }

  const formattedAppointments = validAppointments.map(apt => ({
    date: apt.date.toLocaleDateString('en-GB'), // Format: DD/MM/YYYY
    timeSlot: timeSlots.find(t => t.value === apt.time)?.label || apt.time, // Changed from 'time' to 'timeSlot'
    appointmentStatus: "",
    isBooked: false,
    bookedBy: null
  }));

  toast.success(`${validAppointments.length} appointment slots proposed successfully!`, {
    position: "top-right",
    autoClose: 3000,
  });

  if (handleConfirm) {
    handleConfirm(formattedAppointments);
  }

  handleClose();
  resetForm();
};
