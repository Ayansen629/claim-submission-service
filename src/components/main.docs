// In the Navbar component, update the navbar-right section:

<div className="navbar-right">
  {/* Show New Claim button only for CLM users */}
  {!isCRP && (
    <Link to="/apply-claim" className="create-claim-btn" 
    onClick={newClaimFun}
    >
      <FaPlus />
      <span>New Claim</span>
    </Link>
  )}

  {/* Move search icon to the end */}
  <button className="nav-action-btn search-icon" onClick={() => setSearchOpen(!searchOpen)}>
    <FaSearch />
  </button>

  <div className="user-profile">
    <button 
      className="profile-btn" 
      onClick={() => setDropdownOpen(!dropdownOpen)}
    >
      <div className="avatar">
        {getInitial()}
      </div>
    </button>
    
    {dropdownOpen && (
      <div className="user-dropdown">
        <Link to="/my-profile" className="dropdown-item">
          <FaUserCircle />
          <span>My Profile</span>
        </Link>
        <Link to="/settings" className="dropdown-item">
          <FaCog />
          <span>Settings</span>
        </Link>
        <div className="dropdown-divider"></div>
        <button onClick={handleLogout} className="dropdown-item">
          <FaSignOutAlt />
          <span>Logout</span>
        </button>
      </div>
    )}
  </div>
</div>

/* Update the search icon styles */
.search-icon {
  order: 2; /* Move to the end of flex container */
}

/* Update navbar-right to ensure proper ordering */
.navbar-right {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  margin-left: auto;
}

/* Make sure user profile comes last */
.user-profile {
  order: 3;
}

/* Create claim button should come first */
.create-claim-btn {
  order: 1;
}

/* For mobile view */
@media (max-width: 768px) {
  .navbar-right {
    gap: 0.75rem; /* Reduce gap on small screens */
  }
  
  .search-icon {
    margin-left: auto; /* Push to right on small screens */
  }
}

