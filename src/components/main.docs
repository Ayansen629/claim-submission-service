/* Add to your existing CSS */
.header-sidebar-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.main-layout {
  flex: 1;
  display: flex;
  overflow: hidden;
  margin-top: 0; /* Ensure no top margin */
}

.content-container {
  flex: 1;
  padding: 0; /* Remove padding if exists */
  margin: 0; /* Remove margin if exists */
  overflow-y: auto;
}

/* Ensure header has no bottom margin */
.custom-navbar {
  margin-bottom: 0 !important;
}

/* If you're using any wrapper around children */
.content-container > div {
  height: 100%;
}
