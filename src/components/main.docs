const fetchRegistrationDetails = async () => {
  setIsLoading(true);
  try {
    const payload = {
      applicationNumber: "REG-2025-576219"
    };
    
    const apiUrl = "http://3.111.175.246:7076/iwt-registration-service/document/search";
    
    const response = await fetch(apiUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
      },
      body: JSON.stringify(payload)
    });

    const responseData = await response.json();
    console.log("Registration details response:", responseData);
    
    if (response.ok && responseData?.responseStatus?.status === "Document(s) fetched successfully.") {
      const data = responseData.data[0];
      setRegistrationData(data);
      
      if (data.basicDetails?.ownerDetails) {
        const owner = data.basicDetails.ownerDetails;
        setValue("ownerName", owner.ownerCompanyName);
        setValue("ownerAddress", `${owner.addressLine1}, ${owner.addressLine2}`);
        setValue("mobile", owner.phoneNumber);
        setValue("email", owner.emailId);
        setValue("pan", owner.panNo);
        setValue("gst", owner.gstNo);
        setValue("aadhar", owner.aadharNumber);
        setValue("tradeLicence", owner.tradeLicenseNumber);
      }
      
      if (data.vesselDetails) {
        const vessel = data.vesselDetails;
        setValue("grt", vessel.grossTonnage);
        setValue("workOrderValue", vessel.workOrderValue);
        setValue("vesselType", vessel.typeOfVessel);
        setValue("category", vessel.categoryOfVessel);
        setValue("zone", vessel.zone);
        setValue("purchaseType", vessel.purchaseType);
        setValue("supervisionAuthority", vessel.supervisionAuthority);
        setValue("classificationSociety", vessel.nameOfClassificationSociety);
      }
      
      if (data.basicDetails?.builderDetails) {
        const builder = data.basicDetails.builderDetails;
        setValue("constructedBy", "2");
        setValue("builderName", builder.builderName);
        setValue("builderAddress", `${builder.addressLine1}, ${builder.addressLine2}`);
        setValue("builderEmail", builder.emailId);
        setValue("builderMobile", builder.phone);
        setValue("builderGST", builder.gstNo);
        setValue("builderTradeLicence", builder.tradeLicenseNumber);
        setValue("builderAuth", data.basicDetails.builderAuthorization);
      }
    } else {
      console.error("API Error:", responseData);
      toast.error("Failed to fetch registration details");
    }
  } catch (err) {
    console.error("Failed to fetch registration details:", err);
    toast.error("Failed to fetch registration details");
  } finally {
    setIsLoading(false);
  }
};
