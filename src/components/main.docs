// Update the actionDropdown variable
const actionDropdown =
  isViewMode && isOfficerLogin && actionsFromAPI.length > 0 ? (
    <ActionDropdown
      actions={actionsFromAPI}
      onActionClick={handleActionClick}
      disabled={showCmnStepper && !hasSelectedAppointment && registrationData?.appointmentSlots?.length === 0}
      disabledMessage="Please select proposal appointments first"
      variant="contained"
      sx={{
        backgroundColor: "#2E57A7",
        fontWeight: "bold",
        borderRadius: "0.5rem",
        minWidth: "8rem",
        fontSize: "0.9rem",
        color: "#fff",
        "&:hover": {
          backgroundColor: "#1f4ea0",
        },
      }}
    />
  ) : null;
.btn-dd-disabled {
  background-color: #6c757d !important;
  border-color: #6c757d !important;
  color: #fff !important;
  opacity: 0.6;
  cursor: not-allowed !important;
}

.btn-dd-disabled-toggle {
  background-color: #6c757d !important;
  border-color: #6c757d !important;
  color: #fff !important;
  opacity: 0.6;
  cursor: not-allowed !important;
}

.dd-primary-item.disabled {
  opacity: 0.5;
  cursor: not-allowed;
  pointer-events: none;
}
