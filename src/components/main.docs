import React, { createContext, useContext, useState } from "react";
import { toast } from "react-toastify";
import { APP_MESSAGES } from "../../utils/constants.ts";
import { postData } from "../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../utils/urlsConstants.ts";


const RegistrationContext = createContext();


export const useRegistration = () => {
  return useContext(RegistrationContext);
};


const formatFileInfo = (fileData) => {
  console.log("File data:", fileData);
    if (!fileData) return ""; 
    if (typeof fileData === "string") return fileData;
    return fileData.name || fileData.fileName || ""; 
};
const formatRawData = (rawData) => {
  if (!rawData) return null;

  // Format identification type details
  const identificationDetails = rawData.creditorBasicDetails?.identificationTypeDetails?.identifications?.map((item, index) => ({
    id: index + 1,
    details: item.identificationRecord || "",
    proof: {
      fileId: item.proofOfIdentificationDocuments?.docId || "",
      fileName: item.proofOfIdentificationDocuments?.docName || "",
      fileType: "application/pdf" // Default, adjust if needed
    }
  }));

  // Format all entity data
  console.log(rawData.claimDetails,"claimdetails")
  const principalBorrowers = rawData.claimDetails?.principalBorrowerDetails?.map((item, index) => ({
    id: index + 1,
    name: item.name || "",
    address: item.address || "",
    type: "PRINCIPAL_BORROWER"
  }));
  const beneficiaries = rawData.claimDetails?.beneficiaryDetails ?.map((item, index) => ({
    id: index + 1,
    name: item.name || "",
    address: item.address || "",
    type: "BENEFICIARY"
  }));
  const guarantors = rawData.claimDetails?.guarantorDetails ?.map((item, index) => ({
    id: index + 1,
    name: item.name || "",
    address: item.address || "",
    type: "GUARANTOR"
  }));
  // combine all entity data
  const allEntities = [...principalBorrowers, ...beneficiaries, ...guarantors];
  return {
    step1: {
      corporateDebtorName: rawData.creditorBasicDetails?.financialDebtorName || "",
      identificationType: rawData.creditorBasicDetails?.identificationTypeDetails?.identificationType || "",
      financialCreditorName: rawData.creditorBasicDetails?.financialCreditorName || "",
      financialCreditorEmail: rawData.creditorBasicDetails?.financialCreditorEmail || "",
      addressLine1: rawData.creditorBasicDetails?.addressDetails?.addressLine1 || "",
      addressLine2: rawData.creditorBasicDetails?.addressDetails?.addressLine2 || "",
      city: rawData.creditorBasicDetails?.addressDetails?.city || "",
      state: rawData.creditorBasicDetails?.addressDetails?.state || "",
      pincode: rawData.creditorBasicDetails?.addressDetails?.pincode || "",
      identificationtype_details: identificationDetails || []
    },
    step2: {
      claimType: rawData.claimDetails?.claimType || "",
      claimAmount: rawData.claimDetails?.claimAmount?.toString() || "",
      hasSecurityInterest: rawData.claimDetails?.isAmountOfClaimCoverdBySecurityInterest ? "yes" : "no",
      hasGuarantee: rawData.claimDetails?.isAmountOfClaimCoverdByGuarantee ? "yes" : "no",
      securityValue: rawData.claimDetails?.securityValue?.toString() || "",
      securityDate: rawData.claimDetails?.securityDate || "",
      guaranteeValue: rawData.claimDetails?.guaranteeValue?.toString() || "",
      guaranteeDate: rawData.claimDetails?.guaranteeDate || "",
      debtDetails: rawData.claimDetails?.debtIncurredDetails || "",
      debtDate: rawData.claimDetails?.debtIncurredDate || "",
      mutualDetails: rawData.claimDetails?.mutualDealingDetailsAgainstTheClaim || "",
      accountNumber: rawData.claimDetails?.bankAccountDetails?.bankAccountNumber || "",
      bankName: rawData.claimDetails?.bankAccountDetails?.bankName || "",
      branchName: rawData.claimDetails?.bankAccountDetails?.bankBranchName || "",
      branchAddress: rawData.claimDetails?.bankAccountDetails?.branchAddress || "",
      city: rawData.claimDetails?.bankAccountDetails?.city || "",
      state: rawData.claimDetails?.bankAccountDetails?.state || "",
      district: rawData.claimDetails?.bankAccountDetails?.district || "",
      ifscCode: rawData.claimDetails?.bankAccountDetails?.bankIfscCode || "",
      // PRINCIPAL_BORROWERName1: entityData?.[0]?.name || "",
      // PRINCIPAL_BORROWERAddress1: entityData?.[0]?.address || "",
      entityData: allEntities 
    },
    step3: {
      creditorName: rawData.signatoryDetails?.financialCreditorName || "",
      creditorPosition: rawData.signatoryDetails?.positionOfCreditor || "",
      creditorSignatureText: rawData.signatoryDetails?.signatureFinancialCreditor || "",
      creditorAddress: rawData.signatoryDetails?.addressOfSigningPerson || "",
      hasSignature: rawData.signatoryDetails?.isSignatureToUpload ? "yes" : "no",
      signatureFile: {
        fileId: rawData.signatoryDetails?.document?.docId || "",
        docName: rawData.signatoryDetails?.document?.docName || "",
        docType: "signature",
        docSource: "Signature"
      }
    },
    step4: {
      identityProofType: rawData.supportingDocument?.documents?.find(d => d.docSource === "identity_proof")?.docType || "",
      addressProofType: rawData.supportingDocument?.documents?.find(d => d.docSource === "address_proof")?.docType || "",
      identityProofFile: {
        fileId: rawData.supportingDocument?.documents?.find(d => d.docSource === "identity_proof")?.docId || "",
        fileName: rawData.supportingDocument?.documents?.find(d => d.docSource === "identity_proof")?.docName || "",
        fileType: "application/pdf"
      },
      addressProofFile: {
        fileId: rawData.supportingDocument?.documents?.find(d => d.docSource === "address_proof")?.docId || "",
        fileName: rawData.supportingDocument?.documents?.find(d => d.docSource === "address_proof")?.docName || "",
        fileType: "application/pdf"
      }
    },
    // creditorBasicDetailsUuid: rawData.creditorBasicDetails?.uuid || "",
    // applicationNumber: rawData.applicationNumber || "",
    // uuid: rawData.uuid || "",
    // claimDetailsUuid: rawData.claimDetails?.uuid || "",
    // signatoryDetailsUuid: rawData.signatoryDetails?.uuid || ""
  };
};



// Fixed ApplicationContextProvider
export const ApplicationContextProvider = ({ children }) => {
  const [registrationData, setRegistrationData] = useState({});
  const [applicationDetails, setApplicationDetails] = useState({});

  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  // const [isViewModalOpen, setIsViewModalOpen] = useState(false);

  const handleApplicatioNFormView = async (row) => {
    console.log("Row data:", row);
    if (!row?.uuid) {
      console.warn("Row UUID is missing");
      return;
    }

    try {
      // debugger;
      setLoading(true);
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const fullloginDetails = userFormData?.fullloginDetails;
      const URL =
      process.env.REACT_APP_APPLICATION_SERVICE +
      URLS_ENDPOINT.APP_SERVICES.APPLICATION_VIEW_ID;
     
      const request = {
        userInfo:fullloginDetails || {} , 
        uuids: [row.uuid],
        applicationNumbers: [],
        claimantUUIDs: []
      };

      const response = await postData(URL, request);
      console.log("Response Application view with UUID:", response);


      if (response?.data && response?.data?.applicationDetails?.length > 0) {
        const rawData = response.data.applicationDetails[0];
        setApplicationDetails(rawData);
        
        const formattedData = formatRawData(rawData);
        setRegistrationData(formattedData);
        localStorage.setItem("applicationdatawithId", JSON.stringify(rawData.applicationNumber));
        localStorage.setItem("applicationdatastatus", JSON.stringify(rawData.status));

        // setIsViewModalOpen(true);
      } else {
        toast.error(APP_MESSAGES.NO_DATA_FOUND, { position: "top-right" });
        setRegistrationData({}); 
        localStorage.setItem("applicationdatawithId", JSON.stringify({}));
        localStorage.setItem("applicationdatastatus", JSON.stringify({}));
      }
    } catch (err) {
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setError(err.message || "Error fetching application data");
      setRegistrationData({}); 
      localStorage.setItem("applicationdatawithId", JSON.stringify({}));
      localStorage.setItem("applicationdatastatus", JSON.stringify({}));
    } finally {
      setLoading(false);
    }
  };

  const updateRegistrationData = (updatedData) => {
    setRegistrationData((prev) => ({
      ...prev,
      ...updatedData,
    }));
  };

  return (
    <RegistrationContext.Provider
      value={{
        registrationData,
        loading,
        error,
        
        handleApplicatioNFormView,
        updateRegistrationData,
        setRegistrationData,
        applicationDetails,
        setApplicationDetails,
      }}
    >
      {children}
    </RegistrationContext.Provider>
  );
};
