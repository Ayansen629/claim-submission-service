const buildSurveyPayload = (formData, registrationData) => {
  const payload = {
    surveyId: intialSurveyData?.surveyId || "",
    BasicVesselInformation: {
      id: intialSurveyData?.BasicVesselInformation?.id || "",
      typeOfSurveyId: formData?.basicVesselInfo?.typeOfSurvey || "",
      placeYardNo: formData?.basicVesselInfo?.placeYardNo || "",
      netTonnage: parseFloat(formData?.basicVesselInfo?.netTonnage) || null,
      agentsName: formData?.basicVesselInfo?.agentName || "",
      agentsAddress: formData?.basicVesselInfo?.agentAddress || "",
      agentsTelephone: formData?.basicVesselInfo?.agentTelephone || "",
      placeOfLastSurvey: formData?.basicVesselInfo?.placeOfLastSurvey || "",
      dateOfLastSurvey: formData?.basicVesselInfo?.dateOfLastSurvey || "",
      dateOfProposedVisitSurveyor:
        formData?.basicVesselInfo?.dateOfProposedVisit || "",
      iwtVesRegBasicDetailsTFk:
        registrationData?.vessel?.iwtVesselBasicDetailsTFk || "",
      status: "ACTIVE",
      lengthOfVessel: formData?.basicVesselInfo?.lengthOfVessel || "",
      breadthOfVessel: formData?.basicVesselInfo?.breadthOfVessel || "",
      depthOfVessel: formData?.basicVesselInfo?.depthOfVessel || "",
      draft: formData?.basicVesselInfo?.draft || "",
      enableprovisonalsurveycert:
        formData?.provisionalCertificates?.surveyCertificate || false,
      enableprovisonalregistrationcert:
        formData?.provisionalCertificates?.registrationCertificate || false,
        totalNoOfDeckCrew:parseInt(formData?.crewDetails?.totalDeckCrew)||"",
        totalNoOfEngineCrew:parseInt(formData?.crewDetails?.totalEngineCrew)||"",
    },

    HullParticulars: {
      id: intialSurveyData?.HullParticulars?.id || "",
      frameMaterial: formData?.hullParticulars?.frameMaterial || "",
      frameThickness:
        parseFloat(formData?.hullParticulars?.frameThickness) || "",
      floorMaterial: formData?.hullParticulars?.floorMaterial || "",
      hullMaterial: formData?.hullParticulars?.hullMaterial || "",
      hullPlatingThickness:
        parseFloat(formData?.hullParticulars?.hullPlattingThickness) || "",
      keelLayingDate: formData?.hullParticulars?.keelLayingDate || "",
      iwtVesBasicSurveyDetTFk:
        intialSurveyData?.HullParticulars?.iwtVesBasicSurveyDetTFk || "",
      status: "ACTIVE",
      hullPlatingMaterial:
        formData?.hullParticulars?.hullPlatingMaterial || "",
      noOfBulkheads:
        parseInt(formData?.hullParticulars?.numberOfBulkheads) || "",
      bulkheadPlacement: formData?.hullParticulars?.bulkheadPlacement || "",
      bulkheadThickness:
        parseFloat(formData?.hullParticulars?.bulkheadThickness) || "",
      floorThickness:
        parseFloat(formData?.hullParticulars?.floorThickness) || "",
    },

    RadioandNavigationEquipment: {
      id: intialSurveyData?.RadioandNavigationEquipment?.id || "",
      magneticCompass:
        parseInt(formData?.navigationEquipment?.magneticCompass) || null,
      vhfRadio: parseInt(formData?.navigationEquipment?.vhfRadio) || null,
      aisIdentifiSystem:
        parseInt(formData?.navigationEquipment?.classBAutoAIS) || null,
      gps: parseInt(formData?.navigationEquipment?.gpsNavigator) || null,
      binocular: parseInt(formData?.navigationEquipment?.binocular) || null,
      aldisLamp: parseInt(formData?.navigationEquipment?.aldisLamp) || null,
      rudderAngleIndicator:
        parseInt(formData?.navigationEquipment?.rudderAngleIndicator) || null,
      others:
        parseInt(formData?.navigationEquipment?.othersNavigation) || null,
      iwtVesBasicSurveyDetTFk:
        intialSurveyData?.RadioandNavigationEquipment
          ?.iwtVesBasicSurveyDetTFk || "",
      status: "ACTIVE",
    },

    PollutionControlDevices: {
      id: intialSurveyData?.PollutionControlDevices?.id || "",
      bilgeWaterSeperator:
        parseInt(formData?.polutionControl?.bilgeWaterSeparator) || null,
      capacity: formData?.polutionControl?.bilgeCapacity || "",
      makeModel: formData?.polutionControl?.bilgeMakeModel || "",
      stp: parseInt(formData?.polutionControl?.sewageTreatmentPlant) || null,
      stpCapacity: formData?.polutionControl?.sewageCapacity || "",
      stpMakeModel: formData?.polutionControl?.sewageMakeModel || "",
      owf: parseInt(formData?.polutionControl?.oilyWaterFilter) || null,
      owfCapacity: formData?.polutionControl?.oilyCapacity || "",
      owfMakeModel: formData?.polutionControl?.oilyMakeModel || "",
      egasCleaningSystm:
        parseInt(formData?.polutionControl?.exhaustGasCleaning) || null,
      egasCleaningSystmCapacity:
        formData?.polutionControl?.exhaustCapacity || "",
      egasCleaningSystmMakeModel:
        formData?.polutionControl?.exhaustMakeModel || "",
      other: parseInt(formData?.polutionControl?.othersPollution) || null,
      otherCapacity: formData?.polutionControl?.othersCapacity || "",
      otherMakeModel: formData?.polutionControl?.othersMakeModel || "",
      status: "ACTIVE",
      iwtVesBasicSurveyDetTFk:
        intialSurveyData?.PollutionControlDevices?.iwtVesBasicSurveyDetTFk ||
        "",
    },

    CrewDetails: extractCrewDetails(formData?.crewDetails?.crewDetails),
    equipmentInventoryDetails: null,
    Enclosure: extractEnclosures(
      formData?.enclosure,
      registrationData?.applicationNumber ||
      registrationData?.vessel?.applicationNumber ||
      "",
      intialSurveyData?.Enclosure || []
    ),

    DetailsofPropulsionofEngine: {
      id: intialSurveyData?.DetailsofPropulsionofEngine?.id || "",
      yearOfBuild: formData?.basicVesselInfo?.yearOfBuild || "",
      engineType: formData?.detailsOfPropulsion?.typeOfEngine || "",
      engineMake: formData?.detailsOfPropulsion?.engineMake || "",
      makerAddress: formData?.detailsOfPropulsion?.engineMakerAddress || "",
      pin: registrationData?.engine?.pin || "",
      mobile: registrationData?.engine?.mobile || "",
      email: registrationData?.engine?.email || "",
      horsepower: parseInt(formData?.detailsOfPropulsion?.horsepower) || null,
      speed: parseInt(formData?.detailsOfPropulsion?.speedRPM) || null,
      yearOfMake: formData?.detailsOfPropulsion?.yearOfMake || "",
      applRegistrationTFk:
        registrationData?.vessel?.iwtVesselBasicDetailsTFk || "",
      modelNo: formData?.detailsOfPropulsion?.modelNo || "",
      noOfSet: formData?.detailsOfPropulsion?.numberOfSetFitted || null,
      numberOfEngine:
        parseInt(formData?.detailsOfPropulsion?.numberOfEngine) || null,
      setSerialNo: formData?.detailsOfPropulsion?.setSrNo || "",
      propellerType: formData?.detailsOfPropulsion?.propellerType || "",
      gearType: formData?.detailsOfPropulsion?.gearType || "",
      noOfGear: formData?.detailsOfPropulsion?.noOfGear || null,
      vesselSpeed: formData?.detailsOfPropulsion?.vesselSpeed || null,
      rpm: formData?.detailsOfPropulsion?.revolutionMints || null,
      engineCylinder:
        formData?.detailsOfPropulsion?.engineCylinderDiameter || null,
      stroke: formData?.detailsOfPropulsion?.strokeEngine || null,
      iwtVesBasicSurveyDetTFk:
        intialSurveyData?.DetailsofPropulsionofEngine
          ?.iwtVesBasicSurveyDetTFk || "",
    },
  };

  if (intialSurveyData?.SurveyEquipments) {
    payload.SurveyEquipments = Object.keys(intialSurveyData.SurveyEquipments).reduce((acc, key) => {
      acc[key] = intialSurveyData.SurveyEquipments[key] || [];
      return acc;
    }, {});
  }

  if (intialSurveyData?.passengerDistributionMaxLoad) {
    payload.passengerDistributionMaxLoad =
      intialSurveyData.passengerDistributionMaxLoad;
  }

  if (intialSurveyData?.vesselFreeboardData) {
    payload.vesselFreeboardData = intialSurveyData.vesselFreeboardData;
  }

  return payload;
};
