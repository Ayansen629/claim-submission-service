const workflowApplicationSubmit = async (modalFormData) => {
  try {
    const URL =
      SERVICE_BASE.IWT_WORKFLOW +
      URLS_ENDPOINT.WORK_FLOW_SERVICE.WORKFLOW_ACTION;

    loaderRef?.current?.show();
    
    // Get processId with fallback to re-fetch if state is not updated
    let processId = intialSurveyData?.processActionMapResponce?.[0]?.processs?.[0]?.processId;
    
    // If processId is undefined, try to get fresh survey data
    if (!processId && registrationData?.vessel?.iwtVesselBasicDetailsTFk) {
      try {
        const apiUrl = SERVICE_BASE.IWT_SURVEY_SERVICE + URLS_ENDPOINT.SURVEY_SERVICE.SURVEY_SEARCH;
        const response = await postData(apiUrl, {
          iwtVesRegBasicDetailsTFk: [registrationData.vessel.iwtVesselBasicDetailsTFk],
        });
        
        if (response?.status === 200 || response?.status === 201) {
          const surveyData = response?.data[0] || {};
          processId = surveyData?.processActionMapResponce?.[0]?.processs?.[0]?.processId;
        }
      } catch (fetchError) {
        console.error("Failed to fetch fresh survey data:", fetchError);
      }
    }

    if (!processId) {
      toast.error("Process ID not found. Cannot submit workflow action.");
      loaderRef?.current?.hide();
      return;
    }

    const payload = {
      applicationNo: registrationData?.vessel?.applicationNumber,
      processId: processId,
      actionId: selectedAction?.actionId,
      assignerRole: userRole,
      assignerName:
        userDetails?.userName ||
        JSON.parse(getFromLocalStorage("userDetails"))?.userName ||
        "",
      fileId: modalFormData?.document?.url || "",
      remarks: modalFormData?.reason,
    };
    
    const response = await postData(URL, payload);
    if (
      response &&
      response?.status === 200 &&
      response?.data?.responseStatus?.status === "200"
    ) {
      toast.success(
        response?.data?.responseStatus?.message ||
          "Action submitted successfully"
      );
      handleCloseModal();
      loaderRef?.current?.hide();
      setTimeout(() => {
        navigate("/dashboard");
      }, 1000);
    } else {
      loaderRef?.current?.hide();
      toast.info(
        response?.data?.responseStatus?.message || "Something went wrong..",
        { position: "top-right" }
      );
    }
  } catch (err) {
    console.log(err);
    loaderRef?.current?.hide();
    handleErrorMessage(err?.response?.data);
  }
};
