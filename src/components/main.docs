    //     required: () => formData.categoryOfOwner === "INDIVIDUAL",
    //     colSize: 6,
    //   },
    //   // {
    //   //   name: "companyRegistrationCertificate",
    //   //   label: t("vesselOwnerRegistration.Company Registration Certificate"),
    //   //   type: "file",
    //   //   required: false,
    //   //   colSize: 6,
    //   // },
    //   {
    //     name: "tradeLicenseUpload",
    //     label: t("vesselOwnerRegistration.Trade License"),
    //     type: "file",
    //     required: () => formData.categoryOfOwner === "INDIVIDUAL",
    //     colSize: 6,
    //     showIf: () => !isExemptCategory,
    //   },
    //   {
    //     name: "companyRegistrationCertificate",
    //     label: t("Company Registration Certificate"),
    //     type: "file",
    //     required: false,
    //     colSize: 6,
    //     showIf: () => isCompany,
    //   },
    //   {
    //     name: "moaCertificate",
    //     label: t("vesselOwnerRegistration.MOA Certificate"),
    //     type: "file",
    //     required: false,
    //     colSize: 6,
    //     validation: {},
    //     showIf: () => isCompany,
    //   },
    //   {
    //     name: "aoaCertificate",
    //     label: t("vesselOwnerRegistration.AOA Certificate"),
    //     type: "file",
    //     required: false,
    //     colSize: 6,
    //     validation: {},
    //     showIf: () => isCompany,
    //   },
    // ],

    step3: [
      ...getDocumentsForOwner(formData, null, t),
      ...(isExistingUser
        ? [
            {
              name: "EXISTING_DOCUMENTS",
              label: t("vesselOwnerRegistration.Existing Documents"),
              code: "EXISTING_DOCUMENT",
              type: "file",
              required: true,
              colSize: 6,
            },
          ]
        : []),
      {
        name: "additionalDocuments",
        label: t("vesselOwnerRegistration.Additional_Documents"),
        type: "multifile",
        code: "ADDITIONAL_DOCUMENT",
        required: false,
        colSize: 12,
      },
    ],
  };

  const getDetailsByPIN = async (pinCode) => {
    try {
      const URL =
        PUBLIC_URL +
        URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE +
        pinCode;
      loaderRef.current?.show();
      const response = await getData(URL);
      if (response?.status === 200 && response?.data?.length > 0) {
        setValue("district", response?.data[0]?.district);
        setValue("state", response?.data[0]?.stateName);
        loaderRef?.current?.hide();
      } else {
        loaderRef?.current?.hide();
        toast.info("No Data Found! Pleasee enter manually..", {
          position: "top-right",
        });
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const getCurrentStepFields = () => {
    let fields = [];
    switch (currentStep) {
      case 1:
        fields = formFields.step1;
        break;
      case 2:
        fields = formFields.step2;
        break;
      case 3:
        fields = formFields.step3;
        break;
      default:
        fields = [];
    }

    return fields.filter((field) => !field.showIf || field.showIf());
  };

  const validateStep = async () => {
    const currentFields = getCurrentStepFields();
    const requiredFields = currentFields.filter((field) => {
      if (
        isExemptCategory &&
        ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(field.name)
      ) {
        return false;
      }

      if (typeof field.required === "function") {
        return field.required();
      }

      return field.required;
    });

    requiredFields.forEach((field) => {
      const value = getValues(field.name);
      if (!value || value === "") {
        setError(field.name, {
          type: "required",
          message: `${field.label} is required`,
        });
      } else if (field.validation && field.validation.pattern) {
        const pattern = field.validation.pattern.value;
        if (!pattern.test(value)) {
          setError(field.name, {
            type: "pattern",
            message: field.validation.pattern.message,
          });
        }
      }
    });

    const fieldsToValidate = currentFields
      .filter((field) => {
        if (
          isExemptCategory &&
          ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(field.name)
        ) {
          return false;
        }
        return true;
      })
      .map((field) => field.name);
    return await trigger(fieldsToValidate);
  };

  const handleNext = async () => {
    const isStepValid = await validateStep();

    if (isStepValid) {
      setValidationMessage("");

      const currentValues = getValues();

      setFormData((prev) => {
        const newFormData = { ...prev };

        Object.keys(currentValues).forEach((key) => {
          if (currentValues[key] !== undefined) {
            newFormData[key] = currentValues[key];
          }
        });

        return newFormData;
      });

      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    }
  };

  const handlePrevious = () => {
    const currentValues = getValues();

    const fileFields = getCurrentStepFields().filter(
      (field) => field.type === "file"
    );
    fileFields.forEach((field) => {
      if (currentValues[field.name]) {
        setFormData((prev) => ({
          ...prev,
          [field.name]: currentValues[field.name],
        }));
      }
    });

    // Handle additional documents
    additionalFiles.forEach((file) => {
      const fileName = `ADDITIONALDOCS_file_${file.id}`;
      const descName = `ADDITIONALDOCS_desc_${file.id}`;
      if (currentValues[fileName]) {
        setFormData((prev) => ({
          ...prev,
          [fileName]: currentValues[fileName],
          [descName]: currentValues[descName],
        }));
      }
    });

    setFormData((prev) => ({ ...prev, ...currentValues }));
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
    setValidationMessage("");
  };

  // const onSubmit = (data) => {
  //   const finalData = { ...formData, ...data };

  //   const payload = createOwnerOrBuilderPayload("VESSEL_OWNER", {
  //     ...finalData,
  //   });

  //   // Get additional documents
  //   const additionalDocs = [];
  //   additionalFiles.forEach(file => {
  //     const fileData = finalData[`ADDITIONAL_DOCS_file_${file.id}`];
  //     if (fileData) {
  //       additionalDocs.push(fileData);
  //     }
  //   });

  //   const files = [
  //     // Base documents
  //     finalData?.panCardUpload,
  //     finalData?.gstUpload,
  //     finalData?.tradeLicenseUpload,
  //     finalData?.authorizationLetter,

  //     // Individual documents
  //     finalData?.aadhaarUpload,
  //     finalData?.dlUpload,

  //     // Company documents
  //     finalData?.cosRegCertUpload,
  //     finalData?.cosResolutionUpload,
  //     finalData?.beCosRegDocsUpload,
  //     finalData?.beCosGovDocsUpload,
  //     finalData?.beCosResolutionUpload,
  //     finalData?.compRegCertUpload,
  //     finalData?.compMoaAoaUpload,
  //     finalData?.compBoardResUpload,
  //     finalData?.partnerRegCertUpload,
  //     finalData?.partnerDeedUpload,
  //     finalData?.trustRegCertUpload,
  //     finalData?.trustDeedUpload,
  //     finalData?.fdiRegCertUpload,
  //     finalData?.fdiResolutionUpload,
  //     finalData?.fdiProofUpload,
  //     finalData?.vslBareboatUpload,
  //     finalData?.vslChartererProofUpload,
  //     finalData?.stateAoaUpload,
  //     finalData?.stateMoaUpload,
  //     finalData?.centralAoaUpload,
  //     finalData?.centralMoaUpload,
  //     finalData?.localAoaUpload,
  //     finalData?.localMoaUpload,
  //     finalData?.otherPanUpload,
  //     finalData?.otherGstUpload,

  //     // Additional documents
  //     ...additionalDocs
  //   ];

  //   const fd = new FormData();
  //   fd.append(
  //     "request",
  //     new Blob([JSON.stringify(payload)], { type: "application/json" })
  //   );

  //   files?.forEach((file) => {
  //     if (file) {
  //       fd.append(`files`, file);
  //     }
  //   });

  //   submitUserDetails(fd);
  // };

  // const onSubmit = (data) => {
  //   const finalData = { ...formData, ...data };

  //   const payload = createOwnerOrBuilderPayload("VESSEL_OWNER", {
  //     ...finalData,
  //   });

  //   // Get additional documents
  //   const additionalDocs = [];
  //   additionalFiles.forEach((file) => {
  //     const fileData = finalData[`ADDITIONALDOCS_file_${file.id}`];
  //     if (fileData) {
  //       additionalDocs.push(fileData);
  //     }
  //   });

  //   const files = [
  //     finalData?.addressProof,
  //     finalData?.panCardUpload,
  //     finalData?.gstCertificate,
  //     finalData?.authorizationLetter,
  //     finalData?.companyRegistrationCertificate,
  //     finalData?.moaCertificate,
  //     finalData?.aoaCertificate,
  //     finalData?.tradeLicenseUpload,
  //     finalData?.existingDocuments,
  //     ...additionalDocs,
  //   ];

  //   const fd = new FormData();
  //   fd.append(
  //     "request",
  //     new Blob([JSON.stringify(payload)], { type: "application/json" })
  //   );

  //   files?.forEach((file) => {
  //     if (file) {
  //       fd.append(`files`, file);
  //     }
  //   });

  //   submitUserDetails(fd);
  // };

  //update-->new logic
  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };

    const additionalDocs = [];
    additionalFiles.forEach((file) => {
      const fileData = finalData[`ADDITIONALDOCS_file_${file.id}`];
      const descData = finalData[`ADDITIONALDOCS_desc_${file.id}`];
      const fileStoreId = finalData[`ADDITIONALDOCS_fileStoreId_${file.id}`];

      if (fileData && fileStoreId) {
        additionalDocs.push({
          id: "",
          documentName: fileData.name,
          documentType: "ADDITIONAL_DOCUMENT",
          documentSource: finalData.categoryOfOwner,
          fileStoreId,
          description: descData || "Additional Document",
        });
      }
    });

    // Add all additional documents to the category array
    if (additionalDocs?.length > 0) {
      const category = finalData?.categoryOfOwner;
      const arrayKey = SUPPORTING_DOC_KEYS[category];

      if (!finalData.supportingDocument) {
        finalData.supportingDocument = {};
      }

      if (!finalData.supportingDocument[arrayKey]) {
        finalData.supportingDocument[arrayKey] = [];
      }

      // Add all additional documents to existing array
      finalData.supportingDocument[arrayKey] = [
        ...finalData.supportingDocument[arrayKey],
        ...additionalDocs,
      ];
    }

    const payload = createOwnerOrBuilderPayload("VESSEL_OWNER", finalData);
    console.log("payload", payload);
    submitUserDetails(payload);
  };

  const submitUserDetails = async (payload) => {
    try {
      const URL =
        process.env.REACT_APP_AUTH_URL +
        URLS_ENDPOINT.USER_SERVICE.CREATE_UPDATE_USER_V2;
      loaderRef.current?.show();
      const response = await postData(URL, payload);
      const apiRes = { ...response?.data };
      if (
        response?.status === 200 &&
        apiRes?.responseStatus?.status === "200"
      ) {
        loaderRef?.current?.hide();
        setIsSubmitted(true);
        setSuccessMessage(apiRes?.responseStatus?.message);
        setApplicationData(apiRes?.data);
        window.scrollTo(0, 0);
      } else {
        loaderRef?.current?.hide();
        toast.info(
          apiRes?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  // const submitUserDetails = async (payload) => {
  //   try {
  //     const URL =
  //       process.env.REACT_APP_AUTH_URL +
  //       URLS_ENDPOINT.USER_SERVICE.CREATE_UPDATE_USER;
  //     loaderRef.current?.show();
  //     const response = await postFORMdata(URL, payload);
  //     const apiRes = { ...response?.data };
  //     if (
  //       response?.status === 200 &&
  //       apiRes?.responseStatus?.status === "200"
  //     ) {
  //       loaderRef?.current?.hide();
  //       setIsSubmitted(true);
  //       setSuccessMessage(apiRes?.responseStatus?.message);
  //       setApplicationData(apiRes?.data);
  //       window.scrollTo(0, 0);
  //     } else {
  //       loaderRef?.current?.hide();
  //       toast.info(
  //         apiRes?.responseStatus?.message || "Something went wrong..",
  //         { position: "top-right" }
  //       );
  //     }
  //   } catch (err) {
  //     console.log(err);
  //     loaderRef?.current?.hide();
  //     handleErrorMessage(err?.response?.data);
  //   }
  // };

  const handleFileUpload = async (file, fieldName, fieldLabel) => {
    const maxSize = 10 * 1024 * 1024;
    if (file.size > maxSize) {
      toast.error("File size must be less than or equal to 10 MB.");
      return null;
    }

    try {
      loaderRef.current?.show();
      const formData = new FormData();
      formData.append("file", file);

      const uploadUrl =
        BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE_PUBLIC;

      const response = await axios.post(uploadUrl, formData, {
        headers: { "Content-Type": "multipart/form-data" },
      });

      if (response?.data?.files?.[0]?.fileStoreId) {
        const fileStoreId = response?.data?.files[0]?.fileStoreId;
        const extension = file.name.substring(file.name.lastIndexOf("."));

        const modifiedFile = new File(
          [file],
          `${fieldLabel?.replace(/\s+/g, "")?.toLowerCase()}${extension}`,
          { type: file.type, lastModified: file.lastModified }
        );

        setValue(fieldName, modifiedFile);
        // setValue(`${fieldName}_fileStoreId`, fileStoreId);

        setFormData((prev) => {
          const updated = { ...prev, [fieldName]: modifiedFile };
          return updated;
        });

        if (errors[fieldName]) {
          clearErrors(fieldName);
        }

        setFormData((prev) => {
          const category = prev?.categoryOfOwner;
          let arrayKey = SUPPORTING_DOC_KEYS[category];
          //  if (!arrayKey) return prev;

          const allDocs = [
            ...OWNER_DOC_CONFIG.baseDocuments,
            ...(OWNER_DOC_CONFIG.categoryDocuments[category] || []),
          ];
          const docConfig = allDocs.find((d) => d.name === fieldName);
          //  if (!docConfig) return prev;
          let documentType = docConfig?.code;
          let documentSource = category;
          console.log(
            "Document Type:",
            documentType,
            "Source:",
            documentSource
          );

          if (fieldName === "EXISTING_DOCUMENTS") {
            documentType = "EXISTING_DOCUMENT";
          } else if (fieldName === "authorizationLetter") {
            documentType = "AUTHORIZATION_LETTER";
          }

          const newDoc = {
            id: "",
            documentName: fieldLabel,
            documentType,
            documentSource,
            fileStoreId,
            description: fieldLabel,
          };
          // clone prev
          const updatedSupporting = { ...(prev?.supportingDocument || {}) };
          // ensure array exists
          updatedSupporting[arrayKey] = [
            ...(updatedSupporting[arrayKey] || []).filter(
              (d) => d.documentType !== newDoc.documentType
            ), // replace if already uploaded
            newDoc,
          ];

          return { ...prev, supportingDocument: updatedSupporting };
        });
        ///--- Update the Array Heree

        loaderRef.current?.hide();
        return fileStoreId;
      } else {
        throw new Error("Invalid response from server");
      }
    } catch (err) {
      console.error("File upload failed", err);
      toast.error("File upload failed. Please try again.");
      loaderRef.current?.hide();
      return null;
    }
  };

  const DynamicField = ({ field }) => {
    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case "select":
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register(field?.name, {
              ...field.validation,
            })}
            errors={errors}
            icon={field.icon}
            className="mb-3"
            onChange={(value, selObj) => {
              setSelOwner("");
              if (field?.name === "categoryOfOwner") {
                setIsCompany(selObj?.isCompany || false);
                const isIndividual =
                  value?.toLowerCase()?.includes("indv") || "";
                setIsExemptCategory(!isIndividual);
                setValue(field.name, value);
                if (!isIndividual) {
                  clearErrors(["panNo", "aadharNumber", "tradeLicenseNumber"]);
                } else {
                  trigger(["panNo", "aadharNumber", "tradeLicenseNumber"]);
                }
                if (errors[field.name]) {
                  clearErrors(field.name);
                }
                setFormData((prev) => ({
                  ...prev,
                  [field.name]: value,
                }));
                setSelOwner(selObj);
              } else if (field?.name === "existingUser") {
                setIsExistingUser(value === "Y");
                setValue(field.name, value);
                if (errors[field.name]) {
                  clearErrors(field.name);
                }
                if (value === "Y") {
                  showAlert({
                    type: "info",
                    title: "Information Alert",
                    message:
                      "As you an existing vessel owner, Please upload all the relevant information for all the existing vessels, in the Documents section of this form.",
                    autoDismiss: false,
                    buttons: [
                      {
                        label: "OK",
                        onClick: () => {
                          closeAlert();
                        },
                      },
                    ],
                  });

                  //   toast.info("As you are an Existing Vessel Owner, You need to add existing vessel related information in a document", {
                  //     position: "top-right",
                  //   });
                  // }
                }
                setFormData((prev) => ({
                  ...prev,
                  [field.name]: value,
                }));
              } else {
                setValue(field.name, value);
                if (errors[field.name]) clearErrors(field.name);
                setFormData((prev) => ({
                  ...prev,
                  [field.name]: value,
                }));
              }
            }}
            value={formData[field.name] || watch(field.name)}
            autoFocus={field.autoFocus}
          />
        );

      case "file":
        return (
          <InputFile
            label={field.label}
            required={
              typeof field.required === "function"
                ? field.required()
                : field.required
            }
            name={field.name}
            key={field.name}
            register={register(field.name, {
              required: (
                typeof field.required === "function"
                  ? field.required()
                  : field.required
              )
                ? `${field.label} is required`
                : false,
            })}
            errors={errors}
            onChange={async (e) => {
              e.preventDefault();
              if (e.target.files && e.target.files[0]) {
                const file = e.target.files[0];

                const validTypes = [
                  "application/pdf",
                  "image/jpeg",
                  "image/png",
                  "image/jpg",
                ];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: "manual",
                    message: "Only PDF, JPG or PNG files are allowed",
                  });
                  return;
                }

                if (file.size > 10 * 1024 * 1024) {
                  setError(field.name, {
                    type: "manual",
                    message: "File size should not exceed 10MB",
                  });
                  return;
                }

                await handleFileUpload(file, field?.name, field?.label);
              }
            }}
            // onChange={(e) => {
            //   if (e.target.files && e.target.files[0]) {
            //     const file = e.target.files[0];
            //     const extension = file.name.substring(
            //       file.name.lastIndexOf(".")
            //     );

            //     const modifiedFile = new File(
            //       [file],
            //       `${field.label
            //         .replace(/\s+/g, "")
            //         .toLowerCase()}${extension}`,
            //       {
            //         type: file.type,
            //         lastModified: file.lastModified,
            //       }
            //     );

            //     setValue(field.name, modifiedFile);

            //     setFormData((prev) => {
            //       const updated = { ...prev, [field.name]: modifiedFile };
            //       return updated;
            //     });

            //     if (errors[field.name]) {
            //       clearErrors(field.name);
            //     }

            //     const validTypes = [
            //       "application/pdf",
            //       "image/jpeg",
            //       "image/png",
            //       "image/jpg",
            //     ];
            //     if (!validTypes.includes(file.type)) {
            //       setError(field.name, {
            //         type: "manual",
            //         message: "Only PDF, JPG or PNG files are allowed",
            //       });
            //     }

            //     if (file.size > 10 * 1024 * 1024) {
            //       setError(field.name, {
            //         type: "manual",
            //         message: "File size should not exceed 10MB",
            //       });
            //     }
            //   }
            // }}

            className="mb-3"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={formData[field.name]}
            autoFocus={field.autoFocus}
            style={{
              borderColor: errors[field.name] ? "#dc3545" : "#ced4da",
              backgroundColor: errors[field.name] ? "#fff8f8" : "white",
            }}
          />

          //   {/* Add cross button for regular files */}
          //   {watch(field.name) && (
          //     <FaTimesCircle
          //       className="text-danger position-absolute"
          //       style={{
          //         top: "60%",
          //         right: "1.5rem",
          //         transform: "translateY(-50%)",
          //         cursor: "pointer",
          //         zIndex: 10,
          //       }}
          //       size={16}
          //       title="Remove file"
          //       onClick={() => {
          //         setValue(field.name, null);
          //         clearErrors(field.name);
          //         setFormData(prev => {
          //           const updated = { ...prev };
          //           delete updated[field.name];
          //           return updated;
          //         });
          //       }}
          //     />
          //   )}
          // </div>
        );

      case "multifile":
        return (
          <MultiFile
            title={field.label}
            files={additionalFiles}
            type="ADDITIONALDOCS"
            icon={<FaFileUpload className="me-2" />}
            watch={watch}
            viewMode={false}
            editMode={false}
            clearErrors={clearErrors}
            register={register}
            errors={errors}
            setError={setError}
            setValue={setValue}
            unregister={() => {}}
            localFiles={additionalFiles}
            setFiles={setAdditionalFiles}
            isRegistrationMode={true}
            ref={loaderRef}
          />
        );

      default:
        return (
          // <InputText
          //   label={field.label}
          //   required={
          //     isExemptCategory &&
          //     ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
          //       field.name
          //     )
          //       ? false
          //       : field.required
          //   }
          //   name={field.name}
          //   key={field.name}
          //   type={field.type}
          //   placeholder={field.placeholder}
          //   register={register(field?.name, {
          //     ...(isExemptCategory &&
          //     ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
          //       field.name
          //     )
          //       ? {}
          //       : field.validation),
          //   })}
          //   onChange={handleChange}
          //   errors={errors}
          //   readOnly={field.readOnly}
          //   icon={field.icon}
          //   maxlength={field?.maxlength}
          //   onKeyDown={field?.keyDown}
          //   disabled={field?.disabled || false}
          //   className="mb-3"
          //   style={{
          //     borderColor:
          //       errors[field.name] &&
          //       !(
          //         isExemptCategory &&
          //         ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
          //           field.name
          //         )
          //       )
          //         ? "#dc3545"
          //         : "#ced4da",
          //     backgroundColor:
          //       errors[field.name] &&
          //       !(
          //         isExemptCategory &&
          //         ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
          //           field.name
          //         )
          //       )
          //         ? "#fff8f8"
          //         : "white",
          //   }}
          //   autoFocus={field.autoFocus}
          // />

          <InputText
            label={field.label}
            required={
              ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
                field.name
              )
                ? isIndividualOwner(formData)
                : field.required
            }
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...(["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
                field.name
              )
                ? isIndividualOwner(formData)
                  ? field.validation
                  : {}
                : field.validation),
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className="mb-3"
            style={{
              borderColor:
                errors[field.name] &&
                (["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
                  field.name
                )
                  ? isIndividualOwner(formData)
                  : true)
                  ? "#dc3545"
                  : "#ced4da",
              backgroundColor:
                errors[field.name] &&
                (["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
                  field.name
                )
                  ? isIndividualOwner(formData)
                  : true)
                  ? "#fff8f8"
                  : "white",
            }}
            autoFocus={field.autoFocus}
          />
        );
    }
  };

  const stepTitles = [
    {
      title: t("vesselOwnerRegistration.Vessel Owner Details"),
      icon: FaBuilding,
    },
    {
      title: t("vesselOwnerRegistration.Authorized Person's Details"),
      icon: FaUser,
    },
    {
      title: t("vesselOwnerRegistration.Documents Upload"),
      icon: FaFileUpload,
    },
  ];

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="registration-container py-3 py-md-5">
        <div
          style={{
            position: "absolute",
            top: "10px",
            right: "10px",
            zIndex: 1050,
          }}
        >
          <Dropdown>
            <Dropdown.Toggle
              variant="link"
              className="p-0 d-flex align-items-center gap-1"
              style={{
                color: "#fff",
                textDecoration: "none",
                fontSize: "1.5rem",
                marginTop: "6px",
              }}
            >
              <FaGlobe />
            </Dropdown.Toggle>
            <Dropdown.Menu className="language-dropdown-menu">
              <Dropdown.Item
                onClick={() => changeLanguage("en")}
                active={language === "en"}
                className="d-flex align-items-center gap-2"
              >
                <FiFlag size={18} style={{ color: "#2563eb" }} />
                <span>English</span>
                {language === "en" && (
                  <FaCheck className="ms-auto text-success" />
                )}
              </Dropdown.Item>
              <Dropdown.Item
                onClick={() => changeLanguage("bn")}
                active={language === "bn"}
                className="d-flex align-items-center gap-2"
              >
                <GiIndiaGate size={18} style={{ color: "#f59e42" }} />
                <span>বাংলা</span>
                {language === "bn" && (
                  <FaCheck className="ms-auto text-success" />
                )}
              </Dropdown.Item>
            </Dropdown.Menu>
          </Dropdown>
        </div>

        <Row className="justify-content-center">
          <Col xs={12} md={11} lg={10} xl={9}>
            <Card className="registration-card">
              <Card.Header className="registration-header p-0">
                <div className="registration-header-content flex-column flex-md-row text-center text-md-start">
                  <div className="header-logo-container mb-3 mb-md-0">
                    <Image
                      src={IWT_FULL_IMG}
                      alt="IWT Logo"
                      className="header-logo img-fluid"
                    />
                  </div>
                  <h3 className="header-title mb-0">
                    {t("vesselOwnerRegistration.Vessel Owner Registration")}
                  </h3>
                </div>
              </Card.Header>

              <Card.Body className="registration-body p-3 p-md-4 p-lg-5">
                {isSubmitted ? (
                  <div className="success-container text-center py-4 py-md-5">
                    <div
                      className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4"
                      style={{
                        width: "80px",
                        height: "80px",
                        boxShadow: "0 8px 16px rgba(40, 167, 69, 0.3)",
                      }}
                    >
                      <FaCheck className="success-icon text-white fs-1" />
                    </div>
                    <h4 className="success-title text-success mb-3 fw-bold">
                      Registration Successful!
                    </h4>
                    <div className="registration-id p-3 p-md-4 bg-light rounded mb-4">
                      <div className="mb-3">
                        <strong>Registration Number:</strong>
                        <div className="text-primary fs-6 fs-md-5 fw-bold mt-2">
                          {applicationData?.userBasicDetails
                            ?.registrationNumber || "N/A"}
                        </div>
                      </div>
                      <p className="mb-0">
                        {successMessage ||
                          "Your vessel owner registration has been submitted successfully. You will receive a confirmation email shortly."}
                      </p>
                    </div>
                    <Button
                      variant="primary"
                      size="lg"
                      className="mt-2 d-flex align-items-center justify-content-center mx-auto"
                      style={{
                        background: "linear-gradient(135deg, #0077b6, #023e8a)",
                        border: "none",
                        boxShadow: "0 4px 12px rgba(0, 119, 182, 0.3)",
                        borderRadius: "8px",
                        padding: "10px 24px",
                        fontWeight: "600",
                        transition: "all 0.3s ease",
                        minWidth: "140px",
                        height: "48px",
                      }}
                      onClick={() => (window.location.href = "/")}
                    >
                      Go to Home
                    </Button>
                  </div>
                ) : (
                  <FormProvider {...methods}>
                    <form>
                      <div className="stepper-container">
                        <div className="stepper flex-wrap flex-md-nowrap">
                          {[1, 2, 3].map((step, index) => (
                            <React.Fragment key={step}>
                              <div
                                className={`step ${
                                  currentStep >= step ? "active" : ""
                                } ${currentStep > step ? "completed" : ""}`}
                              >
                                <div className="step-circle">
                                  {currentStep > step ? (
                                    <FaCheck size={16} />
                                  ) : (
                                    React.createElement(
                                      stepTitles[step - 1].icon,
                                      { size: 16 }
                                    )
                                  )}
                                </div>
                                <div className="step-label text-center">
                                  {stepTitles[step - 1].title}
                                </div>
                              </div>
                              {index < 2 && (
                                <div
                                  className={`step-connector ${
                                    currentStep > step ? "active" : ""
                                  } d-none d-md-block`}
                                ></div>
                              )}
                            </React.Fragment>
                          ))}
                        </div>
                      </div>

                      <div className="text-center mb-1 mb-md-3">
                        <p className="text-muted small small-md">
                          {t(
                            "vesselOwnerRegistration.Please complete all required information to register your vessel"
                          )}
                        </p>
                      </div>

                      <div className="step-content">
                        <div className="form-section p-3 p-md-4 rounded mb-3">
                          <div className="section-title d-flex align-items-center mb-2">
                            {React.createElement(
                              stepTitles[currentStep - 1].icon,
                              { className: "section-icon me-2" }
                            )}
                            <h6 className="mb-0 fw-bold">
                              {stepTitles[currentStep - 1].title}
                            </h6>
                          </div>

                          <div className="form-content py-2 py-md-3">
                            <Row className="g-3">
                              {getCurrentStepFields()?.map((field, index) => (
                                <Col
                                  key={`${field.name}-${isCompany}-${isExemptCategory}`}
                                  xs={12}
                                  md={field.colSize || 12}
                                  className="mb-0"
                                >
                                  <DynamicField field={field} />
                                </Col>
                              ))}

                              {/* For multiple owners input chip testing */}
                              {/* {
                          <Col md={6} className="mb-0">
                            <InputChip
                              name="owners"
                              label="Mutiple Owner Names"
                              required
                              initialValues={formData?.owners || []}
                              tooltipText="Enter names separated by 'Enter' or 'Comma' "
                              placeholder="Type a Name and press Enter"
                              register={register}
                              rules={{
                                required:
                                  "At least one owner is required",
                              }}
                              errors={errors}
                              clearErrors={clearErrors}
                              maxChips={10}
                              onChange={(names) => setOwners(names)}
                            />
                          </Col>
                        } */}
                            </Row>
                          </div>
                        </div>
                      </div>

                      <div className="form-navigation mt-3 mt-md-4 d-flex justify-content-between">
                        {currentStep > 1 && (
                          <Button
                            variant="outline-secondary"
                            onClick={handlePrevious}
                            className="prev-btn"
                          >
                            <FaArrowLeft className="btn-icon me-2" />{" "}
                            {t("Previous")}
                          </Button>
                        )}

                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="next-btn ms-auto"
                        >
                          {currentStep === totalSteps
                            ? t("Submit Registration")
                            : t("Next")}
                          {currentStep !== totalSteps && (
                            <FaArrowRight className="btn-icon ms-2" />
                          )}
                        </Button>
                      </div>
                    </form>
                  </FormProvider>
                )}
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Container>
    </>
  );
};

export default VesselOwnerRegistrationPage;
import React, { useState, useEffect, useRef, useCallback, use } from "react";
import { useForm, useFieldArray } from "react-hook-form";
import { Row, Col, Button, Card } from "react-bootstrap";
import InputText from "../../../../common/InputText.tsx";
import InputSelect from "../../../../common/InputSelect.tsx";
import InputFile from "../../../../common/InputFile.tsx";
import Collapsible from "../../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import {
  FaShip,
  FaCog,
  FaBroadcastTower,
  FaLeaf,
  FaUsers,
  FaFileUpload,
  FaPlus,
  FaTrash,
  FaDownload,
  FaTimesCircle,
} from "react-icons/fa";
import { useMasterData } from "../../../../context/MasterDataContext.js";
import { toast } from "react-toastify";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import { BASE_IP, URLS_ENDPOINT } from "../../../../../utils/urlsConstants.ts";
import axios from "axios";
import { postFORMdata } from "../../../../../services/http.service.ts";
