import React, { useState, useEffect, createContext, useContext } from 'react';
import { Link, useLocation, useNavigate } from 'react-router-dom';
import { 
  FaHome, 
  FaClipboardList, 
  FaUserCircle, 
  FaSignOutAlt, 
  FaCog, 
  FaBell, 
  FaSearch,
  FaChevronDown,
  FaPlus
} from 'react-icons/fa';
import './Navbar.css';
import Cookies from 'js-cookie';

// Create a context for search query
export const SearchContext = createContext({
  searchQuery: '',
  setSearchQuery: () => {}
});

export const useSearch = () => useContext(SearchContext);

const Navbar = () => {
  const [isExpanded, setIsExpanded] = useState(false);
  const [dropdownOpen, setDropdownOpen] = useState(false);
  const [notificationsOpen, setNotificationsOpen] = useState(false);
  const [searchOpen, setSearchOpen] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');
  const [userName, setUserName] = useState('');
  const [userType, setUserType] = useState('');
  const location = useLocation();
  const navigate = useNavigate();

  useEffect(() => {
    // Get user data from localStorage
    try {
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;
      
      // Set user type
      if (userFormData?.userType) {
        setUserType(userFormData.userType);
      }
      
      // Set user name
      if (userInfo?.name) {
        setUserName(userInfo.name);
      } else if (userFormData?.userDetails?.claimantName) {
        setUserName(userFormData.userDetails.claimantName);
      } else if (userFormData?.userDetails?.companyName) {
        setUserName(userFormData.userDetails.companyName);
      }
    } catch (error) {
      console.error("Error getting user info:", error);
    }
  }, []);

  // Check URL for search parameter on component mount
  useEffect(() => {
    const params = new URLSearchParams(location.search);
    const searchParam = params.get('search');
    if (searchParam) {
      setSearchQuery(searchParam);
    }
  }, [location.search]);

  // Dispatch sidebar state change event
  useEffect(() => {
    const event = new CustomEvent('sidebarStateChange', { 
      detail: { expanded: isExpanded } 
    });
    window.dispatchEvent(event);
  }, [isExpanded]);

  // Dispatch search query change event
  useEffect(() => {
    const event = new CustomEvent('searchQueryChange', { 
      detail: { searchQuery } 
    });
    window.dispatchEvent(event);
    
    // Store search query in sessionStorage for persistence across components
    sessionStorage.setItem('searchQuery', searchQuery);
  }, [searchQuery]);

  const handleLogout = () => {
    // Clear cookies and localStorage
    localStorage.clear();
    Cookies.remove('token');
    localStorage.removeItem('userFormData');
    // Redirect to login page
    navigate('/login');
  };

  // Mock notifications data
  const notifications = [
    { id: 1, text: 'Your claim #CL-2023-001 has been approved', time: '10 min ago', isNew: true },
    { id: 2, text: 'New document verification required', time: '1 hour ago', isNew: true },
    { id: 3, text: 'System maintenance scheduled for tonight', time: '3 hours ago', isNew: false },
    { id: 4, text: 'Welcome to the Claims Management System', time: '1 day ago', isNew: false },
  ];

  // Close dropdowns when clicking outside
  useEffect(() => {
    const handleClickOutside = (event) => {
      if (!event.target.closest('.user-dropdown') && !event.target.closest('.user-profile')) {
        setDropdownOpen(false);
      }
      if (!event.target.closest('.notification-dropdown') && !event.target.closest('.notification-icon')) {
        setNotificationsOpen(false);
      }
      if (!event.target.closest('.search-container') && !event.target.closest('.search-icon')) {
        setSearchOpen(false);
      }
    };

    document.addEventListener('mousedown', handleClickOutside);
    return () => {
      document.removeEventListener('mousedown', handleClickOutside);
    };
  }, []);

  // Get first letter of name for avatar
  const getInitial = () => {
    if (userName && userName.length > 0) {
      return userName.charAt(0).toUpperCase();
    }
    return 'U';
  };

  // Handle search submission
  const handleSearchSubmit = (e) => {
    e.preventDefault();
    if (searchQuery.trim()) {
      // If we're not on the dashboard, navigate there with search param
      if (location.pathname !== '/dashboard') {
        navigate(`/dashboard?search=${encodeURIComponent(searchQuery)}`);
      } else {
        // If already on dashboard, just update the URL without navigating
        const newUrl = `/dashboard?search=${encodeURIComponent(searchQuery)}`;
        window.history.pushState({ path: newUrl }, '', newUrl);
        
        // Dispatch search event to notify dashboard
        const event = new CustomEvent('searchQueryChange', { 
          detail: { searchQuery } 
        });
        window.dispatchEvent(event);
      }
      
      setSearchOpen(false);
    }
  };

  // Handle search input change
  const handleSearchChange = (e) => {
    setSearchQuery(e.target.value);
    
    // If we're on the dashboard, update search in real-time
    if (location.pathname === '/dashboard') {
      // No need to navigate, just update the search query
      // The dashboard will listen for changes via the context or event
    }
  };

  // Check if user is CRP (Corporate Representative)
  const isCRP = userType === "CRP";
const newClaimFun =()=>{
 
  localStorage.removeItem('apiResponse')
  localStorage.removeItem('fileUploads')
}
  return (
    <SearchContext.Provider value={{ searchQuery, setSearchQuery }}>
      <nav className={`navbar ${isExpanded ? 'expanded' : ''}`}>
        <div className="navbar-container">
          <div className="navbar-brand">
            <button className="menu-toggle" onClick={() => setIsExpanded(!isExpanded)}>
              <span></span>
              <span></span>
              <span></span>
            </button>
            <Link to="/dashboard" className="brand-logo">
              <img src="/Logo.png" alt="Logo" className="logo-img" />
              <span className="brand-name">Claims Management</span>
            </Link>
          </div>

          <div className="navbar-center">
            <form className={`search-container ${searchOpen ? 'active' : ''}`} onSubmit={handleSearchSubmit}>
              <input
                type="text"
                placeholder="Search claims, applications..."
                value={searchQuery}
                onChange={handleSearchChange}
                className="search-input"
              />
              <button type="submit" className="search-btn">
                <FaSearch />
              </button>
            </form>
          </div>

          <div className="navbar-right">
            <button className="nav-action-btn search-icon" onClick={() => setSearchOpen(!searchOpen)}>
              <FaSearch />
            </button>

            {/* Show New Claim button only for CLM users */}
            {!isCRP && (
              <Link to="/apply-claim" className="create-claim-btn" 
              onClick={newClaimFun()}
              >
                <FaPlus />
                <span>New Claim</span>
              </Link>
            )}

            {/* <div className="notification-container">
              <button 
                className="nav-action-btn notification-icon" 
                onClick={() => setNotificationsOpen(!notificationsOpen)}
              >
                <FaBell />
                <span className="notification-badge">2</span>
              </button>
              
              {notificationsOpen && (
                <div className="notification-dropdown">
                  <div className="dropdown-header">
                    <h3>Notifications</h3>
                    <button className="mark-all-read">Mark all as read</button>
                  </div>
                  <div className="notifications-list">
                    {notifications.map(notification => (
                      <div key={notification.id} className={`notification-item ${notification.isNew ? 'new' : ''}`}>
                        <div className="notification-content">
                          <p>{notification.text}</p>
                          <span className="notification-time">{notification.time}</span>
                        </div>
                        {notification.isNew && <div className="notification-indicator"></div>}
                      </div>
                    ))}
                  </div>
                  <div className="dropdown-footer">
                    <Link to="/notifications" onClick={() => setNotificationsOpen(false)}>View all notifications</Link>
                  </div>
                </div>
              )}
            </div> */}

            <div className="user-profile">
              <button 
                className="profile-btn" 
                onClick={() => setDropdownOpen(!dropdownOpen)}
              >
                <div className="avatar">
                  {getInitial()}
                </div>
                {/* <div className="user-info">
                  <span className="user-name">{userName || 'User'}</span>
                  <FaChevronDown className="dropdown-icon" />
                </div> */}
              </button>
              
              {dropdownOpen && (
                <div className="user-dropdown">
                  <Link to="/my-profile" className="dropdown-item">
                    <FaUserCircle />
                    <span>My Profile</span>
                  </Link>
                  <Link to="/settings" className="dropdown-item">
                    <FaCog />
                    <span>Settings</span>
                  </Link>
                  <div className="dropdown-divider"></div>
                  <button onClick={handleLogout} className="dropdown-item">
                    <FaSignOutAlt />
                    <span>Logout</span>
                  </button>
                </div>
              )}
            </div>
          </div>
        </div>

        <div className={`sidebar ${isExpanded ? 'expanded' : ''}`}>
          <div className="sidebar-menu">
            <Link 
              to="/dashboard" 
              className={`sidebar-item ${location.pathname === '/dashboard' ? 'active' : ''}`}
            >
              <FaHome className="sidebar-icon" />
              <span className="sidebar-text">Dashboard</span>
            </Link>
            {/* <Link 
              to="/tracking" 
              className={`sidebar-item ${location.pathname === '/tracking' ? 'active' : ''}`}
            >
              <FaClipboardList className="sidebar-icon" />
              <span className="sidebar-text">Track Claims</span>
            </Link> */}
            <Link 
              to="/my-profile" 
              className={`sidebar-item ${location.pathname === '/my-profile' || location.pathname === '/profile' ? 'active' : ''}`}
            >
              <FaUserCircle className="sidebar-icon" />
              <span className="sidebar-text">Profile</span>
            </Link>
            <Link 
              to="/settings" 
              className={`sidebar-item ${location.pathname === '/settings' ? 'active' : ''}`}
            >
              <FaCog className="sidebar-icon" />
              <span className="sidebar-text">Settings</span>
            </Link>
          </div>
          <div className="sidebar-footer">
            <button onClick={handleLogout} className="sidebar-item logout-btn">
              <FaSignOutAlt className="sidebar-icon" />
              <span className="sidebar-text">Logout</span>
            </button>
          </div>
        </div>
      </nav>
    </SearchContext.Provider>
  );
};

export default Navbar;

/* Navbar.css - Premium Professional Version */
:root {
  --primary-color: #0ea5e9; /* Modern blue */
  --primary-dark: #0284c7;
  --primary-light: #e0f2fe;
  --primary-gradient: linear-gradient(135deg, #0ea5e9, #0284c7);
  --secondary-color: #f97316;
  --secondary-light: #ffedd5;
  --text-dark: #0f172a;
  --text-medium: #334155;
  --text-light: #64748b;
  --text-muted: #94a3b8;
  --white: #ffffff;
  --light-bg: #f8fafc;
  --border-color: #e2e8f0;
  --success-color: #10b981;
  --success-light: #d1fae5;
  --danger-color: #ef4444;
  --danger-light: #fee2e2;
  --warning-color: #f59e0b;
  --warning-light: #fef3c7;
  --info-color: #3b82f6;
  --info-light: #dbeafe;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  --border-radius-sm: 4px;
  --border-radius: 8px;
  --border-radius-lg: 12px;
  --navbar-height: 70px;
  --sidebar-width: 260px;
  --sidebar-collapsed-width: 80px;
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

/* Base Styles with improved typography */
body {
  font-family: var(--font-sans);
  color: var(--text-dark);
  background-color: var(--light-bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Enhanced Navbar */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--navbar-height);
  background-color: var(--white);
  box-shadow: var(--shadow-md);
  z-index: 1000;
  transition: var(--transition);
  padding: 0;
  margin: 0;
  width: 100%;
}

.navbar-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  padding: 0 1.5rem;
  width: 100%;
  max-width: 100%;
}

/* Brand Logo with enhanced styling */
.navbar-brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  height: 100%;
}

.brand-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  color: var(--text-dark);
  font-weight: 600;
  font-size: 1.25rem;
  transition: var(--transition);
}

.brand-logo:hover {
  opacity: 0.9;
}

.logo-img {
  height: 36px;
  width: auto;
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.1));
}

.brand-name {
  display: block;
  white-space: nowrap;
  background: var(--primary-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: transparent;
  font-weight: 700;
  letter-spacing: 0.5px;
  font-size: 1.2rem;
}

/* Improved Menu Toggle Button */
.menu-toggle {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 24px;
  height: 18px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
  margin-right: 1.25rem;
  outline: none;
  transition: var(--transition);
}

.menu-toggle span {
  display: block;
  width: 100%;
  height: 2px;
  background-color: var(--text-medium);
  transition: var(--transition);
  border-radius: 4px;
}

.menu-toggle:hover span {
  background-color: var(--primary-color);
}

.menu-toggle:hover span:nth-child(1) {
  transform: translateY(-1px);
}

.menu-toggle:hover span:nth-child(3) {
  transform: translateY(1px);
}

/* Enhanced Search Container */
.navbar-center {
  flex: 1;
  display: flex;
  justify-content: center;
  max-width: 600px;
  margin: 0 1.5rem;
}

.search-container {
  position: relative;
  width: 100%;
  max-width: 500px;
  transition: var(--transition);
}

.search-input {
  width: 100%;
  padding: 0.75rem 1rem 0.75rem 2.75rem;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
  font-size: 0.95rem;
  transition: var(--transition);
  outline: none;
  color: var(--text-dark);
  box-shadow: var(--shadow-sm);
}

.search-input:focus {
  border-color: var(--primary-color);
  background-color: var(--white);
  box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
}

.search-input::placeholder {
  color: var(--text-muted);
}

.search-btn {
  position: absolute;
  left: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
  background: transparent;
  border: none;
  color: var(--text-light);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: var(--transition);
}

.search-input:focus + .search-btn,
.search-btn:hover {
  color: var(--primary-color);
}

/* Improved Navbar Right Section */
.navbar-right {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  margin-left: auto;
}

.nav-action-btn {
  background: transparent;
  border: none;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-medium);
  cursor: pointer;
  transition: var(--transition);
  position: relative;
}

.nav-action-btn:hover {
  background-color: var(--light-bg);
  color: var(--primary-color);
  transform: translateY(-1px);
}

.nav-action-btn:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
}

.nav-action-btn .badge {
  position: absolute;
  top: -2px;
  right: -2px;
  background-color: var(--danger-color);
  color: white;
  font-size: 0.7rem;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  border: 2px solid var(--white);
}

/* Enhanced Create Claim Button */
.create-claim-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.65rem 1.25rem;
  background: var(--primary-gradient);
  color: var(--white);
  border: none;
  border-radius: var(--border-radius);
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  transition: var(--transition);
  text-decoration: none;
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}

.create-claim-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0));
  transform: translateX(-100%) rotate(45deg);
  transition: transform 0.6s;
}

.create-claim-btn:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-lg);
  color: var(--white);
}

.create-claim-btn:hover::before {
  transform: translateX(100%) rotate(45deg);
}

.create-claim-btn:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.25);
}

.create-claim-btn span {
  display: inline-block;
  position: relative;
  z-index: 1;
}

.create-claim-btn svg {
  position: relative;
  z-index: 1;
}

/* Enhanced User Profile */
.user-profile {
  position: relative;
}

.profile-btn {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0.35rem;
  border-radius: var(--border-radius);
  transition: var(--transition);
  max-width: 200px;
  outline: none;
}

.profile-btn:hover {
  background-color: var(--light-bg);
}

.avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--primary-gradient);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 1rem;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
  border: 2px solid var(--white);
  transition: var(--transition);
}

.profile-btn:hover .avatar {
  transform: scale(1.05);
  box-shadow: var(--shadow-md);
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  overflow: hidden;
}

.user-name {
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--text-dark);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 120px;
}

.user-role {
  font-size: 0.8rem;
  color: var(--text-light);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 120px;
}

.user-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  width: 240px;
  background-color: var(--white);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-xl);
  z-index: 1000;
  overflow: hidden;
  animation: fadeIn 0.25s ease;
  border: 1px solid var(--border-color);
}

.dropdown-header {
  padding: 1rem;
  border-bottom: 1px solid var(--border-color);
  background-color: var(--light-bg);
}

.dropdown-header-name {
  font-weight: 600;
  font-size: 1rem;
  color: var(--text-dark);
  margin-bottom: 0.25rem;
}

.dropdown-header-email {
  font-size: 0.85rem;
  color: var(--text-light);
  word-break: break-all;
}

.dropdown-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.85rem 1rem;
  color: var(--text-medium);
  text-decoration: none;
  transition: var(--transition);
  cursor: pointer;
  border: none;
  background: transparent;
  width: 100%;
  text-align: left;
  font-size: 0.95rem;
  outline: none;
  font-weight: 500;
}

.dropdown-item:hover {
  background-color: var(--light-bg);
  color: var(--primary-color);
}

.dropdown-item:focus {
  box-shadow: none;
  background-color: var(--light-bg);
}

.dropdown-item svg {
  font-size: 1.1rem;
  color: var(--text-light);
  transition: var(--transition);
}

.dropdown-item:hover svg {
  color: var(--primary-color);
}

.dropdown-divider {
  height: 1px;
  background-color: var(--border-color);
  margin: 0.5rem 0;
}

/* Enhanced Sidebar Design */
.sidebar {
  position: fixed;
  top: var(--navbar-height);
  left: 0;
  width: var(--sidebar-collapsed-width);
  height: calc(100vh - var(--navbar-height));
  background-color: var(--white);
  box-shadow: var(--shadow-md);
  z-index: 900;
  transition: var(--transition);
  overflow-x: hidden;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  scrollbar-width: thin;
  scrollbar-color: var(--text-light) transparent;
}

.sidebar::-webkit-scrollbar {
  width: 4px;
}

.sidebar::-webkit-scrollbar-track {
  background: transparent;
}

.sidebar::-webkit-scrollbar-thumb {
  background-color: var(--text-light);
  border-radius: 20px;
}

.sidebar.expanded {
  width: var(--sidebar-width);
}

.sidebar-header {
  padding: 1.25rem 1rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sidebar-title {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-light);
  text-transform: uppercase;
  letter-spacing: 1px;
  opacity: 0;
  transition: var(--transition);
}

.sidebar.expanded .sidebar-title {
  opacity: 1;
}

.sidebar-menu {
  padding: 0.5rem 0.75rem;
}

.menu-category {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 0.75rem 1rem;
  margin-top: 0.5rem;
  opacity: 0;
  transition: var(--transition);
}

.sidebar.expanded .menu-category {
  opacity: 1;
}

.sidebar-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.85rem 1rem;
  margin: 0.25rem 0;
  color: var(--text-medium);
  text-decoration: none;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
  white-space: nowrap;
  border-radius: var(--border-radius);
  font-weight: 500;
  outline: none;
}

.sidebar-item:hover {
  background-color: var(--light-bg);
  color: var(--primary-color);
}

.sidebar-item.active {
  color: var(--primary-color);
  background-color: var(--primary-light);
  font-weight: 600;
}

.sidebar-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 4px;
  background-color: var(--primary-color);
  border-radius: 0 4px 4px 0;
}

.sidebar-icon {
  font-size: 1.25rem;
  min-width: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
}

.sidebar-item:hover .sidebar-icon {
  transform: translateY(-1px);
}

.sidebar-text {
  opacity: 0;
  transition: var(--transition);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 0.95rem;
}

.sidebar.expanded .sidebar-text {
  opacity: 1;
  display: block;
}

.sidebar-badge {
  margin-left: auto;
  background-color: var(--primary-light);
  color: var(--primary-color);
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.15rem 0.5rem;
  border-radius: 10px;
  opacity: 0;
  transition: var(--transition);
}

.sidebar.expanded .sidebar-badge {
  opacity: 1;
}

.sidebar-footer {
  padding: 1rem 0.75rem;
  margin-top: auto;
  position: relative;
}

.sidebar-footer::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40%;
  height: 1px;
  background: linear-gradient(to right, transparent, var(--border-color), transparent);
}

.logout-btn {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.85rem 1rem;
  margin: 0;
  color: var(--danger-color);
  background-color: transparent;
  border: none;
  border-radius: var(--border-radius);
  font-weight: 500;
  font-size: 0.95rem;
  cursor: pointer;
  transition: var(--transition);
  width: 100%;
  text-align: left;
  position: relative;
  overflow: hidden;
}

.logout-btn:hover {
  background-color: var(--danger-light);
}

.logout-btn:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
}

.logout-icon {
  font-size: 1.25rem;
  min-width: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
}

.logout-btn:hover .logout-icon {
  transform: translateX(2px);
}

.logout-text {
  opacity: 0;
  transition: var(--transition);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar.expanded .logout-text {
  opacity: 1;
}

/* Enhanced Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideIn {
  from {
    transform: translateX(-20px);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.sidebar-item {
  animation: slideIn 0.3s ease forwards;
  animation-delay: calc(0.05s * var(--item-index, 0));
  opacity: 0;
}

/* Responsive Styles */
@media (max-width: 992px) {
  .navbar-center {
    display: none;
  }
  
  .search-container.active {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 1rem;
    background-color: var(--white);
    box-shadow: var(--shadow-md);
    z-index: 1000;
    display: flex;
  }
  
  .sidebar {
    transform: translateX(-100%);
  }
  
  .sidebar.expanded {
    transform: translateX(0);
    width: 260px;
  }
}

@media (min-width: 993px) {
  .search-icon {
    display: none;
  }
  
  .sidebar {
    transform: translateX(0);
  }
  
  .sidebar-text {
    display: none;
  }
  
  .sidebar.expanded .sidebar-text {
    display: block;
  }
}

@media (max-width: 768px) {
  .brand-name {
    display: none;
  }
  
  .create-claim-btn span {
    display: none;
  }
  
  .create-claim-btn {
    width: 40px;
    height: 40px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
  
  .user-info {
    display: none;
  }
  
  .navbar-container {
    padding: 0 1rem;
  }
}
