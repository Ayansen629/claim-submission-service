<div className="d-flex justify-content-end mb-3">
  {!isViewMode && (
    <>
      {!isFormSubmitted && !isDeclarationEditable && !watch("workOrderDate") && (
        <Button
          size="sm"
          onClick={() => setIsDeclarationEditable(true)}
          style={{
            backgroundColor: "#007bff !important",
            borderColor: "#007bff !important",
            color: "#ffffff !important",
            marginRight: "10px"
          }}
        >
          Select Work Order Date
        </Button>
      )}
      
      {!isFormSubmitted && isDeclarationEditable && (
        <Button
          size="sm"
          onClick={() => {
            if (!watch("workOrderDate")) {
              toast.error("Please select work order date first");
              return;
            }
            setIsDeclarationEditable(false);
            toast.success("Work order date saved successfully!");
          }}
          style={{
            backgroundColor: "#28a745 !important",
            borderColor: "#28a745 !important",
            color: "#ffffff !important",
            marginRight: "10px"
          }}
        >
          Save Date
        </Button>
      )}
      
      {!isFormSubmitted && watch("workOrderDate") && !isDeclarationEditable && (
        <Button
          size="sm"
          onClick={() => setIsDeclarationEditable(true)}
          style={{
            backgroundColor: "#ffc107 !important",
            borderColor: "#ffc107 !important",
            color: "#000000 !important",
            marginRight: "10px"
          }}
        >
          Edit Date
        </Button>
      )}
      
      {watch("workOrderDate") && (
        <Button
          size="sm"
          onClick={handleGenerateDeclaration}
          style={{
            backgroundColor: "#00A3E0 !important",
            borderColor: "#00A3E0 !important",
            color: "#ffffff !important",
          }}
        >
          Generate Declaration
        </Button>
      )}
    </>
  )}
</div>
