import React, { useState, useEffect, useRef } from "react";
import { Row, Col, Button, Card } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile.tsx";
import InputText from "../../../common/InputText.tsx";
import { fetchAndViewFile, renameFile } from "../../../../utils/constants.ts";
import {
  BsDownload,
  BsEyeFill,
  BsFileEarmarkPdf,
  BsPlus,
  BsTrash,
} from "react-icons/bs";
import { BASE_IP, URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import { postFORMdata } from "../../../../services/http.service.ts";
import { FaClipboardList, FaPaperclip, FaTimesCircle } from "react-icons/fa";
import { toast } from "react-toastify";
import NewLoader from "../../../common/NewLoader.js";
import axios from "axios";
import { getFromLocalStorage } from "../../../../utils/localStorageUtils.js";
import { deleteFile } from "../../../../utils/deleteFile.js";
import styles from "./Documents.module.css";

const Documents = ({
  formMethods,
  viewMode = false,
  editMode = false,
  vesselRegisData,
  tonnageRequired,
  stabilityRequired,
  setParentWorkOrderFiles,
  setParentDrawingsFiles,
}) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  const [workOrderFiles, setWorkOrderFiles] = useState([{ id: 1 }]);
  const [drawingsFiles, setDrawingsFiles] = useState([{ id: 1 }]);
  const [regVesselData, setRegVesselData] = useState(vesselRegisData);
  const loaderRef = useRef();

  const {
    register,
    watch,
    setValue,
    clearErrors,
    getValues,
    setError,
    formState: { errors },
    unregister,
  } = formMethods;

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach((key) => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  useEffect(() => {
    const initializeFiles = () => {
      const workOrderIds = [];
      const drawingIds = [];

      if (viewMode) {
        for (let i = 1; i <= 50; i++) {
          const workOrderFile = getValues(`WORK_ORDER_file_${i}`);
          const drawingFile = getValues(`DRAWINGS_file_${i}`);

          if (workOrderFile && (workOrderFile.name || workOrderFile.size)) {
            workOrderIds.push({ id: i });
          }
          if (drawingFile && (drawingFile.name || drawingFile.size)) {
            drawingIds.push({ id: i });
          }
        }

        setWorkOrderFiles(workOrderIds);
        setParentWorkOrderFiles(workOrderIds);
        setDrawingsFiles(drawingIds);
        setParentDrawingsFiles(drawingIds);
      } else if (editMode) {
        for (let i = 1; i <= 50; i++) {
          const workOrderFile = getValues(`WORK_ORDER_file_${i}`);
          const drawingFile = getValues(`DRAWINGS_file_${i}`);

          if (workOrderFile && (workOrderFile.name || workOrderFile.size)) {
            workOrderIds.push({ id: i });
          }
          if (drawingFile && (drawingFile.name || drawingFile.size)) {
            drawingIds.push({ id: i });
          }
        }

        if (workOrderIds.length === 0) {
          workOrderIds.push({ id: 1 });
        }
        if (drawingIds.length === 0) {
          drawingIds.push({ id: 1 });
        }

        setWorkOrderFiles(workOrderIds);
        setParentWorkOrderFiles(workOrderIds);
        setDrawingsFiles(drawingIds);
        setParentDrawingsFiles(drawingIds);
      } else {
        for (let i = 1; i <= 50; i++) {
          const workOrderFile = getValues(`WORK_ORDER_file_${i}`);
          const drawingFile = getValues(`DRAWINGS_file_${i}`);

          if (workOrderFile && (workOrderFile.name || workOrderFile.size)) {
            workOrderIds.push({ id: i });
          }
          if (drawingFile && (drawingFile.name || drawingFile.size)) {
            drawingIds.push({ id: i });
          }
        }

        if (workOrderIds.length > 0) {
          setWorkOrderFiles(workOrderIds);
          setParentWorkOrderFiles(workOrderIds);
        }
        if (drawingIds.length > 0) {
          setDrawingsFiles(drawingIds);
          setParentDrawingsFiles(drawingIds);
        }
      }
    };

    const timer = setTimeout(initializeFiles, 200);
    return () => clearTimeout(timer);
  }, [viewMode, editMode, getValues]);

  useEffect(() => {
    if (!viewMode && !editMode) {
      const subscription = watch((value, { name, type }) => {
        if (name && name.includes("_file_")) {
          const fileType = name.includes("WORK_ORDER")
            ? "WORK_ORDER"
            : "DRAWINGS";
          const fileId = parseInt(name.split("_").pop());

          if (type === "change" && value[name]) {
            if (fileType === "WORK_ORDER") {
              setWorkOrderFiles((prev) => {
                const exists = prev.some((f) => f.id === fileId);
                if (!exists) {
                  return [...prev, { id: fileId }].sort((a, b) => a.id - b.id);
                }
                return prev;
              });
              setParentWorkOrderFiles((prev) => {
                const exists = prev.some((f) => f.id === fileId);
                if (!exists) {
                  return [...prev, { id: fileId }].sort((a, b) => a.id - b.id);
                }
                return prev;
              });
            } else if (fileType === "DRAWINGS") {
              setDrawingsFiles((prev) => {
                const exists = prev.some((f) => f.id === fileId);
                if (!exists) {
                  return [...prev, { id: fileId }].sort((a, b) => a.id - b.id);
                }
                return prev;
              });
              setParentDrawingsFiles((prev) => {
                const exists = prev.some((f) => f.id === fileId);
                if (!exists) {
                  return [...prev, { id: fileId }].sort((a, b) => a.id - b.id);
                }
                return prev;
              });
            }
          }
        }
      });

      return () => subscription.unsubscribe();
    }
  }, [watch, viewMode, editMode]);

  const DocumentCard = ({
    fileName,
    description,
    onDownload,
    fileSize,
    onRemove,
    showRemove = false,
  }) => {
    const [isMobile, setIsMobile] = useState(window.innerWidth <= 768);

    useEffect(() => {
      const handleResize = () => setIsMobile(window.innerWidth <= 768);
      window.addEventListener("resize", handleResize);
      return () => window.removeEventListener("resize", handleResize);
    }, []);

    return (
      <Card className="mb-1 border-0 shadow-sm">
        <Card.Body className="p-2">
          <div className="d-flex justify-content-between align-items-center">
            <div
              className="d-flex align-items-center flex-grow-1 me-2"
              style={{ minWidth: 0 }}
            >
              {!isMobile && (
                <div className="bg-danger bg-opacity-10 rounded-circle p-1 me-2 flex-shrink-0">
                  <BsFileEarmarkPdf className="text-danger" size={10} />
                </div>
              )}
              <div style={{ minWidth: 0 }}>
                <div
                  className="text-primary fw-semibold"
                  style={{
                    fontSize: isMobile ? "0.8rem" : "0.7rem",
                    overflow: "hidden",
                    textOverflow: "ellipsis",
                    whiteSpace: "nowrap",
                    lineHeight: "1.3",
                    marginBottom: isMobile ? "0" : "4px",
                  }}
                  title={fileName}
                >
                  {fileName}
                </div>
                {!isMobile && (
                  <>
                    <p
                      className="mb-0 text-muted"
                      style={{
                        fontSize: "0.6rem",
                        overflow: "hidden",
                        textOverflow: "ellipsis",
                        whiteSpace: "nowrap",
                      }}
                    >
                      {description}
                    </p>
                    {fileSize && (
                      <span
                        className="badge bg-light text-dark mt-1"
                        style={{ fontSize: "0.55rem" }}
                      >
                        {(fileSize / 1024 / 1024).toFixed(1)} MB
                      </span>
                    )}
                  </>
                )}
              </div>
            </div>
            <div className="flex-shrink-0">
              <Button
                variant="outline-primary"
                size="sm"
                onClick={() => onDownload(fileName)}
                className="rounded-pill d-flex align-items-center"
                style={{
                  minWidth: "auto",
                  fontSize: "0.6rem",
                  padding: isMobile ? "6px 8px" : "4px 6px",
                }}
              >
                {isMobile && <BsFileEarmarkPdf className="me-1" size={12} />}
                <BsDownload size={isMobile ? 12 : 8} />
                {!isMobile && <span className="ms-1">{t("Download")}</span>}
              </Button>
              {showRemove && (
                <Button
                  variant="outline-danger"
                  size="sm"
                  onClick={onRemove}
                  className="rounded-pill ms-1"
                  style={{ minWidth: "auto", padding: "4px 6px" }}
                >
                  <BsTrash size={8} />
                </Button>
              )}
            </div>
          </div>
        </Card.Body>
      </Card>
    );
  };

  const FileUploadCard = ({
    label,
    name,
    fileDownloadKey,
    onRemove,
    showRemove = false,
    fileIndex,
    displayIndex,
  }) => {
    const fileData = watch(name);
    const fileStoreId = watch(fileDownloadKey);
    const hasFile = fileData && (fileData.name || fileData.size);

    const handleDeleteFile = async (name) => {
      const res = await deleteFile(fileStoreId, loaderRef);
      if (res) {
        clearErrors(name);
        setValue(name, null);
        setValue(name.replace("_file_", "_fileStoreId_"), null);
      }
    };

    return (
      <Card className="mb-2 border-2 border-dashed border-primary border-opacity-25">
        <Card.Body className="p-2">
          <div className="mb-2">
            <div style={{ fontSize: "0.75rem", position: "relative" }}>
              <InputFile
                label={`${label} ${displayIndex}`}
                name={name}
                register={register(name)}
                errors={errors}
                onChange={(e) => {
                  if (e?.target?.files && e?.target?.files[0]) {
                    const file = e.target.files[0];

                    if (file.size > 30 * 1024 * 1024) {
                      setError(name, {
                        type: "manual",
                        message: t(
                          "vesselDetails..File size should not exceed 30MB"
                        ),
                      });
                      return;
                    }

                    const extension = file?.name?.substring(
                      file?.name?.lastIndexOf(".")
                    );
                    const fileType = name.includes("WORK_ORDER")
                      ? "WORK_ORDER"
                      : "DRAWINGS";
                    const fileName = `${fileType}_${String(fileIndex).padStart(
                      2,
                      "0"
                    )}${extension}`;
                    file.originalName = fileName;
                    const renamedFile = renameFile(file, fileName);
                    uploadFile(file, name, renamedFile, fileType, fileIndex);
                  }
                }}
                watch={watch}
                defaultValue={watch(name)}
                clearErrors={clearErrors}
                accept=".pdf,.jpg,.jpeg,.png"
                className="mobile-file-input"
                style={{ width: "100%" }}
              />

              {hasFile && !viewMode && (
                <FaTimesCircle
                  className="text-danger position-absolute file-remove-icon"
                  style={{
                    top: "55%",
                    right: "1.5rem",
                    transform: "translateY(-50%)",
                    cursor: "pointer",
                    zIndex: 10,
                  }}
                  size={16}
                  title="Remove file"
                  onClick={() => handleDeleteFile(name)}
                />
              )}
            </div>
          </div>
          <div className="mb-2">
            <div style={{ fontSize: "0.75rem" }}>
              <InputText
                key={`desc-${name}`}
                label={t("vesselDetails.Description")}
                name={name?.replace("_file_", "_desc_")}
                placeholder={t("vesselDetails.Enter file description")}
                register={register(name.replace("_file_", "_desc_"))}
                errors={errors}
                className="mobile-text-input"
              />
            </div>
          </div>
          <div className="text-end d-flex justify-content-end gap-1">
            {editMode && hasFile && (
              <>
                <Button
                  variant="outline-success"
                  size="sm"
                  onClick={() => fetchAndViewFile(fileStoreId || "")}
                  className="rounded-pill"
                  style={{ fontSize: "0.65rem", padding: "2px 6px" }}
                >
                  <BsEyeFill className="me-1" size={8} />
                  <span className=" d-sm-inline">View</span>
                </Button>
                <Button
                  variant="outline-primary"
                  size="sm"
                  onClick={() => handleDownload(fileStoreId, fileData?.name)}
                  className="rounded-pill"
                  style={{ fontSize: "0.65rem", padding: "2px 6px" }}
                >
                  <BsDownload className="me-1" size={8} />
                  <span className=" d-sm-inline">Download</span>
                  {/* <span className="d-sm-none">↓</span> */}
                </Button>
              </>
            )}
            {showRemove && (
              <Button
                variant="outline-danger"
                size="sm"
                onClick={onRemove}
                className="rounded-pill"
                style={{ fontSize: "0.65rem", padding: "2px 6px" }}
              >
                <BsTrash size={8} />
                <span className="ms-1 d-sm-inline">Remove</span>
                {/* <span className="d-sm-none">×</span> */}
              </Button>
            )}
          </div>
        </Card.Body>
      </Card>
    );
  };

  const FileSection = ({ title, files, type, icon }) => {
    const [isMobile, setIsMobile] = useState(window.innerWidth <= 768);

    useEffect(() => {
      const handleResize = () => setIsMobile(window.innerWidth <= 768);
      window.addEventListener("resize", handleResize);
      return () => window.removeEventListener("resize", handleResize);
    }, []);

    const filesWithData = files?.filter((file) => {
      const fileData = watch(`${type}_file_${file.id}`);
      return fileData && (fileData.name || fileData.size);
    });

    return (
      <Card className="h-100 shadow-sm border-0">
        <Card.Header className="bg-light border-0 py-2">
          <div
            className={`d-flex justify-content-between align-items-start ${isMobile ? "card-header-mobile" : ""
              }`}
          >
            <div className="d-flex justify-content-start align-items-start p-1 flex-wrap gap-1">
              <h6
                className="mb-0 text-primary fw-bold d-flex align-items-center"
                style={{ fontSize: isMobile ? "0.8rem" : "0.75rem" }}
              >
                {icon}
                <span className="ms-2">{title}</span>
              </h6>
              <span
                className={`ms-1 px-2 py-1 badge d-flex align-items-center gap-1 badge-bg ${isMobile ? "badge-mobile ms-0" : "ms-2"
                  }`}
                style={{
                  fontSize: isMobile ? "0.6rem" : "0.7rem",
                  padding: "2px 6px",
                  boxShadow: "0 1px 4px rgba(0,0,0,0.2)",
                  color: "#1A61C1",
                }}
              >
                <FaPaperclip size={isMobile ? 10 : 12} />
                {viewMode
                  ? `${filesWithData?.length} Files Uploaded`
                  : editMode
                    ? `${filesWithData?.length}/50 Files Attached`
                    : `${filesWithData?.length} Files Selected`}
              </span>
            </div>
            <div className="d-flex justify-content-end align-items-start">
              {!viewMode && (
                <Button
                  variant="primary"
                  size="sm"
                  onClick={() => addFileInput(type)}
                  className={`${styles.addBtn} ${isMobile ? "ms-0 mt-1" : "ms-2"
                    } badge bg-primary rounded-pill`}
                  style={{ fontSize: "0.6rem" }}
                  disabled={files.length >= 50}
                >
                  <BsPlus className="me-1" size={10} />
                  <span >Add</span>
                  {/* <BsPlus className="me-1" size={10} />
                  <span className={isMobile ? "d-none" : ""}>Add</span>
                  <span className={isMobile ? "" : "d-none"}>+</span> */}
                </Button>
              )}
            </div>
          </div>
        </Card.Header>

        <Card.Body className="p-1">
          <div
            style={{
              maxHeight: isMobile ? "350px" : "250px",
              overflowY: "auto",
            }}
          >
            {viewMode ? (
              filesWithData.length > 0 ? (
                filesWithData.map((fileInput, index) => {
                  const fileData = watch(`${type}_file_${fileInput.id}`);
                  const descData = watch(`${type}_desc_${fileInput.id}`);

                  return (
                    <DocumentCard
                      key={fileInput.id}
                      fileName={fileData.name}
                      description={descData || `${title} document ${index + 1}`}
                      fileSize={fileData.size}
                      onDownload={() =>
                        handleDownload(
                          watch(`${type}_fileStoreId_${fileInput.id}`),
                          watch(`${type}_file_${fileInput.id}`)?.name
                        )
                      }
                    />
                  );
                })
              ) : (
                <div className="text-center py-3 text-muted">
                  <div className="bg-light rounded-circle p-2 d-inline-flex mb-2">
                    <BsFileEarmarkPdf size={20} className="opacity-50" />
                  </div>
                  <p className="mb-0" style={{ fontSize: "0.7rem" }}>
                    No files uploaded
                  </p>
                </div>
              )
            ) : (
              files.map((fileInput, idx) => {
                return (
                  <div key={fileInput.id}>
                    <FileUploadCard
                      label={t("vesselDetails.Choose File")}
                      name={`${type}_file_${fileInput.id}`}
                      fileDownloadKey={`${type}_fileStoreId_${fileInput.id}`}
                      fileIndex={fileInput.id}
                      displayIndex={idx + 1}
                      onRemove={() => removeFileInput(type, fileInput.id)}
                      showRemove={files.length > 1}
                    />
                  </div>
                );
              })
            )}
          </div>
        </Card.Body>
      </Card>
    );
  };

  const SingleFileSection = ({
    title,
    fileName,
    onDownload,
    fileSize,
    icon,
  }) => {
    const [isMobile, setIsMobile] = useState(window.innerWidth <= 768);

    useEffect(() => {
      const handleResize = () => setIsMobile(window.innerWidth <= 768);
      window.addEventListener("resize", handleResize);
      return () => window.removeEventListener("resize", handleResize);
    }, []);

    return (
      <Card className="h-100 shadow-sm border-0">
        <Card.Header className="bg-light border-0 py-2">
          <h6
            className="mb-0 text-primary fw-bold d-flex align-items-center"
            style={{ fontSize: isMobile ? "0.8rem" : "0.75rem" }}
          >
            {icon}
            <span className="ms-2">{title}</span>
          </h6>
        </Card.Header>
        <Card.Body className="p-2">
          {fileName ? (
            <DocumentCard
              fileName={fileName}
              description={`${title} document`}
              fileSize={fileSize}
              onDownload={() => onDownload(fileName)}
            />
          ) : (
            <div className="text-center py-2 text-muted">
              <div className="bg-light rounded-circle p-2 d-inline-flex mb-2">
                <BsFileEarmarkPdf
                  size={isMobile ? 16 : 20}
                  className="opacity-50"
                />
              </div>
              <p
                className="mb-0"
                style={{ fontSize: isMobile ? "0.65rem" : "0.7rem" }}
              >
                No file uploaded
              </p>
            </div>
          )}
        </Card.Body>
      </Card>
    );
  };

  const addFileInput = (type) => {
    if (viewMode) return;

    if (type === "WORK_ORDER") {
      if (workOrderFiles.length >= 50) return;

      const existingIds = workOrderFiles.map((f) => f.id);
      let nextId = 1;
      while (existingIds.includes(nextId)) {
        nextId++;
      }

      setWorkOrderFiles((prev) =>
        [...prev, { id: nextId }].sort((a, b) => a.id - b.id)
      );
      setParentWorkOrderFiles((prev) =>
        [...prev, { id: nextId }].sort((a, b) => a.id - b.id)
      );
    } else if (type === "DRAWINGS") {
      if (drawingsFiles.length >= 50) return;

      const existingIds = drawingsFiles.map((f) => f.id);
      let nextId = 1;
      while (existingIds.includes(nextId)) {
        nextId++;
      }

      setDrawingsFiles((prev) =>
        [...prev, { id: nextId }].sort((a, b) => a.id - b.id)
      );
      setParentDrawingsFiles((prev) =>
        [...prev, { id: nextId }].sort((a, b) => a.id - b.id)
      );
    }
  };

  const removeFileInput = async (type, id, fileDownloadKey) => {
    if (viewMode) return;

    const fileStoreId = watch(`${type}_fileStoreId_${id}`);
    // console.log("fileStoreId ", fileStoreId);
    if (fileStoreId) {
      const res = await deleteFile(fileStoreId, loaderRef);
      if (!res) {
        return;
      }
    }
    if (type === "WORK_ORDER") {
      setWorkOrderFiles((prev) => prev.filter((file) => file.id !== id));
      setParentWorkOrderFiles((prev) => prev.filter((file) => file.id !== id));
    } else if (type === "DRAWINGS") {
      setDrawingsFiles((prev) => prev.filter((file) => file.id !== id));
      setParentDrawingsFiles((prev) => prev.filter((file) => file.id !== id));
    }
    // setValue(`${type}_file_${id}`, null);
    // setValue(`${type}_desc_${id}`, "");
    unregister(`${type}_file_${id}`);
    unregister(`${type}_desc_${id}`);
    unregister(`${type}_fileStoreId_${id}`);
    clearErrors([`${type}_file_${id}`, `${type}_desc_${id}`]);

    setValue(`${type}_file_${id}`, null);
    setValue(`${type}_desc_${id}`, "");
    setValue(`${type}_fileStoreId_${id}`, null);
  };

  const handleDownload = async (fileStoreId, fileName) => {
    try {
      if (!fileStoreId) return;
      const url = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${fileStoreId}`;

      loaderRef.current?.show();

      const accessToken = getFromLocalStorage("access_token");
      const tokenDetails = getFromLocalStorage("tokenDetails");
      const sessionState = tokenDetails
        ? JSON.parse(tokenDetails)?.session_state
        : "";

      const response = await axios({
        method: "GET",
        url: url,
        responseType: "blob",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "X-Request-ID": sessionState,
          Accept: "application/octet-stream",
        },
      });

      if (response.data) {
        let filename = fileName || "document";
        const contentDisposition = response.headers["content-disposition"];
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(
            /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
          );
          if (filenameMatch && filenameMatch[1]) {
            filename = filenameMatch[1].replace(/['"]/g, "");
          }
        }

        const blob = new Blob([response.data], {
          type: response.headers["content-type"] || "application/octet-stream",
        });
        const blobUrl = window.URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = blobUrl;
        link.setAttribute("download", filename);
        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          window.URL.revokeObjectURL(blobUrl);
        }, 100);
      }
    } catch (error) {
      console.error("Error downloading file:", error);
      toast.error("Failed to download file. Please try again.");
    } finally {
      loaderRef.current?.hide();
    }
  };

  const uploadFile = async (
    file,
    formValueName,
    renamedFile,
    fileType,
    fileIndex
  ) => {
    try {
      loaderRef?.current?.show();
      const formData = new FormData();
      formData.append("file", file);
      const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
      const response = await postFORMdata(uploadUrl, formData);
      const fileStoreId = response?.data?.files[0]?.fileStoreId;

      clearErrors(formValueName);
      setValue(formValueName, renamedFile, { shouldValidate: true });

      if (
        fileType === "STABILITY_BOOKLETS" ||
        fileType === "TONNAGE_BOOKLETS"
      ) {
        setValue(fileType + "_fileStoreId", fileStoreId);
      } else {
        setValue(fileType + "_fileStoreId_" + fileIndex, fileStoreId);
        setFormData((prev) => ({
          ...prev,
          [formValueName]: renamedFile,
        }));
      }

      loaderRef?.current?.hide();
    } catch (err) {
      loaderRef?.current?.hide();
      console.error(err);
      setError(formValueName, {
        type: "manual",
        message: t("File upload failed"),
      });
      toast.error("File upload failed...");
    }
  };

  const handleRemoveTonnageFile = async () => {
    const fileStoreId = watch("TONNAGE_BOOKLETS_fileStoreId");
    console.log("fileStoreId - ", fileStoreId);
    const res = await deleteFile(fileStoreId, loaderRef);
    if (res) {
      clearErrors("TONNAGE_BOOKLETS");
      setValue("TONNAGE_BOOKLETS", null);
      setValue("TONNAGE_BOOKLETS_fileStoreId", null);
    }
  };

  const handleRemoveStabilityFile = async () => {
    const fileStoreId = watch("STABILITY_BOOKLETS_fileStoreId");
    console.log("fileStoreId - ", fileStoreId);
    const res = await deleteFile(fileStoreId, loaderRef);
    if (res) {
      clearErrors("STABILITY_BOOKLETS");
      setValue("STABILITY_BOOKLETS", null);
      setValue("STABILITY_BOOKLETS_fileStoreId", null);
    }
  };

  return (
    <>
      <NewLoader ref={loaderRef} />
      <style jsx>{`
        @media (max-width: 768px) {
          .mobile-file-input .file-upload {
            padding: 0.5rem !important;
          }

          .mobile-file-input .file-label {
            font-size: 0.7rem !important;
            padding: 4px 8px !important;
            min-width: 80px !important;
          }

          .mobile-file-input .file-name-container {
            font-size: 0.65rem !important;
            padding: 4px 8px !important;
          }

          .mobile-text-input .form-control {
            font-size: 0.75rem !important;
            padding: 0.25rem 0.5rem !important;
          }

          .mobile-text-input .form-label {
            font-size: 0.7rem !important;
            margin-bottom: 0.25rem !important;
          }

          .file-remove-icon {
            top: 3.7rem !important;
            right: 0.9rem !important;
          }

          .other-file-remove-icon {
            top: 3.3rem !important;
            right: 0.9rem !important;
          }

          .card-header-mobile {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 0.5rem;
          }

          .badge-mobile {
            margin-left: 0 !important;
            margin-top: 0.25rem;
          }

          /* Fix for single file sections */
          .h-100 {
            min-height: 200px !important;
          }

          .card-body {
            overflow-x: auto;
          }
        }
      `}</style>
      <Collapsible
        title={
          <>
            <FaClipboardList className="me-2" />
            <span>{t("vesselDetails.Documents")}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem", backgroundColor: "#f8f9fa" }}>
          <Row className="g-3">
            <Col xs={12} lg={6}>
              <FileSection
                title={t("vesselDetails.Work Order")}
                files={workOrderFiles}
                type="WORK_ORDER"
                icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
              />
            </Col>

            <Col xs={12} lg={6}>
              <FileSection
                title={t("vesselDetails.Drawings")}
                files={drawingsFiles}
                type="DRAWINGS"
                icon={<BsFileEarmarkPdf className="text-success" size={12} />}
              />
            </Col>

            <Col xs={12} md={6}>
              {viewMode ? (
                <SingleFileSection
                  title={t("vesselDetails.Tonnage Booklets")}
                  fileName={watch("TONNAGE_BOOKLETS")?.name}
                  fileSize={watch("TONNAGE_BOOKLETS")?.size}
                  onDownload={() =>
                    handleDownload(
                      watch("TONNAGE_BOOKLETS_fileStoreId"),
                      watch("TONNAGE_BOOKLETS")?.name
                    )
                  }
                  icon={<BsFileEarmarkPdf className="text-warning" size={12} />}
                />
              ) : (
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-2">
                    <h6
                      className="mb-0 text-primary fw-bold d-flex align-items-center"
                      style={{ fontSize: "0.75rem" }}
                    >
                      <BsFileEarmarkPdf
                        className="text-warning me-2"
                        size={12}
                      />
                      {t("vesselDetails.Tonnage Booklets")}
                    </h6>
                  </Card.Header>
                  <Card.Body className="p-2">
                    <div style={{ fontSize: "0.75rem", position: "relative" }}>
                      <InputFile
                        label={t("vesselDetails.Tonnage Booklets")}
                        required={tonnageRequired}
                        name="TONNAGE_BOOKLETS"
                        register={register("TONNAGE_BOOKLETS")}
                        errors={errors}
                        style={{ width: "100%" }}
                        onChange={(e) => {
                          if (e.target.files && e?.target?.files[0]) {
                            const file = e.target.files[0];
                            if (file.size > 30 * 1024 * 1024) {
                              setError("TONNAGE_BOOKLETS", {
                                type: "manual",
                                message: t("File size should not exceed 30MB"),
                              });
                              return;
                            }
                            const extension = file?.name?.substring(
                              file?.name?.lastIndexOf(".")
                            );
                            const fileName = `Tonnage Booklets${extension}`;
                            file.originalName = fileName;
                            const renamedFile = renameFile(file, fileName);
                            uploadFile(
                              file,
                              "TONNAGE_BOOKLETS",
                              renamedFile,
                              "TONNAGE_BOOKLETS"
                            );
                            // clearErrors("TONNAGE_BOOKLETS");
                            // setValue("TONNAGE_BOOKLETS", renamedFile, {
                            //   shouldValidate: true,
                            // });
                          }
                        }}
                        watch={watch}
                        accept=".pdf,.jpg,.jpeg,.png"
                        defaultValue={watch("TONNAGE_BOOKLETS")}
                        clearErrors={clearErrors}
                        className="mobile-file-input"
                      />

                      {watch("TONNAGE_BOOKLETS") && !viewMode && (
                        <FaTimesCircle
                          className="text-danger position-absolute other-file-remove-icon"
                          style={{
                            top: "2.9rem",
                            right: "1.5rem",
                            cursor: "pointer",
                            zIndex: 10,
                          }}
                          size={16}
                          title="Remove file"
                          onClick={handleRemoveTonnageFile}
                        />
                      )}
                    </div>
                    {editMode && watch("TONNAGE_BOOKLETS") && (
                      <div className="text-end mt-2">
                        <Button
                          variant="outline-success"
                          size="sm"
                          onClick={() =>
                            fetchAndViewFile(
                              watch("TONNAGE_BOOKLETS_fileStoreId") || ""
                            )
                          }
                          className="rounded-pill me-1"
                          style={{ fontSize: "0.65rem", padding: "2px 6px" }}
                        >
                          <BsEyeFill className="me-1" size={8} />
                          <span className="d-none d-sm-inline">View</span>
                        </Button>
                        <Button
                          variant="outline-primary"
                          size="sm"
                          onClick={() =>
                            handleDownload(
                              watch("TONNAGE_BOOKLETS_fileStoreId"),
                              watch("TONNAGE_BOOKLETS")?.name
                            )
                          }
                          className="rounded-pill"
                          style={{ fontSize: "0.65rem", padding: "2px 6px" }}
                        >
                          <BsDownload className="me-1" size={8} />
                          <span className="d-none d-sm-inline">Download</span>
                          <span className="d-sm-none">↓</span>
                        </Button>
                      </div>
                    )}
                  </Card.Body>
                </Card>
              )}
            </Col>

            <Col xs={12} md={6}>
              {viewMode ? (
                <SingleFileSection
                  title={t("vesselDetails.Stability Booklets")}
                  fileName={watch("STABILITY_BOOKLETS")?.name}
                  fileSize={watch("STABILITY_BOOKLETS")?.size}
                  onDownload={() =>
                    handleDownload(
                      watch("STABILITY_BOOKLETS_fileStoreId"),
                      watch("STABILITY_BOOKLETS")?.name
                    )
                  }
                  icon={<BsFileEarmarkPdf className="text-info" size={12} />}
                />
              ) : (
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-2">
                    <h6
                      className="mb-0 text-primary fw-bold d-flex align-items-center"
                      style={{ fontSize: "0.75rem" }}
                    >
                      <BsFileEarmarkPdf className="text-info me-2" size={12} />
                      {t("vesselDetails.Stability Booklets")}
                    </h6>
                  </Card.Header>
                  <Card.Body className="p-2">
                    <div style={{ fontSize: "0.75rem", position: "relative" }}>
                      <InputFile
                        label={t("vesselDetails.Stability Booklets")}
                        required={stabilityRequired}
                        name="STABILITY_BOOKLETS"
                        register={register("STABILITY_BOOKLETS")}
                        errors={errors}
                        style={{ width: "100%" }}
                        onChange={(e) => {
                          if (e.target.files && e?.target?.files[0]) {
                            const file = e.target.files[0];
                            if (file.size > 30 * 1024 * 1024) {
                              setError("STABILITY_BOOKLETS", {
                                type: "manual",
                                message: t("File size should not exceed 30MB"),
                              });
                              return;
                            }
                            const extension = file?.name?.substring(
                              file?.name?.lastIndexOf(".")
                            );
                            const fileName = `Stability Booklets${extension}`;
                            file.originalName = fileName;
                            const renamedFile = renameFile(file, fileName);
                            // clearErrors("STABILITY_BOOKLETS");
                            // setValue("STABILITY_BOOKLETS", renamedFile, {
                            //   shouldValidate: true,
                            // });
                            uploadFile(
                              file,
                              "STABILITY_BOOKLETS",
                              renamedFile,
                              "STABILITY_BOOKLETS"
                            );
                          }
                        }}
                        watch={watch}
                        accept=".pdf,.jpg,.jpeg,.png"
                        defaultValue={watch("STABILITY_BOOKLETS")}
                        clearErrors={clearErrors}
                        className="mobile-file-input"
                      />

                      {watch("STABILITY_BOOKLETS") && !viewMode && (
                        <FaTimesCircle
                          className="text-danger position-absolute other-file-remove-icon"
                          style={{
                            top: "2.9rem",
                            right: "1.5rem",
                            cursor: "pointer",
                            zIndex: 10,
                          }}
                          size={16}
                          title="Remove file"
                          onClick={handleRemoveStabilityFile}
                        />
                      )}
                    </div>
                    {editMode && watch("STABILITY_BOOKLETS") && (
                      <div className="text-end mt-2">
                        <Button
                          variant="outline-success"
                          size="sm"
                          className="rounded-pill me-1"
                          style={{ fontSize: "0.65rem", padding: "2px 6px" }}
                          onClick={() =>
                            fetchAndViewFile(
                              watch("STABILITY_BOOKLETS_fileStoreId") || ""
                            )
                          }
                        >
                          <BsEyeFill className="me-1" size={8} />
                          <span className="d-none d-sm-inline">View</span>
                        </Button>
                        <Button
                          variant="outline-primary"
                          size="sm"
                          onClick={() =>
                            handleDownload(
                              watch("STABILITY_BOOKLETS_fileStoreId"),
                              watch("STABILITY_BOOKLETS")?.name
                            )
                          }
                          className="rounded-pill"
                          style={{ fontSize: "0.65rem", padding: "2px 6px" }}
                        >
                          <BsDownload className="me-1" size={8} />
                          <span className="d-none d-sm-inline">Download</span>
                          <span className="d-sm-none">↓</span>
                        </Button>
                      </div>
                    )}
                  </Card.Body>
                </Card>
              )}
            </Col>

            <Col md={12}>
              <Card className="shadow-sm border-0">
                <Card.Body className="p-3">
                  <div className="d-flex align-items-start">
                    <input
                      type="checkbox"
                      id="termsAccepted"
                      className="me-3 mt-1"
                      {...register("termsAccepted", {
                        required: t("You must accept the terms and conditions"),
                      })}
                      onChange={(e) => {
                        setValue("termsAccepted", e.target.checked);
                        if (e.target.checked) {
                          clearErrors("termsAccepted");
                        }
                      }}
                      disabled={viewMode}
                      checked={viewMode ? true : watch("termsAccepted")}
                    />
                    <div className="flex-grow-1">
                      <label
                        htmlFor="termsAccepted"
                        className="mb-0 fw-medium"
                        style={{
                          color: "#333",
                          cursor: viewMode ? "default" : "pointer",
                          lineHeight: "1.5",
                          fontSize: "0.85rem",
                        }}
                      >
                        {t(
                          "vesselDetails.I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule."
                        )}
                      </label>
                      {errors.termsAccepted && !viewMode && (
                        <div className="text-danger small mt-2">
                          {t(errors.termsAccepted.message)}
                        </div>
                      )}
                    </div>
                  </div>
                </Card.Body>
              </Card>
            </Col>
          </Row>
        </div>
      </Collapsible>
    </>
  );
};

export default Documents;
