<Dropdown align="end">
  <OverlayTrigger
    placement="top"
    overlay={<BSTooltip id={`tooltip-${row?.id}`}>More Actions</BSTooltip>}
  >
    <Dropdown.Toggle variant="link" id={`dropdown-${row?.id}`} className={style.actionToggle}>
      <ThreeDots size={20} />
    </Dropdown.Toggle>
  </OverlayTrigger>

  <Dropdown.Menu className={style.actionMenu}>
    {(o.actions.includes("edit") || row?.isEditable) && (
      <Dropdown.Item onClick={() => handleEdit(row)}>
        <PencilSquare size={16} />
        Edit
      </Dropdown.Item>
    )}

    {o.actions.includes("view") && (
      <Dropdown.Item onClick={() => handleView(row)}>
        <FaEye size={16} />
        View
      </Dropdown.Item>
    )}

    {o.actions.includes("delete") && (
      <Dropdown.Item onClick={() => handleDeleteRow(row)}>
        <FaTrash size={16} />
        Delete
      </Dropdown.Item>
    )}

    {o.actions.includes("download") && (
      <Dropdown.Item onClick={() => handleDownload(row)}>
        <FaDownload size={16} />
        Download
      </Dropdown.Item>
    )}

    {o.actions.includes("upload") && (
      <Dropdown.Item onClick={() => handleView(row)}>
        <FaUpload size={16} />
        Upload
      </Dropdown.Item>
    )}

    {(o.actions.includes("uploadReports") || row?.isEnableUploadReports) && (
      <Dropdown.Item onClick={() => handleUploadReports(row)}>
        <Upload size={16} />
        Upload Reports
      </Dropdown.Item>
    )}

    {(o.actions.includes("vesselRegistration") || row?.isEnableApplicationRegistration) && (
      <Dropdown.Item onClick={() => handleVesselRegistration(row)}>
        <FileEarmarkText size={16} />
        Vessel Registration
      </Dropdown.Item>
    )}

    {(o.actions.includes("provisionalCertificate") || row?.isEnableProvisionalCertificate) && (
      <Dropdown.Item onClick={() => handleProvisionalCertificate(row)}>
        <Award size={16} />
        Provisional Certificate
      </Dropdown.Item>
    )}

    {o.actions.includes("revisedDrawing") && (
      <Dropdown.Item onClick={() => handleRevisedDrawing(row)}>
        <Pencil size={16} />
        Revised Drawing
      </Dropdown.Item>
    )}

    {(o.actions.includes("paySupervisionFee") || !row?.isEnableSupervisionFee) && (
      <Dropdown.Item onClick={() => handlePaySupervisionFee(row)}>
        <CreditCard size={16} />
        Pay Supervision Fee
      </Dropdown.Item>
    )}

    {(o.actions.includes("applyInitialSurvey") || row?.enableInitialSurvey) && (
      <Dropdown.Item onClick={() => handleApplyInitialSurvey(row)}>
        <ClipboardCheck size={16} />
        Apply Initial Survey
      </Dropdown.Item>
    )}

    {row?.isCMNGenerated && (
      <Dropdown.Item onClick={() => handleDownloadCMN(row)}>
        <Download size={16} />
        Download CMN
      </Dropdown.Item>
    )}

    {row?.isCMNGenerated && !row.enableInitialSurvey && (
      <Dropdown.Item onClick={() => handleSlotBooking(row)}>
        <Calendar2Check size={16} />
        Slot Booking
      </Dropdown.Item>
    )}
  </Dropdown.Menu>
</Dropdown>
