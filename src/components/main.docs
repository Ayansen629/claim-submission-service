<Form.Control
          ref={inputRef}
          type={inputType}
          name={name}
          placeholder={placeholder}
          {...register}
          disabled={disabled}
          onChange={(e: any) => {
            handleChange(e);
            if (register?.onChange) {
              register.onChange(e);
            }
          }}
          maxLength={maxlength}
          readOnly={readOnly}
          onKeyDown={onKeyDown}
          min={type === "date" ? formatDate(minDate) : 0}
          max={type === "date" ? formatDate(maxDate) : undefined}
          className={inputClasses}
          aria-label={label}
          onBlur={(e) => {
            setTouched(true);
            setIsTyping(false);
            if (register?.onBlur) {
              register.onBlur(e);
            }
          }}
          style={{
            ...style,
            borderColor: showError
              ? "#dc3545"
              : showSuccess && type !== "date"
              ? "#198754"
              : "#ced4da",
            backgroundColor: showError
              ? "#fff8f8"
              : showSuccess && type !== "date"
              ? "#f8fff9"
              : "white",
            transition: "all 0.3s ease",
          }}
          autoFocus={autoFocus}
        />
