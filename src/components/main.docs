const mapFilesByFieldName = (fileStoreMap) => {
  const fileMap = {};

  fileStoreMap?.forEach((file) => {
    const fieldName = file.fieldName?.toLowerCase();

    // Owner file mappings
    if (fieldName?.includes("pancard")) {
      fileMap.panCardUpload = file;
    } else if (fieldName?.includes("gstcertificate")) {
      fileMap.gstCertificate = file;
    } else if (fieldName?.includes("addressproof")) {
      fileMap.addressProof = file;
    } else if (fieldName?.includes("letterofauthorization")) {
      fileMap.authorizationLetter = file;
    } else if (fieldName?.includes("companyregistrationcertificate")) {
      fileMap.companyRegistrationCertificate = file;
    } else if (fieldName?.includes("moacertificate")) {
      fileMap.moaCertificate = file;
    } else if (fieldName?.includes("aoacertificate")) {
      fileMap.aoaCertificate = file;
    } else if (fieldName?.includes("tradelicense") || fieldName?.includes("trade license")) {
      fileMap.tradeLicenseUpload = file;
    }
    // Builder file mappings
    else if (fieldName?.includes("company details")) {
      fileMap.companyDetails = file;
    } else if (fieldName?.includes("pan card")) {
      fileMap.panCardUpload = file;
    } else if (fieldName?.includes("factory license")) {
      fileMap.factoryLicense = file;
    } else if (fieldName?.includes("fire certificate")) {
      fileMap.fireCertificate = file;
    } else if (fieldName?.includes("esipf registration")) {
      fileMap.esipfRegistration = file;
    } else if (fieldName?.includes("iso 9001")) {
      fileMap.iso9001 = file;
    } else if (fieldName?.includes("iso 14001")) {
      fileMap.iso14001 = file;
    } else if (fieldName?.includes("iso 45001")) {
      fileMap.iso45001 = file;
    } else if (fieldName?.includes("pollution certificate")) {
      fileMap.pollutionCertificate = file;
    } else if (fieldName?.includes("experience certificate")) {
      fileMap.experienceCertificate = file;
    } else if (fieldName?.includes("address proof")) {
      fileMap.addressProof = file;
    } else if (fieldName?.includes("gst certificate")) {
      fileMap.gstCertificate = file;
    }
  });

  return fileMap;
};
