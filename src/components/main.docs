<Collapsible 
    title={
        <div className="section-header">
            <FaSignature className="section-icon" />
            <span>Signature of financial creditor or person authorised to act on its behalf</span>
        </div>
    } 
    defaultOpen={true}
>
    <div className="row g-3">
        {/* Ensure both fields are within the same row */}
        {creditorDetailsSchema.filter(f => ["creditorName", "creditorPosition"].includes(f.name)).map((fieldConfig) => (
            <div 
                key={fieldConfig.name} 
                className={`col-6`}  // Use col-6 for consistent two-column layout
            >
                <DynamicField
                    fieldConfig={{
                        ...fieldConfig,
                        isUploading,
                        uploadError,
                        uploadSuccess,
                        setIsUploading,
                        setUploadError,
                        setUploadSuccess,
                        onFileUpload: handleFileUpload
                    }}
                    control={control}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    trigger={trigger}
                    getValues={getValues}
                />
            </div>
        ))}
        
        {/* Render remaining fields after */}
        {creditorDetailsSchema.filter(f => !["creditorName", "creditorPosition"].includes(f.name)).map((fieldConfig) => (
            <div 
                key={fieldConfig.name} 
                className={`col-md-${fieldConfig.colSize || 12}`}
            >
                <DynamicField
                    fieldConfig={{
                        ...fieldConfig,
                        isUploading,
                        uploadError,
                        uploadSuccess,
                        setIsUploading,
                        setUploadError,
                        setUploadSuccess,
                        onFileUpload: handleFileUpload
                    }}
                    control={control}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    trigger={trigger}
                    getValues={getValues}
                />
            </div>
        ))}
    </div>
</Collapsible>
.form-label {
    display: flex;
    align-items: center;
    font-weight: 500;
    color: #34495e;
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
}

.form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #d5dbdf;
    border-radius: 6px;
    font-size: 0.95rem;
    background-color: #f8fafc;
}
