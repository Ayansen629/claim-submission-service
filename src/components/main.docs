/* Mobile responsive pagination fixes */
@media (max-width: 576px) {
  .tableFooter {
    padding: 1rem;
  }
  
  .tableFooterContent {
    flex-direction: column;
    gap: 1rem;
  }
  
  .tablePagination {
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }
  
  .paginationControls {
    justify-content: center;
    gap: 0.5rem;
  }
  
  .paginationButton {
    min-width: 2rem;
    height: 2rem;
    padding: 0.25rem 0.5rem;
  }
}
