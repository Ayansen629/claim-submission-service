const handleConfirm = (appointments) => {
  setShowModal(false);
  
  // appointments already come in the correct format from OfficerAppointmentModal
  if (onAppointmentConfirm) {
    onAppointmentConfirm(appointments);
  }
};

///////////
const handleAppointmentConfirm = (appointments) => {
  // appointments already come in correct format with timeSlot, appointmentStatus, isBooked, bookedBy
  setAppointmentSlots(appointments);
  
  // Call handleSubmit after setting appointment slots
  setTimeout(() => {
    handleSubmit();
  }, 100);
};
