import React, { useState, useRef, useEffect, useCallback, useMemo } from "react";
import { useNavigate, useParams } from "react-router-dom";
import { toast } from "react-toastify";
import { Modal, Button, Form } from "react-bootstrap";
import "./Stepper.css";
import { useRegistration } from "../../context/ApplicationContext";
import ReviewStep from "./ReviewStep";
import { FormDataProvider } from "../../context/FormDataContext";
import { postData } from "../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../utils/urlsConstants.ts";
import axios from "axios";
import { v4 as uuidv4 } from "uuid";

const deepEqual = (obj1, obj2) => {
  return JSON.stringify(obj1) === JSON.stringify(obj2);
};

const generateFileId = (file) => {
  return `file-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`;
};

const extractFileDetails = (file, source, documentType) => {
  if (!file) return null;

  return {
    docId: file.fileId,
    docName: file.docName,
    docType: documentType,
    docSource: source,
  };
};

const createFormPayload = (formData, isFinalSubmit, userFormData, applicationNumber = "", isActive) => {
  const creditorBasicDetailsUuid = formData.creditorBasicDetailsUuid || "";
  const claimDetailsUuid = formData.claimDetailsUuid || "";
  const signatoryDetailsUuid = formData.signatoryDetailsUuid || "";

  return {
    uuid: applicationNumber || "",
    applicationNumber: applicationNumber || "",
    creditorBasicDetails: {
      uuid: creditorBasicDetailsUuid,
      debtorName: formData.step1?.debtorName || "",
      creditorName: formData.step1?.CreditorName || "",
      totalClaimAmount: parseFloat(formData.step1?.totalClaimAmount) || 0,
      debtDetails: formData.step1?.debtDetails || "",
      mutualCreditDetails: formData.step1?.mutualCreditDetails || "",
      status: "",
      isActive: isActive,
      isFinalSubmit: isFinalSubmit,
      identificationNumber: formData.step1?.identificationNumber || "",
      document: extractFileDetails(formData.step1?.identificationDocument, "Identification", formData.step1?.identificationType),
    },
    claimDetails: {
      uuid: claimDetailsUuid,
      securityInterestAmount: parseFloat(formData.step2?.securityInterestAmount) || 0,
      guaranteeAmount: parseFloat(formData.step2?.guaranteeAmount) || 0,
      guarantorName: formData.step2?.guarantorName || "",
      guarantorAddress: formData.step2?.guarantorAddress || "",
      creditorAddress: formData.step2?.creditorAddress || "",
      creditorEmail: formData.step2?.creditorEmail || "",
      beneficiaryName: formData.step2?.beneficiaryName || "",
      beneficiaryAddress: formData.step2?.beneficiaryAddress || "",
      corporateDebtorSecurityAmount: parseFloat(formData.step2?.corporateDebtorSecurityAmount) || 0,
      corporateDebtorGuaranteeAmount: parseFloat(formData.step2?.corporateDebtorGuaranteeAmount) || 0,
      principalBorrowerName: formData.step2?.principalBorrowerName || "",
      principalBorrowerAddress: formData.step2?.principalBorrowerAddress || "",
      bankAccountNumber: formData.step2?.accountNumber || "",
      bankIfscCode: formData.step2?.ifscCode || "",
      bankBranchName: formData.step2?.branchName || "",
      addressProofNumber: formData.step2?.addressProofNumber || "",
      document: extractFileDetails(formData.step2?.addressProofDocument, "Addressproof", formData.step2?.addressProofType),
    },
    signatoryDetails: {
      uuid: signatoryDetailsUuid,
      name: formData.step3?.signatoryName || "",
      position: formData.step3?.signatoryPosition || "",
      address: formData.step3?.signatoryAddress || "",
      document: extractFileDetails(formData.step3?.signatoryDocument, "Signature", "Signature"),
    },
  };
};

const getFileFieldsForStep = (stepNumber) => {
  switch (stepNumber) {
    case 1:
      return ["identificationDocument"];
    case 2:
      return ["addressProof"];
    case 3:
      return ["signatoryDocument"];
    default:
      return [];
  }
};

const processFileUploads = async (stepData, stepNumber) => {
  const fileFields = getFileFieldsForStep(stepNumber);
  const processedData = { ...stepData };

  for (const field of fileFields) {
    if (stepData[field] && stepData[field] instanceof File) {
      processedData[field] = {
        id: generateFileId(stepData[field]),
        name: stepData[field].name,
        size: stepData[field].size,
        type: stepData[field].type,
        uploadedAt: new Date().toISOString(),
      };
    } else if (stepData[field] && typeof stepData[field] === 'object' && stepData[field].name) {
      processedData[field] = { ...stepData[field] };
    }
  }

  return processedData;
};

const Stepper = ({ stepsConfig = [], formAllData }) => {
  const { id } = useParams();
  const isEditMode = !!id;
  const [currentStep, setCurrentStep] = useState(1);
  const [isConfirmed, setIsConfirmed] = useState(false);
  const [isComplete, setIsComplete] = useState(false);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [hasPreviewed, setHasPreviewed] = useState(false);
  const [formData, setFormData] = useState({});
  const [margins, setMargins] = useState({ marginLeft: 0, marginRight: 0 });
  const stepRef = useRef([]);
  const navigate = useNavigate();
  const [currentSubmitHandler, setCurrentSubmitHandler] = useState(null);
  const [showModal, setShowModal] = useState(false);
  const [comments, setComments] = useState("");
  const [actionType, setActionType] = useState("");
  const [isSavingDraft, setIsSavingDraft] = useState(false);
  const [draftResponse, setDraftResponse] = useState(null);
  const [isSubmittingAction, setIsSubmittingAction] = useState(false);

  const {
    registrationData,
    handleStepDataFetch,
    updateRegistrationData,
    handleApplicatioNFormView,
    isDataLoaded,
  } = useRegistration();

  const userFormData = JSON.parse(localStorage.getItem("userFormData"));
  const isCRPUser = userFormData?.userType === "CRP";

  const filteredStepsConfig = useMemo(() => {
    if (isCRPUser) {
      return stepsConfig.filter((step) => step.name !== "Review & Submit");
    }
    return stepsConfig;
  }, [stepsConfig, isCRPUser]);

  useEffect(() => {
    if (id) {
      handleApplicatioNFormView({ uuid: id });
    }
  }, [id]);

  useEffect(() => {
    if (isEditMode && registrationData && !deepEqual(formData, registrationData)) {
      setFormData(registrationData);
    }
  }, [isEditMode, registrationData, formData]);

  useEffect(() => {
    const savedIsConfirmed = localStorage.getItem("isConfirmed");
    if (savedIsConfirmed) {
      setIsConfirmed(JSON.parse(savedIsConfirmed));
    }
  }, []);

  useEffect(() => {
    localStorage.setItem("isConfirmed", JSON.stringify(isConfirmed));
  }, [isConfirmed]);

  useEffect(() => {
    const newSubmitHandler = filteredStepsConfig[currentStep - 1]?.submitHandler;
    if (newSubmitHandler && newSubmitHandler !== currentSubmitHandler) {
      setCurrentSubmitHandler(() => newSubmitHandler);
    }
  }, [currentStep, filteredStepsConfig]);

  const updateSubmitHandler = useCallback((submitHandler) => {
    setCurrentSubmitHandler(() => submitHandler);
  }, []);

  useEffect(() => {
    if (stepRef.current.length > 0) {
      const firstStep = stepRef.current[0]?.offsetWidth || 0;
      const lastStep = stepRef.current[filteredStepsConfig.length - 1]?.offsetWidth || 0;
      setMargins({
        marginLeft: firstStep / 2,
        marginRight: lastStep / 2,
      });
    }
  }, [filteredStepsConfig.length]);

  const validateStepData = (step, data) => {
    const requiredFields = filteredStepsConfig[step - 1]?.requiredFields || [];
    for (let field of requiredFields) {
      if (!data[field]) {
        toast.error(`${field} is required.`);
        return false;
      }
    }
    return true;
  };

  const handleNext = async () => {
    if (!currentSubmitHandler) {
      console.error("No submit handler available.");
      return;
    }

    const currentStepData = await currentSubmitHandler();
    if (!currentStepData) {
      console.error("Form validation failed.");
      return;
    }

    if (!validateStepData(currentStep, currentStepData)) {
      return;
    }

    const processedStepData = await processFileUploads(currentStepData, currentStep);

    const updatedFormData = {
      ...formData,
      [`step${currentStep}`]: { ...formData[`step${currentStep}`], ...processedStepData },
    };

    if (!deepEqual(updatedFormData, formData)) {
      setFormData(updatedFormData);
      updateRegistrationData(`step${currentStep}`, updatedFormData[`step${currentStep}`], id);
    }

    if (currentStep === filteredStepsConfig.length) {
      try {
        setIsSavingDraft(true);
        
        const lastDraftResponse = draftResponse || JSON.parse(localStorage.getItem("draftResponse") || "null");
        
        if (!lastDraftResponse) {
          throw new Error("No draft data found. Please save a draft first.");
        }

        const finalSubmitPayload = {
          ...lastDraftResponse.data,
          applicationDetails: {
            ...lastDraftResponse.data.applicationDetails,
            creditorBasicDetails: {
              ...lastDraftResponse.data.applicationDetails.creditorBasicDetails,
              isFinalSubmit: true,
              isActive: true
            }
          }
        };

        const REQUEST = `${process.env.REACT_APP_APPLICATION_SERVICE}${URLS_ENDPOINT.APP_SERVICES.APPLICATION_FORMSUBMIT}`;
        const response = await postData(REQUEST, finalSubmitPayload);

        if (response.data.status.code === "200") {
          localStorage.removeItem("draftResponse");
          setDraftResponse(null);
          setIsComplete(true);
          toast.success("Form submitted successfully");
          navigate("/dashboard");
        } else {
          toast.error(`Failed to submit form: ${response.data.status.message}`);
        }
      } catch (error) {
        console.error("Error submitting form:", error);
        toast.error(error.message || "Failed to submit form");
      } finally {
        setIsSavingDraft(false);
      }
    } else {
      setCurrentStep((prevStep) => prevStep + 1);
    }
  };

  const handlePreview = async () => {
    if (!currentSubmitHandler) {
      console.error("No submit handler available.");
      return;
    }

    const currentStepData = await currentSubmitHandler();
    if (!currentStepData) {
      console.error("Form validation failed.");
      return;
    }

    if (!validateStepData(currentStep, currentStepData)) {
      return;
    }

    const processedStepData = await processFileUploads(currentStepData, currentStep);

    const updatedFormData = {
      ...formData,
      [`step${currentStep}`]: { ...formData[`step${currentStep}`], ...processedStepData },
    };

    if (!deepEqual(updatedFormData, formData)) {
      setFormData(updatedFormData);
      updateRegistrationData(`step${currentStep}`, updatedFormData[`step${currentStep}`], id);
    }

    setCurrentStep(filteredStepsConfig.length);
    setHasPreviewed(true);
  };

  const handleSaveDraft = async () => {
    setIsSavingDraft(true);
    try {
      const currentStepData = currentSubmitHandler ? await currentSubmitHandler() : {};
      const processedStepData = await processFileUploads(currentStepData, currentStep);

      const draftId = "";
      const creditorBasicDetailsUuid = formData.creditorBasicDetailsUuid || "";
      const claimDetailsUuid = formData.claimDetailsUuid || "";
      const signatoryDetailsUuid = formData.signatoryDetailsUuid || "";

      const draftData = {
        ...formData,
        creditorBasicDetailsUuid,
        claimDetailsUuid,
        signatoryDetailsUuid,
        [`step${currentStep}`]: {
          ...formData[`step${currentStep}`],
          ...processedStepData,
        },
        id: draftId,
        status: "draft",
        lastSaved: new Date().toISOString(),
        currentStep,
        formType: userFormData?.formType,
        userType: userFormData?.userType,
      };

      const draftPayload = {
        status: {
          code: "",
          message: ""
        },
        userInfo: userFormData?.fullloginDetails || {},
        applicationDetails: createFormPayload(draftData, false, userFormData, draftId, false),
      };

      const REQUEST = `${process.env.REACT_APP_APPLICATION_SERVICE}${URLS_ENDPOINT.APP_SERVICES.APPLICATION_FORMSUBMIT}`;
      const response = await postData(REQUEST, draftPayload);

      if (response.data.status.code === "200") {
        localStorage.setItem("draftResponse", JSON.stringify(response));
        setDraftResponse(response);
        setHasPreviewed(true);
        setFormData(prev => ({
          ...prev,
          creditorBasicDetailsUuid: response.data.applicationDetails.creditorBasicDetails.uuid,
          claimDetailsUuid: response.data.applicationDetails.claimDetails.uuid,
          signatoryDetailsUuid: response.data.applicationDetails.signatoryDetails.uuid,
          applicationNumber: response.data.applicationDetails.applicationNumber
        }));
        toast.success("Draft saved successfully");
      } else {
        toast.error(`Failed to save draft: ${response.status.message}`);
      }
    } catch (error) {
      console.error("Error saving draft:", error);
      toast.error("Failed to save draft");
    } finally {
      setIsSavingDraft(false);
    }
  };

  const handleWorkflowAction = async (action, comments) => {
    try {
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const applicationData = JSON.parse(localStorage.getItem("applicationdatawithid"));

      if (!userFormData || !userFormData.fullloginDetails) {
        throw new Error("User information not found");
      }

      if (!applicationData || !applicationData.applicationNumber) {
        throw new Error("Application data not found");
      }

      const payload = {
        userInfo: userFormData.fullloginDetails,
        applicationNumber: applicationData.applicationNumber,
        comments: comments,
        action: action
      };

      const response = await axios.post(
        `${process.env.REACT_APP_APPLICATION_SERVICE}/_workflow/_create`,
        payload,
        {
          headers: {
            'Content-Type': 'application/json'
          }
        }
      );

      return response.data;
    } catch (error) {
      console.error("Error in workflow action:", error);
      throw error;
    }
  };

  const handleActionSubmit = async () => {
    setIsSubmittingAction(true);
    try {
      const actionMap = {
        "Accept": "APPROVED",
        "Reject": "REJECTED",
        "Sendback To Claimants": "SEND_BACK_TO_CITIZEN",
        "Accept as Contingent": "APPROVED_AS_CONTINGENT"
      };

      const apiAction = actionMap[actionType];
      if (!apiAction) {
        throw new Error("Invalid action type");
      }

      const response = await handleWorkflowAction(apiAction, comments);
      
      if (response.status && response.status.code === "200") {
        toast.success(`${actionType} submitted successfully`);
        navigate("/dashboard");
      } else {
        toast.error(response.status?.message || "Action failed");
      }
    } catch (error) {
      console.error("Error submitting action:", error);
      toast.error(error.message || "Failed to submit action");
    } finally {
      setIsSubmittingAction(false);
      handleModalClose();
    }
  };

  const handleActionClick = (action) => {
    setActionType(action);
    setShowModal(true);
  };

  const handleModalClose = () => {
    setShowModal(false);
    setComments("");
  };

  const handlePrevious = () => {
    setCurrentStep((prevStep) => Math.max(1, prevStep - 1));
    setIsConfirmed(false);
    localStorage.removeItem("isConfirmed");
  };

  const handleCancel = () => {
    navigate("/dashboard");
  };

  const calculateProgressBarWidth = () => {
    return ((currentStep - 1) / (filteredStepsConfig.length - 1)) * 100;
  };

  const ActiveComponent = filteredStepsConfig[currentStep - 1]?.Component;
  const shouldRenderReviewStep = currentStep === filteredStepsConfig.length && isDataLoaded;

  const flattenFormData = (formData) => {
    const flattened = {
      ...formData.step1,
      ...formData.step2,
      ...formData.step3,
    };
    return flattened;
  };

  useEffect(() => {
    if (currentStep === 3) {
      setHasPreviewed(false);
    }
  }, [currentStep]);

  return (
    <FormDataProvider formData={flattenFormData(formData)}>
      <div className="stepper">
        {filteredStepsConfig.map((step, index) => (
          <div
            key={step.name}
            ref={(el) => (stepRef.current[index] = el)}
            className={`step ${
              currentStep > index + 1 || isComplete ? "complete" : ""
            } ${currentStep ===
