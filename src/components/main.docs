{col.actions?.includes("track") && (
  <OverlayTrigger overlay={<Tooltip>Track</Tooltip>}>
    <Button 
      variant="outline-primary" 
      size="sm" 
      onClick={() => handleTrack(row)}
      className="track-button"
      style={{ 
        transition: "all 0.3s",
        padding: "0.25rem"
      }}
    >
      <img 
        src={trackIcon} 
        alt="track" 
        style={{ 
          width: "16px", 
          height: "16px",
          filter: "brightness(0) saturate(100%) invert(35%) sepia(98%) saturate(1248%) hue-rotate(183deg) brightness(93%) contrast(96%)"
        }} 
      />
    </Button>
  </OverlayTrigger>
)}

/* For normal state */
.track-button img {
  filter: brightness(0) saturate(100%) invert(35%) sepia(98%) saturate(1248%) hue-rotate(183deg) brightness(93%) contrast(96%);
}

/* For hover state - makes icon white when button is hovered */
.track-button:hover img {
  filter: brightness(0) invert(1);
}
