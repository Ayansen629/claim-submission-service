/* Improved form layout styles */
.form-group {
  margin-bottom: 1.5rem;
}

.form-control {
  width: 100%;
  height: calc(2.25rem + 2px);
  padding: 0.375rem 0.75rem;
}

.form-label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 500;
}

/* Ensure two fields per row */
.two-col-layout .row {
  display: flex;
  flex-wrap: wrap;
  margin-right: -15px;
  margin-left: -15px;
}

.two-col-layout .col-md-6 {
  flex: 0 0 50%;
  max-width: 50%;
  padding-right: 15px;
  padding-left: 15px;
}

/* Radio group alignment */
.radio-group {
  display: flex;
  gap: 1rem;
}

.radio-option {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Error message alignment */
.invalid-feedback {
  display: block;
  margin-top: 0.25rem;
}

/* Section styling */
.form-section-container {
  margin-bottom: 2rem;
}

/* Entity fields styling */
.entity-field-group {
  margin-bottom: 1.5rem;
}

/* Buttons alignment */
.add-more-btn {
  margin-top: 1rem;
}





///////////////
// In the Claim Details section, wrap fields in two-col-layout
<div className="two-col-layout">
  <div className="row g-3">
    {/* Claim Type Dropdown - full width */}
    <div className="col-12">
      <div className="form-group">
        {/* ... existing claim type dropdown ... */}
      </div>
    </div>
    
    {/* Claim Type Specific Fields - will use their own layout */}
    {selectedClaimType && (
      <ClaimTypeFields
        claimType={selectedClaimType}
        control={control}
        register={register}
        errors={errors}
        setValue={setValue}
        getValues={getValues}
        watch={watch}
        trigger={trigger}
      />
    )}
    
    {/* Two-column fields for debt details */}
    <div className="col-md-6">
      <div className="form-group">
        <label className="form-label">
          <FaCalendarAlt className="field-icon me-2" />
          Date of debt incurred <span className="required-asterisk">*</span>
        </label>
        <input
          {...register("debtDate", {
            required: "This field is required",
            validate: (value) => {
              const today = new Date().toISOString().split("T")[0];
              return value <= today || "Date cannot be in the future";
            },
          })}
          type="date"
          className={`form-control ${errors.debtDate ? "is-invalid" : ""}`}
          placeholder="Select date"
        />
        {errors.debtDate && <div className="invalid-feedback">{errors.debtDate.message}</div>}
      </div>
    </div>
    
    {/* Add another field next to it */}
    <div className="col-md-6">
      <div className="form-group">
        <label className="form-label">
          <FaMoneyBillWave className="field-icon me-2" />
          Interest Rate (%)
        </label>
        <input
          {...register("interestRate", {
            min: { value: 0, message: "Cannot be negative" },
            max: { value: 100, message: "Cannot exceed 100%" }
          })}
          type="number"
          className={`form-control ${errors.interestRate ? "is-invalid" : ""}`}
          placeholder="Enter interest rate"
        />
        {errors.interestRate && <div className="invalid-feedback">{errors.interestRate.message}</div>}
      </div>
    </div>
  </div>
</div>
///////////////
// In ClaimTypeFields.js, modify the rendering of fields:
return (
  <div className="form-section two-col-layout">
    <div className="row g-3">
      {commonClaimFields.map((field) => (
        <div className="col-md-6" key={field.name}>
          <DynamicField
            fieldConfig={field}
            control={control}
            register={register}
            errors={errors}
            setValue={setValue}
            getValues={getValues}
            watch={watch}
          />
        </div>
      ))}

      {additionalFields.map((field) => (
        field.show !== false && (
          <div className="col-md-6" key={field.name}>
            <DynamicField
              fieldConfig={field}
              control={control}
              register={register}
              errors={errors}
              setValue={setValue}
              getValues={getValues}
              watch={watch}
            />
          </div>
        )
      ))}
    </div>

    {/* ... rest of the component remains the same ... */}
  </div>
);
