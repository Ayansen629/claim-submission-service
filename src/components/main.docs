import React from "react";
import { Container, Row, Col, Card, Badge } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { BsFileEarmarkPdf, BsCheckCircleFill } from "react-icons/bs";

const VesselRegistrationPreview = ({ formData, isPreview = true }) => {
  const { t } = useTranslation();

  const SectionCard = ({ title, children, icon }) => (
    <Card className="mb-4 shadow-sm border-0">
      <Card.Header className="bg-light border-0 py-3">
        <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
          {icon && <span className="me-2">{icon}</span>}
          {title}
        </h5>
      </Card.Header>
      <Card.Body className="p-4">
        {children}
      </Card.Body>
    </Card>
  );

  const InfoRow = ({ label, value }) => (
    <Row className="mb-3">
      <Col md={4}>
        <strong className="text-muted">{label}:</strong>
      </Col>
      <Col md={8}>
        <span className="text-dark">{value || "N/A"}</span>
      </Col>
    </Row>
  );

  const DocumentCard = ({ fileName, description, size }) => (
    <Card className="mb-2 border-0 shadow-sm">
      <Card.Body className="p-3">
        <div className="d-flex align-items-center">
          <div className="bg-danger bg-opacity-10 rounded-circle p-2 me-3">
            <BsFileEarmarkPdf className="text-danger" size={20} />
          </div>
          <div className="flex-grow-1">
            <h6 className="mb-1 text-primary fw-semibold" style={{ fontSize: "0.9rem" }}>
              {fileName}
            </h6>
            <p className="mb-0 text-muted small">
              {description}
              {size && <span className="ms-2 badge bg-light text-dark">{size}</span>}
            </p>
          </div>
        </div>
      </Card.Body>
    </Card>
  );

  // Get work order files from form data
  const getWorkOrderFiles = () => {
    const files = [];
    for (let i = 1; i <= 50; i++) {
      const file = formData[`workOrder_file_${i}`];
      const desc = formData[`workOrder_desc_${i}`];
      if (file && file.name) {
        files.push({
          name: file.name,
          description: desc || `Work order document ${i}`,
          size: file.size ? `${(file.size / 1024 / 1024).toFixed(1)} MB` : null
        });
      }
    }
    return files;
  };

  // Get drawing files from form data
  const getDrawingFiles = () => {
    const files = [];
    for (let i = 1; i <= 50; i++) {
      const file = formData[`drawings_file_${i}`];
      const desc = formData[`drawings_desc_${i}`];
      if (file && file.name) {
        files.push({
          name: file.name,
          description: desc || `Drawing document ${i}`,
          size: file.size ? `${(file.size / 1024 / 1024).toFixed(1)} MB` : null
        });
      }
    }
    return files;
  };

  const workOrderFiles = getWorkOrderFiles();
  const drawingFiles = getDrawingFiles();

  return (
    <Container fluid className="py-4" style={{ backgroundColor: "#f8f9fa" }}>
      <div className="mb-4 text-center">
        <h2 className="text-primary fw-bold">{t("Vessel Registration Preview")}</h2>
        <p className="text-muted">{t("Review all details before final submission")}</p>
      </div>

      {/* Owner Details */}
      <SectionCard title={t("Owner Details")} icon="👤">
        <Row>
          <Col md={6}>
            <InfoRow label={t("Name of Owner")} value={formData.ownerName} />
            <InfoRow label={t("Mobile")} value={formData.mobile} />
            <InfoRow label={t("PAN")} value={formData.pan} />
            <InfoRow label={t("Trade Licence")} value={formData.tradeLicence} />
          </Col>
          <Col md={6}>
            <InfoRow label={t("Address")} value={formData.ownerAddress} />
            <InfoRow label={t("Email")} value={formData.email} />
            <InfoRow label={t("Aadhar")} value={formData.aadhar} />
            <InfoRow label={t("GST")} value={formData.gst} />
          </Col>
        </Row>
      </SectionCard>

      {/* Vessel Details */}
      <SectionCard title={t("Vessel Details")} icon="🚢">
        <Row>
          <Col md={6}>
            <InfoRow label={t("Gross Tonnage (GRT)")} value={formData.grt} />
            <InfoRow label={t("Type of Vessel")} value={formData.vesselType === 'new' ? t('New Vessel') : t('Old Vessel')} />
            <InfoRow label={t("Zone")} value={formData.zone ? `Zone ${formData.zone}` : "N/A"} />
            <InfoRow label={t("Purchase Type")} value={formData.purchaseType === 'new' ? t('New') : t('Used')} />
          </Col>
          <Col md={6}>
            <InfoRow label={t("Work Order Value")} value={formData.workOrderValue ? `Rs. ${formData.workOrderValue}/-` : "N/A"} />
            <InfoRow label={t("Category")} value={formData.category ? `Category ${formData.category}` : "N/A"} />
            <InfoRow label={t("Supervision Authority")} value={formData.supervisionAuthority === 'iwt' ? t('IWT') : t('Classification Society')} />
            <InfoRow label={t("Constructed By")} value={formData.constructedBy === '1' ? t('Self') : t('Builder')} />
          </Col>
        </Row>
        {formData.classificationSociety && (
          <InfoRow label={t("Classification Society")} value={formData.classificationSociety} />
        )}
      </SectionCard>

      {/* Builder Details - Only show if constructed by builder */}
      {formData.constructedBy === "2" && (
        <SectionCard title={t("Builder Details")} icon="🏗️">
          <Row>
            <Col md={6}>
              <InfoRow label={t("Builder Name")} value={formData.builderName} />
              <InfoRow label={t("Builder Email")} value={formData.builderEmail} />
              <InfoRow label={t("Trade Licence")} value={formData.builderTradeLicence} />
              <InfoRow label={t("Authorization Status")} value={
                formData.builderAuth === 'auth' ? (
                  <Badge bg="success" className="px-3 py-2">
                    <BsCheckCircleFill className="me-1" />
                    {t("Authorized")}
                  </Badge>
                ) : (
                  <Badge bg="danger" className="px-3 py-2">
                    {t("Rejected")}
                  </Badge>
                )
              } />
            </Col>
            <Col md={6}>
              <InfoRow label={t("Builder Address")} value={formData.builderAddress} />
              <InfoRow label={t("Mobile")} value={formData.builderMobile} />
              <InfoRow label={t("GST")} value={formData.builderGST} />
            </Col>
          </Row>
          {formData.authLetter && formData.authLetter.name && (
            <>
              <hr className="my-4" />
              <h6 className="text-primary mb-3">{t("Authorization Letter")}</h6>
              <DocumentCard
                fileName={formData.authLetter.name}
                description="Builder authorization document"
                size={formData.authLetter.size ? `${(formData.authLetter.size / 1024 / 1024).toFixed(1)} MB` : null}
              />
            </>
          )}
        </SectionCard>
      )}

      {/* Documents */}
      <SectionCard title={t("Documents Uploaded")} icon="📄">
        <Row>
          <Col md={6}>
            {workOrderFiles.length > 0 && (
              <>
                <h6 className="text-primary mb-3">{t("Work Order Files")} ({workOrderFiles.length})</h6>
                {workOrderFiles.map((file, index) => (
                  <DocumentCard
                    key={index}
                    fileName={file.name}
                    description={file.description}
                    size={file.size}
                  />
                ))}
              </>
            )}
            
            {formData.tonnageBooklets && formData.tonnageBooklets.name && (
              <>
                <h6 className="text-primary mb-3 mt-4">{t("Tonnage Booklets")}</h6>
                <DocumentCard
                  fileName={formData.tonnageBooklets.name}
                  description="Tonnage certification document"
                  size={formData.tonnageBooklets.size ? `${(formData.tonnageBooklets.size / 1024 / 1024).toFixed(1)} MB` : null}
                />
              </>
            )}
          </Col>
          <Col md={6}>
            {drawingFiles.length > 0 && (
              <>
                <h6 className="text-primary mb-3">{t("Drawing Files")} ({drawingFiles.length})</h6>
                {drawingFiles.map((file, index) => (
                  <DocumentCard
                    key={index}
                    fileName={file.name}
                    description={file.description}
                    size={file.size}
                  />
                ))}
              </>
            )}
            
            {formData.stabilityBooklets && formData.stabilityBooklets.name && (
              <>
                <h6 className="text-primary mb-3 mt-4">{t("Stability Booklets")}</h6>
                <DocumentCard
                  fileName={formData.stabilityBooklets.name}
                  description="Stability certification document"
                  size={formData.stabilityBooklets.size ? `${(formData.stabilityBooklets.size / 1024 / 1024).toFixed(1)} MB` : null}
                />
              </>
            )}
          </Col>
        </Row>
      </SectionCard>

      {/* Terms Acceptance */}
      {formData.termsAccepted && (
        <Card className="shadow-sm border-0">
          <Card.Body className="p-4 text-center">
            <div className="d-flex align-items-center justify-content-center">
              <BsCheckCircleFill className="text-success me-2" size={24} />
              <span className="fw-medium text-success">
                {t("Terms and conditions have been accepted")}
              </span>
            </div>
          </Card.Body>
        </Card>
      )}
    </Container>
  );
};

export default VesselRegistrationPreview;
