  //   if (!row?.registrationNo) {
  //     console.warn("Registration No is missing");
  //     return;
  //   }
  //   try {
  //     const URL =
  //       process.env.REACT_APP_BASE_URL +
  //       URLS_ENDPOINT.APP_SERVICES.REGISTRATION_SEARCH;
  //     const request = {
  //       registrationBook: [
  //         {
  //           registrationNo: row?.registrationNo,
  //         },
  //       ],
  //     };
  //     const response = await postData(URL, request);
  //     if (response?.data?.responseStatus?.status === "200") {
  //       const registrationResponses = response?.data?.iwtRegistrationResponses || [];
  //       if (registrationResponses?.length > 0) {
  //         setModalData(registrationResponses);
  //         setIsViewModalOpen(true);
  //       } else {
  //         toast.info(APP_MESSAGES.NO_DATA_FOUND, { position: "top-right" });
  //         console.warn("No registration data found");
