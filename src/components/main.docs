<Col md={4}>
  <div className="mb-3">
    <label className="form-label">{t("Insurance Valid Upto")}</label>
    <input
      type="date"
      className="form-control"
      {...register("insuranceValidUpto")}
      readOnly={isViewMode}
      disabled={isViewMode}
      style={{
        backgroundColor: isViewMode ? "#e9ecef" : "#ffffff",
        cursor: isViewMode ? "not-allowed" : "pointer",
      }}
    />
    {errors.insuranceValidUpto && (
      <div className="text-danger small">
        {errors.insuranceValidUpto.message}
      </div>
    )}
  </div>
</Col>
