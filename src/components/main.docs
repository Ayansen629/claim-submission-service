import React, { useState, useContext, useEffect } from "react";
import { useForm } from "react-hook-form";
import { useNavigate } from "react-router-dom";
import { toast } from "react-toastify";
import FormInputRenderer from "../../common/FormInputRenderer";
import { UserContext } from "../../components/context/UserContext.js"; // Import UserContext
import "./Login.css";

const LoginPage = () => {
  const {
    register,
    handleSubmit,
    watch,
    formState: { errors },
    setValue,
    reset,
  } = useForm();
  const navigate = useNavigate();
  const { setUserData } = useContext(UserContext); // Use context to set user data

  const [otpSent, setOtpSent] = useState(false);
  const [otpVerified, setOtpVerified] = useState(false);
  const [otp, setOtp] = useState("");
  const [loading, setLoading] = useState(false);
  const [selectedRadio, setSelectedRadio] = useState("corporator"); // Default to "corporator"

  const username = watch("username");
  const userType = watch("userType");
  const financialCreditorType = watch("financialCreditorType");
  const operationalCreditorType = watch("operationalCreditorType");

  // Reset form fields when radio button changes
  useEffect(() => {
    reset({
      username: "",
      userType: "",
      financialCreditorType: "",
      operationalCreditorType: "",
    });
    setOtpSent(false);
    setOtp("");
  }, [selectedRadio, reset]);

  const isValidUsername = (username) => {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const mobileRegex = /^[6-9]\d{9}$/;
    return emailRegex.test(username) || mobileRegex.test(username);
  };

  // Check if all required fields are filled for Claimants
  const isClaimantsFormValid = () => {
    if (selectedRadio === "claimants") {
      if (!isValidUsername(username) || !userType) return false;

      if (userType === "Financial Creditors" && !financialCreditorType) return false;
      if (userType === "Operational Creditors" && !operationalCreditorType) return false;

      return true;
    }
    return false;
  };

  // Check if all required fields are filled for Corporators
  const isCorporatorsFormValid = () => {
    if (selectedRadio === "corporator") {
      return isValidUsername(username) && !!userType;
    }
    return false;
  };

  // Function to simulate sending OTP
  const handleSendOTP = async () => {
    if ((selectedRadio === "claimants" && isClaimantsFormValid()) || (selectedRadio === "corporator" && isCorporatorsFormValid())) {
      setLoading(true);

      // Simulate API call delay
      setTimeout(() => {
        const payload = {
          userType: selectedRadio === "corporator" ? "CRP" : "CLM",
          userId: username,
          claimantType: userType || "",
          claimantCategoryType:
            selectedRadio === "claimants" && userType === "Financial Creditors"
              ? financialCreditorType
              : selectedRadio === "claimants" && userType === "Operational Creditors"
              ? operationalCreditorType
              : "",
          otp: "123456", // Static OTP
        };

        console.log("Payload for Send OTP:", payload);

        toast.success("OTP Sent", { position: "top-right" });
        setOtpSent(true);
        setLoading(false);
      }, 1000);
    } else {
      toast.error("Please provide valid details.");
    }
  };

  // Function to simulate OTP verification
  // const handleVerifyOTP = async (data) => {
  //   if (!otp) {
  //     toast.error("Please enter your OTP first.", { position: "top-right" });
  //     return;
  //   }
  //   if (!data.termsAccepted) {
  //     toast.info("Please accept the terms and conditions.", {
  //       position: "top-right",
  //     });
  //     return;
  //   }

  //   setLoading(true);

  //   // Simulate API call delay
  //   setTimeout(() => {
  //     if (otp === "123456") {
  //       const payload = {
  //         userType: selectedRadio === "corporator" ? "CRP" : "CLM",
  //         userId: username,
  //         claimantType: userType || "",
  //         claimantCategoryType:
  //           selectedRadio === "claimants" && userType === "Financial Creditors"
  //             ? financialCreditorType
  //             : selectedRadio === "claimants" && userType === "Operational Creditors"
  //             ? operationalCreditorType
  //             : "",
  //         otp: otp,
  //       };

  //       console.log("Payload for Verify OTP:", payload);

  //       // Save user data in context
  //       setUserData({
  //         userType: payload.userType,
  //         userId: payload.userId,
  //         claimantType: payload.claimantType,
  //         claimantCategoryType: payload.claimantCategoryType,
  //       });

  //       toast.success("OTP Verified Successfully", { position: "top-right" });

  //       // Navigate to dashboard
  //       setTimeout(() => {
  //         navigate("/dashboard");
  //       }, 1000);
  //     } else {
  //       toast.error("Failed to verify OTP. Please try again.", {
  //         position: "top-right",
  //       });
  //     }
  //     setLoading(false);
  //   }, 1000);
  // };


  const handleVerifyOTP = async (data) => {
    if (!otp) {
      toast.error("Please enter your OTP first.", { position: "top-right" });
      return;
    }
    if (!data.termsAccepted) {
      toast.info("Please accept the terms and conditions.", {
        position: "top-right",
      });
      return;
    }
  
    setLoading(true);
  
    // Simulate API call delay
    setTimeout(() => {
      if (otp === "123456") {
        const payload = {
          userType: selectedRadio === "corporator" ? "CRP" : "CLM",
          userId: username,
          claimantType: userType || "",
          claimantCategoryType:
            selectedRadio === "claimants" && userType === "Financial Creditors"
              ? financialCreditorType
              : selectedRadio === "claimants" && userType === "Operational Creditors"
              ? operationalCreditorType
              : "",
          otp: otp,
        };
  
        console.log("Payload for Verify OTP:", payload);
  
        // Save user data in context
        setUserData({
          userType: payload.userType,
          userId: payload.userId,
          claimantType: payload.claimantType,
          claimantCategoryType: payload.claimantCategoryType,
        });
  
        // Save form data to localStorage
        localStorage.setItem("userFormData", JSON.stringify(payload));
  
        toast.success("OTP Verified Successfully", { position: "top-right" });
  
        // Navigate to dashboard
        setTimeout(() => {
          navigate("/dashboard");
        }, 1000);
      } else {
        toast.error("Failed to verify OTP. Please try again.", {
          position: "top-right",
        });
      }
      setLoading(false);
    }, 1000);
  };
  const corporatorOptions = [
    { value: "IRP", label: "IRP" },
    { value: "RP", label: "RP" },
    { value: "Liquidator", label: "Liquidator" },
    { value: "Bankruptcy Trustee", label: "Bankruptcy Trustee" },
  ];

  const claimantsOptions = [
    { value: "Financial Creditors", label: "Financial Creditors" },
    { value: "Operational Creditors", label: "Operational Creditors" },
    { value: "Employees and Workmen", label: "Employees and Workmen" },
    {
      value: "Employees and Workmen – Through Authorised Representative",
      label: "Employees and Workmen – Through Authorised Representative",
    },
    {
      value: "Other Creditors (other than financial and operational creditors)",
      label: "Other Creditors (other than financial and operational creditors)",
    },
  ];

  const financialCreditorOptions = [
    {
      value: "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)",
      label: "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)",
    },
    {
      value: "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)",
      label: "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)",
    },
    {
      value: "Unsecured Financial Creditors in Class of Creditors (Homebuyers)",
      label: "Unsecured Financial Creditors in Class of Creditors (Homebuyers)",
    },
    {
      value: "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)",
      label: "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)",
    },
  ];

  const operationalCreditorOptions = [
    {
      value: "Operational Creditors – (Other than Govt Authorities)",
      label: "Operational Creditors – (Other than Govt Authorities)",
    },
    {
      value: "Operational Creditors – Govt Authorities",
      label: "Operational Creditors – Govt Authorities",
    },
  ];

  const InputFields = [
    // {
    //   type: "text",
    //   name: "username",
    //   label: "User Id",
    //   placeholder: "Enter your user id or mobile number",
    // },
    ...(selectedRadio === "claimants"
      ? [
        {
          type: "text",
          name: "username",
          label: "User Id",
          placeholder: "Enter your user id or mobile number",
        },
        ]
      : []),
    ...(selectedRadio === "corporator"
      ? [
        {
          type: "text",
          name: "username",
          label: "User Id",
          placeholder: "Enter your user id ",
        },
        ]
      : []),
    ...(selectedRadio === "claimants"
      ? [
          {
            type: "dropdown",
            name: "userType",
            label: "Claimant Type",
            options: claimantsOptions,
          },
        ]
      : []),
    ...(selectedRadio === "corporator"
      ? [
          {
            type: "dropdown",
            name: "userType",
            label: "Corporator Type",
            options: corporatorOptions,
          },
        ]
      : []),
  ];

  return (
    <div className="login-page">
      <div className="login-container">
        <div className="Login-header">
          <div className="login-text">LOG IN</div>
        </div>
        <div className="radio-options">
          <div className="radio-op">
            <input
              type="radio"
              id="corporator"
              name="radioGroup"
              value="corporator"
              checked={selectedRadio === "corporator"}
              onChange={() => setSelectedRadio("corporator")}
            />
            <label htmlFor="corporator">Corporator</label>
          </div>
          <div className="radio-op">
            <input
              type="radio"
              id="claimants"
              name="radioGroup"
              value="claimants"
              checked={selectedRadio === "claimants"}
              onChange={() => setSelectedRadio("claimants")}
            />
            <label htmlFor="claimants">Claimants</label>
          </div>
        </div>
        <div className="login-form">
          <form onSubmit={handleSubmit(handleVerifyOTP)}>
            {InputFields.map((field) => (
              <div key={field.name}>
                <FormInputRenderer
                  field={field}
                  register={register}
                  errors={errors}
                  watch={watch}
                  setValue={setValue}
                />
              </div>
            ))}
            {selectedRadio === "claimants" && userType === "Financial Creditors" && (
              <div className="dropdown-container">
                <select
                  className="dropdown-select"
                  {...register("financialCreditorType", { required: true })}
                >
                  <option value="">Select Claimants Categories </option>
                  {financialCreditorOptions.map((option) => (
                    <option key={option.value} value={option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </div>
            )}

            {selectedRadio === "claimants" && userType === "Operational Creditors" && (
              <div className="dropdown-container">
                <select
                  className="dropdown-select"
                  {...register("operationalCreditorType", { required: true })}
                >
                  <option value="">Select Claimants Categories </option>
                  {operationalCreditorOptions.map((option) => (
                    <option key={option.value} value={option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </div>
            )}

            {!otpSent && (
              <button
                type="button"
                className={`send-otp-btn ${
                  (selectedRadio === "claimants" && isClaimantsFormValid()) ||
                  (selectedRadio === "corporator" && isCorporatorsFormValid())
                    ? ""
                    : "disabled"
                }`}
                onClick={handleSendOTP}
                disabled={
                  (selectedRadio === "claimants" && !isClaimantsFormValid()) ||
                  (selectedRadio === "corporator" && !isCorporatorsFormValid())
                }
              >
                Send OTP
              </button>
            )}

            {otpSent && !otpVerified && (
              <div className="otp-verification">
                <input
                  type="password"
                  placeholder="Enter OTP here..."
                  value={otp}
                  onChange={(e) => setOtp(e.target.value)}
                />
              </div>
            )}

            <div className="login-footer">
              <div className="terms-conditions">
                <input
                  type="checkbox"
                  id="termsAccepted"
                  {...register("termsAccepted", {
                    required: "You must accept the terms",
                  })}
                />
                <label htmlFor="termsAccepted">
                  I accept the{" "}
                  <a href="/terms-and-conditions">Terms & Conditions</a>
                </label>
              </div>
              <button
                type="submit"
                className="login-btn"
                disabled={!otp || loading || !watch("termsAccepted")}
              >
                {loading ? "Logging in..." : "Verify OTP & Login"}
              </button>
              {selectedRadio === "claimants" && (
                <div className="register-text" onClick={() => navigate("/register")}>
                  Don't have an account? <span className="register-link">Register here</span>
                </div>
              )}
            </div>
          </form>
        </div>
      </div>
    </div>
  );
};

export default LoginPage;

body {
  margin: 0;
  padding: 0;
  font-family: "Inter", sans-serif;
  overflow: hidden; 
}

.login-page {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  width: 100vw;
  /* background: linear-gradient(135deg, #09828d, #066b72);
   */
   /* background: #93b7c5; */
   background-image: url("../../assests/images/Backgroundlogin.jpg");
   /* background-size: cover;
  background-position: center;
  background-repeat: no-repeat; */
  padding: 20px;
  box-sizing: border-box;
}

.login-container {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 400px;
  padding: 20px;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0px 6px 30px rgba(0, 0, 0, 0.2);
  border-radius: 16px;
  animation: slideIn 0.5s ease-in-out;
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  overflow: hidden; 
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.Login-header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px; 
}

.login-text {
  font-size: 22px; 
  font-weight: 700;
  /* color: #09828d; */
  color: #269ccc;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* Radio Buttons */
.radio-options {
  display: flex;
  justify-content: space-between;
  padding: 8px;
  background: #f3f3f3;
  border-radius: 30px;
  margin-bottom: 10px; 
  gap: 8px;
}

.radio-op {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px 12px; 
  border-radius: 24px;
  cursor: pointer;
  flex: 1;
  transition: all 0.3s ease;
  text-align: center;
  font-size: 13px; 
  font-weight: 500;
  background: #f3f3f3;
}

.radio-op input[type="radio"] {
  display: none;
}

.radio-op label {
  width: 100%;
  cursor: pointer;
  text-align: center;
  color: #333;
}

.radio-op input[type="radio"]:checked + label {
  /* background-color: #09828d; */
  background-color: #269ccc;
  color: white;
  border-radius: 24px;
  padding: 6px; 
}

/* Login Form */
.login-form {
  width: 100%;
}

.user-input,
.otp-verification input,
.dropdown-select {
  width: 100%;
  padding: 8px;
  border: 2px solid #e6e6e6;
  border-radius: 8px;
  font-size: 13px; 
  outline: none;
  transition: border-color 0.3s ease;
  margin-bottom: 8px; 
  box-sizing: border-box;
}

.user-input:focus,
.otp-verification input:focus,
.dropdown-select:focus {
  /* border-color: #09828d; */
  border-color: #269ccc;
}

/* Dropdown Styles */
.dropdown-container {
  position: relative;
  margin-bottom: 8px; 
}

.dropdown-select {
  appearance: none;
  background: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%2309828D%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E")
    no-repeat right 8px center/10px 10px; 
  background-color: white;
  cursor: pointer;
}

/* Send OTP and Login Buttons */
.send-otp-btn,
.login-btn {
  width: 100%;
  padding: 8px; 
  border: none;
  border-radius: 8px;
  font-size: 13px; 
  font-weight: 600;
  color: white;
  /* background-color: #09828d; */
  background-color: #269ccc;
  cursor: pointer;
  transition: all 0.3s ease;
  margin-top: 8px; 
}

.send-otp-btn:hover,
.login-btn:hover {
  /* background-color: #066b72; */
  background-color: #269ccc;
  transform: scale(1.02);
}

.send-otp-btn:disabled,
.login-btn:disabled {
  background-color: #cccccc;
  cursor: not-allowed;
}

/* Terms & Conditions */
.terms-conditions {
  display: flex;
  align-items: center;
  font-size: 11px; 
  color: #333;
  margin: 8px 0; 
}

.terms-conditions input[type="checkbox"] {
  margin-right: 6px;
  /* accent-color: #09828d; */
  accent-color: #269ccc;
}

.terms-conditions a {
  /* color: #09828d; */
  color: #269ccc;
  text-decoration: none;
}

.terms-conditions a:hover {
  text-decoration: underline;
}

.register-text {
  font-size: 12px; 
  color: #333; 
  text-align: center; 
  margin-top: 10px; 
  cursor: pointer; 
  transition: color 0.3s ease; 
}

.register-text:hover {
  /* color: #09828d;  */
  color: #269ccc;
}

.register-link {
  /* color: #09828d; */
  color: #269ccc;
  font-weight: 600; 
  text-decoration: none; 
  transition: color 0.3s ease; 
}

.register-link:hover {
  text-decoration: underline; 
}

/* Responsive Adjustments */
@media (max-width: 768px) {
  .login-container {
    padding: 15px;
    max-width: 90%;
    margin: 0 auto;
    border-radius: 12px;
  }

  .login-text {
    font-size: 20px; 
  }

  .radio-options {
    flex-direction: column;
    gap: 8px;
    padding: 6px;
  }

  .radio-op {
    padding: 6px 10px; 
    font-size: 12px; 
  }

  .user-input,
  .otp-verification input,
  .dropdown-select {
    padding: 6px; 
    font-size: 12px; 
  }

  .send-otp-btn,
  .login-btn {
    padding: 6px; 
    font-size: 12px; 
  }

  .terms-conditions {
    font-size: 10px; 
  }
}

@media (max-width: 480px) {
  .login-container {
    padding: 10px;
    border-radius: 10px;
  }

  .login-text {
    font-size: 18px; 
  }

  .radio-op {
    padding: 5px 8px;
    font-size: 11px; 
  }

  .user-input,
  .otp-verification input,
  .dropdown-select {
    padding: 5px; 
    font-size: 11px; 
  }

  .send-otp-btn,
  .login-btn {
    padding: 5px; 
    font-size: 11px; 
  }

  .terms-conditions {
    font-size: 9px; 
  }
}
