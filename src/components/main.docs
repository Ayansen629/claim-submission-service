// Update the vessel registration section
<section className="vessel-registration py-5 bg-light">
  <Container fluid="xxl" className="px-4">
    <div className="section-header mb-5" style={{ textAlign: 'left', maxWidth: 'none' }}>
      <h2 className="section-title">Vessel Registration</h2>
      <p className="section-description">
        Lorem Ipsum is simply dummy text of the printing and typesetting industry...
      </p>
    </div>
    <Row className="align-items-stretch g-4">
      <Col xl={6} className="mb-4 mb-xl-0">
        <Row className="g-3 h-100">
          {vesselRegistrationItems.map((item, index) => (
            <Col md={6} key={index} className="d-flex">
              <Card className="h-100 service-card w-100">
                <Card.Body>
                  <div className="d-flex align-items-start h-100">
                    <div className="icon-container me-3">
                      <img 
                        src={item.icon} 
                        alt={item.title}
                        className="zoom-icon"
                      />
                    </div>
                    <div className="content-wrapper">
                      <h5 className="service-title">{item.title}</h5>
                      <p className="service-description">{item.description}</p>
                      <Button variant="link" className="service-link p-0">
                        <img 
                          src={Navigation} 
                          alt="Navigate" 
                          className="nav-icon"
                        />
                      </Button>
                    </div>
                  </div>
                </Card.Body>
              </Card>
            </Col>
          ))}
        </Row>
      </Col>
      <Col xl={6} className="d-flex">
        <div className="vessel-image-container w-100" style={{ maxHeight: '600px' }}>
          <img 
            src={Ship} 
            alt="IWT Ship" 
            className="img-fluid" 
            style={{ 
              objectFit: 'cover', 
              width: '100%',
              height: '100%',
              maxHeight: '600px',
              borderRadius: '10px'
            }} 
          />
        </div>
      </Col>
    </Row>
  </Container>
</section>

// Update the vessel survey section similarly
<section className="vessel-survey py-5">
  <Container fluid="xxl" className="px-4">
    <div className="section-header mb-5" style={{ textAlign: 'left', maxWidth: 'none' }}>
      <h2 className="section-title">Vessel Survey</h2>
      <p className="section-description">
        Lorem Ipsum is simply dummy text of the printing and typesetting industry...
      </p>
    </div>
    <Row className="align-items-stretch g-4">
      <Col lg={6} className="order-lg-2 mb-4 mb-lg-0">
        <Row className="g-3 h-100">
          {vesselSurveyItems.map((item, index) => (
            <Col md={6} key={index} className="d-flex">
              <Card className="h-100 service-card w-100">
                <Card.Body>
                  <div className="d-flex align-items-start h-100">
                    <div className="service-icon me-3">
                      <img src={item.icon} alt={item.title} className="img-fluid" />
                    </div>
                    <div className="content-wrapper">
                      <h5 className="service-title">{item.title}</h5>
                      <p className="service-description">{item.description}</p>
                      <Button variant="link" className="service-link p-0">
                        <img src={Navigation} alt="Navigate" className="img-fluid" />
                      </Button>
                    </div>
                  </div>
                </Card.Body>
              </Card>
            </Col>
          ))}
        </Row>
      </Col>
      <Col lg={6} className="order-lg-1 d-flex">
        <div className="survey-image-container w-100" style={{ maxHeight: '600px' }}>
          <img 
            src={Tower} 
            alt="Survey Tower" 
            className="img-fluid" 
            style={{ 
              objectFit: 'cover',
              width: '100%',
              height: '100%',
              maxHeight: '600px',
              borderRadius: '10px'
            }} 
          />
        </div>
      </Col>
    </Row>
  </Container>
</section>

// Update the social feed section to add gap between LinkedIn and Instagram
<Card className="social-card h-100 shadow-sm">
  <Card.Body className="p-4 d-flex flex-column">
    <Row className="h-100">
      <Col md={6} className="pe-md-4 mb-4 mb-md-0" style={{ borderRight: '1px solid #dee2e6' }}>
        <div className="d-flex justify-content-between align-items-center mb-4">
          <div className="d-flex align-items-center">
            <img
              src={Linkedin}
              alt="Linkedin"
              className="social-icon me-3"
            />
            <h5 className="mb-0">LinkedIn</h5>
          </div>
          <a href="#" className="text-primary">See All</a>
        </div>
        <div className="social-post">
          <p>Latest updates from our LinkedIn page will appear here.</p>
        </div>
      </Col>
      <Col md={6} className="ps-md-4">
        <div className="d-flex justify-content-between align-items-center mb-4">
          <div className="d-flex align-items-center">
            <img
              src={Instagram}
              alt="Instagram"
              className="social-icon me-3"
            />
            <h5 className="mb-0">Instagram</h5>
          </div>
          <a href="#" className="text-primary">See All</a>
        </div>
        <div className="social-post">
          <p>Our Instagram feed will be displayed here.</p>
        </div>
      </Col>
    </Row>
  </Card.Body>
</Card>
/////////////////
.service-icon {
  width: 50px;
  height: 50px;
  min-width: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f7ff;
  border-radius: 8px;
  padding: 10px;
}

.service-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.content-wrapper {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.service-link {
  margin-top: auto;
}
