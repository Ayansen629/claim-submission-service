// Remove validateBookForm function and update handleFormSubmit:
const handleFormSubmit = async (stepInfo) => {
  window.scrollTo({ top: 0, behavior: "smooth" });

  // Step 1: Initial Survey Form
  if (stepInfo.index === 0) {
    const formValues = stepInfo?.getFormData?.() || {};
    const surveyPayload = buildSurveyPayload(formValues, registrationData);
    submitIntialSurveyData(surveyPayload, stepInfo);
  }

  // Step 2: Equipment Form
  if (stepInfo.index === 1) {
    const formValues = stepInfo?.getFormData?.() || {};
    const equipmentPayload = buildEquipmentPayload(formValues, intialSurveyData);
    if (isOfficerLogin && isViewMode) {
      await submitIntialSurveyData(equipmentPayload, null);
      return;
    }
    submitIntialSurveyData(equipmentPayload, stepInfo);
  }

  // Step 3: Book of registration - No validation
  if (stepInfo.index === 2) {
    const success = await handleBookOfRegistrationSubmit();
    if (success) {
      stepperRef.current?.goToNextStep();
      handleProvisionModalOpen("registration", false);
    }
  }

  // Step 4: Certificate of Registration  
  if (stepInfo.index === 3) {
    const formValues = stepInfo?.getFormData?.() || {};
    console.log("=== CERTIFICATE PAYLOAD ===", formValues);
    stepperRef.current?.goToNextStep();
  }
};

// Update getSteps to remove validation:
baseSteps.push({
  label: t("Book of Registration"),
  component: (
    <BookOfRegistrationForm
      formMethods={methods}
      viewMode={isOfficerLogin ? false : isViewMode}
      registrationData={registrationData}
      intialSurveyData={intialSurveyData}
      originalRegistrationData={originalRegistrationData}
    />
  ),
  validate: () => true, // No validation
  getFormData: () => methods?.getValues(),
  showSavaAndNextButton: true,
});
