import React, { useState, useEffect, useRef } from "react";
import { 
  ArrowUp, 
  FileEarmarkText, 
  Clock, 
  CheckCircle, 
  PersonCheck
} from 'react-bootstrap-icons';
import { Container, ProgressBar, Row, Card, Col, Button, Modal, Form, InputGroup } from "react-bootstrap";
import { 
  FaChartLine, 
  FaClipboardList, 
  FaFileAlt, 
  FaUserCircle, 
  FaSearch, 
  FaFilter, 
  FaEllipsisV,
  FaCheckCircle,
  FaClock,
  FaTimesCircle,
  FaFileInvoice,
  FaPlus,
  FaChevronUp,
  FaChevronDown,
  FaBell,
  FaCalendarAlt,
  FaArrowUp,
  FaArrowDown,
  FaTrashAlt,
  FaSortAmountDown,
  FaSortAmountUp,
  FaEye
} from "react-icons/fa";
import "./DashboardMain.css";
import ActionTable from "./ActionTable.js";
import { useNavigate, useLocation } from "react-router-dom";
import axios from "axios";
import { toast } from "react-toastify";
import { APP_MESSAGES } from "../../../utils/constants.ts";
import { URLS_ENDPOINT } from "../../../utils/urlsConstants.ts";
import { postData } from "../../../services/http.service.ts";
import ApplicationDetailsView from "./ApplicationDetailsView.jsx";
import TrackingModal from "./TrackingModal.jsx";
import { useSearch } from "../Navbar";

// Add custom color scheme
const customColors = {
  blue: "#009cff",
  green: "#1bbc85",
  orange: "#ff7a03",
  yellow: "#d4cd18"
};

// Add custom CSS to document head
const injectCustomStyles = () => {
  const styleElement = document.createElement('style');
  styleElement.textContent = `
    /* Custom card colors */
    .stat-card-modern.stat-card-blue {
      background-color: ${customColors.blue};
    }
    .stat-card-modern.stat-card-orange {
      background-color: ${customColors.orange};
    }
    .stat-card-modern.stat-card-green {
      background-color: ${customColors.green};
    }
    .stat-card-modern.stat-card-yellow {
      background-color: ${customColors.yellow};
    }
    
    /* Table Row Styles */
    .table tbody tr:nth-child(even) {
      background-color: rgba(27, 188, 133, 0.05) !important;
    }
    
    .table tbody tr:nth-child(odd) {
      background-color: rgba(255, 204, 51, 0.05) !important;
    }
    
    /* Table Header Styles */
    .table-primary th {
      background-color: ${customColors.blue} !important;
      color: white !important;
      border-color: ${customColors.blue} !important;
    }
    
    /* Button Styles */
    .btn-primary {
      background-color: ${customColors.blue} !important;
      border-color: ${customColors.blue} !important;
    }
    
    .btn-outline-primary {
      color: ${customColors.blue} !important;
      border-color: ${customColors.blue} !important;
    }
    
    .btn-outline-primary:hover {
      background-color: ${customColors.blue} !important;
      color: white !important;
    }
  `;
  document.head.appendChild(styleElement);
  return styleElement;
};

const EnhancedDashboard = () => {
  const [isLoading, setIsLoading] = useState(true);
  const [rowData, setRowData] = useState([]);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [modalData, setModalData] = useState({});
  const [fullModelData, setFullModelData] = useState({});
  const [isTrackModalOpen, setIsTrackModalOpen] = useState(false);
  const [trackData, setTrackData] = useState({});
  const [downloading, setDownloading] = useState({});
  const [userName, setUserName] = useState('');
  const [userType, setUserType] = useState('');
  const [searchQuery, setSearchQuery] = useState('');
  const [statusFilter, setStatusFilter] = useState('all');
  const [dateSort, setDateSort] = useState('none');
  const [filteredData, setFilteredData] = useState([]);
  const navigate = useNavigate();
  const location = useLocation();
  
  // Ref for claims table section
  const claimsTableRef = useRef(null);

  // Inject custom styles
  useEffect(() => {
    const styleElement = injectCustomStyles();
    return () => {
      document.head.removeChild(styleElement);
    };
  }, []);

  // Function to scroll to claims table
  const scrollToClaimsTable = () => {
    if (claimsTableRef.current) {
      claimsTableRef.current.scrollIntoView({ 
        behavior: 'smooth',
        block: 'start'
      });
    }
  };

  // Get current date for greeting
  const getCurrentGreeting = () => {
    const hour = new Date().getHours();
    if (hour < 12) return "Good Morning";
    if (hour < 18) return "Good Afternoon";
    return "Good Evening";
  };

  // Updated stats data with new colors
  const statsData = [
    { 
      id: 1, 
      title: "Total Claims", 
      value: 24, 
      icon: <FileEarmarkText size={24} />, 
      color: customColors.blue,
      trend: "+12%",
      trendUp: true,
      className: "stat-card-blue"
    },
    { 
      id: 2, 
      title: "Pending Review", 
      value: 8, 
      icon: <Clock size={24} />, 
      color: customColors.orange,
      trend: "+3%",
      trendUp: true,
      className: "stat-card-orange"
    },
    { 
      id: 3, 
      title: "Approved", 
      value: 12, 
      icon: <CheckCircle size={24} />, 
      color: customColors.green,
      trend: "+8%",
      trendUp: true,
      className: "stat-card-green"
    },
    { 
      id: 4, 
      title: "Profile Completion", 
      value: "85%", 
      icon: <PersonCheck size={24} />, 
      color: customColors.yellow,
      trend: "+5%",
      trendUp: true,
      className: "stat-card-yellow",
      // showProgress: true
    }
  ];

  // Table columns configuration
  const columns = [
    {
      colName: "SL NO",
      fieldName: "slNo",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "SL NO",
      minWidth: "5rem",
    },
    {
      colName: "Claim Number",
      fieldName: "claimNumber",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Claim Number",
      minWidth: "10rem",
    },
    {
      colName: "Claimant",
      fieldName: "claimant",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Claimant",
      minWidth: "10rem",
    },
    {
      colName: "Status",
      fieldName: "status",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Status",
      minWidth: "10rem",
    },
    {
      colName: "Amount",
      fieldName: "amount",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Amount",
      minWidth: "10rem",
    },
    {
      colName: "Date Submitted",
      fieldName: "dateSubmitted",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Date Submitted",
      minWidth: "10rem",
    },
    {
      colName: "Action",
      fieldName: "action",
      actions: ["view", "edit", "track", "delete"],
      clsName: "col-sm-2 column-text-start actions-column",
    },
  ];

  useEffect(() => {
    // Get user data from localStorage
    try {
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;
      
      // Set user type
      if (userFormData?.userType) {
        setUserType(userFormData.userType);
      }
      
      // Set user name
      if (userInfo?.name) {
        setUserName(userInfo.name);
      } else if (userFormData?.userDetails?.claimantName) {
        setUserName(userFormData.userDetails.claimantName);
      } else if (userFormData?.userDetails?.companyName) {
        setUserName(userFormData.userDetails.companyName);
      }
    } catch (error) {
      console.error("Error getting user info:", error);
    }

    // Fetch dashboard data
    fetchDashboardData();
  }, []);

  // Listen for search query changes from URL or navbar
  useEffect(() => {
    // Check URL for search parameter
    const params = new URLSearchParams(location.search);
    const searchParam = params.get('search');
    
    if (searchParam) {
      setSearchQuery(searchParam);
      // Scroll to claims table when search is performed
      setTimeout(() => {
        scrollToClaimsTable();
      }, 500);
    }
    
    // Listen for search events from navbar
    const handleSearchEvent = (event) => {
      if (event.detail && event.detail.searchQuery !== undefined) {
        setSearchQuery(event.detail.searchQuery);
        // Scroll to claims table when search is performed
        setTimeout(() => {
          scrollToClaimsTable();
        }, 500);
      }
    };
    
    window.addEventListener('searchQueryChange', handleSearchEvent);
    
    // Check sessionStorage for search query (for persistence)
    const storedQuery = sessionStorage.getItem('searchQuery');
    if (storedQuery && !searchParam) {
      setSearchQuery(storedQuery);
    }
    
    return () => {
      window.removeEventListener('searchQueryChange', handleSearchEvent);
    };
  }, [location.search]);

  // Check if user is CRP (Corporate Representative)
  const isCRP = userType === "CRP";

  // Quick actions data - Conditional based on user type
  const getQuickActions = () => {
    if (isCRP) {
      // For CRP users - no new claim option
      return [
        {
          id: 1,
          title: "View Claims",
          description: "Review submitted claims",
          icon: <FaEye />,
          action: scrollToClaimsTable // Scroll to claims table instead of navigating
        },
        {
          id: 2,
          title: "Update Profile",
          description: "Edit your account information",
          icon: <FaUserCircle />,
          action: () => navigate("/my-profile")
        }
      ];
    } else {
      // For CLM users - with new claim option
      return [
        {
          id: 1,
          title: "New Claim",
          description: "Submit a new claim application",
          icon: <FaPlus />,
          action: () => navigate("/apply-claim")
        },
        {
          id: 2,
          title: "Update Profile",
          description: "Edit your account information",
          icon: <FaUserCircle />,
          action: () => navigate("/my-profile")
        }
      ];
    }
  };

  // Filter and search data
  useEffect(() => {
    if (rowData.length > 0) {
      let filtered = [...rowData];
      
      // Apply status filter
      if (statusFilter !== 'all') {
        filtered = filtered.filter(item => item.status === statusFilter);
      }
      
      // Apply search query
      if (searchQuery.trim() !== '') {
        const query = searchQuery.toLowerCase();
        filtered = filtered.filter(item => {
          return (
            (item.claimNumber && item.claimNumber.toLowerCase().includes(query)) ||
            (item.claimant && item.claimant.toLowerCase().includes(query)) ||
            (item.status && item.status.toLowerCase().includes(query))
          );
        });
        
        // If we have search results and they're from a navbar search, scroll to the table
        if (filtered.length > 0) {
          setTimeout(() => {
            scrollToClaimsTable();
          }, 500);
        }
      }
      
      // Apply date sorting
      if (dateSort !== 'none') {
        filtered.sort((a, b) => {
          const dateA = new Date(a.dateSubmitted);
          const dateB = new Date(b.dateSubmitted);
          return dateSort === 'asc' ? dateA - dateB : dateB - dateA;
        });
      }
      
      setFilteredData(filtered);
    } else {
      setFilteredData([]);
    }
  }, [rowData, statusFilter, searchQuery, dateSort]);

  const handleDownload = async (fileId, fileName) => {
    try {
      setDownloading(prev => ({ ...prev, [fileId]: true }));
      
      const response = await axios.get(
        `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileId}`,
      );
  
      // Create download link
      const url = window.URL.createObjectURL(new Blob([response.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', fileName || 'document');
      document.body.appendChild(link);
      link.click();
      link.remove();
      
    } catch (error) {
      console.error('Error downloading file:', error);
      toast.error('Failed to download document', { position: "top-right" });
    } finally {
      setDownloading(prev => ({ ...prev, [fileId]: false }));
    }
  };

  const handleEditRow = (row) => {
    console.log("Edit row:", row.uuid);
    if (row?.uuid) {
      navigate(`/apply-claim/edit/${row.uuid}`);
    } else {
      console.error("UUID not found in the row object.");
      toast.warning("No UUID Available..", { position: "top-right" });
    }
  };

  const handleDeleteRow = (row) => {
    console.log("Delete row:", row.uuid);
    // Implement delete functionality here
    toast.warning("Delete functionality will be implemented soon", { position: "top-right" });
  };

  const formatFileInfo = (document) => {
    if (!document) return "N/A";
    return `${document.docType || 'Document'} (${document.docName || 'No name'})`;
  };

  const transformApplicationData = (application) => {
    console.log("Transforming application data...",application);
    if (!application) return null;

    const basicDetails = application.creditorBasicDetails || {};
    const claimDetails = application.claimDetails || {};
    const signatoryDetails = application.signatoryDetails || {};

    return {
      applicationNumber: application.applicationNumber,
      step1: {
        creditorDetails: {
          "Debtor Name": basicDetails.debtorName,
          "Creditor Name": basicDetails.creditorName,
          "Total Claim Amount": basicDetails.totalClaimAmount,
          "Debt Details": basicDetails.debtDetails,
          "Mutual Credit Details": basicDetails.mutualCreditDetails,
        },
        identificationDetails: {
          "Identification Type": basicDetails.document?.docType,
          "Identification Number": basicDetails.identificationNumber,
          "Document Name": formatFileInfo(basicDetails.document),
        },
      },
      step2: {
        financialDetails: {
          "Security Interest Amount": claimDetails.securityInterestAmount,
          "Guarantee Amount": claimDetails.guaranteeAmount,
          "Guarantor Name": claimDetails.guarantorName,
          "Guarantor Address": claimDetails.guarantorAddress,
          "Creditor Address": claimDetails.creditorAddress,
          "Creditor Email": claimDetails.creditorEmail,
          "Principal Borrower Name": claimDetails.principalBorrowerName,
          "Principal Borrower Address": claimDetails.principalBorrowerAddress,
        },
        beneficiaryDetails: {
          "Beneficiary Name": claimDetails.beneficiaryName,
          "Beneficiary Address": claimDetails.beneficiaryAddress,
          "Corporate Debtor Security Amount": claimDetails.corporateDebtorSecurityAmount,
          "Corporate Debtor Guarantee Amount": claimDetails.corporateDebtorGuaranteeAmount,
        },
        addressproofDetails: {
          "Address Proof Type": claimDetails.document?.docType,
          "Address Proof Number": claimDetails.addressProofNumber,
          "Address Proof Document": formatFileInfo(claimDetails.document),
        },
        bankDetails: {
          "Account Number": claimDetails.bankAccountNumber,
          "IFSC Code": claimDetails.bankIfscCode,
          "Branch Name": claimDetails.bankBranchName,
        },
      },
      step3: {
        signatoryDetails: {
          "Signatory Name": signatoryDetails.name,
          "Signatory Position": signatoryDetails.position,
          "Signatory Address": signatoryDetails.address,
          "Signatory Document": formatFileInfo(signatoryDetails.document),
        },
      },
      status: application.applicationStatus,
    };
  };

  const handleOnViewRow = async (row) => {
    try {
      setIsLoading(true);
      
      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;
      
      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }
  
      const payload = {
        userInfo: userInfo,
        uuids: [row.uuid],
        applicationNumbers: [],
        claimantUUIDs: []
      };
  
      const URL =
        process.env.REACT_APP_APPLICATION_SERVICE +
        URLS_ENDPOINT.APP_SERVICES.APPLICATION_VIEW_ID;
  
      const response = await postData(URL, payload);
      
      if (response?.data?.status?.code === "200" && response?.data?.applicationDetails?.length > 0) {
        const transformedData = transformApplicationData(response.data.applicationDetails[0]);
        setFullModelData(response.data.applicationDetails[0])
        setModalData(transformedData);
        setIsViewModalOpen(true);
      } else {
        toast.error("No application details found", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching application details:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
    } finally {
      setIsLoading(false);
    }
  };

  const getStatusDescription = (stage) => {
    if (stage.submittedBy === "CLAIMANT" && stage.submittedTo === "RP") {
      return `Submitted by claimant ${stage.submittedByName} to RP ${stage.submittedToName}`;
    } else if (stage.submittedBy === "RP" && stage.submittedTo === "CLAIMANT") {
      return `Sent back by RP ${stage.submittedByName} to claimant ${stage.submittedToName}`;
    } else if (stage.submittedBy === "RP" && !stage.submittedTo) {
      return `Final decision by RP ${stage.submittedByName}: ${stage.applicationStatus}`;
    }
    return stage.applicationStatus;
  };

  const handleTrackRow = async (row) => {
    try {
      setIsLoading(true);
      
      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;
      
      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }
  
      const payload = {
        userInfo: userInfo,
        trackingCriteria: {
          applicationNumber: row.claimNumber
        }
      };
  
      const URL = `${process.env.REACT_APP_APPLICATION_SERVICE}_tracking/_getApplicationTrackingDetails`;
      
      const response = await postData(URL, payload);
      
      if (response?.data.status === "200") {
        setTrackData({
          applicationNumber: response.data.applicationNumber,
          trackingSteps: response.data.applicationStages.map(stage => ({
            step: stage.applicationStatus,
            description: getStatusDescription(stage),
            date: stage.submittedDate,
            isCurrentStatus: stage.isCurrentStatus,
            submittedBy: stage.submittedByName,
            submittedTo: stage.submittedToName,
            comments: stage.comments
          }))
        });
        setIsTrackModalOpen(true);
      } else {
        toast.error("Failed to fetch tracking details", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching tracking details:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
    } finally {
      setIsLoading(false);
    }
  };

  const fetchDashboardData = async () => {
    try {
      setIsLoading(true);
      
      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;
      
      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }

      const payload = {
        userInfo: userInfo,
        filterCriteria: {}
      };

      const URL =
          process.env.REACT_APP_APPLICATION_SERVICE +
          URLS_ENDPOINT.APP_SERVICES.DASHBOARD_LIST;

      const response = await postData(URL, payload);
      
      if (response?.data.status === "200" && response?.data.dashboardApplications?.length > 0) {
        // Format the data to match your table structure
        const formattedData = response.data.dashboardApplications.map((item, index) => ({
          ...item,
          id: item.uuid, 
          slNo: index + 1,
          claimNumber: item.applicationNumber,
          claimant: item.creditorName,
          status: item.applicationStatus,
          amount: `${item.totalClaimAmount}` || "0.00",
          dateSubmitted: item.submittedDate || new Date().toLocaleDateString(),
          // For CRP users, only show view and track actions
          action: isCRP ? ["view", "track"] : ["view", "edit", "track", "delete"],
          originalData: item, 
        }));
             
        setRowData(formattedData);
        setFilteredData(formattedData);
      } else {
        setRowData([]);
        setFilteredData([]);
        toast.info("No applications found", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching dashboard data:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setRowData([]);
      setFilteredData([]);
    } finally {
      setIsLoading(false);
    }
  };

  // Handle local search in dashboard
  const handleSearchChange = (e) => {
    setSearchQuery(e.target.value);
    
    // Update URL with search parameter
    const newUrl = `/dashboard?search=${encodeURIComponent(e.target.value)}`;
    window.history.pushState({ path: newUrl }, '', newUrl);
    
    // Store in sessionStorage for persistence
    sessionStorage.setItem('searchQuery', e.target.value);
  };

  // Get the appropriate quick actions based on user type
  const quickActions = getQuickActions();

  // Get the appropriate dashboard title based on user type
  const getDashboardTitle = () => {
    return isCRP ? "Claims Management Dashboard" : "My Claims Dashboard";
  };

  // Get search result message
  const getSearchResultMessage = () => {
    if (searchQuery && filteredData.length === 0) {
      return `No results found for "${searchQuery}"`;
    } else if (searchQuery && filteredData.length > 0) {
      return `Found ${filteredData.length} result${filteredData.length === 1 ? '' : 's'} for "${searchQuery}"`;
    }
    return null;
  };

  return (
    <div className="dashboard-main-container" style={{ marginTop: '70px', marginLeft: '70px', width: 'calc(100% - 70px)', padding: '20px' }}>
      {!isLoading ? (
        <Container fluid className="p-0">
          {/* Dashboard Header */}
          <div className="dashboard-header-section">
            <h1 className="dashboard-welcome">{getCurrentGreeting()}, {userName || 'User'}!</h1>
            <p className="dashboard-subtitle">{getDashboardTitle()}</p>
          </div>

          {/* Stats Cards */}
          <div className="stats-cards-container">
            {statsData.map((stat) => (
              <div key={stat.id} className={`stat-card-modern ${stat.className}`}>
                <div className="stat-card-header">
                  <div className="stat-card-title">{stat.title}</div>
                  <div className="stat-card-icon">
                    {stat.icon}
                  </div>
                </div>
                <div className="stat-card-value">{stat.value}</div>
                <div className={`stat-card-trend ${stat.trendUp ? 'trend-up' : 'trend-down'}`}>
                  {stat.trendUp ? <FaArrowUp className="trend-icon" /> : <FaArrowDown className="trend-icon" />}
                  {stat.trend} from last month
                </div>
                {stat.showProgress && (
                  <ProgressBar 
                    now={parseInt(stat.value)} 
                    style={{ 
                      height: '8px', 
                      borderRadius: '4px', 
                      backgroundColor: 'rgba(255, 255, 255, 0.3)', 
                      marginTop: '10px' 
                    }}
                  >
                    <ProgressBar 
                      now={parseInt(stat.value)} 
                      style={{ backgroundColor: 'white' }} 
                    />
                  </ProgressBar>
                )}
                <div className="stat-card-bg">
                  {stat.icon}
                </div>
              </div>
            ))}
          </div>

          {/* Quick Actions Section */}
          <div className="dashboard-section">
            <div className="section-header">
              <h2 className="section-title">
                <FaFileInvoice className="section-title-icon" />
                Quick Actions
              </h2>
            </div>
            <div className="section-body">
              <div className="quick-actions-grid">
                {quickActions.map(action => (
                  <div key={action.id} className="quick-action-card" onClick={action.action}>
                    <div className="quick-action-icon">
                      {action.icon}
                    </div>
                    <h3 className="quick-action-title">{action.title}</h3>
                    <p className="quick-action-desc">{action.description}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* Claims Table Section - Added ref for scrolling */}
          <div className="dashboard-section" ref={claimsTableRef} id="claims-table-section">
            <div className="section-header">
              <h2 className="section-title">
                <FaClipboardList className="section-title-icon" />
                {isCRP ? "Claims List" : "Recent Claims"}
              </h2>
              
              {/* Dashboard search bar */}
              <div className="dashboard-search-container">
                <InputGroup className="dashboard-search">
                  <InputGroup.Text>
                    <FaSearch />
                  </InputGroup.Text>
                  <Form.Control
                    placeholder="Search claims by number, claimant, or status..."
                    value={searchQuery}
                    onChange={handleSearchChange}
                  />
                  {searchQuery && (
                    <Button 
                      variant="outline-secondary" 
                      onClick={() => {
                        setSearchQuery('');
                        sessionStorage.removeItem('searchQuery');
                        window.history.pushState({ path: '/dashboard' }, '', '/dashboard');
                      }}
                    >
                      Clear
                    </Button>
                  )}
                </InputGroup>
              </div>
            </div>
            
            {/* Search results message */}
            {getSearchResultMessage() && (
              <div className="search-results-message">
                {getSearchResultMessage()}
              </div>
            )}
            
            <div className="section-body">
              <ActionTable
                columns={columns}
                rowData={filteredData}
                hideExportBtn={false}
                onViewRow={handleOnViewRow}
                handleEditRow={handleEditRow}
                onTrackRow={handleTrackRow}
                onDeleteRow={handleDeleteRow}
              />
            </div>
          </div>

          {/* Application Details Modal */}
          <ApplicationDetailsView
            show={isViewModalOpen}
            onHide={() => setIsViewModalOpen(false)}
            modalData={modalData}
            fullModelData={fullModelData}
            handleDownload={handleDownload}
          />

          {/* Tracking Modal */}
          <TrackingModal 
            show={isTrackModalOpen} 
            onHide={() => setIsTrackModalOpen(false)} 
            trackData={trackData} 
          />
        </Container>
      ) : (
        <div className="loader-container">
          <div className="loader"></div>
          <div className="loader-message">Loading your dashboard...</div>
        </div>
      )}
    </div>
  );
};

export default EnhancedDashboard;
