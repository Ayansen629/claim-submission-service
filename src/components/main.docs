import React, { useState, useEffect } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Button, Card, Badge } from 'react-bootstrap';
import { FaFileAlt, FaFileUpload, FaPrint, FaArrowLeft, FaArrowRight, FaDownload } from 'react-icons/fa';
import DynamicFormFields from '../../common/DynamicFormFields';
import createFormFieldsConfig from '../../common/FormFieldsConfig';
import { useNavigate } from 'react-router-dom';
import ActionDropdown from '../../common/ActionDropdown';
import ApprovalModal from '../../common/ApprovalModal';
import './OfficerViewPage.css'; // Create this CSS file for custom styles

const OfficerViewPage = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(true);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const navigate = useNavigate();
  const totalSteps = 2;
  const actionsFromAPI = ["Approve", "Reject", "Request Changes"];

  // Mock data - in real app this would come from API
  const mockApplicationData = {
    firstName: "John",
    lastName: "Doe",
    emailId: "john.doe@example.com",
    phoneNumber: "9876543210",
    panNumber: "ABCDE1234F",
    gstNumber: "22ABCDE1234F1Z5",
    addressLine1: "123 Main Street",
    addressLine2: "Building A",
    pin: "700001",
    district: "Kolkata",
    stateUt: "West Bengal",
    country: "India",
    addressProof: "address_proof.pdf",
    panCardUpload: "pan_card.pdf",
    gstCertificate: "gst_certificate.pdf",
    status: "Pending Review"
  };

  useEffect(() => {
    // Simulate API call
    setTimeout(() => {
      setFormData(mockApplicationData);
      setIsLoading(false);
    }, 500);
  }, []);

  const methods = useForm({ defaultValues: { country: 'India' } });
  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading) {
      Object.keys(formData).forEach(key => {
        if (formData[key]) {
          setValue(key, formData[key]);
        }
      });
    }
  }, [isLoading, formData, setValue]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      ...formData,
    };
    console.log("Action submitted:", payload);
    setShowApprovalModal(false);
    setSelectedAction("");
    // API call would go here
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const getDisabledFormFieldsConfig = () => {
    const originalConfig = createFormFieldsConfig(() => {});
    
    const disabledStep1 = originalConfig.step1.map(field => ({
      ...field,
      disabled: true,
      inputClassName: 'disabled-field' // Add custom class for disabled fields
    }));
    
    const disabledStep2 = originalConfig.step2.map(field => ({
      ...field,
      disabled: true,
      render: (value) => (
        <div className="file-display d-flex align-items-center">
          <span className="me-2">{value || 'No file uploaded'}</span>
          {value && (
            <Button variant="outline-primary" size="sm" onClick={() => handleDownload(value)}>
              <FaDownload className="me-1" /> Download
            </Button>
          )}
        </div>
      )
    }));
    
    return {
      step1: disabledStep1,
      step2: disabledStep2
    };
  };

  const formFields = getDisabledFormFieldsConfig();

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      default: return [];
    }
  };

  const handleNext = () => {
    if (currentStep < totalSteps) {
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const handleDownload = (filename) => {
    console.log(`Downloading ${filename}`);
    // Actual download implementation would go here
  };

  const handlePrint = () => {
    window.print();
  };

  const handleBackToList = () => {
    navigate('/officerRoleDashboard');
  };

  const getStatusBadge = (status) => {
    const statusMap = {
      'Pending Review': 'warning',
      'Approved': 'success',
      'Rejected': 'danger',
      'Processing': 'info'
    };
    return <Badge bg={statusMap[status] || 'secondary'}>{status}</Badge>;
  };

  if (isLoading) {
    return (
      <Container className="d-flex justify-content-center align-items-center" style={{ height: '100vh' }}>
        <div className="spinner-border text-primary" role="status">
          <span className="visually-hidden">Loading...</span>
        </div>
      </Container>
    );
  }

  return (
    <Container fluid className="py-4 officer-view-container">
      <Row className="justify-content-center">
        <Col xl={10} lg={12} md={12}>
          <Card className="shadow-sm">
            <Card.Header className="bg-white border-bottom-0">
              <div className="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                <div className="mb-2 mb-md-0">
                  <h4 className="mb-1">Application Review</h4>
                  <div className="d-flex align-items-center">
                    <span className="text-muted me-3">APP-2025-001</span>
                    {getStatusBadge(formData.status)}
                  </div>
                </div>
                <div className="d-flex">
                  <Button variant="outline-secondary" onClick={handlePrint} className="me-2">
                    <FaPrint className="me-1" /> Print
                  </Button>
                  <Button variant="outline-primary" onClick={handleBackToList}>
                    Back to List
                  </Button>
                </div>
              </div>
            </Card.Header>

            <Card.Body className="p-4">
              <FormProvider {...methods}>
                <form>
                  {/* Enhanced Stepper */}
                  <div className="stepper-wrapper mb-5">
                    <div className={`stepper-item ${currentStep >= 1 ? 'active' : ''}`}>
                      <div className="step-counter">
                        {currentStep > 1 ? <FaFileAlt className="text-success" /> : '1'}
                      </div>
                      <div className="step-name">Basic Details</div>
                      {currentStep > 1 && <div className="step-connector"></div>}
                    </div>
                    <div className={`stepper-item ${currentStep >= 2 ? 'active' : ''}`}>
                      <div className="step-counter">
                        {currentStep > 2 ? <FaFileUpload className="text-success" /> : '2'}
                      </div>
                      <div className="step-name">Documents</div>
                    </div>
                  </div>

                  {/* Form Content */}
                  <div className="form-content px-3">
                    <DynamicFormFields 
                      fields={getCurrentStepFields()} 
                      setFormData={setFormData} 
                    />
                  </div>

                  {/* Navigation Buttons */}
                  <div className="d-flex justify-content-between mt-5 pt-3 border-top">
                    <Button
                      variant="outline-primary"
                      onClick={handlePrevious}
                      disabled={currentStep === 1}
                      className="px-4"
                    >
                      <FaArrowLeft className="me-1" /> Previous
                    </Button>
                    
                    {currentStep < totalSteps ? (
                      <Button
                        variant="primary"
                        onClick={handleNext}
                        className="px-4"
                      >
                        Next <FaArrowRight className="ms-1" />
                      </Button>
                    ) : (
                      <div className="d-flex align-items-center">
                        <ActionDropdown 
                          actions={actionsFromAPI} 
                          onActionClick={handleActionClick} 
                          variant="primary"
                        />
                      </div>
                    )}
                  </div>
                </form>
              </FormProvider>
            </Card.Body>
          </Card>
        </Col>
      </Row>

      {/* Approval Modal */}
      <ApprovalModal
        show={showApprovalModal}
        handleClose={handleCloseModal}
        handleSubmitData={handleActionSubmit}
        selectedAction={selectedAction}
      />
    </Container>
  );
};

export default OfficerViewPage;
