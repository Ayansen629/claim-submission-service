import React, { useState, useEffect, useImperativeHandle, forwardRef } from "react";
import { Row, Col, Table, Card } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { formatDate } from "../../../../../utils/constants.ts";
import styles from "../../../../common/styles/ProvisionalCertificateOfRegistration.module.css";

const ProvisionalCertificateOfRegistration = forwardRef(({
  registrationData,
  surveyData,
  preFilledCertData,
  onDataChange = () => {}
}, ref) => {
  const { t } = useTranslation();

  const currentDate = new Date();
  const expiryDate = new Date(currentDate.getTime() + 365 * 24 * 60 * 60 * 1000);

  const [editableData, setEditableData] = useState({
    expiryDate: formatDate(expiryDate),
    registrationDate: formatDate(currentDate),
    previousRegistrationNo: '',
    dateOfPreviousRegistry: '',
    portOfPreviousRegistry: '',
    build: '',
    lengthEngineRoom: '',
    numberOfTenthShares: '10',
    summaryDescriptionOfTonnage: '',
    isUnderstood: false
  });

  const [errors, setErrors] = useState({});

  useEffect(() => {
    if (preFilledCertData) {
      setEditableData(prev => ({
        ...prev,
        expiryDate: preFilledCertData.expiryDate || prev.expiryDate,
        registrationDate: preFilledCertData.registrationDate || prev.registrationDate,
        previousRegistrationNo: preFilledCertData.previousRegistrationNo || '',
        dateOfPreviousRegistry: preFilledCertData.dateOfPreviousRegistry || '',
        portOfPreviousRegistry: preFilledCertData.portOfPreviousRegistry || '',
        build: preFilledCertData.build || '',
        lengthEngineRoom: preFilledCertData.lengthEngineRoom || '',
        numberOfTenthShares: preFilledCertData.numberOfTenthShares || '10',
        summaryDescriptionOfTonnage: preFilledCertData.summaryDescriptionOfTonnage || '',
        isUnderstood: preFilledCertData.isUnderstood || false
      }));
    }
  }, [preFilledCertData]);

  useEffect(() => {
    onDataChange(editableData);
  }, [editableData, onDataChange]);

  const validateRequiredFields = () => {
    const newErrors = {};
    
    if (!editableData.expiryDate.trim()) newErrors.expiryDate = 'Expiry date is required';
    if (!editableData.registrationDate.trim()) newErrors.registrationDate = 'Registration date is required';
    if (!editableData.lengthEngineRoom.trim()) newErrors.lengthEngineRoom = 'Length of engine room is required';
    if (!editableData.numberOfTenthShares.trim()) newErrors.numberOfTenthShares = 'Number of tenth shares is required';
    if (!editableData.summaryDescriptionOfTonnage.trim()) newErrors.summaryDescriptionOfTonnage = 'Summary description is required';
    if (!editableData.isUnderstood) newErrors.isUnderstood = 'You must confirm understanding';

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  useImperativeHandle(ref, () => ({
    validate: validateRequiredFields,
    getData: () => editableData
  }));

  const handleInputChange = (field, value) => {
    setEditableData(prev => ({
      ...prev,
      [field]: value
    }));
    
    if (errors[field]) {
      setErrors(prev => {
        const newErrors = { ...prev };
        delete newErrors[field];
        return newErrors;
      });
    }
  };

  const renderEditableField = (label, fieldName, type = 'text', required = false, placeholder = '') => {
    const hasError = errors[fieldName];
    
    return (
      <div className={styles.editableCell}>
        {required && <span className={styles.asterisk}>*</span>}
        <input
          type={type}
          className={`${styles.editableInput} ${hasError ? styles.errorField : ''}`}
          value={editableData[fieldName]}
          onChange={(e) => handleInputChange(fieldName, e.target.value)}
          placeholder={placeholder}
        />
        {hasError && <div className={styles.errorMessage}>{hasError}</div>}
      </div>
    );
  };

  return (
    <div className={styles.registrationCertificateContainer}>
      <div className={styles.certificateHeader}>
        <h4 className={styles.certificateTitle}>
          {t("PROVISIONAL CERTIFICATE OF REGISTRATION")}
        </h4>
      </div>

      <div className={styles.certificateBody}>
        {/* Expiry Date */}
        <div className={styles.expirySection}>
          <span className={styles.expiryLabel}>
            {t("Expiry on or before the")} <span className={styles.asterisk}>*</span>
            <input
              type="date"
              className={`${styles.editableDate} ${errors.expiryDate ? styles.errorField : ''}`}
              value={editableData.expiryDate}
              onChange={(e) => handleInputChange("expiryDate", e.target.value)}
            />
            {errors.expiryDate && <div className={styles.errorMessage}>{errors.expiryDate}</div>}
          </span>
        </div>

        {/* Issued By */}
        <div className={styles.issuedBySection}>
          <span className={styles.issuedLabel}>
            {t("Issued by")} ({t("IWT Authority")})
          </span>
        </div>

        {/* Particulars of Vessel */}
        <div className="vessel-particulars mb-4">
          <h5 className={styles.sectionTitle}>{t("PARTICULARS OF VESSEL")}</h5>

          <Table bordered className={styles.particularsTable}>
            <tbody>
              <tr>
                <td className={styles.labelCell}>{t("Official Number")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.officialNumber || "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Registration Date")}</td>
                {renderEditableField("Registration Date", "registrationDate", "date", true)}
                <td className={styles.labelCell}>{t("Name of the Vessel")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.vesselName || "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Port of Registry")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.portOfRegistry || "N/A"}
                </td>
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Previous Registration No.")}</td>
                {renderEditableField("Previous Registration No.", "previousRegistrationNo", "text", false, "Enter if any")}
                <td className={styles.labelCell}>{t("Date of Previous Registry")}</td>
                {renderEditableField("Date of Previous Registry", "dateOfPreviousRegistry", "date")}
                <td className={styles.labelCell}>{t("Port of Previous Registry")}</td>
                {renderEditableField("Port of Previous Registry", "portOfPreviousRegistry", "text", false, "Enter if any")}
                <td className={styles.labelCell}>{t("Name of Builder")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.nameOfBuilder || "N/A"}
                </td>
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Address of Builder")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.addressOfBuilder || "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Where Built")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.placeOfBuilt || "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Propulsion Type")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.propulsionType || "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Number of Deck")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.numberOfDeck ?? "N/A"}
                </td>
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Material Description")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.materialDescription || "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Number of Bulkheads")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.numberOfBulkHeads ?? "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Stern")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.strengthOfDeck || "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Build")}</td>
                {renderEditableField("Build Year", "build", "text", false, "Year")}
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Length")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.length || "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Breadth")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.breadth || "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Depth")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.depth || "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Draft")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.draft || "N/A"}
                </td>
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Length of the Engine Room")}</td>
                {renderEditableField("Length of Engine Room", "lengthEngineRoom", "number", true, "Enter length")}
                <td className={styles.labelCell}>{t("GROSS TONNAGE")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.grossTonnage ?? "N/A"}
                </td>
                <td className={styles.labelCell}>{t("NET TONNAGE")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.netTonnage ?? "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Number of crew")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.numberOfCrew ?? "N/A"}
                </td>
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Number of Engines:")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.numberOfEngines ?? "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Combined Power")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.combinedPower
                    ? `${preFilledCertData.combinedPower} HP`
                    : "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Name of Engine Maker")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.nameOfEngineMaker || "N/A"}
                </td>
                <td className={styles.labelCell}>{t("Address of Engine Maker")}</td>
                <td className={styles.autoPopulateCell}>
                  {preFilledCertData?.addressOfEngineMaker || "N/A"}
                </td>
              </tr>
            </tbody>
          </Table>
        </div>

        {/* Survey Certificate Note */}
        <div className={styles.surveyNote}>
          <p className={styles.noteText}>
            {t("A detailed summary of the tonnages for this vessel is shown on the Certificate of Survey")}
          </p>
        </div>

        {/* Summary Description */}
        <div className="mb-4">
          <label className={`${styles.fieldLabel} ${styles.required}`}>
            {t("Summary Description of Tonnage")} <span className={styles.asterisk}>*</span>
          </label>
          <textarea
            className={`form-control ${errors.summaryDescriptionOfTonnage ? styles.errorField : ''}`}
            rows="4"
            value={editableData.summaryDescriptionOfTonnage}
            onChange={(e) => handleInputChange('summaryDescriptionOfTonnage', e.target.value)}
            placeholder="Enter detailed summary of tonnage..."
          />
          {errors.summaryDescriptionOfTonnage && (
            <div className={styles.errorMessage}>{errors.summaryDescriptionOfTonnage}</div>
          )}
        </div>

        {/* Crew Accommodation */}
        <div className={styles.crewSection}>
          <div className={styles.crewInfo}>
            <span className={styles.crewLabel}>
              {t("The Number of crew for whom accommodation is certified")}
            </span>
            <span className={styles.crewValue}>
              {preFilledCertData?.numberOfCrew ?? "N/A"}
            </span>
          </div>
        </div>

        {/* Certification Statement */}
        <div className={styles.certificationStatement}>
          <p className={styles.statementText}>
            {t("I, the undersigned, Registering Authority at the Port of")}{" "}
            <strong>{preFilledCertData?.portOfRegistry || "N/A"}</strong>{" "}
            {t("in")} <strong>{preFilledCertData?.state || "West Bengal"}</strong>{" "}
            {t("here by certify that the Inland Vessel the Description of which is prefixed to this Provisional certificate, has been duly surveyed, and that the above Description is true; that")}{" "}
            <strong>{preFilledCertData?.nameOfMaster || "N/A"}</strong>{" "}
            {t("whose Certificate of Competency of Service is No")}{" "}
            <strong>{preFilledCertData?.cocNumber || "N/A"}</strong>,{" "}
            {t("is the Master of the said Vessel, and that the Name")}{" "}
            <strong>{preFilledCertData?.ownerName || "N/A"}</strong>{" "}
            {t("Residence of")}{" "}
            <strong>{preFilledCertData?.addressOfOwner || "N/A"}</strong>,{" "}
            {t("owner of")}{" "}
            <strong>{preFilledCertData?.vesselName || "N/A"}</strong>,{" "}
            {t("Number of Tenth Shares Held by are as follows")} :-
          </p>
        </div>

        {/* Owner Details Table */}
        <div className="owner-details mb-4">
          <Table bordered className={styles.ownerTable}>
            <thead>
              <tr>
                <th className={styles.ownerHeader}>
                  {t("Name Residence and Occupation of the Owner")}
                </th>
                <th className={styles.sharesHeader}>
                  {t("Number of Tenth Shares")} <span className={styles.asterisk}>*</span>
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td className={styles.ownerInfo}>
                  <div>
                    <strong>{t("Name")}:</strong> {preFilledCertData?.ownerName || "N/A"}
                  </div>
                  <div>
                    <strong>{t("Residence")}:</strong> {preFilledCertData?.addressOfOwner || "N/A"}
                  </div>
                  <div>
                    <strong>{t("Occupation")}:</strong> {registrationData?.other?.occupation || "Business"}
                  </div>
                </td>
                <td className={styles.sharesValue}>
                  <input
                    type="number"
                    className={`${styles.sharesInput} ${errors.numberOfTenthShares ? styles.errorField : ''}`}
                    value={editableData.numberOfTenthShares}
                    onChange={(e) => handleInputChange('numberOfTenthShares', e.target.value)}
                    min="1"
                    max="10"
                    placeholder="1-10"
                  />
                  <span>/10</span>
                  {errors.numberOfTenthShares && (
                    <div className={styles.errorMessage}>{errors.numberOfTenthShares}</div>
                  )}
                </td>
              </tr>
            </tbody>
          </Table>
        </div>

        {/* Understanding Checkbox */}
        <div className={styles.checkboxSection}>
          <label className={styles.checkboxLabel}>
            <input
              type="checkbox"
              className={styles.checkboxInput}
              checked={editableData.isUnderstood}
              onChange={(e) => handleInputChange('isUnderstood', e.target.checked)}
            />
            <span className={styles.checkboxText}>
              {t("I understand and confirm all the information provided above is accurate")} <span className={styles.asterisk}>*</span>
            </span>
          </label>
          {errors.isUnderstood && (
            <div className={styles.errorMessage}>{errors.isUnderstood}</div>
          )}
        </div>
      </div>
    </div>
  );
});

export default ProvisionalCertificateOfRegistration;
