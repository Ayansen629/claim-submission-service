import React, { useState, useRef, useCallback, forwardRef, useImperativeHandle, useEffect } from "react";
import { useForm } from "react-hook-form";
import { Row, Col, Button } from "react-bootstrap";
import { FaEye, FaUpload } from "react-icons/fa";
import Collapsible from "../../../common/Collapsible";
import InputText from "../../../common/InputText.tsx";
import styles from './AddressChange.module.css';

const AddressChange = forwardRef(({ selectedOption, onValidationChange, onDataChange, initialData }, ref) => {
  const {
    register,
    formState: { errors },
    watch,
    trigger,
    setValue,
  } = useForm({
    mode: "onChange",
    defaultValues: {
      previousAddress: "23, Park View Road, Salt Lake, Kolkata - 700091, West Bengal",
      addressLine1: "",
      addressLine2: "",
      pin: "",
      district: "",
      state: "",
      country: "INDIA"
    }
  });

  const [uploadedFile, setUploadedFile] = useState(null);
  const [fileError, setFileError] = useState("");
  const [showValidation, setShowValidation] = useState(false);

  useEffect(() => {
    if (initialData) {
      Object.keys(initialData).forEach(key => {
        if (key !== 'uploadedFile') {
          setValue(key, initialData[key]);
        }
      });
      if (initialData.uploadedFile) {
        setUploadedFile(initialData.uploadedFile);
        setFileError("");
      }
    }
  }, [initialData, setValue]);

  const handleFileUpload = useCallback((event) => {
    const file = event.target.files[0];
    if (file) {
      setUploadedFile(file);
      setFileError("");
      const formData = watch();
      const isValid = formData.addressLine1 && formData.pin && formData.district && formData.state && file;
      onValidationChange?.(isValid);
      onDataChange?.({ ...formData, uploadedFile: file });
    }
  }, [watch, onValidationChange, onDataChange]);

  const validateForm = useCallback(async () => {
    setShowValidation(true);
    
    const isFormValid = await trigger();
    const formData = watch();
    
    if (!uploadedFile) {
      setFileError("Please upload a valid supporting document");
    } else {
      setFileError("");
    }
    
    const isValid = isFormValid && formData.addressLine1 && formData.pin && formData.district && formData.state && uploadedFile;
    return isValid;
  }, [trigger, watch, uploadedFile]);

  useImperativeHandle(ref, () => ({
    validateForm
  }));

  React.useEffect(() => {
    const subscription = watch((value) => {
      const isValid = value.addressLine1 && value.pin && value.district && value.state && uploadedFile;
      
      if (showValidation && !uploadedFile) {
        setFileError("Please upload a valid supporting document");
      } else if (uploadedFile) {
        setFileError("");
      }
      
      onValidationChange?.(isValid);
      onDataChange?.({ ...value, uploadedFile });
    });
    return () => subscription.unsubscribe();
  }, [watch, uploadedFile, onValidationChange, onDataChange, showValidation]);

  return (
    <Collapsible
      title="Address Update"
      openStat={true}
      newDesign={true}
    >
      <div className={styles.formContent}>
        <div className={styles.previousAddressSection}>
          <label className={styles.sectionLabel}>Previous Address</label>
          <div className={styles.previousAddressBox}>
            {watch("previousAddress")}
          </div>
        </div>

        <div className={styles.updateSection}>
          <h6 className={styles.sectionTitle}>Update Your Address</h6>
          
          <Row className="gy-3">
            <Col md={6}>
              <InputText
                label="Address line 1"
                name="addressLine1"
                placeholder="Enter Address Line 1"
                register={register("addressLine1", {
                  required: "Address line 1 is required"
                })}
                errors={showValidation ? errors : {}}
                required={true}
              />
            </Col>
            
            <Col md={6}>
              <InputText
                label="Address line 2"
                name="addressLine2"
                placeholder="Enter Address Line 2"
                register={register("addressLine2")}
                errors={showValidation ? errors : {}}
              />
            </Col>

            <Col md={6}>
              <InputText
                label="PIN"
                name="pin"
                placeholder="Enter 6-digit Pin code"
                register={register("pin", {
                  required: "PIN is required",
                  pattern: {
                    value: /^[0-9]{6}$/,
                    message: "Please enter a valid 6-digit PIN"
                  }
                })}
                errors={showValidation ? errors : {}}
                required={true}
                maxLength={6}
              />
            </Col>
            
            <Col md={6}>
              <InputText
                label="District"
                name="district"
                placeholder="Please Enter Your District"
                register={register("district", {
                  required: "District is required"
                })}
                errors={showValidation ? errors : {}}
                required={true}
              />
            </Col>

            <Col md={6}>
              <InputText
                label="State"
                name="state"
                placeholder="Please Enter Your State"
                register={register("state", {
                  required: "State is required"
                })}
                errors={showValidation ? errors : {}}
                required={true}
              />
            </Col>
            
            <Col md={6}>
              <InputText
                label="Country"
                name="country"
                register={register("country")}
                errors={showValidation ? errors : {}}
                disabled={true}
              />
            </Col>
          </Row>
        </div>
        
        <div className={styles.warningText}>
          Applicant must upload valid supporting documents for the selected change ({selectedOption})
        </div>
        
        <div className={styles.uploadSection}>
          <label className={styles.uploadLabel}>*Valid Supporting Documents</label>
          <div className={`${styles.uploadBox} ${fileError ? styles.uploadBoxError : ''}`}>
            <input
              type="file"
              id="fileUpload"
              style={{ display: 'none' }}
              onChange={handleFileUpload}
              accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
            />
            <div className={styles.fileName}>
              {uploadedFile ? uploadedFile.name : "File Name"}
            </div>
            <div className={styles.uploadButtons}>
              <Button
                variant="outline-success"
                size="sm"
                disabled={!uploadedFile}
                className={styles.viewButton}
              >
                <FaEye className="me-1" />
                View
              </Button>
              <Button
                variant="outline-primary"
                size="sm"
                className={styles.uploadButton}
                onClick={() => document.getElementById('fileUpload').click()}
              >
                <FaUpload className="me-1" />
                Upload
              </Button>
            </div>
          </div>
          {fileError && (
            <div className={styles.fileError}>
              {fileError}
            </div>
          )}
        </div>
      </div>
    </Collapsible>
  );
});

export default AddressChange;
