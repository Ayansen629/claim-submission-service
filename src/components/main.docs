useEffect(() => {
  if (constructedBy) {
    // Clear all builder-related fields when switching between Self/Builder
    const builderFields = [
      'builderName', 'builderAddress', 'builderEmail', 'builderMobile',
      'builderTradeLicence', 'builderGST', 'builderAuth', 'authLetter', 'builder'
    ];
    
    builderFields.forEach(field => {
      setValue(field, '', { shouldValidate: false });
      clearErrors(field);
    });
    
    // Update formData state
    setFormData(prev => {
      const newData = { ...prev };
      builderFields.forEach(field => {
        delete newData[field];
      });
      return newData;
    });
  }
}, [constructedBy, setValue, clearErrors]);
