const ClaimTypeFields = ({ 
  claimType, 
  control, 
  register, 
  errors, 
  setValue, 
  getValues, 
  watch,
  trigger
}) => {
  // ... (other state declarations remain the same)

  // Fixed collectEntityData function with immediate update
  const collectEntityData = useCallback(() => {
    const entityType = 
      claimType === "principalBorrower" ? "PRINCIPAL_BORROWER" :
      claimType === "guarantor" ? "GUARANTOR" :
      "BENEFICIARY";

    const entities = entityFields.map(entityNum => ({
      id: entityNum,
      name: getValues(`${claimType}Name${entityNum}`) || "",
      address: getValues(`${claimType}Address${entityNum}`) || "",
      type: entityType
    }));

    // Immediately update form data
    setValue("entityData", entities, { shouldValidate: true, shouldDirty: true });
    return entities;
  }, [claimType, entityFields, getValues, setValue]);

  // Updated addEntityField with immediate data collection
  const addEntityField = useCallback(async () => {
    const newIndex = entityFields.length + 1;
    const newEntityFields = [...entityFields, newIndex];
    setEntityFields(newEntityFields);
    
    // Immediately collect and set the entity data
    const entities = collectEntityData();
    
    // Force form validation update
    await trigger();
    
    // Focus the new field
    setTimeout(() => {
      document.getElementById(`${claimType}Name${newIndex}`)?.focus();
    }, 100);
  }, [entityFields, collectEntityData, trigger, claimType]);

  // Updated removeEntityField with immediate data collection
  const removeEntityField = useCallback(async (index) => {
    if (entityFields.length <= 1) return;
    
    const newFields = [...entityFields];
    newFields.splice(index, 1);
    setEntityFields(newFields);
    
    const entityNum = index + 1;
    setValue(`${claimType}Name${entityNum}`, undefined, { shouldValidate: false });
    setValue(`${claimType}Address${entityNum}`, undefined, { shouldValidate: false });
    
    // Immediately collect and set the updated entity data
    collectEntityData();
    await trigger();
  }, [entityFields, setValue, claimType, collectEntityData, trigger]);

  // Watch for changes and update entityData
  useEffect(() => {
    const subscription = watch((value, { name }) => {
      if (name && (name.includes('Name') || name.includes('Address'))) {
        collectEntityData();
      }
    });
    return () => subscription.unsubscribe();
  }, [watch, collectEntityData]);

  // Initialize entityData on mount
  useEffect(() => {
    collectEntityData();
  }, []); // Empty dependency array to run only on mount

  // ... (rest of the component remains the same)
};
