const validateDocuments = async () => {
  if (isViewMode) return true;
  
  let hasErrors = false;
  const requiredFields = [];
  const tonnageBooklets = getValues("TONNAGE_BOOKLETS");
  const stabilityBooklets = getValues("STABILITY_BOOKLETS");
  const termsAccepted = getValues("termsAccepted");
  const currentGRT = getValues("grt");

  const isFilePresent = (fileObj) =>
    !!fileObj && (fileObj.name || fileObj.filestoreId);

  // Check if GRT changed in edit mode
  if (
    isEditMode &&
    originalGRT !== null &&
    currentGRT !== undefined &&
    String(currentGRT) !== String(originalGRT)
  ) {
    if (!isFilePresent(tonnageBooklets)) {
      requiredFields.push("TONNAGE_BOOKLETS");
    }
    if (!isFilePresent(stabilityBooklets)) {
      requiredFields.push("STABILITY_BOOKLETS");
    }
  }

  // Always check terms and conditions (for both normal and edit modes)
  if (!termsAccepted) {
    setError("termsAccepted", {
      type: "required",
      message: "Terms and Conditions must be accepted",
    });
    hasErrors = true;
  }

  // Check other required fields
  requiredFields.forEach((fieldName) => {
    const fieldValue = getValues(fieldName);
    if (
      !fieldValue ||
      (fieldValue instanceof FileList && fieldValue.length === 0)
    ) {
      setError(fieldName, {
        type: "required",
        message: `${fieldName} is required`,
      });
      hasErrors = true;
    }
  });

  // Clear errors for fields that are valid
  Object.keys(getValues()).forEach((fieldName) => {
    if (!requiredFields.includes(fieldName) && fieldName !== "termsAccepted") {
      clearErrors(fieldName);
    }
  });

  return !hasErrors;
};
