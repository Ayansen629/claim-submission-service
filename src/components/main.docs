// In UserManagement component (main changes)
const UserManagement = () => {
  // ... other imports and state

  // Change modal state management
  const [showModal, setShowModal] = useState(false);

  const handleShowModal = () => setShowModal(true);
  const handleCloseModal = () => setShowModal(false);

  const handleFormSubmit = async (data: any) => {
    try {
      console.log("Form Data:", JSON.stringify(data, null, 2)); // Log formatted form data
      
      const formData = new FormData();
      
      // Flatten the data structure for form submission
      Object.entries(data).forEach(([sectionKey, sectionValue]) => {
        if (typeof sectionValue === 'object' && sectionValue !== null) {
          Object.entries(sectionValue).forEach(([key, value]) => {
            if (key === 'documents') {
              Object.entries(value as object).forEach(([docKey, docValue]) => {
                if (docValue) formData.append(docKey, (docValue as FileList)[0]);
              });
            } else {
              formData.append(`${sectionKey}.${key}`, value as string);
            }
          });
        }
      });

      // Submit formData to your API
      await postData("your-api-endpoint", formData);
      toast.success("Employee registered successfully!");
      handleCloseModal();
    } catch (error) {
      toast.error("Error submitting form");
    }
  };

  return (
    <>
      {/* ... other components */}
      
      <ActionModal
        show={showModal}
        close={handleCloseModal}
        handleModalSubmit={methods.handleSubmit(handleFormSubmit)}
        title={modalTitle}
        size={"lg"}
        isFooterHide={false} // Show footer for close button
      >
        <FormProvider {...methods}>
          <form onSubmit={methods.handleSubmit(handleFormSubmit)}>
            <EmployeeRegistrationForm />
            <div className="text-center mt-4">
              <Button variant="primary" type="submit" className="me-2">
                <i className="fas fa-save me-2"></i>Submit
              </Button>
              <Button variant="secondary" onClick={handleCloseModal}>
                <i className="fas fa-times me-2"></i>Cancel
              </Button>
            </div>
          </form>
        </FormProvider>
      </ActionModal>
    </>
  );
};

//////////////////////
// In EmployeeRegistrationForm component (key updates)
const EmployeeRegistrationForm = () => {
  // ... existing code

  // Enhanced PIN code handling
  useEffect(() => {
    const fetchAddressDetails = async (pin: string) => {
      if (pin?.length === 6) {
        try {
          const response = await fetch(`https://api.postalpincode.in/pincode/${pin}`);
          const data = await response.json();
          
          if (data[0]?.Status === "Success" && data[0]?.PostOffice?.length > 0) {
            const postOffice = data[0].PostOffice[0];
            setValue("address.district", postOffice.District);
            setValue("address.state", postOffice.State);
            setValue("address.country", postOffice.Country);
          }
        } catch (error) {
          console.error("Error fetching address details:", error);
          toast.error("Error fetching address details from PIN code");
        }
      }
    };

    fetchAddressDetails(watchPin);
  }, [watchPin, setValue]);

  // Add placeholders to all InputText components
  return (
    <div className="employee-registration-form">
      <Collapsible title="Personal Details" defaultOpen={true}>
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={4}>
                <InputText
                  name="personal.firstName"
                  label="First Name"
                  placeholder="Enter your first name"
                  // ... rest of props
                />
              </Col>
              {/* Add similar placeholder props to all InputText components */}
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>
      {/* ... other sections */}
    </div>
  );
};
