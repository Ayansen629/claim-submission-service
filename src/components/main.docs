import React from "react";
import { Container, Row, Col, Card, Button, Navbar, Nav, NavDropdown } from "react-bootstrap";

// ... (keep all the image imports same as before)

const IWTHomePage = () => {
  // ... (keep all the data arrays same as previous version)

  return (
    <div className="iwt-homepage">
      {/* Banner Section with Navbar - Modified for zoom */}
      <div className="hero-banner" style={{ backgroundImage: `url(${Banner})` }}>
        <Navbar expand="lg" variant="dark" className="transparent-navbar">
          <Container fluid className="px-4">
            {/* Navbar content same as before but with zoom-friendly classes */}
            {/* ... */}
          </Container>
        </Navbar>

        <div className="hero-content">
          <Container>
            <h1 className="zoom-responsive-title">Welcome to Inland Water Transport</h1>
            {/* ... rest of banner content ... */}
          </Container>
        </div>
      </div>

      {/* Stats Section with Zoom Adjustments */}
      <section className="stats-section py-5">
        <Container fluid="xxl">
          <Row className="g-4 justify-content-center">
            {statsData.map((stat, index) => (
              <Col xl={3} lg={6} md={6} key={index}>
                <Card className="stat-card h-100">
                  <Card.Body className="text-center">
                    <h2 className="stat-value">{stat.value}</h2>
                    <h5 className="stat-label">{stat.label}</h5>
                    <p className="stat-description">{stat.description}</p>
                  </Card.Body>
                </Card>
              </Col>
            ))}
          </Row>
        </Container>
      </section>

      {/* Vessel Registration Section with Icon Fixes */}
      <section className="vessel-registration py-5 bg-light">
        <Container fluid="xxl">
          {/* Section header... */}

          <Row className="align-items-center g-4">
            <Col xl={6} className="mb-4 mb-xl-0">
              <Row className="g-3">
                {vesselRegistrationItems.map((item, index) => (
                  <Col md={6} key={index}>
                    <Card className="h-100 service-card">
                      <Card.Body>
                        <div className="d-flex align-items-start">
                          <div className="icon-container me-3">
                            <img 
                              src={item.icon} 
                              alt={item.title}
                              className="zoom-icon"
                            />
                          </div>
                          <div className="content-wrapper">
                            <h5 className="service-title">{item.title}</h5>
                            <p className="service-description">{item.description}</p>
                            <Button variant="link" className="service-link p-0">
                              <img 
                                src={Navigation} 
                                alt="Navigate" 
                                className="nav-icon"
                              />
                            </Button>
                          </div>
                        </div>
                      </Card.Body>
                    </Card>
                  </Col>
                ))}
              </Row>
            </Col>
            <Col xl={6}>
              <div className="vessel-image-container ratio ratio-16x9">
                <img src={Ship} alt="IWT Ship" className="img-fluid" />
              </div>
            </Col>
          </Row>
        </Container>
      </section>

      {/* Add similar modifications to other sections */}

      {/* Updated CSS */}
      <style jsx>{`
        .iwt-homepage {
          font-size: 1rem;
          line-height: 1.5;
        }

        /* Zoom-friendly typography */
        .zoom-responsive-title {
          font-size: clamp(1.5rem, 3vw, 2.5rem);
        }

        /* Consistent icon sizing */
        .icon-container {
          width: 3em;
          height: 3em;
          min-width: 3em;
          padding: 0.5em;
          background: #f0f7ff;
          border-radius: 0.5em;
          display: flex;
          align-items: center;
          justify-content: center;
        }

        .zoom-icon {
          width: 1.5em;
          height: 1.5em;
          object-fit: contain;
        }

        .nav-icon {
          width: 1.25em;
          height: 1.25em;
        }

        /* Fluid spacing */
        .service-card {
          padding: 1.25em;
          margin-bottom: 1em;
        }

        /* Responsive grid adjustments */
        @media (min-width: 1200px) {
          .container-fluid {
            max-width: 1600px;
          }
        }

        /* Better zoom handling */
        @media screen and (min-resolution: 1.5dppx) {
          .iwt-homepage {
            font-size: 0.9em;
          }
          
          .service-card {
            margin-bottom: 1.5em;
          }
          
          .icon-container {
            width: 3.5em;
            height: 3.5em;
          }
        }

        /* Prevent layout breaking */
        .row {
          --bs-gutter-x: 1.5rem;
          margin-right: calc(-0.5 * var(--bs-gutter-x));
          margin-left: calc(-0.5 * var(--bs-gutter-x));
        }

        .col,.col-1,.col-10,.col-11,.col-12,.col-2,.col-3,.col-4,.col-5,.col-6,.col-7,.col-8,.col-9,.col-auto,.col-lg,.col-lg-1,.col-lg-10,.col-lg-11,.col-lg-12,.col-lg-2,.col-lg-3,.col-lg-4,.col-lg-5,.col-lg-6,.col-lg-7,.col-lg-8,.col-lg-9,.col-lg-auto,.col-md,.col-md-1,.col-md-10,.col-md-11,.col-md-12,.col-md-2,.col-md-3,.col-md-4,.col-md-5,.col-md-6,.col-md-7,.col-md-8,.col-md-9,.col-md-auto,.col-sm,.col-sm-1,.col-sm-10,.col-sm-11,.col-sm-12,.col-sm-2,.col-sm-3,.col-sm-4,.col-sm-5,.col-sm-6,.col-sm-7,.col-sm-8,.col-sm-9,.col-sm-auto,.col-xl,.col-xl-1,.col-xl-10,.col-xl-11,.col-xl-12,.col-xl-2,.col-xl-3,.col-xl-4,.col-xl-5,.col-xl-6,.col-xl-7,.col-xl-8,.col-xl-9,.col-xl-auto {
          padding-right: calc(var(--bs-gutter-x) * 0.5);
          padding-left: calc(var(--bs-gutter-x) * 0.5);
        }

        /* Image containment */
        .vessel-image-container img {
          width: 100%;
          height: 100%;
          object-fit: contain;
          max-height: 500px;
        }

        /* Better button scaling */
        .btn {
          font-size: 0.9em;
          padding: 0.5em 1.2em;
          border-radius: 0.5em;
        }
      `}</style>
    </div>
  );
};

export default IWTHomePage;
