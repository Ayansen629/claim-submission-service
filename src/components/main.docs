/* Mobile responsiveness for hero section */
@media (max-width: 768px) {
  .heroSection {
    height: 80vh;
  }

  .brandName {
    font-size: 18px;
    line-height: 24px;
    text-align: center;
  }

  .homeLoginBtn {
    position: relative;
    right: auto;
    top: auto;
    margin-top: 1rem;
    width: 100%;
    max-width: 120px;
  }

  .topNavCol {
    margin-bottom: 2rem;
  }

  .navLinkItems {
    font-size: 14px;
    padding: 0.25rem 0.5rem !important;
  }
}

@media (max-width: 576px) {
  .heroSection {
    height: 70vh;
  }

  .brandName {
    font-size: 16px;
    line-height: 20px;
  }

  .navLinkItems {
    font-size: 12px;
  }
}
