// UserManagement.jsx - handleFormSubmit function update
const handleFormSubmit = async (data) => {
  try {
    // Log the complete form data
    console.log("Form submitted with data:", JSON.stringify(data, null, 2));
    
    // Create FormData object for API submission
    const formDataObj = new FormData();
    
    // Add validation for required fields
    let hasErrors = false;
    
    // Validate personal details
    if (!data.personal?.firstName) {
      methods.setError("personal.firstName", { type: "required", message: "First Name is required" });
      hasErrors = true;
    }
    
    if (!data.personal?.lastName) {
      methods.setError("personal.lastName", { type: "required", message: "Last Name is required" });
      hasErrors = true;
    }
    
    if (!data.personal?.email) {
      methods.setError("personal.email", { type: "required", message: "Email is required" });
      hasErrors = true;
    } else if (!/^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i.test(data.personal.email)) {
      methods.setError("personal.email", { type: "pattern", message: "Invalid email address" });
      hasErrors = true;
    }
    
    if (!data.personal?.phoneNumber) {
      methods.setError("personal.phoneNumber", { type: "required", message: "Phone Number is required" });
      hasErrors = true;
    } else if (!/^\d{10}$/.test(data.personal.phoneNumber)) {
      methods.setError("personal.phoneNumber", { type: "pattern", message: "Phone number must be 10 digits" });
      hasErrors = true;
    }
    
    // Validate address details
    if (!data.address?.line1) {
      methods.setError("address.line1", { type: "required", message: "Address Line-1 is required" });
      hasErrors = true;
    }
    
    if (!data.address?.pin) {
      methods.setError("address.pin", { type: "required", message: "PIN Code is required" });
      hasErrors = true;
    } else if (!/^\d{6}$/.test(data.address.pin)) {
      methods.setError("address.pin", { type: "pattern", message: "PIN must be 6 digits" });
      hasErrors = true;
    }
    
    // Validate document uploads
    if (!data.documents?.addressProof || !data.documents.addressProof[0]) {
      methods.setError("documents.addressProof", { type: "required", message: "Address Proof is required" });
      hasErrors = true;
    }
    
    if (hasErrors) {
      console.log("Form has validation errors");
      return;
    }
    
    // Process form data for API submission
    for (const [key, value] of Object.entries(data)) {
      if (key === "documents") {
        // Handle file uploads
        for (const [docKey, docFile] of Object.entries(value)) {
          if (docFile && docFile[0]) {
            console.log(`Adding file: ${docKey}`, docFile[0]);
            formDataObj.append(docKey, docFile[0]);
          }
        }
      } else {
        // Handle other form data
        formDataObj.append(key, JSON.stringify(value));
      }
    }
    
    // Log the FormData entries
    console.log("Form data payload:");
    for (const [key, value] of formDataObj.entries()) {
      console.log(`${key}:`, value instanceof File ? `File: ${value.name}` : value);
    }

    // Submit formData to your API
    // await postData("your-api-endpoint", formDataObj);
    
    toast.success("Employee registered successfully!");
    setModal(false); // Close modal after successful submission
  } catch (error) {
    console.error("Error submitting form:", error);
    toast.error("Error submitting form");
  }
};
