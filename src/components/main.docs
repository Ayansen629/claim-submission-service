const submitTransferData = async (formValues, stepIndex, stepInfo = null) => {
  try {
    loaderRef.current?.show();
    
    const ownerDetails = getFromLocalStorage("ownerDetails") 
      ? JSON.parse(getFromLocalStorage("ownerDetails")) 
      : null;

    // Use existing data as base, only update changed fields
    const payload = {
      registrationRequest: {
        id: registrationData?.RegistrationResponse?.id || "",
        applicationNumber: registrationData?.RegistrationResponse?.applicationNumber || "",
        applicationType: "TRANSFER_OF_REGISTRY",
        basicDetails: {
          id: registrationData?.RegistrationResponse?.basicDetails?.id || "",
          applicationNumber: registrationData?.RegistrationResponse?.applicationNumber || "",
          status: registrationData?.RegistrationResponse?.basicDetails?.status || "",
          ownerDetails: {
            id: registrationData?.RegistrationResponse?.basicDetails?.ownerDetails?.id || ownerDetails?.id || ""
          },
          builderDetails: {
            id: registrationData?.RegistrationResponse?.basicDetails?.builderDetails?.id || ""
          },
          // Preserve existing or use form values
          dateOfRegistration: formValues?.basicDetails?.dateOfRegistration || registrationData?.RegistrationResponse?.basicDetails?.dateOfRegistration || "",
          occupation: formValues?.basicDetails?.occupation || registrationData?.RegistrationResponse?.basicDetails?.occupation || "",
          originalPlaceBusiness: formValues?.basicDetails?.originalPlaceOfBusiness || registrationData?.RegistrationResponse?.basicDetails?.originalPlaceBusiness || ""
        },
        vesselDetails: {
          // Preserve all existing vessel details, only update form values
          ...registrationData?.RegistrationResponse?.vesselDetails,
          typeOfVessel: formValues?.vesselDetails?.typeOfVessel || registrationData?.RegistrationResponse?.vesselDetails?.typeOfVessel || "",
          categoryOfVessel: formValues?.vesselDetails?.categoryOfVessel || registrationData?.RegistrationResponse?.vesselDetails?.categoryOfVessel || "",
          grossTonnage: parseFloat(formValues?.vesselDetails?.grossTonnage) || registrationData?.RegistrationResponse?.vesselDetails?.grossTonnage || 0,
          vesselName: formValues?.vesselDetails?.vesselName || registrationData?.RegistrationResponse?.vesselDetails?.vesselName || "",
          yearOfBuild: parseInt(formValues?.vesselDetails?.yearOfBuild) || registrationData?.RegistrationResponse?.vesselDetails?.yearOfBuild || 0,
          lengthOfVessel: parseFloat(formValues?.vesselDetails?.lengthOfVessel) || registrationData?.RegistrationResponse?.vesselDetails?.lengthOfVessel || 0,
          breadthOfVessel: parseFloat(formValues?.vesselDetails?.breadthOfVessel) || registrationData?.RegistrationResponse?.vesselDetails?.breadthOfVessel || 0,
          depthOfVessel: parseFloat(formValues?.vesselDetails?.depthOfVessel) || registrationData?.RegistrationResponse?.vesselDetails?.depthOfVessel || 0,
          netTonnage: parseFloat(formValues?.vesselDetails?.netTonnage) || registrationData?.RegistrationResponse?.vesselDetails?.netTonnage || 0,
          registrationNumber: formValues?.basicVesselInfo?.officialNo || registrationData?.RegistrationResponse?.vesselDetails?.registrationNumber || "",
          previousPort: formValues?.vesselDetails?.portOfRegistry || registrationData?.RegistrationResponse?.vesselDetails?.previousPort || "",
          reasonOfChange: formValues?.basicVesselInfo?.reasonForTransfer || registrationData?.RegistrationResponse?.vesselDetails?.reasonOfChange || ""
        },
        engineDetails: {
          // Preserve all existing engine details, only update form values
          ...registrationData?.RegistrationResponse?.engineDetails,
          engineType: formValues?.engineDetails?.engineType || registrationData?.RegistrationResponse?.engineDetails?.engineType || "",
          engineMake: formValues?.engineDetails?.engineMake || registrationData?.RegistrationResponse?.engineDetails?.engineMake || "",
          horsepower: parseFloat(formValues?.engineDetails?.horsepower) || registrationData?.RegistrationResponse?.engineDetails?.horsepower || 0,
          speed: parseFloat(formValues?.engineDetails?.speed) || registrationData?.RegistrationResponse?.engineDetails?.speed || 0,
          numberOfEngine: parseInt(formValues?.engineDetails?.numberOfEngine) || registrationData?.RegistrationResponse?.engineDetails?.numberOfEngine || 0
        }
      },
      initialSurveyRequest: {
        // Preserve existing survey data, only update form values
        ...initialRegistryData,
        BasicVesselInformation: {
          ...initialRegistryData?.BasicVesselInformation,
          placeYardNo: formValues?.basicVesselInfo?.proposedPortOfRegistry || initialRegistryData?.BasicVesselInformation?.placeYardNo || "",
          netTonnage: parseFloat(formValues?.vesselDetails?.netTonnage) || initialRegistryData?.BasicVesselInformation?.netTonnage || 0,
          lengthOfVessel: formValues?.vesselDetails?.lengthOfVessel || initialRegistryData?.BasicVesselInformation?.lengthOfVessel || "",
          breadthOfVessel: formValues?.vesselDetails?.breadthOfVessel || initialRegistryData?.BasicVesselInformation?.breadthOfVessel || "",
          depthOfVessel: formValues?.vesselDetails?.depthOfVessel || initialRegistryData?.BasicVesselInformation?.depthOfVessel || "",
          draft: formValues?.basicVesselInfo?.draft || initialRegistryData?.BasicVesselInformation?.draft || "",
          totalNoOfDeckCrew: parseInt(formValues?.crewDetails?.totalDeckCrew) || initialRegistryData?.BasicVesselInformation?.totalNoOfDeckCrew || "",
          totalNoOfEngineCrew: parseInt(formValues?.crewDetails?.totalEngineCrew) || initialRegistryData?.BasicVesselInformation?.totalNoOfEngineCrew || ""
        }
      },
      enclosers: extractAllEnclosures(formValues)
    };

    // For step 2, merge equipment data with existing
    if (stepIndex === 1) {
      const equipmentPayload = buildEquipmentPayload(formValues, initialRegistryData);
      payload.initialSurveyRequest = {
        ...payload.initialSurveyRequest,
        ...equipmentPayload
      };
    }

    const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.TRANSFER_OF_REGISTRY.TRANSFER_OF_REGISTRY_CREATE;
    const response = await postData(apiUrl, payload);

    if (response?.status === 200 || response?.status === 201) {
      const responseData = response?.data?.data;
      
      // Update state with new response data
      setRegistrationData(prev => ({
        ...prev,
        RegistrationResponse: responseData?.RegistrationResponse || prev?.RegistrationResponse,
        vessel: {
          ...prev?.vessel,
          applicationNumber: responseData?.RegistrationResponse?.applicationNumber || prev?.vessel?.applicationNumber,
          iwtVesselBasicDetailsTFk: responseData?.RegistrationResponse?.basicDetails?.id || prev?.vessel?.iwtVesselBasicDetailsTFk
        }
      }));
      
      setInitialRegistryData(prev => ({
        ...prev,
        ...responseData?.IwtInitialSurveyResponse
      }));
      
      toast.success(stepIndex === 0 ? "Transfer application updated successfully!" : "Equipment data updated successfully!");

      if (stepInfo) {
        stepperRef.current?.goToNextStep();
      }
    } else {
      toast.error("Failed to submit data");
    }
  } catch (err) {
    console.error("Error:", err);
    toast.error("Error submitting data");
  } finally {
    loaderRef?.current?.hide();
  }
};
