import React, { useState, useEffect, useRef } from "react";
import { Box, Typography, Stack } from "@mui/material";
import {
  useParams,
  useLocation,
  useNavigate,
  useSearchParams,
} from "react-router-dom";
import Stepper from "../../../../common/Stepper.jsx";
import VesselSurveyForm from "./VesselSurveyForm.js";
import { useForm } from "react-hook-form";
import { useTranslation } from "react-i18next";
import { toast } from "react-toastify";
import { Button } from "react-bootstrap";
import { BsArrowLeft } from "react-icons/bs";
import { postData } from "../../../../../services/http.service.ts";
import { Tooltip } from "react-tooltip";
import {
  SERVICE_BASE,
  URLS_ENDPOINT,
} from "../../../../../utils/urlsConstants.ts";
import VesselEquipmentForm from "./VesselEquipmentForm.js";
import { initialEquipementData } from "./constants/VesselEquipementConstant.js";
import { vesselSurveyInitialValues } from "./constants/VesselServeyConstant.js";
import Invoicing from "../../../../common/Invoicing.js";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import { OFFICER_ROLES, USER_ROLES } from "../../../../../utils/constants.ts";
import NewLoader from "../../../../common/NewLoader.js";
import { handleErrorMessage } from "../../../../../utils/errorMessageHandler.js";
import ProvisionModal from "../../../../common/ProvisionModal.js";
import { useMasterData } from "../../../../context/MasterDataContext.js";
import ActionDropdown from "../../../../common/ActionDropdown.js";
import ApprovalModal from "../../../../common/ApprovalModal.js";
import BookOfRegistrationForm from "./survey-registrationForms/BookOfRegistrationForm.js";
import CertificateOfRegistrationForm8 from "./survey-registrationForms/CertificateOfRegistrationForm8.js";

const VesselSurveyRegistration = ({
  applicationNo,
  viewMode = false,
  tabMode = false,
}) => {
  let { t } = useTranslation();
  // let { id } = useParams();
  let location = useLocation();
  let navigate = useNavigate();
  const surveyFormRef = useRef();
  const { masterData } = useMasterData();
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [originalRegistrationData, setOriginalRegistrationData] =
    useState(null);
  const [provisionalRegCertData, setProvisionalRegCertData] = useState(null);

  const [searchParams] = useSearchParams();
  let id = searchParams.get("applicationNo");

  let isEditMode = !!id && location.pathname.includes("/edit");
  let isViewMode = (!!id && location.pathname.includes("/view")) || viewMode;

  useEffect(() => {
    if (!id && !applicationNo) {
      toast.error("No Application number present.");
      if (location.key !== "default") {
        navigate(-1);
      } else {
        navigate("/dashboard", { replace: true });
      }
    }
  }, [id, navigate, location.key]);

  if (!id && applicationNo) {
    id = applicationNo;
  }

  let stepperRef = useRef();

  const methods = useForm({
    defaultValues: {
      ...vesselSurveyInitialValues,
      ...initialEquipementData,
    },
    mode: "onTouched",
  });
  const {
    trigger,
    getValues,
    setError,
    setValue,
    reset,
    formState: { errors },
  } = methods;
  const [actionsFromAPI, setActionsFromAPI] = useState([]);
  const [registrationData, setRegistrationData] = useState(null);
  const [intialSurveyData, setIntialSurveyData] = useState(null);

  const userRole = getFromLocalStorage("userRole") || "";
  const userDetails = getFromLocalStorage("userDetails")
    ? JSON.parse(getFromLocalStorage("userDetails"))
    : "";

  const isOfficerLogin = OFFICER_ROLES.includes(userRole) || false;

  const [paymentData, setPaymentData] = useState(null);
  const [fullPaymentData, setFullPaymentData] = useState({});
  const [showOfficerActions, setShowOfficerActions] = useState(false);
  if (isOfficerLogin) {
    isViewMode = true;
  }
  const loaderRef = useRef();

  const [isLoading, setIsLoading] = useState(false);
  const [openCertificateModal, setOpenCertificateModal] = useState(false);
  const [modalType, setModalType] = useState("");

  const [provisionalCertData, setProvisionalCertData] = useState("");
  const [generatedCertificates, setGeneratedCertificates] = useState({
    survey: false,
    registration: false,
  });

  useEffect(() => {
    if (!id) return;

    const fetchRegistrationDetails = async () => {
      try {
        loaderRef.current?.show();
        const payload = { applicationNumbers: [id ?? ""] };
        const apiUrl = `${SERVICE_BASE.IWT_REGISTRATION}${URLS_ENDPOINT.USER_SERVICE.REGISTRATION_SEARCH_BY_ID}`;
        const { status, data } = await postData(apiUrl, payload);

        if (status !== 200) {
          toast.error("Unable to fetch registration details.");
          return;
        }

        const resData = data?.data?.[0] ?? {};
        const {
          basicDetails = {},
          vesselDetails = {},
          engineDetails = {},
          processActionMapResponce = [],
        } = resData;

        const owner = basicDetails?.ownerDetails ?? {};
        const builder = basicDetails?.builderDetails ?? {};

        let normalizedData = {
          basicDetails: basicDetails,
          owner: {
            name: owner?.ownerCompanyName ?? "",
            address: `${owner?.addressLine1 ?? ""}, ${
              owner?.addressLine2 ?? ""
            }`,
            mobile: owner?.phoneNumber ?? "",
            email: owner?.emailId ?? "",
            pan: owner?.panNo ?? "",
            gst: owner?.gstNo ?? "",
            aadhar: owner?.aadharNumber ?? "",
            tradeLicence: owner?.tradeLicenseNumber ?? "",
            ownerIdFk: owner?.ownerIdFk ?? "",
            ownerDetailsId: owner?.ownerDetailsId ?? "",
          },

          vessel: {
            grt: vesselDetails?.grossTonnage ?? "",
            workOrderValue: vesselDetails?.workOrderValue ?? "",
            type: vesselDetails?.typeOfVessel ?? "",
            category: vesselDetails?.categoryOfVessel ?? "",
            zone: vesselDetails?.zone ?? "",
            purchaseType: vesselDetails?.purchaseType ?? "",
            supervisionAuthority: vesselDetails?.supervisionAuthority ?? "",
            classificationSociety:
              vesselDetails?.nameOfClassificationSociety ?? "",
            nameOfMaster: vesselDetails?.nameOfMaster ?? "",
            certificateNo: vesselDetails?.certficateNumber ?? "",
            registry: vesselDetails?.nameOfRegistry ?? "",
            registrationNo: vesselDetails?.registrationNumber ?? "",
            vesselName: vesselDetails?.vesselName ?? "",
            kindOfVessel: vesselDetails?.kindOfVessel ?? "",
            mortgage: vesselDetails?.mortgage ?? "",
            placeOfBuild: vesselDetails?.placeOfBuild ?? "",
            insurance: vesselDetails?.insuranceDetails ?? "",
            yearOfBuild: vesselDetails?.yearOfBuild?.toString() ?? "",
            pniClubNo: vesselDetails?.pniClubNo ?? "",
            pniClubName: vesselDetails?.pniClubName ?? "",
            insuranceValidUpto: vesselDetails?.insuranceValidDate ?? "",

            iwtVesselBasicDetailsTFk:
              vesselDetails?.iwtVesselBasicDetailsTFk ?? "",
            vesselDetailsId: vesselDetails?.vesselDetailsId ?? "",
            applicationNumber: basicDetails?.applicationNumber ?? "",
          },

          builder: {
            constructedBy: basicDetails?.constructedBy ?? "2",
            name: builder?.builderName ?? "",
            address: `${builder?.addressLine1 ?? ""}, ${
              builder?.addressLine2 ?? ""
            }`,
            email: builder?.emailId ?? "",
            mobile: builder?.phone ?? "",
            gst: builder?.gstNo ?? "",
            tradeLicence: builder?.tradeLicenseNumber ?? "",
            auth: basicDetails?.builderAuthorization ?? "",
            builderIdFk: builder?.builderIdFk ?? "",
            builderDetailsId: builder?.builderDetailsId ?? "",
          },

          engine: {
            yearOfBuild: engineDetails?.yearOfBuild ?? "",
            type: engineDetails?.engineType ?? "",
            make: engineDetails?.engineMake ?? "",
            makerAddress: engineDetails?.makerAddress ?? "",
            pin: engineDetails?.pin ?? "",
            mobile: engineDetails?.mobile ?? "",
            email: engineDetails?.email ?? "",
            horsepower: engineDetails?.horsepower?.toString() ?? "",
            speed: engineDetails?.speed?.toString() ?? "",
            yearOfMake: engineDetails?.yearOfMake ?? "",

            engineDetailsId: engineDetails?.engineDetailsId ?? "",
            engineIdFk: engineDetails?.engineIdFk ?? "",
          },

          other: {
            occupation: basicDetails?.occupation ?? "",
            originalPlaceOfBusiness: basicDetails?.originalPlaceBusiness ?? "",

            otherDetailsId: basicDetails?.otherDetailsId ?? "",
          },

          actions: processActionMapResponce || [],
        };

        loaderRef.current?.hide();
        if (vesselDetails?.iwtVesselBasicDetailsTFk) {
          getSurveyDetails(vesselDetails?.iwtVesselBasicDetailsTFk);
        }

        if (isOfficerLogin) {
          const actionsItems =
            processActionMapResponce?.[0]?.processs?.[0]?.actions ?? [];
          if (actionsItems?.length > 0) {
            setActionsFromAPI(actionsItems);
          }
        }
        setOriginalRegistrationData(resData);
        setRegistrationData(normalizedData);
      } catch (err) {
        loaderRef.current?.hide();
        console.error("Failed to fetch registration details:", err);
        toast.error("Failed to fetch registration details.");
      }
    };

    fetchRegistrationDetails();
  }, [id]);

  const getSurveyDetails = async (vesselId) => {
    try {
      loaderRef.current?.show();
      const apiUrl =
        SERVICE_BASE.IWT_SURVEY_SERVICE +
        URLS_ENDPOINT.SURVEY_SERVICE.SURVEY_SEARCH;

      const response = await postData(apiUrl, {
        iwtVesRegBasicDetailsTFk: [vesselId],
      });

      if (response?.status === 200 || response?.status === 201) {
        const surveyData = response?.data[0] || {};

        setIntialSurveyData(surveyData);
        setGeneratedCertificates({
          survey:
            surveyData?.BasicVesselInformation?.enableprovisonalsurveycert ||
            false,
          registration:
            surveyData?.BasicVesselInformation
              ?.enableprovisonalregistrationcert || false,
        });

        if (isOfficerLogin) {
          const hasActions =
            surveyData?.processActionMapResponce?.[0]?.processs?.[0]?.actions
              ?.length > 0;
          setShowOfficerActions(hasActions);

          if (hasActions) {
            setActionsFromAPI(
              surveyData.processActionMapResponce[0].processs[0].actions
            );
          }
        }
        populateFormWithSurveyData(surveyData);
      } else {
        toast.error(
          response?.data?.responseStatus?.message ||
            "Failed to fetch survey details."
        );
      }
    } catch (err) {
      handleErrorMessage(
        err?.response?.data ||
          "Failed to fetch survey details. Check console for details."
      );
    } finally {
      loaderRef?.current?.hide();
    }
  };

  const populateFormWithSurveyData = (data) => {
    if (!data) return;

    const safe = (val, fallback = "") => val ?? fallback;
   

    const mappings = {
      basicVesselInfo: {
        typeOfSurvey: "BasicVesselInformation.typeOfSurveyId",
        placeYardNo: "BasicVesselInformation.placeYardNo",
        netTonnage: "BasicVesselInformation.netTonnage",
        agentName: "BasicVesselInformation.agentsName",
        agentAddress: "BasicVesselInformation.agentsAddress",
        agentTelephone: "BasicVesselInformation.agentsTelephone",
        placeOfLastSurvey: "BasicVesselInformation.placeOfLastSurvey",
        dateOfLastSurvey: "BasicVesselInformation.dateOfLastSurvey",
        dateOfProposedVisit:
          "BasicVesselInformation.dateOfProposedVisitSurveyor",
        lengthOfVessel: "BasicVesselInformation.lengthOfVessel",
        breadthOfVessel: "BasicVesselInformation.breadthOfVessel",
        depthOfVessel: "BasicVesselInformation.depthOfVessel",
        draft: "BasicVesselInformation.draft",
        yearOfBuild: "BasicVesselInformation.yearOfBuild",
        //new updated -->12th sept
        numberOfDecks: "BasicVesselInformation.numberofDecks",
      },
      hullParticulars: {
        frameMaterial: "HullParticulars.frameMaterial",
        frameThickness: "HullParticulars.frameThickness",
        floorMaterial: "HullParticulars.floorMaterial",
        hullMaterial: "HullParticulars.hullMaterial",
        hullPlatingMaterial: "HullParticulars.hullPlatingMaterial",
        hullPlattingThickness: "HullParticulars.hullPlatingThickness",
        keelLayingDate: "HullParticulars.keelLayingDate",
        numberOfBulkheads: "HullParticulars.noOfBulkheads",
        bulkheadPlacement: "HullParticulars.bulkheadPlacement",
        bulkheadThickness: "HullParticulars.bulkheadThickness",
        floorThickness: "HullParticulars.floorThickness",
        stern: "HullParticulars.stern",
      },
      navigationEquipment: {
        magneticCompass: "RadioandNavigationEquipment.magneticCompass",
        vhfRadio: "RadioandNavigationEquipment.vhfRadio",
        classBAutoAIS: "RadioandNavigationEquipment.aisIdentifiSystem",
        gpsNavigator: "RadioandNavigationEquipment.gps",
        binocular: "RadioandNavigationEquipment.binocular",
        aldisLamp: "RadioandNavigationEquipment.aldisLamp",
        rudderAngleIndicator:
          "RadioandNavigationEquipment.rudderAngleIndicator",
        othersNavigation: "RadioandNavigationEquipment.others",
      },
      polutionControl: {
        bilgeWaterSeparator: "PollutionControlDevices.bilgeWaterSeperator",
        bilgeCapacity: "PollutionControlDevices.capacity",
        bilgeMakeModel: "PollutionControlDevices.makeModel",
        sewageTreatmentPlant: "PollutionControlDevices.stp",
        sewageCapacity: "PollutionControlDevices.stpCapacity",
        sewageMakeModel: "PollutionControlDevices.stpMakeModel",
        oilyWaterFilter: "PollutionControlDevices.owf",
        oilyCapacity: "PollutionControlDevices.owfCapacity",
        oilyMakeModel: "PollutionControlDevices.owfMakeModel",
        exhaustGasCleaning: "PollutionControlDevices.egasCleaningSystm",
        exhaustCapacity: "PollutionControlDevices.egasCleaningSystmCapacity",
        exhaustMakeModel: "PollutionControlDevices.egasCleaningSystmMakeModel",
        othersPollution: "PollutionControlDevices.other",
        othersCapacity: "PollutionControlDevices.otherCapacity",
        othersMakeModel: "PollutionControlDevices.otherMakeModel",
      },

      detailsOfPropulsion: {
        // typeOfEngine: "DetailsofPropulsionofEngine.engineType",
        engineMake: "DetailsofPropulsionofEngine.engineMake",
        // engineMakerAddress: "DetailsofPropulsionofEngine.makerAddress",
        // horsepower: "DetailsofPropulsionofEngine.horsepower",
        speedRPM: "DetailsofPropulsionofEngine.speed",
        yearOfMake: "DetailsofPropulsionofEngine.yearOfMake",
        modelNo: "DetailsofPropulsionofEngine.modelNo",
        numberOfSetFitted: "DetailsofPropulsionofEngine.noOfSet",
        numberOfEngine: "DetailsofPropulsionofEngine.numberOfEngine",
        setSrNo: "DetailsofPropulsionofEngine.setSerialNo",
        propellerType: "DetailsofPropulsionofEngine.propellerType",
        gearType: "DetailsofPropulsionofEngine.gearType",
        noOfGear: "DetailsofPropulsionofEngine.noOfGear",
        vesselSpeed: "DetailsofPropulsionofEngine.vesselSpeed",
        revolutionMints: "DetailsofPropulsionofEngine.rpm",
        engineCylinderDiameter: "DetailsofPropulsionofEngine.engineCylinder",
        strokeEngine: "DetailsofPropulsionofEngine.stroke",
        cylindersRotary:
          "DetailsofPropulsionofEngine.noOfCylinderPerSetRotaryEngine",
        cylindersReciprocating:
          "DetailsofPropulsionofEngine.noOfCylinderPerSetReciprocatingEngine",
        numberOfShaft: "DetailsofPropulsionofEngine.noOfShaft",
        lengthEngineRoom: "DetailsofPropulsionofEngine.lengthOfEngineRoom",
      },
    };

    Object.entries(mappings).forEach(([formKey, map]) => {
      Object.entries(map)?.forEach(([field, path]) => {
        const value = path?.split(".")?.reduce((acc, k) => acc?.[k], data);
        const existingValue = getValues(`${formKey}.${field}`);
        if (
          existingValue === undefined ||
          existingValue === null ||
          existingValue === ""
        ) {
          setValue(`${formKey}.${field}`, safe(value));
        }
      });
    });

    // --- Crew Details ---
    const crewDetails = Array.isArray(data?.CrewDetails)
      ? data.CrewDetails
      : [];
    setValue(
      "crewDetails.crewDetails",
      crewDetails.map((crew) => ({
        crewType: safe(crew?.crewType),
        name: safe(crew?.name),
        rank: safe(crew?.rank),
        cocNo: safe(crew?.cocNo),
        validity: safe(crew?.validity),
        experience: safe(crew?.experience),
        status: crew?.status || "ACTIVE",
        placeOfIssue: crew?.placeOfIssue,
      }))
    );

    if (data?.BasicVesselInformation) {
      setValue(
        "crewDetails.totalDeckCrew",
        data?.BasicVesselInformation?.totalNoOfDeckCrew || ""
      );
      setValue(
        "crewDetails.totalEngineCrew",
        data?.BasicVesselInformation?.totalNoOfEngineCrew || ""
      );
    }

    // --- Enclosures ---
    const enclosureMap = {};
    (Array.isArray(data?.Enclosure) ? data.Enclosure : []).forEach((doc) => {
      const typeMap = {
        SURVEY_AUTHORIZATION_OF_AUTHORISED_PERSON: "authorizationFile",
        SURVEY_PAYMENT_CHALLAN: "paymentChallan",
        SURVEY_BUILDER_CERTIFICATE: "builderCertificate",
        SURVEY_COPY_OF_LAST_CERTIFICATE_OF_SURVEY: "lastCertificateCopy",
        SURVEY_COPY_OF_CERTIFICATE_OF_REGISTRATION:
          "registrationCertificateCopy",
        SURVEY_TEST_CERTIFICATE: "testCertificate",
      };
      const key = typeMap[doc.documentType];
      if (key) {
        enclosureMap[key] = {
          name: doc.documentName,
          fileStoreId: doc.fileStoreId,
        };
      }
    });

    Object.entries(enclosureMap).forEach(([key, value]) => {
      setValue(`enclosure.${key}`, value);
      setValue(`enclosure.${key}FileStoreId`, value.fileStoreId);
      setValue(`enclosure.${key}OriginalName`, value.name);
    });

    // --- Equipment Inventory from SurveyEquipments ---
    if (data?.SurveyEquipments) {
      const equipmentData = {};

      Object.keys(data.SurveyEquipments).forEach((equipmentKey) => {
        const equipmentArray = data.SurveyEquipments[equipmentKey];
        if (Array.isArray(equipmentArray)) {
          equipmentArray.forEach((item) => {
            const equipmentId = getEquipmentIdFromKey(equipmentKey);
            if (equipmentId) {
              if (!equipmentData[equipmentId]) {
                equipmentData[equipmentId] = {};
              }
              equipmentData[equipmentId][item.categoryCode] = {
                number: item.number?.toString() || "",
                type: item.type || "",
                location: item.location || "",
                capacity: item.capacity || "",
                condition: item.condition || "",
                remarks: item.remarks || "",
              };
            }
          });
        }
      });

      setValue("equipment", equipmentData);
    }

    if (
      data?.passengerDistributionMaxLoad &&
      Array.isArray(data.passengerDistributionMaxLoad)
    ) {
      setValue(
        "deckSpaces",
        data.passengerDistributionMaxLoad.map((deck) => ({
          deckType: deck.deckName || deck.spaceType || "",
          size: deck.sizeSqm?.toString() || "",
          function: deck.function || "",
          maxPassengers: deck.maxPassengers?.toString() || "",
          remarks: deck.remarks || "",
        }))
      );
    }

    if (data?.vesselFreeboardData) {
      setValue("freeboard", {
        minFreeboard:
          data.vesselFreeboardData.minimumFreeboard?.toString() || "",
        numPassengers:
          data.vesselFreeboardData.numberOfPassengers?.toString() || "",
        cargo: data.vesselFreeboardData.cargoTonnes?.toString() || "",
      });
    }

    // --- Provisional Certificates ---

    if (data?.BasicVesselInformation) {
      setValue(
        "provisionalCertificates.surveyCertificate",
        data.BasicVesselInformation.enableprovisonalsurveycert || false
      );
      setValue(
        "provisionalCertificates.registrationCertificate",
        data.BasicVesselInformation.enableprovisonalregistrationcert || false
      );
    }
  };

  const getEquipmentIdFromKey = (equipmentKey) => {
    const equipmentKeyMap = {
      "Fire Fighting Items": "EquipmentFireFightingItems",
      Equipments: "Equipments",
      "Navigational Equipments": "EquipmentNavigationalEquipments",
      "Life-Saving Equipment": "EquipmentLifeSavingEquipment",
      "Machinery/Electrical": "EquipmentMachineryElectrical",
      "Accommodation/Safety": "EquipmentAccommodationSafety",
    };

    const equipmentName = Object.keys(equipmentKeyMap).find(
      (name) => equipmentKeyMap[name] === equipmentKey
    );

    if (equipmentName) {
      const equipment = masterData?.equipmentCategories?.find(
        (eq) => eq.equipmentName === equipmentName
      );
      return equipment?.id;
    }

    return null;
  };
const validateSurveyForm = async () => {
  if (isViewMode) return true;

  const requiredFields = [
    "basicVesselInfo.typeOfSurvey",
    "basicVesselInfo.placeYardNo",
    "basicVesselInfo.netTonnage",
  ];

  const isValid = await trigger(requiredFields);

  // Check crew details
  const crewDetails = getValues("crewDetails.crewDetails") || [];
  let hasValidCrew = true;
  crewDetails.forEach((crew, index) => {
    if (!crew.crewType) {
      setError(`crewDetails.crewDetails.${index}.crewType`, {
        type: "required",
        message: t("Crew Type is required"),
      });
      hasValidCrew = false;
    }
    if (!crew.name) {
      setError(`crewDetails.crewDetails.${index}.name`, {
        type: "required",
        message: t("Crew Name is required"),
      });
      hasValidCrew = false;
    }
  });

  // Check only mandatory file uploads
  const requiredFiles = [
    "enclosure.authorizationFile",
    "enclosure.builderCertificate",
  ];
  let hasFileErrors = false;

  if (!isEditMode) {
    requiredFiles.forEach((fieldName) => {
      const fieldValue = getValues(fieldName);
      if (!fieldValue) {
        setError(fieldName, {
          type: "required",
          message: t(`${fieldName} is required`),
        });
        hasFileErrors = true;
      }
    });

    await trigger(requiredFiles);
  }

  return isValid && hasValidCrew && !hasFileErrors;
};
  // const validateSurveyForm = async () => {
