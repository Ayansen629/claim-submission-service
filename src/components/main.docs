import { BsEyeFill } from 'react-icons/bs'; // Add this import

// Add this function after handleDownload
const handleView = async (fileData) => {
  try {
    if (!fileData?.fileStoreId) {
      toast.error("No file available to view");
      return;
    }
    
    const url = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${fileData.fileStoreId}`;
    
    const accessToken = getFromLocalStorage("access_token");
    const tokenDetails = getFromLocalStorage("tokenDetails");
    const sessionState = tokenDetails
      ? JSON.parse(tokenDetails)?.session_state
      : "";

    const response = await axios({
      method: "GET",
      url: url,
      responseType: "blob",
      headers: {
        Authorization: `Bearer ${accessToken}`,
        "X-Request-ID": sessionState,
        Accept: "application/octet-stream",
      },
    });

    if (response.data) {
      const blob = new Blob([response.data], {
        type: response.headers["content-type"] || "application/pdf",
      });
      const blobUrl = window.URL.createObjectURL(blob);
      window.open(blobUrl, '_blank');
      
      setTimeout(() => {
        window.URL.revokeObjectURL(blobUrl);
      }, 1000);
    }
  } catch (error) {
    console.error("Error viewing file:", error);
    toast.error("Failed to view file. Please try again.");
  }
};

// Update the file actions section in the file case:
<div className="file-actions">
  <Button 
    variant="outline-primary" 
    size="sm" 
    onClick={() => handleView(fileData)}
    className="file-btn view-btn"
    title="View"
  >
    <BsEyeFill size={10} />
  </Button>
  <Button 
    variant="outline-success" 
    size="sm" 
    onClick={() => handleDownload(fileData)}
    className="file-btn download-btn"
    title="Download"
  >
    <FaDownload size={10} />
  </Button>
</div>


.view-btn {
  border-color: #3b82f6;
  color: #3b82f6;
  background: rgba(59, 130, 246, 0.05);
  margin-right: 0.25rem;
}

.view-btn:hover {
  background: #3b82f6;
  border-color: #3b82f6;
  color: white;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}
