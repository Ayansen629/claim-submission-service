    clsName: "column-text-start",
  },
  {
    colName: "Status",
    fieldName: "status",
    clsName: "column-text-start",
    render: (value) => (
      <span className={`status-badge ${value.toLowerCase()}`}>{value}</span>
    ),
  },
];

// Function to generate inbox data
export const generateInboxData = () => {
  const statuses = ["Pending", "Completed", "Processing", "Rejected"];
  const appTypes = [
    "Registration",
    "Survey",
    "Manning",
    "Certification",
    "Training",
  ];
  const owners = [
    "John Doe",
    "Jane Smith",
    "Robert Johnson",
    "Emily Davis",
    "Michael Wilson",
  ];

  return Array.from({ length: 20 }, (_, i) => ({
    id: i + 1,
    appNo: `APP-2025-${(i + 1).toString().padStart(3, "0")}`,
    appType: appTypes[Math.floor(Math.random() * appTypes.length)],
    owner: owners[Math.floor(Math.random() * owners.length)],
    vesselNo: `WB${1420 + i}`,
    date: new Date(
      2025,
      Math.floor(Math.random() * 12),
      Math.floor(Math.random() * 28) + 1
    )
      .toISOString()
      .split("T")[0],
    status: statuses[Math.floor(Math.random() * statuses.length)],
  }));
};
