// Add import at the top of CurvingMarkingNote.js
import { toastShow } from "../../../../common/toasts";

// Update the handleConfirm function in CurvingMarkingNote.js
const handleConfirm = async (appointments) => {
  setShowModal(false);
  setIsAppointmentBooked(true);
  try {
    const formattedAppointments = appointments.map((apt) => ({
      date: apt.date.toLocaleDateString("en-GB"),
      timeSlot: apt.time,
      appointmentStatus: "",
      isBooked: false,
      bookedBy: null,
    }));
    
    console.log("Awaiting confirmation...");
    await onSubmitAppointments(formattedAppointments);
    console.log("Confirmation successful");
    setDisplayAppointment(false);
    
    // Show success message using your custom toast
    toastShow.notify("Appointment slots proposed successfully!", {
      duration: 5,
      targetId: 'toast-container',
      type: 'success'
    });
    
  } catch (error) {
    console.error("Error submitting appointments:", error);
    toastShow.notify("Failed to submit appointments. Please try again.", {
      duration: 5,
      targetId: 'toast-container',
      type: 'error'
    });
  }
};
