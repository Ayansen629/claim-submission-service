                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Oily Water Filter")}
                name="polutionControl.oilyWaterFilter"
                type="number"
                placeholder={!viewMode ? t("Enter Oily Water Filter") : ""}
                register={register("polutionControl.oilyWaterFilter")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Capacity (m3/hr)")}
                name="polutionControl.oilyCapacity"
                placeholder={!viewMode ? t("Enter Capacity (m3/hr)") : ""}
                register={register("polutionControl.oilyCapacity")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Make & Model")}
