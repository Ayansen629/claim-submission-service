}

.footerText {
  font-family: 'Roboto', sans-serif;
  font-weight: 300;
  font-style: normal;
  font-size: 0.7rem;
  line-height: 1;
  letter-spacing: 0;
  color: white;
}

.footerSocialIcons {
  width: 1.5rem;
  height: 1.5rem;
  box-shadow: 0 0px 3px rgba(0, 0, 0, 0.25);

}

.hideBar {
  margin-left: 2rem;
  margin-right: 2rem;
}

.subTextDynamic {
  display: inline;
}

.socialContainer {
  width: 70% !important;
}

