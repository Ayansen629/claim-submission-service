            <Col md={4}>
              <InputText
                label={t("Engine Cylinder Diameter (mm)")}
                name="detailsOfPropulsion.engineCylinderDiameter"
                type="number"
                placeholder={t("Enter Diameter")}
                register={register(
                  "detailsOfPropulsion.engineCylinderDiameter"
                )}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputSelect
                label={t("Propeller Type")}
                name="detailsOfPropulsion.propellerType"
                options={[
                  {
                    value: "",
                    label: "-- Select --",
                  },
                  ...(masterData?.propellerTypes?.map((type) => ({
                    value: type.valueCode,
                    label: type.valueLabel,
                  })) || []),
                ]}
                register={register("detailsOfPropulsion.propellerType")}
                errors={errors}
                value={watch("detailsOfPropulsion.propellerType") || ""}
                onChange={(value) =>
                  !viewMode &&
                  handleSelectChange("detailsOfPropulsion.propellerType", value)
                }
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Gear Type")}
                name="detailsOfPropulsion.gearType"
                placeholder={t("Enter Gear Type")}
                register={register("detailsOfPropulsion.gearType")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("No. of Gear")}
                name="detailsOfPropulsion.noOfGear"
                type="number"
                placeholder={t("Enter No. of Gear")}
                register={register("detailsOfPropulsion.noOfGear")}
                errors={errors}
