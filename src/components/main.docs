                register={register("engineDetails.noOfGear")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Vessel Speed")}
                name="engineDetails.vesselSpeed"
                placeholder={!viewMode ? t("Enter Vessel Speed") : ""}
                register={register("engineDetails.vesselSpeed")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Revolution/mints")}
