        {/* Engine Details */}
        <Collapsible
          title={
            <>
              <FaCog className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Details of Propulsion of Engine")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
  <InputSelect
    label={t("Type of Engine")}
    name="engineDetails.engineType"
    placeholder={!viewMode ? t("-- Select --") : ""}
    options={[
      { value: "", label: "-- Select --" },
      ...(masterData?.engineTypes?.map((type) => ({
        value: type.valueCode,
        label: type.valueLabel,
      })) || []),
    ]}
    register={register("engineDetails.engineType")}
    errors={errors}
    value={watch("engineDetails.engineType") || ""}
    onChange={(value) =>
      !viewMode &&
      handleSelectChange("engineDetails.engineType", value)
    }
    disabled={viewMode || !!vesselData?.engineType}
    style={{ backgroundColor: "#f8f9fa" }}
  />
</Col>
            <Col md={4}>
              <InputText
                label={t("Engine Make")}
                name="engineDetails.engineMake"
                placeholder={!viewMode ? t("Enter Engine Make") : ""}
