{/* DECLARATION OF OWNERSHIP */}
<Collapsible
  title={
    <div className="d-flex align-items-center">
      <FaUser className="me-2" style={{ color: "#2466BF" }} />
      <span style={{ color: "#2466BF" }}>
        {t("DECLARATION OF OWNERSHIP")}
      </span>
    </div>
  }
  defaultOpen={true}
>
  <Card className="form-section-card">
    <Card.Body>
      <div className="declaration-wrapper">
        <div className="d-flex justify-content-end mb-3">
          {!isViewMode && (
            <Button
              variant={isDeclarationEditable ? "success" : "primary"}
              size="sm"
              onClick={() => setIsDeclarationEditable(!isDeclarationEditable)}
            >
              {isDeclarationEditable ? "Save Declaration" : "Generate Declaration"}
            </Button>
          )}
        </div>
        
        <div className="declaration-content">
          <div className="declaration-text">
            <p className="mb-3">
              I/We <span className="highlight-field">{watch("ownerName") || "[Owner Name]"}</span> residing permanently at{" "}
              <span className="highlight-field">{watch("address") || "[Address of Owner]"}</span> having original place of business at{" "}
              <span className="highlight-field">{watch("originalPlaceOfBusiness") || "[Place of Business]"}</span>
            </p>
            
            <p className="mb-3">
              do hereby declare that vessel named <span className="highlight-field">{watch("vesselName") || "[Vessel Name]"}</span> was built at{" "}
              <span className="highlight-field">{watch("placeOfBuild") || "[Place of Build]"}</span>
            </p>
            
            <p className="mb-3">
              in the year <span className="highlight-field">{watch("vesselyearOfBuild") || "[Year of Build]"}</span> and was purchased by me on{" "}
              {isDeclarationEditable ? (
                <InputText
                  name="workOrderDate"
                  type="date"
                  register={register("workOrderDate")}
                  errors={errors}
                  clearErrors={clearErrors}
                  className="d-inline-block"
                  style={{ 
                    width: "auto", 
                    display: "inline-block",
                    minWidth: "150px",
                    margin: "0 4px"
                  }}
                />
              ) : (
                <span className="highlight-field editable-field">
                  {watch("workOrderDate") || "[Work Order Date]"}
                </span>
              )}
              {" "}for rupees <span className="highlight-field">{watch("workOrderValue") || "[Work Order Value]"}</span> and wish to have the same registered in my name at the port of{" "}
              <span className="highlight-field">{watch("nameOfRegistry") || "[Port of Registry]"}</span> and that I am the owner of the same.
            </p>
          </div>
        </div>
      </div>
    </Card.Body>
  </Card>
</Collapsible>
