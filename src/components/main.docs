/* Main sidebar container */
.custom-sidebar {
  background-color: #f4f8fc;
  color: #2466bf;
  height: 100vh;
  transition: width 0.35s cubic-bezier(0.2, 0, 0.1, 1);
  overflow: hidden;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  border-right: 1px solid #e1eaf5;
  will-change: width;
  padding-top: 60px; /* Match header height */
}

.custom-sidebar.collapsed {
  width: 60px;
}

.custom-sidebar.expanded {
  width: 240px;
}

/* Menu container */
.custom-sidebar-menu {
  list-style: none;
  padding: 0;
  margin: 0;
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  transition: opacity 0.2s ease;
}

/* Menu items */
.custom-sidebar-item {
  position: relative;
  transition: background-color 0.2s ease;
}

.custom-sidebar-item.active > .custom-sidebar-link {
  background-color: #d6e6f9;
  font-weight: 600;
}

/* Main menu links */
.custom-sidebar-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.25s ease;
  border-radius: 0 4px 4px 0;
  position: relative;
  color: #2466bf;
}

.custom-sidebar-link:hover {
  background-color: #e8f1fc;
}

.custom-sidebar-link::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 3px;
  background-color: #2466bf;
  transform: scaleY(0);
  transform-origin: center;
  transition: transform 0.25s ease;
}

.custom-sidebar-item.active > .custom-sidebar-link::before,
.custom-sidebar-link:hover::before {
  transform: scaleY(1);
}

.custom-sidebar-link-content {
  display: flex;
  align-items: center;
  width: 100%;
}

.custom-sidebar-icon {
  margin-right: 12px;
  font-size: 1rem;
  min-width: 24px;
  transition: margin-right 0.25s ease;
}

.custom-sidebar.collapsed .custom-sidebar-icon {
  margin-right: 0;
}

.custom-sidebar.collapsed .custom-sidebar-link-content > span {
  opacity: 0;
  width: 0;
  transition: opacity 0.15s ease, width 0.15s ease;
}

.custom-sidebar.expanded .custom-sidebar-link-content > span {
  opacity: 1;
  width: auto;
  transition: opacity 0.25s ease 0.1s, width 0.25s ease 0.1s;
}

/* Chevron icon */
.custom-sidebar-chevron {
  transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  transform-origin: center;
  opacity: 0.7;
}

.custom-sidebar-chevron.rotate {
  transform: rotate(90deg);
}

/* Submenu */
.custom-sidebar-submenu {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.35s cubic-bezier(0.2, 0, 0.1, 1);
}

.custom-sidebar-submenu.expanded {
  max-height: 1000px;
}

.custom-sidebar-submenu-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

/* Submenu links */
.custom-sidebar-sublink {
  display: block;
  padding: 8px 16px 8px 44px;
  color: #2466bf;
  text-decoration: none;
  font-size: 0.85rem;
  transition: all 0.2s ease;
  position: relative;
}

.custom-sidebar-sublink:hover {
  background-color: #e1ecfb;
  padding-left: 48px;
}

.custom-sidebar-sublink.active {
  background-color: #d6e6f9;
  font-weight: 500;
}

.custom-sidebar-sublink::before {
  content: '';
  position: absolute;
  left: 28px;
  top: 50%;
  transform: translateY(-50%);
  width: 5px;
  height: 5px;
  background-color: #2466bf;
  border-radius: 50%;
  opacity: 0;
  transition: all 0.2s ease;
}

.custom-sidebar-sublink:hover::before,
.custom-sidebar-sublink.active::before {
  opacity: 1;
  left: 24px;
}

/* Close button */
.custom-sidebar-close {
  display: none;
  position: absolute;
  right: 12px;
  top: 12px;
  z-index: 10;
}

.custom-sidebar-close svg {
  cursor: pointer;
  font-size: 1.25rem;
  color: #2466bf;
  transition: transform 0.2s ease;
}

.custom-sidebar-close svg:hover {
  transform: rotate(90deg);
}

/* Scrollbar styling */
.custom-sidebar-menu::-webkit-scrollbar {
  width: 4px;
}

.custom-sidebar-menu::-webkit-scrollbar-thumb {
  background-color: rgba(36, 102, 191, 0.2);
  border-radius: 2px;
}

/* Mobile behavior */
@media (max-width: 768px) {
  .custom-sidebar {
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.2, 0, 0.1, 1);
    width: 260px;
    box-shadow: none;
    z-index: 1100;
  }

  .custom-sidebar.expanded {
    transform: translateX(0);
  }

  .custom-sidebar-close {
    display: block;
  }
}
