useEffect(() => {
  const ownerDetails = getFromLocalStorage("ownerDetails") 
    ? JSON.parse(getFromLocalStorage("ownerDetails")) 
    : null;

  if (ownerDetails) {
    setValue("basicDetails.ownerDetails.nameOfOwner", ownerDetails.ownerCompanyName || "");
    
  
    const address = [ownerDetails.addressLine1, ownerDetails.addressLine2]
      .filter(Boolean)
      .join(", ");
    setValue("basicDetails.ownerDetails.addressLine1", address);
    
    setValue("basicDetails.ownerDetails.phoneNumber", ownerDetails.phoneNumber || "");
  }
}, [setValue]);

const extractAllEnclosures = (formValues) => {
  const enclosures = [];
  
  // Single file documents 
  const singleFileTypes = [
    { field: "certificateOfRegistration", type: "REGISTRATION_CERTIFICATE", name: "Certificate of Registration" },
    { field: "NOCfromOriginalRegistrationAuthority", type: "NOC_FROM_ORIGINAL_REGISTRATION_AUTHORITY", name: "NOC from Original Registration Authority" },
    { field: "lastSurveyCertificate", type: "SURVEY_COPY_OF_LAST_CERTIFICATE_OF_SURVEY", name: "Last Survey Certificate" },
    { field: "tonnageBooklet", type: "TONNAGE_BOOKLETS", name: "Tonnage Booklet" },
    { field: "stabilityBooklet", type: "STABILITY_BOOKLETS", name: "Stability Booklet" },
    { field: "insuranceCertificate", type: "INSURANCE_CERTIFICATE", name: "Insurance Certificate" },
    { field: "paymentChallan", type: "PAYMENT_CHALLAN_OR_ACKNOWLEDGEMENT", name: "Payment Challan" }
  ];

  singleFileTypes.forEach(({ field, type, name }) => {
   
    const fileStoreId = formValues.enclosure?.[`${field}FileStoreId`];
    const fileName = formValues.enclosure?.[field]?.name || formValues.enclosure?.[`${field}OriginalName`];
    
    if (fileStoreId) {
      enclosures.push({
        id: "",
        documentName: fileName || `${name}.pdf`,
        documentType: type,
        fileStoreId,
        documentSource: "TRANSFER_OF_REGISTRY_ENCLOSURES",
        description: name,
        active: true
      });
    }
  });

  // Multi-file documents 
  const multiFileTypes = ["MAIN_AND_OTHER_DRAWINGS", "RADIOGRAPHY_REPORT", "MATERIAL_TEST_REPORT", "OTHER_INSPECTION_REPORTS", "OTHER_TECHNICAL_DOCUMENT"];
  
  multiFileTypes.forEach(type => {
    Object.keys(formValues)
      .filter(key => key.startsWith(`${type}_fileStoreId_`))
      .forEach(storeKey => {
        const index = storeKey.split("_").pop();
        const fileStoreId = formValues[storeKey];
        const fileObj = formValues[`${type}_file_${index}`];
        
        if (fileStoreId) {
          enclosures.push({
            id: "",
            documentName: fileObj?.name || `${type}_${index}.pdf`,
            documentType: type,
            fileStoreId,
            documentSource: "TRANSFER_OF_REGISTRY_ENCLOSURES",
            description: formValues[`${type}_desc_${index}`] || type,
            active: true
          });
        }
      });
  });

  return enclosures;
};




const [step1ResponseData, setStep1ResponseData] = useState(null);

const submitTransferData = async (formValues, stepIndex, stepInfo = null) => {
  try {
    loaderRef.current?.show();
    
    let payload;
    
    
    const isStep1Update = stepIndex === 0 && step1ResponseData?.RegistrationResponse?.id;

    if (stepIndex === 0) {
      const ownerDetails = getFromLocalStorage("ownerDetails") 
        ? JSON.parse(getFromLocalStorage("ownerDetails")) 
        : null;

      payload = {
        registrationRequest: {
          id: isStep1Update ? step1ResponseData.RegistrationResponse.id : "",
          applicationNumber: isStep1Update ? step1ResponseData.RegistrationResponse.applicationNumber : "",
          applicationType: "TRANSFER_OF_REGISTRY",
          basicDetails: {
            id: isStep1Update ? step1ResponseData.RegistrationResponse.basicDetails.id : "",
            applicationNumber: isStep1Update ? step1ResponseData.RegistrationResponse.applicationNumber : "",
            status: isStep1Update ? step1ResponseData.RegistrationResponse.basicDetails.status : "",
            ownerDetails: { id: ownerDetails?.id || "" },
            builderDetails: {
              id: isStep1Update ? step1ResponseData.RegistrationResponse.basicDetails.builderDetails.id : "",
              builderName: formValues?.basicDetails?.builderDetails?.builderName || "",
              addressLine1: formValues?.basicDetails?.builderDetails?.addressLine1 || "",
              addressLine2: formValues?.basicDetails?.builderDetails?.addressLine2 || "",
              pin: formValues?.basicDetails?.builderDetails?.pin || "",
              district: formValues?.basicDetails?.builderDetails?.district || "",
              state: formValues?.basicDetails?.builderDetails?.state || "",
              country: formValues?.basicDetails?.builderDetails?.country || "India"
            },
            // dateOfRegistration: formValues?.basicDetails?.dateOfRegistration || "",
            // occupation: formValues?.basicDetails?.occupation || "",
            // originalPlaceBusiness: formValues?.basicDetails?.originalPlaceOfBusiness || ""
          },
          vesselDetails: {
            id: isStep1Update ? step1ResponseData.RegistrationResponse.vesselDetails.id : "",
            typeOfVessel: formValues?.vesselDetails?.typeOfVessel || "",
            categoryOfVessel: formValues?.vesselDetails?.categoryOfVessel || "",
            zone: "",
            grossTonnage: parseFloat(formValues?.vesselDetails?.grossTonnage) || 0,
            workOrderValue: "",
            purchaseType: "",
            supervisionAuthority: "",
            nameOfMaster: "",
            certficateNumber: "",
            nameOfRegistry: "",
            registrationNumber: formValues?.basicVesselInfo?.officialNo || "",
            vesselName: formValues?.vesselDetails?.vesselName || "",
            kindOfVessel: "",
            mortgage: "",
            placeOfBuild: "",
            insuranceDetails: "",
            yearOfBuild: parseInt(formValues?.vesselDetails?.yearOfBuild) || 0,
            pniClubNo: "",
            pniClubName: "",
            applicationNo: isStep1Update ? step1ResponseData.RegistrationResponse.applicationNumber : "",
            nameOfClassificationSociety: "",
            iwtVesselBasicDetailsTFk: isStep1Update ? step1ResponseData.RegistrationResponse.basicDetails.id : "",
            insuranceValidDate: "",
            portOfRegistry: formValues?.basicVesselInfo?.proposedPortOfRegistry || "",
            surveyId: null,
            lengthOfVessel: parseFloat(formValues?.vesselDetails?.lengthOfVessel) || 0,
            breadthOfVessel: parseFloat(formValues?.vesselDetails?.breadthOfVessel) || 0,
            depthOfVessel: parseFloat(formValues?.vesselDetails?.depthOfVessel) || 0,
            hullMaterial: null,
            noOfBulkheads: null,
            declarationWorkOrderDate: null,
            previousPort: formValues?.vesselDetails?.portOfRegistry || "",
            reasonOfChange: formValues?.basicVesselInfo?.reasonForTransfer || ""
          },
          engineDetails: {
            id: isStep1Update ? step1ResponseData.RegistrationResponse.engineDetails.id : "",
            yearOfBuild: formValues?.vesselDetails?.yearOfBuild || "",
            engineType: formValues?.engineDetails?.engineType || "",
            engineMake: formValues?.engineDetails?.engineMake || "",
            makerAddress: formValues?.engineDetails?.makerAddress || "",
            pin: "",
            mobile: "",
            email: "",
            horsepower: parseFloat(formValues?.engineDetails?.horsepower) || 0.00,
            speed: parseFloat(formValues?.engineDetails?.speed) || 0.00,
            yearOfMake: formValues?.engineDetails?.yearOfMake || "",
            applRegistrationTFk: isStep1Update ? step1ResponseData.RegistrationResponse.basicDetails.id : "",
            modelNo: formValues?.engineDetails?.modelNo || null,
            noOfSet: parseInt(formValues?.engineDetails?.noOfSet) || null,
            numberOfEngine: parseInt(formValues?.engineDetails?.numberOfEngine) || 0,
            serialNo: formValues?.engineDetails?.serialNo || null,
            propellerType: formValues?.engineDetails?.propellerType || null,
            gearType: formValues?.engineDetails?.gearType || null,
            noOfGear: parseInt(formValues?.engineDetails?.noOfGear) || null,
            vesselSpeed: formValues?.engineDetails?.vesselSpeed || null,
            rpm: parseInt(formValues?.engineDetails?.rpm) || null,
            engineCylinder: parseFloat(formValues?.engineDetails?.engineCylinder) || null,
            stroke: parseFloat(formValues?.engineDetails?.stroke) || null,
            internalCombustionEngineNo: null,
            description: null,
            noOfCylindersPerSet: null,
            nhp: null,
            ihp: null,
            propulsionType: null,
            noOfCylinderPerSetRotaryEngine: parseInt(formValues?.engineDetails?.noOfCylinderPerSetRotaryEngine) || 0,
            noOfCylinderPerSetReciprocatingEngine: parseInt(formValues?.engineDetails?.noOfCylinderPerSetReciprocatingEngine) || 0,
            noOfShaft: parseInt(formValues?.engineDetails?.noOfShaft) || 0,
            lengthOfEngineRoom: parseFloat(formValues?.engineDetails?.lengthOfEngineRoom) || 0.00,
            boilderDescription: null,
            boilerNumber: null,
            loadedPressure: null
          }
        },
        initialSurveyRequest: {
          surveyId: isStep1Update ? step1ResponseData.IwtInitialSurveyResponse.surveyId : "",
          BasicVesselInformation: {
            id: isStep1Update ? step1ResponseData.IwtInitialSurveyResponse.BasicVesselInformation.id : "",
            typeOfSurveyId: "Initial",
            placeYardNo: formValues?.basicVesselInfo?.proposedPortOfRegistry || "",
            netTonnage: parseFloat(formValues?.vesselDetails?.netTonnage) || 0,
            agentsName: "",
            agentsAddress: "",
            agentsTelephone: "",
            placeOfLastSurvey: formValues?.basicVesselInfo?.placeOfLastSurvey || "",
            dateOfLastSurvey: formValues?.basicDetails?.builderDetails?.dateOfLastSurvey || "",
            dateOfProposedVisitSurveyor: "",
            iwtVesRegBasicDetailsTFk: isStep1Update ? step1ResponseData.RegistrationResponse.basicDetails.id : "",
            status: isStep1Update ? step1ResponseData.IwtInitialSurveyResponse.BasicVesselInformation.status : "NEW",
            lengthOfVessel: formValues?.vesselDetails?.lengthOfVessel || "",
            breadthOfVessel: formValues?.vesselDetails?.breadthOfVessel || "",
            depthOfVessel: formValues?.vesselDetails?.depthOfVessel || "",
            draft: formValues?.basicVesselInfo?.draft || "",
            numberOfDecks: null,
            enableprovisonalsurveycert: false,
            enableprovisonalregistrationcert: false,
            totalNoOfDeckCrew: formValues?.crewDetails?.totalDeckCrew || "",
            totalNoOfEngineCrew: formValues?.crewDetails?.totalEngineCrew || ""
          },
          HullParticulars: {
            id: isStep1Update ? step1ResponseData.IwtInitialSurveyResponse.HullParticulars.id : "",
            frameMaterial: formValues?.hullParticulars?.frameMaterial || "",
            frameThickness: formValues?.hullParticulars?.frameThickness || "",
            floorMaterial: formValues?.hullParticulars?.floorMaterial || "",
            hullMaterial: formValues?.hullParticulars?.hullMaterial || "",
            hullPlatingThickness: formValues?.hullParticulars?.hullPlattingThickness || "",
            keelLayingDate: formValues?.hullParticulars?.keelLayingDate || "",
            iwtVesBasicSurveyDetTFk: isStep1Update ? step1ResponseData.IwtInitialSurveyResponse.BasicVesselInformation.id : "",
            status: isStep1Update ? step1ResponseData.IwtInitialSurveyResponse.HullParticulars.status : "NEW",
            hullPlatingMaterial: formValues?.hullParticulars?.hullPlatingMaterial || "",
            noOfBulkheads: formValues?.hullParticulars?.numberOfBulkheads || "",
            bulkheadPlacement: formValues?.hullParticulars?.bulkheadPlacement || "",
            bulkheadThickness: formValues?.hullParticulars?.bulkheadThickness || "",
            floorThickness: formValues?.hullParticulars?.floorThickness || "",
            stern: ""
          },
          RadioandNavigationEquipment: {
            id: isStep1Update ? step1ResponseData.IwtInitialSurveyResponse.RadioandNavigationEquipment.id : "",
            magneticCompass: parseInt(formValues?.navigationEquipment?.magneticCompass) || null,
            vhfRadio: parseInt(formValues?.navigationEquipment?.vhfRadio) || null,
            aisIdentifiSystem: parseInt(formValues?.navigationEquipment?.classBAutoAIS) || null,
            gps: parseInt(formValues?.navigationEquipment?.gpsNavigator) || null,
            binocular: parseInt(formValues?.navigationEquipment?.binocular) || null,
            aldisLamp: parseInt(formValues?.navigationEquipment?.aldisLamp) || null,
            rudderAngleIndicator: parseInt(formValues?.navigationEquipment?.rudderAngleIndicator) || null,
            others: parseInt(formValues?.navigationEquipment?.othersNavigation) || null,
            iwtVesBasicSurveyDetTFk: isStep1Update ? step1ResponseData.IwtInitialSurveyResponse.BasicVesselInformation.id : "",
            status: isStep1Update ? step1ResponseData.IwtInitialSurveyResponse.RadioandNavigationEquipment.status : "NEW"
          },
          PollutionControlDevices: {
            id: isStep1Update ? step1ResponseData.IwtInitialSurveyResponse.PollutionControlDevices.id : "",
            bilgeWaterSeperator: parseInt(formValues?.polutionControl?.bilgeWaterSeparator) || null,
            capacity: formValues?.polutionControl?.bilgeCapacity || "",
            makeModel: formValues?.polutionControl?.bilgeMakeModel || "",
            stp: parseInt(formValues?.polutionControl?.sewageTreatmentPlant) || null,
            stpCapacity: formValues?.polutionControl?.sewageCapacity || "",
            stpMakeModel: formValues?.polutionControl?.sewageMakeModel || "",
            owf: parseInt(formValues?.polutionControl?.oilyWaterFilter) || null,
            owfCapacity: formValues?.polutionControl?.oilyCapacity || "",
            owfMakeModel: formValues?.polutionControl?.oilyMakeModel || "",
            egasCleaningSystm: parseInt(formValues?.polutionControl?.exhaustGasCleaning) || null,
            egasCleaningSystmCapacity: formValues?.polutionControl?.exhaustCapacity || "",
            egasCleaningSystmMakeModel: formValues?.polutionControl?.exhaustMakeModel || "",
            other: parseInt(formValues?.polutionControl?.othersPollution) || null,
            otherCapacity: formValues?.polutionControl?.othersCapacity || "",
            otherMakeModel: formValues?.polutionControl?.othersMakeModel || "",
            status: isStep1Update ? step1ResponseData.IwtInitialSurveyResponse.PollutionControlDevices.status : "NEW",
            iwtVesBasicSurveyDetTFk: isStep1Update ? step1ResponseData.IwtInitialSurveyResponse.BasicVesselInformation.id : ""
          },
          CrewDetails: isStep1Update ? 
            (step1ResponseData.IwtInitialSurveyResponse.CrewDetails || []).map((crew, index) => ({
              id: crew.id,
              crewType: formValues?.crewDetails?.crewDetails?.[index]?.crewType || crew.crewType || "",
              name: formValues?.crewDetails?.crewDetails?.[index]?.name || crew.name || "",
              rank: formValues?.crewDetails?.crewDetails?.[index]?.rank || crew.rank || "",
              cocNo: formValues?.crewDetails?.crewDetails?.[index]?.cocNo || crew.cocNo || "",
              validity: formValues?.crewDetails?.crewDetails?.[index]?.validity || crew.validity || "",
              experience: formValues?.crewDetails?.crewDetails?.[index]?.experience || crew.experience || "",
              iwtVesBasicSurveyDetTFk: crew.iwtVesBasicSurveyDetTFk,
              status: crew.status,
              placeOfIssue: formValues?.crewDetails?.crewDetails?.[index]?.placeOfIssue || crew.placeOfIssue || ""
            })) :
            (formValues?.crewDetails?.crewDetails || []).map(crew => ({
              id: "",
              crewType: crew.crewType || "",
              name: crew.name || "",
              rank: crew.rank || "",
              cocNo: crew.cocNo || "",
              validity: crew.validity || "",
              experience: "",
              iwtVesBasicSurveyDetTFk: "",
              status: "NEW",
              placeOfIssue: crew.placeOfIssue || ""
            })),
          equipmentInventoryDetails: null
        },
        enclosers: isStep1Update ? 
          preserveEnclosureIds(step1ResponseData.enclosers || [], extractAllEnclosures(formValues)) :
          extractAllEnclosures(formValues)
      };
    } 
    else if (stepIndex === 1) {
      
      payload = {
        registrationRequest: {
          id: step1ResponseData.RegistrationResponse.id,
          applicationNumber: step1ResponseData.RegistrationResponse.applicationNumber,
          applicationType: "TRANSFER_OF_REGISTRY",
          basicDetails: {
            ...step1ResponseData.RegistrationResponse.basicDetails,
            id: step1ResponseData.RegistrationResponse.basicDetails.id
          },
          vesselDetails: {
            ...step1ResponseData.RegistrationResponse.vesselDetails,
            id: step1ResponseData.RegistrationResponse.vesselDetails.id
          },
          engineDetails: {
            ...step1ResponseData.RegistrationResponse.engineDetails,
            id: step1ResponseData.RegistrationResponse.engineDetails.id
          }
        },
        initialSurveyRequest: {
          ...step1ResponseData.IwtInitialSurveyResponse,
          surveyId: step1ResponseData.IwtInitialSurveyResponse.surveyId,
          BasicVesselInformation: {
            ...step1ResponseData.IwtInitialSurveyResponse.BasicVesselInformation,
            id: step1ResponseData.IwtInitialSurveyResponse.BasicVesselInformation.id
          },
          HullParticulars: {
            ...step1ResponseData.IwtInitialSurveyResponse.HullParticulars,
            id: step1ResponseData.IwtInitialSurveyResponse.HullParticulars.id
          },
          RadioandNavigationEquipment: {
            ...step1ResponseData.IwtInitialSurveyResponse.RadioandNavigationEquipment,
            id: step1ResponseData.IwtInitialSurveyResponse.RadioandNavigationEquipment.id
          },
          PollutionControlDevices: {
            ...step1ResponseData.IwtInitialSurveyResponse.PollutionControlDevices,
            id: step1ResponseData.IwtInitialSurveyResponse.PollutionControlDevices.id
          },
          DetailsofPropulsionofEngine: {
            ...step1ResponseData.IwtInitialSurveyResponse.DetailsofPropulsionofEngine,
            id: step1ResponseData.IwtInitialSurveyResponse.DetailsofPropulsionofEngine.id
          },
          CrewDetails: (step1ResponseData.IwtInitialSurveyResponse.CrewDetails || []).map(crew => ({
            ...crew,
            id: crew.id
          })),
          SurveyEquipments: buildEquipmentPayload(formValues, step1ResponseData.IwtInitialSurveyResponse)?.SurveyEquipments || step1ResponseData.IwtInitialSurveyResponse.SurveyEquipments,
          passengerDistributionMaxLoad: buildEquipmentPayload(formValues, step1ResponseData.IwtInitialSurveyResponse)?.passengerDistributionMaxLoad || step1ResponseData.IwtInitialSurveyResponse.passengerDistributionMaxLoad,
          vesselFreeboardData: buildEquipmentPayload(formValues, step1ResponseData.IwtInitialSurveyResponse)?.vesselFreeboardData || step1ResponseData.IwtInitialSurveyResponse.vesselFreeboardData
        },
        enclosers: step1ResponseData.enclosers || []
      };
    }

    const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.TRANSFER_OF_REGISTRY.TRANSFER_OF_REGISTRY_CREATE;
    const response = await postData(apiUrl, payload);

    if (response?.status === 200 || response?.status === 201) {
      const responseData = response?.data?.data;
      
      
      setStep1ResponseData(responseData);
      
      if (stepIndex === 0) {
        setRegistrationData({
          RegistrationResponse: responseData?.RegistrationResponse,
          vessel: {
            applicationNumber: responseData?.RegistrationResponse?.applicationNumber,
            iwtVesselBasicDetailsTFk: responseData?.RegistrationResponse?.basicDetails?.id
          }
        });
        setInitialRegistryData(responseData?.IwtInitialSurveyResponse);
      }
      
      if (stepIndex === 1) {
        setInitialRegistryData(responseData?.IwtInitialSurveyResponse);
      }
      
      toast.success(stepIndex === 0 ? "Transfer application submitted successfully!" : "Equipment data updated successfully!");

      if (stepInfo) {
        stepperRef.current?.goToNextStep();
      }
    } else {
      toast.error("Failed to submit data");
    }
  } catch (err) {
    console.error("Error:", err);
    toast.error("Error submitting data");
  } finally {
    loaderRef?.current?.hide();
  }
};

// Helper function to preserve enclosure IDs
const preserveEnclosureIds = (existingEnclosures, newEnclosures) => {
  return newEnclosures.map(newEnc => {
    const existing = existingEnclosures.find(enc => 
      enc.documentType === newEnc.documentType || 
      enc.fileStoreId === newEnc.fileStoreId
    );
    
    return {
      ...newEnc,
      id: existing?.id || "",
      applicationNumber: existing?.applicationNumber || newEnc.applicationNumber
    };
  });
};



const handleFormSubmit = async (stepInfo) => {
  window.scrollTo({ top: 0, behavior: "smooth" });
  const formValues = stepInfo?.getFormData?.() || {};
  
  if (stepInfo.index === 0) {
    await submitTransferData(formValues, 0, stepInfo);
  } else if (stepInfo.index === 1) {
    await submitTransferData(formValues, 1, stepInfo);
    // Fetch payment details when moving to invoicing step
    if (!isOfficerLogin && !viewMode && userRole === USER_ROLES.VESSEL_OWNER) {
      await fetchPaymentDetails();
    }
  }
};
