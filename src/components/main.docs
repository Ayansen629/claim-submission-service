                                  value: type.valueCode,
                                  label: type.valueLabel,
                                })) || []
                              }
                              register={register(
                                `professionalDetails.${index}.designation`,
                                { required: t("Designation is required") }
                              )}
                              errors={
                                errors?.professionalDetails?.[index] || {}
                              }
                              value={
                                watch(
                                  `professionalDetails.${index}.designation`
                                ) || ""
                              }
                              onChange={(val) =>
                                setValue(
                                  `professionalDetails.${index}.designation`,
                                  val,
                                  { shouldValidate: true }
                                )
                              }
                            />
                          </Col>
                          <Col md={4}>
                            <InputSelect
                              name={`professionalDetails.${index}.department`}
                              label={t("Department")}
                              required={true}
