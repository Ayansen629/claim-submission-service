import React, { useCallback, useEffect, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import { FaSignature, FaUserTie, FaHome, FaUpload, FaCheckCircle } from "react-icons/fa";
import { MdDescription } from "react-icons/md";
import 'bootstrap/dist/css/bootstrap.min.css';
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepThird.css";

const StepThird = ({ provideSubmitHandler, formData, onValidationComplete }) => {
    // ... existing state and methods ...

    const creditorDetailsSchema = [
        { 
            name: "creditorName", 
            label: <>
                <FaUserTie className="field-icon" />
                Name of financial creditor (in BLOCK LETTERS) <span className="required-asterisk">*</span>
            </>, 
            type: "text", 
            rules: { 
                required: "Creditor name is required",
                pattern: {
                    value: /^[A-Z\s]+$/,
                    message: "Please enter in BLOCK LETTERS only"
                },
                minLength: {
                    value: 3,
                    message: "Name must be at least 3 characters"
                }
            },
            placeholder: "Enter name in BLOCK LETTERS",
            className: "mb-4 creditor-name-field",
            onChange: async (e) => {
                await trigger("creditorName");
            },
            colSize: 6
        },
        { 
            name: "creditorPosition", 
            label: <>
                <MdDescription className="field-icon" />
                Position with or in relation to creditor <span className="required-asterisk">*</span>
            </>, 
            type: "text", 
            rules: { 
                required: "Position is required",
                minLength: {
                    value: 3,
                    message: "Position must be at least 3 characters"
                }
            },
            placeholder: "Enter position/relation to creditor",
            className: "mb-4 creditor-position-field",
            onChange: async (e) => {
                await trigger("creditorPosition");
            },
            colSize: 6
        },
        // ... rest of the schema ...
    ];

    // ... rest of the component code ...

    return (
        <FormProvider {...methods}>
            <form className="form-stepper">
                <div className="form-section-container">
                    <Collapsible 
                        title={
                            <div className="section-header">
                                <FaSignature className="section-icon" />
                                <span>Signature of financial creditor or person authorised to act on its behalf</span>
                            </div>
                        } 
                        defaultOpen={true}
                    >
                        <div className="row g-3 align-items-start">
                            {creditorDetailsSchema.map((fieldConfig) => (
                                <div 
                                    key={fieldConfig.name} 
                                    className={`col-md-${fieldConfig.colSize || 12} ${fieldConfig.className}`}
                                >
                                    <DynamicField
                                        fieldConfig={{
                                            ...fieldConfig,
                                            isUploading,
                                            uploadError,
                                            uploadSuccess,
                                            setIsUploading,
                                            setUploadError,
                                            setUploadSuccess,
                                            onFileUpload: handleFileUpload
                                        }}
                                        control={control}
                                        register={register}
                                        errors={errors}
                                        setValue={setValue}
                                        trigger={trigger}
                                        getValues={getValues}
                                    />
                                </div>
                            ))}
                        </div>
                    </Collapsible>
                </div>
            </form>
        </FormProvider>
    );
};

export default StepThird;
/* Add these styles to your existing StepThird.css */

/* Field Alignment Fixes */
.row.align-items-start {
    align-items: flex-start;
}

.creditor-name-field,
.creditor-position-field {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.creditor-name-field .form-label,
.creditor-position-field .form-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.creditor-name-field .form-control,
.creditor-position-field .form-control {
    flex-grow: 1;
}

/* Responsive adjustments for the creditor name/position fields */
@media (max-width: 768px) {
    .creditor-name-field,
    .creditor-position-field {
        width: 100%;
    }
    
    .creditor-name-field .form-label,
    .creditor-position-field .form-label {
        white-space: normal;
    }
}

/* Ensure consistent height for the input fields */
.form-group {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.form-group .form-control {
    min-height: 44px; /* Standard height for inputs */
}
