import React, { useState, useEffect, useRef } from "react";
import { Container, Row, Col, Button, Card, Badge, Stack, Image } from "react-bootstrap";
import { FaFileAlt, FaFileUpload, FaArrowLeft, FaArrowRight, FaCheck, FaBuilding, FaUser } from "react-icons/fa";
import { FormProvider, useForm } from "react-hook-form";
import { useTranslation } from "react-i18next";
import { useNavigate } from "react-router-dom";
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";
import NewLoader from "../../common/NewLoader.js";
import DynamicViewFields from "../../common/DynamicViewFields";
import createOwnerFormFieldsConfig from "../model/ownerFormFieldsConfig"; // You should create this config like your registration
import createBuilderFormFieldsConfig from "../../common/FormFieldsConfig";
import ApprovalModal from "../../common/ApprovalModal";
import ActionDropdown from "../../common/ActionDropdown";
import "./userViewPage.css";

const UserUnifiedViewPage = ({ userType = "VESSEL_OWNER", applicationData, applicationNumber = "APP-2025-001" }) => {
  const { t } = useTranslation();
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(true);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const loaderRef = useRef();
  const navigate = useNavigate();
  const totalSteps = userType === "VESSEL_OWNER" ? 3 : 2;
  const actionsFromAPI = ["Approve", "Reject", "Request Changes"];

  // Step titles for both types
  const ownerStepTitles = [
    { title: t("vesselOwnerRegistration.Vessel Owner Details"), icon: FaBuilding },
    { title: t("vesselOwnerRegistration.Authorized Person's Details"), icon: FaUser },
    { title: t("vesselOwnerRegistration.Documents Upload"), icon: FaFileUpload }
  ];
  const builderStepTitles = [
    { title: t("builderRegistration.Vessel Builder Details"), icon: FaBuilding },
    { title: t("builderRegistration.Documents Upload"), icon: FaFileUpload }
  ];

  // Get form fields config for view (all disabled)
  const getDisabledFormFieldsConfig = () => {
    let config;
    if (userType === "VESSEL_OWNER") {
      config = createOwnerFormFieldsConfig(() => {});
    } else {
      config = createBuilderFormFieldsConfig(() => {});
    }
    const disabledConfig = {};
    Object.keys(config).forEach(stepKey => {
      disabledConfig[stepKey] = config[stepKey].map(field => ({
        ...field,
        disabled: true,
        inputClassName: 'disabled-field'
      }));
    });
    return disabledConfig;
  };

  const formFields = getDisabledFormFieldsConfig();

  // Get current step fields
  const getCurrentStepFields = () => {
    if (userType === "VESSEL_OWNER") {
      switch (currentStep) {
        case 1: return formFields.step1;
        case 2: return formFields.step2;
        case 3: return formFields.step3;
        default: return [];
      }
    } else {
      switch (currentStep) {
        case 1: return formFields.step1;
        case 2: return formFields.step2;
        default: return [];
      }
    }
  };

  // Stepper titles
  const stepTitles = userType === "VESSEL_OWNER" ? ownerStepTitles : builderStepTitles;

  // Mock: fetch application data
  useEffect(() => {
    setIsLoading(true);
    loaderRef.current?.show?.();
    setTimeout(() => {
      setFormData(applicationData || {}); // Use prop or mock
      setIsLoading(false);
      loaderRef.current?.hide?.();
    }, 500);
  }, [applicationData]);

  // RHF setup
  const methods = useForm({ defaultValues: { country: "India" } });
  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading) {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key]);
        }
      });
    }
  }, [isLoading, formData, setValue]);

  // Approval modal logic
  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };
  const handleActionSubmit = (formData) => {
    const payload = { action: selectedAction, ...formData };
    console.log("Action submitted:", payload);
    setShowApprovalModal(false);
    setSelectedAction("");
  };
  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  // Navigation
  const handleNext = () => {
    if (currentStep < totalSteps) {
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    }
  };
  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };
  const handleBackToList = () => {
    navigate('/user-registration/view');
  };

  // Status badge
  const getStatusBadge = (status) => {
    const statusMap = {
      'Pending Review': 'warning',
      'Approved': 'success',
      'Rejected': 'danger',
      'Processing': 'info'
    };
    return <Badge bg={statusMap[status] || 'secondary'} className="status-badge" text='white'>{status}</Badge>;
  };

  if (isLoading) {
    return <NewLoader ref={loaderRef} />;
  }

  return (
    <Container fluid className="py-4 officer-view-container">
      <Row className="justify-content-center">
        <Col size={12}>
          <Card className="shadow-sm border-0">
            <Card.Header className="bg-white border-bottom-0 py-4">
              <Stack direction="horizontal" gap={3} className="flex-wrap justify-content-between align-items-center">
                <button
                  className="btn back-button"
                  onClick={handleBackToList}
                  style={{
                    fontSize: "0.9rem",
                    left: 0,
                    transform: "translateY(-50%)",
                    textDecoration: "none",
                  }}
                >
                  <FaArrowLeft size={22} color='primary' />
                </button>
                <div className="flex-grow-1 d-flex flex-column align-items-center">
                  <div className="d-flex flex-wrap align-items-center justify-content-center gap-2">
                    <span className="application-label fw-semibold text-muted">Application Number:</span>
                    <span className="application-number px-3 py-1 rounded-pill fw-semibold">
                      {applicationNumber}
                    </span>
                  </div>
                </div>
                <div style={{ width: 160 }}>
                  <span className="ms-2">{getStatusBadge(formData.status || "Pending Review")}</span>
                </div>
              </Stack>
            </Card.Header>
            <Card.Body className="p-4">
              {/* Stepper */}
              <div className="stepper-container mb-5">
                <div className="stepper d-flex justify-content-between">
                  {stepTitles.map((step, idx) => (
                    <React.Fragment key={idx}>
                      <div
                        className={`step ${currentStep >= idx + 1 ? "active" : ""} ${currentStep > idx + 1 ? "completed" : ""} flex-grow-1 text-center`}
                      >
                        <div
                          className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2"
                          style={{
                            width: "60px",
                            height: "60px",
                            borderRadius: "50%",
                            fontSize: "20px",
                            fontWeight: "bold",
                            boxShadow:
                              currentStep >= idx + 1
                                ? "0 5px 15px rgba(0, 119, 182, 0.3)"
                                : "0 4px 10px rgba(0, 0, 0, 0.1)",
                            background:
                              currentStep >= idx + 1
                                ? currentStep > idx + 1
                                  ? "linear-gradient(135deg, #28a745, #20c997)"
                                  : "linear-gradient(135deg, #0077b6, #023e8a)"
                                : "#ffffff",
                            border:
                              currentStep >= idx + 1
                                ? "none"
                                : "2px solid #e9ecef",
                            color:
                              currentStep >= idx + 1 ? "#fff" : "#6c757d",
                            transition: "all 0.4s ease",
                          }}
                        >
                          {currentStep > idx + 1 ? (
                            <FaCheck size={22} />
                          ) : (
                            React.createElement(step.icon, { size: 22 })
                          )}
                        </div>
                        <div
                          className="step-label fw-bold"
                          style={{
                            color:
                              currentStep >= idx + 1
                                ? currentStep > idx + 1
                                  ? "#28a745"
                                  : "#0077b6"
                                : "#6c757d",
                            fontSize: "0.9rem",
                            transition: "all 0.3s ease",
                          }}
                        >
                          {step.title}
                        </div>
                      </div>
                      {idx < stepTitles.length - 1 && (
                        <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                          <div
                            className={`connector-line w-100 ${currentStep > idx + 1 ? "active" : ""}`}
                            style={{
                              height: "4px",
                              background:
                                currentStep > idx + 1
                                  ? "linear-gradient(to right, #28a745, #20c997)"
                                  : "#e9ecef",
                              borderRadius: "2px",
                              transition: "all 0.5s ease",
                            }}
                          ></div>
                        </div>
                      )}
                    </React.Fragment>
                  ))}
                </div>
              </div>
              <FormProvider {...methods}>
                <form>
                  <div className="form-content px-3">
                    <Row className="g-3">
                      <DynamicViewFields
                        fields={getCurrentStepFields()}
                        setFormData={setFormData}
                      />
                    </Row>
                  </div>
                  <div className="d-flex justify-content-between mt-5 pt-4 border-top">
                    <Button
                      variant="outline-primary"
                      onClick={handlePrevious}
                      disabled={currentStep === 1}
                      className="px-4 py-2 d-flex align-items-center"
                    >
                      <FaArrowLeft className="me-2" /> Previous
                    </Button>
                    {currentStep < totalSteps ? (
                      <Button
                        variant="primary"
                        onClick={handleNext}
                        className="px-4 py-2 d-flex align-items-center"
                      >
                        Next <FaArrowRight className="ms-2" />
                      </Button>
                    ) : (
                      <div className="d-flex align-items-center">
                        <ActionDropdown
                          actions={actionsFromAPI}
                          onActionClick={handleActionClick}
                          variant="primary"
                          className="py-2 px-3"
                        />
                      </div>
                    )}
                  </div>
                </form>
              </FormProvider>
            </Card.Body>
          </Card>
        </Col>
      </Row>
      {/* Approval Modal */}
      <ApprovalModal
        show={showApprovalModal}
        handleClose={handleCloseModal}
        handleSubmitData={handleActionSubmit}
        selectedAction={selectedAction}
      />
    </Container>
  );
};

export default UserUnifiedViewPage;
