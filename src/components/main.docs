const collectEntityData = () => {
  const entities = [];
  
  // Collect principal borrowers
  if (claimType === "principalBorrower") {
    entityFields.forEach(entityNum => {
      entities.push({
        id: entityNum,
        name: getValues(`${claimType}Name${entityNum}`) || "",
        address: getValues(`${claimType}Address${entityNum}`) || "",
        type: "PRINCIPAL_BORROWER"
      });
    });
  }
  // Collect guarantors
  else if (claimType === "guarantor") {
    entityFields.forEach(entityNum => {
      entities.push({
        id: entityNum,
        name: getValues(`${claimType}Name${entityNum}`) || "",
        address: getValues(`${claimType}Address${entityNum}`) || "",
        type: "GUARANTOR"
      });
    });
  }
  // Collect beneficiaries
  else if (claimType === "financialDebt") {
    entityFields.forEach(entityNum => {
      entities.push({
        id: entityNum,
        name: getValues(`${claimType}Name${entityNum}`) || "",
        address: getValues(`${claimType}Address${entityNum}`) || "",
        type: "BENEFICIARY"
      });
    });
  }
  
  // Store the entity data in the form
  setValue("entityData", entities, { shouldValidate: false });
  
  return entities;
};
const ClaimTypeFields = ({ 
  claimType, 
  control, 
  register, 
  errors, 
  setValue, 
  getValues, 
  watch,
  trigger
}) => {
  // ... (previous code remains the same until collectEntityData)

  // Function to collect entity data as array of objects with type
  const collectEntityData = () => {
    const entities = [];
    
    // Determine the entity type based on the claim type
    const entityType = 
      claimType === "principalBorrower" ? "PRINCIPAL_BORROWER" :
      claimType === "guarantor" ? "GUARANTOR" :
      "BENEFICIARY";
    
    // Map through all entity fields and create the entity objects
    entityFields.forEach(entityNum => {
      entities.push({
        id: entityNum,
        name: getValues(`${claimType}Name${entityNum}`) || "",
        address: getValues(`${claimType}Address${entityNum}`) || "",
        type: entityType
      });
    });
    
    // Store the entity data in the form
    setValue("entityData", entities, { shouldValidate: false });
    
    return entities;
  };

  // ... (rest of the component remains the same)
};
