useEffect(() => {
  if (isEditMode && employeeData) {
    const professionalDetail = employeeData.professionalDetails?.[0] || {};
    
    reset({
      firstName: getValue(employeeData, "firstName"),
      lastName: getValue(employeeData, "lastName"),
      email: getValue(employeeData, "emailId"),
      phoneNumber: getValue(employeeData, "phoneNumber"),
      gender: getValue(employeeData, "gender"),
      dateOfBirth: getValue(employeeData, "dateOfBirth"),
      addressLine1: getValue(employeeData, "addressLine1"),
      addressLine2: getValue(employeeData, "addressLine2"),
      pin: getValue(employeeData, "pin"),
      district: getValue(employeeData, "district"),
      stateUt: getValue(employeeData, "state"),
      country: getValue(employeeData, "country") || "India",
      appointmentDate: getValue(employeeData, "appointmentDate"),
      employeeType: getValue(employeeData, "employeeType"),
      employeeStatus: getValue(employeeData, "employeeStatus"),
      designation: getValue(employeeData, "designation"),
      department: getValue(employeeData, "department"),
      section: getValue(employeeData, "section"),
      roles: getValue(employeeData, "roles"),
      isActive: getValue(employeeData, "isActive") ?? true,
      educationDetails: Array.isArray(employeeData.educationDetails)
        ? employeeData.educationDetails.map((ed) => ({
            qualification: getValue(ed, "qualification"),
            stream: getValue(ed, "stream"),
            yearOfPassing: getValue(ed, "yearOfPassing"),
            uuid: ed?.uuid || "",
            employeeUUID: ed?.uuid || "",
          }))
        : [{ qualification: "", stream: "", yearOfPassing: "" }],
    });
    
    setToggleValue(getValue(employeeData, "isActive") ?? true);
  } else if (!isEditMode) {
    setToggleValue(true);
  }
}, [isEditMode, reset, employeeData]);
