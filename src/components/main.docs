import React from "react";
import Select from "react-select";
import { Form } from "react-bootstrap";

interface InputSelectProps {
  label: string;
  required?: boolean;
  name: string;
  options: Array<{ value: string | number; label: string }>;
  register?: any;
  errors?: any;
  disabled?: boolean;
  onChange?: (value: string | number | (string | number)[]) => void;
  className?: string;
  style?: React.CSSProperties;
  icon?: React.ElementType;
  value?: any;
  isMulti?: boolean;
  isClearable?: boolean;
}

const InputSelect: React.FC<InputSelectProps> = ({
  label,
  required,
  name,
  options,
  register,
  errors,
  disabled,
  onChange,
  className = "",
  style = {},
  icon: IconComponent,
  value,
  isMulti = false,
  isClearable = false,
}) => {
  const hasError = errors && errors[name];
  const selectedOption = options.find(opt => 
    isMulti 
      ? value?.includes(opt.value) 
      : opt.value === value
  );
  
  const selectedOptions = isMulti 
    ? options.filter(opt => value?.includes(opt.value))
    : undefined;

  const handleChange = (selected: any) => {
    if (isMulti) {
      const values = selected ? selected.map((item: any) => item.value) : [];
      onChange?.(values);
    } else {
      onChange?.(selected?.value || "");
    }
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold d-block">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>

      <div className="position-relative">
        {IconComponent && (
          <div
            className={`input-icon position-absolute ${
              hasError ? "text-danger" : "text-primary"
            }`}
            style={{
              left: "10px",
              top: "50%",
              transform: "translateY(-50%)",
              zIndex: 2,
            }}
          >
            <IconComponent size={18} />
          </div>
        )}

        <Select
          options={options}
          value={isMulti ? selectedOptions : selectedOption}
          onChange={handleChange}
          isDisabled={disabled}
          isMulti={isMulti}
          isClearable={isClearable}
          className={`react-select-container ${hasError ? "is-invalid" : ""}`}
          classNamePrefix="react-select"
          styles={{
            control: (base, state) => ({
              ...base,
              borderColor: hasError ? "#dc3545" : state.isFocused ? "#80bdff" : "#ced4da",
              boxShadow: state.isFocused && !hasError ? "0 0 0 0.2rem rgba(0, 123, 255, 0.25)" : "none",
              paddingLeft: IconComponent ? "40px" : "12px",
              backgroundColor: hasError ? "#fff8f8" : "white",
              minHeight: "calc(1.5em + 1rem + 2px)",
              "&:hover": {
                borderColor: hasError ? "#dc3545" : "#ced4da"
              }
            }),
            menu: (base) => ({
              ...base,
              zIndex: 9999
            })
          }}
        />
      </div>

      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;
//////////
// ... (previous imports remain the same)
import InputSelect from '../../common/InputSelect.tsx';

const VesselOwnerRegistrationPage = () => {
  // ... (previous state and ref declarations remain the same)

  const methods = useForm({
    mode: 'onBlur',
    defaultValues: { 
      ownerCategory: '', 
      country: 'India',
      // Initialize other fields as needed
    }
  });

  const { 
    register, 
    handleSubmit, 
    formState: { errors }, 
    trigger, 
    setValue, 
    getValues, 
    watch, 
    clearErrors, 
    setError,
    control // Add control for react-hook-form integration
  } = methods;

  // ... (other code remains the same until formFields)

  const formFields = {
    step1: [
      {
        name: 'ownerCategory',
        label: 'Category of Owner',
        type: 'select',
        options: [
          { value: '', label: 'Select Category', isDisabled: true },
          ...(masterData?.data?.ownerTypes?.map(type => ({
            value: type.valueCode,
            label: type.valueLabel
          })) || [])
        ],
        required: true,
        icon: FaBuilding,
        colSize: 6,
        validation: { 
          required: 'Owner category is required',
          validate: (value: string) => value !== '' || 'Owner category is required'
        }
      },
      // ... (other fields remain the same)
    ],
    // ... (step2 and step3 fields remain the same)
  };

  // Update the validateStep function
  const validateStep = async () => {
    const currentFields = getCurrentStepFields();
    const requiredFields = currentFields
      .filter(field => field.required && (!field.showIf || field.showIf()));

    // Validate all fields in the current step
    const fieldsToValidate = currentFields
      .filter(field => !field.showIf || field.showIf())
      .map(field => field.name);
    
    const isValid = await trigger(fieldsToValidate);

    // Additional manual validation for react-select fields
    if (isValid) {
      for (const field of requiredFields) {
        if (field.type === 'select') {
          const value = getValues(field.name);
          if (!value || (Array.isArray(value) && value.length === 0)) {
            setError(field.name, {
              type: 'required',
              message: `${field.label} is required`
            });
            return false;
          }
        }
      }
    }

    return isValid;
  };

  // Update the DynamicField component
  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const fieldValue = watch(field.name);

    switch (field.type) {
      case 'select':
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register}
            errors={errors}
            icon={field.icon}
            className="mb-4"
            onChange={(value) => {
              setValue(field.name, value, { shouldValidate: true });
              if (field.onChange) {
                field.onChange({ target: { value } }, setValue, watch);
              }
            }}
            value={fieldValue}
            isClearable={!field.required}
          />
        );
      // ... (other field types remain the same)
    }
  };

  // ... (rest of the component remains the same)
};

export default VesselOwnerRegistrationPage;
//////////////
/* react-select styles */
.react-select-container {
  width: 100%;
  font-size: 1rem;
}

.react-select__control {
  min-height: calc(1.5em + 1rem + 2px) !important;
  border-radius: 8px !important;
  transition: all 0.3s ease !important;
}

.react-select__control--is-focused {
  border-color: #80bdff !important;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25) !important;
}

.react-select__control--is-disabled {
  background-color: #e9ecef !important;
}

.react-select__indicator-separator {
  margin: 8px 0 !important;
}

.react-select__menu {
  z-index: 9999 !important;
}

.is-invalid .react-select__control {
  border-color: #dc3545 !important;
}

.is-invalid .react-select__control--is-focused {
  border-color: #dc3545 !important;
  box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
}
