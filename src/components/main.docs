import React, { useState } from "react";
import { Modal, Button, Container, Row, Col, Table } from "react-bootstrap";
import { FaDownload, FaClipboardList, FaFilePdf, FaBuilding, FaUser, FaIdCard, FaMoneyBillWave, FaUniversity, FaSignature, FaFileAlt } from "react-icons/fa";
import { PDFDownloadLink, Document, Page, Text, View, StyleSheet } from '@react-pdf/renderer';
import PreviewCard from "../../private/stepperForm/common-design/PreviewCard";
import Collapsible from "../../private/stepperForm/common-design/Collapsible";
import "./ApplicationDetailsView.css";


const ApplicationDetailsView = ({ show, onHide, modalData, fullModelData, handleDownload }) => {
  console.log("modalData", modalData);
  const [showDocumentModal, setShowDocumentModal] = useState(false);
  
  // PDF Document component
  const MyDocument = ({ modalData }) => (
    <Document>
      <Page style={styles.page}>
        <View style={styles.section}>
          <Text style={styles.header}>Application Details</Text>
          <Text style={styles.subHeader}>Application Number: {modalData?.applicationNumber || "N/A"}</Text>
          
          {/* Creditor & Identification Details */}
          <Text style={styles.sectionHeader}>Creditor & Identification Details</Text>
          {Object.entries(modalData?.step1?.creditorDetails || {}).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
          ))}
          {Object.entries(modalData?.step1?.identificationDetails || {}).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
          ))}
          
          {/* Financial & Beneficiary Details */}
          <Text style={styles.sectionHeader}>Financial & Beneficiary Details</Text>
          {Object.entries(modalData?.step2?.financialDetails || {}).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
          ))}
          {Object.entries(modalData?.step2?.beneficiaryDetails || {}).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
          ))}
          {Object.entries(modalData?.step2?.addressproofDetails || {}).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
          ))}
          {Object.entries(modalData?.step2?.bankDetails || {}).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
          ))}
          
          {/* Signatory Details */}
          <Text style={styles.sectionHeader}>Signatory Details</Text>
          {Object.entries(modalData?.step3?.signatoryDetails || {}).map(([key, value]) => (
            <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
          ))}
        </View>
      </Page>
    </Document>
  );

  // PDF styles
  const styles = StyleSheet.create({
    page: {
      padding: 30,
    },
    header: {
      fontSize: 24,
      marginBottom: 10,
      textAlign: 'center',
      fontWeight: 'bold',
    },
    subHeader: {
      fontSize: 16,
      marginBottom: 20,
      textAlign: 'center',
    },
    sectionHeader: {
      fontSize: 18,
      marginTop: 15,
      marginBottom: 10,
      fontWeight: 'bold',
      borderBottom: '1 solid #000',
    },
    text: {
      fontSize: 12,
      marginBottom: 5,
    },
    section: {
      marginBottom: 10,
    },
  });

  if (!modalData) return null;

  return (
    <Modal
      show={show}
      onHide={onHide}
      dialogClassName="modal-1110w application-details-modal"
      aria-labelledby="application-details-title"
      centered
    >
      <Modal.Header closeButton className="modal-header">
        <Modal.Title id="application-details-title" className="modal-title">
          <FaFileAlt className="modal-title-icon" />
          Application Details
        </Modal.Title>
      </Modal.Header>
      
      <Modal.Body className="modal-body">
        <div className="application-header-container">
          <div className="application-number-container">
            <h4 className="application-number-label">Application Number:</h4>
            <div className="application-number-value">
              {modalData.applicationNumber || "N/A"}
            </div>
          </div>
          
          <button 
            className="action-button"
            onClick={() => setShowDocumentModal(true)}
            aria-label="View Documents"
          >
            <FaClipboardList />
          </button>
        </div>

        {/* Document Modal */}
        {showDocumentModal && (
          <div className="document-modal">
            <div className="document-modal-content">
              <div className="document-modal-header">
                <h2 className="document-modal-title">
                  Documents for Application
                </h2>
                <button 
                  className="document-modal-close"
                  onClick={() => setShowDocumentModal(false)}
                  aria-label="Close"
                >
                  &times;
                </button>
              </div>

              <Table className="document-table" responsive>
                <thead>
                  <tr>
                    <th style={{ width: "10%" }}>SL #</th>
                    <th style={{ width: "70%" }}>Document Name</th>
                    <th style={{ width: "20%" }}>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>1</td>
                    <td>
                      <div className="document-name">
                        <FaFilePdf className="document-icon" />
                        Full Application Form
                      </div>
                    </td>
                    <td>
                      <PDFDownloadLink 
                        document={<MyDocument modalData={modalData} />} 
                        fileName={`application_${modalData.applicationNumber || 'form'}.pdf`}
                      >
                        {({ loading }) => (
                          <button
                            className="download-button"
                            disabled={loading}
                          >
                            {loading ? 'Generating...' : (
                              <>
                                <FaDownload className="download-icon" />
                                Download
                              </>
                            )}
                          </button>
                        )}
                      </PDFDownloadLink>
                    </td>
                  </tr>
                </tbody>
              </Table>

              <div className="document-modal-footer">
                <Button variant="secondary" onClick={() => setShowDocumentModal(false)}>
                  Close
                </Button>
              </div>
            </div>
          </div>
        )}

        {/* Creditor & Identification Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaUser className="me-2" />
              <span>Creditor & Identification Details</span>
            </div>
          }
          defaultOpen={true}
        >
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaUser className="details-card-title-icon" />
                Creditor Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step1?.creditorDetails && Object.entries(modalData.step1.creditorDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
          
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaIdCard className="details-card-title-icon" />
                Identification Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step1?.identificationDetails && Object.entries(modalData.step1.identificationDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard 
                        title={key} 
                        value={
                          key === "Document Name" && fullModelData?.creditorBasicDetails?.document?.docId ? (
                            <div className="d-flex align-items-center">
                              <span className="me-2">{value}</span>
                              <Button 
                                variant="link" 
                                size="sm" 
                                className="download-btn p-0"
                                onClick={() => handleDownload(
                                  fullModelData.creditorBasicDetails?.document?.docId,
                                  fullModelData.creditorBasicDetails?.document?.docName
                                )}
                              >
                                <FaDownload />
                              </Button>
                            </div>
                          ) : value || "N/A"
                        } 
                      />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
        </Collapsible>

        {/* Financial & Beneficiary Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaMoneyBillWave className="me-2" />
              <span>Financial & Beneficiary Details</span>
            </div>
          }
          defaultOpen={true}
        >
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaMoneyBillWave className="details-card-title-icon" />
                Financial Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.financialDetails && Object.entries(modalData.step2.financialDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
          
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaUser className="details-card-title-icon" />
                Beneficiary Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.beneficiaryDetails && Object.entries(modalData.step2.beneficiaryDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
          
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaIdCard className="details-card-title-icon" />
                Address Proof Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.addressproofDetails && Object.entries(modalData.step2.addressproofDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard 
                        title={key} 
                        value={
                          key === "Address Proof Document" && fullModelData?.claimDetails?.document?.docId ? (
                            <div className="d-flex align-items-center">
                              <span className="me-2">{value}</span>
                              <Button 
                                variant="link" 
                                size="sm" 
                                className="download-btn p-0"
                                onClick={() => handleDownload(
                                  fullModelData.claimDetails?.document?.docId,
                                  fullModelData.claimDetails?.document?.docName
                                )}
                              >
                                <FaDownload />
                              </Button>
                            </div>
                          ) : value || "N/A"
                        } 
                      />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
          
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaUniversity className="details-card-title-icon" />
                Bank Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.bankDetails && Object.entries(modalData.step2.bankDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
        </Collapsible>

        {/* Signatory Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaSignature className="me-2" />
              <span>Signatory Details</span>
            </div>
          }
          defaultOpen={true}
        >
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaSignature className="details-card-title-icon" />
                Signatory Information
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step3?.signatoryDetails && Object.entries(modalData.step3.signatoryDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard 
                        title={key} 
                        value={
                          key === "Signatory Document" && fullModelData?.signatoryDetails?.document?.docId ? (
                            <div className="d-flex align-items-center">
                              <span className="me-2">{value}</span>
                              <Button 
                                variant="link" 
                                size="sm" 
                                className="download-btn p-0"
                                onClick={() => handleDownload(
                                  fullModelData.signatoryDetails?.document?.docId,
                                  fullModelData.signatoryDetails?.document?.docName
                                )}
                              >
                                <FaDownload />
                              </Button>
                            </div>
                          ) : value || "N/A"
                        } 
                      />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
        </Collapsible>
      </Modal.Body>
      
      <Modal.Footer className="modal-footer">
        <Button variant="secondary" onClick={onHide}>
          Close
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default ApplicationDetailsView;

{
    "applicationNumber": "CLAIM/CIRP/20250508/000282",
    "step1": {
        "creditorDetails": {
            "Debtor Name": "sddsd",
            "Creditor Name": "dfdf",
            "Creditor Email": "fdfd@gmail.com",
            "Address": "fddf, fdfd, fdfd, dffdf - 700155"
        },
        "identificationDetails": {
            "Identification Type": "INCORPORATED",
            "Identification Records": "INCORPORATED: fdfd, fdfd",
            "Proof Documents": "identification (pan (1) (1).pdf), identification (pan (1) (1).pdf)"
        }
    },
    "step2": {
        "claimDetails": {
            "Claim Type": "PRINCIPAL_BORROWER",
            "Claim Amount": 3312,
            "Covered by Security Interest": "Yes",
            "Security Value": 4334,
            "Security Date": "2025-05-08",
            "Covered by Guarantee": "Yes",
            "Guarantee Value": 3434,
            "Guarantee Date": "2025-05-08",
            "Guarantor Details": "erre (rere), rere (erre)",
            "Principal Borrower Details": "N/A",
            "Beneficiary Details": "N/A",
            "Debt Incurred Details": "reerrrrrrrrrrrrrrrrrrrrrrrrr",
            "Debt Incurred Date": "2025-05-08",
            "Mutual Dealing Details": "rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr"
        },
        "bankDetails": {
            "Account Number": "3444444444444444",
            "IFSC Code": "BARB0AHMEDN",
            "Bank Name": "Bank of Baroda",
            "Branch Name": "AHMEDNAGAR BRANCH",
            "Branch Address": "AHMEDNAGAR BRANCH,TULSI- VIHAR MANIK CHOWK, AHEMDNAGAR,AHMEDNAGAR,414001, AHMADNAGAR, MAHARASHTRA"
        },
        "supportingDocuments": {
            "Documents Submitted": "pan (pan (1) (1).pdf), passport (pan (1) (1).pdf)"
        }
    },
