const extractAllEnclosures = (formValues) => {
  const enclosures = [];
  
  // Check ALL keys that contain "FileStoreId" for single files
  Object.keys(formValues).forEach(key => {
    if (key.includes('FileStoreId') && !key.includes('_fileStoreId_')) {
      const fileStoreId = formValues[key];
      if (fileStoreId) {
        // Extract base field name
        const baseField = key.replace('FileStoreId', '');
        const fileName = formValues[baseField]?.name || formValues[`${baseField}OriginalName`];
        
        // Map to document type
        const typeMap = {
          'certificateOfRegistration': 'CERTIFICATE_OF_REGISTRATION',
          'NOCfromOriginalRegistrationAuthority': 'NOC_FROM_ORIGINAL_REGISTRATION_AUTHORITY',
          'lastSurveyCertificate': 'LAST_SURVEY_CERTIFICATE',
          'tonnageBooklet': 'TONNAGE_BOOKLET',
          'stabilityBooklet': 'STABILITY_BOOKLET',
          'insuranceCertificate': 'INSURANCE_CERTIFICATE',
          'paymentChallan': 'PAYMENT_CHALLAN'
        };
        
        const docType = typeMap[baseField];
        if (docType) {
          enclosures.push({
            id: "",
            documentName: fileName || `${baseField}.pdf`,
            documentType: docType,
            fileStoreId,
            documentSource: "TRANSFER_ENCLOSURE",
            description: baseField,
            active: true
          });
        }
      }
    }
  });

  // Multi-file documents (keep existing)
  const multiFileTypes = ["DRAWING", "RADIOGRAPHY_REPORT", "MATERIAL_TEST_REPORT", "OTHER_INSPECTION_REPORT", "OTHER_TECH_DOC"];
  
  multiFileTypes.forEach(type => {
    Object.keys(formValues)
      .filter(key => key.startsWith(`${type}_fileStoreId_`))
      .forEach(storeKey => {
        const index = storeKey.split("_").pop();
        const fileStoreId = formValues[storeKey];
        const fileObj = formValues[`${type}_file_${index}`];
        
        if (fileStoreId) {
          enclosures.push({
            id: "",
            documentName: fileObj?.name || `${type}_${index}.pdf`,
            documentType: type,
            fileStoreId,
            documentSource: "TRANSFER_ENCLOSURE",
            description: formValues[`${type}_desc_${index}`] || type,
            active: true
          });
        }
      });
  });

  return enclosures;
};
