import React from "react";
import { Box, Typography, Button, Paper, Stack } from "@mui/material";
import { CheckCircleFill } from "react-bootstrap-icons";
import { useTranslation } from "react-i18next";

const RegistrationSuccess = ({ onClose, registrationId = "VR2024001" }) => {
  const { t } = useTranslation();

  return (
    <Box sx={{ 
      position: "fixed", 
      top: 0, 
      left: 0, 
      width: "100%", 
      height: "100%", 
      backgroundColor: "rgba(0,0,0,0.5)", 
      display: "flex", 
      alignItems: "center", 
      justifyContent: "center",
      zIndex: 9999
    }}>
      <Paper sx={{ 
        padding: "3rem", 
        borderRadius: "1rem", 
        textAlign: "center", 
        maxWidth: "500px",
        margin: "1rem"
      }}>
        <Stack spacing={3} alignItems="center">
          <CheckCircleFill size={80} color="#28a745" />
          
          <Typography variant="h4" sx={{ fontWeight: "bold", color: "#28a745" }}>
            {t("Registration Successful!")}
          </Typography>
          
          <Typography variant="body1" sx={{ color: "#666" }}>
            {t("Your vessel registration has been submitted successfully.")}
          </Typography>
          
          <Box sx={{ 
            backgroundColor: "#f8f9fa", 
            padding: "1rem", 
            borderRadius: "0.5rem",
            width: "100%"
          }}>
            <Typography variant="body2" sx={{ color: "#666", marginBottom: "0.5rem" }}>
              {t("Registration ID")}
            </Typography>
            <Typography variant="h6" sx={{ fontWeight: "bold", color: "#2E57A7" }}>
              {registrationId}
            </Typography>
          </Box>
          
          <Typography variant="body2" sx={{ color: "#666", textAlign: "center" }}>
            {t("You will receive a confirmation email shortly. Please keep your registration ID for future reference.")}
          </Typography>
          
          <Button
            variant="contained"
            onClick={onClose}
            sx={{
              backgroundColor: "#2E57A7",
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "10rem",
              fontSize: "1rem",
              "&:hover": { backgroundColor: "#1f4ea0" }
            }}
          >
            {t("Close")}
          </Button>
        </Stack>
      </Paper>
    </Box>
  );
};

export default RegistrationSuccess;
