const handleDownloadPDF = async () => {
  try {
    const dataForPDF = {
      creditorBasicDetails: formData?.step1?.creditorDetails || {},
      addressDetails: formData?.step1?.creditorDetails || {},
      claimDetails: formData?.step2?.claimDetails || {},
      signatoryDetails: formData?.step3?.signatoryDetails || {}
    };

    const blob = await pdf(<ClaimFormPdf applicationData={dataForPDF} />).toBlob();

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = `Application_${applicationNumber || "claim"}.pdf`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  } catch (error) {
    console.error("Error generating PDF", error);
    alert("An error occurred while generating the PDF. Please try again.");
  }
};
