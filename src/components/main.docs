/* ProvisionalCertificateOfRegistration.module.css */

.certificateContainer {
  background: white;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  margin: 1rem 0;
}

.certificateHeader {
  background: #f8f9fa;
  padding: 1rem;
  border-bottom: 1px solid #dee2e6;
  text-align: center;
}

.certificateTitle {
  color: #2c3e50;
  font-weight: 600;
  font-size: 1.2rem;
  margin: 0;
}

.certificateBody {
  padding: 1.5rem;
}

.formSection {
  margin-bottom: 1.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid #e9ecef;
}

.formSection:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.sectionTitle {
  color: #2c3e50;
  font-weight: 600;
  font-size: 1.1rem;
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid #e9ecef;
}

.subSectionTitle {
  color: #2c3e50;
  font-weight: 600;
  font-size: 1rem;
  margin-bottom: 1rem;
}

.formGroup {
  margin-bottom: 1rem;
}

.formLabel {
  display: block;
  font-weight: 500;
  margin-bottom: 0.5rem;
  color: #495057;
}

.formInput, .formTextarea {
  width: 100%;
  padding: 0.5rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  font-size: 0.9rem;
  transition: border-color 0.15s ease-in-out;
}

.formInput:focus, .formTextarea:focus {
  outline: none;
  border-color: #80bdff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.formTextarea {
  min-height: 100px;
  resize: vertical;
}

.required {
  color: #dc3545;
}

.errorField {
  border-color: #dc3545 !important;
}

.errorMessage {
  color: #dc3545;
  font-size: 0.8rem;
  margin-top: 0.25rem;
}

.issuedBy {
  text-align: center;
  font-style: italic;
  color: #6c757d;
  padding: 0.5rem 0;
}

.responsiveTable {
  overflow-x: auto;
}

.dataTable {
  width: 100%;
  border-collapse: collapse;
}

.dataTable tr {
  border-bottom: 1px solid #e9ecef;
}

.dataTable tr:last-child {
  border-bottom: none;
}

.dataTable td {
  padding: 0.75rem;
  vertical-align: top;
}

.dataTable .label {
  font-weight: 500;
  color: #495057;
  background-color: #f8f9fa;
  width: 20%;
}

.dataTable .value {
  color: #6c757d;
  width: 30%;
}

.dataTable .editable {
  width: 30%;
}

.noteBox {
  background-color: #f8f9fa;
  padding: 1rem;
  border-radius: 4px;
  border-left: 3px solid #6c757d;
}

.noteText {
  margin: 0;
  font-style: italic;
  color: #6c757d;
}

.crewInfo {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem;
  background-color: #f8f9fa;
  border-radius: 4px;
}

.crewLabel {
  font-weight: 500;
  color: #495057;
}

.crewValue {
  font-weight: 600;
  color: #2c3e50;
}

.certificationBox {
  padding: 1rem;
  background-color: #f8f9fa;
  border-radius: 4px;
}

.statementText {
  margin: 0;
  line-height: 1.6;
  color: #495057;
  text-align: justify;
}

.ownerDetails {
  padding: 1rem;
  background-color: #f8f9fa;
  border-radius: 4px;
}

.ownerInfoGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

.ownerInfo {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.infoItem {
  padding: 0.5rem 0;
}

.sharesSection {
  display: flex;
  flex-direction: column;
}

/* Responsive styles */
@media (max-width: 992px) {
  .certificateBody {
    padding: 1rem;
  }
  
  .ownerInfoGrid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
}

@media (max-width: 768px) {
  .dataTable .label,
  .dataTable .value,
  .dataTable .editable {
    display: block;
    width: 100%;
  }
  
  .dataTable tr {
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e9ecef;
  }
  
  .dataTable tr:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  
  .dataTable td {
    padding: 0.5rem;
  }
  
  .crewInfo {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
}

@media (max-width: 576px) {
  .certificateTitle {
    font-size: 1rem;
  }
  
  .sectionTitle {
    font-size: 1rem;
  }
  
  .formSection {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
  }
}
