import React, { useContext, useEffect } from "react";
import Stepper from "./Stepper";
import StepFirst from "./StepFirst";
import StepSecond from "./StepSecond";
import { UserContext } from "../../context/UserContext"; 
import "./MainForm.css";
import StepThird from "./StepThird";
import { useParams } from "react-router-dom";
import ReviewStep from "./ReviewStep";

const CHECKOUT_STEPS = [
  {
    name: "Step 1",
    Component: StepFirst,
  },
  {
    name: "Step 2",
    Component: StepSecond,
  },
  {
    name: "Step 3",
    Component: StepThird,
  },
  {
    name: "Review & Submit",
    Component: ReviewStep,
  },
];

const ClaimForm = () => {
  const { userData, formType } = useContext(UserContext);
  const { claimantType, claimantCategoryType } = userData || {};
  const { id } = useParams();

  useEffect(() => {
    console.log("Claim ID:", id);
    // Fetch claim details based on ID if needed
  }, [id]);

  // Function to determine the form title based on formType from context
  const getFormTitle = () => {
    switch(formType) {
      case "Form C":
        return "PROOF OF CLAIM BY CREDITORS (FORM C)";
      case "Form CA":
        return "PROOF OF CLAIM BY CREDITORS (FORM CA)";
      case "Form B":
        return "PROOF OF CLAIM BY CREDITORS (FORM B)";
      case "Form D":
        return "PROOF OF CLAIM BY CREDITORS (FORM D)";
      case "Form E":
        return "PROOF OF CLAIM BY CREDITORS (FORM E)";
      case "Form F":
        return "PROOF OF CLAIM BY CREDITORS (FORM F)";
      case "Form G":
        return "PROOF OF CLAIM BY CREDITORS (FORM G)";
      default:
        return "PROOF OF CLAIM BY CREDITORS";
    }
  };

  return (
    <div className="main-content">
      <div className="container">
        <div className="row justify-content-center">
          <div className="col-12">
            <div className="card shadow-lg">
              <div className="card-body">
                <h2 className="text-center mb-5 text-formcol">{getFormTitle()}</h2>
                <Stepper stepsConfig={CHECKOUT_STEPS} />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default ClaimForm;
import { createContext, useState, useEffect } from "react";

export const UserContext = createContext(null);

export const UserProvider = ({ children }) => {
  const [userData, setUserData] = useState(() => {
    const storedData = localStorage.getItem("userFormData");
    return storedData ? JSON.parse(storedData) : null;
  });

  const [formType, setFormType] = useState(() => {
    const storedFormType = localStorage.getItem("formType");
    return storedFormType || ""; // Empty string as default
  });

  // Sync userData with localStorage
  useEffect(() => {
    if (userData) {
      localStorage.setItem("userFormData", JSON.stringify(userData));
    } else {
      localStorage.removeItem("userFormData");
    }
  }, [userData]);

  // Sync formType with localStorage
  useEffect(() => {
    if (formType) {
      localStorage.setItem("formType", formType);
    } else {
      localStorage.removeItem("formType");
    }
  }, [formType]);

  const updateFormType = (type) => {
    setFormType(type);
  };

  const updateUserData = (data) => {
    setUserData(data);
  };

  return (
    <UserContext.Provider value={{ 
      userData, 
      setUserData: updateUserData, 
      formType, 
      updateFormType 
    }}>
      {children}
    </UserContext.Provider>
  );
};
