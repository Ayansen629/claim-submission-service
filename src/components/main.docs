/* Survey Tracker Card */
.status-card {
  height: 100%;
  min-height: 220px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  border-left: 4px solid;
  background: #fff;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  padding: 20px;
  position: relative;
}

.icon-wrapper {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.value {
  font-size: 32px;
  font-weight: 700;
  margin: 8px 0;
  line-height: 1;
  color: #333;
}

.title {
  font-size: 15px;
  color: #555;
  margin-bottom: 6px;
  font-weight: 500;
}

.subtitle {
  font-size: 13px;
  color: #888;
  margin-bottom: 10px;
}

.calendar-container {
  margin-top: 10px;
  height: 160px; /* Fixed height for calendar */
  overflow: hidden;
}

/* Calendar Styling */
.survey-calendar {
  width: 100% !important;
  font-family: inherit !important;
  border: none !important;
}

.survey-calendar .react-datepicker__month-container {
  width: 100%;
  padding: 0;
}

.survey-calendar .react-datepicker__header {
  background: transparent;
  border-bottom: none;
  padding: 0;
}

.survey-calendar .react-datepicker__day-names {
  display: flex;
  justify-content: space-between;
  margin-top: 4px;
}

.survey-calendar .react-datepicker__day-name {
  width: 24px;
  color: #666;
  font-size: 11px;
  font-weight: 500;
}

.survey-calendar .react-datepicker__month {
  margin: 4px 0 0 0;
}

.survey-calendar .react-datepicker__week {
  display: flex;
  justify-content: space-between;
  margin: 4px 0;
}

.survey-calendar .react-datepicker__day {
  width: 24px;
  height: 24px;
  margin: 0;
  font-size: 11px;
  line-height: 24px;
}

.survey-calendar .react-datepicker__day--today {
  font-weight: bold;
  color: #2466BF;
}

.survey-calendar .react-datepicker__day--selected {
  background-color: #6f42c1;
  color: white;
}

.day-container {
  position: relative;
  height: 100%;
}

.day-number {
  font-size: 11px;
}

.event-indicators {
  position: absolute;
  bottom: 0;
  display: flex;
  justify-content: center;
  width: 100%;
  gap: 2px;
}

.event-indicator {
  width: 4px;
  height: 4px;
  border-radius: 50%;
}
