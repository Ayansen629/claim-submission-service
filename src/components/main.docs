const [generatedCertificates, setGeneratedCertificates] = useState({
  survey: false,
  registration: false
});

useEffect(() => {
  if (!id) return;

  const fetchRegistrationDetails = async () => {
    try {
      loaderRef.current?.show();
      const payload = { applicationNumbers: [id ?? ""] };
      const apiUrl = `${SERVICE_BASE.IWT_REGISTRATION}${URLS_ENDPOINT.USER_SERVICE.REGISTRATION_SEARCH_BY_ID}`;
      const { status, data } = await postData(apiUrl, payload);

      if (status !== 200) {
        toast.error("Unable to fetch registration details.");
        return;
      }

      const resData = data?.data?.[0] ?? {};
      const {
        basicDetails = {},
        vesselDetails = {},
        engineDetails = {},
        processActionMapResponce = [],
      } = resData;

      // Set certificate generation status from API response
      setGeneratedCertificates({
        survey: basicDetails?.isProvSurveyCertificateGenerated || false,
        registration: basicDetails?.isProvisionaCertificate || false
      });

      // ... rest of your existing code ...

      if (isOfficerLogin) {
        const actionsItems =
          processActionMapResponce?.[0]?.processs?.[0]?.actions ?? [];
        if (actionsItems?.length > 0) {
          setActionsFromAPI(actionsItems);
        }
      }

      setRegistrationData(normalizedData);
    } catch (err) {
      loaderRef.current?.hide();
      console.error("Failed to fetch registration details:", err);
      toast.error("Failed to fetch registration details.");
    }
  };

  fetchRegistrationDetails();
}, [id]);

// Updated actionDropdown with certificate visibility logic
const actionDropdown =
  isViewMode && isOfficerLogin && actionsFromAPI?.length > 0 ? (
    <>
      <div
        style={{
          display: "flex",
          gap: "8px",
          alignItems: "center",
          flexWrap: "wrap",
        }}
      >
        {/* Certificate Buttons - Only show if not generated */}
        {userRole === USER_ROLES?.OFFICER_L3 && showOfficerActions && (
          <>
            {!generatedCertificates.survey && (
              <Button
                variant="contained"
                onClick={() => handleProvisionModalOpen("survey")}
                data-tooltip-id="survey-cert-tooltip"
                data-tooltip-content="Generate Provisional Certificate of Survey for vessel inspection"
                style={{
                  background: "#10b981",
                  color: "#fff",
                  fontWeight: "600",
                  borderRadius: "6px",
                  fontSize: "0.75rem",
                  padding: "6px 12px",
                  height: "32px",
                  minWidth: "100px",
                  maxWidth: "100px",
                  textTransform: "none",
                  border: "none",
                  boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
                  transition: "all 0.2s ease",
                  whiteSpace: "nowrap",
                  overflow: "hidden",
                  textOverflow: "ellipsis",
                }}
              >
                Survey Certificate
              </Button>
            )}

            {!generatedCertificates.registration && (
              <Button
                variant="contained"
                onClick={() => handleProvisionModalOpen("registration")}
                data-tooltip-id="reg-cert-tooltip"
                data-tooltip-content="Generate Provisional Certificate of Registration for vessel registry"
                style={{
                  background: "#10b981",
                  color: "#fff",
                  fontWeight: "600",
                  borderRadius: "6px",
                  fontSize: "0.75rem",
                  padding: "6px 12px",
                  height: "32px",
                  minWidth: "100px",
                  maxWidth: "100px",
                  textTransform: "none",
                  border: "none",
                  boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
                  transition: "all 0.2s ease",
                  whiteSpace: "nowrap",
                  overflow: "hidden",
                  textOverflow: "ellipsis",
                }}
              >
                Registry Certificate
              </Button>
            )}
          </>
        )}

        {/* Save Button */}
        <Button
          variant="contained"
          onClick={() =>
            handleFormSubmit({
              index: 1,
              getFormData: () => methods?.getValues(),
            })
          }
          data-tooltip-id="save-tooltip"
          data-tooltip-content="Save current form data and changes"
          style={{
            backgroundColor: "#2E57A7",
            fontWeight: "600",
            borderRadius: "6px",
            fontSize: "0.75rem",
            color: "#fff",
            padding: "6px 12px",
            height: "32px",
            minWidth: "80px",
            maxWidth: "80px",
            textTransform: "none",
            boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
            transition: "all 0.2s ease",
          }}
        >
          Save
        </Button>

        {/* Action Dropdown */}
        <ActionDropdown
          actions={actionsFromAPI}
          onActionClick={handleWorkflowActionClick}
        />
      </div>

      {/* Tooltips remain the same */}
    </>
  ) : null;
