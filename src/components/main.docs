import React from "react";
import { Box, Typography, Stack } from "@mui/material";
import { Card, Row, Col, Table, Button } from "react-bootstrap";
import { BsFileEarmarkPdf, BsDownload } from "react-icons/bs";
import { useTranslation } from "react-i18next";

const VesselRegistrationPreview = ({ formData, supervisionAuthority }) => {
  const { t } = useTranslation();

  const handleDownload = (fileName) => {
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
  };

  const DocumentCard = ({ fileName, description, fileSize }) => (
    <Card className="mb-2 border-0 shadow-sm">
      <Card.Body className="p-3">
        <div className="d-flex justify-content-between align-items-center">
          <div className="d-flex align-items-center flex-grow-1">
            <div className="bg-danger bg-opacity-10 rounded-circle p-2 me-3">
              <BsFileEarmarkPdf className="text-danger" size={20} />
            </div>
            <div className="flex-grow-1">
              <h6 className="mb-1 text-primary fw-semibold" style={{ fontSize: "0.9rem" }}>
                {fileName}
              </h6>
              <p className="mb-0 text-muted small">
                {description}
                {fileSize && (
                  <span className="ms-2 badge bg-light text-dark">
                    {(fileSize / 1024 / 1024).toFixed(1)} MB
                  </span>
                )}
              </p>
            </div>
          </div>
          <Button
            variant="outline-primary"
            size="sm"
            onClick={() => handleDownload(fileName)}
            className="rounded-pill"
          >
            <BsDownload size={14} />
          </Button>
        </div>
      </Card.Body>
    </Card>
  );

  const FileSection = ({ title, type }) => {
    const filesWithData = [];
    
    for (let i = 1; i <= 50; i++) {
      const fileData = formData[`${type}_file_${i}`];
      if (fileData && fileData.name) {
        filesWithData.push({
          id: i,
          fileData,
          descData: formData[`${type}_desc_${i}`]
        });
      }
    }

    return (
      <Card className="h-100 shadow-sm border-0">
        <Card.Header className="bg-light border-0 py-3">
          <div className="d-flex justify-content-between align-items-center">
            <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
              <BsFileEarmarkPdf className="text-primary me-2" />
              <span>{title}</span>
            </h5>
            <span className="badge bg-primary rounded-pill">
              {filesWithData.length} files
            </span>
          </div>
        </Card.Header>

        <Card.Body className="p-0">
          <div style={{ maxHeight: "500px", overflowY: "auto" }} className="p-3">
            {filesWithData.length > 0 ? (
              filesWithData.map((file) => (
                <DocumentCard
                  key={file.id}
                  fileName={file.fileData.name}
                  description={file.descData || `${title} document ${file.id}`}
                  fileSize={file.fileData.size}
                />
              ))
            ) : (
              <div className="text-center py-5 text-muted">
                <div className="bg-light rounded-circle p-4 d-inline-flex mb-3">
                  <BsFileEarmarkPdf size={48} className="opacity-50" />
                </div>
                <p className="mb-0">No files uploaded</p>
              </div>
            )}
          </div>
        </Card.Body>
      </Card>
    );
  };

  const SingleFileSection = ({ title, fieldName }) => (
    <Card className="h-100 shadow-sm border-0">
      <Card.Header className="bg-light border-0 py-3">
        <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
          <BsFileEarmarkPdf className="text-warning me-2" />
          <span>{title}</span>
        </h5>
      </Card.Header>
      <Card.Body className="p-3">
        {formData[fieldName] ? (
          <DocumentCard
            fileName={formData[fieldName].name}
            description={`${title} document`}
            fileSize={formData[fieldName].size}
          />
        ) : (
          <div className="text-center py-4 text-muted">
            <div className="bg-light rounded-circle p-4 d-inline-flex mb-3">
              <BsFileEarmarkPdf size={32} className="opacity-50" />
            </div>
            <p className="mb-0">No file uploaded</p>
          </div>
        )}
      </Card.Body>
    </Card>
  );

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      <Stack spacing={0.5}>
        <Typography
          sx={{
            fontWeight: 550,
            color: "#2E57A7",
            fontSize: "1.2rem",
          }}
        >
          {t("Vessel Registration Preview")}
          &nbsp;
          <span style={{ color: "#666", fontSize: "0.65rem" }}>
            {t("(Review all vessel registration details before submission)")}
          </span>
        </Typography>
      </Stack>

      <div className="container py-4">
        {/* Owner Details Section */}
        <Card className="mb-4 shadow-sm">
          <Card.Header className="bg-light">
            <h5 className="mb-0 text-primary fw-bold">{t("Owner Details")}</h5>
          </Card.Header>
          <Card.Body>
            <Row>
              {[
                { name: 'ownerName', label: t('Name of Owner'), md: 4 },
                { name: 'ownerAddress', label: t('Address of Owner'), md: 4 },
                { name: 'mobile', label: t('Mobile'), md: 4 },
                { name: 'email', label: t('Email Id'), md: 4 },
                { name: 'pan', label: t('PAN'), md: 4 },
                { name: 'aadhar', label: t('Aadhar'), md: 4 },
                { name: 'tradeLicence', label: t('Trade Licence'), md: 4 },
                { name: 'gst', label: t('GST'), md: 4 },
              ].map((field) => (
                <Col key={field.name} md={field.md}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{field.label}</label>
                    <div className="form-control bg-light">{formData[field.name] || 'N/A'}</div>
                  </div>
                </Col>
              ))}
            </Row>
          </Card.Body>
        </Card>

        {/* Vessel Details Section */}
        <Card className="mb-4 shadow-sm">
          <Card.Header className="bg-light">
            <h5 className="mb-0 text-primary fw-bold">{t("Vessel Details")}</h5>
          </Card.Header>
          <Card.Body>
            <Row>
              {[
                { name: 'grt', label: t('Gross Tonnage (GRT)'), md: 4 },
                { name: 'workOrderValue', label: t('Work Order Value'), md: 4 },
                { 
                  name: 'vesselType', 
                  label: t('Type of Vessel'), 
                  md: 4,
                  transform: (val) => val === "new" ? t("New Vessel") : t("Old Vessel")
                },
                { 
                  name: 'category', 
                  label: t('Category'), 
                  md: 4,
                  transform: (val) => {
                    if (val === "A") return t("Category A");
                    if (val === "B") return t("Category B");
                    return t("Category C");
                  }
                },
                { 
                  name: 'zone', 
                  label: t('Zone'), 
                  md: 4,
                  transform: (val) => {
                    if (val === "1") return t("Zone 1");
                    if (val === "2") return t("Zone 2");
                    return t("Zone 3");
                  }
                },
                { 
                  name: 'supervisionAuthority', 
                  label: t('Supervision Authority'), 
                  md: 4,
                  transform: (val) => val === "iwt" ? t("IWT") : t("Classification Society")
                },
                { 
                  name: 'purchaseType', 
                  label: t('Purchase Type'), 
                  md: 4,
                  transform: (val) => val === "new" ? t("New") : t("Used")
                },
                { name: 'classificationSociety', label: t('Name of the Classification Society'), md: 4 },
                { 
                  name: 'constructedBy', 
                  label: t('Constructed By'), 
                  md: 4,
                  transform: (val) => val === "1" ? t("Self") : t("Builder")
                },
                ...(formData.constructedBy === "2" ? [
                  { 
                    name: 'builder', 
                    label: t('Builder'), 
                    md: 4,
                    transform: (val) => val === "builder1" ? t("Builder 1") : t("Builder 2")
                  }
                ] : [])
              ].map((field) => (
                <Col key={field.name} md={field.md}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{field.label}</label>
                    <div className="form-control bg-light">
                      {field.transform ? field.transform(formData[field.name]) : formData[field.name] || 'N/A'}
                    </div>
                  </div>
                </Col>
              ))}
            </Row>
          </Card.Body>
        </Card>

        {/* Builder Details Section (conditionally rendered) */}
        {formData.constructedBy === "2" && (
          <Card className="mb-4 shadow-sm">
            <Card.Header className="bg-light">
              <h5 className="mb-0 text-primary fw-bold">{t("Builder Details")}</h5>
            </Card.Header>
            <Card.Body>
              <Row>
                {[
                  { name: 'builderName', label: t('Builder Name'), md: 4 },
                  { name: 'builderAddress', label: t('Builder Address'), md: 4 },
                  { name: 'builderEmail', label: t('Builder Email Id'), md: 4 },
                  { name: 'builderMobile', label: t('Mobile'), md: 4 },
                  { name: 'builderTradeLicence', label: t('Trade Licence'), md: 4 },
                  { name: 'builderGST', label: t('GST'), md: 4 },
                  { 
                    name: 'builderAuth', 
                    label: t('Builder Authorization'), 
                    md: 4,
                    transform: (val) => val === "auth" ? t("Authorized") : t("Rejected")
                  },
                ].map((field) => (
                  <Col key={field.name} md={field.md}>
                    <div className="mb-3">
                      <label className="form-label fw-semibold">{field.label}</label>
                      <div className="form-control bg-light">
                        {field.transform ? field.transform(formData[field.name]) : formData[field.name] || 'N/A'}
                      </div>
                    </div>
                  </Col>
                ))}
                <Col md={8}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Authorization Letter")}</label>
                    {formData.authLetter ? (
                      <DocumentCard 
                        fileName={formData.authLetter.name} 
                        fileSize={formData.authLetter.size} 
                      />
                    ) : (
                      <div className="text-muted">No file uploaded</div>
                    )}
                  </div>
                </Col>
              </Row>
            </Card.Body>
          </Card>
        )}

        {/* Documents Section */}
        <Card className="mb-4 shadow-sm">
          <Card.Header className="bg-light">
            <h5 className="mb-0 text-primary fw-bold">{t("Documents")}</h5>
          </Card.Header>
          <Card.Body>
            <Row className="g-4">
              <Col lg={6} md={12}>
                <FileSection
                  title={t("Work Order")}
                  type="workOrder"
                />
              </Col>

              <Col lg={6} md={12}>
                <FileSection
                  title={t("Drawings")}
                  type="drawings"
                />
              </Col>

              <Col md={6}>
                <SingleFileSection
                  title={t('Tonnage Booklets')}
                  fieldName="tonnageBooklets"
                />
              </Col>

              <Col md={6}>
                <SingleFileSection
                  title={t('Stability Booklets')}
                  fieldName="stabilityBooklets"
                />
              </Col>

              <Col md={12}>
                <Card className="shadow-sm border-0">
                  <Card.Body className="p-4">
                    <div className="d-flex align-items-start">
                      <input
                        type="checkbox"
                        id="termsAccepted"
                        className="me-3 mt-1"
                        checked={formData.termsAccepted}
                        disabled
                      />
                      <div>
                        <label
                          htmlFor="termsAccepted"
                          className="mb-0 fw-medium"
                          style={{ color: "#333", cursor: "default", lineHeight: "1.5" }}
                        >
                          {t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.')}
                        </label>
                      </div>
                    </div>
                  </Card.Body>
                </Card>
              </Col>
            </Row>
          </Card.Body>
        </Card>

        {/* Payment Details Section */}
        <Card className="mb-4 shadow-sm">
          <Card.Header className="bg-light">
            <h5 className="mb-0 text-primary fw-bold">{t("Payment Details")}</h5>
          </Card.Header>
          <Card.Body>
            {supervisionAuthority === "iwt" && (
              <Row className="justify-content-center">
                <Col md={8}>
                  <Table bordered responsive className="mb-0">
                    <thead>
                      <tr>
                        <th>{t("Payment")}</th>
                        <th>{t("Fee Structure")}</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>{t("Drawing Approval Fee")}</td>
                        <td>
                          {t("Rs. 0.1% of the work order value")}<br />
                          <span style={{ color: "#888" }}>{t("Minimum Rs. 500/- + GST")}</span>
                        </td>
                      </tr>
                      <tr>
                        <td>{t("Supervision Fee")}</td>
                        <td>
                          <div>
                            {t("1% of the Contract Price up to 10 lac")}<br />
                            <span style={{ color: "#888" }}>{t("(Minimum Rs. 1000)")}</span>
                          </div>
                          <div className="mt-2">
                            {t("Above Rs. 10 lac to 40 lac:")} <br />
                            <span style={{ color: "#2466BF" }}>{t("Rs. 10,000/- + ½% of the cost above 10 lac")}</span>
                          </div>
                          <div className="mt-2">
                            {t("Above Rs. 40 lac:")} <br />
                            <span style={{ color: "#2466BF" }}>{t("Rs. 25,000/- + ¼% of the cost above 40 lac")}</span>
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </Table>
                </Col>
              </Row>
            )}
            {supervisionAuthority === "classificationSociety" && (
              <Row className="justify-content-center">
                <Col md={8}>
                  <Table bordered responsive className="mb-0">
                    <thead>
                      <tr>
                        <th>{t("Payment")}</th>
                        <th>{t("Fee Structure")}</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>{t("Drawing Scrutiny Fee")}</td>
                        <td>
                          {t("0.05% of the work order value")}<br />
                          <span style={{ color: "#888" }}>{t("Minimum Rs. 500/-")}</span>
                        </td>
                      </tr>
                    </tbody>
                  </Table>
                </Col>
              </Row>
            )}
          </Card.Body>
        </Card>
      </div>
    </Box>
  );
};

export default VesselRegistrationPreview;
