const actionDropdown =
  isViewMode && isOfficerLogin && actionsFromAPI?.length > 0 ? (
    <div style={{ display: "flex", gap: "6px", alignItems: "center", flexWrap: "wrap" }}>
      {/* Save Button - First */}
      <Button
        variant="contained"
        onClick={() => handleFormSubmit({ index: 1, getFormData: () => methods?.getValues() })}
        style={{
          backgroundColor: "#2E57A7",
          fontWeight: "600",
          borderRadius: "6px",
          fontSize: "0.75rem",
          color: "#fff",
          padding: "6px 16px",
          minHeight: "28px",
          minWidth: "4rem",
          textTransform: "none",
          boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
          transition: "all 0.2s ease",
        }}
        onMouseEnter={(e) => {
          e.target.style.backgroundColor = "#1f4ea0";
          e.target.style.transform = "translateY(-1px)";
          e.target.style.boxShadow = "0 2px 6px rgba(46, 87, 167, 0.3)";
        }}
        onMouseLeave={(e) => {
          e.target.style.backgroundColor = "#2E57A7";
          e.target.style.transform = "translateY(0)";
          e.target.style.boxShadow = "0 1px 3px rgba(0,0,0,0.12)";
        }}
      >
        Save
      </Button>
      
      {/* Provisional Certificate Buttons */}
      {userRole === USER_ROLES?.OFFICER_L3 && showOfficerActions && (
        <>
          <Button
            variant="contained"
            onClick={() => handleProvisionModalOpen("survey")}
            style={{
              background: "linear-gradient(135deg, #10b981 0%, #059669 100%)",
              color: "#fff",
              fontWeight: "500",
              borderRadius: "4px",
              fontSize: "0.65rem",
              padding: "4px 8px",
              minHeight: "24px",
              minWidth: "3rem",
              textTransform: "none",
              border: "none",
              boxShadow: "0 1px 2px rgba(0,0,0,0.1)",
              transition: "all 0.2s ease",
            }}
            onMouseEnter={(e) => {
              e.target.style.background = "linear-gradient(135deg, #059669 0%, #047857 100%)";
              e.target.style.transform = "translateY(-1px)";
              e.target.style.boxShadow = "0 2px 4px rgba(16, 185, 129, 0.3)";
            }}
            onMouseLeave={(e) => {
              e.target.style.background = "linear-gradient(135deg, #10b981 0%, #059669 100%)";
              e.target.style.transform = "translateY(0)";
              e.target.style.boxShadow = "0 1px 2px rgba(0,0,0,0.1)";
            }}
          >
            Survey
          </Button>
          <Button
            variant="contained"
            onClick={() => handleProvisionModalOpen("registration")}
            style={{
              background: "linear-gradient(135deg, #10b981 0%, #059669 100%)",
              color: "#fff",
              fontWeight: "500",
              borderRadius: "4px",
              fontSize: "0.65rem",
              padding: "4px 8px",
              minHeight: "24px",
              minWidth: "3rem",
              textTransform: "none",
              border: "none",
              boxShadow: "0 1px 2px rgba(0,0,0,0.1)",
              transition: "all 0.2s ease",
            }}
            onMouseEnter={(e) => {
              e.target.style.background = "linear-gradient(135deg, #059669 0%, #047857 100%)";
              e.target.style.transform = "translateY(-1px)";
              e.target.style.boxShadow = "0 2px 4px rgba(16, 185, 129, 0.3)";
            }}
            onMouseLeave={(e) => {
              e.target.style.background = "linear-gradient(135deg, #10b981 0%, #059669 100%)";
              e.target.style.transform = "translateY(0)";
              e.target.style.boxShadow = "0 1px 2px rgba(0,0,0,0.1)";
            }}
          >
            Register
          </Button>
        </>
      )}
      
      {/* Action Dropdown - Last */}
      <ActionDropdown
        actions={actionsFromAPI}
        onActionClick={handleWorkflowActionClick}
        variant="contained"
        sx={{
          backgroundColor: "#2E57A7",
          fontWeight: "600",
          borderRadius: "6px",
          fontSize: "0.75rem",
          color: "#fff",
          minHeight: "28px",
          minWidth: "4rem",
          textTransform: "none",
          boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
          "&:hover": {
            backgroundColor: "#1f4ea0",
            transform: "translateY(-1px)",
            boxShadow: "0 2px 6px rgba(46, 87, 167, 0.3)",
          },
        }}
      />
    </div>
  ) : null;
