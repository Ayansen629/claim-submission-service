import React, { useState, useEffect, useRef } from "react";
import { useForm, useFieldArray } from "react-hook-form";
import { Row, Col, Button, Card } from "react-bootstrap";
import InputText from "../../../../common/InputText.tsx";
import InputFile from "../../../../common/InputFile.tsx";
import Collapsible from "../../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import {
  FaShip,
  FaCog,
  FaFileUpload,
  FaPlus,
  FaTrash,
  FaClipboardList,
  FaDownload,
  FaTimesCircle,
} from "react-icons/fa";
import { BsFileEarmarkPdf } from "react-icons/bs";
import { useMasterData } from "../../../../context/MasterDataContext.js";
import { toast } from "react-toastify";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import { BASE_IP, URLS_ENDPOINT } from "../../../../../utils/urlsConstants.ts";
import axios from "axios";
import { postFORMdata } from "../../../../../services/http.service.ts";
import NewLoader from "../../../../common/NewLoader.js";
import MultiFile from "../../../../common/MultiFile.js";

const RequestApplication = ({
  formMethods,
  viewMode = false,
  editMode = false,
  registrationData,
  initialData
}) => {
  const { t } = useTranslation();
  const { masterData } = useMasterData();
  const loaderRef = useRef();

  const [otherTechnicalDocumentFiles, setOtherTechnicalDocumentFiles] = useState([{ id: 1 }]);
  const [fileStates, setFileStates] = useState({
    certificateOfRegistration: null,
    alterationDrawings: null,
    existingApprovedDrawings: null,
    updatedStabilityBooklet: null,
    existingTonnageBooklet: null,
    updatedTonnageBooklet: null,
    existingStabilityBooklet: null,
    newInsuranceCertificate: null,
    lastSurveyCertificate: null,
    workOrder: null,
    insuranceCertificate: null,
  });

  const internalFormMethods = useForm({
    mode: "onTouched",
  });

  const methods = formMethods || internalFormMethods;
  const {
    register,
    watch,
    setValue,
    clearErrors,
    formState: { errors },
    unregister,
  } = methods;

  const { fields, append, remove } = useFieldArray({
    control: methods.control,
    name: "alterationDetails.alterations",
  });

  useEffect(() => {
    if (fields.length === 0 && !initialData?.AlterationDetails) {
      append({
        description: "",
        reason: "",
        proposedDate: "",
      });
    }
  }, [fields.length, append, initialData]);

  // Auto-populate vessel data from registration
  useEffect(() => {
    if (!registrationData) return;

    const mapping = {
      // Basic Vessel Info
      "basicVesselInfo.officialNo": registrationData.vessel?.registrationNo,
      "basicVesselInfo.portOfRegistry": registrationData.vessel?.portOfRegistry,
      "basicVesselInfo.nameOfVessel": registrationData.vessel?.vesselName,
      "basicVesselInfo.nameOfOwner": registrationData.owner?.name,
      "basicVesselInfo.addressOfOwner": registrationData.owner?.address,
      "basicVesselInfo.ownerTelephone": registrationData.owner?.mobile,
      "basicVesselInfo.typeOfVessel": registrationData.vessel?.type,
      "basicVesselInfo.categoryOfVessel": registrationData.vessel?.category,
      "basicVesselInfo.dateOfRegistry": registrationData.vessel?.dateOfRegistry,
      "basicVesselInfo.length": registrationData.vessel?.length,
      "basicVesselInfo.breadth": registrationData.vessel?.breadth,
      "basicVesselInfo.depth": registrationData.vessel?.depth,
      "basicVesselInfo.draft": registrationData.vessel?.draft,
      "basicVesselInfo.grossTonnage": registrationData.vessel?.grt,
      "basicVesselInfo.netTonnage": registrationData.vessel?.nrt,
      "basicVesselInfo.placeOfLastSurvey": registrationData.vessel?.placeOfLastSurvey,
      "basicVesselInfo.dateOfLastSurvey": registrationData.vessel?.dateOfLastSurvey,
      "basicVesselInfo.yearOfBuild": registrationData.vessel?.yearOfBuild,
      "basicVesselInfo.nameOfBuilder": registrationData.builder?.name,
      "basicVesselInfo.addressOfBuilder": registrationData.builder?.address,
      "basicVesselInfo.builderMobile": registrationData.builder?.mobile,
      "basicVesselInfo.builderEmail": registrationData.builder?.email,
      "basicVesselInfo.tradeLicense": registrationData.builder?.tradeLicense,
      "basicVesselInfo.gst": registrationData.builder?.gst,

      // Hull Particulars
      "hullParticulars.hullMaterial": registrationData.hull?.material,
      "hullParticulars.hullPlattingMaterial": registrationData.hull?.plattingMaterial,
      "hullParticulars.hullPlattingThickness": registrationData.hull?.plattingThickness,
      "hullParticulars.noOfBulkheads": registrationData.hull?.noOfBulkheads,
      "hullParticulars.bulkheadPlacement": registrationData.hull?.bulkheadPlacement,
      "hullParticulars.bulkheadThickness": registrationData.hull?.bulkheadThickness,
      "hullParticulars.frameMaterial": registrationData.hull?.frameMaterial,
      "hullParticulars.frameThickness": registrationData.hull?.frameThickness,
      "hullParticulars.floorMaterial": registrationData.hull?.floorMaterial,
      "hullParticulars.floorThickness": registrationData.hull?.floorThickness,

      // Engine Details
      "detailsOfPropulsion.typeOfEngine": registrationData.engine?.type,
      "detailsOfPropulsion.engineMake": registrationData.engine?.make,
      "detailsOfPropulsion.engineMakerAddress": registrationData.engine?.makerAddress,
      "detailsOfPropulsion.modelNo": registrationData.engine?.modelNo,
      "detailsOfPropulsion.numberOfEngine": registrationData.engine?.numberOfEngine,
      "detailsOfPropulsion.yearOfMake": registrationData.engine?.yearOfMake,
      "detailsOfPropulsion.horsepower": registrationData.engine?.horsepower,
      "detailsOfPropulsion.speedRPM": registrationData.engine?.speed,
      "detailsOfPropulsion.strokeEngine": registrationData.engine?.stroke,
      "detailsOfPropulsion.numberOfSetFitted": registrationData.engine?.numberOfSetFitted,
      "detailsOfPropulsion.setSrNo": registrationData.engine?.setSrNo,
      "detailsOfPropulsion.engineCylinderDiameter": registrationData.engine?.cylinderDiameter,
      "detailsOfPropulsion.propellerType": registrationData.engine?.propellerType,
      "detailsOfPropulsion.gearType": registrationData.engine?.gearType,
      "detailsOfPropulsion.noOfGear": registrationData.engine?.noOfGear,
      "detailsOfPropulsion.vesselSpeed": registrationData.engine?.vesselSpeed,
      "detailsOfPropulsion.revolutionMints": registrationData.engine?.revolutionMints,
      "detailsOfPropulsion.cylindersPerSetRotary": registrationData.engine?.cylindersPerSetRotary,
      "detailsOfPropulsion.cylindersPerSetReciprocating": registrationData.engine?.cylindersPerSetReciprocating,
      "detailsOfPropulsion.noOfShaft": registrationData.engine?.noOfShaft,
      "detailsOfPropulsion.lengthOfEngineRoom": registrationData.engine?.lengthOfEngineRoom,
    };

    Object.entries(mapping).forEach(([key, value]) => {
      if (value != null) setValue(key, value);
    });
  }, [registrationData, setValue]);

  const handleFileChange = async (e, documentType) => {
    if (viewMode) return;
    const file = e?.target?.files[0];
    if (!file) return;

    const maxSize = 10 * 1024 * 1024;
    if (file.size > maxSize) {
      toast.error("File size must be less than or equal to 10 MB.");
      e.target.value = null;
      return;
    }

    loaderRef.current?.show();

    try {
      const formData = new FormData();
      formData.append("file", file);

      const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
      const response = await postFORMdata(uploadUrl, formData);

      const fileStoreId = response?.data?.files[0]?.fileStoreId;

      if (fileStoreId) {
        const fileExtension = file.name.substring(file.name.lastIndexOf("."));

        const getStandardizedFileName = (docType, extension) => {
          const baseNames = {
            certificateOfRegistration: "Certificate of Registration",
            alterationDrawings: "Alteration Drawings",
            existingApprovedDrawings: "Existing Approved Drawings",
            updatedStabilityBooklet: "Updated Stability Booklet",
            existingTonnageBooklet: "Existing Tonnage Booklet",
            updatedTonnageBooklet: "Updated Tonnage Booklet",
            existingStabilityBooklet: "Existing Stability Booklet",
            newInsuranceCertificate: "New Insurance Certificate",
            lastSurveyCertificate: "Last Survey Certificate",
            workOrder: "Work Order",
            insuranceCertificate: "Insurance Certificate",
          };
          return `${baseNames[docType] || docType}${extension}`;
        };

        const standardizedName = getStandardizedFileName(documentType, fileExtension);

        const displayFile = new File([file], standardizedName, {
          type: file.type,
        });

        setFileStates((prev) => ({
          ...prev,
          [documentType]: {
            name: standardizedName,
            fileStoreId,
            originalName: file.name,
            displayFile: displayFile,
          },
        }));

        setValue(`enclosure.${documentType}`, displayFile);
        setValue(`enclosure.${documentType}FileStoreId`, fileStoreId);
        setValue(`enclosure.${documentType}OriginalName`, file.name);
        clearErrors(`enclosure.${documentType}`);
        toast.success("File uploaded successfully!");
      }
    } catch (err) {
      console.error("File upload failed:", err);
      toast.error("File upload failed. Please try again.");
      setFileStates((prev) => ({ ...prev, [documentType]: null }));
      setValue(`enclosure.${documentType}`, null);
      setValue(`enclosure.${documentType}FileStoreId`, null);
      setValue(`enclosure.${documentType}OriginalName`, null);
      e.target.value = null;
    } finally {
      loaderRef.current?.hide();
    }
  };

  const handleFileDownload = async (fileStoreId, fileName, originalName) => {
    try {
      if (!fileStoreId) return;
      const url = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${fileStoreId}`;

      const accessToken = getFromLocalStorage("access_token");
      const tokenDetails = getFromLocalStorage("tokenDetails");
      const sessionState = tokenDetails
        ? JSON.parse(tokenDetails)?.session_state
        : "";

      const response = await axios({
        method: "GET",
        url: url,
        responseType: "blob",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "X-Request-ID": sessionState,
          Accept: "application/octet-stream",
        },
      });

      if (response.data) {
        let filename = fileName || "document";
        const contentDisposition = response.headers["content-disposition"];
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(
            /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
          );
          if (filenameMatch && filenameMatch[1]) {
            filename = filenameMatch[1].replace(/['"]/g, "");
          }
        }

        const blob = new Blob([response.data], {
          type: response.headers["content-type"] || "application/octet-stream",
        });
        const blobUrl = window.URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = blobUrl;
        link.setAttribute("download", filename);
        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          window.URL.revokeObjectURL(blobUrl);
        }, 100);
      }
    } catch (error) {
      console.error("Error downloading file:", error);
      toast.error("Failed to download file. Please try again.");
    }
  };

  useEffect(() => {
    const enclosureData = watch("enclosure");
    if (enclosureData) {
      const newFileStates = {};

      Object.keys(fileStates).forEach(docType => {
        const fileStoreId = enclosureData[`${docType}FileStoreId`];
        const fileName = enclosureData[`${docType}OriginalName`] || enclosureData[docType]?.name;

        if (fileStoreId && fileName) {
          newFileStates[docType] = {
            name: fileName,
            fileStoreId: fileStoreId,
            originalName: fileName
          };
        }
      });

      if (Object.keys(newFileStates).length > 0) {
        setFileStates(prev => ({ ...prev, ...newFileStates }));
      }
    }
  }, [registrationData]);

  const renderFileField = (docType, label) => {
    if (viewMode) {
      return (
        <>
          <label className="form-label">{t(label)}</label>
          {fileStates[docType] ? (
            <div className="d-flex align-items-center p-2 border rounded" style={{ backgroundColor: "#f8f9fa" }}>
              <span className="me-2">{fileStates[docType].name}</span>
              <button
                type="button"
                className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
                onClick={() =>
                  handleFileDownload(
                    fileStates[docType].fileStoreId,
                    fileStates[docType].name,
                    fileStates[docType].originalName
                  )
                }
                title="Download file"
                style={{ width: "24px", height: "24px", padding: "0" }}
              >
                <FaDownload size={10} />
              </button>
            </div>
          ) : (
            <div className="p-2 border rounded text-muted" style={{ backgroundColor: "#f8f9fa" }}>
              No file uploaded
            </div>
          )}
        </>
      );
    }

    return (
      <>
        <div className="position-relative">
          <InputFile
            name={`enclosure.${docType}`}
            label={t(label)}
            id={docType}
            style={{ width: "100%" }}
            register={register(`enclosure.${docType}`, {
              required: !fileStates[docType] && t(`${label} is required`),
            })}
            errors={errors}
            clearErrors={clearErrors}
            onChange={(e) => handleFileChange(e, docType)}
            watch={watch}
            defaultValue={
              fileStates[docType]?.displayFile || watch(`enclosure.${docType}`)
            }
            key={`${docType}-${fileStates[docType] ? "uploaded" : "empty"}`}
          />

          {fileStates[docType] && (
            <FaTimesCircle
              className="text-danger position-absolute"
              style={{
                top: "50%",
                right: "10px",
                transform: "translateY(-50%)",
                cursor: "pointer",
                zIndex: 10,
              }}
              size={18}
              title="Remove file"
              onClick={() => {
                setFileStates((prev) => ({
                  ...prev,
                  [docType]: null,
                }));
                setValue(`enclosure.${docType}`, null);
                setValue(`enclosure.${docType}FileStoreId`, null);
                setValue(`enclosure.${docType}OriginalName`, null);
                clearErrors(`enclosure.${docType}`);

                const fileInput = document.getElementById(docType);
                if (fileInput) {
                  fileInput.value = "";
                  const event = new Event("change", { bubbles: true });
                  fileInput.dispatchEvent(event);
                }
              }}
            />
          )}
        </div>

        {fileStates[docType] && (
          <div
            className="d-flex align-items-center mt-2"
            style={{ maxWidth: "100%" }}
          >
            <small className="text-success me-2 flex-grow-1 text-truncate">
              ✓ {fileStates[docType].name}
            </small>
            <button
              type="button"
              className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
              onClick={() =>
                handleFileDownload(
                  fileStates[docType].fileStoreId,
                  fileStates[docType].name,
                  fileStates[docType].originalName
                )
              }
              title="Download file"
              style={{ width: "24px", height: "24px", padding: "0" }}
            >
              <FaDownload size={10} />
            </button>
          </div>
        )}
      </>
    );
  };

  return (
    <>
      <NewLoader ref={loaderRef} />
      <form autoComplete="off">
        {/* Basic Vessel Information */}
        <Collapsible
          title={
            <>
              <FaShip className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Basic Vessel Information")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Official No. of the Vessel")}
                name="basicVesselInfo.officialNo"
                register={register("basicVesselInfo.officialNo")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Port of Registry of Vessel")}
                name="basicVesselInfo.portOfRegistry"
                register={register("basicVesselInfo.portOfRegistry")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Name of Vessel")}
                name="basicVesselInfo.nameOfVessel"
                register={register("basicVesselInfo.nameOfVessel")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Name of Owner")}
                name="basicVesselInfo.nameOfOwner"
                register={register("basicVesselInfo.nameOfOwner")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Address of Owner")}
                name="basicVesselInfo.addressOfOwner"
                register={register("basicVesselInfo.addressOfOwner")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Owner's Telephone No.")}
                name="basicVesselInfo.ownerTelephone"
                register={register("basicVesselInfo.ownerTelephone")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Type of Vessel")}
                name="basicVesselInfo.typeOfVessel"
                register={register("basicVesselInfo.typeOfVessel")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Category of Vessel")}
                name="basicVesselInfo.categoryOfVessel"
                register={register("basicVesselInfo.categoryOfVessel")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Date of Registry")}
                name="basicVesselInfo.dateOfRegistry"
                type="date"
                register={register("basicVesselInfo.dateOfRegistry")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Length (Meter)")}
                name="basicVesselInfo.length"
                register={register("basicVesselInfo.length")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Breadth (Meter)")}
                name="basicVesselInfo.breadth"
                register={register("basicVesselInfo.breadth")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Depth (Meter)")}
                name="basicVesselInfo.depth"
                register={register("basicVesselInfo.depth")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Draft")}
                name="basicVesselInfo.draft"
                register={register("basicVesselInfo.draft")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Gross Tonnage")}
                name="basicVesselInfo.grossTonnage"
                register={register("basicVesselInfo.grossTonnage")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Net Tonnage")}
                name="basicVesselInfo.netTonnage"
                register={register("basicVesselInfo.netTonnage")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Place of Last Survey")}
                name="basicVesselInfo.placeOfLastSurvey"
                register={register("basicVesselInfo.placeOfLastSurvey")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Date of Last Survey")}
                name="basicVesselInfo.dateOfLastSurvey"
                type="date"
                register={register("basicVesselInfo.dateOfLastSurvey")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Year of Build")}
                name="basicVesselInfo.yearOfBuild"
                register={register("basicVesselInfo.yearOfBuild")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Name of Builder")}
                name="basicVesselInfo.nameOfBuilder"
                register={register("basicVesselInfo.nameOfBuilder")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Address of Builder")}
                name="basicVesselInfo.addressOfBuilder"
                register={register("basicVesselInfo.addressOfBuilder")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Builder's Mobile No.")}
                name="basicVesselInfo.builderMobile"
                register={register("basicVesselInfo.builderMobile")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Builder's Email Id")}
                name="basicVesselInfo.builderEmail"
                register={register("basicVesselInfo.builderEmail")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Trade License")}
                name="basicVesselInfo.tradeLicense"
                register={register("basicVesselInfo.tradeLicense")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("GST")}
                name="basicVesselInfo.gst"
                register={register("basicVesselInfo.gst")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
          </Row>
        </Collapsible>

        {/* Hull Particulars */}
        <Collapsible
          title={
            <>
              <FaShip className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Hull Particulars")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Hull Material")}
                name="hullParticulars.hullMaterial"
                register={register("hullParticulars.hullMaterial")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Hull Platting Material")}
                name="hullParticulars.hullPlattingMaterial"
                register={register("hullParticulars.hullPlattingMaterial")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Hull Platting Thickness")}
                name="hullParticulars.hullPlattingThickness"
                register={register("hullParticulars.hullPlattingThickness")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("No. of Bulkheads")}
                name="hullParticulars.noOfBulkheads"
                register={register("hullParticulars.noOfBulkheads")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Bulkhead Placement")}
                name="hullParticulars.bulkheadPlacement"
                register={register("hullParticulars.bulkheadPlacement")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Bulkhead Thickness")}
                name="hullParticulars.bulkheadThickness"
                register={register("hullParticulars.bulkheadThickness")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Frame Material")}
                name="hullParticulars.frameMaterial"
                register={register("hullParticulars.frameMaterial")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Frame Thickness (mm)")}
                name="hullParticulars.frameThickness"
                register={register("hullParticulars.frameThickness")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Floor Material")}
                name="hullParticulars.floorMaterial"
                register={register("hullParticulars.floorMaterial")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Floor Thickness (mm)")}
                name="hullParticulars.floorThickness"
                register={register("hullParticulars.floorThickness")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
          </Row>
        </Collapsible>

        {/* Details of Propulsion of Engine */}
        <Collapsible
          title={
            <>
              <FaCog className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Details of Propulsion of Engine")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Type of Engine")}
                name="detailsOfPropulsion.typeOfEngine"
                register={register("detailsOfPropulsion.typeOfEngine")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Engine Make")}
                name="detailsOfPropulsion.engineMake"
                register={register("detailsOfPropulsion.engineMake")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Engine Maker Address")}
                name="detailsOfPropulsion.engineMakerAddress"
                register={register("detailsOfPropulsion.engineMakerAddress")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Model No.")}
                name="detailsOfPropulsion.modelNo"
                register={register("detailsOfPropulsion.modelNo")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Number of Engine")}
                name="detailsOfPropulsion.numberOfEngine"
                register={register("detailsOfPropulsion.numberOfEngine")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Year of Make")}
                name="detailsOfPropulsion.yearOfMake"
                register={register("detailsOfPropulsion.yearOfMake")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Horsepower")}
                name="detailsOfPropulsion.horsepower"
                register={register("detailsOfPropulsion.horsepower")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Speed/RPM")}
                name="detailsOfPropulsion.speedRPM"
                register={register("detailsOfPropulsion.speedRPM")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Stroke (Engine)")}
                name="detailsOfPropulsion.strokeEngine"
                register={register("detailsOfPropulsion.strokeEngine")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Number of Set Fitted")}
                name="detailsOfPropulsion.numberOfSetFitted"
                register={register("detailsOfPropulsion.numberOfSetFitted")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Set Sr. No.")}
                name="detailsOfPropulsion.setSrNo"
                register={register("detailsOfPropulsion.setSrNo")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Engine Cylinder Diameter")}
                name="detailsOfPropulsion.engineCylinderDiameter"
                register={register("detailsOfPropulsion.engineCylinderDiameter")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Propeller Type")}
                name="detailsOfPropulsion.propellerType"
                register={register("detailsOfPropulsion.propellerType")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Gear Type")}
                name="detailsOfPropulsion.gearType"
                register={register("detailsOfPropulsion.gearType")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("No. of Gear")}
                name="detailsOfPropulsion.noOfGear"
                register={register("detailsOfPropulsion.noOfGear")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Vessel Speed")}
                name="detailsOfPropulsion.vesselSpeed"
                register={register("detailsOfPropulsion.vesselSpeed")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Revolution/mints")}
                name="detailsOfPropulsion.revolutionMints"
                register={register("detailsOfPropulsion.revolutionMints")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("No. of cylinders per set for Rotary Engine")}
                name="detailsOfPropulsion.cylindersPerSetRotary"
                register={register("detailsOfPropulsion.cylindersPerSetRotary")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("No. of cylinders per set for Reciprocating Engine")}
                name="detailsOfPropulsion.cylindersPerSetReciprocating"
                register={register("detailsOfPropulsion.cylindersPerSetReciprocating")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("No. of Shaft")}
                name="detailsOfPropulsion.noOfShaft"
                register={register("detailsOfPropulsion.noOfShaft")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Length of the Engine Room")}
                name="detailsOfPropulsion.lengthOfEngineRoom"
                register={register("detailsOfPropulsion.lengthOfEngineRoom")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
          </Row>
        </Collapsible>

        {/* Alteration Details */}
        <Collapsible
          title={
            <>
              <FaClipboardList className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Alterations Details")}</span>
            </>
          }
          openStat={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              {fields.map((field, index) => (
                <Row key={field.id} className="gy-3 mb-3 p-3 border rounded">
                  <Col xs={12}>
                    <div className="d-flex justify-content-between align-items-center mb-2">
                      <h6 className="mb-0">Alteration {index + 1}</h6>
                      {fields.length > 1 && !viewMode && (
                        <Button
                          variant="outline-danger"
                          size="sm"
                          onClick={() => remove(index)}
                        >
                          <FaTrash />
                        </Button>
                      )}
                    </div>
                  </Col>
                  <Col md={6}>
                    <InputText
                      label={t("Description of Alteration")}
                      name={`alterationDetails.alterations.${index}.description`}
                      register={register(`alterationDetails.alterations.${index}.description`)}
                      errors={errors}
                      placeholder={t("Enter description of alteration")}
                      disabled={viewMode}
                    />
                  </Col>
                  <Col md={6}>
                    <InputText
                      label={t("Reason for Alteration")}
                      name={`alterationDetails.alterations.${index}.reason`}
                      register={register(`alterationDetails.alterations.${index}.reason`)}
                      errors={errors}
                      placeholder={t("Enter reason for alteration")}
                      disabled={viewMode}
                    />
                  </Col>
                  <Col md={6}>
                    <InputText
                      label={t("Proposed Date")}
                      name={`alterationDetails.alterations.${index}.proposedDate`}
                      type="date"
                      register={register(`alterationDetails.alterations.${index}.proposedDate`)}
                      errors={errors}
                      disabled={viewMode}
                    />
                  </Col>
                </Row>
              ))}
              {!viewMode && (
                <Button
                  variant="outline-primary"
                  onClick={() => append({ description: "", reason: "", proposedDate: "" })}
                  className="mt-2"
                >
                  <FaPlus className="me-2" />
                  Add
                </Button>
              )}
            </Card.Body>
          </Card>
        </Collapsible>

        {/* Enclosure */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>{t("ENCLOSURE")}</span>
            </div>
          }
          defaultOpen={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col xs={12} lg={6}>
                  {renderFileField("certificateOfRegistration", "Certificate of Registration")}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("alterationDrawings", "Alteration Drawings")}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("existingApprovedDrawings", "Existing Approved Drawings")}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("updatedStabilityBooklet", "Updated Stability Booklet")}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("existingTonnageBooklet", "Existing Tonnage Booklet")}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("updatedTonnageBooklet", "Updated Tonnage Booklet")}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("existingStabilityBooklet", "Existing Stability Booklet")}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("newInsuranceCertificate", "New Insurance Certificate")}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("lastSurveyCertificate", "Last Survey Certificate")}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("workOrder", "Work Order")}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("insuranceCertificate", "Insurance Certificate")}
                </Col>
                <Col xs={12}>
                  <MultiFile
                    title={t("Other Technical Document")}
                    files={otherTechnicalDocumentFiles}
                    setFiles={setOtherTechnicalDocumentFiles}
                    type="OTHER_TECHNICAL_DOCUMENT"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={methods.setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                    isRegistrationMode={false}
                  />
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>
      </form>
    </>
  );
};

export default RequestApplication;
