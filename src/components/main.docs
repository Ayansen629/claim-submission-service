{/* Safety Equipment */}
<Card className={styles.detailsCard}>
  <Card.Header className={styles.cardHeader}>
    <h5>{t("Safety equipment carried on the vessel:")}</h5>
  </Card.Header>
  <Card.Body>
    <div className="table-responsive">
      <Table className={styles.safetyTable}>
        <thead>
          <tr>
            <th className={styles.tableHeader} rowSpan="2">
              {t("No. of boats size and cubic capacity")}
            </th>
            <th className={styles.tableHeader} rowSpan="2">
              {t("No. of Buoyant apparatus or Life rafts")}
            </th>
            <th className={styles.tableHeaderGroup} colSpan="2">
              {t("No. of Lifebuoys and lifejackets")}
            </th>
            <th className={styles.tableHeaderGroup} colSpan="3">
              {t("Fire extinguishers")}
            </th>
            <th className={styles.tableHeader} rowSpan="2">
              {t("No. of Anchor with their weight")}
            </th>
            <th className={styles.tableHeaderGroup} colSpan="2">
              {t("Length Size")}
            </th>
          </tr>
          <tr>
            <th className={styles.tableSubHeader}>
              {t("Lifebuoys")}
            </th>
            <th className={styles.tableSubHeader}>
              {t("Lifejackets")}
            </th>
            <th className={`${styles.tableSubHeader} ${styles.required}`}>
              {t("Foam Type")} <span className={styles.asterisk}>*</span>
            </th>
            <th className={`${styles.tableSubHeader} ${styles.required}`}>
              {t("Soda Acid")} <span className={styles.asterisk}>*</span>
            </th>
            <th className={`${styles.tableSubHeader} ${styles.required}`}>
              {t("Dry Carbon Powder")} <span className={styles.asterisk}>*</span>
            </th>
            <th className={styles.tableSubHeader}>
              {t("Anchor Cable")}
            </th>
            <th className={styles.tableSubHeader}>
              {t("Hose")}
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            {Object.entries(editableData.safetyEquipment).map(([key, value], index) => {
              const editableFields = ['fireExtinguishersFoamType', 'fireExtinguishersSodaAcid', 'fireExtinguishersDryCarbonPowder'];
              const isEditable = editableFields.includes(key);
              const hasError = errors[key];
              
              return (
                <td key={index} className={styles.tableCell}>
                  {isEditable ? (
                    <div>
                      <input
                        type="text"
                        className={`${styles.tableInput} ${hasError ? styles.errorField : ''}`}
                        value={value}
                        onChange={(e) => handleInputChange(`safetyEquipment.${key}`, e.target.value)}
                        placeholder="Enter value *"
                      />
                      {hasError && <div className={styles.errorMessage}>{hasError}</div>}
                    </div>
                  ) : (
                    <div className={styles.tableDisabledField}>
                      {value || "Data not available"}
                    </div>
                  )}
                </td>
              );
            })}
          </tr>
        </tbody>
      </Table>
    </div>
  </Card.Body>
</Card>
