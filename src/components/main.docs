/* Updated SurveyTrackerCard.css */
.calendar-wrapper {
  margin-top: 10px;
  width: 100%;
  flex-grow: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.survey-calendar {
  width: 100% !important;
  font-family: inherit !important;
  border: none !important;
  background: transparent !important;
}

.survey-calendar .react-datepicker__month-container {
  width: 100%;
  float: none;
}

.survey-calendar .react-datepicker__header {
  background-color: transparent;
  border-bottom: none;
  padding-top: 0;
}

.survey-calendar .react-datepicker__day-names {
  display: flex;
  justify-content: space-around;
  margin-bottom: 0.2em;
}

.survey-calendar .react-datepicker__day-name {
  color: #666;
  font-weight: 500;
  font-size: 0.7rem;
  margin: 0;
  width: 2em;
  line-height: 2em;
}

.survey-calendar .react-datepicker__month {
  margin: 0;
}

.survey-calendar .react-datepicker__week {
  display: flex;
  justify-content: space-around;
}

.survey-calendar .react-datepicker__day {
  margin: 0;
  width: 2em;
  line-height: 2em;
  font-size: 0.8rem;
  color: #333;
}

.survey-calendar .react-datepicker__day--selected,
.survey-calendar .react-datepicker__day--keyboard-selected {
  background-color: #6f42c1;
  color: white;
}

.survey-calendar .react-datepicker__day--today {
  font-weight: bold;
  color: #0d6efd;
}

.survey-calendar .react-datepicker__navigation {
  top: 0.5em;
}

.day-container {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.day-number {
  font-size: 0.8rem;
}

.event-indicators {
  position: absolute;
  bottom: 1px;
  display: flex;
  gap: 2px;
}

.event-indicator {
  width: 4px;
  height: 4px;
  border-radius: 50%;
}
