import React, { useState, useContext, useEffect } from "react";
import { useForm } from "react-hook-form";
import { useNavigate } from "react-router-dom";
import { toast } from "react-toastify";
import { UserContext } from "../../components/context/UserContext.js";
import "./Login.css";
import {
  fetchInitialClaimantData,
  fetchClaimantCategoriesData,
  fetchFormDetailsData,
} from "../../services/claimant.service.js";
import axios from "axios"; // Import axios for API calls

const LoginPage = () => {
  const {
    register,
    handleSubmit,
    watch,
    formState: { errors },
    reset,
    setValue,
    trigger,
  } = useForm();
  const navigate = useNavigate();
  const { setUserData } = useContext(UserContext);

  const [otpSent, setOtpSent] = useState(false);
  const [otp, setOtp] = useState("");
  const [loading, setLoading] = useState(false);
  const [selectedRadio, setSelectedRadio] = useState("corporateDebtor");
  const [claimantTypes, setClaimantTypes] = useState([]);
  const [claimantCategories, setClaimantCategories] = useState([]);
  const [apiLoading, setApiLoading] = useState(false);
  const [corporateDebtors, setCorporateDebtors] = useState([]);
  const [processTypes, setProcessTypes] = useState([]);
  const [selectedCorporateDebtor, setSelectedCorporateDebtor] = useState(null);
  const [selectedProcessType, setSelectedProcessType] = useState(null);
  const [selectedClaimantType, setSelectedClaimantType] = useState(null);
  const [selectedFormName, setSelectedFormName] = useState("");

  // Watch all form values
  const formValues = watch();
  const {
    username,
    email,
    password,
    userType,
    financialCreditorType,
    operationalCreditorType,
    processTypeUuid,
    corporateDebtorUuid,
    termsAccepted
  } = formValues;

  // ... [keep all existing useEffect hooks and helper functions] ...

  const handleVerifyOTP = async (data) => {
    if (!otp) {
      toast.error("Please enter OTP");
      return;
    }
    if (!data.termsAccepted) {
      toast.info("Please accept terms");
      return;
    }

    setLoading(true);
    
    try {
      const processType = processTypes.find(p => p.uuid === processTypeUuid);
      const corporateDebtor = corporateDebtors.find(d => d.uuid === corporateDebtorUuid);
      const claimantCategory = claimantCategories.find(c => 
        c.uuid === (userType === "Financial Creditors" ? financialCreditorType : operationalCreditorType)
      );

      const payload = {
        userType: "CLAIMANT",
        commonMasterRequest: {
          debtorsUuid: corporateDebtorUuid,
          processTypeUuid: processTypeUuid,
          processTypeValue: processType?.processTypeValue || "",
          claimantTypeUuid: selectedClaimantType?.uuid || "",
          claimantCategoryUuid: claimantCategory?.uuid || "",
          formUuid: claimantCategory?.formId || ""
        },
        claimantLoginRequest: {
          mobileNumber: username,
          processId: processType?.processTypeValue || "",
          corporateDebtorId: corporateDebtor?.uuid || "",
          claimantCatagoryId: selectedClaimantType?.uuid || "",
          claimantSubCatagoryId: claimantCategory?.uuid || "",
          otp: otp
        },
        corporateDebtorLoginRequest: null
      };

      const response = await axios.post('/_user/_login', payload);
      
      if (response.data.status.code === "200") {
        const userPayload = {
          userType: "CLM",
          userId: username,
          processType: processType?.processTypeValue || "",
          corporateDebtorName: corporateDebtor?.nameOfCorporateDebtor || "",
          claimantType: userType,
          claimantCategoryType: claimantCategory?.claimantCategoryName || "",
          formName: selectedFormName,
          userDetails: response.data.users[0]?.claimant || null
        };

        setUserData(userPayload);
        localStorage.setItem("userFormData", JSON.stringify(userPayload));
        toast.success("Login Successful");
        navigate("/dashboard");
      } else {
        toast.error(response.data.status.message || "Login failed");
      }
    } catch (error) {
      console.error("Login error:", error);
      toast.error(error.response?.data?.status?.message || "Login failed");
    } finally {
      setLoading(false);
    }
  };

  const handleCorporateDebtorLogin = async (data) => {
    setLoading(true);
    
    try {
      const payload = {
        userType: "CORPORATOR",
        commonMasterRequest: {},
        claimantLoginRequest: null,
        corporateDebtorLoginRequest: {
          emailId: data.email,
          password: data.password
        }
      };

      const response = await axios.post('/_user/_login', payload);
      
      if (response.data.status.code === "200") {
        const userPayload = {
          userType: "CRP",
          email: data.email,
          userDetails: response.data.users[0]?.corporateDebtor || null
        };

        setUserData(userPayload);
        localStorage.setItem("userFormData", JSON.stringify(userPayload));
        toast.success("Login Successful");
        navigate("/dashboard");
      } else {
        toast.error(response.data.status.message || "Login failed");
      }
    } catch (error) {
      console.error("Login error:", error);
      toast.error(error.response?.data?.status?.message || "Login failed");
    } finally {
      setLoading(false);
    }
  };

  // ... [keep all the existing JSX return code] ...
};

export default LoginPage;
