import React, { useCallback, useEffect, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepFirst.css";
import 'bootstrap/dist/css/bootstrap.min.css';

const StepFirst = ({ provideSubmitHandler, formData, onValidationComplete }) => {
    const [isUploading, setIsUploading] = useState(false);
    const [uploadError, setUploadError] = useState(null);
    const [partnerCount, setPartnerCount] = useState(1);

    const methods = useForm({
        mode: "onChange", // Validate on every change
        reValidateMode: "onChange"
    });

    const { register, handleSubmit, formState: { errors, isValid }, trigger, setValue, control, getValues, watch } = methods;

    const watchIdentificationType = watch("identificationTypeRadio", "incorporated");

    const handleFileUpload = async (file) => {
        try {
            setIsUploading(true);
            setUploadError(null);
            const result = await uploadDocument(file, 'identification');
            return result;
        } catch (error) {
            setUploadError(error.message);
            throw error;
        } finally {
            setIsUploading(false);
        }
    };

    const addPartner = () => {
        setPartnerCount(prev => prev + 1);
    };

    const removePartner = () => {
        if (partnerCount > 1) {
            setPartnerCount(prev => prev - 1);
        }
    };

    const basicDetailsSchema = [
        {
            name: "financialCreditorName",
            label: <>Name of the financial creditor <span className="required-asterisk">*</span></>,
            type: "text",
            rules: {
                required: "Financial creditor name is required",
                minLength: {
                    value: 2,
                    message: "Name must be at least 2 characters"
                }
            },
            placeholder: "Enter financial creditor name",
            tooltip: "Legal name of the financial creditor"
        },
        {
            name: "financialCreditorEmail",
            label: <>Email address of the financial creditor <span className="required-asterisk">*</span></>,
            type: "email",
            rules: {
                required: "Email is required",
                pattern: {
                    value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                    message: "Invalid email address"
                }
            },
            placeholder: "Enter email address",
            tooltip: "Official email address of the financial creditor"
        },
        {
            name: "identificationTypeRadio",
            label: <>Identification type <span className="required-asterisk">*</span></>,
            type: "radio-group",
            options: [
                { value: "incorporated", label: "Incorporated body" },
                { value: "partnership", label: "Partnership or individual" }
            ],
            rules: { required: "Identification type is required" },
            defaultValue: "incorporated",
            className: "mb-4" // Added spacing
        }
    ];

    const incorporatedBodyFields = [
        {
            name: "incorporatedIdentificationNumber",
            label: <>Identification Number <span className="required-asterisk">*</span></>,
            type: "text",
            rules: {
                required: watchIdentificationType === "incorporated" && "Identification number is required",
                pattern: {
                    value: /^[A-Z0-9]{8,15}$/,
                    message: "Invalid identification number"
                }
            },
            placeholder: "Enter identification number",
            tooltip: "Corporate identification number or similar"
        },
        {
            name: "incorporatedProofDocument",
            label: <>Proof of identification <span className="required-asterisk">*</span></>,
            type: "file",
            rules: {
                required: watchIdentificationType === "incorporated" && "Proof document is required",
                validate: {
                    fileSize: (files) => {
                        if (files && files[0]) {
                            const fileSizeInMB = files[0].size / (1024 * 1024);
                            return fileSizeInMB <= 5 || "File size must be ≤ 5MB";
                        }
                        return true;
                    }
                }
            },
            tooltip: "Upload certificate of incorporation or similar",
            accept: "image/*,.pdf",
            onFileUpload: handleFileUpload,
            isUploading,
            uploadError,
            note: "Max file size: 5MB (PDF, JPEG, PNG)"
        }
    ];

    const partnershipIndividualFields = [
        {
            name: "partnerIndividualName",
            label: <>Name of Partner/Individual <span className="required-asterisk">*</span></>,
            type: "text",
            rules: {
                required: watchIdentificationType === "partnership" && "Name is required",
                minLength: {
                    value: 2,
                    message: "Name must be at least 2 characters"
                }
            },
            placeholder: "Enter name",
            tooltip: "Full name of the partner or individual"
        },
        {
            name: "partnerIndividualIdentification",
            label: <>Identification Details <span className="required-asterisk">*</span></>,
            type: "text",
            rules: {
                required: watchIdentificationType === "partnership" && "Identification details are required",
                minLength: {
                    value: 4,
                    message: "ID details must be at least 4 characters"
                }
            },
            placeholder: "Enter ID details",
            tooltip: "ID type and number (e.g., PAN: ABCDE1234F)"
        },
        {
            name: "partnerIndividualProofDocument",
            label: <>Proof of Identification <span className="required-asterisk">*</span></>,
            type: "file",
            rules: {
                required: watchIdentificationType === "partnership" && "Proof document is required",
                validate: {
                    fileSize: (files) => {
                        if (files && files[0]) {
                            const fileSizeInMB = files[0].size / (1024 * 1024);
                            return fileSizeInMB <= 5 || "File size must be ≤ 5MB";
                        }
                        return true;
                    }
                }
            },
            tooltip: "Upload identification proof (e.g., PAN, Aadhaar)",
            accept: "image/*,.pdf",
            onFileUpload: handleFileUpload,
            isUploading,
            uploadError,
            note: "Max file size: 5MB (PDF, JPEG, PNG)"
        }
    ];

    const renderPartnerFields = () => {
        return Array.from({ length: partnerCount }).map((_, index) => (
            <div key={`partner_${index}`} className="row mb-3 align-items-end">
                <div className="col-md-6">
                    <DynamicField
                        fieldConfig={{
                            name: `partnerName_${index}`,
                            label: <>{index === 0 ? <>Partner Name <span className="required-asterisk">*</span></> : "Partner Name"}</>,
                            type: "text",
                            rules: {
                                required: index === 0 && watchIdentificationType === "partnership" && "Partner name is required",
                                minLength: {
                                    value: 2,
                                    message: "Name must be at least 2 characters"
                                }
                            },
                            placeholder: "Enter partner name",
                            tooltip: "Name of the partner"
                        }}
                        register={register}
                        errors={errors}
                    />
                </div>
                <div className="col-md-6">
                    <DynamicField
                        fieldConfig={{
                            name: `partnerIdentification_${index}`,
                            label: <>{index === 0 ? <>Partner ID Details <span className="required-asterisk">*</span></> : "Partner ID Details"}</>,
                            type: "text",
                            rules: {
                                required: index === 0 && watchIdentificationType === "partnership" && "Partner ID details are required",
                                minLength: {
                                    value: 4,
                                    message: "ID details must be at least 4 characters"
                                }
                            },
                            placeholder: "Enter partner ID details",
                            tooltip: "ID type and number (e.g., PAN: ABCDE1234F)"
                        }}
                        register={register}
                        errors={errors}
                    />
                </div>
            </div>
        ));
    };

    const addressDetailsSchema = [
        {
            name: "addressLine1",
            label: <>Address line 1 <span className="required-asterisk">*</span></>,
            type: "text",
            rules: {
                required: "Address line 1 is required",
                minLength: {
                    value: 5,
                    message: "Address must be at least 5 characters"
                }
            },
            placeholder: "Enter address line 1",
            tooltip: "Street address, P.O. box, company name"
        },
        {
            name: "addressLine2",
            label: "Address line 2",
            type: "text",
            placeholder: "Enter address line 2",
            tooltip: "Apartment, suite, unit, building, floor, etc."
        },
        {
            name: "city",
            label: <>City <span className="required-asterisk">*</span></>,
            type: "text",
            rules: {
                required: "City is required",
                minLength: {
                    value: 2,
                    message: "City name must be at least 2 characters"
                }
            },
            placeholder: "Enter city",
            tooltip: "City or locality"
        },
        {
            name: "state",
            label: <>State <span className="required-asterisk">*</span></>,
            type: "text",
            rules: {
                required: "State is required",
                minLength: {
                    value: 2,
                    message: "State name must be at least 2 characters"
                }
            },
            placeholder: "Enter state",
            tooltip: "State or province"
        },
        {
            name: "pincode",
            label: <>Pincode <span className="required-asterisk">*</span></>,
            type: "text",
            rules: {
                required: "Pincode is required",
                pattern: {
                    value: /^[1-9][0-9]{5}$/,
                    message: "Invalid Indian pincode"
                }
            },
            placeholder: "Enter 6-digit pincode",
            tooltip: "Postal code or ZIP code"
        }
    ];

    const onSubmit = useCallback(async () => {
        const isValid = await trigger();
        if (!isValid) {
            console.error("Validation failed");
            return false;
        }
        return getValues();
    }, [trigger, getValues]);

    // Notify parent component about validation status
    useEffect(() => {
        if (onValidationComplete) {
            onValidationComplete(isValid);
        }
    }, [isValid, onValidationComplete]);

    useEffect(() => {
        if (formData) {
            Object.keys(formData).forEach((key) => {
                setValue(key, formData[key]);
            });
        }
    }, [formData, setValue]);

    useEffect(() => {
        if (provideSubmitHandler) {
            provideSubmitHandler(onSubmit);
        }
    }, [provideSubmitHandler, onSubmit]);

    return (
        <FormProvider {...methods}>
            <form className="form-stepper">
                <div className="mb-4 bg-light p-3 rounded">
                    <Collapsible title="Basic Details" defaultOpen={true}>
                        <div className="container-fluid">
                            <div className="row gy-3">
                                {basicDetailsSchema.map((fieldConfig) => (
                                    <div key={fieldConfig.name} className="col-md-6">
                                        <DynamicField
                                            fieldConfig={fieldConfig}
                                            control={control}
                                            register={register}
                                            errors={errors}
                                            setValue={setValue}
                                            trigger={trigger}
                                            getValues={getValues}
                                        />
                                    </div>
                                ))}
                            </div>

                            {watchIdentificationType === "incorporated" && (
                                <div className="row mt-3 gy-3">
                                    <div className="col-12">
                                        <h6 className="mb-3">Incorporated Body Identification</h6>
                                    </div>
                                    {incorporatedBodyFields.map((fieldConfig) => (
                                        <div key={fieldConfig.name} className="col-md-6">
                                            <DynamicField
                                                fieldConfig={{
                                                    ...fieldConfig,
                                                    isUploading,
                                                    uploadError,
                                                    setIsUploading,
                                                    setUploadError,
                                                    onFileUpload: handleFileUpload
                                                }}
                                                control={control}
                                                register={register}
                                                errors={errors}
                                                setValue={setValue}
                                                trigger={trigger}
                                                getValues={getValues}
                                            />
                                        </div>
                                    ))}
                                </div>
                            )}

                            {watchIdentificationType === "partnership" && (
                                <div className="partner-section mt-3">
                                    <h6 className="mb-3">Partnership or Individual Identification</h6>
                                    <div className="mb-3">
                                        <DynamicField
                                            fieldConfig={partnershipIndividualFields[0]} // Name
                                            register={register}
                                            errors={errors}
                                        />
                                    </div>
                                    <div className="mb-3">
                                        <DynamicField
                                            fieldConfig={partnershipIndividualFields[1]} // Identification Details
                                            register={register}
                                            errors={errors}
                                        />
                                    </div>
                                    <div className="mb-3">
                                        <DynamicField
                                            fieldConfig={{
                                                ...partnershipIndividualFields[2], // Proof Document
                                                isUploading,
                                                uploadError,
                                                setIsUploading,
                                                setUploadError,
                                                onFileUpload: handleFileUpload
                                            }}
                                            register={register}
                                            errors={errors}
                                        />
                                    </div>
                                    {partnerCount > 1 && (
                                        <div className="mt-4">
                                            <h6 className="mb-3">Additional Partners/Individuals</h6>
                                            {renderPartnerFields()}
                                        </div>
                                    )}
                                    <div className="d-flex justify-content-end mt-3">
                                        <button
                                            type="button"
                                            className="btn btn-sm btn-outline-primary me-2"
                                            onClick={addPartner}
                                        >
                                            Add Partner
                                        </button>
                                        <button
                                            type="button"
                                            className="btn btn-sm btn-outline-danger"
                                            onClick={removePartner}
                                            disabled={partnerCount <= 1}
                                        >
                                            Remove Partner
                                        </button>
                                    </div>
                                </div>
                            )}
                        </div>
                    </Collapsible>

                    <Collapsible title="Address Details" defaultOpen={true}>
                        <div className="container-fluid">
                            <div className="row gy-3">
                                {addressDetailsSchema.map((fieldConfig) => (
                                    <div key={fieldConfig.name} className="col-md-6">
                                        <DynamicField
                                            fieldConfig={fieldConfig}
                                            control={control}
                                            register={register}
                                            errors={errors}
                                            setValue={setValue}
                                            trigger={trigger}
                                            getValues={getValues}
                                        />
                                    </div>
                                ))}
                            </div>
                        </div>
                    </Collapsible>
                </div>
            </form>
        </FormProvider>
    );
};

export default StepFirst;
