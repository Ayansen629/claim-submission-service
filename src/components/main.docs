import React, { useState } from 'react';
import "./Register.css";
import { useForm } from "react-hook-form";
import { Link, useNavigate } from 'react-router-dom';
import { ToastContainer, toast } from 'react-toastify';
import 'react-toastify/dist/ReactToastify.css';
import axios from 'axios';

const Register = () => {
  const navigate = useNavigate();
  const [otpSent, setOtpSent] = useState(false);
  const [otp, setOtp] = useState("");
  const [loading, setLoading] = useState(false);
  const [selectedRadio, setSelectedRadio] = useState("individual");

  const {
    register,
    handleSubmit,
    watch,
    reset,
    formState: { errors },
  } = useForm({
    defaultValues: {
      name: "",
      corporateName: "",
      email: "",
      mobilenumber: "",
      aadhar: "",
      pancard: "",
      cinTaNumber: "",
      userType: "individual", 
    },
  });

  const formValues = watch();

  const isFormComplete = () => {
    if (selectedRadio === "individual") {
      return (
        formValues.name &&
        formValues.email &&
        formValues.mobilenumber &&
        formValues.aadhar &&
        formValues.pancard
      );
    } else {
      return (
        formValues.corporateName &&
        formValues.email &&
        formValues.mobilenumber &&
        formValues.cinTaNumber &&
        formValues.pancard
      );
    }
  };

  const handleSendOTP = async () => {
    setLoading(true);

    try {
      // First validate the form data with backend
      const validationResponse = await axios.post('/api/validate-registration', {
        email: formValues.email,
        mobileNumber: formValues.mobilenumber,
        userType: selectedRadio === "individual" ? "INDV" : "CORP"
      });

      if (validationResponse.data.valid) {
        toast.success("OTP Sent", { position: 'top-right' });
        setOtpSent(true);
      } else {
        toast.error(validationResponse.data.message || "Validation failed");
      }
    } catch (error) {
      console.error("Validation error:", error);
      toast.error("Failed to validate information. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  const onSubmit = async (data) => {
    if (!otp) {
      toast.error("Please enter the OTP");
      return;
    }

    setLoading(true);

    // Prepare payload for registration
    const payload = {
      claimant: {
        uuid: "",
        claimantName: selectedRadio === "individual" ? data.name : null,
        corporateName: selectedRadio === "corporate" ? data.corporateName : null,
        emailId: data.email,
        claimantEntityType: selectedRadio === "individual" ? "INDV" : "CORP",
        mobileNumber: data.mobilenumber,
        aadharNumber: selectedRadio === "individual" ? data.aadhar : null,
        panNumber: data.pancard,
        cinOrTaNumber: selectedRadio === "corporate" ? data.cinTaNumber : null,
        roleCode: "CLAIMANT",
        active: true,
        auditDetails: {
          createdBy: "system_user",
          createdDate: new Date().toISOString(),
          lastModifiedBy: "system_user",
          lastModifiedDate: new Date().toISOString()
        }
      },
      corporateDebtor: null,
      otp: otp
    };

    try {
      const response = await axios.post('/claim-user-service/_user/_registration', payload);
      
      if (response.data.status.code === "201") {
        toast.success("Registration successful!", { position: 'top-right' });
        reset();
        setOtp("");
        setOtpSent(false);
        setTimeout(() => navigate("/login"), 1000);
      } else {
        toast.error(response.data.status.message || "Registration failed");
      }
    } catch (error) {
      console.error("Registration error:", error);
      toast.error(error.response?.data?.message || "Registration failed. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className='register-page'>
      <div className="register-container">
        <div className="register-header">
          <div className="register-textmain"> Claimants Register</div>
        </div>
        <form className="register-form" onSubmit={handleSubmit(onSubmit)}>
          <div className="radio-options">
            <div className={`radio-op ${selectedRadio === "individual" ? "active" : ""}`}>
              <input
                type="radio"
                id="individual"
                name="userType"
                value="individual"
                checked={selectedRadio === "individual"}
                onChange={() => setSelectedRadio("individual")}
              />
              <label htmlFor="individual">Individual</label>
            </div>
            <div className={`radio-op ${selectedRadio === "corporate" ? "active" : ""}`}>
              <input
                type="radio"
                id="corporate"
                name="userType"
                value="corporate"
                checked={selectedRadio === "corporate"}
                onChange={() => setSelectedRadio("corporate")}
              />
              <label htmlFor="corporate">Corporate</label>
            </div>
          </div>

          <div className="form-grid">
            <div className="form-column">
              {selectedRadio === "individual" ? (
                <>
                  <input
                    type="text"
                    {...register("name", { required: "Name is required" })}
                    placeholder="Name (as on Aadhar)"
                    className="user-input"
                  />
                  {errors.name && <span className="error">{errors.name.message}</span>}
                </>
              ) : (
                <>
                  <input
                    type="text"
                    {...register("corporateName", { required: "Corporate Name is required" })}
                    placeholder="Corporate Name"
                    className="user-input"
                  />
                  {errors.corporateName && <span className="error">{errors.corporateName.message}</span>}
                </>
              )}

              <input
                type="email"
                {...register("email", { 
                  required: "Email is required",
                  pattern: {
                    value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                    message: "Invalid email address"
                  }
                })}
                placeholder="Email Address"
                className="user-input"
              />
              {errors.email && <span className="error">{errors.email.message}</span>}

              {selectedRadio === "individual" ? (
                <input
                  type="text"
                  {...register("aadhar", { 
                    required: "Aadhar number is required",
                    pattern: {
                      value: /^[2-9]{1}[0-9]{11}$/,
                      message: "Invalid Aadhar number"
                    }
                  })}
                  placeholder="Aadhar Number"
                  className="user-input"
                />
              ) : (
                <input
                  type="text"
                  {...register("cinTaNumber", { 
                    required: "CIN/TA is required",
                  })}
                  placeholder="CIN/TA Number"
                  className="user-input"
                />
              )}
              {selectedRadio === "individual" && errors.aadhar && (
                <span className="error">{errors.aadhar.message}</span>
              )}
              {selectedRadio === "corporate" && errors.cinTaNumber && (
                <span className="error">{errors.cinTaNumber.message}</span>
              )}
            </div>
            
            <div className="form-column">
              <input
                type="text"
                {...register("pancard", { 
                  required: "PAN is required",
                  pattern: {
                    value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
                    message: "Invalid PAN format (e.g., ABCDE1234F)"
                  }
                })}
                placeholder="PAN Number"
                className="user-input"
              />
              {errors.pancard && <span className="error">{errors.pancard.message}</span>}

              <input
                type="text"
                {...register("mobilenumber", { 
                  required: "Mobile number is required",
                  pattern: {
                    value: /^[6-9][0-9]{9}$/,
                    message: "Invalid Indian mobile number"
                  }
                })}
                placeholder="Mobile Number"
                className="user-input"
              />
              {errors.mobilenumber && <span className="error">{errors.mobilenumber.message}</span>}
            </div>
          </div>

          {/* OTP Section */}
          {!otpSent && (
            <button
              type="button"
              className="send-otp-btn"
              onClick={handleSendOTP}
              disabled={!isFormComplete() || loading}
            >
              {loading ? "Sending OTP..." : "Send OTP"}
            </button>
          )}

          {otpSent && (
            <div className="otp-verification">
              <input
                type="text"
                placeholder="Enter OTP"
                value={otp}
                onChange={(e) => setOtp(e.target.value)}
                className="user-input"
              />
            </div>
          )}

          {/* Register Button */}
          <button
            type="submit"
            className={`register-btn ${!otpSent || !otp || loading ? 'disabled' : ''}`}
            disabled={!otpSent || !otp || loading}
          >
            {loading ? "Registering..." : "Register"}
          </button>
        </form>

        {/* Login Link */}
        <p className="login-link">
          Already have an account? <Link to="/login">Login here</Link>
        </p>
      </div>
      <ToastContainer />
    </div>
  );
};

export default Register;
