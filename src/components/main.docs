// Modified handleNext function
const handleNext = async () => {
  // Validate current step
  const isStepValid = await validateStep();
  
  if (isStepValid) {
    setValidationMessage("");
    
    // Get current form values
    const currentValues = methods.getValues();
    
    // Update formData with current values
    setFormData(prev => ({ ...prev, ...currentValues }));
    
    if (currentStep < totalSteps) {
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    } else {
      // Submit if on last step
      handleSubmit(onSubmit)();
    }
  } else {
    // Scroll to first error if validation fails
    const firstError = Object.keys(methods.formState.errors)[0];
    if (firstError) {
      document.getElementsByName(firstError)[0]?.scrollIntoView({
        behavior: 'smooth',
        block: 'center'
      });
    }
  }
};

// Modified DynamicField component
const DynamicField = ({ field }) => {
  if (field.showIf && !field.showIf()) return null;

  const handleChange = (e) => {
    if (field?.onChange) {
      field.onChange(e, methods.setValue, methods.watch);
    }
    
    // Clear error if field is being edited
    if (methods.formState.errors[field.name]) {
      methods.clearErrors(field.name);
    }
  };

  // Rest of the DynamicField implementation remains the same
  // but ensure all field changes properly update the form state
  // without causing unnecessary re-renders
};

// Modified form rendering to ensure proper state management
<form onSubmit={methods.handleSubmit(onSubmit)}>
  {/* Form content remains the same */}
</form>
