const uploadFile = async (file, formValueName, renamedFile, fileType, fileIndex) => {
  try {
    loaderRef?.current?.show();
    
    if (isRegistrationMode) {
      const formData = new FormData();
      formData.append("file", file);
      
      const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE_PUBLIC;
      const response = await axios.post(uploadUrl, formData, {
        headers: { "Content-Type": "multipart/form-data" },
      });
      
      const fileStoreId = response?.data?.files[0]?.fileStoreId;
      
      clearErrors(formValueName);
      setValue(formValueName, renamedFile, { shouldValidate: true });
      setValue(fileType + "_fileStoreId_" + fileIndex, fileStoreId);
      
      // Add to supporting documents for additional docs
      if (fileType === "ADDITIONALDOCS") {
        setValue(`supportingDocument_${fileIndex}`, {
          id: "",
          documentName: renamedFile.name,
          documentType: "ADDITIONAL_DOCUMENT",
          documentSource: "ADDITIONAL",
          fileStoreId,
          description: watch(`${fileType}_desc_${fileIndex}`) || "Additional Document",
        });
      }
      
      toast.success("File uploaded successfully!");
      loaderRef?.current?.hide();
      return;
    }
    
    // ... rest of existing code
  } catch (err) {
    // ... error handling
  }
};
