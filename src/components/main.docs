import React, { useState, useEffect, useCallback, useMemo } from "react";
import { useForm, FormProvider, Controller } from "react-hook-form";
import Collapsible from "../formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip";
import { 
  FaInfoCircle, 
  FaPlus, 
  FaMinus,
  FaFileAlt,
  FaMoneyBillWave,
  FaCalendarAlt,
  FaHandshake,
  FaBalanceScale,
  FaUniversity,
  FaLandmark,
  FaMapMarkerAlt,
  FaCity,
  FaGlobeAmericas
} from "react-icons/fa";
import { GiBank } from "react-icons/gi";
import { BsBank2, BsBuilding } from "react-icons/bs";
import axios from "axios";
import "./FormC.css";

// ... (keep all the existing helper components like DynamicField and IFSCSearch)

const ClaimTypeFields = ({ 
  claimType, 
  control, 
  register, 
  errors, 
  setValue, 
  getValues, 
  watch,
  trigger
}) => {
  const hasSecurityInterest = watch("hasSecurityInterest");
  const hasGuarantee = watch("hasGuarantee");
  
  const [showSecurityFields, setShowSecurityFields] = useState(hasSecurityInterest === "yes");
  const [showGuaranteeFields, setShowGuaranteeFields] = useState(hasGuarantee === "yes");

  // Initialize with existing entityData or empty array
  const [entityData, setEntityData] = useState(getValues("entityData") || []);

  // Handle form value changes
  useEffect(() => {
    setShowSecurityFields(hasSecurityInterest === "yes");
    setShowGuaranteeFields(hasGuarantee === "yes");
  }, [hasSecurityInterest, hasGuarantee]);

  const handleSecurityInterestChange = (value) => {
    setShowSecurityFields(value === "yes");
    if (value === "no") {
      setValue("securityValue", "", { shouldValidate: false });
      setValue("securityDate", "", { shouldValidate: false });
    }
  };

  const handleGuaranteeChange = (value) => {
    setShowGuaranteeFields(value === "yes");
    if (value === "no") {
      setValue("guaranteeValue", "", { shouldValidate: false });
      setValue("guaranteeDate", "", { shouldValidate: false });
    }
  };

  const addEntityField = useCallback(() => {
    const newId = entityData.length > 0 ? Math.max(...entityData.map(e => e.id)) + 1 : 1;
    const entityType = claimType === "PRINCIPAL_BORROWER" ? "GUARANTOR" :
                     claimType === "GUARANTOR" ? "PRINCIPAL_BORROWER" :
                     "BENEFICIARY";
    
    const newEntity = {
      id: newId,
      name: "",
      address: "",
      type: entityType
    };
    
    setEntityData([...entityData, newEntity]);
    
    // Focus the new field after a small delay
    setTimeout(() => {
      document.getElementById(`entity-name-${newId}`)?.focus();
    }, 100);
  }, [entityData, claimType]);

  const removeEntityField = useCallback(async (id) => {
    if (entityData.length <= 1) return;

    const updatedEntities = entityData.filter(entity => entity.id !== id);
    setEntityData(updatedEntities);
    setValue("entityData", updatedEntities, { shouldValidate: true });
    await trigger();
  }, [entityData, setValue, trigger]);

  const handleEntityChange = useCallback((id, field, value) => {
    const updatedEntities = entityData.map(entity => 
      entity.id === id ? { ...entity, [field]: value } : entity
    );
    setEntityData(updatedEntities);
    setValue("entityData", updatedEntities, { shouldValidate: true });
  }, [entityData, setValue]);

  // Initialize with existing data
  useEffect(() => {
    const existingData = getValues("entityData");
    if (existingData && existingData.length > 0) {
      setEntityData(existingData);
    }
  }, [getValues]);

  // ... (keep all the existing field configurations)

  const getEntityFieldLabels = () => {
    switch (claimType) {
      case "PRINCIPAL_BORROWER":
        return {
          nameLabel: "Name of the guarantor",
          addressLabel: "Address of the guarantor"
        };
      case "GUARANTOR":
        return {
          nameLabel: "Name of the Principal Borrower",
          addressLabel: "Address of the Principal Borrower"
        };
      case "BENEFICIARY":
        return {
          nameLabel: "Name of the Beneficiary",
          addressLabel: "Address of the Beneficiary"
        };
      default:
        return {
          nameLabel: "Name",
          addressLabel: "Address"
        };
    }
  };

  const { nameLabel, addressLabel } = getEntityFieldLabels();

  return (
    <div className="form-section">
      {/* ... (keep all the existing common and additional fields) */}

      {entityData.map((entity) => (
        <div key={entity.id} className="entity-field-group">
          <div className="entity-field-row">
            <div className="form-group">
              <label className="form-label">
                {nameLabel}
                <span className="required-asterisk">*</span>
              </label>
              <input
                id={`entity-name-${entity.id}`}
                type="text"
                className={`form-control ${
                  errors.entityData?.[entity.id]?.name ? "is-invalid" : ""
                }`}
                value={entity.name}
                onChange={(e) => handleEntityChange(entity.id, "name", e.target.value)}
                placeholder={`Enter ${nameLabel.toLowerCase()}`}
              />
              {errors.entityData?.[entity.id]?.name && (
                <div className="invalid-feedback">
                  {errors.entityData[entity.id].name.message}
                </div>
              )}
            </div>
            
            {entity.id !== 1 && (
              <button 
                type="button" 
                className="btn btn-danger btn-sm remove-entity-btn"
                onClick={() => removeEntityField(entity.id)}
                aria-label={`Remove ${nameLabel}`}
                title={`Remove ${nameLabel}`}
              >
                <FaMinus />
              </button>
            )}
          </div>

          <div className="form-group">
            <label className="form-label">
              {addressLabel}
              <span className="required-asterisk">*</span>
            </label>
            <input
              type="text"
              className={`form-control ${
                errors.entityData?.[entity.id]?.address ? "is-invalid" : ""
              }`}
              value={entity.address}
              onChange={(e) => handleEntityChange(entity.id, "address", e.target.value)}
              placeholder={`Enter ${addressLabel.toLowerCase()}`}
            />
            {errors.entityData?.[entity.id]?.address && (
              <div className="invalid-feedback">
                {errors.entityData[entity.id].address.message}
              </div>
            )}
          </div>
        </div>
      ))}

      <button 
        type="button" 
        className="btn btn-outline-primary btn-sm add-more-btn"
        onClick={addEntityField}
      >
        <FaPlus /> Add {claimType === "GUARANTOR" ? "Principal Borrower" : 
                        claimType === "PRINCIPAL_BORROWER" ? "Guarantor" : "Beneficiary"}
      </button>
    </div>
  );
};

// ... (keep the rest of the FormCDetails component the same)
