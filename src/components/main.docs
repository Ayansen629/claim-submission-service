import React from "react";
import { Box, Typography, Button, Paper, Stack, Container } from "@mui/material";
import { CheckCircleFill, House, FileText } from "react-bootstrap-icons";
import { useTranslation } from "react-i18next";
import { useNavigate } from "react-router-dom";

const RegistrationSuccess = ({ registrationId = "VR2024001" }) => {
  const { t } = useTranslation();
  const navigate = useNavigate();

  return (
    <Box sx={{ 
      backgroundColor: "#f5f6fa", 
      minHeight: "100vh",
      padding: "2rem 0"
    }}>
      <Container maxWidth="md">
        <Paper sx={{ 
          padding: "4rem 3rem", 
          borderRadius: "1rem", 
          textAlign: "center",
          boxShadow: "0 4px 20px rgba(0,0,0,0.1)"
        }}>
          <Stack spacing={4} alignItems="center">
            <Box sx={{
              backgroundColor: "#e8f5e8",
              borderRadius: "50%",
              padding: "1.5rem",
              display: "inline-flex"
            }}>
              <CheckCircleFill size={80} color="#28a745" />
            </Box>
            
            <Typography variant="h3" sx={{ 
              fontWeight: "bold", 
              color: "#28a745",
              marginBottom: "1rem"
            }}>
              {t("Registration Successful!")}
            </Typography>
            
            <Typography variant="h6" sx={{ 
              color: "#666",
              maxWidth: "600px",
              lineHeight: 1.6
            }}>
              {t("Your vessel registration has been submitted successfully. We have received your application and it is now being processed.")}
            </Typography>
            
            <Box sx={{ 
              backgroundColor: "#f8f9fa", 
              padding: "2rem", 
              borderRadius: "1rem",
              width: "100%",
              maxWidth: "400px",
              border: "2px solid #e9ecef"
            }}>
              <Typography variant="body1" sx={{ 
                color: "#666", 
                marginBottom: "1rem",
                fontWeight: 500
              }}>
                {t("Your Registration ID")}
              </Typography>
              <Typography variant="h4" sx={{ 
                fontWeight: "bold", 
                color: "#2E57A7",
                letterSpacing: "1px"
              }}>
                {registrationId}
              </Typography>
            </Box>
            
            <Box sx={{
              backgroundColor: "#fff3cd",
              border: "1px solid #ffeaa7",
              borderRadius: "0.5rem",
              padding: "1.5rem",
              width: "100%",
              maxWidth: "500px"
            }}>
              <Typography variant="body1" sx={{ 
                color: "#856404",
                textAlign: "center",
                lineHeight: 1.5
              }}>
                <strong>{t("Important:")}</strong> {t("Please save your registration ID for future reference. You will receive a confirmation email shortly with further details.")}
              </Typography>
            </Box>
            
            <Stack direction={{ xs: "column", sm: "row" }} spacing={3} sx={{ marginTop: "3rem" }}>
              <Button
                variant="contained"
                size="large"
                startIcon={<House size={20} />}
                onClick={() => navigate("/dashboard")}
                sx={{
                  backgroundColor: "#2E57A7",
                  fontWeight: "bold",
                  borderRadius: "0.75rem",
                  minWidth: "180px",
                  fontSize: "1.1rem",
                  padding: "12px 24px",
                  "&:hover": { backgroundColor: "#1f4ea0" }
                }}
              >
                {t("Go to Dashboard")}
              </Button>
              
              <Button
                variant="outlined"
                size="large"
                startIcon={<FileText size={20} />}
                onClick={() => navigate("/vessel-registration")}
                sx={{
                  color: "#2E57A7",
                  borderColor: "#2E57A7",
                  fontWeight: "bold",
                  borderRadius: "0.75rem",
                  minWidth: "180px",
                  fontSize: "1.1rem",
                  padding: "12px 24px",
                  "&:hover": { 
                    backgroundColor: "#f0f4ff",
                    borderColor: "#1f4ea0"
                  }
                }}
              >
                {t("New Registration")}
              </Button>
            </Stack>
          </Stack>
        </Paper>
      </Container>
    </Box>
  );
};

export default RegistrationSuccess;
