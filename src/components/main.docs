{props.columns.map((o, colIndex) =>
  o.isClickable ? (
    <td
      key={colIndex}
      className={`px-3 py-2 ${o.clsName} ${style.clickable_cell}`}
      onClick={(e) => props.additionalMethod?.(row)}
    >
      <span className={row.isRead === false ? style.unread : ''}>
        {_.get(row, o.fieldName)}
      </span>
    </td>
  ) : !hideColumns.includes(o.fieldName) && o.fieldName !== "action" ? (
    <td
      key={colIndex}
      className={`px-3 py-2 ${o.clsName}`}
    >
      {o.colName === "Status" ? (
        <Tooltip title={_.get(row, o.fieldName) || "No Status"} arrow>
          <span className={`${style.status_badge} ${style[_.get(row, o.fieldName) + '_status'] || ''} ${style.truncate_cell}`}>
            {_.get(row, o.fieldName) ? _.get(row, o.fieldName).split(' ')[0] : "No Status"}
          </span>
        </Tooltip>
      ) : (
        <Tooltip 
          title={_.get(row, o.fieldName) || ''} 
          arrow
          disableHoverListener={!['claimNumber', 'status', 'comment'].includes(o.fieldName.toLowerCase())}
        >
          <span className={`${row.isRead === false ? style.unread : ''} ${style.tooltip_wrapper}`}>
            <span className={style.truncate_cell}>
              {_.get(row, o.fieldName) ? _.get(row, o.fieldName).split(' ')[0] : ''}
              {o.fieldName2 ? _.get(row, o.fieldName2).split(' ')[0] : ""}
            </span>
          </span>
        </Tooltip>
      )}
    </td>
  ) : !hideColumns.includes(o.fieldName) && o.fieldName === "action" ? (
    <td key={colIndex} className={`px-3 py-2 ${o.clsName} ${style.action_cell}`}>
      {/* Action buttons code remains the same */}
    </td>
  ) : null
)}






/* Add to your ActionTable.module.css */
.truncate-cell {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 120px; /* Adjust based on your column width */
  display: inline-block;
}

.tooltip-wrapper {
  display: inline-block;
  width: 100%;
}
