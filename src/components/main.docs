                register={register("polutionControl.exhaustMakeModel")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Others")}
                name="polutionControl.othersPollution"
                type="number"
                placeholder={!viewMode ? t("Enter Others") : ""}
                register={register("polutionControl.othersPollution")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Capacity (m3/hr)")}
                name="polutionControl.othersCapacity"
                placeholder={!viewMode ? t("Enter Capacity (m3/hr)") : ""}
                register={register("polutionControl.othersCapacity")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Make & Model")}
                name="polutionControl.othersMakeModel"
                placeholder={!viewMode ? t("Enter Make & Model") : ""}
                register={register("polutionControl.othersMakeModel")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
          </Row>
        </Collapsible>


        {/* Crew Details */}
        <Collapsible
          title={
            <>
              <FaUsers className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Crew Details")}</span>
            </>
          }
          openStat={true}
        >
          <div style={{ padding: "1rem" }}>
            {/* Total Crew Fields - Single Row */}
            <Row className="gy-3 mb-4 p-3 border rounded" style={{ backgroundColor: "#f8f9fa" }}>
              <Col md={6}>
                <InputText
                  label={t("Total No. of Deck Crew")}
                  name="crewDetails.totalDeckCrew"
                  type="number"
                  placeholder={!viewMode ? t("Enter Total No. of Deck Crew") : ""}
                  register={register("crewDetails.totalDeckCrew")}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={6}>
                <InputText
                  label={t("Total No. of Engine Crew")}
                  name="crewDetails.totalEngineCrew"
                  type="number"
                  placeholder={!viewMode ? t("Enter Total No. of Engine Crew") : ""}
                  register={register("crewDetails.totalEngineCrew")}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
            </Row>

            {/* Individual Crew Members */}
            {fields.map((field, index) => (
              <Row key={field.id} className="gy-3 mb-3 border-bottom pb-3">
                <Col md={3}>
                  <InputSelect
                    label={t("Crew Type")}
                    required={false}
                    placeholder={!viewMode ? t("-- Select --") : ""}

                    name={`crewDetails.crewDetails.${index}.crewType`}
                    options={[
                      { value: "", label: "-- Select --" },
                      ...(masterData?.crewTypes?.map((type) => ({
                        value: type.valueCode,
                        label: type.valueLabel,
                      })) || []),
                    ]}
                    register={register(`crewDetails.crewDetails.${index}.crewType`, {
                      required: t("Crew Type is required"),
                    })}
                    errors={errors}
                    value={watch(`crewDetails.crewDetails.${index}.crewType`) || ""}
                    onChange={(value) =>
                      !viewMode &&
                      handleSelectChange(`crewDetails.crewDetails.${index}.crewType`, value)
                    }
                    disabled={viewMode}
                  />
                </Col>
                <Col md={3}>
                  <InputText
                    label={t("Name")}
                    required={false}
                    name={`crewDetails.crewDetails.${index}.name`}
                    placeholder={!viewMode ? t("Enter Name") : ""}
                    register={register(`crewDetails.crewDetails.${index}.name`, {
                      required: t("Name is required"),
                    })}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Rank")}
                    name={`crewDetails.crewDetails.${index}.rank`}
                    placeholder={!viewMode ? t("Enter Rank") : ""}
                    register={register(`crewDetails.crewDetails.${index}.rank`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("COC No.")}
                    name={`crewDetails.crewDetails.${index}.cocNo`}
                    placeholder={!viewMode ? t("Enter COC No.") : ""}
                    register={register(`crewDetails.crewDetails.${index}.cocNo`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Validity")}
                    name={`crewDetails.crewDetails.${index}.validity`}
                    placeholder={!viewMode ? t("Enter Validity") : ""}
                    register={register(`crewDetails.crewDetails.${index}.validity`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={6}>
                  <InputText
                    label={t("Place of Issue")}
                    name={`crewDetails.crewDetails.${index}.placeOfIssue`}
                    placeholder={!viewMode ? t("Enter Place of Issue") : ""}
                    register={register(`crewDetails.crewDetails.${index}.placeOfIssue`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                {!viewMode && index > 0 && (
                  <Col md={6} className="text-end">
                    <Button
                      variant="danger"
                      size="sm"
                      onClick={() => remove(index)}
                      className="mt-1"
                    >
                      <FaTrash /> Remove
                    </Button>
                  </Col>
                )}
              </Row>
            ))}
            {!viewMode && (
              <Button
                variant="outline-primary"
                onClick={() =>
                  append({
                    crewType: "",
                    name: "",
                    rank: "",
                    cocNo: "",
                    validity: "",
                    placeOfIssue: "",
                  })
                }
                className="mt-2"
              >
                <FaPlus className="me-2" /> Add Crew Member
              </Button>
            )}
          </div>
        </Collapsible>

        {/* Enclosure */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>{t("ENCLOSURE")}</span>
            </div>
          }
          defaultOpen={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "certificateOfRegistration",
                    t("Certificate of Registration")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "NOCfromOriginalRegistrationAuthority",
                    t("NOC from Original Registration Authority")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "lastSurveyCertificate",
                    t("Last Survey Certificate")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "tonnageBooklet",
                    t("Tonnage Booklet")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("stabilityBooklet", t("Stability Booklet"))}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("insuranceCertificate", t("Insurance Certificate"))}
                </Col>
                <Col xs={12} lg={6}>
                  <MultiFile
                    title={t("Main Drawing and Other Drawings")}
                    files={drawingFiles}
                    setFiles={setDrwaingFiles}
                    type="DRAWING"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                  />
                </Col>
                <Col xs={12} lg={6}>
                  <MultiFile
                    title={t("Radiography Report")}
                    files={radiographyFiles}
                    setFiles={setRadiographyFiles}
                    type="RADIOGRAPHY_REPORT"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                  />
                </Col>
                <Col xs={12} lg={6}>
                  <MultiFile
                    title={t("Material Test Report")}
                    files={materialTestFiles}
                    setFiles={setMaterialTestFiles}
                    type="MATERIAL_TEST_REPORT"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                  />
                </Col>
                <Col xs={12} lg={6}>
                  <MultiFile
                    title={t("Other Inspection Reports")}
                    files={otherInspectionFiles}
                    setFiles={setOtherInspectionFiles}
                    type="OTHER_INSPECTION_REPORT"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                  />
                </Col>
                <Col xs={12} lg={6}>
                  <MultiFile
                    title={t("Other Technical Document")}
                    files={otherTechnicalDocumentFiles}
                    setFiles={setOtherTechnicalDocumentFiles}
                    type="OTHER_TECH_DOC"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                  />
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("paymentChallan", t("Payment Challan/Acknowledgement"))}
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>
      </form>
    </>
  );
};

export default TransferOfRegistryForm;
import React, { useState, useEffect, useRef } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams, useLocation, useNavigate, useSearchParams } from "react-router-dom";
