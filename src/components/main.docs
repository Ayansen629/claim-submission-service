import React, { useState, useContext, useEffect } from "react";
import { useForm } from "react-hook-form";
import { useNavigate } from "react-router-dom";
import { toast } from "react-toastify";
import { UserContext } from "../../components/context/UserContext.js";
import "./Login.css";
import {
  fetchInitialClaimantData,
  fetchClaimantCategoriesData,
  fetchFormDetailsData,
} from "../../services/claimant.service.js";

const LoginPage = () => {
  const {
    register,
    handleSubmit,
    watch,
    formState: { errors },
    reset,
    setValue,
    trigger,
  } = useForm();
  const navigate = useNavigate();
  const { setUserData } = useContext(UserContext);

  const [otpSent, setOtpSent] = useState(false);
  const [otp, setOtp] = useState("");
  const [loading, setLoading] = useState(false);
  const [selectedRadio, setSelectedRadio] = useState("corporateDebtor");
  const [claimantTypes, setClaimantTypes] = useState([]);
  const [claimantCategories, setClaimantCategories] = useState([]);
  const [apiLoading, setApiLoading] = useState(false);
  const [corporateDebtors, setCorporateDebtors] = useState([]);
  const [processTypes, setProcessTypes] = useState([]);
  const [selectedCorporateDebtor, setSelectedCorporateDebtor] = useState(null);
  const [selectedProcessType, setSelectedProcessType] = useState(null);
  const [selectedClaimantType, setSelectedClaimantType] = useState(null);
  const [selectedFormName, setSelectedFormName] = useState("");

  // Watch all form values
  const formValues = watch();
  const {
    username,
    email,
    password,
    userType,
    financialCreditorType,
    operationalCreditorType,
    processTypeUuid,
    corporateDebtorUuid,
    termsAccepted
  } = formValues;

  useEffect(() => {
    reset({
      username: "",
      email: "",
      password: "",
      userType: "",
      financialCreditorType: "",
      operationalCreditorType: "",
      processTypeUuid: "",
      corporateDebtorUuid: "",
      corporateDebtorName: "",
    });
    setOtpSent(false);
    setOtp("");
    setSelectedFormName("");
  }, [selectedRadio, reset]);

  // Fetch initial data when radio is claimants
  useEffect(() => {
    if (selectedRadio === "claimants") {
      fetchInitialData();
    }
  }, [selectedRadio]);

  const fetchInitialData = async () => {
    try {
      setApiLoading(true);
      const response = await fetchInitialClaimantData();

      if (response.data.status.code === "200") {
        const data = response.data.claimantMasterData;
        setCorporateDebtors(data.corporateDebtors || []);
        setProcessTypes(data.processTypes || []);
        setClaimantTypes(data.claimantTypes || []);
      } else {
        toast.error(response.data.status.message || "Failed to fetch initial data");
      }
    } catch (error) {
      console.error("Error fetching initial data:", error);
      toast.error(error.response?.data?.status?.message || "Error fetching initial data");
    } finally {
      setApiLoading(false);
    }
  };

  // Fetch claimant categories when dependencies change
  useEffect(() => {
    if (userType && selectedRadio === "claimants" && corporateDebtorUuid && processTypeUuid) {
      const selectedType = claimantTypes.find((type) => type.claimantName === userType);
      if (selectedType) {
        fetchClaimantCategories(selectedType);
      } else {
        setClaimantCategories([]);
        setValue("financialCreditorType", "");
        setValue("operationalCreditorType", "");
      }
    }
  }, [userType, corporateDebtorUuid, processTypeUuid]);

  const fetchClaimantCategories = async (claimantType) => {
    try {
      setApiLoading(true);
      const response = await fetchClaimantCategoriesData(
        corporateDebtorUuid,
        processTypeUuid,
        processTypes.find(p => p.uuid === processTypeUuid)?.processTypeValue,
        claimantType.uuid
      );

      if (response.data.status.code === "200") {
        setClaimantCategories(response.data.claimantMasterData.claimantCategories || []);
        setSelectedClaimantType(claimantType);
      } else {
        toast.error("Failed to fetch claimant categories");
      }
    } catch (error) {
      console.error("Error fetching claimant categories:", error);
      toast.error("Error fetching claimant categories");
    } finally {
      setApiLoading(false);
    }
  };

  const handleCorporateDebtorSelect = (e) => {
    const selectedUuid = e.target.value;
    const selected = corporateDebtors.find((d) => d.uuid === selectedUuid);
    setSelectedCorporateDebtor(selected);
    setValue("corporateDebtorUuid", selectedUuid, { shouldValidate: true });
    setValue("corporateDebtorName", selected?.nameOfCorporateDebtor || "", { shouldValidate: true });
    trigger(["corporateDebtorUuid", "corporateDebtorName"]);
  };

  const handleProcessTypeSelect = (e) => {
    const selectedUuid = e.target.value;
    const selected = processTypes.find((p) => p.uuid === selectedUuid);
    setSelectedProcessType(selected);
    setValue("processTypeUuid", selectedUuid, { shouldValidate: true });
    setValue("processType", selected?.processTypeValue || "", { shouldValidate: true });
    trigger(["processTypeUuid", "processType"]);
  };

  const handleClaimantCategorySelect = async (e, category) => {
    if (!category || !corporateDebtorUuid || !processTypeUuid || !selectedClaimantType) {
      return;
    }
  
    try {
      setApiLoading(true);
      const processType = processTypes.find(p => p.uuid === processTypeUuid);
      
      const payload = {
        debtorsUuid: corporateDebtorUuid,
        processTypeUuid: processTypeUuid,
        processTypeValue: processType?.processTypeValue || "",
        claimantTypeUuid: selectedClaimantType.uuid,
        claimantCategoryUuid: category.uuid,
        formUuid: category.formId
      };
      
      const response = await fetchFormDetailsData(
        payload.debtorsUuid,
        payload.processTypeUuid,
        payload.processTypeValue,
        payload.claimantTypeUuid,
        payload.claimantCategoryUuid,
        payload.formUuid
      );
  
      if (response.data.status.code === "200") {
        setSelectedFormName(response.data.claimantMasterData.formDetail.formName);
      } else {
        toast.error(response.data.status.message || "Failed to fetch form details");
      }
    } catch (error) {
      console.error("Error fetching form details:", error);
      toast.error("Error fetching form details");
    } finally {
      setApiLoading(false);
    }
  };

  const isValidUsername = (username) => /^[6-9]\d{9}$/.test(username);
  const isValidEmail = (email) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

  const isClaimantsFormValid = () => {
    if (selectedRadio === "claimants") {
      const currentValues = watch();

      const basicFieldsValid = 
        isValidUsername(currentValues.username) && 
        currentValues.processTypeUuid && 
        currentValues.corporateDebtorUuid && 
        currentValues.userType;

      if (currentValues.userType === "Financial Creditors") {
        return basicFieldsValid && currentValues.financialCreditorType;
      } else if (currentValues.userType === "Operational Creditors") {
        return basicFieldsValid && currentValues.operationalCreditorType;
      }
      return basicFieldsValid;
    }
    return false;
  };

  const isCorporateDebtorFormValid = () => {
    if (selectedRadio === "corporateDebtor") {
      return isValidEmail(email) && password?.length >= 6 && termsAccepted;
    }
    return false;
  };

  const handleSendOTP = async () => {
    if (!isClaimantsFormValid()) {
      toast.error("Please fill all required fields.");
      return;
    }

    setLoading(true);
    setTimeout(() => {
      const payload = {
        userType: "CLM",
        userId: username,
        processType: processTypes.find(p => p.uuid === processTypeUuid)?.processTypeValue,
        corporateDebtorName: corporateDebtors.find(d => d.uuid === corporateDebtorUuid)?.nameOfCorporateDebtor,
        claimantType: userType,
        claimantCategoryType:
          userType === "Financial Creditors" ? financialCreditorType : operationalCreditorType,
        otp: "123456",
      };

      console.log("OTP Payload:", payload);
      toast.success("OTP Sent");
      setOtpSent(true);
      setLoading(false);
    }, 1000);
  };

  const handleVerifyOTP = async (data) => {
    if (!otp) {
      toast.error("Please enter OTP");
      return;
    }
    if (!data.termsAccepted) {
      toast.info("Please accept terms");
      return;
    }

    setLoading(true);
    setTimeout(() => {
      if (otp === "123456") {
        const payload = {
          userType: "CLM",
          userId: username,
          processType: processTypes.find(p => p.uuid === processTypeUuid)?.processTypeValue,
          corporateDebtorName: corporateDebtors.find(d => d.uuid === corporateDebtorUuid)?.nameOfCorporateDebtor,
          claimantType: userType,
          claimantCategoryType:
            userType === "Financial Creditors" ? financialCreditorType : operationalCreditorType,
          formName: selectedFormName,
        };

        setUserData(payload);
        localStorage.setItem("userFormData", JSON.stringify(payload));
        toast.success("Login Successful");
        navigate("/dashboard");
      } else {
        toast.error("Invalid OTP");
      }
      setLoading(false);
    }, 1000);
  };

  const handleCorporateDebtorLogin = async (data) => {
    setLoading(true);
    setTimeout(() => {
      const payload = {
        userType: "CRP",
        email: data.email,
      };
      console.log("Corporate Debtor Payload:", payload);
      setUserData(payload);
      localStorage.setItem("userFormData", JSON.stringify(payload));
      toast.success("Login Successful");
      navigate("/dashboard");
      setLoading(false);
    }, 1000);
  };

  return (
    <div className="login-page">
      <div className="login-container">
        <div className="Login-header">
          <div className="login-text">LOG IN</div>
        </div>

        <div className="radio-options">
          <div className={`radio-op ${selectedRadio === "corporateDebtor" ? "active" : ""}`}>
            <input
              type="radio"
              id="corporateDebtor"
              name="radioGroup"
              checked={selectedRadio === "corporateDebtor"}
              onChange={() => setSelectedRadio("corporateDebtor")}
            />
            <label htmlFor="corporateDebtor">Corporate Debtor</label>
          </div>
          <div className={`radio-op ${selectedRadio === "claimants" ? "active" : ""}`}>
            <input
              type="radio"
              id="claimants"
              name="radioGroup"
              checked={selectedRadio === "claimants"}
              onChange={() => setSelectedRadio("claimants")}
            />
            <label htmlFor="claimants">Claimants</label>
          </div>
        </div>

        <div className="login-form">
          {selectedRadio === "claimants" ? (
            <form onSubmit={handleSubmit(handleVerifyOTP)}>
              {/* Mobile Number */}
              <div className="form-group">
                <input
                  className="user-input"
                  type="text"
                  {...register("username", {
                    required: "Mobile number is required",
                    pattern: {
                      value: /^[6-9]\d{9}$/,
                      message: "Invalid mobile number",
                    },
                  })}
                  placeholder="Mobile Number"
                />
                {errors.username && <p className="error-message">{errors.username.message}</p>}
              </div>

              {/* Process Type */}
              <div className="dropdown-container">
                <select
                  className="dropdown-select"
                  {...register("processTypeUuid", { 
                    required: "Process type is required",
                    onChange: handleProcessTypeSelect
                  })}
                >
                  <option value="">Process Type</option>
                  {processTypes.map((opt) => (
                    <option key={opt.uuid} value={opt.uuid}>
                      {opt.processTypeName}
                    </option>
                  ))}
                </select>
                {errors.processTypeUuid && <p className="error-message">{errors.processTypeUuid.message}</p>}
              </div>

              {/* Corporate Debtor Name */}
              <div className="dropdown-container">
                <select
                  className="dropdown-select"
                  {...register("corporateDebtorUuid", { 
                    required: "Corporate Debtor name is required",
                    onChange: handleCorporateDebtorSelect
                  })}
                >
                  <option value="">Corporate Debtor Name</option>
                  {corporateDebtors.map((opt) => (
                    <option key={opt.uuid} value={opt.uuid}>
                      {opt.nameOfCorporateDebtor}
                    </option>
                  ))}
                </select>
                {errors.corporateDebtorUuid && (
                  <p className="error-message">{errors.corporateDebtorUuid.message}</p>
                )}
              </div>

              {/* Claimant Type */}
              <div className="dropdown-container">
                <select
                  className="dropdown-select"
                  {...register("userType", {
                    required: "Claimant type is required",
                    onChange: (e) => {
                      const selectedType = claimantTypes.find(type => type.claimantName === e.target.value);
                      setSelectedClaimantType(selectedType);
                      setValue("userType", e.target.value, { shouldValidate: true });
                      setValue("financialCreditorType", "", { shouldValidate: true });
                      setValue("operationalCreditorType", "", { shouldValidate: true });
                      trigger(["userType", "financialCreditorType", "operationalCreditorType"]);
                    },
                  })}
                  disabled={apiLoading}
                >
                  <option value="">Claimant Type</option>
                  {claimantTypes?.map((opt) => (
                    <option key={opt.uuid} value={opt.claimantName}>
                      {opt.claimantName}
                    </option>
                  ))}
                </select>
                {errors.userType && <p className="error-message">{errors.userType.message}</p>}
              </div>

              {userType === "Financial Creditors" && (
                <select
                  className="dropdown-select"
                  {...register("financialCreditorType", {
                    required: "Financial creditor type is required",
                    onChange: (e) => {
                      const selectedCategory = claimantCategories.find((c) => c.uuid === e.target.value);
                      if (selectedCategory) {
                        setValue("financialCreditorType", selectedCategory.uuid, { shouldValidate: true });
                        handleClaimantCategorySelect(e, selectedCategory);
                      }
                    },
                  })}
                  disabled={apiLoading}
                >
                  <option value="">Financial Creditor Type</option>
                  {claimantCategories.map((opt) => (
                    <option key={opt.uuid} value={opt.uuid}>
                      {opt.claimantCategoryName}
                    </option>
                  ))}
                </select>
              )}

              {userType === "Operational Creditors" && (
                <select
                  className="dropdown-select"
                  {...register("operationalCreditorType", {
                    required: "Operational creditor type is required",
                    onChange: (e) => {
                      const selectedCategory = claimantCategories.find((c) => c.uuid === e.target.value);
                      if (selectedCategory) {
                        setValue("operationalCreditorType", selectedCategory.uuid, { shouldValidate: true });
                        handleClaimantCategorySelect(e, selectedCategory);
                      }
                    },
                  })}
                  disabled={apiLoading}
                >
                  <option value="">Operational Creditor Type</option>
                  {claimantCategories.map((opt) => (
                    <option key={opt.uuid} value={opt.uuid}>
                      {opt.claimantCategoryName}
                    </option>
                  ))}
                </select>
              )}

              {/* OTP Section */}
              {!otpSent ? (
                <button
                  type="button"
                  className="send-otp-btn"
                  onClick={handleSendOTP}
                  disabled={!isClaimantsFormValid() || loading || apiLoading}
                  title={
                    !isClaimantsFormValid() ? 
                    `Missing fields: ${[
                      !isValidUsername(username) && "Valid Mobile Number",
                      !processTypeUuid && "Process Type",
                      !corporateDebtorUuid && "Corporate Debtor",
                      !userType && "Claimant Type",
                      userType === "Financial Creditors" && !financialCreditorType && "Financial Creditor Type",
                      userType === "Operational Creditors" && !operationalCreditorType && "Operational Creditor Type"
                    ].filter(Boolean).join(', ')}` 
                    : ""
                  }
                >
                  {loading ? "Sending..." : "Send OTP"}
                </button>
              ) : (
                <div className="otp-verification">
                  <input
                    type="text"
                    value={otp}
                    onChange={(e) => setOtp(e.target.value)}
                    placeholder="Enter OTP"
                    className="user-input"
                  />
                </div>
              )}

              {/* Terms and Submit */}
              <div className="terms-conditions">
                <input
                  type="checkbox"
                  id="termsAccepted"
                  {...register("termsAccepted", { required: "You must accept terms" })}
                />
                <label htmlFor="termsAccepted">
                  I accept the <a href="/terms">Terms & Conditions</a>
                </label>
                {errors.termsAccepted && (
                  <p className="error-message">{errors.termsAccepted.message}</p>
                )}
              </div>

              <button
                type="submit"
                className="login-btn"
                disabled={!otpSent ||
