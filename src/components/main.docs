import React, { useRef } from 'react';
import { Row, Col, Button } from 'react-bootstrap';
import { useFormContext } from 'react-hook-form';
import InputText from './InputText.tsx';
import InputFile from './InputFile.tsx';
import { FaDownload, FaFileUpload, FaExclamationCircle } from 'react-icons/fa';
import { BsFileEarmarkPdf } from 'react-icons/bs';
import { renameFile } from '../../utils/constants.ts';
import {
  getFromLocalStorage,
  setToLocalStorage,
} from "../../utils/localStorageUtils.js";
import axios from 'axios';
import { toast } from 'react-toastify';

const DynamicViewFields = ({ fields, setFormData, formData }) => {
  const { register, formState: { errors }, setValue, watch, setError } = useFormContext();
  const loaderRef = useRef();

  const handleDownload = async (fileData) => {
    console.log("Downloading file:", fileData);
    try {
      if (!fileData?.downLoadFile) {
        toast.error("No download URL available");
        return;
      }
      
      loaderRef.current?.show?.();

      const accessToken = getFromLocalStorage("access_token");
      const tokenDetails = getFromLocalStorage("tokenDetails");
      const sessionState = tokenDetails
        ? JSON.parse(tokenDetails)?.session_state
        : "";

      const response = await axios({
        method: "GET",
        url: fileData.downLoadFile,
        responseType: "blob",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "X-Request-ID": sessionState,
          Accept: "application/octet-stream",
        },
      });

      if (response.data) {
        let filename = fileData.fileName || "document";
        const contentDisposition = response.headers["content-disposition"];
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(
            /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
          );
          if (filenameMatch && filenameMatch[1]) {
            filename = filenameMatch[1].replace(/['"]/g, "");
          }
        }

        const blob = new Blob([response.data], {
          type: response.headers["content-type"] || "application/octet-stream",
        });
        const blobUrl = window.URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = blobUrl;
        link.setAttribute("download", filename);
        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          window.URL.revokeObjectURL(blobUrl);
        }, 100);
      }
    } catch (error) {
      console.error("Error downloading file:", error);
      toast.error("Failed to download file. Please try again.");
    } finally {
      loaderRef.current?.hide?.();
    }
  };

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'additional_docs':
        return (
          <div className="additional-docs-section">
            <div className="additional-docs-header">
              <FaFileUpload className="text-primary" size={20} />
              <h6 className="mb-0 text-primary fw-bold">{field.label}</h6>
              <span className="badge bg-primary rounded-pill" style={{ fontSize: "0.7rem" }}>
                {formData.additionalDocuments?.length || 0} files
              </span>
            </div>
            
            {formData.additionalDocuments?.length > 0 ? (
              <div className="additional-docs-grid">
                {formData.additionalDocuments.map((doc, index) => (
                  <div key={doc.fileStoreId} className="additional-doc-card">
                    <div className="file-item">
                      <div className="file-info">
                        <div className="file-icon">
                          <BsFileEarmarkPdf size={14} />
                        </div>
                        <div className="file-name">{doc.fileName}</div>
                      </div>
                      <div className="file-actions">
                        <Button
                          variant="outline-success"
                          size="sm"
                          className="file-btn download-btn"
                          onClick={() => handleDownload(doc)}
                          title="Download"
                        >
                          <FaDownload size={10} />
                        </Button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div className="text-center py-3 text-muted">
                <BsFileEarmarkPdf size={32} className="opacity-50 mb-2" />
                <p className="mb-0" style={{ fontSize: "0.9rem" }}>
                  No additional documents uploaded
                </p>
              </div>
            )}
          </div>
        );

      case 'file':
        if (field.disabled || field.displayOnly) {
          const fileData = formData[field.name];
          const hasFile = fileData && (fileData.fileName || fileData.downLoadFile);
          
          return (
            <div className="file-field">
              <label className="field-label">
                <BsFileEarmarkPdf size={12} className="field-icon" />
                {field.label}
              </label>
              <div className="file-display">
                {!hasFile ? (
                  <div className="no-file">
                    <FaExclamationCircle size={14} className="no-data-icon" />
                    <span>No data available</span>
                  </div>
                ) : (
                  <div className="file-item">
                    <div className="file-info">
                      <BsFileEarmarkPdf size={14} className="file-icon" />
                      <span className="file-name">
                        {fileData.fileName || `${field.label}.pdf`}
                      </span>
                    </div>
                    <div className="file-actions">
                      {/* <Button 
                        variant="outline-primary" 
                        size="sm" 
                        onClick={() => handleView(fileData)}
                        className="file-btn view-btn"
                        title="View"
                      >
                        <FaEye size={10} />
                      </Button> */}
                      <Button 
                        variant="outline-success" 
                        size="sm" 
                        onClick={() => handleDownload(fileData)}
                        className="file-btn download-btn"
                        title="Download"
                      >
                        <FaDownload size={10} />
                      </Button>
                    </div>
                  </div>
                )}
              </div>
              <input
                type="file"
                className="d-none"
                disabled
                {...register(field.name)}
              />
            </div>
          );
        }
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
                const fileName = `${field.label}${extension}`;
                file.originalName = fileName;
                setValue(field.name, renameFile(file, fileName));
                setFormData(prev => {
                  const updated = { ...prev, [field.name]: file };
                  return updated;
                });

                const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'Only PDF, JPG or PNG files are allowed'
                  });
                }

                if (file.size > 2 * 1024 * 1024) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'File size should not exceed 2MB'
                  });
                }
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={watch(field.name)}
          />
        );

      default:
        const fieldValue = formData[field.name];
        const hasData = fieldValue && fieldValue !== '' && fieldValue !== null && fieldValue !== undefined;
        
        return (
          <div className="text-field">
            <label className="form-label">{field.label}</label>
            {!hasData ? (
              <div className="no-data-field">
                <FaExclamationCircle size={12} className="no-data-icon" />
                <span>No data available</span>
              </div>
            ) : (
              <InputText
                label=""
                required={field.required}
                name={field.name}
                key={field.name}
                type={field.type}
                placeholder={field.placeholder}
                register={register(field?.name, {
                  ...field.validation,
                })}
                onChange={handleChange}
                errors={errors}
                readOnly={field.readOnly}
                icon={field.icon}
                maxlength={field?.maxlength}
                onKeyDown={field?.keyDown}
                disabled={field?.disabled || false}
                className="form-input"
              />
            )}
          </div>
        );
    }
  };

  return (
    <Row className="g-3">
      {fields.map((field, index) => (
        <Col key={index} md={field.colSize || 12}>
          {renderField(field)}
        </Col>
      ))}
    </Row>
  );
};

export default DynamicViewFields;
import React, { useState, useEffect, useRef } from "react";
import { useForm, FormProvider } from "react-hook-form";
import { Container, Row, Col, Button, Card, Badge } from "react-bootstrap";
import {
  FaFileUpload,
  FaArrowLeft,
  FaArrowRight,
  FaArrowAltCircleLeft,
  FaCheckCircle,
  FaUser,
  FaBuilding,
} from "react-icons/fa";
import { BsFileEarmarkPdf, BsDownload } from "react-icons/bs";
import { useNavigate, useParams, useLocation } from "react-router-dom";
import ActionDropdown from "../../../common/ActionDropdown";
import ApprovalModal from "../../../common/ApprovalModal";
import "./userViewPage.css";
import NewLoader from "../../../common/NewLoader";
import DynamicViewFields from "../../../common/DynamicViewFields";
import { useTranslation } from "react-i18next";
import { getFromLocalStorage } from "../../../../utils/localStorageUtils";
import {
  SERVICE_BASE,
  URLS_ENDPOINT,
  BASE_IP,
} from "../../../../utils/urlsConstants.ts";
import { toast } from "react-toastify";
import { postData } from "../../../../services/http.service.ts";
import { handleErrorMessage } from "../../../../utils/errorMessageHandler";
import { getDocumentsForOwner } from "../../../public/user-registration/registration-docs.config.js";
import { useMasterData } from "../../../context/MasterDataContext.js";
const UserViewPage = () => {
  const { t } = useTranslation();
    const { masterData } = useMasterData()
  const { type, id } = useParams();
  const location = useLocation();
  const applicationInfo = location.state?.application;
  const userRole = getFromLocalStorage("userRole");
  const userDetails = getFromLocalStorage("userDetails")
    ? JSON.parse(getFromLocalStorage("userDetails"))
    : "";
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(true);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [completedSteps, setCompletedSteps] = useState(new Set());
  const navigate = useNavigate();
  const [actionsFromAPI, setActionsFromAPI] = useState([]);
  const loaderRef = useRef();

  const isOwner = applicationInfo?.userType === "VESSEL_OWNER";
  const isBuilder = applicationInfo?.userType === "VESSEL_BUILDER";
  const totalSteps = isOwner ? 3 : 2;

const mapFilesByFieldName = (supportingDocument = {}) => {
  const regularFiles = {};
  const additionalFiles = [];

  // Get the correct document array based on category
  const categoryKey = Object.keys(supportingDocument).find(key => 
    supportingDocument[key] && Array.isArray(supportingDocument[key])
  );
  
  if (!categoryKey || !supportingDocument[categoryKey]) return { regularFiles, additionalFiles };

  const documents = supportingDocument[categoryKey];

  documents.forEach(doc => {
    if (doc.documentType === 'ADDITIONAL_DOCUMENT') {
      additionalFiles.push({
        fileName: doc.documentName,
        fileStoreId: doc.fileStoreId,
        downLoadFile: `${BASE_IP}${URLS_ENDPOINT.FILE_STORE_SERVICE.DOWNLOAD_FILE}${doc.fileStoreId}`
      });
    } else {
      // Map document types to field names
      const fieldMapping = {
        'PAN_CARD': 'panCardUpload',
        'GST_CERTIFICATE': 'gstCertificate',
        'TRADE_LICENSE': 'tradeLicenseUpload',
        'AADHAAR_CARD': 'aadhaarUpload',
        'DRIVING_LICENSE': 'dlUpload',
        'AUTHORIZATION_LETTER': 'authorizationLetter',
        'EXISTING_DOCUMENT': 'existingDocuments'
      };

      const fieldName = fieldMapping[doc.documentType];
      if (fieldName) {
        regularFiles[fieldName] = {
          fileName: doc.documentName,
          fileStoreId: doc.fileStoreId,
          downLoadFile: `${BASE_IP}${URLS_ENDPOINT.FILE_STORE_SERVICE.DOWNLOAD_FILE}${doc.fileStoreId}`
        };
      }
    }
  });

  return { regularFiles, additionalFiles };
};
  const getOwnerCategoryLabel = (categoryCode) => {
    const ownerType = masterData?.ownerTypes?.find(
      type => type.valueCode === categoryCode
    );
    return ownerType?.valueLabel || categoryCode;
  };
 
  useEffect(() => {
  setIsLoading(true);
  loaderRef.current?.show?.();

  if (applicationInfo) {
    let processedData = {};

    if (isOwner && applicationInfo.ownerDetails) {
      const ownerData = applicationInfo.ownerDetails;
      const { regularFiles, additionalFiles } = mapFilesByFieldName(ownerData.supportingDocument);
      
      processedData = {
        categoryOfOwner: getOwnerCategoryLabel(ownerData.categoryOfOwner),
        categoryOfOwnerCode: ownerData.categoryOfOwner,
        ownerCompanyName: ownerData.ownerCompanyName,
        existingUser: ownerData.isExistingUser === "Y" ? "Yes" : "No",
        emailId: ownerData.emailId,
        phoneNumber: ownerData.phoneNumber,
        panNo: ownerData.panNo,
        gstNo: ownerData.gstNo,
        addressLine1: ownerData.addressLine1,
        addressLine2: ownerData.addressLine2,
        pin: ownerData.pin,
        district: ownerData.district,
        state: ownerData.state,
        country: ownerData.country,
        authorisedFname: ownerData.authorisedFname,
        authorisedLname: ownerData.authorisedLname,
        authorisedMob: ownerData.authorisedMob,
        authorisedEmail: ownerData.authorisedEmail,
        aadharNumber: ownerData.aadharNumber,
        tradeLicenseNumber: ownerData.tradeLicenseNumber,
        cinNo: ownerData.cinNo,
        dinNo: ownerData.dinNo,
        registrationNumber: applicationInfo.userBasicDetails.registrationNumber,
        status: applicationInfo.userBasicDetails.isActive ? "Approved" : "Pending Review",
        additionalDocuments: additionalFiles,
        ...regularFiles,
      };
    } else if (isBuilder && applicationInfo.builderDetails) {
      const builderData = applicationInfo.builderDetails;
      const { regularFiles, additionalFiles } = mapFilesByFieldName(builderData.supportingDocument);

      processedData = {
        builderName: builderData.builderName,
        emailId: builderData.emailId,
        phoneNumber: builderData.phone,
        panNo: builderData.panNo,
        gstNo: builderData.gstNo,
        addressLine1: builderData.addressLine1,
        addressLine2: builderData.addressLine2,
        pin: builderData.pin,
        district: builderData.district,
        state: builderData.state,
        country: builderData.country,
        registrationNumber: applicationInfo.userBasicDetails.registrationNumber,
        status: applicationInfo.userBasicDetails.isActive ? "Approved" : "Pending Review",
        additionalDocuments: additionalFiles,
        ...regularFiles,
      };
    }

    setFormData(processedData);
    setActionsFromAPI(applicationInfo?.processActionMapResponce?.processs[0]?.actions || []);
    setCompletedSteps(new Set([1]));
  }

  setTimeout(() => {
    setIsLoading(false);
    loaderRef.current?.hide?.();
  }, 500);
}, [applicationInfo, isOwner, isBuilder, masterData]);

  const methods = useForm({ defaultValues: { country: "India" } });
  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading && Object.keys(formData)?.length > 0) {
      Object?.keys(formData)?.forEach((key) => {
        if (formData[key] !== undefined && formData[key] !== null) {
          setValue(key, formData[key]);
        }
      });
    }
  }, [isLoading, formData, setValue]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const workflowApplicationSubmit = async (modalFormData) => {
    loaderRef?.current?.show();

    try {
      const URL = `${SERVICE_BASE.IWT_WORKFLOW}${URLS_ENDPOINT.WORK_FLOW_SERVICE.WORKFLOW_ACTION}`;

      const userName =
        userDetails?.userName ||
        JSON.parse(getFromLocalStorage("userDetails"))?.userName ||
        "";

      const payload = {
        applicationNo: applicationInfo?.userBasicDetails?.registrationNumber,
        processId: applicationInfo?.processActionMapResponce?.processs?.[0]?.processId,
        actionId: selectedAction?.actionId,
        assignerRole: userRole,
        assignerName: userName,
        fileId: modalFormData?.document?.url ?? "",
        remarks: modalFormData?.reason ?? "",
      };

      const { status, data } = await postData(URL, payload);
      const { responseStatus } = data || {};

      if (status === 200 && responseStatus?.status === "200") {
        toast.success(responseStatus?.message || "Action submitted successfully");
        handleCloseModal();

        setTimeout(() => navigate("/user-registration/view"), 2000);
      } else {
        toast.info(responseStatus?.message || "Something went wrong..", {
          position: "top-right",
        });
      }
    } catch (err) {
      console.error(err);
      handleErrorMessage(err?.response?.data);
    } finally {
      loaderRef?.current?.hide();
    }
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const getFormFieldsConfig = () => {
    if (isOwner) {
      return {
        step1: [
          {
            name: "categoryOfOwner",
            label: t("vesselOwnerRegistration.Category of Owner"),
            type: "text",
            colSize: 6,
          },
          {
            name: "ownerCompanyName",
            label: t("vesselOwnerRegistration.Owner/Company Name"),
            type: "text",
            colSize: 6,
          },
          {
          name: "existingUser",
          label: t("vesselOwnerRegistration.Existing User ?"),
          type: "text",
          colSize: 6,
        },
          {
            name: "emailId",
            label: t("vesselOwnerRegistration.Email ID"),
            type: "email",
            colSize: 6,
          },
          {
            name: "phoneNumber",
            label: t("vesselOwnerRegistration.Phone Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "panNo",
            label: t("vesselOwnerRegistration.PAN Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "aadharNumber",
            label: t("vesselOwnerRegistration.aadharNo"),
            type: "text",
            colSize: 6,
          },
          {
            name: "tradeLicenseNumber",
            label: t("vesselOwnerRegistration.tradeLicense"),
            type: "text",
            colSize: 6,
          },
          {
            name: "gstNo",
            label: t("vesselOwnerRegistration.GST Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "cinNo",
            label: t("vesselOwnerRegistration.CIN Number"),
            type: "text",
            colSize: 6,
            showIf: () => ["COMPANY", "FIRM", "PRIVATE_LTD"].includes(formData.categoryOfOwner),
          },
          {
            name: "dinNo",
            label: t("vesselOwnerRegistration.DIN Number"),
            type: "text",
            colSize: 6,
            showIf: () => ["COMPANY", "FIRM", "PRIVATE_LTD"].includes(formData.categoryOfOwner),
          },
          {
            name: "addressLine1",
            label: t("vesselOwnerRegistration.Address Line-1"),
            type: "text",
            colSize: 6,
          },
          {
            name: "addressLine2",
            label: t("vesselOwnerRegistration.Address Line-2"),
            type: "text",
            colSize: 6,
          },
          {
            name: "pin",
            label: t("vesselOwnerRegistration.PIN"),
            type: "text",
            colSize: 6,
          },
          {
            name: "district",
            label: t("vesselOwnerRegistration.District"),
            type: "text",
            colSize: 6,
          },
          {
            name: "state",
            label: t("vesselOwnerRegistration.State / UT"),
            type: "text",
            colSize: 6,
          },
          {
            name: "country",
            label: t("vesselOwnerRegistration.Country"),
            type: "text",
            colSize: 6,
          },
        ],
        step2: [
          {
            name: "authorisedFname",
            label: t("vesselOwnerRegistration.First Name"),
            type: "text",
            colSize: 6,
          },
          {
            name: "authorisedLname",
            label: t("vesselOwnerRegistration.Last Name"),
            type: "text",
            colSize: 6,
          },
          {
            name: "authorisedMob",
            label: t("vesselOwnerRegistration.Primary Mobile Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "authorisedEmail",
            label: t("vesselOwnerRegistration.Email ID"),
            type: "email",
            colSize: 6,
          },
          {
            name: "authorizationLetter",
            label: t("vesselOwnerRegistration.Letter of Authorization"),
            type: "file",
            colSize: 6,
          },
        ],
        step3: [
        
          ...getDocumentsForOwner({categoryOfOwner: formData.categoryOfOwnerCode}, null, t).map(doc => ({
            ...doc,
            type: "file",
            disabled: true,
            inputClassName: "disabled-field",
          })),
            {
          name: "existingDocuments",
          label: t("vesselOwnerRegistration.Existing Documents"),
          type: "file",
          colSize: 6,
          disabled: true,
          inputClassName: "disabled-field",
        },
         
          {
            name: "additionalDocuments",
            label: t("vesselOwnerRegistration.Additional_Documents"),
            type: "additional_docs",
            colSize: 12,
          },
        ],
      };
    } else {
      return {
        step1: [
          {
            name: "builderName",
            label: t("builderRegistration.builderName"),
            type: "text",
            colSize: 6,
          },
          {
            name: "emailId",
            label: t("builderRegistration.Email ID"),
            type: "email",
            colSize: 6,
          },
          {
            name: "phoneNumber",
            label: t("builderRegistration.Phone Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "panNo",
            label: t("builderRegistration.PAN Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "gstNo",
            label: t("builderRegistration.GST Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "addressLine1",
            label: t("builderRegistration.Address Line-1"),
            type: "text",
            colSize: 6,
          },
          {
            name: "addressLine2",
            label: t("builderRegistration.Address Line-2"),
            type: "text",
            colSize: 6,
          },
          {
            name: "pin",
            label: t("builderRegistration.PIN"),
            type: "text",
            colSize: 6,
          },
          {
            name: "district",
            label: t("builderRegistration.District"),
            type: "text",
            colSize: 6,
          },
          {
            name: "state",
            label: t("builderRegistration.State / UT"),
            type: "text",
            colSize: 6,
          },
          {
            name: "country",
            label: t("builderRegistration.Country"),
            type: "text",
            colSize: 6,
          },
        ],
        step2: [
          {
            name: "companyDetails",
            label: t("builderRegistration.Company Details"),
            type: "file",
            colSize: 6,
          },
          {
            name: "gstCertificate",
            label: t("builderRegistration.GST Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "panCardUpload",
            label: t("builderRegistration.PAN Card"),
            type: "file",
            colSize: 6,
          },
          {
            name: "factoryLicense",
            label: t("builderRegistration.Factory License"),
            type: "file",
            colSize: 6,
          },
          {
            name: "addressProof",
            label: t("builderRegistration.Address Proof"),
            type: "file",
            colSize: 6,
          },
          {
            name: "fireCertificate",
            label: t("builderRegistration.Fire Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "esipfRegistration",
            label: t("builderRegistration.ESIPF Registration"),
            type: "file",
            colSize: 6,
          },
          {
            name: "iso9001",
            label: t("builderRegistration.ISO 9001 Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "iso14001",
            label: t("builderRegistration.ISO 14001 Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "iso45001",
            label: t("builderRegistration.ISO 45001 Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "pollutionCertificate",
            label: t("builderRegistration.Pollution Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "experienceCertificate",
            label: t("builderRegistration.Experience Certificate"),
            type: "file",
            colSize: 6,
          },
          // // Additional documents for builder
          // {
          //   name: "additionalDocuments",
          //   label: t("builderRegistration.Additional Documents"),
          //   type: "additional_docs",
          //   colSize: 12,
          // },
        ],
      };
    }
  };

  const formFields = getFormFieldsConfig();

  const getDisabledFormFieldsConfig = () => {
    const config = {};
    Object.keys(formFields).forEach((stepKey) => {
      config[stepKey] = formFields[stepKey].map((field) => ({
        ...field,
        disabled: true,
        inputClassName: "disabled-field",
      }));
    });
    return config;
  };

  const disabledFormFields = getDisabledFormFieldsConfig();

  const getCurrentStepFields = () => {
    let fields = [];
    switch (currentStep) {
      case 1:
        fields = disabledFormFields.step1;
        break;
      case 2:
        fields = disabledFormFields.step2;
        break;
      case 3:
        fields = disabledFormFields.step3 || [];
        break;
      default:
        fields = [];
    }

    // Filter fields based on showIf condition
    return fields.filter((field) => !field.showIf || field.showIf());
  };

  const handleNext = () => {
    if (currentStep < totalSteps) {
      setCompletedSteps((prev) => new Set([...prev, currentStep]));
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const handleBackToList = () => {
    navigate("/user-registration/view");
  };

  const getStatusBadge = (status) => {
    const statusMap = {
      "Pending Review": "warning",
      Pending: "warning",
      Approved: "success",
      Completed: "success",
      Rejected: "danger",
      Processing: "info",
    };
    return (
      <Badge bg={statusMap[status] || "secondary"} className="status-badge">
        {status}
      </Badge>
    );
  };

  const getStepIcon = (stepNumber) => {
    if (completedSteps.has(stepNumber)) {
      return <FaCheckCircle className="text-white" size={12} />;
    }

    if (isOwner) {
      const ownerIcons = [FaUser, FaUser, FaFileUpload];
      return currentStep === stepNumber
        ? React.createElement(ownerIcons[stepNumber - 1], {
          className: "text-white",
          size: 12,
        })
        : stepNumber;
    } else {
      const builderIcons = [FaBuilding, FaFileUpload];
      return currentStep === stepNumber
        ? React.createElement(builderIcons[stepNumber - 1], {
          className: "text-white",
          size: 12,
        })
        : stepNumber;
    }
  };

  const getStepTitles = () => {
    if (isOwner) {
      return [
        t("vesselOwnerRegistration.Vessel Owner Details"),
        t("vesselOwnerRegistration.Authorized Person's Details"),
        t("vesselOwnerRegistration.Documents Upload"),
      ];
    } else {
      return [
        t("builderRegistration.Vessel Builder Details"),
        t("builderRegistration.Documents Upload"),
      ];
    }
  };

  const stepTitles = getStepTitles();

  if (isLoading) {
    return <NewLoader ref={loaderRef} />;
  }

  return (
    <>
      <Container fluid className="py-4 officer-view-container">
        <Row className="justify-content-center">
          <Col size={12}>
            <Card className="shadow-lg border-0 modern-card">
              <Card.Header className="modern-header">
                <div className="header-content">
                  <div className="header-left">
                    <button
                      className="back-btn"
                      style={{ width: "2.4rem" }}
                      onClick={handleBackToList}
                    >
                      <FaArrowAltCircleLeft
                        style={{ verticalAlign: "baseline" }}
                        size={16}
                      />
                    </button>
                  </div>

                  <div className="header-center">
                    <h2 className="app-title">Application Review</h2>
                    <div className="app-details">
                      <div className="app-number">
                        <span className="app-label">ID:</span>
                        <span className="app-id">
                          {formData.registrationNumber || "N/A"}
                        </span>
                      </div>
                      <div className="user-type">
                        <span className="type-badge">
                          {isOwner ? "Owner" : "Builder"}
                        </span>
                      </div>
                    </div>
                  </div>
                    {/* <div className="header-right">
                    {getStatusBadge(formData.status)}
                  </div> */}
                </div>
              </Card.Header>

              <Card.Body className="modern-body">
                <div className="stepper-container">
                  {Array.from({ length: totalSteps }, (_, i) => i + 1).map(
                    (step, index) => (
                      <React.Fragment key={step}>
                        <div
                          className={`stepper-step ${currentStep === step ? "active" : ""
                            } ${completedSteps.has(step) ? "completed" : ""}`}
                        >
                          <div className="step-circle">{getStepIcon(step)}</div>
                          <div className="step-label">
                            {stepTitles[step - 1]}
                          </div>
                        </div>

                        {index < totalSteps - 1 && (
                          <div className="step-connector"></div>
                        )}
                      </React.Fragment>
                    )
                  )}
                </div>

                <FormProvider {...methods}>
                  <form>
                    <div className="form-section">
                      <Row className="g-3">
                        <DynamicViewFields
                          fields={getCurrentStepFields()}
                          setFormData={setFormData}
                          formData={formData}
                        />
                      </Row>
                    </div>

                    <div className="form-actions">
                      {currentStep > 1 && (
                        <Button
                          variant="outline-secondary"
                          onClick={handlePrevious}
                          className="action-btn prev-btn"
                        >
                          <FaArrowLeft size={12} className="me-2" /> Previous
                        </Button>
                      )}

                      {currentStep < totalSteps ? (
                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="action-btn next-btn"
                          style={
                            currentStep === 1 ? { marginLeft: "auto" } : {}
                          }
                        >
                          Next <FaArrowRight size={12} className="ms-2" />
                        </Button>
                      ) : (
                        <ActionDropdown
                          actions={actionsFromAPI}
                          onActionClick={handleActionClick}
                          variant="success"
                          className="action-dropdown"
                        />
                      )}
                    </div>
                  </form>
                </FormProvider>
              </Card.Body>
            </Card>
          </Col>
        </Row>

        <ApprovalModal
          show={showApprovalModal}
          handleClose={handleCloseModal}
          handleSubmitData={workflowApplicationSubmit}
          selectedAction={selectedAction}
        />
      </Container>
    </>
  );
};

export default UserViewPage;
