.registration-container {
  /* background-image: linear-gradient(rgba(36, 102, 191, 0.5), rgba(70, 149, 255, 0.5)),
                    url('../../../assets/images/iwt-wallpaper.png'); */
  /* background-image: url('../../../assets/images/login-bg.jpg');
   */
  background-image: linear-gradient(
      rgba(36, 102, 191, 0.5),
      rgba(70, 149, 255, 0.5)
    ),
    url("../../../assets/images/iwt_bg1.jpg");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  min-height: 100vh;
  overflow-x: hidden;
}

.registration-card {
  transition: all 0.3s ease;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border: none !important;
}

.registration-header {
  border-bottom: none;
  position: relative;
}

.registration-header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.2rem 1.5rem;
  background: linear-gradient(135deg, #ffffff, #f8f9fa);
  border-bottom: 2px solid #0077b6;
  position: relative;
  overflow: hidden;
}

.registration-header-content::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: url("../../../assets/images/iwt-whole.jpg");
  background-size: cover;
  opacity: 0.05;
  z-index: 0;
}

.header-logo-container {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.header-logo {
  height: 70px;
  object-fit: contain;
  margin-right: 20px;
}

.header-title {
  margin: 0;
  font-weight: 700;
  color: #0077b6;
  position: relative;
  z-index: 1;
  font-size: 1.8rem;
  text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.05);
}

.header-title::after {
  content: "";
  position: absolute;
  bottom: -5px;
  left: 0;
  width: 40px;
  height: 3px;
  background: linear-gradient(to right, #dfbe08, #f8d231);
  border-radius: 3px;
}

.form-section {
  transition: all 0.3s ease;
  background-color: rgba(255, 255, 255, 0.9) !important;
  border-radius: 12px;
}

.form-section:hover {
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08) !important;
}

.section-title {
  display: flex;
  align-items: center;
  padding-bottom: 0.75rem;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

.section-icon {
  color: #0077b6;
  margin-right: 0.75rem;
  font-size: 1.5rem;
}

/* Fix for input with icon alignment */
.input-with-icon {
  position: relative;
}

.input-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  color: #0077b6;
}

.custom-input,
.custom-select {
  padding-left: 40px !important;
}

.form-select {
  padding-left: 40px !important;
  background-position: right 0.75rem center !important;
}

/* Stepper styling */
.stepper-container {
  margin-bottom: 2rem;
}

.step-icon {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.step.active .step-icon {
  transform: scale(1.05);
}

.step.completed .step-icon {
  transform: scale(1);
}

.connector-line {
  transition: all 0.5s ease;
}

/* Button styling */
.form-navigation {
  margin-top: 2rem;
}

.prev-btn,
.next-btn {
  min-width: 150px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  border-radius: 8px;
  transition: all 0.3s ease;
}

.next-btn {
  background: linear-gradient(135deg, #0077b6, #023e8a);
  border: none;
  box-shadow: 0 4px 15px rgba(0, 119, 182, 0.3);
}

.next-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 119, 182, 0.4);
}

.prev-btn {
  border: 2px solid #6c757d;
  background: white;
  color: #6c757d;
}

.prev-btn:hover {
  background-color: #5a6268;
  border-color: #f8f9fa;
  color: white;
}

/* Success container styling */
.success-container {
  animation: fadeIn 0.5s ease;
}

.success-icon-container {
  animation: scaleIn 0.5s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes scaleIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .header-title {
    font-size: 1.5rem;
  }

  .header-logo {
    height: 50px;
    margin-right: 15px;
  }

  .registration-header-content {
    padding: 1rem;
  }

  .step-label {
    font-size: 0.8rem !important;
  }

  .step-icon {
    width: 50px !important;
    height: 50px !important;
  }
}

@media (max-width: 576px) {
  .header-title {
    font-size: 1.2rem;
  }

  .header-logo {
    height: 40px;
    margin-right: 10px;
  }

  .form-navigation {
    flex-direction: column;
    gap: 1rem;
  }

  .prev-btn,
  .next-btn {
    width: 100%;
    margin-bottom: 10px;
  }
}
