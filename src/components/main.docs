const handleCertificateSubmit = async () => {
  try {
    loaderRef.current?.show();
    
    const formData = methods?.getValues();
    
    // Call PROV_REGISTRATION_CERTIFICATE API
    const URL = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.CERT.CREATE;
    
    const request = {
      certificateType: "PROV_REGISTRATION_CERTIFICATE",
      registrationCertificateDetails: {
        certificateExpiryDate: formData?.certificateOfRegistration?.basicInfo?.dateOfRegistry || "",
        applicationNumber: registrationData?.vessel?.applicationNumber || "",
        applicationId: registrationData?.applicationId || "",
        registrationDate: formData?.certificateOfRegistration?.basicInfo?.dateOfRegistry || "",
        vesselName: formData?.certificateOfRegistration?.basicInfo?.nameOfVessel || "",
        portOfRegistry: formData?.certificateOfRegistration?.basicInfo?.portOfRegistry || "",
        previousRegistrationNumber: formData?.certificateOfRegistration?.basicInfo?.previousRegistryPort || "",
        dateOfPreviousRegisty: formData?.certificateOfRegistration?.basicInfo?.dateOfPreviousRegistry || "",
        portOfPreviousRegistry: formData?.certificateOfRegistration?.basicInfo?.previousRegistryPort || "",
        nameOfBuilder: formData?.certificateOfRegistration?.basicInfo?.nameOfBuilder || "",
        addressOfBuilder: formData?.certificateOfRegistration?.basicInfo?.addressOfBuilder || "",
        placeOfBuilt: formData?.certificateOfRegistration?.basicInfo?.whereBuilt || "",
        propulsionType: formData?.certificateOfRegistration?.basicInfo?.propulsionType || "",
        numberOfDeck: parseInt(formData?.certificateOfRegistration?.basicInfo?.numberOfDecks) || 0,
        materialDescription: formData?.certificateOfRegistration?.basicInfo?.material || "",
        numberOfBulkHeads: parseInt(formData?.certificateOfRegistration?.basicInfo?.numberOfBulkheads) || 0,
        strengthOfDeck: "",
        build: formData?.certificateOfRegistration?.basicInfo?.indianOrForeignBuilt || "",
        length: formData?.certificateOfRegistration?.basicInfo?.length || "0",
        breadth: formData?.certificateOfRegistration?.basicInfo?.breadth || "0",
        depth: formData?.certificateOfRegistration?.basicInfo?.depth || "0",
        draft: formData?.certificateOfRegistration?.basicInfo?.draft || "0",
        lengthOfEngineRoom: parseFloat(formData?.certificateOfRegistration?.basicInfo?.lengthOfEngineRoom) || 0,
        grossTonnage: parseFloat(formData?.certificateOfRegistration?.particularsOfTonnage?.grossTonnage) || 0,
        netTonnage: parseFloat(formData?.certificateOfRegistration?.particularsOfTonnage?.netTonnage) || 0,
        numberOfCrew: parseInt(formData?.certificateOfRegistration?.particularsOfTonnage?.numberOfCrew) || 0,
        numberOfEngines: parseInt(formData?.certificateOfRegistration?.particularsOfEngine?.noOfSets) || 0,
        combinedPower: parseFloat(formData?.certificateOfRegistration?.particularsOfEngine?.bhp) || 0,
        nameOfEngineMaker: formData?.certificateOfRegistration?.particularsOfEngine?.madeBy || "",
        addressOfEngineMaker: formData?.certificateOfRegistration?.particularsOfEngine?.engineMakerAddress || "",
        summaryDescriptionOfTonnage: formData?.certificateOfRegistration?.summary || "",
        state: "",
        nameOfMaster: registrationData?.vessel?.nameOfMaster || "",
        cocNumber: "",
        ownerName: registrationData?.owner?.name || "",
        addressOfOwner: registrationData?.owner?.address || "",
        officialNumber: formData?.certificateOfRegistration?.basicInfo?.officialNo || "",
        numberOfTenthShares: "",
      },
    };

    const response = await postData(URL, request);
    
    if (response?.status === 200 || response?.status === 201) {
      toast.success("Certificate of Registration generated successfully!");
      navigate("/dashboard");
      return true;
    } else {
      toast.error("Failed to generate Certificate of Registration.");
      return false;
    }
  } catch (error) {
    console.error("Certificate submission error:", error);
    toast.error("Failed to generate Certificate of Registration.");
    return false;
  } finally {
    loaderRef.current?.hide();
  }
};
