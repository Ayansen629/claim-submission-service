const handleFormSubmit = async (stepInfo) => {
  window.scrollTo({ top: 0, behavior: "smooth" });

  //-- Step 1  Initial Survey Form Submission -- //
  if (stepInfo.index === 0) {
    const formValues = stepInfo?.getFormData?.() || {};
    const surveyPayload = buildSurveyPayload(formValues, registrationData);
    submitIntialSurveyData(surveyPayload, stepInfo);
  }

  //-- Step 2  Equipment Form Submission -- //
  if (stepInfo.index === 1) {
    const formValues = stepInfo?.getFormData?.() || {};
    const equipmentPayload = buildEquipmentPayload(formValues, intialSurveyData);
    submitIntialSurveyData(equipmentPayload, stepInfo);
  }
};
