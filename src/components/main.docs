import React from "react";
import {
  Container,
  Row,
  Col,
  Card,
  Button,
  Navbar,
  Nav,
} from "react-bootstrap"; // Import Navbar and Nav
import { NavDropdown } from "react-bootstrap";
import Banner from "../../assets/images/Banner.png";
import Ship from "../../assets/images/ship.png";
import Tower from "../../assets/images/tower.jpg";
import Map from "../../assets/images/map.png";
import vector from "../../assets/images/Vector.png";
import transfer from "../../assets/images/transfer.png";
import Navigation from "../../assets/images/Navigation.png";
import Suitcase from "../../assets/images/suitcase.png";
import Profile from "../../assets/images/pic.png";
import Notebook from "../../assets/images/note.svg";
import tick from "../../assets/images/tick.png";
import iwtnote from "../../assets/images/iwtnote.svg";
import Shield from "../../assets/images/Shield.png";
import Arrow from "../../assets/images/arrow.png";
import LastIcon from "../../assets/images/lasticon.png";
import Linkedin from "../../assets/images/Linkedin.png";
import Instagram from "../../assets/images/Instagram.png";
import HeaderLogo from "../../assets/images/bengal-logo.png";
import Login from "../../assets/images/iwtlogin.png";
const IWTHomePage = () => {
  const quickActionCards = [
    {
      id: 1,
      title: "Offences & Penalties",
      icon: (
        <img src={iwtnote} alt="Offences & Penalties" className="img-fluid" />
      ),
      buttonText: "Proceed",
    },
    {
      id: 2,
      title: "Investigation",
      icon: <img src={Shield} alt="Compliance Status" className="img-fluid" />,
      buttonText: "Proceed",
    },
    {
      id: 3,
      title: "Crew/Citizen Information",
      icon: <img src={Shield} alt="Inspection Reports" className="img-fluid" />,
      buttonText: "Proceed",
    },
    {
      id: 4,
      title: "Manning,Training & Cretification",
      icon: <img src={LastIcon} alt="Vessel Details" className="img-fluid" />,
      buttonText: "Proceed",
    },
  ];

  return (
    <Container fluid className="p-0">
      {/* Banner Section */}
      <div
        className="container-bannerimg"
        style={{
          backgroundImage: `url(${Banner})`,
          height: "632px",
          backgroundSize: "cover",
          position: "relative", // Ensures the navbar can be positioned inside
        }}
      >
        {/* Navbar Section */}
        <Navbar
          expand="lg"
          bg="transparent"
          variant="dark"
          style={{ position: "absolute", top: 0, width: "100%" }}
        >
          <Container>
            {/* Brand Logo */}
            <Navbar.Brand href="#home">
              <img
                src={HeaderLogo}
                alt="Logo"
                style={{ width: "60px", height: "60px", marginRight: "10px" }}
              />
            </Navbar.Brand>

            {/* Navbar Toggle for Mobile View */}
            <Navbar.Toggle aria-controls="basic-navbar-nav" />

            {/* Navbar Links */}
            <Navbar.Collapse id="basic-navbar-nav">
              <Nav className="ms-auto d-flex align-items-center">
                {/* Home Link */}
                <Nav.Link href="#home" className="mx-2">
                  Home
                </Nav.Link>

                {/* Vessel Registration Dropdown */}
                <NavDropdown
                  title="Vessel Registration"
                  id="vessel-registration-dropdown"
                  className="mx-2"
                >
                  <NavDropdown.Item href="#new-registration">
                    New Registration
                  </NavDropdown.Item>
                  <NavDropdown.Item href="#renewal">Renewal</NavDropdown.Item>
                </NavDropdown>

                {/* Vessel Survey Dropdown */}
                <NavDropdown
                  title="Vessel Survey"
                  id="vessel-survey-dropdown"
                  className="mx-2"
                >
                  <NavDropdown.Item href="#survey-schedule">
                    Survey Schedule
                  </NavDropdown.Item>
                  <NavDropdown.Item href="#survey-reports">
                    Survey Reports
                  </NavDropdown.Item>
                </NavDropdown>

                {/* Finance Accounts Link */}
                <Nav.Link
                  href="#finance"
                  className="mx-2"
                  style={{ whiteSpace: "nowrap" }}
                >
                  Finance Accounts
                </Nav.Link>

                {/* Grievance Redressal Link */}
                <Nav.Link
                  href="#grievance"
                  className="mx-2"
                  style={{ whiteSpace: "nowrap" }}
                >
                  Grievance Redressal
                </Nav.Link>

                {/* Quick Links Dropdown */}
                <NavDropdown
                  title="Quick Links"
                  id="quick-links-dropdown"
                  className="mx-2"
                >
                  <NavDropdown.Item href="#link1">Link 1</NavDropdown.Item>
                  <NavDropdown.Item href="#link2">Link 2</NavDropdown.Item>
                </NavDropdown>

                {/* Login Button with Image */}
                <Nav.Link href="/login" className="btn text-white px-3 mx-2">
                  <img
                    src={Login}
                    alt="Login"
                    // className="img-fluid"
                    style={{
                      width: "70px",
                      height: "70px",
                      objectFit: "contain",
                    }} // Ensures proper scaling
                    onError={(e) => {
                      e.target.src = ""; // If the image fails to load, set src to blank
                      e.target.alt = "Login Icon Not Found"; // Display fallback text
                    }}
                  />
                </Nav.Link>
              </Nav>
            </Navbar.Collapse>
          </Container>
        </Navbar>
      </div>

      {/* Header Section */}
      <Row className="text-white">
        {[...Array(4)].map((_, index) => (
          <Col className="iwt-bg" key={index} md={3}>
            <h1 style={{textAlign: 'center'}}>5000+</h1>
            <h5>Total Registered Vessel</h5>
            <p>
              Lorem Ipsum Dol sit amet. Lorem Ipsum Dol sit amet. Lorem Ipsum
              Dol sit amet.
            </p>
          </Col>
        ))}
      </Row>

      {/* Vessel Registration Section */}
      <Container className="my-5">
        <h2>Vessel Registration</h2>
        <p>
          Lorem Ipsum is simply dummy text of the printing and typesetting
          industry. Lorem Ipsum has been the industry's standard dummy text ever
          since the 1500s, when an unknown printer took a galley of type and
          scrambled it to make a type specimen book.
        </p>
        <Row>
          <Col md={6}>
            {/* First Row */}
            <Row>
              <Col md={6} className="border p-1">
                <div style={{ display: "flex" }}>
                  <div className="vessel-RegLeftSideFirstContainerlogo">
                    <img src={vector} alt="train" className="img-fluid" />
                  </div>
                  <div className="vessel-RegLeftSidedescription">
                    <div className="vessel-RegLeftSidedescription1">
                      <p className="vessel-RegLeftSidedescription1Styling">
                        New Vessel Registration
                      </p>
                    </div>
                    <div className="vess-description">
                      <p className="vess-description1">
                        Lorem Ipsum is simply dummy text of the printing and
                        typesetting industry.
                      </p>
                    </div>
                    <div className="onlinedescription">
                      <img
                        src={Navigation}
                        alt="Navigation"
                        className="img-fluid"
                      />
                    </div>
                  </div>
                </div>
              </Col>
              <Col md={6} className="border p-1">
                <div style={{ display: "flex" }}>
                  <div className="vessel-RegLeftSideSecondContainer-logo">
                    <img src={Suitcase} alt="Suitcase" className="img-fluid" />
                  </div>
                  <div className="vessel-RegLeftSidedescription">
                    <div className="vessel-RegLeftSidedescription1">
                      <p className="vessel-RegLeftSidedescription1Styling">
                        New Vessel Registration
                      </p>
                    </div>
                    <div className="vess-description">
                      <p className="vess-description1">
                        Lorem Ipsum is simply dummy text of the printing and
                        typesetting industry.
                      </p>
                    </div>
                    <div className="onlinedescription">
                      <img
                        src={Navigation}
                        alt="Navigation"
                        className="img-fluid"
                      />
                    </div>
                  </div>
                </div>
              </Col>
            </Row>

            {/* Second Row */}
            <Row className="mt-3">
              <Col md={6} className="border p-1">
                <div style={{ display: "flex" }}>
                  <div className="vessel-RegLeftSideFirstContainerlogo">
                    <img src={transfer} alt="transfer" className="img-fluid" />
                  </div>
                  <div className="vessel-RegLeftSidedescription">
                    <div className="vessel-RegLeftSidedescription1">
                      <p className="vessel-RegLeftSidedescription1Styling">
                        Transfer of Registry
                      </p>
                    </div>
                    <div className="vess-description">
                      <p className="vess-description1">
                        Lorem Ipsum is simply dummy text of the printing and
                        typesetting industry.
                      </p>
                    </div>
                    <div className="onlinedescription">
                      <img
                        src={Navigation}
                        alt="Navigation"
                        className="img-fluid"
                      />
                    </div>
                  </div>
                </div>
              </Col>
              <Col md={6} className="border p-1">
                <div style={{ display: "flex" }}>
                  <div className="vessel-RegLeftSideSecondContainer-logo">
                    <img src={Profile} alt="Profile" className="img-fluid" />
                  </div>
                  <div className="vessel-RegLeftSidedescription">
                    <div className="vessel-RegLeftSidedescription1">
                      <p className="vessel-RegLeftSidedescription1Styling">
                        Transfer of Registry
                      </p>
                    </div>
                    <div className="vess-description">
                      <p className="vess-description1">
                        Lorem Ipsum is simply dummy text of the printing and
                        typesetting industry.
                      </p>
                    </div>
                    <div className="onlinedescription">
                      <img
                        src={Navigation}
                        alt="Navigation"
                        className="img-fluid"
                      />
                    </div>
                  </div>
                </div>
              </Col>
            </Row>

            {/* Third Row */}
            <Row className="mt-3">
              <Col md={6} className="border p-1">
                <div style={{ display: "flex" }}>
                  <div className="vessel-RegLeftSideFirstContainerlogo">
                    <img src={Notebook} alt="Notebook" className="img-fluid" />
                  </div>
                  <div className="vessel-RegLeftSidedescription">
                    <div className="vessel-RegLeftSidedescription1">
                      <p className="vessel-RegLeftSidedescription1Styling">
                        Cancellation of Registration
                      </p>
                    </div>
                    <div className="vess-description">
                      <p className="vess-description1">
                        Lorem Ipsum is simply dummy text of the printing and
                        typesetting industry.
                      </p>
                    </div>
                    <div className="onlinedescription">
                      <img
                        src={Navigation}
                        alt="Navigation"
                        className="img-fluid"
                      />
                    </div>
                  </div>
                </div>
              </Col>
              <Col md={6} className="border p-1">
                <div style={{ display: "flex" }}>
                  <div className="vessel-RegLeftSideSecondContainer-logo">
                    <img src={tick} alt="tick" className="img-fluid" />
                  </div>
                  <div className="vessel-RegLeftSidedescription">
                    <div className="vessel-RegLeftSidedescription1">
                      <p className="vessel-RegLeftSidedescription1Styling">
                        Cancellation of Registration
                      </p>
                    </div>
                    <div className="vess-description">
                      <p className="vess-description1">
                        Lorem Ipsum is simply dummy text of the printing and
                        typesetting industry.
                      </p>
                    </div>
                    <div className="onlinedescription">
                      <img
                        src={Navigation}
                        alt="Navigation"
                        className="img-fluid"
                      />
                    </div>
                  </div>
                </div>
              </Col>
            </Row>
          </Col>
          <Col md={6} className="d-flex align-items-stretch">
            <div style={{ width: "100%", height: "100%" }}>
              <img
                src={Ship}
                alt="IWT Ship"
                className="img-fluid"
                style={{
                  objectFit: "cover",
                  width: "100%", // Ensures the image fits within the container
                  height: "100%", // Matches the height of the container
                }}
              />
            </div>
          </Col>
        </Row>
      </Container>

      {/* Vessel Survey Section */}
      <Container className="my-5">
        <h2>Vessel Survey</h2>
        <p>
          Lorem Ipsum is simply dummy text of the printing and typesetting
          industry. Lorem Ipsum has been the industry's standard dummy text ever
          since the 1500s.
        </p>
        <Row className="d-flex align-items-stretch">
          {" "}
          {/* Ensures both columns stretch to the same height */}
          <Col md={6} className="d-flex">
            <img
              src={Tower}
              alt="Tower"
              className="img-fluid w-100"
              style={{ objectFit: "cover" }} // Ensures the image covers the available space
            />
          </Col>
          <Col md={6} className="d-flex align-items-center">
            <Row>
              <Col md={12}>
                {/* First Row */}
                <Row>
                  <Col md={6} className="border p-2">
                    <div className="vessel-RegLeftSideFirstContainerText d-flex">
                      <div className="vessel-RegLeftSideFirstContainerlogo">
                        <img src={vector} alt="train" className="img-fluid" />
                      </div>
                      <div className="vessel-RegLeftSidedescription">
                        <div className="vessel-RegLeftSidedescription1">
                          <p className="vessel-RegLeftSidedescription1Styling">
                            New Vessel Registration
                          </p>
                        </div>
                        <div className="vess-description">
                          <p className="vess-description1">
                            Lorem Ipsum is simply dummy text of the printing and
                            typesetting industry.
                          </p>
                        </div>
                        <div className="onlinedescription">
                          <img
                            src={Navigation}
                            alt="Navigation"
                            className="img-fluid"
                          />
                        </div>
                      </div>
                    </div>
                  </Col>
                  <Col md={6} className="border p-2">
                    <div className="vessel-RegLeftSideSecondContainer-logo d-flex">
                      <img
                        src={Suitcase}
                        alt="Suitcase"
                        className="img-fluid"
                      />
                    </div>
                    <div className="vessel-RegLeftSidedescription">
                      <div className="vessel-RegLeftSidedescription1">
                        <p className="vessel-RegLeftSidedescription1Styling">
                          New Vessel Registration
                        </p>
                      </div>
                      <div className="vess-description">
                        <p className="vess-description1">
                          Lorem Ipsum is simply dummy text of the printing and
                          typesetting industry.
                        </p>
                      </div>
                      <div className="onlinedescription">
                        <img
                          src={Navigation}
                          alt="Navigation"
                          className="img-fluid"
                        />
                      </div>
                    </div>
                  </Col>
                </Row>

                {/* Second Row */}
                <Row className="mt-2">
                  <Col md={6} className="border p-2">
                    <div className="vessel-RegLeftSideFirstContainerText d-flex">
                      <div className="vessel-RegLeftSideFirstContainerlogo">
                        <img
                          src={transfer}
                          alt="transfer"
                          className="img-fluid"
                        />
                      </div>
                      <div className="vessel-RegLeftSidedescription">
                        <div className="vessel-RegLeftSidedescription1">
                          <p className="vessel-RegLeftSidedescription1Styling">
                            Transfer of Registry
                          </p>
                        </div>
                        <div className="vess-description">
                          <p className="vess-description1">
                            Lorem Ipsum is simply dummy text of the printing and
                            typesetting industry.
                          </p>
                        </div>
                        <div className="onlinedescription">
                          <img
                            src={Navigation}
                            alt="Navigation"
                            className="img-fluid"
                          />
                        </div>
                      </div>
                    </div>
                  </Col>
                  <Col md={6} className="border p-2">
                    <div className="vessel-RegLeftSideSecondContainer-logo d-flex">
                      <img src={Profile} alt="Profile" className="img-fluid" />
                    </div>
                    <div className="vessel-RegLeftSidedescription">
                      <div className="vessel-RegLeftSidedescription1">
                        <p className="vessel-RegLeftSidedescription1Styling">
                          Transfer of Registry
                        </p>
                      </div>
                      <div className="vess-description">
                        <p className="vess-description1">
                          Lorem Ipsum is simply dummy text of the printing and
                          typesetting industry.
                        </p>
                      </div>
                      <div className="onlinedescription">
                        <img
                          src={Navigation}
                          alt="Navigation"
                          className="img-fluid"
                        />
                      </div>
                    </div>
                  </Col>
                </Row>

                {/* Third Row */}
                <Row className="mt-2">
                  <Col md={6} className="border p-2">
                    <div className="vessel-RegLeftSideFirstContainerText d-flex">
                      <div className="vessel-RegLeftSideFirstContainerlogo">
                        <img
                          src={Notebook}
                          alt="Notebook"
                          className="img-fluid"
                        />
                      </div>
                      <div className="vessel-RegLeftSidedescription">
                        <div className="vessel-RegLeftSidedescription1">
                          <p className="vessel-RegLeftSidedescription1Styling">
                            Cancellation of Registration
                          </p>
                        </div>
                        <div className="vess-description">
                          <p className="vess-description1">
                            Lorem Ipsum is simply dummy text of the printing and
                            typesetting industry.
                          </p>
                        </div>
                        <div className="onlinedescription">
                          <img
                            src={Navigation}
                            alt="Navigation"
                            className="img-fluid"
                          />
                        </div>
                      </div>
                    </div>
                  </Col>
                  <Col md={6} className="border p-2">
                    <div className="vessel-RegLeftSideSecondContainer-logo d-flex">
                      <img src={tick} alt="tick" className="img-fluid" />
                    </div>
                    <div className="vessel-RegLeftSidedescription">
                      <div className="vessel-RegLeftSidedescription1">
                        <p className="vessel-RegLeftSidedescription1Styling">
                          Cancellation of Registration
                        </p>
                      </div>
                      <div className="vess-description">
                        <p className="vess-description1">
                          Lorem Ipsum is simply dummy text of the printing and
                          typesetting industry.
                        </p>
                      </div>
                      <div className="onlinedescription">
                        <img
                          src={Navigation}
                          alt="Navigation"
                          className="img-fluid"
                        />
                      </div>
                    </div>
                  </Col>
                </Row>
              </Col>
            </Row>
          </Col>
        </Row>
      </Container>

      {/* Quick Action Section */}
      <Container className="my-5">
        <h2>Quick Action</h2>
        <Row>
          {quickActionCards.map((card) => (
            <Col key={card.id} md={3} className="mb-4">
              <Card className="text-center shadow-sm">
                <Card.Body>
                  <div className="mb-3">
                    {React.cloneElement(card.icon, {
                      style: { width: "30px", height: "30px" },
                    })}{" "}
                    {/* Adjusted size */}
                  </div>
                  <Card.Title>{card.title}</Card.Title>
                  <Button className="btn iwt-bg" style={{borderRadius : '10px', fontSize : '0.8rem'}}>{card.buttonText}</Button>
                </Card.Body>
              </Card>
            </Col>
          ))}
        </Row>
      </Container>

      {/* Map Information Section */}
      <Container className="my-5">
        <h2>Map Information</h2>
        <img
          src={Map}
          alt="Map"
          className="img-fluid w-100"
          style={{ height: "400px", objectFit: "cover" }}
        />
      </Container>

      {/* Social Feed Section */}
      <Container className="my-5">
        <Row>
          {/* Social Feed Section */}
          <Col md={8}>
            <h2>Social Feed</h2>
            <div
              style={{
                boxShadow: "0 4px 8px rgba(0, 0, 0, 0.1)",
                padding: "1rem",
                height: "100%",
              }}
            >
              {" "}
              {/* Outer box-shadow */}
              <Row className="h-100">
                <Col
                  md={6}
                  className="p-3 d-flex flex-column justify-content-between h-100"
                  style={{ borderRight: "1px solid #ddd" }} // Added border between columns
                >
                  <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                      <img
                        src={Linkedin}
                        alt="Linkedin"
                        className="img-fluid me-3"
                        style={{ width: "40px", height: "40px" }}
                      />
                      <p className="mb-0 fw-bold">LinkedIn</p>
                    </div>
                    <a href="#" className="text-primary">
                      See All
                    </a>
                  </div>
                </Col>
                <Col
                  md={6}
                  className="p-3 d-flex flex-column justify-content-between h-100"
                >
                  <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                      <img
                        src={Instagram}
                        alt="Instagram"
                        className="img-fluid me-3"
                        style={{ width: "40px", height: "40px" }}
                      />
                      <p className="mb-0 fw-bold">Instagram</p>
                    </div>
                    <a href="#" className="text-primary">
                      See All
                    </a>
                  </div>
                </Col>
              </Row>
            </div>
          </Col>

          {/* What's New Section */}
          <Col md={4}>
            <h2>What’s New</h2>
            <div className="border p-3 h-100">
              {" "}
              {/* Added h-100 for full height */}
              <Row className="mb-3">
                <Col className="d-flex justify-content-between align-items-start">
                  <div>
                    <p className="mb-1">
                      <small>
                        Lorem Ipsum is simply dummy text of the printing and
                        typesetting industry. Lorem Ipsum has been the
                        industry's standard dummy text ever since the 1500s.
                      </small>
                    </p>
                    <p className="text-muted mb-0">
                      <small>April 06, 2025</small>
                    </p>
                  </div>
                  <button
                    style={{
                      backgroundColor: "red",
                      color: "white",
                      borderRadius: "50px",
                      border: "none",
                      padding: "5px 15px",
                    }}
                  >
                    New
                  </button>
                </Col>
              </Row>
              <hr />
              <Row className="mb-3">
                <Col className="d-flex justify-content-between align-items-start">
                  <div>
                    <p className="mb-1">
                      <small>
                        Lorem Ipsum is simply dummy text of the printing and
                        typesetting industry. Lorem Ipsum has been the
                        industry's standard dummy text ever since the 1500s.
                      </small>
                    </p>
                    <p className="text-muted mb-0">
                      <small>April 06, 2025</small>
                    </p>
                  </div>
                  <button
                    style={{
                      backgroundColor: "red",
                      color: "white",
                      borderRadius: "50px",
                      border: "none",
                      padding: "5px 15px",
                    }}
                  >
                    New
                  </button>
                </Col>
              </Row>
              <hr />
              <Row>
                <Col className="d-flex justify-content-between align-items-start">
                  <div>
                    <p className="mb-1">
                      <small>
                        Lorem Ipsum is simply dummy text of the printing and
                        typesetting industry. Lorem Ipsum has been the
                        industry's standard dummy text ever since the 1500s.
                      </small>
                    </p>
                    <p className="text-muted mb-0">
                      <small>April 06, 2025</small>
                    </p>
                  </div>
                  <button
                    style={{
                      backgroundColor: "red",
                      color: "white",
                      borderRadius: "50px",
                      border: "none",
                      padding: "5px 15px",
                    }}
                  >
                    New
                  </button>
                </Col>
              </Row>
            </div>
          </Col>
        </Row>
      </Container>

      {/* Footer */}
      <footer className="bg-primary text-white text-center py-4">
        <Container>
          <Row>
            <Col md={4}>
              <h6>HR</h6>
            </Col>
            <Col md={4}>
              <h6>FAQS</h6>
            </Col>
            <Col md={4}>
              <h6>Privacy Policy</h6>
            </Col>
          </Row>

          <Row>
            <Col md={4}>
              <h6>Tools</h6>
            </Col>
            <Col md={4}>
              <h6>About Us</h6>
            </Col>
            <Col md={4}>
              <h6>Hyperlink Policy</h6>
            </Col>
          </Row>

          <Row>
            <Col md={4}>
              <h6>Career & Learning</h6>
            </Col>
            <Col md={4}>
              <h6>Terms of Use</h6>
            </Col>
            <Col md={4}>
              <h6>Website Policy</h6>
            </Col>
          </Row>

          <Row>
            <Col md={4}>
              <h6>Resources</h6>
            </Col>
            <Col md={4}>
              <h6>Morth</h6>
            </Col>
            <Col md={4}>
              <h6>Content Policy</h6>
            </Col>
          </Row>

          <Row>
            <Col md={4}>
              <h6>IT Helpdesk</h6>
            </Col>
            <Col md={4}>
              <h6>CMVR 1989</h6>
            </Col>
            <Col md={4}>
              <h6>Contingency Plan</h6>
            </Col>
          </Row>
        </Container>
      </footer>
    </Container>
  );
};

export default IWTHomePage;
