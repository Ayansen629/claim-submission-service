const ReportsDashboard = ({ viewMode = false }) => {
  const { t } = useTranslation();
  const [showFileModal, setShowFileModal] = useState(false);
  const [currentReportType, setCurrentReportType] = useState("");
  const [reports, setReports] = useState({
    materialTest: [],
    radiography: [],
    inspection: [],
    other: [],
  });
  const [loading, setLoading] = useState(false);

  const REPORT_COLUMNS = [
    {
      colName: t("Add Attachment"),
      fieldName: "fileName",
      clsName: "column-text-start",
    },
    {
      colName: t("Description"),
      fieldName: "description",
      clsName: "column-text-start",
    },
    {
      colName: t("Action"),
      fieldName: "action",
      actions: viewMode ? ['download'] : ['delete', 'download'], // Conditional actions
      clsName: "col-sm-2 column-text-start actions-column",
    },
  ];

  // ... existing code for fetchReports, useEffect, handlers ...

  const renderReportTable = (reportType, reportData, title) => {
    return (
      <Collapsible title={title} openStat={true}>
        <div style={{ padding: "1rem" }}>
          {/* Conditionally render Add button only if not in view mode */}
          {!viewMode && (
            <div className="d-flex justify-content-end mb-3">
              <Button
                variant="primary"
                size="sm"
                onClick={() => handleAddReport(reportType)}
              >
                <BsPlus size={20} /> {t("Add")}
              </Button>
            </div>
          )}

          <ActionTable
            columns={REPORT_COLUMNS}
            rowData={reportData}
            tableHeader={null}
            hideExportBtn={true}
            hideSearchBar={true}
            pagination={false}
            onViewRow={(rowData) => handleViewReport(rowData, reportType)}
            onDeleteRow={!viewMode ? (rowData) => handleDeleteReport(rowData, reportType) : undefined}
            download={(rowData) => handleDownloadReport(rowData, reportType)}
            noDataText={t("No reports available")}
          />
        </div>
      </Collapsible>
    );
  };

  return (
    <Card className="mt-4">
      <Card.Body style={{ padding: 0 }}>
        <div className="reports-section">
          {renderReportTable("materialTest", reports.materialTest, t("Material Test Report"))}
          {renderReportTable("radiography", reports.radiography, t("Radiography Report"))}
          {renderReportTable("inspection", reports.inspection, t("Inspection Report"))}
          {renderReportTable("other", reports.other, t("Other Report"))}
        </div>
      </Card.Body>

      {/* Only show modal if not in view mode */}
      {!viewMode && (
        <FileReportsUploadModal
          show={showFileModal}
          onHide={() => setShowFileModal(false)}
          reportType={currentReportType}
          onSubmit={handleFileUpload}
        />
      )}
    </Card>
  );
};

export default ReportsDashboard;
///


useEffect(() => {
  const createStep = (label, component, validate = null, noValidation = true) => ({
    label,
    component,
    getFormData: () => methods?.getValues(),
    validate,
    goToNextStepNoValidtion: noValidation,
  });

  const stepsList = [
    createStep(
      "Basic Details",
      <VesselBasicDetailsView
        formMethods={methods}
        isPreview
        formData={getValues()}
        registrationData={registrationData}
      />
    ),
  ];

  // Only add Reports & Documents step if NOT in view mode
  const reportsDashboardStep = createStep(
    "Reports & Documents",
    <ReportsDashboard
      formMethods={methods}
      viewMode={isViewMode}  // Pass viewMode prop
      isUploadOnly
      applicationNumber={rowData?.applicationNumber}
      additionalData={rowData}
    />
  );

  if (pageName === "uploadReports" && !isViewMode) {
    stepsList.push(reportsDashboardStep);
  }

  if (pageName === "vesselRegistration") {
    if (!isViewMode) {
      stepsList.push(reportsDashboardStep);
    }
    stepsList.push(
      createStep(
        "Application for Registration",
        <RegistrationApplicationForm
          ref={registrationFormRef}
          registrationData={registrationData}
        />,
        async () => {
          if (registrationFormRef.current?.validateForm) {
            return await registrationFormRef.current.validateForm();
          }
          return true;
        },
        false
      )
    );
  }

  setSteps(stepsList);
}, [pageName, rowData, methods, registrationData, isViewMode]);

