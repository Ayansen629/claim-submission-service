import React, { useState, useEffect, useRef } from "react";
import { useForm, useFieldArray } from "react-hook-form";
import { Row, Col, Button, Card } from "react-bootstrap";
import InputText from "../../../../common/InputText.tsx";
import InputSelect from "../../../../common/InputSelect.tsx";
import Collapsible from "../../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import {
  FaShip,
  FaCog,
  FaFileUpload,
  FaPlus,
  FaTrash,
  FaClipboardList,
} from "react-icons/fa";
import { BsFileEarmarkPdf } from "react-icons/bs";
import { useMasterData } from "../../../../context/MasterDataContext.js";
import { toast } from "react-toastify";
import NewLoader from "../../../../common/NewLoader.js";
import MultiFile from "../../../../common/MultiFile.js";

const RequestApplication = ({
  formMethods,
  viewMode = false,
  editMode = false,
  registrationData,
  initialData
}) => {
  const { t } = useTranslation();
  const { masterData } = useMasterData();
  const loaderRef = useRef();

  const [otherTechnicalDocumentFiles, setOtherTechnicalDocumentFiles] = useState([{ id: 1 }]);

  const internalFormMethods = useForm({
    mode: "onTouched",
  });

  const methods = formMethods || internalFormMethods;
  const {
    register,
    watch,
    setValue,
    clearErrors,
    formState: { errors },
    unregister,
  } = methods;

  const { fields, append, remove } = useFieldArray({
    control: methods.control,
    name: "alterationDetails.alterations",
  });

  useEffect(() => {
    if (fields.length === 0 && !initialData?.AlterationDetails) {
      append({
        description: "",
        reason: "",
        proposedDate: "",
      });
    }
  }, [fields.length, append, initialData]);

  // Auto-populate vessel data from registration
  useEffect(() => {
    if (!registrationData) return;

    const mapping = {
      // Basic Vessel Info
      "basicVesselInfo.nameOfVessel": registrationData.vessel?.vesselName,
      "basicVesselInfo.grossTonnage": registrationData.vessel?.grt,
      "basicVesselInfo.typeOfVessel": registrationData.vessel?.type,
      "basicVesselInfo.officialNo": registrationData.vessel?.registrationNo,
      "basicVesselInfo.categoryOfVessel": registrationData.vessel?.category,
      "basicVesselInfo.yearOfBuild": registrationData.vessel?.yearOfBuild,
      "basicVesselInfo.nameOfOwner": registrationData.owner?.name,
      "basicVesselInfo.addressOfOwner": registrationData.owner?.address,

      // Hull Particulars
      "hullParticulars.length": registrationData.vessel?.length,
      "hullParticulars.breadth": registrationData.vessel?.breadth,
      "hullParticulars.depth": registrationData.vessel?.depth,
      "hullParticulars.draft": registrationData.vessel?.draft,

      // Engine Details
      "engineDetails.typeOfEngine": registrationData.engine?.type,
      "engineDetails.engineMake": registrationData.engine?.make,
      "engineDetails.horsepower": registrationData.engine?.horsepower,
      "engineDetails.speedRPM": registrationData.engine?.speed,
    };

    Object.entries(mapping).forEach(([key, value]) => {
      if (value != null) setValue(key, value);
    });
  }, [registrationData, setValue]);

  return (
    <>
      <NewLoader ref={loaderRef} />
      <form autoComplete="off">
        {/* Basic Vessel Information */}
        <Collapsible
          title={
            <>
              <FaShip className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Basic Vessel Information")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Name of Vessel")}
                name="basicVesselInfo.nameOfVessel"
                register={register("basicVesselInfo.nameOfVessel")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Official No.")}
                name="basicVesselInfo.officialNo"
                register={register("basicVesselInfo.officialNo")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Type of Vessel")}
                name="basicVesselInfo.typeOfVessel"
                register={register("basicVesselInfo.typeOfVessel")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Gross Tonnage")}
                name="basicVesselInfo.grossTonnage"
                register={register("basicVesselInfo.grossTonnage")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Name of Owner")}
                name="basicVesselInfo.nameOfOwner"
                register={register("basicVesselInfo.nameOfOwner")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Address of Owner")}
                name="basicVesselInfo.addressOfOwner"
                register={register("basicVesselInfo.addressOfOwner")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
          </Row>
        </Collapsible>

        {/* Hull Particulars */}
        <Collapsible
          title={
            <>
              <FaShip className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Hull Particulars")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Length (Meter)")}
                name="hullParticulars.length"
                register={register("hullParticulars.length")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Breadth (Meter)")}
                name="hullParticulars.breadth"
                register={register("hullParticulars.breadth")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Depth (Meter)")}
                name="hullParticulars.depth"
                register={register("hullParticulars.depth")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Draft (Meter)")}
                name="hullParticulars.draft"
                register={register("hullParticulars.draft")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
          </Row>
        </Collapsible>

        {/* Engine Details */}
        <Collapsible
          title={
            <>
              <FaCog className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Engine Details")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Type of Engine")}
                name="engineDetails.typeOfEngine"
                register={register("engineDetails.typeOfEngine")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Engine Make")}
                name="engineDetails.engineMake"
                register={register("engineDetails.engineMake")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Horsepower")}
                name="engineDetails.horsepower"
                register={register("engineDetails.horsepower")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Speed RPM")}
                name="engineDetails.speedRPM"
                register={register("engineDetails.speedRPM")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
          </Row>
        </Collapsible>

        {/* Alteration Details */}
        <Collapsible
          title={
            <>
              <FaClipboardList className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Alteration Details")}</span>
            </>
          }
          openStat={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              {fields.map((field, index) => (
                <Row key={field.id} className="gy-3 mb-3 p-3 border rounded">
                  <Col xs={12}>
                    <div className="d-flex justify-content-between align-items-center mb-2">
                      <h6 className="mb-0">Alteration {index + 1}</h6>
                      {fields.length > 1 && !viewMode && (
                        <Button
                          variant="outline-danger"
                          size="sm"
                          onClick={() => remove(index)}
                        >
                          <FaTrash />
                        </Button>
                      )}
                    </div>
                  </Col>
                  <Col md={6}>
                    <InputText
                      label={t("Description of Alteration")}
                      name={`alterationDetails.alterations.${index}.description`}
                      register={register(`alterationDetails.alterations.${index}.description`)}
                      errors={errors}
                      placeholder={t("Enter description of alteration")}
                      disabled={viewMode}
                    />
                  </Col>
                  <Col md={6}>
                    <InputText
                      label={t("Reason for Alteration")}
                      name={`alterationDetails.alterations.${index}.reason`}
                      register={register(`alterationDetails.alterations.${index}.reason`)}
                      errors={errors}
                      placeholder={t("Enter reason for alteration")}
                      disabled={viewMode}
                    />
                  </Col>
                  <Col md={6}>
                    <InputText
                      label={t("Proposed Date")}
                      name={`alterationDetails.alterations.${index}.proposedDate`}
                      type="date"
                      register={register(`alterationDetails.alterations.${index}.proposedDate`)}
                      errors={errors}
                      disabled={viewMode}
                    />
                  </Col>
                </Row>
              ))}
              {!viewMode && (
                <Button
                  variant="outline-primary"
                  onClick={() => append({ description: "", reason: "", proposedDate: "" })}
                  className="mt-2"
                >
                  <FaPlus className="me-2" />
                  Add Alteration
                </Button>
              )}
            </Card.Body>
          </Card>
        </Collapsible>

        {/* Enclosure */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>{t("ENCLOSURE")}</span>
            </div>
          }
          defaultOpen={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col xs={12}>
                  <MultiFile
                    title={t("Other Technical Document")}
                    files={otherTechnicalDocumentFiles}
                    setFiles={setOtherTechnicalDocumentFiles}
                    type="OTHER_TECHNICAL_DOCUMENT"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={methods.setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                    isRegistrationMode={false}
                  />
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>
      </form>
    </>
  );
};

export default RequestApplication;
