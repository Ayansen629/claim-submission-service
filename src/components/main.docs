const handleGenerate = () => {
  if (type === "survey" && surveyFormRef.current) {
    const isValid = surveyFormRef.current.validateForm();
    if (!isValid) {
      toast.error("Please fix the validation errors before generating the certificate");
      return;
    }
    
    const formData = surveyFormRef.current.getFormData();
    onGenerateCertificate(formData);
  } else {
    onGenerateCertificate({});
  }
};
