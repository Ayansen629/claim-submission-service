import React, { useState, useEffect, useRef } from "react";
import { useForm, FormProvider } from "react-hook-form";
import { useTranslation } from "react-i18next";
import { Dropdown } from "react-bootstrap";
import { FaGlobe, FaCheck, FaTimesCircle } from "react-icons/fa";
import { FiFlag } from "react-icons/fi";
import { GiIndiaGate } from "react-icons/gi";
import "./stepper-styles.css";
// import axios from "axios";

import { Container, Row, Col, Button, Card, Image } from "react-bootstrap";
import {
  FaUser,
  FaBuilding,
  FaFileUpload,
  FaArrowRight,
  FaArrowLeft,
  FaIdCard,
  FaEnvelope,
  FaPhone,
  FaMapMarkerAlt,
} from "react-icons/fa";
import "./UserRegistration.css";
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";
import { toast } from "react-toastify";
import {
  getData,
  postData,
  postFORMdata,
} from "../../../services/http.service.ts";
import { URLS_ENDPOINT, BASE_IP } from "../../../utils/urlsConstants.ts";
import { handleErrorMessage } from "../../../utils/errorMessageHandler.js";
import { createOwnerOrBuilderPayload } from "../model/mapToVesselModel.ts";
import NewLoader from "../../common/NewLoader.js";
import InputText from "../../common/InputText.tsx";
import InputFile from "../../common/InputFile.tsx";
