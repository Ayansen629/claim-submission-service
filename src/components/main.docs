import React, { useState } from 'react';
import { useForm } from 'react-hook-form';
import { Link, useNavigate } from 'react-router-dom';
import { toast } from 'react-toastify';
import 'react-toastify/dist/ReactToastify.css';
import './Register.css';

const CorporateDebtorRegister = () => {
  const navigate = useNavigate();
  const [loading, setLoading] = useState(false);
  
  const {
    register,
    handleSubmit,
    watch,
    formState: { errors },
  } = useForm();

  const processTypeOptions = [
    { value: 'CIRP', label: 'Corporate Insolvency Resolution Process (CIRP)' },
    { value: 'Liquidation', label: 'Liquidation' },
    { value: 'VoluntaryLiquidation', label: 'Voluntary Liquidation' },
    { value: 'PPIRP', label: 'Pre-Packaged Insolvency Resolution Process (PPIRP)' },
  ];

  const onSubmit = async (data) => {
    setLoading(true);
    
    // Simulate API call
    setTimeout(() => {
      console.log('Registration Data:', data);
      toast.success('Registration successful!');
      setLoading(false);
      navigate('/login');
    }, 1500);
  };

  const password = watch("password");

  return (
    <div className="register-page">
      <div className="register-container">
        <div className="register-header">
          <h2>Corporate Debtor Registration</h2>
        </div>

        <form onSubmit={handleSubmit(onSubmit)} className="register-form">
          {/* Name */}
          <div className="form-group">
            <label>Name</label>
            <input
              type="text"
              {...register("name", { required: "Company name is required" })}
              placeholder="Enter company name"
              className="form-input"
            />
            {errors.name && <p className="error-message">{errors.name.message}</p>}
          </div>

          {/* Email */}
          <div className="form-group">
            <label>Email ID</label>
            <input
              type="email"
              {...register("email", { 
                required: "Email is required",
                pattern: {
                  value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                  message: "Invalid email address"
                }
              })}
              placeholder="Enter company email"
              className="form-input"
            />
            {errors.email && <p className="error-message">{errors.email.message}</p>}
          </div>

          {/* Mobile Number */}
          <div className="form-group">
            <label>Mobile Number</label>
            <input
              type="tel"
              {...register("mobile", { 
                required: "Mobile number is required",
                pattern: {
                  value: /^[6-9]\d{9}$/,
                  message: "Invalid Indian mobile number"
                }
              })}
              placeholder="Enter mobile number"
              className="form-input"
            />
            {errors.mobile && <p className="error-message">{errors.mobile.message}</p>}
          </div>

          {/* CIN Number */}
          <div className="form-group">
            <label>CIN Number</label>
            <input
              type="text"
              {...register("cin", { 
                required: "CIN is required",
                pattern: {
                  value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
                  message: "Invalid CIN format (e.g., U12345AB6789CDE12345)"
                }
              })}
              placeholder="Enter Corporate Identification Number"
              className="form-input"
            />
            {errors.cin && <p className="error-message">{errors.cin.message}</p>}
          </div>

          {/* Process Type */}
          <div className="form-group">
            <label>Process Type</label>
            <select
              {...register("processType", { required: "Process type is required" })}
              className="form-input"
            >
              <option value="">Select Process Type</option>
              {processTypeOptions.map((option) => (
                <option key={option.value} value={option.value}>
                  {option.label}
                </option>
              ))}
            </select>
            {errors.processType && <p className="error-message">{errors.processType.message}</p>}
          </div>

          {/* Password */}
          <div className="form-group">
            <label>Password</label>
            <input
              type="password"
              {...register("password", { 
                required: "Password is required",
                minLength: {
                  value: 8,
                  message: "Password must be at least 8 characters"
                }
              })}
              placeholder="Enter password"
              className="form-input"
            />
            {errors.password && <p className="error-message">{errors.password.message}</p>}
          </div>

          {/* Confirm Password */}
          <div className="form-group">
            <label>Confirm Password</label>
            <input
              type="password"
              {...register("confirmPassword", { 
                required: "Please confirm your password",
                validate: value => 
                  value === password || "Passwords do not match"
              })}
              placeholder="Confirm password"
              className="form-input"
            />
            {errors.confirmPassword && <p className="error-message">{errors.confirmPassword.message}</p>}
          </div>

          <button 
            type="submit" 
            className="register-button"
            disabled={loading}
          >
            {loading ? 'Registering...' : 'Register'}
          </button>
        </form>

        <div className="login-link">
          Already have an account? <Link to="/login">Login here</Link>
        </div>
      </div>
    </div>
  );
};

export default CorporateDebtorRegister;
.register-page {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background-image: url("../../assests/images/Backgroundlogin.jpg");
  background-size: cover;
  background-position: center;
  padding: 20px;
}

.register-container {
  width: 100%;
  max-width: 500px;
  padding: 30px;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16px;
  box-shadow: 0px 6px 30px rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.register-header {
  text-align: center;
  margin-bottom: 25px;
}

.register-header h2 {
  color: #269ccc;
  font-size: 24px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  margin-bottom: 8px;
  font-weight: 500;
  color: #333;
}

.form-input {
  width: 100%;
  padding: 12px 15px;
  border: 2px solid #e6e6e6;
  border-radius: 8px;
  font-size: 14px;
  transition: border-color 0.3s;
}

.form-input:focus {
  border-color: #269ccc;
  outline: none;
}

select.form-input {
  appearance: none;
  background: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23269ccc%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E") no-repeat right 15px center/12px 12px;
  background-color: white;
}

.error-message {
  color: #e74c3c;
  font-size: 13px;
  margin-top: 5px;
}

.register-button {
  width: 100%;
  padding: 12px;
  background-color: #269ccc;
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
  margin-top: 10px;
}

.register-button:hover {
  background-color: #1e87b0;
}

.register-button:disabled {
  background-color: #95a5a6;
  cursor: not-allowed;
}

.login-link {
  text-align: center;
  margin-top: 20px;
  font-size: 14px;
  color: #333;
}

.login-link a {
  color: #269ccc;
  text-decoration: none;
  font-weight: 600;
}

.login-link a:hover {
  text-decoration: underline;
}

@media (max-width: 768px) {
  .register-container {
    padding: 20px;
    max-width: 90%;
  }
  
  .register-header h2 {
    font-size: 20px;
  }
  
  .form-input {
    padding: 10px 12px;
    font-size: 13px;
  }
}
