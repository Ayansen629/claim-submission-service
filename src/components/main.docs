import AddressChange from "./AddressChange";

// In the steps array, update the first step:
const steps = [
  {
    label: selectedOption === "Address" ? "Address Update" : "Registration Information",
    component: selectedOption === "Address" ? (
      <AddressChange 
        ref={nameChangeRef}
        selectedOption={selectedOption}
        onValidationChange={handleValidationChange}
        onDataChange={handleDataChange}
        initialData={savedFormData} 
      />
    ) : (
      <NameChange 
        ref={nameChangeRef}
        selectedOption={selectedOption}
        onValidationChange={handleValidationChange}
        onDataChange={handleDataChange}
        initialData={savedFormData} 
      />
    ),
    validate: validateStep,
    getFormData: getFormData,
    showSavaAndNextButton: true,
    hasActions: true
  },
  // ... rest of steps
];
