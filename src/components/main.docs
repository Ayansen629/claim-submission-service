import React, { useState, useEffect } from "react";
import { Modal, Button } from "react-bootstrap";
import { postData } from "../../../services/http.service.ts";
import { APP_MESSAGES } from "../../../utils/constants.ts";
import { FaCheckCircle, FaClock, FaHourglassStart } from "react-icons/fa";
import "./DashboardMain.css"; // Assuming you have some shared styles

const TrackingModal = ({ show, onHide, applicationNumber, trackingDetails }) => {
  if (!show) {
    return null;
  }

  if (!trackingDetails || trackingDetails.length === 0) {
    return (
      <Modal show={show} onHide={onHide} centered>
        <Modal.Header closeButton>
          <Modal.Title>Claim Tracking</Modal.Title>
        </Modal.Header>
        <Modal.Body>No tracking information available for application: {applicationNumber}</Modal.Body>
        <Modal.Footer>
          <Button variant="secondary" onClick={onHide}>
            Close
          </Button>
        </Modal.Footer>
      </Modal>
    );
  }

  return (
    <Modal
      show={show}
      onHide={onHide}
      size="lg"
      centered
      aria-labelledby="tracking-modal-title"
    >
      <Modal.Header closeButton className="border-0 pb-0">
        <Modal.Title id="tracking-modal-title" className="w-100">
          <div className="d-flex justify-content-between align-items-center">
            <h4 className="mb-0">Claim Tracking</h4>
            <div className="badge bg-primary fs-6">{applicationNumber}</div>
          </div>
        </Modal.Title>
      </Modal.Header>
      <Modal.Body className="pt-0">
        <div className="timeline-container position-relative">
          {/* Vertical line */}
          <div
            className="timeline-vertical-line"
            style={{
              position: 'absolute',
              left: '24px',
              top: '0',
              bottom: '0',
              width: '2px',
              backgroundColor: '#dee2e6',
              zIndex: 0
            }}
          ></div>

          {trackingDetails.map((stage, index) => (
            <div
              key={index}
              className={`timeline-step ${stage.isCurrent ? 'current-step' : ''}`}
              style={{
                position: 'relative',
                paddingLeft: '60px',
                marginBottom: '30px',
                zIndex: 1
              }}
            >
              <div
                className="timeline-icon-container"
                style={{
                  position: 'absolute',
                  left: '0',
                  top: '0',
                  width: '50px',
                  height: '50px',
                  borderRadius: '50%',
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'center',
                  backgroundColor: stage.isCurrent ? '#0d6efd' : '#6c757d',
                  color: 'white',
                  boxShadow: '0 0 0 5px rgba(13, 110, 253, 0.1)'
                }}
              >
                {stage.status === 'Approved' ? (
                  <FaCheckCircle size={20} />
                ) : stage.status === 'Pending' ? (
                  <FaClock size={20} />
                ) : (
                  <FaHourglassStart size={20} />
                )}
              </div>

              <div
                className="timeline-content p-3 rounded-3"
                style={{
                  backgroundColor: stage.isCurrent ? '#f8f9fa' : 'white',
                  border: stage.isCurrent ? '1px solid #0d6efd' : '1px solid #dee2e6',
                  boxShadow: '0 0.125rem 0.25rem rgba(0, 0, 0, 0.075)'
                }}
              >
                <div className="d-flex justify-content-between align-items-center mb-2">
                  <h6
                    className="mb-0"
                    style={{
                      color: stage.isCurrent ? '#0d6efd' : '#212529',
                      fontWeight: '600'
                    }}
                  >
                    {stage.label}
                  </h6>
                  {stage.date && (
                    <small className="text-muted">
                      <FaClock className="me-1" />
                      {stage.date}
                    </small>
                  )}
                </div>
                <p className="mb-1">{stage.description}</p>
                {stage.submittedBy && (
                  <small className="text-muted d-block">
                    Submitted By: {stage.submittedBy}
                  </small>
                )}
                {stage.submittedTo && (
                  <small className="text-muted d-block">
                    Submitted To: {stage.submittedTo}
                  </small>
                )}
                {stage.comments && (
                  <div
                    className="mt-2 p-2 rounded-2"
                    style={{
                      backgroundColor: '#e9ecef',
                      borderLeft: '3px solid #007bff'
                    }}
                  >
                    <small className="text-muted">Comments: {stage.comments}</small>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </Modal.Body>
      <Modal.Footer className="border-0">
        <Button variant="secondary" onClick={onHide}>
          Close
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

const DashboardMain = () => {
  // ... other state variables from your component
  const [isTrackModalOpen, setIsTrackModalOpen] = useState(false);
  const [trackingData, setTrackingData] = useState(null);
  const [selectedApplicationNumber, setSelectedApplicationNumber] = useState("");

  // ... your existing columns definition

  const handleTrackRow = async (row) => {
    setSelectedApplicationNumber(row.claimNumber);
    try {
      setIsLoading(true);
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;

      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }

      const payload = {
        userInfo: userInfo,
        trackingCriteria: {
          applicationNumber: row.claimNumber
        }
      };

      const URL = `${process.env.REACT_APP_APPLICATION_SERVICE}_tracking/_getApplicationTrackingDetails`;

      const response = await postData(URL, payload);
      console.log(response, "response track");

      if (response?.data.status === "200") {
        // Map the API response to the structure expected by the TrackingModal
        const formattedTrackingDetails = response.data.applicationStages.map(stage => ({
          label: stage.applicationStatus,
          description: stage.comments || "", // Adjust based on your API response
          date: stage.submittedDate,
          isCurrent: stage.isCurrentStatus,
          submittedBy: stage.submittedByName,
          submittedTo: stage.submittedToName,
          status: stage.applicationStatus // Add status for icon selection
        }));
        setTrackingData(formattedTrackingDetails);
        setIsTrackModalOpen(true);
      } else {
        toast.error("Failed to fetch tracking details", { position: "top-right" });
        setTrackingData([]);
      }
    } catch (error) {
      console.error("Error fetching tracking details:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setTrackingData([]);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchDashboardData();
  }, []);

  return (
    <div className="container-fluid mt-5" style={{ paddingLeft: 0, paddingRight: 0 }}>
      {!isLoading ? (
        <>
          <h3 className="mb-2 text-center">Claim Submission Service</h3>
          <ActionTable
            columns={columns}
            rowData={rowData}
            hideExportBtn={false}
            onViewRow={handleOnViewRow}
            handleEditRow={handleEditRow}
            onTrackRow={handleTrackRow}
          />

          {/* Tracking Modal */}
          <TrackingModal
            show={isTrackModalOpen}
            onHide={() => setIsTrackModalOpen(false)}
            applicationNumber={selectedApplicationNumber}
            trackingDetails={trackingData}
          />

          {/* Your existing View Modal */}
          <Modal
            show={isViewModalOpen}
            onHide={() => setIsViewModalOpen(false)}
            dialogClassName="modal-1110w"
            aria-labelledby="example-custom-modal-styling-title"
          >
            {/* ... content of your view modal ... */}
          </Modal>
        </>
      ) : (
        <div className="text-center">Loading...</div>
      )}
    </div>
  );
};

export default DashboardMain;
