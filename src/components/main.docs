import React from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import { FaCheckCircle, FaDownload } from 'react-icons/fa';
import { Button } from 'react-bootstrap';
import { jsPDF } from 'jspdf';
import 'jspdf-autotable'; // Import the auto-table plugin
import './SubmissionSuccess.css'; // You can create this CSS file for styling

const SubmissionSuccess = () => {
  const location = useLocation();
  const navigate = useNavigate();
  const { applicationNumber } = location.state || { applicationNumber: 'APP-2025-0001' }; // Use the static application number

  // Static claim data (for demonstration purposes)
  const staticClaimData = {
    step1: {
      creditorDetails: {
        "Financial Creditor Name": "ABC Creditors Ltd.",
        "Financial Creditor Email": "abc@example.com",
        "Address": "123 Main St, Anytown",
        "City": "Anytown",
        "State": "Anystate",
        "Pincode": "12345"
      },
      identificationDetails: {
        "Identification Type": "PAN",
        "Identification Details": [
          { id: "PAN123", details: "PAN Card Number: ABCDE1234F", proof: "pan_card.pdf" }
        ]
      }
    },
    step2: {
      claimDetails: {
        "Claim Type": "Financial Debt",
        "Has Security Interest": "Yes",
        "Has Guarantee": "No",
        "Claim Amount": 100000,
        "Principal Borrower Name": "XYZ Corp",
        "Principal Borrower Address": "456 Business Park, Anytown",
        "Debt Details": "Loan Agreement #LA-2023-001",
        "Debt Date": "2023-01-15",
        "Mutual Details": "N/A",
        "Security Value": 50000,
        "Security Date": "2022-12-01",
        "Guarantee Value": 0,
        "Guarantee Date": null
      },
      bankDetails: {
        "Account Number": "1234567890",
        "IFSC Code": "ABCD0123456",
        "Bank Name": "Any Bank",
        "Branch Name": "Main Branch",
        "Branch Address": "789 Bank St, Anytown",
        "City": "Anytown",
        "State": "Anystate",
        "District": "Anydistrict"
      }
    },
    step3: {
      signatoryDetails: {
        "Creditor Name": "John Doe",
        "Creditor Position": "CFO",
        "Creditor Signature": "John Doe",
        "Has Signature": "Yes",
        "Creditor Address": "10 Downing St",
        "Signature File": "signature.jpg"
      }
    },
    step4: {
      documentDetails: {
        "Identity Proof Type": "PAN",
        "Address Proof Type": "Utility Bill",
        "Identity Proof File": "pan_card.pdf",
        "Address Proof File": "utility_bill.pdf"
      }
    }
  };


  const generatePdf = () => {
    const doc = new jsPDF();
    doc.setFontSize(16);
    doc.text(`Claim Form - Application Number: ${applicationNumber}`, 10, 10);
    doc.setFontSize(12);

    let y = 30; // Initial Y position

    // Helper function to add text with labels
    const addTextWithLabel = (doc, label, text, y) => {
        doc.setFont("helvetica", "bold");
        doc.text(label, 20, y);
        doc.setFont("helvetica", "normal");
        doc.text(text, 80, y);
        return y + 10;
    };

    const addSectionTitle = (doc, title, y) => {
      doc.setFont("helvetica", "bold");
      doc.setFontSize(14);
      doc.text(title, 10, y);
      doc.setFontSize(12);
      return y + 10;
    }

    const addTable = (doc, headers, data, title, startY) => {
      let currentY = startY;
      if(title){
        currentY = addSectionTitle(doc, title, currentY);
      }
      doc.autoTable({
          head: [headers],
          body: data,
          startY: currentY,
          margin: { left: 20 },
          columnStyles: {
              0: { fontStyle: 'bold' } // Make the first column (labels) bold
          }
      });
      return doc.lastAutoTable.finalY + 20; // Return the Y position after the table
    }

    // Step 1: Creditor and Identification Details
    y = addSectionTitle(doc, "Step 1: Creditor and Identification Details", y);
    y = addSectionTitle(doc, "Creditor Details", y);
    y = addTextWithLabel(doc, "Financial Creditor Name:", staticClaimData.step1.creditorDetails["Financial Creditor Name"], y);
    y = addTextWithLabel(doc, "Financial Creditor Email:", staticClaimData.step1.creditorDetails["Financial Creditor Email"], y);
    y = addTextWithLabel(doc, "Address:", staticClaimData.step1.creditorDetails["Address"], y);
    y = addTextWithLabel(doc, "City:", staticClaimData.step1.creditorDetails["City"], y);
    y = addTextWithLabel(doc, "State:", staticClaimData.step1.creditorDetails["State"], y);
    y = addTextWithLabel(doc, "Pincode:", staticClaimData.step1.creditorDetails["Pincode"], y);

    y = addSectionTitle(doc, "Identification Details", y);
    staticClaimData.step1.identificationDetails["Identification Details"].forEach((detail, index) => {
        y = addTextWithLabel(doc, `Detail ${index + 1}:`, '', y); // Add a label for each detail
        y = addTextWithLabel(doc, "  ID:", detail.id, y);
        y = addTextWithLabel(doc, "  Details:", detail.details, y);
        y = addTextWithLabel(doc, "  Proof:", detail.proof, y);
    });

    // Step 2: Claim and Financial Details
    y = addSectionTitle(doc, "Step 2: Claim and Financial Details", y);
    y = addSectionTitle(doc, "Claim Details", y);
    y = addTextWithLabel(doc, "Claim Type:", staticClaimData.step2.claimDetails["Claim Type"], y);
    y = addTextWithLabel(doc, "Has Security Interest:", staticClaimData.step2.claimDetails["Has Security Interest"], y);
    y = addTextWithLabel(doc, "Has Guarantee:", staticClaimData.step2.claimDetails["Has Guarantee"], y);
    y = addTextWithLabel(doc, "Claim Amount:", staticClaimData.step2.claimDetails["Claim Amount"].toString(), y);
    y = addTextWithLabel(doc, "Principal Borrower Name:", staticClaimData.step2.claimDetails["Principal Borrower Name"], y);
    y = addTextWithLabel(doc, "Principal Borrower Address:", staticClaimData.step2.claimDetails["Principal Borrower Address"], y);
    y = addTextWithLabel(doc, "Debt Details:", staticClaimData.step2.claimDetails["Debt Details"], y);
    y = addTextWithLabel(doc, "Debt Date:", staticClaimData.step2.claimDetails["Debt Date"], y);
    y = addTextWithLabel(doc, "Mutual Details:", staticClaimData.step2.claimDetails["Mutual Details"], y);
    y = addTextWithLabel(doc, "Security Value:", staticClaimData.step2.claimDetails["Security Value"]?.toString() || "N/A", y);
    y = addTextWithLabel(doc, "Security Date:", staticClaimData.step2.claimDetails["Security Date"] || "N/A", y);
    y = addTextWithLabel(doc, "Guarantee Value:", staticClaimData.step2.claimDetails["Guarantee Value"]?.toString() || "N/A", y);
    y = addTextWithLabel(doc, "Guarantee Date:", staticClaimData.step2.claimDetails["Guarantee Date"] || "N/A", y);

    y = addSectionTitle(doc, "Bank Details", y);
    y = addTextWithLabel(doc, "Account Number:", staticClaimData.step2.bankDetails["Account Number"], y);
    y = addTextWithLabel(doc, "IFSC Code:", staticClaimData.step2.bankDetails["IFSC Code"], y);
    y = addTextWithLabel(doc, "Bank Name:", staticClaimData.step2.bankDetails["Bank Name"], y);
    y = addTextWithLabel(doc, "Branch Name:", staticClaimData.step2.bankDetails["Branch Name"], y);
    y = addTextWithLabel(doc, "Branch Address:", staticClaimData.step2.bankDetails["Branch Address"], y);
    y = addTextWithLabel(doc, "City:", staticClaimData.step2.bankDetails["City"], y);
    y = addTextWithLabel(doc, "State:", staticClaimData.step2.bankDetails["State"], y);
    y = addTextWithLabel(doc, "District:", staticClaimData.step2.bankDetails["District"], y);

    // Step 3: Signatory Details
    y = addSectionTitle(doc, "Step 3: Signatory Details", y);
    y = addTextWithLabel(doc, "Creditor Name:", staticClaimData.step3.signatoryDetails["Creditor Name"], y);
    y = addTextWithLabel(doc, "Creditor Position:", staticClaimData.step3.signatoryDetails["Creditor Position"], y);
    y = addTextWithLabel(doc, "Creditor Signature:", staticClaimData.step3.signatoryDetails["Creditor Signature"], y);
    y = addTextWithLabel(doc, "Has Signature:", staticClaimData.step3.signatoryDetails["Has Signature"], y);
    y = addTextWithLabel(doc, "Creditor Address:", staticClaimData.step3.signatoryDetails["Creditor Address"], y);
    y = addTextWithLabel(doc, "Signature File:", staticClaimData.step3.signatoryDetails["Signature File"], y);

    // Step 4: Document Verification
    y = addSectionTitle(doc, "Step 4: Document Verification", y);
    y = addTextWithLabel(doc, "Identity Proof Type:", staticClaimData.step4.documentDetails["Identity Proof Type"], y);
    y = addTextWithLabel(doc, "Address Proof Type:", staticClaimData.step4.documentDetails["Address Proof Type"], y);
    y = addTextWithLabel(doc, "Identity Proof File:", staticClaimData.step4.documentDetails["Identity Proof File"], y);
    y = addTextWithLabel(doc, "Address Proof File:", staticClaimData.step4.documentDetails["Address Proof File"], y);

    doc.save(`claim_form_${applicationNumber}.pdf`);
  };

  const handleReturnToDashboard = () => {
    navigate('/dashboard');
  };

  return (
    <div className="submission-success-container">
      <div className="success-card">
        <FaCheckCircle className="success-icon" size={80} color="#28a745" />
        <h2>Claim Form Submitted Successfully!</h2>

        <div className="application-details">
          <p>Your application has been submitted with the following details:</p>
          <p><strong>Application Number:</strong> {applicationNumber || 'N/A'}</p>
          <p><strong>Date Submitted:</strong> {new Date().toLocaleDateString()}</p>
        </div>

        <div className="success-actions">
          <Button
            variant="success"
            onClick={generatePdf} // Call the generatePdf function
            className="download-button"
          >
            <FaDownload className="mr-2" />
            Download Application PDF
          </Button>

          <Button
            variant="outline-primary"
            onClick={handleReturnToDashboard}
            className="dashboard-button"
          >
            Return to Dashboard
          </Button>
        </div>

        <div className="success-message">
          <p>Thank you for submitting your claim form. You will receive a confirmation email shortly.</p>
          <p>You can track the status of your application in the dashboard.</p>
        </div>
      </div>
    </div>
  );
};

export default SubmissionSuccess;
