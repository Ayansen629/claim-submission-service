    "identificationDocument": {}
  },
  "step2": {
    "securityInterestAmount": "2121",
    "guaranteeAmount": "2112",
    "guarantorName": "2121",
    "guarantorAddress": "2121",
    "creditorAddress": "SSA",
    "creditorEmail": "212@gmail.com",
    "beneficiaryName": "wqwq",
    "beneficiaryAddress": "wqw",
    "corporateDebtorSecurityAmount": "212",
    "corporateDebtorGuaranteeAmount": "2121",
