<Col md={4}>
  <InputSelect
    label={t("Type of Vessel")}
    name="vesselDetails.typeOfVessel"
    placeholder={!viewMode ? t("-- Select --") : ""}
    options={[
      { value: "", label: "-- Select --" },
      ...(masterData?.vesselTypes?.map((type) => ({
        value: type.valueCode,
        label: type.valueLabel,
      })) || []),
    ]}
    register={register("vesselDetails.typeOfVessel")}
    errors={errors}
    value={watch("vesselDetails.typeOfVessel") || ""}
    onChange={(value) =>
      !viewMode &&
      handleSelectChange("vesselDetails.typeOfVessel", value)
    }
    disabled={viewMode || !!vesselData?.typeOfVessel}
    style={{ backgroundColor: "#f8f9fa" }}
  />
</Col>


<Col md={4}>
  <InputSelect
    label={t("Category of Vessel")}
    name="vesselDetails.categoryOfVessel"
    placeholder={!viewMode ? t("-- Select --") : ""}
    options={[
      { value: "", label: "-- Select --" },
      ...(masterData?.vesselCategories?.map((category) => ({
        value: category.valueCode,
        label: category.valueLabel,
      })) || []),
