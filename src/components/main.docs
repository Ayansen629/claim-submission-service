case 'file':
    return (
        <div className="custom-file-input border p-3 rounded"> {/* Add border here */}
            {note && (
                <small className="text-muted d-block mb-2">
                    {note}
                </small>
            )}
            <div className="d-flex align-items-center gap-3">
                <input
                    type="file"
                    id={name}
                    onChange={handleFileChange}
                    className="d-none"
                    disabled={isUploading || disabled}
                    accept={accept}
                />
                <label
                    htmlFor={name}
                    className={`btn btn-outline-primary ${isUploading ? 'disabled' : ''}`}
                >
                    {isUploading ? (
                        <>
                            <span className="spinner-border spinner-border-sm me-2" role="status"></span>
                            Uploading...
                        </>
                    ) : (
                        'Choose File'
                    )}
                </label>
                {value && (
                    <span className="text-truncate" style={{ maxWidth: '200px' }}>
                        {typeof value === 'object' ? value.docName || value.name || 'Uploaded file' : value}
                    </span>
                )}
            </div>
            {uploadError && (
                <div className="text-danger mt-2 small">
                    {uploadError}
                </div>
            )}
            {uploadSuccess && (
                <div className="text-success d-flex align-items-center gap-2 mt-2">
                    <CheckCircle size={16} />
                    <span>File uploaded successfully!</span>
                </div>
            )}
        </div>
    );
