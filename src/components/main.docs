// Inbox Columns Configuration for Admin (without Action column)
export const INBOX_COLUMNS_ADMIN = [
  {
    colName: "Application No",
    fieldName: "appNo",
    clsName: "column-text-start",
  },
  {
    colName: "Application Type",
    fieldName: "appType",
    clsName: "column-text-start",
  },
  {
    colName: "Vessel Owner",
    fieldName: "owner",
    clsName: "column-text-start",
  },
  {
    colName: "Vessel No",
    fieldName: "vesselNo",
    clsName: "column-text-start",
  },
  {
    colName: "Date of Submission",
    fieldName: "date",
    clsName: "column-text-start",
  },
  {
    colName: "Status",
    fieldName: "status",
    clsName: "column-text-start",
    render: (value) => (
      <span className={`status-badge ${value.toLowerCase()}`}>{value}</span>
    ),
  },
];

// Inbox Columns Configuration for Non-Admin (with Action column)
export const INBOX_COLUMNS = [
  {
    colName: "Application No",
    fieldName: "appNo",
    clsName: "column-text-start",
  },
  {
    colName: "Application Type",
    fieldName: "appType",
    clsName: "column-text-start",
  },
  {
    colName: "Vessel Owner",
    fieldName: "owner",
    clsName: "column-text-start",
  },
  {
    colName: "Vessel No",
    fieldName: "vesselNo",
    clsName: "column-text-start",
  },
  {
    colName: "Date of Submission",
    fieldName: "date",
    clsName: "column-text-start",
  },
  {
    colName: "Status",
    fieldName: "status",
    clsName: "column-text-start",
    render: (value) => (
      <span className={`status-badge ${value.toLowerCase()}`}>{value}</span>
    ),
  },
  {
    colName: "Action",
    fieldName: "action",
    actions: ['view'],
    clsName: "col-sm-2 column-text-start actions-column",
  },
];

