// In createFormFieldsConfig.js
step2: [
  {
    name: 'addressProof',
    label: 'Address Proof',
    type: 'file',
    required: false,
    colSize: 6,
    disabled: true,
    render: (value) => (
      <div className="file-display d-flex align-items-center justify-content-between p-2 bg-light rounded">
        <span className="text-truncate me-2" style={{ maxWidth: '200px' }}>
          {value || 'No file uploaded'}
        </span>
        {value && (
          <Button 
            variant="outline-primary" 
            size="sm" 
            onClick={() => handleDownload(value)}
            className="ms-2"
          >
            <FaDownload className="me-1" /> Download
          </Button>
        )}
      </div>
    )
  },
  {
    name: 'panCardUpload',
    label: 'PAN Card',
    type: 'file',
    required: false,
    colSize: 6,
    disabled: true,
    render: (value) => (
      <div className="file-display d-flex align-items-center justify-content-between p-2 bg-light rounded">
        <span className="text-truncate me-2" style={{ maxWidth: '200px' }}>
          {value || 'No file uploaded'}
        </span>
        {value && (
          <Button 
            variant="outline-primary" 
            size="sm" 
            onClick={() => handleDownload(value)}
            className="ms-2"
          >
            <FaDownload className="me-1" /> Download
          </Button>
        )}
      </div>
    )
  },
  {
    name: 'gstCertificate',
    label: 'GST Certificate',
    type: 'file',
    required: false,
    colSize: 6,
    disabled: true,
    render: (value) => (
      <div className="file-display d-flex align-items-center justify-content-between p-2 bg-light rounded">
        <span className="text-truncate me-2" style={{ maxWidth: '200px' }}>
          {value || 'No file uploaded'}
        </span>
        {value && (
          <Button 
            variant="outline-primary" 
            size="sm" 
            onClick={() => handleDownload(value)}
            className="ms-2"
          >
            <FaDownload className="me-1" /> Download
          </Button>
        )}
      </div>
    )
  }
]
