/* Time slot card */
.time-slot-card {
  position: relative;
  padding: 20px;
  border-radius: 12px;
  background: white;
  border: 2px solid #e8ecf4;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.time-slot-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(102, 126, 234, 0.15);
  border-color: #667eea;
}

.time-slot-card.selected {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: 2px solid #667eea;
  color: white;
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(102, 126, 234, 0.3);
}

.time-slot-card.selected .slot-day {
  color: rgba(255, 255, 255, 0.9);
}

.time-slot-card.selected .slot-date {
  color: white;
}

.time-slot-card.selected .slot-time {
  background: rgba(255, 255, 255, 0.2);
  color: white;
}

/* Selection indicator */
.selection-indicator {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.selection-check {
  background: white;
  color: #667eea;
  border-radius: 50%;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 12px;
  animation: bounceIn 0.3s ease;
}

@keyframes bounceIn {
  0% { transform: scale(0); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

/* Rest of the CSS remains the same */
.appointment-modal .modal-content {
  border-radius: 16px;
  border: none;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
}

.slots-container {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 16px;
  max-height: 65vh;
  overflow-y: auto;
  padding: 20px 8px;
}

.confirm-btn:disabled {
  background: #e2e8f0;
  color: #a0aec0;
  cursor: not-allowed;
}
