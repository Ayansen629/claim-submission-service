const handleOnViewRow = async (row) => {
  try {
    setIsLoading(true);
    
    // Get user data from localStorage
    const userFormData = JSON.parse(localStorage.getItem("userFormData"));
    const userInfo = userFormData?.fullloginDetails;
    
    if (!userInfo) {
      throw new Error("User information not found in localStorage");
    }

    const payload = {
      userInfo: userInfo,
      uuids: [row.uuid], // Use the uuid from the row
      applicationNumbers: [],
      claimantUUIDs: []
    };

    const URL =
      process.env.REACT_APP_APPLICATION_SERVICE +
      URLS_ENDPOINT.APP_SERVICES.APPLICATION_SEARCH;

    const response = await postData(URL, payload);
    
    if (response?.data?.status?.code === "200" && response?.data?.applicationDetails?.length > 0) {
      setModalData(response.data.applicationDetails);
      setIsViewModalOpen(true);
    } else {
      toast.error("No application details found", { position: "top-right" });
    }
  } catch (error) {
    console.error("Error fetching application details:", error);
    toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
  } finally {
    setIsLoading(false);
  }
};
<Modal
  show={isViewModalOpen}
  onHide={() => setIsViewModalOpen(false)}
  dialogClassName="modal-1110w"
  aria-labelledby="example-custom-modal-styling-title"
>
  <Modal.Header closeButton>
    <Modal.Title id="example-custom-modal-styling-title">
      Application Details
    </Modal.Title>
  </Modal.Header>
  <Modal.Body>
    {modalData?.length > 0 ? (
      <>
        {modalData.map((application, index) => (
          <Collapsible
            key={index}
            title={`Application: ${application.applicationNumber || 'N/A'}`}
          >
            <div className="card mb-4 tiles_Size">
              <div className="card-body">
                <div className="d-flex justify-content-between align-items-center mb-3">
                  <h5 style={{ fontWeight: 600 }}>Basic Details</h5>
                  <Badge bg="info">
                    Status: {application.status || 'Not Available'}
                  </Badge>
                </div>
                <Container fluid>
                  <Row className="g-3">
                    {Object.entries({
                      "Application Number": application.applicationNumber,
                      "Debtor Name": application.creditorBasicDetails?.debtorName,
                      "Creditor Name": application.creditorBasicDetails?.creditorName,
                      "Total Claim Amount": application.creditorBasicDetails?.totalClaimAmount,
                      "Debt Details": application.creditorBasicDetails?.debtDetails,
                      "Mutual Credit Details": application.creditorBasicDetails?.mutualCreditDetails,
                    }).map(([key, value]) => (
                      <Col key={key} xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title={key} value={value || 'N/A'} />
                      </Col>
                    ))}
                  </Row>
                </Container>
              </div>
            </div>

            <div className="card mb-4 tiles_Size">
              <div className="card-body">
                <h5 style={{ fontWeight: 600 }}>Identification Details</h5>
                <Container fluid>
                  <Row className="g-3">
                    {Object.entries({
                      "Identification Type": application.creditorBasicDetails?.document?.docType,
                      "Identification Number": application.creditorBasicDetails?.identificationNumber,
                      "Document Name": application.creditorBasicDetails?.document?.docName,
                    }).map(([key, value]) => (
                      <Col key={key} xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title={key} value={value || 'N/A'} />
                      </Col>
                    ))}
                  </Row>
                </Container>
              </div>
            </div>

            <div className="card mb-4 tiles_Size">
              <div className="card-body">
                <h5 style={{ fontWeight: 600 }}>Claim Details</h5>
                <Container fluid>
                  <Row className="g-3">
                    {Object.entries({
                      "Security Interest Amount": application.claimDetails?.securityInterestAmount,
                      "Guarantee Amount": application.claimDetails?.guaranteeAmount,
                      "Guarantor Name": application.claimDetails?.guarantorName,
                      "Guarantor Address": application.claimDetails?.guarantorAddress,
                      "Creditor Address": application.claimDetails?.creditorAddress,
                      "Creditor Email": application.claimDetails?.creditorEmail,
                    }).map(([key, value]) => (
                      <Col key={key} xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title={key} value={value || 'N/A'} />
                      </Col>
                    ))}
                  </Row>
                </Container>
              </div>
            </div>

            <div className="card mb-4 tiles_Size">
              <div className="card-body">
                <h5 style={{ fontWeight: 600 }}>Signatory Details</h5>
                <Container fluid>
                  <Row className="g-3">
                    {Object.entries({
                      "Signatory Name": application.signatoryDetails?.name,
                      "Signatory Position": application.signatoryDetails?.position,
                      "Signatory Address": application.signatoryDetails?.address,
                      "Document Type": application.signatoryDetails?.document?.docType,
                      "Document Name": application.signatoryDetails?.document?.docName,
                    }).map(([key, value]) => (
                      <Col key={key} xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title={key} value={value || 'N/A'} />
                      </Col>
                    ))}
                  </Row>
                </Container>
              </div>
            </div>
          </Collapsible>
        ))}
      </>
    ) : (
      <p>No application data available.</p>
    )}
  </Modal.Body>
  <Modal.Footer>
    <Button variant="secondary" onClick={() => setIsViewModalOpen(false)}>
      Close
    </Button>
    <Button variant="primary" onClick={() => {
      // Add any additional action here if needed
      setIsViewModalOpen(false);
    }}>
      Print/Download
    </Button>
  </Modal.Footer>
</Modal>

