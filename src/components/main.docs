import React from 'react';
import { Row, Col } from 'react-bootstrap';
import { useFormContext } from 'react-hook-form';
import InputText from './InputText.tsx';
import InputFile from './InputFile.tsx';
import { renameFile } from '../../utils/constants.ts';

const DynamicFormFields = ({ fields, setFormData }) => {
  const { register, formState: { errors }, setValue, watch, setError, trigger } = useFormContext();

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'file':
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name, {
              required: field.required ? `${field.label} is required` : false,
              validate: {
                lessThan2MB: files => 
                  !files[0] || files[0].size < 2 * 1024 * 1024 || 'File size should be less than 2MB',
                acceptedFormats: files => 
                  !files[0] || 
                  ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'].includes(files[0].type) || 
                  'Only PDF, JPG or PNG files are allowed'
              }
            })}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
                const fileName = `${field.label}${extension}`;
                file.originalName = fileName;
                const renamedFile = renameFile(file, fileName);
                setValue(field.name, renamedFile);
                setFormData(prev => {
                  const updated = { ...prev, [field.name]: renamedFile };
                  return updated;
                });
                trigger(field.name); // Trigger validation after file selection
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={watch(field.name)}
            setValue={setValue}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...field.validation,
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className="mb-4"
            style={{
              borderColor: errors[field.name] ? '#dc3545' : '#ced4da',
              backgroundColor: errors[field.name] ? '#fff8f8' : 'white'
            }}
          />
        );
    }
  };

  return (
    <Row className="g-3">
      {fields.map((field, index) => (
        <Col key={index} md={field.colSize || 12}>
          {renderField(field)}
        </Col>
      ))}
    </Row>
  );
};

export default DynamicFormFields;
