import { useForm, FormProvider } from 'react-hook-form';
import DocumentUpload from './DocumentUpload';

const ParentComponent = () => {
  const methods = useForm();
  
  return (
    <FormProvider {...methods}>
      {/* Other form components */}
      <DocumentUpload />
      {/* Other form components */}
    </FormProvider>
  );
};

