import React from "react";
import { useLocation, useNavigate, useParams } from "react-router-dom";
import DynamicTabs from "../../../common/DynamicTabs";
import VesselSurveyRegistration from "./survey/VesselSurveyRegistration";
import VesselReportsAndDocs from "./common/VesselReportsAndDocs";
import { useTranslation } from "react-i18next";
import { Button } from "react-bootstrap";
import { Box, Typography, Stack, Paper } from "@mui/material";
import { BsArrowLeft } from "react-icons/bs";

const VesselApplicationDetailsView = () => {
  const { t } = useTranslation();
  const { id } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  const { rowData } = location?.state || {};
  
  const tabs = [
    {
      key: "registration",
      title: t("Registration Information"),
      content: <VesselReportsAndDocs applicationNo={id} viewMode tabMode />,
    },
    ...(rowData?.enableInitialSurvey
      ? [
          {
            key: "survey",
            title: t("Initial Survey - Details"),
            content: (
              <VesselSurveyRegistration applicationNo={id} viewMode tabMode />
            ),
          },
        ]
      : []),
  ];

  return (
    <Box sx={{ p: 2, backgroundColor: "#f8fafc", minHeight: "100vh" }}>
      {/* Compact Header */}
      <Box 
        sx={{ 
          display: 'flex', 
          alignItems: 'center', 
          mb: 2,
          p: 2,
          backgroundColor: "#fff",
          borderRadius: 1,
          boxShadow: "0 1px 3px rgba(0,0,0,0.05)",
          border: "1px solid #e1e5e9"
        }}
      >
        <Button
          variant="outline-primary"
          onClick={() => navigate("/dashboard")}
          className="d-flex align-items-center justify-content-center"
          sx={{
            borderRadius: "6px",
            width: 36,
            height: 36,
            border: "1px solid #e1e5e9",
            color: "#2E57A7",
            backgroundColor: "#fff",
            transition: "all 0.2s ease",
            padding: 0,
            marginRight: 1.5,
            minWidth: "auto",
            "&:hover": {
              backgroundColor: "#2E57A7",
              color: "#fff",
              borderColor: "#2E57A7"
            }
          }}
          aria-label={t("Back to Dashboard")}
        >
          <BsArrowLeft size={14} />
        </Button>
        
        <Stack spacing={0}>
          <Typography
            sx={{
              fontWeight: 600,
              color: "#1a3353",
              fontSize: "1.25rem",
              lineHeight: 1.3,
            }}
            component="h1"
          >
            {t("Vessel Application Details")}
          </Typography>
          {id && (
            <Typography
              sx={{
                fontWeight: 400,
                color: "#64748b",
                fontSize: "0.8rem",
                mt: 0.25
              }}
            >
              Application ID: {id}
            </Typography>
          )}
        </Stack>
      </Box>
      
      {/* Compact Tabs Section */}
      <Paper 
        elevation={0}
        sx={{ 
          borderRadius: 1,
          overflow: "hidden",
          border: "1px solid #e1e5e9",
          backgroundColor: "#fff"
        }}
      >
        <DynamicTabs tabs={tabs} />
      </Paper>
    </Box>
  );
};

export default VesselApplicationDetailsView;
