<div
  className="registration-id p-4 bg-light rounded mb-4"
  style={{ borderLeft: "4px solid #0077b6" }}
>
  <div className="mb-3">
    <strong>Registration Number:</strong>
    <div className="text-primary fs-5 fw-bold mt-2">
      {successMessage?.data?.userBasicDetails?.registrationNumber || "N/A"}
    </div>
  </div>
  <p className="mb-0">
    {successMessage?.responseStatus?.message || 
     `Your vessel owner registration has been submitted successfully with Registration Number: ${successMessage?.data?.userBasicDetails?.registrationNumber || "N/A"}. You will receive a confirmation email shortly.`}
  </p>
</div>
