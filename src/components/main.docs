// UserManagement.tsx
import { useNavigate } from "react-router-dom";
import "react-toastify/dist/ReactToastify.css";
import { postData } from "../../../../services/http.service.ts";
import { useTranslation } from "react-i18next";
import { useEffect, useState } from "react";
import ActionTable from "../../../common/ActionTable.tsx";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import { toast } from "react-toastify";
import ActionModal from "../../../common/ActionModal.tsx";
import { FormProvider, useForm } from "react-hook-form";
import { USER_REGIS_MASTER } from "./userManagConst.ts";
import { Card, Row, Col, Button } from "react-bootstrap";
import EmployeeRegistrationForm from "../../../common/EmployeeRegistrationForm.js";

const formDefaultValues = {
  personal: {
    firstName: "",
    lastName: "",
    email: "",
    phoneNumber: "",
    gender: "",
    dob: ""
  },
  address: {
    line1: "",
    line2: "",
    pin: "",
    district: "",
    state: "",
    country: ""
  },
  educationDetails: [{
    qualification: "",
    stream: "",
    yearOfPassing: ""
  }],
  professional: {
    appointmentDate: "",
    employeeType: "",
    employeeStatus: "",
    designation: "",
    department: "",
    section: "",
    roles: ""
  },
  documents: {
    addressProof: null,
    identityProof: null,
    appointmentLetter: null
  }
};

const UserManagement = () => {
  const { t } = useTranslation();
  const [rowData, setRowData] = useState([]);
  const [showModal, setShowModal] = useState(false);
  const [modalTitle] = useState(t("AddUser"));
  const [isLoading, setIsLoading] = useState(false);

  const methods = useForm({
    defaultValues: formDefaultValues,
    mode: 'onChange'
  });

  useEffect(() => {
    getUserDetails();
  }, []);

  const getUserDetails = async () => {
    setIsLoading(true);
    try {
      setTimeout(() => {
        setRowData(USER_REGIS_MASTER.MOCK_USER_DATA);
        setIsLoading(false);
      }, 500);
    } catch (error) {
      toast.error(t("Error fetching user details"));
      setIsLoading(false);
    }
  };

  const handleFormSubmit = async (data: any) => {
    try {
      console.log("Form Data:", JSON.stringify(data, null, 2));
      
      const formData = new FormData();
      
      // Append personal details
      Object.entries(data.personal).forEach(([key, value]) => {
        formData.append(`personal.${key}`, value as string);
      });

      // Append address details
      Object.entries(data.address).forEach(([key, value]) => {
        formData.append(`address.${key}`, value as string);
      });

      // Append education details
      data.educationDetails.forEach((edu: any, index: number) => {
        Object.entries(edu).forEach(([key, value]) => {
          formData.append(`educationDetails[${index}].${key}`, value as string);
        });
      });

      // Append professional details
      Object.entries(data.professional).forEach(([key, value]) => {
        formData.append(`professional.${key}`, value as string);
      });

      // Append documents
      Object.entries(data.documents).forEach(([key, value]) => {
        if (value) {
          formData.append(key, (value as FileList)[0]);
        }
      });

      await postData("your-api-endpoint", formData);
      toast.success("Employee registered successfully!");
      setShowModal(false);
      methods.reset(formDefaultValues);
    } catch (error) {
      toast.error("Error submitting form");
    }
  };

  return (
    <div className="w-full">
      <Card>
        {/* Search Form */}
        <form style={{ padding: "2rem", margin: 0 }}>
          {/* ... existing search form elements ... */}
          <Row className="mt-2">
            <Col md={{ span: 2, offset: 10 }} className="d-flex justify-content-end">
              <Button
                variant="primary"
                onClick={() => setShowModal(true)}
              >
                <i className="fa fa-plus me-2"></i>{t("Add")}
              </Button>
            </Col>
          </Row>
        </form>
      </Card>

      <ActionTable
        tableHeader="Employee List"
        columns={USER_REGIS_MASTER.USER_INFO_COLUMNS}
        rowData={rowData}
        isLoading={isLoading}
        // ... other table props
      />

      <ActionModal
        show={showModal}
        close={() => {
          setShowModal(false);
          methods.reset(formDefaultValues);
        }}
        title={modalTitle}
        size="xl"
        isFooterHide={false}
      >
        <FormProvider {...methods}>
          <form onSubmit={methods.handleSubmit(handleFormSubmit)}>
            <EmployeeRegistrationForm />
            <div className="modal-footer mt-4">
              <Button variant="secondary" onClick={() => setShowModal(false)}>
                Close
              </Button>
              <Button variant="primary" type="submit" className="ms-2">
                Submit
              </Button>
            </div>
          </form>
        </FormProvider>
      </ActionModal>
    </div>
  );
};

export default UserManagement;

//////////////
// EmployeeRegistrationForm.tsx
import { useEffect } from "react";
import { useFieldArray, useFormContext } from "react-hook-form";
import { Card, Row, Col, Button } from "react-bootstrap";
import InputSelect from "../common/InputSelect.tsx";
import InputText from "../common/InputText.tsx";
import Collapsible from "../common/Collapsible";
import { toast } from "react-toastify";

const EmployeeRegistrationForm = () => {
  const { control, register, setValue, watch, formState: { errors } } = useFormContext();
  const { fields, append, remove } = useFieldArray({
    control,
    name: "educationDetails"
  });
  const watchPin = watch("address.pin");

  useEffect(() => {
    const fetchAddressDetails = async (pin: string) => {
      if (pin?.length === 6) {
        try {
          const response = await fetch(`https://api.postalpincode.in/pincode/${pin}`);
          const data = await response.json();
          
          if (data[0]?.Status === "Success" && data[0]?.PostOffice?.length > 0) {
            const postOffice = data[0].PostOffice[0];
            setValue("address.district", postOffice.District);
            setValue("address.state", postOffice.State);
            setValue("address.country", postOffice.Country);
            toast.success("Address details auto-filled!");
          }
        } catch (error) {
          toast.error("Failed to fetch address details");
        }
      }
    };

    fetchAddressDetails(watchPin);
  }, [watchPin, setValue]);

  return (
    <div className="employee-registration-form">
      <Collapsible title="Personal Details" defaultOpen={true}>
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={4}>
                <InputText
                  name="personal.firstName"
                  label="First Name"
                  placeholder="John"
                  register={register}
                  errors={errors}
                  validation={{ required: "Required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.lastName"
                  label="Last Name"
                  placeholder="Doe"
                  register={register}
                  errors={errors}
                  validation={{ required: "Required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.email"
                  label="Email"
                  placeholder="john.doe@example.com"
                  type="email"
                  register={register}
                  errors={errors}
                  validation={{ required: "Required" }}
                />
              </Col>
              {/* Add all other form fields with proper names and placeholders */}
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Address Section */}
      <Collapsible title="Address Details">
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={4}>
                <InputText
                  name="address.pin"
                  label="PIN Code"
                  placeholder="110001"
                  register={register}
                  errors={errors}
                  validation={{
                    required: "Required",
                    pattern: {
                      value: /^\d{6}$/,
                      message: "Invalid PIN"
                    }
                  }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="address.district"
                  label="District"
                  placeholder="Auto-filled"
                  register={register}
                  errors={errors}
                  readOnly
                />
              </Col>
              {/* Add other address fields */}
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Add other sections with proper field names */}
    </div>
  );
};

export default EmployeeRegistrationForm;
