import React, { useEffect, useMemo, useState } from "react";
import { Container, Row, Col, Spinner, Badge, Button } from "react-bootstrap";
import Collapsible from "./formCommon/Collapsible";
import { useFormData } from "../../context/FormDataContext";
import PreviewCard from "../../private/Dashboard/PreviewCard";
import { FaDownload } from "react-icons/fa";
import axios from "axios";

const ReviewStep = () => {
  const { formData } = useFormData();
  console.log("reviewstepformData", formData);
  const [draftResponse, setDraftResponse] = useState(null);
  const [loading, setLoading] = useState(true);
  const [downloading, setDownloading] = useState({});
  const staticApplicationNumber="CLAIM/CIRP/20250425/0093993"

  // Load draft data from localStorage on mount
  useEffect(() => {
    const savedDraft = localStorage.getItem("draftResponse");
    if (savedDraft) {
      try {
        const parsedDraft = JSON.parse(savedDraft);
        setDraftResponse(parsedDraft);
      } catch (error) {
        console.error("Error parsing draft data:", error);
      }
    }
    setLoading(false);
  }, []);

  // Handle document download
  const handleDownload = async (fileId, fileName) => {
    try {
      setDownloading(prev => ({ ...prev, [fileId]: true }));
      
      const response = await axios.get(
        `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileId}`,
        { responseType: 'blob' }
      );

      // Create download link
      const url = window.URL.createObjectURL(new Blob([response.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', fileName || 'document');
      document.body.appendChild(link);
      link.click();
      link.remove();
      
    } catch (error) {
      console.error('Error downloading file:', error);
      alert('Failed to download document');
    } finally {
      setDownloading(prev => ({ ...prev, [fileId]: false }));
    }
  };

  // Get application number from draft response
  const applicationNumber = useMemo(() => {
    if (!draftResponse) return null;
    return draftResponse.data.applicationDetails?.applicationNumber || "N/A";
  }, [draftResponse]);

  // Format document display with download button
  const formatFileInfo = (fileData) => {
    if (!fileData) return "No file uploaded";
    if (typeof fileData === "string") return fileData;
    
    const fileName = fileData.fileName || fileData.docName || "File uploaded";
    const fileId = fileData.fileId || fileData.docId;
    
    return (
      <div className="d-flex align-items-center">
        <span className="me-2">{fileName}</span>
        <Button 
          variant="link" 
          size="sm" 
          className="p-0"
          onClick={() => handleDownload(fileId, fileName)}
          disabled={downloading[fileId]}
        >
          {downloading[fileId] ? (
            <Spinner animation="border" size="sm" />
          ) : (
            <FaDownload className="text-primary" />
          )}
        </Button>
      </div>
    );
  };

  // Transform the form data for display
  const formattedData = useMemo(() => {
    if (!formData) return null;

    return {
      step1: {
        creditorDetails: {
          "Financial Creditor Name": formData.step1.financialCreditorName,
          "Financial Creditor Email": formData.step1.financialCreditorEmail,
          "Address": `${formData.step1.addressLine1}, ${formData.step1.addressLine2}`,
          "City": formData.step1.city,
          "State": formData.step1.state,
          "Pincode": formData.step1.pincode
        },
        identificationDetails: {
          "Identification Type": formData.step1.identificationType,
          "Identification Details": formData.step1.identificationtype_details?.map(detail => (
            <div key={detail.id} className="mb-2">
              <div><strong>SL:</strong> {detail.id}</div>
              <div><strong>Details:</strong> {detail.details}</div>
              <div><strong>Proof:</strong> {formatFileInfo(detail.proof)}</div>
            </div>
          )) || "N/A"
        }
      },
      step2: {
        claimDetails: {
          "Claim Type": formData.step2.claimType,
          "Has Security Interest": formData.step2.hasSecurityInterest,
          "Has Guarantee": formData.step2.hasGuarantee,
          "Claim Amount": formData.step2.claimAmount,
          "Principal Borrower Name": formData.step2.principalBorrowerName1,
          "Principal Borrower Address": formData.step2.principalBorrowerAddress1,
          "Debt Details": formData.step2.debtDetails,
          "Debt Date": formData.step2.debtDate,
          "Mutual Details": formData.step2.mutualDetails,
          "Security Value": formData.step2.securityValue,
          "Security Date": formData.step2.securityDate,
          "Guarantee Value": formData.step2.guaranteeValue,
          "Guarantee Date": formData.step2.guaranteeDate
        },
        bankDetails: {
          "Account Number": formData.step2.accountNumber,
          "IFSC Code": formData.step2.ifscCode,
          "Bank Name": formData.step2.bankName,
          "Branch Name": formData.step2.branchName,
          "Branch Address": formData.step2.branchAddress,
          "City": formData.step2.city,
          "State": formData.step2.state,
          "District": formData.step2.district
        },
        
      },
      step3: {
        signatoryDetails: {
          "Creditor Name": formData.step3.creditorName,
          "Creditor Position": formData.step3.creditorPosition,
          "Creditor Signature": formData.step3.creditorSignatureText,
          "Has Signature": formData.step3.hasSignature,
          "Creditor Address": formData.step3.creditorAddress,
          "Signature File": formatFileInfo(formData.step3.signatureFile)
        }
      },
      step4: {
        documentDetails: {
          "Identity Proof Type": formData.step4.identityProofType,
          "Address Proof Type": formData.step4.addressProofType,
          "Identity Proof File": formatFileInfo(formData.step4.identityProofFile),
          "Address Proof File": formatFileInfo(formData.step4.addressProofFile)
        }
      }
    };
  }, [formData, downloading]);

  if (loading) {
    return (
      <div className="d-flex justify-content-center align-items-center" style={{ height: "100vh" }}>
        <Spinner animation="border" />
      </div>
    );
  }

  if (!formattedData) {
    return (
      <div className="alert alert-info">
        No form data available to display
      </div>
    );
  }

  const renderPreviewSection = (fields) => (
    <Container fluid>
      <Row className="g-3">
        {Object.entries(fields).map(([key, value]) => (
          <Col key={key} xs={12} sm={6} md={3} className="mb-3">
            <PreviewCard 
              title={key} 
              value={value} 
            />
          </Col>
        ))}
      </Row>
    </Container>
  );

  const renderCard = (title, fields) => (
    <div className="mb-3">
      <h5 style={{ fontWeight: 600 }}>{title}</h5>
      {renderPreviewSection(fields)}
    </div>
  );

  return (
    <div className="form-stepper">
      {/* {draftResponse && ( */}
        <div className="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
          <div>
            <span className="text-muted small">Application Number:</span>
            <span className="ms-2 fw-bold">{staticApplicationNumber}</span>
          </div>
          <Badge bg="warning" className="text-dark">
            Draft Preview
          </Badge>
        </div>
      {/* )} */}

      <Collapsible title="Step 1: Creditor and Identification Details">
        {renderCard("Creditor Details", formattedData.step1.creditorDetails)}
        {renderCard("Identification Details", formattedData.step1.identificationDetails)}
      </Collapsible>

      <Collapsible title="Step 2: Claim and Financial Details">
        {renderCard("Claim Details", formattedData.step2.claimDetails)}
        {renderCard("Bank Details", formattedData.step2.bankDetails)}
        
      </Collapsible>

      <Collapsible title="Step 3: Signatory Details">
        {renderCard("Signatory Details", formattedData.step3.signatoryDetails)}
      </Collapsible>

      <Collapsible title="Step 4: Document Verification">
        {renderCard("Document Details", formattedData.step4.documentDetails)}
      </Collapsible>
    </div>
  );
};

export default React.memo(ReviewStep);
