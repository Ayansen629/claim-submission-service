/* Card Container */
.row.g-3 {
  display: flex;
  flex-wrap: wrap;
}

.col-md-4, .col-lg-3, .col-sm-12 {
  display: flex;
  flex-direction: column;
}

/* Status Card - Applied to all cards */
.status-card {
  height: 100%;
  min-height: 220px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  border-left: 4px solid;
  background: #fff;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  padding: 20px;
}

.status-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
}

/* Common card elements */
.status-card .icon-wrapper {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.status-card .value {
  font-size: 32px;
  font-weight: 700;
  margin: 8px 0;
  line-height: 1;
  color: #333;
}

.status-card .title {
  font-size: 15px;
  color: #555;
  margin-bottom: 6px;
  font-weight: 500;
}

.status-card .subtitle {
  font-size: 13px;
  color: #888;
  margin-bottom: 0;
}
