import React, { useCallback, useEffect, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepFirst.css";
import 'bootstrap/dist/css/bootstrap.min.css';
import { FaPlus, FaTimes } from "react-icons/fa";
import { Button } from "react-bootstrap";

const StepFirst = ({ provideSubmitHandler, formData, onValidationComplete }) => {
  const [isUploading, setIsUploading] = useState(false);
  const [uploadError, setUploadError] = useState(null);
  const [identificationRecords, setIdentificationRecords] = useState([{ id: 1, details: "", docs: null }]);
  
  const methods = useForm({
    mode: "onChange",
    reValidateMode: "onChange",
    defaultValues: {
      identification_records: [{ id: 1, details: "", docs: null }]
    }
  });
  
  const { register, handleSubmit, formState: { errors, isValid }, trigger, setValue, control, getValues, watch } = methods;
  const watchIdentificationType = watch("identificationType", "incorporated");

  // Initialize form data
  useEffect(() => {
    if (formData) {
      // Initialize identification records
      if (formData.identification_records && formData.identification_records.length > 0) {
        setIdentificationRecords(formData.identification_records);
      }
      
      // Set all other form values
      Object.keys(formData).forEach((key) => {
        if (key !== 'identification_records') {
          setValue(key, formData[key]);
        }
      });
      
      // Ensure identification_records is set in form state
      setValue('identification_records', formData.identification_records || [{ id: 1, details: "", docs: null }]);
    }
  }, [formData, setValue]);

  const handleFileUpload = async (file) => {
    try {
      setIsUploading(true);
      setUploadError(null);
      const result = await uploadDocument(file, 'identification');
      return {
        fileId: result.fileId,
        fileName: file.name,
        fileType: file.type
      };
    } catch (error) {
      setUploadError(error.message);
      throw error;
    } finally {
      setIsUploading(false);
    }
  };

  const addIdentificationRecord = () => {
    const newId = identificationRecords.length > 0 
      ? Math.max(...identificationRecords.map(r => r.id)) + 1 
      : 1;
      
    const newRecord = { id: newId, details: "", docs: null };
    const updatedRecords = [...identificationRecords, newRecord];
    
    setIdentificationRecords(updatedRecords);
    setValue('identification_records', updatedRecords);
  };

  const removeIdentificationRecord = (id) => {
    if (identificationRecords.length > 1) {
      const updatedRecords = identificationRecords.filter(record => record.id !== id);
      setIdentificationRecords(updatedRecords);
      setValue('identification_records', updatedRecords);
    }
  };

  const updateRecordField = (id, field, value) => {
    const updatedRecords = identificationRecords.map(record => 
      record.id === id ? { ...record, [field]: value } : record
    );
    
    setIdentificationRecords(updatedRecords);
    setValue('identification_records', updatedRecords);
  };

  const handleFileChange = async (e, recordId) => {
    const file = e.target.files[0];
    if (!file) return;

    try {
      const uploadedDoc = await handleFileUpload(file);
      updateRecordField(recordId, 'docs', uploadedDoc);
    } catch (error) {
      console.error("Upload failed:", error);
    }
  };

  // ... (keep your existing schema definitions)

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        <div className="mb-4 bg-light p-4 rounded-3">
          <Collapsible title="Basic Details" defaultOpen={true}>
            <div className="container-fluid">
              <div className="row g-3">
                {basicDetailsSchema.map((fieldConfig) => (
                  <div key={fieldConfig.name} className="col-md-6">
                    <DynamicField
                      fieldConfig={fieldConfig}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      trigger={trigger}
                      getValues={getValues}
                    />
                  </div>
                ))}
              </div>

              {watchIdentificationType === "incorporated" && (
                <div className="row g-3 mt-2">
                  {incorporatedBodyFields.map((fieldConfig) => (
                    <div key={fieldConfig.name} className="col-md-6">
                      <DynamicField
                        fieldConfig={{
                          ...fieldConfig,
                          isUploading,
                          uploadError,
                          setIsUploading,
                          setUploadError,
                          onFileUpload: handleFileUpload
                        }}
                        control={control}
                        register={register}
                        errors={errors}
                        setValue={setValue}
                        trigger={trigger}
                        getValues={getValues}
                      />
                      {fieldConfig.name === "incorporatedProofDocument" && (
                        <div className="form-text text-muted">
                          Max file size: 5MB (PDF, JPEG, PNG)
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}

              {watchIdentificationType === "partnership" && (
                <div className="mt-3">
                  {identificationRecords.map((record, index) => (
                    <div key={record.id} className="mb-4 p-3 border rounded">
                      <div className="d-flex justify-content-between align-items-center mb-3">
                        <h6 className="mb-0">Identification Record {index + 1}</h6>
                        {identificationRecords.length > 1 && (
                          <button
                            type="button"
                            className="btn btn-sm btn-danger"
                            onClick={() => removeIdentificationRecord(record.id)}
                          >
                            <FaTimes /> Remove
                          </button>
                        )}
                      </div>
                      <div className="row g-3">
                        <div className="col-12">
                          <DynamicField
                            fieldConfig={{
                              name: `record_${record.id}_details`,
                              label: <>Identification Details <span className="required-asterisk">*</span></>,
                              type: "textarea",
                              rules: {
                                required: "Identification details are required",
                                minLength: {
                                  value: 10,
                                  message: "Please provide detailed information"
                                }
                              },
                              placeholder: "Enter identification details",
                              defaultValue: record.details
                            }}
                            control={control}
                            register={register}
                            errors={errors}
                            setValue={(name, value) => updateRecordField(record.id, 'details', value)}
                            trigger={trigger}
                            getValues={getValues}
                          />
                        </div>
                        <div className="col-12">
                          <Form.Group>
                            <Form.Label>
                              Proof of Identification <span className="required-asterisk">*</span>
                            </Form.Label>
                            {record.docs ? (
                              <div className="d-flex align-items-center mt-2">
                                <span className="me-2">{record.docs.fileName}</span>
                                <Button
                                  variant="outline-primary"
                                  size="sm"
                                  href={`${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${record.docs.fileId}`}
                                  target="_blank"
                                  className="me-2"
                                >
                                  <FaDownload />
                                </Button>
                                <Button
                                  variant="outline-danger"
                                  size="sm"
                                  onClick={() => updateRecordField(record.id, 'docs', null)}
                                >
                                  <FaTimes />
                                </Button>
                              </div>
                            ) : (
                              <>
                                <input
                                  type="file"
                                  id={`record_${record.id}_docs`}
                                  accept=".pdf,.jpg,.jpeg,.png"
                                  onChange={(e) => handleFileChange(e, record.id)}
                                  className="d-none"
                                  disabled={isUploading}
                                />
                                <label 
                                  htmlFor={`record_${record.id}_docs`} 
                                  className="btn btn-outline-primary w-100"
                                >
                                  {isUploading ? (
                                    <>
                                      <Spinner animation="border" size="sm" className="me-2" />
                                      Uploading...
                                    </>
                                  ) : (
                                    "Choose File"
                                  )}
                                </label>
                              </>
                            )}
                            <Form.Control.Feedback type="invalid" className="d-block">
                              {errors.identification_records?.[index]?.docs?.message}
                            </Form.Control.Feedback>
                            <div className="form-text text-muted">
                              Max file size: 5MB (PDF, JPEG, PNG)
                            </div>
                          </Form.Group>
                        </div>
                      </div>
                    </div>
                  ))}

                  <button
                    type="button"
                    className="btn btn-outline-primary mt-2"
                    onClick={addIdentificationRecord}
                  >
                    <FaPlus /> Add Another Identification Record
                  </button>
                </div>
              )}
            </div>
          </Collapsible>

          {/* Address Details Collapsible (keep your existing implementation) */}
          
        </div>
      </form>
    </FormProvider>
  );
};

export default StepFirst;
