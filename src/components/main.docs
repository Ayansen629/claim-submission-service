const actionDropdown =
  isViewMode && isOfficerLogin && actionsFromAPI?.length > 0 ? (
    <div
      style={{
        display: "flex",
        gap: "8px",
        alignItems: "center",
        flexWrap: "wrap",
      }}
    >
      {/* Certificate Buttons */}
      {userRole === USER_ROLES?.OFFICER_L3 && showOfficerActions && (
        <>
          {!generatedCertificates.survey && (
            <Button
              variant="contained"
              onClick={() => handleProvisionModalOpen("survey")}
              style={{
                background: "#10b981",
                color: "#fff",
                fontWeight: "600",
                borderRadius: "6px",
                fontSize: "0.75rem",
                padding: "6px 12px",
                height: "32px",
                minWidth: "80px",
                maxWidth: "80px",
                textTransform: "none",
                border: "none",
                boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
                transition: "all 0.2s ease",
              }}
              onMouseEnter={(e) => {
                e.target.style.background = "#059669";
                e.target.style.transform = "translateY(-1px)";
                e.target.style.boxShadow = "0 2px 6px rgba(0,0,0,0.15)";
              }}
              onMouseLeave={(e) => {
                e.target.style.background = "#10b981";
                e.target.style.transform = "translateY(0)";
                e.target.style.boxShadow = "0 1px 3px rgba(0,0,0,0.12)";
              }}
              title="Generate Provisional Certificate of Survey"
            >
              Survey
            </Button>
          )}
          
          {!generatedCertificates.registration && (
            <Button
              variant="contained"
              onClick={() => handleProvisionModalOpen("registration")}
              style={{
                background: "#10b981",
                color: "#fff",
                fontWeight: "600",
                borderRadius: "6px",
                fontSize: "0.75rem",
                padding: "6px 12px",
                height: "32px",
                minWidth: "80px",
                maxWidth: "80px",
                textTransform: "none",
                border: "none",
                boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
                transition: "all 0.2s ease",
              }}
              onMouseEnter={(e) => {
                e.target.style.background = "#059669";
                e.target.style.transform = "translateY(-1px)";
                e.target.style.boxShadow = "0 2px 6px rgba(0,0,0,0.15)";
              }}
              onMouseLeave={(e) => {
                e.target.style.background = "#10b981";
                e.target.style.transform = "translateY(0)";
                e.target.style.boxShadow = "0 1px 3px rgba(0,0,0,0.12)";
              }}
              title="Generate Provisional Certificate of Registration"
            >
              Registry
            </Button>
          )}
        </>
      )}

      {/* Save Button */}
      <Button
        variant="contained"
        onClick={() =>
          handleFormSubmit({
            index: 1,
            getFormData: () => methods?.getValues(),
          })
        }
        style={{
          backgroundColor: "#2E57A7",
          fontWeight: "600",
          borderRadius: "6px",
          fontSize: "0.75rem",
          color: "#fff",
          padding: "6px 12px",
          height: "32px",
          minWidth: "80px",
          maxWidth: "80px",
          textTransform: "none",
          boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
          transition: "all 0.2s ease",
        }}
        title="Save current changes"
      >
        Save
      </Button>

      {/* Action Dropdown */}
      <ActionDropdown
        actions={actionsFromAPI}
        onActionClick={handleWorkflowActionClick}
      />
    </div>
  ) : null;
