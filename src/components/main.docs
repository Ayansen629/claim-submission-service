import React, { useState, useEffect } from 'react';
import { useForm } from 'react-hook-form';
import { Link, useNavigate } from 'react-router-dom';
import { toast } from 'react-toastify';
import 'react-toastify/dist/ReactToastify.css';
import {
  fetchInitialClaimantData,
  registerCorporateDebtor,
} from "../../services/auth.service.js";
import './CorporateRegister.css';

const CorporateDebtorRegister = () => {
  const navigate = useNavigate();
  const [loading, setLoading] = useState(false);
  const [processTypesFromApi, setProcessTypesFromApi] = useState([]);

  const {
    register,
    handleSubmit,
    watch,
    formState: { errors, isValid, isDirty }
  } = useForm({
    mode: 'onChange'
  });

  useEffect(() => {
    const fetchInitialData = async () => {
      try {
        setLoading(true);
        const response = await fetchInitialClaimantData();

        if (response.data.status.code === "200") {
          const data = response.data.claimantMasterData;
          setProcessTypesFromApi(data.processTypes || []);
        } else {
          toast.error(response.data.status.message || "Failed to fetch initial data");
        }
      } catch (error) {
        console.error("Error fetching initial data:", error);
        toast.error(error.response?.data?.status?.message || "Error fetching initial data");
      } finally {
        setLoading(false);
      }
    };
    fetchInitialData();
  }, []);

  const onSubmit = async (formData) => {
    try {
      setLoading(true);
      
      // Find the selected process type to get its UUID
      const selectedProcessType = processTypesFromApi.find(
        type => type.processTypeValue === formData.processType
      );
      
      if (!selectedProcessType) {
        throw new Error("Selected process type not found");
      }

      const requestData = {
        claimant: {},
        corporateDebtor: {
          uuid: "",
          companyName: formData.name,
          emailId: formData.email,
          cinNumber: formData.cin,
          processId: selectedProcessType.uuid, // Using the UUID of the selected process type
          password: formData.password,
          isActive: true,
          auditDetails: {
            createdBy: "system_admin",
            createdDate: new Date().toISOString(),
            lastModifiedBy: "system_admin",
            lastModifiedDate: new Date().toISOString()
          }
        }
      };

      const response = await registerCorporateDebtor(requestData);

      if (response.data.status.code === "201") {
        toast.success('Registration successful!');
        // You might want to store the OTP or navigate to OTP verification
        navigate('/login');
      } else {
        throw new Error(response.data.status.message || "Registration failed");
      }
    } catch (error) {
      console.error("Registration error:", error);
      toast.error(error.response?.data?.status?.message || error.message || "Registration failed");
    } finally {
      setLoading(false);
    }
  };

  const password = watch("password");

  return (
    <div className='register-page'>
      <div className="register-container">
        <div className="register-header">
          <h1 className="register-textmain">Corporate Debtor Registration</h1>
        </div>

        <form className="register-form" onSubmit={handleSubmit(onSubmit)}>
          {/* Name */}
          <div className="form-group">
            <input
              type="text"
              {...register("name", { required: "Company name is required" })}
              placeholder="Company Name"
              className="user-input"
            />
            {errors.name && <span className="error">{errors.name.message}</span>}
          </div>

          {/* Email */}
          <div className="form-group">
            <input
              type="email"
              {...register("email", {
                required: "Email is required",
                pattern: {
                  value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                  message: "Invalid email address"
                }
              })}
              placeholder="Email ID"
              className="user-input"
            />
            {errors.email && <span className="error">{errors.email.message}</span>}
          </div>

          {/* CIN Number */}
          <div className="form-group">
            <input
              type="text"
              {...register("cin", {
                required: "CIN is required",
                pattern: {
                  value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
                  message: "Invalid CIN format (e.g., U12345AB6789CDE12345)"
                }
              })}
              placeholder="CIN Number"
              className="user-input"
            />
            {errors.cin && <span className="error">{errors.cin.message}</span>}
          </div>

          {/* Process Type */}
          <div className="form-group">
            <select
              className="dropdown-select"
              {...register("processType", { required: "Process type is required" })}
            >
              <option value="">Select Process Type</option>
              {processTypesFromApi.map(opt => (
                <option key={opt.uuid} value={opt.processTypeValue}>{opt.processTypeName}</option>
              ))}
            </select>
            {errors.processType && <span className="error">{errors.processType.message}</span>}
          </div>

          {/* Password */}
          <div className="form-group">
            <input
              type="password"
              {...register("password", {
                required: "Password is required",
                minLength: {
                  value: 8,
                  message: "Password must be at least 8 characters"
                }
              })}
              placeholder="Password"
              className="user-input"
            />
            {errors.password && <span className="error">{errors.password.message}</span>}
          </div>

          {/* Confirm Password */}
          <div className="form-group">
            <input
              type="password"
              {...register("confirmPassword", {
                required: "Please confirm your password",
                validate: value =>
                  value === password || "Passwords do not match"
              })}
              placeholder="Confirm Password"
              className="user-input"
            />
            {errors.confirmPassword && <span className="error">{errors.confirmPassword.message}</span>}
          </div>

          {/* Register Button */}
          <button
            type="submit"
            className="register-btn"
            disabled={!isValid || loading}
          >
            {loading ? "Registering..." : "Register"}
          </button>
        </form>

        <div className="login-link">
          Already have an account? <Link to="/login">Login here</Link>
        </div>
      </div>
    </div>
  );
};

export default CorporateDebtorRegister;
