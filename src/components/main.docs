import React, { useCallback, useEffect, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import { FaSignature, FaUserTie, FaHome, FaUpload, FaCheckCircle } from "react-icons/fa";
import { MdDescription } from "react-icons/md";
import 'bootstrap/dist/css/bootstrap.min.css';
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepThird.css";

const StepThird = ({ provideSubmitHandler, formData, onValidationComplete }) => {
    const methods = useForm({
        mode: "onChange",
        reValidateMode: "onChange"
    });
    
    const { 
        register, 
        handleSubmit, 
        formState: { errors, isValid }, 
        trigger, 
        setValue, 
        control, 
        getValues,
        watch
    } = methods;

    const [hasSignature, setHasSignature] = useState(false);
    const watchAllFields = watch();
    const [isUploading, setIsUploading] = useState(false);
    const [uploadError, setUploadError] = useState(null);
    const [uploadSuccess, setUploadSuccess] = useState(false);
    const [isCRPUser, setIsCRPUser] = useState(false);

    // Check if user is CRP
    useEffect(() => {
        const storedData = localStorage.getItem('userFormData');
        if (storedData) {
            const parsedData = JSON.parse(storedData);
            setIsCRPUser(parsedData?.userType === "CRP");
        }
    }, []);

    const handleFileUpload = async (file) => {
        if (isCRPUser) return null; // Don't upload if user is CRP
        
        try {
            setIsUploading(true);
            setUploadError(null);
            setUploadSuccess(false);
            const result = await uploadDocument(file, 'identification');
            setUploadSuccess(true);
            return result;
        } catch (error) {
            setUploadError(error.message);
            throw error;
        } finally {
            setIsUploading(false);
        }
    };

    const creditorDetailsSchema = [
       { 
            name: "creditorName", 
            label: <>
                <FaUserTie className="field-icon" />
                Name of financial creditor (in BLOCK LETTERS) <span className="required-asterisk">*</span>
            </>, 
            type: "text", 
            rules: { 
                required: "Creditor name is required",
                pattern: {
                    value: /^[A-Z\s]+$/,
                    message: "Please enter in BLOCK LETTERS only"
                },
                minLength: {
                    value: 3,
                    message: "Name must be at least 3 characters"
                }
            },
            placeholder: "Enter name in BLOCK LETTERS",
            className: "mb-4 creditor-name-field",
            onChange: async (e) => {
                if (!isCRPUser) {
                    await trigger("creditorName");
                }
            },
            colSize: 6,
            disabled: isCRPUser
        },
        { 
            name: "creditorPosition", 
            label: <>
                <MdDescription className="field-icon" />
                Position with or in relation to creditor <span className="required-asterisk">*</span>
            </>, 
            type: "text", 
            rules: { 
                required: "Position is required",
                minLength: {
                    value: 3,
                    message: "Position must be at least 3 characters"
                }
            },
            placeholder: "Enter position/relation to creditor",
            className: "mb-4 creditor-position-field",
            onChange: async (e) => {
                if (!isCRPUser) {
                    await trigger("creditorPosition");
                }
            },
            colSize: 6,
            disabled: isCRPUser
        },
        { 
            name: "creditorSignatureText", 
            label: <>
                <FaSignature className="field-icon" />
                Signature of financial creditor <span className="required-asterisk">*</span>
            </>, 
            type: "text", 
            rules: { 
                required: "Signature is required",
                minLength: {
                    value: 3,
                    message: "Signature must be at least 3 characters"
                }
            },
            placeholder: "Enter signature text",
            className: "mb-4",
            onChange: async (e) => {
                if (!isCRPUser) {
                    await trigger("creditorSignatureText");
                }
            },
            colSize: 6,
            disabled: isCRPUser
        },
        { 
            name: "creditorAddress", 
            label: <>
                <FaHome className="field-icon" />
                Address of person signing <span className="required-asterisk">*</span>
            </>, 
            type: "textarea",
            rules: { 
                required: "Address is required",
                minLength: {
                    value: 10,
                    message: "Address must be at least 10 characters"
                }
            },
            placeholder: "Enter complete address",
            className: "mb-4",
            rows: 3,
            onChange: async (e) => {
                if (!isCRPUser) {
                    await trigger("creditorAddress");
                }
            },
            colSize: 12,
            disabled: isCRPUser
        },
        { 
            name: "hasSignature", 
            label: <>
                <FaUpload className="field-icon" />
                Do you have a signature to upload?
            </>, 
            type: "radio", 
            options: [
                { value: "yes", label: "Yes" },
                { value: "no", label: "No" }
            ],
            rules: { required: "Please select an option" },
            className: "mb-4",
            onChange: (e) => {
                if (!isCRPUser) {
                    setHasSignature(e.target.value === "yes");
                    setValue("signatureFile", null);
                    setUploadSuccess(false);
                }
            },
            colSize: 6,
            inline: true,
            disabled: isCRPUser
        },
        
        ...(hasSignature ? [{
            name: "signatureFile",
            label: <>
                <FaSignature className="field-icon" />
                Upload Signature <span className="required-asterisk">*</span>
            </>,
            type: "file",
            rules: { 
                required: "Signature file is required",
                validate: {
                    fileSize: (files) => {
                        if (files && files[0]) {
                            const fileSizeInMB = files[0].size / (1024 * 1024);
                            return fileSizeInMB <= 5 || "File size must be ≤ 5MB";
                        }
                        return true;
                    }
                }
            },
            accept: ".jpg,.jpeg,.png,.pdf",
            onFileUpload: handleFileUpload,
            isUploading,
            uploadError,
            uploadSuccess,
            note: "Max file size: 5MB (PDF, JPEG, PNG)",
            className: "mb-4 border p-3 rounded",
            colSize: 6,
            disabled: isCRPUser
        }] : [])
    ];

    const onSubmit = useCallback(async () => {
        const isValid = await trigger();
        
        if (!isValid) {
            const errorField = Object.keys(errors)[0];
            if (errorField) {
                document.querySelector(`[name="${errorField}"]`)?.scrollIntoView({ 
                    behavior: 'smooth', 
                    block: 'center' 
                });
            }
            return false;
        }
        
        return getValues();
    }, [trigger, getValues, errors]);

    useEffect(() => {
        if (formData) {
            Object.keys(formData).forEach((key) => {
                setValue(key, formData[key], { shouldValidate: true });
            });
            if (formData.hasSignature) {
                setHasSignature(formData.hasSignature === "yes");
            }
        }
    }, [formData, setValue]);

    useEffect(() => {
        if (provideSubmitHandler) {
            provideSubmitHandler(onSubmit);
        }
    }, [provideSubmitHandler, onSubmit]);

    // Make sure DynamicField component can handle disabled prop
    const enhancedCreditorDetailsSchema = creditorDetailsSchema.map(field => ({
        ...field,
        disabled: isCRPUser
    }));

    return (
       <FormProvider {...methods}>
                <form className="form-stepper">
                    <div className="form-section-container">
                        <Collapsible 
                            title={
                                <div className="section-header">
                                    <FaSignature className="section-icon" />
                                    <span>Signature of financial creditor or person authorised to act on its behalf</span>
                                </div>
                            } 
                            defaultOpen={true}
                        >
                            <div className="row g-3 align-items-start">
                                {enhancedCreditorDetailsSchema.map((fieldConfig) => (
                                    <div 
                                        key={fieldConfig.name} 
                                        className={`col-md-${fieldConfig.colSize || 12} ${fieldConfig.className}`}
                                    >
                                        <DynamicField
                                            fieldConfig={{
                                                ...fieldConfig,
                                                isUploading,
                                                uploadError,
                                                uploadSuccess,
                                                setIsUploading,
                                                setUploadError,
                                                setUploadSuccess,
                                                onFileUpload: handleFileUpload
                                            }}
                                            control={control}
                                            register={register}
                                            errors={errors}
                                            setValue={setValue}
                                            trigger={trigger}
                                            getValues={getValues}
                                        />
                                    </div>
                                ))}
                            </div>
                        </Collapsible>
                    </div>
                </form>
            </FormProvider>
    );
};

export default StepThird;
