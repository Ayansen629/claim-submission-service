const FileUploadCard = ({
  label,
  name,
  fileDownloadKey,
  onRemove,
  showRemove = false,
  fileIndex,
  displayIndex,
}) => {
  const fileData = watch(name);
  const fileStoreId = watch(fileDownloadKey);
  const hasFile = fileData && (fileData.name || fileData.size);

  const handleDeleteFile = async (name) => {
    const res = await deleteFile(fileStoreId, loaderRef);
    console.log(fileStoreId);
    if (res) {
      clearErrors(name);
      setValue(name, null);
      setValue(name.replace("_file_", "_fileStoreId_"), null);
    }
  }

  return (
    <Card className="mb-2 border-2 border-dashed border-primary border-opacity-25">
      <Card.Body className="p-2">
        <div className="mb-2">
          <div style={{ fontSize: "0.75rem", position: "relative" }}>
            <InputFile
              label={`${label} ${displayIndex}`}
              name={name}
              register={register(name)}
              errors={errors}
              onChange={(e) => {
                if (e?.target?.files && e?.target?.files[0]) {
                  const file = e.target.files[0];

                  if (file.size > 30 * 1024 * 1024) {
                    setError(name, {
                      type: "manual",
                      message: t(
                        "vesselDetails..File size should not exceed 30MB"
                      ),
                    });
                    return;
                  }

                  const extension = file?.name?.substring(
                    file?.name?.lastIndexOf(".")
                  );
                  const fileType = name.includes("WORK_ORDER")
                    ? "WORK_ORDER"
                    : "DRAWINGS";
                  const fileName = `${fileType}_${String(fileIndex).padStart(
                    2,
                    "0"
                  )}${extension}`;
                  file.originalName = fileName;
                  const renamedFile = renameFile(file, fileName);
                  uploadFile(file, name, renamedFile, fileType, fileIndex);
                }
              }}
              watch={watch}
              defaultValue={watch(name)}
              clearErrors={clearErrors}
              accept=".pdf,.jpg,.jpeg,.png"
              className="mobile-file-input"
              style={{ width: "100%" }}
            />

            {hasFile && !viewMode && (
              <FaTimesCircle
                className="text-danger position-absolute"
                style={{
                  top: "55%",
                  right: "1.5rem",
                  transform: "translateY(-50%)",
                  cursor: "pointer",
                  zIndex: 10,
                }}
                size={16}
                title="Remove file"
                onClick={() => handleDeleteFile(name)}
              />
            )}
          </div>
        </div>
        <div className="mb-2">
          <div style={{ fontSize: "0.75rem" }}>
            <InputText
              label={t("vesselDetails.Description")}
              name={name?.replace("_file_", "_desc_")}
              placeholder={t("vesselDetails.Enter file description")}
              register={register(name.replace("_file_", "_desc_"))}
              errors={errors}
              className="mobile-text-input"
            />
          </div>
        </div>
        <div className="text-end d-flex justify-content-end gap-1">
          {editMode && hasFile && (
            <Button
              variant="outline-primary"
              size="sm"
              onClick={() => handleDownload(fileStoreId, fileData.name)}
              className="rounded-pill"
              style={{ fontSize: "0.65rem", padding: "2px 6px" }}
            >
              <BsDownload className="me-1" size={8} />
              <span className="d-none d-sm-inline">Download</span>
              <span className="d-sm-none">↓</span>
            </Button>
          )}
          {showRemove && (
            <Button
              variant="outline-danger"
              size="sm"
              onClick={onRemove}
              className="rounded-pill"
              style={{ fontSize: "0.65rem", padding: "2px 6px" }}
            >
              <BsTrash className="me-1" size={8} />
              <span className="d-none d-sm-inline">Remove</span>
              <span className="d-sm-none">×</span>
            </Button>
          )}
        </div>
      </Card.Body>
    </Card>
  );
};
