// Format claim type for display
  const formatClaimType = (type) => {
    switch(type) {
      case "PRINCIPAL_BORROWER":
        return "Principal Borrower";
      case "GUARANTOR":
        return "Guarantor";
      case "BENEFICIARY":
        return "Beneficiary";
      default:
        return type || "N/A";
    }
  };
  
  const displayClaimType = formatClaimType(claimDetails.claimType);
