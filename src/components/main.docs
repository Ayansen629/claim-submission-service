const handleFileChange = async (e, documentType) => {
  if (isViewMode) return;
  const file = e?.target?.files[0];
  if (!file) return;

  const maxSize = 10 * 1024 * 1024;
  if (file.size > maxSize) {
    toast.error("File size must be less than or equal to 10 MB.");
    e.target.value = null;
    return;
  }

  loaderRef.current?.show();

  try {
    const formData = new FormData();
    formData.append("file", file);

    const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
    const response = await postFORMdata(uploadUrl, formData);

    const fileStoreId = response?.data?.files[0]?.fileStoreId;

    if (fileStoreId) {
      const getDisplayFileName = (docType, originalFileName) => {
        const fileExtension = originalFileName.split('.').pop();
        const fileNames = {
          "thirdPartyInsurance": "thirdpartyinsurance",
          "builderCertificate": "builderscertificate", 
          "instrumentOfSale": "instrumentofsale",
          "mortgageDetails": "mortgagedetails",
          "pniInsurance": "pniinsurance",
          "declarationOfOwnership": "declarationofownership",
          "challan": "challan"
        };
        return `${fileNames[docType]}.${fileExtension}`;
      };

      const displayName = getDisplayFileName(documentType, file.name);

      setFileStates(prev => ({
        ...prev,
        [documentType]: {
          name: displayName,
          fileStoreId,
          originalName: file.name
        }
      }));
      setValue(documentType, file);
      setValue(`${documentType}FileStoreId`, fileStoreId);
      toast.success("File uploaded successfully!");
    }
  } catch (err) {
    console.error("File upload failed:", err);
    toast.error("File upload failed. Please try again.");
    setFileStates(prev => ({ ...prev, [documentType]: null }));
    e.target.value = null;
  } finally {
    loaderRef.current?.hide();
  }
};
