                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="protectionAndIndemnityClubName"
                          label={t("Protection & Indemnity Club Name")}
                          placeholder={t("Enter PNI Club Name")}
                          required={true}
                          register={{
                            ...register("protectionAndIndemnityClubName", {
                              required: t("PNI Club Name is required"),
                            }),
