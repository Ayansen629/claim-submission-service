import React, { useRef } from 'react';
import { Form } from 'react-bootstrap';
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaCheckCircle, FaTimesCircle } from 'react-icons/fa';

const InputFile = ({
  label,
  required,
  name,
  register,
  errors,
  onChange,
  accept = '.pdf,.jpg,.jpeg,.png',
  disabled,
  className = '',
  watch
}) => {
  const fileInputRef = useRef(null);
  const hasError = errors && errors[name];
  const fileValue = watch ? watch(name) : null;

  let fileName = '';
  if (fileValue instanceof File) {
    fileName = fileValue.name;
  }

  const handleFileChange = (e) => {
    if (onChange) {
      onChange(e);
    }
  };

  const getFileIcon = () => {
    if (!fileName) return <FaFile />;
    const extension = fileName.split('.').pop().toLowerCase();
    if (extension === 'pdf') return <FaFilePdf />;
    if (['jpg', 'jpeg', 'png'].includes(extension)) return <FaFileImage />;
    return <FaFile />;
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      <div
        className={`file-upload-container border rounded p-3 ${hasError ? 'border-danger' : fileName ? 'border-success' : ''}`}
        style={{
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderColor: hasError ? '#dc3545' : fileName ? '#28a745' : '#ced4da'
        }}
      >
        <div className="d-flex align-items-center">
          <label
            htmlFor={name}
            className={`btn ${hasError ? 'btn-outline-danger' : 'btn-primary'} me-3`}
            style={{ minWidth: '120px' }}
          >
            <FaUpload className="me-2" /> Choose File
          </label>
          <div className="file-info flex-grow-1">
            {fileName ? (
              <div className="d-flex align-items-center">
                {hasError ? (
                  <FaTimesCircle className="text-danger me-2" />
                ) : (
                  <FaCheckCircle className="text-success me-2" />
                )}
                <div>
                  <small className="d-block text-muted">{hasError ? 'Error in file:' : 'Selected file:'}</small>
                  <div className="d-flex align-items-center">
                    <span className="me-2">{getFileIcon()}</span>
                    <span className="text-truncate" style={{ maxWidth: '200px' }}>
                      {fileName}
                    </span>
                  </div>
                </div>
              </div>
            ) : (
              <span className={hasError ? 'text-danger' : 'text-muted'}>
                {hasError ? 'Please select a file' : 'No file chosen'}
              </span>
            )}
          </div>
        </div>
        <input
          type="file"
          id={name}
          ref={(e) => {
            fileInputRef.current = e;
            if (register && register.ref) {
              register.ref(e);
            }
          }}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="d-none"
          {...register}
        />
      </div>
      {hasError && (
        <Form.Text className="text-danger">
          {errors[name]?.message}
        </Form.Text>
      )}
      <Form.Text className="text-muted">
        Accepted formats: PDF, JPG, PNG (Max 2MB)
      </Form.Text>
    </Form.Group>
  );
};

export default InputFile;
