// EmployeeRegistrationForm.tsx
import { useEffect } from "react";
import { useFieldArray, useFormContext } from "react-hook-form";
import { Card, Row, Col, Button } from "react-bootstrap";
import InputSelect from "../../../common/InputSelect.tsx";
import InputText from "../../../common/InputText.tsx";
import Collapsible from "../../../common/Collapsible.tsx";

const EmployeeRegistrationForm = () => {
  const { control, register, setValue, watch, formState: { errors } } = useFormContext();
  const { fields, append, remove } = useFieldArray({
    control,
    name: "educationDetails"
  });

  const watchPin = watch("address.pin");
  
  // Mock API call for address auto-population
  useEffect(() => {
    const fetchAddressDetails = async (pin: string) => {
      if (pin?.length === 6) {
        // Simulate API call delay
        setTimeout(() => {
          setValue("address.district", "Sample District");
          setValue("address.state", "Sample State");
          setValue("address.country", "Sample Country");
        }, 500);
      }
    };

    fetchAddressDetails(watchPin);
  }, [watchPin, setValue]);

  return (
    <div className="employee-registration-form">
      {/* Personal Details Section */}
      <Collapsible title="Personal Details" defaultOpen={true}>
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={4}>
                <InputText
                  name="personal.firstName"
                  label="First Name"
                  register={register}
                  errors={errors}
                  validation={{ required: "First Name is required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.lastName"
                  label="Last Name"
                  register={register}
                  errors={errors}
                  validation={{ required: "Last Name is required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.email"
                  label="Email ID"
                  type="email"
                  register={register}
                  errors={errors}
                  validation={{
                    required: "Email is required",
                    pattern: {
                      value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                      message: "Invalid email address"
                    }
                  }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.phoneNumber"
                  label="Phone Number"
                  register={register}
                  errors={errors}
                  validation={{
                    required: "Phone Number is required",
                    pattern: {
                      value: /^\d{10}$/,
                      message: "Invalid phone number"
                    }
                  }}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="personal.gender"
                  label="Gender"
                  options={[
                    { value: "male", label: "Male" },
                    { value: "female", label: "Female" },
                    { value: "other", label: "Other" }
                  ]}
                  register={register}
                  errors={errors}
                  validation={{ required: "Gender is required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.dob"
                  label="Date of Birth"
                  type="date"
                  register={register}
                  errors={errors}
                  validation={{ required: "Date of Birth is required" }}
                />
              </Col>
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Address Details Section */}
      <Collapsible title="Address Details">
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={12}>
                <InputText
                  name="address.line1"
                  label="Address Line 1"
                  register={register}
                  errors={errors}
                  validation={{ required: "Address Line 1 is required" }}
                />
              </Col>
              <Col md={12}>
                <InputText
                  name="address.line2"
                  label="Address Line 2"
                  register={register}
                  errors={errors}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="address.pin"
                  label="PIN Code"
                  register={register}
                  errors={errors}
                  validation={{
                    required: "PIN Code is required",
                    pattern: {
                      value: /^\d{6}$/,
                      message: "Invalid PIN code"
                    }
                  }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="address.district"
                  label="District"
                  register={register}
                  errors={errors}
                  readOnly
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="address.state"
                  label="State/UT"
                  register={register}
                  errors={errors}
                  readOnly
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="address.country"
                  label="Country"
                  register={register}
                  errors={errors}
                  readOnly
                />
              </Col>
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Education Details Section */}
      <Collapsible title="Education Details">
        <Card className="form-section-card">
          <Card.Body>
            {fields.map((field, index) => (
              <div key={field.id} className="education-entry mb-4">
                <Row className="g-3">
                  <Col md={4}>
                    <InputText
                      name={`educationDetails.${index}.qualification`}
                      label="Qualification"
                      register={register}
                      errors={errors}
                      validation={{ required: "Qualification is required" }}
                    />
                  </Col>
                  <Col md={4}>
                    <InputText
                      name={`educationDetails.${index}.stream`}
                      label="Stream"
                      register={register}
                      errors={errors}
                    />
                  </Col>
                  <Col md={3}>
                    <InputText
                      name={`educationDetails.${index}.yearOfPassing`}
                      label="Year of Passing"
                      type="number"
                      register={register}
                      errors={errors}
                      validation={{
                        required: "Year of Passing is required",
                        min: { value: 1900, message: "Invalid year" },
                        max: { value: new Date().getFullYear(), message: "Invalid year" }
                      }}
                    />
                  </Col>
                  <Col md={1} className="d-flex align-items-end">
                    {index > 0 && (
                      <Button
                        variant="danger"
                        onClick={() => remove(index)}
                        className="mt-1"
                      >
                        ×
                      </Button>
                    )}
                  </Col>
                </Row>
              </div>
            ))}
            <Button
              variant="primary"
              onClick={() => append({ qualification: "", stream: "", yearOfPassing: "" })}
            >
              Add Education Details
            </Button>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Professional Details Section */}
      <Collapsible title="Professional Details">
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={4}>
                <InputText
                  name="professional.appointmentDate"
                  label="Appointment Date"
                  type="date"
                  register={register}
                  errors={errors}
                  validation={{ required: "Appointment Date is required" }}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.employeeType"
                  label="Employee Type"
                  options={[
                    { value: "full-time", label: "Full Time" },
                    { value: "part-time", label: "Part Time" },
                    { value: "contract", label: "Contract" }
                  ]}
                  register={register}
                  errors={errors}
                  validation={{ required: "Employee Type is required" }}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.employeeStatus"
                  label="Employee Status"
                  options={[
                    { value: "active", label: "Active" },
                    { value: "on-leave", label: "On Leave" },
                    { value: "terminated", label: "Terminated" }
                  ]}
                  register={register}
                  errors={errors}
                  validation={{ required: "Employee Status is required" }}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.designation"
                  label="Designation"
                  options={[
                    { value: "manager", label: "Manager" },
                    { value: "developer", label: "Developer" },
                    { value: "designer", label: "Designer" }
                  ]}
                  register={register}
                  errors={errors}
                  validation={{ required: "Designation is required" }}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.department"
                  label="Department"
                  options={[
                    { value: "it", label: "IT" },
                    { value: "hr", label: "HR" },
                    { value: "finance", label: "Finance" }
                  ]}
                  register={register}
                  errors={errors}
                  validation={{ required: "Department is required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="professional.section"
                  label="Section"
                  register={register}
                  errors={errors}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.roles"
                  label="Roles"
                  options={[
                    { value: "admin", label: "Admin" },
                    { value: "user", label: "User" },
                    { value: "manager", label: "Manager" }
                  ]}
                  register={register}
                  errors={errors}
                  isMulti
                  validation={{ required: "At least one role is required" }}
                />
              </Col>
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Documents Upload Section */}
      <Collapsible title="Documents Upload">
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={4}>
                <InputText
                  name="documents.addressProof"
                  label="Address Proof"
                  type="file"
                  register={register}
                  errors={errors}
                  validation={{ required: "Address Proof is required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="documents.identityProof"
                  label="Identity Proof"
                  type="file"
                  register={register}
                  errors={errors}
                  validation={{ required: "Identity Proof is required" }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="documents.appointmentLetter"
                  label="Appointment Letter"
                  type="file"
                  register={register}
                  errors={errors}
                  validation={{ required: "Appointment Letter is required" }}
                />
              </Col>
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>
    </div>
  );
};

export default EmployeeRegistrationForm;
////////////
// Updated UserManagement component modal section
import { FormProvider, useForm } from "react-hook-form";

const UserManagement = () => {
  // ... existing code ...
  
  const methods = useForm({
    defaultValues: {
      personal: {
        firstName: "",
        lastName: "",
        email: "",
        phoneNumber: "",
        gender: "",
        dob: ""
      },
      address: {
        line1: "",
        line2: "",
        pin: "",
        district: "",
        state: "",
        country: ""
      },
      educationDetails: [{
        qualification: "",
        stream: "",
        yearOfPassing: ""
      }],
      professional: {
        appointmentDate: "",
        employeeType: "",
        employeeStatus: "",
        designation: "",
        department: "",
        section: "",
        roles: ""
      },
      documents: {
        addressProof: null,
        identityProof: null,
        appointmentLetter: null
      }
    }
  });

  const handleFormSubmit = async (data: any) => {
    try {
      const formData = new FormData();
      
      // Append all form data
      Object.entries(data).forEach(([key, value]) => {
        if (key === "documents") {
          Object.entries(value as object).forEach(([docKey, docValue]) => {
            if (docValue) formData.append(docKey, docValue[0]);
          });
        } else {
          formData.append(key, JSON.stringify(value));
        }
      });

      // Submit formData to your API
      await postData("your-api-endpoint", formData);
      toast.success("Employee registered successfully!");
      Toggle();
    } catch (error) {
      toast.error("Error submitting form");
    }
  };

  return (
    <>
      {/* ... existing code ... */}
      
      <ActionModal
        show={modal}
        close={Toggle}
        handleModalSubmit={methods.handleSubmit(handleFormSubmit)}
        title={modalTitle}
        action={modalAction}
        size={"xl"}
      >
        <FormProvider {...methods}>
          <form onSubmit={methods.handleSubmit(handleFormSubmit)}>
            <EmployeeRegistrationForm />
            <div className="text-center mt-4">
              <Button variant="primary" type="submit">
                Submit
              </Button>
            </div>
          </form>
        </FormProvider>
      </ActionModal>
    </>
  );
};
