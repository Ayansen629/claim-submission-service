// ... (keep all existing imports and code)

const VesselInfo = ({ handleViewAction = (rowData) => { }, externalVesselData = null, useApiData = false }) => {
    // ... (keep all existing state and variables)

    // Use external data if provided, otherwise generate mock data (only if not using API)
    useEffect(() => {
        if (useApiData) {
            // For API components, only use external data (empty array if API fails)
            setVesselData(externalVesselData || []);
            setFilteredVesselData(externalVesselData || []);
        } else {
            // For other components, use mock data
            const data = generateVesselData(15);
            setVesselData(data);
            setFilteredVesselData(data);
        }
    }, [externalVesselData, useApiData]);

    // ... (keep all other existing code unchanged)
};

export default VesselInfo;
