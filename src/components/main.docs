import React, { useState, useEffect, useRef } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Form, Button, Card, Image, Alert } from 'react-bootstrap';
import {
  FaUser, FaBuilding, FaFileUpload, FaCheck, FaArrowRight,
  FaArrowLeft, FaIdCard, FaEnvelope, FaPhone, FaMapMarkerAlt, FaUpload, FaShip
} from 'react-icons/fa';
import './UserRegistration.css';
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";
import { toast } from "react-toastify";
import { getData, postData, postFORMdata } from "../../../services/http.service.ts";
import { URLS_ENDPOINT } from '../../../utils/urlsConstants.ts';
import { handleErrorMessage } from '../../../utils/errorMessageHandler.js';
import { mapToVesselUserDetails } from '../model/mapToVesselModel.ts';
import NewLoader from '../../common/NewLoader.js';
import InputText from '../../common/InputText.tsx';
import InputFile from '../../common/InputFile.tsx';
import InputSelect from '../../common/InputSelect.tsx';
import { MasterDataProvider, useMasterData } from '../../context/MasterDataContext.js';

const VesselOwnerRegistrationPage = () => {
  const { masterData } = useMasterData();
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [successMessage, setSuccessMessage] = useState("");
  const [validationMessage, setValidationMessage] = useState("");
  
  const loaderRef = useRef();
  const PUBLIC_URL = process.env.REACT_APP_PUBLIC_URL;
  
  const methods = useForm({
    mode: 'onBlur',
    defaultValues: { 
      ownerCategory: '', 
      country: 'India',
      // Add other default values as needed
    }
  });

  const { register, handleSubmit, formState: { errors }, trigger, setValue, getValues, watch, clearErrors, setError, reset } = methods;
  const totalSteps = 3;
  const ownerCategory = watch('ownerCategory');

  useEffect(() => {
    // When step changes, update form values from saved formData
    Object.keys(formData).forEach(key => {
      if (formData[key] !== undefined) {
        setValue(key, formData[key], { shouldValidate: false });
      }
    });
  }, [currentStep, formData, setValue]);

  // ... rest of your formFields definition remains the same ...

  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const fieldValue = watch(field.name); // Get current value

    const handleChange = (e) => {
      const fieldName = field?.name;
      const value = e?.target?.value || "";

      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'select':
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register}
            errors={errors}
            icon={field.icon}
            className="mb-4"
            onChange={(selectedValue) => {
              setValue(field.name, selectedValue, { shouldValidate: true });
            }}
            value={fieldValue} // Pass current value
            autoFocus={field.autoFocus}
          />
        );

      case 'file':
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e.target.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
                const customFileName = `${field.label}${extension}`;
                file.originalName = customFileName;
                setValue(field.name, file);

                setFormData(prev => {
                  const updated = { ...prev, [field.name]: file };
                  return updated;
                });

                if (errors[field.name]) {
                  clearErrors(field.name);
                }

                const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'Only PDF, JPG or PNG files are allowed'
                  });
                }

                if (file.size > 2 * 1024 * 1024) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'File size should not exceed 2MB'
                  });
                }
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={formData[field.name]}
            autoFocus={field.autoFocus}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...field.validation,
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className="mb-4"
            style={{
              borderColor: errors[field.name] ? '#dc3545' : '#ced4da',
              backgroundColor: errors[field.name] ? '#fff8f8' : 'white'
            }}
            autoFocus={field.autoFocus}
          />
        );
    }
  };

  // ... rest of your component code remains the same ...

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="registration-container py-5">
        {/* ... rest of your JSX remains the same ... */}
      </Container>
    </>
  );
};

export default VesselOwnerRegistrationPage;
//////////////
import React from "react";
import Select from "react-select";
import { Form } from "react-bootstrap";
import "./InputSelect.css";

interface InputSelectProps {
  label: string;
  required?: boolean;
  name: string;
  options: Array<{ value: string | number; label: string }>;
  register?: any;
  errors?: any;
  disabled?: boolean;
  onChange?: (value: string | number) => void;
  className?: string;
  style?: React.CSSProperties;
  icon?: React.ElementType;
  value?: any;
  isMulti?: boolean;
  isClearable?: boolean;
}

const InputSelect: React.FC<InputSelectProps> = ({
  label,
  required,
  name,
  options,
  register,
  errors,
  disabled,
  onChange,
  className = "",
  style = {},
  icon: IconComponent,
  value,
  isMulti = false,
  isClearable = false,
}) => {
  const hasError = errors && errors[name];
  const selectedOption = options.find(opt => opt.value === value);

  const handleChange = (selected: any) => {
    onChange?.(selected?.value || "");
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold d-block">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>

      <div className="position-relative">
        {IconComponent && (
          <div
            className={`input-icon position-absolute ${
              hasError ? "text-danger" : "text-primary"
            }`}
            style={{
              left: "10px",
              top: "50%",
              transform: "translateY(-50%)",
              zIndex: 2,
            }}
          >
            <IconComponent size={18} />
          </div>
        )}

        <Select
          options={options}
          value={selectedOption}
          onChange={handleChange}
          isDisabled={disabled}
          isMulti={isMulti}
          isClearable={isClearable}
          className={`react-select-container ${hasError ? "is-invalid" : ""}`}
          classNamePrefix="react-select"
          styles={{
            control: (base, state) => ({
              ...base,
              borderColor: hasError ? "#dc3545" : state.isFocused ? "#80bdff" : "#ced4da",
              boxShadow: state.isFocused && !hasError ? "0 0 0 0.2rem rgba(0, 123, 255, 0.25)" : "none",
              paddingLeft: IconComponent ? "40px" : "12px",
              backgroundColor: hasError ? "#fff8f8" : "white",
              minHeight: "calc(1.5em + 1rem + 2px)",
              "&:hover": {
                borderColor: hasError ? "#dc3545" : "#ced4da"
              }
            }),
            menu: (base) => ({
              ...base,
              zIndex: 9999
            })
          }}
        />
      </div>

      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;
