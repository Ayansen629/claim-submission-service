import React, { useEffect, useState } from "react";
import { Card, Button, Form, InputGroup } from "react-bootstrap";
import { BsSearch, BsFilter } from "react-icons/bs";
import ActionTable from "../../common/ActionTable.tsx";
import { useNavigate } from "react-router-dom";
import { toast } from "react-toastify";
import { APP_MESSAGES } from "../../../utils/constants.ts";

const EmployeeInbox = ({
  title = "Inbox",
  userRole,
  rowData = [],
  itemsPerPage = 5,
  inboxColumns = [],
  onViewRow,
}) => {
  const [searchTerm, setSearchTerm] = useState("");
  const [filteredData, setFilteredData] = useState(rowData);
  const [currentPage, setCurrentPage] = useState(1);
  const navigate = useNavigate();

  useEffect(() => {
    if (!searchTerm) {
      setFilteredData(rowData);
      return;
    }

    const lowerSearch = searchTerm.toLowerCase();
    const results = rowData?.filter((item) =>
      [
        item?.applicationNumber,
        item?.applicationType,
        item?.vesselName,
        item?.vesselOwnerName,
        item?.vesselRegistrationNumber,
        item?.applicationAppliedDate,
        item?.status,
        item?.assignedTo,
        item?.pendingWith,
      ]
        .filter(Boolean)
        .some((field) => field?.toLowerCase()?.includes(lowerSearch))
    );

    setFilteredData(results);
    setCurrentPage(1);
  }, [searchTerm, rowData]);

  const handleViewAction = (rowData) => {
    if (!rowData || !rowData?.applicationNumber) {
      toast.info("Application no. missing. Please contact Admin");
      return;
    }

    const { applicationNumber, applicationType } = rowData;

    const routeMap = {
      NEW_VESSEL_REGISTRATION: "/officer/vessel-registration/view",
      TRANSFER_OF_REGISTRY: "/officer/transfer-of-registry-application/view",
      NAME_CHANGE_OF_VESSEL: "/officer/name-change-of-vessel/view",
    };
    const basePath = routeMap["NEW_VESSEL_REGISTRATION"]; // will change

    if (!basePath) {
      toast.error(APP_MESSAGES.CMN_ERR);
      console.warn("Unknown applicationType:", applicationType);
      return;
    }
    navigate(`${basePath}?applicationNo=${applicationNumber}`, {
      state: { rowData: { ...rowData } },
    });
  };

  return (
    <Card className="bg-transparent mt-4 dashboard-card">
      <Card.Header className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap">
        <div className="d-flex align-items-center">
          <h5 className="mb-0 me-2">{title}</h5>
          <span className="badge bg-primary rounded-pill">
            {filteredData?.length}
          </span>
        </div>
        <div className="d-flex align-items-center">
          {/* <Button variant="outline-secondary" className="filter-btn me-2">
            <BsFilter size={18} />
            <span className="ms-1 d-none d-sm-inline">Filter</span>
          </Button> */}
          <Form className="inbox-search">
            <InputGroup>
              <Form.Control
                type="text"
                placeholder="Search inbox..."
                aria-label="Search inbox"
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
              />
              <Button variant="primary">
                <BsSearch />
              </Button>
            </InputGroup>
          </Form>
        </div>
      </Card.Header>

      <div style={{ position: "relative", bottom: "2rem" }}>
        <ActionTable
          columns={inboxColumns}
          onViewRow={userRole !== "ADMIN" ? handleViewAction : undefined}
          rowData={filteredData}
          tableHeader={null}
          hideExportBtn={true}
          hideSearchBar={true}
          pagination={true}
          currentPage={currentPage}
          itemsPerPage={itemsPerPage}
          onPageChange={(page) => setCurrentPage(page)}
          noDataText={
            <div className="no-results text-center py-4">
              <BsSearch size={24} className="mb-2" />
              <p>No results found</p>
              <small>
                Try adjusting your search to find what you're looking for.
              </small>
            </div>
          }
        />
      </div>
    </Card>
  );
};

export default EmployeeInbox;
