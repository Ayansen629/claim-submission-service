.required {
  font-weight: 600;
}

.asterisk {
  color: #dc3545;
  margin-left: 2px;
}

.errorField {
  border: 2px solid #dc3545 !important;
  background-color: #fff5f5;
}

.errorMessage {
  color: #dc3545;
  font-size: 0.75rem;
  margin-top: 4px;
  font-weight: 500;
}

.plyingLimitsRow {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
  flex-wrap: wrap;
}

.fieldGroup {
  margin-bottom: 1rem;
}

.editableInput, .editableSelect, .inlineInput, .tableInput, .dateInput {
  border: 1px solid #ced4da;
  border-radius: 4px;
  padding: 6px 12px;
  font-size: 0.875rem;
  transition: border-color 0.15s ease-in-out;
}

.editableInput:focus, .editableSelect:focus, .inlineInput:focus, .tableInput:focus, .dateInput:focus {
  outline: none;
  border-color: #2E57A7;
  box-shadow: 0 0 0 0.2rem rgba(46, 87, 167, 0.25);
}
