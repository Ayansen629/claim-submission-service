import "./EmployeeRegistration.css";
import { getData, postFORMdata } from "../../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import AppToggleButton from "../../../common/AppToggleButton.js";

// Static data for edit mode
