
import React, { useState, useEffect, useRef } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFilePdf, FaFileImage, FaCheckCircle } from "react-icons/fa";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
  defaultValue?: string | File;
  autoFocus?: boolean;
  clearErrors?: (fieldName: string) => void;
  setValue?: (name: string, value: any, options?: Object) => void;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  watch,
  clearErrors,
  setValue,
}) => {
  const { t } = useTranslation();
  const fileInputRef = useRef<HTMLInputElement>(null);
  const currentFile = watch ? watch(name) : null;
  const hasError = errors && errors[name];
  const [isTouched, setIsTouched] = useState(false);

  // Clear error when file is selected
  useEffect(() => {
    if (currentFile && isTouched && clearErrors) {
      clearErrors(name);
    }
  }, [currentFile, isTouched, name, clearErrors]);

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    setIsTouched(true);
    if (e.target.files && e.target.files[0]) {
      const file = e.target.files[0];
      if (setValue) {
        setValue(name, file, { shouldValidate: true });
      }
      if (onChange) {
        onChange(e);
      }
      if (clearErrors) {
        clearErrors(name);
      }
    } else if (setValue) {
      setValue(name, null, { shouldValidate: true });
    }
  };

  const handleLabelClick = () => {
    if (fileInputRef.current && !disabled) {
      fileInputRef.current.click();
    }
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      <div
        className={`file-upload border rounded p-3 ${
          hasError ? 'border-danger' : 
          currentFile ? 'border-success' : 'border-secondary'
        }`}
        style={{
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderRadius: '8px',
          transition: 'all 0.3s ease'
        }}
      >
        <div className="d-flex align-items-center">
          <div
            onClick={handleLabelClick}
            className={`file-label btn ${
              hasError ? 'btn-outline-danger' : 'btn-primary'
            } mb-0 d-inline-flex align-items-center`}
            style={{
              borderRadius: '6px',
              padding: '8px 16px',
              cursor: disabled ? 'not-allowed' : 'pointer',
              opacity: disabled ? 0.6 : 1,
              minWidth: '120px',
              color: 'white'
            }}
          >
            <FaUpload className="file-icon me-2" />
            <span className="file-text">{t("Choose File")}</span>
          </div>
          <div
            className={`file-name-container ms-3 flex-grow-1 border rounded px-3 py-2 ${
              currentFile ? 'bg-light-success' : 'bg-light'
            } d-flex align-items-center ${
              hasError ? 'border-danger' : 
              currentFile ? 'border-success' : 'border-secondary'
            }`}
            style={{ overflow: 'hidden' }}
          >
            {currentFile ? (
              <>
                <FaCheckCircle className="text-success me-2 flex-shrink-0" />
                <div className="overflow-hidden">
                  <span className="text-success fw-bold" style={{ fontSize: '0.8rem' }}>
                    {t("Selected File")}:
                  </span>
                  <div className="d-flex align-items-center">
                    <span className="file-icon-preview me-2 flex-shrink-0">
                      {currentFile.name?.endsWith('.pdf') ? (
                        <FaFilePdf color="#dc3545" />
                      ) : (
                        <FaFileImage color="#28a745" />
                      )}
                    </span>
                    <span 
                      className="text-dark fw-semibold" 
                      style={{ 
                        overflow: 'hidden', 
                        textOverflow: 'ellipsis', 
                        whiteSpace: 'nowrap' 
                      }}
                    >
                      {currentFile.name}
                    </span>
                  </div>
                </div>
              </>
            ) : (
              <span className="text-muted">{t("No file chosen")}</span>
            )}
          </div>
        </div>
        <input
          ref={fileInputRef}
          type="file"
          id={name}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="d-none"
        />
      </div>
      {hasError ? (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      ) : (
        <Form.Text className="text-muted small mt-1">
          {t("Upload PDF, JPG or PNG file (Max size: 2MB)")}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
