// Replace the date sorting logic in your useEffect with this:
if (dateSort !== "none") {
  filteredData.sort((a, b) => {
    // Function to parse date from multiple possible fields
    const parseDate = (obj) => {
      const dateFormats = [
        'dd-MM-yy', 'dd/MM/yy', 'dd.MM.yy', 
        'yyyy-MM-dd', 'yyyy/MM/dd', 'yyyy.MM.dd'
      ];
      
      const dateFields = ['dateSubmitted', 'createdAt', 'date', 'submissionDate'];
      
      for (const field of dateFields) {
        if (obj[field]) {
          // Try parsing with different formats
          for (const format of dateFormats) {
            const parsedDate = parseDateFromFormat(obj[field], format);
            if (parsedDate && !isNaN(parsedDate.getTime())) {
              return parsedDate;
            }
          }
          
          // Fallback to native Date parsing
          const date = new Date(obj[field]);
          if (!isNaN(date.getTime())) {
            return date;
          }
        }
      }
      
      // If no valid date found, return a very old date (will sort to bottom)
      return new Date(0);
    };

    const dateA = parseDate(a);
    const dateB = parseDate(b);

    // For newest first (descending)
    if (dateSort === "desc") {
      return dateB - dateA; // Newest dates first
    } 
    // For oldest first (ascending)
    else {
      return dateA - dateB; // Oldest dates first
    }
  });
}

// Helper function to parse date from specific format
function parseDateFromFormat(dateString, format) {
  if (!dateString) return null;
  
  // Handle dd-MM-yy format
  if (format === 'dd-MM-yy') {
    const parts = dateString.split('-');
    if (parts.length === 3) {
      const day = parseInt(parts[0], 10);
      const month = parseInt(parts[1], 10) - 1;
      const year = 2000 + parseInt(parts[2], 10);
      return new Date(year, month, day);
    }
  }
  
  // Handle other formats similarly...
  
  // Fallback to native parsing
  return new Date(dateString);
}

///////////////////
// In your useEffect where filtering happens:
if (dateSort !== "none") {
  filteredData.sort((a, b) => {
    // Enhanced date parser that handles multiple formats
    const parseDateObject = (obj) => {
      const dateFields = ['dateSubmitted', 'createdAt', 'date', 'submissionDate'];
      
      for (const field of dateFields) {
        if (obj[field]) {
          const dateValue = obj[field];
          
          // Try parsing as ISO string first
          const isoDate = new Date(dateValue);
          if (!isNaN(isoDate.getTime())) return isoDate;
          
          // Try parsing common string formats
          const formats = [
            { regex: /^(\d{2})-(\d{2})-(\d{2})$/, handler: (d, m, y) => new Date(2000 + +y, m - 1, d) }, // dd-mm-yy
            { regex: /^(\d{2})\/(\d{2})\/(\d{2})$/, handler: (d, m, y) => new Date(2000 + +y, m - 1, d) }, // dd/mm/yy
            { regex: /^(\d{4})-(\d{2})-(\d{2})$/, handler: (y, m, d) => new Date(y, m - 1, d) }, // yyyy-mm-dd
            { regex: /^(\d{4})\/(\d{2})\/(\d{2})$/, handler: (y, m, d) => new Date(y, m - 1, d) }  // yyyy/mm/dd
          ];
          
          for (const format of formats) {
            const match = dateValue.match(format.regex);
            if (match) {
              const date = format.handler(...match.slice(1));
              if (!isNaN(date.getTime())) return date;
            }
          }
        }
      }
      
      return new Date(0); // Default for invalid/missing dates
    };

    const dateA = parseDateObject(a);
    const dateB = parseDateObject(b);

    // Newest first (descending) - show recent dates first
    if (dateSort === "desc") {
      return dateB.getTime() - dateA.getTime();
    } 
    // Oldest first (ascending) - show dates in chronological order
    else {
      return dateA.getTime() - dateB.getTime();
    }
  });
}
