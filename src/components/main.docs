/* Navigation container for desktop */
.navContainer {
  position: relative;
  display: inline-block;
}

/* Underline that only spans the navigation items */
.navUnderline {
  width: 100%;
  max-width: fit-content;
  margin: 0 auto;
}

/* Desktop logo positioning */
.desktopLogo {
  width: 4.25rem;
  height: 5rem;
  position: absolute;
  top: -17px;
  right: 0;
}

/* Mobile responsive styles */
@media (max-width: 768px) {
  .heroSection {
    height: auto;
    min-height: 70vh;
    padding: 1rem 0;
  }
  
  .brandName {
    font-size: 18px;
    line-height: 24px;
  }
  
  .navLinkItems {
    font-size: 14px;
    padding: 0.25rem 0.5rem !important;
  }
  
  .homeLoginBtn {
    position: static !important;
    margin: 1rem auto 0 !important;
    display: block !important;
    width: fit-content !important;
  }
  
  /* Full width underline on mobile */
  .navUnderline {
    width: 100% !important;
    max-width: 100% !important;
  }
}

@media (max-width: 576px) {
  .heroSection {
    min-height: 80vh;
  }
  
  .brandName {
    font-size: 16px;
    line-height: 20px;
  }
  
  .navLinkItems {
    font-size: 12px;
    padding: 0.2rem 0.4rem !important;
  }
}
