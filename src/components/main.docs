import React, { useState, useEffect } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams, useLocation,useNavigate } from "react-router-dom";
import Stepper from "../../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import Documents from "./Documents.js";
import { useForm } from "react-hook-form";
import Invoicing from "../../../common/Invoicing.js";
import PaymentModal from "../../../common/PaymentModal.js"; 
// import ActionDropdown from "../../../common/ActionDropdown";
// import ApprovalModal from "../../../common/ApprovalModal";
import NewVesselRegistrationSuccess from "./newVesselRegistrationSuccess.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";

const NewVesselRegistration = () => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const { id } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  
  const isEditMode = !!id && location.pathname.includes('/edit/');
  const isViewMode = !!id && location.pathname.includes('/view/');
  const isNormalMode = !isEditMode && !isViewMode;
  
  const methods = useForm({ mode: "onTouched" });
  const { trigger, getValues, setError, setValue, reset } = methods;

  const [showModal, setShowModal] = useState(false);
  const [paymentMode, setPaymentMode] = useState("offline");
  const [challanFile, setChallanFile] = useState(null);
  const [isLoading, setIsLoading] = useState(false);
  // const [showApprovalModal, setShowApprovalModal] = useState(false);
  // const [selectedAction, setSelectedAction] = useState("");

  // const actionsFromAPI = ["Approve", "Reject", "Request Changes"];

  const staticData = {
    ownerName: "John Doe",
    ownerAddress: "123 Main Street, Harbor City, State 12345",
    mobile: "9876543210",
    email: "john.doe@example.com",
    pan: "ABCDE1234F",
    aadhar: "123456789012",
    tradeLicence: "TL123456789",
    gst: "GST123456789012",
    grt: "500",
    workOrderValue: "1000000",
    vesselType: "new",
    category: "A",
    zone: "1",
    supervisionAuthority: "classificationSociety",
    purchaseType: "new",
    classificationSociety: "Lloyd's Register Classification Society",
    constructedBy: "2",
    builder: "builder1",
    builderName: "ABC Marine Shipyard Pvt Ltd",
    builderAddress: "456 Port Road, Shipyard Complex, Harbor City 54321",
    builderEmail: "contact@abcshipyard.com",
    builderMobile: "9876543211",
    builderTradeLicence: "BTL789012345",
    builderGST: "BGST987654321098",
    builderAuth: "auth",
    termsAccepted: true,
    
    // Work Order Files (50 files)
    ...Array.from({ length: 50 }, (_, i) => ({
      [`workOrder_file_${i + 1}`]: { 
        name: `Work_Order_Document_${String(i + 1).padStart(2, '0')}.pdf`, 
        size: Math.floor(Math.random() * 2000000) + 500000 
      },
      [`workOrder_desc_${i + 1}`]: `Work order document ${i + 1} - ${[
        'Main contract document',
        'Amendment and modifications',
        'Technical specifications',
        'Timeline and milestones',
        'Budget breakdown',
        'Quality requirements',
        'Safety protocols',
        'Environmental compliance',
        'Material specifications',
        'Equipment details'
      ][i % 10]}`
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    
    // Drawing Files (50 files)
    ...Array.from({ length: 50 }, (_, i) => ({
      [`drawings_file_${i + 1}`]: { 
        name: `Technical_Drawing_${String(i + 1).padStart(2, '0')}.pdf`, 
        size: Math.floor(Math.random() * 3000000) + 800000 
      },
      [`drawings_desc_${i + 1}`]: `Technical drawing ${i + 1} - ${[
        'General arrangement plan',
        'Hull structure details',
        'Machinery layout',
        'Electrical schematic',
        'Piping diagram',
        'Safety equipment layout',
        'Navigation equipment',
        'Interior arrangement',
        'Deck plan',
        'Cross-section view'
      ][i % 10]}`
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    
    tonnageBooklets: { name: "Tonnage_Booklets.pdf", size: 512000 },
    stabilityBooklets: { name: "Stability_Booklets.pdf", size: 768000 },
    authLetter: { name: "Authorization_Letter.pdf", size: 256000 }
  };

  useEffect(() => {
    if (isNormalMode) {
      reset();
    } else if (isEditMode || isViewMode) {
      setTimeout(() => {
        Object.keys(staticData).forEach(key => {
          setValue(key, staticData[key]);
        });
      }, 100);
    }
  }, [isEditMode, isViewMode, isNormalMode, setValue, reset, location.pathname]);

  const validateVesselDetails = async () => {
    if (isViewMode) return true;
    const basicFields = [
      "ownerName", "ownerAddress", "mobile", "email", "pan", 
      "aadhar", "tradeLicence", "gst", "grt", "workOrderValue",
      "vesselType", "category", "purchaseType", "constructedBy"
    ];
    
    const constructedBy = getValues("constructedBy");
    if (constructedBy === "2") {
      basicFields.push(
        "builderName", "builderAddress", "builderEmail", 
        "builderMobile", "builderTradeLicence", "builderGST", 
        "builderAuth", "authLetter"
      );
    }
    
    const valid = await trigger(basicFields);
    return valid;
  };

  const validateDocuments = async () => {
    if (isViewMode) return true;
    const requiredFields = ['tonnageBooklets', 'stabilityBooklets', 'termsAccepted'];
    const constructedBy = getValues("constructedBy");
    
    if (constructedBy === "2") {
      requiredFields.push('authLetter');
    }
    
    let hasErrors = false;
    
    requiredFields.forEach(fieldName => {
      const fieldValue = getValues(fieldName);
      
      if (!fieldValue || (fieldValue instanceof FileList && fieldValue.length === 0)) {
        setError(fieldName, {
          type: 'required',
          message: `${fieldName} is required`
        });
        hasErrors = true;
      }
    });
    
    return !hasErrors;
  };

  const supervisionAuthority = methods.watch("supervisionAuthority");

  const handleChallanUpload = (e) => {
    setChallanFile(e.target.files?.[0] || null);
  };

  const handleOnlinePay = () => {
    setIsLoading(true);
    setShowModal(false);
   
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  const handleOfflineSubmit = () => {
    setShowModal(false);
    setIsLoading(true);
    
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  // const handleActionClick = (action) => {
  //   setSelectedAction(action);
  //   setShowApprovalModal(true);
  // };

  // const handleActionSubmit = (formData) => {
  //   const payload = {
  //     action: selectedAction,
  //     ...formData,
  //   };
  //   console.log("Action submitted:", payload);
  //   setShowApprovalModal(false);
  //   setSelectedAction("");
  // };

  // const handleCloseModal = () => {
  //   setShowApprovalModal(false);
  //   setSelectedAction("");
  // };

  const steps = isViewMode ? [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={isViewMode} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateDocuments,
    }
  ] : [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={isViewMode} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateDocuments,
    },
    {
      label: t("Invoicing"),
      component: (
        <Invoicing
          supervisionAuthority={supervisionAuthority}
          onPayNow={() => setShowModal(true)}
        />
      ),
      validate: () => true,
    },
  ];

  const handleSave = () => {
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {isLoading ? (
        <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
          <div className="text-center">
            <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
              <span className="visually-hidden">Loading...</span>
            </div>
            <p className="mt-3">Processing your request...</p>
          </div>
        </div>
      ) : (
        <>
          <Stack spacing={0.5}>
            <Typography
              sx={{
                fontWeight: 550,
                color: "#2E57A7",
                fontSize: "1.2rem",
              }}
            >
             {isViewMode ? t("View Vessel Registration") + ` - ${id}` : 
              isEditMode ? t("Edit Vessel Registration") + ` - ${id}` : t("New Vessel Registration")}
              &nbsp;
              <span style={{ color: "#666", fontSize: "0.65rem" }}>
                {isViewMode ? t("(View vessel registration details)") :
                 isEditMode ? t("(Update vessel registration details)") : t("(Fill in the vessel details to complete registration)")}
              </span>
            </Typography>
          </Stack>
          <Stepper 
            steps={steps} 
            onSave={handleSave} 
            viewMode={isViewMode}
            // actionDropdown={isViewMode ? (
            //   <ActionDropdown
            //     actions={actionsFromAPI}
            //     onActionClick={handleActionClick}
            //     variant="primary"
            //     className="py-2 px-3"
            //   />
            // ) : null}
          />
          {!isViewMode && (
            <PaymentModal
              show={showModal}
              onHide={() => setShowModal(false)}
              paymentMode={paymentMode}
              setPaymentMode={setPaymentMode}
              challanFile={challanFile}
              onChallanUpload={handleChallanUpload}
              onOnlinePay={handleOnlinePay}
              onOfflineSubmit={handleOfflineSubmit}
              isLoading={isLoading}
              formMethods={methods}
            />
          )}
          {/* {isViewMode && (
            <ApprovalModal
              show={showApprovalModal}
              handleClose={handleCloseModal}
              handleSubmitData={handleActionSubmit}
              selectedAction={selectedAction}
            />
          )} */}
        </>
      )}
    </Box>
  );
};

export default NewVesselRegistration;
import React, { useState } from 'react';
import { Container, Row, Col, Card, Button, Badge, OverlayTrigger, Tooltip } from 'react-bootstrap';
import { 
  FaShip, FaUser, FaFileAlt, FaReceipt, FaCheck, FaArrowLeft, FaArrowRight, FaEdit, FaDownload, FaRegFilePdf, FaRegFileImage 
} from 'react-icons/fa';
import TakeActionModal from './TakeActionModal';
import './PreviewPage.css';
import PreviewCard from './PreviewCard';

const PreviewPage = ({
  data = {},
  sections = [],
  title = "Preview",
  subtitle = "Please review all information before final submission",
  onBack,
  onSubmit,
  submitButtonText = "Submit",
  icons = {}
}) => {
  const defaultIcons = {
    vessel: FaShip,
    owner: FaUser,
    documents: FaFileAlt,
    invoice: FaReceipt,
    edit: FaEdit,
    back: FaArrowLeft,
    submit: FaArrowRight,
    check: FaCheck,
    ...icons
  };

  
  const formatLabel = (key) => key
    .replace(/([A-Z])/g, ' $1')
    .replace(/^./, str => str.toUpperCase())
    .replace(/Id$/, 'ID')
    .replace(/_/g, ' ');


  const formatCurrency = (value) => {
    const numValue = parseFloat(value);
    return isNaN(numValue) ? value : numValue.toLocaleString();
  };


  const renderValue = (value) => {
    if (value === null || value === undefined) return <span className="text-muted">N/A</span>;
    if (typeof value === 'boolean') return value ? <Badge bg="success">Yes</Badge> : <Badge bg="secondary">No</Badge>;
    if (typeof value === 'object' && value.status) {
      return <Badge bg={getBadgeColor(value.status)}>{value.status}</Badge>;
    }
    return value.toString();
  };

  
  const getBadgeColor = (status) => {
    const statusMap = {
      'Pending': 'warning',
      'Approved': 'success',
      'Rejected': 'danger',
      'In Progress': 'info',
      'Paid': 'success',
      'Unpaid': 'danger'
    };
    return statusMap[status] || 'secondary';
  };

 
  const getFileIcon = (filename) => {
    if (!filename) return <FaRegFilePdf />;
    const ext = filename.split('.').pop().toLowerCase();
    if (['pdf'].includes(ext)) return <FaRegFilePdf className="text-danger" />;
    if (['jpg', 'jpeg', 'png'].includes(ext)) return <FaRegFileImage className="text-primary" />;
    return <FaFileAlt />;
  };


  const renderPreviewCards = (items) => {
    const keys = Object.keys(items || {});
    if (!keys.length) return <div className="text-muted">No data available.</div>;
    const rows = [];
    for (let i = 0; i < keys.length; i += 3) {
      rows.push(keys.slice(i, i + 3));
    }
    return (
      <>
        {rows.map((rowKeys, idx) => (
          <Row className="mb-3 justify-content-center" key={idx}>
            {rowKeys.map((key) => (
              <Col xl={4} md={6} xs={12} key={key} className="d-flex mb-3">
                <PreviewCard title={formatLabel(key)} value={renderValue(items[key])} />
              </Col>
            ))}
          </Row>
        ))}
      </>
    );
  };

 
  const renderDocuments = (documents) => {
    if (!documents || Object.keys(documents).length === 0) {
      return <div className="text-muted">No documents uploaded.</div>;
    }
    const docKeys = Object.keys(documents);
    const rows = [];
    for (let i = 0; i < docKeys.length; i += 3) {
      rows.push(docKeys.slice(i, i + 3));
    }
    return (
      <>
        {rows.map((rowKeys, idx) => (
          <Row className="mb-3" key={idx}>
            {rowKeys.map((key) => (
              <Col xl={4} md={6} xs={12} key={key} className="mb-3">
                <div className="document-item w-100">
                  <div className="document-icon">
                    {getFileIcon(documents[key])}
                  </div>
                  <div className="document-details">
                    <div className="document-name">{formatLabel(key)}</div>
                    <div className="document-filename">
                      {documents[key] ? (
                        <OverlayTrigger
                          placement="top"
                          overlay={<Tooltip>Download</Tooltip>}
                        >
                          <a
                            href={typeof documents[key] === 'string' && documents[key].startsWith('http') ? documents[key] : '#'}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="document-link"
                            style={{ textDecoration: 'underline', color: '#0077b6', fontWeight: 500 }}
                            download
                          >
                            {documents[key].split('/').pop()}
                            <FaDownload style={{ marginLeft: 8, fontSize: 14 }} />
                          </a>
                        </OverlayTrigger>
                      ) : (
                        <span className="text-muted">Not uploaded</span>
                      )}
                    </div>
                  </div>
                </div>
              </Col>
            ))}
          </Row>
        ))}
      </>
    );
  };

 
  const renderFeeBreakdown = (fees) => {
    if (!fees) return null;
    const { totalAmount, ...otherFees } = fees;
    return (
      <div className="fee-breakdown">
        {Object.entries(otherFees).map(([key, value]) => (
          <div className="fee-item" key={key}>
            <span className="fee-label">{formatLabel(key)}:</span>
            <span className="fee-value">₹ {formatCurrency(value)}</span>
          </div>
        ))}
        <div className="fee-divider"></div>
        <div className="fee-total">
          <span className="fee-total-label">Total Amount:</span>
          <span className="fee-total-value">₹ {formatCurrency(totalAmount)}</span>
        </div>
      </div>
    );
  };

 
  const renderSection = (section) => {
    const { title, type, data: sectionData, icon } = section;
    const IconComponent = defaultIcons[icon] || defaultIcons.vessel;
    return (
      <Card className="preview-card mb-4">
        <Card.Header className="preview-header">
          <IconComponent className="preview-header-icon text-white" />
          <h5 className="preview-header-title text-white mb-0">{title}</h5>
        </Card.Header>
        <Card.Body className="preview-body">
          {type === 'table' && renderPreviewCards(sectionData)}
          {type === 'documents' && renderDocuments(sectionData)}
          {type === 'fees' && renderFeeBreakdown(sectionData)}
          {type === 'custom' && section.render(sectionData)}
        </Card.Body>
      </Card>
    );
  };

  const TitleIcon = icons.title ? defaultIcons[icons.title] || icons.title : null;

  const [showActionModal, setShowActionModal] = useState(false);

  const handleActionClick = () => {
    setShowActionModal(true);
  };

  const handleActionSubmit = (actionData) => {
    console.log('Action submitted:', actionData);
    
    setShowActionModal(false);
    
 
  };

  return (
    <Container className="preview-container">
      <div className="preview-header-container">
        <h2 className="preview-title">
          {TitleIcon && <TitleIcon className="preview-title-icon" />}
          {title}
        </h2>
        <p className="preview-subtitle">{subtitle}</p>
      </div>
      {sections.length > 0 ? (
        sections.map((section, index) => (
          <React.Fragment key={index}>
            {renderSection({
              ...section,
              data: section.dataKey ? data[section.dataKey] : section.data
            })}
          </React.Fragment>
        ))
      ) : (
        <>
          {data.vesselDetails && (
            <Card className="preview-card mb-4">
              <Card.Header className="preview-header">
                <FaShip className="preview-header-icon text-white" />
                <h5 className="preview-header-title text-white mb-0">Vessel Details</h5>
              </Card.Header>
              <Card.Body className="preview-body">
                {renderPreviewCards(data.vesselDetails)}
              </Card.Body>
            </Card>
          )}
          {data.ownerDetails && (
            <Card className="preview-card mb-4">
              <Card.Header className="preview-header">
                <FaUser className="preview-header-icon text-white" />
                <h5 className="preview-header-title text-white mb-0">Owner Details</h5>
              </Card.Header>
              <Card.Body className="preview-body">
                {renderPreviewCards(data.ownerDetails)}
              </Card.Body>
            </Card>
          )}
          {data.documents && (
            <Card className="preview-card mb-4">
              <Card.Header className="preview-header">
                <FaFileAlt className="preview-header-icon text-white" />
                <h5 className="preview-header-title text-white mb-0">Uploaded Documents</h5>
              </Card.Header>
              <Card.Body className="preview-body">
                {renderDocuments(data.documents)}
              </Card.Body>
            </Card>
          )}
          {data.invoiceDetails && (
            <Card className="preview-card mb-4">
              <Card.Header className="preview-header">
                <FaReceipt className="preview-header-icon text-white" />
                <h5 className="preview-header-title text-white mb-0">Invoice Details</h5>
              </Card.Header>
              <Card.Body className="preview-body">
                <Row>
                  <Col md={6} xs={12}>
                    {renderPreviewCards({
                      invoiceNumber: data.invoiceDetails.invoiceNumber,
                      invoiceDate: data.invoiceDetails.invoiceDate,
                      paymentStatus: {
                        status: data.invoiceDetails.paymentStatus
                      },
                      paymentMode: data.invoiceDetails.paymentMode
                    })}
                  </Col>
                  <Col md={6} xs={12}>
                    <Card className="fee-card">
                      <Card.Body>
                        {renderFeeBreakdown(data.invoiceDetails)}
                      </Card.Body>
                    </Card>
                  </Col>
                </Row>
              </Card.Body>
            </Card>
          )}
        </>
      )}
      <div className="preview-actions">
        {onBack && (
          <Button 
            variant="outline-secondary" 
            onClick={onBack}
            className="preview-back-btn"
          >
            <FaArrowLeft className="preview-btn-icon" /> Back to Edit
          </Button>
        )}
        {onSubmit && (
          <Button 
            variant="primary" 
            onClick={handleActionClick}
            className="preview-submit-btn"
          >
            {submitButtonText} <FaArrowRight className="preview-btn-icon" />
          </Button>
        )}
      </div>
      
 
      <TakeActionModal 
        show={showActionModal} 
        onHide={() => setShowActionModal(false)} 
        onSubmit={handleActionSubmit} 
      />
    </Container>
  );
};

export default PreviewPage;
