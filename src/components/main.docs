import React, { useState, useRef, useEffect, useCallback, useMemo } from "react";
import { useNavigate, useParams } from "react-router-dom";
import { toast } from "react-toastify";
import { Modal, Button, Form } from "react-bootstrap";
import "./Stepper.css";
import { useRegistration } from "../../context/ApplicationContext";
import ReviewStep from "./ReviewStep";
import { FormDataProvider } from "../../context/FormDataContext";
import { v4 as uuidv4 } from "uuid"; // Import UUID generator

const deepEqual = (obj1, obj2) => {
  return JSON.stringify(obj1) === JSON.stringify(obj2);
};

const generateFileId = (file) => {
  return `file-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`;
};

const extractFileDetails = (file, source) => {
  if (!file) return null;

  return {
    docId: file.id || generateFileId(file),
    docName: file.name,
    docType: file.type, // Assuming you have file.type
    docSource: source,
  };
};

const createFormPayload = (formData, isFinalSubmit, userFormData, applicationNumber = "") => {
  const creditorBasicDetailsUuid = formData.creditorBasicDetailsUuid || "";
  const claimDetailsUuid = formData.claimDetailsUuid || "";
  const signatoryDetailsUuid = formData.signatoryDetailsUuid || "";

  return {
    userInfo: userFormData?.fullloginDetails || {}, // Make sure to handle potential null
    uuid: applicationNumber || "", // Application number is generated on final submit
    applicationNumber: applicationNumber || "",
    creditorBasicDetails: {
      uuid: creditorBasicDetailsUuid,
      debtorName: formData.step1?.debtorName || "",
      creditorName: formData.step1?.CreditorName || "", // Assuming this is the creditor's UUID
      totalClaimAmount: parseFloat(formData.step1?.totalClaimAmount) || 0,
      debtDetails: formData.step1?.debtDetails || "",
      mutualCreditDetails: formData.step1?.mutualCreditDetails || "",
      status: "",
      isActive: "",
      isFinalSubmit: isFinalSubmit,
      document: extractFileDetails(formData.step1?.identificationDocument, "Identification"),
    },
    auditDetails: {
      auditDetails: {
        createdBy: userFormData?.fullloginDetails?.uuid || "", // Get from user info
        lastModifiedBy: userFormData?.fullloginDetails?.uuid || "",
        createdTime: Date.now(),
        lastModifiedTime: Date.now(),
      },
    },
    claimDetails: {
      uuid: claimDetailsUuid,
      securityInterestAmount: parseFloat(formData.step2?.securityInterestAmount) || 0,
      guaranteeAmount: parseFloat(formData.step2?.guaranteeAmount) || 0,
      guarantorName: formData.step2?.guarantorName || "",
      guarantorAddress: formData.step2?.guarantorAddress || "",
      creditorAddress: formData.step2?.creditorAddress || "",
      creditorEmail: formData.step2?.creditorEmail || "",
      beneficiaryName: formData.step2?.beneficiaryName || "",
      beneficiaryAddress: formData.step2?.beneficiaryAddress || "",
      corporateDebtorSecurityAmount: parseFloat(formData.step2?.corporateDebtorSecurityAmount) || 0,
      corporateDebtorGuaranteeAmount: parseFloat(formData.step2?.corporateDebtorGuaranteeAmount) || 0,
      principalBorrowerName: formData.step2?.principalBorrowerName || "",
      principalBorrowerAddress: formData.step2?.principalBorrowerAddress || "",
      bankAccountNumber: formData.step2?.accountNumber || "",
      bankIfscCode: formData.step2?.ifscCode || "",
      bankBranchName: formData.step2?.branchName || "",
      document: extractFileDetails(formData.step2?.addressProof, "Addressproof"),
      auditDetails: {},
    },
    signatoryDetails: {
      uuid: signatoryDetailsUuid,
      name: formData.step3?.signatoryName || "",
      position: formData.step3?.signatoryPosition || "",
      address: formData.step3?.signatoryAddress || "",
      document: extractFileDetails(formData.step3?.signatoryDocument, "Signature"),
    },
  };
};

const getFileFieldsForStep = (stepNumber) => {
  switch (stepNumber) {
    case 1:
      return ["identificationDocument"];
    case 2:
      return ["addressProof"];
    case 3:
      return ["signatoryDocument"];
    default:
      return [];
  }
};

const processFileUploads = async (stepData, stepNumber) => {
  const fileFields = getFileFieldsForStep(stepNumber);
  const processedData = { ...stepData };

  for (const field of fileFields) {
    if (stepData[field] && stepData[field] instanceof File) {
      // In a real application, you would upload the file here
      // and get a server-side ID or URL.
      processedData[field] = {
        id: generateFileId(stepData[field]),
        name: stepData[field].name,
        size: stepData[field].size,
        type: stepData[field].type,
        uploadedAt: new Date().toISOString(),
      };
    } else if (stepData[field] && typeof stepData[field] === 'object' && stepData[field].name) {
      // Keep existing file details if not a new file
      processedData[field] = { ...stepData[field] };
    }
  }

  return processedData;
};

const Stepper = ({ stepsConfig = [], formAllData }) => {
  const { id } = useParams();
  const isEditMode = !!id;
  const [currentStep, setCurrentStep] = useState(1);
  const [isConfirmed, setIsConfirmed] = useState(false);
  const [isComplete, setIsComplete] = useState(false);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [hasPreviewed, setHasPreviewed] = useState(false);
  const [formData, setFormData] = useState({});
  const [margins, setMargins] = useState({ marginLeft: 0, marginRight: 0 });
  const stepRef = useRef([]);
  const navigate = useNavigate();
  const [currentSubmitHandler, setCurrentSubmitHandler] = useState(null);
  const [showModal, setShowModal] = useState(false);
  const [comments, setComments] = useState("");
  const [actionType, setActionType] = useState("");
  const [isSavingDraft, setIsSavingDraft] = useState(false);

  const {
    registrationData,
    handleStepDataFetch,
    updateRegistrationData,
    loadDataFromLocalStorage,
    isDataLoaded,
  } = useRegistration();

  const userFormData = JSON.parse(localStorage.getItem("userFormData"));
  const isCRPUser = userFormData?.userType === "CRP";

  const filteredStepsConfig = useMemo(() => {
    if (isCRPUser) {
      return stepsConfig.filter((step) => step.name !== "Review & Submit");
    }
    return stepsConfig;
  }, [stepsConfig, isCRPUser]);

  useEffect(() => {
    if (id) {
      loadDataFromLocalStorage(id);
    }
  }, [id, loadDataFromLocalStorage]);

  useEffect(() => {
    if (isEditMode && registrationData && !deepEqual(formData, registrationData)) {
      setFormData({
        ...registrationData,
        creditorBasicDetailsUuid: registrationData.creditorBasicDetails?.uuid || uuidv4(),
        claimDetailsUuid: registrationData.claimDetails?.uuid || uuidv4(),
        signatoryDetailsUuid: registrationData.signatoryDetails?.uuid || uuidv4(),
        step1: {
          debtorName: registrationData.creditorBasicDetails?.debtorName,
          CreditorName: registrationData.creditorBasicDetails?.creditorName,
          totalClaimAmount: registrationData.creditorBasicDetails?.totalClaimAmount,
          debtDetails: registrationData.creditorBasicDetails?.debtDetails,
          mutualCreditDetails: registrationData.creditorBasicDetails?.mutualCreditDetails,
          identificationType: registrationData.creditorBasicDetails?.document?.docType,
          identificationNumber: registrationData.creditorBasicDetails?.document?.docId,
          identificationDocument: registrationData.creditorBasicDetails?.document
            ? { id: registrationData.creditorBasicDetails.document.docId, name: registrationData.creditorBasicDetails.document.docName, type: registrationData.creditorBasicDetails.document.docType }
            : null,
        },
        step2: {
          securityInterestAmount: registrationData.claimDetails?.securityInterestAmount,
          guaranteeAmount: registrationData.claimDetails?.guaranteeAmount,
          guarantorName: registrationData.claimDetails?.guarantorName,
          guarantorAddress: registrationData.claimDetails?.guarantorAddress,
          creditorAddress: registrationData.claimDetails?.creditorAddress,
          creditorEmail: registrationData.claimDetails?.creditorEmail,
          beneficiaryName: registrationData.claimDetails?.beneficiaryName,
          beneficiaryAddress: registrationData.claimDetails?.beneficiaryAddress,
          corporateDebtorSecurityAmount: registrationData.claimDetails?.corporateDebtorSecurityAmount,
          corporateDebtorGuaranteeAmount: registrationData.claimDetails?.corporateDebtorGuaranteeAmount,
          principalBorrowerName: registrationData.claimDetails?.principalBorrowerName,
          principalBorrowerAddress: registrationData.claimDetails?.principalBorrowerAddress,
          accountNumber: registrationData.claimDetails?.bankAccountNumber,
          ifscCode: registrationData.claimDetails?.bankIfscCode,
          branchName: registrationData.claimDetails?.bankBranchName,
          addressProof: registrationData.claimDetails?.document
            ? { id: registrationData.claimDetails.document.docId, name: registrationData.claimDetails.document.docName, type: registrationData.claimDetails.document.docType }
            : null,
        },
        step3: {
          signatoryName: registrationData.signatoryDetails?.name,
          signatoryPosition: registrationData.signatoryDetails?.position,
          signatoryAddress: registrationData.signatoryDetails?.address,
          signatoryDocument: registrationData.signatoryDetails?.document
            ? { id: registrationData.signatoryDetails.document.docId, name: registrationData.signatoryDetails.document.docName, type: registrationData.signatoryDetails.document.docType }
            : null,
        },
      });
    } else if (!isEditMode && !isDataLoaded) {
      // Initialize with new UUIDs for a new form
      setFormData({
        creditorBasicDetailsUuid: uuidv4(),
        claimDetailsUuid: uuidv4(),
        signatoryDetailsUuid: uuidv4(),
      });
    }
  }, [isEditMode, registrationData, formData, isDataLoaded]);

  useEffect(() => {
    const savedIsConfirmed = localStorage.getItem("isConfirmed");
    if (savedIsConfirmed) {
      setIsConfirmed(JSON.parse(savedIsConfirmed));
    }
  }, []);

  useEffect(() => {
    localStorage.setItem("isConfirmed", JSON.stringify(isConfirmed));
  }, [isConfirmed]);

  useEffect(() => {
    const newSubmitHandler = filteredStepsConfig[currentStep - 1]?.submitHandler;
    if (newSubmitHandler && newSubmitHandler !== currentSubmitHandler) {
      setCurrentSubmitHandler(() => newSubmitHandler);
    }
  }, [currentStep, filteredStepsConfig]);

  const updateSubmitHandler = useCallback((submitHandler) => {
    setCurrentSubmitHandler(() => submitHandler);
  }, []);

  useEffect(() => {
    if (stepRef.current.length > 0) {
      const firstStep = stepRef.current[0]?.offsetWidth || 0;
      const lastStep = stepRef.current[filteredStepsConfig.length - 1]?.offsetWidth || 0;
      setMargins({
        marginLeft: firstStep / 2,
        marginRight: lastStep / 2,
      });
    }
  }, [filteredStepsConfig.length]);

  const validateStepData = (step, data) => {
    const requiredFields = filteredStepsConfig[step - 1]?.requiredFields || [];
    for (let field of requiredFields) {
      if (!data[field]) {
        toast.error(`${field} is required.`);
        return false;
      }
    }
    return true;
  };

  const handleNext = async () => {
    if (!currentSubmitHandler) {
      console.error("No submit handler available.");
      return;
    }

    const currentStepData = await currentSubmitHandler();
    if (!currentStepData) {
      console.error("Form validation failed.");
      return;
    }

    if (!validateStepData(currentStep, currentStepData)) {
      return;
    }

    const processedStepData = await processFileUploads(currentStepData, currentStep);

    const updatedFormData = {
      ...formData,
      [`step${currentStep}`]: { ...formData[`step${currentStep}`], ...processedStepData },
    };

    if (!deepEqual(updatedFormData, formData)) {
      setFormData(updatedFormData);
      updateRegistrationData(`step${currentStep}`, updatedFormData[`step${currentStep}`], id);
    }

    if (currentStep === filteredStepsConfig.length) {
      const finalPayload = createFormPayload(updatedFormData, true, userFormData, id); // isFinalSubmit: true, use ID as application number if editing
      console.log("Final Payload:", JSON.stringify(finalPayload, null, 2));

      // In a real application, you would send this payload to your API
      // await submitForm(finalPayload);

      setIsComplete(true);
      toast.success("Form submitted successfully");
      navigate("/dashboard");
    } else {
      setCurrentStep((prevStep) => prevStep + 1);
    }
  };

  const handlePreview = async () => {
    if (!currentSubmitHandler) {
      console.error("No submit handler available.");
      return;
    }

    const currentStepData = await currentSubmitHandler();
    if (!currentStepData) {
      console.error("Form validation failed.");
      return;
    }

    if (!validateStepData(currentStep, currentStepData)) {
      return;
    }

    const processedStepData = await processFileUploads(currentStepData, currentStep);

    const updatedFormData = {
      ...formData,
      [`step${currentStep}`]: { ...formData[`step${currentStep}`], ...processedStepData },
    };

    if (!deepEqual(updatedFormData, formData)) {
      setFormData(updatedFormData);
      updateRegistrationData(`step${currentStep}`, updatedFormData[`step${currentStep}`], id);
    }

    const previewPayload = createFormPayload(updatedFormData, false, userFormData, id); // isFinalSubmit: false, use ID if editing

    console.log("Preview Payload:", JSON.stringify(previewPayload, null, 2));
    localStorage.setItem("formPreviewData", JSON.stringify(previewPayload));

    setCurrentStep(filteredStepsConfig.length);
    setHasPreviewed(true); // Enable preview button
  };

  const handleSaveDraft = async () => {
    setIsSavingDraft(true);
    try {
      const currentStepData = currentSubmitHandler ? await currentSubmitHandler() : {};
      const processedStepData = await processFileUploads(currentStepData, currentStep);

      const draftId = id || `draft-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`;

      // Generate uuids if they don't exist
      const creditorBasicDetailsUuid = formData.creditorBasicDetailsUuid || uuidv4();
      const claimDetailsUuid = formData.claimDetailsUuid || uuidv4();
      const signatoryDetailsUuid = formData.signatoryDetailsUuid || uuidv4();

      const draftData = {
        ...formData,
        creditorBasicDetailsUuid: creditorBasicDetailsUuid,
        claimDetailsUuid: claimDetailsUuid,
        signatoryDetailsUuid: signatoryDetailsUuid,
        [`step${currentStep}`]: {
          ...formData[`step${currentStep}`],
          ...processedStepData,
        },
        id: draftId,
        status: "draft",
        lastSaved: new Date().toISOString(),
        currentStep,
        formType: userFormData?.formType,
        userType: userFormData?.userType,
      };

      const existingDraft = JSON.parse(localStorage.getItem("formDrafts") || "[]");
      const updatedDrafts = [
        ...existingDraft.filter((draft) => draft.id !== draftId),
        draftData,
      ];
      localStorage.setItem("formDrafts", JSON.stringify(updatedDrafts));

      // Save the draft data to local storage
      localStorage.setItem(draftId, JSON.stringify(createFormPayload(draftData, false, userFormData, draftId))); // Save with isFinalSubmit: false

      toast.success("Draft saved successfully");
      navigate("/drafts");
      setHasPreviewed(true); // Enable preview after saving draft
    } catch (error) {
      console.error("Error saving draft:", error);
      toast.error("Failed to save draft");
    } finally {
      setIsSavingDraft(false);
    }
  };

  const handleActionClick = (action) => {
    setActionType(action);
    setShowModal(true);
  };

  const handleModalClose = () => {
    setShowModal(false);
    setComments("");
  };

  const handleActionSubmit = () => {
    console.log(`Action: ${actionType}, Comments: ${comments}`);
    toast.success(`${actionType} submitted successfully`);
    navigate("/dashboard");
  };

  const handlePrevious = () => {
    setCurrentStep((prevStep) => Math.max(1, prevStep - 1));
    setIsConfirmed(false);
    localStorage.removeItem("isConfirmed");
  };

  const handleCancel = () => {
    navigate("/dashboard");
  };

  const calculateProgressBarWidth = () => {
    return ((currentStep - 1) / (filteredStepsConfig.length - 1)) * 100;
  };

  const ActiveComponent = filteredStepsConfig[currentStep - 1]?.Component;
  const shouldRenderReviewStep = currentStep === filteredStepsConfig.length && isDataLoaded;

  const flattenFormData = (formData) => {
    const flattened = {
      ...formData.step1,
      ...formData.step2,
      ...formData.step3,
    };

    return flattened;
  };

  return (
    <FormDataProvider formData={flattenFormData(formData)}>
      <div className="stepper">
        {filteredStepsConfig.map((step, index) => (
          <div
            key={step.name}
            ref={(el) => (stepRef.current[index] = el)}
            className={`step ${
              currentStep > index + 1 || isComplete ? "complete" : ""
            } ${currentStep === index + 1 ? "active" : ""}`}
          >
            <div className="step-number">
              {currentStep > index + 1 || isComplete ? (
                <span>✓</span>
              ) : (
                index + 1
              )}
            </div>
            <div className="step-name">{step.name}</div>
          </div>
        ))}

        <div
          className="progress-bar"
          style={{
            marginLeft: margins.marginLeft,
            marginRight: margins.marginRight,
          }}
        >
          <div
            className="progress"
            style={{ width: `${calculateProgressBarWidth()}%` }}
          ></div>
        </div>
      </div>

      {ActiveComponent && (
        <ActiveComponent
          formData={formData[`step${currentStep}`] || {}}
          provideSubmitHandler={updateSubmitHandler}
          setFormData={setFormData}
        />
      )}

      {shouldRenderReviewStep && !isCRPUser && (
        <ReviewStep />
      )}

      {currentStep === filteredStepsConfig.length && !isCRPUser && (
        <div className="confirmation-container">
          <Form.Group controlId="formConfirmation" className="mt-3 confirmation-checkbox">
            <Form.Check
              type="checkbox"
              label="I confirm that the information provided is correct."
              checked={isConfirmed}
              onChange={(e) => setIsConfirmed(e.target.checked)}
            />
          </Form.Group>
        </div>
      )}

      <div className="stepper-buttons">
        {currentStep > 1 && (
          <button className="buttonplus previous-button" onClick={handlePrevious}>
            Previous
          </button>
        )}
        {currentStep === 1 && (
          <button className="buttonplus cancel-button" onClick={handleCancel}>
            Cancel
          </button>
        )}

        {currentStep === 3 && !isCRPUser && (
          <div className="last-step-buttons">
            <button
              className="buttonplus draft-button"
              onClick={handleSaveDraft}
              disabled={isSavingDraft}
            >
              {isSavingDraft ? "Saving..." : "Save as Draft"}
            </button>
            <button
              className="buttonplus preview-button"
              onClick={handlePreview}
              disabled={!hasPreviewed}
            >
              Preview
            </button>
          </div>
        )}

        {currentStep !== 3 && currentStep !== filteredStepsConfig.length && (
          <button
            className="buttonplus next-button"
            onClick={handleNext}
            disabled={isComplete}
          >
            Next
          </button>
        )}

        {currentStep === filteredStepsConfig.length && isCRPUser ? (
          <>
            <button
              className="buttonplus sendback-button"
              onClick={() => handleActionClick("Sendback To Claimants")}
            >
              Sendback To Claimants
            </button>
            <button
              className="buttonplus accept-contingent-button"
              onClick={() => handleActionClick("Accept as Contingent")}
            >
              Accept as Contingent
            </button>
            <button
              className="buttonplus accept-button"
              onClick={() => handleActionClick("Accept")}
            >
              Accept
            </button>
            <button
              className="buttonplus reject-button"
              onClick={() => handleActionClick("Reject")}
            >
              Reject
            </button>
          </>
        ) : currentStep === filteredStepsConfig.length ? (
          <button
            className="buttonplus next-button"
            onClick={handleNext}
            disabled={!isConfirmed || isComplete}
          >
            Submit
          </button>
        ) : null}
      </div>

      <Modal show={showModal} onHide={handleModalClose} centered>
        <Modal.Header closeButton>
          <Modal.Title>{actionType} Form</Modal.Title>
        </Modal.Header>
        <Modal.Body>
          <Form>
            <Form.Group controlId="comments">
              <Form.Label>Comments</Form.Label>
              <Form.Control
                as="textarea"
                rows={3}
                value={comments}
                onChange={(e) => setComments(e.target.value)}
                placeholder="Enter your comments..."
              />
            </Form.Group>
          </Form>
        </Modal.Body>
        <Modal.Footer>
          <Button className="modal-close-button" onClick={handleModalClose}>
            Close
          </Button>
          <Button
            className="modal-submit-button"
            onClick={handleActionSubmit}
            disabled={!comments.trim()}
          >
            Submit
          </Button>
        </Modal.Footer>
      </Modal>
    </FormDataProvider>
  );
};

export default Stepper;

