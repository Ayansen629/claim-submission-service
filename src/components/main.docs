import { toast } from "react-toastify";
import VesselInfo from "../common/VesselInfo";
import { useNavigate } from "react-router-dom";
import { useEffect, useState } from "react";
import { postData } from "../../../../services/http.service.ts";
import {
  BASE_IP,
  SERVICE_BASE,
  URLS_ENDPOINT,
} from "../../../../utils/urlsConstants.ts";

const TransferOfRegistry = () => {
    const navigate = useNavigate();
    const [apiVesselData, setApiVesselData] = useState([]);

    const fetchVesselData = async () => {
        try {
            const apiUrl = SERVICE_BASE.IWT_REGISTRATION +
                          URLS_ENDPOINT.TRANSFER_OF_REGISTRY.FETCH_VESSELS_BY_OWNER;
                               
            const response = await postData(apiUrl);
            
            if (response?.status === 200 && response?.data?.responseStatus?.status === "SUCCESS") {
                const mappedData = response.data.data.map((vessel, index) => ({
                    id: index + 1,
                    registrationNo: vessel.registrationNumber || vessel.applicationNo,
                    vesselName: vessel.vesselName || "N/A",
                    registeredYear: vessel.yearOfBuild || "N/A",
                    lastSurveyDate: vessel.auditDetails?.updatedOn?.split('T')[0] || "N/A",
                    vesselType: vessel.typeOfVessel || "N/A",
                    ...vessel
                }));
                setApiVesselData(mappedData);
            }
        } catch (error) {
            console.error("Error fetching vessels:", error);
            toast.error("Error fetching vessel data");
            setApiVesselData([]); 
        }
    };

    useEffect(() => {
        fetchVesselData();
    }, []);

    const handleViewRegistry = (rowData) => {
        console.log("Viewing registry for:", rowData);
        const regNo = rowData?.registrationNo || "";
        if (!regNo) {
            toast.warning("Registration Number missing...", {
                position: "top-right",
            });
            return;
        }
        navigate(`/vessel-registration/transfer-of-registry-application?applicationNo=${regNo}`, {
            state: {
                rowData: { ...rowData },
            },
        });
    };

    return (
        <>
            <VesselInfo 
                handleViewAction={handleViewRegistry}
                externalVesselData={apiVesselData}
                useApiData={true}
            />
        </>
    );
};

export default TransferOfRegistry;
