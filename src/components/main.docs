import React, { useState } from "react";
import { useForm } from "react-hook-form";
import { Row, Col, Card, Button } from "react-bootstrap";
import InputText from "../../common/InputText.tsx";
import InputSelect from "../../common/InputSelect.tsx";
import InputRadio from "../../common/InputRadio.tsx";
import InputFile from "../../common/InputFile.jsx";

// MultipleFileUpload component for reusable file upload sections
const MultipleFileUpload = ({ title, description = true }) => {
  const [files, setFiles] = useState([{ id: 1, file: null, description: "" }]);

  const addFileInput = () => {
    const newId = files.length > 0 ? Math.max(...files.map(f => f.id)) + 1 : 1;
    setFiles([...files, { id: newId, file: null, description: "" }]);
  };

  const removeFileInput = (id) => {
    setFiles(files.filter(file => file.id !== id));
  };

  return (
    <div className="mb-4">
      <div className="d-flex justify-content-between align-items-center mb-2">
        <h6 className="mb-0">{title}</h6>
        {description && (
          <Button 
            variant="primary" 
            size="sm" 
            onClick={addFileInput}
            style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
          >
            + Add
          </Button>
        )}
      </div>
      
      {files.map((fileInput) => (
        <Row key={fileInput.id} className="mb-2 align-items-end">
          <Col md={description ? 6 : 10}>
            <InputFile
              label=""
              name={`${title.replace(/\s+/g, '')}_file_${fileInput.id}`}
              required={fileInput.id === 1} // First file is required
            />
          </Col>
          
          {description && (
            <Col md={4}>
              <InputText
                label=""
                name={`${title.replace(/\s+/g, '')}_desc_${fileInput.id}`}
                placeholder="Description of File"
              />
            </Col>
          )}
          
          {description && files.length > 1 && (
            <Col md={2}>
              <Button 
                variant="outline-danger" 
                size="sm" 
                onClick={() => removeFileInput(fileInput.id)}
                className="mb-3"
              >
                Remove
              </Button>
            </Col>
          )}
        </Row>
      ))}
    </div>
  );
};

const VesselDetails = () => {
    const {
        register,
        handleSubmit,
        formState: { errors },
    } = useForm({
        defaultValues: {
            ownerName: "",
            ownerAddress: "",
            mobile: "",
            email: "",
            pan: "",
            aadhar: "",
            tradeLicence: "",
            gst: "",
            vesselType: "",
            category: "",
            zone: "",
            supervisionAuthority: "",
            purchaseType: "",
            classificationSociety: "",
            constructedBy: '1',
            builder: '',
            builderName: '',
            builderAddress: '',
            builderEmail: '',
            builderMobile: '',
            builderTradeLicence: '',
            builderGST: '',
            builderAuth: '',
            authLetter: '',
            workOrderValue: ''
        },
    });

    const onSubmit = (data) => {
        console.log("Form Submitted:", data);
    };

    const headerStyle = {
        backgroundColor: "#EAF1FB",
        color: "#2466BF",
        fontWeight: 600,
        borderRadius: "0.4rem",
        padding: "0.75rem 1rem",
    };

    return (
        <form onSubmit={handleSubmit(onSubmit)}>
            {/* Owner Details Header */}
            <Card className="bg-transparent">
                <Card.Header style={headerStyle}>Basic Information</Card.Header>
            </Card>
            <Row className="gy-3" style={{ padding: '1rem' }}>
                <Col md={4}>
                    <InputText
                        label="Name of Owner"
                        name="ownerName"
                        placeholder="Please enter Name of Owner"
                        required
                        register={{
                            ...register("ownerName", { required: "Name is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="Address of Owner"
                        name="ownerAddress"
                        placeholder="Please enter Address of Owner"
                        required
                        register={{
                            ...register("ownerAddress", { required: "Address is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="Mobile"
                        name="mobile"
                        placeholder="Please enter Mobile"
                        required
                        register={{
                            ...register("mobile", { required: "Mobile is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="Email Id"
                        name="email"
                        placeholder="Please enter Email Id"
                        required
                        register={{
                            ...register("email", { required: "Email is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="PAN"
                        name="pan"
                        placeholder="Please enter PAN"
                        required
                        register={{
                            ...register("pan", { required: "PAN is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="Aadhar"
                        name="aadhar"
                        placeholder="Please enter Aadhar"
                        required
                        register={{
                            ...register("aadhar", { required: "Aadhar is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
            </Row>

            <Row className="gy-3" style={{ padding: '1rem' }}>
                <Col md={4}>
                    <InputText
                        label="Trade Licence"
                        name="tradeLicence"
                        placeholder="Please enter Trade Licence"
                        required
                        register={{
                            ...register("tradeLicence", { required: "Trade Licence is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="GST"
                        name="gst"
                        placeholder="Please enter GST"
                        required
                        register={{
                            ...register("gst", { required: "GST is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
            </Row>

            <Row className="gy-3" style={{ padding: '1rem' }}>
                <Col md={4}>
                    <InputSelect
                        label="Type of Vessel"
                        name="vesselType"
                        required
                        options={[
                            { value: "new", label: "New Vessel" },
                            { value: "old", label: "Old Vessel" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Vessel Type:", val)}
                    />
                </Col>
                <Col md={4}>
                    <InputSelect
                        label="Category"
                        name="category"
                        required
                        options={[
                            { value: "A", label: "Category A" },
                            { value: "B", label: "Category B" },
                            { value: "C", label: "Category C" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Category:", val)}
                    />
                </Col>
                <Col md={4}>
                    <InputSelect
                        label="Zone"
                        name="zone"
                        options={[
                            { value: "1", label: "Zone 1" },
                            { value: "2", label: "Zone 2" },
                            { value: "3", label: "Zone 3" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Zone:", val)}
                    />
                </Col>
                <Col md={4}>
                    <InputSelect
                        label="Supervision Authority"
                        name="supervisionAuthority"
                        options={[
                            { value: "iwt", label: "IWT" },
                            { value: "classificationSociety", label: "Classification Society" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Authority:", val)}
                    />
                </Col>
                <Col md={4}>
                    <InputSelect
                        label="Purchase Type"
                        name="purchaseType"
                        options={[
                            { value: "new", label: "New" },
                            { value: "used", label: "Used" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Purchase Type:", val)}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="Name of the Classification Society"
                        name="classificationSociety"
                        placeholder="Please enter Name of the Classification Society"
                        register={{
                            ...register("classificationSociety"),
                        }}
                        errors={errors}
                    />
                </Col>
            </Row>

            <Row className="gy-3" style={{ padding: '1rem' }}>
                <Col md={6}>
                    <InputRadio
                        name="constructedBy"
                        label=" Constructed By ?"
                        options={[
                            { label: "Self", value: '1' },
                            { label: "Builder", value: '2' },
                        ]}
                        register={register}
                        rules={{ required: "Please select a Contructor Type" }}
                        errors={errors}
                    />
                </Col>


                <Col md={6}>
                    <InputSelect
                        label="Builder"
                        name="builder"
                        required
                        options={[
                            { value: "builder1", label: "Builder 1" },
                            { value: "builder2", label: "Builder 2" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Builder Type:", val)}
                    />
                </Col>



            </Row>


            <Card className="bg-transparent">
                <Card.Header style={headerStyle}>Builder Details</Card.Header>
            </Card>
            <Row className="gy-3" style={{ padding: '1rem' }}>
                <Col md={4}>
                    <InputText
                        label="Builder Name"
                        name="builderName"
                        required
                        placeholder="Please enter Builder Name"
                        register={{
                            ...register("builderName"),
                        }}
                        errors={errors}
                    />
                </Col>

                <Col md={4}>
                    <InputText
                        label="Builder Address"
                        name="builderAddress"
                        required
                        placeholder="Please enter Builder Address"
                        register={{
                            ...register("builderAddress"),
                        }}
                        errors={errors}
                    />
                </Col>

                <Col md={4}>
                    <InputText
                        label="Builder Email Id"
                        name="builderEmail"
                        required
                        placeholder="Please enter Builder Email Id"
                        register={{
                            ...register("builderEmail"),
                        }}
                        errors={errors}
                    />
                </Col>

                <Col md={4}>
                    <InputText
                        label="Mobile"
                        name="builderMobile"
                        required
                        placeholder="Please enter Mobile"
                        register={{
                            ...register("builderMobile"),
                        }}
                        errors={errors}
                    />
                </Col>

                <Col md={4}>
                    <InputText
                        label="Trade Licence"
                        name="builderTradeLicence"
                        required
                        placeholder="Please enter Trade Licence"
                        register={{
                            ...register("builderTradeLicence"),
                        }}
                        errors={errors}
                    />
                </Col>

                <Col md={4}>
                    <InputText
                        label="GST"
                        name="builderGST"
                        required
                        placeholder="Please enter GST"
                        register={{
                            ...register("builderGST"),
                        }}
                        errors={errors}
                    />
                </Col>

                <Col md={4}>
                    <InputSelect
                        label="Builder Authorization"
                        name="builderAuth"
                        required
                        options={[
                            { value: "auth", label: "Authorized" },
                            { value: "rejected", label: "Rejected" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Builder Type:", val)}
                    />
                </Col>


                <Col md={4}>
                    <InputFile
                        label="Authorisation Letter"
                        name="authLetter"
                        required
                        placeholder="Please upload Authorisation Letter"
                        register={{
                            ...register("authLetter"),
                        }}
                        errors={errors}
                    />
                </Col>


                <Col md={4}>
                    <InputText
                        label="Work Order Value"
                        name="workOrderValue"
                        required
                        placeholder="Enter Work Order Value"
                        register={{
                            ...register("workOrderValue"),
                        }}
                        errors={errors}
                    />
                </Col>

            </Row>

            <Card className="bg-transparent">
                <Card.Header style={headerStyle}>Documents</Card.Header>
            </Card>
            
            <Row className="gy-3" style={{ padding: '1rem' }}>
                <Col md={12}>
                    <Card className="p-3">
                        <Card.Body>
                            <div className="mb-3">
                                <p className="fw-bold mb-3">
                                    I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.
                                </p>
                            </div>
                            
                            <div className="mb-4">
                                <h5 className="mb-3">Documents Upload section</h5>
                                
                                {/* Work Order section */}
                                <MultipleFileUpload title="1. Work Order" />
                                
                                {/* Drawings section */}
                                <MultipleFileUpload title="2. Drawings" />
                                
                                {/* Tonnage Booklets section - no add button */}
                                <div className="mb-4">
                                    <h6 className="mb-2">3. Tonnage Booklets</h6>
                                    <Row className="mb-2">
                                        <Col md={10}>
                                            <InputFile
                                                label=""
                                                name="tonnageBooklets"
                                                required
                                            />
                                        </Col>
                                    </Row>
                                </div>
                                
                                {/* Stability Booklets section - no add button */}
                                <div className="mb-4">
                                    <h6 className="mb-2">4. Stability Booklets</h6>
                                    <Row className="mb-2">
                                        <Col md={10}>
                                            <InputFile
                                                label=""
                                                name="stabilityBooklets"
                                                required
                                            />
                                        </Col>
                                    </Row>
                                </div>
                            </div>
                        </Card.Body>
                    </Card>
                </Col>
            </Row>
        </form>
    );
};

export default VesselDetails;
