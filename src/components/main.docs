import React from 'react';
import { Row, Col } from 'react-bootstrap';
import { useFormContext } from 'react-hook-form';
import InputText from './InputText';
import InputFile from './InputFile';
import { renameFile } from '../../utils/constants';

const DynamicFormFields = ({ fields, setFormData }) => {
  const { register, formState: { errors }, setValue, watch } = useFormContext();

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'file':
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name, {
              required: field.required ? `${field.label} is required` : false,
              validate: {
                fileType: (files) => {
                  if (!files || !files[0]) return !field.required || 'File is required';
                  const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                  if (!validTypes.includes(files[0].type)) {
                    return 'Only PDF, JPG or PNG files are allowed';
                  }
                  return true;
                },
                fileSize: (files) => {
                  if (!files || !files[0]) return !field.required || 'File is required';
                  if (files[0].size > 2 * 1024 * 1024) {
                    return 'File size should not exceed 2MB';
                  }
                  return true;
                }
              }
            })}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e.target.files[0]) {
                const file = e.target.files[0];
                const extension = file.name.substring(file.name.lastIndexOf('.'));
                const fileName = `${field.label.replace(/\s+/g, '_')}${extension}`;
                const renamedFile = renameFile(file, fileName);
                setValue(field.name, renamedFile, { shouldValidate: true });
                setFormData(prev => ({ ...prev, [field.name]: renamedFile }));
              } else {
                setValue(field.name, null, { shouldValidate: true });
                setFormData(prev => ({ ...prev, [field.name]: null }));
              }
            }}
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field.name, field.validation)}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field.maxlength}
            disabled={field.disabled}
          />
        );
    }
  };

  return (
    <Row className="g-3">
      {fields.map((field, index) => (
        <Col key={index} md={field.colSize || 12}>
          {renderField(field)}
        </Col>
      ))}
    </Row>
  );
};

export default DynamicFormFields;
