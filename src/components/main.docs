import React, { useEffect, useState } from "react";
import { useLocation, useNavigate, useSearchParams } from "react-router-dom";
import DynamicTabs from "../../../common/DynamicTabs";
import VesselSurveyRegistration from "./survey/VesselSurveyRegistration";
import VesselReportsAndDocs from "./common/VesselReportsAndDocs";
import { useTranslation } from "react-i18next";
import { Button } from "react-bootstrap";
import { Box, Typography, Stack, CircularProgress } from "@mui/material";
import { BsArrowLeft, BsFileText, BsClipboardCheck } from "react-icons/bs";
import { postData } from "../../../../services/http.service.ts";
import {
  SERVICE_BASE,
  URLS_ENDPOINT,
} from "../../../../utils/urlsConstants.ts";
import { toast } from "react-toastify";
import { FaArrowCircleLeft } from "react-icons/fa";

const VesselApplicationDetailsView = () => {
  const { t } = useTranslation();
  const [searchParams] = useSearchParams();
  const id = decodeURIComponent(searchParams.get("applicationNo") || "");

  const location = useLocation();
  const navigate = useNavigate();

  const [rowData, setRowData] = useState(location?.state?.rowData ?? null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);

  useEffect(() => {
    if (!id) {
      toast.error("No Application number present.");
      if (window.history.state?.idx > 0) {
        navigate(-1);
      } else {
        navigate("/dashboard", { replace: true });
      }
    }
  }, [id, navigate]);

  useEffect(() => {
    if (rowData || !id) return;

    (async () => {
      try {
        setLoading(true);
        setError(null);

        const payload = { applicationNumbers: [id] };
        const apiUrl = `${SERVICE_BASE.IWT_REGISTRATION}${URLS_ENDPOINT.USER_SERVICE.REGISTRATION_SEARCH_BY_ID}`;
        const { status, data } = await postData(apiUrl, payload);

        if (status !== 200 || !data?.data?.[0]?.basicDetails) {
          setError("No data found for the given application number.");
          return;
        }

        const fetchedData = data?.data[0]?.basicDetails;
        setRowData(fetchedData);

        navigate(location.pathname, {
          replace: true,
          state: { rowData: fetchedData },
        });
      } catch (err) {
        console.error("Failed to fetch registration details:", err);
        setError("Failed to fetch registration details.");
      } finally {
        setLoading(false);
      }
    })();
  }, [rowData, id, navigate, location.pathname]);

  if (loading) {
    return (
      <Box sx={{ p: 4, display: "flex", justifyContent: "center" }}>
        <CircularProgress size={32} sx={{ color: "#2E57A7" }} />
      </Box>
    );
  }

  if (error || !rowData) {
    return (
      <Box
        sx={{
          p: 4,
          minHeight: "60vh",
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          justifyContent: "center",
          textAlign: "center",
          backgroundColor: "#f8f9fa",
        }}
      >
        <Typography
          variant="h6"
          sx={{ fontWeight: 600, color: "#2E57A7", mb: 1 }}
        >
          {t("No Data Found")}
        </Typography>
        <Typography sx={{ color: "#6c757d", mb: 3 }}>
          {t("No application details available for this number : " + id)};
        </Typography>
        <Button
          onClick={() => navigate("/dashboard")}
          style={{
            borderRadius: "8px",
            padding: "8px 16px",
            border: "2px solid #2E57A7",
            color: "#fff",
            backgroundColor: "#2E57A7",
            fontWeight: 600,
          }}
        >
          <FaArrowCircleLeft size={12} /> &nbsp; {t("Back to Dashboard")}
        </Button>
      </Box>
    );
  }

  const tabs = [
    {
      key: "registration",
      title: t("Registration Information"),
      icon: <BsFileText />,
      content: <VesselReportsAndDocs applicationNo={id} viewMode tabMode />,
    },
    ...(rowData?.enableInitialSurvey ||
    rowData?.initialSurveyCompleted ||
    rowData?.initialSurveySubmitted ||
    rowData?.isProvSurveyCertificateGenerated ||
    rowData?.isProvisionalCertificate
      ? [
          {
            key: "survey",
            title: t("Initial Survey - Details"),
            icon: <BsClipboardCheck />,
            content: (
              <VesselSurveyRegistration applicationNo={id} viewMode tabMode />
            ),
          },
        ]
      : []),
  ];

  return (
    <Box sx={{ p: 2, backgroundColor: "#f8f9fa", minHeight: "100vh" }}>
      {/* Header */}
      <Box
        sx={{
          display: "flex",
          alignItems: "center",
          mb: 3,
          padding: "16px 20px",
          background: "#ffffff",
          borderRadius: "12px",
          boxShadow: "0 2px 12px rgba(0, 0, 0, 0.08)",
          border: "1px solid #e9ecef",
        }}
      >
        <Button
          variant="outline-primary"
          onClick={() => navigate("/dashboard")}
          style={{
            borderRadius: "10px",
            width: 40,
            height: 40,
            border: "2px solid #2E57A7",
            color: "#2E57A7",
            backgroundColor: "#fff",
            transition: "all 0.3s ease",
            padding: 0,
            marginRight: 16,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
          }}
          onMouseEnter={(e) => {
            e.target.style.backgroundColor = "#2E57A7";
            e.target.style.color = "#fff";
            e.target.style.transform = "translateY(-2px)";
            e.target.style.boxShadow = "0 4px 12px rgba(46, 87, 167, 0.3)";
          }}
          onMouseLeave={(e) => {
            e.target.style.backgroundColor = "#fff";
            e.target.style.color = "#2E57A7";
            e.target.style.transform = "translateY(0)";
            e.target.style.boxShadow = "none";
          }}
        >
          {" "}
          <BsArrowLeft size={16} />{" "}
        </Button>{" "}
        <Stack direction="row" spacing={2} alignItems="center">
          <Typography
            sx={{
              fontWeight: 600,
              color: "#2E57A7",
              fontSize: "1.3rem",
              lineHeight: 1.3,
            }}
          >
            {t("Vessel Application Details")}
          </Typography>

          {id && (
            <Box
              sx={{
                background: "linear-gradient(135deg, #e3f2fd, #f3e5f5)",
                borderRadius: "8px",
                padding: "6px 12px",
                border: "1px solid #bbdefb",
              }}
            >
              <Typography
                sx={{ color: "#1976d2", fontSize: "0.9rem", fontWeight: 600 }}
              >
                {id}
              </Typography>
            </Box>
          )}
        </Stack>
      </Box>

      {/* Tabs */}
      <DynamicTabs tabs={tabs} />
    </Box>
  );
};

export default VesselApplicationDetailsView;

import React, { useState, useRef, useCallback } from "react";
import { Button } from "@mui/material";
import { FaArrowLeft } from "react-icons/fa";
import { useNavigate, useLocation } from "react-router-dom";
import Stepper from "../../../common/Stepper";
import NameChange from "./NameChange";
import Invoicing from "../../../common/Invoicing";
import styles from './ApplicationDetailsUpdate.module.css';

const ApplicationDetailsUpdate = () => {
  const navigate = useNavigate();
  const location = useLocation();
  const stepperRef = useRef();
  const selectedOption = location.state?.selectedOption || "";
  
  const [isValid, setIsValid] = useState(false);
  const [formData, setFormData] = useState({});

  const mockPaymentData = {
    summary: {
      subTotal: 1000,
      cgst: 90,
      sgst: 90,
      igst: 0,
      totalPayable: 1180
    },
    invoiceBreakupInfo: [
      {
        id: 1,
        categoryHeader: "Registration Charges",
        label: "Application processing fee",
        amount: 500
      },
      {
        id: 2,
        categoryHeader: "Documentation Charges",
        label: "Certificate issuance fee",
        amount: 300
      },
      {
        id: 3,
        categoryHeader: "Processing Fees",
        label: "Administrative charges",
        amount: 200
      }
    ]
  };

  const handleValidationChange = useCallback((valid) => {
    setIsValid(valid);
  }, []);

  const handleDataChange = useCallback((data) => {
    setFormData(data);
  }, []);

  const validateStep = () => {
    return isValid;
  };

  const getFormData = () => {
    return formData;
  };

  const handleSaveAndNext = (stepInfo) => {
    console.log("Saving step data:", stepInfo);
    if (stepperRef.current) {
      stepperRef.current.goToNextStep();
    }
  };

  const handlePayNow = () => {
    console.log("Proceeding to payment...");
    // Add payment logic here
  };

  const steps = [
    {
      label: "Registration Information",
      component: (
        <NameChange 
          selectedOption={selectedOption}
          onValidationChange={handleValidationChange}
          onDataChange={handleDataChange}
        />
      ),
      validate: validateStep,
      getFormData: getFormData,
      showSavaAndNextButton: true,
      hasActions: true
    },
    {
      label: "Invoicing",
      component: (
        <Invoicing
          supervisionAuthority="iwt"
          onPayNow={handlePayNow}
          paymentData={mockPaymentData}
        />
      ),
      validate: () => true,
      getFormData: () => ({}),
      showPayBtn: true
    }
  ];

  return (
    <div className={styles.container}>
      <div className={styles.header}>
        <Button
          startIcon={<FaArrowLeft />}
          onClick={() => navigate(-1)}
          className={styles.backButton}
        >
        </Button>
        <h5 className={styles.title}>
          Application Details Update 
          {/* - {selectedOption} */}
        </h5>
        <div className={styles.applicationId}>
          WB-IWT/REG/2025/302748
        </div>
      </div>
      
      <Stepper
        ref={stepperRef}
        steps={steps}
        onSyncData={handleSaveAndNext}
        onPayNow={handlePayNow}
        viewMode={true}
        editMode={false}
        initialStep={0}
      />
    </div>
  );
};

export default ApplicationDetailsUpdate;
