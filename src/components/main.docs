// Apply date sorting
if (dateSort !== "none") {
  filteredData.sort((a, b) => {
    // Function to extract and parse date from object
    const getDate = (obj) => {
      // Try these possible date fields in order
      const dateFields = ['dateSubmitted', 'createdAt', 'date', 'submissionDate', 'timestamp'];
      
      for (const field of dateFields) {
        if (obj[field]) {
          const date = new Date(obj[field]);
          if (!isNaN(date.getTime())) {
            return date;
          }
        }
      }
      
      // If no valid date found, return minimum date (will sort to end)
      return new Date(0);
    };

    const dateA = getDate(a);
    const dateB = getDate(b);

    // For newest first (descending) - show recent dates first
    if (dateSort === "desc") {
      return dateB - dateA; // Newest at top
    }
    // For oldest first (ascending) - show oldest dates first
    else {
      return dateA - dateB; // Oldest at top
    }
  });
}





/////
const DateSortDropdown = () => (
  <Dropdown className="ms-2">
    <Dropdown.Toggle 
      variant="outline-secondary" 
      id="date-sort-dropdown"
      className="d-flex align-items-center"
    >
      <i className="fa fa-calendar me-2" />
      {dateSort === "none" ? "Sort by Date" : 
       dateSort === "asc" ? "Oldest First" : "Newest First"}
    </Dropdown.Toggle>
    <Dropdown.Menu className="dropdown-menu-end">
      <Dropdown.Item 
        onClick={() => setDateSort("desc")} 
        active={dateSort === "desc"}
        className="d-flex align-items-center"
      >
        <i className={`fa fa-arrow-down me-2 ${dateSort === "desc" ? "text-primary" : ""}`} />
        Newest First
        {dateSort === "desc" && <i className="fa fa-check ms-2" />}
      </Dropdown.Item>
      <Dropdown.Item 
        onClick={() => setDateSort("asc")} 
        active={dateSort === "asc"}
        className="d-flex align-items-center"
      >
        <i className={`fa fa-arrow-up me-2 ${dateSort === "asc" ? "text-primary" : ""}`} />
        Oldest First
        {dateSort === "asc" && <i className="fa fa-check ms-2" />}
      </Dropdown.Item>
      <Dropdown.Divider />
      <Dropdown.Item 
        onClick={() => setDateSort("none")} 
        active={dateSort === "none"}
        className="d-flex align-items-center"
      >
        <i className="fa fa-times me-2" />
        Clear Sort
      </Dropdown.Item>
    </Dropdown.Menu>
  </Dropdown>
);
