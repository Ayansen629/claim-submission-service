/* General Styles */
:root {
  --primary-color: #269ccc;
  --primary-dark: #076C75;
  --secondary-color: #09828D;
  --text-color: #333;
  --light-gray: #f9f9f9;
  --medium-gray: #e0e0e0;
  --dark-gray: #777;
  --white: #ffffff;
  --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  color: var(--text-color);
  background-color: #f5f7fa;
  margin: 0;
  padding: 0;
  min-height: 100vh;
}

.container-fluid {
  width: 100%;
  padding: 0 15px;
  margin: 0 auto;
  box-sizing: border-box;
}

/* Header Styles */
.dashboard-header {
  margin-bottom: 2rem;
  padding: 1rem 0;
  border-bottom: 1px solid var(--medium-gray);
}

.mb-2.text-center {
  font-size: 2rem;
  font-weight: 600;
  color: var(--primary-color);
  letter-spacing: 0.5px;
  margin: 1rem 0;
  text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1);
}

/* Card Styles */
.card {
  border: none;
  border-radius: 8px;
  box-shadow: var(--shadow);
  margin-bottom: 1.5rem;
  background: var(--white);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
}

.card-header {
  background-color: var(--primary-color);
  color: var(--white);
  font-weight: 600;
  border-radius: 8px 8px 0 0 !important;
  padding: 1rem 1.25rem;
  border-bottom: none;
}

.card-body {
  padding: 1.5rem;
}

/* Professional Table Styles */
.table-responsive {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  margin-bottom: 1rem;
  position: relative;
}

.table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 0.9rem;
  min-width: 600px;
}

.table th {
  position: sticky;
  top: 0;
  z-index: 10;
}

.table th,
.table td {
  padding: 12px 15px;
  text-align: left;
  vertical-align: middle;
  border-bottom: 1px solid var(--medium-gray);
}

.table thead th {
  background-color: var(--primary-color);
  color: var(--white);
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.8rem;
  letter-spacing: 0.5px;
}

.table tbody tr {
  transition: background-color 0.2s ease;
}

.table tbody tr:nth-child(even) {
  background-color: var(--light-gray);
}

.table tbody tr:hover {
  background-color: rgba(38, 156, 204, 0.05);
}

.table tbody tr:last-child td {
  border-bottom: none;
}

/* Status Badges */
.badge {
  padding: 6px 10px;
  font-weight: 500;
  font-size: 0.75rem;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.badge-success {
  background-color: #d4edda;
  color: #155724;
}

.badge-warning {
  background-color: #fff3cd;
  color: #856404;
}

.badge-danger {
  background-color: #f8d7da;
  color: #721c24;
}

/* Button Styles */
.btn {
  font-weight: 500;
  padding: 8px 16px;
  border-radius: 6px;
  transition: all 0.2s ease;
  font-size: 0.85rem;
  letter-spacing: 0.3px;
  white-space: nowrap;
}

.btn-primary {
  background-color: var(--primary-color);
  border-color: var(--primary-color);
}

.btn-primary:hover {
  background-color: var(--primary-dark);
  border-color: var(--primary-dark);
  transform: translateY(-1px);
}

.btn-outline-primary {
  color: var(--primary-color);
  border-color: var(--primary-color);
}

.btn-outline-primary:hover {
  background-color: var(--primary-color);
  color: var(--white);
}

/* Action Buttons */
.btn-sm {
  padding: 5px 10px;
  font-size: 0.75rem;
}

.btn-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

/* Pagination Styles */
.pagination {
  display: flex;
  justify-content: center;
  list-style: none;
  padding: 1rem 0;
  margin: 0;
}

.pagination .page-item {
  margin: 0 3px;
}

.pagination .page-link {
  padding: 8px 14px;
  font-size: 0.85rem;
  color: var(--secondary-color);
  text-decoration: none;
  border: 1px solid var(--medium-gray);
  border-radius: 6px;
  transition: all 0.2s ease;
  min-width: 38px;
  text-align: center;
}

.pagination .page-link:hover {
  background-color: var(--light-gray);
  border-color: var(--medium-gray);
}

.pagination .active .page-link {
  background-color: var(--secondary-color);
  color: var(--white);
  border-color: var(--secondary-color);
}

.pagination .disabled .page-link {
  color: var(--dark-gray);
  pointer-events: none;
  background-color: var(--light-gray);
}

/* Custom Scrollbars */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--light-gray);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb {
  background: var(--primary-color);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--primary-dark);
}

/* For Firefox */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--primary-color) var(--light-gray);
}

/* Loader Styles */
.loader-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background-color: rgba(255, 255, 255, 0.8);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.loader {
  border: 4px solid rgba(38, 156, 204, 0.1);
  border-top: 4px solid var(--primary-color);
  border-radius: 50%;
  width: 40px;
  height: 40px;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Form Controls */
.form-control {
  border-radius: 6px;
  padding: 8px 12px;
  border: 1px solid var(--medium-gray);
  transition: border-color 0.2s ease;
}

.form-control:focus {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 0.2rem rgba(38, 156, 204, 0.25);
}

/* Utility Classes */
.d-flex {
  display: flex;
}

.mr-2 {
  margin-right: 0.5rem;
}

.mb-3 {
  margin-bottom: 1rem;
}

/* Modal Styles */
.modal-1110w {
  max-width: 1110px;
}

.modal-content {
  border-radius: 10px;
  border: none;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
}

.white-icon {
  filter: brightness(0) invert(1);
}

.black-icon {
  filter: brightness(0) invert(0);
}

/* Preview Card */
.preview-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 1.25rem;
  border: 1px solid var(--medium-gray);
  border-radius: 8px;
  background-color: var(--white);
  box-shadow: var(--shadow);
}

.preview-card h6 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  color: var(--primary-color);
}

.preview-card p {
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
  color: var(--text-color);
}

/* Timeline Styles */
.timeline-container {
  position: relative;
  margin-left: 20px;
  padding-left: 20px;
  border-left: 2px solid var(--medium-gray);
}

.timeline-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20px;
  position: relative;
}

.timeline-icon {
  position: absolute;
  left: -26px;
  top: 2px;
  background: var(--white);
  padding: 6px;
  border-radius: 50%;
  border: 2px solid var(--medium-gray);
  font-size: 1rem;
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
}

.timeline-content {
  padding-left: 20px;
  background: var(--white);
  padding: 12px 15px;
  border-radius: 6px;
  box-shadow: var(--shadow);
  width: 100%;
}

.timeline-date {
  font-size: 0.75rem;
  color: var(--dark-gray);
  margin-bottom: 5px;
}

.timeline-title {
  font-weight: 600;
  margin-bottom: 5px;
  color: var(--primary-color);
}

.timeline-description {
  font-size: 0.85rem;
  color: var(--text-color);
}

/* Responsive Adjustments */
@media (max-width: 1199.98px) {
  .modal-1110w {
    max-width: 95%;
  }
}

@media (max-width: 991.98px) {
  .mb-2.text-center {
    font-size: 1.75rem;
  }
  
  .card-body {
    padding: 1.25rem;
  }
  
  .table th,
  .table td {
    padding: 10px 12px;
  }
}

@media (max-width: 767.98px) {
  .container-fluid {
    padding: 0 10px;
  }
  
  .mb-2.text-center {
    font-size: 1.5rem;
  }
  
  .row {
    flex-direction: column;
  }
  
  .col-md-6, .col-md-4, .col-md-2 {
    margin-bottom: 1rem;
    width: 100%;
  }
  
  .d-flex {
    flex-direction: column;
  }
  
  .mr-2 {
    margin-right: 0;
    margin-bottom: 0.5rem;
  }
  
  .table-responsive {
    border: 1px solid var(--medium-gray);
    border-radius: 6px;
  }
  
  .pagination .page-link {
    padding: 6px 10px;
    min-width: 32px;
  }
}

@media (max-width: 575.98px) {
  .mb-2.text-center {
    font-size: 1.3rem;
  }
  
  .card-header {
    padding: 0.75rem 1rem;
  }
  
  .card-body {
    padding: 1rem;
  }
  
  .btn {
    padding: 6px 12px;
    font-size: 0.8rem;
  }
  
  .pagination .page-item {
    margin: 0 2px;
  }
  
  .pagination .page-link {
    padding: 4px 8px;
    min-width: 28px;
    font-size: 0.75rem;
  }
}
