not need to remove others code
import React, { useState, useEffect } from "react";
import {
    Card,
    Button,
    Container,
    Row,
    Col,
    Spinner,
    Image,
} from "react-bootstrap";
import { useParams, useNavigate, useLocation,useSearchParams } from "react-router-dom";
import { IconButton, Typography, Tooltip } from "@mui/material";
import {
    ArrowBack,
    CheckCircleOutline,
    ErrorOutline,
    FileDownload,
    Close as CloseIcon,
} from "@mui/icons-material";

import logo from "../../assets/images/IWT_Icon.jpg";
import "./styles/PaymentPage.css";
import { postData } from "../../services/http.service.ts";
import { SERVICE_BASE, URLS_ENDPOINT } from "../../utils/urlsConstants.ts";
import { toast } from "react-toastify";

const PaymentPage = () => {
    const { invoiceId } = useParams();
    const navigate = useNavigate();
    const location = useLocation();
    const [status, setStatus] = useState(null);
    const [loading, setLoading] = useState(false);

    const paymentData = location.state?.paymentData;
    const applicationNumber = location.state?.applicationNumber || invoiceId;
    const fullPaymentData = location.state?.fullPaymentData?.data;

    console.log(fullPaymentData, "PAYMENTData");

     const [searchParams] = useSearchParams();
 
  useEffect(() => {
    const status = searchParams.get('status');
    // const transactionId = searchParams.get('txnId');
 
    if (status === 'SUCCESS') {
      console.log('Payment was successful!');
      setStatus("success");
    } else {
      console.log('Payment failed or cancelled.');
      setStatus("error");
    }
  }, [searchParams]);

  

    const formatCurrency = (amount) => {
        return new Intl.NumberFormat('en-IN', {
            style: 'currency',
            currency: 'INR',
            minimumFractionDigits: 2
        }).format(amount);
    };

    const handlePayment = async () => {
        if (!fullPaymentData) {
            toast.error("Payment data not available");
            return;
        }

        setLoading(true);
        try {
            const payload = {
                // calculation: {
                    // totalAmount: fullPaymentData.totalAmount,
                    // totalAmountAtergst: fullPaymentData.totalAmountAtergst,
                    // cgst: fullPaymentData.cgst,
                    // igst: fullPaymentData.igst,
                    // sgst: fullPaymentData.sgst,
                    // billtype: fullPaymentData.billtype,
                    // applicationNumber: fullPaymentData.applicationNumber,
                    // applicationUuid: fullPaymentData.applicationUuid,
                    // feesDetailsl: fullPaymentData.feesDetailsl
                // }
                calculation:fullPaymentData
            };

            const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.VESSEL_SERVICE.PAYMENT_FEES;
            const response = await postData(apiUrl, payload);
                        if (response?.status === 200 && response?.data?.data?.paymentStatusUrl) {
                const paymentUrl = response.data.data.paymentStatusUrl;
                
                // Check if it's a relative path or full URL
                if (paymentUrl.startsWith('http')) {
                    window.location.href = paymentUrl;
                } else {
                    // Handle relative path - navigate within app
                    navigate(`/${paymentUrl}`);
                }
            } else {
                setStatus("error");
                toast.error("Payment failed. Please try again.");
            }
            // if (response?.status === 200 && response?.data?.data?.paymentStatusUrl) {
            //     window.location.href = response.data.data.paymentStatusUrl;
            // } else {
            //     setStatus("error");
            //     toast.error("Payment failed. Please try again.");
            // }

            // if (response?.status === 200) {
            //     setStatus("success");
            //     toast.success("Payment processed successfully!");
            // } else {
            //     setStatus("error");
            //     toast.error("Payment failed. Please try again.");
            // }
        } catch (error) {
            console.error("Payment error:", error);
            setStatus("error");
            toast.error("Payment failed. Please try again.");
        } finally {
            setLoading(false);
        }
    };

    const handleDownloadReceipt = () => {
        const receiptContent = `
       Registration Number: ${applicationNumber}
    Status: Paid
   Amount: ${paymentData ? formatCurrency(paymentData.summary.totalPayable) : '₹2,500'}
        Date: ${new Date().toLocaleDateString()}
        `;
        const blob = new Blob([receiptContent], { type: "text/plain" });
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = `receipt_${applicationNumber}.txt`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };

    const goHome = () => {
        navigate("/dashboard");
    };

    return (
        <Card
            fluid
            className="py-4 payment-card"
            style={{ background: "transparent", minHeight: "100vh" }}
        >
            <Row className="mb-3 px-3 align-items-center">
                <Col xs="auto">
                    <Tooltip title="Back to Dashboard">
                        <IconButton
                            onClick={goHome}
                            sx={{ backgroundColor: "#2466BF", color: "#fff" }}
                        >
                            <ArrowBack />
                        </IconButton>
                    </Tooltip>
                </Col>
                <Col className="d-flex align-items-center">
                    <h4 className="m-0 fw-bold">
                        Registration{" "}
                        <strong style={{ color: "#2466BF", fontWeight: 700 }}>
                            #{applicationNumber}
                        </strong>
                    </h4>
                </Col>
            </Row>

            <Row className="justify-content-center">
                <Col xs={12} md={8} lg={6}>
                    <Card
                        className="rounded-4 border-0 p-4"
                        style={{
                            boxShadow: "0 12px 28px rgba(0, 0, 0, 0.1)",
                            background: "#ffffff",
                        }}
                    >
                         {/* Header Row: Logo Left + Centered Title */}
                        <div
                            className="position-relative mb-4 pb-3"
                            style={{
                                borderBottom: "1px solid #e0e0e0",
                            }}
                        >
                            <div className="d-flex align-items-center">
                                <Image
                                    src={logo}
                                    alt="IWT Logo"
                                    height={50}
                                    style={{ objectFit: "contain" }}
                                />
                            </div>
                            <Typography
                                variant="h6"
                                className="text-center position-absolute top-50 start-50 translate-middle"
                                sx={{
                                    color: "#2466BF",
                                    fontWeight: 700,
                                    fontSize: "1.3rem",
                                }}
                            >
                                Secure Payment Portal
                            </Typography>
                        </div>

                        <div className="text-center">
                            {status !== "success" && (
                                <Typography variant="body2" color="text.secondary">
                                    Complete your payment for registration{" "}
                                    <strong style={{ color: "#2466BF", fontWeight: 700 }}>
                                        #{applicationNumber}
                                    </strong>
                                </Typography>
                            )}
                        </div>

                        {status === "success" && (
                            <div className="text-center fade-in-up">
                                <CheckCircleOutline sx={{ fontSize: 70, color: "green" }} />
                                <Typography variant="h5" className="mt-3 fw-bold text-success">
                                    Payment Successful!
                                </Typography>
                                <Typography className="text-muted">
                                    Thank you! Your registration payment has been completed successfully.
                                </Typography>
                                <div className="d-flex mt-3 justify-content-center gap-3 flex-wrap">
                                    <Button variant="success" onClick={handleDownloadReceipt}>
                                        <FileDownload className="me-2" />
                                        Download Receipt
                                    </Button>
                                    <Button variant="outline-danger" onClick={goHome}>
                                        <CloseIcon className="me-2" />
                                        Close
                                    </Button>
                                </div>
                            </div>
                        )}

                        {status === "error" && (
                            <div className="text-center py-4 fade-in-up">
                                <ErrorOutline sx={{ fontSize: 70, color: "red" }} />
                                <Typography variant="h5" className="mt-3 fw-bold text-danger">
                                    Payment Failed
                                </Typography>
                                <Typography className="text-muted mb-3">
                                    Oops! Something went wrong. Please try again.
                                </Typography>
                                <Button variant="danger" onClick={() => setStatus(null)}>
                                    Retry Payment
                                </Button>
                            </div>
                        )}

                        {!status && (
                            <>
                                <Typography
                                    variant="body1"
                                    align="center"
                                    className="text-muted mt-2 mb-4"
                                >
                                    Amount Due: <strong>
                                        {paymentData ? formatCurrency(paymentData.summary.totalPayable) : '₹2,500'}
                                    </strong>
                                </Typography>
                                <Button
                                    variant="primary"
                                    className="w-100 py-2"
                                    style={{ backgroundColor: "#2466BF", border: "none" }}
                                    onClick={handlePayment}
                                    disabled={loading}
                                >
                                    {loading ? (
                                        <>
                                            <Spinner animation="border" size="sm" className="me-2" />
                                            Processing Payment...
                                        </>
                                    ) : (
                                        "Pay Now"
                                    )}
                                </Button>
                            </>
                        )}
                    </Card>
                </Col>
            </Row>
        </Card>
    );
};

export default PaymentPage;
// import Registration from '../components/private/Registration';
import Service from "../components/private/Service";
import RedirectUrlScreen from "./RedirectUrlScreen";

import Login from "../components/public/user-login/Login";
import RegisterRouter from "./RegisterRouter";
import RegistrationForm from "../components/public/user-registration/FormPage";
import UserReg from "../components/public/user-registration/userReg";
import UserManagement from "../components/private/masters/employee-management/userManagement";
import IWTHomePage from "../components/public/IWTHomePage";
import VesselMainPage from ".././components/private/vessel-registration/vessel-legacy-data/VesselMainPage.js";
import VesselMainForm from "../components/private/vessel-registration/vessel-legacy-data/VesselMainForm.js";
import VesselFormSuccess from "../components/private/vessel-registration/vessel-legacy-data/VesselFormSuccess.js";
import Dashboard from "../components/private/dashboard/Dashboard.js";
import NewVesselRegistration from "../components/private/vessel-registration/new-vessel/NewVesselRegistration.js";
import Employee from "../components/private/employee/employee.js";
import Employeequicksearch from "../components/private/employee/Employeequicksearch.jsx";

import EmployeeRegistration from "../components/private/masters/employee-management/EmployeeRegistration.js";

import UserViewPage from "../components/private/employee/user-registrationview/userViewPage.js";
import UserRegDashboard from "../components/private/employee/user-registrationview/userRegDashboard.js";
import NewVesselRegistrationSuccess from "../components/private/vessel-registration/new-vessel/newVesselRegistrationSuccess.js";
import ReportsDashboard from "../components/private/vessel-registration/new-vessel/common/reports/reportsDashboard.js";
import VesselReportsAndDocs from "../components/private/vessel-registration/new-vessel/common/VesselReportsAndDocs.js";

import VesselSurveyRegistration from "../components/private/vessel-registration/new-vessel/survey/VesselSurveyRegistration.js";
import PaymentPage from "../components/common/PaymentPage.js";
import paymentStatus from "../components/common/paymentStatus.js";

// import Profile from '../components/private/settings/Profile.jsx';

export const publicRoutes = [
  { path: "/", component: IWTHomePage, name: "HomePage" },
  { path: "/login", component: Login, name: "Login" },
  { path: "/registration-form", component: RegistrationForm, name: "FormPage" },
  { path: "/user-registration", component: UserReg, name: "UserRegistration" },
  {
    path: "/iwt/register",
    component: RegisterRouter,
    name: "DynamicRegistration",
  },
  { path: "*", component: RedirectUrlScreen },
];

export const privateRoutes = [
  { path: "/dashboard", component: Dashboard, name: "Dashboard" },
  {
    path: "/dashboard/employee-dashboard",
    component: Employee,
    name: "EmployeeDashboard",
  },
  {
    path: "/dashboard/employee-dashboard/employee-applications",
    component: Employeequicksearch,
    name: "Employeequicksearch",
  },
  {
    path: "/vessel-registration/new-vessel",
    component: NewVesselRegistration,
    name: "New Vessel Registration",
  },
  {
    path: "/vessel-registration/upload-legacy-data",
    component: VesselMainPage,
    name: "Vessel Dashboard",
  },
  { path: "/registration", component: VesselMainForm, name: "Registration" },
  {
    path: "/employee-registration",
    component: EmployeeRegistration,
    name: "employee-registration",
  },
  {
    path: "/employee-registration/edit/:id",
    component: EmployeeRegistration,
    name: "employee-registration",
  },
  { path: "/services", component: Service, name: "Services" },
  {
    path: "/registration-success",
    component: VesselFormSuccess,
    name: "RegistrationSuccess",
  },
  {
    path: "/registration/edit/:id",
    component: VesselMainForm,
    name: "RegistrationEdit",
  },
  {
    path: "/vessel-registration/new-vessel/edit/:id",
    component: NewVesselRegistration,
    name: "New Vessel Registration Edit",
  },

  {
    path: "/vessel-registration/new-vessel/view/:id",
    component: NewVesselRegistration,
    name: "New Vessel Registration Edit",
  },
  {
    path: "/new-vessel/registration-success",
    component: NewVesselRegistrationSuccess,
    name: "NewVesselRegistrationSuccess",
  },
  {
    path: "/iwt/employee-management",
    component: UserManagement,
    name: "EmployeeManagement",
  },
  {
    path: "/user-registration/view",
    component: UserRegDashboard,
    name: "UserRegistrationViewPagse",
  },
  {
    path: "/user-dashboard/:type/:id",
    component: UserViewPage,
    name: "UserRegistrationDashboard",
  },
  { path: "/user-reports", component: ReportsDashboard, name: "UserReports" },

  {
    path: "/vessel-registration/new-vessel/reports-and-forms/:id",
    component: VesselReportsAndDocs,
    name: "New Vessel Forms & Docs",
  },
  {
    path: "/apply-vessel-survey",
    component: VesselSurveyRegistration,
    name: "Vessel-survey",
  },

// http://localhost:3000/payment?status=SUCCESS&txnId=f1f640c1-3b2e-4061-916f-c3b2adaf0e4d
