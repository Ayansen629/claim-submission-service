/* employeeDashboard.css additions */

/* Card Container */
.row.g-3 {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch; /* Make cards equal height */
}

.row.g-3 > [class*="col-"] {
  display: flex;
  height: auto;
}

/* Base Card Styling */
.status-card {
  height: 100%;
  min-height: 220px;
  width: 100%;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  background: #fff;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* Left Border Color Fix */
.status-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background-color: inherit;
}

/* Responsive Adjustments */
@media (max-width: 992px) {
  .survey-tracker-card {
    grid-column: span 1;
  }
  
  .status-card {
    min-height: 200px;
  }
}

@media (max-width: 768px) {
  .status-card {
    min-height: 180px;
  }
}
