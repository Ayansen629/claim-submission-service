import React from "react";
import { Dropdown, ButtonGroup, Button } from "react-bootstrap";
import { Tooltip } from "react-tooltip";
import "../common/styles/ActionDropdown.css";

import {
  FaCheck,
  FaTimes,
  FaEdit,
  FaTrash,
  FaEye,
  FaDownload,
  FaInfoCircle,
  FaArrowCircleLeft,
  FaArrowCircleRight,
} from "react-icons/fa";

const getIconForAction = (action) => {
  if (!action) return <FaInfoCircle className="drop-icon" />;
  const act = action?.toLowerCase();
  switch (true) {
    case act?.includes("approve"):
      return <FaCheck className="drop-icon" />;
    case act?.includes("sendback") ||
      act?.includes("back") ||
      act?.includes("return"):
      return <FaArrowCircleLeft className="drop-icon" />;
    case act?.includes("forward") || act?.includes("next"):
      return <FaArrowCircleRight className="drop-icon" />;
    case act?.includes("reject") || act?.includes("decline"):
      return <FaTimes className="drop-icon" />;
    case act?.includes("edit") || act?.includes("update"):
      return <FaEdit className="drop-icon" />;
    case act?.includes("delete") || act?.includes("remove"):
      return <FaTrash className="drop-icon" />;
    case act?.includes("view") || act?.includes("details"):
      return <FaEye className="drop-icon" />;
    case act?.includes("download"):
      return <FaDownload className="drop-icon" />;
    case act?.includes("info") || act?.includes("more"):
      return <FaInfoCircle className="drop-icon" />;
    default:
      return <FaInfoCircle className="drop-icon" />;
  }
};

const ActionDropdown = ({ actions, onActionClick }) => {
  return (
    <>
      <Dropdown as={ButtonGroup}>
        <Button 
          variant="dd-primary"
          data-tooltip-id="action-tooltip"
          data-tooltip-content="Select an action to perform on this item"
          style={{
            height: "32px",
            minWidth: "80px",
            maxWidth: "80px",
            fontSize: "0.75rem",
            fontWeight: "600",
            padding: "6px 8px",
            textTransform: "none",
            borderTopRightRadius: "0",
            borderBottomRightRadius: "0",
          }}
        >
          Take Action
        </Button>
        <Dropdown.Toggle 
          split 
          variant="dd-primary" 
          id="dropdown-split-basic"
          style={{
            height: "32px",
            minWidth: "20px",
            maxWidth: "20px",
            padding: "6px 4px",
            borderTopLeftRadius: "0",
            borderBottomLeftRadius: "0",
          }}
        />

        <Dropdown.Menu className="dd-primary-menu show-fade">
          {actions?.map((action, idx) => (
            <Dropdown.Item
              key={idx}
              className="dd-primary-item"
              onClick={() => onActionClick(action)}
            >
              {getIconForAction(action?.actionName)} {action?.actionName}
            </Dropdown.Item>
          ))}
        </Dropdown.Menu>
      </Dropdown>
      
      <Tooltip 
        id="action-tooltip" 
        place="top"
        style={{
          backgroundColor: "#333",
          color: "#fff",
          fontSize: "0.75rem",
          padding: "4px 8px",
          borderRadius: "4px",
          zIndex: 9999
        }}
      />
    </>
  );
};

export default ActionDropdown;
