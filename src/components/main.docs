const handleFileChange = async (e) => {
  const file = e?.target?.files[0];
  if (!file) return;

  const maxSize = 10 * 1024 * 1024;
  if (file.size > maxSize) {
    toast.error("File size must be less than or equal to 10 MB.");
    e.target.value = null;
    return;
  }

  setUploading(true);

  try {
    const formData = new FormData();
    formData.append("file", file);

    const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
    const response = await postFORMdata(uploadUrl, formData);

    console.log("File upload response:", response);

    const fileStoreId = response?.data?.files[0]?.fileStoreId;

    // Get file extension
    const fileExtension = file.name.substring(file.name.lastIndexOf('.'));
    
    // Create display name with report type and extension
    const reportDisplayName = getReportDisplayName(reportType)
      .toLowerCase()
      .replace(/\s+/g, ''); // Remove spaces and convert to lowercase
    const displayFileName = `${reportDisplayName}${fileExtension}`;

    setUploadedFile({ name: displayFileName, url: fileStoreId });
    setValue("file", fileStoreId);
    toast.success("File uploaded successfully!");
  } catch (err) {
    console.error("File upload failed:", err);
    console.log("Error details:", err.response || err.message);
    toast.error("File upload failed. Please try again.");
    setUploadedFile(null);
    e.target.value = null;
  } finally {
    setUploading(false);
  }
};
