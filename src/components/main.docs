<Offcanvas.Header 
  closeButton 
  className="text-white border-0 position-relative"
  style={{ 
    background: "linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%)",
    padding: "1rem 1.5rem"
  }}
>
  <Offcanvas.Title className="fw-bold d-flex align-items-center">
    <BsSticky className="me-2" size={20} />
    {t("Note Sheet")}
  </Offcanvas.Title>
  
  {/* Mobile Close Button */}
  <Button
    variant="light"
    size="sm"
    className="d-md-none position-absolute"
    style={{
      right: "1rem",
      top: "50%",
      transform: "translateY(-50%)",
      padding: "4px 8px",
      fontSize: "0.7rem",
      borderRadius: "4px"
    }}
    onClick={onHide}
  >
    {t("Close")}
  </Button>
</Offcanvas.Header>
