import React, { useState, useEffect } from "react";
import { createRoot } from 'react-dom/client'

export const ToastTop = ({ targetId, duration, message, type }) => {
    const toastClasses = ['toast', 'align-items-center', 'text-white',
        'border-0', 'position-absolute', 'notification', 'show'];
    toastClasses.push(type);
    
    console.log("render toast ...");
    useEffect(
        () => {
            console.log("toast set timeout ...");
            const timeout = setTimeout(() => {
                remove(targetId);
            }, duration * 1000);
            
            return () => {
                console.log("toast clear timeout ...");
                clearTimeout(timeout);
            };
        },
        [targetId, duration]
    );

    const remove = (id) => {
        const container = document.getElementById(id);
        if (container && container._reactRoot) {
            container._reactRoot.unmount();
            delete container._reactRoot;
        }
    }

    return (
        <div className={toastClasses.join(' ')}
            role="alert"
            aria-live="assertive"
            aria-atomic="true">
            <div className="d-flex">
                <div className="toast-body">
                    {message}
                </div>
                <button type="button" className="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close" onClick={(e) => remove(targetId)}></button>
            </div>
        </div>
    );
};

export const toast = {
    remove: (id) => {
        let comId = id || 'toast-container'
        let doc = document.getElementById(comId)
        if (doc && doc._reactRoot) {
            doc._reactRoot.unmount();
            delete doc._reactRoot;
        }
    },
    notify: (message, options = null) => {
        let duration = 5
        let targetId = "toast-container"
        let type = "bg-warning"
        
        if (options) {
            if (options.duration) {
                duration = options.duration
            }
            if (options.targetId) {
                targetId = options.targetId;
            }
            if (options.type === "error") {
                type = "bg-danger";
            }
        }
        
        const container = document.getElementById(targetId);
        if (!container) {
            console.error(`Toast container with id '${targetId}' not found`);
            return;
        }
        
        if (!container._reactRoot) {
            container._reactRoot = createRoot(container);
        }
        container._reactRoot.render(<ToastTop
            message={message}
            targetId={targetId}
            duration={duration}
            type={type}
             />);
    }
}

export const ToastsContainer = (props) => {
    let id = props.id || 'toast-container'
    return (
        <div id={id} className="toasts-container">
        </div>
    );
};
