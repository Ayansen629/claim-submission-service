.declaration-text {
  font-size: 1rem;
  line-height: 1.8;
  color: #333;
  text-align: justify;
  text-justify: inter-word;
}

.declaration-text p {
  margin-bottom: 1.2rem;
  word-spacing: 0.1em;
  hyphens: auto;
  -webkit-hyphens: auto;
  -ms-hyphens: auto;
}

.highlight-field {
  background: linear-gradient(120deg, #2466BF 0%, #1976d2 100%);
  color: white !important;
  padding: 1px 6px;
  border-radius: 3px;
  font-weight: bold !important;
  font-style: italic !important;
  display: inline;
  white-space: nowrap;
  word-break: keep-all;
}

.declaration-content {
  background: white;
  padding: 2rem;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  max-width: 100%;
  overflow-wrap: break-word;
}
