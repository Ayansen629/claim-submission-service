<div
  style={{
    position: "fixed",
    top: "20px",
    right: "20px",
    zIndex: 9999,
  }}
>
  <Dropdown>
    <Dropdown.Toggle
      variant="link"
      className="p-0 d-flex align-items-center gap-1"
      style={{
        color: "#fff",
        textDecoration: "none",
        fontSize: "1.5rem",
        backgroundColor: "rgba(15, 85, 178, 0.9)",
        padding: "12px",
        borderRadius: "8px",
        border: "2px solid rgba(255,255,255,0.3)",
        boxShadow: "0 4px 12px rgba(0,0,0,0.3)",
      }}
    >
      <FaGlobe />
    </Dropdown.Toggle>
    <Dropdown.Menu 
      className="language-dropdown-menu"
      style={{ 
        zIndex: 10000,
        position: "absolute",
        top: "100%",
        right: "0",
        marginTop: "8px",
        minWidth: "150px",
        boxShadow: "0 8px 25px rgba(0,0,0,0.15)",
        border: "1px solid rgba(0,0,0,0.1)",
        borderRadius: "8px",
      }}
    >
      <Dropdown.Item
        onClick={() => changeLanguage("en")}
        active={language === "en"}
        className="d-flex align-items-center gap-2"
      >
        <FiFlag size={18} style={{ color: "#2563eb" }} />
        <span>English</span>
        {language === "en" && (
          <FaCheck className="ms-auto text-success" />
        )}
      </Dropdown.Item>
      <Dropdown.Item
        onClick={() => changeLanguage("bn")}
        active={language === "bn"}
        className="d-flex align-items-center gap-2"
      >
        <GiIndiaGate size={18} style={{ color: "#f59e42" }} />
        <span>বাংলা</span>
        {language === "bn" && (
          <FaCheck className="ms-auto text-success" />
        )}
      </Dropdown.Item>
    </Dropdown.Menu>
  </Dropdown>
</div>
