import React, { useState } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFileAlt, FaFilePdf, FaFileImage } from "react-icons/fa";

const InputFile = ({
  label,
  required,
  name,
  register,
  errors,
  onChange,
  className = "",
  accept,
  disabled,
  style = {},
  clearErrors,
  setValue,
  trigger,
}) => {
  const [fileName, setFileName] = useState("");

  const hasError = errors?.[name];

  const handleChange = async (e) => {
    const file = e.target.files?.[0];
    if (file) {
      setFileName(file.name);
      if (onChange) onChange(e);
      setValue(name, e.target.files); // update RHF value
      await trigger(name); // re-validate this field
      clearErrors(name); // clear error if valid
    }
  };

  const getFileIcon = () => {
    if (!fileName) return <FaFile />;
    if (fileName.endsWith(".pdf")) return <FaFilePdf color="#dc3545" />;
    if (fileName.match(/\.(jpg|jpeg|png|gif)$/i)) return <FaFileImage color="#0077b6" />;
    return <FaFileAlt color="#6c757d" />;
  };

  const containerStyle = {
    borderRadius: "8px",
    border: `1px solid ${hasError ? "#dc3545" : "#dee2e6"}`,
    backgroundColor: hasError ? "#fff8f8" : "white",
    padding: "5px",
    transition: "all 0.2s",
    ...style,
  };

  return (
    <Form.Group controlId={name} className={`mb-3 ${className}`}>
      <Form.Label className="fw-semibold d-block">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      <div className="file-upload-container" style={containerStyle}>
        <input
          type="file"
          id={`file-${name}`}
          className="d-none"
          {...register}
          onChange={handleChange}
          accept={accept}
          disabled={disabled}
        />
        <div className="d-flex align-items-center">
          <label
            htmlFor={`file-${name}`}
            className="btn btn-outline-primary mb-0 d-inline-flex align-items-center"
            style={{ borderRadius: "6px", cursor: "pointer" }}
          >
            <FaUpload className="me-2" />
            <span>Choose File</span>
          </label>
          <div className="ms-3 d-flex align-items-center text-muted">
            {fileName ? (
              <>
                {getFileIcon()}
                <span className="ms-2 text-truncate" style={{ maxWidth: "200px" }}>
                  {fileName}
                </span>
              </>
            ) : (
              <span>No file chosen</span>
            )}
          </div>
        </div>
      </div>
      <div className="text-muted small mt-1">
        Upload PDF, JPG or PNG file (Max size: 2MB)
      </div>
      {hasError && (
        <Form.Text className="text-danger d-block mt-1">
          {errors[name]?.message || "Please select a valid file"}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
