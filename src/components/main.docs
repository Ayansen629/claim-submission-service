<Col md={4}>
  <InputText
    label={t("Revolution/mints")}
    name="detailsOfPropulsion.revolutionMints"
    type="number"
    placeholder={t("Enter Revolution/mints")}
    register={register("detailsOfPropulsion.revolutionMints")}
    errors={errors}
    disabled={viewMode}
  />
</Col>
<Col md={4}>
  <InputText
    label={t("No. of cylinders per set for Rotary Engine")}
    name="detailsOfPropulsion.cylindersRotary"
    type="number"
    placeholder={t("Enter No. of cylinders")}
    register={register("detailsOfPropulsion.cylindersRotary")}
    errors={errors}
    disabled={viewMode}
  />
</Col>
<Col md={4}>
  <InputText
    label={t("No. of cylinders per set for Reciprocating Engine")}
    name="detailsOfPropulsion.cylindersReciprocating"
    type="number"
    placeholder={t("Enter No. of cylinders")}
    register={register("detailsOfPropulsion.cylindersReciprocating")}
    errors={errors}
    disabled={viewMode}
  />
</Col>
<Col md={4}>
  <InputText
    label={t("No. of Shaft")}
    name="detailsOfPropulsion.numberOfShaft"
    type="number"
    placeholder={t("Enter No. of Shaft")}
    register={register("detailsOfPropulsion.numberOfShaft")}
    errors={errors}
    disabled={viewMode}
  />
</Col>
<Col md={4}>
  <InputText
    label={t("Length of the Engine Room")}
    name="detailsOfPropulsion.lengthEngineRoom"
    type="number"
    placeholder={t("Enter Length of Engine Room")}
    register={register("detailsOfPropulsion.lengthEngineRoom")}
    errors={errors}
    disabled={viewMode}
  />
</Col>
