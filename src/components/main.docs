// Update the getEnclosuresForUpdate function to handle mixed ID scenarios
const getEnclosuresForUpdate = (formValues, existingEnclosures = []) => {
  const newEnclosures = extractAllEnclosures(formValues);
  
  return newEnclosures.map(newEnc => {
    // Try to find existing enclosure by documentType and fileStoreId
    let existing = existingEnclosures.find(
      existing => existing.documentType === newEnc.documentType && 
                 existing.fileStoreId === newEnc.fileStoreId
    );
    
    // If not found by fileStoreId, try to find by documentType only
    if (!existing) {
      existing = existingEnclosures.find(
        existing => existing.documentType === newEnc.documentType
      );
    }
    
    return {
      ...newEnc,
      id: existing?.id || "",
      applicationNumber: existing?.applicationNumber || ""
    };
  });
};

// Update handleStepResponse to merge enclosures properly
const handleStepResponse = (response) => {
  if (response?.enclosers && response.enclosers.length > 0) {
    // Merge new enclosures with existing ones, preserving IDs
    const existingEnclosures = storedEnclosures.length > 0 
      ? storedEnclosures 
      : JSON.parse(sessionStorage.getItem('step1Enclosures') || '[]');
    
    const mergedEnclosures = response.enclosers.map(newEnc => {
      const existing = existingEnclosures.find(
        existing => existing.documentType === newEnc.documentType
      );
      
      return {
        ...newEnc,
        id: newEnc.id || existing?.id || ""
      };
    });
    
    setStoredEnclosures(mergedEnclosures);
    sessionStorage.setItem('step1Enclosures', JSON.stringify(mergedEnclosures));
  }
};
