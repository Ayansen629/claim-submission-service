// MyProfile.js
import React from "react";
import "./css/MyProfile.css";

const MyProfile = () => {
  const userFormData = JSON.parse(localStorage.getItem("userFormData")) || {};
  const isCRP = userFormData.userType === "CRP";
  const isCLM = userFormData.userType === "CLM";
  const userDetails = userFormData.userDetails || {};
  const corporateDebtor = userFormData.fullloginDetails?.users?.[0]?.corporateDebtor || {};

  return (
    <div className="profile-container">
      <div className="profile-header">
        <h1>My Profile</h1>
        <div className="profile-badge">
          {isCRP ? "Corporate Representative" : "Claimant"}
        </div>
      </div>

      <div className="profile-content">
        <div className="profile-picture">
          <div className="avatar">
            {isCRP 
              ? userDetails.companyName?.charAt(0)?.toUpperCase()
              : userDetails.claimantName?.charAt(0)?.toUpperCase()}
          </div>
        </div>

        <div className="profile-details">
          {isCRP && (
            <>
              <div className="detail-item">
                <span className="detail-label">Company Name:</span>
                <span className="detail-value">{userDetails.companyName || corporateDebtor.companyName}</span>
              </div>
              <div className="detail-item">
                <span className="detail-label">CIN Number:</span>
                <span className="detail-value">{userDetails.cinNumber || corporateDebtor.cinNumber}</span>
              </div>
              <div className="detail-item">
                <span className="detail-label">Email:</span>
                <span className="detail-value">{userDetails.emailId || corporateDebtor.emailId}</span>
              </div>
            </>
          )}

          {isCLM && (
            <>
              <div className="detail-item">
                <span className="detail-label">Name:</span>
                <span className="detail-value">{userDetails.claimantName}</span>
              </div>
              <div className="detail-item">
                <span className="detail-label">Email:</span>
                <span className="detail-value">{userDetails.emailId}</span>
              </div>
              <div className="detail-item">
                <span className="detail-label">Phone:</span>
                <span className="detail-value">{userDetails.mobileNumber}</span>
              </div>
            </>
          )}

          <div className="profile-actions">
            <button className="edit-button">Edit Profile</button>
            <button className="change-password-button">Change Password</button>
          </div>
        </div>
      </div>
    </div>
  );
};

export default MyProfile;

/* MyProfile.css */
.profile-container {
  max-width: 800px;
  margin: 2rem auto;
  padding: 2rem;
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.profile-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  border-bottom: 1px solid #eaeaea;
  padding-bottom: 1rem;
}

.profile-header h1 {
  font-size: 1.8rem;
  color: #2c3e50;
  margin: 0;
}

.profile-badge {
  background: #3498db;
  color: white;
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 600;
}

.profile-content {
  display: flex;
  gap: 3rem;
}

.profile-picture {
  flex: 0 0 150px;
}

.avatar {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  background: #3498db;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 4rem;
  font-weight: bold;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

.profile-details {
  flex: 1;
}

.detail-item {
  margin-bottom: 1.5rem;
}

.detail-label {
  display: block;
  font-size: 0.9rem;
  color: #7f8c8d;
  margin-bottom: 0.3rem;
  font-weight: 500;
}

.detail-value {
  display: block;
  font-size: 1.1rem;
  color: #2c3e50;
  padding: 0.5rem 0;
  border-bottom: 1px solid #f1f1f1;
}

.profile-actions {
  margin-top: 2rem;
  display: flex;
  gap: 1rem;
}

.edit-button, .change-password-button {
  padding: 0.7rem 1.5rem;
  border: none;
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.edit-button {
  background: #3498db;
  color: white;
}

.change-password-button {
  background: #f1f1f1;
  color: #2c3e50;
}

.edit-button:hover {
  background: #2980b9;
}

.change-password-button:hover {
  background: #e0e0e0;
}

@media (max-width: 768px) {
  .profile-content {
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .profile-picture {
    align-self: center;
  }
}
