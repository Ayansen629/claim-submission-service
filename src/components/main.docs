.sidebar {
  background: linear-gradient(135deg, #f4f8fc 0%, #e8f2ff 100%);
  color: #2466bf;
  height: calc(100vh - 70px);
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
  overflow: hidden;
  padding-top: 0;
  box-shadow: 0 4px 20px rgba(36, 102, 191, 0.15);
  border-right: 1px solid #d1e7ff;
  position: fixed;
  top: 70px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  will-change: width, transform;
  backdrop-filter: blur(10px);
}

.collapsed {
  width: 70px;
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
}

.expanded {
  width: 18rem;
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
}

.menu,
.submenuList {
  list-style: none;
  padding: 0;
  margin: 0;
}

.item {
  transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  margin: 2px 8px;
  border-radius: 12px;
  overflow: hidden;
  opacity: 1;
  transform: translateX(0);
}

.item.active > .link {
  background: linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%);
  color: white;
  font-weight: 600;
  box-shadow: 0 4px 15px rgba(36, 102, 191, 0.3);
  transform: translateX(4px);
}

.link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  border-radius: 12px;
  position: relative;
  overflow: hidden;
}

.link::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 1s ease-out;
}

.link:hover::before {
  left: 100%;
}

.link:hover {
  background: linear-gradient(135deg, #e1ecfb 0%, #d6e6f9 100%);
  transform: translateX(2px);
  box-shadow: 0 2px 10px rgba(36, 102, 191, 0.1);
  transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

.linkContent {
  display: flex;
  align-items: center;
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.icon {
  margin-right: 14px;
  font-size: 1.2rem;
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
}

.sidebar.collapsed .icon {
  margin-right: 0;
  transform: scale(1.1);
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.chevron {
  margin-left: auto;
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
  opacity: 1;
  transform: rotate(0deg) scale(1);
}

.chevron.rotate {
  transform: rotate(90deg) scale(1.1);
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
}

.sidebar.collapsed .chevron {
  opacity: 0;
  transform: scale(0);
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.submenu {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 8px;
  border-radius: 0 0 12px 12px;
  backdrop-filter: blur(5px);
  transform-origin: top;
  transform: scaleY(0);
  transition: all 1.2s cubic-bezier(0.23, 1, 0.32, 1);
}

.submenu.expanded {
  max-height: 600px;
  opacity: 1;
  transform: scaleY(1);
  overflow-y: auto;
  transition: all 1.4s cubic-bezier(0.23, 1, 0.32, 1);
  padding: 8px 0;
}

.submenu.collapsed {
  max-height: 0;
  opacity: 0;
  transform: scaleY(0);
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
}

.submenuList {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sublink {
  margin: 3px 12px;
  display: block;
  padding: 12px 20px;
  color: #2466bf;
  text-decoration: none;
  font-size: 0.9rem;
  border-radius: 10px;
  transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  position: relative;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-20px);
}

.sublink::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 3px;
  background: linear-gradient(135deg, #2466bf, #1a4fa0);
  transform: scaleY(0);
  transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}

.sublink:hover::before,
.sublink.active::before {
  transform: scaleY(1);
}

.sublink:hover {
  background: linear-gradient(135deg, rgba(36, 102, 191, 0.1) 0%, rgba(36, 102, 191, 0.05) 100%);
  color: #1a4fa0;
  transform: translateX(4px) translateY(0);
  box-shadow: 0 2px 8px rgba(36, 102, 191, 0.1);
  transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

.sublink.active {
  background: linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%);
  color: white;
  font-weight: 500;
  transform: translateX(4px) translateY(0);
  box-shadow: 0 3px 12px rgba(36, 102, 191, 0.3);
}

.backdrop {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(2px);
  opacity: 0;
  transition: opacity 0.6s ease;
}

.backdrop.show {
  opacity: 1;
}

.close {
  display: none;
  justify-content: flex-end;
  padding: 1rem;
}

.close svg {
  cursor: pointer;
  font-size: 1.5rem;
  color: #2466bf;
  transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}

.close svg:hover {
  color: #1a4fa0;
  transform: rotate(90deg);
}

@media (max-width: 768px) {
  .sidebar {
    position: fixed;
    top: 60px;
    left: 0;
    height: calc(100vh - 60px);
    width: 280px;
    z-index: 1000;
    transition: transform 1s cubic-bezier(0.23, 1, 0.32, 1);
    background: linear-gradient(135deg, #f4f8fc 0%, #e8f2ff 100%);
  }

  .sidebar.collapsed {
    transform: translateX(-100%);
    transition: transform 1s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .sidebar.expanded {
    transform: translateX(0);
    transition: transform 1s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .close {
    display: flex;
  }

  .menu {
    padding-bottom: 2rem;
  }
}

.menu {
  list-style: none;
  padding: 12px 0;
  margin: 0;
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
}

.menu::-webkit-scrollbar {
  width: 6px;
}

.menu::-webkit-scrollbar-track {
  background: rgba(36, 102, 191, 0.1);
  border-radius: 3px;
}

.menu::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, rgba(36, 102, 191, 0.4), rgba(36, 102, 191, 0.6));
  border-radius: 3px;
  transition: background 0.6s ease;
}

.menu::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(135deg, rgba(36, 102, 191, 0.6), rgba(36, 102, 191, 0.8));
}

.submenu.expanded::-webkit-scrollbar {
  width: 4px;
}

.submenu.expanded::-webkit-scrollbar-thumb {
  background: rgba(36, 102, 191, 0.3);
  border-radius: 2px;
}

.sidebar.collapsed .menu {
  overflow: hidden;
}

.link span:not(.icon):not(.chevron) {
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
  opacity: 1;
  transform: translateX(0);
}

.sidebar.collapsed .link span:not(.icon):not(.chevron) {
  opacity: 0;
  transform: translateX(-20px);
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.sidebar.collapsed .link {
  position: relative;
}

.sidebar.collapsed .link::after {
  content: attr(data-tooltip);
  position: absolute;
  left: 100%;
  top: 50%;
  transform: translateY(-50%) scale(0.8);
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 8px 12px;
  border-radius: 6px;
  font-size: 0.85rem;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  z-index: 1000;
  margin-left: 10px;
}

.sidebar.collapsed .link:hover::after {
  opacity: 1;
  transform: translateY(-50%) translateX(5px) scale(1);
}

.submenu.expanded .sublink {
  animation: slideDownFade 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
}

.submenu.expanded .sublink:nth-child(1) { animation-delay: 0.1s; }
.submenu.expanded .sublink:nth-child(2) { animation-delay: 0.2s; }
.submenu.expanded .sublink:nth-child(3) { animation-delay: 0.3s; }
.submenu.expanded .sublink:nth-child(4) { animation-delay: 0.4s; }
.submenu.expanded .sublink:nth-child(5) { animation-delay: 0.5s; }
.submenu.expanded .sublink:nth-child(6) { animation-delay: 0.6s; }
.submenu.expanded .sublink:nth-child(7) { animation-delay: 0.7s; }
.submenu.expanded .sublink:nth-child(8) { animation-delay: 0.8s; }
.submenu.expanded .sublink:nth-child(9) { animation-delay: 0.9s; }

@keyframes slideDownFade {
  0% {
    opacity: 0;
    transform: translateY(-20px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.submenu.collapsed .sublink {
  animation: slideUpFade 0.5s cubic-bezier(0.23, 1, 0.32, 1) forwards;
}

@keyframes slideUpFade {
  0% {
    opacity: 1;
    transform: translateY(0);
  }
  100% {
    opacity: 0;
    transform: translateY(-20px);
  }
}

.link:active {
  transform: scale(0.98);
  transition: transform 0.1s ease;
}

.sublink:active {
  transform: scale(0.98) translateY(0);
  transition: transform 0.1s ease;
}
