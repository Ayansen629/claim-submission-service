useEffect(() => {
  // Get URL parameters
  const urlStatus = searchParams.get("status");
  const urlTxnId = searchParams.get("txnId");
  const urlAppNo = searchParams.get("applicationNo");
  
  // If we have payment response parameters, we have valid data
  if (urlStatus && urlAppNo) {
    return; // Don't redirect, this is a valid payment response
  }
  
  // Only check for missing application details if no URL parameters
  if (!applicationNumber && !urlAppNo) {
    toast.error("Invalid or missing application details.");
    const timer = setTimeout(() => {
      navigate("/dashboard", { replace: true });
    }, 3000);
    return () => clearTimeout(timer);
  }
}, [searchParams, applicationNumber, navigate]);
