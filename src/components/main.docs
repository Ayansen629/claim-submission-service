import React, { useEffect, useState } from "react";
import { useLocation, useNavigate } from "react-router-dom";
import { Container, Card, ProgressBar, Button, Alert, Row, Col } from "react-bootstrap";
import { FaCheckCircle, FaClock, FaFileAlt, FaPrint, FaDownload, FaHome } from "react-icons/fa";
import "./TrackingPage.css"; // Custom CSS for this page

const TrackingPage = () => {
  const location = useLocation();
  const navigate = useNavigate();
  const [applicationData, setApplicationData] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  // Status configuration
  const statusConfig = {
    submitted: { label: "Submitted", icon: <FaFileAlt className="text-primary" />, color: "primary" },
    under_review: { label: "Under Review", icon: <FaClock className="text-warning" />, color: "warning" },
    approved: { label: "Approved", icon: <FaCheckCircle className="text-success" />, color: "success" },
    rejected: { label: "Rejected", icon: <FaCheckCircle className="text-danger" />, color: "danger" },
    contingent: { label: "Approved as Contingent", icon: <FaCheckCircle className="text-info" />, color: "info" }
  };

  // Mock API call - replace with your actual API call
  useEffect(() => {
    const fetchApplicationData = async () => {
      try {
        // In a real app, you would get the application ID from location.state or params
        // and fetch the data from your backend
        const appId = location.state?.applicationId || localStorage.getItem("lastSubmittedApplication");
        
        if (!appId) {
          throw new Error("No application data found");
        }

        // Simulate API call
        setTimeout(() => {
          const mockData = {
            id: appId,
            applicationNumber: `APP-${Math.floor(100000 + Math.random() * 900000)}`,
            dateSubmitted: new Date().toISOString(),
            status: "submitted",
            nextSteps: [
              "Your application has been received",
              "Awaiting initial review (typically within 3 business days)",
              "You will receive email notifications at each stage"
            ],
            summary: location.state?.formData || JSON.parse(localStorage.getItem("lastSubmittedFormData") || "{}"),
            documents: [
              { name: "Application Form", type: "pdf", downloadUrl: "#" },
              { name: "Submission Receipt", type: "pdf", downloadUrl: "#" }
            ],
            estimatedCompletion: "10-14 business days"
          };
          setApplicationData(mockData);
          setLoading(false);
        }, 1000);
      } catch (err) {
        setError(err.message);
        setLoading(false);
      }
    };

    fetchApplicationData();
  }, [location.state]);

  const handlePrint = () => {
    window.print();
  };

  const handleDownload = (doc) => {
    console.log(`Downloading ${doc.name}`);
    // Implement actual download logic
  };

  if (loading) {
    return (
      <Container className="my-5 text-center">
        <div className="spinner-border text-primary" role="status">
          <span className="visually-hidden">Loading...</span>
        </div>
        <p className="mt-3">Loading your application details...</p>
      </Container>
    );
  }

  if (error) {
    return (
      <Container className="my-5">
        <Alert variant="danger">
          <h4>Error loading application</h4>
          <p>{error}</p>
          <Button variant="primary" onClick={() => navigate("/dashboard")}>
            Return to Dashboard
          </Button>
        </Alert>
      </Container>
    );
  }

  if (!applicationData) {
    return (
      <Container className="my-5">
        <Alert variant="warning">
          <h4>No application data found</h4>
          <p>It seems you haven't submitted an application recently.</p>
          <Button variant="primary" onClick={() => navigate("/dashboard")}>
            Return to Dashboard
          </Button>
        </Alert>
      </Container>
    );
  }

  return (
    <Container className="my-5 tracking-container">
      <Card className="mb-4 shadow-sm">
        <Card.Header className="bg-primary text-white">
          <h2 className="mb-0">Application Submitted Successfully</h2>
        </Card.Header>
        <Card.Body>
          <Alert variant="success" className="d-flex align-items-center">
            <FaCheckCircle className="me-2" size={24} />
            <div>
              <h5 className="alert-heading">Thank you for your submission!</h5>
              <p className="mb-0">
                Your application #{applicationData.applicationNumber} has been received on{" "}
                {new Date(applicationData.dateSubmitted).toLocaleDateString()}.
              </p>
            </div>
          </Alert>

          <Row className="mb-4">
            <Col md={6}>
              <Card className="h-100">
                <Card.Header>
                  <h5>Application Status</h5>
                </Card.Header>
                <Card.Body>
                  <div className="d-flex align-items-center mb-3">
                    <div className="me-3" style={{ fontSize: "2rem" }}>
                      {statusConfig[applicationData.status]?.icon || <FaFileAlt />}
                    </div>
                    <div>
                      <h4 className={`mb-0 text-${statusConfig[applicationData.status]?.color || "primary"}`}>
                        {statusConfig[applicationData.status]?.label || "Submitted"}
                      </h4>
                      <small className="text-muted">Current status</small>
                    </div>
                  </div>

                  <ProgressBar className="mb-3">
                    <ProgressBar
                      variant={statusConfig[applicationData.status]?.color || "primary"}
                      now={
                        applicationData.status === "submitted" ? 25 :
                        applicationData.status === "under_review" ? 50 :
                        applicationData.status === "approved" ? 100 :
                        applicationData.status === "rejected" ? 100 : 75
                      }
                      label={`${
                        applicationData.status === "submitted" ? 25 :
                        applicationData.status === "under_review" ? 50 :
                        applicationData.status === "approved" ? 100 :
                        applicationData.status === "rejected" ? 100 : 75
                      }%`}
                    />
                  </ProgressBar>

                  <p className="text-muted">
                    Estimated completion: {applicationData.estimatedCompletion}
                  </p>
                </Card.Body>
              </Card>
            </Col>

            <Col md={6}>
              <Card className="h-100">
                <Card.Header>
                  <h5>Next Steps</h5>
                </Card.Header>
                <Card.Body>
                  <ul className="timeline">
                    {applicationData.nextSteps.map((step, index) => (
                      <li key={index} className={index === 0 ? "active" : ""}>
                        <div className="timeline-badge"></div>
                        <div className="timeline-panel">
                          <p>{step}</p>
                        </div>
                      </li>
                    ))}
                  </ul>
                </Card.Body>
              </Card>
            </Col>
          </Row>

          <Card className="mb-4">
            <Card.Header>
              <h5>Application Summary</h5>
            </Card.Header>
            <Card.Body>
              <Row>
                <Col md={6}>
                  <dl className="row">
                    <dt className="col-sm-4">Application Number</dt>
                    <dd className="col-sm-8">{applicationData.applicationNumber}</dd>

                    <dt className="col-sm-4">Submitted Date</dt>
                    <dd className="col-sm-8">
                      {new Date(applicationData.dateSubmitted).toLocaleString()}
                    </dd>

                    <dt className="col-sm-4">Debtor Name</dt>
                    <dd className="col-sm-8">
                      {applicationData.summary.step1?.debtorName || "N/A"}
                    </dd>

                    <dt className="col-sm-4">Creditor Name</dt>
                    <dd className="col-sm-8">
                      {applicationData.summary.step1?.CreditorName || "N/A"}
                    </dd>
                  </dl>
                </Col>
                <Col md={6}>
                  <dl className="row">
                    <dt className="col-sm-4">Total Claim Amount</dt>
                    <dd className="col-sm-8">
                      {applicationData.summary.step1?.totalClaimAmount
                        ? `₹${parseFloat(applicationData.summary.step1.totalClaimAmount).toLocaleString()}`
                        : "N/A"}
                    </dd>

                    <dt className="col-sm-4">Security Interest</dt>
                    <dd className="col-sm-8">
                      {applicationData.summary.step2?.securityInterestAmount
                        ? `₹${parseFloat(applicationData.summary.step2.securityInterestAmount).toLocaleString()}`
                        : "N/A"}
                    </dd>

                    <dt className="col-sm-4">Guarantee Amount</dt>
                    <dd className="col-sm-8">
                      {applicationData.summary.step2?.guaranteeAmount
                        ? `₹${parseFloat(applicationData.summary.step2.guaranteeAmount).toLocaleString()}`
                        : "N/A"}
                    </dd>
                  </dl>
                </Col>
              </Row>
            </Card.Body>
          </Card>

          <Card>
            <Card.Header>
              <h5>Documents</h5>
            </Card.Header>
            <Card.Body>
              <ul className="list-group">
                {applicationData.documents.map((doc, index) => (
                  <li key={index} className="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                      <FaFileAlt className="me-2" />
                      {doc.name}
                    </div>
                    <Button
                      variant="outline-primary"
                      size="sm"
                      onClick={() => handleDownload(doc)}
                    >
                      <FaDownload className="me-1" /> Download
                    </Button>
                  </li>
                ))}
              </ul>
            </Card.Body>
          </Card>
        </Card.Body>
        <Card.Footer className="d-flex justify-content-between">
          <Button variant="outline-primary" onClick={handlePrint}>
            <FaPrint className="me-1" /> Print This Page
          </Button>
          <Button variant="primary" onClick={() => navigate("/dashboard")}>
            <FaHome className="me-1" /> Return to Dashboard
          </Button>
        </Card.Footer>
      </Card>
    </Container>
  );
};

export default TrackingPage;




.tracking-container {
  max-width: 1200px;
}

.timeline {
  list-style: none;
  padding: 0;
  position: relative;
}

.timeline:before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #e9ecef;
  left: 15px;
}

.timeline > li {
  position: relative;
  margin-bottom: 20px;
}

.timeline-badge {
  width: 30px;
  height: 30px;
  line-height: 30px;
  font-size: 1.2em;
  text-align: center;
  position: absolute;
  top: 0;
  left: 0;
  background-color: #6c757d;
  color: white;
  border-radius: 50%;
}

.timeline-panel {
  margin-left: 45px;
  padding: 10px 15px;
  background-color: #f8f9fa;
  border-radius: 4px;
}

.timeline > li.active .timeline-badge {
  background-color: #0d6efd;
}

@media print {
  .no-print {
    display: none !important;
  }
  
  body {
    background: white;
    font-size: 12pt;
  }
  
  .card {
    border: none;
    box-shadow: none;
  }
}





