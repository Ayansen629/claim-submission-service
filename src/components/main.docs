const FormCDetails = ({ provideSubmitHandler, formData, onValidationComplete }) => {
  const methods = useForm({ mode: "onChange" });
  const { 
    register, 
    handleSubmit, 
    formState: { errors, isValid }, 
    control, 
    setValue, 
    getValues, 
    watch, 
    reset, 
    trigger 
  } = methods;
  
  const [selectedClaimType, setSelectedClaimType] = useState("");
  const [isCRPUser, setIsCRPUser] = useState(false);

  // Check if user is CRP
  useEffect(() => {
    const storedData = localStorage.getItem('userFormData');
    if (storedData) {
      const parsedData = JSON.parse(storedData);
      setIsCRPUser(parsedData?.userType === "CRP");
    }
  }, []);

  const bankAccountFields = [
    {
      name: "accountNumber",
      label: "Account Number",
      type: "text",
      rules: { 
        required: "Account number is required",
        pattern: {
          value: /^[0-9]{9,18}$/,
          message: "Account number must be 9-18 digits"
        }
      },
      placeholder: "Enter account number"
    },
    {
      name: "ifscCode",
      label: "IFSC Code",
      type: "text",
      rules: { 
        required: "IFSC code is required",
        pattern: {
          value: /^[A-Za-z]{4}0[A-Za-z0-9]{6}$/,
          message: "Invalid IFSC code format (e.g., ABCD0123456)"
        }
      },
      placeholder: "Enter IFSC code (e.g., ABCD0123456)",
      component: IFSCSearch
    },
    {
      name: "bankName",
      label: "Bank Name",
      type: "text",
      rules: { required: "Bank name is required" },
      placeholder: "Enter bank name"
    },
    {
      name: "branchName",
      label: "Branch Name",
      type: "text",
      rules: { required: "Branch name is required" },
      placeholder: "Enter branch name"
    },
    {
      name: "branchAddress",
      label: "Branch Address",
      type: "text",
      rules: { required: "Branch address is required" },
      placeholder: "Enter branch address"
    },
    {
      name: "city",
      label: "City",
      type: "text",
      rules: { required: "City is required" },
      placeholder: "Enter city"
    },
    {
      name: "state",
      label: "State",
      type: "text",
      rules: { required: "State is required" },
      placeholder: "Enter state"
    },
    {
      name: "district",
      label: "District",
      type: "text",
      rules: { required: "District is required" },
      placeholder: "Enter district"
    }
  ];

  const claimTypeOptions = [
    { value: "", label: "Select Claim Type", disabled: true },
    { value: "PRINCIPAL_BORROWER", label: "Corporate Debtor as Principal Borrower" },
    { value: "GUARANTOR", label: "Corporate Debtor as Guarantor" },
    { value: "BENEFICIARY", label: "Financial Debt Covered" },
  ];

  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    if (!isValid) {
      console.error("Validation failed");
      return false;
    }
    
    // Get all form values including entity data
    const formValues = getValues();
    
    // Log the complete form data with entity data
    console.log("Form Submit Data with Entity Data:", formValues);
    
    return formValues;
  }, [trigger, getValues]);

  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        setValue(key, formData[key]);
      });
      if (formData.claimType) {
        setSelectedClaimType(formData.claimType);
      }
    }
  }, [formData, setValue]);

  // Function to get entity type based on claim type
  function getEntityTypeFromClaimType(claimType) {
    switch(claimType) {
      case "PRINCIPAL_BORROWER": return "GUARANTOR";
      case "GUARANTOR": return "PRINCIPAL_BORROWER";
      case "BENEFICIARY": return "BENEFICIARY";
      default: return "";
    }
  }

  const handleClaimTypeChange = async (value) => {
    setSelectedClaimType(value);
    
    const baseReset = {
      claimType: value,
      claimAmount: "",
      hasSecurityInterest: "",
      hasGuarantee: "",
      securityValue: "",
      securityDate: "",
      guaranteeValue: "",
      guaranteeDate: "",
    };

    reset(baseReset);
    await trigger();
  };

  useEffect(() => {
    if (provideSubmitHandler) {
      provideSubmitHandler(onSubmit);
    }
  }, [provideSubmitHandler, onSubmit]);

  // Modified IFSCSearch component with disabled support
  const ModifiedIFSCSearch = ({ fieldConfig, register, errors, setValue, trigger }) => {
    return (
      <div className="form-group">
        <label className="form-label">
          <GiBank className="field-icon me-2" />
          {fieldConfig.label}
          {fieldConfig.rules?.required && <span className="required-asterisk">*</span>}
        </label>
        <input
          {...register(fieldConfig.name, fieldConfig.rules)}
          type="text"
          className={`form-control ${errors[fieldConfig.name] ? "is-invalid" : ""}`}
          placeholder={fieldConfig.placeholder}
          onChange={async (e) => {
            if (isCRPUser) return; // Don't fetch if user is CRP
            setValue(fieldConfig.name, e.target.value.toUpperCase(), { shouldValidate: true });
            await trigger(fieldConfig.name);
            fetchBankDetails(e.target.value);
          }}
          disabled={isCRPUser}
        />
        {errors[fieldConfig.name] && (
          <div className="invalid-feedback">{errors[fieldConfig.name].message}</div>
        )}
      </div>
    );
  };

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        {/* Claim Details Section */}
        <div className="form-section-container mb-4 bg-white p-4 rounded-3 shadow-sm">
          <Collapsible 
            title={
              <div className="section-header d-flex align-items-center">
                <FaFileAlt className="section-icon me-2" />
                <span>Details of Claim</span>
              </div>
            } 
            defaultOpen={true}
            iconColor="#269ccc"
          >
            <div className="container-fluid">
              <div className="row g-3">
                {/* Claim Type Dropdown */}
                <div className="col-md-6">
                  <div className="form-group">
                    <label className="form-label">
                      <FaMoneyBillWave className="field-icon me-2" />
                      Select Claim Type <span className="required-asterisk">*</span>
                    </label>
                    <select
                      {...register("claimType", { required: "Claim type is required" })}
                      className={`form-control ${errors.claimType ? "is-invalid" : ""}`}
                      onChange={(e) => !isCRPUser && handleClaimTypeChange(e.target.value)}
                      value={selectedClaimType}
                      disabled={isCRPUser}
                    >
                      {claimTypeOptions.map((option) => (
                        <option key={option.value} value={option.value} disabled={option.disabled}>
                          {option.label}
                        </option>
                      ))}
                    </select>
                    {errors.claimType && <div className="invalid-feedback">{errors.claimType.message}</div>}
                  </div>
                </div>
              </div>

              {/* Claim Type Specific Fields */}
              {selectedClaimType && (
                <ClaimTypeFields
                  claimType={selectedClaimType}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  getValues={getValues}
                  watch={watch}
                  trigger={trigger}
                  isCRPUser={isCRPUser}
                />
              )}

              <div className="row g-3 mt-3">
                {/* Details of How Debt Incurred */}
                <div className="col-md-12">
                  <div className="form-group">
                    <label className="form-label">
                      <FaFileAlt className="field-icon me-2" />
                      Details of how debt incurred <span className="required-asterisk">*</span>
                    </label>
                    <textarea
                      {...register("debtDetails", { required: "This field is required" })}
                      className={`form-control ${errors.debtDetails ? "is-invalid" : ""}`}
                      placeholder="Enter details of how debt was incurred"
                      rows={3}
                      disabled={isCRPUser}
                    />
                    {errors.debtDetails && <div className="invalid-feedback">{errors.debtDetails.message}</div>}
                  </div>
                </div>

                {/* Date of Debt Incurred */}
                <div className="col-md-6">
                  <div className="form-group">
                    <label className="form-label">
                      <FaCalendarAlt className="field-icon me-2" />
                      Date of debt incurred <span className="required-asterisk">*</span>
                    </label>
                    <input
                      {...register("debtDate", {
                        required: "This field is required",
                        validate: (value) => {
                          const today = new Date().toISOString().split("T")[0];
                          return value <= today || "Date cannot be in the future";
                        },
                      })}
                      type="date"
                      className={`form-control ${errors.debtDate ? "is-invalid" : ""}`}
                      placeholder="Select date"
                      disabled={isCRPUser}
                    />
                    {errors.debtDate && <div className="invalid-feedback">{errors.debtDate.message}</div>}
                  </div>
                </div>

                {/* Mutual Dealings */}
                <div className="col-md-12">
                  <div className="form-group">
                    <label className="form-label">
                      <FaHandshake className="field-icon me-2" />
                      Details of any mutual credit, mutual debts, or other mutual dealings
                    </label>
                    <textarea
                      {...register("mutualDetails")}
                      className="form-control"
                      placeholder="Enter details of any mutual dealings"
                      rows={5}
                      disabled={isCRPUser}
                    />
                  </div>
                </div>
              </div>
            </div>
          </Collapsible>
        </div>

        {/* Bank Account Details Section */}
        <div className="form-section-container mb-4 bg-white p-4 rounded-3 shadow-sm">
          <Collapsible 
            title={
              <div className="section-header d-flex align-items-center">
                <BsBank2 className="section-icon me-2" />
                <span>Bank Account Details</span>
              </div>
            } 
            defaultOpen={true}
            iconColor="#269ccc"
          >
            <div className="container-fluid">
              <div className="row g-3">
                {bankAccountFields.map((field) =>
                  field.component ? (
                    <div key={field.name} className="col-md-6">
                      <ModifiedIFSCSearch
                        fieldConfig={field}
                        register={register}
                        errors={errors}
                        setValue={setValue}
                        trigger={trigger}
                      />
                    </div>
                  ) : (
                    <div key={field.name} className="col-md-6">
                      <div className="form-group">
                        <label className="form-label">
                          {field.name === "accountNumber" && <FaUniversity className="field-icon me-2" />}
                          {field.name === "ifscCode" && <GiBank className="field-icon me-2" />}
                          {field.name === "bankName" && <FaLandmark className="field-icon me-2" />}
                          {field.name === "branchName" && <BsBuilding className="field-icon me-2" />}
                          {field.name === "branchAddress" && <FaMapMarkerAlt className="field-icon me-2" />}
                          {field.name === "city" && <FaCity className="field-icon me-2" />}
                          {field.name === "state" && <FaGlobeAmericas className="field-icon me-2" />}
                          {field.name === "district" && <FaMapMarkerAlt className="field-icon me-2" />}
                          {field.label} {field.rules?.required && <span className="required-asterisk">*</span>}
                        </label>
                        <input
                          {...register(field.name, field.rules)}
                          type={field.type || "text"}
                          className={`form-control ${errors[field.name] ? "is-invalid" : ""}`}
                          placeholder={field.placeholder}
                          disabled={isCRPUser}
                        />
                        {errors[field.name] && (
                          <div className="invalid-feedback">{errors[field.name].message}</div>
                        )}
                      </div>
                    </div>
                  )
                )}
              </div>
            </div>
          </Collapsible>
        </div>
      </form>
    </FormProvider>
  );
};

///////////////////////////
const ClaimTypeFields = ({ 
  claimType, 
  control, 
  register, 
  errors, 
  setValue, 
  getValues, 
  watch,
  trigger,
  isCRPUser // Add this prop
}) => {
  // Watch form values
  const hasSecurityInterest = watch("hasSecurityInterest");
  const hasGuarantee = watch("hasGuarantee");
  const currentClaimType = watch("claimType");
  const formEntityData = watch("entityData");
  
  // State for showing/hiding fields
  const [showSecurityFields, setShowSecurityFields] = useState(hasSecurityInterest === "yes");
  const [showGuaranteeFields, setShowGuaranteeFields] = useState(hasGuarantee === "yes");

  // Function to get entity type based on claim type
  const getEntityType = (claimType) => {
    switch(claimType) {
      case "PRINCIPAL_BORROWER": return "GUARANTOR";
      case "GUARANTOR": return "PRINCIPAL_BORROWER";
      case "BENEFICIARY": return "BENEFICIARY";
      default: return "";
    }
  };

  // Initialize entity data
  const [entityData, setEntityData] = useState(() => {
    const existingData = getValues("entityData");
    if (existingData && existingData.length > 0) {
      return existingData;
    }
    return [{ 
      id: 1, 
      name: "", 
      address: "", 
      type: getEntityType(claimType) 
    }];
  });

  // Handle security interest change
  const handleSecurityInterestChange = async (value) => {
    if (isCRPUser) return; // Don't process if user is CRP
    
    const wasYes = hasSecurityInterest === "yes";
    const isNo = value === "no";
    
    setShowSecurityFields(value === "yes");
    
    if (wasYes && isNo) {
      // Clear fields when switching from Yes to No
      setValue("securityValue", "");
      setValue("securityDate", "");
      
      // Trigger validation to clear any errors
      await trigger(["securityValue", "securityDate"]);
    }
  };

  // Handle guarantee change
  const handleGuaranteeChange = async (value) => {
    if (isCRPUser) return; // Don't process if user is CRP
    
    const wasYes = hasGuarantee === "yes";
    const isNo = value === "no";
    
    setShowGuaranteeFields(value === "yes");
    
    if (wasYes && isNo) {
      // Clear fields when switching from Yes to No
      setValue("guaranteeValue", "");
      setValue("guaranteeDate", "");
      
      // Trigger validation to clear any errors
      await trigger(["guaranteeValue", "guaranteeDate"]);
    }
  };

  // Update entity types when claimType changes
  useEffect(() => {
    if (claimType && !isCRPUser) {
      setEntityData(prev => prev.map(entity => ({
        ...entity,
        type: getEntityType(claimType)
      })));
    }
  }, [claimType, isCRPUser]);

  // Reset entity data when claim type changes
  useEffect(() => {
    if (!isCRPUser) {
      setEntityData([{ 
        id: 1, 
        name: "", 
        address: "", 
        type: getEntityType(currentClaimType) 
      }]);
      setValue("entityData", [{
        id: 1,
        name: "",
        address: "",
        type: getEntityType(currentClaimType)
      }]);
    }
  }, [currentClaimType, setValue, isCRPUser]);

  // Sync show/hide states with form values
  useEffect(() => {
    setShowSecurityFields(hasSecurityInterest === "yes");
    setShowGuaranteeFields(hasGuarantee === "yes");
  }, [hasSecurityInterest, hasGuarantee]);

  // Sync entityData with form values
  useEffect(() => {
    if (!isCRPUser) {
      if (formEntityData && formEntityData.length > 0) {
        setEntityData(formEntityData);
      } else {
        const newEntity = { 
          id: 1, 
          name: "", 
          address: "", 
          type: getEntityType(currentClaimType) 
        };
        setEntityData([newEntity]);
        setValue("entityData", [newEntity]);
      }
    }
  }, [currentClaimType, formEntityData, setValue, isCRPUser]);

  // Update form when entity data changes
  useEffect(() => {
    if (!isCRPUser) {
      setValue("entityData", entityData, { shouldValidate: true });
    }
  }, [entityData, setValue, isCRPUser]);

  // Field configurations
  const fieldConfigurations = [
    // Claim Amount
    {
      name: "claimAmount",
      label: "Amount of claim",
      type: "number",
      icon: FaMoneyBillWave,
      validation: {
        required: "Claim amount is required",
        min: { value: 1, message: "Amount must be greater than 0" }
      },
      placeholder: "Enter claim amount",
      colSize: 6,
      alwaysShow: true
    },
    // Security Interest Radio
    {
      name: "hasSecurityInterest",
      label: "Amount of claim covered by security interest",
      type: "radio",
      icon: FaBalanceScale,
      options: [
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" }
      ],
      validation: { required: "This field is required" },
      onChange: handleSecurityInterestChange,
      colSize: 6,
      alwaysShow: claimType !== "BENEFICIARY"
    },
    // Security Value
    {
      name: "securityValue",
      label: "Value of the security",
      type: "number",
      icon: FaMoneyBillWave,
      validation: showSecurityFields ? { 
        required: "Security value is required",
        min: { value: 1, message: "Value must be greater than 0" }
      } : {},
      placeholder: "Enter security value",
      colSize: 6,
      alwaysShow: showSecurityFields && claimType !== "BENEFICIARY"
    },
    // Security Date
    {
      name: "securityDate",
      label: "Date of the security",
      type: "date",
      icon: FaCalendarAlt,
      validation: showSecurityFields ? { 
        required: "Security date is required",
        validate: value => {
          const today = new Date().toISOString().split('T')[0];
          return value <= today || "Date cannot be in the future";
        }
      } : {},
      placeholder: "Select security date",
      colSize: 6,
      alwaysShow: showSecurityFields && claimType !== "BENEFICIARY"
    },
    // Guarantee Radio
    {
      name: "hasGuarantee",
      label: "Amount of claim covered by guarantee",
      type: "radio",
      icon: FaHandshake,
      options: [
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" }
      ],
      validation: { required: "This field is required" },
      onChange: handleGuaranteeChange,
      colSize: 6,
      alwaysShow: claimType !== "BENEFICIARY"
    },
    // Guarantee Value
    {
      name: "guaranteeValue",
      label: "Value of the guarantee",
      type: "number",
      icon: FaMoneyBillWave,
      validation: showGuaranteeFields ? { 
        required: "Guarantee value is required",
        min: { value: 1, message: "Value must be greater than 0" }
      } : {},
      placeholder: "Enter guarantee value",
      colSize: 6,
      alwaysShow: showGuaranteeFields && claimType !== "BENEFICIARY"
    },
    // Guarantee Date
    {
      name: "guaranteeDate",
      label: "Date of the guarantee",
      type: "date",
      icon: FaCalendarAlt,
      validation: showGuaranteeFields ? { 
        required: "Guarantee date is required",
        validate: value => {
          const today = new Date().toISOString().split('T')[0];
          return value <= today || "Date cannot be in the future";
        }
      } : {},
      placeholder: "Select guarantee date",
      colSize: 6,
      alwaysShow: showGuaranteeFields && claimType !== "BENEFICIARY"
    }
  ];

  // Render field based on configuration
  const renderField = (field) => {
    if (!field.alwaysShow) return null;

    switch(field.type) {
      case "radio":
        return (
          <div className="form-group">
            <label className="form-label">
              {field.icon && <field.icon className="field-icon me-2" />}
              {field.label} <span className="required-asterisk">*</span>
            </label>
            <div className="custom-radio-group">
              {field.options.map(option => (
                <div className="custom-radio" key={option.value}>
                  <input
                    type="radio"
                    id={`${field.name}${option.value}`}
                    {...register(field.name, field.validation)}
                    value={option.value}
                    className="custom-radio-input"
                    onChange={(e) => {
                      if (field.onChange && !isCRPUser) field.onChange(e.target.value);
                    }}
                    disabled={isCRPUser}
                  />
                  <label htmlFor={`${field.name}${option.value}`} className="custom-radio-label">
                    {option.label}
                  </label>
                </div>
              ))}
            </div>
            {errors[field.name] && <div className="invalid-feedback d-block">{errors[field.name].message}</div>}
          </div>
        );
      
      default:
        return (
          <div className="form-group">
            <label className="form-label">
              {field.icon && <field.icon className="field-icon me-2" />}
              {field.label} {field.validation?.required && <span className="required-asterisk">*</span>}
            </label>
            <input
              {...register(field.name, field.validation)}
              type={field.type}
              className={`form-control ${errors[field.name] ? "is-invalid" : ""}`}
              placeholder={field.placeholder}
              disabled={isCRPUser}
            />
            {errors[field.name] && <div className="invalid-feedback">{errors[field.name].message}</div>}
          </div>
        );
    }
  };

  // Get entity field labels based on claim type
  const getEntityFieldLabels = () => {
    switch (claimType) {
      case "PRINCIPAL_BORROWER":
        return {
          nameLabel: "Name of the guarantor",
          addressLabel: "Address of the guarantor",
          sectionTitle: "Guarantor Details",
          addButtonText: "Add Guarantor"
        };
      case "GUARANTOR":
        return {
          nameLabel: "Name of the Principal Borrower",
          addressLabel: "Address of the Principal Borrower",
          sectionTitle: "Principal Borrower Details",
          addButtonText: "Add Principal Borrower"
        };
      case "BENEFICIARY":
        return {
          nameLabel: "Name of the Beneficiary",
          addressLabel: "Address of the Beneficiary",
          sectionTitle: "Beneficiary Details",
          addButtonText: "Add Beneficiary"
        };
      default:
        return {
          nameLabel: "Name",
          addressLabel: "Address",
          sectionTitle: "Entity Details",
          addButtonText: "Add Entity"
        };
    }
  };

  const { nameLabel, addressLabel, sectionTitle, addButtonText } = getEntityFieldLabels();

  // Entity field management functions
  const updateEntityDetails = (id, field, value) => {
    if (isCRPUser) return; // Don't update if user is CRP
    
    const updatedEntities = entityData.map(entity => 
      entity.id === id ? { ...entity, [field]: value } : entity
    );
    setEntityData(updatedEntities);
  };

  const addEntityField = () => {
    if (isCRPUser) return; // Don't add if user is CRP
    
    const newId = entityData.length > 0 ? Math.max(...entityData.map(e => e.id)) + 1 : 1;
    setEntityData([...entityData, { 
      id: newId, 
      name: "", 
      address: "", 
      type: getEntityType(claimType) 
    }]);
  };

  const removeEntityField = (id) => {
    if (isCRPUser) return; // Don't remove if user is CRP
    
    if (entityData.length <= 1) return;
    const updatedEntities = entityData.filter(entity => entity.id !== id);
    setEntityData(updatedEntities);
  };

  return (
    <div className="form-section">
      <div className="row g-3">
        {fieldConfigurations.map((field, index) => (
          <div className={`col-md-${field.colSize}`} key={`${field.name}-${index}`}>
            {renderField(field)}
          </div>
        ))}
      </div>

      {/* Entity Fields Section */}
      <div className="entity-fields-container mt-4">
        <h5 className="mb-3">{sectionTitle}</h5>
        
        {entityData.map((entity, index) => (
          <div key={entity.id} className="entity-field-group mb-4 p-3 border rounded bg-light">
            <div className="d-flex justify-content-between align-items-center mb-3">
              <h6 className="mb-0">
                {claimType === "GUARANTOR" ? "Principal Borrower" : 
                 claimType === "PRINCIPAL_BORROWER" ? "Guarantor" : 
                 "Beneficiary"} {index + 1}
              </h6>
              {entityData.length > 1 && !isCRPUser && (
                <button
                  type="button"
                  className="btn btn-sm btn-danger"
                  onClick={() => removeEntityField(entity.id)}
                  disabled={isCRPUser}
                >
                  <FaMinus className="me-1" /> Remove
                </button>
              )}
            </div>
            
            <div className="row g-3">
              <div className="col-md-6">
                <div className="form-group">
                  <label className="form-label">
                    <FaUser className="field-icon me-2" />
                    {nameLabel} <span className="required-asterisk">*</span>
                  </label>
                  <input
                    type="text"
                    className={`form-control ${errors.entityData?.[index]?.name ? "is-invalid" : ""}`}
                    value={entity.name || ""}
                    onChange={(e) => updateEntityDetails(entity.id, "name", e.target.value)}
                    placeholder={`Enter name`}
                    disabled={isCRPUser}
                  />
                  {errors.entityData?.[index]?.name && (
                    <div className="invalid-feedback">{errors.entityData[index].name.message}</div>
                  )}
                </div>
              </div>
              
              <div className="col-md-6">
                <div className="form-group">
                  <label className="form-label">
                    <FaMapMarkerAlt className="field-icon me-2" />
                    {addressLabel} <span className="required-asterisk">*</span>
                  </label>
                  <input
                    type="text"
                    className={`form-control ${errors.entityData?.[index]?.address ? "is-invalid" : ""}`}
                    value={entity.address || ""}
                    onChange={(e) => updateEntityDetails(entity.id, "address", e.target.value)}
                    placeholder={`Enter address`}
                    disabled={isCRPUser}
                  />
                  {errors.entityData?.[index]?.address && (
                    <div className="invalid-feedback">{errors.entityData[index].address.message}</div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}

        {!isCRPUser && (
          <button 
            type="button" 
            className="btn btn-outline-primary add-more-btn"
            onClick={addEntityField}
            disabled={isCRPUser}
          >
            <FaPlus className="me-2" /> {addButtonText}
          </button>
        )}
      </div>
    </div>
  );
};
