<Offcanvas 
  show={show} 
  onHide={onHide} 
  placement="end"
  style={{ width: "450px", zIndex: 9999 }}
>
  <Offcanvas.Header 
    className="text-white border-0 d-flex justify-content-between align-items-center"
    style={{ 
      background: "linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%)",
      padding: "1rem 1.5rem",
      zIndex: 10000,
      position: "relative"
    }}
  >
    <Offcanvas.Title className="fw-bold d-flex align-items-center mb-0">
      <BsSticky className="me-2" size={20} />
      {t("Note Sheet")}
    </Offcanvas.Title>
    
    {/* Mobile Close Button */}
    <Button
      variant="outline-light"
      size="sm"
      className="d-block d-md-none"
      style={{
        padding: "4px 12px",
        fontSize: "0.75rem",
        borderRadius: "6px",
        fontWeight: "500",
        zIndex: 10001
      }}
      onClick={onHide}
    >
      {t("Close")}
    </Button>
    
    {/* Desktop Close Button */}
    <button
      type="button"
      className="btn-close btn-close-white d-none d-md-block"
      aria-label="Close"
      onClick={onHide}
      style={{ zIndex: 10001 }}
    ></button>
  </Offcanvas.Header>
  
  <Offcanvas.Body 
    className="p-0" 
    style={{ 
      background: "#f8f9fa",
      overflowX: "hidden",
      zIndex: 9999
    }}
  >
