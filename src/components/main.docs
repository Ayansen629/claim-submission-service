import React, { useState, useEffect, useRef } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFilePdf, FaFileImage, FaCheckCircle, FaTimes } from "react-icons/fa";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
  defaultValue?: string | File;
  autoFocus?: boolean;
  clearErrors?: (fieldName: string) => void;
  register?: any;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  watch,
  defaultValue,
  clearErrors,
  register
}) => {
  const hasError = errors && errors[name];
  const fileInputRef = useRef<HTMLInputElement>(null);
  const [fileSelected, setFileSelected] = useState(false);
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  const currentFile = watch ? watch(name) : null;

  useEffect(() => {
    if (currentFile && fileSelected) {
      clearErrors && clearErrors(name);
    }
  }, [currentFile, fileSelected, name, clearErrors]);

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files[0]) {
      setFileSelected(true);
      if (onChange) {
        onChange(e);
      }
    }
  };

  const handleRemoveFile = () => {
    if (fileInputRef.current) {
      fileInputRef.current.value = '';
    }
    setFileSelected(false);
    
    const fakeEvent = {
      target: {
        files: null,
        value: ''
      }
    } as any;
    
    if (onChange) {
      onChange(fakeEvent);
    }
  };

  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold text-dark mb-2">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      <div className="d-flex align-items-center gap-3">
        <label
          htmlFor={name}
          className={`btn ${hasError ? 'btn-outline-danger' : 'btn-primary'} btn-sm d-flex align-items-center`}
          style={{
            cursor: disabled ? 'not-allowed' : 'pointer',
            opacity: disabled ? 0.6 : 1,
            minWidth: '110px',
            padding: '6px 12px'
          }}
        >
          <FaUpload size={12} className="me-2" />
          <span style={{ fontSize: '0.85rem' }}>{t("Choose File")}</span>
        </label>

        <div className="flex-grow-1">
          {currentFile ? (
            <div className={`d-flex align-items-center justify-content-between border rounded px-3 py-2 ${hasError ? 'border-danger bg-danger-subtle' : 'border-success bg-success-subtle'}`}>
              <div className="d-flex align-items-center flex-grow-1 me-2">
                <FaCheckCircle className="text-success me-2 flex-shrink-0" size={14} />
                <div className="me-2 flex-shrink-0">
                  {currentFile.name.toLowerCase().includes('.pdf') ? (
                    <FaFilePdf className="text-danger" size={14} />
                  ) : (
                    <FaFileImage className="text-success" size={14} />
                  )}
                </div>
                <span 
                  className="text-dark fw-medium"
                  style={{ 
                    fontSize: '0.85rem',
                    overflow: 'hidden', 
                    textOverflow: 'ellipsis', 
                    whiteSpace: 'nowrap' 
                  }}
                  title={currentFile.name}
                >
                  {currentFile.name}
                </span>
              </div>
              <button
                type="button"
                className="btn btn-outline-danger btn-sm rounded-circle p-1"
                onClick={handleRemoveFile}
                disabled={disabled}
                style={{ width: '24px', height: '24px' }}
              >
                <FaTimes size={10} />
              </button>
            </div>
          ) : (
            <div className={`border rounded px-3 py-2 bg-light ${hasError ? 'border-danger' : ''}`}>
              <span className="text-muted" style={{ fontSize: '0.85rem' }}>
                {t("No file chosen")}
              </span>
            </div>
          )}
        </div>
      </div>

      <input
        ref={fileInputRef}
        type="file"
        id={name}
        onChange={handleFileChange}
        accept={accept}
        disabled={disabled}
        className="d-none"
        {...(register && register)}
      />

      {hasError ? (
        <Form.Text className="text-danger small mt-1 d-block">
          <FaTimes size={10} className="me-1" />
          {errors[name]?.message}
        </Form.Text>
      ) : (
        <Form.Text className="text-muted small mt-1">
          {t("PDF, JPG, PNG (Max: 10MB)")}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
