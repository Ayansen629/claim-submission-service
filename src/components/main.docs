/* Samsung Galaxy (412 * 914) */
@media (min-width: 412px) and (max-width: 412px) and (min-height: 914px) {
  .heroSection {
    height: 45vh;
    min-height: 380px;
  }

  .brandName {
    font-size: 11px;
    line-height: 15px;
  }

  .navLinkItems {
    font-size: 9px;
    padding: 0.1rem 0.2rem !important;
  }

  .topNavCol {
    padding: 0.4rem !important;
    margin-bottom: 0.8rem !important;
  }
}

/* Surface Duo (540 * 720) */
@media (min-width: 540px) and (max-width: 540px) and (min-height: 720px) {
  .heroSection {
    height: 50vh;
    min-height: 400px;
  }

  .brandName {
    font-size: 13px;
    line-height: 17px;
  }

  .navLinkItems {
    font-size: 10px;
    padding: 0.12rem 0.3rem !important;
  }
}

/* iPad Mini (768 * 1024) */
@media (min-width: 768px) and (max-width: 768px) and (min-height: 1024px) {
  .heroSection {
    height: 60vh;
    min-height: 480px;
  }

  .brandName {
    font-size: 15px;
    line-height: 19px;
  }

  .navLinkItems {
    font-size: 11px;
    padding: 0.18rem 0.38rem !important;
  }

  .topNavCol {
    padding: 0.8rem !important;
    margin-bottom: 1.8rem !important;
  }
}

/* iPad Air (820 * 1180) */
@media (min-width: 820px) and (max-width: 820px) and (min-height: 1180px) {
  .heroSection {
    height: 65vh;
    min-height: 520px;
  }

  .brandName {
    font-size: 16px;
    line-height: 20px;
  }

  .navLinkItems {
    font-size: 12px;
    padding: 0.2rem 0.4rem !important;
  }

  .topNavCol {
    padding: 0.9rem !important;
    margin-bottom: 2rem !important;
  }
}

/* Asus Zenbook (853 * 1280) */
@media (min-width: 853px) and (max-width: 853px) and (min-height: 1280px) {
  .heroSection {
    height: 70vh;
    min-height: 550px;
  }

  .brandName {
    font-size: 17px;
    line-height: 21px;
  }

  .navLinkItems {
    font-size: 12px;
    padding: 0.22rem 0.42rem !important;
  }
}

/* Surface Pro 7 (912 * 1368) */
@media (min-width: 912px) and (max-width: 912px) and (min-height: 1368px) {
  .heroSection {
    height: 70vh;
    min-height: 560px;
  }

  .brandName {
    font-size: 17px;
    line-height: 22px;
  }

  .navLinkItems {
    font-size: 13px;
    padding: 0.22rem 0.44rem !important;
  }

  .topNavCol {
    padding: 1rem !important;
    margin-bottom: 2.2rem !important;
  }
}

/* iPad Pro (1024 * 1366) */
@media (min-width: 1024px) and (max-width: 1024px) and (min-height: 1366px) {
  .heroSection {
    height: 75vh;
    min-height: 600px;
  }

  .brandName {
    font-size: 18px;
    line-height: 23px;
  }

  .navLinkItems {
    font-size: 13px;
    padding: 0.25rem 0.45rem !important;
  }

  .homeLoginBtn {
    position: static !important;
    right: auto !important;
    top: auto !important;
    margin: 1rem auto 0 !important;
    display: block !important;
    width: fit-content !important;
  }
}

/* Nest Hub (1024 * 600) */
@media (min-width: 1024px) and (max-width: 1024px) and (max-height: 600px) {
  .heroSection {
    height: 85vh;
    min-height: 500px;
  }

  .brandName {
    font-size: 16px;
    line-height: 20px;
  }

  .navLinkItems {
    font-size: 12px;
    padding: 0.2rem 0.4rem !important;
  }

  .topNavCol {
    padding: 0.8rem !important;
    margin-bottom: 1.5rem !important;
  }
}

/* Nest Hub Max (1280 * 800) */
@media (min-width: 1280px) and (max-width: 1280px) and (max-height: 800px) {
  .heroSection {
    height: 90vh;
    min-height: 600px;
  }

  .brandName {
    font-size: 18px;
    line-height: 22px;
  }

  .navLinkItems {
    font-size: 13px;
    padding: 0.25rem 0.45rem !important;
  }

  .topNavCol {
    padding: 1rem !important;
    margin-bottom: 2rem !important;
  }
}
