import React, { useRef, useState, useEffect } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaCheckCircle, FaTimes } from "react-icons/fa";
import { useTranslation } from "react-i18next";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  watch?: any;
  clearErrors?: (fieldName: string) => void;
  compact?: boolean;
  onRemove?: () => void;
  description?: string;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  watch,
  clearErrors,
  compact = false,
  onRemove,
  description
}) => {
  const fileInputRef = useRef<HTMLInputElement>(null);
  const [fileSelected, setFileSelected] = useState(false);
  const { t } = useTranslation();
  const currentFile = watch ? watch(name) : null;

  useEffect(() => {
    if (currentFile && fileSelected) {
      clearErrors?.(name);
    }
  }, [currentFile, fileSelected, name, clearErrors]);

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files[0]) {
      setFileSelected(true);
      onChange?.(e);
    }
  };

  const handleRemove = (e: React.MouseEvent) => {
    e.stopPropagation();
    if (fileInputRef.current) {
      fileInputRef.current.value = '';
    }
    setFileSelected(false);
    onRemove?.();
  };

  const getFileIcon = (fileName: string) => {
    if (fileName?.endsWith('.pdf')) {
      return <FaFilePdf className="text-danger" />;
    } else if (['.jpg', '.jpeg', '.png'].some(ext => fileName?.endsWith(ext))) {
      return <FaFileImage className="text-success" />;
    }
    return <FaFile className="text-primary" />;
  };

  if (compact) {
    return (
      <Form.Group className={`mb-3 ${className}`} controlId={name}>
        <div className="d-flex align-items-center gap-2">
          <label
            htmlFor={name}
            className={`btn btn-sm ${errors?.[name] ? 'btn-outline-danger' : 'btn-outline-primary'} mb-0 d-flex align-items-center`}
            style={{
              borderRadius: '4px',
              padding: '4px 12px',
              cursor: disabled ? 'not-allowed' : 'pointer',
              opacity: disabled ? 0.6 : 1,
              whiteSpace: 'nowrap'
            }}
          >
            <FaUpload className="me-2" size={12} />
            <span>{label}</span>
          </label>
          
          {currentFile ? (
            <div className="d-flex align-items-center bg-light rounded px-2 py-1 flex-grow-1">
              <span className="me-2">
                {getFileIcon(currentFile.name)}
              </span>
              <span 
                className="text-truncate flex-grow-1" 
                style={{ maxWidth: '150px' }}
              >
                {currentFile.name}
              </span>
              {!disabled && (
                <button 
                  type="button" 
                  className="btn btn-link p-0 ms-2 text-danger"
                  onClick={handleRemove}
                >
                  <FaTimes size={12} />
                </button>
              )}
            </div>
          ) : (
            <div className="text-muted small flex-grow-1">
              No file selected
            </div>
          )}
          
          <input
            ref={fileInputRef}
            type="file"
            id={name}
            onChange={handleFileChange}
            accept={accept}
            disabled={disabled}
            className="d-none"
          />
        </div>
        
        {errors?.[name] && (
          <Form.Text className="text-danger small mt-1 d-block">
            {errors[name]?.message}
          </Form.Text>
        )}
      </Form.Group>
    );
  }

  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      <div
        className={`border rounded p-2 ${errors?.[name] ? 'border-danger' : currentFile ? 'border-success' : 'border-secondary'}`}
        style={{
          backgroundColor: errors?.[name] ? '#fff8f8' : 'white',
          transition: 'all 0.3s ease'
        }}
      >
        <div className="d-flex align-items-center gap-2">
          <label
            htmlFor={name}
            className={`btn ${errors?.[name] ? 'btn-outline-danger' : 'btn-outline-primary'} mb-0 d-flex align-items-center`}
            style={{
              borderRadius: '4px',
              padding: '6px 12px',
              cursor: disabled ? 'not-allowed' : 'pointer',
              opacity: disabled ? 0.6 : 1,
              whiteSpace: 'nowrap'
            }}
          >
            <FaUpload className="me-2" />
            <span>Choose File</span>
          </label>
          
          <div
            className={`flex-grow-1 rounded px-3 py-2 ${currentFile ? 'bg-light-success' : 'bg-light'}`}
          >
            {currentFile ? (
              <div className="d-flex align-items-center justify-content-between">
                <div className="d-flex align-items-center">
                  <FaCheckCircle className="text-success me-2" />
                  <div className="d-flex align-items-center">
                    <span className="me-2">
                      {getFileIcon(currentFile.name)}
                    </span>
                    <span 
                      className="text-truncate" 
                      style={{ maxWidth: '200px' }}
                    >
                      {currentFile.name}
                    </span>
                  </div>
                </div>
                {!disabled && (
                  <button 
                    type="button" 
                    className="btn btn-link p-0 text-danger"
                    onClick={handleRemove}
                  >
                    <FaTimes />
                  </button>
                )}
              </div>
            ) : (
              <span className="text-muted">No file chosen</span>
            )}
          </div>
        </div>
        
        <input
          ref={fileInputRef}
          type="file"
          id={name}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="d-none"
        />
      </div>
      
      {errors?.[name] ? (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      ) : (
        <Form.Text className="text-muted small mt-1">
          {description || t("Upload PDF, JPG or PNG file (Max size: 10MB)")}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
