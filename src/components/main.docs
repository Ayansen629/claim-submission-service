import React, { useState } from 'react';
import { Modal, Button } from 'react-bootstrap';
import { format, addDays, setHours, setMinutes } from 'date-fns';
import 'bootstrap/dist/css/bootstrap.min.css';
import './AppointmentModal.css';

const AppointmentModal = ({ show, handleClose, handleConfirm }) => {
  // Generate date and time slots
  const generateSlots = () => {
    const slots = [];
    const today = new Date();
    
    // For each of the next 7 days
    for (let i = 0; i < 7; i++) {
      const date = addDays(today, i);
      const dateFormatted = format(date, 'MMM d, yyyy');
      
      // Generate time slots for each day
      const timeSlots = [
        { start: setHours(setMinutes(date, 0), 10), end: setHours(setMinutes(date, 0), 11), display: '10:00 AM' },
        { start: setHours(setMinutes(date, 0), 12), end: setHours(setMinutes(date, 0), 13), display: '12:00 PM' },
        { start: setHours(setMinutes(date, 0), 15), end: setHours(setMinutes(date, 0), 16), display: '3:00 PM' },
        { start: setHours(setMinutes(date, 0), 16), end: setHours(setMinutes(date, 0), 17), display: '4:00 PM' }
      ];
      
      timeSlots.forEach((timeSlot, j) => {
        slots.push({
          id: `${date.getTime()}-${j}`,
          ...timeSlot,
          date: dateFormatted,
          fullDisplay: `${timeSlot.display}, ${dateFormatted}`
        });
      });
    }
    
    return slots;
  };

  const [selectedSlot, setSelectedSlot] = useState(null);
  const timeSlots = generateSlots();

  const handleSlotSelect = (slot) => {
    setSelectedSlot(slot);
  };

  const handleConfirmation = () => {
    if (selectedSlot) {
      console.log("Selected Appointment:", JSON.stringify({
        date: selectedSlot.date,
        time: selectedSlot.display,
        startTime: selectedSlot.start,
        endTime: selectedSlot.end
      }, null, 2));
      handleConfirm(selectedSlot);
      handleClose();
    }
  };

  return (
    <Modal show={show} onHide={handleClose} centered className="appointment-modal">
      <Modal.Header closeButton className="modal-header">
        <Modal.Title className="modal-title">Select Appointment Slot</Modal.Title>
      </Modal.Header>
      
      <Modal.Body className="modal-body">
        <div className="slots-container">
          {timeSlots.map((slot) => (
            <div 
              key={slot.id}
              className={`time-slot-card ${selectedSlot?.id === slot.id ? 'selected' : ''}`}
              onClick={() => handleSlotSelect(slot)}
            >
              <div className="slot-date">{slot.date}</div>
              <div className="slot-time">
                <span className="time-text">{slot.display}</span>
                <span className="time-duration">1 hour</span>
              </div>
              {selectedSlot?.id === slot.id && (
                <div className="selection-indicator">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <circle cx="10" cy="10" r="9" fill="#0d6efd" />
                    <path d="M6 10L9 13L14 7" stroke="white" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
                  </svg>
                </div>
              )}
            </div>
          ))}
        </div>
      </Modal.Body>
      
      <Modal.Footer className="modal-footer">
        <Button variant="outline-secondary" onClick={handleClose} className="cancel-btn">
          Cancel
        </Button>
        <Button 
          variant="primary" 
          onClick={handleConfirmation}
          disabled={!selectedSlot}
          className="confirm-btn"
        >
          Confirm Appointment
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default AppointmentModal;
