const renderActionButton = () => {
  if (viewMode) {
    return activeStep === totalSteps - 1 ? (
      actionComponent || (
        <>
          {!omitSubmitButton && !registrationData?.basicDetails?.isCmnGenerated ? (
            <>
              <Button disabled={disableSubmit} variant="contained" sx={buttonStyle} onClick={handleSubmit}>
                Submit
              </Button>
              {disableSubmit && (
                <Button style={{ marginLeft: "1rem" }} variant="contained" sx={buttonStyle} onClick={handleGetInvoice}>
                  {t("Get Invoice")}
                </Button>
              )}
            </>
          ) : registrationData?.basicDetails?.isCmnGenerated ? (
            <Button variant="contained" sx={buttonStyle} onClick={() => navigate("/dashboard")}>
              Close
            </Button>
          ) : null}
        </>
      )
    ) : (
      <Button variant="contained" sx={buttonStyle} onClick={handleNext}>
        {t("Next")}
      </Button>
    );
  }

  return activeStep === totalSteps - 1 ? (
    <Button variant="contained" sx={buttonStyle} onClick={handlePayNow}>
      {t("Proceed to Pay")}
    </Button>
  ) : (
    <Button variant="contained" sx={buttonStyle} onClick={handleSave}>
      {t("Save & Next")}
    </Button>
  );
};
