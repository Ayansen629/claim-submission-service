import { useMasterData } from "../../../../context/MasterDataContext.js";
import ActionDropdown from "../../../../common/ActionDropdown.js";
import ApprovalModal from "../../../../common/ApprovalModal.js";
import BookOfRegistrationForm from "./survey-registrationForms/BookOfRegistrationForm.js";
import CertificateOfRegistrationForm8 from "./survey-registrationForms/CertificateOfRegistrationForm8.js";

const TransferOfRegistryApplication = ({
  applicationNo,
  viewMode = false,
  tabMode = false,
}) => {
  let { t } = useTranslation();
  // let { id } = useParams();
  let location = useLocation();
  let navigate = useNavigate();
  const surveyFormRef = useRef();
  const ownerDetails = getFromLocalStorage("ownerDetails")
    ? JSON.parse(getFromLocalStorage("ownerDetails"))
    : "";
  const { masterData } = useMasterData();
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");

  const [searchParams] = useSearchParams();
  const id = searchParams.get("applicationNo");

  let isEditMode = !!id && location.pathname.includes("/edit/");
  let isViewMode = (!!id && location.pathname.includes("/view/")) || viewMode;
  

  if (!id && applicationNo) {
    id = applicationNo;
  }


  let stepperRef = useRef();

  const methods = useForm({
    defaultValues: {
      ...vesselSurveyInitialValues,
      ...initialEquipementData,
    },
    mode: "onTouched",
  });
  const {
    trigger,
    getValues,
    setError,
    setValue,
    reset,
    formState: { errors },
  } = methods;
  const [actionsFromAPI, setActionsFromAPI] = useState([]);
  const [registrationData, setRegistrationData] = useState(null);
  const [initialRegistryData, setInitialRegistryData] = useState(null);

  const userRole = getFromLocalStorage("userRole") || "";
  const userDetails = getFromLocalStorage("userDetails")
    ? JSON.parse(getFromLocalStorage("userDetails"))
    : "";

  const isOfficerLogin = OFFICER_ROLES.includes(userRole) || false;

  const [paymentData, setPaymentData] = useState(
    {
    invoiceBreakupInfo: [
      {
        id: 1,
        label: "Payment",
        categoryHeader: "Pay now",
        amount: 500,

      },
    ], summary: {
      subTotal: 500,
      cgst: 0,
      sgst: 0,
      igst: 0,
      totalPayable: 500,
   
    }
  }
);
  const [fullPaymentData, setFullPaymentData] = useState({});
  const [showOfficerActions, setShowOfficerActions] = useState(false);
  const [vesselData, setVesselData] = useState({});

  if (isOfficerLogin) {
    isViewMode = true;
  }
  const loaderRef = useRef();

  const [isLoading, setIsLoading] = useState(false);
  const [openCertificateModal, setOpenCertificateModal] = useState(false);
  const [modalType, setModalType] = useState("");

  const [provisionalCertData, setProvisionalCertData] = useState("");
  const [generatedCertificates, setGeneratedCertificates] = useState({
    survey: false,
    registration: false,
  });

  useEffect(() => {
