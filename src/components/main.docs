import React, { useImperativeHandle, forwardRef, useState } from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";
import { useNavigate, useParams } from "react-router-dom";

const themeColor = "#2E57A7";
const successColor = "#28a745";

const Stepper = forwardRef(
  (
    {
      steps,
      onSave,
      viewMode = false,
      editMode = false,
      actionComponent = null,
      onNext,
      onBack,
      onPayNow,
      onSyncData,
      onSubmit,
      onGetInvoice,
      disableStepNavigation = false,
      disableSubmit = false,
      initialStep = 0,
      omitSubmitButton = false,
      registrationData,
      pageName = "",
      displayProvision = false,
      handleProvisionModalOpen = (type) => {}
    },
    ref
  ) => {
    const { t } = useTranslation();
    const navigate = useNavigate();
    const { id } = useParams();
    const [activeStep, setActiveStep] = useState(initialStep);
    const [completed, setCompleted] = useState({});
    const [errors, setErrors] = useState({});

    const totalSteps = steps.length;
    const currentStep = steps[activeStep];

    // Improved button styles - smaller and more refined
    const buttonStyle = {
      fontWeight: "600",
      borderRadius: "6px",
      fontSize: "0.75rem",
      textTransform: "none",
      padding: "6px 16px",
      minHeight: "28px",
      boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
      transition: "all 0.2s ease",
    };

    const primaryButtonStyle = {
      ...buttonStyle,
      backgroundColor: themeColor,
      color: "#fff",
      minWidth: "5rem",
      "&:hover": {
        backgroundColor: "#1f4ea0",
        transform: "translateY(-1px)",
        boxShadow: "0 2px 6px rgba(46, 87, 167, 0.3)",
      },
    };

    const provisionalButtonStyle = {
      ...buttonStyle,
      background: "linear-gradient(135deg, #10b981 0%, #059669 100%)",
      color: "#fff",
      fontSize: "0.65rem",
      minWidth: "3.2rem",
      padding: "4px 8px",
      minHeight: "24px",
      border: "none",
      "&:hover": {
        background: "linear-gradient(135deg, #059669 0%, #047857 100%)",
        transform: "translateY(-1px)",
        boxShadow: "0 2px 6px rgba(16, 185, 129, 0.3)",
      },
    };

    const stepperStyle = {
      fontSize: "0.75rem",
      width: "1.25rem",
      height: "1.25rem",
      textAlign: "center",
      borderRadius: "50%",
      backgroundColor: "#e5e7eb",
      display: "inline-flex",
      alignItems: "center",
      justifyContent: "center",
      fontWeight: "600",
      color: "#6b7280",
      transition: "all 0.2s ease",
    };

    const activeStepperStyle = {
      ...stepperStyle,
      backgroundColor: themeColor,
      color: "#fff",
      transform: "scale(1.1)",
    };

    useImperativeHandle(ref, () => ({
      goToNextStep,
      goToStep,
    }));

    const goToNextStep = () => {
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
    };

    const markStepCompleted = () => {
      setCompleted((prev) => ({ ...prev, [activeStep]: true }));
    };

    const validateAndProceed = async (callback) => {
      if (currentStep.validate) {
        const isValid = await currentStep.validate();
        setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));

        if (!isValid) {
          toast.error("Please fix the errors before proceeding.");
          return;
        }
      }

      markStepCompleted();
      callback();
    };

    const handleNext = () => {
      if (viewMode || steps?.goToNextStepNoValidtion || editMode) {
        goToNextStep();
        markStepCompleted();
      } else {
        validateAndProceed(() => {
          goToNextStep();
          onNext?.(activeStep);
        });
      }
    };

    const handleBack = () => {
      setActiveStep((prev) => Math.max(prev - 1, 0));
      onBack?.(activeStep);
    };

    const handleSave = () => {
      if (viewMode) return;

      if (steps[activeStep]?.goToNextStepNoValidtion || editMode) {
        goToNextStep();
        markStepCompleted();
        return;
      }

      validateAndProceed(() => {
        if (activeStep < totalSteps - 1) {
          const currentStepInfo = {
            index: activeStep,
            label: currentStep?.label,
            component: currentStep?.component,
            validate: currentStep?.validate,
            isLastStep: activeStep === totalSteps - 1,
            completedSteps: completed,
            getFormData: currentStep?.getFormData,
          };
          onSyncData?.(currentStepInfo);
        } else {
          onSave?.();
        }
      });
    };

    const handlePayNow = () => {
      onPayNow();
    };

    const handleGetInvoice = () => {
      onGetInvoice();
    };

    const handleSubmit = async () => {
      if (currentStep.validate) {
        const isValid = await currentStep.validate();
        if (!isValid) {
          toast.error("Please fix all errors before submitting.");
          return;
        }
      }
      onSubmit?.();
    };

    const renderActionButton = () => {
      if (viewMode) {
        return activeStep === totalSteps - 1 ? (
          <div style={{ display: "flex", gap: "8px", alignItems: "center", flexWrap: "wrap" }}>
            {actionComponent}
          </div>
        ) : (
          <Button variant="contained" sx={primaryButtonStyle} onClick={handleNext}>
            {t("Next")}
          </Button>
        );
      }

      return activeStep === totalSteps - 1 ? (
        (pageName === "uploadReports" ? (
          <Button variant="contained" sx={primaryButtonStyle} onClick={() => navigate("/dashboard")}>
            Close
          </Button>
        ) : pageName === "vesselRegistration" ? (
          <div style={{ display: "flex", gap: "8px", alignItems: "center" }}>
            {!omitSubmitButton && (
              <Button disabled={disableSubmit} variant="contained" sx={primaryButtonStyle} onClick={handleSubmit}>
                Submit
              </Button>
            )}
            {disableSubmit && (
              <Button variant="contained" sx={primaryButtonStyle} onClick={handleGetInvoice}>
                {t("Get Invoice")}
              </Button>
            )}
          </div>
        ) : (
          <Button variant="contained" sx={primaryButtonStyle} onClick={handlePayNow}>
            {t("Proceed to Pay")}
          </Button>
        ))
      ) : (
        <Button variant="contained" sx={primaryButtonStyle} onClick={handleSave}>
          {t("Save & Next")}
        </Button>
      );
    };

    const goToStep = (index) => {
      if (index >= 0 && index < totalSteps) {
        setActiveStep(index);
      }
    };

    return (
      <Box sx={{ width: "100%", padding: "0.75rem" }}>
        {/* Improved Stepper Header */}
        <Paper
          elevation={2}
          sx={{
            padding: "0.75rem 1.25rem",
            borderRadius: "8px",
            overflowX: "auto",
            whiteSpace: "nowrap",
            backgroundColor: "#fafbfc",
            border: "1px solid #e5e7eb",
          }}
        >
          <Stack direction="row" alignItems="center" spacing={1.5}>
            {steps?.map((step, index) => (
              <React.Fragment key={index}>
                <Stack
                  direction="row"
                  alignItems="center"
                  spacing={0.75}
                  sx={{ 
                    cursor: "pointer",
                    padding: "4px 8px",
                    borderRadius: "6px",
                    transition: "background-color 0.2s ease",
                    "&:hover": {
                      backgroundColor: "rgba(46, 87, 167, 0.05)",
                    }
                  }}
                  onClick={() => {
                    if (
                      !disableStepNavigation &&
                      (viewMode || completed[index] || editMode)
                    ) {
                      goToStep(index);
                    }
                  }}
                >
                  {completed[index] ? (
                    <CheckCircleFill size={16} color={successColor} />
                  ) : (
                    <Typography
                      sx={index === activeStep ? activeStepperStyle : stepperStyle}
                    >
                      {index + 1}
                    </Typography>
                  )}
                  <Typography
                    sx={{
                      fontWeight: index === activeStep || completed[index] ? "600" : "500",
                      color: index === activeStep ? themeColor : completed[index] ? successColor : "#6b7280",
                      fontSize: "0.8rem",
                      whiteSpace: "nowrap",
                      transition: "color 0.2s ease",
                    }}
                  >
                    {step.label}
                  </Typography>
                </Stack>
                {index < steps.length - 1 && (
                  <ChevronRight size={12} color="#9ca3af" />
                )}
              </React.Fragment>
            ))}
          </Stack>
        </Paper>

        {/* Step Content */}
        <Paper
          elevation={1}
          sx={{
            marginTop: "1rem",
            borderRadius: "8px",
            backgroundColor: "#fff",
            width: "100%",
            border: "1px solid #e5e7eb",
          }}
        >
          {currentStep.component}
          {errors[activeStep]}
        </Paper>

        <Divider sx={{ margin: "1.5rem 0", backgroundColor: "#e5e7eb" }} />

        {/* Improved Action Buttons */}
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            gap: "12px",
            flexDirection: { xs: "column", sm: "row" },
            alignItems: { xs: "stretch", sm: "center" },
          }}
        >
          <Button
            variant="outlined"
            onClick={handleBack}
            disabled={activeStep === 0}
            sx={{
              ...buttonStyle,
              color: themeColor,
              borderColor: themeColor,
              backgroundColor: "transparent",
              minWidth: { xs: "100%", sm: "5rem" },
              "&:hover": {
                backgroundColor: "rgba(46, 87, 167, 0.04)",
                borderColor: "#1f4ea0",
                transform: "translateY(-1px)",
              },
              "&:disabled": {
                color: "#9ca3af",
                borderColor: "#d1d5db",
              },
            }}
          >
            {t("Previous")}
          </Button>

          {renderActionButton()}
        </Box>
      </Box>
    );
  }
);

export default Stepper;
