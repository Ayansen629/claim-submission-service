import React from "react";
import { FaTimes } from "react-icons/fa";
import styles from './ImportantModal.module.css';
import ImportantLogo from "../../../assets/images/important_logo.png";

const ImportantModal = ({ show, onClose, selectedOption }) => {
  if (!show) return null;

  return (
    <div className={styles.modalOverlay}>
      <div className={styles.modalContent}>
        <div className={styles.modalHeader}>
          <button className={styles.closeButton} onClick={onClose}>
            <FaTimes />
          </button>
        </div>
        
        <div className={styles.modalBody}>
          <div className={styles.modalImage}>
            <img src={ImportantLogo} alt="Important" />
          </div>
          
          <h2 className={styles.modalTitle}>IMPORTANT</h2>
          
          <p className={styles.modalText}>
            You are attempting to modify the Owner Name / Registered Address associated with your vessel(s).
          </p>
          
          <ul className={styles.modalList}>
            <li>Any change in Owner's Name or Registered Address requires issuance of a new Registration Certificate.</li>
            <li>A prescribed government fee will be applicable for issuance of the new certificate.</li>
            <li>Please upload valid supporting documents (e.g., Incorporation Certificate, Gazette Notification, Affidavit, Proof of Address, etc.)</li>
            <li>Incorrect or incomplete details may lead to rejection of application or cancellation of vessel registration under Inland Water Transport Rules.</li>
          </ul>
        </div>
        
        <div className={styles.modalFooter}>
          <button className={styles.cancelButton} onClick={onClose}>
            Cancel
          </button>
          <button className={styles.proceedNowButton}>
            Proceed Now
          </button>
        </div>
      </div>
    </div>
  );
};

export default ImportantModal;
