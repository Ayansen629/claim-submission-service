/* Main sidebar container */
.custom-sidebar {
  background-color: #f4f8fc;
  color: #2466bf;
  height: calc(100vh - 60px);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  padding-top: 1rem;
  box-shadow: 2px 0 10px rgba(0, 0, 0, 0.08);
  border-right: 1px solid #e1eaf5;
  position: fixed;
  top: 75px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  will-change: transform, width;
}

.custom-sidebar.collapsed {
  width: 60px;
}

.custom-sidebar.expanded {
  width: 17rem;
  animation: slideIn 0.4s ease-out;
}

@keyframes slideIn {
  from {
    opacity: 0.8;
    transform: translateX(-10px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.custom-sidebar-menu,
.custom-sidebar-submenu-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.custom-sidebar-item {
  transition: all 0.3s ease;
  position: relative;
}

.custom-sidebar-item.active > .custom-sidebar-link {
  background-color: #d6e6f9;
  font-weight: 600;
}

/* Link inside main menu */
.custom-sidebar-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 18px;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: 0 20px 20px 0;
  position: relative;
  overflow: hidden;
}

.custom-sidebar-link:hover {
  background-color: #e8f1fc;
}

.custom-sidebar-link::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background-color: #2466bf;
  transform: scaleY(0);
  transform-origin: bottom;
  transition: transform 0.3s ease;
}

.custom-sidebar-link:hover::after,
.custom-sidebar-item.active > .custom-sidebar-link::after {
  transform: scaleY(1);
}

.custom-sidebar-link-content {
  display: flex;
  align-items: center;
  transition: opacity 0.3s ease;
}

.custom-sidebar.collapsed .custom-sidebar-link-content > span {
  opacity: 0;
  transition: opacity 0.2s ease, transform 0.3s ease;
  transform: translateX(-10px);
}

.custom-sidebar.expanded .custom-sidebar-link-content > span {
  opacity: 1;
  transform: translateX(0);
  transition: opacity 0.3s ease 0.15s, transform 0.3s ease 0.15s;
}

.custom-sidebar-icon {
  margin-right: 12px;
  font-size: 1.1rem;
  min-width: 24px;
  transition: margin-right 0.3s ease;
}

.custom-sidebar.collapsed .custom-sidebar-icon {
  margin-right: 0;
}

/* Chevron icon */
.custom-sidebar-chevron {
  margin-left: auto;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  opacity: 0.8;
}

.custom-sidebar-chevron.rotate {
  transform: rotate(90deg);
}

.custom-sidebar-submenu {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transform: translateY(-5px);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.custom-sidebar-submenu.expanded {
  max-height: 1000px;
  opacity: 1;
  transform: translateY(0);
}

/* Submenu list */
.custom-sidebar-submenu-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

/* Submenu link */
.custom-sidebar-sublink {
  margin: 5px 5px 0 5px;
  display: block;
  padding: 10px 35px;
  color: #2466bf;
  text-decoration: none;
  font-size: 0.85rem;
  border-radius: 0 20px 20px 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.custom-sidebar-sublink:hover {
  background-color: #e1ecfb;
  color: #1d4f9b;
  transform: translateX(5px);
}

.custom-sidebar-sublink.active {
  background-color: #d6e6f9;
  color: #1d4f9b;
  font-weight: 500;
}

.custom-sidebar-sublink::before {
  content: '';
  position: absolute;
  left: 20px;
  top: 50%;
  transform: translateY(-50%);
  width: 6px;
  height: 6px;
  background-color: #2466bf;
  border-radius: 50%;
  opacity: 0;
  transition: all 0.3s ease;
}

.custom-sidebar-sublink:hover::before,
.custom-sidebar-sublink.active::before {
  opacity: 1;
  left: 15px;
}

/* Close button */
.custom-sidebar-close {
  display: none;
  justify-content: flex-end;
  padding: 0.75rem 1rem;
  transition: opacity 0.3s ease;
}

.custom-sidebar-close svg {
  cursor: pointer;
  font-size: 1.25rem;
  color: #2466bf;
  transition: transform 0.3s ease;
}

.custom-sidebar-close svg:hover {
  transform: rotate(90deg);
}

/* Mobile behavior */
@media (max-width: 768px) {
  .custom-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 250px;
    z-index: 1000;
    transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    background-color: #f4f8fc;
    padding-top: 1.5rem;
  }

  .custom-sidebar.collapsed {
    transform: translateX(-100%);
    width: 250px;
  }

  .custom-sidebar.expanded {
    transform: translateX(0);
    box-shadow: 2px 0 20px rgba(0, 0, 0, 0.15);
  }

  .custom-sidebar-close {
    display: flex;
    position: absolute;
    right: 10px;
    top: 10px;
  }

  .custom-sidebar-menu {
    padding-bottom: 2rem;
    padding-top: 1rem;
  }
}

/* Backdrop for mobile */
.custom-sidebar-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.custom-sidebar-backdrop.visible {
  opacity: 1;
  visibility: visible;
}

/* Scrollbar styling */
.custom-sidebar-menu {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
}

.custom-sidebar-menu::-webkit-scrollbar {
  width: 6px;
}

.custom-sidebar-menu::-webkit-scrollbar-thumb {
  background-color: rgba(36, 102, 191, 0.3);
  border-radius: 4px;
}

.custom-sidebar-submenu.expanded {
  overflow-y: auto;
}

.custom-sidebar-submenu.expanded::-webkit-scrollbar {
  width: 6px;
}

.custom-sidebar-submenu.expanded::-webkit-scrollbar-thumb {
  background-color: rgba(36, 102, 191, 0.25);
  border-radius: 4px;
}

.custom-sidebar.collapsed .custom-sidebar-menu {
  overflow: hidden;
}
