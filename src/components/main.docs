import React, { useState, useEffect, useImperativeHandle, forwardRef } from "react";
import { Row, Col, Table, Card } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { formatDate } from "../../../../../utils/constants.ts";
import styles from "../../../../common/styles/ProvisionalCertificateOfSurvey.module.css";

const ProvisionalCertificateOfSurvey = forwardRef(({ registrationData, surveyData, preFilledCertData }, ref) => {
  const { t } = useTranslation();

  const currentDate = new Date();
  const expiryDate = new Date(currentDate.getTime() + (60 * 24 * 60 * 60 * 1000));

  const [editableData, setEditableData] = useState({
    expiryDay: expiryDate.getDate().toString().padStart(2, '0'),
    expiryMonth: (expiryDate.getMonth() + 1).toString().padStart(2, '0'),
    expiryYear: expiryDate.getFullYear().toString(),
    certificateNo: '',
    loadingMarksOnSide: 'Yes',
    notExtendingBeyondNauticalMiles: '',
    plyingLimits: '',
    safetyEquipment: {
      noOfBoats: '',
      noOfBuoyantApparatus: '',
      noOfLifebuoys: '',
      noOfLifejackets: '',
      fireExtinguishersFoamType: '',
      fireExtinguishersSodaAcid: '',
      fireExtinguishersDryCarbonPowder: '',
      anchorCable: '',
      noOfAnchorsWithWeight: '',
      hose: ''
    }
  });

  const [errors, setErrors] = useState({});

  const validateRequiredFields = () => {
    const newErrors = {};
    
    if (!editableData.expiryDay.trim()) newErrors.expiryDay = 'Expiry day is required';
    if (!editableData.expiryMonth.trim()) newErrors.expiryMonth = 'Expiry month is required';
    if (!editableData.expiryYear.trim()) newErrors.expiryYear = 'Expiry year is required';
    if (!editableData.certificateNo.trim()) newErrors.certificateNo = 'Certificate number is required';
    if (!editableData.plyingLimits.trim()) newErrors.plyingLimits = 'Plying limits is required';
    if (!editableData.notExtendingBeyondNauticalMiles.trim()) newErrors.notExtendingBeyondNauticalMiles = 'Nautical miles limit is required';
    
    if (!editableData.safetyEquipment.fireExtinguishersFoamType.trim()) {
      newErrors.fireExtinguishersFoamType = 'Fire Extinguishers (Foam Type) is required';
    }
    if (!editableData.safetyEquipment.fireExtinguishersSodaAcid.trim()) {
      newErrors.fireExtinguishersSodaAcid = 'Fire Extinguishers (Soda Acid) is required';
    }
    if (!editableData.safetyEquipment.fireExtinguishersDryCarbonPowder.trim()) {
      newErrors.fireExtinguishersDryCarbonPowder = 'Fire Extinguishers (Dry Carbon Powder) is required';
    }

    // Validate date format
    const day = parseInt(editableData.expiryDay);
    const month = parseInt(editableData.expiryMonth);
    const year = parseInt(editableData.expiryYear);

    if (day < 1 || day > 31) newErrors.expiryDay = 'Invalid day (1-31)';
    if (month < 1 || month > 12) newErrors.expiryMonth = 'Invalid month (1-12)';
    if (year < new Date().getFullYear()) newErrors.expiryYear = 'Year cannot be in the past';

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  useImperativeHandle(ref, () => ({
    validate: validateRequiredFields,
    getFormData: () => editableData
  }));

  useEffect(() => {
    if (preFilledCertData) {
      setEditableData(prev => ({
        ...prev,
        expiryDay: preFilledCertData.expiryDay || prev.expiryDay,
        expiryMonth: preFilledCertData.expiryMonth || prev.expiryMonth,
        expiryYear: preFilledCertData.expiryYear || prev.expiryYear,
        certificateNo: preFilledCertData.certificateNo || '',
        loadingMarksOnSide: preFilledCertData.loadingMarksOnSide || 'Yes',
        notExtendingBeyondNauticalMiles: preFilledCertData.notExtendingBeyondNauticalMiles || '',
        plyingLimits: preFilledCertData.plyingLimits || '',
        safetyEquipment: {
          noOfBoats: preFilledCertData.noOfBoats || '',
          noOfBuoyantApparatus: preFilledCertData.noOfBuoyantApparatus || '',
          noOfLifebuoys: preFilledCertData.noOfLifebuoys || '',
          noOfLifejackets: preFilledCertData.noOfLifejackets || '',
          fireExtinguishersFoamType: preFilledCertData.fireExtinguishersFoamType || '',
          fireExtinguishersSodaAcid: preFilledCertData.fireExtinguishersSodaAcid || '',
          fireExtinguishersDryCarbonPowder: preFilledCertData.fireExtinguishersDryCarbonPowder || '',
          anchorCable: preFilledCertData.anchorCable || '',
          noOfAnchorsWithWeight: preFilledCertData.noOfAnchorsWithWeight || '',
          hose: preFilledCertData.hose || ''
        }
      }));
    }
  }, [preFilledCertData]);

  const handleInputChange = (field, value) => {
    if (field.includes('.')) {
      const [parent, child] = field.split('.');
      setEditableData(prev => ({
        ...prev,
        [parent]: {
          ...prev[parent],
          [child]: value
        }
      }));
    } else {
      setEditableData(prev => ({
        ...prev,
        [field]: value
      }));
    }
    
    // Clear error when user starts typing
    if (errors[field] || errors[field?.split('.')[1]]) {
      setErrors(prev => {
        const newErrors = { ...prev };
        delete newErrors[field];
        delete newErrors[field?.split('.')[1]];
        return newErrors;
      });
    }
  };

  const renderField = (label, value, isEditable = false, fieldName = '', type = 'text', required = false) => {
    const hasError = errors[fieldName] || errors[fieldName?.split('.')[1]];
    
    if (isEditable) {
      if (type === 'select') {
        return (
          <div className={styles.fieldGroup}>
            <label className={`${styles.fieldLabel} ${required ? styles.required : ''}`}>
              {label} {required && <span className={styles.asterisk}>*</span>}
            </label>
            <select
              className={`${styles.editableSelect} ${hasError ? styles.errorField : ''}`}
              value={editableData[fieldName]}
              onChange={(e) => handleInputChange(fieldName, e.target.value)}
            >
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
            {hasError && <div className={styles.errorMessage}>{hasError}</div>}
          </div>
        );
      }
      return (
        <div className={styles.fieldGroup}>
          <label className={`${styles.fieldLabel} ${required ? styles.required : ''}`}>
            {label} {required && <span className={styles.asterisk}>*</span>}
          </label>
          <input
            type="text"
            className={`${styles.editableInput} ${hasError ? styles.errorField : ''}`}
            value={fieldName.includes('.') ? editableData[fieldName.split('.')[0]][fieldName.split('.')[1]] : editableData[fieldName]}
            onChange={(e) => handleInputChange(fieldName, e.target.value)}
            placeholder={`Enter ${label}`}
          />
          {hasError && <div className={styles.errorMessage}>{hasError}</div>}
        </div>
      );
    }
    
    return (
      <div className={styles.fieldGroup}>
        <label className={styles.fieldLabel}>{label}</label>
        <div className={value ? styles.disabledField : styles.disabledFieldEmpty}>
          {value || "Data not available"}
        </div>
      </div>
    );
  };

  return (
    <div className={styles.certificateContainer}>
      {/* Basic Certificate Info */}
      <Card className={styles.mainCard}>
        <Card.Body>
          <Row className="g-3">
            <Col xs={12} lg={3}>
              {renderField("Category", preFilledCertData?.category)}
            </Col>
            <Col xs={12} lg={9}>
              <div className={styles.fieldGroup}>
                <label className={`${styles.fieldLabel} ${styles.required}`}>
                  {t("Expiry on or before the")} <span className={styles.asterisk}>*</span>
                </label>
                <div className={styles.dateInputGroup}>
                  <div className={styles.dateField}>
                    <label className={styles.dateLabel}>Day</label>
                    <input
                      type="text"
                      className={`${styles.dateInput} ${errors.expiryDay ? styles.errorField : ''}`}
                      value={editableData.expiryDay}
                      onChange={(e) => handleInputChange('expiryDay', e.target.value)}
                      maxLength="2"
                      placeholder="DD"
                    />
                    {errors.expiryDay && <div className={styles.errorMessage}>{errors.expiryDay}</div>}
                  </div>
                  <div className={styles.dateField}>
                    <label className={styles.dateLabel}>Month</label>
                    <input
                      type="text"
                      className={`${styles.dateInput} ${errors.expiryMonth ? styles.errorField : ''}`}
                      value={editableData.expiryMonth}
                      onChange={(e) => handleInputChange('expiryMonth', e.target.value)}
                      maxLength="2"
                      placeholder="MM"
                    />
                    {errors.expiryMonth && <div className={styles.errorMessage}>{errors.expiryMonth}</div>}
                  </div>
                  <div className={styles.dateField}>
                    <label className={styles.dateLabel}>Year</label>
                    <input
                      type="text"
                      className={`${styles.dateInput} ${errors.expiryYear ? styles.errorField : ''}`}
                      value={editableData.expiryYear}
                      onChange={(e) => handleInputChange('expiryYear', e.target.value)}
                      maxLength="4"
                      placeholder="YYYY"
                    />
                    {errors.expiryYear && <div className={styles.errorMessage}>{errors.expiryYear}</div>}
                  </div>
                </div>
              </div>
            </Col>
          </Row>

          <Row className="g-3 mt-2">
            <Col xs={12} lg={6}>
              {renderField("Provisional Certificate of Survey No.", editableData.certificateNo, true, 'certificateNo', 'text', true)}
            </Col>
            <Col xs={12} lg={6}>
              {renderField("Zone of operation", preFilledCertData?.zoneOfOperation)}
            </Col>
          </Row>

          <Row className="g-3 mt-2">
            <Col xs={12} lg={6}>
              {renderField("Date of Issue", preFilledCertData?.dateOfIssue || formatDate(currentDate))}
            </Col>
            <Col xs={12} lg={6}>
              {renderField("Date of Expiry", preFilledCertData?.dateOfExpiry || formatDate(expiryDate))}
            </Col>
          </Row>
        </Card.Body>
      </Card>

      {/* Statement */}
      <div className={styles.statementBox}>
        <p>{t("This Provisional Certificate of Survey has been issued subsequent to Survey carried out of the below detailed inland vessel.")}</p>
      </div>

      {/* Vessel Details */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("VESSEL DETAILS")}</h5>
        </Card.Header>
        <Card.Body>
          <Row className="g-3">
            <Col xs={12} md={6}>
              {renderField("Name of the Vessel", preFilledCertData?.vesselName)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Official No.", preFilledCertData?.officialNo)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Port of Registry", preFilledCertData?.portOfRegistry)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Certificate of Registry No.", preFilledCertData?.certificateOfRegistryNo)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Gross Tonnage", preFilledCertData?.grossTonnage)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Registered Tonnage", preFilledCertData?.registeredTonnage)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Freeboard Assigned", preFilledCertData?.freeboardAssigned)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Loading marks placed on the vessel's side", editableData.loadingMarksOnSide, true, 'loadingMarksOnSide', 'select', true)}
            </Col>
          </Row>
        </Card.Body>
      </Card>

      {/* Personnel Details */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("PERSONNEL DETAILS")}</h5>
        </Card.Header>
        <Card.Body>
          <Row className="g-3">
            <Col xs={12} md={6}>
              {renderField("Name of the Master", preFilledCertData?.masterName)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Master's COC Grade", preFilledCertData?.masterCocGrade)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("COC No.", preFilledCertData?.masterCocNo)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Place of Issue", preFilledCertData?.masterPlaceOfIssue)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Name of the Engineer or Engine Driver", preFilledCertData?.engineerName)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("COC Grade of the Engineer or Engine Driver", preFilledCertData?.engineerCocGrade)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("COC No.", preFilledCertData?.engineerCocNo)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Place of Issue", preFilledCertData?.engineerPlaceOfIssue)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Name of Owner", preFilledCertData?.ownerName)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Address of Owner", preFilledCertData?.ownerAddress)}
            </Col>
          </Row>
        </Card.Body>
      </Card>

      {/* Survey Details */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("SURVEY DETAILS")}</h5>
        </Card.Header>
        <Card.Body>
          <Row className="g-3">
            <Col xs={12} md={6}>
              {renderField("Date of Survey carried out", preFilledCertData?.dateOfSurveyCarriedOut)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Place of survey carried out", preFilledCertData?.placeOfSurveyCarriedOut)}
            </Col>
          </Row>
        </Card.Body>
      </Card>

      {/* Plying Limits */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("PLYING LIMITS (as applicable):")}</h5>
        </Card.Header>
        <Card.Body>
          <div className={styles.plyingLimitsContent}>
            <div className={styles.plyingLimitsRow}>
              <span className={styles.inlineLabel}>{t("Within inland waters limits")}:</span>
              <input
                type="text"
                className={`${styles.inlineInput} ${errors.plyingLimits ? styles.errorField : ''}`}
                value={editableData.plyingLimits}
                onChange={(e) => handleInputChange('plyingLimits', e.target.value)}
                placeholder="Enter plying limits *"
                style={{minWidth: '200px'}}
              />
              {errors.plyingLimits && <div className={styles.errorMessage}>{errors.plyingLimits}</div>}
            </div>
            <div className={styles.plyingLimitsRow}>
              <span className={styles.inlineLabel}>{t("not extending beyond")}:</span>
              <input
                type="text"
                className={`${styles.inlineInput} ${errors.notExtendingBeyondNauticalMiles ? styles.errorField : ''}`}
                value={editableData.notExtendingBeyondNauticalMiles}
                placeholder="Enter nautical miles *"
                onChange={(e) => handleInputChange('notExtendingBeyondNauticalMiles', e.target.value)}
              />
              <span className={styles.inlineLabel}>{t("Nautical Miles from the nearest shore.")}</span>
              {errors.notExtendingBeyondNauticalMiles && <div className={styles.errorMessage}>{errors.notExtendingBeyondNauticalMiles}</div>}
            </div>
          </div>
        </Card.Body>
      </Card>

      {/* Capacity */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("CARGO/PASSENGER CAPACITY")}</h5>
        </Card.Header>
        <Card.Body>
          <div className={styles.capacityContent}>
            <div className={styles.capacityItem}>
              <span className={styles.capacityLabel}>{t("Maximum permissible cargo carriage capacity")}:</span>
              <div className={preFilledCertData?.cargoCapacity ? styles.capacityValue : styles.capacityValueEmpty}>
                {preFilledCertData?.cargoCapacity || "Not specified"}
              </div>
            </div>
            <div className={styles.capacityItem}>
              <span className={styles.capacityLabel}>{t("Passengers")}:</span>
              <div className={preFilledCertData?.passengerCapacity ? styles.capacityValue : styles.capacityValueEmpty}>
                {preFilledCertData?.passengerCapacity || "Not specified"}
              </div>
            </div>
            <div className={styles.capacityItem}>
              <span className={styles.capacityLabel}>{t("Crew")}:</span>
              <div className={preFilledCertData?.crewCapacity ? styles.capacityValue : styles.capacityValueEmpty}>
                {preFilledCertData?.crewCapacity || "Not specified"}
              </div>
            </div>
          </div>
        </Card.Body>
      </Card>

      {/* Safety Equipment */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("Safety equipment carried on the vessel:")}</h5>
        </Card.Header>
        <Card.Body>
          <div className="table-responsive">
            <Table className={styles.safetyTable}>
              <thead>
                <tr>
                  <th className={styles.tableHeader}>{t("No. of boats size and cubic capacity")}</th>
                  <th className={styles.tableHeader}>{t("No. of Buoyant apparatus or Life rafts")}</th>
                  <th className={styles.tableHeader}>{t("Lifebuoys")}</th>
                  <th className={styles.tableHeader}>{t("Lifejackets")}</th>
                  <th className={`${styles.tableHeader} ${styles.required}`}>
                    {t("Fire Extinguishers (Foam Type)")} <span className={styles.asterisk}>*</span>
                  </th>
                  <th className={`${styles.tableHeader} ${styles.required}`}>
                    {t("Fire Extinguishers (Soda Acid)")} <span className={styles.asterisk}>*</span>
                  </th>
                  <th className={`${styles.tableHeader} ${styles.required}`}>
                    {t("Fire Extinguishers (Dry Carbon Powder)")} <span className={styles.asterisk}>*</span>
                  </th>
                  <th className={styles.tableHeader}>{t("No. od Anchor with their weight")}</th>
                  <th className={styles.tableHeader}>{t("Anchor Cable(Length size)")}</th>
                  <th className={styles.tableHeader}>{t("Hose (Length size)")}</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  {Object.entries(editableData.safetyEquipment).map(([key, value], index) => {
                    const editableFields = ['fireExtinguishersFoamType', 'fireExtinguishersSodaAcid', 'fireExtinguishersDryCarbonPowder'];
                    const isEditable = editableFields.includes(key);
                    const hasError = errors[key];
                    
                    return (
                      <td key={index} className={styles.tableCell}>
                        {isEditable ? (
                          <div>
                            <input
                              type="text"
                              className={`${styles.tableInput} ${hasError ? styles.errorField : ''}`}
                              value={value}
                              onChange={(e) => handleInputChange(`safetyEquipment.${key}`, e.target.value)}
                              placeholder="Enter value *"
                            />
                            {hasError && <div className={styles.errorMessage}>{hasError}</div>}
                          </div>
                        ) : (
                          <div className={styles.tableDisabledField}>
                            {value || "Data not available"}
                          </div>
                        )}
                      </td>
                    );
                  })}
                </tr>
              </tbody>
            </Table>
          </div>
        </Card.Body>
      </Card>

      {/* Certificate Statement */}
      <div className={styles.certificationBox}>
        <h6 className={styles.certificationTitle}>{t("THIS IS TO CERTIFY")}</h6>
        <p className={styles.certificationText}>
          {t("that the provisions of the rules with respect to the survey of the above mentioned Inland Vessel and the Transmission of declaration in respect thereof, have been complied with.")}
        </p>
      </div>

      {/* Validity Statement */}
      <div className={styles.validityBox}>
        <p>
          {t("This Provisional Certificate of Survey, issued under the provisions of section 13(1) of the Inland Vessels Act, 2021 continues to be in force only until the")} 
          <strong> ({editableData.expiryDay}-{editableData.expiryMonth}-{editableData.expiryYear})</strong>
        </p>
      </div>
    </div>
  );
});

export default ProvisionalCertificateOfSurvey;
