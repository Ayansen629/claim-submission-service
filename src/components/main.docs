import React, { createContext, useContext, useState } from "react";
import { toast } from "react-toastify";
import { APP_MESSAGES, formatDate, formatDateTime } from "../../utils/constants.ts";
import { URLS_ENDPOINT } from "../../utils/urlsConstants.ts";
import { postData } from "../../services/http.service.ts";
import { format, parseISO } from "date-fns";
import moment from "moment";
 
// Create the Registration Context
const RegistrationContext = createContext();
 
// Custom hook to use the Registration Context
export const useRegistration = () => {
  return useContext(RegistrationContext);
};
 
// Fixed ApplicationContextProvider
export const ApplicationContextProvider = ({ children }) => {
  const [registrationData, setRegistrationData] = useState({});
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
 
  // const handleRegistrationView = async (row) => {
  //   if (row?.uuid) {
  //     const request = {
  //       registrationBook: [{ uuid: row?.uuid }],
  //     };
 
  //     try {
  //       setLoading(true);
  //       const URL =
  //         process.env.REACT_APP_BASE_URL +
  //         URLS_ENDPOINT.APP_SERVICES.REGISTRATION_SEARCH;
  //       const response = await postData(URL, request);
 
  //       if (response?.data && response?.data?.length > 0) {
  //         setIsViewModalOpen(true); // Open the modal
  //         const registrationData = response?.data[0]; // Assuming we get a single object
  //         console.log(registrationData, "testingdata");
  //         const formattedData = formatRawData(registrationData);
  //         setRegistrationData(formattedData);
  //       } else {
  //         toast.error(APP_MESSAGES.NO_DATA_FOUND, { position: "top-right" });
  //       }
  //     } catch (err) {
  //       toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
  //       setError(err.message || "Error fetching registration data");
  //     } finally {
  //       setLoading(false);
  //     }
  //   }
  // };


  const handleRegistrationView = async (row) => {
    if (!row?.uuid) {
      console.warn("Row UUID is missing");
      return;
    }
  
    console.log("Row UUID:", row.uuid);
  
    const request = {
      registrationBook: [{ uuid: row.uuid }],
    };
  
    console.log("API Request Payload:", request);
  
    try {
      setLoading(true);
      const URL =
        process.env.REACT_APP_BASE_URL +
        URLS_ENDPOINT.APP_SERVICES.REGISTRATION_SEARCH;
  
      console.log("API URL:", URL);
  
      const response = await postData(URL, request);
  
      console.log("Full API Response:", response);
  
      // Validate API response status
      if (response?.data?.responseStatus?.status === "200") {
        const registrationResponses = response?.data?.iwtRegistrationResponses;
  
        console.log("Extracted Registration Responses:", registrationResponses);
  
        if (Array.isArray(registrationResponses) && registrationResponses.length > 0) {
          const registrationData = registrationResponses[0]; // Extract the first object
          console.log("Raw Registration Data:", registrationData);
  
          const formattedData = formatRawData(registrationData);
          console.log("Formatted Registration Data:", formattedData);
  
          setRegistrationData(formattedData);
          setIsViewModalOpen(true); // Open the modal
        } else {
          console.warn("No registration data found");
          setRegistrationData(getDefaultRegistrationData()); // Reset state
          toast.error(APP_MESSAGES.NO_DATA_FOUND, { position: "top-right" });
        }
      } else {
        console.error("API returned an error status:", response?.data?.responseStatus);
        setRegistrationData(getDefaultRegistrationData()); // Reset state
        toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      }
    } catch (err) {
      console.error("Error fetching registration data:", err);
      setRegistrationData(getDefaultRegistrationData()); // Reset state
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setError(err.message || "Error fetching registration data");
    } finally {
      setLoading(false);
    }
  };
  

  
 
  const updateRegistrationData = (updatedData) => {
    setRegistrationData((prev) => ({
      ...prev,
      ...updatedData,
    }));
  };
 
  return (
    <RegistrationContext.Provider
      value={{
        registrationData,
        loading,
        error,
        isViewModalOpen,
        setIsViewModalOpen,
        handleRegistrationView,
        updateRegistrationData,
        setRegistrationData
      }}
    >
      {children}
    </RegistrationContext.Provider>
  );
};

 
const formatRawData = (rawData) => {
  return {
    step1: {
      registrationNo: rawData.registrationBooksData?.[0]?.registrationNo,
      noAndYear: rawData.registrationBooksData?.[0]?.noAndYear,
      uuidofRegistrationBook: rawData.registrationBooksData?.[0]?.uuid || "",
      nameOfVessel: rawData.registrationBooksData?.[0]?.nameOfVessel,
      yearOfRegistry: rawData.registrationBooksData?.[0]?.yearOfRegistry,
      portOfRegistry: rawData.registrationBooksData?.[0]?.portOfRegistry,
      registrationBookNo: rawData.registrationBooksData?.[0]?.registrationBookNo,
      nameOfOwner: rawData.registrationBooksData?.[0]?.nameOfOwner,
      addressOfOwner: rawData.registrationBooksData?.[0]?.addressOfOwner,
      vesselType: rawData.vesselDescriptionsData?.[0]?.vesselType,
      category: rawData.vesselDescriptionsData?.[0]?.category,
      uuidOfVesselDescription: rawData.vesselDescriptionsData?.[0]?.uuid || "",
      grossTonnage: rawData.vesselDescriptionsData?.[0]?.grossTonnage,
      registeredTonnage: rawData.vesselDescriptionsData?.[0]?.registeredTonnage,
      // typeOfCarving: rawData.carvingMakingsData?.[0]?.typeOfCarving || "Not Available",
      // uuidofCarving: rawData.carvingMakingsData?.[0]?.uuid || "",
      // nameResidenceOccupation: rawData.subsequentToRegistrationsData?.[0]?.nameResidenceOccupation || "Not Available",
      // numberOfTransactionTransferee: rawData.subsequentToRegistrationsData?.[0]?.numberOfTransactionTransferee || "Not Available",
      // remarks: rawData.subsequentToRegistrationsData?.[0]?.remarks || "Not Available",
      // dateOfTransaction: formatDate(rawData.subsequentToRegistrationsData?.[0]?.dateOfTransaction) ,
      // transactionNo: rawData.subsequentToRegistrationsData?.[0]?.transactionNo || "Not Available",
      // natureOfTransaction:rawData.subsequentToRegistrationsData?.[0]?.transactionNo,
      // uuid:rawData.subsequentToRegistrationsData?.[0]?.uuid
    },

    step2: {
      uuidOfVesselParticulars: rawData.vesselParticularsData?.[0]?.uuid || "",
      lengthOverall: rawData.vesselParticularsData?.[0]?.lengthOverall,
      breadthExtreme: rawData.vesselParticularsData?.[0]?.breadthExtreme,
      depthOfUndersideOfDeckamidShips: rawData.vesselParticularsData?.[0]?.depthOfUndersideOfDeckamidShips,
      builderNameAddress: rawData.vesselParticularsData?.[0]?.builderNameAddress,
      builderAddress: rawData.vesselParticularsData?.[0]?.builderAddress,
      yearOfBuild: rawData.vesselParticularsData?.[0]?.yearOfBuild,
      typeOfHull: rawData.vesselParticularsData?.[0]?.typeOfHull,
      noOfDecks: rawData.vesselParticularsData?.[0]?.noOfDecks,
      noOfBulkheads: rawData.vesselParticularsData?.[0]?.noOfBulkheads,
      stren: rawData.vesselParticularsData?.[0]?.stren,
      build: rawData.vesselParticularsData?.[0]?.build,
      particulardescription: rawData.vesselParticularsData?.[0]?.description,
      engineNo: rawData.enginesData?.[0]?.engineNo,
      typeOfEngine: rawData.enginesData?.[0]?.typeOfEngine,
      uuidOfEngine: rawData.enginesData?.[0]?.uuid || "" ,
      noOfSeats: rawData.enginesData?.[0]?.noOfSeats || null,
      engineMadeBy: rawData.enginesData?.[0]?.madeBy,
      engineYearOfMake: rawData.enginesData?.[0]?.yearOfMake,
      surfaceJet: rawData.enginesData?.[0]?.surfaceJet,
      noOfCylindersPerSet: rawData.enginesData?.[0]?.noOfCylindersPerSet || null,
      diameterOfCylinderInInches: rawData.enginesData?.[0]?.diameterOfCylinderInInches,
      strokesInInches: rawData.enginesData?.[0]?.strokesInInches,
      enginedescription: rawData.enginesData?.[0]?.description,
      nhp: rawData.enginesData?.[0]?.nhp || null,
      bhp: rawData.enginesData?.[0]?.bhp || null,
      ihp: rawData.enginesData?.[0]?.ihp || null,
      engineRpm: rawData.enginesData?.[0]?.rpm || null,
      typeOfBoiler: rawData.boilersData?.[0]?.typeOfBoiler || null,
      noOfBoiler: rawData.boilersData?.[0]?.noOfBoiler,
      uuidofBoiler: rawData.boilersData?.[0]?.uuid || "" ,
      totalHeatingSurface: rawData.boilersData?.[0]?.totalHeatingSurface,

      grateArea: rawData.boilersData?.[0]?.grateArea,
      boilerMadeBy: rawData.boilersData?.[0]?.madeBy,
      boilerYearOfMake: rawData.boilersData?.[0]?.yearOfMake,
      workingPressure: rawData.boilersData?.[0]?.workingPressure,
      madeOfMaterial: rawData.boilersData?.[0]?.madeOfMaterial,
      propelerType: rawData.propulsionsData?.[0]?.propelerType,
      propulsionsRpm: rawData.propulsionsData?.[0]?.rpm,
      speedOfVessel: rawData.propulsionsData?.[0]?.speedOfVessel,
      uuidofPropulsionsData: rawData.propulsionsData?.[0]?.uuid || "",
      propulsionGearedOrDirectDriven: rawData.propulsionsData?.[0]?.propulsionGearedOrDirectDriven,
      propulsionType: rawData.propulsionsData?.[0]?.propulsionType,
      registeringAuthority: rawData.propulsionsData?.[0]?.registeringAuthority,
      dateOfRegistration: formatDate(rawData.propulsionsData?.[0]?.dateOfRegistration) ,
    },

    step3: {
      nameOfPersonTitleDerived: rawData.transactionSubsequentToRegistrationsData?.[0]?.nameOfPersonTitleDerived || "",
      noOfSharesAffected: rawData.transactionSubsequentToRegistrationsData?.[0]?.noOfSharesAffected || "",
      uuid:rawData.transactionSubsequentToRegistrationsData?.[0]?.uuid || "",
      dateHourOfRegistry: formatDateTime(rawData.transactionSubsequentToRegistrationsData?.[0]?.dateHourOfRegistry),
      nameResidenceOccupation: rawData.transactionSubsequentToRegistrationsData?.[0]?.nameResidenceOccupation || "",
      numberOfTransactionTransferee: rawData.transactionSubsequentToRegistrationsData?.[0]?.numberOfTransactionTransferee || "",
      remarks: rawData.transactionSubsequentToRegistrationsData?.[0]?.remarks,
      dateOfTransaction: formatDate(rawData.transactionSubsequentToRegistrationsData?.[0]?.dateOfTransaction) ,
      transactionNo: rawData.transactionSubsequentToRegistrationsData?.[0]?.transactionNo || "",
      natureOfTransaction:rawData.transactionSubsequentToRegistrationsData?.[0]?.natureOfTransaction || "",
      uuidOfTransaction:rawData.transactionSubsequentToRegistrationsData?.[0]?.uuid || "",
      isTransDataAvail : rawData?.transactionSubsequentToRegistrationsData?.length > 0 ? true : false
    },
  }
}


