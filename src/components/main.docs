// Add this import at the top
import CertificateOfRegistrationForm8 from "./survey-registrationForms/CertificateOfRegistrationForm8.js";

// In the getSteps function, modify the condition like this:
if (registrationData?.basicDetails?.initialSurveyCompleted) {
  baseSteps.push({
    label: t("Book of Registration"),
    component: (
      <BookOfRegistrationForm
        formMethods={methods}
        viewMode={isOfficerLogin ? false : isViewMode}
        registrationData={registrationData}
      />
    ),
    validate: () => true,
    getFormData: () => methods?.getValues(),
  });

  baseSteps.push({
    label: t("Certificate of Registration Form 8"),
    component: (
      <CertificateOfRegistrationForm8
        formMethods={methods}
        viewMode={isOfficerLogin ? false : isViewMode}
        registrationData={registrationData}
      />
    ),
    validate: () => true,
    getFormData: () => methods?.getValues(),
  });
}
