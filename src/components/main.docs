// Add this import at the top
import BookOfRegistrationForm from "./BookOfRegistrationForm.js";

// In the getSteps function, modify it like this:
const getSteps = () => {
  const baseSteps = [
    {
      label: t("Survey of Inland Vessel Details"),
      component: (
        <VesselSurveyForm
          formMethods={methods}
          viewMode={isViewMode}
          editMode={isEditMode}
          registrationData={registrationData}
          intialSurveyData={intialSurveyData}
        />
      ),
      validate: validateSurveyForm,
      getFormData: () => methods?.getValues(),
    },
    {
      label: t("Equipment & Vessel Information"),
      component: (
        <VesselEquipmentForm
          formMethods={methods}
          viewMode={isViewMode}
          editMode={isEditMode}
          registrationData={registrationData}
        />
      ),
      validate: validateEquipmentForm,
      getFormData: () => methods?.getValues(),
    },
  ];

  // Add Book of Registration step when initial survey is completed
  if (registrationData?.basicDetails?.initialSurveyCompleted) {
    baseSteps.push({
      label: t("Book of Registration"),
      component: (
        <BookOfRegistrationForm
          formMethods={methods}
          viewMode={isOfficerLogin ? false : isViewMode} // Officers can edit in view mode
          registrationData={registrationData}
        />
      ),
      validate: () => true,
      getFormData: () => methods?.getValues(),
    });
  }

  if (!isOfficerLogin && !viewMode && userRole === USER_ROLES.VESSEL_OWNER) {
    baseSteps.push({
      label: t("vesselDetails.Invoicing"),
      component: (
        <Invoicing
          supervisionAuthority={
            registrationData?.vessel?.supervisionAuthority ||
            "CLASSIFICATION SOCIETY"
          }
          onPayNow={handlePayNow}
          vesselRegisData={registrationData}
          paymentData={paymentData}
        />
      ),
      validate: () => true,
    });
  }
  return baseSteps;
};
