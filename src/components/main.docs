import React, { useState, useEffect, useImperativeHandle, forwardRef } from "react";
import { Row, Col, Table, Card, Form } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { formatDate } from "../../../../../utils/constants.ts";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import styles from "../../../../common/styles/ProvisionalCertificateOfRegistration.module.css";

const ProvisionalCertificateOfRegistration = forwardRef(({ registrationData, surveyData, preFilledCertData }, ref) => {
  const { t } = useTranslation();

  const currentDate = new Date();
  const expiryDate = new Date(currentDate.getTime() + 365 * 24 * 60 * 60 * 1000);

  // Editable fields state
  const [editableData, setEditableData] = useState({
    expiryDate: formatDate(expiryDate),
    previousRegistrationNo: "",
    dateOfPreviousRegistry: "",
    portOfPreviousRegistry: "",
    stern: "",
    build: "",
    lengthOfEngineRoom: "",
    detailedSummary: "",
    numberOfTenthShares: "10/10",
    hasFullOwnership: true
  });

  const [errors, setErrors] = useState({});
  const [touched, setTouched] = useState({});

  // Expose methods via ref
  useImperativeHandle(ref, () => ({
    getFormData: () => {
      return editableData;
    },
    validateForm: () => {
      return validate();
    }
  }));

  useEffect(() => {
    if (preFilledCertData) {
      setEditableData(prev => ({
        ...prev,
        expiryDate: preFilledCertData.certificateExpiryDate || formatDate(expiryDate),
        previousRegistrationNo: preFilledCertData.previousRegistrationNumber || "",
        dateOfPreviousRegistry: preFilledCertData.dateOfPreviousRegisty || "",
        portOfPreviousRegistry: preFilledCertData.portOfPreviousRegisty || "",
        stern: preFilledCertData.stern || "",
        build: preFilledCertData.build || "",
        lengthOfEngineRoom: preFilledCertData.lengthOfEngineRoom?.toString() || "",
        detailedSummary: preFilledCertData.summaryDescriptionOfTonnage || "",
        numberOfTenthShares: preFilledCertData.numberOfTenthShares || "10/10",
        hasFullOwnership: true
      }));
    }
  }, [preFilledCertData]);

  const validate = () => {
    const newErrors = {};

    // Required fields validation
    if (!editableData.expiryDate?.trim()) newErrors.expiryDate = 'Expiry date is required';
    if (!editableData.lengthOfEngineRoom?.trim()) newErrors.lengthOfEngineRoom = 'Length of engine room is required';
    if (!editableData.detailedSummary?.trim()) newErrors.detailedSummary = 'Detailed summary is required';

    // Date validation
    if (editableData.expiryDate) {
      const expiry = new Date(editableData.expiryDate);
      if (expiry <= currentDate) newErrors.expiryDate = 'Expiry date must be in the future';
    }

    if (editableData.dateOfPreviousRegistry) {
      const prevRegistryDate = new Date(editableData.dateOfPreviousRegistry);
      if (prevRegistryDate > currentDate) newErrors.dateOfPreviousRegistry = 'Previous registry date cannot be in the future';
    }

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleInputChange = (field, value) => {
    setEditableData(prev => ({
      ...prev,
      [field]: value
    }));

    // Clear error when user starts typing
    if (errors[field]) {
      setErrors(prev => ({ ...prev, [field]: '' }));
    }
  };

  const handleBlur = (field) => {
    setTouched(prev => ({ ...prev, [field]: true }));
    validate();
  };

  const hasError = (field) => {
    return touched[field] && errors[field];
  };

  const renderEditableInput = (value, field, placeholder = "", type = "text", required = false) => {
    const error = hasError(field);
    
    return (
      <div className={styles.editableCell}>
        <input
          type={type}
          value={value}
          onChange={(e) => handleInputChange(field, e.target.value)}
          onBlur={() => handleBlur(field)}
          placeholder={placeholder}
          className={error ? styles.error : ""}
        />
        {error && <div className={styles.errorMessage}>{errors[field]}</div>}
      </div>
    );
  };

  const renderAutoPopulateCell = (value, highlight = false) => {
    return (
      <td className={`${styles.autoPopulateCell} ${highlight ? styles.highlight : ''}`}>
        {value || "N/A"}
      </td>
    );
  };

  // Validation summary component
  const ValidationSummary = () => {
    const errorCount = Object.keys(errors).filter(key => errors[key]).length;
    
    if (errorCount === 0) return null;

    return (
      <div className={styles.validationSummary}>
        <div className={styles.validationSummaryTitle}>
          Please fix the following errors:
        </div>
        <ul className={styles.validationSummaryList}>
          {Object.entries(errors).map(([field, message]) => 
            message && <li key={field} className={styles.validationSummaryItem}>{message}</li>
          )}
        </ul>
      </div>
    );
  };

  return (
    <div className={styles.registrationCertificateContainer}>
      <div className={styles.certificateHeader}>
        <h2 className={styles.certificateTitle}>
          PROVISIONAL CERTIFICATE OF REGISTRATION
        </h2>
        <p className={styles.certificateSubtitle}>
          Issued under the Inland Vessels Act, 2021
        </p>
      </div>

      <div className={styles.certificateBody}>
        <ValidationSummary />
        
        {/* Expiry Date */}
        <div className={styles.expirySection}>
          <span className={`${styles.expiryLabel} ${styles.required}`}>
            {t("Expiry on or before the")}
          </span>
          <input
            type="date"
            className={`${styles.editableDate} ${hasError('expiryDate') ? styles.error : ''}`}
            value={editableData.expiryDate}
            onChange={(e) => handleInputChange("expiryDate", e.target.value)}
            onBlur={() => handleBlur('expiryDate')}
          />
          {hasError('expiryDate') && (
            <div className={styles.errorMessage}>{errors.expiryDate}</div>
          )}
        </div>

        {/* Issued By */}
        <div className={styles.issuedBySection}>
          <span className={styles.issuedLabel}>
            {t("Issued by")} ({t("IWT Authority")})
          </span>
        </div>

        {/* Particulars of Vessel */}
        <div className="vessel-particulars">
          <h5 className={styles.sectionTitle}>{t("PARTICULARS OF VESSEL")}</h5>

          <Table bordered className={styles.particularsTable}>
            <tbody>
              <tr>
                <td className={styles.labelCell}>{t("Official Number")}</td>
                {renderAutoPopulateCell(preFilledCertData?.officialNumber, true)}
                <td className={styles.labelCell}>{t("Registration Date")}</td>
                {renderAutoPopulateCell(preFilledCertData?.registrationDate, true)}
                <td className={styles.labelCell}>{t("Name of the Vessel")}</td>
                {renderAutoPopulateCell(preFilledCertData?.vesselName, true)}
                <td className={styles.labelCell}>{t("Port of Registry")}</td>
                {renderAutoPopulateCell(preFilledCertData?.portOfRegistry, true)}
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Previous Registration No.")}</td>
                {renderEditableInput(editableData.previousRegistrationNo, 'previousRegistrationNo', "Enter if any")}
                <td className={styles.labelCell}>{t("Date of Previous Registry")}</td>
                {renderEditableInput(editableData.dateOfPreviousRegistry, 'dateOfPreviousRegistry', "", "date")}
                <td className={styles.labelCell}>{t("Port of Previous Registry")}</td>
                {renderEditableInput(editableData.portOfPreviousRegistry, 'portOfPreviousRegistry', "Enter if any")}
                <td className={styles.labelCell}>{t("Name of Builder")}</td>
                {renderAutoPopulateCell(preFilledCertData?.nameOfBuilder)}
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Address of Builder")}</td>
                {renderAutoPopulateCell(preFilledCertData?.addressOfBuilder)}
                <td className={styles.labelCell}>{t("Where Built")}</td>
                {renderAutoPopulateCell(preFilledCertData?.placeOfBuilt)}
                <td className={styles.labelCell}>{t("Propulsion Type")}</td>
                {renderAutoPopulateCell(preFilledCertData?.propulsionType)}
                <td className={styles.labelCell}>{t("Number of Deck")}</td>
                {renderAutoPopulateCell(preFilledCertData?.numberOfDeck)}
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Material Description")}</td>
                {renderAutoPopulateCell(preFilledCertData?.materialDescription)}
                <td className={styles.labelCell}>{t("Number of Bulkheads")}</td>
                {renderAutoPopulateCell(preFilledCertData?.numberOfBulkHeads)}
                <td className={styles.labelCell}>{t("Stern")}</td>
                {renderEditableInput(editableData.stern, 'stern', "Enter stern details")}
                <td className={styles.labelCell}>{t("Build")}</td>
                {renderEditableInput(editableData.build, 'build', "Enter build year")}
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Length")}</td>
                {renderAutoPopulateCell(preFilledCertData?.length)}
                <td className={styles.labelCell}>{t("Breadth")}</td>
                {renderAutoPopulateCell(preFilledCertData?.breadth)}
                <td className={styles.labelCell}>{t("Depth")}</td>
                {renderAutoPopulateCell(preFilledCertData?.depth)}
                <td className={styles.labelCell}>{t("Draft")}</td>
                {renderAutoPopulateCell(preFilledCertData?.draft)}
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Length of the Engine Room")}</td>
                {renderEditableInput(editableData.lengthOfEngineRoom, 'lengthOfEngineRoom', "Enter length", "number", true)}
                <td className={styles.labelCell}>{t("GROSS TONNAGE")}</td>
                {renderAutoPopulateCell(preFilledCertData?.grossTonnage, true)}
                <td className={styles.labelCell}>{t("NET TONNAGE")}</td>
                {renderAutoPopulateCell(preFilledCertData?.netTonnage, true)}
                <td className={styles.labelCell}>{t("Number of crew")}</td>
                {renderAutoPopulateCell(preFilledCertData?.numberOfCrew)}
              </tr>
              <tr>
                <td className={styles.labelCell}>{t("Number of Engines:")}</td>
                {renderAutoPopulateCell(preFilledCertData?.numberOfEngines)}
                <td className={styles.labelCell}>{t("Combined Power")}</td>
                {renderAutoPopulateCell(preFilledCertData?.combinedPower ? `${preFilledCertData.combinedPower} HP` : "N/A")}
                <td className={styles.labelCell}>{t("Name of Engine Maker")}</td>
                {renderAutoPopulateCell(preFilledCertData?.nameOfEngineMaker)}
                <td className={styles.labelCell}>{t("Address of Engine Maker")}</td>
                {renderAutoPopulateCell(preFilledCertData?.addressOfEngineMaker)}
              </tr>
            </tbody>
          </Table>
        </div>

        {/* Survey Certificate Note */}
        <div className={styles.surveyNote}>
          <p className={styles.noteText}>
            {t(
              "A detailed summary of the tonnages for this vessel is shown on the Certificate of Survey"
            )}
          </p>
        </div>

        {/* Detailed Summary Textarea */}
        <div className={styles.detailedSummary}>
          <label htmlFor="detailedSummary" className="form-label fw-bold text-primary">
            Detailed Summary of Tonnages *
          </label>
          <textarea
            className={`form-control ${hasError('detailedSummary') ? styles.error : ''}`}
            id="detailedSummary"
            rows="5"
            value={editableData.detailedSummary}
            onChange={(e) => handleInputChange('detailedSummary', e.target.value)}
            onBlur={() => handleBlur('detailedSummary')}
            placeholder="Provide detailed summary of tonnages as shown on Certificate of Survey"
          />
          {hasError('detailedSummary') && (
            <div className={styles.errorMessage}>{errors.detailedSummary}</div>
          )}
        </div>

        {/* Crew Accommodation */}
        <div className={styles.crewSection}>
          <div className={styles.crewInfo}>
            <span className={styles.crewLabel}>
              {t("The Number of crew for whom accommodation is certified")}
            </span>
            <span className={styles.crewValue}>
              {preFilledCertData?.numberOfCrew ?? "N/A"}
            </span>
          </div>
        </div>

        {/* Certification Statement */}
        <div className={styles.certificationStatement}>
          <p className={styles.statementText}>
            {t("I, the undersigned, Registering Authority at the Port of")}{" "}
            <strong>{preFilledCertData?.portOfRegistry || "N/A"}</strong>{" "}
            {t("in")} <strong>{preFilledCertData?.state || "West Bengal"}</strong>{" "}
            {t(
              "here by certify that the Inland Vessel the Description of which is prefixed to this Provisional certificate, has been duly surveyed, and that the above Description is true; that"
            )}{" "}
            <strong>{preFilledCertData?.nameOfMaster || "N/A"}</strong>{" "}
            {t("whose Certificate of Competency of Service is No")}{" "}
            <strong>{preFilledCertData?.cocNumber || "N/A"}</strong>,{" "}
            {t("is the Master of the said Vessel, and that the Name")}{" "}
            <strong>{preFilledCertData?.ownerName || "N/A"}</strong>{" "}
            {t("Residence of")}{" "}
            <strong>{preFilledCertData?.addressOfOwner || "N/A"}</strong>,{" "}
            {t("owner of")}{" "}
            <strong>{preFilledCertData?.vesselName || "N/A"}</strong>,{" "}
            {t("Number of Tenth Shares Held by are as follows")} :-
          </p>
        </div>

        {/* Owner Details Table */}
        <div className="owner-details">
          <Table bordered className={styles.ownerTable}>
            <thead>
              <tr>
                <th className={styles.ownerHeader}>
                  {t("Name Residence and Occupation of the Owner")}
                </th>
                <th className={styles.sharesHeader}>
                  {t("Number of Tenth Shares")}
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td className={styles.ownerInfo}>
                  <div>
                    <strong>{t("Name")}:</strong> {preFilledCertData?.ownerName || "N/A"}
                  </div>
                  <div>
                    <strong>{t("Residence")}:</strong> {preFilledCertData?.addressOfOwner || "N/A"}
                  </div>
                  <div>
                    <strong>{t("Occupation")}:</strong> {registrationData?.other?.occupation || "Business"}
                  </div>
                  <div className={styles.tenthSharesCheckbox}>
                    <Form.Check
                      type="checkbox"
                      checked={editableData.hasFullOwnership}
                      onChange={(e) => handleInputChange('hasFullOwnership', e.target.checked)}
                      label="Full Ownership (10/10 shares)"
                    />
                  </div>
                </td>
                <td className={styles.sharesCell}>
                  <span className={styles.sharesValue}>
                    {editableData.hasFullOwnership ? "10/10" : editableData.numberOfTenthShares}
                  </span>
                  {!editableData.hasFullOwnership && (
                    <div className="mt-2">
                      <input
                        type="text"
                        className="form-control form-control-sm"
                        value={editableData.numberOfTenthShares}
                        onChange={(e) => handleInputChange('numberOfTenthShares', e.target.value)}
                        placeholder="e.g., 5/10"
                      />
                    </div>
                  )}
                </td>
              </tr>
            </tbody>
          </Table>
        </div>
      </div>
    </div>
  );
});

export default ProvisionalCertificateOfRegistration;
