import React, { useState, useEffect, useRef } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Button, Card, Badge, Stack } from 'react-bootstrap';
import { FaFileAlt, FaFileUpload, FaArrowLeft, FaArrowRight, FaArrowAltCircleLeft, FaCheckCircle, FaFileExcel } from 'react-icons/fa';
import { BsFileEarmarkX, BsDownload } from 'react-icons/bs';
import createFormFieldsConfig from '../../../common/FormFieldsConfig';
import { useNavigate } from 'react-router-dom';
import ActionDropdown from '../../../common/ActionDropdown';
import ApprovalModal from '../../../common/ApprovalModal';
import './userViewPage.css';
import NewLoader from '../../../common/NewLoader';
import DynamicViewFields from '../../../common/DynamicViewFields';

const UserViewPage = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(true);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [completedSteps, setCompletedSteps] = useState(new Set());
  const navigate = useNavigate();
  const totalSteps = 2;
  const actionsFromAPI = ["Approve", "Reject", "Request Changes"];
  const loaderRef = useRef();

  const applicationNumber = "APP-2025-001";

  const mockApplicationData = {
    firstName: "John",
    lastName: "Doe",
    emailId: "john.doe@example.com",
    phoneNumber: "9876543210",
    panNumber: "ABCDE1234F",
    gstNumber: "22ABCDE1234F1Z5",
    addressLine1: "123 Main Street",
    addressLine2: "Building A",
    pin: "700001",
    district: "Kolkata",
    stateUt: "West Bengal",
    country: "India",
    addressProof: "address_proof.pdf",
    panCardUpload: "pan_card.pdf",
    gstCertificate: "gst_certificate.pdf",
    pollutionCertificate: "", // No file
    esipfCertificate: "", // No file
    status: "Pending Review"
  };

  useEffect(() => {
    setIsLoading(true);
    loaderRef.current?.show?.();
    setTimeout(() => {
      setFormData(mockApplicationData);
      setIsLoading(false);
      loaderRef.current?.hide?.();
      // Don't mark any steps as completed initially
    }, 500);
  }, []);

  const methods = useForm({ defaultValues: { country: 'India' } });
  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading) {
      Object.keys(formData).forEach(key => {
        if (formData[key]) {
          setValue(key, formData[key]);
        }
      });
    }
  }, [isLoading, formData, setValue]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      ...formData,
    };
    console.log("Action submitted:", payload);
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleDownload = (filename) => {
    const blob = new Blob(["Dummy file content"], { type: "text/plain" });
    const link = document.createElement("a");
    link.href = window.URL.createObjectURL(blob);
    link.download = filename;
    link.click();
    window.URL.revokeObjectURL(link.href);
  };

  // Define which fields should show no file vs static files
  const noFileFields = ['pollutionCertificate', 'esipfCertificate'];
  
  const renderFileField = (value, fieldName) => (
    <div className="file-display-container">
      {value || !noFileFields.includes(fieldName) ? (
        <div className="file-display-with-doc">
          <div className="file-info">
            <FaFileExcel className="file-icon text-success me-2" size={16} />
            <span className="file-name">
              {value || `${fieldName.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase())}.pdf`}
            </span>
          </div>
          <Button
            variant="link"
            size="sm"
            className="file-download-btn"
            onClick={() => handleDownload(value || `${fieldName}.pdf`)}
            tabIndex={-1}
          >
            <BsDownload size={14} />
          </Button>
        </div>
      ) : (
        <div className="file-display-no-doc">
          <BsFileEarmarkX className="no-doc-icon text-muted me-2" size={16} />
          <span className="no-doc-text">No document uploaded</span>
        </div>
      )}
    </div>
  );

  const getDisabledFormFieldsConfig = () => {
    const originalConfig = createFormFieldsConfig(() => { });
    const disabledStep1 = originalConfig.step1.map(field => ({
      ...field,
      disabled: true,
      inputClassName: 'disabled-field'
    }));
    const disabledStep2 = originalConfig.step2.map(field => ({
      ...field,
      disabled: true,
      render: (value) => renderFileField(value, field.name)
    }));
    return {
      step1: disabledStep1,
      step2: disabledStep2
    };
  };

  const formFields = getDisabledFormFieldsConfig();

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      default: return [];
    }
  };

  const handleNext = () => {
    if (currentStep < totalSteps) {
      // Mark current step as completed when moving to next
      setCompletedSteps(prev => new Set([...prev, currentStep]));
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const handleBackToList = () => {
    navigate('/user-registration/view');
  };

  const getStatusBadge = (status) => {
    const statusMap = {
      'Pending Review': 'warning',
      'Approved': 'success',
      'Rejected': 'danger',
      'Processing': 'info'
    };
    return <Badge bg={statusMap[status] || 'secondary'} className="status-badge">{status}</Badge>;
  };

  const getStepIcon = (stepNumber) => {
    if (completedSteps.has(stepNumber)) {
      return <FaCheckCircle className="text-white" size={18} />;
    }
    if (stepNumber === 1) {
      return currentStep === 1 ? <FaFileAlt className="text-white" size={16} /> : '1';
    }
    if (stepNumber === 2) {
      return currentStep === 2 ? <FaFileUpload className="text-white" size={16} /> : '2';
    }
    return stepNumber;
  };

  if (isLoading) {
    return <NewLoader ref={loaderRef} />;
  }

  return (
    <>
      <Container fluid className="py-4 officer-view-container">
        <Row className="justify-content-center">
          <Col size={12}>
            <Card className="shadow-lg border-0 modern-card">
              <Card.Header className="modern-header">
                <Stack direction="horizontal" gap={3} className="flex-wrap justify-content-between align-items-center">
                  <button
                    className="btn back-button modern-back-btn"
                    onClick={handleBackToList}
                  >
                    <FaArrowAltCircleLeft size={20} className="text-primary" />
                  </button>

                  <div className="flex-grow-1 d-flex flex-column align-items-center">
                    <div className="d-flex flex-wrap align-items-center justify-content-center gap-2">
                      <span className="application-label">Application Number:</span>
                      <span className="application-number">
                        {applicationNumber}
                      </span>
                    </div>
                  </div>
                  
                  <div className="status-container">
                    {getStatusBadge(formData.status)}
                  </div>
                </Stack>
              </Card.Header>

              <Card.Body className="modern-body">
                {/* Modern Stepper */}
                <div className="modern-stepper-wrapper">
                  <div className={`modern-stepper-item ${currentStep === 1 ? 'active' : ''} ${completedSteps.has(1) ? 'completed' : ''}`}>
                    <div className="modern-step-counter">
                      {getStepIcon(1)}
                    </div>
                    <div className="modern-step-name">Basic Details</div>
                  </div>
                  
                  <div className="stepper-connector"></div>
                  
                  <div className={`modern-stepper-item ${currentStep === 2 ? 'active' : ''} ${completedSteps.has(2) ? 'completed' : ''}`}>
                    <div className="modern-step-counter">
                      {getStepIcon(2)}
                    </div>
                    <div className="modern-step-name">Documents</div>
                  </div>
                </div>

                <FormProvider {...methods}>
                  <form>
                    <div className="form-content">
                      <Row className="g-4">
                        <DynamicViewFields
                          fields={getCurrentStepFields()}
                          setFormData={setFormData}
                        />
                      </Row>
                    </div>

                    <div className="navigation-footer">
                      <Button
                        variant="outline-primary"
                        onClick={handlePrevious}
                        disabled={currentStep === 1}
                        className="nav-btn prev-btn"
                      >
                        <FaArrowLeft className="me-2" size={14} /> Previous
                      </Button>
                      
                      {currentStep < totalSteps ? (
                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="nav-btn next-btn"
                        >
                          Next <FaArrowRight className="ms-2" size={14} />
                        </Button>
                      ) : (
                        <ActionDropdown
                          actions={actionsFromAPI}
                          onActionClick={handleActionClick}
                          variant="primary"
                          className="action-dropdown"
                        />
                      )}
                    </div>
                  </form>
                </FormProvider>
              </Card.Body>
            </Card>
          </Col>
        </Row>

        <ApprovalModal
          show={showApprovalModal}
          handleClose={handleCloseModal}
          handleSubmitData={handleActionSubmit}
          selectedAction={selectedAction}
        />
      </Container>
    </>
  );
};

export default UserViewPage;
.officer-view-container {
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  min-height: 100vh;
  padding: 2rem 1rem;
}

.modern-card {
  border-radius: 16px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  border: none;
  overflow: hidden;
}

.modern-header {
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  border-bottom: 1px solid #e2e8f0;
  padding: 2rem;
}

.modern-back-btn {
  background: none;
  border: none;
  padding: 0.5rem;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.modern-back-btn:hover {
  background: rgba(59, 130, 246, 0.1);
  transform: translateX(-2px);
}

.application-label {
  font-size: 1rem;
  font-weight: 600;
  color: #64748b;
  letter-spacing: 0.025em;
}

.application-number {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: white;
  padding: 0.5rem 1.25rem;
  border-radius: 25px;
  font-weight: 700;
  font-size: 0.95rem;
  letter-spacing: 0.05em;
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}

.status-container {
  min-width: 120px;
  text-align: center;
}

.status-badge {
  font-size: 0.85rem;
  padding: 0.6rem 1.2rem;
  border-radius: 20px;
  font-weight: 600;
  letter-spacing: 0.025em;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.modern-body {
  padding: 2.5rem;
  background: #ffffff;
}

/* Modern Stepper */
.modern-stepper-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 3rem;
  position: relative;
}

.modern-stepper-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
}

.stepper-connector {
  flex: 1;
  height: 3px;
  background: linear-gradient(90deg, #e2e8f0 0%, #cbd5e1 100%);
  margin: 0 2rem;
  border-radius: 2px;
  position: relative;
}

.modern-stepper-item.completed ~ .stepper-connector::before,
.modern-stepper-item.active ~ .stepper-connector::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, #10b981 0%, #059669 100%);
  border-radius: 2px;
  width: 100%;
  transition: width 0.5s ease;
}

.modern-step-counter {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 1.1rem;
  margin-bottom: 0.75rem;
  transition: all 0.3s ease;
  background: #e2e8f0;
  color: #64748b;
  border: 3px solid #e2e8f0;
}

.modern-stepper-item.active .modern-step-counter {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: white;
  border-color: #3b82f6;
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  transform: scale(1.05);
}

.modern-stepper-item.completed .modern-step-counter {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: white;
  border-color: #10b981;
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
}

.modern-step-name {
  font-size: 0.9rem;
  font-weight: 600;
  color: #64748b;
  text-align: center;
  letter-spacing: 0.025em;
}

.modern-stepper-item.active .modern-step-name {
  color: #3b82f6;
  font-weight: 700;
}

.modern-stepper-item.completed .modern-step-name {
  color: #10b981;
  font-weight: 700;
}

/* Form Content */
.form-content {
  padding: 1rem 0;
}

.disabled-field {
  background-color: #f8fafc !important;
  border: 2px solid #e2e8f0 !important;
  border-radius: 8px !important;
  color: #475569 !important;
  font-weight: 500;
}

/* File Display */
.file-display-container {
  width: 100%;
}

.file-display-with-doc {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1rem;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border: 2px solid #0ea5e9;
  border-radius: 8px;
  transition: all 0.3s ease;
}

.file-display-with-doc:hover {
  box-shadow: 0 4px 12px rgba(14, 165, 233, 0.2);
  transform: translateY(-1px);
}

.file-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.file-name {
  font-weight: 600;
  color: #0369a1;
  font-size: 0.9rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-download-btn {
  color: #059669 !important;
  padding: 0.25rem 0.5rem !important;
  border-radius: 6px;
  transition: all 0.2s ease;
  text-decoration: none !important;
}

.file-download-btn:hover {
  background: rgba(5, 150, 105, 0.1);
  transform: scale(1.1);
}

.file-display-no-doc {
  display: flex;
  align-items: center;
  padding: 0.75rem 1rem;
  background: #f8fafc;
  border: 2px dashed #cbd5e1;
  border-radius: 8px;
}

.no-doc-text {
  font-weight: 500;
  color: #64748b;
  font-size: 0.9rem;
  font-style: italic;
}

/* Navigation Footer */
.navigation-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 2px solid #f1f5f9;
}

/* .nav-btn {
  padding: 0.75rem 2rem;
  border-radius: 25px;
  font-weight: 600;
  font-size: 0.9rem;
  letter-spacing: 0.025em;
  transition: all 0.3s ease;
  border: 2px solid;
} */

.prev-btn {
  border-color: #3b82f6;
  color: #3b82f6;
}

.prev-btn:hover:not(:disabled) {
  background: #3b82f6;
  color: white;
  transform: translateX(-2px);
}

.next-btn {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  border-color: #3b82f6;
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}

.next-btn:hover {
  transform: translateX(2px);
  box-shadow: 0 6px 16px rgba(59, 130, 246, 0.4);
}

.action-dropdown {
  padding: 0.75rem 2rem;
  border-radius: 25px;
  font-weight: 600;
}

/* Responsive Design */
@media (max-width: 768px) {
  .officer-view-container {
    padding: 1rem 0.5rem;
  }
  
  .modern-header {
    padding: 1.5rem;
  }
  
  .modern-body {
    padding: 1.5rem;
  }
  
  .modern-stepper-wrapper {
    flex-direction: column;
    gap: 1rem;
  }
  
  .stepper-connector {
    width: 3px;
    height: 2rem;
    margin: 0;
  }
  
  .navigation-footer {
    flex-direction: column;
    gap: 1rem;
  }
  
  .nav-btn {
    width: 100%;
    justify-content: center;
  }
}

.nav-btn {
  padding: 0.75rem 2rem;
  border-radius: 8px; 
  font-size: 0.9rem;
  letter-spacing: 0.025em;
  transition: all 0.3s ease;
  border: 2px solid;
}

.next-btn {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  border-color: #3b82f6;
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  border-radius: 8px; 
}

.action-dropdown {
  padding: 0.75rem 2rem;
  border-radius: 8px;
  font-weight: 600;
}


.file-download-btn {
  color: #059669 !important;
  padding: 0.25rem 0.5rem !important;
  border-radius: 6px;
  transition: all 0.2s ease;
  text-decoration: none !important;
  min-width: auto;
}
