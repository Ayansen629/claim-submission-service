// Add state to store complete response data
const [completeResponseData, setCompleteResponseData] = useState(null);

const submitTransferData = async (formValues, stepIndex, stepInfo = null) => {
  try {
    loaderRef.current?.show();
    
    let payload;

    if (stepIndex === 0) {
      if (completeResponseData) {
        // Update mode: Use existing complete response and update only step 1 fields
        payload = {
          ...completeResponseData,
          registrationRequest: {
            ...completeResponseData.registrationRequest,
            basicDetails: {
              ...completeResponseData.registrationRequest.basicDetails,
              dateOfRegistration: formValues?.basicDetails?.dateOfRegistration || completeResponseData.registrationRequest.basicDetails.dateOfRegistration,
              occupation: formValues?.basicDetails?.occupation || completeResponseData.registrationRequest.basicDetails.occupation,
              originalPlaceBusiness: formValues?.basicDetails?.originalPlaceOfBusiness || completeResponseData.registrationRequest.basicDetails.originalPlaceBusiness
            },
            vesselDetails: {
              ...completeResponseData.registrationRequest.vesselDetails,
              typeOfVessel: formValues?.vesselDetails?.typeOfVessel || completeResponseData.registrationRequest.vesselDetails.typeOfVessel,
              categoryOfVessel: formValues?.vesselDetails?.categoryOfVessel || completeResponseData.registrationRequest.vesselDetails.categoryOfVessel,
              grossTonnage: parseFloat(formValues?.vesselDetails?.grossTonnage) || completeResponseData.registrationRequest.vesselDetails.grossTonnage,
              registrationNumber: formValues?.basicVesselInfo?.officialNo || completeResponseData.registrationRequest.vesselDetails.registrationNumber,
              vesselName: formValues?.vesselDetails?.vesselName || completeResponseData.registrationRequest.vesselDetails.vesselName,
              yearOfBuild: parseInt(formValues?.vesselDetails?.yearOfBuild) || completeResponseData.registrationRequest.vesselDetails.yearOfBuild,
              lengthOfVessel: parseFloat(formValues?.vesselDetails?.lengthOfVessel) || completeResponseData.registrationRequest.vesselDetails.lengthOfVessel,
              breadthOfVessel: parseFloat(formValues?.vesselDetails?.breadthOfVessel) || completeResponseData.registrationRequest.vesselDetails.breadthOfVessel,
              depthOfVessel: parseFloat(formValues?.vesselDetails?.depthOfVessel) || completeResponseData.registrationRequest.vesselDetails.depthOfVessel,
              previousPort: formValues?.vesselDetails?.portOfRegistry || completeResponseData.registrationRequest.vesselDetails.previousPort,
              reasonOfChange: formValues?.basicVesselInfo?.reasonForTransfer || completeResponseData.registrationRequest.vesselDetails.reasonOfChange
            },
            engineDetails: {
              ...completeResponseData.registrationRequest.engineDetails,
              engineType: formValues?.engineDetails?.engineType || completeResponseData.registrationRequest.engineDetails.engineType,
              engineMake: formValues?.engineDetails?.engineMake || completeResponseData.registrationRequest.engineDetails.engineMake,
              makerAddress: formValues?.engineDetails?.makerAddress || completeResponseData.registrationRequest.engineDetails.makerAddress,
              horsepower: parseFloat(formValues?.engineDetails?.horsepower) || completeResponseData.registrationRequest.engineDetails.horsepower,
              speed: parseFloat(formValues?.engineDetails?.speed) || completeResponseData.registrationRequest.engineDetails.speed,
              yearOfMake: formValues?.engineDetails?.yearOfMake || completeResponseData.registrationRequest.engineDetails.yearOfMake,
              modelNo: formValues?.engineDetails?.modelNo || completeResponseData.registrationRequest.engineDetails.modelNo,
              noOfSet: parseInt(formValues?.engineDetails?.noOfSet) || completeResponseData.registrationRequest.engineDetails.noOfSet,
              numberOfEngine: parseInt(formValues?.engineDetails?.numberOfEngine) || completeResponseData.registrationRequest.engineDetails.numberOfEngine,
              serialNo: formValues?.engineDetails?.serialNo || completeResponseData.registrationRequest.engineDetails.serialNo,
              propellerType: formValues?.engineDetails?.propellerType || completeResponseData.registrationRequest.engineDetails.propellerType,
              gearType: formValues?.engineDetails?.gearType || completeResponseData.registrationRequest.engineDetails.gearType,
              noOfGear: parseInt(formValues?.engineDetails?.noOfGear) || completeResponseData.registrationRequest.engineDetails.noOfGear,
              vesselSpeed: formValues?.engineDetails?.vesselSpeed || completeResponseData.registrationRequest.engineDetails.vesselSpeed,
              rpm: parseInt(formValues?.engineDetails?.rpm) || completeResponseData.registrationRequest.engineDetails.rpm,
              engineCylinder: parseFloat(formValues?.engineDetails?.engineCylinder) || completeResponseData.registrationRequest.engineDetails.engineCylinder,
              stroke: parseFloat(formValues?.engineDetails?.stroke) || completeResponseData.registrationRequest.engineDetails.stroke,
              noOfCylinderPerSetRotaryEngine: parseInt(formValues?.engineDetails?.noOfCylinderPerSetRotaryEngine) || completeResponseData.registrationRequest.engineDetails.noOfCylinderPerSetRotaryEngine,
              noOfCylinderPerSetReciprocatingEngine: parseInt(formValues?.engineDetails?.noOfCylinderPerSetReciprocatingEngine) || completeResponseData.registrationRequest.engineDetails.noOfCylinderPerSetReciprocatingEngine,
              noOfShaft: parseInt(formValues?.engineDetails?.noOfShaft) || completeResponseData.registrationRequest.engineDetails.noOfShaft,
              lengthOfEngineRoom: parseFloat(formValues?.engineDetails?.lengthOfEngineRoom) || completeResponseData.registrationRequest.engineDetails.lengthOfEngineRoom
            }
          },
          initialSurveyRequest: {
            ...completeResponseData.initialSurveyRequest,
            BasicVesselInformation: {
              ...completeResponseData.initialSurveyRequest.BasicVesselInformation,
              placeYardNo: formValues?.basicVesselInfo?.proposedPortOfRegistry || completeResponseData.initialSurveyRequest.BasicVesselInformation.placeYardNo,
              netTonnage: parseFloat(formValues?.vesselDetails?.netTonnage) || completeResponseData.initialSurveyRequest.BasicVesselInformation.netTonnage,
              placeOfLastSurvey: formValues?.basicVesselInfo?.placeOfLastSurvey || completeResponseData.initialSurveyRequest.BasicVesselInformation.placeOfLastSurvey,
              dateOfLastSurvey: formValues?.basicDetails?.builderDetails?.dateOfLastSurvey || completeResponseData.initialSurveyRequest.BasicVesselInformation.dateOfLastSurvey,
              lengthOfVessel: formValues?.vesselDetails?.lengthOfVessel || completeResponseData.initialSurveyRequest.BasicVesselInformation.lengthOfVessel,
              breadthOfVessel: formValues?.vesselDetails?.breadthOfVessel || completeResponseData.initialSurveyRequest.BasicVesselInformation.breadthOfVessel,
              depthOfVessel: formValues?.vesselDetails?.depthOfVessel || completeResponseData.initialSurveyRequest.BasicVesselInformation.depthOfVessel,
              draft: formValues?.basicVesselInfo?.draft || completeResponseData.initialSurveyRequest.BasicVesselInformation.draft,
              totalNoOfDeckCrew: formValues?.crewDetails?.totalDeckCrew || completeResponseData.initialSurveyRequest.BasicVesselInformation.totalNoOfDeckCrew,
              totalNoOfEngineCrew: formValues?.crewDetails?.totalEngineCrew || completeResponseData.initialSurveyRequest.BasicVesselInformation.totalNoOfEngineCrew
            },
            HullParticulars: {
              ...completeResponseData.initialSurveyRequest.HullParticulars,
              frameMaterial: formValues?.hullParticulars?.frameMaterial || completeResponseData.initialSurveyRequest.HullParticulars.frameMaterial,
              frameThickness: formValues?.hullParticulars?.frameThickness || completeResponseData.initialSurveyRequest.HullParticulars.frameThickness,
              floorMaterial: formValues?.hullParticulars?.floorMaterial || completeResponseData.initialSurveyRequest.HullParticulars.floorMaterial,
              hullMaterial: formValues?.hullParticulars?.hullMaterial || completeResponseData.initialSurveyRequest.HullParticulars.hullMaterial,
              hullPlatingThickness: formValues?.hullParticulars?.hullPlattingThickness || completeResponseData.initialSurveyRequest.HullParticulars.hullPlatingThickness,
              keelLayingDate: formValues?.hullParticulars?.keelLayingDate || completeResponseData.initialSurveyRequest.HullParticulars.keelLayingDate,
              hullPlatingMaterial: formValues?.hullParticulars?.hullPlatingMaterial || completeResponseData.initialSurveyRequest.HullParticulars.hullPlatingMaterial,
              noOfBulkheads: formValues?.hullParticulars?.numberOfBulkheads || completeResponseData.initialSurveyRequest.HullParticulars.noOfBulkheads,
              bulkheadPlacement: formValues?.hullParticulars?.bulkheadPlacement || completeResponseData.initialSurveyRequest.HullParticulars.bulkheadPlacement,
              bulkheadThickness: formValues?.hullParticulars?.bulkheadThickness || completeResponseData.initialSurveyRequest.HullParticulars.bulkheadThickness,
              floorThickness: formValues?.hullParticulars?.floorThickness || completeResponseData.initialSurveyRequest.HullParticulars.floorThickness
            },
            RadioandNavigationEquipment: {
              ...completeResponseData.initialSurveyRequest.RadioandNavigationEquipment,
              magneticCompass: parseInt(formValues?.navigationEquipment?.magneticCompass) || completeResponseData.initialSurveyRequest.RadioandNavigationEquipment.magneticCompass,
              vhfRadio: parseInt(formValues?.navigationEquipment?.vhfRadio) || completeResponseData.initialSurveyRequest.RadioandNavigationEquipment.vhfRadio,
              aisIdentifiSystem: parseInt(formValues?.navigationEquipment?.classBAutoAIS) || completeResponseData.initialSurveyRequest.RadioandNavigationEquipment.aisIdentifiSystem,
              gps: parseInt(formValues?.navigationEquipment?.gpsNavigator) || completeResponseData.initialSurveyRequest.RadioandNavigationEquipment.gps,
              binocular: parseInt(formValues?.navigationEquipment?.binocular) || completeResponseData.initialSurveyRequest.RadioandNavigationEquipment.binocular,
              aldisLamp: parseInt(formValues?.navigationEquipment?.aldisLamp) || completeResponseData.initialSurveyRequest.RadioandNavigationEquipment.aldisLamp,
              rudderAngleIndicator: parseInt(formValues?.navigationEquipment?.rudderAngleIndicator) || completeResponseData.initialSurveyRequest.RadioandNavigationEquipment.rudderAngleIndicator,
              others: parseInt(formValues?.navigationEquipment?.othersNavigation) || completeResponseData.initialSurveyRequest.RadioandNavigationEquipment.others
            },
            PollutionControlDevices: {
              ...completeResponseData.initialSurveyRequest.PollutionControlDevices,
              bilgeWaterSeperator: parseInt(formValues?.polutionControl?.bilgeWaterSeparator) || completeResponseData.initialSurveyRequest.PollutionControlDevices.bilgeWaterSeperator,
              capacity: formValues?.polutionControl?.bilgeCapacity || completeResponseData.initialSurveyRequest.PollutionControlDevices.capacity,
              makeModel: formValues?.polutionControl?.bilgeMakeModel || completeResponseData.initialSurveyRequest.PollutionControlDevices.makeModel,
              stp: parseInt(formValues?.polutionControl?.sewageTreatmentPlant) || completeResponseData.initialSurveyRequest.PollutionControlDevices.stp,
              stpCapacity: formValues?.polutionControl?.sewageCapacity || completeResponseData.initialSurveyRequest.PollutionControlDevices.stpCapacity,
              stpMakeModel: formValues?.polutionControl?.sewageMakeModel || completeResponseData.initialSurveyRequest.PollutionControlDevices.stpMakeModel,
              owf: parseInt(formValues?.polutionControl?.oilyWaterFilter) || completeResponseData.initialSurveyRequest.PollutionControlDevices.owf,
              owfCapacity: formValues?.polutionControl?.oilyCapacity || completeResponseData.initialSurveyRequest.PollutionControlDevices.owfCapacity,
              owfMakeModel: formValues?.polutionControl?.oilyMakeModel || completeResponseData.initialSurveyRequest.PollutionControlDevices.owfMakeModel,
              egasCleaningSystm: parseInt(formValues?.polutionControl?.exhaustGasCleaning) || completeResponseData.initialSurveyRequest.PollutionControlDevices.egasCleaningSystm,
              egasCleaningSystmCapacity: formValues?.polutionControl?.exhaustCapacity || completeResponseData.initialSurveyRequest.PollutionControlDevices.egasCleaningSystmCapacity,
              egasCleaningSystmMakeModel: formValues?.polutionControl?.exhaustMakeModel || completeResponseData.initialSurveyRequest.PollutionControlDevices.egasCleaningSystmMakeModel,
              other: parseInt(formValues?.polutionControl?.othersPollution) || completeResponseData.initialSurveyRequest.PollutionControlDevices.other,
              otherCapacity: formValues?.polutionControl?.othersCapacity || completeResponseData.initialSurveyRequest.PollutionControlDevices.otherCapacity,
              otherMakeModel: formValues?.polutionControl?.othersMakeModel || completeResponseData.initialSurveyRequest.PollutionControlDevices.otherMakeModel
            },
            CrewDetails: formValues?.crewDetails?.crewDetails ? 
              (formValues.crewDetails.crewDetails || []).map((crew, index) => ({
                id: completeResponseData.initialSurveyRequest.CrewDetails?.[index]?.id || "",
                crewType: crew.crewType || "",
                name: crew.name || "",
                rank: crew.rank || "",
                cocNo: crew.cocNo || "",
                validity: crew.validity || "",
                experience: crew.experience || "",
                iwtVesBasicSurveyDetTFk: completeResponseData.initialSurveyRequest.CrewDetails?.[index]?.iwtVesBasicSurveyDetTFk || "",
                status: crew.status || "ACTIVE",
                placeOfIssue: crew.placeOfIssue || ""
              })) : completeResponseData.initialSurveyRequest.CrewDetails
          }
        };
      } else {
        // Create mode: First time submission
        const ownerDetails = getFromLocalStorage("ownerDetails") 
          ? JSON.parse(getFromLocalStorage("ownerDetails")) 
          : null;

        payload = {
          registrationRequest: {
            id: "",
            applicationNumber: "",
            applicationType: "TRANSFER_OF_REGISTRY",
            basicDetails: {
              id: "",
              applicationNumber: "",
              status: "",
              ownerDetails: { id: ownerDetails?.id || "" },
              builderDetails: { id: "" },
              dateOfRegistration: formValues?.basicDetails?.dateOfRegistration || "",
              occupation: formValues?.basicDetails?.occupation || "",
              originalPlaceBusiness: formValues?.basicDetails?.originalPlaceOfBusiness || ""
            },
            vesselDetails: {
              id: "",
              typeOfVessel: formValues?.vesselDetails?.typeOfVessel || "",
              categoryOfVessel: formValues?.vesselDetails?.categoryOfVessel || "",
              zone: "",
              grossTonnage: parseFloat(formValues?.vesselDetails?.grossTonnage) || 0,
              workOrderValue: "",
              purchaseType: "",
              supervisionAuthority: "",
              nameOfMaster: "",
              certficateNumber: "",
              nameOfRegistry: "",
              registrationNumber: formValues?.basicVesselInfo?.officialNo || "",
              vesselName: formValues?.vesselDetails?.vesselName || "",
              kindOfVessel: "",
              mortgage: "",
              placeOfBuild: "",
              insuranceDetails: "",
              yearOfBuild: parseInt(formValues?.vesselDetails?.yearOfBuild) || 0,
              pniClubNo: "",
              pniClubName: "",
              applicationNo: "",
              nameOfClassificationSociety: "",
              iwtVesselBasicDetailsTFk: "",
              insuranceValidDate: "",
              portOfRegistry: formValues?.vesselDetails?.previousPort || "",
              surveyId: null,
              lengthOfVessel: parseFloat(formValues?.vesselDetails?.lengthOfVessel) || 0,
              breadthOfVessel: parseFloat(formValues?.vesselDetails?.breadthOfVessel) || 0,
              depthOfVessel: parseFloat(formValues?.vesselDetails?.depthOfVessel) || 0,
              hullMaterial: null,
              noOfBulkheads: null,
              declarationWorkOrderDate: null,
              previousPort: formValues?.vesselDetails?.portOfRegistry || "",
              reasonOfChange: formValues?.basicVesselInfo?.reasonForTransfer || ""
            },
            engineDetails: {
              id: "",
              yearOfBuild: formValues?.vesselDetails?.yearOfBuild || "",
              engineType: formValues?.engineDetails?.engineType || "",
              engineMake: formValues?.engineDetails?.engineMake || "",
              makerAddress: formValues?.engineDetails?.makerAddress || "",
              pin: "",
              mobile: "",
              email: "",
              horsepower: parseFloat(formValues?.engineDetails?.horsepower) || 0.00,
              speed: parseFloat(formValues?.engineDetails?.speed) || 0.00,
              yearOfMake: formValues?.engineDetails?.yearOfMake || "",
              applRegistrationTFk: "",
              modelNo: formValues?.engineDetails?.modelNo || null,
              noOfSet: parseInt(formValues?.engineDetails?.noOfSet) || null,
              numberOfEngine: parseInt(formValues?.engineDetails?.numberOfEngine) || 0,
              serialNo: formValues?.engineDetails?.serialNo || null,
              propellerType: formValues?.engineDetails?.propellerType || null,
              gearType: formValues?.engineDetails?.gearType || null,
              noOfGear: parseInt(formValues?.engineDetails?.noOfGear) || null,
              vesselSpeed: formValues?.engineDetails?.vesselSpeed || null,
              rpm: parseInt(formValues?.engineDetails?.rpm) || null,
              engineCylinder: parseFloat(formValues?.engineDetails?.engineCylinder) || null,
              stroke: parseFloat(formValues?.engineDetails?.stroke) || null,
              internalCombustionEngineNo: null,
              description: null,
              noOfCylindersPerSet: null,
              nhp: null,
              ihp: null,
              propulsionType: null,
              noOfCylinderPerSetRotaryEngine: parseInt(formValues?.engineDetails?.noOfCylinderPerSetRotaryEngine) || 0,
              noOfCylinderPerSetReciprocatingEngine: parseInt(formValues?.engineDetails?.noOfCylinderPerSetReciprocatingEngine) || 0,
              noOfShaft: parseInt(formValues?.engineDetails?.noOfShaft) || 0,
              lengthOfEngineRoom: parseFloat(formValues?.engineDetails?.lengthOfEngineRoom) || 0.00,
              boilderDescription: null,
              boilerNumber: null,
              loadedPressure: null
            }
          },
          initialSurveyRequest: {
            surveyId: "",
            BasicVesselInformation: {
              id: "",
              typeOfSurveyId: "Initial",
              placeYardNo: formValues?.basicVesselInfo?.proposedPortOfRegistry || "",
              netTonnage: parseFloat(formValues?.vesselDetails?.netTonnage) || 0,
              agentsName: "",
              agentsAddress: "",
              agentsTelephone: "",
              placeOfLastSurvey: formValues?.basicVesselInfo?.placeOfLastSurvey || "",
              dateOfLastSurvey: formValues?.basicDetails?.builderDetails?.dateOfLastSurvey || "",
              dateOfProposedVisitSurveyor: "",
              iwtVesRegBasicDetailsTFk: "",
              status: "NEW",
              lengthOfVessel: formValues?.vesselDetails?.lengthOfVessel || "",
              breadthOfVessel: formValues?.vesselDetails?.breadthOfVessel || "",
              depthOfVessel: formValues?.vesselDetails?.depthOfVessel || "",
              draft: formValues?.basicVesselInfo?.draft || "",
              numberOfDecks: null,
              enableprovisonalsurveycert: false,
              enableprovisonalregistrationcert: false,
              totalNoOfDeckCrew: formValues?.crewDetails?.totalDeckCrew || "",
              totalNoOfEngineCrew: formValues?.crewDetails?.totalEngineCrew || ""
            },
            HullParticulars: {
              id: "",
              frameMaterial: formValues?.hullParticulars?.frameMaterial || "",
              frameThickness: formValues?.hullParticulars?.frameThickness || "",
              floorMaterial: formValues?.hullParticulars?.floorMaterial || "",
              hullMaterial: formValues?.hullParticulars?.hullMaterial || "",
              hullPlatingThickness: formValues?.hullParticulars?.hullPlattingThickness || "",
              keelLayingDate: formValues?.hullParticulars?.keelLayingDate || "",
              iwtVesBasicSurveyDetTFk: "",
              status: "NEW",
              hullPlatingMaterial: formValues?.hullParticulars?.hullPlatingMaterial || "",
              noOfBulkheads: formValues?.hullParticulars?.numberOfBulkheads || "",
              bulkheadPlacement: formValues?.hullParticulars?.bulkheadPlacement || "",
              bulkheadThickness: formValues?.hullParticulars?.bulkheadThickness || "",
              floorThickness: formValues?.hullParticulars?.floorThickness || "",
              stern: ""
            },
            RadioandNavigationEquipment: {
              id: "",
              magneticCompass: parseInt(formValues?.navigationEquipment?.magneticCompass) || null,
              vhfRadio: parseInt(formValues?.navigationEquipment?.vhfRadio) || null,
              aisIdentifiSystem: parseInt(formValues?.navigationEquipment?.classBAutoAIS) || null,
              gps: parseInt(formValues?.navigationEquipment?.gpsNavigator) || null,
              binocular: parseInt(formValues?.navigationEquipment?.binocular) || null,
              aldisLamp: parseInt(formValues?.navigationEquipment?.aldisLamp) || null,
              rudderAngleIndicator: parseInt(formValues?.navigationEquipment?.rudderAngleIndicator) || null,
              others: parseInt(formValues?.navigationEquipment?.othersNavigation) || null,
              iwtVesBasicSurveyDetTFk: "",
              status: "NEW"
            },
            PollutionControlDevices: {
              id: "",
              bilgeWaterSeperator: parseInt(formValues?.polutionControl?.bilgeWaterSeparator) || null,
              capacity: formValues?.polutionControl?.bilgeCapacity || "",
              makeModel: formValues?.polutionControl?.bilgeMakeModel || "",
              stp: parseInt(formValues?.polutionControl?.sewageTreatmentPlant) || null,
              stpCapacity: formValues?.polutionControl?.sewageCapacity || "",
              stpMakeModel: formValues?.polutionControl?.sewageMakeModel || "",
              owf: parseInt(formValues?.polutionControl?.oilyWaterFilter) || null,
              owfCapacity: formValues?.polutionControl?.oilyCapacity || "",
              owfMakeModel: formValues?.polutionControl?.oilyMakeModel || "",
              egasCleaningSystm: parseInt(formValues?.polutionControl?.exhaustGasCleaning) || null,
              egasCleaningSystmCapacity: formValues?.polutionControl?.exhaustCapacity || "",
              egasCleaningSystmMakeModel: formValues?.polutionControl?.exhaustMakeModel || "",
              other: parseInt(formValues?.polutionControl?.othersPollution) || null,
              otherCapacity: formValues?.polutionControl?.othersCapacity || "",
              otherMakeModel: formValues?.polutionControl?.othersMakeModel || "",
              status: "NEW",
              iwtVesBasicSurveyDetTFk: ""
            },
            CrewDetails: (formValues?.crewDetails?.crewDetails || []).map(crew => ({
              id: "",
              crewType: crew.crewType || "",
              name: crew.name || "",
              rank: crew.rank || "",
              cocNo: crew.cocNo || "",
              validity: crew.validity || "",
              experience: "",
              iwtVesBasicSurveyDetTFk: "",
              status: "NEW",
              placeOfIssue: crew.placeOfIssue || ""
            })),
            equipmentInventoryDetails: null
          },
          enclosers: extractAllEnclosures(formValues)
        };
      }
    } 
    else if (stepIndex === 1) {
      // Step 2: Use complete response and update only equipment values
      payload = {
        ...completeResponseData,
        initialSurveyRequest: {
          ...completeResponseData.initialSurveyRequest,
          SurveyEquipments: buildEquipmentPayload(formValues, completeResponseData.initialSurveyRequest)?.SurveyEquipments || completeResponseData.initialSurveyRequest?.SurveyEquipments,
          passengerDistributionMaxLoad: buildEquipmentPayload(formValues, completeResponseData.initialSurveyRequest)?.passengerDistributionMaxLoad || completeResponseData.initialSurveyRequest?.passengerDistributionMaxLoad,
          vesselFreeboardData: buildEquipmentPayload(formValues, completeResponseData.initialSurveyRequest)?.vesselFreeboardData || completeResponseData.initialSurveyRequest?.vesselFreeboardData
        }
      };
    }

    const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.TRANSFER_OF_REGISTRY.TRANSFER_OF_REGISTRY_CREATE;
    const response = await postData(apiUrl, payload);

    if (response?.status === 200 || response?.status === 201) {
      const responseData = response?.data?.data;
      
      // Always store complete response in state
      setCompleteResponseData(responseData);
      
      if (stepIndex === 0) {
        setRegistrationData({
          RegistrationResponse: responseData?.RegistrationResponse,
          vessel: {
            applicationNumber: responseData?.RegistrationResponse?.applicationNumber,
            iwtVesselBasicDetailsTFk: responseData?.RegistrationResponse?.basicDetails?.id
          }
        });
        setInitialRegistryData(responseData?.IwtInitialSurveyResponse);
      }
      
      if (stepIndex === 1) {
        setInitialRegistryData(responseData.IwtInitialSurveyResponse);
      }
      
      toast.success(stepIndex === 0 ? "Transfer application submitted successfully!" : "Equipment data updated successfully!");

      if (stepInfo) {
        stepperRef.current?.goToNextStep();
      }
    } else {
      toast.error("Failed to submit data");
    }
  } catch (err) {
    console.error("Error:", err);
    toast.error("Error submitting data");
  } finally {
    loaderRef?.current?.hide();
  }
};
