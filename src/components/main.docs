import React, { useState, useEffect, useRef } from "react";
import { FaChevronLeft, FaChevronRight } from "react-icons/fa";
import "./styles/DynamicTabs.css";

const DynamicTabs = ({ tabs, onTabChange }) => {
  const [activeIndex, setActiveIndex] = useState(0);
  const [showLeft, setShowLeft] = useState(false);
  const [showRight, setShowRight] = useState(false);
  const tabListRef = useRef(null);
  const touchStartX = useRef(null);

  const updateScrollButtons = () => {
    const el = tabListRef.current;
    if (!el) return;
    setShowLeft(el.scrollLeft > 0);
    setShowRight(el.scrollLeft + el.clientWidth < el.scrollWidth - 1);
  };

  useEffect(() => {
    const el = tabListRef.current;
    updateScrollButtons();
    el.addEventListener("scroll", updateScrollButtons);
    window.addEventListener("resize", updateScrollButtons);
    return () => {
      el.removeEventListener("scroll", updateScrollButtons);
      window.removeEventListener("resize", updateScrollButtons);
    };
  }, [tabs]);

  useEffect(() => {
    if (tabs[activeIndex]?.onLoad) tabs[activeIndex].onLoad();
    if (onTabChange) onTabChange(activeIndex);
  }, [activeIndex, onTabChange, tabs]);

  const scrollTabs = (dir) => {
    const el = tabListRef.current;
    if (el) el.scrollBy({ left: dir * 180, behavior: "smooth" });
  };

  const handleTouchStart = (e) => {
    touchStartX.current = e.touches[0].clientX;
  };

  const handleTouchEnd = (e) => {
    const deltaX = e.changedTouches[0].clientX - touchStartX.current;
    if (Math.abs(deltaX) > 50) {
      setActiveIndex((prev) => {
        const newIndex = deltaX > 0 ? prev - 1 : prev + 1;
        return Math.max(0, Math.min(newIndex, tabs.length - 1));
      });
    }
  };

  return (
    <div className="tabs-wrapper">
      <div className={`tabs-header${showLeft || showRight ? " with-arrows" : ""}`}>
        {showLeft && (
          <button className="scroll-btn left" onClick={() => scrollTabs(-1)}>
            <FaChevronLeft />
          </button>
        )}
        <div className="tabs-scroll" ref={tabListRef}>
          <ul className="tab-list">
            {tabs.map((tab, index) => (
              <li key={index} className="tab-item">
                <button
                  className={`tab-btn${index === activeIndex ? " active" : ""}`}
                  onClick={() => setActiveIndex(index)}
                >
                  {tab.icon && <span className="tab-icon">{tab.icon}</span>}
                  <span className="tab-title">{tab.title}</span>
                  {tab.badge && <span className="tab-badge">{tab.badge}</span>}
                </button>
              </li>
            ))}
          </ul>
        </div>
        {showRight && (
          <button className="scroll-btn right" onClick={() => scrollTabs(1)}>
            <FaChevronRight />
          </button>
        )}
      </div>
      <div className="tabs-content" onTouchStart={handleTouchStart} onTouchEnd={handleTouchEnd}>
        {tabs[activeIndex]?.content}
      </div>
    </div>
  );
};

export default DynamicTabs;
