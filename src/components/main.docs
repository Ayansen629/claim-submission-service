const actionDropdown =
  isViewMode && isOfficerLogin && actionsFromAPI?.length > 0 ? (
    <div
      style={{
        display: "flex",
        gap: "8px",
        alignItems: "center",
        flexWrap: "wrap",
      }}
    >
      <Button
        variant="contained"
        onClick={() =>
          handleFormSubmit({
            index: 1,
            getFormData: () => methods?.getValues(),
          })
        }
        style={{
          backgroundColor: "#2E57A7",
          fontWeight: "600",
          borderRadius: "6px",
          fontSize: "0.75rem",
          color: "#fff",
          padding: "6px 12px",
          height: "32px",
          minWidth: "60px",
          maxWidth: "60px",
          textTransform: "none",
          boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
          transition: "all 0.2s ease",
        }}
        title="Save Changes"
      >
        Save
      </Button>

      {/* Provisional Certificate Buttons - Only show if not generated */}
      {userRole === USER_ROLES?.OFFICER_L3 && showOfficerActions && (
        <>
          {!generatedCertificates.survey && (
            <Button
              variant="contained"
              onClick={() => handleProvisionModalOpen("survey")}
              style={{
                background: "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                color: "#fff",
                fontWeight: "600",
                borderRadius: "6px",
                fontSize: "0.75rem",
                padding: "6px 12px",
                height: "32px",
                minWidth: "80px",
                maxWidth: "80px",
                textTransform: "none",
                border: "none",
                boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
                transition: "all 0.2s ease",
                overflow: "hidden",
                textOverflow: "ellipsis",
                whiteSpace: "nowrap",
              }}
              title="Provisional Certificate of Survey"
            >
              Survey Cert
            </Button>
          )}
          
          {!generatedCertificates.registration && (
            <Button
              variant="contained"
              onClick={() => handleProvisionModalOpen("registration")}
              style={{
                background: "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                color: "#fff",
                fontWeight: "600",
                borderRadius: "6px",
                fontSize: "0.75rem",
                padding: "6px 12px",
                height: "32px",
                minWidth: "80px",
                maxWidth: "80px",
                textTransform: "none",
                border: "none",
                boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
                transition: "all 0.2s ease",
                overflow: "hidden",
                textOverflow: "ellipsis",
                whiteSpace: "nowrap",
              }}
              title="Provisional Certificate of Registration"
            >
              Reg Cert
            </Button>
          )}
        </>
      )}

      <ActionDropdown
        actions={actionsFromAPI}
        onActionClick={handleWorkflowActionClick}
        variant="contained"
        sx={{
          backgroundColor: "#2E57A7",
          fontWeight: "600",
          borderRadius: "6px",
          fontSize: "0.75rem",
          color: "#fff",
          height: "32px",
          minWidth: "80px",
          maxWidth: "100px",
          textTransform: "none",
          boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
          padding: "6px 12px",
          "& .MuiButton-root": {
            height: "32px",
            minWidth: "80px",
            maxWidth: "100px",
          }
        }}
      />
    </div>
  ) : null;
