import React, { createContext, useContext, useState, useEffect } from "react";
import { toast } from "react-toastify";
import { APP_MESSAGES } from "../../utils/constants.ts";

const formatFileInfo = (fileData) => {
  if (!fileData) return "No file uploaded";
  if (typeof fileData === "string") return fileData;
  return fileData.name || fileData.fileName || "File uploaded";
};

// Create the Registration Context
const RegistrationContext = createContext();

// Custom hook to use the Registration Context
export const useRegistration = () => {
  return useContext(RegistrationContext);
};

// ApplicationContextProvider
export const ApplicationContextProvider = ({ children }) => {
  const [registrationData, setRegistrationData] = useState({});
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [isDataLoaded, setIsDataLoaded] = useState(false);

  const getLocalStorageKey = (id) => `registrationData-${id}`;

  const loadDataFromLocalStorage = (id) => {
    try {
      setLoading(true);
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const isCRPUser = userFormData?.userType === "CRP";

      // For CRP users viewing a form (with ID), fetch data and populate
      if (isCRPUser && id) {
        fetchFormData(id); // Fetch data from API
        return;
      }

      // First check if this is a draft
      if (id && id.startsWith("draft-")) {
        const drafts = JSON.parse(localStorage.getItem("formDrafts") || "[]");
        const draftData = drafts.find((draft) => draft.id === id);
        if (draftData) {
          setRegistrationData(draftData);
          setIsDataLoaded(true);
          return;
        }
      }

      // Otherwise check regular saved data
      const savedData = localStorage.getItem(getLocalStorageKey(id));
      if (savedData) {
        setRegistrationData(JSON.parse(savedData));
      }
      setIsDataLoaded(true);
    } catch (err) {
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setError(err.message || "Error loading data");
    } finally {
      setLoading(false);
    }
  };

  const saveDataToLocalStorage = (id, data) => {
    localStorage.setItem(getLocalStorageKey(id), JSON.stringify(data));
  };

  const handleStepDataFetch = (stepId, id) => {
    try {
      setLoading(true);
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const isCRPUser = userFormData?.userType === "CRP";

      // For CRP users, fetch data from API
      if (isCRPUser && id) {
        fetchFormData(id, stepId);
        return;
      }

      // For drafts, use the draft data directly
      if (id && id.startsWith("draft-")) {
        const drafts = JSON.parse(localStorage.getItem("formDrafts") || "[]");
        const draftData = drafts.find((draft) => draft.id === id);
        if (draftData && draftData[stepId]) {
          setRegistrationData((prev) => ({
            ...prev,
            [stepId]: draftData[stepId],
          }));
          return;
        }
      }

      // For regular data
      const savedData = localStorage.getItem(getLocalStorageKey(id));
      if (savedData) {
        const parsedData = JSON.parse(savedData);
        if (parsedData[stepId]) {
          setRegistrationData((prev) => ({
            ...prev,
            [stepId]: parsedData[stepId],
          }));
        }
      }
    } catch (err) {
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setError(err.message || "Error fetching step data");
    } finally {
      setLoading(false);
    }
  };

  const updateRegistrationData = (stepId, updatedData, id) => {
    setRegistrationData((prev) => ({
      ...prev,
      [stepId]: updatedData,
    }));

    if (id) {
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const isCRPUser = userFormData?.userType === "CRP";

      // Don't save updates for CRP users viewing forms
      if (isCRPUser && id && !id.startsWith("draft-")) {
        return;
      }

      if (id.startsWith("draft-")) {
        // Update draft data
        const drafts = JSON.parse(localStorage.getItem("formDrafts") || "[]");
        const draftIndex = drafts.findIndex((draft) => draft.id === id);

        if (draftIndex >= 0) {
          const updatedDraft = {
            ...drafts[draftIndex],
            [stepId]: updatedData,
            lastSaved: new Date().toISOString(),
          };

          drafts[draftIndex] = updatedDraft;
          localStorage.setItem("formDrafts", JSON.stringify(drafts));
        }
      } else {
        // Update regular data
        saveDataToLocalStorage(id, {
          ...registrationData,
          [stepId]: updatedData,
        });
      }
    }
  };

  const handleFileUpload = (stepId, fieldName, file, id) => {
    const userFormData = JSON.parse(localStorage.getItem("userFormData"));
    const isCRPUser = userFormData?.userType === "CRP";

    // Don't allow file uploads for CRP users viewing forms
    if (isCRPUser && id && !id.startsWith("draft-")) {
      toast.info("CRP users cannot modify submitted forms");
      return;
    }

    const filePath = URL.createObjectURL(file);
    const updatedData = {
      ...registrationData[stepId],
      [fieldName]: {
        path: filePath,
        file,
      },
    };

    updateRegistrationData(stepId, updatedData, id);
  };

  // Function to fetch form data from the API
  const fetchFormData = async (id, stepId = null) => {
    try {
      setLoading(true);
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const fullloginDetails = userFormData?.fullloginDetails;

      const payload = {
        userInfo: fullloginDetails || {}, // Use fullloginDetails or empty object
        uuids: [id], // Use the provided id
        applicationNumbers: [],
        claimantUUIDs: [],
      };

      const response = await fetch(
        "/cms-application-service/_application/_search",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        }
      );

      if (!response.ok) {
        throw new Error("Failed to fetch form data");
      }

      const data = await response.json();

      if (data && data.applicationDetails && data.applicationDetails.length > 0) {
        const fetchedData = data.applicationDetails[0];

        // Structure the data to match your staticFormData structure
        const formattedData = {
          step1: {
            debtorName: fetchedData?.creditorBasicDetails?.debtorName || "",
            CreditorName: fetchedData?.creditorBasicDetails?.creditorName || "",
            totalClaimAmount: fetchedData?.creditorBasicDetails?.totalClaimAmount || "",
            debtDetails: fetchedData?.creditorBasicDetails?.debtDetails || "",
            mutualCreditDetails: fetchedData?.creditorBasicDetails?.mutualCreditDetails || "",
            identificationType: fetchedData?.creditorBasicDetails?.document?.docType || "",
            identificationNumber: fetchedData?.creditorBasicDetails?.identificationNumber || "",
            identificationDocument: formatFileInfo(fetchedData?.creditorBasicDetails?.document?.docName) || "",
          },
          step2: {
            securityInterestAmount: fetchedData?.claimDetails?.securityInterestAmount || "",
            guaranteeAmount: fetchedData?.claimDetails?.guaranteeAmount || "",
            guarantorName: fetchedData?.claimDetails?.guarantorName || "",
            guarantorAddress: fetchedData?.claimDetails?.guarantorAddress || "",
            creditorAddress: fetchedData?.claimDetails?.creditorAddress || "",
            creditorEmail: fetchedData?.claimDetails?.creditorEmail || "",
            beneficiaryClaimAmount: fetchedData?.claimDetails?.beneficiaryClaimAmount || "",
            beneficiaryName: fetchedData?.claimDetails?.beneficiaryName || "",
            beneficiaryAddress: fetchedData?.claimDetails?.beneficiaryAddress || "",
            corporateDebtorClaimAmount: fetchedData?.claimDetails?.corporateDebtorClaimAmount || "",
            corporateDebtorSecurityAmount: fetchedData?.claimDetails?.corporateDebtorSecurityAmount || "",
            corporateDebtorGuaranteeAmount: fetchedData?.claimDetails?.corporateDebtorGuaranteeAmount || "",
            principalBorrowerName: fetchedData?.claimDetails?.principalBorrowerName || "",
            principalBorrowerAddress: fetchedData?.claimDetails?.principalBorrowerAddress || "",
            accountNumber: fetchedData?.claimDetails?.bankAccountNumber || "",
            ifscCode: fetchedData?.claimDetails?.bankIfscCode || "",
            branchName: fetchedData?.claimDetails?.bankBranchName || "",
            addressProofNumber: fetchedData?.claimDetails?.addressProofNumber || "",
            addressProofType: fetchedData?.claimDetails?.addressProofType || "",
            addressProofDocument: formatFileInfo(fetchedData?.claimDetails?.document?.docName) || "",
          },
          step3: {
            signatoryName: fetchedData?.signatoryDetails?.name || "",
            signatoryPosition: fetchedData?.signatoryDetails?.position || "",
            signatoryAddress: fetchedData?.signatoryDetails?.address || "",
            signatoryDocument: formatFileInfo(fetchedData?.signatoryDetails?.document?.docName) || "",
          },
        };

        if (stepId) {
          setRegistrationData((prev) => ({
            ...prev,
            [stepId]: formattedData[stepId],
          }));
        } else {
          setRegistrationData(formattedData);
          setIsDataLoaded(true);
        }
      }
    } catch (err) {
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setError(err.message || "Error fetching form data");
    } finally {
      setLoading(false);
    }
  };

  return (
    <RegistrationContext.Provider
      value={{
        registrationData,
        loading,
        error,
        isViewModalOpen,
        setIsViewModalOpen,
        handleStepDataFetch,
        updateRegistrationData,
        handleFileUpload,
        setRegistrationData,
        loadDataFromLocalStorage,
        isDataLoaded,
      }}
    >
      {children}
    </RegistrationContext.Provider>
  );
};
