// Update the handleTrackRow function to make the API call
const handleTrackRow = async (row) => {
  try {
    setIsLoading(true);
    
    // Get user data from localStorage
    const userFormData = JSON.parse(localStorage.getItem("userFormData"));
    const userInfo = userFormData?.fullloginDetails;
    
    if (!userInfo) {
      throw new Error("User information not found in localStorage");
    }

    const payload = {
      userInfo: userInfo,
      trackingCriteria: {
        applicationNumber: row.claimNumber
      }
    };

    const URL = `${process.env.REACT_APP_APPLICATION_SERVICE}/cms-application-service/_tracking/_getApplicationTrackingDetails`;
    
    const response = await postData(URL, payload);
    
    if (response?.status === "200") {
      setTrackData({
        applicationNumber: response.applicationNumber,
        trackingSteps: response.applicationStages.map(stage => ({
          step: stage.applicationStatus,
          description: this.getStatusDescription(stage),
          date: stage.submittedDate,
          isCurrentStatus: stage.isCurrentStatus,
          submittedBy: stage.submittedByName,
          submittedTo: stage.submittedToName,
          comments: stage.comments
        }))
      });
      setIsTrackModalOpen(true);
    } else {
      toast.error("Failed to fetch tracking details", { position: "top-right" });
    }
  } catch (error) {
    console.error("Error fetching tracking details:", error);
    toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
  } finally {
    setIsLoading(false);
  }
};

// Helper function to generate status descriptions
const getStatusDescription = (stage) => {
  if (stage.submittedBy === "CLAIMANT" && stage.submittedTo === "RP") {
    return `Submitted by claimant ${stage.submittedByName} to RP ${stage.submittedToName}`;
  } else if (stage.submittedBy === "RP" && stage.submittedTo === "CLAIMANT") {
    return `Sent back by RP ${stage.submittedByName} to claimant ${stage.submittedToName}`;
  } else if (stage.submittedBy === "RP" && !stage.submittedTo) {
    return `Final decision by RP ${stage.submittedByName}: ${stage.applicationStatus}`;
  }
  return stage.applicationStatus;
};

// Update the Tracking Modal component
const TrackingModal = ({ show, onHide, trackData }) => {
  if (!trackData) return null;

  return (
    <Modal
      show={show}
      onHide={onHide}
      size="lg"
      centered
      aria-labelledby="tracking-modal-title"
    >
      <Modal.Header closeButton className="border-0 pb-0">
        <Modal.Title id="tracking-modal-title" className="w-100">
          <div className="d-flex justify-content-between align-items-center">
            <h4 className="mb-0">Claim Tracking</h4>
            <div className="badge bg-primary fs-6">
              {trackData.applicationNumber}
            </div>
          </div>
        </Modal.Title>
      </Modal.Header>
      <Modal.Body className="pt-0">
        <div className="timeline-container position-relative">
          {/* Vertical line */}
          <div 
            className="timeline-vertical-line" 
            style={{
              position: 'absolute',
              left: '24px',
              top: '0',
              bottom: '0',
              width: '2px',
              backgroundColor: '#dee2e6',
              zIndex: 0
            }}
          ></div>
          
          {trackData.trackingSteps?.map((step, index) => (
            <div 
              key={index} 
              className={`timeline-step ${step.isCurrentStatus ? 'current-step' : ''}`}
              style={{
                position: 'relative',
                paddingLeft: '60px',
                marginBottom: '30px',
                zIndex: 1
              }}
            >
              <div 
                className="timeline-icon-container"
                style={{
                  position: 'absolute',
                  left: '0',
                  top: '0',
                  width: '50px',
                  height: '50px',
                  borderRadius: '50%',
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'center',
                  backgroundColor: step.isCurrentStatus ? '#0d6efd' : '#6c757d',
                  color: 'white',
                  boxShadow: '0 0 0 5px rgba(13, 110, 253, 0.1)'
                }}
              >
                {step.isCurrentStatus ? (
                  <FaCheckCircle size={20} />
                ) : (
                  <FaClock size={20} />
                )}
              </div>
              
              <div 
                className="timeline-content p-3 rounded-3"
                style={{
                  backgroundColor: step.isCurrentStatus ? '#f8f9fa' : 'white',
                  border: step.isCurrentStatus ? '1px solid #0d6efd' : '1px solid #dee2e6',
                  boxShadow: '0 0.125rem 0.25rem rgba(0, 0, 0, 0.075)'
                }}
              >
                <div className="d-flex justify-content-between align-items-center mb-2">
                  <h5 
                    className="mb-0"
                    style={{
                      color: step.isCurrentStatus ? '#0d6efd' : '#212529',
                      fontWeight: '600'
                    }}
                  >
                    {step.step}
                  </h5>
                  <small className="text-muted">
                    <FaClock className="me-1" />
                    {step.date}
                  </small>
                </div>
                
                <p className="mb-2">{step.description}</p>
                
                {step.comments && (
                  <div 
                    className="p-2 rounded-2"
                    style={{
                      backgroundColor: '#f8f9fa',
                      borderLeft: '3px solid #0d6efd'
                    }}
                  >
                    <small className="text-muted d-block mb-1">
                      <strong>Comments:</strong>
                    </small>
                    <p className="mb-0">{step.comments}</p>
                  </div>
                )}
                
                <div className="d-flex justify-content-between mt-2">
                  <small className="text-muted">
                    <strong>From:</strong> {step.submittedBy}
                  </small>
                  {step.submittedTo && (
                    <small className="text-muted">
                      <strong>To:</strong> {step.submittedTo}
                    </small>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </Modal.Body>
      <Modal.Footer className="border-0">
        <Button variant="secondary" onClick={onHide}>
          Close
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

// Update the modal rendering in your DashboardMain component
<TrackingModal 
  show={isTrackModalOpen} 
  onHide={() => setIsTrackModalOpen(false)} 
  trackData={trackData} 
/>
