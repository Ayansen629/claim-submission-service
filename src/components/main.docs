import React, { createContext, useContext, useState } from "react";
import { toast } from "react-toastify";
import { APP_MESSAGES } from "../../utils/constants.ts";
import { postData } from "../../services/http.service.ts";

// Create the Registration Context
const RegistrationContext = createContext();

// Custom hook to use the Registration Context
export const useRegistration = () => {
  return useContext(RegistrationContext);
};

// Utility function to format file info
const formatFileInfo = (fileData) => {
    if (!fileData) return ""; // Changed to return empty string for consistency
    if (typeof fileData === "string") return fileData;
    return fileData.name || fileData.fileName || ""; // Return empty string if no name
};

// Function to format the raw API response data
const formatRawData = (rawData) => {
  if (!rawData) return null; // Handle null or undefined rawData

  return {
    step1: {
      debtorName: rawData?.creditorBasicDetails?.debtorName || "",
      CreditorName: rawData?.creditorBasicDetails?.creditorName || "",
      totalClaimAmount: rawData?.creditorBasicDetails?.totalClaimAmount || "",
      debtDetails: rawData?.creditorBasicDetails?.debtDetails || "",
      mutualCreditDetails: rawData?.creditorBasicDetails?.mutualCreditDetails || "",
      identificationType: rawData?.creditorBasicDetails?.document?.docType || "",
      identificationNumber: rawData?.creditorBasicDetails?.identificationNumber || "",
      identificationDocument: formatFileInfo(rawData?.creditorBasicDetails?.document?.docName) || "",
    },
    step2: {
      securityInterestAmount: rawData?.claimDetails?.securityInterestAmount || "",
      guaranteeAmount: rawData?.claimDetails?.guaranteeAmount || "",
      guarantorName: rawData?.claimDetails?.guarantorName || "",
      guarantorAddress: rawData?.claimDetails?.guarantorAddress || "",
      creditorAddress: rawData?.claimDetails?.creditorAddress || "",
      creditorEmail: rawData?.claimDetails?.creditorEmail || "",
      beneficiaryClaimAmount: rawData?.claimDetails?.beneficiaryClaimAmount || "",
      beneficiaryName: rawData?.claimDetails?.beneficiaryName || "",
      beneficiaryAddress: rawData?.claimDetails?.beneficiaryAddress || "",
      corporateDebtorClaimAmount: rawData?.claimDetails?.corporateDebtorClaimAmount || "",
      corporateDebtorSecurityAmount: rawData?.claimDetails?.corporateDebtorSecurityAmount || "",
      corporateDebtorGuaranteeAmount: rawData?.claimDetails?.corporateDebtorGuaranteeAmount || "",
      principalBorrowerName: rawData?.claimDetails?.principalBorrowerName || "",
      principalBorrowerAddress: rawData?.claimDetails?.principalBorrowerAddress || "",
      accountNumber: rawData?.claimDetails?.bankAccountNumber || "",
      ifscCode: rawData?.claimDetails?.bankIfscCode || "",
      branchName: rawData?.claimDetails?.bankBranchName || "",
      addressProofNumber: rawData?.claimDetails?.addressProofNumber || "",
      addressProofType: rawData?.claimDetails?.addressProofType || "",
      addressProofDocument: formatFileInfo(rawData?.claimDetails?.document?.docName) || "",
    },
    step3: {
      signatoryName: rawData?.signatoryDetails?.name || "",
      signatoryPosition: rawData?.signatoryDetails?.position || "",
      signatoryAddress: rawData?.signatoryDetails?.address || "",
      signatoryDocument: formatFileInfo(rawData?.signatoryDetails?.document?.docName) || "",
    },
  };
};

// Fixed ApplicationContextProvider
export const ApplicationContextProvider = ({ children }) => {
  const [registrationData, setRegistrationData] = useState({});
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);

  const handleRegistrationView = async (row) => {
    if (!row?.uuid) {
      console.warn("Row UUID is missing");
      return;
    }

    try {
      setLoading(true);
      const URL =
        process.env.REACT_APP_BASE_URL +
        "/cms-application-service/_application/_search"; // Changed URL
      const request = {
        userInfo: {}, // Add userInfo
        uuids: [row.uuid],
        applicationNumbers: [],
        claimantUUIDs: []
      };

      const response = await postData(URL, request);

      if (response?.data && response?.data?.applicationDetails?.length > 0) {
        const rawData = response.data.applicationDetails[0];
        const formattedData = formatRawData(rawData);
        setRegistrationData(formattedData);
        setIsViewModalOpen(true);
      } else {
        toast.error(APP_MESSAGES.NO_DATA_FOUND, { position: "top-right" });
        setRegistrationData({}); // Reset to empty, not default values
      }
    } catch (err) {
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setError(err.message || "Error fetching registration data");
      setRegistrationData({}); // Reset to empty on error
    } finally {
      setLoading(false);
    }
  };

  const updateRegistrationData = (updatedData) => {
    setRegistrationData((prev) => ({
      ...prev,
      ...updatedData,
    }));
  };

  return (
    <RegistrationContext.Provider
      value={{
        registrationData,
        loading,
        error,
        isViewModalOpen,
        setIsViewModalOpen,
        handleRegistrationView,
        updateRegistrationData,
        setRegistrationData,
      }}
    >
      {children}
    </RegistrationContext.Provider>
  );
};
