import React from 'react';
import DatePicker from 'react-datepicker';
import { format, isToday, isSameDay, parseISO } from 'date-fns';
import { BsCalendarEvent } from 'react-icons/bs';
import 'react-datepicker/dist/react-datepicker.css';
import './SurveyTrackerCard.css';

const SurveyTrackerCard = ({ events, color = "#6f42c1" }) => {
  const today = new Date();
  
  const renderDayContents = (day, date) => {
    const dayEvents = events.filter(event => 
      isSameDay(parseISO(event.start), date)
    );
    const isCurrentDay = isToday(date);
    
    return (
      <div className={`day-container ${isCurrentDay ? 'today' : ''}`}>
        <div className="day-number">{format(date, 'd')}</div>
        {dayEvents.length > 0 && (
          <div className="event-details">
            {dayEvents.map((event, i) => (
              <div 
                key={i} 
                className="event-item"
                style={{ borderLeft: `3px solid ${event.color || color}` }}
              >
                <div className="event-title">{event.title}</div>
                <div className="event-vessel">{event.vessel}</div>
              </div>
            ))}
          </div>
        )}
      </div>
    );
  };

  return (
    <div className="status-card survey-tracker-card" style={{ borderLeft: `4px solid ${color}` }}>
      <div className="status-card-content">
        <div className="card-header-wrapper">
          <div className="icon-wrapper" style={{ backgroundColor: `${color}20`, color }}>
            <BsCalendarEvent size={24} />
          </div>
          <div className="card-header-text">
            <div className="value">{events.length}</div>
            <div className="title">Survey Tracker</div>
            <div className="subtitle">Upcoming surveys</div>
          </div>
        </div>
        <div className="calendar-wrapper">
          <DatePicker
            inline
            selected={today}
            renderDayContents={renderDayContents}
            calendarClassName="survey-calendar"
          />
        </div>
      </div>
    </div>
  );
};

export default SurveyTrackerCard;
