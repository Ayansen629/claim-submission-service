/* InputSelect.module.css */
.menu {
  position: absolute;
  z-index: 9999;
}

.menuList {
  padding: 0;
  max-height: 200px;
  overflow-y: auto;
}

.option {
  padding: 8px 12px;
  cursor: pointer;
}

.optionIsFocused {
  background-color: #f0f0f0;
}

.optionIsSelected {
  background-color: #2684FF;
  color: white;
}

.controlIsFocused {
  border-color: #80bdff !important;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25) !important;
}

.controlIsInvalid {
  border-color: #dc3545 !important;
  background-color: #fff8f8 !important;
}

.inputIcon {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
}

.inputIconError {
  composes: inputIcon;
  color: #dc3545;
}

.inputIconSuccess {
  composes: inputIcon;
  color: #28a745;
}

.inputIconPrimary {
  composes: inputIcon;
  color: #007bff;
}
