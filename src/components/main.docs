const handleFormSubmit = async (stepInfo) => {
  window.scrollTo({ top: 0, behavior: "smooth" });

  //-- Step 1  Intial Survey Form Submission -- //
  if (stepInfo.index === 0) {
    const formValues = stepInfo?.getFormData?.() || {};
    const surveyPayload = buildSurveyPayload(formValues, registrationData);
    submitIntialSurveyData(surveyPayload);
  }

  //-- Step 2  Equipment Form Submission -- //
  if (stepInfo.index === 1) {
    const formValues = stepInfo?.getFormData?.() || {};

    console.log("=== EQUIPMENT FORM DATA ===");
    console.log("Equipment Data:", formValues.equipment);
    console.log("Deck Spaces:", formValues.deckSpaces);
    console.log("Freeboard:", formValues.freeboard);
    console.log("===========================");

    // Build complete payload with step 1 + step 2 data
    const completePayload = {
      ...buildSurveyPayload(formValues, registrationData), // Step 1 data
      equipmentInventoryDetails: formValues.equipment || {},
      deckSpaceDetails: formValues.deckSpaces || [],
      freeboardDetails: formValues.freeboard || {}
    };
    
    console.log("=== COMPLETE PAYLOAD ===");
    console.log("Payload:", completePayload);
    console.log("========================");

    // Call same API with complete data
    submitIntialSurveyData(completePayload);
  }
};
