 <div className="mb-5 px-0 mx-0 generic-action-table pt-3">
    {/* Search Bar and Filters */}
    <div
      className={`row ${style.application_search} ${
        props.hideSearchBar ? "justify-content-end mb-2" : "justify-content-center"
      }`}
    >
      {props.filters && (
        <div className="col-sm-6 my-2 fw-600" style={{ width: "fit-content" }}>
          {props.filters()}
        </div>
      )}
      {!props.hideSearchBar && (
        <div className="col-sm-4 my-2">
          <input
            type="search"
            onChange={handleOnSearch}
            placeholder="Search"
            //  placeholder="🔍 Search by Claim Number, Claimant, or Status..."
            className={`form-control ${props.hideSearchBar && "d-none"}`}
            style={{ width: "100%", maxWidth: "400px" }}
          />
        </div>
      )}
      {props.showCustomBtn && (
        <div
          id="table_custom_button_div"
          className="col-sm-2 my-2"
          style={props.btnStyle ? props.btnStyle : { width: "12%" }}
        >
          <button
            onClick={props.handleBtnClick}
            type="button"
            disabled={props.isCustomBtnDisabled}
            className="btn btn-primary"
            style={{ width: "100%" }}
          >
            <span className="font-14">{props.btnName}</span>
          </button>
        </div>
      )}
    </div>
  
    {/* Table */}
    <div className="table-container">
      <table className={`table ${style.table}`} style={{ width: props.tableWidth }}>
        <thead>
          <tr className="table_header">
            {props.columns?.map((data, colIndx) => {
              const checkedItems = selected.every((item) =>
                currentItems.some((obj) => obj.id === item.id)
              );
              return data.fieldName === "checkbox" && props.checkType === "multiCheck" ? (
                <th
                  key={colIndx}
                  className={`px-3 py-2 ${data.clsName}`}
                  style={{ minWidth: data.minWidth || "6rem" }}
                >
                  <input
                    type="checkbox"
                    id="table-column-check"
                    ref={(input) => {
                      if (input) {
                        input.indeterminate =
                          selected.length > 0 && selected.length < currentItems.length;
                      }
                    }}
                    checked={
                      props.rowData?.length > 0 &&
                      selected.length === currentItems.length &&
                      checkedItems
                    }
                    name="column-check"
                    onClick={(e) => onCheckColumn(e, data)}
                  />
                </th>
              ) : !hideColumns.includes(data.fieldName) ? (
                <th
                  key={colIndx}
                  className={`px-3 py-2 ${data.clsName}`}
                  style={{ minWidth: data.minWidth || "6rem" }}
                  onClick={() => sortByColumn(data.fieldName)}
                >
                  {data.titleCode ? data.titleCode : data.colName}{" "}
                  {showSortedColumnIcon(data.fieldName)}
                </th>
              ) : null;
            })}
          </tr>
        </thead>
        <tbody>
          {searchedData.length !== 0 ? (
            currentItems.map((row, index) => {
              const rowId = row.id;
              const isItemSelected = isSelected(rowId);
              return (
                <tr key={index} className="table_datarow">
                  {props.columns.map((o, colIndex) =>
                 
                    o.isClickable ? (
                      <td
                        key={colIndex}
                        className={`px-3 py-2 ${o.clsName} ${
                          colIndex === props.columns.length - 1
                            ? "last-column"
                            : colIndex === 0
                            ? "first-column"
                            : ""
                        }`}
                        style={{
                          color: "#3370D4",
                          cursor: "pointer",
                          fontWeight: row.isRead === false ? "bolder" : "normal",
                        }}
                        onClick={(e) => onRowClick(e, row)}
                      >
                        <span>{_.get(row, o.fieldName)}</span>
                      </td>
                    ) : o.fieldName === "checkbox" ? (
                      <td key={colIndex} className={`px-3 py-2 ${o.clsName}`}>
                        <input
                          type="checkbox"
                          checked={isItemSelected}
                          name="row-check"
                          onChange={(event) => onRowCheck(event, rowId, row)}
                        />
                      </td>
                    ) : !hideColumns.includes(o.fieldName) && o.fieldName !== "action" ? (
                      <td
                        key={colIndex}
                        className={`px-3 py-2 ${o.clsName} ${
                          colIndex === props.columns.length - 1
                            ? "last-column"
                            : colIndex === 0
                            ? "first-column"
                            : ""
                        }`}
                        style={{
                          fontWeight: row.isRead === false ? "bolder" : "normal",
                        }}
                      >
                        {o.colName === "Status" ? (
                          
                          <span className={`status-column ${_.get(row, o.fieldName)}-status`}>
                            {_.get(row, o.fieldName)}{" "}
                            {o.fieldName2 ? _.get(row, o.fieldName2) : ""}
                          </span>
                        ) : (
                          <span>
                            {_.get(row, o.fieldName)}{" "}
                            {o.fieldName2 ? _.get(row, o.fieldName2) : ""}
                          </span>
                        )}
                      </td>
                    ) :!hideColumns.includes(o.fieldName) && o.fieldName === "action" ? (
                      <td key={colIndex} className={`px-3 py-2 ${o.clsName} action-column`}>
                        <div className="d-flex" style={{ gap: "12px", justifyContent: "center" }}>
                          {/* Edit Button */}
                          {/* {o.actions.includes("edit") && (
                            <Tooltip title="Edit this item" placement="top" arrow>
                              <button
                                className="btn btn-light border-secondary btn-sm "
                                onClick={() => props.handleEditRow(row)}
                                type="button"
                                disabled // Disable the button
                                style={{ opacity: 0.5, cursor: "not-allowed" }} // Visual indication of disabled state
                              >
                                <img src={editIcon} alt="edit" className="table-action-icon" />
                              </button>
                            </Tooltip>
                          )}
                     */}

{o.actions.includes("edit") && userData?.userType !== "CRP" && (
  <Tooltip title="Edit this item" placement="top" arrow>
    <button
      className="btn btn-light border-secondary btn-sm"
      onClick={() => props.handleEditRow(row)}
      type="button"
      disabled // Disable the button
      style={{ opacity: 0.5, cursor: "not-allowed" }} 
    >
      <img src={editIcon} alt="edit" className="table-action-icon" />
    </button>
  </Tooltip>
)}
                          {/* View Button */}
                          {o.actions.includes("view") && (
                            <Tooltip title="View details" placement="top" arrow>
                              <button
                                className="btn btn-info btn-sm"
                                onClick={() => handleView(row)}
                                type="button"
                              >
                                <img src={viewIcon} alt="view" className="table-action-icon" />
                              </button>
                            </Tooltip>
                          )}
                    
                          {/* Delete Button */}
                          {o.actions.includes("delete") && (
                            <Tooltip title="Delete this item" placement="top" arrow>
                              <button
                                className="btn btn-danger btn-sm"
                                onClick={() => handleDeleteRow(row)}
                                type="button"
                              >
                                <img src={deleteIcon} alt="delete" className="table-action-icon" />
                              </button>
                            </Tooltip>
                          )}
                        </div>
                      </td>
                    ) : null
                  )}
                </tr>
              );
            })
          ) : (
            <tr>
              <td colSpan={props.columns.length} className="text-center fw-bold py-4">
                <h5>Sorry, we couldn't find any results</h5>
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  
    {/* Table Footer */}
    <div
          className={`col-sm-12 py-3 position-relative d-flex justify-content-between align-items-center ${style.table_footer}`}
        >
          <div>
            Entries found: {props?.rowData?.length || searchedData.length}
          </div>
          <div
            className="d-flex align-items-center"
            style={{ marginRight: 30 }}
          >
            <PaginationOptions />
            <div>
              <button
                onClick={handlePrevPage}
                disabled={currentPage === 1}
                className="btn btn-light"
              >
                <i className="fa fa-arrow-left" aria-hidden="true"></i>
              </button>
              <span className={`mx-1 ${style.pagenumber}`}>{currentPage}</span>
              <button
                onClick={handleNextPage}
                disabled={currentPage === totalPages}
                className="btn btn-light"
              >
                <i className="fa fa-arrow-right" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </div>
  </div>
