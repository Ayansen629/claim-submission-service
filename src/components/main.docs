import React, { useState, useEffect } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Form, Button, Card, Image } from 'react-bootstrap';
import { 
  FaUser, FaBuilding, FaFileUpload, FaCheck, FaArrowRight, 
  FaArrowLeft, FaIdCard, FaEnvelope, FaPhone, FaMapMarkerAlt, FaUpload, FaShip 
} from 'react-icons/fa';
import './Reg.css';
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";

// Main Registration Form Component
const RegistrationForm = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  
  const methods = useForm({
    mode: 'onBlur',
    defaultValues: { ownerCategory: '', country: 'India' }
  });
  
  const { register, handleSubmit, formState: { errors }, trigger, setValue, getValues, watch, clearErrors, setError } = methods;
  const totalSteps = 3;
  const ownerCategory = watch('ownerCategory');
  
  // Reset validation errors when changing steps
  useEffect(() => {
    // Clear previous errors when changing steps
    clearErrors();
  }, [currentStep, clearErrors]);

  // Form field definitions for all steps
  const formFields = {
    step1: [
      {
        name: 'ownerCategory',
        label: 'Category of Owner',
        type: 'select',
        options: [
          { value: '', label: 'Select Category' },
          { value: 'individual', label: 'Individual' },
          { value: 'company', label: 'Company' },
          { value: 'organization', label: 'Organization' }
        ],
        required: true,
        icon: FaBuilding,
        colSize: 6,
        validation: { required: 'Owner category is required' }
      },
      {
        name: 'ownerName',
        label: 'Owner/Company Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter owner or company name',
        validation: { required: 'Owner name is required' }
      },
      {
        name: 'email',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: { 
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      {
        name: 'phoneNumber',
        label: 'Phone Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        placeholder: 'Enter 10-digit phone number',
        validation: { 
          required: 'Phone number is required',
          pattern: {
            value: /^[0-9]{10}$/,
            message: 'Phone number must be 10 digits'
          }
        }
      },
      {
        name: 'panNumber',
        label: 'PAN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter PAN number (e.g., ABCDE1234F)',
        validation: { 
          required: 'PAN number is required',
          pattern: {
            value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
            message: 'Invalid PAN format'
          }
        }
      },
      {
        name: 'gstNumber',
        label: 'GST Number',
        type: 'text',
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter GST number (if applicable)',
        validation: { 
          pattern: {
            value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
            message: 'Invalid GST format'
          }
        }
      },
      {
        name: 'addressLine1',
        label: 'Address Line-1',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 1',
        validation: { required: 'Address is required' }
      },
      {
        name: 'addressLine2',
        label: 'Address Line-2',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 2 (optional)'
      },
      {
        name: 'pincode',
        label: 'PIN',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter 6-digit PIN code',
        validation: { 
          required: 'PIN code is required',
          pattern: {
            value: /^[0-9]{6}$/,
            message: 'PIN must be 6 digits'
          }
        },
        onChange: (e) => {
          if (e.target.value.length === 6) {
            setValue('district', 'Sample District');
            setValue('state', 'Sample State');
            setValue('country', 'India');
          }
        }
      },
      {
        name: 'district',
        label: 'District',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter district',
      },
      {
        name: 'state',
        label: 'State/UT',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter state',
      },
      {
        name: 'country',
        label: 'Country',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter country',
      }
    ],
    step2: [
      {
        name: 'firstName',
        label: 'First Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter first name',
        validation: { required: 'First name is required' }
      },
      {
        name: 'lastName',
        label: 'Last Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter last name',
        validation: { required: 'Last name is required' }
      },
      {
        name: 'mobileNumber',
        label: 'Primary Mobile Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        placeholder: 'Enter 10-digit mobile number',
        validation: { 
          required: 'Mobile number is required',
          pattern: {
            value: /^[0-9]{10}$/,
            message: 'Mobile number must be 10 digits'
          }
        }
      },
      {
        name: 'authorizedEmail',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: { 
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      {
        name: 'authorizationLetter',
        label: 'Upload Letter of Authorization',
        type: 'file',
        required: true,
        colSize: 12,
        validation: { required: 'Authorization letter is required' }
      }
    ],
    step3: [
      {
        name: 'panCardUpload',
        label: 'PAN Card',
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: 'PAN card upload is required' }
      },
      {
        name: 'gstCertificate',
        label: 'GST Certificate',
        type: 'file',
        required: false,
        colSize: 6
      },
      {
        name: 'addressProof',
        label: 'Address Proof',
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: 'Address proof is required' }
      },
      {
        name: 'companyRegistrationCertificate',
        label: 'Company Registration Certificate',
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: 'Company registration certificate is required' },
        showIf: () => ownerCategory !== 'organization'
      },
      {
        name: 'cinNumber',
        label: 'CIN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter CIN number',
        validation: { 
          required: 'CIN number is required',
          pattern: {
            value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
            message: 'Invalid CIN format'
          }
        },
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'dinNumber',
        label: 'DIN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter DIN number',
        validation: { 
          required: 'DIN number is required',
          pattern: {
            value: /^[0-9]{8}$/,
            message: 'DIN must be 8 digits'
          }
        },
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'moaCertificate',
        label: 'MOA Certificate',
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: 'MOA certificate is required' },
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'aoaCertificate',
        label: 'AOA Certificate',
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: 'AOA certificate is required' },
        showIf: () => ownerCategory === 'company'
      }
    ]
  };

  // Get fields for current step
  const getCurrentStepFields = () => {
    switch(currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      case 3: return formFields.step3;
      default: return [];
    }
  };

  // Validate current step
  const validateStep = async () => {
    // Get all required fields for current step
    const requiredFields = getCurrentStepFields()
      .filter(field => field.required && (!field.showIf || field.showIf()));
    
    // Mark all empty required fields with errors
    let hasEmptyFields = false;
    requiredFields.forEach(field => {
      const value = getValues(field.name);
      if (!value || value === '') {
        hasEmptyFields = true;
        // Set error manually for empty fields
        methods.setError(field.name, { 
          type: 'required', 
          message: `${field.label} is required` 
        });
      }
    });
    
    // If there are empty fields, return false immediately
    if (hasEmptyFields) {
      // Find first empty field to focus
      const firstEmptyField = requiredFields.find(field => !getValues(field.name));
      if (firstEmptyField) {
        const errorElement = document.querySelector(`[name="${firstEmptyField.name}"]`);
        if (errorElement) {
          errorElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
          errorElement.focus();
        }
      }
      return false;
    }
    
    // If all required fields have values, validate their format
    const fieldsToValidate = requiredFields.map(field => field.name);
    const isValid = await trigger(fieldsToValidate);
    
    // If validation fails, scroll to the first error field
    if (!isValid) {
      const firstErrorField = Object.keys(errors)[0];
      if (firstErrorField) {
        const errorElement = document.querySelector(`[name="${firstErrorField}"]`);
        if (errorElement) {
          errorElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
          errorElement.focus();
        }
      }
    }
    
    return isValid;
  };

  // Handle next button click
  const handleNext = async (e) => {
    e.preventDefault(); // Prevent default form submission
    
    // Force validation on all required fields
    const isStepValid = await validateStep();
    
    if (isStepValid) {
      const currentValues = getValues();
      setFormData(prev => ({ ...prev, ...currentValues }));
      
      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    } else {
      // Show error message for mandatory fields
      const missingFields = getCurrentStepFields()
        .filter(field => field.required && (!field.showIf || field.showIf()))
        .filter(field => !getValues(field.name))
        .map(field => field.label)
        .join(", ");
      
 
    }
  };

  // Handle previous button click
  const handlePrevious = () => {
    const currentValues = getValues();
    setFormData(prev => ({ ...prev, ...currentValues }));
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  // Handle form submission
  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };
    console.log('Form submitted with data:', JSON.stringify(finalData, null, 2));
    setIsSubmitted(true);
    window.scrollTo(0, 0);
  };

  // Handle manual field validation
  const handleBlur = (name) => {
    // Always trigger validation on blur
    trigger(name);
  };
  
  // Check if current step has any empty required fields
  const hasEmptyRequiredFields = () => {
    const currentFields = getCurrentStepFields()
      .filter(field => field.required && (!field.showIf || field.showIf()));
    
    return currentFields.some(field => {
      const value = getValues(field.name);
      return !value || value === '';
    });
  };

  // Dynamic Field Component
  const DynamicField = ({ field }) => {
    // Skip rendering if showIf condition is false
    if (field.showIf && !field.showIf()) return null;

    switch(field.type) {
      case 'select':
        return (
          <Form.Group className="form-group mb-4">
            <Form.Label className="fw-bold text-dark">
              {field.label} {field.required && <span className="required text-danger">*</span>}
            </Form.Label>
            <div className="input-with-icon">
              <Form.Select 
                name={field.name}
                onChange={(e) => {
                  if (field.onChange) field.onChange(e);
                  setValue(field.name, e.target.value);
                }}
                onBlur={() => handleBlur(field.name)}
                className={`form-select custom-select ${errors[field.name] ? 'is-invalid border-danger' : ''}`}
                disabled={field.readOnly}
                style={{ height: '50px', borderRadius: '8px' }}
                value={watch(field.name) || ''}
              >
                {field.options.map((option, idx) => (
                  <option key={idx} value={option.value}>{option.label}</option>
                ))}
              </Form.Select>
              {field.icon && <field.icon className="input-icon text-primary" />}
            </div>
            {errors[field.name] && <div className="error-message text-danger small mt-1">{errors[field.name].message}</div>}
          </Form.Group>
        );
      
      case 'file':
        return (
          <Form.Group className="form-group mb-4">
            <Form.Label className="fw-bold text-dark">
              {field.label} {field.required && <span className="required text-danger">*</span>}
            </Form.Label>
            <div className="file-upload border rounded p-3" style={{ borderRadius: '8px', borderColor: '#dee2e6' }}>
              <input 
                type="file" 
                id={field.name}
                onChange={(e) => {
                  if (e.target.files[0]) {
                    setValue(field.name, e.target.files[0].name);
                    clearErrors(field.name);
                  }
                }}
                className="file-input d-none"
              />
              <label htmlFor={field.name} className="file-label btn btn-outline-primary mb-0 d-inline-flex align-items-center" style={{ borderRadius: '6px' }}>
                <FaUpload className="file-icon me-2" />
                <span className="file-text">Choose File</span>
              </label>
              <span className="file-name ms-3 text-muted">
                {watch(field.name) ? watch(field.name) : 'No file chosen'}
              </span>
            </div>
            <div className="file-help-text text-muted small mt-1">Upload PDF, JPG or PNG file (Max size: 2MB)</div>
            {errors[field.name] && <div className="error-message text-danger small mt-1">{errors[field.name].message}</div>}
          </Form.Group>
        );
      
      default: // text, email, etc.
        return (
          <Form.Group className="form-group mb-4">
            <Form.Label className="fw-bold text-dark">
              {field.label} {field.required && <span className="required text-danger">*</span>}
            </Form.Label>
            <div className="input-with-icon">
              <Form.Control 
                type={field.type} 
                name={field.name}
                onChange={(e) => {
                  if (field.onChange) field.onChange(e);
                  setValue(field.name, e.target.value);
                }}
                onBlur={() => handleBlur(field.name)}
                className={`form-control custom-input ${errors[field.name] ? 'is-invalid border-danger' : field.readOnly ? 'auto-populated bg-light' : ''}`}
                placeholder={field.placeholder}
                readOnly={field.readOnly}
                defaultValue={field.defaultValue}
                value={watch(field.name) || ''}
                style={{ height: '50px', borderRadius: '8px' }}
              />
              {field.icon && <field.icon className="input-icon text-primary" />}
            </div>
            {errors[field.name] && <div className="error-message text-danger small mt-1">{errors[field.name].message}</div>}
          </Form.Group>
        );
    }
  };

  // Step titles
  const stepTitles = [
    { title: "Vessel Owner Details", icon: FaBuilding },
    { title: "Authorized Person's Details", icon: FaUser },
    { title: "Documents Upload", icon: FaFileUpload }
  ];

  // Custom styles
  const cardStyle = {
    borderRadius: '15px',
    overflow: 'hidden',
    boxShadow: '0 10px 30px rgba(0, 0, 0, 0.1)'
  };

  const headerStyle = {
    height: '140px',
    overflow: 'hidden',
    background: 'linear-gradient(135deg, #f8f9fa, #e9ecef)'
  };

  const buttonGradient = {
    background: 'linear-gradient(135deg, #0077b6, #023e8a)',
    border: 'none',
    boxShadow: '0 4px 15px rgba(0, 119, 182, 0.3)',
    borderRadius: '8px',
    padding: '12px 24px',
    fontWeight: '600',
    transition: 'all 0.3s ease'
  };

  const outlineButtonStyle = {
    borderRadius: '8px',
    padding: '12px 24px',
    fontWeight: '600',
    boxShadow: '0 4px 15px rgba(108, 117, 125, 0.15)',
    transition: 'all 0.3s ease'
  };

  const stepIconStyle = {
    width: '45px',
    height: '45px',
    borderRadius: '50%',
    fontSize: '18px',
    boxShadow: '0 4px 10px rgba(0, 0, 0, 0.1)'
  };

  return (
    <Container fluid className="registration-container py-5">
      <Row className="justify-content-center">
        <Col lg={10} xl={9}>
          <Card className="registration-card" style={cardStyle}>
            <Card.Header className="registration-header p-0">
              <div className="d-flex justify-content-between align-items-center px-4" style={headerStyle}>
                <Image 
                  src={IWT_FULL_IMG} 
                  alt="IWT Logo" 
                  style={{ maxHeight: '80%', objectFit: 'contain' }} 
                />
                <h3 className="text-primary fw-bold mb-0">Vessel Owner Registration</h3>
              </div>
            </Card.Header>
            
            <Card.Body className="registration-body p-4 p-md-5">
              {isSubmitted ? (
                <div className="success-container text-center py-5">
                  <div className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style={{ width: '90px', height: '90px', boxShadow: '0 10px 20px rgba(40, 167, 69, 0.3)' }}>
                    <FaCheck className="success-icon text-white fs-1" />
                  </div>
                  <h4 className="success-title text-success mb-3 fw-bold">Registration Successful!</h4>
                  <p className="success-message mb-4 text-muted fs-5">
                    Your vessel owner registration has been submitted successfully. 
                    You will receive a confirmation email shortly.
                  </p>
                  <div className="registration-id p-4 bg-light rounded mb-4" style={{ borderLeft: '4px solid #0077b6' }}>
                    <strong>Registration ID:</strong> {Math.random().toString(36).substring(2, 10).toUpperCase()}
                  </div>
                  <Button 
                    variant="primary" 
                    size="lg"
                    className="mt-2 px-5"
                    style={buttonGradient}
                    onClick={() => window.location.href = '/dashboard'}
                  >
                    Go to Dashboard
                  </Button>
                </div>
              ) : (
                <FormProvider {...methods}>
                  <form onSubmit={(e) => e.preventDefault()}>
                    {/* Sign Up Message */}
                    <div className="text-center mb-4">
                      <p className="text-muted">Please complete all required information to register your vessel</p>
                      <p className="text-danger small">Fields marked with <span className="fw-bold">*</span> are mandatory</p>
                    </div>
                    
                    {/* Stepper */}
                    <div className="stepper-container mb-5">
                      <div className="stepper d-flex justify-content-between">
                        {[1, 2, 3].map((step) => (
                          <React.Fragment key={step}>
                            <div className={`step ${currentStep >= step ? 'active' : ''} ${currentStep > step ? 'completed' : ''} flex-grow-1 text-center`}>
                              <div className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2" 
                                style={{
                                  ...stepIconStyle,
                                  background: currentStep >= step ? 
                                    (currentStep > step ? '#28a745' : '#0077b6') : 
                                    '#f8f9fa',
                                  color: currentStep >= step ? '#fff' : '#6c757d'
                                }}>
                                {currentStep > step ? <FaCheck /> : step}
                              </div>
                              <div className="step-label small fw-bold" style={{ color: currentStep >= step ? (currentStep > step ? '#28a745' : '#0077b6') : '#6c757d' }}>
                                {stepTitles[step-1].title}
                              </div>
                            </div>
                            {step < 3 && (
                              <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                                <div className={`connector-line w-100 ${currentStep > step ? 'active' : ''}`} 
                                  style={{ 
                                    height: '3px', 
                                    background: currentStep > step ? '#28a745' : '#e9ecef',
                                    transition: 'all 0.3s ease'
                                  }}></div>
                              </div>
                            )}
                          </React.Fragment>
                        ))}
                      </div>
                    </div>
                    
                    {/* Step Content */}
                    <div className="step-content">
                      <div className="form-section bg-light p-4 rounded mb-4" style={{ borderRadius: '12px', boxShadow: '0 5px 15px rgba(0, 0, 0, 0.05)' }}>
                        <div className="section-title d-flex align-items-center mb-4 pb-2 border-bottom">
                          {React.createElement(stepTitles[currentStep-1].icon, { className: "section-icon text-primary me-2 fs-4" })}
                          <h4 className="mb-0 fw-bold">{stepTitles[currentStep-1].title}</h4>
                        </div>
                        
                        <div className="form-content">
                          <Row className="g-3">
                            {getCurrentStepFields().map((field, index) => (
                              <Col key={index} md={field.colSize || 12}>
                                <DynamicField field={field} />
                              </Col>
                            ))}
                          </Row>
                        </div>
                      </div>
                    </div>
                    
                    {/* Navigation Buttons */}
                    <div className="form-navigation d-flex justify-content-between mt-4">
                      <Button 
                        variant="outline-secondary" 
                        onClick={handlePrevious}
                        disabled={currentStep === 1}
                        className="prev-btn d-flex align-items-center"
                        size="lg"
                        style={outlineButtonStyle}
                      >
                        <FaArrowLeft className="btn-icon me-2" /> Previous
                      </Button>
                      
                      <Button 
                        variant="primary" 
                        onClick={handleNext}
                        className="next-btn d-flex align-items-center"
                        size="lg"
                        style={buttonGradient}
                      >
                        {currentStep === totalSteps ? 'Submit Registration' : 'Next'} 
                        {currentStep !== totalSteps && <FaArrowRight className="btn-icon ms-2" />}
                      </Button>
                    </div>
                  </form>
                </FormProvider>
              )}
            </Card.Body>
          </Card>
        </Col>
      </Row>
    </Container>
  );
};

export default RegistrationForm;
