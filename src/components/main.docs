  const [materialTestFiles, setMaterialTestFiles] = useState([{ id: 1 }]);
  const [otherInspectionFiles, setOtherInspectionFiles] = useState([{ id: 1 }]);
  const [otherTechnicalDocumentFiles, setOtherTechnicalDocumentFiles] = useState([{ id: 1 }]);



  console.log("registrationData--survey--steps", registrationData);

