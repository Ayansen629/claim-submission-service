// Changes are focused on the stats cards and vessel registration/survey sections

{/* Updated Stats Section */}
<section className="stats-section py-5">
  <Container fluid="xxl">
    <Row className="g-4 justify-content-center">
      {statsData.map((stat, index) => (
        <Col xl={3} lg={6} md={6} key={index}>
          <Card className="stat-card h-100" style={{ 
            background: 'linear-gradient(135deg, #00429C, #4695FF)',
            color: '#fff'
          }}>
            <Card.Body className="text-center">
              <h2 className="stat-value text-white">{stat.value}</h2>
              <h5 className="stat-label text-white">{stat.label}</h5>
              <p className="stat-description text-white">{stat.description}</p>
            </Card.Body>
          </Card>
        </Col>
      ))}
    </Row>
  </Container>
</section>

{/* Updated Vessel Registration Section */}
<section className="vessel-registration py-5 bg-light">
  <Container fluid="xxl" className="px-4">
    <div className="section-header mb-5">
      <h2 className="section-title">Vessel Registration</h2>
      <p className="section-description">
        {/* ... existing description ... */}
      </p>
    </div>
    
    <Row className="align-items-stretch g-4">
      <Col xl={6} className="mb-4 mb-xl-0">
        <Row className="g-3 h-100">
          {vesselRegistrationItems.map((item, index) => (
            <Col md={6} key={index}>
              {/* ... existing card structure ... */}
            </Col>
          ))}
        </Row>
      </Col>
      <Col xl={6} className="h-100">
        <div className="vessel-image-container h-100">
          <img 
            src={Ship} 
            alt="IWT Ship" 
            className="img-fluid h-100" 
            style={{ 
              objectFit: 'cover', 
              objectPosition: 'center bottom',
              borderRadius: '10px'
            }} 
          />
        </div>
      </Col>
    </Row>
  </Container>
</section>

{/* Updated Vessel Survey Section */}
<section className="vessel-survey py-5">
  <Container fluid="xxl" className="px-4">
    {/* ... existing header ... */}
    
    <Row className="align-items-stretch g-4">
      <Col lg={6} className="order-lg-2 h-100 mb-4 mb-lg-0">
        <Row className="g-3 h-100">
          {vesselSurveyItems.map((item, index) => (
            <Col md={6} key={index}>
              {/* ... existing card structure ... */}
            </Col>
          ))}
        </Row>
      </Col>
      <Col lg={6} className="order-lg-1 h-100">
        <div className="survey-image-container h-100">
          <img 
            src={Tower} 
            alt="Survey Tower" 
            className="img-fluid h-100" 
            style={{ 
              borderRadius: '10px',
              objectFit: 'cover'
            }} 
          />
        </div>
      </Col>
    </Row>
  </Container>
</section>
