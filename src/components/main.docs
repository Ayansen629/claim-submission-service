const handleFormSubmit = async (data) => {
  if (!uploadedFile?.url) {
    toast.error("Please upload a file first.");
    return;
  }

  setSubmitting(true);
  
  try {
    const apiReportType = getReportTypeMapping(reportType);
    
    const payload = {
      applicationNo: "039f85be-0201-4802-b6fb-c3b9d59af6e1",
      doc: [
        {
          id: "",
          documentName: getReportDisplayName(reportType),
          documentType: apiReportType,
          applicationNumber: "039f85be-0201-4802-b6fb-c3b9d59af6e1",
          fileStoreId: uploadedFile.url,
          documentSource: apiReportType,
          description: data.description || "",
          auditDetails: {
            createdBy: "user-001",
            createdTime: Date.now(),
            updatedBy: "user-001",
            updatedOn: Date.now()
          },
          active: true
        }
      ]
    };

    const uploadApiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.USER_SERVICE.REPORT_UPLOAD;
    const response = await postData(uploadApiUrl, payload);
    
    // Check both HTTP status and response status
    if (response?.status === 200 && response?.data?.responseStatus?.status === "Document saved successfully.") {
      toast.success("Report uploaded successfully!");
      onSubmit && onSubmit(response.data.data[0]);
      resetForm();
      onHide();
    } else {
      toast.error("Failed to save report. Please try again.");
    }
  } catch (err) {
    console.error("Report upload failed:", err);
    toast.error("Report upload failed. Please try again.");
  } finally {
    setSubmitting(false);
  }
};
