  //                 </span>
  //               )}
  //             </p>
  //           </div>
  //         </div>
  //         <div className="d-flex gap-2">
  //           <Button
  //             variant="outline-primary"
  //             size="sm"
  //             onClick={() => onDownload(fileName)}
  //             className="rounded-pill"
  //           >
  //             <BsDownload size={14} />
  //           </Button>
  //           {showRemove && (
  //             <Button
  //               variant="outline-danger"
  //               size="sm"
  //               onClick={onRemove}
  //               className="rounded-pill"
  //             >
  //               <BsTrash size={14} />
  //             </Button>
  //           )}
  //         </div>
  //       </div>
  //     </Card.Body>
  //   </Card>
  // );

  const FileUploadCard = ({ label, name, onRemove, showRemove = false }) => (
    <Card className="mb-3 border-2 border-dashed border-primary border-opacity-25">
      <Card.Body className="p-3">
        <div className="mb-3">
          <InputFile
            label={label}
            name={name}
            register={register(name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                
                if (file.size > 10 * 1024 * 1024) {
                  setError(name, {
                    type: 'manual',
                    message: t('File size should not exceed 10MB')
                  });
                  return;
                }
                
                const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                const fileName = `${label}${extension}`;
                file.originalName = fileName;
                const renamedFile = renameFile(file, fileName);

                clearErrors(name);
                setValue(name, renamedFile, { shouldValidate: true });
                setFormData((prev) => ({
                  ...prev,
                  [name]: renamedFile
                }));
              }
            }}
            watch={watch}
            defaultValue={watch(name)}
            clearErrors={clearErrors}
            accept=".pdf,.jpg,.jpeg,.png"
          />
        </div>
        <div className="mb-3">
          <InputText
            label={t("Description")}
            name={name.replace('_file_', '_desc_')}
            placeholder={t("Enter file description")}
            register={register(name.replace('_file_', '_desc_'))}
            errors={errors}
          />
        </div>
        {showRemove && (
          <div className="text-end">
            <Button
              variant="outline-danger"
              size="sm"
              onClick={onRemove}
              className="rounded-pill"
            >
              <BsTrash className="me-1" size={14} />
              Remove
            </Button>
          </div>
        )}
      </Card.Body>
    </Card>
  );
  const FileSection = ({ title, files, type, icon }) => {
  const filesWithData = files.filter(file => {
    const fileData = watch(`${type}_file_${file.id}`);
    return fileData && fileData.name;
  });

  return (
    <Card className="h-100 shadow-sm border-0">
      <Card.Header className="bg-light border-0 py-2">
        <div className="d-flex justify-content-between align-items-center">
          <h6 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: '0.9rem' }}>
            {icon}
            <span className="ms-2">{title}</span>
          </h6>
          <span className="badge bg-primary rounded-pill" style={{ fontSize: '0.7rem' }}>
            {viewMode ? filesWithData.length : files.length} files
          </span>
        </div>
      </Card.Header>

      <Card.Body className="p-0">
        <div style={{ maxHeight: "350px", overflowY: "auto" }} className="p-2">
          {viewMode ? (
            filesWithData.length > 0 ? (
              <div className="row g-1">
                {filesWithData.map((fileInput, index) => {
                  const fileData = watch(`${type}_file_${fileInput.id}`);
                  const descData = watch(`${type}_desc_${fileInput.id}`);
                  
                  return (
                    <div key={fileInput.id} className="col-12">
                      <DocumentCard
                        fileName={fileData.name}
                        description={descData || `${title} document ${index + 1}`}
                        fileSize={fileData.size}
                        onDownload={() => handleDownload(fileData.name)}
                      />
                    </div>
                  );
                })}
              </div>
            ) : (
              <div className="text-center py-4 text-muted">
                <div className="bg-light rounded-circle p-3 d-inline-flex mb-2">
                  <BsFileEarmarkPdf size={32} className="opacity-50" />
                </div>
                <p className="mb-0 small">No files uploaded</p>
              </div>
            )
          ) : (
            <>
              {files.map((fileInput, idx) => (
                <FileUploadCard
                  key={fileInput.id}
                  label={`${t("Choose File")} ${idx + 1}`}
                  fileName={type === 'workOrder' ? `WorkOrder_${fileInput.id}` : `Drawing_${fileInput.id}`}
                  name={`${type}_file_${fileInput.id}`}
                  onRemove={() => removeFileInput(type, fileInput.id)}
                  showRemove={files.length > 1}
                />
              ))}
            </>
          )}
        </div>
      </Card.Body>

      {!viewMode && (
        <Card.Footer className="bg-light border-0 text-center py-2">
          <Button
            variant="primary"
            size="sm"
            onClick={() => addFileInput(type)}
            className="rounded-pill px-3"
            style={{ fontSize: '0.8rem' }}
          >
            <BsPlus className="me-1" size={14} />
            Add {title}
          </Button>
        </Card.Footer>
      )}
    </Card>
  );
};

  // const FileSection = ({ title, files, type, icon }) => {
  //   const filesWithData = files.filter(file => {
  //     const fileData = watch(`${type}_file_${file.id}`);
  //     return fileData && fileData.name;
  //   });

