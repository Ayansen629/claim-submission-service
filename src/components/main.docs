.tabs-wrapper {
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.1);
  border: 1px solid #e9ecef;
  overflow: hidden;
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
}

.tabs-header {
  position: relative;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-bottom: 1px solid #e9ecef;
  padding: 8px 0 0 0;
}

.tabs-header.with-arrows {
  padding: 8px 60px 0 60px;
}

.scroll-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  background: linear-gradient(135deg, #2E57A7, #1f4ea0);
  border: none;
  border-radius: 50%;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  box-shadow: 0 4px 16px rgba(46, 87, 167, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-size: 12px;
}

.scroll-btn:hover {
  transform: translateY(-50%) scale(1.1);
  box-shadow: 0 6px 20px rgba(46, 87, 167, 0.4);
}

.scroll-btn.left {
  left: 10px;
}

.scroll-btn.right {
  right: 10px;
}

.tabs-scroll {
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.tabs-scroll::-webkit-scrollbar {
  display: none;
}

.tab-list {
  display: flex;
  list-style: none;
  margin: 0;
  padding: 0 16px;
  gap: 2px;
  min-height: 44px;
  align-items: flex-end;
}

.tab-item {
  flex-shrink: 0;
}

.tab-btn {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px 12px 18px;
  background: rgba(248, 249, 250, 0.8);
  border: 1px solid #e9ecef;
  cursor: pointer;
  font-size: 13px;
  font-weight: 500;
  color: #6c757d;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  white-space: nowrap;
  border-radius: 8px 8px 0 0;
  min-height: 40px;
  overflow: hidden;
  border-bottom: none;
  margin-bottom: -1px;
}

.tab-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(46, 87, 167, 0.05), rgba(31, 78, 160, 0.05));
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: 8px 8px 0 0;
}

.tab-btn:hover::before {
  opacity: 1;
}

.tab-btn:hover {
  color: #2E57A7;
  background: rgba(255, 255, 255, 0.9);
  border-color: rgba(46, 87, 167, 0.3);
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(46, 87, 167, 0.15);
}

.tab-btn.active {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #28a745, #20c997);
  border-color: #20c997;
  box-shadow: 0 6px 20px rgba(40, 167, 69, 0.4);
  transform: translateY(-3px);
  z-index: 5;
}

.tab-btn.active::before {
  opacity: 0;
}

.tab-btn.active::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(135deg, #28a745, #20c997);
}

.tab-icon {
  font-size: 14px;
  display: flex;
  align-items: center;
  transition: transform 0.3s ease;
}

.tab-btn:hover .tab-icon,
.tab-btn.active .tab-icon {
  transform: scale(1.1);
}

.tab-title {
  font-size: 13px;
  line-height: 1.3;
  font-weight: inherit;
  letter-spacing: 0.2px;
}

.tab-badge {
  background: linear-gradient(135deg, #dc3545, #c82333);
  color: white;
  border-radius: 10px;
  padding: 2px 6px;
  font-size: 10px;
  font-weight: 600;
  min-width: 16px;
  text-align: center;
  box-shadow: 0 2px 4px rgba(220, 53, 69, 0.3);
}

.tab-btn.active .tab-badge {
  background: linear-gradient(135deg, #ffffff, #f8f9fa);
  color: #28a745;
  box-shadow: 0 2px 4px rgba(255, 255, 255, 0.3);
}

.tabs-content {
  padding: 0;
  background: #ffffff;
  min-height: 350px;
  border-radius: 0 0 12px 12px;
}

/* Responsive Design */
@media (max-width: 768px) {
  .tab-btn {
    padding: 8px 14px 10px 14px;
    font-size: 12px;
    min-height: 36px;
    gap: 6px;
  }
  
  .tab-list {
    padding: 0 12px;
    gap: 1px;
    min-height: 40px;
  }
  
  .scroll-btn {
    width: 36px;
    height: 36px;
    font-size: 11px;
  }
  
  .tabs-header.with-arrows {
    padding: 8px 48px 0 48px;
  }
}

@media (max-width: 480px) {
  .tab-btn {
    padding: 6px 12px 8px 12px;
    gap: 4px;
  }
  
  .tab-title {
    font-size: 12px;
  }
  
  .tab-list {
    padding: 0 8px;
    gap: 1px;
  }
}

/* Single tab styling */
.tab-list.single-tab {
  justify-content: center;
}

.tab-list.single-tab .tab-item {
  min-width: 180px;
}

.tab-list.single-tab .tab-btn {
  width: 100%;
  justify-content: center;
  padding: 12px 24px 14px 24px;
  font-size: 14px;
  font-weight: 600;
}

/* Dynamic width styling */
.tab-list.dynamic-width {
  display: grid;
  grid-template-columns: repeat(var(--tab-count, 1), 1fr);
  gap: 2px;
}

.tab-list.dynamic-width .tab-item {
  width: 100%;
}

.tab-list.dynamic-width .tab-btn {
  width: 100%;
  justify-content: center;
  padding: 10px 16px 12px 16px;
  font-size: 13px;
  font-weight: 600;
}

/* Subtle glow effect for active tab */
.tab-btn.active {
  animation: subtleGlow 3s ease-in-out infinite alternate;
}

@keyframes subtleGlow {
  from {
    box-shadow: 0 6px 20px rgba(40, 167, 69, 0.4);
  }
  to {
    box-shadow: 0 8px 28px rgba(40, 167, 69, 0.5);
  }
}
