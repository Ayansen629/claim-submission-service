import React, { useState } from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

const themeColor = "#2E57A7";
const successColor = "#28a745";

const Stepper = ({ steps, onSave, formMethods }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [activeStep, setActiveStep] = useState(0);
  const [completed, setCompleted] = useState({});
  const [errors, setErrors] = useState({});

  const totalSteps = steps.length;

  const validateCurrentStep = async () => {
    const currentStep = steps[activeStep];
    if (!currentStep.validate) return true;

    // First try standard validation
    let isValid = await currentStep.validate();
    
    // Special handling for documents step
    if (activeStep === 1 && !isValid) {
      const values = formMethods.getValues();
      
      // Manually verify if files exist
      const hasTonnageBooklets = !!values.tonnageBooklets;
      const hasStabilityBooklets = !!values.stabilityBooklets;
      const hasAuthLetter = values.constructedBy !== "2" || !!values.authLetter;
      const hasTermsAccepted = !!values.termsAccepted;

      if (hasTonnageBooklets && hasStabilityBooklets && hasAuthLetter && hasTermsAccepted) {
        // Clear any lingering errors
        formMethods.clearErrors([
          "tonnageBooklets",
          "stabilityBooklets",
          "authLetter",
          "termsAccepted"
        ]);
        return true;
      }
    }

    return isValid;
  };

  const handleNext = async () => {
    const isValid = await validateCurrentStep();
    setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
    
    if (isValid) {
      setCompleted({ ...completed, [activeStep]: true });
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
    } else {
      const errorFields = Object.keys(formMethods.formState.errors);
      if (errorFields.length > 0) {
        toast.error(t("Please fix the errors before proceeding."));
      }
    }
  };

  const handleBack = () => {
    setActiveStep((prev) => Math.max(prev - 1, 0));
  };

  const handleSave = async () => {
    const isValid = await validateCurrentStep();
    
    if (isValid) {
      setCompleted({ ...completed, [activeStep]: true });
      if (activeStep < totalSteps - 1) {
        setActiveStep((prev) => prev + 1);
      } else {
        onSave();
      }
    } else {
      // Get current errors to show specific messages
      const errors = formMethods.formState.errors;
      let errorMessage = t("Please fix the following errors:");
      
      if (errors.tonnageBooklets) errorMessage += `\n- ${errors.tonnageBooklets.message}`;
      if (errors.stabilityBooklets) errorMessage += `\n- ${errors.stabilityBooklets.message}`;
      if (errors.authLetter) errorMessage += `\n- ${errors.authLetter.message}`;
      if (errors.termsAccepted) errorMessage += `\n- ${errors.termsAccepted.message}`;

      toast.error(errorMessage);
    }
  };

  return (
    <Box sx={{ width: "100%", padding: "1rem" }}>
      {/* Step Header */}
      <Paper
        elevation={3}
        sx={{
          padding: "0.75rem 1.5rem",
          borderRadius: "0.75rem",
          overflowX: "auto",
          whiteSpace: "nowrap",
          backgroundColor: "#fafafa",
        }}
      >
        <Stack direction="row" alignItems="center" spacing={1}>
          {steps.map((step, index) => (
            <React.Fragment key={index}>
              <Stack
                direction="row"
                alignItems="center"
                spacing={0.5}
                sx={{ cursor: "pointer" }}
                onClick={() => setActiveStep(index)}
              >
                {completed[index] ? (
                  <CheckCircleFill size={18} color={successColor} />
                ) : (
                  <Typography
                    sx={{
                      fontSize: "0.875rem",
                      width: "1.5rem",
                      height: "1.5rem",
                      textAlign: "center",
                      borderRadius: "50%",
                      backgroundColor: "#e0e0e0",
                      display: "inline-flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: "bold",
                      color: "#666",
                    }}
                  >
                    {index + 1}
                  </Typography>
                )}
                <Typography
                  sx={{
                    fontWeight: index === activeStep ? "bold" : "normal",
                    color: index === activeStep ? themeColor : "#999",
                    fontSize: "0.875rem",
                    whiteSpace: "nowrap",
                  }}
                >
                  {step.label}
                </Typography>
              </Stack>
              {index < steps.length - 1 && <ChevronRight size={14} color="#ccc" />}
            </React.Fragment>
          ))}
        </Stack>
      </Paper>

      {/* Step Content */}
      <Paper
        elevation={2}
        sx={{
          marginTop: "1rem",
          borderRadius: "0.75rem",
          backgroundColor: "#fff",
          width: "100%",
        }}
      >
        {steps[activeStep].component}
      </Paper>

      <Divider sx={{ margin: "2rem 0" }} />

      {/* Navigation Buttons */}
      <Box
        sx={{
          display: "flex",
          justifyContent: "space-between",
          gap: "1rem",
          flexWrap: "wrap",
        }}
      >
        <Button
          variant="outlined"
          onClick={handleBack}
          disabled={activeStep === 0}
          sx={{
            color: themeColor,
            borderColor: themeColor,
            fontWeight: "bold",
            borderRadius: "0.5rem",
            minWidth: "8rem",
            fontSize: "0.9rem",
          }}
        >
          {t("Previous")}
        </Button>
        
        {activeStep === totalSteps - 1 ? (
          <Button
            variant="contained"
            onClick={handleSave}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            {t("Pay Now")}
          </Button>
        ) : (
          <Button
            variant="contained"
            onClick={activeStep === 1 ? handleSave : handleNext}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            {activeStep === 1 ? t("Save & Next") : t("Next")}
          </Button>
        )}
      </Box>
    </Box>
  );
};

export default Stepper;
