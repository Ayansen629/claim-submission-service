import React, { useState, useEffect, useRef } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Button, Card, Badge, Stack, Tab, Tabs } from 'react-bootstrap';
import { FaFileAlt, FaFileUpload, FaArrowLeft, FaArrowRight, FaArrowAltCircleLeft, FaCheckCircle, FaUser, FaBuilding, FaEye, FaDownload, FaRegBuilding, FaRegUser } from 'react-icons/fa';
import { BsFileEarmarkX } from 'react-icons/bs';
import { useNavigate, useParams, useLocation } from 'react-router-dom';
import ActionDropdown from '../../../common/ActionDropdown';
import ApprovalModal from '../../../common/ApprovalModal';
import NewLoader from '../../../common/NewLoader';
import DynamicViewFields from '../../../common/DynamicViewFields';
import { useTranslation } from 'react-i18next';
import './userViewPage.css';

const UserViewPage = () => {
  const { t } = useTranslation();
  const { type, id } = useParams();
  const location = useLocation();
  const applicationInfo = location.state?.application;

  // Static data for demonstration
  const staticData = {
    owner: {
      registrationNumber: 'APP-2023-00125',
      status: 'Approved',
      categoryOfOwner: 'Corporate',
      ownerCompanyName: 'Oceanic Vessels Ltd.',
      emailId: 'contact@oceanicvessels.com',
      phoneNumber: '+919876543210',
      panNo: 'ABCDE1234F',
      aadharNumber: '123456789012',
      tradeLicenseNumber: 'TL-2020-45678',
      gstNo: '22ABCDE1234F1Z5',
      addressLine1: '12, Marine Business Park',
      addressLine2: 'Andheri East',
      pin: '400069',
      district: 'Mumbai',
      state: 'Maharashtra',
      country: 'India',
      authorisedFname: 'Rajesh',
      authorisedLname: 'Patel',
      authorisedMob: '+919876543211',
      authorisedEmail: 'rajesh.patel@oceanicvessels.com',
      cinNo: 'U45200MH2010PTC123456',
      dinNo: '01234567',
      panCardUpload: {
        fileName: 'PAN_Card.pdf',
        downLoadFile: 'https://example.com/files/pan_card.pdf'
      },
      gstCertificate: {
        fileName: 'GST_Certificate.pdf',
        downLoadFile: 'https://example.com/files/gst_certificate.pdf'
      },
      addressProof: {
        fileName: 'Address_Proof.pdf',
        downLoadFile: 'https://example.com/files/address_proof.pdf'
      },
      authorizationLetter: {
        fileName: 'Authorization_Letter.pdf',
        downLoadFile: 'https://example.com/files/authorization_letter.pdf'
      },
      companyRegistrationCertificate: {
        fileName: 'Company_Registration.pdf',
        downLoadFile: 'https://example.com/files/company_registration.pdf'
      },
      moaCertificate: {
        fileName: 'MOA_Certificate.pdf',
        downLoadFile: 'https://example.com/files/moa_certificate.pdf'
      },
      aoaCertificate: {
        fileName: 'AOA_Certificate.pdf',
        downLoadFile: 'https://example.com/files/aoa_certificate.pdf'
      }
    },
    builder: {
      registrationNumber: 'APP-2023-00126',
      status: 'Pending Review',
      builderName: 'Marine Constructors Pvt. Ltd.',
      emailId: 'info@marineconstructors.com',
      phoneNumber: '+919876543212',
      panNo: 'BCDEF2345G',
      gstNo: '27BCDEF2345G2Z6',
      addressLine1: '34, Shipyard Road',
      addressLine2: 'Belapur',
      pin: '400614',
      district: 'Navi Mumbai',
      state: 'Maharashtra',
      country: 'India',
      companyDetails: {
        fileName: 'Company_Details.pdf',
        downLoadFile: 'https://example.com/files/company_details.pdf'
      },
      panCardUpload: {
        fileName: 'PAN_Card.pdf',
        downLoadFile: 'https://example.com/files/pan_card.pdf'
      },
      factoryLicense: {
        fileName: 'Factory_License.pdf',
        downLoadFile: 'https://example.com/files/factory_license.pdf'
      },
      addressProof: {
        fileName: 'Address_Proof.pdf',
        downLoadFile: 'https://example.com/files/address_proof.pdf'
      },
      fireCertificate: {
        fileName: 'Fire_Certificate.pdf',
        downLoadFile: 'https://example.com/files/fire_certificate.pdf'
      },
      esipfRegistration: {
        fileName: 'ESIPF_Registration.pdf',
        downLoadFile: 'https://example.com/files/esipf_registration.pdf'
      },
      iso9001: {
        fileName: 'ISO_9001.pdf',
        downLoadFile: 'https://example.com/files/iso_9001.pdf'
      },
      iso14001: {
        fileName: 'ISO_14001.pdf',
        downLoadFile: 'https://example.com/files/iso_14001.pdf'
      },
      iso45001: {
        fileName: 'ISO_45001.pdf',
        downLoadFile: 'https://example.com/files/iso_45001.pdf'
      },
      pollutionCertificate: {
        fileName: 'Pollution_Certificate.pdf',
        downLoadFile: 'https://example.com/files/pollution_certificate.pdf'
      },
      experienceCertificate: {
        fileName: 'Experience_Certificate.pdf',
        downLoadFile: 'https://example.com/files/experience_certificate.pdf'
      }
    }
  };

  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(false);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [completedSteps, setCompletedSteps] = useState(new Set());
  const navigate = useNavigate();
  const [actionsFromAPI, setActionsFromAPI] = useState([]);
  const [originalActions, setOriginalActions] = useState([]);
  const loaderRef = useRef();
  const [activeTab, setActiveTab] = useState(type || 'owner');

  const isOwner = activeTab === 'owner';
  const isBuilder = activeTab === 'builder';
  const totalSteps = isOwner ? 3 : 2;

  useEffect(() => {
    setIsLoading(true);
    loaderRef.current?.show?.();
    
    // Use static data based on active tab
    const dataToUse = applicationInfo || staticData[activeTab];
    
    setFormData(dataToUse);
    
    // Mock actions
    const actionsList = [
      { actionName: "Approve", actionDescription: "Approve Application" },
      { actionName: "Reject", actionDescription: "Reject Application" },
      { actionName: "Request Changes", actionDescription: "Request Changes" }
    ];
    
    setOriginalActions(actionsList);
    const actionNames = actionsList.map(action => action.actionName || action.actionDescription || action);
    setActionsFromAPI(actionNames);
    
    setCompletedSteps(new Set([1]));
    
    setTimeout(() => {
      setIsLoading(false);
      loaderRef.current?.hide?.();
    }, 500);
  }, [applicationInfo, activeTab]);

  const methods = useForm({ defaultValues: { country: 'India' } });
  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading && Object.keys(formData).length > 0) {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined && formData[key] !== null) {
          setValue(key, formData[key]);
        }
      });
    }
  }, [isLoading, formData, setValue]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (modalFormData) => {
    const fullActionObject = originalActions.find(
      action => action.actionName === selectedAction || action.actionDescription === selectedAction
    );

    const payload = {
      applicationNo: formData.registrationNumber,
      action: selectedAction,
      processId: "PROC-001", // Mock process ID
      actionId: fullActionObject?.actionId,
      processName: "User Registration Approval",
      ...modalFormData,
    };
    console.log("Action submitted:", payload);
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const getFormFieldsConfig = () => {
    if (isOwner) {
      return {
        step1: [
          { name: "categoryOfOwner", label: t("vesselOwnerRegistration.Category of Owner"), type: "text", colSize: 6 },
          { name: "ownerCompanyName", label: t("vesselOwnerRegistration.Owner/Company Name"), type: "text", colSize: 6 },
          { name: "emailId", label: t("vesselOwnerRegistration.Email ID"), type: "email", colSize: 6 },
          { name: "phoneNumber", label: t("vesselOwnerRegistration.Phone Number"), type: "text", colSize: 6 },
          { name: "panNo", label: t("vesselOwnerRegistration.PAN Number"), type: "text", colSize: 6 },
          { name: "aadharNumber", label: t("vesselOwnerRegistration.Aadhar Number"), type: "text", colSize: 6 },
          { name: "tradeLicenseNumber", label: t("vesselOwnerRegistration.Trade License Number"), type: "text", colSize: 6 },
          { name: "gstNo", label: t("vesselOwnerRegistration.GST Number"), type: "text", colSize: 6 },
          { name: "addressLine1", label: t("vesselOwnerRegistration.Address Line-1"), type: "text", colSize: 6 },
          { name: "addressLine2", label: t("vesselOwnerRegistration.Address Line-2"), type: "text", colSize: 6 },
          { name: "pin", label: t("vesselOwnerRegistration.PIN"), type: "text", colSize: 6 },
          { name: "district", label: t("vesselOwnerRegistration.District"), type: "text", colSize: 6 },
          { name: "state", label: t("vesselOwnerRegistration.State / UT"), type: "text", colSize: 6 },
          { name: "country", label: t("vesselOwnerRegistration.Country"), type: "text", colSize: 6 },
        ],
        step2: [
          { name: "authorisedFname", label: t("vesselOwnerRegistration.First Name"), type: "text", colSize: 6 },
          { name: "authorisedLname", label: t("vesselOwnerRegistration.Last Name"), type: "text", colSize: 6 },
          { name: "authorisedMob", label: t("vesselOwnerRegistration.Primary Mobile Number"), type: "text", colSize: 6 },
          { name: "authorisedEmail", label: t("vesselOwnerRegistration.Email ID"), type: "email", colSize: 6 },
          { name: "authorizationLetter", label: t("vesselOwnerRegistration.Letter of Authorization"), type: "file", colSize: 12 },
        ],
        step3: [
          { name: "panCardUpload", label: t("vesselOwnerRegistration.PAN Card"), type: "file", colSize: 6 },
          { name: "gstCertificate", label: t("vesselOwnerRegistration.GST Certificate"), type: "file", colSize: 6 },
          { name: "addressProof", label: t("vesselOwnerRegistration.Address Proof"), type: "file", colSize: 6 },
          { name: "companyRegistrationCertificate", label: t("vesselOwnerRegistration.Company Registration Certificate"), type: "file", colSize: 6 },
          { name: "moaCertificate", label: t("vesselOwnerRegistration.MOA Certificate"), type: "file", colSize: 6 },
          { name: "aoaCertificate", label: t("vesselOwnerRegistration.AOA Certificate"), type: "file", colSize: 6 },
        ]
      };
    } else {
      return {
        step1: [
          { name: "builderName", label: t("builderRegistration.builderName"), type: "text", colSize: 6 },
          { name: "emailId", label: t("builderRegistration.Email ID"), type: "email", colSize: 6 },
          { name: "phoneNumber", label: t("builderRegistration.Phone Number"), type: "text", colSize: 6 },
          { name: "panNo", label: t("builderRegistration.PAN Number"), type: "text", colSize: 6 },
          { name: "gstNo", label: t("builderRegistration.GST Number"), type: "text", colSize: 6 },
          { name: "addressLine1", label: t("builderRegistration.Address Line-1"), type: "text", colSize: 6 },
          { name: "addressLine2", label: t("builderRegistration.Address Line-2"), type: "text", colSize: 6 },
          { name: "pin", label: t("builderRegistration.PIN"), type: "text", colSize: 6 },
          { name: "district", label: t("builderRegistration.District"), type: "text", colSize: 6 },
          { name: "state", label: t("builderRegistration.State / UT"), type: "text", colSize: 6 },
          { name: "country", label: t("builderRegistration.Country"), type: "text", colSize: 6 },
        ],
        step2: [
          { name: "companyDetails", label: t("builderRegistration.Company Details"), type: "file", colSize: 6 },
          { name: "gstCertificate", label: t("builderRegistration.GST Certificate"), type: "file", colSize: 6 },
          { name: "panCardUpload", label: t("builderRegistration.PAN Card"), type: "file", colSize: 6 },
          { name: "factoryLicense", label: t("builderRegistration.Factory License"), type: "file", colSize: 6 },
          { name: "addressProof", label: t("builderRegistration.Address Proof"), type: "file", colSize: 6 },
          { name: "fireCertificate", label: t("builderRegistration.Fire Certificate"), type: "file", colSize: 6 },
          { name: "esipfRegistration", label: t("builderRegistration.ESIPF Registration"), type: "file", colSize: 6 },
          { name: "iso9001", label: t("builderRegistration.ISO 9001 Certificate"), type: "file", colSize: 6 },
          { name: "iso14001", label: t("builderRegistration.ISO 14001 Certificate"), type: "file", colSize: 6 },
          { name: "iso45001", label: t("builderRegistration.ISO 45001 Certificate"), type: "file", colSize: 6 },
          { name: "pollutionCertificate", label: t("builderRegistration.Pollution Certificate"), type: "file", colSize: 6 },
          { name: "experienceCertificate", label: t("builderRegistration.Experience Certificate"), type: "file", colSize: 6 },
        ]
      };
    }
  };

  const formFields = getFormFieldsConfig();

  const getDisabledFormFieldsConfig = () => {
    const config = {};
    Object.keys(formFields).forEach(stepKey => {
      config[stepKey] = formFields[stepKey].map(field => ({
        ...field,
        disabled: true,
        inputClassName: 'disabled-field'
      }));
    });
    return config;
  };

  const disabledFormFields = getDisabledFormFieldsConfig();

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return disabledFormFields.step1;
      case 2: return disabledFormFields.step2;
      case 3: return disabledFormFields.step3 || [];
      default: return [];
    }
  };

  const handleNext = () => {
    if (currentStep < totalSteps) {
      setCompletedSteps(prev => new Set([...prev, currentStep]));
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const handleBackToList = () => {
    navigate('/user-registration/view');
  };

  const getStatusBadge = (status) => {
    const statusMap = {
      'Pending Review': 'warning',
      'Pending': 'warning',
      'Approved': 'success',
      'Completed': 'success',
      'Rejected': 'danger',
      'Processing': 'info'
    };
    return <Badge bg={statusMap[status] || 'secondary'} className="status-badge">{status}</Badge>;
  };

  const getStepIcon = (stepNumber) => {
    if (completedSteps.has(stepNumber)) {
      return <FaCheckCircle className="text-white" size={18} />;
    }
    
    if (isOwner) {
      const ownerIcons = [FaUser, FaUser, FaFileUpload];
      return currentStep === stepNumber ? 
        React.createElement(ownerIcons[stepNumber - 1], { className: "text-white", size: 16 }) : 
        stepNumber;
    } else {
      const builderIcons = [FaBuilding, FaFileUpload];
      return currentStep === stepNumber ? 
        React.createElement(builderIcons[stepNumber - 1], { className: "text-white", size: 16 }) : 
        stepNumber;
    }
  };

  const getStepTitles = () => {
    if (isOwner) {
      return [
        t("vesselOwnerRegistration.Vessel Owner Details"),
        t("vesselOwnerRegistration.Authorized Person's Details"),
        t("vesselOwnerRegistration.Documents Upload")
      ];
    } else {
      return [
        t("builderRegistration.Vessel Builder Details"),
        t("builderRegistration.Documents Upload")
      ];
    }
  };

  const stepTitles = getStepTitles();

  if (isLoading) {
    return <NewLoader ref={loaderRef} />;
  }

  return (
    <Container fluid className="py-4 user-view-container">
      <Row className="justify-content-center">
        <Col xl={10} xxl={8}>
          <Card className="shadow border-0">
            <Card.Header className="app-detail-header">
              <div className="d-flex align-items-center justify-content-between">
                <Button variant="link" onClick={handleBackToList} className="back-btn">
                  <FaArrowAltCircleLeft className="me-2" />
                  Back to List
                </Button>
                
                <div className="d-flex align-items-center gap-4">
                  <div className="app-info-box">
                    <span className="app-label">Application Number:</span>
                    <span className="app-number">{formData.registrationNumber || 'N/A'}</span>
                  </div>
                  <div className="app-info-box">
                    <span className="app-label">Type:</span>
                    <span className="app-type">{isOwner ? 'Vessel Owner' : 'Vessel Builder'}</span>
                  </div>
                  {getStatusBadge(formData.status)}
                </div>
              </div>

              <Tabs
                activeKey={activeTab}
                onSelect={(k) => setActiveTab(k)}
                className="mt-3 user-type-tabs"
              >
                <Tab eventKey="owner" title={
                  <span>
                    <FaRegUser className="me-2" />
                    Vessel Owner
                  </span>
                } />
                <Tab eventKey="builder" title={
                  <span>
                    <FaRegBuilding className="me-2" />
                    Vessel Builder
                  </span>
                } />
              </Tabs>
            </Card.Header>

            <Card.Body className="p-4">
              <div className="stepper-container mb-5">
                {Array.from({ length: totalSteps }, (_, i) => i + 1).map((step, index) => (
                  <React.Fragment key={step}>
                    <div className={`stepper-step ${currentStep === step ? 'active' : ''} ${completedSteps.has(step) ? 'completed' : ''}`}>
                      <div className="step-circle">
                        {getStepIcon(step)}
                      </div>
                      <div className="step-label">{stepTitles[step - 1]}</div>
                    </div>
                    
                    {index < totalSteps - 1 && (
                      <div className="step-connector"></div>
                    )}
                  </React.Fragment>
                ))}
              </div>

              <FormProvider {...methods}>
                <form>
                  <div className="form-section">
                    <Row className="g-4">
                      <DynamicViewFields
                        fields={getCurrentStepFields()}
                        setFormData={setFormData}
                      />
                    </Row>
                  </div>

                  <div className="d-flex justify-content-between mt-5 pt-4 border-top">
                    {currentStep > 1 ? (
                      <Button
                        variant="outline-secondary"
                        onClick={handlePrevious}
                        className="action-btn prev-btn"
                      >
                        <FaArrowLeft className="me-2" /> Previous
                      </Button>
                    ) : (
                      <div></div> {/* Empty div to maintain space */}
                    )}
                    
                    {currentStep < totalSteps ? (
                      <Button
                        variant="primary"
                        onClick={handleNext}
                        className="action-btn next-btn"
                      >
                        Next <FaArrowRight className="ms-2" />
                      </Button>
                    ) : (
                      <ActionDropdown
                        actions={actionsFromAPI}
                        onActionClick={handleActionClick}
                        variant="success"
                        className="action-dropdown"
                      />
                    )}
                  </div>
                </form>
              </FormProvider>
            </Card.Body>
          </Card>
        </Col>
      </Row>

      <ApprovalModal
        show={showApprovalModal}
        handleClose={handleCloseModal}
        handleSubmitData={handleActionSubmit}
        selectedAction={selectedAction}
      />
    </Container>
  );
};

export default UserViewPage;
