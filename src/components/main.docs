import React, { useEffect, useMemo, useState } from "react";
import { Container, Row, Col, Spinner, Badge, Button } from "react-bootstrap";
import Collapsible from "./formCommon/Collapsible";
import PreviewCard from "../../private/Dashboard/PreviewCard";
import { FaDownload, FaUser, FaBuilding, FaFileAlt, FaMoneyBillWave, FaUniversity, FaSignature, FaIdCard, FaUsers } from "react-icons/fa";
import axios from "axios";
import "./ReviewStep.css";

const PreviewSection = ({ title, icon, fields }) => {
  if (!fields || Object.keys(fields).length === 0) return null;
  
  return (
    <div className="mb-4">
      <h5 className="section-title">
        {icon && <span className="section-icon">{icon}</span>}
        {title}
      </h5>
      <Container fluid>
        <Row className="g-3">
          {Object.entries(fields).map(([key, value]) => (
            <Col key={key} xs={12} sm={6} md={4} lg={3} className="mb-3">
              <PreviewCard title={key} value={value} />
            </Col>
          ))}
        </Row>
      </Container>
    </div>
  );
};

const ReviewStep = () => {
  const [previewResponse, setPreviewResponse] = useState(null);
  const [loading, setLoading] = useState(true);
  const [downloading, setDownloading] = useState({});

  // Load preview data from localStorage on mount
  useEffect(() => {
    const savedPreview = localStorage.getItem("previewResponse");
    console.log(savedPreview,"savedPreview");
    if (savedPreview) {
      try {
        const parsedPreview = JSON.parse(savedPreview);
        setPreviewResponse(parsedPreview);
      } catch (error) {
        console.error("Error parsing preview data:", error);
      }
    }
    setLoading(false);
  }, []);

  const handleDownload = async (fileId, fileName) => {
    try {
      setDownloading(prev => ({ ...prev, [fileId]: true }));
      
      const response = await axios.get(
        `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileId}`,
        { responseType: 'blob' }
      );

      const url = window.URL.createObjectURL(new Blob([response.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', fileName || 'document');
      document.body.appendChild(link);
      link.click();
      link.remove();
      
    } catch (error) {
      console.error('Error downloading file:', error);
      alert('Failed to download document');
    } finally {
      setDownloading(prev => ({ ...prev, [fileId]: false }));
    }
  };

  const formatFileInfo = (fileData) => {
    if (!fileData) return "No file uploaded";
    
    const fileName = fileData.docName || "File uploaded";
    const fileId = fileData.docId;
    
    return (
      <div className="d-flex align-items-center">
        <span className="me-2">{fileName}</span>
        <Button 
          variant="link" 
          size="sm" 
          className="p-0"
          onClick={() => handleDownload(fileId, fileName)}
          disabled={downloading[fileId]}
        >
          {downloading[fileId] ? (
            <Spinner animation="border" size="sm" />
          ) : (
            <FaDownload className="text-primary" />
          )}
        </Button>
      </div>
    );
  };

  const getEntityLabels = (claimType) => {
    switch (claimType) {
      case "PRINCIPAL_BORROWER":
        return {
          nameLabel: "Name of the guarantor",
          addressLabel: "Address of the guarantor",
          sectionTitle: "Guarantor Details"
        };
      case "GUARANTOR":
        return {
          nameLabel: "Name of the Principal Borrower",
          addressLabel: "Address of the Principal Borrower",
          sectionTitle: "Principal Borrower Details"
        };
      case "BENEFICIARY":
        return {
          nameLabel: "Name of the Beneficiary",
          addressLabel: "Address of the Beneficiary",
          sectionTitle: "Beneficiary Details"
        };
      default:
        return {
          nameLabel: "Name",
          addressLabel: "Address",
          sectionTitle: "Entity Details"
        };
    }
  };

  const formattedData = useMemo(() => {
    if (!previewResponse?.applicationDetails) return null;

    const appDetails = previewResponse.applicationDetails;
    const claimType = appDetails.claimDetails?.claimType;
    console.log(claimType,"claimType");
    const entityLabels = getEntityLabels(claimType);

    return {
      corporateDebtor: {
        "Corporate Debtor Name": previewResponse.userInfo?.corporateDebtorDetails?.nameOfCorporateDebtor || "N/A",
        "CIN/LLPIN Number": previewResponse.userInfo?.corporateDebtorDetails?.cinOrLlpinNumber || "N/A",
        "IP Name": previewResponse.userInfo?.corporateDebtorDetails?.nameOfIp || "N/A",
        "IP Registration No": previewResponse.userInfo?.corporateDebtorDetails?.registrationNo || "N/A"
      },
      
      creditorDetails: {
        "Financial Creditor Name": appDetails.creditorBasicDetails?.financialCreditorName,
        "Financial Creditor Email": appDetails.creditorBasicDetails?.financialCreditorEmail,
        "Identification Type": appDetails.creditorBasicDetails?.identificationTypeDetails?.identificationType === "INCORPORATED" 
          ? "Incorporated Body" 
          : "Partnership or Individual",
      },
      
      addressDetails: {
        "Address Line 1": appDetails.creditorBasicDetails?.addressDetails?.addressLine1,
        "Address Line 2": appDetails.creditorBasicDetails?.addressDetails?.addressLine2,
        "City": appDetails.creditorBasicDetails?.addressDetails?.city,
        "State": appDetails.creditorBasicDetails?.addressDetails?.state,
        "Pincode": appDetails.creditorBasicDetails?.addressDetails?.pincode
      },
      
      identificationDetails: {
        "Identification Records": appDetails.creditorBasicDetails?.identificationTypeDetails?.identifications?.map((detail, index) => (
          <div key={index} className="mb-2 identification-record">
            <div className="record-header">Record {index + 1}</div>
            <div><strong>Type:</strong> {detail.identificationRecord}</div>
            <div><strong>Proof:</strong> {formatFileInfo(detail.proofOfIdentificationDocuments)}</div>
          </div>
        )) || "N/A"
      },
      
      claimDetails: {
        "Claim Type": appDetails.claimDetails?.claimType?.replace(/_/g, ' ') || "N/A",
        "Claim Amount": appDetails.claimDetails?.claimAmount ? `₹${appDetails.claimDetails.claimAmount}` : "N/A",
        "Debt Details": appDetails.claimDetails?.debtIncurredDetails || "N/A",
        "Debt Date": appDetails.claimDetails?.debtIncurredDate || "N/A",
        "Has Security Interest": appDetails.claimDetails?.isAmountOfClaimCoverdBySecurityInterest ? "Yes" : "No",
        "Security Value": appDetails.claimDetails?.securityValue ? `₹${appDetails.claimDetails.securityValue}` : "N/A",
        "Security Date": appDetails.claimDetails?.securityDate || "N/A",
        "Has Guarantee": appDetails.claimDetails?.isAmountOfClaimCoverdByGuarantee ? "Yes" : "No",
        "Guarantee Value": appDetails.claimDetails?.guaranteeValue ? `₹${appDetails.claimDetails.guaranteeValue}` : "N/A",
        "Guarantee Date": appDetails.claimDetails?.guaranteeDate || "N/A",
        "Mutual Details": appDetails.claimDetails?.mutualDealingDetailsAgainstTheClaim || "N/A"
      },
      
      entityDetails: {
        [entityLabels.sectionTitle]: (() => {
          const entities = 
            claimType === "PRINCIPAL_BORROWER" ? appDetails.claimDetails?.guarantorDetails :
            claimType === "GUARANTOR" ? appDetails.claimDetails?.principalBorrowerDetails :
            appDetails.claimDetails?.beneficiaryDetails;

            
          
          return entities?.length > 0 ? (
            <div className="entity-records-container">
              {entities.map((entity, index) => (
                <div key={index} className="mb-2 identification-record">
                  <div className="record-header">{entityLabels.sectionTitle.replace(" Details", "")} {index + 1}</div>
                  <div><strong>{entityLabels.nameLabel}:</strong> {entity.name}</div>
                  <div><strong>{entityLabels.addressLabel}:</strong> {entity.address}</div>
                </div>
              ))}
            </div>
          ) : `No ${entityLabels.sectionTitle.toLowerCase()} found`;
        })()
      },
      
      bankDetails: {
        "Account Number": appDetails.claimDetails?.bankAccountDetails?.bankAccountNumber,
        "IFSC Code": appDetails.claimDetails?.bankAccountDetails?.bankIfscCode,
        "Bank Name": appDetails.claimDetails?.bankAccountDetails?.bankName,
        "Branch Name": appDetails.claimDetails?.bankAccountDetails?.bankBranchName,
        "Branch Address": appDetails.claimDetails?.bankAccountDetails?.branchAddress,
        "City": appDetails.claimDetails?.bankAccountDetails?.city,
        "State": appDetails.claimDetails?.bankAccountDetails?.state,
        "District": appDetails.claimDetails?.bankAccountDetails?.district
      },
      
      signatoryDetails: {
        "Creditor Name": appDetails.signatoryDetails?.financialCreditorName,
        "Creditor Position": appDetails.signatoryDetails?.positionOfCreditor,
        "Creditor Address": appDetails.signatoryDetails?.addressOfSigningPerson,
        "Has Signature": appDetails.signatoryDetails?.isSignatureToUpload ? "Yes" : "No",
        "Signature": formatFileInfo(appDetails.signatoryDetails?.document)
      },
      
      documentDetails: {
        "Identity Proof": appDetails.supportingDocument?.documents?.find(d => d.docSource === "identity_proof") 
          ? formatFileInfo(appDetails.supportingDocument.documents.find(d => d.docSource === "identity_proof"))
          : "N/A",
        "Address Proof": appDetails.supportingDocument?.documents?.find(d => d.docSource === "address_proof") 
          ? formatFileInfo(appDetails.supportingDocument.documents.find(d => d.docSource === "address_proof"))
          : "N/A"
      }
    };
  }, [previewResponse, downloading]);

  if (loading) {
    return (
      <div className="d-flex justify-content-center align-items-center" style={{ height: "100vh" }}>
        <Spinner animation="border" />
      </div>
    );
  }

  if (!previewResponse) {
    return (
      <div className="alert alert-info">
        No preview data available to display
      </div>
    );
  }

  return (
    <div className="form-stepper review-step">
      <div className="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
        <div>
          <span className="text-muted small">Application Number:</span>
          <span className="ms-2 fw-bold">{previewResponse.applicationDetails?.applicationNumber || "N/A"}</span>
        </div>
        <Badge bg="warning" className="text-dark">
          {previewResponse.applicationDetails?.status || "Draft"} Preview
        </Badge>
      </div>

      <Collapsible title="Corporate Debtor & Creditor Details">
        <PreviewSection 
          title="Corporate Debtor Details" 
          icon={<FaBuilding />} 
          fields={formattedData.corporateDebtor} 
        />
        <PreviewSection 
          title="Financial Creditor Details" 
          icon={<FaUser />} 
          fields={formattedData.creditorDetails} 
        />
        <PreviewSection 
          title="Address Details" 
          icon={<FaBuilding />} 
          fields={formattedData.addressDetails} 
        />
        <PreviewSection 
          title="Identification Details" 
          icon={<FaIdCard />} 
          fields={formattedData.identificationDetails} 
        />
      </Collapsible>

      <Collapsible title="Claim & Financial Details">
        <PreviewSection 
          title="Claim Details" 
          icon={<FaFileAlt />} 
          fields={formattedData.claimDetails} 
        />
        <PreviewSection 
          title={getEntityLabels(previewResponse.applicationDetails?.claimDetails?.claimType).sectionTitle}
          icon={<FaUsers />} 
          fields={formattedData.entityDetails} 
        />
        <PreviewSection 
          title="Bank Details" 
          icon={<FaUniversity />} 
          fields={formattedData.bankDetails} 
        />
      </Collapsible>

      <Collapsible title="Signatory Details">
        <PreviewSection 
          title="Signatory Information" 
          icon={<FaSignature />} 
          fields={formattedData.signatoryDetails} 
        />
      </Collapsible>

      <Collapsible title="Document Verification">
        <PreviewSection 
          title="Document Details" 
          icon={<FaFileAlt />} 
          fields={formattedData.documentDetails} 
        />
      </Collapsible>
    </div>
  );
};

export default React.memo(ReviewStep);

import React, { useState, useEffect, useRef } from "react";
import { 
  ArrowUp, 
  FileEarmarkText, 
  Clock, 
  CheckCircle, 
  PersonCheck
} from 'react-bootstrap-icons';
import { Container, ProgressBar, Row, Card, Col, Button, Modal, Form, InputGroup } from "react-bootstrap";
import { 
  FaChartLine, 
  FaClipboardList, 
  FaFileAlt, 
  FaUserCircle, 
  FaSearch, 
  FaFilter, 
  FaEllipsisV,
  FaCheckCircle,
  FaClock,
  FaTimesCircle,
  FaFileInvoice,
  FaPlus,
  FaChevronUp,
  FaChevronDown,
  FaBell,
  FaCalendarAlt,
  FaArrowUp,
  FaArrowDown,
  FaTrashAlt,
  FaSortAmountDown,
  FaSortAmountUp,
  FaEye
} from "react-icons/fa";
import "./DashboardMain.css";
import ActionTable from "./ActionTable.js";
import { useNavigate, useLocation } from "react-router-dom";
import axios from "axios";
import { toast } from "react-toastify";
import { APP_MESSAGES } from "../../../utils/constants.ts";
import { URLS_ENDPOINT } from "../../../utils/urlsConstants.ts";
import { postData } from "../../../services/http.service.ts";
import ApplicationDetailsView from "./ApplicationDetailsView.jsx";
import TrackingModal from "./TrackingModal.jsx";
import { useSearch } from "../Navbar";

// Add custom color scheme
const customColors = {
  blue: "#009cff",
  green: "#1bbc85",
  orange: "#ff7a03",
  yellow: "#d4cd18"
};

// Add custom CSS to document head
const injectCustomStyles = () => {
  const styleElement = document.createElement('style');
  styleElement.textContent = `
    /* Custom card colors */
    .stat-card-modern.stat-card-blue {
      background-color: ${customColors.blue};
    }
    .stat-card-modern.stat-card-orange {
      background-color: ${customColors.orange};
    }
    .stat-card-modern.stat-card-green {
      background-color: ${customColors.green};
    }
    .stat-card-modern.stat-card-yellow {
      background-color: ${customColors.yellow};
    }
    
    /* Table Row Styles */
    .table tbody tr:nth-child(even) {
      background-color: rgba(27, 188, 133, 0.05) !important;
    }
    
    .table tbody tr:nth-child(odd) {
      background-color: rgba(255, 204, 51, 0.05) !important;
    }
    
    /* Table Header Styles */
    .table-primary th {
      background-color: ${customColors.blue} !important;
      color: white !important;
      border-color: ${customColors.blue} !important;
    }
    
    /* Button Styles */
    .btn-primary {
      background-color: ${customColors.blue} !important;
      border-color: ${customColors.blue} !important;
    }
    
    .btn-outline-primary {
      color: ${customColors.blue} !important;
      border-color: ${customColors.blue} !important;
    }
    
    .btn-outline-primary:hover {
      background-color: ${customColors.blue} !important;
      color: white !important;
    }
  `;
  document.head.appendChild(styleElement);
  return styleElement;
};

const EnhancedDashboard = () => {
  const [isLoading, setIsLoading] = useState(true);
  const [rowData, setRowData] = useState([]);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [modalData, setModalData] = useState({});
  const [fullModelData, setFullModelData] = useState({});
  const [isTrackModalOpen, setIsTrackModalOpen] = useState(false);
  const [trackData, setTrackData] = useState({});
  const [downloading, setDownloading] = useState({});
  const [userName, setUserName] = useState('');
  const [userType, setUserType] = useState('');
  const [searchQuery, setSearchQuery] = useState('');
  const [statusFilter, setStatusFilter] = useState('all');
  const [dateSort, setDateSort] = useState('none');
  const [filteredData, setFilteredData] = useState([]);
  const navigate = useNavigate();
  const location = useLocation();
  
  // Ref for claims table section
  const claimsTableRef = useRef(null);

  // Inject custom styles
  useEffect(() => {
    const styleElement = injectCustomStyles();
    return () => {
      document.head.removeChild(styleElement);
    };
  }, []);

  // Function to scroll to claims table
  const scrollToClaimsTable = () => {
    if (claimsTableRef.current) {
      claimsTableRef.current.scrollIntoView({ 
        behavior: 'smooth',
        block: 'start'
      });
    }
  };

  // Get current date for greeting
  const getCurrentGreeting = () => {
    const hour = new Date().getHours();
    if (hour < 12) return "Good Morning";
    if (hour < 18) return "Good Afternoon";
    return "Good Evening";
  };

  // Updated stats data with new colors
  const statsData = [
    { 
      id: 1, 
      title: "Total Claims", 
      value: 24, 
      icon: <FileEarmarkText size={24} />, 
      color: customColors.blue,
      trend: "+12%",
      trendUp: true,
      className: "stat-card-blue"
    },
    { 
      id: 2, 
      title: "Pending Review", 
      value: 8, 
      icon: <Clock size={24} />, 
      color: customColors.orange,
      trend: "+3%",
      trendUp: true,
      className: "stat-card-orange"
    },
    { 
      id: 3, 
      title: "Approved", 
      value: 12, 
      icon: <CheckCircle size={24} />, 
      color: customColors.green,
      trend: "+8%",
      trendUp: true,
      className: "stat-card-green"
    },
    { 
      id: 4, 
      title: "Profile Completion", 
      value: "85%", 
      icon: <PersonCheck size={24} />, 
      color: customColors.yellow,
      trend: "+5%",
      trendUp: true,
      className: "stat-card-yellow",
      // showProgress: true
    }
  ];

  // Table columns configuration
  const columns = [
    {
      colName: "SL NO",
      fieldName: "slNo",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "SL NO",
      minWidth: "5rem",
    },
    {
      colName: "Claim Number",
      fieldName: "claimNumber",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Claim Number",
      minWidth: "10rem",
    },
    {
      colName: "Claimant",
      fieldName: "claimant",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Claimant",
      minWidth: "10rem",
    },
    {
      colName: "Status",
      fieldName: "status",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Status",
      minWidth: "10rem",
    },
    {
      colName: "Amount",
      fieldName: "amount",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Amount",
      minWidth: "10rem",
    },
    {
      colName: "Date Submitted",
      fieldName: "dateSubmitted",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Date Submitted",
      minWidth: "10rem",
    },
    {
      colName: "Action",
      fieldName: "action",
      actions: ["view", "edit", "track", "delete"],
      clsName: "col-sm-2 column-text-start actions-column",
    },
  ];

  useEffect(() => {
    // Get user data from localStorage
    try {
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;
      
      // Set user type
      if (userFormData?.userType) {
        setUserType(userFormData.userType);
      }
      
      // Set user name
      if (userInfo?.name) {
        setUserName(userInfo.name);
      } else if (userFormData?.userDetails?.claimantName) {
        setUserName(userFormData.userDetails.claimantName);
      } else if (userFormData?.userDetails?.companyName) {
        setUserName(userFormData.userDetails.companyName);
      }
    } catch (error) {
      console.error("Error getting user info:", error);
    }

    // Fetch dashboard data
    fetchDashboardData();
  }, []);

  // Listen for search query changes from URL or navbar
  useEffect(() => {
    // Check URL for search parameter
    const params = new URLSearchParams(location.search);
    const searchParam = params.get('search');
    
    if (searchParam) {
      setSearchQuery(searchParam);
      // Scroll to claims table when search is performed
      setTimeout(() => {
        scrollToClaimsTable();
      }, 500);
    }
    
    // Listen for search events from navbar
    const handleSearchEvent = (event) => {
      if (event.detail && event.detail.searchQuery !== undefined) {
        setSearchQuery(event.detail.searchQuery);
        // Scroll to claims table when search is performed
        setTimeout(() => {
          scrollToClaimsTable();
        }, 500);
      }
    };
    
    window.addEventListener('searchQueryChange', handleSearchEvent);
    
    // Check sessionStorage for search query (for persistence)
    const storedQuery = sessionStorage.getItem('searchQuery');
    if (storedQuery && !searchParam) {
      setSearchQuery(storedQuery);
    }
    
    return () => {
      window.removeEventListener('searchQueryChange', handleSearchEvent);
    };
  }, [location.search]);

  // Check if user is CRP (Corporate Representative)
  const isCRP = userType === "CRP";

  // Quick actions data - Conditional based on user type
  const getQuickActions = () => {
    if (isCRP) {
      // For CRP users - no new claim option
      return [
        {
          id: 1,
          title: "View Claims",
          description: "Review submitted claims",
          icon: <FaEye />,
          action: scrollToClaimsTable // Scroll to claims table instead of navigating
        },
        {
          id: 2,
          title: "Update Profile",
          description: "Edit your account information",
          icon: <FaUserCircle />,
          action: () => navigate("/my-profile")
        }
      ];
    } else {
      // For CLM users - with new claim option
      return [
        {
          id: 1,
          title: "New Claim",
          description: "Submit a new claim application",
          icon: <FaPlus />,
          action: () => navigate("/apply-claim")
        },
        {
          id: 2,
          title: "Update Profile",
          description: "Edit your account information",
          icon: <FaUserCircle />,
          action: () => navigate("/my-profile")
        }
      ];
    }
  };

  // Filter and search data
  useEffect(() => {
    if (rowData.length > 0) {
      let filtered = [...rowData];
      
      // Apply status filter
      if (statusFilter !== 'all') {
        filtered = filtered.filter(item => item.status === statusFilter);
      }
      
      // Apply search query
      if (searchQuery.trim() !== '') {
        const query = searchQuery.toLowerCase();
        filtered = filtered.filter(item => {
          return (
            (item.claimNumber && item.claimNumber.toLowerCase().includes(query)) ||
            (item.claimant && item.claimant.toLowerCase().includes(query)) ||
            (item.status && item.status.toLowerCase().includes(query))
          );
        });
        
        // If we have search results and they're from a navbar search, scroll to the table
        if (filtered.length > 0) {
          setTimeout(() => {
            scrollToClaimsTable();
          }, 500);
        }
      }
      
      // Apply date sorting
      if (dateSort !== 'none') {
        filtered.sort((a, b) => {
          const dateA = new Date(a.dateSubmitted);
          const dateB = new Date(b.dateSubmitted);
          return dateSort === 'asc' ? dateA - dateB : dateB - dateA;
        });
      }
      
      setFilteredData(filtered);
    } else {
      setFilteredData([]);
    }
  }, [rowData, statusFilter, searchQuery, dateSort]);

  const handleDownload = async (fileId, fileName) => {
    try {
      setDownloading(prev => ({ ...prev, [fileId]: true }));
      
      const response = await axios.get(
        `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileId}`,
      );
  
      // Create download link
      const url = window.URL.createObjectURL(new Blob([response.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', fileName || 'document');
      document.body.appendChild(link);
      link.click();
      link.remove();
      
    } catch (error) {
      console.error('Error downloading file:', error);
      toast.error('Failed to download document', { position: "top-right" });
    } finally {
      setDownloading(prev => ({ ...prev, [fileId]: false }));
    }
  };

  const handleEditRow = (row) => {
    console.log("Edit row:", row.uuid);
    if (row?.uuid) {
      navigate(`/apply-claim/edit/${row.uuid}`);
    } else {
      console.error("UUID not found in the row object.");
      toast.warning("No UUID Available..", { position: "top-right" });
    }
  };

  const handleDeleteRow = (row) => {
    console.log("Delete row:", row.uuid);
    // Implement delete functionality here
    toast.warning("Delete functionality will be implemented soon", { position: "top-right" });
  };

  const formatFileInfo = (document) => {
    if (!document) return "N/A";
    return `${document.docType || 'Document'} (${document.docName || 'No name'})`;
  };

  const transformApplicationData = (application) => {
    console.log("Transforming application data...", application);
    if (!application) return null;
  
    const basicDetails = application.creditorBasicDetails || {};
    const claimDetails = application.claimDetails || {};
    const signatoryDetails = application.signatoryDetails || {};
    const supportingDocuments = application.supportingDocument || {};
    const identificationDetails = basicDetails.identificationTypeDetails || {};
  
    // Helper function to format documents
    const formatDocumentInfo = (doc) => {
      if (!doc) return "N/A";
      return `${doc.docType || 'Document'} (${doc.docName || 'No name'})`;
    };
  
    // Get identification records
    const identifications = identificationDetails.identifications || [];
    const identificationInfo = identifications.length > 0 
      ? `${identificationDetails.identificationType || ''}: ${identifications.map(id => id.identificationRecord).join(', ')}`
      : "N/A";
  
   // Get guarantor details
  const guarantors = claimDetails.guarantorDetails || [];
  const guarantorInfo = guarantors.length > 0
    ? guarantors.map(g => `${g.name} (${g.address})`).join(', ')
    : "N/A";

  // Get principal borrower details
  const principalBorrowers = claimDetails.principalBorrowerDetails || [];
  const principalBorrowerInfo = principalBorrowers.length > 0
    ? principalBorrowers.map(pb => `${pb.name} (${pb.address})`).join(', ')
    : "N/A";

  // Get beneficiary details
  const beneficiaries = claimDetails.beneficiaryDetails || [];
  const beneficiaryInfo = beneficiaries.length > 0
    ? beneficiaries.map(b => `${b.name} (${b.address})`).join(', ')
    : "N/A";
  
    // Get supporting docs
    const supportingDocs = supportingDocuments.documents || [];
    const supportingDocsInfo = supportingDocs.length > 0
      ? supportingDocs.map(doc => formatDocumentInfo(doc)).join(', ')
      : "N/A";
  
    return {
      applicationNumber: application.applicationNumber,
      step1: {
        creditorDetails: {
          "Debtor Name": basicDetails.financialDebtorName || "N/A",
          "Creditor Name": basicDetails.financialCreditorName || "N/A",
          "Creditor Email": basicDetails.financialCreditorEmail || "N/A",
          "Address": `${basicDetails.addressDetails?.addressLine1 || ''}, ${basicDetails.addressDetails?.addressLine2 || ''}, ${basicDetails.addressDetails?.city || ''}, ${basicDetails.addressDetails?.state || ''} - ${basicDetails.addressDetails?.pincode || ''}`,
        },
        identificationDetails: {
          "Identification Type": identificationDetails.identificationType || "N/A",
          "Identification Records": identificationInfo,
          "Proof Documents": identifications.length > 0 
            ? identifications.map(id => formatDocumentInfo(id.proofOfIdentificationDocuments)).join(', ')
            : "N/A"
        },
      },
      step2: {
        claimDetails: {
          "Claim Type": claimDetails.claimType || "N/A",
          "Claim Amount": claimDetails.claimAmount || "0",
          "Covered by Security Interest": claimDetails.isAmountOfClaimCoverdBySecurityInterest ? "Yes" : "No",
          "Security Value": claimDetails.securityValue || "0",
          "Security Date": claimDetails.securityDate || "N/A",
          "Covered by Guarantee": claimDetails.isAmountOfClaimCoverdByGuarantee ? "Yes" : "No",
          "Guarantee Value": claimDetails.guaranteeValue || "0",
          "Guarantee Date": claimDetails.guaranteeDate || "N/A",
          "Guarantor Details": guarantorInfo,
        "Principal Borrower Details": principalBorrowerInfo,
        "Beneficiary Details": beneficiaryInfo,
          "Debt Incurred Details": claimDetails.debtIncurredDetails || "N/A",
          "Debt Incurred Date": claimDetails.debtIncurredDate || "N/A",
          "Mutual Dealing Details": claimDetails.mutualDealingDetailsAgainstTheClaim || "N/A",
        },
        bankDetails: {
          "Account Number": claimDetails.bankAccountDetails?.bankAccountNumber || "N/A",
          "IFSC Code": claimDetails.bankAccountDetails?.bankIfscCode || "N/A",
          "Bank Name": claimDetails.bankAccountDetails?.bankName || "N/A",
          "Branch Name": claimDetails.bankAccountDetails?.bankBranchName || "N/A",
          "Branch Address": claimDetails.bankAccountDetails?.branchAddress || "N/A",
        },
        supportingDocuments: {
          "Documents Submitted": supportingDocsInfo
        }
      },
      step3: {
        signatoryDetails: {
          "Signatory Name": signatoryDetails.financialCreditorName || "N/A",
          "Signatory Position": signatoryDetails.positionOfCreditor || "N/A",
          "Signature": signatoryDetails.signatureFinancialCreditor || "N/A",
          "Signatory Address": signatoryDetails.addressOfSigningPerson || "N/A",
          "Signature Document": formatDocumentInfo(signatoryDetails.document),
        },
      },
      status: application.status || "N/A",
    };
  };

 

  const handleOnViewRow = async (row) => {
    try {
      setIsLoading(true);
      
      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;
      
      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }
  
      const payload = {
        userInfo: userInfo,
        uuids: [row.uuid],
        applicationNumbers: [],
        claimantUUIDs: []
      };
  
      const URL =
        process.env.REACT_APP_APPLICATION_SERVICE +
        URLS_ENDPOINT.APP_SERVICES.APPLICATION_VIEW_ID;
  
      const response = await postData(URL, payload);
      
      if (response?.data?.status?.code === "200" && response?.data?.applicationDetails?.length > 0) {
        const transformedData = transformApplicationData(response.data.applicationDetails[0]);
        setFullModelData(response.data.applicationDetails[0])
        setModalData(transformedData);
        setIsViewModalOpen(true);
      } else {
        toast.error("No application details found", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching application details:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
    } finally {
      setIsLoading(false);
    }
  };

  const getStatusDescription = (stage) => {
    if (stage.submittedBy === "CLAIMANT" && stage.submittedTo === "RP") {
      return `Submitted by claimant ${stage.submittedByName} to RP ${stage.submittedToName}`;
    } else if (stage.submittedBy === "RP" && stage.submittedTo === "CLAIMANT") {
      return `Sent back by RP ${stage.submittedByName} to claimant ${stage.submittedToName}`;
    } else if (stage.submittedBy === "RP" && !stage.submittedTo) {
      return `Final decision by RP ${stage.submittedByName}: ${stage.applicationStatus}`;
    }
    return stage.applicationStatus;
  };

  const handleTrackRow = async (row) => {
    try {
      setIsLoading(true);
      
      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;
      
      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }
  
      const payload = {
        userInfo: userInfo,
        trackingCriteria: {
          applicationNumber: row.claimNumber
        }
      };
  
      const URL = `${process.env.REACT_APP_APPLICATION_SERVICE}_tracking/_getApplicationTrackingDetails`;
      
      const response = await postData(URL, payload);
      
      if (response?.data.status === "200") {
        setTrackData({
          applicationNumber: response.data.applicationNumber,
          trackingSteps: response.data.applicationStages.map(stage => ({
            step: stage.applicationStatus,
            description: getStatusDescription(stage),
            date: stage.submittedDate,
            isCurrentStatus: stage.isCurrentStatus,
            submittedBy: stage.submittedByName,
            submittedTo: stage.submittedToName,
            comments: stage.comments
          }))
        });
        setIsTrackModalOpen(true);
      } else {
        toast.error("Failed to fetch tracking details", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching tracking details:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
    } finally {
      setIsLoading(false);
    }
  };

  const fetchDashboardData = async () => {
    try {
      setIsLoading(true);
      
      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;
      
      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }

      const payload = {
        userInfo: userInfo,
        filterCriteria: {}
      };

      const URL =
          process.env.REACT_APP_APPLICATION_SERVICE +
          URLS_ENDPOINT.APP_SERVICES.DASHBOARD_LIST;

      const response = await postData(URL, payload);
      
      if (response?.data.status === "200" && response?.data.dashboardApplications?.length > 0) {
        // Format the data to match your table structure
        const formattedData = response.data.dashboardApplications.map((item, index) => ({
          ...item,
          id: item.uuid, 
          slNo: index + 1,
          claimNumber: item.applicationNumber,
          claimant: item.creditorName,
          status: item.applicationStatus,
          amount: `${item.totalClaimAmount}` || "0.00",
          dateSubmitted: item.submittedDate || new Date().toLocaleDateString(),
          // For CRP users, only show view and track actions
          action: isCRP ? ["view", "track"] : ["view", "edit", "track", "delete"],
          originalData: item, 
        }));
             
        setRowData(formattedData);
        setFilteredData(formattedData);
      } else {
        setRowData([]);
        setFilteredData([]);
        toast.info("No applications found", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching dashboard data:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setRowData([]);
      setFilteredData([]);
    } finally {
      setIsLoading(false);
    }
  };

  // Handle local search in dashboard
  const handleSearchChange = (e) => {
    setSearchQuery(e.target.value);
    
    // Update URL with search parameter
    const newUrl = `/dashboard?search=${encodeURIComponent(e.target.value)}`;
    window.history.pushState({ path: newUrl }, '', newUrl);
    
    // Store in sessionStorage for persistence
    sessionStorage.setItem('searchQuery', e.target.value);
  };

  // Get the appropriate quick actions based on user type
  const quickActions = getQuickActions();

  // Get the appropriate dashboard title based on user type
  const getDashboardTitle = () => {
    return isCRP ? "Claims Management Dashboard" : "My Claims Dashboard";
  };

  // Get search result message
  const getSearchResultMessage = () => {
    if (searchQuery && filteredData.length === 0) {
      return `No results found for "${searchQuery}"`;
    } else if (searchQuery && filteredData.length > 0) {
      return `Found ${filteredData.length} result${filteredData.length === 1 ? '' : 's'} for "${searchQuery}"`;
    }
    return null;
  };

  return (
    <div className="dashboard-main-container" style={{ marginTop: '70px', marginLeft: '70px', width: 'calc(100% - 70px)', padding: '20px' }}>
      {!isLoading ? (
        <Container fluid className="p-0">
          {/* Dashboard Header */}
          <div className="dashboard-header-section">
            <h1 className="dashboard-welcome">{getCurrentGreeting()}, {userName || 'User'}!</h1>
            <p className="dashboard-subtitle">{getDashboardTitle()}</p>
          </div>

          {/* Stats Cards */}
          <div className="stats-cards-container">
            {statsData.map((stat) => (
              <div key={stat.id} className={`stat-card-modern ${stat.className}`}>
                <div className="stat-card-header">
                  <div className="stat-card-title">{stat.title}</div>
                  <div className="stat-card-icon">
                    {stat.icon}
                  </div>
                </div>
                <div className="stat-card-value">{stat.value}</div>
                <div className={`stat-card-trend ${stat.trendUp ? 'trend-up' : 'trend-down'}`}>
                  {stat.trendUp ? <FaArrowUp className="trend-icon" /> : <FaArrowDown className="trend-icon" />}
                  {stat.trend} from last month
                </div>
                {stat.showProgress && (
                  <ProgressBar 
                    now={parseInt(stat.value)} 
                    style={{ 
                      height: '8px', 
                      borderRadius: '4px', 
                      backgroundColor: 'rgba(255, 255, 255, 0.3)', 
                      marginTop: '10px' 
                    }}
                  >
                    <ProgressBar 
                      now={parseInt(stat.value)} 
                      style={{ backgroundColor: 'white' }} 
                    />
                  </ProgressBar>
                )}
                <div className="stat-card-bg">
                  {stat.icon}
                </div>
              </div>
            ))}
          </div>

          {/* Quick Actions Section */}
          <div className="dashboard-section">
            <div className="section-header">
              <h2 className="section-title">
                <FaFileInvoice className="section-title-icon" />
                Quick Actions
              </h2>
            </div>
            <div className="section-body">
              <div className="quick-actions-grid">
                {quickActions.map(action => (
                  <div key={action.id} className="quick-action-card" onClick={action.action}>
                    <div className="quick-action-icon">
                      {action.icon}
                    </div>
                    <h3 className="quick-action-title">{action.title}</h3>
                    <p className="quick-action-desc">{action.description}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* Claims Table Section - Added ref for scrolling */}
          <div className="dashboard-section" ref={claimsTableRef} id="claims-table-section">
            <div className="section-header">
              <h2 className="section-title">
                <FaClipboardList className="section-title-icon" />
                {isCRP ? "Claims List" : "Recent Claims"}
              </h2>
              
              {/* Dashboard search bar */}
              <div className="dashboard-search-container">
                <InputGroup className="dashboard-search">
                  <InputGroup.Text>
                    <FaSearch />
                  </InputGroup.Text>
                  <Form.Control
                    placeholder="Search claims by number, claimant, or status..."
                    value={searchQuery}
                    onChange={handleSearchChange}
                  />
                  {searchQuery && (
                    <Button 
                      variant="outline-secondary" 
                      onClick={() => {
                        setSearchQuery('');
                        sessionStorage.removeItem('searchQuery');
                        window.history.pushState({ path: '/dashboard' }, '', '/dashboard');
                      }}
                    >
                      Clear
                    </Button>
                  )}
                </InputGroup>
              </div>
            </div>
            
            {/* Search results message */}
            {getSearchResultMessage() && (
              <div className="search-results-message">
                {getSearchResultMessage()}
              </div>
            )}
            
            <div className="section-body">
              <ActionTable
                columns={columns}
                rowData={filteredData}
                hideExportBtn={false}
                onViewRow={handleOnViewRow}
                handleEditRow={handleEditRow}
                onTrackRow={handleTrackRow}
                onDeleteRow={handleDeleteRow}
              />
            </div>
          </div>

          {/* Application Details Modal */}
          <ApplicationDetailsView
            show={isViewModalOpen}
            onHide={() => setIsViewModalOpen(false)}
            modalData={modalData}
            fullModelData={fullModelData}
            handleDownload={handleDownload}
          />

          {/* Tracking Modal */}
          <TrackingModal 
            show={isTrackModalOpen} 
            onHide={() => setIsTrackModalOpen(false)} 
            trackData={trackData} 
          />
        </Container>
      ) : (
        <div className="loader-container">
          <div className="loader"></div>
          <div className="loader-message">Loading your dashboard...</div>
        </div>
      )}
    </div>
  );
};

export default EnhancedDashboard;
