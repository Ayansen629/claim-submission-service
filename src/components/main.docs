    const handleWorkflowAction = async (action, comments) => {
      try {
        const userFormData = JSON.parse(localStorage.getItem("userFormData"));
        const applicationNumber = JSON.parse(localStorage.getItem("applicationdatawithId"));
        console.log("handleWorkflowAction", action, comments);
