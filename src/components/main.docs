import React from "react";
import { Row, Col, Form } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile";
import InputText from "../../../common/InputText.tsx";

const Documents = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const {
    register,
    watch,
    setValue,
    clearErrors,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");
  const [fileStates, setFileStates] = React.useState({
    tonnageBooklets: null,
    stabilityBooklets: null,
    authLetter: null,
    workOrderFiles: [],
    drawingsFiles: []
  });

  // Update file states when form values change
  React.useEffect(() => {
    const subscription = watch((value, { name }) => {
      if (name && name.includes("Files")) {
        setFileStates(prev => ({
          ...prev,
          [name]: value[name] || []
        }));
      } else if (name && (name === "tonnageBooklets" || name === "stabilityBooklets" || name === "authLetter")) {
        setFileStates(prev => ({
          ...prev,
          [name]: value[name]
        }));
      }
    });
    return () => subscription.unsubscribe();
  }, [watch]);

  const handleFileAdd = (fieldName) => {
    const currentFiles = watch(fieldName) || [];
    setValue(fieldName, [...currentFiles, null]);
  };

  const handleFileRemove = (fieldName, index) => {
    const currentFiles = watch(fieldName) || [];
    const newFiles = currentFiles.filter((_, i) => i !== index);
    setValue(fieldName, newFiles.length ? newFiles : null);
    clearErrors(`${fieldName}_${index}`);
  };

  const handleFileChange = (fieldName, index, e) => {
    const currentFiles = watch(fieldName) || [];
    const newFiles = [...currentFiles];
    const file = e.target.files?.[0];
    
    if (file) {
      // Validate file type
      const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
      if (!validTypes.includes(file.type)) {
        setValue(fieldName, null);
        setError(fieldName, {
          type: 'manual',
          message: 'Only PDF, JPG or PNG files are allowed'
        });
        return;
      }

      // Validate file size
      if (file.size > 2 * 1024 * 1024) {
        setValue(fieldName, null);
        setError(fieldName, {
          type: 'manual',
          message: 'File size should not exceed 2MB'
        });
        return;
      }

      newFiles[index] = file;
      setValue(fieldName, newFiles);
      clearErrors(`${fieldName}_${index}`);
    }
  };

  const handleSingleFileChange = (fieldName, e) => {
    const file = e.target.files?.[0];
    
    if (file) {
      // Validate file type
      const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
      if (!validTypes.includes(file.type)) {
        setValue(fieldName, null);
        setError(fieldName, {
          type: 'manual',
          message: 'Only PDF, JPG or PNG files are allowed'
        });
        return;
      }

      // Validate file size
      if (file.size > 2 * 1024 * 1024) {
        setValue(fieldName, null);
        setError(fieldName, {
          type: 'manual',
          message: 'File size should not exceed 2MB'
        });
        return;
      }

      setValue(fieldName, file);
      clearErrors(fieldName);
    }
  };

  return (
    <div>
      {/* Documents Collapsible */}
      <Collapsible title={t("Documents")} openStat={true}>
        <Row className="gy-4">
          {/* Work Order Section */}
          <Col md={6}>
            <Form.Group>
              <Form.Label className="fw-bold">{t("Work Order")}</Form.Label>
              {(fileStates.workOrderFiles.length === 0 ? [null] : fileStates.workOrderFiles).map((file, index) => (
                <div key={index} className="mb-3">
                  <div className="d-flex align-items-center gap-2">
                    <InputFile
                      label=""
                      name={`workOrderFiles_${index}`}
                      register={register(`workOrderFiles_${index}`)}
                      errors={errors}
                      value={file}
                      onChange={(e) => handleFileChange("workOrderFiles", index, e)}
                      disabled={viewMode}
                      className="flex-grow-1"
                    />
                    {index === fileStates.workOrderFiles.length - 1 && !viewMode && (
                      <button
                        type="button"
                        className="btn btn-sm btn-outline-primary"
                        onClick={() => handleFileAdd("workOrderFiles")}
                      >
                        +
                      </button>
                    )}
                    {fileStates.workOrderFiles.length > 1 && !viewMode && (
                      <button
                        type="button"
                        className="btn btn-sm btn-outline-danger"
                        onClick={() => handleFileRemove("workOrderFiles", index)}
                      >
                        -
                      </button>
                    )}
                  </div>
                  <InputText
                    label=""
                    name={`workOrder_desc_${index}`}
                    placeholder={t("Description of File")}
                    register={register(`workOrder_desc_${index}`)}
                    errors={errors}
                    disabled={viewMode}
                    className="mt-2"
                  />
                </div>
              ))}
            </Form.Group>
          </Col>

          {/* Drawings Section */}
          <Col md={6}>
            <Form.Group>
              <Form.Label className="fw-bold">{t("Drawings")}</Form.Label>
              {(fileStates.drawingsFiles.length === 0 ? [null] : fileStates.drawingsFiles).map((file, index) => (
                <div key={index} className="mb-3">
                  <div className="d-flex align-items-center gap-2">
                    <InputFile
                      label=""
                      name={`drawingsFiles_${index}`}
                      register={register(`drawingsFiles_${index}`)}
                      errors={errors}
                      value={file}
                      onChange={(e) => handleFileChange("drawingsFiles", index, e)}
                      disabled={viewMode}
                      className="flex-grow-1"
                    />
                    {index === fileStates.drawingsFiles.length - 1 && !viewMode && (
                      <button
                        type="button"
                        className="btn btn-sm btn-outline-primary"
                        onClick={() => handleFileAdd("drawingsFiles")}
                      >
                        +
                      </button>
                    )}
                    {fileStates.drawingsFiles.length > 1 && !viewMode && (
                      <button
                        type="button"
                        className="btn btn-sm btn-outline-danger"
                        onClick={() => handleFileRemove("drawingsFiles", index)}
                      >
                        -
                      </button>
                    )}
                  </div>
                  <InputText
                    label=""
                    name={`drawings_desc_${index}`}
                    placeholder={t("Description of File")}
                    register={register(`drawings_desc_${index}`)}
                    errors={errors}
                    disabled={viewMode}
                    className="mt-2"
                  />
                </div>
              ))}
            </Form.Group>
          </Col>
        </Row>

        <Row className="gy-4 mt-2">
          {/* Tonnage Booklets */}
          <Col md={6}>
            <InputFile
              label={t("Tonnage Booklets")}
              name="tonnageBooklets"
              required
              register={register("tonnageBooklets", { 
                required: t("Tonnage Booklets are required") 
              })}
              errors={errors}
              value={fileStates.tonnageBooklets}
              onChange={e => {
                if (viewMode) return;
                handleSingleFileChange("tonnageBooklets", e);
              }}
              disabled={viewMode}
            />
          </Col>

          {/* Stability Booklets */}
          <Col md={6}>
            <InputFile
              label={t("Stability Booklets")}
              name="stabilityBooklets"
              required
              register={register("stabilityBooklets", { 
                required: t("Stability Booklets are required") 
              })}
              errors={errors}
              value={fileStates.stabilityBooklets}
              onChange={e => {
                if (viewMode) return;
                handleSingleFileChange("stabilityBooklets", e);
              }}
              disabled={viewMode}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Builder Documents - Only shown if constructed by builder */}
      {constructedBy === "2" && (
        <Collapsible title={t("Builder Documents")} openStat={true}>
          <Row className="gy-4">
            <Col md={6}>
              <InputFile
                label={t("Authorisation Letter")}
                name="authLetter"
                required
                register={register("authLetter", {
                  required: constructedBy === "2" && t("Authorization Letter is required"),
                })}
                errors={errors}
                value={fileStates.authLetter}
                onChange={e => {
                  if (viewMode) return;
                  handleSingleFileChange("authLetter", e);
                }}
                disabled={viewMode}
              />
            </Col>
          </Row>
        </Collapsible>
      )}

      {/* Declaration Collapsible */}
      <Collapsible title={t("Declaration")} openStat={true}>
        <div className="mb-3">
          <div className="d-flex align-items-start">
            <input
              type="checkbox"
              id="termsAccepted"
              className="me-2 mt-1"
              {...register("termsAccepted", {
                required: t("You must accept the terms and conditions"),
              })}
              disabled={viewMode}
            />
            <div>
              <label
                htmlFor="termsAccepted"
                className="mb-0"
                style={{ fontWeight: 500, color: "#333", cursor: "pointer" }}
              >
                {t("I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.")}
              </label>
              {errors.termsAccepted && (
                <div className="text-danger small mt-1" style={{ display: "block" }}>
                  {errors.termsAccepted.message}
                </div>
              )}
            </div>
          </div>
        </div>
      </Collapsible>
    </div>
  );
};

export default Documents;
