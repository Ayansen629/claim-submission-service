// ReviewStep.js
import React, { useEffect, useMemo } from "react";
import { Container, Row, Col, Spinner } from "react-bootstrap";
import Collapsible from "./formCommon/Collapsible";
import { useFormData } from "../../context/FormDataContext";
import PreviewCard from "../../private/Dashboard/PreviewCard";

const ReviewStep = () => {
  const { formData } = useFormData();
  const [hasLoggedData, setHasLoggedData] = React.useState(false);
  console.log("ReviewStep formDatadssssssssssssssssss:", formData);

  // Memoize the formatted data to prevent unnecessary re-renders
  const formattedData = useMemo(() => {
    if (!formData || Object.keys(formData).length === 0) return null;

    // Helper function to format file information
    const formatFileInfo = (fileData) => {
      if (!fileData) return "No file uploaded";
      if (typeof fileData === "string") return fileData;
      return fileData.name || fileData.docName || "File uploaded";
    };

    return {
      step1: {
        creditorDetails: {
          "Debtor Name": formData.debtorName,
          "Creditor Name": formData.CreditorName,
          "Total Claim Amount": formData.totalClaimAmount,
          "Debt Details": formData.debtDetails,
          "Mutual Credit Details": formData.mutualCreditDetails,
        },
        identificationDetails: {
          "Identification Type": formData.identificationType,
          "Identification Number": formData.identificationNumber,
          "Identification Document": formatFileInfo(formData.identificationDocument),
        }
      },
      step2: {
        financialDetails: {
          "Security Interest Amount": formData.securityInterestAmount,
          "Guarantee Amount": formData.guaranteeAmount,
          "Guarantor Name": formData.guarantorName,
          "Guarantor Address": formData.guarantorAddress,
          "Creditor Address": formData.creditorAddress,
          "Creditor Email": formData.creditorEmail,
        },
        beneficiaryDetails: {
          "Beneficiary Name": formData.beneficiaryName,
          "Beneficiary Address": formData.beneficiaryAddress,
          "Corporate Debtor Security Amount": formData.corporateDebtorSecurityAmount,
          "Corporate Debtor Guarantee Amount": formData.corporateDebtorGuaranteeAmount,
        },
        addressproofDetails: {
          "Address Proof Type": formData.addressProofType,
          "Address Proof Number": formData.addressProofNumber,
          "Address Proof Document": formatFileInfo(formData.addressProofDocument),
        },
        bankDetails: {
          "Principal Borrower Name": formData.principalBorrowerName,
          "Principal Borrower Address": formData.principalBorrowerAddress,
          "Account Number": formData.accountNumber,
          "IFSC Code": formData.ifscCode,
          "Branch Name": formData.branchName,
          // "Address Proof": formatFileInfo(formData.addressProof),
        }
      },
      step3: {
        signatoryDetails: {
          "Signatory Name": formData.signatoryName,
          "Signatory Position": formData.signatoryPosition,
          "Signatory Address": formData.signatoryAddress,
          "Signatory Document": formatFileInfo(formData.signatoryDocument),
        }
      }
    };
  }, [formData]);

  useEffect(() => {
    if (formattedData && !hasLoggedData) {
      console.log("Review formdata:", formattedData);
      setHasLoggedData(true);
    }
  }, [formattedData, hasLoggedData]);

  const renderPreviewSection = (fields) => (
    <Container fluid>
      <Row className="g-3">
        {Object.entries(fields).map(([key, value]) => (
          <Col key={key} xs={12} sm={6} md={3} className="mb-3">
            <PreviewCard 
              title={key} 
              value={value} 
            />
          </Col>
        ))}
      </Row>
    </Container>
  );

  const renderCard = (title, fields) => (
    <div className="mb-3">
      <h5 style={{ fontWeight: 600 }}>{title}</h5>
      {renderPreviewSection(fields)}
    </div>
  );

  if (!formattedData) {
    return (
      <div className="d-flex justify-content-center align-items-center" style={{ height: "100vh" }}>
        <Spinner animation="border" />
      </div>
    );
  }

  return (
    <div className="form-stepper">
      <Collapsible title="Step 1: Creditor and Identification Details">
        {renderCard("Creditor Details", formattedData.step1.creditorDetails)}
        {renderCard("Identification Details", formattedData.step1.identificationDetails)}
      </Collapsible>

      <Collapsible title="Step 2: Financial and Beneficiary Details">
        {renderCard("Financial Details", formattedData.step2.financialDetails)}
        {renderCard("Address Proof Details", formattedData.step2.addressproofDetails)}
        {renderCard("Beneficiary Details", formattedData.step2.beneficiaryDetails)}
        {renderCard("Bank Details", formattedData.step2.bankDetails)}
      </Collapsible>

      <Collapsible title="Step 3: Signatory Details">
        {renderCard("Signatory Details", formattedData.step3.signatoryDetails)}
      </Collapsible>
    </div>
  );
};

export default React.memo(ReviewStep);
