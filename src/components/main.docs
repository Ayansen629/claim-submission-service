{/* Track Button */}
{col.actions?.includes("track") && (
  <OverlayTrigger overlay={<Tooltip>Track</Tooltip>}>
    <Button 
      variant="outline-info" 
      size="sm" 
      onClick={() => handleTrack(row)}
      className='track-button'
      style={{ 
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        padding: '0.25rem 0.5rem'
      }}
    >
      <img 
        src={trackIcon} 
        alt="track" 
        style={{ 
          width: "16px", 
          height: "16px",
          filter: "brightness(0.8)" // This helps make the icon visible if it's too light
        }}
      />
    </Button>
  </OverlayTrigger>
)}


.track-icon {
  filter: brightness(0.8) contrast(1.2);
  width: 16px;
  height: 16px;
}

.track-button {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0.25rem 0.5rem !important;
}


<Button 
  variant="outline-info" 
  size="sm" 
  onClick={() => handleTrack(row)}
  className={styles['track-button']}
>
  <img 
    src={trackIcon} 
    alt="track" 
    className={styles['track-icon']}
  />
</Button>
