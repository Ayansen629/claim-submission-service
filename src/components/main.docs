import React, { useState, useCallback, useEffect } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip";
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepFirst.css";
import { Button } from 'react-bootstrap';
import { File, Download, Upload, CheckCircle } from "lucide-react";
import 'bootstrap/dist/css/bootstrap.min.css';

const StepFirst = ({ provideSubmitHandler, formData }) => {
    const userFormData = JSON.parse(localStorage.getItem("userFormData")) || {};
    const hasCreditorName = !!userFormData?.claimantName;
    const hasDebtorName = !!userFormData?.corporateDebtorName;
    const [isUploading, setIsUploading] = useState(false);
    const [uploadError, setUploadError] = useState(null);
    const [uploadSuccess, setUploadSuccess] = useState(false);
    const [uploadedFileUrl, setUploadedFileUrl] = useState(null);

    const methods = useForm({
        defaultValues: {
            CreditorName: userFormData?.claimantName || "",
            debtorName: userFormData?.corporateDebtorName || "",
        }
    });

    const { register, handleSubmit, formState: { errors }, trigger, setValue, control, getValues, watch } = methods;

    const handleFileUpload = async (file) => {
        try {
            setIsUploading(true);
            setUploadError(null);
            setUploadSuccess(false);

            const result = await uploadDocument(file, 'identification');
            if (result.success) {
                setValue("identificationDocument", {
                    fileId: result.fileId,
                    docName: result.docName,
                    docType: result.docType,
                    fileUrl: result.fileUrl
                }, { shouldValidate: true });
                setUploadedFileUrl(`${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${result.fileId}`);
                setUploadSuccess(true);
            }
            return result;
        } catch (error) {
            setUploadError(error.message);
            setValue("identificationDocument", null, { shouldValidate: true });
            setUploadSuccess(false);
            throw error;
        } finally {
            setIsUploading(false);
        }
    };

    // ... [rest of your schema definitions remain the same] ...

    return (
        <FormProvider {...methods}>
            <form className="form-stepper">
                <div className="mb-4 bg-light">
                    <div className="mb-4 bg-light">
                        <Collapsible title="Debtor Details" defaultOpen={true}>
                            <div className="flex-container">
                                {debtorDetailsSchema.map((fieldConfig) => (
                                    <DynamicField
                                        key={fieldConfig.name}
                                        fieldConfig={fieldConfig}
                                        control={control}
                                        register={register}
                                        errors={errors}
                                        setValue={setValue}
                                        trigger={trigger}
                                        getValues={getValues}
                                    />
                                ))}
                            </div>
                        </Collapsible>
                    </div>
                    <Collapsible title="Creditor Basic Details" defaultOpen={true}>
                        <div className="flex-container">
                            {claimantDetailsSchema.map((fieldConfig) => (
                                <DynamicField
                                    key={fieldConfig.name}
                                    fieldConfig={fieldConfig}
                                    control={control}
                                    register={register}
                                    errors={errors}
                                    setValue={setValue}
                                    trigger={trigger}
                                    getValues={getValues}
                                />
                            ))}
                            {uploadedFileUrl && (
                                <div className="file-upload-status mt-4 p-3 border rounded bg-light">
                                    <div className="d-flex align-items-center gap-3">
                                        {uploadSuccess && (
                                            <div className="text-success d-flex align-items-center gap-2">
                                                <CheckCircle size={20} />
                                                <span>File uploaded successfully!</span>
                                            </div>
                                        )}
                                        <Button
                                            variant="outline-primary"
                                            as="a"
                                            href={uploadedFileUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            download
                                            className="d-flex align-items-center gap-2"
                                        >
                                            <Download size={18} />
                                            Download Document
                                        </Button>
                                    </div>
                                </div>
                            )}
                        </div>
                    </Collapsible>
                </div>
            </form>
        </FormProvider>
    );
};

export default StepFirst;


/* Add these styles to your existing StepFirst.css */

.file-upload-status {
    transition: all 0.3s ease;
    border: 1px solid #dee2e6 !important;
}

.file-upload-status:hover {
    background-color: #f8f9fa !important;
}

.btn-outline-primary {
    border-color: #0d6efd;
    color: #0d6efd;
}

.btn-outline-primary:hover {
    background-color: #0d6efd;
    color: white;
}

.required-asterisk {
    color: #dc3545;
    font-weight: bold;
}

/* Add some spacing between form elements */
.flex-container > * {
    margin-bottom: 1.5rem;
}

/* Style for upload progress/status */
.upload-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
}

.upload-status.success {
    color: #198754;
}

.upload-status.error {
    color: #dc3545;
}
