import React, { useState, useEffect } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Form, Button, Card, Image } from 'react-bootstrap';
import { 
  FaUser, FaBuilding, FaFileUpload, FaCheck, FaArrowRight, 
  FaArrowLeft, FaIdCard, FaEnvelope, FaPhone, FaMapMarkerAlt, FaUpload, FaShip 
} from 'react-icons/fa';
import './Reg.css';
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";

const RegistrationForm = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  
  const methods = useForm({
    mode: 'onBlur',
    defaultValues: { ownerCategory: '', country: 'India' }
  });
  
  const { register, handleSubmit, formState: { errors }, trigger, setValue, getValues, watch, clearErrors } = methods;
  const totalSteps = 3;
  const ownerCategory = watch('ownerCategory');
  
  // Clear errors when changing steps
  useEffect(() => {
    clearErrors();
  }, [currentStep, clearErrors]);

  // Form field definitions remain the same as your original code
  const formFields = {
    // ... (keep your existing formFields definition)
  };

  // Get fields for current step
  const getCurrentStepFields = () => {
    switch(currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      case 3: return formFields.step3;
      default: return [];
    }
  };

  // Enhanced validation function
  const validateStep = async () => {
    // Get all fields for current step that should be validated
    const fieldsToValidate = getCurrentStepFields()
      .filter(field => (!field.showIf || field.showIf()))
      .map(field => field.name);
    
    // Trigger validation for all relevant fields
    const isValid = await trigger(fieldsToValidate);
    
    // If validation fails, scroll to the first error
    if (!isValid) {
      const firstErrorField = Object.keys(errors)[0];
      if (firstErrorField) {
        const errorElement = document.querySelector(`[name="${firstErrorField}"]`);
        if (errorElement) {
          errorElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
          errorElement.focus();
        }
      }
    }
    
    return isValid;
  };

  // Handle next button click with improved validation
  const handleNext = async (e) => {
    e.preventDefault();
    
    const isStepValid = await validateStep();
    
    if (isStepValid) {
      const currentValues = getValues();
      setFormData(prev => ({ ...prev, ...currentValues }));
      
      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    }
  };

  // Handle previous button click
  const handlePrevious = () => {
    const currentValues = getValues();
    setFormData(prev => ({ ...prev, ...currentValues }));
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  // Handle form submission
  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };
    console.log('Form submitted with data:', JSON.stringify(finalData, null, 2));
    setIsSubmitted(true);
    window.scrollTo(0, 0);
  };

  // Enhanced field blur handler
  const handleBlur = async (fieldName, fieldConfig) => {
    // Only validate if the field has a value or is required
    const value = getValues(fieldName);
    if (value || fieldConfig.required) {
      await trigger(fieldName);
    } else {
      // If field is empty and not required, clear any existing error
      clearErrors(fieldName);
    }
  };

  // Dynamic Field Component with improved validation handling
  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const fieldError = errors[field.name];
    const fieldValue = watch(field.name);

    // Clear error when field is filled and valid
    useEffect(() => {
      if (fieldError && fieldValue && fieldValue.length > 0) {
        trigger(field.name);
      }
    }, [fieldValue, field.name, fieldError, trigger]);

    switch(field.type) {
      case 'select':
        return (
          <Form.Group className="form-group mb-4">
            <Form.Label className="fw-bold text-dark">
              {field.label} {field.required && <span className="required text-danger">*</span>}
            </Form.Label>
            <div className="input-with-icon">
              <Form.Select 
                {...register(field.name, field.validation)}
                onChange={(e) => {
                  if (field.onChange) field.onChange(e);
                  setValue(field.name, e.target.value);
                  clearErrors(field.name);
                }}
                onBlur={() => handleBlur(field.name, field)}
                className={`form-select custom-select ${fieldError ? 'is-invalid border-danger' : ''}`}
                disabled={field.readOnly}
                style={{ height: '50px', borderRadius: '8px' }}
                value={fieldValue || ''}
              >
                {field.options.map((option, idx) => (
                  <option key={idx} value={option.value}>{option.label}</option>
                ))}
              </Form.Select>
              {field.icon && <field.icon className="input-icon text-primary" />}
            </div>
            {fieldError && <div className="error-message text-danger small mt-1">{fieldError.message}</div>}
          </Form.Group>
        );
      
      case 'file':
        return (
          <Form.Group className="form-group mb-4">
            <Form.Label className="fw-bold text-dark">
              {field.label} {field.required && <span className="required text-danger">*</span>}
            </Form.Label>
            <div className="file-upload border rounded p-3" style={{ borderRadius: '8px', borderColor: '#dee2e6' }}>
              <input 
                type="file" 
                id={field.name}
                {...register(field.name, field.validation)}
                onChange={(e) => {
                  if (e.target.files[0]) {
                    setValue(field.name, e.target.files[0].name);
                    clearErrors(field.name);
                  }
                }}
                onBlur={() => handleBlur(field.name, field)}
                className="file-input d-none"
              />
              <label htmlFor={field.name} className="file-label btn btn-outline-primary mb-0 d-inline-flex align-items-center" style={{ borderRadius: '6px' }}>
                <FaUpload className="file-icon me-2" />
                <span className="file-text">Choose File</span>
              </label>
              <span className="file-name ms-3 text-muted">
                {fieldValue ? fieldValue : 'No file chosen'}
              </span>
            </div>
            <div className="file-help-text text-muted small mt-1">Upload PDF, JPG or PNG file (Max size: 2MB)</div>
            {fieldError && <div className="error-message text-danger small mt-1">{fieldError.message}</div>}
          </Form.Group>
        );
      
      default:
        return (
          <Form.Group className="form-group mb-4">
            <Form.Label className="fw-bold text-dark">
              {field.label} {field.required && <span className="required text-danger">*</span>}
            </Form.Label>
            <div className="input-with-icon">
              <Form.Control 
                type={field.type} 
                {...register(field.name, field.validation)}
                onChange={(e) => {
                  if (field.onChange) field.onChange(e);
                  setValue(field.name, e.target.value);
                  // Clear error as user types (only if there was an error)
                  if (errors[field.name]) {
                    clearErrors(field.name);
                  }
                }}
                onBlur={() => handleBlur(field.name, field)}
                className={`form-control custom-input ${fieldError ? 'is-invalid border-danger' : field.readOnly ? 'auto-populated bg-light' : ''}`}
                placeholder={field.placeholder}
                readOnly={field.readOnly}
                value={fieldValue || ''}
                style={{ height: '50px', borderRadius: '8px' }}
              />
              {field.icon && <field.icon className="input-icon text-primary" />}
            </div>
            {fieldError && <div className="error-message text-danger small mt-1">{fieldError.message}</div>}
          </Form.Group>
        );
    }
  };

  // ... (rest of your component remains the same)
  
  return (
    <Container fluid className="registration-container py-5">
      {/* ... (keep your existing JSX structure) */}
    </Container>
  );
};

export default RegistrationForm;
