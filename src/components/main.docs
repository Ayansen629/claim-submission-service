import React, { useState, useEffect, useRef } from 'react';
import { Table, Dropdown, Form, Button, Tooltip, OverlayTrigger, InputGroup } from 'react-bootstrap';
import {
    PencilSquare,
    Eye,
    Trash3,
    GeoAlt,
    Plus,
    ArrowDown,
    ArrowUp,
    Database,
    Check,
    Calendar,
    FileEarmarkText,
    Download,
    Search,
    Filter,
    SortDown,
    SortUp
} from 'react-bootstrap-icons';
import { useNavigate } from 'react-router-dom';
import './ActionTable.css';
import styles from './ActionTable.css';

// import trackIcon from "../../../assests/icons/track.png"; // adjust path as needed
import { FaMapMarkerAlt } from "react-icons/fa";
const ActionTable = (props) => {
    const [searchedData, setSearchedData] = useState(props.rowData || []);
    const [currentPage, setCurrentPage] = useState(1);
    const [selected, setSelected] = useState([]);
    const [sortedColumn, setSortedColumn] = useState(null);
    const [sortOrder, setSortOrder] = useState('');
    const hideColumns = props.hideColumns || [];
    const [searchQuery, setSearchQuery] = useState('');
    const [statusFilter, setStatusFilter] = useState('all');
    const [dateSort, setDateSort] = useState('none');
    const [itemsPerPage, setItemPerPage] = useState(10);
    const [totalPages, setTotalPages] = useState(0);
    const [statusDropdownOpen, setStatusDropdownOpen] = useState(false);
    const [dateDropdownOpen, setDateDropdownOpen] = useState(false);
    const statusDropdownRef = useRef(null);
    const dateDropdownRef = useRef(null);
    const navigate = useNavigate();

    // Close dropdowns when clicking outside
    useEffect(() => {
        function handleClickOutside(event) {
            if (statusDropdownRef.current && !statusDropdownRef.current.contains(event.target)) {
                setStatusDropdownOpen(false);
            }
            if (dateDropdownRef.current && !dateDropdownRef.current.contains(event.target)) {
                setDateDropdownOpen(false);
            }
        }

        document.addEventListener("mousedown", handleClickOutside);
        return () => {
            document.removeEventListener("mousedown", handleClickOutside);
        };
    }, []);

    useEffect(() => {
        if (props.rowData) {
            setSearchedData(props.rowData);
            setCurrentPage(1);
            const selectedRows = props.rowData
                .filter((item) => item.isChecked)
                .map((item) => item.id);
            setSelected(selectedRows);
        }
    }, [props.rowData]);

    useEffect(() => {
        let filteredData = [...(props.rowData || [])];

        if (statusFilter !== 'all') {
            filteredData = filteredData.filter(item => item.status === statusFilter);
        }

        if (searchQuery) {
            const searchValue = searchQuery.toLowerCase();
            filteredData = filteredData.filter(item => {
                return Object.values(item).some(value => {
                    if (value === null || value === undefined) return false;
                    return value.toString().toLowerCase().includes(searchValue);
                });
            });
        }

        if (dateSort !== 'none') {
            filteredData.sort((a, b) => {
                const parseDate = (obj) => {
                    const dateFormats = [
                        'dd-MM-yy', 'dd/MM/yy', 'dd.MM.yy',
                        'yyyy-MM-dd', 'yyyy/MM/dd', 'yyyy.MM.dd'
                    ];
                    const dateFields = ['dateSubmitted', 'createdAt', 'date', 'submissionDate'];

                    for (const field of dateFields) {
                        if (obj[field]) {
                            for (const format of dateFormats) {
                                const parsedDate = parseDateFromFormat(obj[field], format);
                                if (parsedDate) return parsedDate;
                            }
                            const date = new Date(obj[field]);
                            if (!isNaN(date.getTime())) return date;
                        }
                    }
                    return new Date(0);
                };
                function parseDateFromFormat(dateString, format) {
                    if (!dateString) return null;

                    // Handle dd-MM-yy format
                    if (format === 'dd-MM-yy') {
                        const parts = dateString.split('-');
                        if (parts.length === 3) {
                            const day = parseInt(parts[0], 10);
                            const month = parseInt(parts[1], 10) - 1;
                            const year = 2000 + parseInt(parts[2], 10);
                            return new Date(year, month, day);
                        }
                        return null;
                    }

                    // Fallback to native parsing
                    const parsedDate = new Date(dateString);
                    return isNaN(parsedDate.getTime()) ? null : parsedDate;
                }

                const dateA = parseDate(a);
                const dateB = parseDate(b);
                return dateSort === "desc" ? dateB - dateA : dateA - dateB;
            });
        }

        setSearchedData(filteredData);
        setCurrentPage(1);
        setTotalPages(Math.ceil((filteredData?.length || 0) / itemsPerPage));
    }, [props.rowData, statusFilter, searchQuery, dateSort, itemsPerPage]);

    const indexOfLastItem = currentPage * itemsPerPage;
    const indexOfFirstItem = indexOfLastItem - itemsPerPage;
    const currentItems = searchedData.slice(indexOfFirstItem, indexOfLastItem);

    const handleNextPage = () => setCurrentPage(prev => Math.min(prev + 1, totalPages));
    const handlePrevPage = () => setCurrentPage(prev => Math.max(prev - 1, 1));
    const handleOnSearch = (e) => setSearchQuery(e.target.value);

    const sortByColumn = (column) => {
        setSortedColumn(column);
        setSortOrder(sortOrder === "asc" && sortedColumn === column ? "desc" : "asc");
    };

    const showSortedColumnIcon = (columnName) => {
        if (sortedColumn !== columnName) return null;
        return sortOrder === "asc" ? <ArrowUp className="ms-1" /> : <ArrowDown className="ms-1" />;
    };

    const handleDeleteRow = (rowData) => props.onDeleteRow?.(rowData);
    const handleTrack = (rowData) => props.onTrackRow?.(rowData);
    const handleView = (rowData) => props.onViewRow?.(rowData);
    const handleEdit = (rowData) => props.handleEditRow?.(rowData);
    const handleDownload = (rowData) => props.download?.(rowData);

    const handleSelectAll = (e) => {
        const newSelecteds = e.target.checked ? currentItems.map(n => n.id) : [];
        setSelected(newSelecteds);
        props.onCheckHandler?.(newSelecteds);
    };

    const handleRowSelect = (e, row) => {
        const newSelected = e.target.checked
            ? [...selected, row.id]
            : selected.filter(id => id !== row.id);
        setSelected(newSelected);
        props.onCheckHandler?.(newSelected);
    };

    const isSelected = (id) => selected.includes(id);
    const getStatusOptions = () => ["all", ...new Set(props.rowData?.map(item => item.status))].filter(Boolean);

    const PaginationOptions = () => (
        <div className="d-inline-flex align-items-center">
            <div className="pe-2">Rows per page</div>
            <Dropdown>
                <Dropdown.Toggle variant="outline-primary" className="d-flex align-items-center">
                    {itemsPerPage}
                </Dropdown.Toggle>
                <Dropdown.Menu>
                    {[10, 25, 50, 100].map((item) => (
                        <Dropdown.Item
                            key={item}
                            onClick={() => { setItemPerPage(item); setCurrentPage(1); }}
                            active={itemsPerPage === item}
                        >
                            {item} {itemsPerPage === item && <Check className="ms-2" />}
                        </Dropdown.Item>
                    ))}
                </Dropdown.Menu>
            </Dropdown>
        </div>
    );

    const userData = JSON.parse(localStorage.getItem("userFormData")) || {};

    // Add this function to your component
const getStatusColor = (status) => {
  switch (status?.toLowerCase()) {
    case 'draft':
      return '#95a5a6'; // Soft gray - neutral for in-progress items
    case 'accepted as contingent':
      return '#e67e22'; // Orange - indicates conditional/temporary state
    case 'sent back':
      return '#e74c3c'; // Vibrant red - requires attention
    case 'pending':
      return '#f39c12'; // Gold/yellow - waiting state
    case 'approved by rp':
      return '#27ae60'; // Green - success/completion
    case 'rejected':
      return '#c0392b'; // Dark red - clear negative outcome
    default:
      return '#bdc3c7'; // Light gray - neutral default
  }
};

// Add this function to get the text color (for contrast)
const getStatusTextColor = (status) => {
  switch (status?.toLowerCase()) {
    case 'pending':
      return '#000000'; // Black text for yellow background
    default:
      return '#ffffff'; // White text for other backgrounds
  }
};

    return (
        <div className="mb-5 px-3 mx-0 generic-action-table pt-4" style={{ margin: '20px' }}>
            {/* Search and Filter Controls - All in one row */}
            <div className="controls-row">
                {!props.hideSearchBar && (
                    <div className="controls-container">
                        <div className="search-container">
                            <div className="input-group">
                            
                                <input
                                    type="search"
                                    value={searchQuery}
                                    onChange={handleOnSearch}
                                    placeholder="Search records..."
                                    className="form-control"
                                />
                                    <span className="input-group-text">
                                    <Search />
                                </span>
                            </div>
                        </div>
                        
                        <div className="filters-container">
                            {/* Status Filter */}
                            <div className="filter-item" ref={statusDropdownRef}>
                                <button 
                                    className={`filter-button ${statusFilter !== 'all' ? 'active' : ''}`}
                                    onClick={() => setStatusDropdownOpen(!statusDropdownOpen)}
                                >
                                    <Filter className="filter-icon" />
                                    <span>{statusFilter === 'all' ? 'All Statuses' : statusFilter}</span>
                                    <ArrowDown className="ms-1" />
                                </button>
                                
                                {statusDropdownOpen && (
                                    <div className="filter-menu">
                                        <div className="filter-header">Filter by Status</div>
                                        {getStatusOptions().map((status, index) => (
                                            <div 
                                                key={index} 
                                                className={`filter-option ${statusFilter === status ? 'active' : ''}`}
                                                onClick={() => {
                                                    setStatusFilter(status);
                                                    setStatusDropdownOpen(false);
                                                }}
                                            >
                                                <span>{status === 'all' ? 'All Statuses' : status}</span>
                                                {statusFilter === status && <Check className="ms-2" />}
                                            </div>
                                        ))}
                                    </div>
                                )}
                            </div>
                            
                            {/* Date Sort */}
                            <div className="filter-item" ref={dateDropdownRef}>
                                <button 
                                    className={`filter-button ${dateSort !== 'none' ? 'active' : ''}`}
                                    onClick={() => setDateDropdownOpen(!dateDropdownOpen)}
                                >
                                    <Calendar className="filter-icon" />
                                    <span>{dateSort === 'none' ? 'Date' : dateSort === 'asc' ? 'Oldest First' : 'Newest First'}</span>
                                    <ArrowDown className="ms-1" />
                                </button>
                                
                                {dateDropdownOpen && (
                                    <div className="filter-menu">
                                        <div className="filter-header">Sort by Date</div>
                                        <div 
                                            className={`filter-option ${dateSort === 'none' ? 'active' : ''}`}
                                            onClick={() => {
                                                setDateSort('none');
                                                setDateDropdownOpen(false);
                                            }}
                                        >
                                            <span>Default Order</span>
                                            {dateSort === 'none' && <Check className="ms-2" />}
                                        </div>
                                        <div 
                                            className={`filter-option ${dateSort === 'asc' ? 'active' : ''}`}
                                            onClick={() => {
                                                setDateSort('asc');
                                                setDateDropdownOpen(false);
                                            }}
                                        >
                                            <SortUp className="me-2" /> <span>Oldest First</span>
                                            {dateSort === 'asc' && <Check className="ms-2" />}
                                        </div>
                                        <div 
                                            className={`filter-option ${dateSort === 'desc' ? 'active' : ''}`}
                                            onClick={() => {
                                                setDateSort('desc');
                                                setDateDropdownOpen(false);
                                            }}
                                        >
                                            <SortDown className="me-2" /> <span>Newest First</span>
                                            {dateSort === 'desc' && <Check className="ms-2" />}
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>

                        {props.showCustomBtn && (
                            <Button
                                onClick={props.handleBtnClick}
                                disabled={props.isCustomBtnDisabled}
                                className={`btn btn-primary ms-3 d-flex align-items-center ${props.isCustomBtnDisabled ? 'custom-disabled-btn' : ''}`}
                            >
                                <Plus className="me-2" />
                                <span>{props.btnName}</span>
                            </Button>
                        )}
                    </div>
                )}
            </div>

            {/* Table */}
           <div className="table-responsive mb-4" style={{ overflowX: 'hidden', margin: '0 10px' }}>
                <Table className="table align-middle" style={{ 
                    width: '100%', 
                    marginBottom: '0',
                    borderBottom: '2px solid #dee2e6'
                }}>
               
                    <thead className="table-primary">
                        <tr>
                            <th style={{ width: '50px' }}>
                                <Form.Check
                                    type="checkbox"
                                    checked={selected.length > 0 && selected.length === currentItems.length}
                                    onChange={handleSelectAll}
                                    ref={input => input && (input.indeterminate = selected.length > 0 && selected.length < currentItems.length)}
                                />
                            </th>
                            
                            {props.columns?.map((data) => (
                                !hideColumns.includes(data.fieldName) && (
                                    <th
                                        key={data.fieldName}
                                        className="text-center"
                                        style={{ 
                                            width: data.width || 'auto',
                                            padding: '12px 8px'
                                        }}
                                        onClick={() => sortByColumn(data.fieldName)}
                                    >
                                        <div className="d-flex justify-content-center align-items-center">
                                            <span>{data.titleCode || data.colName}</span>
                                            {showSortedColumnIcon(data.fieldName)}
                                        </div>
                                    </th>
                                )
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        {currentItems.length > 0 ? (
                            currentItems.map((row) => (
                                <tr key={row.id} className={isSelected(row.id) ? 'selected-row' : ''} style={{ borderBottom: '1px solid #e9ecef' }}>
                                    <td style={{ padding: '15px' }}>
                                        <Form.Check
                                            type="checkbox"
                                            checked={isSelected(row.id)}
                                            onChange={(e) => handleRowSelect(e, row)}
                                        />
                                    </td>
                                    
                                    {props.columns.map((col) => {
                                        if (hideColumns.includes(col.fieldName)) return null;

                                        const cellValue = col.fieldName.split('.').reduce((obj, key) => obj?.[key], row);
                                        const displayValue = cellValue?.toString() || '';
                                        const firstWord = displayValue.split(' ')[0];

                                        if (col.fieldName === 'action') {
                                            return (
                                                <td key="actions" className="text-center" style={{ padding: '8px' }}>
                                                    <div className="d-flex justify-content-center gap-2">
                                                        {/* Edit Button */}
                                                        {col.actions?.includes("edit") && userData?.userType !== "CRP" && (
                                                            <OverlayTrigger overlay={<Tooltip>Edit</Tooltip>}>
                                                            <Button
                                                              variant={
                                                                row.applicationStatus !== "Sent back" && row.applicationStatus !== "Draft"
                                                                  ? "secondary" // looks like a disabled/muted button
                                                                  : "outline-primary"
                                                              }
                                                              size="sm"
                                                              disabled={row.applicationStatus !== "Sent back" && row.applicationStatus !== "Draft"}
                                                              onClick={() => handleEdit(row)}
                                                            >
                                                              <PencilSquare className="action-icon" />
                                                            </Button>
                                                          </OverlayTrigger>
                                                          
                                                        )}

                                                        {/* View Button */}
                                                        {col.actions?.includes("view") && (
                                                            <OverlayTrigger overlay={<Tooltip>View</Tooltip>}>
                                                                <Button variant="outline-primary" size="sm" onClick={() => handleView(row)}>
                                                                    <Eye className="action-icon" />
                                                                </Button>
                                                            </OverlayTrigger>
                                                        )}

                          {/* Track Button */}
{col.actions?.includes("track") && (
  <OverlayTrigger overlay={<Tooltip>
    {row.status?.toLowerCase() === 'draft' ? 'Tracking not available for drafts' : 'Track'}
  </Tooltip>}>
    <span> {/* Using span as wrapper to maintain tooltip even when button is disabled */}
      <Button 
        variant="outline-primary" 
        size="sm" 
        onClick={() => handleTrack(row)}
        disabled={row.status?.toLowerCase() === 'draft'}
        style={{
          opacity: row.status?.toLowerCase() === 'draft' ? '0.6' : '1',
          cursor: row.status?.toLowerCase() === 'draft' ? 'not-allowed' : 'pointer'
        }}
      >
        <GeoAlt className="action-icon" />
      </Button>
    </span>
  </OverlayTrigger>
)}                             


		{/* Track Button */}
 {/* {col.actions?.includes("track") && (
  <OverlayTrigger overlay={<Tooltip>Track</Tooltip>}>
    <Button variant="outline-primary" size="sm" onClick={() => handleTrack(row)}>
      <GeoAlt className="action-icon" />
    </Button>
  </OverlayTrigger>
)}  */}


 
{/* Track Button */}
{/* {col.actions?.includes("track") && (
  <div 
    onClick={() => handleTrack(row)}
    style={{
      display: 'inline-flex',
      alignItems: 'center',
      justifyContent: 'center',
      padding: '6px 10px',
    //   border: '1px solid #0ea5e9',
      borderRadius: '4px',
      cursor: 'pointer',
    //   backgroundColor: 'white',
      margin: '0 4px',
      transition: 'all 0.2s ease'
    }}
    onMouseOver={(e) => {
      e.currentTarget.style.backgroundColor = '#f0f9ff';
      e.currentTarget.style.boxShadow = '0 0 0 3px rgba(14, 165, 233, 0.15)';
    }}
    onMouseOut={(e) => {
      e.currentTarget.style.backgroundColor = 'white';
      e.currentTarget.style.boxShadow = 'none';
    }}
    title="Track"
  >
    <img 
      src={trackIcon} 
      alt="track" 
      style={{ 
        width: "16px", 
        height: "16px",
        // filter: "brightness(0) saturate(100%) invert(48%) sepia(99%) saturate(2368%) hue-rotate(175deg) brightness(98%) contrast(101%)",
        // This filter makes the icon blue (#0ea5e9) regardless of its original color
      }}
    />
  </div>
)} */}










                                                        {/* Delete Button */}
                                                        {col.actions?.includes("delete") && userData?.userType !== "CRP" && (
                                                            <OverlayTrigger overlay={<Tooltip>Delete</Tooltip>}>
                                                                <Button variant="outline-danger" size="sm" onClick={() => handleDeleteRow(row)}>
                                                                    <Trash3 className="action-icon" />
                                                                </Button>
                                                            </OverlayTrigger>
                                                        )}

                                                        {/* Download Button */}
                                                        {col.actions?.includes("download") && (
                                                            <OverlayTrigger overlay={<Tooltip>Download</Tooltip>}>
                                                                <Button variant="outline-success" size="sm" onClick={() => handleDownload(row)}>
                                                                    <Download className="action-icon" />
                                                                </Button>
                                                            </OverlayTrigger>
                                                        )}
                                                    </div>
                                                </td>
                                            );
                                        }

                                        // Special handling for claim number (show first word with tooltip)
                                        // if (col.fieldName === 'claimNumber') {
                                        //     return (
                                        //         <td key={col.fieldName} className="text-center" style={{ padding: '8px' }}>
                                        //             <OverlayTrigger overlay={<Tooltip>{displayValue}</Tooltip>}>
                                        //                 <div className="text-truncate" style={{ maxWidth: '120px', display: 'inline-block' }}>
                                        //                     {userData?.userType === "CRP" ? (
                                        //                         <a
                                        //                             href={`/apply-claim/${row.uuid}`}
                                        //                             onClick={(e) => { e.preventDefault(); navigate(`/apply-claim/${row.uuid}`); }}
                                        //                             className="text-primary"
                                        //                         >
                                        //                             {displayValue || 'N/A'}
                                        //                         </a>
                                        //                     ) : displayValue || 'N/A'}
                                        //                 </div>
                                        //             </OverlayTrigger>
                                        //         </td>
                                        //     );
                                        // }

                                        // Add this to your cell rendering logic
if (col.fieldName === 'status' ) {
  return (
    <td key={col.fieldName} className="text-center" style={{ padding: '8px' }}>
      <div 
        className="status-badge"
        style={{
          backgroundColor: getStatusColor(displayValue),
          color: getStatusTextColor(displayValue),
          padding: '4px 8px',
          borderRadius: '4px',
          display: 'inline-block',
          fontWeight: '500',
          fontSize: '0.85rem',
          minWidth: '80px'
        }}
      >
        {displayValue || 'N/A'}
      </div>
    </td>
  );
}


                                        if (col.fieldName === 'claimNumber') {
                                            return (
                                                <td key={col.fieldName} className="text-center" style={{ padding: '8px' }}>
                                                    {/* <OverlayTrigger overlay={<Tooltip>{displayValue}</Tooltip>}> */}
                                                        {/* <div className="text-truncate" style={{ maxWidth: '120px', display: 'inline-block' }}> */}
                                                            {userData?.userType === "CRP" ? (
                                                                <a
                                                                    href={`/apply-claim/${row.uuid}`}
                                                                    onClick={(e) => { e.preventDefault(); navigate(`/apply-claim/${row.uuid}`); }}
                                                                    className="text-primary"
                                                                >
                                                                    {displayValue || 'N/A'}
                                                                    
                                                                </a>
                                                            ) : (
                                                            
                                                                <div className='cell-content'>
                                                                      {displayValue || 'N/A'}

                                                                </div>


                                                            )}
                                                            
                                                          
                                                        {/* </div> */}
                                                    {/* </OverlayTrigger> */}
                                                </td>
                                            );
                                        }

                                        // Special handling for comment (show first word with tooltip)
                                        if (col.fieldName === 'comment') {
                                            return (
                                                <td key={col.fieldName} className="text-center" style={{ padding: '8px' }}>
                                                    <OverlayTrigger overlay={<Tooltip>{displayValue || 'No comment'}</Tooltip>}>
                                                        <div className="text-truncate" style={{ maxWidth: '120px', display: 'inline-block' }}>
                                                            {firstWord || (
                                                                <span className="text-muted">
                                                                    <FileEarmarkText className="me-1" />
                                                                    None
                                                                </span>
                                                            )}
                                                        </div>
                                                    </OverlayTrigger>
                                                </td>
                                            );
                                        }

                                        // Default cell rendering (show full content)
                                        return (
                                            <td key={col.fieldName} className="text-center" style={{ padding: '8px' }}>
                                                <div className="cell-content">
                                                    {displayValue || (
                                                        <span className="text-muted">
                                                            <FileEarmarkText className="me-1" />
                                                            None
                                                        </span>
                                                    )}
                                                </div>
                                            </td>
                                        );
                                    })}
                                </tr>
                            ))
                        ) : (
                            <tr>
                                <td colSpan={props.columns.length + 1} className="text-center py-5">
                                    <div className="d-flex flex-column justify-content-center align-items-center">
                                        <Database size={48} className="text-muted mb-3" />
                                        <h5 className="text-muted">No records found</h5>
                                        <p className="text-muted">Try adjusting your search or filter criteria</p>
                                    </div>
                                </td>
                            </tr>
                        )}
                    </tbody>
                </Table>
            </div>

            {/* Table Footer */}
            <div className={styles.tableFooter}>
                <div className={styles.tableFooterContent}>
                    <div className={styles.tableInfo}>
                        <span className={styles.entriesInfo}>
                            Showing {indexOfFirstItem + 1}-{Math.min(indexOfLastItem, searchedData.length)} of {searchedData.length} entries
                        </span>
                        {selected.length > 0 && (
                            <span className={styles.selectedBadge}>
                                {selected.length} selected
                            </span>
                        )}
                    </div>
                    
                    <div className={styles.tablePagination}>
                        <PaginationOptions />
                        
                        <div className={styles.paginationControls}>
                            <button 
                                className={`${styles.paginationButton} ${currentPage === 1 ? styles.disabled : ''}`}
                                onClick={handlePrevPage}
                                disabled={currentPage === 1}
                            >
                                <span className={styles.paginationIcon}>«</span>
                            </button>
                            
                            <div className={styles.paginationPages}>
                                {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
                                    // Logic to show current page and surrounding pages
                                    let pageNum;
                                    if (totalPages <= 5) {
                                        pageNum = i + 1;
                                    } else if (currentPage <= 3) {
                                        pageNum = i + 1;
                                    } else if (currentPage >= totalPages - 2) {
                                        pageNum = totalPages - 4 + i;
                                    } else {
                                        pageNum = currentPage - 2 + i;
                                    }
                                    
                                    return (
                                        <button
                                            key={pageNum}
                                            className={`${styles.pageNumber} ${currentPage === pageNum ? styles.active : ''}`}
                                            onClick={() => setCurrentPage(pageNum)}
                                        >
                                            {pageNum}
                                        </button>
                                    );
                                })}
                                
                                {totalPages > 5 && currentPage < totalPages - 2 && (
                                    <>
                                        <span className={styles.paginationEllipsis}>...</span>
                                        <button
                                            className={styles.pageNumber}
                                            onClick={() => setCurrentPage(totalPages)}
                                        >
                                            {totalPages}
                                        </button>
                                    </>
                                )}
                            </div>
                            
                            <button 
                                className={`${styles.paginationButton} ${currentPage === totalPages || totalPages === 0 ? styles.disabled : ''}`}
                                onClick={handleNextPage}
                                disabled={currentPage === totalPages || totalPages === 0}
                            >
                                <span className={styles.paginationIcon}>»</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <style jsx>{`
                .controls-row {
                    margin-bottom: 1.5rem;
                }
                
                .controls-container {
                    display: flex;
                    align-items: center;
                    width: 100%;
                }
                
                .search-container {
                    flex: 1;
                    max-width: 400px;
                    margin-right: 1rem;
                }
                
                .filters-container {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                }
                
                .filter-item {
                    position: relative;
                }
                
                .filter-button {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    background-color: #fff;
                    border: 1px solid #ced4da;
                    border-radius: 4px;
                    padding: 0.375rem 0.75rem;
                    font-size: 0.9rem;
                    color: #495057;
                    cursor: pointer;
                    transition: all 0.2s;
                    height: 38px;
                    white-space: nowrap;
                }
                
                .filter-button:hover {
                    border-color: #adb5bd;
                    background-color: #f8f9fa;
                }
                
                .filter-button.active {
                    border-color: #1976d2;
                    color: #1976d2;
                }
                
                .filter-icon {
                    font-size: 0.9rem;
                    color: #6c757d;
                }
                
                .filter-menu {
                    position: absolute;
                    top: 100%;
                    left: 0;
                    z-index: 1050;
                    min-width: 200px;
                    padding: 0.5rem 0;
                    margin: 0.125rem 0 0;
                    background-color: #fff;
                    border: 1px solid rgba(0, 0, 0, 0.15);
                    border-radius: 0.25rem;
                    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.175);
                    max-height: none !important;
                    overflow: visible !important;
                }
                
                .filter-header {
                    display: block;
                    padding: 0.5rem 1rem;
                    margin-bottom: 0;
                    font-size: 0.875rem;
                    color: #6c757d;
                    white-space: nowrap;
                    background-color: #f8f9fa;
                    border-bottom: 1px solid #e9ecef;
                    font-weight: 600;
                }
                
                .filter-option {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    padding: 0.5rem 1rem;
                    clear: both;
                    font-weight: 400;
                    color: #212529;
                    text-align: inherit;
                    white-space: nowrap;
                    background-color: transparent;
                    border: 0;
                    cursor: pointer;
                }
                
                .filter-option:hover {
                    color: #16181b;
                    text-decoration: none;
                    background-color: #f8f9fa;
                }
                
                .filter-option.active {
                    color: #1976d2;
                    background-color: rgba(25, 118, 210, 0.1);
                    font-weight: 500;
                }
                
                @media (max-width: 768px) {
                    .controls-container {
                        flex-direction: column;
                        align-items: flex-start;
                    }
                        
                    
                    .search-container {
                        width: 100%;
                        max-width: none;
                        margin-right: 0;
                        margin-bottom: 1rem;
                    }
                    
                    .filters-container {
                        width: 100%;
                        justify-content: space-between;
                    }
                    
                    .filter-item {
                        flex: 1;
                    }
                    
                    .filter-button {
                        width: 100%;
                        justify-content: space-between;
                    }
                }
            `}</style>
        </div>
    );
};

export default ActionTable;
action table.css
.table {
  border-collapse: separate;
  border-spacing: 0;
  width: 100%;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.table_header {
  background-color: #fff!important;
  color: black;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  position: sticky;
  top: 0;
  z-index: 10;
}

.table_header th {
  padding: 1rem !important;
  transition: background-color 0.2s;
  cursor: pointer;
  border-bottom: 2px solid #fff
}

.table_header th:hover {
  background-color: #0b5ed7 !important;
}

.table_data td {
  padding: 0.75rem 1rem !important;
  vertical-align: middle;
  border-bottom: 1px solid #e9ecef;
}

.table_data:hover {
  background-color: #f5f9fa !important;
}

.actionTable_table_data {
  text-align: center;
}

.application_search {
  margin-bottom: 1.5rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.application_search input[type="search"] {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  transition: border-color 0.2s;
}

.application_search input[type="search"]:focus {
  border-color: #0b5ed7;
  outline: none;
  box-shadow: 0 0 0 0.2rem rgba(36, 36, 203, 0.25);
}

.table_footer {
  background-color: #f8f9fa;
  border-radius: 0 0 8px 8px;
  padding: 1rem;
  font-weight: 500;
}

.pagenumber {
  display: inline-block;
  min-width: 2rem;
  text-align: center;
  font-weight: 600;
}

/* Action buttons styling */
.actionButton {
  margin: 0 4px;
  transition: all 0.2s;
}

.actionButton:hover {
  transform: translateY(-2px);
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
}

/* Table container */
.tableContainer {
  border-radius: 8px;
  overflow: auto;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
}

/* Table header section */
.tableHeader {
  padding: 1rem;
  background-color: #f8f9fa;
  border-bottom: 1px solid #e9ecef;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
}

/* Search input styling */
.searchInput {
  display: flex;
  align-items: center;
  background-color: white;
  border: 1px solid #ced4da;
  border-radius: 4px;
  padding: 0 0.5rem;
}

.searchInput input {
  border: none;
  padding: 0.5rem;
  outline: none;
  width: 100%;
}

.searchInput i {
  color: #6c757d;
}

/* Pagination styling */
.pagination {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.paginationButton {
  background-color: white;
  border: 1px solid #ced4da;
  border-radius: 4px;
  padding: 0.25rem 0.5rem;
  cursor: pointer;
  transition: all 0.2s;
}

.paginationButton:hover:not(:disabled) {
  background-color:#0b5ed7;
  color: white;
}

.paginationButton:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.paginationControls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.paginationIcon {
  font-size: 1.2rem;
  line-height: 1;
}

.paginationPages {
  display: flex;
  align-items: center;
}

.pageNumber {
  background-color: white;
  border: 1px solid #ced4da;
  border-radius: 4px;
  min-width: 2rem;
  height: 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0.2rem;
  cursor: pointer;
  transition: all 0.2s;
}

.pageNumber:hover {
  background-color: #f0f0f0;
}

.pageNumber.active {
  background-color:#0b5ed7;
  color: white;
  border-color: #0b5ed7;
}

.paginationEllipsis {
  margin: 0 0.2rem;
}

.disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.tableFooter {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
  background-color: #f8f9fa;
  border-top: 1px solid #e9ecef;
}

.paginationInfo {
  color: #6c757d;
  font-size: 0.9rem;
}

.tableActions {
  display: flex;
  align-items: center;
  gap: 1rem;
}

