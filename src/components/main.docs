

if (dateSort !== "none") {
  filteredData.sort((a, b) => {
    const getTimestamp = (obj) => {
      const dateFields = ['dateSubmitted', 'createdAt', 'date', 'submissionDate'];
      for (const field of dateFields) {
        if (obj[field]) {
          const timestamp = new Date(obj[field]).getTime();
          if (!isNaN(timestamp)) {
            return timestamp;
          }
        }
      }
      return 0; // Fallback for items with no valid date
    };

    const timestampA = getTimestamp(a);
    const timestampB = getTimestamp(b);

    // Newest first (descending) - show higher timestamps first
    if (dateSort === "desc") {
      return timestampB - timestampA;
    }
    // Oldest first (ascending) - show lower timestamps first
    else {
      return timestampA - timestampB;
    }
  });
}
