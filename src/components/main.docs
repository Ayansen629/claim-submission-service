import React from "react";
import { Card, Row, Col, Button } from "react-bootstrap";
import { useForm } from "react-hook-form";
import InputSelect from "../../../common/InputSelect.tsx";
import InputText from "../../../common/InputText.tsx";
import { headerStyle } from "../../../../utils/constants.ts";

const UserRegFilter = ({ onFilterSubmit }) => {
  const {
    register,
    handleSubmit,
    reset,
    formState: { errors },
  } = useForm();

  const onSubmitFilterForm = (data) => {
    onFilterSubmit(data);
  };

  return (
    <Card className="mb-4 filter-card">
      <Card.Header className="dashboard-card-header" style={headerStyle}>
        <h5>Filter Applications</h5>
      </Card.Header>
      <Card.Body>
        <form onSubmit={handleSubmit(onSubmitFilterForm)}>
          <Row>
            <Col md={3}>
              <InputSelect
                label="Application Module"
                name="applicationModule"
                options={[
                  { value: "", label: "All Modules" },
                  { value: "registration", label: "Registration" },
                  { value: "survey", label: "Survey" },
                  { value: "training", label: "Manning/Training & Certification" },
                ]}
                register={register}
                errors={errors}
                defaultValue=""
              />
            </Col>

            <Col md={3}>
              <InputSelect
                label="Application Type"
                name="applicationType"
                options={[
                  { value: "", label: "All Types" },
                  { value: "ship_builder", label: "Ship Builder" },
                  { value: "vessel_owner", label: "Vessel Owner" },
                  { value: "duplicate", label: "Duplicate Certificate" },
                ]}
                register={register}
                errors={errors}
                defaultValue=""
              />
            </Col>

            <Col md={3}>
              <InputSelect
                label="Application Status"
                name="applicationStatus"
                options={[
                  { value: "", label: "All Statuses" },
                  { value: "pending", label: "Pending" },
                  { value: "completed", label: "Completed" },
                  { value: "processing", label: "Processing" },
                  { value: "rejected", label: "Rejected" },
                ]}
                register={register}
                errors={errors}
                defaultValue=""
              />
            </Col>

            <Col md={3}>
              <InputText
                type="text"
                name="applicationNumber"
                label="Application Number"
                maxLength={15}
                placeholder="e.g. APP-2025-001"
                register={{
                  ...register("applicationNumber"),
                }}
                errors={errors}
              />
            </Col>
          </Row>

          <Row className="mt-3">
            <Col md={3}>
              <InputText
                type="date"
                name="fromDate"
                label="From Date"
                register={{
                  ...register("fromDate"),
                }}
                errors={errors}
              />
            </Col>

            <Col md={3}>
              <InputText
                type="date"
                name="toDate"
                label="To Date"
                register={{
                  ...register("toDate"),
                }}
                errors={errors}
              />
            </Col>

            <Col md={3}>
              <InputText
                type="text"
                name="phoneNumber"
                label="Phone Number"
                maxLength={10}
                placeholder="Enter phone number"
                register={{
                  ...register("phoneNumber", {
                    pattern: {
                      value: /^[0-9]*$/,
                      message: "Only numbers are allowed",
                    },
                  }),
                }}
                errors={errors}
              />
            </Col>

            <Col md={3} className="d-flex align-items-end">
              <div className="d-flex gap-2 w-100">
                <Button variant="primary" type="submit" className="w-50">
                  Apply Filters
                </Button>
                <Button
                  variant="outline-secondary"
                  type="button"
                  className="w-50"
                  onClick={() => {
                    reset();
                    onFilterSubmit({});
                  }}
                >
                  Reset
                </Button>
              </div>
            </Col>
          </Row>
        </form>
      </Card.Body>
    </Card>
  );
};

export default UserRegFilter;

import React from "react";
import Select from "react-select";
import { Form } from "react-bootstrap";
import "./styles/InputSelect.css"; 

interface InputSelectProps {
  label: string;
  required?: boolean;
  name: string;
  options: Array<{ value: string | number; label: string }>;
  register?: any;
  errors?: any;
  disabled?: boolean;
  onChange?: (value: string | number, selObj?: any) => void;
  className?: string;
  style?: React.CSSProperties;
  icon?: React.ElementType;
  value?: any;
  isMulti?: boolean;
  isClearable?: boolean;
  placeholder?: string;
}

const InputSelect: React.FC<InputSelectProps> = ({
  label,
  required,
  name,
  options,
  register,
  errors = {},
  disabled,
  onChange,
  className = "",
  style = {},
  icon: IconComponent,
  value,
  isMulti = false,
  isClearable = false,
  placeholder = "-- Select --",
}) => {
  const fieldKey = name.includes(".") ? name.split(".").pop() : name;
  const hasError = errors && errors[fieldKey];
  const errorMessage = hasError?.message;

  const selectedOption = options.find((opt) => String(opt.value) === String(value)) || null;

  const handleChange = (selected: any) => {
    onChange?.(selected ? selected.value : "", selected);
  };

  
  const menuPortalStyles = {
    menuPortal: (base: any) => ({ ...base, zIndex: 9999 }),
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold d-block">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>

      <div className="position-relative">
        {IconComponent && (
          <div
            className={`input-icon position-absolute ${
              hasError ? "text-danger" : value ? "text-success" : "text-primary"
            }`}
            style={{
              left: "10px",
              top: "50%",
              transform: "translateY(-50%)",
              zIndex: 2,
            }}
          >
            <IconComponent size={18} />
          </div>
        )}

        <Select
          options={options}
          value={selectedOption}
          onChange={handleChange}
          isDisabled={disabled}
          isMulti={isMulti}
          placeholder={placeholder}
          isClearable={isClearable}
          className={`react-select-container ${hasError ? "is-invalid" : ""}`}
          classNamePrefix="react-select"
          menuPosition="fixed" 
          menuPlacement="auto" 
          menuShouldScrollIntoView={true}
          menuPortalTarget={typeof document !== "undefined" ? document.body : undefined} 
          styles={{
            control: (base, state) => ({
              ...base,
              borderColor: hasError
                ? "#dc3545"
                : state.isFocused
                ? "#80bdff"
                : "#ced4da",
              boxShadow:
                state.isFocused && !hasError
                  ? "0 0 0 0.2rem rgba(0, 123, 255, 0.25)"
                  : "none",
              paddingLeft: IconComponent ? "40px" : "12px",
              backgroundColor: hasError ? "#fff8f8" : "white",
              minHeight: "calc(1.5em + 1rem + 2px)",
              "&:hover": {
                borderColor: hasError ? "#dc3545" : "#ced4da",
              },
            }),
            menu: (base) => ({
              ...base,
              zIndex: 9999,
              position: "absolute",
            }),
            menuPortal: (base) => ({ ...base, zIndex: 9999 }), 
            ...menuPortalStyles,
          }}
        />
      </div>

      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errorMessage}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;
