import React, { useState, useEffect } from "react";
import { Row, Col, Table, Card } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { formatDate } from "../../../../../utils/constants.ts";
import styles from "../../../../common/styles/ProvisionalCertificateOfSurvey.module.css";

const ProvisionalCertificateOfSurvey = ({ registrationData, surveyData, preFilledCertData }) => {
  const { t } = useTranslation();

  const currentDate = new Date();
  const expiryDate = new Date(currentDate.getTime() + (60 * 24 * 60 * 60 * 1000));

  // Only editable fields
  const [editableData, setEditableData] = useState({
    expiryDay: expiryDate.getDate().toString().padStart(2, '0'),
    expiryMonth: (expiryDate.getMonth() + 1).toString().padStart(2, '0'),
    expiryYear: expiryDate.getFullYear().toString(),
    certificateNo: '',
    loadingMarksOnSide: 'Yes',
    notExtendingBeyondNauticalMiles: '12',
    safetyEquipment: {
      noOfBoats: '',
      noOfBuoyantApparatus: '',
      noOfLifebuoys: '',
      noOfLifejackets: '',
      fireExtinguishersFoamType: '',
      fireExtinguishersSodaAcid: '',
      fireExtinguishersDryCarbonPowder: '',
      anchorCable: '',
      lengthSize: '',
      hose: ''
    }
  });

  useEffect(() => {
    if (preFilledCertData) {
      setEditableData(prev => ({
        ...prev,
        expiryDay: preFilledCertData.expiryDay || prev.expiryDay,
        expiryMonth: preFilledCertData.expiryMonth || prev.expiryMonth,
        expiryYear: preFilledCertData.expiryYear || prev.expiryYear,
        certificateNo: preFilledCertData.certificateNo || '',
        loadingMarksOnSide: preFilledCertData.loadingMarksOnSide || 'Yes',
        notExtendingBeyondNauticalMiles: preFilledCertData.notExtendingBeyondNauticalMiles || '12',
        safetyEquipment: {
          noOfBoats: preFilledCertData.noOfBoats || '',
          noOfBuoyantApparatus: preFilledCertData.noOfBuoyantApparatus || '',
          noOfLifebuoys: preFilledCertData.noOfLifebuoys || '',
          noOfLifejackets: preFilledCertData.noOfLifejackets || '',
          fireExtinguishersFoamType: preFilledCertData.fireExtinguishersFoamType || '',
          fireExtinguishersSodaAcid: preFilledCertData.fireExtinguishersSodaAcid || '',
          fireExtinguishersDryCarbonPowder: preFilledCertData.fireExtinguishersDryCarbonPowder || '',
          anchorCable: preFilledCertData.anchorCable || '',
          lengthSize: '',
          hose: preFilledCertData.hose || ''
        }
      }));
    }
  }, [preFilledCertData]);

  const handleInputChange = (field, value) => {
    if (field.includes('.')) {
      const [parent, child] = field.split('.');
      setEditableData(prev => ({
        ...prev,
        [parent]: {
          ...prev[parent],
          [child]: value
        }
      }));
    } else {
      setEditableData(prev => ({
        ...prev,
        [field]: value
      }));
    }
  };

  const renderField = (label, value, isEditable = false, fieldName = '', type = 'text') => {
    if (isEditable) {
      if (type === 'select') {
        return (
          <div className={styles.fieldGroup}>
            <label className={styles.fieldLabel}>{label}</label>
            <select
              className={styles.editableSelect}
              value={editableData[fieldName]}
              onChange={(e) => handleInputChange(fieldName, e.target.value)}
            >
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
          </div>
        );
      }
      return (
        <div className={styles.fieldGroup}>
          <label className={styles.fieldLabel}>{label}</label>
          <input
            type="text"
            className={styles.editableInput}
            value={editableData[fieldName]}
            onChange={(e) => handleInputChange(fieldName, e.target.value)}
            placeholder={`Enter ${label}`}
          />
        </div>
      );
    }
    
    return (
      <div className={styles.fieldGroup}>
        <label className={styles.fieldLabel}>{label}</label>
        <div className={value ? styles.autoPopulateField : styles.autoPopulateFieldEmpty}>
          {value || (
            <div className={styles.noDataIndicator}>
              <span className={styles.noDataIcon}>📋</span>
              <span>Data not available</span>
            </div>
          )}
        </div>
      </div>
    );
  };

  return (
    <div className={styles.certificateContainer}>
     

      {/* Basic Certificate Info */}
      <Card className={styles.mainCard}>
        <Card.Body>
          <Row className="g-3">
            <Col xs={12} lg={3}>
              {renderField("Category", preFilledCertData?.category)}
            </Col>
            <Col xs={12} lg={9}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Expiry on or before the")}</label>
                <div className={styles.dateInputGroup}>
                  <div className={styles.dateField}>
                    <label className={styles.dateLabel}>Day</label>
                    <input
                      type="text"
                      className={styles.dateInput}
                      value={editableData.expiryDay}
                      onChange={(e) => handleInputChange('expiryDay', e.target.value)}
                      maxLength="2"
                      placeholder="DD"
                    />
                  </div>
                  <div className={styles.dateField}>
                    <label className={styles.dateLabel}>Month</label>
                    <input
                      type="text"
                      className={styles.dateInput}
                      value={editableData.expiryMonth}
                      onChange={(e) => handleInputChange('expiryMonth', e.target.value)}
                      maxLength="2"
                      placeholder="MM"
                    />
                  </div>
                  <div className={styles.dateField}>
                    <label className={styles.dateLabel}>Year</label>
                    <input
                      type="text"
                      className={styles.dateInput}
                      value={editableData.expiryYear}
                      onChange={(e) => handleInputChange('expiryYear', e.target.value)}
                      maxLength="4"
                      placeholder="YYYY"
                    />
                  </div>
                </div>
              </div>
            </Col>
          </Row>

          <Row className="g-3 mt-2">
            <Col xs={12} lg={6}>
              {renderField("Provisional Certificate of Survey No.", editableData.certificateNo, true, 'certificateNo')}
            </Col>
            <Col xs={12} lg={6}>
              {renderField("Zone of operation", preFilledCertData?.zoneOfOperation)}
            </Col>
          </Row>

          <Row className="g-3 mt-2">
            <Col xs={12} lg={6}>
              {renderField("Date of Issue", preFilledCertData?.dateOfIssue || formatDate(currentDate))}
            </Col>
            <Col xs={12} lg={6}>
              {renderField("Date of Expiry", preFilledCertData?.dateOfExpiry || formatDate(expiryDate))}
            </Col>
          </Row>
        </Card.Body>
      </Card>

      {/* Statement */}
      <div className={styles.statementBox}>
        <p>{t("This Provisional Certificate of Survey has been issued subsequent to Survey carried out of the below detailed inland vessel.")}</p>
      </div>

      {/* Vessel Details */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("VESSEL DETAILS")}</h5>
        </Card.Header>
        <Card.Body>
          <Row className="g-3">
            <Col xs={12} md={6}>
              {renderField("Name of the Vessel", preFilledCertData?.vesselName)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Official No.", preFilledCertData?.officialNo)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Port of Registry", preFilledCertData?.portOfRegistry)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Certificate of Registry No.", preFilledCertData?.certificateOfRegistryNo)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Gross Tonnage", preFilledCertData?.grossTonnage)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Registered Tonnage", preFilledCertData?.registeredTonnage)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Freeboard Assigned", preFilledCertData?.freeboardAssigned)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Loading marks placed on the vessel's side", editableData.loadingMarksOnSide, true, 'loadingMarksOnSide', 'select')}
            </Col>
          </Row>
        </Card.Body>
      </Card>

      {/* Personnel Details */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("PERSONNEL DETAILS")}</h5>
        </Card.Header>
        <Card.Body>
          <Row className="g-3">
            <Col xs={12} md={6}>
              {renderField("Name of the Master", preFilledCertData?.masterName)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Master's COC Grade", preFilledCertData?.masterCocGrade)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("COC No.", preFilledCertData?.masterCocNo)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Place of Issue", preFilledCertData?.masterPlaceOfIssue)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Name of the Engineer or Engine Driver", preFilledCertData?.engineerName)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("COC Grade of the Engineer or Engine Driver", preFilledCertData?.engineerCocGrade)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("COC No.", preFilledCertData?.engineerCocNo)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Place of Issue", preFilledCertData?.engineerPlaceOfIssue)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Name of Owner", preFilledCertData?.ownerName)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Address of Owner", preFilledCertData?.ownerAddress)}
            </Col>
          </Row>
        </Card.Body>
      </Card>

      {/* Survey Details */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("SURVEY DETAILS")}</h5>
        </Card.Header>
        <Card.Body>
          <Row className="g-3">
            <Col xs={12} md={6}>
              {renderField("Date of Survey carried out", preFilledCertData?.dateOfSurveyCarriedOut)}
            </Col>
            <Col xs={12} md={6}>
              {renderField("Place of survey carried out", preFilledCertData?.placeOfSurveyCarriedOut)}
            </Col>
          </Row>
        </Card.Body>
      </Card>

      {/* Plying Limits */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("PLYING LIMITS (as applicable):")}</h5>
        </Card.Header>
        <Card.Body>
          <div className={styles.plyingLimitsContent}>
            <span className={styles.inlineLabel}>{t("Within inland waters limits")}:</span>
            <div className={preFilledCertData?.zoneOfOperation ? styles.autoPopulateInline : styles.autoPopulateInlineEmpty}>
              {preFilledCertData?.zoneOfOperation || (
                <div className={styles.inlineNoData}>
                  <span className={styles.noDataIcon}>🌊</span>
                  <span>Not specified</span>
                </div>
              )}
            </div>
            <span className={styles.inlineLabel}>{t("not extending beyond")}:</span>
            <input
              type="text"
              className={styles.inlineInput}
              value={editableData.notExtendingBeyondNauticalMiles}
              onChange={(e) => handleInputChange('notExtendingBeyondNauticalMiles', e.target.value)}
            />
            <span className={styles.inlineLabel}>{t("Nautical Miles from the nearest shore.")}</span>
          </div>
        </Card.Body>
      </Card>

      {/* Capacity */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("CARGO/PASSENGER CAPACITY")}</h5>
        </Card.Header>
        <Card.Body>
          <div className={styles.capacityContent}>
            <div className={styles.capacityItem}>
              <span className={styles.capacityLabel}>{t("Maximum permissible cargo carriage capacity")}:</span>
              <div className={preFilledCertData?.cargoCapacity ? styles.capacityValue : styles.capacityValueEmpty}>
                {preFilledCertData?.cargoCapacity || (
                  <div className={styles.capacityNoData}>
                    <span className={styles.noDataIcon}>📦</span>
                    <span>Not specified</span>
                  </div>
                )}
              </div>
            </div>
            <div className={styles.capacityItem}>
              <span className={styles.capacityLabel}>{t("Passengers")}:</span>
              <div className={preFilledCertData?.passengerCapacity ? styles.capacityValue : styles.capacityValueEmpty}>
                {preFilledCertData?.passengerCapacity || (
                  <div className={styles.capacityNoData}>
                    <span className={styles.noDataIcon}>👥</span>
                    <span>Not specified</span>
                  </div>
                )}
              </div>
            </div>
            <div className={styles.capacityItem}>
              <span className={styles.capacityLabel}>{t("Crew")}:</span>
              <div className={preFilledCertData?.crewCapacity ? styles.capacityValue : styles.capacityValueEmpty}>
                {preFilledCertData?.crewCapacity || (
                  <div className={styles.capacityNoData}>
                    <span className={styles.noDataIcon}>⚓</span>
                    <span>Not specified</span>
                  </div>
                )}
              </div>
            </div>
          </div>
        </Card.Body>
      </Card>

      {/* Safety Equipment */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("Safety equipment carried on the vessel:")}</h5>
        </Card.Header>
        <Card.Body>
          <div className="table-responsive">
            <Table className={styles.safetyTable}>
              <thead>
                <tr>
                  <th rowSpan="2" className={styles.mainHeader}>
                    {t("No. of boats size and cubic capacity")}
                  </th>
                  <th rowSpan="2" className={styles.mainHeader}>
                    {t("No. of Buoyant apparatus or Life rafts")}
                  </th>
                  <th colSpan="2" className={styles.groupHeader}>
                    {t("No. of Lifebuoys and lifejackets")}
                  </th>
                  <th colSpan="3" className={styles.groupHeader}>
                    {t("Fire extinguishers")}
                  </th>
                  <th colSpan="3" className={styles.groupHeader}>
                    {t("No. of Anchor with their weight")}
                  </th>
                </tr>
                <tr>
                  <th className={styles.subHeader}>{t("Lifebuoys")}</th>
                  <th className={styles.subHeader}>{t("Lifejackets")}</th>
                  <th className={styles.subHeader}>{t("Foam Type")}</th>
                  <th className={styles.subHeader}>{t("Soda Acid")}</th>
                  <th className={styles.subHeader}>{t("Dry Carbon Powder")}</th>
                  <th className={styles.subHeader}>{t("Anchor Cable")}</th>
                  <th className={styles.subHeader}>{t("Length Size")}</th>
                  <th className={styles.subHeader}>{t("Hose")}</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  {Object.entries(editableData.safetyEquipment).map(([key, value], index) => (
                    <td key={index} className={styles.inputCell}>
                      {value ? (
                        <input
                          type="text"
                          className={styles.tableInput}
                          value={value}
                          onChange={(e) => handleInputChange(`safetyEquipment.${key}`, e.target.value)}
                        />
                      ) : (
                        <div className={styles.tableNoDataCell}>
                          <span className={styles.noDataIcon}>🔍</span>
                          <input
                            type="text"
                            className={styles.tableInput}
                            value={value}
                            onChange={(e) => handleInputChange(`safetyEquipment.${key}`, e.target.value)}
                            placeholder="Enter value"
                          />
                        </div>
                      )}
                    </td>
                  ))}
                </tr>
              </tbody>
            </Table>
          </div>
        </Card.Body>
      </Card>

      {/* Certificate Statement */}
      <div className={styles.certificationBox}>
        <h6 className={styles.certificationTitle}>{t("THIS IS TO CERTIFY")}</h6>
        <p className={styles.certificationText}>
          {t("that the provisions of the rules with respect to the survey of the above mentioned Inland Vessel and the Transmission of declaration in respect thereof, have been complied with.")}
        </p>
      </div>

      {/* Validity Statement */}
      <div className={styles.validityBox}>
        <p>
          {t("This Provisional Certificate of Survey, issued under the provisions of section 13(1) of the Inland Vessels Act, 2021 continues to be in force only until the")} 
          <strong> ({editableData.expiryDay}-{editableData.expiryMonth}-{editableData.expiryYear})</strong>
        </p>
      </div>
    </div>
  );
};

export default ProvisionalCertificateOfSurvey;
table design do that better not use any search icon in table
and do that simple form
this is very odd looking

.certificateContainer {
  max-width: 1200px;
  margin: 0 auto;
  padding: 30px;
  background: #f9fafb;
  font-family: 'Segoe UI', 'Roboto', sans-serif;
  color: #1f2937;
  line-height: 1.5;
}

.certificateHeader {
  text-align: center;
  margin-bottom: 30px;
  padding: 30px;
  background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
  color: white;
  border-radius: 12px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

.certificateTitle {
  font-size: 2.2rem;
  font-weight: 700;
  margin: 0;
  letter-spacing: 1px;
}

.subtitle {
  margin: 12px 0 0 0;
  font-size: 1.1rem;
  opacity: 0.9;
  font-weight: 300;
}

.mainCard, .detailsCard {
  margin-bottom: 25px;
  border: none;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.06);
  border-radius: 10px;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.mainCard:hover, .detailsCard:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
}

.cardHeader {
  background: linear-gradient(135deg, #374151 0%, #4b5563 100%);
  color: white;
  border-bottom: none;
  padding: 18px 25px;
}

.cardHeader h5 {
  margin: 0;
  font-weight: 600;
  font-size: 1.1rem;
  letter-spacing: 0.5px;
}

.fieldGroup {
  margin-bottom: 20px;
}

.fieldLabel {
  display: block;
  font-weight: 600;
  color: #374151;
  margin-bottom: 8px;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.autoPopulateField {
  padding: 12px 15px;
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  color: #111827;
  font-weight: 500;
  min-height: 45px;
  display: flex;
  align-items: center;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.autoPopulateFieldEmpty {
  padding: 12px 15px;
  background: #f9fafb;
  border: 1px dashed #d1d5db;
  border-radius: 8px;
  min-height: 45px;
  display: flex;
  align-items: center;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.noDataIndicator {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #6b7280;
  font-style: italic;
}

.noDataIcon {
  font-size: 1.1rem;
}

.editableInput, .editableSelect {
  width: 100%;
  padding: 12px 15px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-size: 0.9rem;
  transition: all 0.2s ease;
  background: white;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.editableInput:focus, .editableSelect:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
}

.dateInputGroup {
  display: flex;
  gap: 15px;
  align-items: end;
}

.dateField {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.dateLabel {
  font-size: 0.8rem;
  font-weight: 600;
  color: #6b7280;
}

.dateInput {
  width: 80px;
  padding: 10px;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  text-align: center;
  font-weight: 600;
  font-size: 0.9rem;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.dateInput:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
}

.statementBox {
  background: white;
  padding: 25px;
  border-radius: 10px;
  margin: 25px 0;
  border-left: 4px solid #3b82f6;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.06);
}

.plyingLimitsContent {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  padding: 15px;
  background: #f9fafb;
  border-radius: 8px;
}

.inlineLabel {
  font-weight: 600;
  color: #374151;
}

.autoPopulateInline {
  background: white;
  padding: 8px 12px;
  border-radius: 6px;
  border: 1px solid #e5e7eb;
}

.autoPopulateInlineEmpty {
  background: #f9fafb;
  padding: 8px 12px;
  border-radius: 6px;
  border: 1px dashed #d1d5db;
}

.inlineNoData {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #6b7280;
  font-style: italic;
  font-size: 0.85rem;
}

.inlineInput {
  width: 100px;
  padding: 8px 12px;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.inlineInput:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
}

.capacityContent {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.capacityItem {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px;
  background: white;
  border-radius: 8px;
  border: 1px solid #e5e7eb;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.capacityLabel {
  font-weight: 600;
  color: #374151;
  flex: 1;
}

.capacityValue {
  font-weight: 700;
  color: #059669;
  min-width: 120px;
  text-align: right;
  padding: 8px 12px;
  background: #f0fdf4;
  border-radius: 6px;
}

.capacityValueEmpty {
  min-width: 120px;
  text-align: right;
  padding: 8px 12px;
  background: #f9fafb;
  border-radius: 6px;
  border: 1px dashed #d1d5db;
}

.capacityNoData {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #6b7280;
  font-style: italic;
}

/* Safety Table Styles */
.safetyTable {
  margin: 0;
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.06);
  background: white;
  width: 100%;
  min-width: 1200px;
}

.mainHeader {
  background: linear-gradient(135deg, #374151 0%, #4b5563 100%);
  color: white;
  font-weight: 700;
  padding: 18px 12px;
  text-align: center;
  border: none;
  font-size: 0.85rem;
  line-height: 1.3;
  vertical-align: middle;
}

.groupHeader {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: white;
  font-weight: 600;
  padding: 14px 10px;
  text-align: center;
  border: none;
  font-size: 0.8rem;
  line-height: 1.2;
}

.subHeader {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: white;
  font-weight: 600;
  padding: 12px 8px;
  text-align: center;
  border: none;
  font-size: 0.75rem;
  line-height: 1.2;
  min-width: 90px;
}

.inputCell {
  padding: 15px 10px;
  text-align: center;
  border: 1px solid #f3f4f6;
  background: #f9fafb;
  vertical-align: middle;
}

.inputCell:hover {
  background: #f3f4f6;
}

.tableNoDataCell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.tableInput {
  width: 100%;
  max-width: 130px;
  padding: 10px 12px;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  text-align: center;
  font-size: 0.85rem;
  font-weight: 500;
  background: white;
  transition: all 0.2s ease;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.tableInput:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
}

.tableInput::placeholder {
  color: #9ca3af;
  font-size: 0.8rem;
}

.certificationBox {
  background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
  color: white;
  padding: 30px;
  border-radius: 10px;
  margin: 30px 0 25px 0;
  text-align: center;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

.certificationTitle {
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 18px;
  color: #e0e7ff;
  letter-spacing: 1px;
}

.certificationText {
  margin: 0;
  line-height: 1.6;
  font-size: 1rem;
  font-weight: 300;
}

.validityBox {
  background: #f0fdf4;
  border: 2px solid #10b981;
  padding: 25px;
  border-radius: 10px;
  text-align: center;
  margin-top: 25px;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.06);
}

.validityBox p {
  margin: 0;
  font-weight: 600;
  color: #065f46;
  font-size: 1rem;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .safetyTable {
    min-width: 1000px;
  }
  
  .mainHeader, .groupHeader {
    font-size: 0.8rem;
    padding: 14px 8px;
  }
  
  .subHeader {
    font-size: 0.7rem;
    padding: 10px 6px;
  }
  
  .dateInputGroup {
    flex-wrap: wrap;
    gap: 10px;
  }
}

@media (max-width: 768px) {
  .certificateContainer {
    padding: 15px;
  }
  
  .certificateTitle {
    font-size: 1.8rem;
  }
  
  .safetyTable {
    min-width: 900px;
  }
  
  .mainHeader, .groupHeader, .subHeader {
    font-size: 0.65rem;
    padding: 10px 4px;
  }
  
  .tableInput {
    max-width: 90px;
    padding: 8px 10px;
    font-size: 0.8rem;
  }
  
  .plyingLimitsContent {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  
  .capacityItem {
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }
  
  .capacityValue, .capacityValueEmpty {
    text-align: center;
  }
  
  .dateInputGroup {
    justify-content: center;
  }
}

@media (max-width: 576px) {
  .certificateHeader {
    padding: 20px 15px;
  }
  
  .certificateTitle {
    font-size: 1.5rem;
  }
  
  .inputCell {
    padding: 10px 6px;
  }
  
  .tableInput {
    max-width: 70px;
    padding: 6px 8px;
    font-size: 0.75rem;
  }
  
  .certificationBox {
    padding: 20px 15px;
  }
  
  .validityBox {
    padding: 20px 15px;
  }
  
  .dateInput {
    width: 60px;
    padding: 8px;
  }
  
  .inlineInput {
    width: 80px;
  }
}

@media (max-width: 480px) {
  .safetyTable {
    min-width: 700px;
  }
  
  .capacityContent {
    gap: 10px;
  }
  
  .capacityItem {
    padding: 12px;
  }
}

