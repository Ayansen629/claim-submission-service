const generateVesselData = (count = 20) => {
  const vesselNames = [
    "MA  Durga",
    "MA  Annapurna",
    "MA  Saraswati",
    "MA  Jagadhatri",
    "MV  Rocket",
    "MV  Kanchan",
    "MV  Rabindra Nath Tagore",
    "MV  ICHASAKTI",
    "MV  ALOR RANI",
    "MV  MAHESHKANYA",
  ];

  const vesselTypes = ["Passenger", "Non-Passenger", "Cargo", "RO-RO"];

  return Array.from({ length: count }, (_, i) => {
    const yearIN = 2015 + Math.floor(Math.random() * 11); // 2015 - 2025

    const registeredYear = new Date(
      yearIN + Math.floor(Math.random() * 10), // survey after registration
      Math.floor(Math.random() * 12),
      Math.floor(Math.random() * 28) + 1
    )
      .toISOString()
      .split("T")[0];

    const lastSurveyDate = new Date(
      new Date(registeredYear).getFullYear() + Math.floor(Math.random() * 10), // survey after registration
      Math.floor(Math.random() * 12),
      Math.floor(Math.random() * 28) + 1
    )
      .toISOString()
      .split("T")[0];

    return {
      id: i + 1,
      registrationNo: `WB${String(1000 + i).padStart(4, "0")}`,
      vesselName: vesselNames[Math.floor(Math.random() * vesselNames.length)],
      registeredYear,
      lastSurveyDate,
      vesselType: vesselTypes[Math.floor(Math.random() * vesselTypes.length)],
    };
  });
};

const VesselOwner = ({ userDetails, userRole }) => {
  //   const tabs = Array.from({ length: 8 }, (_, i) => ({
