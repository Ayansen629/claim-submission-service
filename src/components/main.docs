const INBOX_COLUMNS = [
  {
    colName: "Application No",
    fieldName: "appNo",
    clsName: "column-text-start",
  },
  {
    colName: "Application Type",
    fieldName: "appType",
    clsName: "column-text-start",
  },
  {
    colName: "Vessel Owner",
    fieldName: "owner",
    clsName: "column-text-start",
  },
  {
    colName: "Vessel No",
    fieldName: "vesselNo",
    clsName: "column-text-start",
  },
  {
    colName: "Date of Submission",
    fieldName: "date",
    clsName: "column-text-start",
  },
  {
    colName: "Status",
    fieldName: "status",
    clsName: "column-text-start",
    render: (value) => (
      <span className={`status-badge ${value.toLowerCase()}`}>{value}</span>
    ),
  },
   {
      colName: "Action",
      fieldName: "action",
      actions: ['view', 
        // 'edit'
      ],
      clsName: "col-sm-2 column-text-start actions-column",
    },
];

const OfficerRoleDashboard = () => {
  const statData = [
    {
      title: "Registration",
      value: 12,
      icon: BsPersonBadge,
      color: "#1251a6",
      bgColor: "rgba(18, 81, 166, 0.1)",
    },
    {
      title: "Survey",
      value: 24,
      icon: MdOutlineAssignment,
      color: "#28a745",
      bgColor: "rgba(40, 167, 69, 0.1)",
    },
    {
      title: "Manning/Training & Certification",
      value: 7,
      icon: FaUserGraduate,
      color: "#902424",
      bgColor: "rgba(144, 36, 36, 0.1)",
    },
    // {
    //   title: "View Application",
    //   value: "",
    //   icon: FaRegEye,
    //   color: "#2466BF",
    //   bgColor: "rgba(36, 102, 191, 0.08)",
    // },
  ];

  const generateInboxData = () => {
    const statuses = ["Pending", "Completed", "Processing", "Rejected"];
    const appTypes = [
      "Registration",
      "Survey",
      "Manning",
      "Certification",
      "Training",
    ];
    const owners = [
      "John Doe",
      "Jane Smith",
      "Robert Johnson",
      "Emily Davis",
      "Michael Wilson",
    ];

    return Array.from({ length: 20 }, (_, i) => ({
      id: i + 1,
      appNo: `APP-2025-${(i + 1).toString().padStart(3, "0")}`,
      appType: appTypes[Math.floor(Math.random() * appTypes.length)],
      owner: owners[Math.floor(Math.random() * owners.length)],
      vesselNo: `WB${1420 + i}`,
      date: new Date(
        2025,
        Math.floor(Math.random() * 12),
        Math.floor(Math.random() * 28) + 1
      )
        .toISOString()
        .split("T")[0],
      status: statuses[Math.floor(Math.random() * statuses.length)],
    }));
  };

  // State for inbox data and pagination
  const [inboxData, setInboxData] = useState([]);
  const [filteredData, setFilteredData] = useState([]);
  const [currentPage, setCurrentPage] = useState(1);
  const [searchTerm, setSearchTerm] = useState("");
  const itemsPerPage = 5;

  // Initialize data
  useEffect(() => {
    const data = generateInboxData();
    setInboxData(data);
    setFilteredData(data);
  }, []);

  // Handle search
  useEffect(() => {
    const results = inboxData.filter(
      (item) =>
        item.appNo.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.appType.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.owner.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.vesselNo.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.status.toLowerCase().includes(searchTerm.toLowerCase())
    );
    setFilteredData(results);
    setCurrentPage(1);
  }, [searchTerm, inboxData]);

  // Pagination handler for ActionTable
  const handleTablePageChange = (page) => {
    setCurrentPage(page);
  };

  const navigate = useNavigate();

  return (
    <>
      <WelcomeBox
        userName="Welcome John"
        desc="Here's your Dashboard overview."
      />

      <Card className="bg-transparent mb-4 dashboard-card">
        <Card.Header className="dashboard-card-header">My WorkDesk

          <div style={{ float: 'right', width: 180 }}>
            <button className="generic-btn-submit" type="button" onClick={() => navigate('/dashboard/employee-dashboard/employee-applications')}>
              View Applications &nbsp; <FaUsersBetweenLines size={15} color={'#fff'} />
            </button>
          </div>
        </Card.Header>
      </Card>


      <div className="row g-3" style={{ paddingLeft: '1rem', paddingRight: '1rem' }}>
        {statData.map((item, index) => (
          <div className="col-md-4 col-lg-3 col-sm-12" key={index}>
            <StatusCard {...item} />
          </div>
        ))}
      </div>

      <Card className="bg-transparent mt-4 dashboard-card">
        <Card.Header
          style={headerStyle}
          className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
        >
          <div className="d-flex align-items-center">
            <h5 className="mb-0 me-2">Inbox</h5>
            <span className="badge bg-primary rounded-pill">
              {filteredData.length}
            </span>
          </div>
          <div className="d-flex align-items-center">
            <Button variant="outline-secondary" className="filter-btn me-2">
              <BsFilter size={18} />
              <span className="ms-1 d-none d-sm-inline">Filter</span>
            </Button>
            <Form className="inbox-search">
              <InputGroup>
                <Form.Control
                  type="text"
                  placeholder="Search inbox..."
                  aria-label="Search inbox"
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                />
                <Button variant="primary">
                  <BsSearch />
                </Button>
              </InputGroup>
            </Form>
          </div>
        </Card.Header>
        <div style={{ position: 'relative', 'bottom': '2rem', }}>
          <ActionTable
            columns={INBOX_COLUMNS}
            rowData={filteredData}
            tableHeader={null}
            hideExportBtn={true}
            hideSearchBar={true}
            pagination={true}
            currentPage={currentPage}
            itemsPerPage={itemsPerPage}
            onPageChange={handleTablePageChange}
            onViewRow={handleOnViewRow}
            noDataText={
              <div className="no-results text-center py-4">
                <BsSearch size={24} className="mb-2" />
                <p>No results found</p>
                <small>
                  Try adjusting your search to find what you're looking for.
                </small>
              </div>
            }
          />
        </div>
      </Card>
    </>
  );
};

export default OfficerRoleDashboard;


import React from 'react';
import { FaUser, FaIdCard, FaEnvelope, FaPhone, FaMapMarkerAlt } from 'react-icons/fa';
import { CONSTANT_REGEX } from '../../utils/constants.ts';

const createFormFieldsConfig = (getDetailsByPIN) => {
  return {
    step1: [
      {
        name: 'firstName',
        label: 'First Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 80,
        placeholder: "Enter Builder's First name",
        validation: { required: 'First name is required' }
      },
      {
        name: 'lastName',
        label: 'Last Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 80,
        placeholder: "Enter Builder's Last name",
        validation: { required: 'Last name is required' }
      },
      {
        name: 'emailId',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: {
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      {
        name: 'phoneNumber',
        label: 'Phone Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        maxlength: 10,
        placeholder: 'Enter 10-digit phone number',
        validation: {
          required: 'Phone number is required (10 digits)',
          pattern: {
            value: CONSTANT_REGEX.MOBILE,
            message: 'Please enter a valid Phone number'
          }
        },
      },
      {
        name: 'panNumber',
        label: 'PAN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        maxlength: 10,
        placeholder: 'Enter PAN number (e.g., ABCDE1234F)',
        validation: {
          required: 'PAN number is required',
          pattern: {
            value: CONSTANT_REGEX.PAN,
            message: 'Invalid PAN number'
          }
        }
      },
      {
        name: 'gstNumber',
        label: 'GST Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter GST number',
        maxlength: 15,
        validation: {
          required: 'GST number is required',
          pattern: {
            value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
            message: 'Invalid GST No.'
          }
        }
      },
      {
        name: 'addressLine1',
        label: 'Address Line-1',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 100,
        placeholder: 'Enter address line 1',
        validation: { required: 'Address is required' }
      },
      {
        name: 'addressLine2',
        label: 'Address Line-2',
        type: 'text',
        required: false,
        maxlength: 100,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 2 (optional)'
      },
      {
        name: 'pin',
        label: 'PIN',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 6,
        placeholder: 'Enter 6-digit PIN code',
        validation: {
          required: 'PIN code is required',
          pattern: {
            value: /^[0-9]{6}$/,
            message: 'PIN must be 6 digits'
          }
        },
        onChange: (e, setValue, watch) => {
          const changedValue = e?.target?.value || "";
          if (changedValue?.length === 6) {
            setValue('district', '');
            setValue('stateUt', '');
            setValue('country', 'India');
            getDetailsByPIN(changedValue);
          }
        },
      },
      {
        name: 'district',
        label: 'District',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter district',
      },
      {
        name: 'stateUt',
        label: 'State / UT',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter state',
      },
      {
        name: 'country',
        label: 'Country',
        type: 'text',
        required: false,
        disabled: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter country',
      }
    ],
    step2: [
      {
        name: 'addressProof',
        label: 'Address Proof',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'panCardUpload',
        label: 'PAN Card',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'gstCertificate',
        label: 'GST Certificate',
        type: 'file',
        required: false,
        colSize: 6,
      }
    ]
  };
};

export default createFormFieldsConfig;
