.dashboard-card, .status-card {
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(36, 102, 191, 0.07);
  border: none;
  background: #fff;
  min-height: 160px;
  transition: box-shadow 0.2s;
}
.dashboard-card:hover, .status-card:hover {
  box-shadow: 0 4px 16px rgba(36, 102, 191, 0.15);
}
.status-badge {
  display: inline-block;
  padding: 0.25em 0.75em;
  border-radius: 12px;
  background: #f0ad4e;
  color: #fff;
  font-size: 0.95em;
  font-weight: 500;
}
.status-badge.completed {
  background: #28a745;
}

@media (max-width: 767px) {
  .dashboard-card, .status-card {
    min-height: 120px;
    margin-bottom: 1rem;
  }
}



@media (min-width: 768px) {
  .my-3.d-flex.justify-content-end {
    margin-bottom: 0 !important;
  }
}

import React from 'react';
import WelcomeBox from '../../common/WelcomeBox';
import StatusCard from '../../common/StatusCard';
import { Card, Table, Form, InputGroup, Button } from 'react-bootstrap';
import { BsPersonBadge, BsClipboardData, BsShieldCheck, BsSearch } from 'react-icons/bs';
import { FaUserGraduate } from 'react-icons/fa';
import './employeeDashboard.css';
import { headerStyle } from '../../../utils/constants.ts';

const EmployeeDashboard = () => {
  const statData = [
    { title: 'Registration', value: 12, icon: BsPersonBadge, color: '#1251a6' },
    { title: 'Survey', value: 24, icon: BsClipboardData, color: '#28a745' },
    { title: 'Manning/Training & Certification', value: 7, icon: FaUserGraduate, color: '#902424' },
  ];

  const inboxData = [
    {
      appNo: 'APP-2025-001',
      appType: 'Registration',
      owner: 'John Doe',
      vesselNo: 'WB1423',
      date: '2025-05-22',
      status: 'Pending',
    },
    {
      appNo: 'APP-2025-002',
      appType: 'Survey',
      owner: 'Jane Smith',
      vesselNo: 'WB1424',
      date: '2025-05-20',
      status: 'Completed',
    },
  ];

  return (
    <>
      <WelcomeBox userName="Welcome John" desc="Here’s your Dashboard overview." />

      <Card className="bg-transparent mb-4">
        <Card.Header style={headerStyle}>My WorkDesk</Card.Header>
        <Card.Body>
          <div className="row g-3">
            {statData.map((item, idx) => (
             <div className="col-6 col-md-4 col-lg-3" key={idx}>
                <StatusCard
                  title={item.title}
                  value={item.value}
                  icon={item.icon}
                  color={item.color}
                  subtitle="Total Application"
                />
              </div>
            ))}
          </div>
        </Card.Body>
      </Card>

      <SearchBar />

      <Card className="bg-transparent mt-4">
        <Card.Header style={headerStyle}>Inbox</Card.Header>
        <Table responsive="md" striped bordered hover className="custom-vessel-table mb-0">
          <thead>
            <tr className="custom-header">
              <th>Application No</th>
              <th>Application Type</th>
              <th>Vessel Owner</th>
              <th>Vessel No</th>
              <th>Date of Submission</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {inboxData.map((row, idx) => (
              <tr key={row.appNo}>
                <td>{row.appNo}</td>
                <td>{row.appType}</td>
                <td>{row.owner}</td>
                <td>{row.vesselNo}</td>
                <td>{row.date}</td>
                <td>
                  <span className={`status-badge${row.status === 'Completed' ? ' completed' : ''}`}>
                    {row.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </Table>
      </Card>
    </>
  );
};

const SearchBar = () => (
  <Form className="my-3 d-flex justify-content-end">
    <InputGroup size="sm" style={{ maxWidth: 260 }}>
      <Form.Control
        type="text"
        placeholder="Search Application…"
        aria-label="Search"
      />
      <Button variant="primary">
        <BsSearch />
      </Button>
    </InputGroup>
  </Form>
);

export default EmployeeDashboard;
