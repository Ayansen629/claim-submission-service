import React, { useEffect, useState } from "react";
import { useTranslation } from "react-i18next";
import { Link, useLocation } from "react-router-dom";
import {
  FaHome,
  FaCog,
  FaChevronRight,
  FaShip,
  FaDatabase,
  FaTimes,
  FaClipboardCheck,
  FaAnchor,
  FaIdBadge,
  FaBell,
  FaChartBar,
  FaBalanceScale,
  FaGavel,
  FaMoneyCheckAlt,
  FaBoxes,
  FaDrawPolygon,
} from "react-icons/fa";
import styles from "./Sidebar.module.css";

// Constants for user roles
const USER_ROLES = {
  ADMIN: "admin",
  OFFICER_L1: "officer_l1",
  OFFICER_L2: "officer_l2",
  OFFICER_L3: "officer_l3",
  OFFICER_L4: "officer_l4",
  OFFICER_L5: "officer_l5",
};

const Sidebar = ({ isSidebarOpen, onMenuClick, onClose, userRole }) => {
  const { t } = useTranslation();
  const location = useLocation();
  const [activeMenu, setActiveMenu] = useState("");
  const [expandedMenus, setExpandedMenus] = useState({});
  const [animatingMenus, setAnimatingMenus] = useState({});

  // Menu configuration
  const commonDashboard = {
    name: "dashboard",
    label: t("Dashboard"),
    icon: <FaHome />,
    path: "/dashboard",
  };

  const vesselRegistrationMenu = {
    name: "vessel-registration",
    label: t("Registration of Vessel"),
    path: "/vessel-registration/new-vessel",
    icon: <FaAnchor />,
    subMenu: [
      { name: "new-vessel", label: t("New Vessel"), path: "/vessel-registration/new-vessel" },
      {
        name: "existing-vessel",
        label: t("Existing Vessel"),
        icon: <FaShip />,
        subMenu: [
          { name: "name-change", label: t("Name Change of Vessel"), path: "/vessel-registration/name-change" },
          { name: "alteration", label: t("Registration for Alteration/Modification"), path: "/vessel-registration/alteration" },
          { name: "transfer-registry", label: t("Transfer of Registry"), path: "/vessel-registration/transfer-registry" },
          { name: "transfer-vessel", label: t("Transfer of Inland Vessel"), path: "/vessel-registration/transfer-vessel" },
          { name: "cancellation", label: t("Cancellation of Registration"), path: "/vessel-registration/cancellation" },
          { name: "mortgage", label: t("Registration for Mortgage"), path: "/vessel-registration/mortgage" },
          { name: "deregistration", label: t("De-registration for Mortgage"), path: "/vessel-registration/deregistration" },
          { name: "mortgage-transfer", label: t("Transfer for Mortgage"), path: "/vessel-registration/mortgage-transfer" },
          { name: "duplicate-cert", label: t("Duplicate Registration Certificate"), path: "/vessel-registration/duplicate-cert" },
        ]
      },
      { name: "upload-legacy-data", label: t("Upload Legacy Data"), path: "/vessel-registration/upload-legacy-data" },
    ],
  };

  const surveyMenu = {
    name: "vessel-survey",
    label: t("Survey of Vessel"),
    path: "/vessel-survey/annual-survey",
    icon: <FaClipboardCheck />,
    subMenu: [
      { name: "annual-survey", label: t("Annual survey"), path: "/vessel-survey/annual-survey" },
      { name: "renewal-survey", label: t("Renewal Survey"), path: "/vessel-survey/renewal-survey" },
      { name: "extension-cert", label: t("Extension of Survey Certificate"), path: "/vessel-survey/extension-cert" },
      { name: "name-change-cert", label: t("Name change in Survey Certificate"), path: "/vessel-survey/name-change-cert" },
      { name: "state-inspection", label: t("State Inspection"), path: "/vessel-survey/state-inspection" },
      { name: "accident-survey", label: t("Additional Survey for Vessel Accident"), path: "/vessel-survey/accident-survey" }
    ],
  };

  const masterMenu = {
    name: "master",
    label: t("Master"),
    icon: <FaDatabase />,
    subMenu: [
      { name: "manage-employee", label: t("Employee Management"), path: "/master/employee-management" },
    ],
  };

  const settingsItem = {
    name: "settings",
    label: t("Settings"),
    icon: <FaCog />,
    subMenu: [
      { name: "profile", label: t("Profile"), path: "/settings/profile" },
      { name: "security", label: t("Security"), path: "/settings/security" },
    ],
  };

  const officerCommonItems1 = [
    {
      name: "vessel-registration",
      label: t("Vessel Registration"),
      icon: <FaShip />,
      path: "/officer/vessel-registration"
    },
    {
      name: "survey-management",
      label: t("Survey Management"),
      icon: <FaClipboardCheck />,
      subMenu: [
        { name: "schedule-survey", label: t("Schedule Survey"), path: "/officer/schedule-survey" },
        { name: "survey-history", label: t("Survey History"), path: "/officer/survey-history" },
      ],
    },
    {
      name: "manning-certification",
      label: t("Manning & Certification"),
      icon: <FaIdBadge />,
      subMenu: [
        { name: "certification", label: t("Certification"), path: "/officer/certification" },
      ],
    },
  ];

  const officerCommonItems2 = [
    {
      name: "mis-reports",
      label: "MIS Reports",
      icon: <FaChartBar />,
      subMenu: [
        { name: "vessel-report", label: "Vessel Reports", path: "/officer/vessel-reports" },
        { name: "survey-report", label: "Survey Reports", path: "/officer/survey-reports" },
      ],
    },
    {
      name: "notifications",
      label: "Notifications",
      icon: <FaBell />,
      subMenu: [
        { name: "send-notification", label: "Send Notification", path: "/officer/send-notification" },
        { name: "notification-history", label: "Notification History", path: "/officer/notification-history" },
      ],
    },
  ];

  const commonDrawings = {
    name: "drawing-approvals",
    label: "Approvals of Drawings",
    icon: <FaDrawPolygon />,
    path: "/drawing-approvals",
  };

  const DRAItems = [
    {
      name: "grievance-redressal",
      label: "Grievance Redressal",
      icon: <FaBalanceScale />,
      path: "/dra/grievance-redressal"
    },
    {
      name: "offences-penalties",
      label: "Offences & Penalties",
      icon: <FaGavel />,
      path: "/dra/offences-penalties"
    },
    {
      name: "financial-dashboard",
      label: "Financial Dashboard",
      icon: <FaMoneyCheckAlt />,
      path: "/dra/financial-dashboard"
    },
    {
      name: "inventory-procurement",
      label: "Inventory & Procurement",
      icon: <FaBoxes />,
      path: "/dra/inventory-procurement"
    },
  ];

  const getRoleSpecificMenuItems = () => {
    switch (userRole) {
      case USER_ROLES.ADMIN:
        return [commonDashboard, masterMenu];
      case USER_ROLES.OFFICER_L1:
      case USER_ROLES.OFFICER_L2:
        return [commonDashboard, ...officerCommonItems1, ...officerCommonItems2];
      case USER_ROLES.OFFICER_L3:
      case USER_ROLES.OFFICER_L4:
        return [commonDashboard, ...officerCommonItems1, commonDrawings, ...officerCommonItems2];
      case USER_ROLES.OFFICER_L5:
        return [commonDashboard, ...officerCommonItems1, ...DRAItems, masterMenu, ...officerCommonItems2];
      default:
        return [commonDashboard, vesselRegistrationMenu, surveyMenu];
    }
  };

  const menuItems = [...getRoleSpecificMenuItems(), settingsItem];

  useEffect(() => {
    const findActiveMenuName = (items) => {
      for (const item of items) {
        if (item.path === location.pathname) return item.name;
        if (item.subMenu) {
          const result = findActiveMenuName(item.subMenu);
          if (result) return item.name;
        }
      }
      return "";
    };
    setActiveMenu(findActiveMenuName(menuItems));
  }, [location, menuItems]);

  const toggleSubMenu = (menuName) => {
    if (animatingMenus[menuName]) return;
    
    setAnimatingMenus(prev => ({ ...prev, [menuName]: true }));
    
    setExpandedMenus((prev) => ({
      ...prev,
      [menuName]: !prev[menuName],
    }));
    
    setTimeout(() => {
      setAnimatingMenus(prev => ({ ...prev, [menuName]: false }));
    }, 500);
  };

  const SidebarItem = ({ item, depth = 0 }) => {
    const isActive = activeMenu === item.name;
    const hasSubMenu = !!item.subMenu;
    const isExpanded = !!expandedMenus[item.name];
    const isAnimating = !!animatingMenus[item.name];

    return (
      <li 
        className={`${styles.item} ${isActive ? styles.itemActive : ""}`}
        style={{
          '--depth': depth,
          '--delay': `${depth * 50}ms`
        }}
      >
        <div
          className={styles.link}
          onClick={() => {
            if (hasSubMenu) toggleSubMenu(item.name);
            else onMenuClick(item.name);
          }}
          aria-expanded={isExpanded}
        >
          <div className={styles.linkContent}>
            {item.icon && <span className={styles.icon}>{item.icon}</span>}
            <span className={styles.linkLabel}>{item.label}</span>
          </div>
          {hasSubMenu && isSidebarOpen && (
            <span 
              className={`${styles.chevron} ${isExpanded ? styles.rotate : ""}`}
              style={{ transitionDelay: `calc(${depth * 50}ms + 50ms)` }}
            >
              <FaChevronRight size={12} />
            </span>
          )}
        </div>
        {hasSubMenu && (
          <div 
            className={`${styles.submenu} ${isExpanded && isSidebarOpen ? styles.expanded : ""}`}
            style={{
              transitionDelay: `${depth * 30}ms`,
              marginLeft: `${8 + (depth * 4)}px`
            }}
          >
            <ul className={styles.submenuList}>
              {item.subMenu.map((sub, index) => (
                <SidebarItem 
                  key={`${sub.name}-${index}`}
                  item={sub} 
                  depth={depth + 1}
                />
              ))}
            </ul>
          </div>
        )}
      </li>
    );
  };

  return (
    <>
      <div className={`${styles.sidebar} ${isSidebarOpen ? styles.expanded : styles.collapsed}`}>
        <div className={styles.close}>
          <FaTimes onClick={onClose} />
        </div>
        <ul className={styles.menu}>
          {menuItems.map((item, index) => (
            <SidebarItem 
              key={`${item.name}-${index}`}
              item={item} 
              depth={0} 
            />
          ))}
        </ul>
      </div>
      {!isSidebarOpen && (
        <div className={styles.backdrop} onClick={onClose} />
      )}
    </>
  );
};

export default Sidebar;
