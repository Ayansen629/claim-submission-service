import React, { useEffect, useCallback } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip"; 
import "./StepFirst.css";

const StepFirst = ({ provideSubmitHandler, formData }) => {
  // Get user data from localStorage safely
  const userFormData = JSON.parse(localStorage.getItem("userFormData")) || {};
  const hasCreditorName = !!userFormData?.claimantName;
  const hasDebtorName = !!userFormData?.corporateDebtorName;

  const methods = useForm({
    defaultValues: {
      CreditorName: userFormData?.claimantName || "",
      debtorName: userFormData?.corporateDebtorName || "",
      // Set default identification values if available in userDetails
      identificationType: userFormData?.userDetails?.aadharNumber ? "Aadhar" : 
                         userFormData?.userDetails?.panNumber ? "PAN" : "",
      identificationNumber: userFormData?.userDetails?.aadharNumber || 
                           userFormData?.userDetails?.panNumber || ""
    }
  });
  
  const { register, handleSubmit, formState: { errors }, trigger, setValue, control, getValues, watch } = methods;

  const claimantDetailsSchema = [
    { 
      name: "CreditorName", 
      label: <>Creditor Name <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { 
        required: !hasCreditorName && "Creditor Name is required",
      },
      placeholder: "Enter Creditor Name",
      disabled: hasCreditorName,
      tooltip: "Name of the creditor filing the claim"
    },
    { 
      name: "totalClaimAmount", 
      label: <>Total Claim Amount <span className="required-asterisk">*</span></>, 
      type: "number", 
      rules: { 
        required: "Total Claim Amount is required", 
        min: { value: 0, message: "Value must be greater than or equal to 0" } 
      },
      placeholder: "Enter Total Claim Amount",
      tooltip: "The total amount being claimed against the debtor"
    },
    { 
      name: "debtDetails", 
      label: <>Debt Incurred Details <span className="required-asterisk">*</span></>, 
      type: "textarea", 
      rules: { required: "Debt Details are required" },
      tooltip: "Details of how and when debt incurred",
      placeholder: "Enter details including dates, nature of debt, and agreements"
    },
    { 
      name: "mutualCreditDetails", 
      label: <>Mutual Credit/Debts Details <span className="required-asterisk">*</span></>, 
      type: "textarea", 
      rules: { required: "Mutual Credit Details are required" },
      tooltip: "Details of any mutual credit, mutual debts, or other mutual dealings between the corporate debtor and the creditor which may be set-off against the claim",
      placeholder: "Enter details of any mutual transactions or set-offs"
    },
    {
      name: "identificationType",
      label: <>Identification Type <span className="required-asterisk">*</span></>,
      type: "select",
      options: [
        { value: "", label: "Select Identification Type", disabled: true },
        { value: "Aadhar", label: "Aadhar" },
        { value: "PAN", label: "PAN" },
        { value: "Passport", label: "Passport" },
      ],
      rules: { required: "Identification type is required" },
      tooltip: "Select the type of identification document provided",
    },
    {
      name: "identificationNumber",
      label: <>Identification Number <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { 
        required: "Identification number is required",
        pattern: {
          value: watch("identificationType") === "PAN" 
            ? /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/ 
            : /^.*$/,
          message: "Please enter a valid PAN number (format: ABCDE1234F)"
        }
      },
      tooltip: "Enter your Aadhar, PAN, or Passport number",
      placeholder: "Enter Identification Number"
    },
    {
      name: "identificationDocument",
      label: <>Identification Document <span className="required-asterisk">*</span></>,
      type: "file",
      rules: { required: "Identification document is required" },
      tooltip: "Upload a clear scan of your identification document",
      accept: "image/*,.pdf"
    },
  ];

  const debtorDetailsSchema = [
    {
      name: "debtorName",
      label: <>Debtor Name <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { 
        required: !hasDebtorName && "Debtor Name is required" 
      },
      placeholder: "Enter Debtor Name",
      tooltip: "Name of the corporate debtor against whom the claim is being filed",
      disabled: hasDebtorName
    }
  ];

  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    const identificationDocument = getValues("identificationDocument");

    if (!isValid || !identificationDocument) {
      console.error("Validation failed or required documents missing");
      return false;
    }

    return getValues();
  }, [trigger, getValues]);

  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        setValue(key, formData[key]);
      });
    }

    // Set values from localStorage if not in formData
    if (!formData?.CreditorName && hasCreditorName) {
      setValue("CreditorName", userFormData.claimantName);
    }
    if (!formData?.debtorName && hasDebtorName) {
      setValue("debtorName", userFormData.corporateDebtorName);
    }
  }, [formData, setValue, hasCreditorName, hasDebtorName, userFormData]);

  useEffect(() => {
    if (provideSubmitHandler) {
      provideSubmitHandler(onSubmit);
    }
  }, [provideSubmitHandler, onSubmit]);

  // Watch identification type for validation
  const identificationType = watch("identificationType");
  useEffect(() => {
    if (identificationType) {
      trigger("identificationNumber");
    }
  }, [identificationType, trigger]);

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        <div className="mb-4 bg-light">
          <div className="mb-4 bg-light">
            <Collapsible title="Debtor Details" defaultOpen={true}>
              <div className="flex-container">
                {debtorDetailsSchema.map((fieldConfig) => (
                  <DynamicField
                    key={fieldConfig.name}
                    fieldConfig={fieldConfig}
                    control={control}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    trigger={trigger}
                    getValues={getValues}
                  />
                ))}
              </div>
            </Collapsible>
          </div>
          <Collapsible title="Creditor Basic Details" defaultOpen={true}>
            <div className="flex-container">
              {claimantDetailsSchema.map((fieldConfig) => (
                <DynamicField
                  key={fieldConfig.name}
                  fieldConfig={fieldConfig}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  trigger={trigger}
                  getValues={getValues}
                />
              ))}
            </div>
          </Collapsible>
        </div>
      </form>
    </FormProvider>
  );
};

export default StepFirst;

import React, { useCallback, useEffect } from "react";
import { useForm, FormProvider, Controller } from "react-hook-form";
import DatePicker from "react-datepicker";
import "react-datepicker/dist/react-datepicker.css";
import Collapsible from "../formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip";
import { FaInfoCircle } from "react-icons/fa";

// Dynamic field renderer
const DynamicField = ({ fieldConfig, control, register, errors, setValue, trigger, getValues }) => {
  const { name, label, type, options, rules, tooltip, placeholder } = fieldConfig;

  // Check if the field has an error
  const hasError = errors[name];

  // Allow only valid numeric keys
  const handleKeyPress = (e) => {
    if (type === "number" && !/^\d$/.test(e.key) && e.key !== "Backspace") {
      e.preventDefault();
    }
  };

  // Handle file upload
  const handleFileChange = (e) => {
    const files = e.target.files;
    if (files) {
      setValue(name, files[0]); // Single file selection
      trigger(name);
    }
  };

  return (
    <div className="flex-item">
      <label>
        {label}
        {tooltip && (
          <Tooltip title={tooltip} arrow>
            <span style={{ marginLeft: "5px", cursor: "pointer" }}>
              <FaInfoCircle />
            </span>
          </Tooltip>
        )}
      </label>
      {type === "select" ? (
        <Controller
          name={name}
          control={control}
          rules={rules}
          render={({ field }) => (
            <select
              {...field}
              className={`form-input ${hasError ? "input-error" : ""}`}
              onChange={(e) => {
                field.onChange(e);
                if (fieldConfig.onChange) fieldConfig.onChange(e.target.value);
              }}
            >
              <option value="" disabled>
                {placeholder || `Select ${label}`}
              </option>
              {options.map((option) => (
                <option key={option.value} value={option.value}>
                  {option.label}
                </option>
              ))}
            </select>
          )}
        />
      ) : type === "date" ? (
        <Controller
          name={name}
          control={control}
          rules={rules}
          render={({ field }) => (
            <DatePicker
              {...field}
              selected={field.value}
              onChange={(date) => {
                setValue(name, date);
                trigger(name);
              }}
              className={`form-input ${hasError ? "input-error" : ""}`}
              dateFormat="yyyy-MM-dd"
              placeholderText={placeholder || "Select a date"}
            />
          )}
        />
      ) : type === "file" ? (
        <div className="custom-file-input">
          <input
            type="file"
            id={name}
            onChange={handleFileChange}
            className="form-input"
            style={{ display: "none" }}
          />
          <label htmlFor={name} className="file-label">
            {placeholder || "Choose File"}
          </label>
          {getValues(name) && (
            <span style={{ marginTop: "8px", fontSize: "14px" }}>
              Selected file: {getValues(name).name}
            </span>
          )}
        </div>
      ) : type === "multifile" ? (
        <input
          type="file"
          multiple
          onChange={handleFileChange}
          className={`form-input ${hasError ? "input-error" : ""}`}
          placeholder={placeholder || "Upload multiple files"}
        />
      ) : (
        <input
          {...register(name, rules)}
          type={type}
          className={`form-input ${hasError ? "input-error" : ""}`}
          onChange={(e) => {
            setValue(name, e.target.value);
            trigger(name);
          }}
          onKeyPress={handleKeyPress} // Restrict input for numeric fields
          placeholder={placeholder || `Enter ${label.toLowerCase()}`}
        />
      )}
      {hasError && <p className="error-message">{errors[name]?.message}</p>}
    </div>
  );
};

const FormCDetails = ({ provideSubmitHandler, formData }) => {
  const methods = useForm();
  const { register, handleSubmit, formState: { errors }, trigger, clearErrors, setValue, control, getValues } = methods;

  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    if (!isValid) {
      console.error("Validation failed");
      return false;
    }
    return getValues();
  }, [trigger, getValues]);

  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        setValue(key, formData[key]);
      });
    }
  }, [formData, setValue]);

  useEffect(() => {
    if (provideSubmitHandler) {
      provideSubmitHandler(onSubmit);
    }
  }, [provideSubmitHandler, onSubmit]);

  // Field configurations for each section
  const claimDetailsSchema = [
    { 
      name: "securityInterestAmount", 
      label: <>Security Interest Amount <span className="required-asterisk">*</span></>, 
      type: "number", 
      rules: { required: "Security interest amount is required" }, 
      tooltip: "Amount of claim covered by security interest, if any (Please provide details of security interest, the value of the security, and the date it was given)",
      placeholder: "Enter security interest amount" 
    },
    { 
      name: "guaranteeAmount", 
      label: <>Guarantee Amount <span className="required-asterisk">*</span></>, 
      type: "number", 
      rules: { required: "Guarantee amount is required" }, 
      tooltip: "Amount of claim covered by guarantee, if any (Please provide details of guarantee held, the value of the guarantee, and the date it was given)",
      placeholder: "Enter guarantee amount" 
    },
    { 
      name: "guarantorName", 
      label: <>Guarantor Name <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "Guarantor name is required" },
      placeholder: "Enter guarantor name" 
    },
    { 
      name: "guarantorAddress", 
      label: <>Guarantor Address <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "Guarantor address is required" },
      placeholder: "Enter guarantor address" 
    },
    { 
      name: "addressProof", 
      label: "Address Proof", 
      type: "file", 
      rules: { required: "Address proof is required" }, 
      tooltip: "Upload a document as proof of address",
      placeholder: "Upload address proof" 
    },
    { 
      name: "creditorAddress", 
      label: <>Address of Creditor for Correspondence <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "Creditor address is required" },
      placeholder: "Enter creditor address" 
    },
    { 
      name: "creditorEmail", 
      label: <>Email Address of Creditor for Correspondence <span className="required-asterisk">*</span></>, 
      type: "email", 
      rules: { 
        required: "Email address is required", 
        pattern: {
          value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
          message: "Invalid email address",
        },
      },
      placeholder: "Enter creditor email" 
    },
  ];

  const beneficiaryDetailsSchema = [
    // { 
    //   name: "beneficiaryClaimAmount", 
    //   label: <>Claim Amount <span className="required-asterisk">*</span></>, 
    //   type: "number", 
    //   rules: { required: "Claim amount is required" },
    //   placeholder: "Enter claim amount" 
    // },
    { 
      name: "beneficiaryName", 
      label: <>Beneficiary Name <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "Beneficiary name is required" },
      placeholder: "Enter beneficiary name" 
    },
    { 
      name: "beneficiaryAddress", 
      label: <>Beneficiary Address <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "Beneficiary address is required" },
      placeholder: "Enter beneficiary address" 
    },
  ];

  const corporateDebtorSchema = [
    // { 
    //   name: "corporateDebtorClaimAmount", 
    //   label: <>Claim Amount <span className="required-asterisk">*</span></>, 
    //   type: "number", 
    //   rules: { required: "Claim amount is required" },
    //   placeholder: "Enter claim amount" 
    // },
    { 
      name: "corporateDebtorSecurityAmount", 
      label: <>Security Amount <span className="required-asterisk">*</span></>, 
      type: "number", 
      rules: { required: "Security amount is required" }, 
      tooltip: "Amount of claim covered by security interest, if any (Please provide details of security interest, the value of the security, and the date it was given)",
      placeholder: "Enter security amount" 
    },
    { 
      name: "corporateDebtorGuaranteeAmount", 
      label: <>Guarantee Amount <span className="required-asterisk">*</span></>, 
      type: "number", 
      rules: { required: "Guarantee amount is required" }, 
      tooltip: "Amount of claim covered by guarantee, if any (Please provide details of guarantee held, the value of the guarantee, and the date it was given)",
      placeholder: "Enter guarantee amount" 
    },
    { 
      name: "principalBorrowerName", 
      label: <>Principal Borrower Name <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "Principal borrower name is required" },
      placeholder: "Enter principal borrower name" 
    },
    { 
      name: "principalBorrowerAddress", 
      label: <>Principal Borrower Address <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "Principal borrower address is required" },
      placeholder: "Enter principal borrower address" 
    },
  ];

  const bankAccountDetailsSchema = [
    { 
      name: "accountNumber", 
      label: <>Account Number <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "Account number is required" },
      placeholder: "Enter account number" 
    },
    { 
      name: "ifscCode", 
      label: <>IFSC Code <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "IFSC code is required" },
      placeholder: "Enter IFSC code" 
    },
    { 
      name: "branchName", 
      label: <>Branch Name <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "Branch name is required" },
      placeholder: "Enter branch name" 
    },
  ];

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        {/* Details of Claim Section */}
        <div className="mb-4 bg-light">
          <Tooltip title="Details of claim, if it is made in respect of financial debt covered under clauses (h) and (i) of sub-section (8) of section 5 of the Code, extended by the creditor" arrow>
            <div>
              <Collapsible title="Details of claim: corporate debtor as principal borrower">
                <div className="flex-container">
                  {claimDetailsSchema.map((fieldConfig) => (
                    <DynamicField
                      key={fieldConfig.name}
                      fieldConfig={fieldConfig}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      trigger={trigger}
                      getValues={getValues}
                    />
                  ))}
                </div>
              </Collapsible>
            </div>
          </Tooltip>
        </div>

        {/* Beneficiary Details Section */}
        <div className="mb-4 bg-light">
          <Tooltip title="Beneficiary details (Details of claim, if it is made in respect of financial debt covered under clauses (h) and (i) of sub-section (8) of section 5 of the Code, extended by the creditor)" arrow>
            <div>
              <Collapsible title="Details of claim: corporate debtor as beneficiary">
                <div className="flex-container">
                  {beneficiaryDetailsSchema.map((fieldConfig) => (
                    <DynamicField
                      key={fieldConfig.name}
                      fieldConfig={fieldConfig}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      trigger={trigger}
                    />
                  ))}
                </div>
              </Collapsible>
            </div>
          </Tooltip>
        </div>

        {/* Corporate Debtor as Guarantor Section */}
        <div className="mb-4 bg-light">
          <Collapsible title="Details of claim: corporate debtor as guarantor">
            <div className="flex-container">
              {corporateDebtorSchema.map((fieldConfig) => (
                <DynamicField
                  key={fieldConfig.name}
                  fieldConfig={fieldConfig}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  trigger={trigger}
                />
              ))}
            </div>
          </Collapsible>
        </div>

        {/* Bank Account Details Section */}
        <div className="mb-4 bg-light">
          <Tooltip title="Bank account details (Details of the bank account to which the amount of the claim or any part thereof can be transferred pursuant to a resolution plan)" arrow>
            <div>
              <Collapsible title="Bank Account Details">
                <div className="flex-container">
                  {bankAccountDetailsSchema.map((fieldConfig) => (
                    <DynamicField
                      key={fieldConfig.name}
                      fieldConfig={fieldConfig}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      trigger={trigger}
                    />
                  ))}
                </div>
              </Collapsible>
            </div>
          </Tooltip>
        </div>
      </form>
    </FormProvider>
  );
};

export default FormCDetails;
