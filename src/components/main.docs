/* Calendar Stat Card */
.calendar-stat-card {
  height: 100%;
  display: flex;
  padding: 1.25rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  background: #fff;
  transition: all 0.3s ease;
}

.calendar-stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
}

.calendar-stat-card .stat-icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 1rem;
  background-color: rgba(111, 66, 193, 0.1);
  flex-shrink: 0;
}

.calendar-stat-card .stat-content {
  flex-grow: 1;
}

.calendar-stat-card .stat-content h3 {
  font-size: 1.5rem;
  font-weight: 700;
  margin: 8px 0 4px 0;
  line-height: 1;
  color: #333;
}

.calendar-stat-card .stat-content p {
  font-size: 0.9rem;
  color: #666;
  margin-bottom: 12px;
}

.mini-calendar-container {
  height: 200px;
  margin-top: 12px;
}

/* Calendar Styling */
.survey-calendar {
  width: 100%;
  border: none;
  font-family: inherit;
  font-size: 13px;
}

.survey-calendar .react-datepicker__month-container {
  width: 100%;
  padding: 0;
}

.survey-calendar .react-datepicker__header {
  background: white;
  border-bottom: none;
  padding: 0 0 8px 0;
}

.survey-calendar .react-datepicker__day-names {
  display: flex;
  justify-content: space-between;
  margin-top: 4px;
}

.survey-calendar .react-datepicker__day-name {
  width: 24px;
  color: #666;
  font-size: 12px;
  font-weight: 500;
  text-transform: uppercase;
}

.survey-calendar .react-datepicker__month {
  margin: 4px 0 0 0;
}

.survey-calendar .react-datepicker__week {
  display: flex;
  justify-content: space-between;
  margin: 4px 0;
}

.survey-calendar .react-datepicker__day {
  width: 24px;
  height: 24px;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 12px;
}

.survey-calendar .react-datepicker__day--outside-month {
  color: #ccc;
}

.survey-calendar .react-datepicker__day--today {
  font-weight: bold;
  color: #2466BF;
  background-color: #e6f2ff;
}

.survey-calendar .react-datepicker__day--selected {
  background-color: #6f42c1;
  color: white;
}

.day-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
}

.day-number {
  font-size: 12px;
}

.event-indicators {
  position: absolute;
  bottom: 0;
  display: flex;
  gap: 2px;
}

.event-indicator {
  width: 4px;
  height: 4px;
  border-radius: 50%;
}

/* Navigation */
.survey-calendar .react-datepicker__navigation {
  top: 8px;
  width: 24px;
  height: 24px;
}

.survey-calendar .react-datepicker__navigation--previous {
  left: 10px;
}

.survey-calendar .react-datepicker__navigation--next {
  right: 10px;
}

.survey-calendar .react-datepicker__current-month {
  font-size: 13px;
  font-weight: 600;
  color: #333;
  padding-top: 8px;
}
