
import React, { useRef, useState, useEffect } from "react";
import { useNavigate, useParams, useLocation } from "react-router-dom";
import { useForm, useFieldArray, Controller } from "react-hook-form";
import { Container, Row, Col, Card, Button } from "react-bootstrap";
import { toast } from "react-toastify";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import { useTranslation } from "react-i18next";
import i18n from "i18next";
import {
  FaUser,
  FaMapMarkerAlt,
  FaBriefcase,
  FaFileUpload,
  FaGraduationCap,
  FaPlus,
  FaTrash,
  FaArrowLeft,
  FaDownload,
  FaArrowAltCircleLeft,
} from "react-icons/fa";
import InputText from "../../../common/InputText.tsx";
import { handleErrorMessage } from "../../../../utils/errorMessageHandler.js";
import InputSelect from "../../../common/InputSelect.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { CONSTANT_REGEX } from "../../../../utils/constants.ts";
import { useMasterData } from "../../../context/MasterDataContext.js";
import NewLoader from "../../../common/NewLoader.js";
import "./EmployeeRegistration.css";
import {
  getData,
  postFORMdata,
  getBlobData,
} from "../../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import AppToggleButton from "../../../common/AppToggleButton.js";
import axios from "axios";
import {
  getFromLocalStorage,
  setToLocalStorage,
} from "../../../../utils/localStorageUtils.js";

import {
  downloadFile,
  getFilenameFromHeaders,
} from "../../../../utils/fileDownload.ts";

const getValue = (obj, key) => {
  if (!obj) return "";
  if (obj[key] !== undefined) return obj[key];
  const lowerKey = key.toLowerCase();
  const foundKey = Object.keys(obj).find((k) => k.toLowerCase() === lowerKey);
  return foundKey ? obj[foundKey] : "";
};

const EmployeeRegistration = () => {
  const isCompMount = useRef(true);
  const { i18n,t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const navigate = useNavigate();
  const { id } = useParams();
  const location = useLocation();
  const isEditMode = !!id;
  const loaderRef = useRef();
  const { masterData } = useMasterData();
  const [employeeData, setEmployeeData] = useState("");

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [i18n.language]);

  useEffect(() => {
    setEmployeeData(location?.state?.employee.employeeDetails || "");
  }, []);

  const {
    register,
    handleSubmit,
    control,
    formState: { errors },
    setValue,
    watch,
    reset,
    clearErrors,
    trigger,
  } = useForm({
    mode: "onSubmit",
    defaultValues: {
      firstName: "",
      lastName: "",
      email: "",
      phoneNumber: "",
      gender: "",
      dateOfBirth: "",
      addressLine1: "",
      addressLine2: "",
      pin: "",
      district: "",
      stateUt: "",
      country: "India",
      appointmentDate: "",
      employeeType: "",
      employeeStatus: "",
      designation: "",
      department: "",
      section: "",
      roles: "",
      addressProof: "",
      identityProof: "",
      appointmentLetter: "",
      educationDetails: [
        {
          qualification: "",
          stream: "",
          yearOfPassing: "",
          employeeUUID: "",
          uuid: "",
        },
      ],
      isActive: true,
    },
  });

  const [addressProofFile, setAddressProofFile] = useState(null);
  const [identityProofFile, setIdentityProofFile] = useState(null);
  const [appointmentLetterFile, setAppointmentLetterFile] = useState(null);
  const [toggleValue, setToggleValue] = useState(true);

  const { fields, append, remove } = useFieldArray({
    control,
    name: "educationDetails",
  });

  useEffect(() => {
    if (isEditMode && employeeData) {
      const professionalDetail = employeeData.professionalDetails?.[0] || {};
      
      reset({
        firstName: getValue(employeeData, "firstName"),
        lastName: getValue(employeeData, "lastName"),
        email: getValue(employeeData, "emailId"),
        phoneNumber: getValue(employeeData, "phoneNumber"),
        gender: getValue(employeeData, "gender"),
        dateOfBirth: getValue(employeeData, "dateOfBirth"),
        addressLine1: getValue(employeeData, "addressLine1"),
        addressLine2: getValue(employeeData, "addressLine2"),
        pin: getValue(employeeData, "pin"),
        district: getValue(employeeData, "district"),
        stateUt: getValue(employeeData, "stateUt"),
        country: getValue(employeeData, "country") || "India",
        appointmentDate: getValue(employeeData, "appointmentDate"),
        employeeType: getValue(employeeData, "employeeType"),
        employeeStatus: getValue(employeeData, "employeeStatus"),
        designation: getValue(employeeData, "designation"),
        department: getValue(employeeData, "department"),
        section: getValue(employeeData, "section"),
        roles: getValue(employeeData, "roles"),
        isActive: getValue(employeeData, "isActive") ?? true,
        educationDetails: Array.isArray(employeeData.educationDetails)
          ? employeeData.educationDetails.map((ed) => ({
              qualification: getValue(ed, "qualification"),
              stream: getValue(ed, "stream"),
              yearOfPassing: getValue(ed, "yearOfPassing"),
              uuid: ed?.uuid || "",
              employeeUUID: ed?.uuid || "",
            }))
          : [{ qualification: "", stream: "", yearOfPassing: "" }],
      });
      
      setToggleValue(getValue(employeeData, "isActive") ?? true);
    } else if (!isEditMode) {
      setToggleValue(true);
    }
  }, [isEditMode, reset, employeeData]);

  const fetchAddressDetails = async (pin) => {
    try {
      const URL =
        process.env.REACT_APP_PUBLIC_URL +
        URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE +
        pin;
      const response = await getData(URL);
      if (response?.status === 200 && response?.data?.length > 0) {
        setValue("district", response?.data[0]?.district);
        setValue("stateUt", response?.data[0]?.stateName);
        setValue("country", "India");
      } else {
        setValue("district", "");
        setValue("stateUt", "");
        setValue("country", "");
        toast.info("No data found for this PIN code");
      }
      loaderRef.current?.hide();
    } catch (error) {
      setValue("district", "");
      setValue("stateUt", "");
      setValue("country", "");
      loaderRef.current?.hide();
      toast.error("Error fetching address details");
    }
  };

  const onSubmit = async (data) => {
    console.log("Form Data:", data);
    try {
      loaderRef.current?.show();

      const uInfo = {
        userType: "EMPLOYEE",
        userBasicDetails:{},
        employeeDetails: {
          id: isEditMode ? employeeData?.id : "",
          firstName: data.firstName,
          lastName: data.lastName,
          emailId: data.email,
          phoneNumber: data.phoneNumber,
          addressLine1: data.addressLine1,
          addressLine2: data.addressLine2,
          pin: data.pin,
          district: data.district,
          state: data.stateUt,
          country: data.country,
          isActive: data?.isActive,
          dateOfBirth: data.dateOfBirth,
          gender: data.gender,
          appointmentDate: data.appointmentDate,
          employeeType: data.employeeType,
          employeeStatus: data.employeeStatus,
          designation: data.designation,
          department: data.department,
          section: data.section,
          roles: data.roles,
          educationDetails: data?.educationDetails?.map((ed) => ({
            uuid: isEditMode ? ed.uuid : "",
            qualification: ed.qualification,
            stream: ed.stream,
            yearOfPassing: ed.yearOfPassing,
          })),
        },
      };

      const formData = new FormData();
      formData.append(
        "request",
        new Blob([JSON.stringify(uInfo)], {
          type: "application/json",
        })
      );

      [addressProofFile, identityProofFile, appointmentLetterFile].forEach(
        (file) => {
          if (file) {
            formData.append("files", file);
          }
        }
      );

      await submitEmpDetails(formData);
    } catch (error) {
      loaderRef.current?.hide();
      toast.error(
        error?.response?.data?.message ||
          "Error submitting form. Please try again."
      );
    }
  };

  const submitEmpDetails = async (payload) => {
    try {
      const URL =
        process.env.REACT_APP_AUTH_URL + URLS_ENDPOINT.USER_SERVICE.CREATE_UPDATE_EMP;

      loaderRef.current?.show();
      const response = await postFORMdata(URL, payload);
      const apiRes = response?.data ? { ...response?.data } : null;
      console.log("API Response:employee", apiRes);

      if (apiRes?.responseStatus?.status === "200") {
        loaderRef?.current?.hide();
        toast.success(
          apiRes?.responseStatus?.message ||
            (isEditMode
              ? "Employee updated successfully!"
              : "Employee registered successfully!"),
          { position: "top-right" }
        );
        handleCancel();
      } else {
        loaderRef?.current?.hide();
        toast.info(
          apiRes?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const handleCancel = () => {
    navigate("/iwt/employee-management");
  };

  const handleFileDownload = async (url) => {
    try {
      if (!url) return;
      loaderRef.current?.show();

      const accessToken = getFromLocalStorage("access_token");
      const tokenDetails = getFromLocalStorage("tokenDetails");
      const sessionState = tokenDetails
        ? JSON.parse(tokenDetails)?.session_state
        : "";

      const response = await axios({
        method: "GET",
        url: url,
        responseType: "blob",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "X-Request-ID": sessionState,
          Accept: "application/octet-stream",
        },
      });

      if (response.data) {
        let filename = "document";
        const contentDisposition = response.headers["content-disposition"];
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(
            /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
          );
          if (filenameMatch && filenameMatch[1]) {
            filename = filenameMatch[1].replace(/['"]/g, "");
          }
        }

        const blob = new Blob([response.data], {
          type: response.headers["content-type"] || "application/octet-stream",
        });
        const blobUrl = window.URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = blobUrl;
        link.setAttribute("download", filename);
        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          window.URL.revokeObjectURL(blobUrl);
        }, 100);
      }
    } catch (error) {
      console.error("Error downloading file:", error);
      toast.error("Failed to download file. Please try again.");
    } finally {
      loaderRef.current?.hide();
    }
  };

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="p-4">
        <Card className="mb-4">
          <Card.Header
            className="bg-primary text-white d-flex align-items-center justify-content-center position-relative"
            style={{
              minHeight: 56,
              background: "linear-gradient(135deg, #00429c, #4695ff)",
              border: "none",
            }}
          >
            <button
              className="btn back-button"
              onClick={() => navigate("/iwt/employee-management")}
              style={{
                color: "white",
                fontSize: "0.9rem",
                position: "absolute",
                left: 0,
                top: "50%",
                transform: "translateY(-50%)",
                textDecoration: "none",
              }}
            >
              <FaArrowAltCircleLeft size={22} />
            </button>

            <div style={{ fontWeight: 600, fontSize: 22, color: "#fff" }}>
              {isEditMode ? t("Edit Employee") : t("addEmployee.Add Employee")}
            </div>

            <div style={{ width: 40 }}></div>
          </Card.Header>
          <Card.Body>
            <form onSubmit={handleSubmit(onSubmit)} className="employee-form">
              {/* Personal Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaUser className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>
                      {t("addEmployee.Personal Details")}
                    </span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="firstName"
                          label={t("addEmployee.First Name")}
                          placeholder={t("addEmployee.Enter first name")}
                          required={true}
                          register={{
                            ...register("firstName", {
                              required: t("addEmployee.First Name is required"),
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="lastName"
                          label={t("addEmployee.Last Name")}
                          placeholder={t("addEmployee.Enter last name")}
                          required={true}
                          register={{
                            ...register("lastName", {
                              required: t("addEmployee.Last Name is required"),
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="email"
                          label={t("addEmployee.Email ID")}
                          type="email"
                          placeholder={t("addEmployee.Enter email address")}
                          required={true}
                          register={{
                            ...register("email", {
                              required: t("addEmployee.Email is required"),
                              pattern: {
                                value: CONSTANT_REGEX.EMAIL,
                                message: t("addEmployee.Invalid email address"),
                              },
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="phoneNumber"
                          label={t("addEmployee.Phone Number")}
                          placeholder={t(
                            "addEmployee.Enter 10-digit phone number"
                          )}
                          required={true}
                          maxlength={10}
                          register={{
                            ...register("phoneNumber", {
                              required: t(
                                "addEmployee.Phone Number is required"
                              ),
                              pattern: {
                                value: CONSTANT_REGEX.MOBILE,
                                message: t(
                                  "addEmployee.Phone number must be 10 digits"
                                ),
                              },
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="gender"
                          label={t("addEmployee.Gender")}
                          required={true}
                          options={[
                            {
                              value: "",
                              label: t("addEmployee.Select Gender"),
                            },
                            ...(masterData?.genders?.map((type) => ({
                              value: type.valueCode,
                              label: type.valueLabel,
                            })) || [
                              { value: "MALE", label: "MALE" },
                              { value: "FEMALE", label: "FEMALE" },
                              { value: "OTHER", label: "OTHER" },
                            ]),
                          ]}
                          register={register("gender", {
                            required: t("addEmployee.Gender is required"),
                          })}
                          errors={errors}
                          value={watch("gender") || ""}
                          onChange={(value) =>
                            setValue("gender", value, { shouldValidate: true })
                          }
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="dateOfBirth"
                          label={t("addEmployee.Date of Birth")}
                          type="date"
                          placeholder={t("addEmployee.Select date of birth")}
                          required={true}
                          register={{
                            ...register("dateOfBirth", {
                              required: t(
                                "addEmployee.Date of Birth is required"
                              ),
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Address Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaMapMarkerAlt
                      className="me-2"
                      style={{ color: "#2466BF" }}
                    />
                    <span style={{ color: "#2466BF" }}>
                      {t("addEmployee.Address Details")}
                    </span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={6}>
                        <InputText
                          name="addressLine1"
                          label={t("addEmployee.Address Line-1")}
                          placeholder={t("addEmployee.Enter address line 1")}
                          required={true}
                          register={{
                            ...register("addressLine1", {
                              required: t(
                                "addEmployee.Address Line-1 is required"
                              ),
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={6}>
                        <InputText
                          name="addressLine2"
                          label={t("addEmployee.Address Line-2")}
                          placeholder={t(
                            "addEmployee.Enter address line 2 (optional)"
                          )}
                          register={{
                            ...register("addressLine2"),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="pin"
                          label={t("addEmployee.PIN")}
                          placeholder={t("addEmployee.Enter 6-digit PIN code")}
                          required={true}
                          register={{
                            ...register("pin", {
                              required: t("addEmployee.PIN Code is required"),
                              pattern: {
                                value: /^[0-9]{6}$/,
                                message: t("addEmployee.PIN must be 6 digits"),
                              },
                            }),
                          }}
                          onChange={(e) => {
                            const pinValue = e.target.value;
                            if (pinValue.length === 6) {
                              loaderRef.current?.show();
                              fetchAddressDetails(pinValue);
                            }
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="district"
                          label={t("addEmployee.District")}
                          required={true}
                          placeholder={t("addEmployee.Auto-populated")}
                          register={{
                            ...register("district"),
                          }}
                          errors={errors}
                          readOnly
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="stateUt"
                          label={t("addEmployee.State/UT")}
                          required={true}
                          placeholder={t("addEmployee.Auto-populated")}
                          register={{
                            ...register("stateUt"),
                          }}
                          errors={errors}
                          readOnly
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="country"
                          label={t("addEmployee.Country")}
                          required={true}
                          placeholder={t("addEmployee.Auto-populated")}
                          register={{
                            ...register("country"),
                          }}
                          errors={errors}
                          readOnly
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Education Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaGraduationCap
                      className="me-2"
                      style={{ color: "#2466BF" }}
                    />
                    <span style={{ color: "#2466BF" }}>
                      {t("addEmployee.Education Details")}
                    </span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    {fields.map((field, index) => (
                      <Row key={field.id} className="g-3">
                        <Col md={4}>
                          <InputText
                            required={true}
                            name={`educationDetails.${index}.qualification`}
                            label={t("addEmployee.Qualification")}
                            placeholder={t("addEmployee.Enter qualification")}
                            register={register(
                              `educationDetails.${index}.qualification`,
                              {
                                required: t(
                                  "addEmployee.Qualification is required"
                                ),
                              }
                            )}
                            errors={errors}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name={`educationDetails.${index}.stream`}
                            label={t("addEmployee.Stream")}
                            placeholder={t("addEmployee.Enter stream")}
                            register={register(
                              `educationDetails.${index}.stream`,
                              {
                                required: t("addEmployee.Stream is required"),
                              }
                            )}
                            errors={errors}
                          />
                        </Col>
                        <Col md={4}>
                          <InputText
                            name={`educationDetails.${index}.yearOfPassing`}
                            label={t("addEmployee.Year of Passing")}
                            required={true}
                            placeholder={t("addEmployee.Enter year of passing")}
                            register={register(
                              `educationDetails.${index}.yearOfPassing`,
                              {
                                required: t(
                                  "addEmployee.Year of Passing is required"
                                ),
                              }
                            )}
                            errors={errors}
                          />
                        </Col>
                        {index > 0 && (
                          <Col md={12} className="text-end">
                            <Button
                              variant="danger"
                              size="sm"
                              onClick={() => remove(index)}
                              className="mt-1"
                            >
                              <FaTrash /> Remove
                            </Button>
                          </Col>
                        )}
                      </Row>
                    ))}
                    <Button
                      variant="outline-primary"
                      onClick={() =>
                        append({
                          qualification: "",
                          stream: "",
                          yearOfPassing: "",
                        })
                      }
                      className="add-education-btn"
                    >
                      <FaPlus className="me-2" />{" "}
                      {t("addEmployee.Add Education Details")}
                    </Button>
                  </Card.Body>
                </Card>
              </Collapsible>
              
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaBriefcase
                      className="me-2"
                      style={{ color: "#2466BF" }}
                    />
                    <span style={{ color: "#2466BF" }}>
                      {t("addEmployee.Professional Details")}
                    </span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="appointmentDate"
                          label={t("Appointment Date")}
                          type="date"
                          placeholder={t("Select appointment date")}
                          required={true}
                          register={{
                            ...register("appointmentDate", {
                              required: t("addEmployee.Appointment Date is required"),
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="employeeType"
                          label={t("addEmployee.Employee Type")}
                          required={true}
                          placeholder={t("addEmployee.Select employee type")}
                          options={
                            masterData?.employeeTypes?.map((type) => ({
                              value: type.valueCode,
                              label: type.valueLabel,
                            })) || []
                          }
                          register={register("employeeType", {
                            required: t("addEmployee.Employee Type is required"),
                          })}
                          errors={errors}
                          value={watch("employeeType") || ""}
                          onChange={(val) =>
                            setValue("employeeType", val, { shouldValidate: true })
                          }
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="employeeStatus"
                          label={t("addEmployee.Employee Status")}
                          required={true}
                          placeholder={t("addEmployee.Select employee status")}
                          options={
                            masterData?.employeeStatuses?.map((type) => ({
                              value: type.valueCode,
                              label: type.valueLabel,
                            })) || []
                          }
                          register={register("employeeStatus", {
                            required: t("addEmployee.Employee Status is required"),
                          })}
                          errors={errors}
                          value={watch("employeeStatus") || ""}
                          onChange={(val) =>
                            setValue("employeeStatus", val, { shouldValidate: true })
                          }
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="designation"
                          label={t("addEmployee.Designation")}
                          required={true}
                          placeholder={t("addEmployee.Select designation")}
                          options={
                            masterData?.designations?.map((type) => ({
                              value: type.valueCode,
                              label: type.valueLabel,
                            })) || []
                          }
                          register={register("designation", {
                            required: t("addEmployee.Designation is required"),
                          })}
                          errors={errors}
                          value={watch("designation") || ""}
                          onChange={(val) =>
                            setValue("designation", val, { shouldValidate: true })
                          }
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="department"
                          label={t("addEmployee.Department")}
                          required={true}
                          placeholder={t("addEmployee.Select Department")}
                          options={
                            masterData?.departments?.map((type) => ({
                              value: type.valueCode,
                              label: type.valueLabel,
                            })) || []
                          }
                          register={register("department", {
                            required: t("addEmployee.Department is required"),
                          })}
                          errors={errors}
                          value={watch("department") || ""}
                          onChange={(val) =>
                            setValue("department", val, { shouldValidate: true })
                          }
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="section"
                          label={t("addEmployee.Section")}
                          placeholder={t("addEmployee.Enter section")}
                          register={{
                            ...register("section"),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="roles"
                          label={t("addEmployee.Roles")}
                          required={true}
                          placeholder={t("addEmployee.Select role")}
                          options={
                            masterData?.roles?.map((type) => ({
                              value: type.valueCode,
                              label: type.valueLabel,
                            })) || []
                          }
                          register={register("roles", {
                            required: t("addEmployee.Role is required"),
                          })}
                          errors={errors}
                          value={watch("roles") || ""}
                          onChange={(val) =>
                            setValue("roles", val, { shouldValidate: true })
                          }
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaFileUpload
                      className="me-2"
                      style={{ color: "#2466BF" }}
                    />
                    <span style={{ color: "#2466BF" }}>
                      {t("addEmployee.Documents Upload")}
                    </span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      {/* Address Proof */}
                      <Col md={6}>
                        <div className="document-upload-container">
                          <label className="form-label fw-semibold">
                            {t("addEmployee.Address Proof")}{" "}
                            {!isEditMode && (
                              <span className="text-danger">*</span>
                            )}
                          </label>
                          <div className="file-input-wrapper">
                            <input
                              type="file"
                              id="addressProof"
                              className={`form-control file-input ${
                                errors.addressProof ? "is-invalid" : ""
                              }`}
                              accept=".jpg,.jpeg,.png,.pdf"
                              {...register("addressProof", {
                                required:
                                  !isEditMode &&
                                  t("addEmployee.Address Proof is required"),
                                validate: {
                                  validFileType: (files) => {
                                    if (!files || !files.length) return true;
                                    const file = files[0];
                                    const validExtensions = [
                                      ".jpg",
                                      ".jpeg",
                                      ".png",
                                      ".pdf",
                                    ];
                                    const extension = file.name
                                      ?.substring(file.name.lastIndexOf("."))
                                      .toLowerCase();
                                    return (
                                      validExtensions.includes(extension) ||
                                      "Only JPG, PNG, and PDF files are allowed"
                                    );
                                  },
                                  validFileSize: (files) => {
                                    if (!files || !files.length) return true;
                                    return (
                                      files[0].size <= 2 * 1024 * 1024 ||
                                      "File size must be less than 2MB"
                                    );
                                  },
                                },
                              })}
                              onChange={(e) => {
                                const files = e.target.files;
                                if (!files || !files.length) return;

                                const file = files[0];
                                const validExtensions = [
                                  ".jpg",
                                  ".jpeg",
                                  ".png",
                                  ".pdf",
                                ];
                                const extension = file.name
                                  ?.substring(file.name.lastIndexOf("."))
                                  .toLowerCase();

                                if (
                                  !extension ||
                                  !validExtensions.includes(extension)
                                ) {
                                  toast.error(
                                    "Only JPG, PNG, and PDF files are allowed"
                                  );
                                  e.target.value = "";
                                  return;
                                }

                                if (file.size > 2 * 1024 * 1024) {
                                  toast.error(
                                    "File size must be less than 2MB"
                                  );
                                  e.target.value = "";
                                  return;
                                }

                                // Keep original file without renaming
                                setAddressProofFile(file);
                                clearErrors("addressProof");
                              }}
                            />
                            <label
                              htmlFor="addressProof"
                              className="file-input-label"
                            >
                              <span className="file-input-text">
                                {addressProofFile
                                  ? addressProofFile.name
                                  : t("Choose file...")}
                              </span>
                              <span className="file-input-button">
                                {t("Browse")}
                              </span>
                            </label>
                          </div>
                          <small className="text-muted d-block mt-1">
                            {t("Allowed formats: PDF, JPG, PNG (Max: 2MB)")}
                          </small>
                          {errors.addressProof && (
                            <div
                              className="invalid-feedback d-block"
                              style={{ color: "#dc3545" }}
                            >
                              {errors.addressProof.message}
                            </div>
                          )}
                          {isEditMode &&
                            employeeData?.files?.[0]?.downLoadFile && (
                              <div className="mt-2 download-link">
                                <Button
                                  variant="link"
                                  className="p-0 text-primary text-decoration-none"
                                  onClick={() =>
                                    handleFileDownload(
                                      employeeData.files[0].downLoadFile
                                    )
                                  }
                                >
                                  <FaDownload className="me-1" />
                                  Download address proof
                                </Button>
                              </div>
                            )}
                        </div>
                      </Col>

                      {/* Identity Proof */}
                      <Col md={6}>
                        <div className="document-upload-container">
                          <label className="form-label fw-semibold">
                            {t("addEmployee.Identity Proof")}{" "}
                            {!isEditMode && (
                              <span className="text-danger">*</span>
                            )}
                          </label>
                          <div className="file-input-wrapper">
                            <input
                              type="file"
                              id="identityProof"
                              className={`form-control file-input ${
                                errors.identityProof ? "is-invalid" : ""
                              }`}
                              accept=".jpg,.jpeg,.png,.pdf"
                              {...register("identityProof", {
                                required:
                                  !isEditMode &&
                                  t("addEmployee.Identity Proof is required"),
                                validate: {
                                  validFileType: (files) => {
                                    if (!files || !files.length) return true;
                                    const file = files[0];
                                    const validExtensions = [
                                      ".jpg",
                                      ".jpeg",
                                      ".png",
                                      ".pdf",
                                    ];
                                    const extension = file.name
                                      ?.substring(file.name.lastIndexOf("."))
                                      .toLowerCase();
                                    return (
                                      validExtensions.includes(extension) ||
                                      "Only JPG, PNG, and PDF files are allowed"
                                    );
                                  },
                                  validFileSize: (files) => {
                                    if (!files || !files.length) return true;
                                    return (
                                      files[0].size <= 2 * 1024 * 1024 ||
                                      "File size must be less than 2MB"
                                    );
                                  },
                                },
                              })}
                              onChange={(e) => {
                                const files = e.target.files;
                                if (!files || !files.length) return;

                                const file = files[0];
                                const validExtensions = [
                                  ".jpg",
                                  ".jpeg",
                                  ".png",
                                  ".pdf",
                                ];
                                const extension = file.name
                                  ?.substring(file.name.lastIndexOf("."))
                                  .toLowerCase();

                                if (
                                  !extension ||
                                  !validExtensions.includes(extension)
                                ) {
                                  toast.error(
                                    "Only JPG, PNG, and PDF files are allowed"
                                  );
                                  e.target.value = "";
                                  return;
                                }

                                if (file.size > 2 * 1024 * 1024) {
                                  toast.error(
                                    "File size must be less than 2MB"
                                  );
                                  e.target.value = "";
                                  return;
                                }

                                // Keep original file without renaming
                                setIdentityProofFile(file);
                                clearErrors("identityProof");
                              }}
                            />
                            <label
                              htmlFor="identityProof"
                              className="file-input-label"
                            >
                              <span className="file-input-text">
                                {identityProofFile
                                  ? identityProofFile.name
                                  : t("Choose file...")}
                              </span>
                              <span className="file-input-button">
                                {t("Browse")}
                              </span>
                            </label>
                          </div>
                          <small className="text-muted d-block mt-1">
                            {t("Allowed formats: PDF, JPG, PNG (Max: 2MB)")}
                          </small>
                          {errors.identityProof && (
                            <div
                              className="invalid-feedback d-block"
                              style={{ color: "#dc3545" }}
                            >
                              {errors.identityProof.message}
                            </div>
                          )}
                          {isEditMode &&
                            employeeData?.files?.[1]?.downLoadFile && (
                              <div className="mt-2 download-link">
                                <Button
                                  variant="link"
                                  className="p-0 text-primary text-decoration-none"
                                  onClick={() =>
                                    handleFileDownload(
                                      employeeData.files[1].downLoadFile
                                    )
                                  }
                                >
                                  <FaDownload className="me-1" />
                                  Download identity proof
                                </Button>
                              </div>
                            )}
                        </div>
                      </Col>

                      {/* Appointment Letter */}
                      <Col md={6}>
                        <div className="document-upload-container">
                          <label className="form-label fw-semibold">
                            {t("addEmployee.Appointment Letter")}{" "}
                            {!isEditMode && (
                              <span className="text-danger">*</span>
                            )}
                          </label>
                          <div className="file-input-wrapper">
                            <input
                              type="file"
                              id="appointmentLetter"
                              className={`form-control file-input ${
                                errors.appointmentLetter ? "is-invalid" : ""
                              }`}
                              accept=".jpg,.jpeg,.png,.pdf"
                              {...register("appointmentLetter", {
                                required:
                                  !isEditMode &&
                                  t(
                                    "addEmployee.Appointment Letter is required"
                                  ),
                                validate: {
                                  validFileType: (files) => {
                                    if (!files || !files.length) return true;
                                    const file = files[0];
                                    const validExtensions = [
                                      ".jpg",
                                      ".jpeg",
                                      ".png",
                                      ".pdf",
                                    ];
                                    const extension = file.name
                                      ?.substring(file.name.lastIndexOf("."))
                                      .toLowerCase();
                                    return (
                                      validExtensions.includes(extension) ||
                                      "Only JPG, PNG, and PDF files are allowed"
                                    );
                                  },
                                  validFileSize: (files) => {
                                    if (!files || !files.length) return true;
                                    return (
                                      files[0].size <= 2 * 1024 * 1024 ||
                                      "File size must be less than 2MB"
                                    );
                                  },
                                },
                              })}
                              onChange={(e) => {
                                const files = e.target.files;
                                if (!files || !files.length) return;

                                const file = files[0];
                                const validExtensions = [
                                  ".jpg",
                                  ".jpeg",
                                  ".png",
                                  ".pdf",
                                ];
                                const extension = file.name
                                  ?.substring(file.name.lastIndexOf("."))
                                  .toLowerCase();

                                if (
                                  !extension ||
                                  !validExtensions.includes(extension)
                                ) {
                                  toast.error(
                                    "Only JPG, PNG, and PDF files are allowed"
                                  );
                                  e.target.value = "";
                                  return;
                                }

                                if (file.size > 2 * 1024 * 1024) {
                                  toast.error(
                                    "File size must be less than 2MB"
                                  );
                                  e.target.value = "";
                                  return;
                                }

                                // Keep original file without renaming
                                setAppointmentLetterFile(file);
                                clearErrors("appointmentLetter");
                              }}
                            />
                            <label
                              htmlFor="appointmentLetter"
                              className="file-input-label"
                            >
                              <span className="file-input-text">
                                {appointmentLetterFile
                                  ? appointmentLetterFile.name
                                  : t("Choose file...")}
                              </span>
                              <span className="file-input-button">
                                {t("Browse")}
                              </span>
                            </label>
                          </div>
                          <small className="text-muted d-block mt-1">
                            {t("Allowed formats: PDF, JPG, PNG (Max: 2MB)")}
                          </small>
                          {errors.appointmentLetter && (
                            <div
                              className="invalid-feedback d-block"
                              style={{ color: "#dc3545" }}
                            >
                              {errors.appointmentLetter.message}
                            </div>
                          )}
                          {isEditMode &&
                            employeeData?.files?.[2]?.downLoadFile && (
                              <div className="mt-2 download-link">
                                <Button
                                  variant="link"
                                  className="p-0 text-primary text-decoration-none"
                                  onClick={() =>
                                    handleFileDownload(
                                      employeeData.files[2].downLoadFile
                                    )
                                  }
                                >
                                  <FaDownload className="me-1" />
                                  Download appointment letter
                                </Button>
                              </div>
                            )}
                        </div>
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Form Actions */}
              <div className="d-flex justify-content-end mt-4 gap-2">
                <Col style={{ display: "flex" }}>
                  <strong style={{ marginTop: "5px" }}>
                    {t("addEmployee.User Status")} :
                  </strong>
                  &nbsp; &nbsp;
                  <Controller
                    name="isActive"
                    control={control}
                    defaultValue={true}
                    render={({ field }) => (
                      <AppToggleButton
                        labels={[
                          t("addEmployee.In-Active"),
                          t("addEmployee.Active"),
                        ]}
                        value={toggleValue}
                        onChange={(val) => {
                          field.onChange(val);
                          setToggleValue(val);
                          setValue("isActive", val);
                        }}
                      />
                    )}
                  />
                </Col>

                <Button variant="secondary" onClick={handleCancel}>
                  {t("addEmployee.Cancel")}
                </Button>
                <Button
                  variant="primary"
                  type="submit"
                  style={{
                    background: "linear-gradient(135deg, #0077b6, #023e8a)",
                    border: "none",
                    boxShadow: "0 4px 6px rgba(0, 0, 0, 0.1)",
                    padding: "8px 20px",
                  }}
                >
                  {isEditMode
                    ? t("addEmployee.Update")
                    : t("addEmployee.Submit")}
                </Button>
              </div>
            </form>
          </Card.Body>
        </Card>
      </Container>
    </>
  );
};

export default EmployeeRegistration;

