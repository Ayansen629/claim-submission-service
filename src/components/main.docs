                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Number of Engine")}
                name="engineDetails.numberOfEngine"
                type="number"
                placeholder={!viewMode ? t("Enter Number of Engine") : ""}
                register={register("engineDetails.numberOfEngine")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Year of Make")}
                name="engineDetails.yearOfMake"
