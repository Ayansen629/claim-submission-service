{currentRecords.map((record, index) => (
  <div key={record.id} className="mb-4 p-4 border rounded bg-light">
    {watchIdentificationType === "INDIVIDUAL_PARTNERSHIP" && (
      <div className="d-flex justify-content-between align-items-center mb-3">
        <h6 className="mb-0">Record {index + 1}</h6>
        {currentRecords.length > 1 && (
          <button
            type="button"
            className="btn btn-sm btn-danger"
            onClick={() => removeIdentificationRecord(record.id)}
            disabled={uploadingRecordId !== null || isSubmitting}
          >
            <FaTimes className="me-1" /> Remove
          </button>
        )}
      </div>
    )}
    <div className="row g-3 align-items-end">
      <div className="col-md-6">
        <label className="form-label d-flex align-items-center">
          <FaIdCard className="me-2 text-primary" />
          {watchIdentificationType === "INCORPORATED"
            ? "Identification Number"
            : "Identification Records"} <span className="required-asterisk">*</span>
        </label>
        <input
          type="text"
          className={`form-control ${errors.identificationtype_details?.[index]?.details ? 'is-invalid' : ''}`}
          value={record.details}
          onChange={(e) => updateRecordDetails(record.id, e.target.value)}
          placeholder={
            watchIdentificationType === "INCORPORATED"
              ? "Enter Identification number"
              : "Enter identification records"
          }
          disabled={uploadingRecordId !== null || isSubmitting}
        />
        {errors.identificationtype_details?.[index]?.details && (
          <div className="invalid-feedback d-block">
            {errors.identificationtype_details[index].details.message}
          </div>
        )}
      </div>
      <div className="col-md-6">
        <label className="form-label d-flex align-items-center">
          <FaDownload className="me-2 text-primary" />
          {watchIdentificationType === "INCORPORATED"
            ? "Proof of Identification"
            : "Proof of Identification"} <span className="required-asterisk">*</span>
        </label>
        
        {record.proof ? (
          <div className="file-upload-status p-3 rounded border d-flex justify-content-between align-items-center">
            <div className="d-flex align-items-center">
              <FaFilePdf className="me-2 text-danger" />
              <span className="text-truncate" style={{maxWidth: "200px"}}>{record.proof.fileName}</span>
            </div>
            <div className="d-flex">
              <a
                href={`${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${record.proof.fileId}`}
                target="_blank"
                rel="noopener noreferrer"
                className="btn btn-sm btn-outline-primary me-2"
              >
                <FaDownload className="me-1" /> View
              </a>
              <button
                type="button"
                className="btn btn-sm btn-outline-danger"
                onClick={() => handleRemoveProof(record.id)}
                disabled={uploadingRecordId !== null || isSubmitting}
              >
                <FaTimes className="me-1" /> Remove
              </button>
            </div>
          </div>
        ) : (
          <div className="file-upload-container">
            <input
              type="file"
              id={`proof_${record.id}`}
              onChange={(e) => updateRecordProof(e, record.id)}
              className="d-none"
              accept=".pdf,.jpg,.jpeg,.png"
              disabled={uploadingRecordId !== null || isSubmitting}
            />
            <label 
              htmlFor={`proof_${record.id}`} 
              className="file-upload-status p-3 rounded border d-flex justify-content-center align-items-center"
              style={{cursor: "pointer"}}
            >
              {uploadingRecordId === record.id ? (
                <>
                  <span className="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                  <span>Uploading...</span>
                </>
              ) : (
                <>
                  <FaDownload className="me-2 text-primary" />
                  <span>Choose File</span>
                </>
              )}
            </label>
            <div className="file-upload-note text-center mt-1">
              Accepted formats: PDF, JPG, PNG (Max 5MB)
            </div>
          </div>
        )}
        {errors.identificationtype_details?.[index]?.proof && (
          <div className="invalid-feedback d-block">
            {errors.identificationtype_details[index].proof.message}
          </div>
        )}
      </div>
    </div>
  </div>
))}




/* Enhanced file upload styling */
.file-upload-container {
  width: 100%;
}

.file-upload-status {
  transition: all 0.2s ease;
  background-color: #f8f9fa;
  border: 1px solid #dee2e6 !important;
  min-height: 58px; /* Match the height of the input field */
}

.file-upload-status:hover {
  background-color: #e9ecef;
  border-color: #ced4da !important;
}

/* Align the input and file upload fields */
.align-items-end {
  align-items: flex-end !important;
}

/* Make the form labels consistent */
.form-label {
  font-weight: 500;
  color: #495057;
  margin-bottom: 0.5rem;
}

/* Style the icons in the form */
.form-label .me-2 {
  font-size: 1rem;
}

/* Style the file name display */
.text-truncate {
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Add some padding to the record container */
.mb-4.p-4.border.rounded.bg-light {
  background-color: #f8f9fa !important;
  border-color: #dee2e6 !important;
}

/* Style the buttons consistently */
.btn-outline-primary {
  color: #269ccc;
  border-color: #269ccc;
}

.btn-outline-primary:hover {
  background-color: #269ccc;
  color: white;
}

.btn-outline-danger {
  color: #dc3545;
  border-color: #dc3545;
}

.btn-outline-danger:hover {
  background-color: #dc3545;
  color: white;
}

/* Make the file upload note more visible */
.file-upload-note {
  color: #6c757d;
  font-size: 0.75rem;
}
