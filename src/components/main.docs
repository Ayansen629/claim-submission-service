.tabs-wrapper {
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  border: 1px solid #e9ecef;
  overflow: hidden;
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
}

.tabs-header {
  position: relative;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-bottom: 1px solid #e9ecef;
  padding: 12px 0 0 0; /* Removed bottom padding */
}

.tabs-header.with-arrows {
  padding: 12px 60px 0 60px; /* Removed bottom padding */
}

.scroll-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, #2E57A7, #1f4ea0);
  border: none;
  border-radius: 50%;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  box-shadow: 0 6px 20px rgba(46, 87, 167, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-size: 14px;
}

.scroll-btn:hover {
  transform: translateY(-50%) scale(1.1);
  box-shadow: 0 8px 25px rgba(46, 87, 167, 0.4);
}

.scroll-btn.left {
  left: 12px;
}

.scroll-btn.right {
  right: 12px;
}

.tabs-scroll {
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.tabs-scroll::-webkit-scrollbar {
  display: none;
}

.tab-list {
  display: flex;
  list-style: none;
  margin: 0;
  padding: 0 20px;
  gap: 4px;
  min-height: 56px; /* Reduced height */
  align-items: flex-end; /* Align to bottom */
}

.tab-item {
  flex-shrink: 0;
}

.tab-btn {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px 28px 18px 28px; /* Added more bottom padding */
  background: rgba(248, 249, 250, 0.8);
  border: 2px solid #e9ecef;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  color: #6c757d;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  white-space: nowrap;
  border-radius: 12px 12px 0 0; /* Only top corners rounded */
  min-height: 52px;
  overflow: hidden;
  border-bottom: none; /* Remove bottom border */
  margin-bottom: -1px; /* Pull up to cover header border */
}

.tab-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(46, 87, 167, 0.05), rgba(31, 78, 160, 0.05));
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: 12px 12px 0 0;
}

.tab-btn:hover::before {
  opacity: 1;
}

.tab-btn:hover {
  color: #2E57A7;
  background: rgba(255, 255, 255, 0.9);
  border-color: rgba(46, 87, 167, 0.3);
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(46, 87, 167, 0.15);
}

.tab-btn.active {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #28a745, #20c997); /* Green gradient */
  border-color: #20c997;
  box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4); /* Green shadow */
  transform: translateY(-4px);
  z-index: 5;
}

.tab-btn.active::before {
  opacity: 0;
}

.tab-btn.active::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(135deg, #28a745, #20c997);
}

.tab-icon {
  font-size: 16px;
  display: flex;
  align-items: center;
  transition: transform 0.3s ease;
}

.tab-btn:hover .tab-icon,
.tab-btn.active .tab-icon {
  transform: scale(1.15) rotate(5deg);
}

.tab-title {
  font-size: 14px;
  line-height: 1.4;
  font-weight: inherit;
  letter-spacing: 0.3px;
}

.tab-badge {
  background: linear-gradient(135deg, #dc3545, #c82333);
  color: white;
  border-radius: 12px;
  padding: 3px 8px;
  font-size: 11px;
  font-weight: 600;
  min-width: 20px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(220, 53, 69, 0.3);
}

.tab-btn.active .tab-badge {
  background: linear-gradient(135deg, #ffffff, #f8f9fa);
  color: #28a745;
  box-shadow: 0 2px 6px rgba(255, 255, 255, 0.3);
}

.tabs-content {
  padding: 0;
  background: #ffffff;
  min-height: 400px;
  border-radius: 0 0 16px 16px;
}

/* Responsive Design */
@media (max-width: 768px) {
  .tab-btn {
    padding: 14px 20px 16px 20px;
    font-size: 13px;
    min-height: 48px;
    gap: 8px;
  }
  
  .tab-list {
    padding: 0 16px;
    gap: 3px;
    min-height: 52px;
  }
  
  .scroll-btn {
    width: 40px;
    height: 40px;
    font-size: 12px;
  }
  
  .tabs-header.with-arrows {
    padding: 12px 52px 0 52px;
  }
}

@media (max-width: 480px) {
  .tab-btn {
    padding: 12px 16px 14px 16px;
    gap: 6px;
  }
  
  .tab-title {
    font-size: 13px;
  }
  
  .tab-list {
    padding: 0 12px;
    gap: 2px;
  }
}

/* Single tab styling */
.tab-list.single-tab {
  justify-content: center;
}

.tab-list.single-tab .tab-item {
  min-width: 200px;
}

.tab-list.single-tab .tab-btn {
  width: 100%;
  justify-content: center;
  padding: 18px 32px 20px 32px;
  font-size: 15px;
  font-weight: 600;
}

/* Dynamic width styling */
.tab-list.dynamic-width {
  display: grid;
  grid-template-columns: repeat(var(--tab-count, 1), 1fr);
  gap: 4px;
}

.tab-list.dynamic-width .tab-item {
  width: 100%;
}

.tab-list.dynamic-width .tab-btn {
  width: 100%;
  justify-content: center;
  padding: 16px 20px 18px 20px;
  font-size: 14px;
  font-weight: 600;
}

/* Beautiful glow effect for active tab */
.tab-btn.active {
  animation: activeGlow 2s ease-in-out infinite alternate;
}

@keyframes activeGlow {
  from {
    box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
  }
  to {
    box-shadow: 0 12px 35px rgba(40, 167, 69, 0.6);
  }
}
