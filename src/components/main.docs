import React, { useState } from "react";
import { Modal, Button, Container, Row, Col, Table } from "react-bootstrap";
import { FaDownload, FaClipboardList, FaFilePdf, FaBuilding, FaUser, FaIdCard, FaMoneyBillWave, FaUniversity, FaSignature, FaFileAlt, FaUsers } from "react-icons/fa";
import { PDFDownloadLink, Document, Page, Text, View, StyleSheet } from '@react-pdf/renderer';
import PreviewCard from "../../private/stepperForm/common-design/PreviewCard";
import Collapsible from "../../private/stepperForm/common-design/Collapsible";
import "./ApplicationDetailsView.css";

const ApplicationDetailsView = ({ show, onHide, modalData, fullModelData, handleDownload }) => {
  console.log("modalData", modalData);

  console.log(fullModelData,"fullModelData");
  const [showDocumentModal, setShowDocumentModal] = useState(false);
  
  // PDF Document component
  // const MyDocument = ({ modalData }) => (
  //   <Document>
  //     <Page style={styles.page}>
  //       <View style={styles.section}>
  //         <Text style={styles.header}>Application Details</Text>
  //         <Text style={styles.subHeader}>Application Number: {modalData?.applicationNumber || "N/A"}</Text>
          
  //         {/* Creditor & Identification Details */}
  //         <Text style={styles.sectionHeader}>Creditor & Identification Details</Text>
  //         {modalData?.step1?.creditorDetails && Object.entries(modalData.step1.creditorDetails).map(([key, value]) => (
  //           <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
  //         ))}
  //         {modalData?.step1?.identificationDetails && Object.entries(modalData.step1.identificationDetails).map(([key, value]) => (
  //           <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
  //         ))}
          
  //         {/* Claim Details */}
  //         <Text style={styles.sectionHeader}>Claim Details</Text>
  //         {modalData?.step2?.claimDetails && Object.entries(modalData.step2.claimDetails).map(([key, value]) => (
  //           <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
  //         ))}
          
  //         {/* Bank Details */}
  //         <Text style={styles.sectionHeader}>Bank Details</Text>
  //         {modalData?.step2?.bankDetails && Object.entries(modalData.step2.bankDetails).map(([key, value]) => (
  //           <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
  //         ))}
          
  //         {/* Supporting Documents */}
  //         <Text style={styles.sectionHeader}>Supporting Documents</Text>
  //         {modalData?.step2?.supportingDocuments && Object.entries(modalData.step2.supportingDocuments).map(([key, value]) => (
  //           <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
  //         ))}
          
  //         {/* Signatory Details */}
  //         <Text style={styles.sectionHeader}>Signatory Details</Text>
  //         {modalData?.step3?.signatoryDetails && Object.entries(modalData.step3.signatoryDetails).map(([key, value]) => (
  //           <Text style={styles.text} key={key}>{key}: {value || "N/A"}</Text>
  //         ))}
  //       </View>
  //     </Page>
  //   </Document>
  // );

  // // PDF styles
  // const styles = StyleSheet.create({
  //   page: {
  //     padding: 30,
  //   },
  //   header: {
  //     fontSize: 24,
  //     marginBottom: 10,
  //     textAlign: 'center',
  //     fontWeight: 'bold',
  //   },
  //   subHeader: {
  //     fontSize: 16,
  //     marginBottom: 20,
  //     textAlign: 'center',
  //   },
  //   sectionHeader: {
  //     fontSize: 18,
  //     marginTop: 15,
  //     marginBottom: 10,
  //     fontWeight: 'bold',
  //     borderBottom: '1 solid #000',
  //   },
  //   text: {
  //     fontSize: 12,
  //     marginBottom: 5,
  //   },
  //   section: {
  //     marginBottom: 10,
  //   },
  // });
// PDF Styles
const pdfStyles =StyleSheet.create({
  page: {
    padding: 30,
  },
  header: {
    fontSize: 24,
    marginBottom: 10,
    textAlign: 'center',
    fontWeight: 'bold',
  },
  subHeader: {
    fontSize: 16,
    marginBottom: 5,
    textAlign: 'center',
    fontWeight: '600',
  },
  subject: {
    fontSize: 14,
    marginTop: 5,
    marginBottom: 5,
    fontWeight: '600',
  },
  subSectionHeading: {
    fontSize: 12,
    marginBottom: 20,
    textAlign: 'center',
    fontWeight: '400',
  },
  sectionHeader: {
    fontSize: 18,
    marginTop: 15,
    marginBottom: 10,
    fontWeight: 'bold',
    borderBottom: '1 solid #000',
  },
  text: {
    fontSize: 12,
    marginBottom: 5,
  },
  section: {
    marginTop: 10,
  },
  table: {
    display: "table",
    width: "100%",
    marginTop: 10,
  },
  tableRow: {
    flexDirection: "row",
  },
  tableCell: {
    flex: 1,
    padding: 5,
    fontSize: 10,
  },
  tableHeader: {
    fontWeight: "bold",
    backgroundColor: "#f0f0f0",
  },
  rowBetween: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
  }
});


const MyDocument = ({ applicationData }) => {
  // Extract data from the API response
  const creditorBasic = applicationData?.creditorBasicDetails || {};
  const claimDetails = applicationData?.claimDetails || {};
  const signatoryDetails = applicationData?.signatoryDetails || {};
  const supportingDocs = applicationData?.supportingDocument?.documents || [];
  
  const creditorName = creditorBasic.financialCreditorName || "N/A";
  const creditorEmail = creditorBasic.financialCreditorEmail || "N/A";
  const address = `${creditorBasic.addressDetails?.addressLine1 || ""}, ${creditorBasic.addressDetails?.addressLine2 || ""}, ${creditorBasic.addressDetails?.city || ""}, ${creditorBasic.addressDetails?.state || ""} - ${creditorBasic.addressDetails?.pincode || ""}`;
  const city = creditorBasic.addressDetails?.city || "N/A";
  const claimAmount = claimDetails.claimAmount ? `₹${claimDetails.claimAmount}` : "N/A";
  const securityAmount = claimDetails.securityValue ? `₹${claimDetails.securityValue}` : "N/A";
  const guaranteeAmount = claimDetails.guaranteeValue ? `₹${claimDetails.guaranteeValue}` : "N/A";
  
  // Handle different claim types
  let entityData = [];
  let entityLabel = "";
  
  if (claimDetails.claimType === "PRINCIPAL_BORROWER") {
    entityData = claimDetails.guarantorDetails || [];
    entityLabel = "Guarantor";
  } else if (claimDetails.claimType === "GUARANTOR") {
    entityData = claimDetails.principalBorrowerDetails || [];
    entityLabel = "Principal Borrower";
  } else if (claimDetails.claimType === "BENEFICIARY") {
    entityData = claimDetails.beneficiaryDetails || [];
    entityLabel = "Beneficiary";
  }
  
  const debtDetails = claimDetails.debtIncurredDetails || "N/A";
  const debtDate = claimDetails.debtIncurredDate || "N/A";
  
  const signatoryName = signatoryDetails.financialCreditorName || "N/A";
  const signatoryPosition = signatoryDetails.positionOfCreditor || "N/A";
  const signatoryAddress = signatoryDetails.addressOfSigningPerson || "N/A";

  return (
    <Document>
      <Page style={pdfStyles.page}>
        <View style={pdfStyles.section}>
         <Text style={pdfStyles.header}>FORM C</Text>
                   <Text style={pdfStyles.subHeader}>SUBMISSION OF CLAIM BY FINANCIAL CREDITORS</Text>
                   <Text style={pdfStyles.subSectionHeading}>(Under Regulation 8 of the Insolvency and Bankruptcy Board of India (Insolvency Resolution Process for Corporate Persons) Regulations, 2016)</Text>
         
                   <View style={[pdfStyles.rowBetween, { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }]}>
                     <Text style={pdfStyles.text}>From</Text>
                     <Text style={pdfStyles.text}>{new Date().toLocaleDateString()}</Text>
                   </View>
                   <Text style={pdfStyles.text}>{creditorName}</Text>
                   <Text style={pdfStyles.text}>{address}</Text>
                   <Text style={pdfStyles.text}>Email: {creditorEmail}</Text>
                   <Text style={pdfStyles.text}>To</Text>
                   <Text style={pdfStyles.text}>The Interim Resolution Professional / Resolution Professional</Text>
                   {/* <Text style={pdfStyles.text}>[Name of the Insolvency Resolution Professional / Resolution Professional]</Text>
                   <Text style={pdfStyles.text}>[Address as set out in public announcement]</Text> */}
                   <Text style={pdfStyles.subject}>Subject: Submission of claim and proof of claim.</Text>
                   <Text style={pdfStyles.text}>
                     {creditorName}, hereby submits this claim in respect of the corporate{"\n"}
                     insolvency resolution process of [name of corporate debtor]. The details for the same{"\n"}
                     are setout below:
                   </Text>

          <View style={pdfStyles.table}>
            <View style={pdfStyles.tableRow}>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Name of the financial creditor</Text>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Email address</Text>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Address for correspondence</Text>
            </View>
            <View style={pdfStyles.tableRow}>
              <Text style={pdfStyles.tableCell}>{creditorName}</Text>
              <Text style={pdfStyles.tableCell}>{creditorEmail}</Text>
              <Text style={pdfStyles.tableCell}>{address}</Text>
            </View>
          </View>

          <View style={pdfStyles.table}>
            <View style={pdfStyles.tableRow}>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Amount of claim</Text>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Amount covered by security interest</Text>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Amount covered by guarantee</Text>
            </View>
            <View style={pdfStyles.tableRow}>
              <Text style={pdfStyles.tableCell}>{claimAmount}</Text>
              <Text style={pdfStyles.tableCell}>{securityAmount}</Text>
              <Text style={pdfStyles.tableCell}>{guaranteeAmount}</Text>
            </View>
          </View>

           <View style={pdfStyles.table}>
                      <View style={pdfStyles.tableRow}>
                        {/* <Text style={[styles.tableCell, styles.tableHeader]}>Principal Borrower</Text>
                        <Text style={[styles.tableCell, styles.tableHeader]}>Borrower Address</Text> */}
                        <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Details of debt</Text>
                        <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Date incurred</Text>
                      </View>
                      <View style={pdfStyles.tableRow}>
                        {/* <Text style={styles.tableCell}>{principalBorrower}</Text>
                        <Text style={styles.tableCell}>{principalBorrowerAddress}</Text> */}
                        <Text style={pdfStyles.tableCell}>{debtDetails}</Text>
                        <Text style={pdfStyles.tableCell}>{debtDate}</Text>
                      </View>
                    </View>

          {entityData.length > 0 && (
            <View style={pdfStyles.table}>
              <View style={pdfStyles.tableRow}>
                <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>{entityLabel} Name</Text>
                <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>{entityLabel} Address</Text>
              </View>
              {entityData.map((entity, index) => (
                <View key={index} style={pdfStyles.tableRow}>
                  <Text style={pdfStyles.tableCell}>{entity.name || "N/A"}</Text>
                  <Text style={pdfStyles.tableCell}>{entity.address || "N/A"}</Text>
                </View>
              ))}
            </View>
          )}

          <View style={pdfStyles.table}>
            <View style={pdfStyles.tableRow}>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Signatory Name</Text>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Position</Text>
              <Text style={[pdfStyles.tableCell, pdfStyles.tableHeader]}>Address</Text>
            </View>
            <View style={pdfStyles.tableRow}>
              <Text style={pdfStyles.tableCell}>{signatoryName}</Text>
              <Text style={pdfStyles.tableCell}>{signatoryPosition}</Text>
              <Text style={pdfStyles.tableCell}>{signatoryAddress}</Text>
            </View>
          </View>

          <View style={pdfStyles.section}>
            <Text style={pdfStyles.sectionHeader}>Supporting Documents</Text>
            {supportingDocs.map((doc, index) => (
              <View key={index} style={pdfStyles.tableRow}>
                <Text style={[pdfStyles.tableCell, { flex: 0.3 }]}>Document {index + 1}:</Text>
                <Text style={[pdfStyles.tableCell, { flex: 0.7 }]}>
                  {doc.docType} ({doc.docSource})
                </Text>
              </View>
            ))}
          </View>





          <Text style={pdfStyles.subHeader}>DECLARATION</Text>
          <Text style={pdfStyles.text}>
            I, {signatoryName}, currently residing at {signatoryAddress}, do hereby declare and state as follows: -
          </Text>
          <Text style={pdfStyles.text}>1. The corporate debtor was, at the insolvency commencement date, actually indebted to me for a sum of {claimAmount}.</Text>
          <Text style={pdfStyles.text}>2. In respect of my claim of the said sum or any part thereof, I have relied on the documents specified above.</Text>
          <Text style={pdfStyles.text}>3. The said documents are true, valid and genuine to the best of my knowledge, information and belief.</Text>
          <Text style={pdfStyles.text}>4. I undertake to update my claim as and when the claim is satisfied, partly or fully.</Text>

          <View style={[pdfStyles.rowBetween, { marginTop: 20 }]}>
            <Text style={pdfStyles.text}>Place: {city}</Text>
            <Text style={pdfStyles.text}>Signature of the claimant</Text>
          </View>
          
          <View style={[pdfStyles.rowBetween, { marginTop: 40 }]}>
            <Text style={pdfStyles.text}>Date: {new Date().toLocaleDateString()}</Text>
            <Text style={pdfStyles.text}>_________________________</Text>
          </View>
        </View>
      </Page>
    </Document>
  );
};
  // Helper function to get entity labels based on claim type
  const getEntityLabels = (claimType) => {
    switch (claimType) {
      case "PRINCIPAL_BORROWER":
        return {
          nameLabel: "Name of the guarantor",
          addressLabel: "Address of the guarantor",
          sectionTitle: "Guarantor Details"
        };
      case "GUARANTOR":
        return {
          nameLabel: "Name of the Principal Borrower",
          addressLabel: "Address of the Principal Borrower",
          sectionTitle: "Principal Borrower Details"
        };
      case "BENEFICIARY":
        return {
          nameLabel: "Name of the Beneficiary",
          addressLabel: "Address of the Beneficiary",
          sectionTitle: "Beneficiary Details"
        };
      default:
        return {
          nameLabel: "Name",
          addressLabel: "Address",
          sectionTitle: "Entity Details"
        };
    }
  };

  if (!modalData) return null;

  // Get entity labels based on claim type
  const entityLabels = getEntityLabels(fullModelData?.claimDetails?.claimType);

  // Get entity data based on claim type
  const getEntityData = () => {
    if (!fullModelData?.claimDetails) return [];
    
    switch (fullModelData.claimDetails.claimType) {
      case "PRINCIPAL_BORROWER":
        return fullModelData.claimDetails.guarantorDetails || [];
      case "GUARANTOR":
        return fullModelData.claimDetails.principalBorrowerDetails || [];
      case "BENEFICIARY":
        return fullModelData.claimDetails.beneficiaryDetails || [];
      default:
        return [];
    }
  };

  const entityData = getEntityData();

  return (
    <Modal
      show={show}
      onHide={onHide}
      dialogClassName="modal-1110w application-details-modal"
      aria-labelledby="application-details-title"
      centered
    >
      <Modal.Header closeButton className="modal-header">
        <Modal.Title id="application-details-title" className="modal-title">
          <FaFileAlt className="modal-title-icon" />
          Application Details
        </Modal.Title>
      </Modal.Header>
      
      <Modal.Body className="modal-body">
        <div className="application-header-container">
          <div className="application-number-container">
            <h4 className="application-number-label">Application Number:</h4>
            <div className="application-number-value">
              {modalData.applicationNumber || "N/A"}
            </div>
          </div>
          
          <button 
            className="action-button"
            onClick={() => setShowDocumentModal(true)}
            aria-label="View Documents"
          >
            <FaClipboardList />
          </button>
        </div>

        {/* Document Modal */}
        {showDocumentModal && (
          <div className="document-modal">
            <div className="document-modal-content">
              <div className="document-modal-header">
                <h2 className="document-modal-title">
                  Documents for Application
                </h2>
                <button 
                  className="document-modal-close"
                  onClick={() => setShowDocumentModal(false)}
                  aria-label="Close"
                >
                  &times;
                </button>
              </div>

              <Table className="document-table" responsive>
                <thead>
                  <tr>
                    <th style={{ width: "10%" }}>SL #</th>
                    <th style={{ width: "70%" }}>Document Name</th>
                    <th style={{ width: "20%" }}>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>1</td>
                    <td>
                      <div className="document-name">
                        <FaFilePdf className="document-icon" />
                        Full Application Form
                      </div>
                    </td>
                    <td>
                      <PDFDownloadLink 
                        document={<MyDocument applicationData={fullModelData} />} 
                        fileName={`application_${modalData.applicationNumber || 'form'}.pdf`}
                      >
                        {({ loading }) => (
                          <button
                            className="download-button"
                            disabled={loading}
                          >
                            {loading ? 'Generating...' : (
                              <>
                                <FaDownload className="download-icon" />
                                Download
                              </>
                            )}
                          </button>
                        )}
                      </PDFDownloadLink>
                    </td>
                  </tr>
                </tbody>
              </Table>

              <div className="document-modal-footer">
                <Button variant="secondary" onClick={() => setShowDocumentModal(false)}>
                  Close
                </Button>
              </div>
            </div>
          </div>
        )}

        {/* Creditor & Identification Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaUser className="me-2" />
              <span>Creditor & Identification Details</span>
            </div>
          } 
          defaultOpen={true}
        >
          {/* <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaUser className="details-card-title-icon" />
                Creditor Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step1?.creditorDetails && Object.entries(modalData.step1.creditorDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div> */}
         
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaUser className="details-card-title-icon" />
                Creditor Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Debtor Name" value={fullModelData.creditorBasicDetails?.financialDebtorName || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Creditor Name" value={fullModelData.creditorBasicDetails?.financialCreditorName || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Creditor Email" value={fullModelData.creditorBasicDetails?.financialCreditorEmail || "N/A"} />
                  </Col>
                </Row>
              </Container>
            </div>
          </div>
          
    {/* <div className="details-card-header">
      <h5 className="details-card-title">
        <FaUser className="details-card-title-icon" />
        Creditor Details
      </h5>
    </div> */}
   
  
  
  {/* Address Details */}
  <div className="details-card">
    <div className="details-card-header">
      <h5 className="details-card-title">
        <FaBuilding className="details-card-title-icon" />
        Address Details
      </h5>
    </div>
    <div className="details-card-body">
      <Container fluid>
        <Row className="g-3">
          <Col xs={12} sm={6} md={4} className="mb-3">
            <PreviewCard title="Address Line 1" value={fullModelData.creditorBasicDetails?.addressDetails?.addressLine1 || "N/A"} />
          </Col>
          <Col xs={12} sm={6} md={4} className="mb-3">
            <PreviewCard title="Address Line 2" value={fullModelData.creditorBasicDetails?.addressDetails?.addressLine2 || "N/A"} />
          </Col>
          <Col xs={12} sm={6} md={4} className="mb-3">
            <PreviewCard title="City" value={fullModelData.creditorBasicDetails?.addressDetails?.city || "N/A"} />
          </Col>
          <Col xs={12} sm={6} md={4} className="mb-3">
            <PreviewCard title="State" value={fullModelData.creditorBasicDetails?.addressDetails?.state || "N/A"} />
          </Col>
          <Col xs={12} sm={6} md={4} className="mb-3">
            <PreviewCard title="Pincode" value={fullModelData.creditorBasicDetails?.addressDetails?.pincode || "N/A"} />
          </Col>
        </Row>
      </Container>
    </div>
  </div>
          
          {/* Identification Details */}
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaIdCard className="details-card-title-icon" />
                Identification Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                {fullModelData?.creditorBasicDetails?.identificationTypeDetails?.identificationType && (
                  <div className="mb-3">
                    <PreviewCard 
                      title="Identification Type" 
                      value={fullModelData.creditorBasicDetails.identificationTypeDetails.identificationType === "INCORPORATED" 
                        ? "Incorporated Body" 
                        : "Partnership or Individual"} 
                    />
                  </div>
                )}
                
                {fullModelData?.creditorBasicDetails?.identificationTypeDetails?.identifications?.length > 0 && (
                  <div className="identification-records">
                    <h6 className="mb-3">Identification Records</h6>
                    {fullModelData.creditorBasicDetails.identificationTypeDetails.identifications.map((record, index) => (
                      <div key={index} className="mb-4 p-3 border rounded bg-light">
                        <h6 className="mb-3">Record {index + 1}</h6>
                        <Row className="g-3">
                          <Col xs={12} sm={6}>
                            <PreviewCard title="Identification Record" value={record.identificationRecord || "N/A"} />
                          </Col>
                          <Col xs={12} sm={6}>
                            <PreviewCard 
                              title="Proof Document" 
                              value={
                                record.proofOfIdentificationDocuments ? (
                                  <div className="d-flex align-items-center">
                                    <span className="me-2">{record.proofOfIdentificationDocuments.docName || "Document"}</span>
                                    {record.proofOfIdentificationDocuments.docId && (
                                      <Button 
                                        variant="link" 
                                        size="sm" 
                                        className="download-btn p-0"
                                        onClick={() => handleDownload(
                                          record.proofOfIdentificationDocuments.docId,
                                          record.proofOfIdentificationDocuments.docName
                                        )}
                                      >
                                        <FaDownload />
                                      </Button>
                                    )}
                                  </div>
                                ) : "N/A"
                              } 
                            />
                          </Col>
                        </Row>
                      </div>
                    ))}
                  </div>
                )}
              </Container>
            </div>
          </div>
        </Collapsible>

        {/* Claim Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaMoneyBillWave className="me-2" />
              <span>Claim Details</span>
            </div>
          }
          defaultOpen={true}
        >
          {/* <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaMoneyBillWave className="details-card-title-icon" />
                Claim Information
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.claimDetails && Object.entries(modalData.step2.claimDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div> */}
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaMoneyBillWave className="details-card-title-icon" />
                Claim Information
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Claim Type" value={fullModelData.claimDetails?.claimType || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Claim Amount" value={fullModelData.claimDetails?.claimAmount || "N/A"} />
                  </Col>
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Security Interest" value={fullModelData.claimDetails?.isAmountOfClaimCoverdBySecurityInterest ? "Yes" : "No"} />
                  </Col>
                  {fullModelData.claimDetails?.isAmountOfClaimCoverdBySecurityInterest && (
                    <>
                      <Col xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title="Security Value" value={fullModelData.claimDetails?.securityValue || "N/A"} />
                      </Col>
                      <Col xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title="Security Date" value={fullModelData.claimDetails?.securityDate || "N/A"} />
                      </Col>
                    </>
                  )}
                  <Col xs={12} sm={6} md={4} className="mb-3">
                    <PreviewCard title="Guarantee" value={fullModelData.claimDetails?.isAmountOfClaimCoverdByGuarantee ? "Yes" : "No"} />
                  </Col>
                  {fullModelData.claimDetails?.isAmountOfClaimCoverdByGuarantee && (
                    <>
                      <Col xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title="Guarantee Value" value={fullModelData.claimDetails?.guaranteeValue || "N/A"} />
                      </Col>
                      <Col xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title="Guarantee Date" value={fullModelData.claimDetails?.guaranteeDate || "N/A"} />
                      </Col>
                    </>
                  )}
                </Row>
              </Container>
            </div>
          </div>
          {/* Entity Details Section */}
          {fullModelData?.claimDetails?.claimType && (
            <div className="details-card">
              <div className="details-card-header">
                <h5 className="details-card-title">
                  <FaUsers className="details-card-title-icon" />
                  {entityLabels.sectionTitle}
                </h5>
              </div>
              <div className="details-card-body">
                <Container fluid>
                  {entityData.length > 0 ? (
                    entityData.map((entity, index) => (
                      <div key={index} className="mb-4 p-3 border rounded bg-light">
                        <h6 className="mb-3">{entityLabels.sectionTitle.replace(" Details", "")} {index + 1}</h6>
                        <Row className="g-3">
                          <Col xs={12} sm={6}>
                            <PreviewCard title={entityLabels.nameLabel} value={entity.name || "N/A"} />
                          </Col>
                          <Col xs={12} sm={6}>
                            <PreviewCard title={entityLabels.addressLabel} value={entity.address || "N/A"} />
                          </Col>
                        </Row>
                      </div>
                    ))
                  ) : (
                    <div className="alert alert-info">
                      No {entityLabels.sectionTitle.toLowerCase()} found
                    </div>
                  )}
                </Container>
              </div>
            </div>
          )}
          
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaUniversity className="details-card-title-icon" />
                Bank Details
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step2?.bankDetails && Object.entries(modalData.step2.bankDetails).map(([key, value]) => (
                    <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                      <PreviewCard title={key} value={value || "N/A"} />
                    </Col>
                  ))}
                </Row>
              </Container>
            </div>
          </div>
        </Collapsible>

      

        {/* Signatory Details */}
        <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaSignature className="me-2" />
              <span>Signatory Details</span>
            </div>
          }
          defaultOpen={true}
        >
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaSignature className="details-card-title-icon" />
                Signatory Information
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                <Row className="g-3">
                  {modalData.step3?.signatoryDetails && Object.entries(modalData.step3.signatoryDetails)
                    .filter(([key]) => key !== "Signature Document") // Filter out signature document to display separately
                    .map(([key, value]) => (
                      <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                        <PreviewCard title={key} value={value || "N/A"} />
                      </Col>
                    ))
                  }
                </Row>
                
                {/* Display signature document separately */}
                {fullModelData?.signatoryDetails?.document?.docId && (
                  <div className="mt-4 p-3 border rounded bg-light">
                    <h6 className="mb-3">Signature Document</h6>
                    <div className="d-flex align-items-center">
                      <span className="me-2">{fullModelData.signatoryDetails.document.docName || "Signature"}</span>
                      <Button 
                        variant="link" 
                        size="sm" 
                        className="download-btn p-0"
                        onClick={() => handleDownload(
                          fullModelData.signatoryDetails.document.docId,
                          fullModelData.signatoryDetails.document.docName
                        )}
                      >
                        <FaDownload />
                      </Button>
                    </div>
                  </div>
                )}
              </Container>
            </div>
          </div>
        </Collapsible>

          {/* Supporting Documents */}
          <Collapsible 
          title={
            <div className="d-flex align-items-center">
              <FaFileAlt className="me-2" />
              <span>Supporting Documents</span>
            </div>
          }
          defaultOpen={true}
        >
          <div className="details-card">
            <div className="details-card-header">
              <h5 className="details-card-title">
                <FaFileAlt className="details-card-title-icon" />
                Documents
              </h5>
            </div>
            <div className="details-card-body">
              <Container fluid>
                {fullModelData?.supportingDocument?.documents?.length > 0 ? (
                  fullModelData.supportingDocument.documents.map((doc, index) => (
                    <div key={index} className="mb-4 p-3 border rounded bg-light">
                      <Row className="g-3">
                        <Col xs={12} sm={6}>
                          <PreviewCard 
                            title="Document Type" 
                            value={doc.docSource === "identity_proof" ? "Identity Proof" : 
                                  doc.docSource === "address_proof" ? "Address Proof" : 
                                  doc.docSource} 
                          />
                        </Col>
                        <Col xs={12} sm={6}>
                          <PreviewCard 
                            title="Document" 
                            value={
                              <div className="d-flex align-items-center">
                                <span className="me-2">{doc.docName || "Document"}</span>
                                {doc.docId && (
                                  <Button 
                                    variant="link" 
                                    size="sm" 
                                    className="download-btn p-0"
                                    onClick={() => handleDownload(doc.docId, doc.docName)}
                                  >
                                    <FaDownload />
                                  </Button>
                                )}
                              </div>
                            } 
                          />
                        </Col>
                      </Row>
                    </div>
                  ))
                ) : (
                  <div className="alert alert-info">
                    No supporting documents found
                  </div>
                )}
              </Container>
            </div>
          </div>
        </Collapsible>
      </Modal.Body>
      
      <Modal.Footer className="modal-footer">
        <Button variant="secondary" onClick={onHide}>
          Close
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default ApplicationDetailsView;
