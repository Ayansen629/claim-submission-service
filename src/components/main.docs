const handlePayNow = () => {
  // Console all form data from both steps
  const allFormData = methods.getValues();
  
  console.log("=== PAY NOW - ALL FORM DATA ===");
  console.log("Complete Form Data:", allFormData);
  console.log("Step 1 - Survey Details:", {
    typeOfSurvey: allFormData.typeOfSurvey,
    placeYardNo: allFormData.placeYardNo,
    netTonnage: allFormData.netTonnage,
    hullLength: allFormData.hullLength,
    hullBreadth: allFormData.hullBreadth,
    hullDepth: allFormData.hullDepth,
    crewDetails: allFormData.crewDetails,
    files: {
      authorizationFile: allFormData.authorizationFile,
      paymentChallan: allFormData.paymentChallan,
      lastCertificateCopy: allFormData.lastCertificateCopy,
      registrationCertificateCopy: allFormData.registrationCertificateCopy
    }
  });
  console.log("Step 2 - Equipment Data:", {
    // Add any equipment form fields that are stored in the main form
    equipmentData: "Equipment data from VesselEquipmentForm component"
  });
  console.log("===============================");
  
  setShowModal(true);
};
