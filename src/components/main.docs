import React, { useState } from "react";

const images = [
  "https://images.unsplash.com/photo-1506744038136-46273834b3fb", // Replace with your image URLs
  "https://images.unsplash.com/photo-1465101046530-73398c7f28ca",
  "https://images.unsplash.com/photo-1507525428034-b723cf961d3e"
];

const Carousel = () => {
  const [current, setCurrent] = useState(0);

  const prevSlide = () => {
    setCurrent(current === 0 ? images.length - 1 : current - 1);
  };

  const nextSlide = () => {
    setCurrent(current === images.length - 1 ? 0 : current + 1);
  };

  return (
    <div style={{
      width: "600px",
      margin: "40px auto",
      background: "#fff",
      borderRadius: "16px",
      boxShadow: "0 4px 24px rgba(0,0,0,0.08)",
      padding: "32px 0",
      position: "relative"
    }}>
      <div style={{ display: "flex", justifyContent: "center", alignItems: "center" }}>
        <button
          onClick={prevSlide}
          style={{
            background: "rgba(0,0,0,0.1)",
            border: "none",
            borderRadius: "50%",
            width: "40px",
            height: "40px",
            fontSize: "24px",
            cursor: "pointer",
            marginRight: "16px"
          }}
          aria-label="Previous"
        >
          &#8592;
        </button>
        <img
          src={images[current]}
          alt={`Slide ${current + 1}`}
          style={{
            width: "400px",
            height: "220px",
            objectFit: "cover",
            borderRadius: "12px",
            boxShadow: "0 2px 8px rgba(0,0,0,0.12)"
          }}
        />
        <button
          onClick={nextSlide}
          style={{
            background: "rgba(0,0,0,0.1)",
            border: "none",
            borderRadius: "50%",
            width: "40px",
            height: "40px",
            fontSize: "24px",
            cursor: "pointer",
            marginLeft: "16px"
          }}
          aria-label="Next"
        >
          &#8594;
        </button>
      </div>
      <div style={{ textAlign: "center", marginTop: "16px" }}>
        {images.map((_, idx) => (
          <span
            key={idx}
            style={{
              display: "inline-block",
              width: "10px",
              height: "10px",
              borderRadius: "50%",
              background: idx === current ? "#007bff" : "#d3d3d3",
              margin: "0 4px"
            }}
          />
        ))}
      </div>
    </div>
  );
};

export default Carousel;
