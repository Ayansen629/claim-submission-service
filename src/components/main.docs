// In your EmployeeDashboard.jsx
import SurveyTrackerCard from './SurveyTrackerCard';
import { OFFICER_L2_STAT_DATA } from './employeeDashboardConstants';

// ... other imports and code ...

// In your stats rendering section:
{getStatData().map((item, index) => (
  <div className="col-md-4 col-lg-3 col-sm-12" key={index}>
    {item.isCalendar ? (
      <SurveyTrackerCard events={item.events} />
    ) : (
      <StatusCard {...item} />
    )}
  </div>
))}
