export const VESSEL_COLUMNS = [
    {
        colName: "Registration No.",
        fieldName: "registrationNo",
        clsName: "column-text-start",
        render: (value) => (
            <a 
                href={`/vessel-registration/new-vessel/edit-${value}`}
                style={{ color: '#007bff', textDecoration: 'none' }}
                onMouseOver={(e) => e.target.style.textDecoration = 'underline'}
                onMouseOut={(e) => e.target.style.textDecoration = 'none'}
            >
                {value}
            </a>
        ),
    },
    {
        colName: "Vessel Name",
        fieldName: "vesselName",
        clsName: "column-text-start",
    },
    {
        colName: "Registered Year",
        fieldName: "registeredYear",
        clsName: "column-text-start",
    },
    {
        colName: "Last Survey Date",
        fieldName: "lastSurveyDate",
        clsName: "column-text-start",
    },
];
