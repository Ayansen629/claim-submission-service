const submitIntialSurveyData = async (surveyPayload, stepInfo = null) => {
  try {
    loaderRef.current?.show();
    const apiUrl =
      SERVICE_BASE.IWT_SURVEY_SERVICE +
      URLS_ENDPOINT.SURVEY_SERVICE.SURVEY_CREATE;

    const response = await postData(apiUrl, surveyPayload);
    console.log("=== SURVEY RESPONSE ===", response?.data);
    console.log("full reposne", response);

    if (response?.status === 200 || response?.status === 201) {
      setIntialSurveyData(response?.data || []);

      // Fix the message handling
      if (isOfficerLogin && isViewMode && !stepInfo) {
        toast.success("Survey form data saved successfully!");
      } else {
        // Try multiple possible message paths
        const successMessage = 
          response?.data?.responseStatus?.message ||
          response?.data?.message ||
          response?.message ||
          (stepInfo?.index === 1 ? "Equipment data saved successfully!" : "Initial survey data submitted successfully!");
        
        toast.success(successMessage);
      }

      if (stepInfo) {
        stepperRef.current?.goToNextStep();
        if (stepInfo?.index === 1) {
          fetchPaymentDetails();
        }
      }
    } else {
      // Fix error message handling too
      const errorMessage = 
        response?.data?.responseStatus?.message ||
        response?.data?.message ||
        response?.message ||
        "Failed to submit survey data.";
      
      toast.error(errorMessage);
    }
  } catch (err) {
    handleErrorMessage(
      err?.response?.data ||
      "Failed to save survey. Check console for details."
    );
  } finally {
    loaderRef?.current?.hide();
  }
};
