// Add to step3 fields in formFields
step3: [
  ...getDocumentsForOwner(formData, null, t),
  ...(isExistingUser
    ? [
        {
          name: "EXISTING_DOCUMENTS",
          label: t("vesselOwnerRegistration.Existing Documents"),
          code: "EXISTING_DOCUMENT", // Updated code
          type: "file",
          required: true,
          colSize: 6,
        },
      ]
    : []),
  {
    name: "authorizationLetter",
    label: t("vesselOwnerRegistration.Letter of Authorization"),
    code: "AUTHORIZATION_LETTER", // Add code
    type: "file",
    required: false,
    colSize: 12,
  },
  {
    name: "additionalDocuments",
    label: t("vesselOwnerRegistration.Additional_Documents"),
    type: "multifile",
    code: "ADDITIONAL_DOCUMENT",
    required: false,
    colSize: 12,
  },
],
