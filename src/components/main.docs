import React, { useRef, useEffect } from "react";
import { useNavigate, useParams } from "react-router-dom";
import { useForm } from "react-hook-form";
import { Container, Row, Col, Card, Button } from "react-bootstrap";
import { toast } from "react-toastify";
import {
  FaUser,
  FaMapMarkerAlt,
  FaBriefcase,
  FaFileUpload,
  FaGraduationCap,
  FaPlus,
  FaTrash
} from "react-icons/fa";
import InputText from "../../../common/InputText.tsx";
import InputSelect from "../../../common/InputSelect.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { CONSTANT_REGEX } from "../../../../utils/constants.ts";
import { useMasterData } from "../../../context/MasterDataContext.js";
import NewLoader from "../../../common/NewLoader.js";
import "./EmployeeRegistration.css";
import { getData } from "../../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";

const EmployeeRegistration = () => {
  const navigate = useNavigate();
  const { id } = useParams();
  const isEditMode = !!id;
  const loaderRef = useRef();
  const { masterData } = useMasterData();
  
  // Form setup with explicit validation mode
  const {
    register,
    handleSubmit,
    formState: { errors },
    setValue,
    watch,
    reset,
    control,
  } = useForm({
    mode: "onSubmit",
    defaultValues: {
      vesselUserDetails: {
        firstName: "",
        lastName: "",
        email: "",
        phoneNumber: "",
        gender: "",
        dateOfBirth: "",
        addressLine1: "",
        addressLine2: "",
        pin: "",
        district: "",
        stateUt: "",
        country: "India",
      },
      professional: {
        appointmentDate: "",
        employeeType: "",
        employeeStatus: "",
        designation: "",
        department: "Shipping", // Default department
        section: "",
        roles: "",
      },
      educationDetails: [{
        qualification: "",
        stream: "",
        yearOfPassing: "",
      }],
      documents: {
        addressProof: "",
        identityProof: "",
        appointmentLetter: "",
      }
    },
  });

  const { fields, append, remove } = useFieldArray({
    control,
    name: "educationDetails"
  });

  const watchPin = watch("vesselUserDetails.pin");
  const watchDesignation = watch("professional.designation");

  // Auto-populate department based on designation
  useEffect(() => {
    if (watchDesignation) {
      // This is a simplified example - you would need to map designations to departments
      // based on your business logic or master data
      setValue("professional.department", "Shipping"); // Default department
    }
  }, [watchDesignation, setValue]);

  // Improved pincode lookup with debounce
  useEffect(() => {
    const timer = setTimeout(() => {
      const fetchAddressDetails = async (pin) => {
        if (pin?.length === 6) {
          try {
            loaderRef.current?.show();
            const URL = process.env.REACT_APP_PUBLIC_URL + URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE + pin;
            const response = await getData(URL);
            if (response?.status === 200 && response?.data?.length > 0) {
              setValue('vesselUserDetails.district', response?.data[0]?.district || "");
              setValue('vesselUserDetails.stateUt', response?.data[0]?.stateName || "");
              setValue("vesselUserDetails.country", "India");
            } else {
              setValue("vesselUserDetails.district", "");
              setValue("vesselUserDetails.stateUt", "");
              setValue("vesselUserDetails.country", "India");
            }
          } catch (error) {
            console.error("Error fetching pincode details:", error);
            setValue("vesselUserDetails.district", "");
            setValue("vesselUserDetails.stateUt", "");
            setValue("vesselUserDetails.country", "India");
          } finally {
            loaderRef.current?.hide();
          }
        }
      };
  
      if (watchPin) {
        fetchAddressDetails(watchPin);
      }
    }, 500); // 500ms debounce

    return () => clearTimeout(timer);
  }, [watchPin, setValue]);

  const onSubmit = async (data) => {
    try {
      console.log("Form submitted with data:", data);
      loaderRef.current?.show();
      
      // Simulate API call
      setTimeout(() => {
        toast.success(isEditMode ? "Employee updated successfully!" : "Employee registered successfully!");
        loaderRef.current?.hide();
        navigate("/iwt/employee-management");
      }, 1000);
      
    } catch (error) {
      console.error("Error submitting form:", error);
      toast.error("Error submitting form");
      loaderRef.current?.hide();
    }
  };

  const handleCancel = () => {
    navigate("/iwt/employee-management");
  };

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="p-4">
        <Card className="mb-4">
          <Card.Header className="bg-primary text-white">
            <h5 className="mb-0">{isEditMode ? "Edit Employee" : "Add Employee"}</h5>
          </Card.Header>
          <Card.Body>
            <form onSubmit={handleSubmit(onSubmit)} className="employee-form">
              {/* Personal Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaUser className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>Personal Details</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="vesselUserDetails.firstName"
                          label="First Name"
                          placeholder="Enter first name"
                          required={true}
                          register={register("vesselUserDetails.firstName", {
                            required: "First Name is required",
                          })}
                          errors={errors.vesselUserDetails?.firstName}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="vesselUserDetails.lastName"
                          label="Last Name"
                          placeholder="Enter last name"
                          required={true}
                          register={register("vesselUserDetails.lastName", {
                            required: "Last Name is required",
                          })}
                          errors={errors.vesselUserDetails?.lastName}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="vesselUserDetails.email"
                          label="Email ID"
                          type="email"
                          placeholder="Enter email address"
                          required={true}
                          register={register("vesselUserDetails.email", {
                            required: "Email is required",
                            pattern: {
                              value: CONSTANT_REGEX.EMAIL,
                              message: "Invalid email address",
                            },
                          })}
                          errors={errors.vesselUserDetails?.email}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="vesselUserDetails.phoneNumber"
                          label="Phone Number"
                          placeholder="Enter 10-digit phone number"
                          required={true}
                          register={register("vesselUserDetails.phoneNumber", {
                            required: "Phone Number is required",
                            pattern: {
                              value: CONSTANT_REGEX.MOBILE,
                              message: "Phone number must be 10 digits",
                            },
                          })}
                          errors={errors.vesselUserDetails?.phoneNumber}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="vesselUserDetails.gender"
                          label="Gender"
                          required={true}
                          options={[
                            { value: "", label: "Select Gender", disabled: true },
                            ...(masterData?.genders?.map(type => ({
                              value: type.valueCode,
                              label: type.valueLabel
                            })) || [])
                          ]}
                          register={register("vesselUserDetails.gender", {
                            required: "Gender is required",
                          })}
                          errors={errors.vesselUserDetails?.gender}
                          value={watch("vesselUserDetails.gender")}
                          onChange={(value) => setValue("vesselUserDetails.gender", value)}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="vesselUserDetails.dateOfBirth"
                          label="Date of Birth"
                          type="date"
                          placeholder="Select date of birth"
                          required={true}
                          register={register("vesselUserDetails.dateOfBirth", {
                            required: "Date of Birth is required",
                          })}
                          errors={errors.vesselUserDetails?.dateOfBirth}
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Address Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaMapMarkerAlt className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>Address Details</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={6}>
                        <InputText
                          name="vesselUserDetails.addressLine1"
                          label="Address Line-1"
                          placeholder="Enter address line 1"
                          required={true}
                          register={register("vesselUserDetails.addressLine1", {
                            required: "Address Line-1 is required",
                          })}
                          errors={errors.vesselUserDetails?.addressLine1}
                        />
                      </Col>
                      <Col md={6}>
                        <InputText
                          name="vesselUserDetails.addressLine2"
                          label="Address Line-2"
                          placeholder="Enter address line 2 (optional)"
                          register={register("vesselUserDetails.addressLine2")}
                          errors={errors.vesselUserDetails?.addressLine2}
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="vesselUserDetails.pin"
                          label="PIN"
                          placeholder="Enter 6-digit PIN code"
                          required={true}
                          register={register("vesselUserDetails.pin", {
                            required: "PIN Code is required",
                            pattern: {
                              value: /^[0-9]{6}$/,
                              message: "PIN must be 6 digits",
                            },
                          })}
                          errors={errors.vesselUserDetails?.pin}
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="vesselUserDetails.district"
                          label="District"
                          placeholder="Auto-populated"
                          register={register("vesselUserDetails.district")}
                          errors={errors.vesselUserDetails?.district}
                          readOnly
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="vesselUserDetails.stateUt"
                          label="State/UT"
                          placeholder="Auto-populated"
                          register={register("vesselUserDetails.stateUt")}
                          errors={errors.vesselUserDetails?.stateUt}
                          readOnly
                        />
                      </Col>
                      <Col md={3}>
                        <InputText
                          name="vesselUserDetails.country"
                          label="Country"
                          placeholder="Auto-populated"
                          register={register("vesselUserDetails.country")}
                          errors={errors.vesselUserDetails?.country}
                          readOnly
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Education Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaGraduationCap className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>Education Details</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    {fields.map((field, index) => (
                      <div key={field.id} className="education-entry mb-4">
                        {index > 0 && <div className="entry-divider mb-3"></div>}
                        <Row className="g-3">
                          <Col md={4}>
                            <InputText
                              name={`educationDetails.${index}.qualification`}
                              label={`Qualification ${index === 0 ? '*' : ''}`}
                              placeholder="Enter qualification"
                              required={index === 0}
                              register={register(`educationDetails.${index}.qualification`, {
                                required: index === 0 ? "Qualification is required" : false
                              })}
                              errors={errors.educationDetails?.[index]?.qualification}
                            />
                          </Col>
                          <Col md={4}>
                            <InputText
                              name={`educationDetails.${index}.stream`}
                              label={`Stream ${index === 0 ? '*' : ''}`}
                              placeholder="Enter stream"
                              required={index === 0}
                              register={register(`educationDetails.${index}.stream`, {
                                required: index === 0 ? "Stream is required" : false
                              })}
                              errors={errors.educationDetails?.[index]?.stream}
                            />
                          </Col>
                          <Col md={3}>
                            <InputText
                              name={`educationDetails.${index}.yearOfPassing`}
                              label={`Year of Passing ${index === 0 ? '*' : ''}`}
                              placeholder="Enter year"
                              type="number"
                              required={index === 0}
                              register={register(`educationDetails.${index}.yearOfPassing`, {
                                required: index === 0 ? "Year of Passing is required" : false,
                                min: {
                                  value: 1900,
                                  message: "Year must be after 1900"
                                },
                                max: {
                                  value: new Date().getFullYear(),
                                  message: "Year cannot be in the future"
                                }
                              })}
                              errors={errors.educationDetails?.[index]?.yearOfPassing}
                            />
                          </Col>
                          <Col md={1} className="d-flex align-items-end">
                            {index > 0 && (
                              <Button
                                variant="danger"
                                size="sm"
                                onClick={() => remove(index)}
                                className="mt-1"
                              >
                                <FaTrash />
                              </Button>
                            )}
                          </Col>
                        </Row>
                      </div>
                    ))}
                    <Button
                      variant="outline-primary"
                      onClick={() => append({ qualification: "", stream: "", yearOfPassing: "" })}
                      className="mt-2"
                    >
                      <FaPlus className="me-2" /> Add Education
                    </Button>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Professional Details Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaBriefcase className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>Professional Details</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="professional.appointmentDate"
                          label="Appointment Date"
                          type="date"
                          placeholder="Select appointment date"
                          required={true}
                          register={register("professional.appointmentDate", {
                            required: "Appointment Date is required",
                          })}
                          errors={errors.professional?.appointmentDate}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="professional.employeeType"
                          label="Employee Type"
                          required={true}
                          options={[
                            { value: "", label: "Select Employee Type", disabled: true },
                            ...(masterData?.employeeTypes?.map(type => ({
                              value: type.valueCode,
                              label: type.valueLabel
                            })) || [])
                          ]}
                          register={register("professional.employeeType", {
                            required: "Employee Type is required",
                          })}
                          errors={errors.professional?.employeeType}
                          value={watch("professional.employeeType")}
                          onChange={(value) => setValue("professional.employeeType", value)}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="professional.employeeStatus"
                          label="Employee Status"
                          required={true}
                          options={[
                            { value: "", label: "Select Employee Status", disabled: true },
                            ...(masterData?.employeeStatuses?.map(type => ({
                              value: type.valueCode,
                              label: type.valueLabel
                            })) || [])
                          ]}
                          register={register("professional.employeeStatus", {
                            required: "Employee Status is required",
                          })}
                          errors={errors.professional?.employeeStatus}
                          value={watch("professional.employeeStatus")}
                          onChange={(value) => setValue("professional.employeeStatus", value)}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="professional.designation"
                          label="Designation"
                          required={true}
                          options={[
                            { value: "", label: "Select Designation", disabled: true },
                            ...(masterData?.designations?.map(type => ({
                              value: type.valueCode,
                              label: type.valueLabel
                            })) || [])
                          ]}
                          register={register("professional.designation", {
                            required: "Designation is required",
                          })}
                          errors={errors.professional?.designation}
                          value={watch("professional.designation")}
                          onChange={(value) => setValue("professional.designation", value)}
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="professional.department"
                          label="Department"
                          placeholder="Auto-populated"
                          register={register("professional.department")}
                          errors={errors.professional?.department}
                          readOnly
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="professional.section"
                          label="Section"
                          placeholder="Enter section"
                          register={register("professional.section")}
                          errors={errors.professional?.section}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="professional.roles"
                          label="Roles"
                          required={true}
                          options={[
                            { value: "", label: "Select Role", disabled: true },
                            ...(masterData?.roles?.map(type => ({
                              value: type.valueCode,
                              label: type.valueLabel
                            })) || [])
                          ]}
                          register={register("professional.roles", {
                            required: "Role is required",
                          })}
                          errors={errors.professional?.roles}
                          value={watch("professional.roles")}
                          onChange={(value) => setValue("professional.roles", value)}
                        />
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Documents Upload Section */}
              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
                    <span style={{ color: "#2466BF" }}>Documents Upload</span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="documents.addressProof"
                          label="Address Proof"
                          type="file"
                          required={true}
                          register={register("documents.addressProof", {
                            required: "Address Proof is required",
                          })}
                          errors={errors.documents?.addressProof}
                        />
                        <small className="text-muted">
                          Upload PDF, JPG or PNG (Max: 2MB)
                        </small>
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="documents.identityProof"
                          label="Identity Proof"
                          type="file"
                          required={true}
                          register={register("documents.identityProof", {
                            required: "Identity Proof is required",
                          })}
                          errors={errors.documents?.identityProof}
                        />
                        <small className="text-muted">
                          Upload PDF, JPG or PNG (Max: 2MB)
                        </small>
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="documents.appointmentLetter"
                          label="Appointment Letter"
                          type="file"
                          required={true}
                          register={register("documents.appointmentLetter", {
                            required: "Appointment Letter is required",
                          })}
                          errors={errors.documents?.appointmentLetter}
                        />
                        <small className="text-muted">
                          Upload PDF, JPG or PNG (Max: 2MB)
                        </small>
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Form Actions */}
              <div className="d-flex justify-content-end mt-4 gap-2">
                <Button 
                  variant="secondary" 
                  onClick={handleCancel}
                >
                  Cancel
                </Button>
                <Button 
                  variant="primary" 
                  type="submit"
                  style={{
                    background: "linear-gradient(135deg, #0077b6, #023e8a)",
                    border: "none",
                    boxShadow: "0 4px 6px rgba(0, 0, 0, 0.1)",
                    padding: "8px 20px",
                  }}
                >
                  {isEditMode ? "Update" : "Submit"}
                </Button>
              </div>
            </form>
          </Card.Body>
        </Card>
      </Container>
    </>
  );
};

export default EmployeeRegistration;
