import React from "react";
import { useLocation, useNavigate, useParams } from "react-router-dom";
import DynamicTabs from "../../../common/DynamicTabs";
import VesselSurveyRegistration from "./survey/VesselSurveyRegistration";
import VesselReportsAndDocs from "./common/VesselReportsAndDocs";
import { useTranslation } from "react-i18next";
import { Button } from "react-bootstrap";
import { Box, Typography, Stack } from "@mui/material";
import { BsArrowLeft, BsFileText, BsClipboardCheck } from "react-icons/bs";

const VesselApplicationDetailsView = () => {
  const { t } = useTranslation();
  const { id } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  const { rowData } = location?.state || {};
  
  const tabs = [
    {
      key: "registration",
      title: t("Registration Information"),
      icon: <BsFileText />,
      content: <VesselReportsAndDocs applicationNo={id} viewMode tabMode />,
    },
    ...(rowData?.enableInitialSurvey
      ? [
          {
            key: "survey",
            title: t("Initial Survey - Details"),
            icon: <BsClipboardCheck />,
            content: (
              <VesselSurveyRegistration applicationNo={id} viewMode tabMode />
            ),
          },
        ]
      : []),
  ];

  return (
    <Box
      sx={{
        padding: "1rem",
        backgroundColor: "#f8f9fa",
        minHeight: "100vh",
      }}
    >
      {/* Header */}
      <Box 
        sx={{ 
          display: 'flex', 
          alignItems: 'center', 
          mb: 3,
          padding: "16px 20px",
          background: "#ffffff",
          borderRadius: "12px",
          boxShadow: "0 2px 12px rgba(0, 0, 0, 0.08)",
          border: "1px solid #e9ecef",
        }}
      >
        <Button
          variant="outline-primary"
          onClick={() => navigate("/dashboard")}
          style={{
            borderRadius: "8px",
            width: 40,
            height: 40,
            border: "2px solid #2E57A7",
            color: "#2E57A7",
            backgroundColor: "#fff",
            transition: "all 0.3s ease",
            padding: 0,
            marginRight: 16,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
          }}
          onMouseEnter={(e) => {
            e.target.style.backgroundColor = "#2E57A7";
            e.target.style.color = "#fff";
            e.target.style.transform = "translateY(-2px)";
            e.target.style.boxShadow = "0 4px 12px rgba(46, 87, 167, 0.3)";
          }}
          onMouseLeave={(e) => {
            e.target.style.backgroundColor = "#fff";
            e.target.style.color = "#2E57A7";
            e.target.style.transform = "translateY(0)";
            e.target.style.boxShadow = "none";
          }}
        >
          <BsArrowLeft size={16} />
        </Button>
        
        <Stack direction="row" spacing={2} alignItems="center">
          <Typography
            sx={{
              fontWeight: 600,
              color: "#2E57A7",
              fontSize: "1.3rem",
              lineHeight: 1.3,
            }}
          >
            {t("Vessel Application Details")}
          </Typography>
          
          {id && (
            <Box
              sx={{
                background: "linear-gradient(135deg, #e3f2fd, #f3e5f5)",
                borderRadius: "8px",
                padding: "6px 12px",
                border: "1px solid #bbdefb",
              }}
            >
              <Typography
                sx={{
                  color: "#1976d2",
                  fontSize: "0.9rem",
                  fontWeight: 600,
                }}
              >
                {id}
              </Typography>
            </Box>
          )}
        </Stack>
      </Box>
      
      {/* Tabs */}
      <DynamicTabs tabs={tabs} />
    </Box>
  );
};

export default VesselApplicationDetailsView;
