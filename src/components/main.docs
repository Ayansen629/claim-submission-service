const populateFormWithTransferData = (data) => {
  console.log("Populating form with data:", data);
  if (!data) return;
  
  const { RegistrationResponse, IwtInitialSurveyResponse } = data;
  
  // Basic vessel information
  if (RegistrationResponse?.vesselDetails) {
    const vessel = RegistrationResponse.vesselDetails;
    setValue('vesselDetails.portOfRegistry', vessel.previousPort || '');
    setValue('basicVesselInfo.officialNo', vessel.registrationNumber || '');
    setValue('vesselDetails.vesselName', vessel.vesselName || '');
    setValue('vesselDetails.typeOfVessel', vessel.typeOfVessel || '');
    setValue('vesselDetails.categoryOfVessel', vessel.categoryOfVessel || '');
    setValue('vesselDetails.yearOfBuild', vessel.yearOfBuild || '');
    setValue('vesselDetails.grossTonnage', vessel.grossTonnage || '');
    // setValue('vesselDetails.lengthOfVessel', vessel.lengthOfVessel || '');
    // setValue('vesselDetails.breadthOfVessel', vessel.breadthOfVessel || '');
    // setValue('vesselDetails.depthOfVessel', vessel.depthOfVessel || '');
    setValue('basicVesselInfo.proposedPortOfRegistry', vessel.portOfRegistry || '');
    setValue('basicVesselInfo.reasonForTransfer', vessel.reasonOfChange || '');
    setValue('basicVesselInfo.proposedPortOfRegistryAddress', vessel.addressOfPort || '');
  }

  // Owner details
  if (RegistrationResponse?.basicDetails?.ownerDetails) {
    const owner = RegistrationResponse.basicDetails.ownerDetails;
    setValue('basicDetails.ownerDetails.nameOfOwner', owner.ownerCompanyName || '');
    setValue('basicDetails.ownerDetails.addressLine1', owner.addressLine1 || '');
    setValue('basicDetails.ownerDetails.phoneNumber', owner.phoneNumber || '');
  }

  // Builder details
  if (RegistrationResponse?.basicDetails?.builderDetails) {
    const builder = RegistrationResponse.basicDetails.builderDetails;
    setValue('basicDetails.builderDetails.builderName', builder.builderName || '');
    setValue('basicDetails.builderDetails.addressLine1', builder.addressLine1 || '');
    setValue('basicDetails.builderDetails.addressLine2', builder.addressLine2 || '');
    setValue('basicDetails.builderDetails.pin', builder.pin || '');
    setValue('basicDetails.builderDetails.district', builder.district || '');
    setValue('basicDetails.builderDetails.state', builder.state || '');
    setValue('basicDetails.builderDetails.country', builder.country || 'India');
  }

  // Engine details
  if (RegistrationResponse?.engineDetails) {
    const engine = RegistrationResponse.engineDetails;
    setValue('engineDetails.engineType', engine.engineType || '');
    setValue('engineDetails.engineMake', engine.engineMake || '');
    setValue('engineDetails.makerAddress', engine.makerAddress || '');
    setValue('engineDetails.horsepower', engine.horsepower || '');
    setValue('engineDetails.speed', engine.speed || '');
    setValue('engineDetails.yearOfMake', engine.yearOfMake || '');
    setValue('engineDetails.modelNo', engine.modelNo || '');
    setValue('engineDetails.numberOfEngine', engine.numberOfEngine || '');
    setValue('engineDetails.noOfSet', engine.noOfSet || '');
    setValue('engineDetails.serialNo', engine.serialNo || '');
    setValue('engineDetails.propellerType', engine.propellerType || '');
    setValue('engineDetails.gearType', engine.gearType || '');
    setValue('engineDetails.noOfGear', engine.noOfGear || '');
    setValue('engineDetails.vesselSpeed', engine.vesselSpeed || '');
    setValue('engineDetails.rpm', engine.rpm || '');
    setValue('engineDetails.engineCylinder', engine.engineCylinder || '');
    setValue('engineDetails.stroke', engine.stroke || '');
    setValue('engineDetails.noOfCylinderPerSetRotaryEngine', engine.noOfCylinderPerSetRotaryEngine || '');
    setValue('engineDetails.noOfCylinderPerSetReciprocatingEngine', engine.noOfCylinderPerSetReciprocatingEngine || '');
    setValue('engineDetails.noOfShaft', engine.noOfShaft || '');
    setValue('engineDetails.lengthOfEngineRoom', engine.lengthOfEngineRoom || '');
  }

  // Survey data from IwtInitialSurveyResponse
  if (IwtInitialSurveyResponse?.BasicVesselInformation) {
    const basicInfo = IwtInitialSurveyResponse.BasicVesselInformation;
    setValue('vesselDetails.netTonnage', basicInfo.netTonnage || '');
    setValue('basicVesselInfo.draft', basicInfo.draft || '');
    setValue('basicVesselInfo.placeOfLastSurvey', basicInfo.placeOfLastSurvey || '');
    setValue('basicDetails.builderDetails.dateOfLastSurvey', basicInfo.dateOfLastSurvey || '');
    setValue('crewDetails.totalDeckCrew', basicInfo.totalNoOfDeckCrew || '');
    setValue('crewDetails.totalEngineCrew', basicInfo.totalNoOfEngineCrew || '');
    setValue('vesselDetails.lengthOfVessel', basicInfo.lengthOfVessel || '');
    setValue('vesselDetails.breadthOfVessel', basicInfo.breadthOfVessel || '');
    setValue('vesselDetails.depthOfVessel', basicInfo.depthOfVessel || '');
  }

  // Hull particulars
  if (IwtInitialSurveyResponse?.HullParticulars) {
    const hull = IwtInitialSurveyResponse.HullParticulars;
    setValue('hullParticulars.hullMaterial', hull.hullMaterial || '');
    setValue('hullParticulars.hullPlatingMaterial', hull.hullPlatingMaterial || '');
    setValue('hullParticulars.hullPlattingThickness', hull.hullPlatingThickness || '');
    setValue('hullParticulars.numberOfBulkheads', hull.noOfBulkheads || '');
    setValue('hullParticulars.bulkheadPlacement', hull.bulkheadPlacement || '');
    setValue('hullParticulars.bulkheadThickness', hull.bulkheadThickness || '');
    setValue('hullParticulars.keelLayingDate', hull.keelLayingDate || '');
    setValue('hullParticulars.frameMaterial', hull.frameMaterial || '');
    setValue('hullParticulars.frameThickness', hull.frameThickness || '');
    setValue('hullParticulars.floorMaterial', hull.floorMaterial || '');
    setValue('hullParticulars.floorThickness', hull.floorThickness || '');
  }

  // Navigation equipment
  if (IwtInitialSurveyResponse?.RadioandNavigationEquipment) {
    const nav = IwtInitialSurveyResponse.RadioandNavigationEquipment;
    setValue('navigationEquipment.magneticCompass', nav.magneticCompass || '');
    setValue('navigationEquipment.vhfRadio', nav.vhfRadio || '');
    setValue('navigationEquipment.classBAutoAIS', nav.aisIdentifiSystem || '');
    setValue('navigationEquipment.gpsNavigator', nav.gps || '');
    setValue('navigationEquipment.binocular', nav.binocular || '');
    setValue('navigationEquipment.aldisLamp', nav.aldisLamp || '');
    setValue('navigationEquipment.rudderAngleIndicator', nav.rudderAngleIndicator || '');
    setValue('navigationEquipment.othersNavigation', nav.others || '');
  }

  // Pollution control
  if (IwtInitialSurveyResponse?.PollutionControlDevices) {
    const pollution = IwtInitialSurveyResponse.PollutionControlDevices;
    setValue('polutionControl.bilgeWaterSeparator', pollution.bilgeWaterSeperator || '');
    setValue('polutionControl.bilgeCapacity', pollution.capacity || '');
    setValue('polutionControl.bilgeMakeModel', pollution.makeModel || '');
    setValue('polutionControl.sewageTreatmentPlant', pollution.stp || '');
    setValue('polutionControl.sewageCapacity', pollution.stpCapacity || '');
    setValue('polutionControl.sewageMakeModel', pollution.stpMakeModel || '');
    setValue('polutionControl.oilyWaterFilter', pollution.owf || '');
    setValue('polutionControl.oilyCapacity', pollution.owfCapacity || '');
    setValue('polutionControl.oilyMakeModel', pollution.owfMakeModel || '');
    setValue('polutionControl.exhaustGasCleaning', pollution.egasCleaningSystm || '');
    setValue('polutionControl.exhaustCapacity', pollution.egasCleaningSystmCapacity || '');
    setValue('polutionControl.exhaustMakeModel', pollution.egasCleaningSystmMakeModel || '');
    setValue('polutionControl.othersPollution', pollution.other || '');
    setValue('polutionControl.othersCapacity', pollution.otherCapacity || '');
    setValue('polutionControl.othersMakeModel', pollution.otherMakeModel || '');
  }

  // Crew details
  if (IwtInitialSurveyResponse?.CrewDetails?.length) {
    const crewData = IwtInitialSurveyResponse.CrewDetails.map(crew => ({
      crewType: crew.crewType || '',
      name: crew.name || '',
      rank: crew.rank || '',
      cocNo: crew.cocNo || '',
      validity: crew.validity || '',
      experience: crew.experience || '',
      placeOfIssue: crew.placeOfIssue || ''
    }));
    setValue('crewDetails.crewDetails', crewData);
  }

 
 
if (data.enclosers?.length) {
    console.log("Processing enclosers:", data.enclosers);
    
    const typeMap = {
      'REGISTRATION_CERTIFICATE': 'certificateOfRegistration',
      'NOC_FROM_ORIGINAL_REGISTRATION_AUTHORITY': 'NOCfromOriginalRegistrationAuthority',
      'SURVEY_COPY_OF_LAST_CERTIFICATE_OF_SURVEY': 'lastSurveyCertificate',
      'TONNAGE_BOOKLETS': 'tonnageBooklet',
      'STABILITY_BOOKLETS': 'stabilityBooklet',
      'INSURANCE_CERTIFICATE': 'insuranceCertificate',
      'PAYMENT_CHALLAN_OR_ACKNOWLEDGEMENT': 'paymentChallan'
    };
    
    data.enclosers.forEach(doc => {
      const fieldName = typeMap[doc.documentType];
      console.log(`Processing document: ${doc.documentType} -> ${fieldName}`, doc);
      
      if (fieldName && doc.fileStoreId) {
       
        const fileObject = { 
          name: doc.documentName,
          fileStoreId: doc.fileStoreId 
        };
        
        console.log(`Setting enclosure.${fieldName} with:`, fileObject);
        
        
        setValue(`enclosure.${fieldName}`, fileObject);
        
        setValue(`enclosure.${fieldName}FileStoreId`, doc.fileStoreId);
       
        setValue(`enclosure.${fieldName}OriginalName`, doc.documentName);
      }
    });
  }
if (data.enclosers?.length) {
  const multiFileTypes = ["MAIN_AND_OTHER_DRAWINGS", "RADIOGRAPHY_REPORT", "MATERIAL_TEST_REPORT", "OTHER_INSPECTION_REPORTS", "OTHER_TECHNICAL_DOCUMENT"];
  
  multiFileTypes.forEach(type => {
    const docs = data.enclosers.filter(doc => doc.documentType === type);
    
    if (docs.length > 0) {
    
      if (type === "MAIN_AND_OTHER_DRAWINGS") {
        setDrwaingFiles(docs.map((_, index) => ({ id: index + 1 })));
      } else if (type === "RADIOGRAPHY_REPORT") {
        setRadiographyFiles(docs.map((_, index) => ({ id: index + 1 })));
      } else if (type === "MATERIAL_TEST_REPORT") {
        setMaterialTestFiles(docs.map((_, index) => ({ id: index + 1 })));
      } else if (type === "OTHER_INSPECTION_REPORTS") {
        setOtherInspectionFiles(docs.map((_, index) => ({ id: index + 1 })));
      } else if (type === "OTHER_TECHNICAL_DOCUMENT") {
        setOtherTechnicalDocumentFiles(docs.map((_, index) => ({ id: index + 1 })));
      }
      
   
      docs.forEach((doc, index) => {
        setValue(`${type}_file_${index + 1}`, { 
          name: doc.documentName,
          fileStoreId: doc.fileStoreId 
        });
        setValue(`${type}_fileStoreId_${index + 1}`, doc.fileStoreId);
        setValue(`${type}_desc_${index + 1}`, doc.description || doc.documentName);
      });
    }
  });
}





  
  if (IwtInitialSurveyResponse?.SurveyEquipments) {
    const equipmentData = {};
    Object.keys(IwtInitialSurveyResponse.SurveyEquipments).forEach((equipmentKey) => {
      const equipmentArray = IwtInitialSurveyResponse.SurveyEquipments[equipmentKey];
      if (Array.isArray(equipmentArray)) {
        equipmentArray.forEach((item) => {
          const equipmentId = getEquipmentIdFromKey(equipmentKey);
          if (equipmentId) {
            if (!equipmentData[equipmentId]) {
              equipmentData[equipmentId] = {};
            }
            equipmentData[equipmentId][item.categoryCode] = {
              number: item.number?.toString() || '',
              type: item.type || '',
              location: item.location || '',
              capacity: item.capacity || '',
              condition: item.condition || '',
              remarks: item.remarks || ''
            };
          }
        });
      }
    });
    setValue('equipment', equipmentData);
  }

  
  if (IwtInitialSurveyResponse?.passengerDistributionMaxLoad && Array.isArray(IwtInitialSurveyResponse.passengerDistributionMaxLoad)) {
    setValue('deckSpaces', IwtInitialSurveyResponse.passengerDistributionMaxLoad.map((deck) => ({
      deckType: deck.deckName || deck.spaceType || '',
      size: deck.sizeSqm?.toString() || '',
      function: deck.function || '',
      maxPassengers: deck.maxPassengers?.toString() || '',
      remarks: deck.remarks || ''
    })));
  }

 
  if (IwtInitialSurveyResponse?.vesselFreeboardData) {
    setValue('freeboard', {
      minFreeboard: IwtInitialSurveyResponse.vesselFreeboardData.minimumFreeboard?.toString() || '',
      numPassengers: IwtInitialSurveyResponse.vesselFreeboardData.numberOfPassengers?.toString() || '',
      cargo: IwtInitialSurveyResponse.vesselFreeboardData.cargoTonnes?.toString() || ''
    });
  }



};

const fetchTransferOfRegistryData = async (applicationNumber) => {
  
  try {
     loaderRef.current?.show();
    const response = await postData(
      SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.TRANSFER_OF_REGISTRY.TRANSFER_OF_REGISTRY_SEARCH,
      {
        applicationType: "TRANSFER_OF_REGISTRY",
        applicationNumbers: [applicationNumber]
      }
    );
console.log("Transfer of Registry fetch response:", response?.data?.data?.[0]);
 if (response?.status === 200 && response?.data?.data?.[0]) {
  const responseData = response.data.data[0];
  setRegistrationData(responseData);
  setInitialRegistryData(responseData.IwtInitialSurveyResponse);
  setStep1ResponseData(responseData);
  
  // Set actions for officer
  if (isOfficerLogin && responseData.IwtInitialSurveyResponse?.processActionMapResponce) {
    const actionsItems = responseData.IwtInitialSurveyResponse.processActionMapResponce?.[0]?.processs?.[0]?.actions ?? [];
    if (actionsItems?.length > 0) {
      setActionsFromAPI(actionsItems);
      setShowOfficerActions(true);
    }
  }

  populateFormWithTransferData(responseData);
}
  } catch (error) {
    
    toast.error('Failed to fetch transfer data');
  } finally {
         loaderRef.current?.hide();                 
  }
};



useEffect(() => {
  if (id && (isViewMode || isEditMode)) {
    fetchTransferOfRegistryData(id);
  }
}, [id, isViewMode, isEditMode]);


console.log("Registration Data:encloser", registrationData);




  const getSurveyDetails = async (vesselId) => {
    try {
      loaderRef.current?.show();
      const apiUrl =
        SERVICE_BASE.IWT_SURVEY_SERVICE +
        URLS_ENDPOINT.SURVEY_SERVICE.SURVEY_SEARCH;

      const response = await postData(apiUrl, {
        iwtVesRegBasicDetailsTFk: [vesselId],
      });

      if (response?.status === 200 || response?.status === 201) {
        const surveyData = response?.data[0] || {};

        setInitialRegistryData(surveyData);
        setGeneratedCertificates({
          survey: surveyData?.BasicVesselInformation?.enableprovisonalsurveycert || false,
          registration: surveyData?.BasicVesselInformation?.enableprovisonalregistrationcert || false,
        });

        if (isOfficerLogin) {
          const hasActions =
            surveyData?.processActionMapResponce?.[0]?.processs?.[0]?.actions?.length > 0;
          setShowOfficerActions(hasActions);

          if (hasActions) {
            setActionsFromAPI(surveyData.processActionMapResponce[0].processs[0].actions);
          }
        }
        populateFormWithSurveyData(surveyData);
      } else {
        toast.error(
          response?.data?.responseStatus?.message || "Failed to fetch survey details."
        );
      }
    } catch (err) {
      handleErrorMessage(
        err?.response?.data || "Failed to fetch survey details. Check console for details."
      );
    } finally {
      loaderRef?.current?.hide();
    }
  };

   const getEquipmentIdFromKey = (equipmentKey) => {
    const equipmentKeyMap = {
      "Fire Fighting Items": "EquipmentFireFightingItems",
      Equipments: "Equipments",
      "Navigational Equipments": "EquipmentNavigationalEquipments",
      "Life-Saving Equipment": "EquipmentLifeSavingEquipment",
      "Machinery/Electrical": "EquipmentMachineryElectrical",
      "Accommodation/Safety": "EquipmentAccommodationSafety",
    };

    const equipmentName = Object.keys(equipmentKeyMap).find(
      (name) => equipmentKeyMap[name] === equipmentKey
    );

    if (equipmentName) {
      const equipment = masterData?.equipmentCategories?.find(
        (eq) => eq.equipmentName === equipmentName
      );
      return equipment?.id;
    }

    return null;
  };
  

  const populateFormWithSurveyData = (data) => {
    if (!data) return;

    const safe = (val, fallback = "") => val ?? fallback;

    const mappings = {
      basicVesselInfo: {
        typeOfSurvey: "BasicVesselInformation.typeOfSurveyId",
        placeYardNo: "BasicVesselInformation.placeYardNo",
        netTonnage: "BasicVesselInformation.netTonnage",
        agentName: "BasicVesselInformation.agentsName",
        agentAddress: "BasicVesselInformation.agentsAddress",
        agentTelephone: "BasicVesselInformation.agentsTelephone",
        placeOfLastSurvey: "BasicVesselInformation.placeOfLastSurvey",
        dateOfLastSurvey: "BasicVesselInformation.dateOfLastSurvey",
        dateOfProposedVisit: "BasicVesselInformation.dateOfProposedVisitSurveyor",
        lengthOfVessel: "BasicVesselInformation.lengthOfVessel",
        breadthOfVessel: "BasicVesselInformation.breadthOfVessel",
        depthOfVessel: "BasicVesselInformation.depthOfVessel",
        draft: "BasicVesselInformation.draft",
        yearOfBuild: "BasicVesselInformation.yearOfBuild",
        numberOfDecks: "BasicVesselInformation.numberOfDecks",
      },
      hullParticulars: {
        frameMaterial: "HullParticulars.frameMaterial",
        frameThickness: "HullParticulars.frameThickness",
        floorMaterial: "HullParticulars.floorMaterial",
        hullMaterial: "HullParticulars.hullMaterial",
        hullPlatingMaterial: "HullParticulars.hullPlatingMaterial",
        hullPlattingThickness: "HullParticulars.hullPlatingThickness",
        keelLayingDate: "HullParticulars.keelLayingDate",
        numberOfBulkheads: "HullParticulars.noOfBulkheads",
        bulkheadPlacement: "HullParticulars.bulkheadPlacement",
        bulkheadThickness: "HullParticulars.bulkheadThickness",
        floorThickness: "HullParticulars.floorThickness",
        stern: "HullParticulars.stern",

      },
      navigationEquipment: {
        magneticCompass: "RadioandNavigationEquipment.magneticCompass",
        vhfRadio: "RadioandNavigationEquipment.vhfRadio",
        classBAutoAIS: "RadioandNavigationEquipment.aisIdentifiSystem",
        gpsNavigator: "RadioandNavigationEquipment.gps",
        binocular: "RadioandNavigationEquipment.binocular",
        aldisLamp: "RadioandNavigationEquipment.aldisLamp",
        rudderAngleIndicator:
          "RadioandNavigationEquipment.rudderAngleIndicator",
        othersNavigation: "RadioandNavigationEquipment.others",
      },
      polutionControl: {
        bilgeWaterSeparator: "PollutionControlDevices.bilgeWaterSeperator",
        bilgeCapacity: "PollutionControlDevices.capacity",
        bilgeMakeModel: "PollutionControlDevices.makeModel",
        sewageTreatmentPlant: "PollutionControlDevices.stp",
        sewageCapacity: "PollutionControlDevices.stpCapacity",
        sewageMakeModel: "PollutionControlDevices.stpMakeModel",
        oilyWaterFilter: "PollutionControlDevices.owf",
        oilyCapacity: "PollutionControlDevices.owfCapacity",
        oilyMakeModel: "PollutionControlDevices.owfMakeModel",
        exhaustGasCleaning: "PollutionControlDevices.egasCleaningSystm",
        exhaustCapacity: "PollutionControlDevices.egasCleaningSystmCapacity",
        exhaustMakeModel: "PollutionControlDevices.egasCleaningSystmMakeModel",
        othersPollution: "PollutionControlDevices.other",
        othersCapacity: "PollutionControlDevices.otherCapacity",
        othersMakeModel: "PollutionControlDevices.otherMakeModel",
      },

      detailsOfPropulsion: {
        typeOfEngine: "DetailsofPropulsionofEngine.engineType",
        engineMake: "DetailsofPropulsionofEngine.engineMake",
        engineMakerAddress: "DetailsofPropulsionofEngine.makerAddress",
        horsepower: "DetailsofPropulsionofEngine.horsepower",
        speedRPM: "DetailsofPropulsionofEngine.speed",
        yearOfMake: "DetailsofPropulsionofEngine.yearOfMake",
        modelNo: "DetailsofPropulsionofEngine.modelNo",
        numberOfSetFitted: "DetailsofPropulsionofEngine.noOfSet",
        numberOfEngine: "DetailsofPropulsionofEngine.numberOfEngine",
        setSrNo: "DetailsofPropulsionofEngine.setSerialNo",
        propellerType: "DetailsofPropulsionofEngine.propellerType",
        gearType: "DetailsofPropulsionofEngine.gearType",
        noOfGear: "DetailsofPropulsionofEngine.noOfGear",
        vesselSpeed: "DetailsofPropulsionofEngine.vesselSpeed",
        revolutionMints: "DetailsofPropulsionofEngine.rpm",
        engineCylinderDiameter: "DetailsofPropulsionofEngine.engineCylinder",
        strokeEngine: "DetailsofPropulsionofEngine.stroke",
        cylindersRotary:
          "DetailsofPropulsionofEngine.noOfCylinderPerSetRotaryEngine",
        cylindersReciprocating:
          "DetailsofPropulsionofEngine.noOfCylinderPerSetReciprocatingEngine",
        numberOfShaft: "DetailsofPropulsionofEngine.noOfShaft",
        lengthEngineRoom: "DetailsofPropulsionofEngine.lengthOfEngineRoom",
      },
    };

    Object.entries(mappings).forEach(([formKey, map]) => {
      Object.entries(map)?.forEach(([field, path]) => {
        const value = path?.split(".")?.reduce((acc, k) => acc?.[k], data);
        setValue(`${formKey}.${field}`, safe(value));
      });
    });

    // --- Crew Details ---
    const crewDetails = Array.isArray(data?.CrewDetails)
      ? data.CrewDetails
      : [];
    setValue(
      "crewDetails.crewDetails",
      crewDetails.map((crew) => ({
        crewType: safe(crew?.crewType),
        name: safe(crew?.name),
        rank: safe(crew?.rank),
        cocNo: safe(crew?.cocNo),
        validity: safe(crew?.validity),
        experience: safe(crew?.experience),
        status: crew?.status || "ACTIVE",
      }))
    );

    if (data?.BasicVesselInformation) {
      setValue(
        "crewDetails.totalDeckCrew",
        data?.BasicVesselInformation?.totalNoOfDeckCrew || ""
      );
      setValue(
        "crewDetails.totalEngineCrew",
        data?.BasicVesselInformation?.totalNoOfEngineCrew || ""
      );
    }

    // --- Enclosures ---
    const enclosureMap = {};
    (Array.isArray(data?.Enclosure) ? data.Enclosure : []).forEach((doc) => {
      const typeMap = {
        SURVEY_AUTHORIZATION_OF_AUTHORISED_PERSON: "authorizationFile",
        SURVEY_PAYMENT_CHALLAN: "paymentChallan",
        SURVEY_BUILDER_CERTIFICATE: "builderCertificate",
        SURVEY_COPY_OF_LAST_CERTIFICATE_OF_SURVEY: "lastCertificateCopy",
        SURVEY_COPY_OF_CERTIFICATE_OF_REGISTRATION:
          "registrationCertificateCopy",
        SURVEY_TEST_CERTIFICATE: "testCertificate",
      };
      const key = typeMap[doc.documentType];
      if (key) {
        enclosureMap[key] = {
          name: doc.documentName,
          fileStoreId: doc.fileStoreId,
        };
      }
    });

    Object.entries(enclosureMap).forEach(([key, value]) => {
      setValue(`enclosure.${key}`, value);
      setValue(`enclosure.${key}FileStoreId`, value.fileStoreId);
      setValue(`enclosure.${key}OriginalName`, value.name);
    });

    // --- Equipment Inventory from SurveyEquipments ---
    if (data?.SurveyEquipments) {
      const equipmentData = {};

      Object.keys(data.SurveyEquipments).forEach((equipmentKey) => {
        const equipmentArray = data.SurveyEquipments[equipmentKey];
        if (Array.isArray(equipmentArray)) {
          equipmentArray.forEach((item) => {
            const equipmentId = getEquipmentIdFromKey(equipmentKey);
            if (equipmentId) {
              if (!equipmentData[equipmentId]) {
                equipmentData[equipmentId] = {};
              }
              equipmentData[equipmentId][item.categoryCode] = {
                number: item.number?.toString() || "",
                type: item.type || "",
                location: item.location || "",
                capacity: item.capacity || "",
                condition: item.condition || "",
                remarks: item.remarks || "",
              };
            }
          });
        }
      });

      setValue("equipment", equipmentData);
    }

    if (
      data?.passengerDistributionMaxLoad &&
      Array.isArray(data.passengerDistributionMaxLoad)
    ) {
      setValue(
        "deckSpaces",
        data.passengerDistributionMaxLoad.map((deck) => ({
          deckType: deck.deckName || deck.spaceType || "",
          size: deck.sizeSqm?.toString() || "",
          function: deck.function || "",
          maxPassengers: deck.maxPassengers?.toString() || "",
          remarks: deck.remarks || "",
        }))
      );
    }

    if (data?.vesselFreeboardData) {
      setValue("freeboard", {
        minFreeboard:
          data.vesselFreeboardData.minimumFreeboard?.toString() || "",
        numPassengers:
          data.vesselFreeboardData.numberOfPassengers?.toString() || "",
        cargo: data.vesselFreeboardData.cargoTonnes?.toString() || "",
      });
    }

    // --- Provisional Certificates ---

    if (data?.BasicVesselInformation) {
      setValue(
        "provisionalCertificates.surveyCertificate",
        data.BasicVesselInformation.enableprovisonalsurveycert || false
      );
      setValue(
        "provisionalCertificates.registrationCertificate",
        data.BasicVesselInformation.enableprovisonalregistrationcert || false
      );
    }
  };

  //  const getEquipmentIdFromKey = (equipmentKey) => {
  //   const equipmentKeyMap = {
  //     "Fire Fighting Items": "EquipmentFireFightingItems",
  //     Equipments: "Equipments",
  //     "Navigational Equipments": "EquipmentNavigationalEquipments",
  //     "Life-Saving Equipment": "EquipmentLifeSavingEquipment",
  //     "Machinery/Electrical": "EquipmentMachineryElectrical",
  //     "Accommodation/Safety": "EquipmentAccommodationSafety",
  //   };

  //   const equipmentName = Object.keys(equipmentKeyMap).find(
  //     (name) => equipmentKeyMap[name] === equipmentKey
  //   );

  //   if (equipmentName) {
  //     const equipment = masterData?.equipmentCategories?.find(
  //       (eq) => eq.equipmentName === equipmentName
  //     );
  //     return equipment?.id;
  //   }

  //   return null;
  // };
 

  // const validateSurveyForm = async () => {
