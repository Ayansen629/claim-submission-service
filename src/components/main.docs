import React, { useState, useCallback, useEffect } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import { uploadDocument } from "../../../services/documentUploadService";
import { Button } from 'react-bootstrap';
import { Download, CheckCircle } from "lucide-react";
import 'bootstrap/dist/css/bootstrap.min.css';

const StepThird = ({ provideSubmitHandler, formData }) => {
    const [isUploading, setIsUploading] = useState(false);
    const [uploadError, setUploadError] = useState(null);
    const [uploadSuccess, setUploadSuccess] = useState(false);
    const [uploadedFileUrl, setUploadedFileUrl] = useState(null);

    const methods = useForm();
    const { register, handleSubmit, formState: { errors }, trigger, setValue, control, getValues, watch } = methods;

    const handleFileUpload = async (file) => {
        try {
            setIsUploading(true);
            setUploadError(null);
            setUploadSuccess(false);

            const result = await uploadDocument(file, 'signatoryDocument');
            if (result.success) {
                setValue("signatoryDocument", {
                    fileId: result.fileId,
                    docName: result.docName,
                    docType: result.docType,
                    fileUrl: result.fileUrl
                }, { shouldValidate: true });
                setUploadedFileUrl(`${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${result.fileId}`);
                setUploadSuccess(true);
            }
            return result;
        } catch (error) {
            setUploadError(error.message);
            setValue("signatoryDocument", null, { shouldValidate: true });
            setUploadSuccess(false);
            throw error;
        } finally {
            setIsUploading(false);
        }
    };

    const financialCreditorDetailsSchema = [
        { 
            name: "signatoryName", 
            label: <>Name of Signatory (BLOCK LETTERS) <span className="required-asterisk">*</span></>, 
            type: "text", 
            rules: { 
                required: "Signatory name is required",
                pattern: {
                    value: /^[A-Z\s]+$/,
                    message: "Please enter in BLOCK LETTERS only"
                }
            },
            placeholder: "Enter signatory name in BLOCK LETTERS" 
        },
        { 
            name: "signatoryDocument", 
            label: <>Signatory Document <span className="required-asterisk">*</span></>, 
            type: "file", 
            rules: { 
                required: "Signatory document is required",
                validate: {
                    fileUploaded: (value) => value !== null || "Please upload the document"
                }
            },
            accept: "image/*,.pdf",
            onFileUpload: handleFileUpload,
            isUploading,
            uploadError,
            setIsUploading,
            setUploadError
        },
        { 
            name: "signatoryPosition", 
            label: <>Position of Signatory or Relation to Creditors<span className="required-asterisk">*</span></>, 
            type: "text", 
            rules: { required: "Signatory position is required" },
            placeholder: "Enter signatory position/relation" 
        },
        { 
            name: "signatoryAddress", 
            label: <>Address of Signatory <span className="required-asterisk">*</span></>, 
            type: "textarea",
            rules: { 
                required: "Signatory address is required",
                // minLength: {
                //     value: 10,
                //     message: "Address should be at least 10 characters long"
                // }
            },
            placeholder: "Enter complete signatory address" 
        },
    ];

    const onSubmit = useCallback(async () => {
        const isValid = await trigger();
        if (!isValid) {
            console.error("Validation failed");
            return false;
        }
        return getValues();
    }, [trigger, getValues]);

    useEffect(() => {
        if (formData) {
            Object.keys(formData).forEach((key) => {
                setValue(key, formData[key]);
            });
        }
    }, [formData, setValue]);

    useEffect(() => {
        if (provideSubmitHandler) {
            provideSubmitHandler(onSubmit);
        }
    }, [provideSubmitHandler, onSubmit]);

    return (
        <FormProvider {...methods}>
            <form className="form-stepper">
                <div className="mb-4 bg-light">
                    <Collapsible title="Financial Creditor Details" defaultOpen={true}>
                        <div className="flex-container">
                            {financialCreditorDetailsSchema.map((fieldConfig) => (
                                <DynamicField
                                    key={fieldConfig.name}
                                    fieldConfig={fieldConfig}
                                    control={control}
                                    register={register}
                                    errors={errors}
                                    setValue={setValue}
                                    trigger={trigger}
                                    getValues={getValues}
                                />
                            ))}
                            {uploadedFileUrl && (
                                <div className="file-upload-status mt-4 p-3 border rounded bg-light">
                                    <div className="d-flex align-items-center gap-3">
                                        {uploadSuccess && (
                                            <div className="text-success d-flex align-items-center gap-2">
                                                <CheckCircle size={20} />
                                                <span>Document uploaded successfully!</span>
                                            </div>
                                        )}
                                        <Button
                                            variant="outline-primary"
                                            as="a"
                                            href={uploadedFileUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            download
                                            className="d-flex align-items-center gap-2"
                                        >
                                            <Download size={18} />
                                            Download Document
                                        </Button>
                                    </div>
                                </div>
                            )}
                        </div>
                    </Collapsible>
                </div>
            </form>
        </FormProvider>
    );
};

export default StepThird;
