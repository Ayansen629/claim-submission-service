{/* Enclosure */}
<Collapsible
  title={
    <div className="d-flex align-items-center">
      <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
      <span style={{ color: "#2466BF" }}>{t("ENCLOSURE")}</span>
    </div>
  }
  defaultOpen={true}
>
  <Card className="form-section-card">
    <Card.Body>
      <Row className="g-3">
        <Col xs={12} lg={6}>
          {renderFileField(
            "authorizationFile",
            t("Authorization of Authorised Person")
          )}
        </Col>
        <Col xs={12} lg={6}>
          {renderFileField(
            "paymentChallan",
            t("Payment Challan/Acknowledgement")
          )}
        </Col>
        <Col xs={12} lg={6}>
          {renderFileField(
            "builderCertificate",
            t("Builder Certificate")
          )}
        </Col>
        <Col xs={12} lg={6}>
          {renderFileField(
            "lastCertificateCopy",
            t("Copy of last Certificate of Survey")
          )}
        </Col>
        <Col xs={12} lg={6}>
          {renderFileField(
            "registrationCertificateCopy",
            t("Copy of Certificate of Registration")
          )}
        </Col>
        <Col xs={12} lg={6}>
          {renderFileField("testCertificate", t("Test Certificate"))}
        </Col>
      </Row>
    </Card.Body>
  </Card>
</Collapsible>
