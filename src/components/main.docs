{/* Provisional Certificates */}
<Collapsible
  title={
    <div className="d-flex align-items-center">
      <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
      <span style={{ color: "#2466BF" }}>{t("Provisional Certificates")}</span>
    </div>
  }
  defaultOpen={true}
>
  <Card className="form-section-card">
    <Card.Body>
      <Row className="g-3">
        <Col xs={12} md={6}>
          <div className="form-check">
            <input
              className="form-check-input"
              type="checkbox"
              id="provisionalSurveyCertificate"
              {...register("provisionalCertificates.surveyCertificate")}
              disabled={viewMode}
            />
            <label className="form-check-label" htmlFor="provisionalSurveyCertificate">
              {t("Provisional Survey Certificate")}
            </label>
          </div>
        </Col>
        <Col xs={12} md={6}>
          <div className="form-check">
            <input
              className="form-check-input"
              type="checkbox"
              id="provisionalRegistrationCertificate"
              {...register("provisionalCertificates.registrationCertificate")}
              disabled={viewMode}
            />
            <label className="form-check-label" htmlFor="provisionalRegistrationCertificate">
              {t("Provisional Registration Certificate")}
            </label>
          </div>
        </Col>
      </Row>
    </Card.Body>
  </Card>
</Collapsible>
