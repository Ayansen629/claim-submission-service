export const INBOX_COLUMNS = [
  {
    colName: "Application No",
    fieldName: "appNo",
    clsName: "column-text-start",
  },
  {
    colName: "Application Type",
    fieldName: "appType",
    clsName: "column-text-start",
  },
  {
    colName: "Vessel No",
    fieldName: "vesselNo",
    clsName: "column-text-start",
  },
  {
    colName: "Date of Submission",
    fieldName: "date",
    clsName: "column-text-start",
  },
  {
    colName: "Status",
    fieldName: "status",
    clsName: "column-text-start",
    render: (value) => (
      <span className={`status-badge ${value.toLowerCase()}`}>{value}</span>
    ),
  },
  {
    colName: "Action",
    fieldName: "action",
    actions: ['view', 'approve', 'reject'],
    clsName: "column-text-start actions-column",
  },
];

