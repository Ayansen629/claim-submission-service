import React, { useState, useEffect } from "react";
import {
    Card,
    Button,
    Container,
    Row,
    Col,
    Spinner,
    Image,
} from "react-bootstrap";
import { useParams, useNavigate, useLocation, useSearchParams } from "react-router-dom";
import { IconButton, Typography, Tooltip } from "@mui/material";
import {
    ArrowBack,
    CheckCircleOutline,
    ErrorOutline,
    FileDownload,
    Close as CloseIcon,
} from "@mui/icons-material";

import logo from "../../assets/images/IWT_Icon.jpg";
import "./styles/PaymentPage.css";
import { postData } from "../../services/http.service.ts";
import { SERVICE_BASE, URLS_ENDPOINT } from "../../utils/urlsConstants.ts";
import { toast } from "react-toastify";
import { getFromLocalStorage } from "../../utils/localStorageUtils.js";

const PaymentPage = () => {
    const { invoiceId } = useParams();
    const navigate = useNavigate();
    const location = useLocation();
    const [status, setStatus] = useState(null);
    const [loading, setLoading] = useState(false);
    const [downloadLoading, setDownloadLoading] = useState(false);

    const paymentData = location.state?.paymentData;
    const fullPaymentData = location.state?.fullPaymentData?.data;

    const [searchParams] = useSearchParams();
    
    const urlApplicationNo = searchParams.get('applicationNo');
    const txnId = searchParams.get('txnId');
    const applicationNumber = urlApplicationNo || location.state?.applicationNumber || invoiceId;

    console.log(fullPaymentData, "PAYMENTData");
    console.log("Transaction ID from URL:", txnId);
 
    useEffect(() => {
        const urlStatus = searchParams.get('status');
        
        if (urlStatus === 'SUCCESS') {
            console.log('Payment was successful!');
            setStatus("success");
        } 
        else if (urlStatus === 'FAILED' || urlStatus === 'CANCELLED') {
            console.log('Payment failed or cancelled.');
            setStatus("error");
        }
    }, [searchParams]);

    const formatCurrency = (amount) => {
        return new Intl.NumberFormat('en-IN', {
            style: 'currency',
            currency: 'INR',
            minimumFractionDigits: 2
        }).format(amount);
    };

    const handlePayment = async () => {
        if (!fullPaymentData) {
            toast.error("Payment data not available");
            return;
        }

        setLoading(true);
        try {
            const payload = {
                calculation: fullPaymentData
                // calculation: {
                    // totalAmount: fullPaymentData.totalAmount,
                    // totalAmountAtergst: fullPaymentData.totalAmountAtergst,
                    // cgst: fullPaymentData.cgst,
                    // igst: fullPaymentData.igst,
                    // sgst: fullPaymentData.sgst,
                    // billtype: fullPaymentData.billtype,
                    // applicationNumber: fullPaymentData.applicationNumber,
                    // applicationUuid: fullPaymentData.applicationUuid,
                    // feesDetailsl: fullPaymentData.feesDetailsl
                // }
            };

            const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.VESSEL_SERVICE.PAYMENT_FEES;
            const response = await postData(apiUrl, payload);
            console.log(response, "PAYMENT RESPONSE");
            
            if (response?.data?.data?.paymentStatusUrl) {
                const paymentStatusUrl = response.data.data.paymentStatusUrl;
                
                if (paymentStatusUrl.includes('status=SUCCESS')) {
                    navigate(paymentStatusUrl);
                } else {
                    navigate(paymentStatusUrl);
                }
            } else {
                setStatus("error");
                toast.error("Payment failed. Please try again.");
            }
        } catch (error) {
            console.error("Payment error:", error);
            setStatus("error");
            toast.error("Payment failed. Please try again.");
        } finally {
            setLoading(false);
        }
    };

 

const handleDownloadReceipt = async () => {
    if (!txnId) {
        toast.error("Transaction ID not found");
        return;
    }

    setDownloadLoading(true);
    try {
        const payload = {
            formType: "INVOICE",
            transactionNo: txnId,
            isUploadReq: true
        };

        const accessToken = getFromLocalStorage("access_token");
        const tokenDetails = getFromLocalStorage("tokenDetails");
        const sessionState = tokenDetails
            ? JSON.parse(tokenDetails)?.session_state
            : "";

        const apiUrl = SERVICE_BASE.IWT_PDFSERVICE + URLS_ENDPOINT.VESSEL_SERVICE.INVOICE_DOWNLOAD;
        const response = await fetch(apiUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${accessToken}`,
                'X-Request-ID': sessionState,
            },
            body: JSON.stringify(payload)
        });

        if (response.ok) {
            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.href = url;
            link.download = `invoice_${applicationNumber}_${txnId}.pdf`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            window.URL.revokeObjectURL(url);
            toast.success("Receipt downloaded successfully!");
        } else {
            toast.error("Failed to generate receipt");
        }
    } catch (error) {
        console.error("Receipt download error:", error);
        toast.error("Failed to download receipt. Please try again.");
    } finally {
        setDownloadLoading(false);
    }
};



    const goHome = () => {
        navigate("/dashboard");
    };

    return (
        <Card
            fluid
            className="py-4 payment-card"
            style={{ background: "transparent", minHeight: "100vh" }}
        >
            <Row className="mb-3 px-3 align-items-center">
                <Col xs="auto">
                    <Tooltip title="Back to Dashboard">
                        <IconButton
                            onClick={goHome}
                            sx={{ backgroundColor: "#2466BF", color: "#fff" }}
                        >
                            <ArrowBack />
                        </IconButton>
                    </Tooltip>
                </Col>
                <Col className="d-flex align-items-center">
                    <h4 className="m-0 fw-bold">
                        Application{" "}
                        <strong style={{ color: "#2466BF", fontWeight: 700 }}>
                            #{applicationNumber}
                        </strong>
                    </h4>
                </Col>
            </Row>

            <Row className="justify-content-center">
                <Col xs={12} md={8} lg={6}>
                    <Card
                        className="rounded-4 border-0 p-4"
                        style={{
                            boxShadow: "0 12px 28px rgba(0, 0, 0, 0.1)",
                            background: "#ffffff",
                        }}
                    >
                        {/* Header Row: Logo Left + Centered Title */}
                        <div
                            className="position-relative mb-4 pb-3"
                            style={{
                                borderBottom: "1px solid #e0e0e0",
                            }}
                        >
                            <div className="d-flex align-items-center">
                                <Image
                                    src={logo}
                                    alt="IWT Logo"
                                    height={50}
                                    style={{ objectFit: "contain" }}
                                />
                            </div>
                            <Typography
                                variant="h6"
                                className="text-center position-absolute top-50 start-50 translate-middle"
                                sx={{
                                    color: "#2466BF",
                                    fontWeight: 700,
                                    fontSize: "1.3rem",
                                }}
                            >
                                Secure Payment Portal
                            </Typography>
                        </div>

                        <div className="text-center mb-3">
                            <Typography variant="body1" sx={{ color: "#2466BF", fontWeight: 600 }}>
                                Application Number: <strong>{applicationNumber}</strong>
                            </Typography>
                           
                        </div>

                        <div className="text-center">
                            {status !== "success" && (
                                <Typography variant="body2" color="text.secondary">
                                    Complete your payment for Drawing Approval{" "}
                                    <strong style={{ color: "#2466BF", fontWeight: 700 }}>
                                        #{applicationNumber}
                                    </strong>
                                </Typography>
                            )}
                        </div>

                        {status === "success" && (
                            <div className="text-center fade-in-up">
                                <CheckCircleOutline sx={{ fontSize: 70, color: "green" }} />
                                <Typography variant="h5" className="mt-3 fw-bold text-success">
                                    Payment Successful!
                                </Typography>
                                <Typography className="text-muted">
                                    Thank you! Your registration payment has been completed successfully.
                                </Typography>
                                <div className="d-flex mt-3 justify-content-center gap-3 flex-wrap">
                                    <Button 
                                        variant="success" 
                                        onClick={handleDownloadReceipt}
                                        disabled={downloadLoading || !txnId}
                                    >
                                        {downloadLoading ? (
                                            <Spinner animation="border" size="sm" className="me-2" />
                                        ) : (
                                            <FileDownload className="me-2" />
                                        )}
                                        {downloadLoading ? "Generating..." : "Download Receipt"}
                                    </Button>
                                    <Button variant="outline-danger" onClick={goHome}>
                                        <CloseIcon className="me-2" />
                                        Close
                                    </Button>
                                </div>
                            </div>
                        )}

                        {status === "error" && (
                            <div className="text-center py-4 fade-in-up">
                                <ErrorOutline sx={{ fontSize: 70, color: "red" }} />
                                <Typography variant="h5" className="mt-3 fw-bold text-danger">
                                    Payment Failed
                                </Typography>
                                <Typography className="text-muted mb-3">
                                    Oops! Something went wrong. Please try again.
                                </Typography>
                                <Button variant="danger" onClick={() => setStatus(null)}>
                                    Retry Payment
                                </Button>
                            </div>
                        )}

                        {!status && (
                            <>
                                <Typography
                                    variant="body1"
                                    align="center"
                                    className="text-muted mt-2 mb-4"
                                >
                                    Amount Due: <strong>
                                        {paymentData ? formatCurrency(paymentData.summary.totalPayable) : '₹2,500'}
                                    </strong>
                                </Typography>
                                <Button
                                    variant="primary"
                                    className="w-100 py-2"
                                    style={{ backgroundColor: "#2466BF", border: "none" }}
                                    onClick={handlePayment}
                                    disabled={loading}
                                >
                                    {loading ? (
                                        <>
                                            <Spinner animation="border" size="sm" className="me-2" />
                                            Processing Payment...
                                        </>
                                    ) : (
                                        "Pay Now"
                                    )}
                                </Button>
                            </>
                        )}
                    </Card>
                </Col>
            </Row>
        </Card>
    );
};

export default PaymentPage;
