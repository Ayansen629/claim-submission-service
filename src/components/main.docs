step3: [
  {
    name: "panCardUpload",
    label: t("vesselOwnerRegistration.PAN Card"),
    type: "file",
    colSize: 6,
  },
  {
    name: "gstCertificate",
    label: t("vesselOwnerRegistration.GST Certificate"),
    type: "file",
    colSize: 6,
  },
  {
    name: "addressProof",
    label: t("vesselOwnerRegistration.Address Proof"),
    type: "file",
    colSize: 6,
  },
  {
    name: "tradeLicenseUpload",
    label: t("vesselOwnerRegistration.Trade License"),
    type: "file",
    colSize: 6,
    showIf: () => {
      const showTradeCategories = ["FIRM", "INDIVIDUAL", "OTHERS", "PRIVATE_LTD"];
      return showTradeCategories.includes(formData.categoryOfOwner);
    },
  },
  {
    name: "companyRegistrationCertificate",
    label: t("vesselOwnerRegistration.Company Registration Certificate"),
    type: "file",
    colSize: 6,
    showIf: () => {
      const showCompanyCategories = ["FIRM", "PRIVATE_LTD", "STATE GOVERNMENT/ PANCHAYET"];
      return showCompanyCategories.includes(formData.categoryOfOwner);
    },
  },
  {
    name: "moaCertificate",
    label: t("vesselOwnerRegistration.MOA Certificate"),
    type: "file",
    colSize: 6,
    showIf: () => {
      const showMOACategories = ["FIRM", "PRIVATE_LTD", "STATE GOVERNMENT/ PANCHAYET"];
      return showMOACategories.includes(formData.categoryOfOwner);
    },
  },
  {
    name: "aoaCertificate",
    label: t("vesselOwnerRegistration.AOA Certificate"),
    type: "file",
    colSize: 6,
    showIf: () => {
      const showAOACategories = ["FIRM", "PRIVATE_LTD", "STATE GOVERNMENT/ PANCHAYET"];
      return showAOACategories.includes(formData.categoryOfOwner);
    },
  },
],
