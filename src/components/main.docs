<Collapsible
  title={
    <>
      <FaUsers className="me-2" style={{ color: "#2466BF" }} />
      <span>{t("Location of passengers on specific decks and spaces in maximum loaded condition")}</span>
    </>
  }
  openStat={true}
>
  <div style={{ padding: "1rem", overflowX: "auto" }}>
    <div style={{ minHeight: "200px" }}>
      <Table striped bordered hover responsive className="mb-0" style={{ tableLayout: "fixed" }}>
        <thead style={{ backgroundColor: "#f8f9fa" }}>
          <tr>
            <th style={{ fontWeight: "600", color: "#2466BF", width: "20%" }}>{t("Deck/Space Type")}</th>
            <th style={{ fontWeight: "600", color: "#2466BF", width: "15%" }}>{t("Size")}</th>
            <th style={{ fontWeight: "600", color: "#2466BF", width: "20%" }}>{t("Function")}</th>
            <th style={{ fontWeight: "600", color: "#2466BF", width: "20%" }}>{t("Max. No. of Passenger")}</th>
            <th style={{ fontWeight: "600", color: "#2466BF", width: "20%" }}>{t("Remarks")}</th>
            {deckFields?.length > 1 && !isFieldDisabled && (
              <th style={{ fontWeight: "600", color: "#2466BF", width: "5%" }}>{t("Actions")}</th>
            )}
          </tr>
        </thead>
        <tbody>
          {deckFields.map((deck, index) => (
            <tr key={`deck-row-${index}`} style={{ height: "70px" }}>
              <td style={{ padding: "10px", verticalAlign: "middle" }}>
                <InputText
                  name={`deckSpaces.${index}.deckType`}
                  placeholder={t("Enter Deck/Space Type")}
                  register={register(`deckSpaces.${index}.deckType`)}
                  errors={errors}
                  disabled={isFieldDisabled}
                />
              </td>
              <td style={{ padding: "10px", verticalAlign: "middle" }}>
                <InputText
                  name={`deckSpaces.${index}.size`}
                  placeholder={t("Enter Size")}
                  register={register(`deckSpaces.${index}.size`)}
                  errors={errors}
                  disabled={isFieldDisabled}
                />
              </td>
              <td style={{ padding: "10px", verticalAlign: "middle" }}>
                <InputText
                  name={`deckSpaces.${index}.function`}
                  placeholder={t("Enter Function")}
                  register={register(`deckSpaces.${index}.function`)}
                  errors={errors}
                  disabled={isFieldDisabled}
                />
              </td>
              <td style={{ padding: "10px", verticalAlign: "middle" }}>
                <InputText
                  name={`deckSpaces.${index}.maxPassengers`}
                  type="number"
                  placeholder={t("Enter Max. No. of Passenger")}
                  register={register(`deckSpaces.${index}.maxPassengers`)}
                  errors={errors}
                  disabled={isFieldDisabled}
                />
              </td>
              <td style={{ padding: "10px", verticalAlign: "middle" }}>
                <InputText
                  name={`deckSpaces.${index}.remarks`}
                  placeholder={t("Enter Remarks")}
                  register={register(`deckSpaces.${index}.remarks`)}
                  errors={errors}
                  disabled={isFieldDisabled}
                />
              </td>
              {deckFields?.length > 1 && !isFieldDisabled && (
                <td style={{ padding: "10px", verticalAlign: "middle", textAlign: "center" }}>
                  <Button
                    variant="outline-danger"
                    onClick={() => handleRemoveDeck(index)}
                    type="button"
                    size="sm"
                    style={{ minWidth: "80px" }}
                  >
                    <FaTrash />
                  </Button>
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </Table>
    </div>
    {!isFieldDisabled && (
      <div style={{ position: "sticky", bottom: "0", backgroundColor: "white", padding: "10px 0" }}>
        <Button
          variant="outline-primary"
          onClick={handleAddDeck}
          type="button"
          style={{ minWidth: "100px" }}
        >
          <FaPlus className="me-2" /> Add
        </Button>
      </div>
    )}
  </div>
</Collapsible>
