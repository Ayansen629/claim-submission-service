// Updated ClaimTypeFields component with improved styling
const ClaimTypeFields = ({ 
  claimType, 
  control, 
  register, 
  errors, 
  setValue, 
  getValues, 
  watch,
  trigger
}) => {
  // ... (keep existing state and effect hooks)

  const getEntityFieldLabels = () => {
    switch (claimType) {
      case "principalBorrower":
        return {
          nameLabel: "Guarantor",
          addressLabel: "Address of the Guarantor"
        };
      case "guarantor":
        return {
          nameLabel: "Principal Borrower",
          addressLabel: "Address of the Principal Borrower"
        };
      case "financialDebt":
        return {
          nameLabel: "Beneficiary",
          addressLabel: "Address of the Beneficiary"
        };
      default:
        return {
          nameLabel: "Name",
          addressLabel: "Address"
        };
    }
  };

  const { nameLabel, addressLabel } = getEntityFieldLabels();

  return (
    <div className="form-section">
      {/* ... (keep existing commonClaimFields and additionalFields rendering) */}

      {entityFields.map((entityNum, index) => (
        <div key={entityNum} className="entity-field-group">
          <div className="entity-field-row">
            <DynamicField
              fieldConfig={{
                name: `${claimType}Name${entityNum}`,
                label: `${nameLabel} ${entityNum}`,
                type: "text",
                rules: { required: "This field is required" },
                placeholder: `Enter ${nameLabel.toLowerCase()} ${entityNum}`,
                id: `${claimType}Name${entityNum}`
              }}
              control={control}
              register={register}
              errors={errors}
              setValue={setValue}
              getValues={getValues}
              watch={watch}
            />
            
            {index > 0 && (
              <button 
                type="button" 
                className="btn btn-danger btn-sm remove-entity-btn"
                onClick={() => removeEntityField(index)}
                aria-label={`Remove ${nameLabel} ${entityNum}`}
                title={`Remove ${nameLabel} ${entityNum}`}
              >
                <FaMinus />
              </button>
            )}
          </div>

          <DynamicField
            fieldConfig={{
              name: `${claimType}Address${entityNum}`,
              label: `${addressLabel} ${entityNum}`,
              type: "text",
              rules: { required: "This field is required" },
              placeholder: `Enter ${addressLabel.toLowerCase()} ${entityNum}`
            }}
            control={control}
            register={register}
            errors={errors}
            setValue={setValue}
            getValues={getValues}
            watch={watch}
          />
        </div>
      ))}

      <button 
        type="button" 
        className="btn btn-outline-primary btn-sm add-more-btn"
        onClick={addEntityField}
      >
        <FaPlus /> Add {claimType === "guarantor" ? "Principal Borrower" : 
                        claimType === "principalBorrower" ? "Guarantor" : "Beneficiary"}
      </button>
    </div>
  );
};
/* Add these styles to your existing CSS */

.entity-field-group {
  margin-bottom: 1.5rem;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  padding: 1rem;
  background-color: #f9f9f9;
  position: relative;
}

.entity-field-row {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
}

.entity-field-row .form-group {
  flex: 1;
}

.remove-entity-btn {
  margin-top: 1.75rem;
  padding: 0.5rem;
  border-radius: 6px;
  background-color: #fef5f5;
  border: 1px solid #fadbd8;
  color: #e74c3c;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 38px;
  width: 38px;
}

.remove-entity-btn:hover {
  background-color: #fadbd8;
  cursor: pointer;
}

.add-more-btn {
  margin-top: 0.5rem;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  font-weight: 500;
  font-size: 0.9rem;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background-color: #f8fafc;
  border: 1px solid #d5dbdf;
  color: #3498db;
  transition: all 0.2s ease;
}

.add-more-btn:hover {
  background-color: #e3f2fd;
  border-color: #3498db;
  cursor: pointer;
}

/* Ensure all fields have equal width */
.entity-field-group .form-control {
  width: 100%;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .entity-field-row {
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .remove-entity-btn {
    margin-top: 0;
    align-self: flex-end;
    margin-bottom: 0.5rem;
  }
}
