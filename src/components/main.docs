.tabs-wrapper {
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  border: 1px solid #e9ecef;
  overflow: hidden;
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
}

.tabs-header {
  position: relative;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-bottom: 1px solid #e9ecef;
  padding: 8px 0;
}

.tabs-header.with-arrows {
  padding: 8px 60px;
}

.scroll-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, #2E57A7, #1f4ea0);
  border: none;
  border-radius: 50%;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  box-shadow: 0 6px 20px rgba(46, 87, 167, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-size: 14px;
}

.scroll-btn:hover {
  transform: translateY(-50%) scale(1.1);
  box-shadow: 0 8px 25px rgba(46, 87, 167, 0.4);
}

.scroll-btn.left {
  left: 12px;
}

.scroll-btn.right {
  right: 12px;
}

.tabs-scroll {
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.tabs-scroll::-webkit-scrollbar {
  display: none;
}

.tab-list {
  display: flex;
  list-style: none;
  margin: 0;
  padding: 0 20px;
  gap: 8px;
  min-height: 64px;
  align-items: center;
}

.tab-item {
  flex-shrink: 0;
}

.tab-btn {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 24px;
  background: transparent;
  border: 2px solid transparent;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  color: #6c757d;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  white-space: nowrap;
  border-radius: 12px;
  min-height: 48px;
  overflow: hidden;
}

.tab-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(46, 87, 167, 0.05), rgba(31, 78, 160, 0.05));
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: 10px;
}

.tab-btn:hover::before {
  opacity: 1;
}

.tab-btn:hover {
  color: #2E57A7;
  border-color: rgba(46, 87, 167, 0.2);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(46, 87, 167, 0.15);
}

.tab-btn.active {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #2E57A7, #1f4ea0);
  border-color: #1f4ea0;
  box-shadow: 0 6px 20px rgba(46, 87, 167, 0.3);
  transform: translateY(-2px);
}

.tab-btn.active::before {
  opacity: 0;
}

.tab-icon {
  font-size: 16px;
  display: flex;
  align-items: center;
  transition: transform 0.3s ease;
}

.tab-btn:hover .tab-icon,
.tab-btn.active .tab-icon {
  transform: scale(1.1);
}

.tab-title {
  font-size: 14px;
  line-height: 1.4;
  font-weight: inherit;
}

.tab-badge {
  background: linear-gradient(135deg, #dc3545, #c82333);
  color: white;
  border-radius: 12px;
  padding: 3px 8px;
  font-size: 11px;
  font-weight: 600;
  min-width: 20px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(220, 53, 69, 0.3);
}

.tabs-content {
  padding: 0;
  background: #ffffff;
  min-height: 400px;
}

/* Responsive Design */
@media (max-width: 768px) {
  .tab-btn {
    padding: 12px 18px;
    font-size: 13px;
    min-height: 44px;
    gap: 8px;
  }
  
  .tab-list {
    padding: 0 16px;
    gap: 6px;
  }
  
  .scroll-btn {
    width: 40px;
    height: 40px;
    font-size: 12px;
  }
  
  .tabs-header
