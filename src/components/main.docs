// File formatting utility
const formatFileInfo = (fileData) => {
  if (!fileData) return "";
  if (typeof fileData === "string") return fileData;
  return fileData.fileName || fileData.docName || fileData.name || "";
};

// Data transformation function
const formatRawData = (rawData) => {
  if (!rawData) return null;

  return {
    step1: {
      debtorName: "",
      creditorName: rawData.step1?.financialCreditorName || "",
      totalClaimAmount: rawData.step2?.claimAmount || "",
      debtDetails: rawData.step2?.debtDetails || "",
      mutualCreditDetails: rawData.step2?.mutualDetails || "",
      identificationType: rawData.step1?.identificationType || "",
      identificationNumber: rawData.step1?.identificationtype_details?.[0]?.details || "",
      identificationDocument: formatFileInfo(rawData.step1?.identificationtype_details?.[0]?.proof) || "",
    },
    step2: {
      securityInterestAmount: rawData.step2?.securityValue || "",
      guaranteeAmount: rawData.step2?.guaranteeValue || "",
      guarantorName: "",
      guarantorAddress: "",
      creditorAddress: `${rawData.step1?.addressLine1} ${rawData.step1?.addressLine2}, ${rawData.step1?.city}, ${rawData.step1?.state} - ${rawData.step1?.pincode}` || "",
      creditorEmail: rawData.step1?.financialCreditorEmail || "",
      beneficiaryClaimAmount: "",
      beneficiaryName: "",
      beneficiaryAddress: "",
      corporateDebtorClaimAmount: rawData.step2?.claimAmount || "",
      corporateDebtorSecurityAmount: rawData.step2?.securityValue || "",
      corporateDebtorGuaranteeAmount: rawData.step2?.guaranteeValue || "",
      principalBorrowerName: rawData.step2?.principalBorrowerName1 || "",
      principalBorrowerAddress: rawData.step2?.principalBorrowerAddress1 || "",
      accountNumber: rawData.step2?.accountNumber || "",
      ifscCode: rawData.step2?.ifscCode || "",
      branchName: rawData.step2?.branchName || "",
      addressProofNumber: "",
      addressProofType: rawData.step4?.addressProofType || "",
      addressProofDocument: formatFileInfo(rawData.step4?.addressProofFile) || "",
    },
    step3: {
      name: rawData.step3?.creditorName || "",
      position: rawData.step3?.creditorPosition || "",
      address: rawData.step3?.creditorAddress || "",
      document: {
        docName: formatFileInfo(rawData.step3?.signatureFile) || ""
      }
    }
  };
};

// Context Setup
const RegistrationContext = createContext();

export const useRegistration = () => {
  return useContext(RegistrationContext);
};

export const ApplicationContextProvider = ({ children }) => {
  const [registrationData, setRegistrationData] = useState({});
  const [applicationDetails, setApplicationDetails] = useState({});

  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);

  // Simulate view application form with static data
  const handleApplicatioNFormView = async (row) => {
    try {
      setLoading(true);
      
      // Simulate delay
      await new Promise(resolve => setTimeout(resolve, 500));
      
      // Use static data instead of API
      const rawData = STATIC_APPLICATION_DATA;
      
      if (rawData) {
        setApplicationDetails(rawData);
        
        const formattedData = formatRawData(rawData);
        setRegistrationData(formattedData);
        
        // Store in localStorage for consistency
        localStorage.setItem("applicationdatawithId", JSON.stringify(rawData.applicationNumber));
        localStorage.setItem("applicationdatastatus", JSON.stringify(rawData.status));
      } else {
        toast.error(APP_MESSAGES.NO_DATA_FOUND, { position: "top-right" });
        setRegistrationData({});
      }
    } catch (err) {
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setError(err.message || "Error processing data");
      setRegistrationData({});
    } finally {
      setLoading(false);
    }
  };

  const updateRegistrationData = (updatedData) => {
    setRegistrationData((prev) => ({
      ...prev,
      ...updatedData,
    }));
  };

  return (
    <RegistrationContext.Provider
      value={{
        registrationData,
        loading,
        error,
        handleApplicatioNFormView,
        updateRegistrationData,
        setRegistrationData,
        applicationDetails,
        setApplicationDetails,
      }}
    >
      {children}
    </RegistrationContext.Provider>
  );
};
const formatRawData = (rawData) => {
  if (!rawData) return null;

  return {
    // From Step 1 - Basic Info
    creditorBasicDetails: {
      debtorName: "", // Not present in raw data
      creditorName: rawData.step1?.financialCreditorName || "",
      totalClaimAmount: rawData.step2?.claimAmount || "",
      debtDetails: rawData.step2?.debtDetails || "",
      mutualCreditDetails: rawData.step2?.mutualDetails || "",
      identificationType: rawData.step1?.identificationType || "",
      identificationNumber: rawData.step1?.identificationtype_details?.[0]?.details || "",
      document: {
        docType: rawData.step1?.identificationType || "",
        docName: formatFileInfo(rawData.step1?.identificationtype_details?.[0]?.proof) || "",
      }
    },

    // From Step 2 - Claim Info
    claimDetails: {
      securityInterestAmount: rawData.step2?.securityValue || "",
      guaranteeAmount: rawData.step2?.guaranteeValue || "",
      guarantorName: "", // Not directly available
      guarantorAddress: "", // Not directly available
      creditorAddress: `${rawData.step1?.addressLine1} ${rawData.step1?.addressLine2}, ${rawData.step1?.city}, ${rawData.step1?.state} - ${rawData.step1?.pincode}` || "",
      creditorEmail: rawData.step1?.financialCreditorEmail || "",
      beneficiaryClaimAmount: "", // Not directly available
      beneficiaryName: "", // Not directly available
      beneficiaryAddress: "", // Not directly available
      corporateDebtorClaimAmount: rawData.step2?.claimAmount || "",
      corporateDebtorSecurityAmount: rawData.step2?.securityValue || "",
      corporateDebtorGuaranteeAmount: rawData.step2?.guaranteeValue || "",
      principalBorrowerName: rawData.step2?.principalBorrowerName1 || "",
      principalBorrowerAddress: rawData.step2?.principalBorrowerAddress1 || "",
      bankAccountNumber: rawData.step2?.accountNumber || "",
      bankIfscCode: rawData.step2?.ifscCode || "",
      bankBranchName: rawData.step2?.branchName || "",
      addressProofType: rawData.step4?.addressProofType || "",
      document: {
        docName: formatFileInfo(rawData.step4?.addressProofFile) || ""
      }
    },

    // From Step 3 - Signatory Info
    signatoryDetails: {
      name: rawData.step3?.creditorName || "",
      position: rawData.step3?.creditorPosition || "",
      address: rawData.step3?.creditorAddress || "",
      document: {
        docName: formatFileInfo(rawData.step3?.signatureFile) || ""
      }
    }
  };
};
