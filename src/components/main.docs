import React, { useState, useEffect } from "react";
import { useNavigate } from "react-router-dom";
import { Table, Button, Modal, Alert } from "react-bootstrap";
import { toast } from "react-toastify";
import "./Drafts.css";

const DraftsPage = () => {
  const [drafts, setDrafts] = useState([]);
  const [showDeleteModal, setShowDeleteModal] = useState(false);
  const [draftToDelete, setDraftToDelete] = useState(null);
  const [loading, setLoading] = useState(false);
  const navigate = useNavigate();

  // Load drafts from localStorage
  useEffect(() => {
    const loadDrafts = () => {
      try {
        const savedDrafts = JSON.parse(localStorage.getItem('formDrafts')) || [];
        setDrafts(savedDrafts);
      } catch (error) {
        console.error("Error loading drafts:", error);
        toast.error("Failed to load drafts");
      }
    };
    
    loadDrafts();
  }, []);

  const handleEditDraft = (draftId) => {
    navigate(`/apply-claim/${draftId}`); 
  };

  const handleDeleteDraft = (draft) => {
    if(draft.some(d=> d.id===draft.id)){
      setDraftToDelete(draft);
      setShowDeleteModal(true);

    }
    else{
      toast.warning("This draft no longer exists.");
    }
   
  };

  const confirmDelete = () => {
    setLoading(true);
    try {
      const updatedDrafts = drafts.filter(draft => draft.id !== draftToDelete.id ?false :true);
      localStorage.setItem('formDrafts', JSON.stringify(updatedDrafts));
      setDrafts(updatedDrafts);
      toast.success("Draft deleted successfully");
    } catch (error) {
      console.error("Error deleting draft:", error);
      toast.error("Failed to delete draft");
    } finally {
      setLoading(false);
      setShowDeleteModal(false);
      setDraftToDelete(null);
    }
  };

  const formatDate = (dateString) => {
    return new Date(dateString).toLocaleString();
  };

  const getFormTitle = (draft) => {
    return draft.formType || `Draft ${drafts.indexOf(draft) + 1}`;
  };

  useEffect(() => {
   return () => {
    setDraftToDelete(null);


   };
  }, []);
  return (
    <div className="drafts-container">
      <div className="drafts-header">
        <h2>Saved Drafts</h2>
        {drafts.length === 0 && (
          <Alert variant="info">
            You don't have any saved drafts yet.
          </Alert>
        )}
      </div>

      {drafts.length > 0 && (
        <Table striped bordered hover responsive className="drafts-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Form Type</th>
              <th>Last Saved</th>
              <th>Progress</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {drafts.map((draft, index) => (
              <tr key={draft.id}>
                <td>{index + 1}</td>
                <td>{getFormTitle(draft)}</td>
                <td>{formatDate(draft.lastSaved)}</td>
                <td>
                  Step {draft.currentStep || 1} of{" "}
                  {draft.formType === "Form CA" ? 3 : 4} {/* Adjust based on your form steps */}
                </td>
                <td>
                  <Button
                    variant="primary"
                    size="sm"
                    onClick={() => handleEditDraft(draft.id)}
                    className="me-2"
                  >
                    Continue
                  </Button>
                  <Button
                    variant="danger"
                    size="sm"
                    onClick={() => handleDeleteDraft(draft)}
                  >
                    Delete
                  </Button>
                </td>
              </tr>
            ))}
          </tbody>
        </Table>
      )}

      {/* Delete Confirmation Modal */}
      <Modal show={showDeleteModal} onHide={() => setShowDeleteModal(false)} centered>
        <Modal.Header closeButton>
          <Modal.Title>Confirm Delete</Modal.Title>
        </Modal.Header>
        <Modal.Body>
          Are you sure you want to delete this draft? This action cannot be undone.
        </Modal.Body>
        <Modal.Footer>
          <Button variant="secondary" onClick={() => setShowDeleteModal(false)}>
            Cancel
          </Button>
          <Button
            variant="danger"
            onClick={confirmDelete}
            disabled={loading}
          >
            {loading ? "Deleting..." : "Delete"}
          </Button>
        </Modal.Footer>
      </Modal>
    </div>
  );
};

export default DraftsPage;
