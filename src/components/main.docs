const deepEqual = (obj1, obj2) => {
  return JSON.stringify(obj1) === JSON.stringify(obj2);
};

const generateFileId = (file) => {
  return `file-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`;
};
// const  idetificationType= localStorage.getItem("selectedIdentificationType");
// const addressproofType = localStorage.getItem("selectedAddressProofType");
const extractFileDetails = (file, source,documentType) => {
  console.log("extractFileDetails", file, source);
  if (!file) return null;

  return {
    docId: file.fileId ,
    docName: file.docName,
    docType: documentType, 
    docSource: source,
  };
};

const createFormPayload = (formData, isFinalSubmit, userFormData, applicationNumber = "", isActive, applicationUuid = "") => {
  console.log("createFormPayload", formData);
  
  // Extract UUIDs from existing data or generate new ones
  const creditorBasicDetailsUuid = formData.creditorBasicDetailsUuid || uuidv4();
  const claimDetailsUuid = formData.claimDetailsUuid || uuidv4();
  const signatoryDetailsUuid = formData.signatoryDetailsUuid || uuidv4();

  return {
    userInfo: userFormData?.fullloginDetails || {},
    uuid: applicationUuid || uuidv4(),
    applicationNumber: applicationNumber || "",
    creditorBasicDetails: {
      uuid: creditorBasicDetailsUuid,
      financialCreditorName: formData.step1?.financialCreditorName || "",
      financialCreditorEmail: formData.step1?.financialCreditorEmail || "",
      identificationType: formData.step1?.identificationType || "",
      identificationNumber: formData.step1?.incorporatedIdentificationNumber || "",
    
      document: extractFileDetails(formData.step1?.incorporatedProofDocument, "web_upload", "identification"),
      // status: "",
      // isActive: isActive,
      // isFinalSubmit: isFinalSubmit
    },
    addressDetails:{
      addressLine1: formData.step1?.addressLine1 || "",
      addressLine2: formData.step1?.addressLine2 || "",
      city: formData.step1?.city || "",
      state: formData.step1?.state || "",
      pincode: formData.step1?.pincode || "",

    },
    claimDetails: {
      uuid: claimDetailsUuid,
      claimType: formData.step2?.claimType || "",
      hasSecurityInterest: formData.step2?.hasSecurityInterest || "",
      hasGuarantee: formData.step2?.hasGuarantee || "",
      claimAmount: parseFloat(formData.step2?.claimAmount) || 0,
      principalBorrowerName: formData.step2?.principalBorrowerName1 || "",
      principalBorrowerAddress: formData.step2?.principalBorrowerAddress1 || "",
      debtDetails: formData.step2?.debtDetails || "",
      debtDate: formData.step2?.debtDate || "",
      mutualDetails: formData.step2?.mutualDetails || "",
      
      securityValue: parseFloat(formData.step2?.securityValue) || 0,
      securityDate: formData.step2?.securityDate || "",
      guaranteeValue: parseFloat(formData.step2?.guaranteeValue) || 0,
      guaranteeDate: formData.step2?.guaranteeDate || "",
      // status: "",
      // isActive: isActive,
      // isFinalSubmit: isFinalSubmit
    },
    bankAccountDetails: {
      bankAccountNumber: formData.step2?.accountNumber || "",
      bankIfscCode: formData.step2?.ifscCode || "",
      bankName: formData.step2?.bankName || "",
      bankBranchName: formData.step2?.branchName || "",
      branchAddress: formData.step2?.branchAddress || "",
      city: formData.step2?.city || "",
      state: formData.step2?.state || "",
      district: formData.step2?.district || "",
    },
    signatoryDetails: {
      uuid: signatoryDetailsUuid,
      creditorName: formData.step3?.creditorName || "",
      creditorPosition: formData.step3?.creditorPosition || "",
      creditorSignature: formData.step3?.creditorSignatureText || "",
      hasSignature: formData.step3?.hasSignature || "",
      creditorAddress: formData.step3?.creditorAddress || "",
      document: extractFileDetails(formData.step3?.signatureFile, "web_upload", "signature"),
      // status: "",
      // isActive: isActive,
      // isFinalSubmit: isFinalSubmit
    },
    uploadDocumentDetails: {
      identityProofType: formData.step4?.identityProofType || "",
      addressProofType: formData.step4?.addressProofType || "",
      identityProofFile: extractFileDetails(formData.step4?.identityProofFile, "web_upload", "identity_proof"),
      addressProofFile: extractFileDetails(formData.step4?.addressProofFile, "web_upload", "address_proof"),
      // status: "",
      // isActive: isActive,
      // isFinalSubmit: isFinalSubmit
    },
    status: "",
    isActive: isActive,
    isFinalSubmit: isFinalSubmit
  };
};

const getFileFieldsForStep = (stepNumber) => {
  switch (stepNumber) {
    case 1:
      return ["identificationDocument"];
    case 2:
      return ["addressProof"];
    case 3:
      return ["signatoryDocument"];
    default:
      return [];
  }
};

const processFileUploads = async (stepData, stepNumber) => {
  const fileFields = getFileFieldsForStep(stepNumber);
  const processedData = { ...stepData };

  for (const field of fileFields) {
    if (stepData[field] && stepData[field] instanceof File) {
      // In a real application, you would upload the file here
      // and get a server-side ID or URL.
      processedData[field] = {
        id: generateFileId(stepData[field]),
        name: stepData[field].name,
        size: stepData[field].size,
        type: stepData[field].type,
        uploadedAt: new Date().toISOString(),
      };
    } else if (stepData[field] && typeof stepData[field] === 'object' && stepData[field].name) {
      // Keep existing file details if not a new file
      processedData[field] = { ...stepData[field] };
    }
  }

  return processedData;
};

