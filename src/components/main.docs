// InputFile.tsx
import React, { useState } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaFileAlt } from "react-icons/fa";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  register?: any;
  errors?: Record<string, { message?: string }>;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  className?: string;
  accept?: string;
  disabled?: boolean;
  style?: React.CSSProperties;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  register,
  errors,
  onChange,
  className = "",
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  style = {}
}) => {
  const [fileName, setFileName] = useState("");
  const [isFocused, setIsFocused] = useState(false);
  
  const hasError = errors?.[name];
  
  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) {
      setFileName(file.name);
      if (onChange) onChange(e);
    }
  };
  
  const getFileIcon = () => {
    if (!fileName) return <FaFile />;
    
    if (fileName.endsWith('.pdf')) return <FaFilePdf color="#dc3545" />;
    if (fileName.match(/\.(jpg|jpeg|png|gif)$/i)) return <FaFileImage color="#0077b6" />;
    return <FaFileAlt color="#6c757d" />;
  };
  
  const containerStyle = {
    borderRadius: '8px',
    border: `1px solid ${hasError ? '#dc3545' : isFocused ? '#0077b6' : '#dee2e6'}`,
    backgroundColor: hasError ? '#fff8f8' : 'white',
    padding: '15px',
    transition: 'all 0.2s',
    ...style
  };

  return (
    <Form.Group controlId={`file-${name}`} className={`mb-3 ${className}`}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      <div 
        className="file-upload-container" 
        style={containerStyle}
        onFocus={() => setIsFocused(true)}
        onBlur={() => setIsFocused(false)}
      >
        <input
          type="file"
          id={`file-${name}`}
          className="d-none"
          {...register}
          onChange={handleChange}
          accept={accept}
          disabled={disabled}
        />
        
        <div className="d-flex align-items-center flex-wrap">
          <label 
            htmlFor={`file-${name}`} 
            className="btn btn-outline-primary mb-0 d-inline-flex align-items-center"
            style={{ borderRadius: '6px', cursor: 'pointer' }}
          >
            <FaUpload className="me-2" />
            <span>Choose File</span>
          </label>
          
          <div className="ms-3 d-flex align-items-center text-muted">
            {fileName ? (
              <>
                {getFileIcon()}
                <span className="ms-2 text-truncate" style={{ maxWidth: '200px' }}>
                  {fileName}
                </span>
              </>
            ) : (
              <span>No file chosen</span>
            )}
          </div>
        </div>
      </div>
      
      <div className="text-muted small mt-1">
        Upload PDF, JPG or PNG file (Max size: 2MB)
      </div>
      
      {hasError && (
        <Form.Text className="text-danger d-block mt-1">
          {errors[name]?.message || "Please select a valid file"}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
/////////////////////
// InputSelect.tsx
import React, { useState } from "react";
import { Form } from "react-bootstrap";

interface Option {
  value: string;
  label: string;
}

interface InputSelectProps {
  label: string;
  required?: boolean;
  name: string;
  options: Option[];
  register?: any;
  errors?: Record<string, { message?: string }>;
  onChange?: (e: React.ChangeEvent<HTMLSelectElement>) => void;
  className?: string;
  disabled?: boolean;
  icon?: React.ElementType;
  style?: React.CSSProperties;
}

const InputSelect: React.FC<InputSelectProps> = ({
  label,
  required,
  name,
  options,
  register,
  errors,
  onChange,
  className = "",
  disabled,
  icon: IconComponent,
  style = {}
}) => {
  const [isFocused, setIsFocused] = useState(false);
  
  const hasError = errors?.[name];
  
  const handleChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    if (onChange) onChange(e);
    if (e.target.value && hasError) {
      // This would be handled by the parent component's clearErrors
    }
  };
  
  const selectStyle = {
    height: '50px',
    borderRadius: '8px',
    paddingLeft: IconComponent ? '40px' : '12px',
    transition: 'all 0.2s',
    ...style,
    borderColor: hasError ? '#dc3545' : isFocused ? '#0077b6' : '#ced4da',
    backgroundColor: hasError ? '#fff8f8' : 'white'
  };
  
  const iconContainerStyle = {
    position: 'absolute',
    left: '15px',
    top: '50%',
    transform: 'translateY(-50%)',
    zIndex: 4,
    pointerEvents: 'none'
  };

  return (
    <Form.Group className={`mb-3 position-relative ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      {IconComponent && (
        <div style={iconContainerStyle}>
          <IconComponent size={18} color={hasError ? "#dc3545" : "#387AD4"} />
        </div>
      )}
      
      <Form.Select
        {...register}
        className={hasError ? 'is-invalid' : ''}
        disabled={disabled}
        style={selectStyle}
        onChange={handleChange}
        onFocus={() => setIsFocused(true)}
        onBlur={() => setIsFocused(false)}
      >
        {options.map((option, idx) => (
          <option key={idx} value={option.value}>
            {option.label}
          </option>
        ))}
      </Form.Select>
      
      {hasError && (
        <Form.Text className="text-danger d-block mt-1">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;
//////////////////
// DynamicField component
const DynamicField = ({ field }) => {
  if (field.showIf && !field.showIf()) return null;

  // Common handler for all field types
  const handleFieldChange = (e) => {
    if (field.onChange) field.onChange(e);
    
    // Clear error when field is valid
    if (field.type === 'email') {
      // For email validation
      const emailPattern = /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i;
      if (emailPattern.test(e.target.value)) {
        clearErrors(field.name);
      }
    } else if (field.type === 'text' && field.validation?.pattern) {
      // For pattern validation (like phone numbers, PAN, etc.)
      if (field.validation.pattern.value.test(e.target.value)) {
        clearErrors(field.name);
      }
    } else if (e.target.value) {
      // For required fields
      clearErrors(field.name);
    }
    
    // Clear validation message if no errors
    if (Object.keys(errors).length === 0) {
      setValidationMessage("");
    }
  };

  // File change handler
  const handleFileChange = (e) => {
    const file = e.target.files?.[0];
    if (file) {
      setValue(field.name, file.name);
      clearErrors(field.name);
      
      // Clear validation message if no errors
      if (Object.keys(errors).length === 0) {
        setValidationMessage("");
      }
    }
  };

  switch(field.type) {
    case 'select':
      return (
        <InputSelect
          label={field.label}
          required={field.required}
          name={field.name}
          options={field.options}
          register={register(field.name, {
            ...field.validation,
            onChange: handleFieldChange
          })}
          errors={errors}
          disabled={field.readOnly}
          icon={field.icon}
          className="mb-4"
        />
      );
    
    case 'file':
      return (
        <InputFile
          label={field.label}
          required={field.required}
          name={field.name}
          register={register(field.name, field.validation)}
          errors={errors}
          onChange={handleFileChange}
          className="mb-4"
        />
      );
    
    default: // text, email, etc.
      return (
        <InputText
          label={field.label}
          required={field.required}
          name={field.name}
          type={field.type}
          placeholder={field.placeholder}
          register={register(field.name, {
            ...field.validation,
            onChange: handleFieldChange
          })}
          errors={errors}
          readOnly={field.readOnly}
          icon={field.icon}
          className="mb-4"
        />
      );
  }
};
