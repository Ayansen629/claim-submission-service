.certificateContainer {
  max-width: 1200px;
  margin: 0 auto;
  padding: 30px;
  background: #f9fafb;
  font-family: 'Segoe UI', 'Roboto', sans-serif;
  color: #1f2937;
  line-height: 1.5;
}

.certificateHeader {
  text-align: center;
  margin-bottom: 30px;
  padding: 30px;
  background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
  color: white;
  border-radius: 12px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

.certificateTitle {
  font-size: 2.2rem;
  font-weight: 700;
  margin: 0;
  letter-spacing: 1px;
}

.subtitle {
  margin: 12px 0 0 0;
  font-size: 1.1rem;
  opacity: 0.9;
  font-weight: 300;
}

.mainCard, .detailsCard {
  margin-bottom: 25px;
  border: none;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.06);
  border-radius: 10px;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.mainCard:hover, .detailsCard:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
}

.cardHeader {
  background: linear-gradient(135deg, #374151 0%, #4b5563 100%);
  color: white;
  border-bottom: none;
  padding: 18px 25px;
}

.cardHeader h5 {
  margin: 0;
  font-weight: 600;
  font-size: 1.1rem;
  letter-spacing: 0.5px;
}

.fieldGroup {
  margin-bottom: 20px;
}

.fieldLabel {
  display: block;
  font-weight: 600;
  color: #374151;
  margin-bottom: 8px;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.autoPopulateField {
  padding: 12px 15px;
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  color: #111827;
  font-weight: 500;
  min-height: 45px;
  display: flex;
  align-items: center;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.autoPopulateFieldEmpty {
  padding: 12px 15px;
  background: #f9fafb;
  border: 1px dashed #d1d5db;
  border-radius: 8px;
  min-height: 45px;
  display: flex;
  align-items: center;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.noDataIndicator {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #6b7280;
  font-style: italic;
}

.noDataIcon {
  font-size: 1.1rem;
}

.editableInput, .editableSelect {
  width: 100%;
  padding: 12px 15px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-size: 0.9rem;
  transition: all 0.2s ease;
  background: white;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.editableInput:focus, .editableSelect:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
}

.dateInputGroup {
  display: flex;
  gap: 15px;
  align-items: end;
}

.dateField {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.dateLabel {
  font-size: 0.8rem;
  font-weight: 600;
  color: #6b7280;
}

.dateInput {
  width: 80px;
  padding: 10px;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  text-align: center;
  font-weight: 600;
  font-size: 0.9rem;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.dateInput:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
}

.statementBox {
  background: white;
  padding: 25px;
  border-radius: 10px;
  margin: 25px 0;
  border-left: 4px solid #3b82f6;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.06);
}

.plyingLimitsContent {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  padding: 15px;
  background: #f9fafb;
  border-radius: 8px;
}

.inlineLabel {
  font-weight: 600;
  color: #374151;
}

.autoPopulateInline {
  background: white;
  padding: 8px 12px;
  border-radius: 6px;
  border: 1px solid #e5e7eb;
}

.autoPopulateInlineEmpty {
  background: #f9fafb;
  padding: 8px 12px;
  border-radius: 6px;
  border: 1px dashed #d1d5db;
}

.inlineNoData {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #6b7280;
  font-style: italic;
  font-size: 0.85rem;
}

.inlineInput {
  width: 100px;
  padding: 8px 12px;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.inlineInput:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
}

.capacityContent {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.capacityItem {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px;
  background: white;
  border-radius: 8px;
  border: 1px solid #e5e7eb;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.capacityLabel {
  font-weight: 600;
  color: #374151;
  flex: 1;
}

.capacityValue {
  font-weight: 700;
  color: #059669;
  min-width: 120px;
  text-align: right;
  padding: 8px 12px;
  background: #f0fdf4;
  border-radius: 6px;
}

.capacityValueEmpty {
  min-width: 120px;
  text-align: right;
  padding: 8px 12px;
  background: #f9fafb;
  border-radius: 6px;
  border: 1px dashed #d1d5db;
}

.capacityNoData {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #6b7280;
  font-style: italic;
}

/* Safety Table Styles */
.safetyTable {
  margin: 0;
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.06);
  background: white;
  width: 100%;
  min-width: 1200px;
}

.mainHeader {
  background: linear-gradient(135deg, #374151 0%, #4b5563 100%);
  color: white;
  font-weight: 700;
  padding: 18px 12px;
  text-align: center;
  border: none;
  font-size: 0.85rem;
  line-height: 1.3;
  vertical-align: middle;
}

.groupHeader {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: white;
  font-weight: 600;
  padding: 14px 10px;
  text-align: center;
  border: none;
  font-size: 0.8rem;
  line-height: 1.2;
}

.subHeader {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: white;
  font-weight: 600;
  padding: 12px 8px;
  text-align: center;
  border: none;
  font-size: 0.75rem;
  line-height: 1.2;
  min-width: 90px;
}

.inputCell {
  padding: 15px 10px;
  text-align: center;
  border: 1px solid #f3f4f6;
  background: #f9fafb;
  vertical-align: middle;
}

.inputCell:hover {
  background: #f3f4f6;
}

.tableNoDataCell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.tableInput {
  width: 100%;
  max-width: 130px;
  padding: 10px 12px;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  text-align: center;
  font-size: 0.85rem;
  font-weight: 500;
  background: white;
  transition: all 0.2s ease;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.tableInput:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
}

.tableInput::placeholder {
  color: #9ca3af;
  font-size: 0.8rem;
}

.certificationBox {
  background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
  color: white;
  padding: 30px;
  border-radius: 10px;
  margin: 30px 0 25px 0;
  text-align: center;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

.certificationTitle {
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 18px;
  color: #e0e7ff;
  letter-spacing: 1px;
}

.certificationText {
  margin: 0;
  line-height: 1.6;
  font-size: 1rem;
  font-weight: 300;
}

.validityBox {
  background: #f0fdf4;
  border: 2px solid #10b981;
  padding: 25px;
  border-radius: 10px;
  text-align: center;
  margin-top: 25px;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.06);
}

.validityBox p {
  margin: 0;
  font-weight: 600;
  color: #065f46;
  font-size: 1rem;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .safetyTable {
    min-width: 1000px;
  }
  
  .mainHeader, .groupHeader {
    font-size: 0.8rem;
    padding: 14px 8px;
  }
  
  .subHeader {
    font-size: 0.7rem;
    padding: 10px 6px;
  }
  
  .dateInputGroup {
    flex-wrap: wrap;
    gap: 10px;
  }
}

@media (max-width: 768px) {
  .certificateContainer {
    padding: 15px;
  }
  
  .certificateTitle {
    font-size: 1.8rem;
  }
  
  .safetyTable {
    min-width: 900px;
  }
  
  .mainHeader, .groupHeader, .subHeader {
    font-size: 0.65rem;
    padding: 10px 4px;
  }
  
  .tableInput {
    max-width: 90px;
    padding: 8px 10px;
    font-size: 0.8rem;
  }
  
  .plyingLimitsContent {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  
  .capacityItem {
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }
  
  .capacityValue, .capacityValueEmpty {
    text-align: center;
  }
  
  .dateInputGroup {
    justify-content: center;
  }
}

@media (max-width: 576px) {
  .certificateHeader {
    padding: 20px 15px;
  }
  
  .certificateTitle {
    font-size: 1.5rem;
  }
  
  .inputCell {
    padding: 10px 6px;
  }
  
  .tableInput {
    max-width: 70px;
    padding: 6px 8px;
    font-size: 0.75rem;
  }
  
  .certificationBox {
    padding: 20px 15px;
  }
  
  .validityBox {
    padding: 20px 15px;
  }
  
  .dateInput {
    width: 60px;
    padding: 8px;
  }
  
  .inlineInput {
    width: 80px;
  }
}

@media (max-width: 480px) {
  .safetyTable {
    min-width: 700px;
  }
  
  .capacityContent {
    gap: 10px;
  }
  
  .capacityItem {
    padding: 12px;
  }
}
