import { useEffect } from "react";
import { Form, useFieldArray, useFormContext } from "react-hook-form";
import { Card, Row, Col, Button } from "react-bootstrap";
import InputSelect from "../../../common/InputSelect.tsx";
import InputText from "../../../common/InputText.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { FaPlus, FaTrash, FaUser, FaMapMarkerAlt, FaGraduationCap, FaBriefcase, FaFileUpload } from "react-icons/fa";
import { CONSTANT_REGEX } from "../../../../utils/constants.ts";
import { useMasterData } from "../../../context/MasterDataContext.js";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import { getData } from "../../../../services/http.service.ts";

const EmployeeRegistrationForm = ({ onSubmit, onCancel }) => {
  const { 
    control, 
    register, 
    setValue, 
    watch, 
    handleSubmit, 
    trigger,
    formState: { errors, isSubmitted } 
  } = useFormContext();
  
  const { fields, append, remove } = useFieldArray({
    control,
    name: "educationDetails"
  });

  const watchPin = watch("vesselUserDetails.pin");

  const { masterData } = useMasterData();

  useEffect(() => {
    const fetchAddressDetails = async (pin) => {
      if (pin?.length === 6) {
        try {
          const URL = process.env.REACT_APP_PUBLIC_URL + URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE + pin;
          const response = await getData(URL);
          if (response?.status === 200 && response?.data?.length > 0) {
            setValue('vesselUserDetails.district', response?.data[0]?.district);
            setValue('vesselUserDetails.stateUt', response?.data[0]?.stateName);
            setValue("vesselUserDetails.country", "India");
          } else {
            setValue("vesselUserDetails.district", "");
            setValue("vesselUserDetails.stateUt", "");
            setValue("vesselUserDetails.country", "");
          }
        } catch (error) {
          setValue("vesselUserDetails.district", "");
          setValue("vesselUserDetails.stateUt", "");
          setValue("vesselUserDetails.country", "");
        }
      }
    };

    if (watchPin) {
      fetchAddressDetails(watchPin);
    }
  }, [watchPin, setValue]);

  // Trigger validation when form is submitted
  useEffect(() => {
    if (isSubmitted) {
      trigger();
    }
  }, [isSubmitted, trigger]);

  return (
    <Form onSubmit={handleSubmit(onSubmit)}>
      <div className="employee-registration-form">
        {/* Personal Details Section */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaUser className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>Personal Details</span>
            </div>
          }
          defaultOpen={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col md={4}>
                  <InputText
                    name="vesselUserDetails.firstName"
                    label="First Name"
                    placeholder="Enter first name"
                    register={register("vesselUserDetails.firstName", { 
                      required: "First Name is required",
                      validate: value => value?.trim() !== "" || "First Name is required"
                    })}
                    errors={errors}
                    style={{
                      borderColor: errors?.vesselUserDetails?.firstName ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.firstName ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={4}>
                  <InputText
                    name="vesselUserDetails.lastName"
                    label="Last Name"
                    placeholder="Enter last name"
                    register={register("vesselUserDetails.lastName", { 
                      required: "Last Name is required",
                      validate: value => value?.trim() !== "" || "Last Name is required"
                    })}
                    errors={errors}
                    style={{
                      borderColor: errors?.vesselUserDetails?.lastName ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.lastName ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={4}>
                  <InputText
                    name="vesselUserDetails.email"
                    label="Email ID"
                    type="email"
                    placeholder="Enter email address"
                    register={register("vesselUserDetails.email", {
                      required: "Email is required",
                      pattern: {
                        value: CONSTANT_REGEX.EMAIL,
                        message: "Invalid email address"
                      }
                    })}
                    errors={errors}
                    style={{
                      borderColor: errors?.vesselUserDetails?.email ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.email ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={4}>
                  <InputText
                    name="vesselUserDetails.phoneNumber"
                    label="Phone Number"
                    placeholder="Enter 10-digit phone number"
                    register={register("vesselUserDetails.phoneNumber", {
                      required: "Phone Number is required",
                      pattern: {
                        value: CONSTANT_REGEX.MOBILE,
                        message: "Invalid phone number"
                      }
                    })}
                    errors={errors}
                    style={{
                      borderColor: errors?.vesselUserDetails?.phoneNumber ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.phoneNumber ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={4}>
                  <InputSelect
                    name="vesselUserDetails.gender"
                    label="Gender"
                    placeholder="-- Select gender --"
                    options={masterData?.genders?.map(type => ({
                      value: type.valueCode,
                      label: type.valueLabel
                    })) || []}
                    register={register("vesselUserDetails.gender", {
                      required: "Gender is required"
                    })}
                    errors={errors}
                    value={watch("vesselUserDetails.gender") || ""}
                    onChange={val => setValue("vesselUserDetails.gender", val, { shouldValidate: true })}
                  />
                </Col>
                <Col md={4}>
                  <InputText
                    name="vesselUserDetails.dateOfBirth"
                    label="Date of Birth"
                    type="date"
                    placeholder="Select date of birth"
                    register={register("vesselUserDetails.dateOfBirth", { 
                      required: "Date of Birth is required"
                    })}
                    errors={errors}
                    style={{
                      borderColor: errors?.vesselUserDetails?.dateOfBirth ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.dateOfBirth ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>

        {/* Address Details Section */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaMapMarkerAlt className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>Address Details</span>
            </div>
          }
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col md={6}>
                  <InputText
                    name="vesselUserDetails.addressLine1"
                    label="Address Line-1"
                    placeholder="Enter address line 1"
                    register={register("vesselUserDetails.addressLine1", { 
                      required: "Address Line-1 is required",
                      validate: value => value?.trim() !== "" || "Address Line-1 is required"
                    })}
                    errors={errors}
                    style={{
                      borderColor: errors?.vesselUserDetails?.addressLine1 ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.addressLine1 ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={6}>
                  <InputText
                    name="vesselUserDetails.addressLine2"
                    label="Address Line-2"
                    placeholder="Enter address line 2 (optional)"
                    register={register("vesselUserDetails.addressLine2")}
                    errors={errors}
                  />
                </Col>
                <Col md={3}>
                  <InputText
                    name="vesselUserDetails.pin"
                    label="PIN"
                    placeholder="Enter 6-digit PIN code"
                    register={register("vesselUserDetails.pin", {
                      required: "PIN Code is required",
                      pattern: {
                        value: /^\d{6}$/,
                        message: "Invalid PIN code (must be 6 digits)"
                      }
                    })}
                    errors={errors}
                    style={{
                      borderColor: errors?.vesselUserDetails?.pin ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.pin ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={3}>
                  <InputText
                    name="vesselUserDetails.district"
                    label="District"
                    placeholder="Auto-populated"
                    register={register("vesselUserDetails.district")}
                    errors={errors}
                    readOnly
                  />
                </Col>
                <Col md={3}>
                  <InputText
                    name="vesselUserDetails.stateUt"
                    label="State/UT"
                    placeholder="Auto-populated"
                    register={register("vesselUserDetails.stateUt")}
                    errors={errors}
                    readOnly
                  />
                </Col>
                <Col md={3}>
                  <InputText
                    name="vesselUserDetails.country"
                    label="Country"
                    placeholder="Enter country"
                    register={register("vesselUserDetails.country")}
                    errors={errors}
                    readOnly
                  />
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>

        {/* Education Details Section */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaGraduationCap className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>Education Details</span>
            </div>
          }
        >
          <Card className="form-section-card">
            <Card.Body>
              {fields.map((field, index) => (
                <div key={field.id} className="education-entry mb-4">
                  {index > 0 && <div className="entry-divider mb-3"></div>}
                  <Row className="g-3">
                    <Col md={4}>
                      <InputText
                        name={`educationDetails.${index}.qualification`}
                        label={`Qualification ${index === 0 ? '*' : ''}`}
                        placeholder="Enter qualification"
                        register={register(`educationDetails.${index}.qualification`, 
                          index === 0 ? { 
                            required: "Qualification is required",
                            validate: value => value?.trim() !== "" || "Qualification is required"
                          } : {}
                        )}
                        errors={errors}
                        style={{
                          borderColor: errors?.educationDetails?.[index]?.qualification ? '#dc3545' : undefined,
                          backgroundColor: errors?.educationDetails?.[index]?.qualification ? '#fff8f8' : undefined
                        }}
                      />
                    </Col>
                    <Col md={4}>
                      <InputText
                        name={`educationDetails.${index}.stream`}
                        label={`Stream ${index === 0 ? '*' : ''}`}
                        placeholder="Enter stream"
                        register={register(`educationDetails.${index}.stream`,
                          index === 0 ? { 
                            required: "Stream is required",
                            validate: value => value?.trim() !== "" || "Stream is required"
                          } : {}
                        )}
                        errors={errors}
                        style={{
                          borderColor: errors?.educationDetails?.[index]?.stream ? '#dc3545' : undefined,
                          backgroundColor: errors?.educationDetails?.[index]?.stream ? '#fff8f8' : undefined
                        }}
                      />
                    </Col>
                    <Col md={3}>
                      <InputText
                        name={`educationDetails.${index}.yearOfPassing`}
                        label={`Year of Passing ${index === 0 ? '*' : ''}`}
                        placeholder="Enter year"
                        type="number"
                        register={register(`educationDetails.${index}.yearOfPassing`, {
                          ...(index === 0 ? { required: "Year of Passing is required" } : {}),
                          min: { value: 1900, message: "Invalid year" },
                          max: { value: new Date().getFullYear(), message: "Invalid year" }
                        })}
                        errors={errors}
                        style={{
                          borderColor: errors?.educationDetails?.[index]?.yearOfPassing ? '#dc3545' : undefined,
                          backgroundColor: errors?.educationDetails?.[index]?.yearOfPassing ? '#fff8f8' : undefined
                        }}
                      />
                    </Col>
                    <Col md={1} className="d-flex align-items-end">
                      {index > 0 && (
                        <Button
                          variant="danger"
                          size="sm"
                          onClick={() => remove(index)}
                          className="mt-1"
                        >
                          <FaTrash />
                        </Button>
                      )}
                    </Col>
                  </Row>
                </div>
              ))}
              <Button
                variant="outline-primary"
                onClick={() => append({ qualification: "", stream: "", yearOfPassing: "" })}
                className="add-education-btn"
              >
                <FaPlus className="me-2" /> Add Education Details
              </Button>
            </Card.Body>
          </Card>
        </Collapsible>

        {/* Professional Details Section */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaBriefcase className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>Professional Details</span>
            </div>
          }
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col md={4}>
                  <InputText
                    name="professional.appointmentDate"
                    label="Appointment Date"
                    type="date"
                    placeholder="Select appointment date"
                    register={register("professional.appointmentDate", { 
                      required: "Appointment Date is required"
                    })}
                    errors={errors}
                    style={{
                      borderColor: errors?.professional?.appointmentDate ? '#dc3545' : undefined,
                      backgroundColor: errors?.professional?.appointmentDate ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={4}>
                  <InputSelect
                    name="professional.employeeType"
                    label="Employee Type"
                    placeholder="Select employee type"
                    options={masterData?.employeeTypes?.map(type => ({
                      value: type.valueCode,
                      label: type.valueLabel
                    })) || []}
                    register={register("professional.employeeType", {
                      required: "Employee Type is required"
                    })}
                    errors={errors}
                    value={watch("professional.employeeType") || ""}
                    onChange={val => setValue("professional.employeeType", val, { shouldValidate: true })}
                  />
                </Col>
                <Col md={4}>
                  <InputSelect
                    name="professional.employeeStatus"
                    label="Employee Status"
                    placeholder="Select employee status"
                    options={masterData?.employeeStatuses?.map(type => ({
                      value: type.valueCode,
                      label: type.valueLabel
                    })) || []}
                    register={register("professional.employeeStatus", {
                      required: "Employee Status is required"
                    })}
                    errors={errors}
                    value={watch("professional.employeeStatus") || ""}
                    onChange={val => setValue("professional.employeeStatus", val, { shouldValidate: true })}
                  />
                </Col>
                <Col md={4}>
                  <InputSelect
                    name="professional.designation"
                    label="Designation"
                    placeholder="Select designation"
                    options={masterData?.designations?.map(type => ({
                      value: type.valueCode,
                      label: type.valueLabel
                    })) || []}
                    register={register("professional.designation", {
                      required: "Designation is required"
                    })}
                    errors={errors}
                    value={watch("professional.designation") || ""}
                    onChange={val => setValue("professional.designation", val, { shouldValidate: true })}
                  />
                </Col>
                <Col md={4}>
                  <InputText
                    name="professional.department"
                    label="Department"
                    placeholder="Auto-populated"
                    register={register("professional.department", {
                      required: "Department is required"
                    })}
                    errors={errors}
                    readOnly
                    style={{
                      borderColor: errors?.professional?.department ? '#dc3545' : undefined,
                      backgroundColor: errors?.professional?.department ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={4}>
                  <InputText
                    name="professional.section"
                    label="Section"
                    placeholder="Enter section"
                    register={register("professional.section", {
                      required: "Section is required",
                      validate: value => value?.trim() !== "" || "Section is required"
                    })}
                    errors={errors}
                    style={{
                      borderColor: errors?.professional?.section ? '#dc3545' : undefined,
                      backgroundColor: errors?.professional?.section ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={4}>
                  <InputSelect
                    name="professional.roles"
                    label="Roles"
                    placeholder="Select role"
                    options={masterData?.roles?.map(type => ({
                      value: type.valueCode,
                      label: type.valueLabel
                    })) || []}
                    register={register("professional.roles", {
                      required: "Role is required"
                    })}
                    errors={errors}
                    value={watch("professional.roles") || ""}
                    onChange={val => setValue("professional.roles", val, { shouldValidate: true })}
                  />
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>

        {/* Documents Upload Section */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>Documents Upload</span>
            </div>
          }
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col md={4}>
                  <InputText
                    name="documents.addressProof"
                    label="Address Proof"
                    type="file"
                    register={register("documents.addressProof", { 
                      required: "Address Proof is required"
                    })}
                    errors={errors}
                    style={{
                      borderColor: errors?.documents?.addressProof ? '#dc3545' : undefined,
                      backgroundColor: errors?.documents?.addressProof ? '#fff8f8' : undefined
                    }}
                  />
                  <small className="text-muted">Upload PDF, JPG or PNG (Max: 2MB)</small>
                </Col>
                <Col md={4}>
                  <InputText
                    name="documents.identityProof"
                    label="Identity Proof"
                    type="file"
                    register={register("documents.identityProof", { 
                      required: "Identity Proof is required"
                    })}
                    errors={errors}
                    style={{
                      borderColor: errors?.documents?.identityProof ? '#dc3545' : undefined,
                      backgroundColor: errors?.documents?.identityProof ? '#fff8f8' : undefined
                    }}
                  />
                  <small className="text-muted">Upload PDF, JPG or PNG (Max: 2MB)</small>
                </Col>
                <Col md={4}>
                  <InputText
                    name="documents.appointmentLetter"
                    label="Appointment Letter"
                    type="file"
                    register={register("documents.appointmentLetter", { 
                      required: "Appointment Letter is required"
                    })}
                    errors={errors}
                    style={{
                      borderColor: errors?.documents?.appointmentLetter ? '#dc3545' : undefined,
                      backgroundColor: errors?.documents?.appointmentLetter ? '#fff8f8' : undefined
                    }}
                  />
                  <small className="text-muted">Upload PDF, JPG or PNG (Max: 2MB)</small>
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>
      </div>
    </Form>
  );
};

export default EmployeeRegistrationForm;
///
import React from "react";
import Select from "react-select";
import { Form } from "react-bootstrap";
import "./InputSelect.css";

interface InputSelectProps {
  label: string;
  required?: boolean;
  name: string;
  options: Array<{ value: string | number; label: string }>;
  register?: any;
  errors?: any;
  disabled?: boolean;
  onChange?: (value: string | number) => void;
  className?: string;
  style?: React.CSSProperties;
  icon?: React.ElementType;
  value?: any;
  isMulti?: boolean;
  isClearable?: boolean;
}

const InputSelect: React.FC<InputSelectProps> = ({
  label,
  required,
  name,
  options,
  register,
  errors,
  disabled,
  onChange,
  className = "",
  style = {},
  icon: IconComponent,
  value,
  isMulti = false,
  isClearable = false,
}) => {
  const hasError = errors && errors[name];
  const selectedOption = options.find(opt => opt.value === value);
  
  const handleChange = (selected: any) => {
    const newValue = selected?.value || "";
    onChange?.(newValue);
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold d-block">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>

      <div className="position-relative">
        {IconComponent && (
          <div
            className={`input-icon position-absolute ${
              hasError ? "text-danger" : value ? "text-success" : "text-primary"
            }`}
            style={{
              left: "10px",
              top: "50%",
              transform: "translateY(-50%)",
              zIndex: 2,
            }}
          >
            <IconComponent size={18} />
          </div>
        )}

        <Select
          options={options}
          value={selectedOption}
          onChange={handleChange}
          isDisabled={disabled}
          isMulti={isMulti}
          isClearable={isClearable}
          className={`react-select-container ${hasError ? "is-invalid" : ""}`}
          classNamePrefix="react-select"
          styles={{
            control: (base, state) => ({
              ...base,
              borderColor: hasError ? "#dc3545" : state.isFocused ? "#80bdff" : "#ced4da",
              boxShadow: state.isFocused && !hasError ? "0 0 0 0.2rem rgba(0, 123, 255, 0.25)" : "none",
              paddingLeft: IconComponent ? "40px" : "12px",
              backgroundColor: hasError ? "#fff8f8" : "white",
              minHeight: "calc(1.5em + 1rem + 2px)",
              "&:hover": {
                borderColor: hasError ? "#dc3545" : "#ced4da"
              }
            }),
            menu: (base) => ({
              ...base,
              zIndex: 9999
            })
          }}
        />
        
        {/* Register the field for validation */}
        {register && (
          <input
            type="hidden"
            {...register(name, {
              validate: value => {
                if (required && !value) return `${label} is required`;
                return true;
              }
            })}
            value={value || ""}
          />
        )}
      </div>

      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;
