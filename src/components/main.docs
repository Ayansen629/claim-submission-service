import React, { useState, useEffect } from "react";
import { FaPhone, FaEnvelope, FaCheckSquare, FaChevronDown, FaEdit, FaExclamationTriangle } from "react-icons/fa";
import styles from './Profile.module.css';
import UserProfileLogo from "../../../assets/images/user-profilelogo.jpg";
import { getFromLocalStorage } from "../../../utils/localStorageUtils.js";
import { USER_ROLES } from "../../../utils/constants.ts";

const Profile = () => {
  const [profileData, setProfileData] = useState({
    name: "",
    phone: "",
    email: "",
    pan: "",
    aadhar: "",
    license: ""
  });

  useEffect(() => {
    const safeParse = (key) => {
      try {
        return JSON.parse(getFromLocalStorage(key) || "{}");
      } catch {
        return {};
      }
    };

    const userRole = getFromLocalStorage("userRole");
    let data = {};

    if (userRole === USER_ROLES.VESSEL_OWNER) {
      const ownerDetails = safeParse("ownerDetails");
      data = {
        name: ownerDetails.ownerCompanyName || ownerDetails.authorisedFname || null,
        phone: ownerDetails.phoneNumber || null,
        email: ownerDetails.emailId || null,
        pan: ownerDetails.panNo ? `${ownerDetails.panNo.substring(0, 4)}*******` : null,
        aadhar: ownerDetails.aadharNumber ? `${ownerDetails.aadharNumber.substring(0, 4)} ${ownerDetails.aadharNumber.substring(4, 8)} ****` : null,
        license: ownerDetails.tradeLicenseNumber ? `${ownerDetails.tradeLicenseNumber.substring(0, 15)}******` : null
      };
    } else {
      const employeeDetails = safeParse("employeeDetails");
      data = {
        name: `${employeeDetails.firstName || ""} ${employeeDetails.lastName || ""}`.trim() || null,
        phone: employeeDetails.phoneNumber || null,
        email: employeeDetails.emailId || null,
        pan: null,
        aadhar: null,
        license: null
      };
    }

    setProfileData(data);
  }, []);

  const renderContactItem = (icon, value, prefix = "") => (
    <div className={styles.contactItem}>
      {value ? (
        <>
          {icon}
          <span>{prefix}{value}</span>
        </>
      ) : (
        <>
          <FaExclamationTriangle style={{ color: '#ff6b6b' }} />
          <span style={{ color: '#999', fontStyle: 'italic' }}>Not Available</span>
        </>
      )}
    </div>
  );

  const renderDocLabel = (label, value) => (
    <span className={styles.docLabel}>
      {label}: {value ? value : (
        <span style={{ color: '#999', fontStyle: 'italic' }}>
          <FaExclamationTriangle style={{ fontSize: '12px', marginRight: '4px' }} />
          Not Available
        </span>
      )}
    </span>
  );

  return (
    <div className={styles.container}>
      <div className={styles.card}>
        <div className={styles.circularImage}>
          <img 
            src={UserProfileLogo}
            alt="Profile"
          />
          <div className={styles.editIcon}>
            <FaEdit />
          </div>
        </div>
        
        <h1 className={styles.companyName}>
          {profileData.name || (
            <span style={{ color: '#999', fontStyle: 'italic' }}>
              <FaExclamationTriangle style={{ marginRight: '8px' }} />
              Name Not Available
            </span>
          )}
        </h1>
        
        <div className={styles.contactRow}>
          {renderContactItem(<FaPhone className={styles.phoneIcon} />, profileData.phone, "+91 ")}
          {renderContactItem(<FaEnvelope className={styles.emailIcon} />, profileData.email)}
        </div>
        
        <div className={styles.documentRow}>
          {renderDocLabel("PAN", profileData.pan)}
          {renderDocLabel("Aadhar", profileData.aadhar)}
          {renderDocLabel("License", profileData.license)}
        </div>
        
        <div className={styles.vesselSection}>
          <div className={styles.vesselHeader}>
            <span>Vessel Details</span>
            <FaChevronDown className={styles.chevron} />
          </div>
          
          <div className={styles.optionsSection}>
            <div className={styles.option}>
              <FaCheckSquare className={styles.checkIcon} />
              <span>Name Change</span>
              <FaEdit className={styles.optionEditIcon} />
            </div>
            <div className={styles.option}>
              <FaCheckSquare className={styles.checkIcon} />
              <span>Address Change</span>
              <FaEdit className={styles.optionEditIcon} />
            </div>
          </div>
        </div>
        
        <button className={styles.proceedButton}>
          Proceed Now
        </button>
      </div>
    </div>
  );
};

export default Profile;
