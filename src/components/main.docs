.declaration-wrapper {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 12px;
  padding: 1.5rem;
  border: 2px solid #e3f2fd;
}

.declaration-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 1rem;
  border-bottom: 2px solid #2466BF;
}

.declaration-content {
  background: white;
  padding: 1.5rem;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  margin-top: 1rem;
}

.declaration-text {
  font-size: 1rem;
  line-height: 1.8;
  color: #333;
}

.highlight-field {
  background: linear-gradient(120deg, #2466BF 0%, #1976d2 100%);
  color: white;
  padding: 2px 8px;
  border-radius: 4px;
  font-weight: 600;
  display: inline-block;
  margin: 0 2px;
}

.editable-field {
  background: linear-gradient(120deg, #28a745 0%, #20c997 100%) !important;
  cursor: pointer;
  transition: all 0.3s ease;
}

.editable-field:hover {
  transform: translateY(-1px);
  box-shadow: 0 2px 4px rgba(40, 167, 69, 0.3);
}

.declaration-footer {
  border-top: 1px solid #dee2e6;
  padding-top: 1rem;
}

.declaration-text p {
  text-align: justify;
  margin-bottom: 1rem;
}
