const handleViewAction = (rowData) => {
  const regNo = rowData?.applicationNumber || "";
  if (!regNo) {
    toast.warning("Application Number missing...", {
      position: "top-right",
    });
    return;
  }

  // Check if it's a Transfer of Registry application
  if (regNo.includes("/TRF/")) {
    navigate(`/vessel-registration/transfer-of-registry-application/view?applicationNo=${regNo}`, {
      state: {
        rowData: { ...rowData },
      },
    });
  } else {
    navigate(`/dashboard/vessel-info/vessel-registration/view?applicationNo=${regNo}`, {
      state: {
        rowData: { ...rowData },
      },
    });
  }
};

const handleEditAction = (rowData) => {
  const regNo = rowData?.applicationNumber || "";
  if (!regNo) {
    toast.warning("Application Number missing...", {
      position: "top-right",
    });
    return;
  }

  // Check if it's a Transfer of Registry application
  if (regNo.includes("/TRF/")) {
    navigate(`/vessel-registration/transfer-of-registry-application/edit?applicationNo=${regNo}`);
  } else {
    navigate(`/dashboard/vessel-registration/new-vessel/edit?applicationNo=${regNo}`);
  }
};
