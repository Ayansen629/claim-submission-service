/* General Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Main Header */
.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 1.5rem;
  background-color: #fff;
  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
  top: 0;
  left: 0;
  width: 100%;
  position: fixed;
  z-index: 1000;
}

/* Logo Section */
.header-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo-container {
  width: 50px;
  height: 50px;
  border-radius: 60%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.2);
}

.logo {
  width: 30px;
  height: 30px;
  object-fit: contain;
}

.header-title h4 {
  font-size: 18px;
  font-weight: bold;
  color: #269ccc;
  margin: 0;
}

.header-title p {
  font-size: 14px;
  font-weight: bold;
  color: #99c8e8;
  margin: 0;
}

/* Navigation Menu */
.header-nav {
  display: flex;
  align-items: center;
}

.nav-list {
  display: flex;
  list-style-type: none;
  gap: 1.5rem;
  margin: 0;
  padding: 0;
}

.nav-item {
  position: relative;
}

.nav-link {
  text-decoration: none;
  font-size: 16px;
  font-weight: bold;
  color: #7b7b7b;
  transition: color 0.2s ease;
  padding: 0.5rem 0;
  display: block;
}

.nav-link:hover {
  color: #269ccc;
}

/* Dropdown Menu for Claim Management */
.dropdown-createmenu {
  position: absolute;
  top: 100%;
  left: 0;
  background: #269ccc;
  list-style-type: none;
  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
  min-width: 200px;
  z-index: 1000;
  display: none;
  padding: 0.5rem 0;
  border-radius: 8px;
}

.nav-item.dropdown:hover .dropdown-createmenu {
  display: block;
}

/* Nested Dropdown Menu */
.nested-dropdown-menu {
  position: absolute;
  top: 0;
  left: 100%;
  background: #269ccc;
  list-style-type: none;
  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
  min-width: 200px;
  display: none;
  padding: 0.5rem 0;
  border-radius: 8px;
}

.dropdown-createmenu li:hover .nested-dropdown-menu {
  display: block;
}

/* User Menu Dropdown */
.dropdown-menu-end {
  position: absolute;
  top: 100%;
  right: 0;
  background-color: #fff;
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 0.5rem 0;
  min-width: 180px;
  display: none;
  z-index: 1000;
  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
}

.user-menu:hover .dropdown-menu-end {
  display: block;
}

/* Dropdown Items */
.dropdown-menu-end .dropdown-rightheader {
  padding: 0.75rem 1rem;
  font-size: 14px;
  color: #7b7b7b;
  background-color: transparent;
  transition: background-color 0.2s ease, color 0.2s ease;
  border: none;
  width: 100%;
  text-align: left;
  cursor: pointer;
}

/* Hover Effect for Dropdown Items */
.dropdown-menu-end .dropdown-rightheader:hover {
  background-color: #269ccc;
  color: #fff;
  border-radius: 4px;
}

.dropdown-item-header {
  display: block;
  padding: 0.5rem 1rem;
  text-decoration: none;
  font-size: 14px;
  color: #ecf0f1;
  transition: background-color 0.2s ease;
}

.dropdown-item-header:hover {
  background-color: #3498db;
  border-radius: 4px;
}

/* Hamburger Menu for Mobile */
.hamburger-menu {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  margin-left: auto;
}

.hamburger-menu div {
  width: 25px;
  height: 3px;
  background-color: #ecf0f1;
  transition: all 0.3s ease;
}

/* Responsive Design */
@media (max-width: 768px) {
  .hamburger-menu {
    display: flex;
    order: 2;
  }

  .header-nav {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: #2c3e50;
    flex-direction: column;
    align-items: flex-start;
    padding: 1rem;
    display: none;
  }

  .header-nav.active {
    display: flex;
  }

  .nav-list {
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .nav-item {
    width: 100%;
  }

  .dropdown-createmenu {
    position: static;
    display: none;
    width: 100%;
  }

  .nav-item.dropdown:hover .dropdown-createmenu {
    display: block;
  }

  .nested-dropdown-menu {
    position: static;
    display: none;
    width: 100%;
  }

  .dropdown-createmenu li:hover .nested-dropdown-menu {
    display: block;
  }

  .user-menu {
    order: 3;
  }
}
