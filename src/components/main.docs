// Add this in the column mapping section, after the status field handling:

// Handle "receipt" column with download button
if (o.fieldName === "receipt") {
  return (
    <td
      key={colIndex}
      className={`px-0 py-2 ${style.actionTable_table_data}`}
      style={{ background: "#ffffff" }}
    >
      <div className="d-flex align-items-center justify-content-center gap-2">
        <span className="fw-medium" style={{ fontSize: "0.85rem" }}>
          {_.get(row, o.fieldName)}
        </span>
        <Tooltip title="Download Receipt" placement="top" arrow>
          <button
            onClick={() => props?.onDownloadReceipt?.(row)}
            type="button"
            className="btn btn-outline-primary btn-sm"
            style={{ 
              padding: "4px 8px",
              borderRadius: "6px",
              display: "flex",
              alignItems: "center",
              gap: "4px"
            }}
          >
            <img
              src={download}
              alt="download"
              style={{ width: "14px", height: "14px" }}
            />
          </button>
        </Tooltip>
      </div>
    </td>
  );
}
