                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t(
                  "Class B Automatic Identification System (AIS) with display"
                )}
                name="navigationEquipment.classBAutoAIS"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("navigationEquipment.classBAutoAIS")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Global Positioning System (GPS) Navigator")}
                name="navigationEquipment.gpsNavigator"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("navigationEquipment.gpsNavigator")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Binocular")}
                name="navigationEquipment.binocular"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("navigationEquipment.binocular")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Aldis lamp or search light")}
                name="navigationEquipment.aldisLamp"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("navigationEquipment.aldisLamp")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Rudder angle indicator")}
                name="navigationEquipment.rudderAngleIndicator"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("navigationEquipment.rudderAngleIndicator")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Others")}
                name="navigationEquipment.othersNavigation"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("navigationEquipment.othersNavigation")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
          </Row>
        </Collapsible>

        {/* Pollution Control Devices */}
        <Collapsible
          title={
            <>
              <FaLeaf className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Pollution Control Devices")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Bilge Water Separator")}
                name="polutionControl.bilgeWaterSeparator"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("polutionControl.bilgeWaterSeparator")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Capacity (m3/hr)")}
                name="polutionControl.bilgeCapacity"
                placeholder={t("Enter capacity")}
                register={register("polutionControl.bilgeCapacity")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Make & Model")}
                name="polutionControl.bilgeMakeModel"
                placeholder={t("Enter make & model")}
                register={register("polutionControl.bilgeMakeModel")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Sewage Treatment Plant")}
                name="polutionControl.sewageTreatmentPlant"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("polutionControl.sewageTreatmentPlant")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Capacity (m3/hr)")}
                name="polutionControl.sewageCapacity"
                placeholder={t("Enter capacity")}
                register={register("polutionControl.sewageCapacity")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Make & Model")}
                name="polutionControl.sewageMakeModel"
                placeholder={t("Enter make & model")}
                register={register("polutionControl.sewageMakeModel")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Oily Water Filter")}
                name="polutionControl.oilyWaterFilter"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("polutionControl.oilyWaterFilter")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Capacity (m3/hr)")}
                name="polutionControl.oilyCapacity"
                placeholder={t("Enter capacity")}
                register={register("polutionControl.oilyCapacity")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Make & Model")}
                name="polutionControl.oilyMakeModel"
                placeholder={t("Enter make & model")}
                register={register("polutionControl.oilyMakeModel")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Exhaust Gas Cleaning System")}
                name="polutionControl.exhaustGasCleaning"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("polutionControl.exhaustGasCleaning")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Capacity (m3/hr)")}
                name="polutionControl.exhaustCapacity"
                placeholder={t("Enter capacity")}
                register={register("polutionControl.exhaustCapacity")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Make & Model")}
                name="polutionControl.exhaustMakeModel"
                placeholder={t("Enter make & model")}
                register={register("polutionControl.exhaustMakeModel")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Others")}
                name="polutionControl.othersPollution"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("polutionControl.othersPollution")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Capacity (m3/hr)")}
                name="polutionControl.othersCapacity"
                placeholder={t("Enter capacity")}
                register={register("polutionControl.othersCapacity")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Make & Model")}
                name="polutionControl.othersMakeModel"
                placeholder={t("Enter make & model")}
                register={register("polutionControl.othersMakeModel")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
          </Row>
        </Collapsible>

        {/* Crew Details */}
        <Collapsible
          title={
            <>
              <FaUsers className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Crew Details")}</span>
            </>
          }
          openStat={true}
        >
          <div style={{ padding: "1rem" }}>
            {fields.map((field, index) => (
              <Row key={field.id} className="gy-3 mb-3 border-bottom pb-3">
                <Col md={4}>
                  <InputText
                    label={t("Total No. of Deck Crew")}
                    name={`crewDetails.crewDetails.${index}.totalDeckCrew`}
                    type="number"
                    placeholder={t("Enter total no. of deck crew")}
                    register={register(`crewDetails.crewDetails.${index}.totalDeckCrew`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={4}>
                  <InputText
                    label={t("Total No. of Engine Crew")}
                    name={`crewDetails.crewDetails.${index}.totalEngineCrew`}
                    type="number"
                    placeholder={t("Enter total no. of engine crew")}
                    register={register(`crewDetails.crewDetails.${index}.totalEngineCrew`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputSelect
                    label={t("Crew Type")}
                    required={true}
                    name={`crewDetails.crewDetails.${index}.crewType`}
                    options={crewTypeOptions}
                    register={register(
                      `crewDetails.crewDetails.${index}.crewType`,
                      {
                        required: t("Crew Type is required"),
                      }
                    )}
                    errors={errors}
                    value={
                      watch(`crewDetails.crewDetails.${index}.crewType`) || ""
                    }
                    onChange={(value) =>
                      !viewMode &&
                      handleSelectChange(
                        `crewDetails.crewDetails.${index}.crewType`,
                        value
                      )
                    }
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Name")}
                    required={true}
                    name={`crewDetails.crewDetails.${index}.name`}
                    placeholder={t("Enter Name")}
                    register={register(`crewDetails.crewDetails.${index}.name`, {
                      required: t("Name is required"),
                    })}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Rank")}
                    name={`crewDetails.crewDetails.${index}.rank`}
                    placeholder={t("Enter Rank")}
                    register={register(`crewDetails.crewDetails.${index}.rank`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("COC No.")}
                    name={`crewDetails.crewDetails.${index}.cocNo`}
                    placeholder={t("Enter COC No.")}
                    register={register(`crewDetails.crewDetails.${index}.cocNo`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Validity")}
                    name={`crewDetails.crewDetails.${index}.validity`}
                    placeholder={t("Enter Validity")}
                    register={register(
                      `crewDetails.crewDetails.${index}.validity`
                    )}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Place of Issue")}
                    name={`crewDetails.crewDetails.${index}.placeOfIssue`}
                    placeholder={t("Enter Place of Issue")}
                    register={register(
                      `crewDetails.crewDetails.${index}.placeOfIssue`
                    )}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                {!viewMode && index > 0 && (
                  <Col md={12} className="text-end">
                    <Button
                      variant="danger"
                      size="sm"
                      onClick={() => remove(index)}
                      className="mt-1"
                    >
                      <FaTrash /> Remove
                    </Button>
                  </Col>
                )}
              </Row>
            ))}
            {!viewMode && (
              <Button
                variant="outline-primary"
                onClick={() =>
                  append({
                    totalDeckCrew: "",
                    totalEngineCrew: "",
                    crewType: "",
                    name: "",
                    rank: "",
                    cocNo: "",
                    validity: "",
                    experience: "",
                  })
                }
                className="mt-2"
              >
                <FaPlus className="me-2" /> Add Crew Member
              </Button>
            )}
          </div>
        </Collapsible>

        
       
{/* Enclosure */}
<Collapsible
  title={
    <div className="d-flex align-items-center">
      <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
      <span style={{ color: "#2466BF" }}>{t("ENCLOSURE")}</span>
    </div>
  }
  defaultOpen={true}
>
  <Card className="form-section-card">
    <Card.Body>
      <Row className="g-3">
        <Col xs={12} lg={6}>
          {renderFileField(
            "authorizationFile",
            t("Authorization of Authorised Person")
          )}
        </Col>
        <Col xs={12} lg={6}>
          {renderFileField(
            "paymentChallan",
            t("Payment Challan/Acknowledgement")
          )}
        </Col>
        <Col xs={12} lg={6}>
          {renderFileField(
            "builderCertificate",
            t("Builder Certificate")
          )}
        </Col>
        <Col xs={12} lg={6}>
          {renderFileField(
            "lastCertificateCopy",
            t("Copy of last Certificate of Survey")
          )}
        </Col>
        <Col xs={12} lg={6}>
          {renderFileField(
            "registrationCertificateCopy",
            t("Copy of Certificate of Registration")
          )}
        </Col>
        <Col xs={12} lg={6}>
          {renderFileField("testCertificate", t("Test Certificate"))}
        </Col>
      </Row>
    </Card.Body>
  </Card>
</Collapsible>

      </form>
    </>
  );
};

export default VesselSurveyForm;
