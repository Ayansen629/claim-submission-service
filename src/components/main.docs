.table {
  width: 100%;
  border-collapse: collapse;
  background-color: #ffffff;
}

.table th,
.table td {
  padding: 12px 16px;
  text-align: left;
  border-bottom: 1px solid #ecf0f1;
  vertical-align: middle;
}

.table th {
  background: #269ccc;
  color: #ffffff;
  font-weight: 900;
  font-size: 18px;
}

.table_datarow {
  background-color: #f9f9f9;
  transition: background-color 0.3s ease;
}

.table_datarow:nth-child(even) {
  background-color: #ffffff;
}

.table_datarow:hover {
  background-color: #f1f8ff;
}
