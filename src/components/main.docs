const validateSurveyForm = async () => {
  // Check if last survey certificate is uploaded
  const lastSurveyCertificate = getValues("enclosure.lastSurveyCertificate");
  const lastSurveyCertificateFileStoreId = getValues("enclosure.lastSurveyCertificateFileStoreId");
  
  if (!lastSurveyCertificate && !lastSurveyCertificateFileStoreId) {
    setError("enclosure.lastSurveyCertificate", {
      type: "required",
      message: t("Last Survey Certificate is required"),
    });
    return false;
  }

  return true;
};
