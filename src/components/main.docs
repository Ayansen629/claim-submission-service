const buildSurveyPayload = (formData, registrationData) => {
  // Get current equipment data from form
  const currentEquipmentData = getValues("equipment") || {};
  const currentDeckSpaces = getValues("deckSpaces") || [];
  const currentFreeboard = getValues("freeboard") || {};

  // ... existing payload code ...

  const payload = {
    surveyId: intialSurveyData?.surveyId || "",
    BasicVesselInformation: {
      // ... existing BasicVesselInformation code ...
    },
    HullParticulars: {
      // ... existing HullParticulars code ...
    },
    RadioandNavigationEquipment: {
      // ... existing RadioandNavigationEquipment code ...
    },
    PollutionControlDevices: {
      // ... existing PollutionControlDevices code ...
    },
    CrewDetails: extractCrewDetails(formData?.crewDetails?.crewDetails),
    equipmentInventoryDetails: null,
    Enclosure: extractEnclosures(
      formData?.enclosure,
      registrationData?.applicationNumber || registrationData?.vessel?.applicationNumber || "",
      intialSurveyData?.Enclosure || []
    ),
    DetailsofPropulsionofEngine: {
      // ... existing DetailsofPropulsionofEngine code ...
    }
  };

  // Add equipment data if it exists
  if (Object.keys(currentEquipmentData).length > 0) {
    const equipmentPayload = buildEquipmentPayload({ 
      equipment: currentEquipmentData,
      deckSpaces: currentDeckSpaces,
      freeboard: currentFreeboard
    }, intialSurveyData);
    
    payload.SurveyEquipments = equipmentPayload.SurveyEquipments;
    payload.passengerDistributionMaxLoad = equipmentPayload.passengerDistributionMaxLoad;
    payload.vesselFreeboardData = equipmentPayload.vesselFreeboardData;
  }

  return payload;
};
