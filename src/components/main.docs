import React, { useState, useEffect } from "react";
import { Link, useLocation } from "react-router-dom";
import { FaChevronRight, FaMoneyBill, FaTimes, FaBars } from "react-icons/fa";
import "./Sidebar.css";

const menuItems = [
  {
    name: "finance",
    label: "Finance",
    icon: <FaMoneyBill />,
    subMenu: [
      { name: "expense-bill", label: "Expense Bill", path: "/finance/expense-bill" },
      { name: "bank-transfer", label: "Bank to Bank Transfer", path: "/finance/bank-transfer" },
      { name: "contractor-bill", label: "Contractor Bill", path: "/finance/contractor-bill" },
      { name: "supplier-bill", label: "Supplier Bill", path: "/finance/supplier-bill" },
    ],
  },
];

const Sidebar = ({ isSidebarOpen, onMenuClick, onClose, onExpand }) => {
  const location = useLocation();
  const [expanded, setExpanded] = useState(false);
  const [isMobile, setIsMobile] = useState(window.innerWidth <= 900);

  useEffect(() => {
    const handleResize = () => setIsMobile(window.innerWidth <= 900);
    window.addEventListener("resize", handleResize);
    return () => window.removeEventListener("resize", handleResize);
  }, []);

  // Mini sidebar for desktop when closed
  if (!isSidebarOpen && !isMobile) {
    return (
      <div className="custom-sidebar mini pro">
        <div className="mini-sidebar-logo">
          <img
            src={require("../../assets/images/GovtLogo.png")}
            alt="Logo"
            style={{ height: "2.2rem", borderRadius: "8px", marginTop: "1.2rem", boxShadow: "0 2px 8px rgba(44,62,80,0.15)" }}
          />
        </div>
        <div className="mini-sidebar-icons">
          <div
            className="mini-sidebar-icon"
            title="Finance"
            onClick={onExpand}
            style={{ marginTop: "2rem" }}
          >
            <FaMoneyBill />
          </div>
        </div>
        <div className="mini-sidebar-expand" onClick={onExpand} title="Expand">
          <FaBars />
        </div>
      </div>
    );
  }

  return (
    <>
      {isSidebarOpen && isMobile && (
        <div className="custom-sidebar-backdrop" onClick={onClose}></div>
      )}
      <div className={`custom-sidebar pro ${isSidebarOpen ? "expanded" : "collapsed"}`}>
        <div className="custom-sidebar-close">
          <FaTimes onClick={onClose} />
        </div>
       
        <ul className="custom-sidebar-menu">
          <li className="custom-sidebar-item">
            <div
              className="custom-sidebar-link"
              onClick={() => setExpanded((prev) => !prev)}
              aria-expanded={expanded}
            >
              <div className="custom-sidebar-link-content">
                <span className="custom-sidebar-icon">
                  <FaMoneyBill />
                </span>
                {isSidebarOpen && <span>Finance</span>}
              </div>
              {isSidebarOpen && (
                <span className={`custom-sidebar-chevron${expanded ? " rotate" : ""}`}>
                  <FaChevronRight size={12} />
                </span>
              )}
            </div>
            <div className={`custom-sidebar-submenu${expanded && isSidebarOpen ? " expanded" : ""}`}>
              {menuItems[0].subMenu.map((sub) => (
                <Link
                  key={sub.name}
                  to={sub.path}
                  className={`custom-sidebar-sublink${location.pathname === sub.path ? " active" : ""}`}
                  onClick={() => {
                    onMenuClick && onMenuClick(sub.name);
                    if (isMobile) onClose();
                  }}
                >
                  {sub.label}
                </Link>
              ))}
            </div>
          </li>
        </ul>
        <div className="sidebar-footer">
          <span>© {new Date().getFullYear()} Digit Finance</span>
        </div>
      </div>
    </>
  );
};

export default Sidebar;
/* Main sidebar styles */
.custom-sidebar,
.custom-sidebar.mini {
  background: linear-gradient(135deg, #232526 0%, #414345 100%);
  color: #f5f6fa;
  box-shadow: 2px 0 16px rgba(44, 62, 80, 0.12);
  border-right: 1px solid #232526;
}

.custom-sidebar {
  position: fixed;
  top: 70px;
  left: 0;
  height: calc(100vh - 70px);
  width: 250px;
  z-index: 1200;
  transform: translateX(-100%);
  transition: transform 0.3s cubic-bezier(.4,2,.6,1);
  display: flex;
  flex-direction: column;
  padding-top: 0;
  overflow-y: auto;
}

.custom-sidebar.expanded {
  transform: translateX(0);
}

.custom-sidebar.collapsed {
  transform: translateX(-100%);
}

.custom-sidebar-close {
  position: absolute;
  top: 18px;
  right: 18px;
  color: #ffd700;
  font-size: 1.5rem;
  cursor: pointer;
  display: none;
  z-index: 2;
}

@media (max-width: 900px) {
  .custom-sidebar {
    width: 80vw;
    max-width: 320px;
    top: 60px;
    height: calc(100vh - 60px);
  }
  .custom-sidebar-close {
    display: block;
  }
  .custom-sidebar.mini {
    display: none !important; /* Hide mini sidebar on mobile */
  }
}

/* Mini sidebar styles */
.custom-sidebar.mini {
  width: 60px;
  min-width: 60px;
  max-width: 60px;
  position: fixed;
  top: 70px;
  left: 0;
  height: calc(100vh - 70px);
  z-index: 1200;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 0;
  overflow-y: auto;
  transition: width 0.3s;
}

.mini-sidebar-logo {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 1.2rem;
}

.mini-sidebar-icons {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 2rem;
}

.mini-sidebar-icon {
  color: #ffd700;
  font-size: 1.5rem;
  margin-bottom: 0.5rem;
  transition: background 0.2s, color 0.2s;
  border-left: 4px solid transparent;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 1.2rem 0;
  cursor: pointer;
}

.mini-sidebar-icon.active,
.mini-sidebar-icon:hover {
  background: rgba(255,215,0,0.08);
  border-left: 4px solid #ffd700;
  color: #ffd700;
}

.mini-sidebar-expand {
  color: #ffd700;
  font-size: 1.5rem;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: background 0.2s, color 0.2s;
  padding: 1.2rem 0;
  cursor: pointer;
  margin-bottom: 0.5rem;
}

.mini-sidebar-expand:hover {
  background: rgba(255,215,0,0.08);
  color: #ffd700;
}

/* Sidebar header and footer */
.sidebar-header {
  padding: 1.5rem 1.5rem 1rem 1.5rem;
  font-size: 1.2rem;
  font-weight: bold;
  letter-spacing: 1px;
  color: #ffd700;
  text-align: left;
  display: flex;
  align-items: center;
}

.sidebar-title {
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: 1px;
}

.sidebar-footer {
  margin-top: auto;
  padding: 1rem 1.5rem;
  font-size: 0.95rem;
  color: #888;
  text-align: left;
  border-top: 1px solid #232526;
  background: rgba(0,0,0,0.04);
}

/* Menu and submenu */
.custom-sidebar-menu {
  list-style: none;
  padding: 0;
  margin: 0;
}

.custom-sidebar-item {
  margin-bottom: 0.5rem;
}

.custom-sidebar-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.85rem 1.5rem;
  cursor: pointer;
  transition: background 0.2s;
  font-weight: 500;
  border-left: 4px solid transparent;
  color: #f5f6fa;
  text-decoration: none;
  border-radius: 8px;
}

.custom-sidebar-item .custom-sidebar-link:hover,
.custom-sidebar-item .custom-sidebar-link:focus {
  background: rgba(255, 215, 0, 0.08);
  border-left: 4px solid #ffd700;
  color: #ffd700;
}

.custom-sidebar-link-content {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.custom-sidebar-icon {
  font-size: 1.3rem;
  color: #ffd700;
}

.custom-sidebar-chevron {
  transition: transform 0.2s;
  color: #ffd700;
}

.custom-sidebar-chevron.rotate {
  transform: rotate(90deg);
}

.custom-sidebar-submenu {
  background: rgba(255,255,255,0.02);
  padding-left: 2.5rem;
  display: none;
  flex-direction: column;
}

.custom-sidebar-submenu.expanded {
  display: flex;
}

.custom-sidebar-sublink {
  color: #f5f6fa;
  padding: 0.5rem 0;
  text-decoration: none;
  font-size: 0.97rem;
  border-left: 2px solid transparent;
  border-radius: 4px;
  transition: color 0.2s, border 0.2s, background 0.2s;
}

.custom-sidebar-sublink.active,
.custom-sidebar-sublink:hover {
  color: #ffd700;
  border-left: 2px solid #ffd700;
  background: rgba(255, 215, 0, 0.06);
}

/* Backdrop for mobile */
.custom-sidebar-backdrop {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(44,62,80,0.25);
  z-index: 1199;
  animation: fadeIn 0.2s;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* Modern sidebar enhancements */
.custom-sidebar.modern,
.custom-sidebar.mini.modern {
  background: linear-gradient(135deg, #23243a 0%, #2c3e50 100%);
  border-right: 1px solid #23243a;
  box-shadow: 2px 0 16px rgba(44, 62, 80, 0.13);
}

.sidebar-header.modern {
  padding: 1.5rem 1.5rem 1rem 1.5rem;
  display: flex;
  align-items: center;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.sidebar-title.modern {
  font-size: 1.25rem;
  font-weight: 700;
  color: #ffd700;
  letter-spacing: 1px;
}

.sidebar-nav {
  margin-top: 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.sidebar-nav-link {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.9rem 1.5rem;
  cursor: pointer;
  color: #f5f6fa;
  font-weight: 500;
  border-radius: 8px;
  transition: background 0.2s, color 0.2s;
  position: relative;
}

.sidebar-nav-link:hover,
.sidebar-nav-link.expanded {
  background: rgba(255, 215, 0, 0.09);
  color: #ffd700;
}

.sidebar-nav-icon {
  font-size: 1.3rem;
  color: #ffd700;
}

.sidebar-nav-chevron {
  margin-left: auto;
  color: #ffd700;
  transition: transform 0.2s;
}
.sidebar-nav-chevron.rotate {
  transform: rotate(90deg);
}

.sidebar-nav-submenu {
  display: none;
  flex-direction: column;
  padding-left: 2.5rem;
  margin-top: 0.2rem;
}
.sidebar-nav-submenu.expanded {
  display: flex;
}

.sidebar-nav-sublink {
  color: #f5f6fa;
  padding: 0.5rem 0;
  text-decoration: none;
  font-size: 0.97rem;
  border-left: 2px solid transparent;
  border-radius: 4px;
  transition: color 0.2s, border 0.2s, background 0.2s;
}
.sidebar-nav-sublink.active,
.sidebar-nav-sublink:hover {
  color: #ffd700;
  border-left: 2px solid #ffd700;
  background: rgba(255, 215, 0, 0.06);
}

.sidebar-footer.modern {
  margin-top: auto;
  padding: 1rem 1.5rem;
  font-size: 0.95rem;
  color: #bfc9d1;
  border-top: 1px solid rgba(255,255,255,0.06);
  background: rgba(0,0,0,0.04);
}
//header.js
import React, { useState } from "react";
import { FaBars, FaUserCircle, FaGlobe } from "react-icons/fa";
import "./Header.css";

const Header = ({ toggleSidebar, onLogout }) => {
  const [language, setLanguage] = useState("en");

  const handleLanguageChange = (lang) => setLanguage(lang);

  return (
    <nav className="custom-navbar pro-navbar">
      {/* Sidebar Toggle */}
      <button
        className="sidebar-toggle"
        onClick={toggleSidebar}
        aria-label="Toggle Sidebar"
      >
        <FaBars />
      </button>

      {/* Logo and App Title */}
      <div className="navbar-logo-title">
        <img
          src={require("../../assets/images/logo-gov.png")}
          alt="Logo"
          className="navbar-logo"
        />
        <span className="navbar-title">Digit Finance</span>
      </div>

      <div className="navbar-actions">
        {/* Language Dropdown */}
        <div className="dropdown me-3">
          <button
            className="btn lang-btn"
            type="button"
            id="langDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            <FaGlobe size={18} />
            <span className="d-none d-sm-inline ms-1">{language === "en" ? "English" : "हिंदी"}</span>
          </button>
          <ul className="dropdown-menu dropdown-menu-end" aria-labelledby="langDropdown">
            <li>
              <button className="dropdown-item" onClick={() => handleLanguageChange("en")}>
                English
              </button>
            </li>
            <li>
              <button className="dropdown-item" onClick={() => handleLanguageChange("hi")}>
                हिंदी
              </button>
            </li>
          </ul>
        </div>

        {/* Profile Dropdown */}
        <div className="dropdown">
          <button
            className="btn profile-btn"
            type="button"
            id="profileDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            <FaUserCircle size={28} className="profile-img" />
            <span className="d-none d-sm-inline ms-2">Profile</span>
          </button>
          <ul className="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
            <li>
              <button className="dropdown-item">My Profile</button>
            </li>
            <li>
              <button className="dropdown-item text-danger" onClick={onLogout}>
                Logout
              </button>
            </li>
          </ul>
        </div>
      </div>
    </nav>
  );
};

export default Header;
//header.css
.pro-navbar {
  background: linear-gradient(90deg, #23243a 0%, #2c3e50 100%);
  color: #fff;
  height: 70px;
  width: 100%;
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1050;
  display: flex;
  align-items: center;
  padding: 0 2rem;
  box-shadow: 0 2px 8px rgba(44, 62, 80, 0.10);
}

.sidebar-toggle {
  background: none;
  border: none;
  color: #ffd700;
  font-size: 1.7rem;
  margin-right: 1.5rem;
  cursor: pointer;
  transition: color 0.2s;
}
.sidebar-toggle:hover {
  color: #fff;
}

.navbar-logo-title {
  display: flex;
  align-items: center;
  gap: 0.7rem;
}

.navbar-logo {
  height: 2.5rem;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(44, 62, 80, 0.08);
}

.navbar-title {
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: 1px;
  color: #ffd700;
  text-shadow: 0 1px 2px #23243a;
}

.navbar-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 1.2rem;
}

.lang-btn, .profile-btn {
  background: none;
  border: none;
  color: #fff;
  font-weight: 500;
  display: flex;
  align-items: center;
  font-size: 1rem;
  transition: color 0.2s;
  padding: 0.3rem 0.7rem;
  border-radius: 6px;
}
.lang-btn:hover, .profile-btn:hover {
  color: #ffd700;
  background: rgba(255,215,0,0.08);
}

.profile-img {
  margin-right: 0.3rem;
}

.dropdown-menu {
  min-width: 160px;
  font-size: 0.95rem;
  border-radius: 8px;
  box-shadow: 0 4px 12px rgba(44, 62, 80, 0.15);
}

.dropdown-menu .dropdown-item:hover {
  background-color: #f1f1f1;
  color: #23243a;
}

@media (max-width: 900px) {
  .pro-navbar {
    height: 60px;
    padding: 0 0.7rem;
  }
  .navbar-title {
    font-size: 1.1rem;
  }
  .navbar-logo {
    height: 2rem;
  }
}
//headersidebar.js

import React, { useState } from "react";
import { useNavigate } from "react-router-dom";
import Header from "./Header";
import Sidebar from "./Sidebar";
import "../private/Main.css";

const HeaderSidebar = ({ children, onLogout }) => {
  const [isSidebarOpen, setIsSidebarOpen] = useState(true);
  const navigate = useNavigate();

  const toggleSidebar = () => setIsSidebarOpen((prev) => !prev);

  const handleMenuClick = (menu) => {
    if (menu === "logout") {
      onLogout?.();
      navigate("/");
    } else {
      navigate(`/${menu}`);
    }
  };

  return (
    <div className="header-sidebar-container">
      <Header
        toggleSidebar={toggleSidebar}
        onLogout={onLogout}
        isSidebarOpen={isSidebarOpen}
      />
      <div className="main-layout">
      <Sidebar
  isSidebarOpen={isSidebarOpen}
  onMenuClick={handleMenuClick}
  onClose={() => setIsSidebarOpen(false)}
  onExpand={() => setIsSidebarOpen(true)} // <-- Add this line
/>
       <div className="content-container">
      {children}
    </div>
      </div>
    </div>
  );
};

export default HeaderSidebar;
//main.css
.header-sidebar-container {
  min-height: 100vh;
  background: #f7f9fb;
}

.main-layout {
  display: flex;
  margin-top: 70px; /* header height */
}

.content-container {
  flex: 1;
  padding: 2rem;
  transition: margin-left 0.3s;
}

@media (min-width: 901px) {
  .main-layout {
    margin-left: 60px; /* mini sidebar width by default */
  }
  .custom-sidebar.expanded ~ .content-container {
    margin-left: 250px; /* full sidebar width */
  }
  .custom-sidebar.mini ~ .content-container {
    margin-left: 60px; /* mini sidebar width */
  }
}

@media (max-width: 900px) {
  .main-layout {
    margin-left: 0;
  }
  .content-container {
    margin-left: 0;
    padding: 1rem;
  }
}
