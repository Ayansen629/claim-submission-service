.text-field .form-control,
.form-input {
  border: 1px solid #d1d5db;
  border-radius: 6px;
  font-size: 0.85rem;
  transition: all 0.3s ease;
  background: #ffffff;
  color: #000000; /* Changed to black for better readability */
  font-weight: 600; /* Increased font weight for highlighting */
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  width: 100%;
  height: 38px;
  padding: 0.5rem 0.75rem;
}

.text-field .form-control:disabled,
.form-input:disabled,
.disabled-field {
  background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%) !important;
  border: 1px solid #e5e7eb !important;
  border-radius: 6px !important;
  color: #000000 !important; /* Black color for disabled fields too */
  font-weight: 600 !important; /* Bold text for better visibility */
  font-size: 0.85rem;
  padding: 0.5rem 0.75rem !important;
  cursor: not-allowed;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.05) !important;
  width: 100%;
  height: 38px;
}
