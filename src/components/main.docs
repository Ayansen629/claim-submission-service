<FormProvider {...methods}>
  <form className="form-stepper">
    {/* Claim Type Selection */}
    <div className="form-section">
      <Collapsible title="Details of Claim" defaultOpen={true}>
        <div className="form-grid">
          {/* Claim Type Dropdown */}
          <div className="form-group">
            <label className="form-label">
              Select Claim Type <span className="required-asterisk">*</span>
            </label>
            <select
              {...register("claimType", { required: "Claim type is required" })}
              className={`form-control ${errors.claimType ? "is-invalid" : ""}`}
              onChange={(e) => handleClaimTypeChange(e.target.value)}
              value={selectedClaimType}
            >
              {claimTypeOptions.map((option) => (
                <option key={option.value} value={option.value} disabled={option.disabled}>
                  {option.label}
                </option>
              ))}
            </select>
            {errors.claimType && <div className="invalid-feedback">{errors.claimType.message}</div>}
          </div>

          {/* Display Claim Type as Read-Only Field */}
          {selectedClaimType && (
            <div className="form-group">
              <label className="form-label">
                Claim Type <span className="required-asterisk">*</span>
              </label>
              <input
                {...register("claimTypeDisplay", { required: "Claim type is required" })}
                type="text"
                className={`form-control ${errors.claimTypeDisplay ? "is-invalid" : ""}`}
                placeholder="Claim type"
                value={
                  selectedClaimType
                    ? claimTypeOptions.find((opt) => opt.value === selectedClaimType)?.label || ""
                    : ""
                }
                readOnly
              />
            </div>
          )}

          {/* Details of How Debt Incurred */}
          {selectedClaimType && (
            <div className="form-group">
              <DynamicField
                fieldConfig={{
                  name: "debtDetails",
                  label: "Details of how debt incurred",
                  type: "textarea",
                  rules: { required: "This field is required" },
                  placeholder: "Enter details of how debt was incurred",
                  rows: 3,
                }}
                control={control}
                register={register}
                errors={errors}
                setValue={setValue}
                getValues={getValues}
                watch={watch}
              />
            </div>
          )}

          {/* Date of Debt Incurred */}
          {selectedClaimType && (
            <div className="form-group">
              <DynamicField
                fieldConfig={{
                  name: "debtDate",
                  label: "Date of debt incurred",
                  type: "date",
                  rules: {
                    required: "This field is required",
                    validate: (value) => {
                      const today = new Date().toISOString().split("T")[0];
                      return value <= today || "Date cannot be in the future";
                    },
                  },
                  placeholder: "Select date",
                }}
                control={control}
                register={register}
                errors={errors}
                setValue={setValue}
                getValues={getValues}
                watch={watch}
              />
            </div>
          )}

          {/* Mutual Details */}
          {selectedClaimType && (
            <div className="form-group full-width">
              <DynamicField
                fieldConfig={{
                  name: "mutualDetails",
                  label:
                    "Details of any mutual credit, mutual debts, or other mutual dealings between the corporate debtor and the creditor which may be set-off against the claim",
                  type: "textarea",
                  rows: 5,
                  placeholder: "Enter details of any mutual dealings",
                }}
                control={control}
                register={register}
                errors={errors}
                setValue={setValue}
                getValues={getValues}
                watch={watch}
              />
            </div>
          )}

          {/* Claim Type Specific Fields */}
          {selectedClaimType && (
            <ClaimTypeFields
              claimType={selectedClaimType}
              control={control}
              register={register}
              errors={errors}
              setValue={setValue}
              getValues={getValues}
              watch={watch}
              trigger={trigger}
            />
          )}
        </div>
      </Collapsible>
    </div>

    {/* Bank Account Details Section */}
    <div className="form-section">
      <Collapsible title="Bank Account Details" defaultOpen={true}>
        <div className="form-grid">
          {bankAccountFields.map((field) =>
            field.component ? (
              <field.component
                key={field.name}
                fieldConfig={field}
                register={register}
                errors={errors}
                setValue={setValue}
                trigger={trigger}
              />
            ) : (
              <DynamicField
                key={field.name}
                fieldConfig={field}
                control={control}
                register={register}
                errors={errors}
                setValue={setValue}
                getValues={getValues}
                watch={watch}
              />
            )
          )}
        </div>
      </Collapsible>
    </div>
  </form>
</FormProvider>
