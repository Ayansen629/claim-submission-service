const handleBookOfRegistrationSubmit = async () => {
  try {
    loaderRef.current?.show();
    
    const formData = methods?.getValues();
    let registrationFormData = {};
    if (registrationFormRef?.current?.getFormData) {
      registrationFormData = registrationFormRef?.current?.getFormData();
    }

    // Create payload with only engine details update
    const payload = {
      ...registrationData,
      engineDetails: {
        ...registrationData?.engineDetails,
        internalCombustionEngineNo: formData?.bookOfRegistration?.engine?.engineNo || "",
        description: formData?.bookOfRegistration?.engine?.description || "",
        noOfCylindersPerSet: formData?.bookOfRegistration?.engine?.cylindersPerSet || "",
        nhp: parseFloat(formData?.bookOfRegistration?.engine?.nhp) || null,
        ihp: parseFloat(formData?.bookOfRegistration?.engine?.ihp) || null,
        propulsionType: formData?.bookOfRegistration?.propulsion?.propulsionType || "",
      },
    };

    const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.VESSEL_SERVICE.CREATE;
    const response = await postData(apiUrl, payload);

    if (response?.status === 200 && response?.data?.responseStatus) {
      toast.success(response?.data?.responseStatus?.message || "Book of Registration saved successfully!");
      return true;
    } else {
      toast.error(response?.data?.responseStatus?.message || "Failed to save Book of Registration.");
      return false;
    }
  } catch (error) {
    console.error("Book of Registration submission error:", error);
    toast.error("Failed to save Book of Registration. Please try again.");
    return false;
  } finally {
    loaderRef.current?.hide();
  }
};
