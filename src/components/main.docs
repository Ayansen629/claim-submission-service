// Updated InputFile.tsx component
import React, { useState, useEffect, useRef } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaCheckCircle } from "react-icons/fa";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
  defaultValue?: string | File;
  autoFocus?: boolean;
  register?: any;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  style = {},
  watch,
  defaultValue,
  autoFocus = false,
  register
}) => {
  const hasError = errors && errors[name];
  const fileInputRef = useRef<HTMLInputElement>(null);

  // Always get the current value from watch (could be File or string)
  let watchedValue = watch ? watch(name) : undefined;
  let fileName = "";
  let fileExtension = "";
  
  useEffect(() => {
    if (autoFocus && fileInputRef.current) {
      fileInputRef.current.focus();
    }
  }, [autoFocus]);

  if (watchedValue instanceof File) {
    // Use the custom originalName if available, otherwise use the actual file name
    fileName = watchedValue.originalName || watchedValue.name;
    if (!fileName.includes('.')) {
      fileExtension = watchedValue.name.substring(watchedValue.name.lastIndexOf('.'));
      fileName = fileName + fileExtension;
    }
  } else if (typeof watchedValue === "string" && watchedValue.trim() !== "") {
    fileName = watchedValue;
  } else if (defaultValue) {
    if (defaultValue instanceof File) {
      fileName = defaultValue.originalName || defaultValue.name;
      if (!fileName.includes('.')) {
        fileExtension = defaultValue.name.substring(defaultValue.name.lastIndexOf('.'));
        fileName = fileName + fileExtension;
      }
    } else if (typeof defaultValue === "string") {
      fileName = defaultValue;
    }
  }

  // Handle file change internally
  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (onChange) {
      onChange(e);
    }
  };

  // Get file icon based on extension
  const getFileIcon = () => {
    if (!fileName || typeof fileName !== 'string') return <FaFile color="#0d6efd" />;
    const extension = fileName.split('.').pop()?.toLowerCase();
    if (extension === 'pdf') return <FaFilePdf color="#dc3545" />;
    if (['jpg', 'jpeg', 'png', 'gif'].includes(extension || '')) return <FaFileImage color="#28a745" />;
    return <FaFile color="#0d6efd" />;
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      <div
        className={`file-upload border rounded p-3 ${hasError ? 'border-danger' : ''}`}
        style={{
          ...style,
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderColor: hasError ? '#dc3545' : '#ced4da',
          borderRadius: '8px',
          transition: 'all 0.3s ease'
        }}
      >
        <div className="d-flex align-items-center">
          <label
            htmlFor={name}
            className={`file-label btn ${hasError ? 'btn-outline-danger' : 'btn-primary'} mb-0 d-inline-flex align-items-center`}
            style={{
              borderRadius: '6px',
              padding: '8px 16px',
              cursor: disabled ? 'not-allowed' : 'pointer',
              boxShadow: '0 2px 5px rgba(0,0,0,0.1)',
              transition: 'all 0.3s ease',
              minWidth: '120px',
              color: 'white!important',
              flexShrink: 0,
              opacity: disabled ? 0.65 : 1
            }}
          >
            <FaUpload className="file-icon me-2" />
            <span className="file-text">Choose File</span>
          </label>
          <div
            className={`file-name-container ms-3 flex-grow-1 border rounded px-3 py-2 ${fileName ? 'bg-light-success' : 'bg-light'} d-flex align-items-center ${hasError ? 'border-danger' : fileName ? 'border-success' : ''}`}
            style={{
              backgroundColor: fileName ? '#f0f9f0' : '#f8f9fa',
              overflow: 'hidden'
            }}
          >
            {fileName ? (
              <>
                <FaCheckCircle className="text-success me-2 flex-shrink-0" />
                <div className="overflow-hidden">
                  <span className="text-success fw-bold" style={{ fontSize: '0.8rem' }}>Selected File:</span>
                  <div className="d-flex align-items-center">
                    <span className="file-icon-preview me-2 flex-shrink-0">{getFileIcon()}</span>
                    <span className="text-dark fw-semibold" style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                      {fileName}
                    </span>
                  </div>
                </div>
              </>
            ) : (
              <span className="text-muted">No file chosen</span>
            )}
          </div>
        </div>
        <input
          ref={fileInputRef}
          type="file"
          id={name}
          {...register}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="file-input d-none"
        />
      </div>
      <Form.Text className="text-muted small mt-1">
        Upload PDF, JPG or PNG file (Max size: 2MB)
      </Form.Text>
      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
