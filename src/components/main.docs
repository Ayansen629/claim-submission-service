import React from 'react';
import DatePicker from 'react-datepicker';
import { format, isToday, isSameDay, parseISO } from 'date-fns';
import { BsCalendarEvent } from 'react-icons/bs';
import 'react-datepicker/dist/react-datepicker.css';
import './SurveyTrackerCard.css';

const SurveyTrackerCard = ({ events, color = "#6f42c1" }) => {
  const today = new Date();
  
  const renderDayContents = (day, date) => {
    const dayEvents = events.filter(event => 
      isSameDay(parseISO(event.start), date)
    );
    const isCurrentDay = isToday(date);
    
    return (
      <div className={`day-container ${isCurrentDay ? 'today' : ''}`}>
        <div className="day-number">{format(date, 'd')}</div>
        {dayEvents.length > 0 && (
          <div className="event-indicators">
            {dayEvents.map((event, i) => (
              <div 
                key={i} 
                className="event-indicator" 
                style={{ backgroundColor: event.color || color }}
              />
            ))}
          </div>
        )}
      </div>
    );
  };

  return (
    <div className="status-card survey-tracker-card" style={{ borderLeft: `4px solid ${color || "#6f42c1"}` }}>
      <div className="status-card-content">
        <div className="card-header-wrapper">
          <div className="icon-wrapper" style={{ backgroundColor: `${color || "#6f42c1"}20`, color: color || "#6f42c1" }}>
            <BsCalendarEvent size={24} />
          </div>
          <div className="card-header-text">
            <div className="value">{events.length}</div>
            <div className="title">Survey Tracker</div>
            <div className="subtitle">Upcoming surveys</div>
          </div>
        </div>
        <div className="calendar-wrapper">
          <DatePicker
            inline
            selected={today}
            renderDayContents={renderDayContents}
            calendarClassName="survey-calendar"
          />
        </div>
      </div>
    </div>
  );
};

export default SurveyTrackerCard;
////////////
.survey-tracker-card {
  grid-column: span 2;
}

.survey-tracker-card .status-card-content {
  padding: 15px;
}

.card-header-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.card-header-text {
  margin-left: 12px;
}

.calendar-wrapper {
  margin-top: 5px;
  width: 100%;
}

.survey-calendar {
  width: 100% !important;
  font-family: inherit !important;
  border: none !important;
  background: transparent !important;
}

.survey-calendar .react-datepicker__month-container {
  width: 100%;
  float: none;
}

.survey-calendar .react-datepicker__header {
  background-color: transparent;
  border-bottom: none;
  padding: 0;
}

.survey-calendar .react-datepicker__day-names {
  display: flex;
  justify-content: space-around;
  margin: 0;
  padding: 5px 0;
}

.survey-calendar .react-datepicker__day-name {
  color: #666;
  font-weight: 500;
  font-size: 0.65rem;
  margin: 0;
  width: 1.8em;
  line-height: 1.8em;
}

.survey-calendar .react-datepicker__month {
  margin: 0;
}

.survey-calendar .react-datepicker__week {
  display: flex;
  justify-content: space-around;
}

.survey-calendar .react-datepicker__day {
  margin: 0;
  width: 1.8em;
  line-height: 1.8em;
  font-size: 0.7rem;
  color: #333;
}

.survey-calendar .react-datepicker__day--selected,
.survey-calendar .react-datepicker__day--keyboard-selected {
  background-color: #6f42c1;
  color: white;
}

.survey-calendar .react-datepicker__day--today {
  font-weight: bold;
  color: #0d6efd;
}

.survey-calendar .react-datepicker__navigation {
  top: 0.3em;
  width: 1.5em;
  height: 1.5em;
}

.day-container {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.day-number {
  font-size: 0.7rem;
}

.event-indicators {
  position: absolute;
  bottom: 0;
  display: flex;
  gap: 1px;
}

.event-indicator {
  width: 3px;
  height: 3px;
  border-radius: 50%;
}

/* Adjust calendar size to fit card */
.react-datepicker {
  font-size: 0.8rem !important;
}

.react-datepicker__month-container {
  padding: 0 5px 5px 5px !important;
}
