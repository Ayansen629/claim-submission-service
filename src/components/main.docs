import React from "react";
import { Card, Row, Col, Button, ButtonGroup } from "react-bootstrap";
import { useForm } from "react-hook-form";
import InputSelect from "../../../common/InputSelect.tsx";
import InputText from "../../../common/InputText.tsx";
import { headerStyle } from "../../../../utils/constants.ts";

const UserRegFilter = ({ onFilterSubmit }) => {
  const {
    register,
    handleSubmit,
    reset,
    watch,
    setValue,
    formState: { errors },
  } = useForm();

  const applicationModule = watch("applicationModule");
  const applicationType = watch("applicationType");
  const applicationStatus = watch("applicationStatus");

  const onSubmitFilterForm = (data) => {
    onFilterSubmit(data);
  };

  const handleSelectChange = (name: string, value: string) => {
    setValue(name, value);
  };

  return (
    <Card className="mb-4 filter-card">
      <Card.Header className="dashboard-card-header" style={headerStyle}>
        <h5>Filter Applications</h5>
      </Card.Header>
      <Card.Body>
        <form onSubmit={handleSubmit(onSubmitFilterForm)}>
          {/* First Row of Filters (same as before) */}
          <Row>
            {/* ... existing filter columns ... */}
          </Row>

          {/* Second Row with Date Inputs and Buttons */}
          <Row className="mt-3">
            <Col xs={12} md={4} lg={3} className="mb-3">
              <InputText
                type="date"
                name="fromDate"
                label="From Date"
                register={register("fromDate")}
                errors={errors}
              />
            </Col>

            <Col xs={12} md={4} lg={3} className="mb-3">
              <InputText
                type="date"
                name="toDate"
                label="To Date"
                register={register("toDate")}
                errors={errors}
              />
            </Col>

            <Col xs={12} md={4} lg={3} className="mb-3">
              <InputText
                type="text"
                name="phoneNumber"
                label="Phone Number"
                maxLength={10}
                placeholder="Enter phone number"
                register={register("phoneNumber", {
                  pattern: {
                    value: /^[0-9]*$/,
                    message: "Only numbers are allowed",
                  },
                })}
                errors={errors}
              />
            </Col>

            <Col xs={12} lg={3} className="d-flex align-items-end">
              <ButtonGroup className="w-100">
                <Button 
                  variant="primary" 
                  type="submit" 
                  className="flex-grow-1"
                >
                  Apply Filters
                </Button>
                <Button
                  variant="outline-secondary"
                  type="button"
                  className="flex-grow-1"
                  onClick={() => {
                    reset({
                      applicationModule: "",
                      applicationType: "",
                      applicationStatus: "",
                      applicationNumber: "",
                      fromDate: "",
                      toDate: "",
                      phoneNumber: ""
                    });
                    onFilterSubmit({});
                  }}
                >
                  Reset
                </Button>
              </ButtonGroup>
            </Col>
          </Row>
        </form>
      </Card.Body>
    </Card>
  );
};

export default UserRegFilter;
