import React, { Component, useContext ,useEffect} from "react";
import Stepper from "./Stepper";
import StepFirst from "./StepFirst";
import StepSecond from "./StepSecond";
import { UserContext } from "../../context/UserContext"; 
import "./MainForm.css";
import StepThird from "./StepThird";
import { useParams } from "react-router-dom";

import ReviewStep from "./ReviewStep";

const CHECKOUT_STEPS = [
  {
    name: "Step 1",
    Component: StepFirst,
   
  },
  {
    name: "Step 2",
    Component: StepSecond,

  },
  {
    name: "Step 3",
    Component: StepThird,
   
  },
  {
    name : "Review & Submit",
    Component: ReviewStep,
  },
];

const ClaimForm = () => {
  const { userData, formType } = useContext(UserContext);
  const { claimantType, claimantCategoryType } = userData || {};
  console.log("Claimant Category Type:", claimantType, claimantCategoryType);

  const { id } = useParams(); // Get claim ID from URL

  useEffect(() => {
    console.log("Claim ID:", id);
    // Fetch claim details based on ID if needed
  }, [id]);

  // Function to determine the form title dynamically
  const getFormTitle = () => {
    // const { userData, formType } = useContext(UserContext); // Use formType from context
    // const { claimantType, claimantCategoryType } = userData || {};
  
    if (formType === "Insolvency") {
      if (claimantType === "Financial Creditors") {
        if (
          claimantCategoryType === "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)" ||
          claimantCategoryType === "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)" ||
          claimantCategoryType === "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)"
        ) {
          return "PROOF OF CLAIM BY CREDITORS (FORM C)";
        } else if (claimantCategoryType === "Unsecured Financial Creditors in Class of Creditors (Homebuyers)") {
          return "PROOF OF CLAIM BY CREDITORS (FORM CA)";
        }
      } else if (claimantType === "Operational Creditors") {
        return "PROOF OF CLAIM BY CREDITORS (FORM B)";
      } else if (claimantType === "Employees and Workmen") {
        return "PROOF OF CLAIM BY CREDITORS (FORM D)";
      } else if (claimantType === "Employees and Workmen – Through Authorised Representative") {
        return "PROOF OF CLAIM BY CREDITORS (FORM E)";
      } else if (claimantType === "Other Creditors (other than financial and operational creditors)") {
        return "PROOF OF CLAIM BY CREDITORS (FORM F)";
      }
    } else if (formType === "Liquidation") {
      if (claimantType === "Financial Creditors") {
        if (
          claimantCategoryType === "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)" ||
          claimantCategoryType === "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)" ||
          claimantCategoryType === "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)" ||
          claimantCategoryType === "Unsecured Financial Creditors in Class of Creditors (Homebuyers)"
        ) {
          return "PROOF OF CLAIM BY CREDITORS (FORM D)";
        }
      } else if (claimantType === "Operational Creditors") {
        return "PROOF OF CLAIM BY CREDITORS (FORM C)";
      } else if (claimantType === "Employees and Workmen") {
        return "PROOF OF CLAIM BY CREDITORS (FORM E)";
      } else if (claimantType === "Employees and Workmen – Through Authorised Representative") {
        return "PROOF OF CLAIM BY CREDITORS (FORM F)";
      } else if (claimantType === "Other Creditors (other than financial and operational creditors)") {
        return "PROOF OF CLAIM BY CREDITORS (FORM G)";
      }
    }
  
    return "PROOF OF CLAIM BY CREDITORS"; // Default title if no form is matched
  };
  return (
    <div className="main-content">
      <div className="container">
        <div className="row justify-content-center">
          <div className="col-12">
            <div className="card shadow-lg">
              <div className="card-body">
                <h2 className="text-center mb-5 text-formcol">{getFormTitle()}</h2>
                <Stepper stepsConfig={CHECKOUT_STEPS} />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default ClaimForm;







import { createContext, useState, useEffect } from "react";

export const UserContext = createContext(null);

export const UserProvider = ({ children }) => {
  const [userData, setUserData] = useState(() => {
    const storedData = localStorage.getItem("userFormData");
    return storedData ? JSON.parse(storedData) : null;
  });

  const [formType, setFormType] = useState(() => {
    const storedFormType = localStorage.getItem("formType");
    return storedFormType ? storedFormType : "Insolvency"; // Default to "Insolvency" if not found
  });

  // Sync userData with localStorage when it changes
  useEffect(() => {
    if (userData) {
      localStorage.setItem("userFormData", JSON.stringify(userData));
    } else {
      localStorage.removeItem("userFormData");
    }
  }, [userData]);

  // Sync formType with localStorage when it changes
  useEffect(() => {
    localStorage.setItem("formType", formType);
  }, [formType]);

  // Function to update formType
  const updateFormType = (type) => {
    setFormType(type);
  };

  return (
    <UserContext.Provider value={{ userData, setUserData, formType, updateFormType }}>
      {children}
    </UserContext.Provider>
  );
};
