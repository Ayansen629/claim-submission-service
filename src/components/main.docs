  const fetchDashboardData = async () => {
    try {
      setIsLoading(true);
      
      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails
      
      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }

      const payload = {
        userInfo: userInfo,
        filterCriteria: {}
      };

      const URL =
          process.env.REACT_APP_APPLICATION_SERVICE +
          URLS_ENDPOINT.APP_SERVICES.DASHBOARD_LIST;

     

      const response = await postData(URL, payload);
      console.log(response,"responselist");
      

      if (response?.data.status === "200" && response?.data.dashboardApplications?.length > 0) {
        // Format the data to match your table structure
        const formattedData = response.data.dashboardApplications.map((item, index) => ({
          ...item,
          id: item.uuid, 
          slNo: index + 1,
          claimNumber: item.applicationNumber,
          claimant:item.creditorName,
          // status:item.applicationStatus ||"No Status Found",
          status: item.applicationStatus,
         
          amount:`${item.totalClaimAmount}` || "0.00",
          dateSubmitted: item.submittedDate || new Date().toLocaleDateString(),
          action: ["view"],
          originalData: item, 
        }));
             if (userFormData?.userType === "CRP") {
        formattedData.forEach((item) => {
          item.claimNumber = (
            <a href={`/apply-claim/${item.id}`} style={{ color: "#269ccc", textDecoration: "underline" }}>
              {item.claimNumber}
            </a>
          );
        });
      }
        
        setRowData(formattedData);
      } else {
        setRowData([]);
        toast.info("No applications found", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching dashboard data:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setRowData([]);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchDashboardData();
  }, []);
  

  return (
    <div className="container-fluid mt-5" style={{ paddingLeft: 0, paddingRight: 0 }}>
      {!isLoading ? (
        <>
          <h3 className="mb-2 text-center">Claim Submission Service</h3>
          <br />
          <div className="row mb-3 align-items-center">
            <div className="col-12 col-md-4 d-flex justify-content-md-end justify-content-center gap-2 ms-auto">
