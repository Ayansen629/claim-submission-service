import React, { useState, useEffect } from "react";
import { Row, Col, Form, Button } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile";
import InputText from "../../../common/InputText.tsx";

const Documents = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  const [workOrderFiles, setWorkOrderFiles] = useState([{ id: 1 }]);
  const [drawingsFiles, setDrawingsFiles] = useState([{ id: 1 }]);
  
  const {
    register,
    watch,
    setValue,
    clearErrors,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  const addFileInput = (type) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      const newId = workOrderFiles.length > 0 ? Math.max(...workOrderFiles.map(f => f.id)) + 1 : 1;
      setWorkOrderFiles([...workOrderFiles, { id: newId }]);
    } else if (type === 'drawings') {
      const newId = drawingsFiles.length > 0 ? Math.max(...drawingsFiles.map(f => f.id)) + 1 : 1;
      setDrawingsFiles([...drawingsFiles, { id: newId }]);
    }
  };

  const removeFileInput = (type, id) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      setWorkOrderFiles(workOrderFiles.filter(file => file.id !== id));
      setValue(`workOrder_file_${id}`, null);
      setValue(`workOrder_desc_${id}`, "");
      clearErrors([`workOrder_file_${id}`, `workOrder_desc_${id}`]);
    } else if (type === 'drawings') {
      setDrawingsFiles(drawingsFiles.filter(file => file.id !== id));
      setValue(`drawings_file_${id}`, null);
      setValue(`drawings_desc_${id}`, "");
      clearErrors([`drawings_file_${id}`, `drawings_desc_${id}`]);
    }
  };

  const handleFileChange = (fieldName, file) => {
    if (file) {
      const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
      const customFileName = `${fieldName}${extension}`;
      file.originalName = customFileName;
      
      setValue(fieldName, file, { shouldValidate: true });
      setFormData(prev => ({
        ...prev,
        [fieldName]: file
      }));

      if (errors[fieldName]) {
        clearErrors(fieldName);
      }

      // Validate file type and size
      const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
      if (!validTypes.includes(file.type)) {
        setError(fieldName, {
          type: 'manual',
          message: 'Only PDF, JPG or PNG files are allowed'
        });
      } else if (file.size > 2 * 1024 * 1024) {
        setError(fieldName, {
          type: 'manual',
          message: 'File size should not exceed 2MB'
        });
      }
    }
  };

  return (
    <div>
      <Collapsible title={t("Documents")} openStat={true}>
        <Row className="gy-4" style={{ padding: "1rem" }}>
          {/* Work Order Section */}
          <Col md={6}>
            <div className="mb-4">
              <div className="d-flex justify-content-between align-items-center mb-2">
                <h6 className="mb-0">{t("Work Order")}</h6>
                {!viewMode && (
                  <Button
                    variant="primary"
                    size="sm"
                    onClick={() => addFileInput('workOrder')}
                    style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
                  >
                    + Add
                  </Button>
                )}
              </div>
              {workOrderFiles.map((fileInput, idx) => (
                <Row key={fileInput.id} className="mb-2 align-items-center">
                  <Col md={8}>
                    <InputFile
                      label=""
                      name={`workOrder_file_${fileInput.id}`}
                      register={register(`workOrder_file_${fileInput.id}`)}
                      errors={errors}
                      onChange={(e) => {
                        if (viewMode) return;
                        if (e.target.files && e.target.files[0]) {
                          handleFileChange(`workOrder_file_${fileInput.id}`, e.target.files[0]);
                        }
                      }}
                      disabled={viewMode}
                      watch={watch}
                      defaultValue={formData[`workOrder_file_${fileInput.id}`]}
                      clearErrors={clearErrors}
                    />
                  </Col>
                  <Col md={4}>
                    <InputText
                      label=""
                      name={`workOrder_desc_${fileInput.id}`}
                      placeholder={t("Description of File")}
                      register={register(`workOrder_desc_${fileInput.id}`)}
                      errors={errors}
                      onChange={() => !viewMode && clearErrors(`workOrder_desc_${fileInput.id}`)}
                      disabled={viewMode}
                    />
                  </Col>
                  {workOrderFiles.length > 1 && !viewMode && (
                    <Col md={12}>
                      <Button
                        variant="outline-danger"
                        size="sm"
                        onClick={() => removeFileInput('workOrder', fileInput.id)}
                        className="mt-2"
                      >
                        Remove
                      </Button>
                    </Col>
                  )}
                </Row>
              ))}
            </div>
          </Col>

          {/* Drawings Section */}
          <Col md={6}>
            <div className="mb-4">
              <div className="d-flex justify-content-between align-items-center mb-2">
                <h6 className="mb-0">{t("Drawings")}</h6>
                {!viewMode && (
                  <Button
                    variant="primary"
                    size="sm"
                    onClick={() => addFileInput('drawings')}
                    style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
                  >
                    + Add
                  </Button>
                )}
              </div>
              {drawingsFiles.map((fileInput, idx) => (
                <Row key={fileInput.id} className="mb-2 align-items-center">
                  <Col md={8}>
                    <InputFile
                      label=""
                      name={`drawings_file_${fileInput.id}`}
                      register={register(`drawings_file_${fileInput.id}`)}
                      errors={errors}
                      onChange={(e) => {
                        if (viewMode) return;
                        if (e.target.files && e.target.files[0]) {
                          handleFileChange(`drawings_file_${fileInput.id}`, e.target.files[0]);
                        }
                      }}
                      disabled={viewMode}
                      watch={watch}
                      defaultValue={formData[`drawings_file_${fileInput.id}`]}
                      clearErrors={clearErrors}
                    />
                  </Col>
                  <Col md={4}>
                    <InputText
                      label=""
                      name={`drawings_desc_${fileInput.id}`}
                      placeholder={t("Description of File")}
                      register={register(`drawings_desc_${fileInput.id}`)}
                      errors={errors}
                      onChange={() => !viewMode && clearErrors(`drawings_desc_${fileInput.id}`)}
                      disabled={viewMode}
                    />
                  </Col>
                  {drawingsFiles.length > 1 && !viewMode && (
                    <Col md={12}>
                      <Button
                        variant="outline-danger"
                        size="sm"
                        onClick={() => removeFileInput('drawings', fileInput.id)}
                        className="mt-2"
                      >
                        Remove
                      </Button>
                    </Col>
                  )}
                </Row>
              ))}
            </div>
          </Col>

          {/* Tonnage Booklets */}
          <Col md={6}>
            <InputFile
              label={t("Tonnage Booklets")}
              name="tonnageBooklets"
              required
              register={register("tonnageBooklets", { 
                required: t("Tonnage Booklets are required") 
              })}
              errors={errors}
              onChange={(e) => {
                if (viewMode) return;
                if (e.target.files && e.target.files[0]) {
                  handleFileChange("tonnageBooklets", e.target.files[0]);
                }
              }}
              disabled={viewMode}
              watch={watch}
              defaultValue={formData["tonnageBooklets"]}
              clearErrors={clearErrors}
            />
          </Col>

          {/* Stability Booklets */}
          <Col md={6}>
            <InputFile
              label={t("Stability Booklets")}
              name="stabilityBooklets"
              required
              register={register("stabilityBooklets", { 
                required: t("Stability Booklets are required") 
              })}
              errors={errors}
              onChange={(e) => {
                if (viewMode) return;
                if (e.target.files && e.target.files[0]) {
                  handleFileChange("stabilityBooklets", e.target.files[0]);
                }
              }}
              disabled={viewMode}
              watch={watch}
              defaultValue={formData["stabilityBooklets"]}
              clearErrors={clearErrors}
            />
          </Col>

          {/* Authorization Letter (if needed) */}
          {constructedBy === "2" && (
            <Col md={6}>
              <InputFile
                label={t("Authorisation Letter")}
                name="authLetter"
                required
                register={register("authLetter", {
                  required: constructedBy === "2" && t("Authorization Letter is required"),
                })}
                errors={errors}
                onChange={(e) => {
                  if (viewMode) return;
                  if (e.target.files && e.target.files[0]) {
                    handleFileChange("authLetter", e.target.files[0]);
                  }
                }}
                disabled={viewMode}
                watch={watch}
                defaultValue={formData["authLetter"]}
                clearErrors={clearErrors}
              />
            </Col>
          )}

          {/* Terms and Conditions */}
          <Col md={12}>
            <div className="mb-3">
              <div className="d-flex align-items-start">
                <input
                  type="checkbox"
                  id="termsAccepted"
                  className="me-2 mt-1"
                  {...register("termsAccepted", {
                    required: t("You must accept the terms and conditions"),
                  })}
                  disabled={viewMode}
                />
                <div>
                  <label
                    htmlFor="termsAccepted"
                    className="mb-0"
                    style={{ fontWeight: 500, color: "#333", cursor: "pointer" }}
                  >
                    {t("I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.")}
                  </label>
                  {errors.termsAccepted && (
                    <div className="text-danger small mt-1" style={{ display: "block" }}>
                      {errors.termsAccepted.message}
                    </div>
                  )}
                </div>
              </div>
            </div>
          </Col>
        </Row>
      </Collapsible>
    </div>
  );
};

export default Documents;
