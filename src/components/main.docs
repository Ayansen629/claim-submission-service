// InputFile.jsx
import React, { useState } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFileAlt, FaFilePdf, FaFileImage } from "react-icons/fa";

const InputFile = ({
  label,
  required,
  name,
  register,
  errors,
  onChange,
  className = "",
  accept,
  disabled,
  style = {}
}) => {
  const [fileName, setFileName] = useState("");
  const [isFocused, setIsFocused] = useState(false);
  
  const hasError = errors?.[name];
  
  const handleChange = (e) => {
    const file = e.target.files?.[0];
    if (file) {
      setFileName(file.name);
      if (onChange) onChange(e);
    }
  };
  
  const getFileIcon = () => {
    if (!fileName) return <FaFile />;
    
    if (fileName.endsWith('.pdf')) return <FaFilePdf color="#dc3545" />;
    if (fileName.match(/\.(jpg|jpeg|png|gif)$/i)) return <FaFileImage color="#0077b6" />;
    return <FaFileAlt color="#6c757d" />;
  };
  
  const containerStyle = {
    borderRadius: '8px',
    border: `1px solid ${hasError ? '#dc3545' : isFocused ? '#0077b6' : '#dee2e6'}`,
    backgroundColor: hasError ? '#fff8f8' : 'white',
    padding: '15px',
    transition: 'all 0.2s',
    ...style
  };

  return (
    <Form.Group controlId={name} className={`mb-3 ${className}`}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      <div 
        className="file-upload-container" 
        style={containerStyle}
        onFocus={() => setIsFocused(true)}
        onBlur={() => setIsFocused(false)}
      >
        <input
          type="file"
          id={`file-${name}`}
          className="d-none"
          {...register}
          onChange={handleChange}
          accept={accept}
          disabled={disabled}
        />
        
        <div className="d-flex align-items-center">
          <label 
            htmlFor={`file-${name}`} 
            className="btn btn-outline-primary mb-0 d-inline-flex align-items-center"
            style={{ borderRadius: '6px', cursor: 'pointer' }}
          >
            <FaUpload className="me-2" />
            <span>Choose File</span>
          </label>
          
          <div className="ms-3 d-flex align-items-center text-muted">
            {fileName ? (
              <>
                {getFileIcon()}
                <span className="ms-2 text-truncate" style={{ maxWidth: '200px' }}>
                  {fileName}
                </span>
              </>
            ) : (
              <span>No file chosen</span>
            )}
          </div>
        </div>
      </div>
      
      <div className="text-muted small mt-1">
        Upload PDF, JPG or PNG file (Max size: 2MB)
      </div>
      
      {hasError && (
        <Form.Text className="text-danger d-block mt-1">
          {errors[name]?.message || "Please select a valid file"}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;

////////////////////
// InputSelect.jsx
import React, { useState } from "react";
import { Form } from "react-bootstrap";

const InputSelect = ({
  label,
  required,
  name,
  options,
  register,
  errors,
  onChange,
  className = "",
  disabled,
  icon: IconComponent,
  style = {}
}) => {
  const [isFocused, setIsFocused] = useState(false);
  
  const hasError = errors?.[name];
  
  const selectStyle = {
    height: '50px',
    borderRadius: '8px',
    paddingLeft: IconComponent ? '40px' : '12px',
    transition: 'all 0.2s',
    ...style,
    borderColor: hasError ? '#dc3545' : isFocused ? '#0077b6' : '#ced4da',
    backgroundColor: hasError ? '#fff8f8' : 'white'
  };
  
  const iconContainerStyle = {
    position: 'absolute',
    left: '15px',
    top: '50%',
    transform: 'translateY(-50%)',
    zIndex: 4,
    pointerEvents: 'none'
  };

  return (
    <Form.Group className={`mb-3 position-relative ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      {IconComponent && (
        <div style={iconContainerStyle}>
          <IconComponent size={18} color={hasError ? "#dc3545" : "#387AD4"} />
        </div>
      )}
      
      <Form.Select
        {...register}
        className={hasError ? 'is-invalid' : ''}
        disabled={disabled}
        style={selectStyle}
        onChange={(e) => {
          if (onChange) onChange(e);
          if (register?.onChange) register.onChange(e);
        }}
        onFocus={() => setIsFocused(true)}
        onBlur={(e) => {
          setIsFocused(false);
          if (register?.onBlur) register.onBlur(e);
        }}
      >
        {options.map((option, idx) => (
          <option key={idx} value={option.value}>
            {option.label}
          </option>
        ))}
      </Form.Select>
      
      {hasError && (
        <Form.Text className="text-danger d-block mt-1">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;
///////////
// InputText.tsx
import React, { useState } from "react";
import { Form, InputGroup, OverlayTrigger, Tooltip } from "react-bootstrap";
import { FaEye, FaEyeSlash } from "react-icons/fa";
import classNames from "classnames";

interface InputTextProps {
  label: string;
  required?: boolean;
  name: string;
  type?: string;
  placeholder?: string;
  register?: any;
  disabled?: boolean;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  maxlength?: number;
  readOnly?: boolean;
  errors?: Record<string, { message?: string }>;
  className?: string;
  onKeyDown?: (e: React.KeyboardEvent<HTMLInputElement>) => void;
  icon?: React.ElementType;
  description?: string;
  style?: React.CSSProperties;
}

const InputText: React.FC<InputTextProps> = ({
  label,
  required,
  name,
  type = "text",
  placeholder,
  register,
  disabled,
  onChange,
  maxlength,
  readOnly,
  errors,
  className = "",
  onKeyDown,
  icon: IconComponent,
  description,
  style = {}
}) => {
  const [showPassword, setShowPassword] = useState(false);
  const [isFocused, setIsFocused] = useState(false);

  const isPassword = type === "password";
  const inputType = isPassword ? (showPassword ? "text" : "password") : type;
  const hasError = errors?.[name];

  const togglePasswordVisibility = () => setShowPassword((prev) => !prev);

  const inputClasses = classNames("form-control", {
    "is-invalid": hasError,
    "border-start-0": IconComponent,
    "border-end-0": isPassword,
    "is-valid": isFocused && !hasError && register?.name === name
  });

  const visibilityIcon = showPassword ? (
    <FaEyeSlash size={18} color="#387AD4" />
  ) : (
    <FaEye size={18} color="#387AD4" />
  );

  const combinedStyle = {
    height: '50px',
    borderRadius: '8px',
    transition: 'all 0.2s',
    ...style,
    borderColor: hasError ? '#dc3545' : isFocused ? '#0077b6' : '#ced4da',
    backgroundColor: hasError ? '#fff8f8' : 'white'
  };

  const handleFocus = () => setIsFocused(true);
  const handleBlur = (e) => {
    setIsFocused(false);
    if (register?.onBlur) register.onBlur(e);
  };

  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      {label && (
        <Form.Label className="fw-bold text-dark">
          {label}
          {required && <span className="text-danger ms-1">*</span>}
        </Form.Label>
      )}

      <InputGroup className="has-validation">
        {IconComponent && (
          <InputGroup.Text 
            className={`bg-white ${hasError ? 'border-danger text-danger' : ''}`}
            style={{ borderTopLeftRadius: '8px', borderBottomLeftRadius: '8px' }}
          >
            <IconComponent size={18} color={hasError ? "#dc3545" : "#387AD4"} />
          </InputGroup.Text>
        )}

        <Form.Control
          type={inputType}
          name={name}
          placeholder={placeholder}
          {...register}
          disabled={disabled}
          onChange={(e) => {
            if (onChange) onChange(e);
            if (register?.onChange) register.onChange(e);
          }}
          maxLength={maxlength}
          readOnly={readOnly}
          onKeyDown={onKeyDown}
          min={0}
          className={inputClasses}
          aria-label={label}
          style={combinedStyle}
          onFocus={handleFocus}
          onBlur={handleBlur}
        />

        {isPassword && (
          <OverlayTrigger
            placement="top"
            overlay={
              <Tooltip id={`tooltip-${name}`}>
                {showPassword ? "Hide password" : "Show password"}
              </Tooltip>
            }
          >
            <InputGroup.Text
              className={`bg-white ${hasError ? 'border-danger' : ''}`}
              role="button"
              onClick={togglePasswordVisibility}
              aria-label="Toggle password visibility"
              style={{ cursor: "pointer", borderTopRightRadius: '8px', borderBottomRightRadius: '8px' }}
            >
              {visibilityIcon}
            </InputGroup.Text>
          </OverlayTrigger>
        )}
      </InputGroup>

      {description && (
        <Form.Text style={{ color: "#5A67D8" }} className="d-block mt-1">
          {description}
        </Form.Text>
      )}

      {hasError?.message && (
        <Form.Text className="text-danger d-block mt-1">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputText;
//////////////
// Updated DynamicField component
const DynamicField = ({ field }) => {
  if (field.showIf && !field.showIf()) return null;

  switch(field.type) {
    case 'select':
      return (
        <InputSelect
          label={field.label}
          required={field.required}
          name={field.name}
          options={field.options}
          register={register(field.name, {
            ...field.validation,
            onChange: (e) => {
              if (field.onChange) field.onChange(e);
              if (e.target.value) clearErrors(field.name);
            }
          })}
          errors={errors}
          disabled={field.readOnly}
          icon={field.icon}
          className="mb-4"
        />
      );
    
    case 'file':
      return (
        <InputFile
          label={field.label}
          required={field.required}
          name={field.name}
          register={register(field.name, field.validation)}
          errors={errors}
          onChange={(e) => {
            if (e.target.files[0]) {
              setValue(field.name, e.target.files[0].name);
              clearErrors(field.name);
            }
          }}
          className="mb-4"
        />
      );
    
    default: // text, email, etc.
      return (
        <InputText
          label={field.label}
          required={field.required}
          name={field.name}
          type={field.type}
          placeholder={field.placeholder}
          register={register(field.name, {
            ...field.validation,
            onChange: (e) => {
              if (field.onChange) field.onChange(e);
              
              // For email validation
              if (field.type === 'email' && field.validation?.pattern) {
                if (field.validation.pattern.value.test(e.target.value)) {
                  clearErrors(field.name);
                }
              } 
              // For other validations
              else if (e.target.value && field.required) {
                clearErrors(field.name);
              }
            }
          })}
          errors={errors}
          readOnly={field.readOnly}
          icon={field.icon}
          className="mb-4"
        />
      );
  }
};
