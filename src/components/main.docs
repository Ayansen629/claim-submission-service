// Fix the useState initialization in InputFile.tsx
const [fileName, setFileName] = useState<string>(
  defaultValue && typeof defaultValue === 'string' && defaultValue.trim() !== "" 
    ? defaultValue 
    : ""
);

// Also fix the useEffect check
useEffect(() => {
  // Check if there's a value from watch
  if (watch) {
    const value = watch(name);
    if (value && typeof value === 'string' && value.trim() !== "") {
      console.log(`InputFile ${name} watch value:`, value);
      setFileName(value);
    }
  }
  
  // Also check defaultValue on mount
  if (defaultValue && typeof defaultValue === 'string' && defaultValue.trim() !== "" && !fileName) {
    setFileName(defaultValue);
  }
}, [watch, name, defaultValue]);
