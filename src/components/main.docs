import InputSelect from "../../../common/InputSelect.tsx";
import InputText from "../../../common/InputText.tsx";
import EmployeeRegistrationForm from "../../../common/EmployeeRegistrationForm";


const formData = {
  salutation: "",
  nameAsPerAadhar: "",
  userName: "",
  firstName: "",
  middleName: "",
  lastName: "",
  mobileNumber: "",
  aadharNumber: "",
  password: "",
  plainPassword: "",
  active: true,
  isBlocked: false,
  blockedAt: "",
  alternateMobileNumber: "",
  emailId: "",
  gender: "",
  panNumber: "",
  voterIdNumber: "",
  drivingLicense: "",
  address: "",
  gurdianName: "",
  gurdianRelation: "",
  type: "",
  dob: "",
  ageOnDate: "",
  bloodGroup: "",
  photo: "",
  identificationMark: "",
  nationality: "",
  educationQualification: "",
  individualTypeDesignation: "",
  panAttachmentUrl: "",
  passwordExpiryDate: "",
  rolesCode: "",
  districtName: "",
  blockName: "",
  panchayatName: "",
  projectCode: "",
  projectName: "",
  ifscCode: "",
  bankName: "",
  bankType: "",
};

type EmployeeSearchFormData = {
  empId?: string;
  empName?: string;
  designation?: string;
  status?: string;
  phoneNumber?: string;
};

const UserManagement = () => {
  const { t } = useTranslation();
  let navigate = useNavigate();
  const [rowData, setRowData] = useState([]);
  const [modal, setModal] = useState(false);
  const [modalAction, setModalAction] = useState("");
  const [userFormData, setuserFormData] = useState(formData);
  const [modalTitle, setModalTitle] = useState(t("Add Employee"));
  const [isLoading, setIsLoading] = useState(false);

  const {
    register,
    handleSubmit,
    watch,
    reset,
    setValue,
    formState: { errors },
  } = useForm<EmployeeSearchFormData>();

  const methods = useForm({
    defaultValues: {
      personal: {
        firstName: "",
        lastName: "",
        email: "",
        phoneNumber: "",
        gender: "",
        dob: ""
      },
      address: {
        line1: "",
        line2: "",
        pin: "",
        district: "",
        state: "",
        country: ""
      },
      educationDetails: [{
        qualification: "",
        stream: "",
        yearOfPassing: ""
      }],
      professional: {
        appointmentDate: "",
        employeeType: "",
        employeeStatus: "",
        designation: "",
        department: "",
        section: "",
        roles: ""
      },
      documents: {
        addressProof: null,
        identityProof: null,
        appointmentLetter: null
      }
    }
  });

  useEffect(() => {
    setuserFormData([]);
    getUserDetails();
  }, []);

  const columns = USER_REGIS_MASTER.USER_INFO_COLUMNS;
  const userMockData = USER_REGIS_MASTER.MOCK_USER_DATA;

  const getUserDetails = async () => {
    setIsLoading(true);
    try {
      // Use the mock data from USER_REGIS_MASTER
      setTimeout(() => {
        setRowData(userMockData);
        setIsLoading(false);
      }, 500);
    } catch (error) {
      console.error("Error fetching user details:", error);
      toast.error(t("Error fetching user details"));
      setIsLoading(false);
    }
  };

  const handleRowClick = (e) => {};

  const handleBtnClick = () => {
    // Reset form data before opening modal
    methods.reset({
      personal: {
        firstName: "",
        lastName: "",
        email: "",
        phoneNumber: "",
        gender: "",
        dob: ""
      },
      address: {
        line1: "",
        line2: "",
        pin: "",
        district: "",
        state: "",
        country: ""
      },
      educationDetails: [{
        qualification: "",
        stream: "",
        yearOfPassing: ""
      }],
      professional: {
        appointmentDate: "",
        employeeType: "",
        employeeStatus: "",
        designation: "",
        department: "",
        section: "",
        roles: ""
      },
      documents: {
        addressProof: null,
        identityProof: null,
        appointmentLetter: null
      }
    });
    setModalTitle(t("Add Employee"));
    setModal(true);
  };

  const handleEditRow = (e) => {
    setModalTitle(t("Edit Employee"));
    setuserFormData(e);
    
    // Populate form with existing data
    const { firstName, lastName, email } = e;
    methods.reset({
      personal: {
        firstName,
        lastName,
        email,
        // Add other fields as needed
        phoneNumber: "",
        gender: "",
        dob: ""
      },
      // Add other sections as needed
      address: {
        line1: "",
        line2: "",
        pin: "",
        district: "",
        state: "",
        country: ""
      },
      educationDetails: [{
        qualification: "",
        stream: "",
        yearOfPassing: ""
      }],
      professional: {
        appointmentDate: "",
        employeeType: "",
        employeeStatus: "",
        designation: "",
        department: "",
        section: "",
        roles: ""
      },
      documents: {
        addressProof: null,
        identityProof: null,
        appointmentLetter: null
      }
    });
    
    setModal(true);
  };

  const Toggle = () => {
    setuserFormData(formData);
    setModal(false); // Ensure modal closes
  };

  const onSubmitFilterForm = async (e) => {
    if (e && Object.keys(e).length > 0) {
      console.log("Filter form submitted:", e);
      // Implement filter logic here
    }
  };

 // Update the handleFormSubmit function in UserManagement.jsx
