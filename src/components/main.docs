<Col md={6}>
  {viewMode ? (
    watch("authLetter") && watch("authLetter").name ? (
      <div className="mb-3">
        <label className="form-label fw-bold" style={{ fontSize: "0.9rem" }}>
          {t("Authorization Letter")}
        </label>
        <div className="p-2 p-sm-3 border rounded bg-light">
          <div className="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
            <div className="flex-grow-1 min-width-0">
              <div className="fw-semibold text-primary mb-1" style={{ 
                fontSize: "0.8rem",
                overflow: 'hidden',
                textOverflow: 'ellipsis',
                whiteSpace: 'nowrap'
              }}>
                {watch("authLetter").name}
              </div>
              <small className="text-muted" style={{ fontSize: "0.7rem" }}>
                {((watch("authLetter").size || 0) / 1024 / 1024).toFixed(1)} MB
              </small>
            </div>
            <button
              type="button"
              className="btn btn-outline-primary btn-sm d-flex align-items-center flex-shrink-0"
              style={{ fontSize: "0.75rem", padding: "4px 8px" }}
              onClick={() => handleDownload(watch("authLetter").name)}
            >
              <BsDownload size={12} className="me-1" />
              <span>{t("Download")}</span>
            </button>
          </div>
        </div>
      </div>
    ) : (
      <div className="mb-3">
        <label className="form-label fw-bold" style={{ fontSize: "0.9rem" }}>
          {t("Authorization Letter")}
        </label>
        <div className="p-2 p-sm-3 border rounded bg-light text-muted text-center" style={{ fontSize: "0.8rem" }}>
          {t("No file uploaded")}
        </div>
      </div>
    )
  ) : (
    <div className="mb-2">
      <InputFile
        label={t("Authorization Letter")}
        required={true}
        name="authLetter"
        register={register("authLetter", {
          required: t("Authorization Letter is required"),
        })}
        errors={errors}
        onChange={(e) => {
          if (viewMode) return;
          if (e.target.files && e?.target?.files[0]) {
            handleFileChange("authLetter", e.target.files[0]);
          }
        }}
        disabled={viewMode}
        watch={watch}
        defaultValue={watch("authLetter")}
        clearErrors={clearErrors}
        accept=".pdf,.jpg,.jpeg,.png"
      />
    </div>
  )}
</Col>
