import React, { useState, useContext, useEffect } from "react";
import { useForm } from "react-hook-form";
import { useNavigate } from "react-router-dom";
import { toast } from "react-toastify";
import { UserContext } from "../../components/context/UserContext.js";
import "./Login.css";

const LoginPage = () => {
  const {
    register,
    handleSubmit,
    watch,
    formState: { errors },
    reset,
  } = useForm();
  const navigate = useNavigate();
  const { setUserData } = useContext(UserContext);

  const [otpSent, setOtpSent] = useState(false);
  const [otp, setOtp] = useState("");
  const [loading, setLoading] = useState(false);
  const [selectedRadio, setSelectedRadio] = useState("corporateDebtor");

  const username = watch("username");
  const email = watch("email");
  const password = watch("password");
  const userType = watch("userType");
  const financialCreditorType = watch("financialCreditorType");
  const operationalCreditorType = watch("operationalCreditorType");
  const processType = watch("processType");
  const corporateDebtorName = watch("corporateDebtorName");

  useEffect(() => {
    reset({
      username: "",
      email: "",
      password: "",
      userType: "",
      financialCreditorType: "",
      operationalCreditorType: "",
      processType: "",
      corporateDebtorName: "",
    });
    setOtpSent(false);
    setOtp("");
  }, [selectedRadio, reset]);

  const isValidUsername = (username) => /^[6-9]\d{9}$/.test(username);
  const isValidEmail = (email) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

  const isClaimantsFormValid = () => {
    if (selectedRadio === "claimants") {
      return (
        isValidUsername(username) &&
        userType &&
        processType &&
        corporateDebtorName &&
        (userType !== "Financial Creditors" || financialCreditorType) &&
        (userType !== "Operational Creditors" || operationalCreditorType)
      );
    }
    return false;
  };

  const isCorporateDebtorFormValid = () => {
    if (selectedRadio === "corporateDebtor") {
      return isValidEmail(email) && password?.length >= 6 && watch("termsAccepted");
    }
    return false;
  };

  const handleSendOTP = async () => {
    if (!isClaimantsFormValid()) {
      toast.error("Please provide valid details.");
      return;
    }

    setLoading(true);
    setTimeout(() => {
      const payload = {
        userType: "CLM",
        userId: username,
        processType,
        corporateDebtorName,
        claimantType: userType,
        claimantCategoryType: userType === "Financial Creditors" 
          ? financialCreditorType 
          : operationalCreditorType,
        otp: "123456",
      };

      console.log("OTP Payload:", payload);
      toast.success("OTP Sent");
      setOtpSent(true);
      setLoading(false);
    }, 1000);
  };

  const handleVerifyOTP = async (data) => {
    if (!otp) {
      toast.error("Please enter OTP");
      return;
    }
    if (!data.termsAccepted) {
      toast.info("Please accept terms");
      return;
    }

    setLoading(true);
    setTimeout(() => {
      if (otp === "123456") {
        const payload = {
          userType: "CLM",
          userId: username,
          processType,
          corporateDebtorName,
          claimantType: userType,
          claimantCategoryType: userType === "Financial Creditors" 
            ? financialCreditorType 
            : operationalCreditorType,
        };

        setUserData(payload);
        localStorage.setItem("userFormData", JSON.stringify(payload));
        toast.success("Login Successful");
        navigate("/dashboard");
      } else {
        toast.error("Invalid OTP");
      }
      setLoading(false);
    }, 1000);
  };

  const handleCorporateDebtorLogin = async (data) => {
    setLoading(true);
    setTimeout(() => {
      const payload = {
        userType: "CD",
        email: data.email,
      };
      setUserData(payload);
      localStorage.setItem("userFormData", JSON.stringify(payload));
      toast.success("Login Successful");
      navigate("/dashboard");
      setLoading(false);
    }, 1000);
  };

  // Options data
  const processTypeOptions = [
    { value: "CIRP", label: "Corporate Insolvency Resolution Process (CIRP)" },
    { value: "Liquidation", label: "Liquidation" },
    { value: "Voluntary Liquidation", label: "Voluntary Liquidation" },
    { value: "PPIRP", label: "Pre-packaged Insolvency Resolution Process (PPIRP)" },
  ];

  const corporateDebtorOptions = [
    { value: "Jalpower Corporation Limited", label: "Jalpower Corporation Limited" },
    { value: "Neesa Leisure Limited", label: "Neesa Leisure Limited" },
    { value: "Empathy Infra and Engineering Private Limited", label: "Empathy Infra and Engineering Private Limited" },
    { value: "Simpa Energy India Private Limited", label: "Simpa Energy India Private Limited" },
    { value: "Eicher Polaris Private Limited", label: "Eicher Polaris Private Limited" },
  ];

  const claimantsOptions = [
    { value: "Financial Creditors", label: "Financial Creditors" },
    { value: "Operational Creditors", label: "Operational Creditors" },
    { value: "Employees and Workmen", label: "Employees and Workmen" },
    { value: "Employees and Workmen – Through Authorised Representative", label: "Employees and Workmen – Through Authorised Representative" },
    { value: "Other Creditors (other than financial and operational creditors)", label: "Other Creditors (other than financial and operational creditors)" },
  ];

  const financialCreditorOptions = [
    { value: "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)", label: "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)" },
    { value: "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)", label: "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)" },
    { value: "Unsecured Financial Creditors in Class of Creditors (Homebuyers)", label: "Unsecured Financial Creditors in Class of Creditors (Homebuyers)" },
    { value: "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)", label: "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)" },
  ];

  const operationalCreditorOptions = [
    { value: "Operational Creditors – (Other than Govt Authorities)", label: "Operational Creditors – (Other than Govt Authorities)" },
    { value: "Operational Creditors – Govt Authorities", label: "Operational Creditors – Govt Authorities" },
  ];

  return (
    <div className="login-page">
      <div className="login-container">
        <div className="Login-header">
          <div className="login-text">LOG IN</div>
        </div>
        
        <div className="radio-options">
          <div className="radio-op">
            <input
              type="radio"
              id="corporateDebtor"
              name="radioGroup"
              checked={selectedRadio === "corporateDebtor"}
              onChange={() => setSelectedRadio("corporateDebtor")}
            />
            <label htmlFor="corporateDebtor">Corporate Debtor</label>
          </div>
          <div className="radio-op">
            <input
              type="radio"
              id="claimants"
              name="radioGroup"
              checked={selectedRadio === "claimants"}
              onChange={() => setSelectedRadio("claimants")}
            />
            <label htmlFor="claimants">Claimants</label>
          </div>
        </div>

        <div className="login-form">
          {selectedRadio === "claimants" ? (
            <form onSubmit={handleSubmit(handleVerifyOTP)}>
              {/* Claimants form fields */}
              <div className="form-group">
                <label>Mobile Number</label>
                <input
                  type="text"
                  {...register("username", {
                    required: "Mobile number is required",
                    pattern: {
                      value: /^[6-9]\d{9}$/,
                      message: "Invalid mobile number"
                    }
                  })}
                  placeholder="Enter 10-digit mobile number"
                />
                {errors.username && <p className="error">{errors.username.message}</p>}
              </div>

              <div className="form-group">
                <label>Process Type</label>
                <select
                  {...register("processType", { required: "Process type is required" })}
                >
                  <option value="">Select Process Type</option>
                  {processTypeOptions.map(opt => (
                    <option key={opt.value} value={opt.value}>{opt.label}</option>
                  ))}
                </select>
                {errors.processType && <p className="error">{errors.processType.message}</p>}
              </div>

              <div className="form-group">
                <label>Corporate Debtor Name</label>
                <select
                  {...register("corporateDebtorName", { required: "Corporate Debtor name is required" })}
                >
                  <option value="">Select Corporate Debtor</option>
                  {corporateDebtorOptions.map(opt => (
                    <option key={opt.value} value={opt.value}>{opt.label}</option>
                  ))}
                </select>
                {errors.corporateDebtorName && <p className="error">{errors.corporateDebtorName.message}</p>}
              </div>

              <div className="form-group">
                <label>Claimant Type</label>
                <select
                  {...register("userType", { required: "Claimant type is required" })}
                >
                  <option value="">Select Claimant Type</option>
                  {claimantsOptions.map(opt => (
                    <option key={opt.value} value={opt.value}>{opt.label}</option>
                  ))}
                </select>
                {errors.userType && <p className="error">{errors.userType.message}</p>}
              </div>

              {userType === "Financial Creditors" && (
                <div className="form-group">
                  <label>Financial Creditor Type</label>
                  <select
                    {...register("financialCreditorType", { required: "Financial creditor type is required" })}
                  >
                    <option value="">Select Type</option>
                    {financialCreditorOptions.map(opt => (
                      <option key={opt.value} value={opt.value}>{opt.label}</option>
                    ))}
                  </select>
                  {errors.financialCreditorType && <p className="error">{errors.financialCreditorType.message}</p>}
                </div>
              )}

              {userType === "Operational Creditors" && (
                <div className="form-group">
                  <label>Operational Creditor Type</label>
                  <select
                    {...register("operationalCreditorType", { required: "Operational creditor type is required" })}
                  >
                    <option value="">Select Type</option>
                    {operationalCreditorOptions.map(opt => (
                      <option key={opt.value} value={opt.value}>{opt.label}</option>
                    ))}
                  </select>
                  {errors.operationalCreditorType && <p className="error">{errors.operationalCreditorType.message}</p>}
                </div>
              )}

              {!otpSent ? (
                <button
                  type="button"
                  onClick={handleSendOTP}
                  disabled={!isClaimantsFormValid() || loading}
                >
                  {loading ? "Sending..." : "Send OTP"}
                </button>
              ) : (
                <div className="otp-group">
                  <input
                    type="text"
                    value={otp}
                    onChange={(e) => setOtp(e.target.value)}
                    placeholder="Enter OTP"
                  />
                </div>
              )}

              <div className="form-footer">
                <div className="terms">
                  <input
                    type="checkbox"
                    id="termsAccepted"
                    {...register("termsAccepted", { required: "You must accept terms" })}
                  />
                  <label htmlFor="termsAccepted">
                    I accept <a href="/terms">Terms & Conditions</a>
                  </label>
                  {errors.termsAccepted && <p className="error">{errors.termsAccepted.message}</p>}
                </div>

                <button
                  type="submit"
                  disabled={!otpSent || !otp || loading || !watch("termsAccepted")}
                >
                  {loading ? "Verifying..." : "Verify OTP & Login"}
                </button>

                <p className="register-link" onClick={() => navigate("/register")}>
                  Don't have an account? Register
                </p>
              </div>
            </form>
          ) : (
            <form onSubmit={handleSubmit(handleCorporateDebtorLogin)}>
              {/* Corporate Debtor form fields */}
              <div className="form-group">
                <label>Email ID</label>
                <input
                  type="email"
                  {...register("email", {
                    required: "Email is required",
                    pattern: {
                      value: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
                      message: "Invalid email format"
                    }
                  })}
                  placeholder="Enter your email"
                />
                {errors.email && <p className="error">{errors.email.message}</p>}
              </div>

              <div className="form-group">
                <label>Password</label>
                <input
                  type="password"
                  {...register("password", {
                    required: "Password is required",
                    minLength: {
                      value: 6,
                      message: "Password must be at least 6 characters"
                    }
                  })}
                  placeholder="Enter your password"
                />
                {errors.password && <p className="error">{errors.password.message}</p>}
              </div>

              <div className="form-footer">
                <div className="terms">
                  <input
                    type="checkbox"
                    id="termsAccepted"
                    {...register("termsAccepted", { required: "You must accept terms" })}
                  />
                  <label htmlFor="termsAccepted">
                    I accept <a href="/terms">Terms & Conditions</a>
                  </label>
                  {errors.termsAccepted && <p className="error">{errors.termsAccepted.message}</p>}
                </div>

                <button
                  type="submit"
                  disabled={!isCorporateDebtorFormValid() || loading}
                >
                  {loading ? "Logging in..." : "Login"}
                </button>

                <p className="register-link" onClick={() => navigate("/register")}>
                  Don't have an account? Register
                </p>
              </div>
            </form>
          )}
        </div>
      </div>
    </div>
  );
};

export default LoginPage;



body {
  margin: 0;
  padding: 0;
  font-family: "Inter", sans-serif;
  overflow: hidden; 
}

.login-page {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  width: 100vw;
  /* background: linear-gradient(135deg, #09828d, #066b72);
   */
   /* background: #93b7c5; */
   background-image: url("../../assests/images/Backgroundlogin.jpg");
   /* background-size: cover;
  background-position: center;
  background-repeat: no-repeat; */
  padding: 20px;
  box-sizing: border-box;
}

.login-container {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 400px;
  padding: 20px;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0px 6px 30px rgba(0, 0, 0, 0.2);
  border-radius: 16px;
  animation: slideIn 0.5s ease-in-out;
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  overflow: hidden; 
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.Login-header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px; 
}

.login-text {
  font-size: 22px; 
  font-weight: 700;
  /* color: #09828d; */
  color: #269ccc;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* Radio Buttons */
.radio-options {
  display: flex;
  justify-content: space-between;
  padding: 8px;
  background: #f3f3f3;
  border-radius: 30px;
  margin-bottom: 10px; 
  gap: 8px;
}

.radio-op {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px 12px; 
  border-radius: 24px;
  cursor: pointer;
  flex: 1;
  transition: all 0.3s ease;
  text-align: center;
  font-size: 13px; 
  font-weight: 500;
  background: #f3f3f3;
}

.radio-op input[type="radio"] {
  display: none;
}

.radio-op label {
  width: 100%;
  cursor: pointer;
  text-align: center;
  color: #333;
}

.radio-op input[type="radio"]:checked + label {
  /* background-color: #09828d; */
  background-color: #269ccc;
  color: white;
  border-radius: 24px;
  padding: 6px; 
}

/* Login Form */
.login-form {
  width: 100%;
}

.user-input,
.otp-verification input,
.dropdown-select {
  width: 100%;
  padding: 8px;
  border: 2px solid #e6e6e6;
  border-radius: 8px;
  font-size: 13px; 
  outline: none;
  transition: border-color 0.3s ease;
  margin-bottom: 8px; 
  box-sizing: border-box;
}

.user-input:focus,
.otp-verification input:focus,
.dropdown-select:focus {
  /* border-color: #09828d; */
  border-color: #269ccc;
}

/* Dropdown Styles */
.dropdown-container {
  position: relative;
  margin-bottom: 8px; 
}

.dropdown-select {
  appearance: none;
  background: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%2309828D%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E")
    no-repeat right 8px center/10px 10px; 
  background-color: white;
  cursor: pointer;
}

/* Send OTP and Login Buttons */
.send-otp-btn,
.login-btn {
  width: 100%;
  padding: 8px; 
  border: none;
  border-radius: 8px;
  font-size: 13px; 
  font-weight: 600;
  color: white;
  /* background-color: #09828d; */
  background-color: #269ccc;
  cursor: pointer;
  transition: all 0.3s ease;
  margin-top: 8px; 
}

.send-otp-btn:hover,
.login-btn:hover {
  /* background-color: #066b72; */
  background-color: #269ccc;
  transform: scale(1.02);
}

.send-otp-btn:disabled,
.login-btn:disabled {
  background-color: #cccccc;
  cursor: not-allowed;
}

/* Terms & Conditions */
.terms-conditions {
  display: flex;
  align-items: center;
  font-size: 11px; 
  color: #333;
  margin: 8px 0; 
}

.terms-conditions input[type="checkbox"] {
  margin-right: 6px;
  /* accent-color: #09828d; */
  accent-color: #269ccc;
}

.terms-conditions a {
  /* color: #09828d; */
  color: #269ccc;
  text-decoration: none;
}

.terms-conditions a:hover {
  text-decoration: underline;
}

.register-text {
  font-size: 12px; 
  color: #333; 
  text-align: center; 
  margin-top: 10px; 
  cursor: pointer; 
  transition: color 0.3s ease; 
}

.register-text:hover {
  /* color: #09828d;  */
  color: #269ccc;
}

.register-link {
  /* color: #09828d; */
  color: #269ccc;
  font-weight: 600; 
  text-decoration: none; 
  transition: color 0.3s ease; 
}

.register-link:hover {
  text-decoration: underline; 
}

/* Responsive Adjustments */
@media (max-width: 768px) {
  .login-container {
    padding: 15px;
    max-width: 90%;
    margin: 0 auto;
    border-radius: 12px;
  }

  .login-text {
    font-size: 20px; 
  }

  .radio-options {
    flex-direction: column;
    gap: 8px;
    padding: 6px;
  }

  .radio-op {
    padding: 6px 10px; 
    font-size: 12px; 
  }

  .user-input,
  .otp-verification input,
  .dropdown-select {
    padding: 6px; 
    font-size: 12px; 
  }

  .send-otp-btn,
  .login-btn {
    padding: 6px; 
    font-size: 12px; 
  }

  .terms-conditions {
    font-size: 10px; 
  }
}

@media (max-width: 480px) {
  .login-container {
    padding: 10px;
    border-radius: 10px;
  }

  .login-text {
    font-size: 18px; 
  }

  .radio-op {
    padding: 5px 8px;
    font-size: 11px; 
  }

  .user-input,
  .otp-verification input,
  .dropdown-select {
    padding: 5px; 
    font-size: 11px; 
  }

  .send-otp-btn,
  .login-btn {
    padding: 5px; 
    font-size: 11px; 
  }

  .terms-conditions {
    font-size: 9px; 
  }
}
