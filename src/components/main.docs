if (response?.status === 200 && response?.data?.data?.[0]) {
  const responseData = response.data.data[0];
  setRegistrationData(responseData);
  setInitialRegistryData(responseData.IwtInitialSurveyResponse);
  setStep1ResponseData(responseData);
  
  // Set actions for officer
  if (isOfficerLogin && responseData.IwtInitialSurveyResponse?.processActionMapResponce) {
    const actionsItems = responseData.IwtInitialSurveyResponse.processActionMapResponce?.[0]?.processs?.[0]?.actions ?? [];
    if (actionsItems?.length > 0) {
      setActionsFromAPI(actionsItems);
      setShowOfficerActions(true);
    }
  }

  populateFormWithTransferData(responseData);
}
