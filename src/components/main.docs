const mapFilesByFieldName = (supportingDocument = {}) => {
  const mappingConfig = {
    // Base documents
    "PAN_CARD": "panCardUpload",
    "GST_CERTIFICATE": "gstCertificate", 
    "TRADE_LICENSE": "tradeLicenseUpload",
    "AADHAAR_CARD": "aadhaarUpload",
    "DRIVING_LICENSE": "dlUpload",
    
    // Company specific documents
    "COS_REGISTRATION_CERTIFICATE": "cosRegCertUpload",
    "COS_BOARD_RESOLUTION": "cosResolutionUpload",
    "RELEVANT_REGISTRATION": "beCosRegDocsUpload",
    "GOVERNING_DOCUMENTS": "beCosGovDocsUpload",
    "BODY_BOARD_RESOLUTION_AUTHORIZING_OWNERSHIP": "beCosResolutionUpload",
    "COMPANY_REGISTRATION_CERTIFICATE": "compRegCertUpload",
    "MEMORANDUM_AND_ARTICLES_ASSOCIATION": "compMoaAoaUpload",
    "COMPANY_BOARD_RESOLUTION": "compBoardResUpload",
    "PARTNERSHIP_REGISTRATION_CERTIFICATE": "partnerRegCertUpload",
    "PARTNERSHIP_DEED": "partnerDeedUpload",
    "TRUST_REGISTRATION_CERTIFICATE": "trustRegCertUpload",
    "TRUST_DEED": "trustDeedUpload",
    "FDI_CERTIFICATE_OF_INCORPORATION": "fdiRegCertUpload",
    "FDI_BOARD_RESOLUTION": "fdiResolutionUpload",
    "FDI_POLICY_PROOF": "fdiProofUpload",
    "BAREBOAT_CHARTER_AGREEMENT": "vslBareboatUpload",
    "INDIAN_CHARTERER_ELIGIBILITY_PROOF": "vslChartererProofUpload",
    "STATE_AOA": "stateAoaUpload",
    "STATE_MOA": "stateMoaUpload",
    "CENTRAL_AOA": "centralAoaUpload",
    "CENTRAL_MOA": "centralMoaUpload",
    "LOCAL_AOA": "localAoaUpload",
    "LOCAL_MOA": "localMoaUpload",
  };

  const regularFiles = {};
  const additionalFiles = [];

  // Get all document arrays from supportingDocument
  const allDocArrays = [
    supportingDocument.individualSupportingDocuments,
    supportingDocument.cosSupportingDocuments,
    supportingDocument.companySupportingDocuments,
    supportingDocument.partnerFirmSupportingDocuments,
    supportingDocument.trustSOCSupportingDocuments,
    supportingDocument.lbcFDISupportingDocuments,
    supportingDocument.foreignVesselSupportingDocuments,
    supportingDocument.stateSupportingDocuments,
    supportingDocument.centerSupportingDocuments,
    supportingDocument.localSupportingDocuments,
    supportingDocument.otherSupportingDocuments,
    supportingDocument.becossupportingDocuments
  ].filter(Boolean);

  // Process all documents
  allDocArrays.forEach(docArray => {
    if (Array.isArray(docArray)) {
      docArray.forEach(doc => {
        const fieldName = mappingConfig[doc.documentType];
        if (fieldName) {
          regularFiles[fieldName] = {
            fileName: doc.documentName,
            fileStoreId: doc.fileStoreId,
            downLoadFile: `${window.location.origin}/filestore/v1/files/id?fileStoreId=${doc.fileStoreId}`,
            documentType: doc.documentType
          };
        } else {
          // Handle additional documents
          additionalFiles.push({
            fileName: doc.documentName,
            fileStoreId: doc.fileStoreId,
            downLoadFile: `${window.location.origin}/filestore/v1/files/id?fileStoreId=${doc.fileStoreId}`,
            documentType: doc.documentType
          });
        }
      });
    }
  });

  return { regularFiles, additionalFiles };
};
