// Add this function in TransferOfRegistryForm.js
const getDetailsByPIN = async (pinCode) => {
  try {
    const URL = `${process.env.REACT_APP_PUBLIC_URL}${URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE}${pinCode}`;
    loaderRef.current?.show();
    
    const response = await getData(URL);
    
    if (response?.status === 200 && response?.data?.length > 0) {
      setValue("basicDetails.builderDetails.district", response.data[0]?.district);
      setValue("basicDetails.builderDetails.state", response.data[0]?.stateName);
      setValue("basicDetails.builderDetails.country", "India");
      loaderRef?.current?.hide();
    } else {
      loaderRef?.current?.hide();
      toast.info("No Data Found! Please enter manually..", {
        position: "top-right",
      });
    }
  } catch (err) {
    console.log(err);
    loaderRef?.current?.hide();
    handleErrorMessage(err?.response?.data);
  }
};

// Update the pincode field in the form (around line 1200)
<Col md={4}>
  <InputText
    label={t("Pincode of Builder")}
    name="basicDetails.builderDetails.pin"
    placeholder={!viewMode ? t("Enter Pincode of Builder") : ""}
    register={register("basicDetails.builderDetails.pin")}
    errors={errors}
    disabled={viewMode}
    maxlength={6}
    onChange={(e) => {
      const pinValue = e?.target?.value || "";
      if (pinValue?.length === 6) {
        setValue("basicDetails.builderDetails.district", "");
        setValue("basicDetails.builderDetails.state", "");
        setValue("basicDetails.builderDetails.country", "India");
        getDetailsByPIN(pinValue);
      }
    }}
    style={{ backgroundColor: "#f8f9fa" }}
  />
</Col>

