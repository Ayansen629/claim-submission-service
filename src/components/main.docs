import React, { useState, useEffect, useRef } from "react";
import style from "./styles/ActionTable.module.css";
import _ from "lodash";
import GenericExportDropdown from "./export/GenericExport";
import deleteIcon from "../../assets/icons/delete.svg";
import upload from "../../assets/icons/upload.svg";
import download from "../../assets/icons/download.svg";
import { Dropdown } from "react-bootstrap";
import Tooltip from "@mui/material/Tooltip";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import { FcViewDetails } from "react-icons/fc";
import { EyeFill, PencilSquare ,Upload, FileEarmarkText, Award, Pencil, CreditCard} from "react-bootstrap-icons";
import "react-datepicker/dist/react-datepicker.css";
import DateRangePickerComponent from "./DateRangePickerComponent";

const ActionTable = (props: any) => {
  
  const [searchedData, setSearchedData] = useState(props?.rowData || []);
  const [startDate, setStartDate] = useState(null);
  const [endDate, setEndDate] = useState(null);
  const [currentPage, setCurrentPage] = useState(1);
  const [selected, setSelected] = useState<any[]>([]);
  const [sortedColumn, setSortedColumn] = useState<string | null>(null);
  const [sortOrder, setSortOrder] = useState<string>("");
  const [itemsPerPage, setItemPerPage] = useState(
    props?.tableConfig?.defaultRowsPerPage || 5
  );

  // Constants
  const hideColumns = props?.hideColumns || [];

  // Pagination calculations
  const indexOfLastItem = currentPage * itemsPerPage;
  const indexOfFirstItem = indexOfLastItem - itemsPerPage;
  const currentItems = searchedData?.slice(indexOfFirstItem, indexOfLastItem);
  const totalPages = Math.ceil(searchedData?.length / itemsPerPage);

  // Update data when props change
  useEffect(() => {
    props?.rowData && setSearchedData(props?.rowData);
    setCurrentPage(1);
    const selectedRows = props?.rowData
      .filter((item: any) => item.isChecked)
      .map((item: any) => item.id);
    setSelected(selectedRows);
  }, [props?.rowData]);

  // Date filtering
  const handleDateFilter = (startDate, endDate) => {
    let filteredData = props?.rowData || [];

    if (startDate && endDate) {
      filteredData = filteredData.filter((item) => {
        const yearOfRegistry = new Date(item.yearOfRegistry).getFullYear();
        return (
          yearOfRegistry >= startDate.getFullYear() &&
          yearOfRegistry <= endDate.getFullYear()
        );
      });

      // Sort by year
      filteredData = filteredData.sort((a, b) => {
        const yearA = new Date(a.yearOfRegistry).getFullYear();
        const yearB = new Date(b.yearOfRegistry).getFullYear();
        return yearA - yearB;
      });
    }

    setSearchedData(filteredData);
  };

  // Pagination handlers
  const handleNextPage = () => {
    setCurrentPage((prevPage) => Math.min(prevPage + 1, totalPages));
  };

  const handlePrevPage = () => {
    setCurrentPage((prevPage) => Math.max(prevPage - 1, 1));
  };

  // Search functionality
  const handleOnSearch = (e: any) => {
    if (e.target.value) {
      const searchValue = e.target.value.toLowerCase();

      const filterObject = (obj: any): boolean => {
        return Object.values(obj).some((value) => {
          if (typeof value === "object" && value !== null) {
            return filterObject(value);
          }
          return value?.toString().toLowerCase().includes(searchValue);
        });
      };

      const filtered = props?.rowData?.filter((item: any) =>
        filterObject(item)
      );
      handleDateFilter(startDate, endDate);
      setSearchedData(filtered);
      setCurrentPage(1);
    } else {
      setSearchedData(props?.rowData);
    }
  };

  // Sorting functionality
  const sortByColumn = (column: string) => {
    if (sortedColumn === column) {
      setSortOrder(sortOrder === "asc" ? "desc" : "asc");
    } else {
      setSortedColumn(column);
      setSortOrder("asc");
    }
  };

  const showSortedColumnIcon = (columnName: string) => {
    return sortedColumn === columnName ? (
      sortOrder === "asc" ? (
        <i className="fa fa-long-arrow-up table-arrow" aria-hidden="true" />
      ) : (
        <i className="fa fa-long-arrow-down table-arrow" aria-hidden="true"></i>
      )
    ) : (
      <></>
    );
  };

  // Apply sorting
  useEffect(() => {
    if (sortOrder && sortedColumn) {
      const sortedData = [...searchedData]?.sort((a, b) => {
        const columnValueA = _.get(a, sortedColumn);
        const columnValueB = _.get(b, sortedColumn);

        if (sortOrder === "asc") {
          return typeof columnValueA === "string"
            ? columnValueA?.localeCompare(columnValueB)
            : columnValueA - columnValueB;
        } else {
          return typeof columnValueA === "string"
            ? columnValueB?.localeCompare(columnValueA)
            : columnValueB - columnValueA;
        }
      });
      setSearchedData(sortedData);
    }
  }, [sortOrder, sortedColumn]);

  // Row action handlers
  const handleDeleteRow = (rowData: any) => props?.onDeleteRow(rowData);
  const handleView = (rowData: any) => props?.onViewRow(rowData);
  const handleHistoryViews = (rowData: any) => props?.onHistoryView(rowData);
  const handleDownload = (rowData: any) => props?.download(rowData);
  const handleEdit = (rowData: any) => props?.handleEditRow(rowData);
  const handlePullBack = (rowData: any) => props?.pullBack(rowData);
  const onRowClick = (rowData: any) => props?.additionalMethod(rowData);

  const handleUploadReports = (rowData: any) => props?.onUploadReports(rowData);
const handleVesselRegistration = (rowData: any) => props?.onVesselRegistration(rowData);
const handleProvisionalCertificate = (rowData: any) => props?.onProvisionalCertificate(rowData);
const handleRevisedDrawing = (rowData: any) => props?.onRevisedDrawing(rowData);
const handlePaySupervisionFee = (rowData: any) => props?.onPaySupervisionFee(rowData);

  // Checkbox handling
  const onCheckColumn = (event: any) => {
    if (props?.checkType === "multiCheck") {
      if (event.target.checked) {
        const newSelecteds = currentItems?.map((n: any) => n);
        setSelected(newSelecteds);
        props?.onCheckHandler(newSelecteds);
        return;
      }
    }
    setSelected([]);
    props?.onCheckHandler([]);
  };

  const onRowCheck = (event: any, id: any, row: any) => {
    const selectedIndex = selected.map((e) => e.id).indexOf(id);
    let newSelected: any = [];
    const NOCHECK_ITEM = -1;

    if (props?.checkType === "multiCheck") {
      if (selectedIndex === NOCHECK_ITEM) {
        newSelected = newSelected.concat(selected, row);
      } else if (selectedIndex === 0) {
        newSelected = newSelected.concat(selected.slice(1));
      } else if (selectedIndex === selected.length - 1) {
        newSelected = newSelected.concat(selected.slice(0, -1));
      } else if (selectedIndex > 0) {
        newSelected = newSelected.concat(
          selected.slice(0, selectedIndex),
          selected.slice(selectedIndex + 1)
        );
      }
    } else {
      if (selectedIndex === NOCHECK_ITEM) {
        newSelected = newSelected.concat(selected, row);
      } else if (selectedIndex === 0) {
        newSelected = newSelected.concat(selected.slice(1));
      } else if (selectedIndex > 0) {
        newSelected = newSelected.concat(
          selected.slice(0, selectedIndex),
          selected.slice(selectedIndex + 1)
        );
      }
    }

    setSelected(newSelected);
    props?.onCheckHandler(newSelected);
  };

  const isSelected = (id: any) => {
    const pos = selected.map((e) => e.id).indexOf(id);
    return pos !== -1;
  };

  const uncheckLast = () => {
    if (props?.checkType === "singleCheck") {
      let ns = selected.slice(1);
      setSelected(ns);
    }
  };

  // Handle checkbox state
  useEffect(() => {
    let x: any = document.getElementById("table-column-check");
    if (!x) return;

    const checkedItems = selected.every((id) =>
      currentItems.some((obj: any) => obj.id === id)
    );

    if (props?.checkType) {
      if (
        selected.length > 0 &&
        selected.length < props?.rowData?.length &&
        selected.length === currentItems.length &&
        checkedItems
      ) {
        x.indeterminate = true;
      } else {
        x.indeterminate = false;
      }

      if (selected.length > 1 && props?.checkType === "singleCheck") {
        uncheckLast();
      }
    }
  }, [selected, currentItems, props?.rowData?.length, props?.checkType]);

  // Rows per page handling
  const onChangeRowsPerPage = (item: any) => {
    setItemPerPage(item);
  };

  // Pagination options component
  const PaginationOptions = () => {
    const exportRef = useRef<any>(null);

    return (
      <div
        id="export_button"
        ref={exportRef}
        className="d-inline-flex flex-row align-items-center stickyCard"
      >
        <div className="ps-3" style={{ marginRight: "10px" }}>
          Rows per page
        </div>
        <Dropdown>
          <Dropdown.Toggle
            id="dropdownMenuButton1"
            style={{
              color: "white",
              backgroundColor: "#0b5ed7",
              borderColor: "#000000",
            }}
          >
            <span className="font-14">{itemsPerPage}</span>
          </Dropdown.Toggle>

          <Dropdown.Menu>
            {(
              props?.tableConfig?.paginationOptions || [5, 10, 25, 50, 100]
            ).map((item, i) => (
              <Dropdown.Item
                key={i}
                onClick={() => onChangeRowsPerPage(item)}
                onMouseEnter={(e) => {
                  e.currentTarget.style.backgroundColor = "#0b5ed7";
                  e.currentTarget.style.color = "#fff";
                }}
                onMouseLeave={(e) => {
                  e.currentTarget.style.backgroundColor = "";
                  e.currentTarget.style.color = "";
                }}
                style={{
                  cursor: "pointer",
                  transition: "background-color 0.3s ease, color 0.3s ease",
                }}
              >
                {item}
              </Dropdown.Item>
            ))}
          </Dropdown.Menu>
        </Dropdown>
      </div>
    );
  };

  return (
    <>
      <div className="generic-action-table pt-3">
        <div
          className={`row px-1 ${style.application_search} ${
            props?.hideSearchBar
              ? "justify-content-end mb-1"
              : "justify-content-between"
          }`}
        >
          <div
            className="col-sm-6 my-1 fw-bold"
            style={{ width: "fit-content" }}
          >
            {props?.tableHeader ? props?.tableHeader : ""}
          </div>

          <div
            className="d-flex justify-content-end align-items-center"
            style={{ flex: 1, gap: "1rem" }}
          >
            {props?.showDatePicker && (
              <DateRangePickerComponent onFilterDate={handleDateFilter} />
            )}

            {!props.hideSearchBar && (
              <div className="my-1" style={{ marginLeft: "auto" }}>
                <input
                  type="search"
                  onChange={handleOnSearch}
                  placeholder="Search"
                  className={`p-2 ${style.searchInput}`}
                  style={{ width: "240px" }}
                />
              </div>
            )}

            {props.rowData?.length > 0 && !props.hideExportBtn && (
              <div className="my-1">
                <GenericExportDropdown
                  columns={props.columns}
                  rowData={props.rowData}
                />
              </div>
            )}
          </div>
        </div>

        <div style={{ overflow: "auto" }}>
          <table
            className={`${style.table} table table-bordered`}
            style={{
              width: `${props?.tableWidth}`,
              backgroundColor: "#ffffff",
            }}
          >
            <thead>
              <tr className={`${style.table_header}`}>
                {props?.columns?.map(
                  (data: any, colIndx: any) =>
                    !hideColumns.includes(data.fieldName) && (
                      <th
                        key={colIndx}
                        className="px-0 py-2 text-center"
                        style={{
                          width: data?.minWidth || "8rem",
                          fontSize: "1.1rem",
                        }}
                        onClick={() => sortByColumn(data.fieldName)}
                      >
                        {data.titleCode || data.colName}
                        {showSortedColumnIcon(data.fieldName)}
                      </th>
                    )
                )}
              </tr>
            </thead>

            <tbody style={{ backgroundColor: "#ffffff" }}>
              {searchedData.length !== 0 ? (
                currentItems?.map((row: any, index: number) => {
                  const rowId = row.id;
                  const isItemSelected = isSelected(rowId);

                  return (
                    <tr
                      key={rowId}
                      className={`${style.table_data} table-row-hover`}
                      style={{ backgroundColor: "#ffffff" }}
                    >
                      {props?.columns.map((o: any, colIndex: any) => {
                        // Skip hidden columns
                        if (hideColumns.includes(o.fieldName)) {
                          return null;
                        }

                        // Columns that need to check for missing data
                        if (
                          [
                            "nameOfVessel",
                            "portOfRegistry",
                            "addressOfOwner",
                            "yearOfRegistry",
                            "vesselType",
                          ].includes(o.fieldName) &&
                          !_.get(row, o.fieldName)
                        ) {
                          return (
                            <td
                              key={colIndex}
                              className={`px-0 py-2 ${style.actionTable_table_data}`}
                              style={{
                                textAlign: "center",
                                background: "#ffffff",
                              }}
                            >
                              <Tooltip
                                title="No data available"
                                placement="top"
                                arrow
                              >
                                <ErrorOutlineIcon
                                  style={{ color: "#888", fontSize: "20px" }}
                                />
                              </Tooltip>
                            </td>
                          );
                        }

                        // Check for clickable fields
                        if (o?.isClickable) {
                          return (
                            <td
                              key={colIndex}
                              className={`px-0 py-2 ${style.actionTable_table_data}`}
                              style={{
                                color: "#3370D4",
                                cursor: "pointer",
                                background: "#ececf9",
                                fontWeight: row.isRead ? "normal" : "bolder",
                              }}
                              onClick={() => onRowClick(row)}
                            >
                              <span>{_.get(row, o.fieldName)}</span>
                            </td>
                          );
                        }

                        // Check for checkbox field
                        if (o.fieldName === "checkbox") {
                          return (
                            <td
                              key={colIndex}
                              className={`px-0 py-2 ${style.actionTable_table_data}`}
                            >
                              <input
                                type="checkbox"
                                checked={isItemSelected}
                                onChange={(event) =>
                                  onRowCheck(event, rowId, row)
                                }
                              />
                            </td>
                          );
                        }

                        // Check for sER field
                        if (o.fieldName === "slNo") {
                          return (
                            <td
                              key={colIndex}
                              style={{ maxWidth: "1rem!important" }}
                            >
                              {index + 1}
                            </td>
                          );
                        }

                        // Add tooltip for "nameOfOwner" field
                        if (o?.colName === "nameOfOwner") {
                          return (
                            <td
                              key={colIndex}
                              className={`px-0 py-2 ${style.actionTable_table_data}`}
                              style={{ background: "#ffffff" }}
                            >
                              <Tooltip
                                title={
                                  _.get(row, o.fieldName) || "No name available"
                                }
                                placement="top"
                                arrow
                              >
                                <span>
                                  {_.get(row, o.fieldName)
                                    ?.split(" ")
                                    .slice(0, 3)
                                    .join(" ") || "No name available"}
                                </span>
                              </Tooltip>
                            </td>
                          );
                        }

                        // Check for the "addressOfOwner" field
                        if (o?.colName === "addressOfOwner") {
                          return (
                            <td
                              key={colIndex}
                              className={`px-0 py-2 ${style.actionTable_table_data}`}
                              style={{ background: "#ffffff" }}
                            >
                              <Tooltip
                                title={
                                  _.get(row, o.fieldName) ||
                                  "No address available"
                                }
                                placement="top"
                                arrow
                              >
                                <span
                                  style={{
                                    display: "inline-block",
                                    whiteSpace: "nowrap",
                                    overflow: "hidden",
                                    textOverflow: "ellipsis",
                                    maxWidth: "200px",
                                  }}
                                >
                                  {_.get(row, o.fieldName)
                                    ?.split(" ")
                                    .slice(0, 4)
                                    .join(" ") || "No address available"}
                                </span>
                              </Tooltip>
                            </td>
                          );
                        }

                        // Check for the "history" field
                        if (o?.colName === "History") {
                          return (
                            <td
                              key={colIndex}
                              className={`px-0 py-2 ${style.actionTable_table_data}`}
                              style={{ background: "#ffffff" }}
                            >
                              <div
                                className="d-flex"
                                style={{ gap: "8px", justifyContent: "center" }}
                              >
                                <Tooltip
                                  title="View history"
                                  placement="top"
                                  arrow
                                >
                                  <button
                                    onClick={() => handleHistoryViews(row)}
                                    type="button"
                                    className="btn btn-info"
                                  >
                                    <FcViewDetails className="table-action-icon" />
                                  </button>
                                </Tooltip>
                              </div>
                            </td>
                          );
                        }

                        // Handle status field with different colors
                        if (o.fieldName === "status") {
                          const status = _.get(row, o.fieldName);
                          let statusColor = "#ffffff"; // Default background
                          let textColor = "#000000"; // Default text color

                          // Define colors for different status values
                          switch (status?.toLowerCase()) {
                            case "active":
                            case "approved":
                              statusColor = "#d4edda"; // Light green
                              textColor = "#155724"; // Dark green
                              break;
                            case "pending":
                            case "in progress":
                              statusColor = "#fff3cd"; // Light yellow
                              textColor = "#856404"; // Dark yellow/amber
                              break;
                            case "rejected":
                            case "failed":
                            case "inactive": 
                              statusColor = "#f8d7da"; // Light red
                              textColor = "#721c24"; // Dark red
                              break;
                            case "draft":
                              statusColor = "#e2e3e5"; // Light gray
                              textColor = "#383d41"; // Dark gray
                              break;
                            case "completed":
                              statusColor = "#cce5ff"; // Light blue
                              textColor = "#004085"; // Dark blue
                              break;
                            default:
                              statusColor = "#ffffff"; // Default white
                              textColor = "#000000"; // Default black
                          }

                          return (
                            <td
                              key={colIndex}
                              className={`px-0 py-2 ${style.actionTable_table_data}`}
                              style={{ background: "#ffffff" }}
                            >
                              <span
                                style={{
                                  backgroundColor: statusColor,
                                  color: textColor,
                                  padding: "4px 8px",
                                  borderRadius: "4px",
                                  display: "inline-block",
                                  fontWeight: "500",
                                }}
                              >
                                {status}
                              </span>
                            </td>
                          );
                        }

                        // Handle "action" column
                        if (o.fieldName === "action") {
                          return (
                            <td
                              key={colIndex}
                              className={`px-3 py-2 ${style.actionTable_table_data}`}
                              style={{ background: "#ffffff" }}
                            >
                              <div
                                className="d-flex"
                                style={{
                                  gap: "12px",
                                  justifyContent: "center",
                                }}
                              >
                                {o.actions.includes("edit") && (
                                  <Tooltip
                                    title="Edit this item"
                                    placement="top"
                                    arrow
                                  >
                                    <button
                                      onClick={() => handleEdit(row)}
                                      type="button"
                                      className="btn btn-primary"
                                      style={{ padding: "6px 12px" }}
                                    >
                                      <PencilSquare color="white" size={18} />
                                    </button>
                                  </Tooltip>
                                )}

                                {o.actions.includes("view") && (
                                  <Tooltip
                                    title="View details"
                                    placement="top"
                                    arrow
                                  >
                                    <button
                                      onClick={() => handleView(row)}
                                      type="button"
                                      className="btn btn-primary"
                                      style={{ padding: "6px 12px" }}
                                    >
                                      <EyeFill color="white" size={18} />
                                    </button>
                                  </Tooltip>
                                )}

                                {o.actions.includes("delete") && (
                                  <Tooltip
                                    title="Delete this item"
                                    placement="top"
                                    arrow
                                  >
                                    <button
                                      onClick={() => handleDeleteRow(row)}
                                      type="button"
                                      className="btn btn-danger"
                                    >
                                      <img
                                        src={deleteIcon}
                                        alt="delete"
                                        className="table-action-icon"
                                      />
                                    </button>
                                  </Tooltip>
                                )}

                                {o.actions.includes("download") && (
                                  <Tooltip
                                    title="Download file"
                                    placement="top"
                                    arrow
                                  >
                                    <button
                                      onClick={() => handleDownload(row)}
                                      type="button"
                                      className="btn btn-primary"
                                    >
                                      <img
                                        src={download}
                                        alt="download"
                                        className="table-action-icon"
                                      />
                                    </button>
                                  </Tooltip>
                                )}

                                {o.actions.includes("upload") && (
                                  <Tooltip
                                    title="Upload file"
                                    placement="top"
                                    arrow
                                  >
                                    <button
                                      onClick={() => handleView(row)}
                                      type="button"
                                      className="btn btn-secondary"
                                    >
                                      <img
                                        src={upload}
                                        alt="upload"
                                        className="table-action-icon"
                                      />
                                    </button>
                                  </Tooltip>
                                )}
                                {o.actions.includes("uploadReports") && (
                                  <Tooltip
                                    title="Upload Reports"
                                    placement="top"
                                    arrow
                                  >
                                    <button
                                      onClick={() => handleUploadReports(row)}
                                      type="button"
                                      className="btn btn-success"
                                      style={{ padding: "6px 12px" }}
                                    >
                                      <Upload color="white" size={18} />
                                    </button>
                                  </Tooltip>
                                )}
                                
                                {o.actions.includes("vesselRegistration") && (
                                  <Tooltip
                                    title="Application for Vessel Registration"
                                    placement="top"
                                    arrow
                                  >
                                    <button
                                      onClick={() => handleVesselRegistration(row)}
                                      type="button"
                                      className="btn btn-info"
                                      style={{ padding: "6px 12px" }}
                                    >
                                      <FileEarmarkText color="white" size={18} />
                                    </button>
                                  </Tooltip>
                                )}
                                
                                {o.actions.includes("provisionalCertificate") && (
                                  <Tooltip
                                    title="Application for Provisional Certificate"
                                    placement="top"
                                    arrow
                                  >
                                    <button
                                      onClick={() => handleProvisionalCertificate(row)}
                                      type="button"
                                      className="btn btn-warning"
                                      style={{ padding: "6px 12px" }}
                                    >
                                      <Award color="white" size={18} />
                                    </button>
                                  </Tooltip>
                                )}
                                
                                {o.actions.includes("revisedDrawing") && (
                                  <Tooltip
                                    title="Revised Drawing"
                                    placement="top"
                                    arrow
                                  >
                                    <button
                                      onClick={() => handleRevisedDrawing(row)}
                                      type="button"
                                      className="btn btn-secondary"
                                      style={{ padding: "6px 12px" }}
                                    >
                                      <Pencil color="white" size={18} />
                                    </button>
                                  </Tooltip>
                                )}
                                
                                {o.actions.includes("paySupervisionFee") && (
                                  <Tooltip
                                    title="Pay Supervision Fee"
                                    placement="top"
                                    arrow
                                  >
                                    <button
                                      onClick={() => handlePaySupervisionFee(row)}
                                      type="button"
                                      className="btn btn-dark"
                                      style={{ padding: "6px 12px" }}
                                    >
                                      <CreditCard color="white" size={18} />
                                    </button>
                                  </Tooltip>
                                )}
                              </div>
                            </td>
                          );
                        }

                        
                        return (
                          <td
                            key={colIndex}
                            className={`px-0 py-2 ${style.actionTable_table_data}`}
                            style={{ background: "#ffffff" }}
                          >
                            <span>{_.get(row, o.fieldName)}</span>
                          </td>
                        );
                      })}
                    </tr>
                  );
                })
              ) : (
                <tr>
                  <td colSpan={props.columns.length} className="text-center">
                    <strong>No results found</strong>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>

       
<div className={style.tableFooter}>
  <div className="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 w-100">
    <div className={style.tableInfo}>
      <span className={style.entriesInfo}>
        Showing {indexOfFirstItem + 1}-
        {Math.min(indexOfLastItem, searchedData.length)} of{" "}
        {searchedData.length} entries
      </span>
      {selected.length > 0 && (
        <span className={style.selectedBadge}>
          {selected.length} selected
        </span>
      )}
    </div>

    <div className="d-flex flex-column flex-sm-row align-items-center gap-2">
      <PaginationOptions />

      <div className="d-flex align-items-center gap-2">
        <button
          className={`${style.paginationButton} ${
            currentPage === 1 ? style.disabled : ""
          }`}
          onClick={handlePrevPage}
          disabled={currentPage === 1}
        >
          <span className={style.paginationIcon}>«</span>
        </button>

        
        <div className="d-none d-sm-flex align-items-center gap-1">
          {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
            let pageNum;
            if (totalPages <= 5) {
              pageNum = i + 1;
            } else if (currentPage <= 3) {
              pageNum = i + 1;
            } else if (currentPage >= totalPages - 2) {
              pageNum = totalPages - 4 + i;
            } else {
              pageNum = currentPage - 2 + i;
            }

            return (
              <button
                key={pageNum}
                className={`${style.pageNumber} ${
                  currentPage === pageNum ? style.active : ""
                }`}
                onClick={() => setCurrentPage(pageNum)}
              >
                {pageNum}
              </button>
            );
          })}

          {totalPages > 5 && currentPage < totalPages - 2 && (
            <>
              <span className={style.paginationEllipsis}>...</span>
              <button
                className={style.pageNumber}
                onClick={() => setCurrentPage(totalPages)}
              >
                {totalPages}
              </button>
            </>
          )}
        </div>

      
        <div className="d-sm-none px-2">
          <span className="small text-muted fw-medium">
            {currentPage} / {totalPages}
          </span>
        </div>

        <button
          className={`${style.paginationButton} ${
            currentPage === totalPages || totalPages === 0
              ? style.disabled
              : ""
          }`}
          onClick={handleNextPage}
          disabled={currentPage === totalPages || totalPages === 0}
        >
          <span className={style.paginationIcon}>»</span>
        </button>
      </div>
    </div>
  </div>
</div>

      </div>
    </>
  );
};

export default ActionTable;

import React, { act } from "react";
import { Card, Badge, Button } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { BsCheckCircleFill, BsClock, BsXCircleFill, BsDownload, BsCreditCard } from "react-icons/bs";
import ActionTable from "../../../common/ActionTable.tsx";

const PaymentDetailsView = ({ supervisionAuthority, formData }) => {
  const { t } = useTranslation();

  // Payment table data
  const paymentTableData = [
    {
      id: 1,
      paymentId: "PAY-2024-001",
      status: "paid",
      paymentDate: "2024-01-16",
      receipt: "receipt_001.pdf"
    },
    {
      id: 2,
      paymentId: "PAY-2024-002", 
      status: "pending",
      paymentDate: "2024-01-20",
      receipt: "receipt_002.pdf"
    },
    {
      id: 3,
      paymentId: "PAY-2024-003", 
      status: "failed",
      paymentDate: "2024-01-18",
      receipt: "receipt_003.pdf"
    }
  ];

  // Payment table columns
  const paymentColumns = [
    {
      colName: t("Payment ID"),
      fieldName: "paymentId",
      clsName: "column-text-start",
      render: (value) => (
        <span className="fw-semibold text-primary">{value}</span>
      )
    },
    {
      colName: t("Status"),
      fieldName: "status",
      clsName: "column-text-center",
      render: (value) => getStatusBadge(value)
    },
    {
      colName: t("Payment Date"),
      fieldName: "paymentDate",
      clsName: "column-text-center",
      render: (value) => (
        <span className="fw-medium">{value}</span>
      )
    },
    {
      colName: t("Receipt"),
      fieldName: "receipt",
      clsName: "column-text-center",
    render: (value) => (
        <span className="fw-medium">{value}</span>
      )
    
    },
        {
    colName: "Action",
    fieldName: "action",
    actions: [
        'download'
     
    ],
    clsName: "col-sm-2 column-text-start actions-column",
  },
  ];



  const getStatusBadge = (status) => {
    switch (status) {
      case 'paid':
        return (
          <Badge 
            className="d-flex align-items-center gap-2 px-3 py-2 rounded-pill"
            style={{ 
              background: "linear-gradient(135deg, #28a745 0%, #20c997 100%)",
              border: "none",
              fontSize: "0.8rem",
              fontWeight: "600"
            }}
          >
            <BsCheckCircleFill size={12} /> {t("Paid")}
          </Badge>
        );
      case 'pending':
        return (
          <Badge 
            className="d-flex align-items-center gap-2 px-3 py-2 rounded-pill"
            style={{ 
              background: "linear-gradient(135deg, #ffc107 0%, #fd7e14 100%)",
              border: "none",
              fontSize: "0.8rem",
              fontWeight: "600",
              color: "white"
            }}
          >
            <BsClock size={12} /> {t("Pending")}
          </Badge>
        );
      case 'failed':
        return (
          <Badge 
            className="d-flex align-items-center gap-2 px-3 py-2 rounded-pill"
            style={{ 
              background: "linear-gradient(135deg, #dc3545 0%, #e83e8c 100%)",
              border: "none",
              fontSize: "0.8rem",
              fontWeight: "600"
            }}
          >
            <BsXCircleFill size={12} /> {t("Failed")}
          </Badge>
        );
      default:
        return <Badge bg="secondary">{t("Unknown")}</Badge>;
    }
  };

  return (
    <div className="container py-4">
      <Card className="shadow-lg border-0" style={{ borderRadius: "15px", overflow: "hidden" }}>
        <Card.Header 
          className="text-white py-4 d-flex align-items-center"
          style={{ 
            background: "linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%)",
            borderBottom: "none"
          }}
        >
          <BsCreditCard size={24} className="me-3" />
          <div>
            <h4 className="mb-1 fw-bold text-white">{t("Payment Details")}</h4>
            <p className="mb-0 text-white-50">{t("View and download payment receipts")}</p>
          </div>
        </Card.Header>
        
        <Card.Body className="p-0" style={{ background: "#f8f9fa" }}>
          <div className="p-4">
            <ActionTable
              columns={paymentColumns}
              rowData={paymentTableData}
              tableHeader={null}
              hideExportBtn={true}
              hideSearchBar={true}
              pagination={true}
              itemsInboxPerPage={10}
              tableClassName="table-hover"
              noDataText={
                <div className="text-center py-5 text-muted">
                  <BsCreditCard size={48} className="mb-3 opacity-25" />
                  <h6 className="mb-2">{t("No Payment Records")}</h6>
                  <p className="mb-0">{t("No payment transactions found for this registration")}</p>
                </div>
              }
            />
          </div>
        </Card.Body>
      </Card>
    </div>
  );
};

export default PaymentDetailsView;
