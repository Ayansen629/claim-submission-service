import React, { useState, useEffect, useRef } from "react";
import { FaChevronLeft, FaChevronRight } from "react-icons/fa";
import { styled } from "@mui/material/styles";

const TabsWrapper = styled('div')({
  margin: 0,
  fontFamily: "'Inter', 'Segoe UI', sans-serif",
});

const TabsHeader = styled('div')({
  display: "flex",
  alignItems: "center",
  backgroundColor: "#fff",
  position: "relative",
  overflow: "hidden",
  borderBottom: "1px solid #e1e8ed",
});

const TabsScroll = styled('div')({
  overflowX: "auto",
  flex: 1,
  scrollBehavior: "smooth",
  scrollbarWidth: "none",
  "&::-webkit-scrollbar": {
    display: "none",
  },
});

const TabList = styled('ul')(({ tabcount, issingle }) => ({
  display: "flex",
  gap: "0",
  padding: "0",
  margin: "0",
  listStyle: "none",
  minWidth: "max-content",
  ...(issingle === "true" && {
    width: "100%",
  }),
  ...(tabcount <= 4 && tabcount > 1 && {
    display: "grid",
    gridTemplateColumns: `repeat(${tabcount}, 1fr)`,
    width: "100%",
  }),
}));

const TabItem = styled('li')(({ tabcount, issingle }) => ({
  flex: "0 0 auto",
  ...(issingle === "true" && {
    width: "100%",
  }),
  ...(tabcount <= 4 && tabcount > 1 && {
    width: "100%",
    flex: "1 1 0%",
  }),
}));

const TabButton = styled('button')(({ isactive }) => ({
  position: "relative",
  background: isactive ? "#2E57A7" : "transparent",
  border: "none",
  color: isactive ? "#fff" : "#64748b",
  padding: "1rem 1.5rem",
  fontSize: "0.875rem",
  fontWeight: isactive ? "600" : "500",
  cursor: "pointer",
  display: "flex",
  alignItems: "center",
  gap: "0.5rem",
  transition: "all 0.2s ease",
  whiteSpace: "nowrap",
  "&:hover": {
    background: isactive ? "#2E57A7" : "#f8fafc",
    color: isactive ? "#fff" : "#2E57A7",
  },
  "&::after": {
    content: '""',
    position: "absolute",
    bottom: 0,
    left: "50%",
    transform: "translateX(-50%)",
    width: isactive ? "100%" : "0",
    height: "2px",
    background: isactive ? "#0a9163" : "transparent",
    transition: "width 0.3s ease",
  }
}));

const ScrollButton = styled('button')({
  position: "absolute",
  top: "50%",
  transform: "translateY(-50%)",
  background: "#fff",
  color: "#64748b",
  border: "none",
  borderRadius: "50%",
  width: "32px",
  height: "32px",
  fontSize: "0.8rem",
  display: "flex",
  alignItems: "center",
  justifyContent: "center",
  zIndex: 10,
  boxShadow: "0 2px 8px rgba(0, 0, 0, 0.1)",
  transition: "all 0.2s ease",
  "&:hover": {
    background: "#2E57A7",
    color: "#fff",
  },
});

const TabsContent = styled('div')({
  backgroundColor: "#fff",
  padding: "1.5rem",
  minHeight: "300px",
});

const DynamicTabs = ({ tabs, onTabChange }) => {
  const [activeIndex, setActiveIndex] = useState(0);
  const [showLeft, setShowLeft] = useState(false);
  const [showRight, setShowRight] = useState(false);
  const tabListRef = useRef(null);
  const touchStartX = useRef(null);

  const updateScrollButtons = () => {
    const el = tabListRef.current;
    if (!el) return;
    setShowLeft(el.scrollLeft > 0);
    setShowRight(el.scrollLeft + el.clientWidth < el.scrollWidth - 1);
  };

  useEffect(() => {
    const el = tabListRef.current;
    updateScrollButtons();
    el.addEventListener("scroll", updateScrollButtons);
    window.addEventListener("resize", updateScrollButtons);
    return () => {
      el.removeEventListener("scroll", updateScrollButtons);
      window.removeEventListener("resize", updateScrollButtons);
    };
  }, [tabs]);

  useEffect(() => {
    if (tabs[activeIndex]?.onLoad) tabs[activeIndex].onLoad();
    if (onTabChange) onTabChange(activeIndex);
  }, [activeIndex, onTabChange, tabs]);

  const scrollTabs = (dir) => {
    const el = tabListRef.current;
    if (el) el.scrollBy({ left: dir * 180, behavior: "smooth" });
  };

  const handleTouchStart = (e) => {
    touchStartX.current = e.touches[0].clientX;
  };

  const handleTouchEnd = (e) => {
    const deltaX = e.changedTouches[0].clientX - touchStartX.current;
    if (Math.abs(deltaX) > 50) {
      setActiveIndex((prev) => {
        const newIndex = deltaX > 0 ? prev - 1 : prev + 1;
        return Math.max(0, Math.min(newIndex, tabs.length - 1));
      });
    }
  };

  return (
    <TabsWrapper>
      <TabsHeader className={showLeft || showRight ? "with-arrows" : ""}>
        {showLeft && (
          <ScrollButton 
            className="left" 
            onClick={() => scrollTabs(-1)}
            sx={{ left: "8px" }}
          >
            <FaChevronLeft />
          </ScrollButton>
        )}
        <TabsScroll ref={tabListRef}>
          <TabList 
            tabcount={tabs.length} 
            issingle={(tabs.length === 1).toString()}
          >
            {tabs.map((tab, index) => (
              <TabItem 
                key={index} 
                tabcount={tabs.length}
                issingle={(tabs.length === 1).toString()}
              >
                <TabButton
                  isactive={index === activeIndex}
                  onClick={() => setActiveIndex(index)}
                >
                  {tab.icon && <span className="tab-icon">{tab.icon}</span>}
                  <span>{tab.title}</span>
                  {tab.badge && <span className="tab-badge">{tab.badge}</span>}
                </TabButton>
              </TabItem>
            ))}
          </TabList>
        </TabsScroll>
        {showRight && (
          <ScrollButton 
            className="right" 
            onClick={() => scrollTabs(1)}
            sx={{ right: "8px" }}
          >
            <FaChevronRight />
          </ScrollButton>
        )}
      </TabsHeader>
      <TabsContent
        onTouchStart={handleTouchStart}
        onTouchEnd={handleTouchEnd}
      >
        {tabs[activeIndex]?.content}
      </TabsContent>
    </TabsWrapper>
  );
};

export default DynamicTabs;
