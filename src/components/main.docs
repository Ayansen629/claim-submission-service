// Track if GRT value has been changed from original
const [originalGrt, setOriginalGrt] = useState("");
const [grtChanged, setGrtChanged] = useState(false);

// Set original GRT value when component mounts in edit mode
useEffect(() => {
  if (editMode && grossTonnage && !originalGrt) {
    setOriginalGrt(grossTonnage);
  }
}, [editMode, grossTonnage, originalGrt]);

// Track GRT changes
useEffect(() => {
  if (editMode && originalGrt && grossTonnage !== originalGrt) {
    setGrtChanged(true);
  } else if (editMode && originalGrt && grossTonnage === originalGrt) {
    setGrtChanged(false);
  }
}, [editMode, grossTonnage, originalGrt]);

// Check if tonnage and stability booklets are required
const isTonnageRequired = () => {
  if (editMode) {
    const existingTonnageFile = getValues("tonnageBooklets");
    const hasFileId = existingTonnageFile?.id;
    
    // Required if: has file ID OR GRT value was changed
    return !!(hasFileId || grtChanged);
  }
  return false;
};

const isStabilityRequired = () => {
  if (editMode) {
    const existingStabilityFile = getValues("stabilityBooklets");
    const hasFileId = existingStabilityFile?.id;
    
    // Required if: has file ID OR GRT value was changed
    return !!(hasFileId || grtChanged);
  }
  return false;
};

// Trigger validation when GRT changes or file IDs exist
useEffect(() => {
  if (editMode) {
    setTimeout(() => {
      const tonnageFile = getValues("tonnageBooklets");
      const stabilityFile = getValues("stabilityBooklets");
      
      // Check tonnage requirement
      if (isTonnageRequired()) {
        if (!tonnageFile || !tonnageFile.name) {
          setError("tonnageBooklets", {
            type: "required",
            message: grtChanged 
              ? t('Tonnage Booklets is required when GRT value is changed')
              : t('Tonnage Booklets is required')
          });
        } else {
          clearErrors("tonnageBooklets");
        }
      } else {
        clearErrors("tonnageBooklets");
      }
      
      // Check stability requirement
      if (isStabilityRequired()) {
        if (!stabilityFile || !stabilityFile.name) {
          setError("stabilityBooklets", {
            type: "required", 
            message: grtChanged 
              ? t('Stability Booklets is required when GRT value is changed')
              : t('Stability Booklets is required')
          });
        } else {
          clearErrors("stabilityBooklets");
        }
      } else {
        clearErrors("stabilityBooklets");
      }
    }, 100);
  } else {
    // Clear errors in normal mode
    clearErrors(["tonnageBooklets", "stabilityBooklets"]);
  }
}, [grossTonnage, grtChanged, editMode, getValues, setError, clearErrors, t]);
