.checkboxContainer {
  margin-top: 16px;
  padding: 12px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.checkboxLabel {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  cursor: pointer;
  margin: 0;
}

.checkbox {
  margin-top: 2px;
  width: 16px;
  height: 16px;
  cursor: pointer;
}

.checkboxText {
  font-size: 0.8rem;
  color: #333;
  line-height: 1.4;
  flex: 1;
}

.certificationBox .checkboxContainer {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid #ddd;
}

.certificationBox .checkboxText {
  color: #333;
}

.validityBox .checkboxContainer {
  background: #fff;
  border: 1px solid #ddd;
}
