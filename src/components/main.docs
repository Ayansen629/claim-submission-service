useEffect(() => {
  if (id) {
    handleApplicatioNFormView({ uuid: id });
  } else {
    // Check local storage for existing application data
    const savedApplicationDetails = localStorage.getItem('applicationDetails');
    if (savedApplicationDetails) {
      const parsedDetails = JSON.parse(savedApplicationDetails);
      updateRegistrationData('applicationDetails', parsedDetails);
      setFormData(prev => ({
        ...prev,
        creditorBasicDetailsUuid: parsedDetails.creditorBasicDetails?.uuid || "",
        claimDetailsUuid: parsedDetails.claimDetails?.uuid || "",
        signatoryDetailsUuid: parsedDetails.signatoryDetails?.uuid || ""
      }));
    }
  }
}, [id]);
