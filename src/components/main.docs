<Dropdown align="end">
  <OverlayTrigger
    placement="top"
    overlay={
      <BSTooltip id={`tooltip-${row?.id}`}>
        More Actions
      </BSTooltip>
    }
  >
    <Dropdown.Toggle
      variant="link"
      id={`dropdown-${row?.id}`}
      className="action-toggle p-2 rounded-circle"
      style={{
        border: "1px solid #e0e6ed",
        backgroundColor: "#ffffff",
        color: "#6c757d",
        transition: "all 0.2s ease",
        boxShadow: "0 2px 4px rgba(0,0,0,0.08)",
      }}
      onMouseEnter={(e) => {
        e.currentTarget.style.backgroundColor = "#f8f9fa";
        e.currentTarget.style.borderColor = "#2E57A7";
        e.currentTarget.style.color = "#2E57A7";
        e.currentTarget.style.transform = "scale(1.05)";
      }}
      onMouseLeave={(e) => {
        e.currentTarget.style.backgroundColor = "#ffffff";
        e.currentTarget.style.borderColor = "#e0e6ed";
        e.currentTarget.style.color = "#6c757d";
        e.currentTarget.style.transform = "scale(1)";
      }}
    >
      <ThreeDots size={18} />
    </Dropdown.Toggle>
  </OverlayTrigger>

  <Dropdown.Menu 
    className="shadow-lg border-0"
    style={{
      borderRadius: "12px",
      padding: "8px 0",
      minWidth: "220px",
      backgroundColor: "rgba(255, 255, 255, 0.95)",
      backdropFilter: "blur(10px)",
      border: "1px solid rgba(0,0,0,0.08)",
      boxShadow: "0 10px 40px rgba(0,0,0,0.15), 0 4px 12px rgba(0,0,0,0.1)",
      animation: "dropdownFadeIn 0.2s ease-out",
    }}
  >
    {(o.actions.includes("edit") || row?.isEditable) && (
      <Dropdown.Item
        onClick={() => handleEdit(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #667eea 0%, #764ba2 100%)";
          e.currentTarget.style.color = "#fff";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <PencilSquare size={16} className="me-3" />
        Edit
      </Dropdown.Item>
    )}

    {o.actions.includes("view") && (
      <Dropdown.Item
        onClick={() => handleView(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)";
          e.currentTarget.style.color = "#fff";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <FaEye size={16} className="me-3" />
        View
      </Dropdown.Item>
    )}

    {o.actions.includes("download") && (
      <Dropdown.Item
        onClick={() => handleDownload(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <FaDownload size={16} className="me-3" />
        Download
      </Dropdown.Item>
    )}

    {o.actions.includes("upload") && (
      <Dropdown.Item
        onClick={() => handleView(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%)";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <FaUpload size={16} className="me-3" />
        Upload
      </Dropdown.Item>
    )}

    {(o.actions.includes("uploadReports") || row?.isEnableUploadReports) && (
      <Dropdown.Item
        onClick={() => handleUploadReports(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%)";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <Upload size={16} className="me-3" />
        Upload Reports
      </Dropdown.Item>
    )}

    {(o.actions.includes("vesselRegistration") || row?.isEnableApplicationRegistration) && (
      <Dropdown.Item
        onClick={() => handleVesselRegistration(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%)";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <FileEarmarkText size={16} className="me-3" />
        Vessel Registration
      </Dropdown.Item>
    )}

    {(o.actions.includes("provisionalCertificate") || row?.isEnableProvisionalCertificate) && (
      <Dropdown.Item
        onClick={() => handleProvisionalCertificate(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #fad0c4 0%, #ffd1ff 100%)";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <Award size={16} className="me-3" />
        Provisional Certificate
      </Dropdown.Item>
    )}

    {o.actions.includes("revisedDrawing") && (
      <Dropdown.Item
        onClick={() => handleRevisedDrawing(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)";
          e.currentTarget.style.color = "#fff";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <Pencil size={16} className="me-3" />
        Revised Drawing
      </Dropdown.Item>
    )}

    {(o.actions.includes("paySupervisionFee") || row?.isEnableSupervisionFee) && (
      <Dropdown.Item
        onClick={() => handlePaySupervisionFee(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #667eea 0%, #764ba2 100%)";
          e.currentTarget.style.color = "#fff";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <CreditCard size={16} className="me-3" />
        Pay Supervision Fee
      </Dropdown.Item>
    )}

    {(o.actions.includes("applyInitialSurvey") || row?.enableInitialSurvey) && (
      <Dropdown.Item
        onClick={() => handleApplyInitialSurvey(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%)";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <ClipboardCheck size={16} className="me-3" />
        Apply Initial Survey
      </Dropdown.Item>
    )}

    {row?.isCMNGenerated && (
      <Dropdown.Item
        onClick={() => handleDownloadCMN(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #fa709a 0%, #fee140 100%)";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <Download size={16} className="me-3" />
        Download CMN
      </Dropdown.Item>
    )}

    {row?.isCMNGenerated && !row.enableInitialSurvey && (
      <Dropdown.Item
        onClick={() => handleSlotBooking(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%)";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <Calendar2Check size={16} className="me-3" />
        Slot Booking
      </Dropdown.Item>
    )}

    {o.actions.includes("delete") && (
      <>
        <Dropdown.Divider style={{ margin: "8px 0", borderColor: "#f1f3f4" }} />
        <Dropdown.Item
          onClick={() => handleDeleteRow(row)}
          className="d-flex align-items-center px-3 py-2 border-0"
          style={{
            transition: "all 0.2s ease",
            borderRadius: "8px",
            margin: "2px 8px",
            fontSize: "14px",
            fontWeight: "500",
            color: "#dc3545",
          }}
          onMouseEnter={(e) => {
            e.currentTarget.style.background = "linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%)";
            e.currentTarget.style.color = "#fff";
            e.currentTarget.style.transform = "translateX(4px)";
          }}
          onMouseLeave={(e) => {
            e.currentTarget.style.background = "transparent";
            e.currentTarget.style.color = "#dc3545";
            e.currentTarget.style.transform = "translateX(0)";
          }}
        >
          <FaTrash size={16} className="me-3" />
          Delete
        </Dropdown.Item>
      </>
    )}
  </Dropdown.Menu>
</Dropdown>
