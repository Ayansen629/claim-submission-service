// Header.js
import React, { useState } from "react";
import { FaBars, FaUserCircle, FaBell, FaSearch } from "react-icons/fa";
import { IoMdNotifications } from "react-icons/io";
import "./Header.css";

const Header = ({ toggleSidebar, onLogout, isSidebarOpen }) => {
  const [notifications, setNotifications] = useState([]);
  const [searchQuery, setSearchQuery] = useState("");
  const [userMenuOpen, setUserMenuOpen] = useState(false);
  const [notificationsOpen, setNotificationsOpen] = useState(false);

  return (
    <header className="custom-header">
      <div className="header-left">
        <button
          className="sidebar-toggle"
          onClick={toggleSidebar}
          aria-label="Toggle Sidebar"
        >
          {isSidebarOpen ? <FaTimes /> : <FaBars />}
        </button>
        <div className="header-logo">
          <img
            src={require("../../assets/images/logo-gov.png")}
            alt="Government Logo"
            className="logo-img"
          />
          <h1 className="app-title">Digit Finance</h1>
        </div>
      </div>
      
      <div className="header-search">
        <div className="search-container">
          <FaSearch className="search-icon" />
          <input
            type="text"
            placeholder="Search..."
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
          />
        </div>
      </div>
      
      <div className="header-right">
        <div className="notification-icon-container">
          <button 
            className="notification-icon"
            onClick={() => setNotificationsOpen(!notificationsOpen)}
          >
            <IoMdNotifications />
            {notifications.length > 0 && (
              <span className="notification-badge">{notifications.length}</span>
            )}
          </button>
          
          {notificationsOpen && (
            <div className="notification-dropdown">
              {notifications.length > 0 ? (
                notifications.map((notification) => (
                  <div key={notification.id} className="notification-item">
                    {notification.message}
                  </div>
                ))
              ) : (
                <div className="notification-empty">No new notifications</div>
              )}
            </div>
          )}
        </div>
        
        <div className="user-menu-container">
          <button 
            className="user-profile"
            onClick={() => setUserMenuOpen(!userMenuOpen)}
          >
            <FaUserCircle className="user-avatar" />
            <span className="user-name">Admin User</span>
          </button>
          
          {userMenuOpen && (
            <div className="user-dropdown">
              <div className="user-dropdown-header">
                <FaUserCircle className="dropdown-avatar" />
                <div>
                  <div className="user-dropdown-name">Admin User</div>
                  <div className="user-dropdown-email">admin@digitfinance.gov</div>
                </div>
              </div>
              <div className="dropdown-divider"></div>
              <button className="dropdown-item">My Profile</button>
              <button className="dropdown-item">Settings</button>
              <div className="dropdown-divider"></div>
              <button 
                className="dropdown-item logout-item"
                onClick={onLogout}
              >
                Logout
              </button>
            </div>
          )}
        </div>
      </div>
    </header>
  );
};

export default Header;
