import React, { useRef, useEffect, useMemo, useState } from "react";
import { Form, InputGroup, OverlayTrigger, Tooltip } from "react-bootstrap";
import { FaEye, FaEyeSlash } from "react-icons/fa";
import classNames from "classnames";
import { CONSTANT_REGEX } from "../../utils/constants.ts";

interface InputTextProps {
  label: string;
  required?: boolean;
  name: string;
  type?: string;
  placeholder?: string;
  register?: any;
  disabled?: boolean;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  maxlength?: number;
  readOnly?: boolean;
  errors?: any;
  className?: string;
  onKeyDown?: (e: React.KeyboardEvent<HTMLInputElement>) => void;
  icon?: React.ElementType;
  description?: string;
  style?: React.CSSProperties;
  autoFocus?: boolean;
  watchValue?: string;
}

const InputText: React.FC<InputTextProps> = ({
  label,
  required,
  name,
  type = "text",
  placeholder,
  register,
  disabled,
  onChange,
  maxlength,
  readOnly,
  errors,
  className = "",
  onKeyDown,
  icon: IconComponent,
  description,
  style = {},
  autoFocus,
  watchValue = "",
}) => {
  const [showPassword, setShowPassword] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);

  const isPassword = type === "password";
  const inputType = isPassword ? (showPassword ? "text" : "password") : type;

  const fieldKey = name.includes(".") ? name.split(".").pop() : name;

  const validationPattern = useRef<RegExp | null>(null);

  useEffect(() => {
    if (type === "email") {
      validationPattern.current = CONSTANT_REGEX.EMAIL;
    } else if (name.includes("pan")) {
      validationPattern.current = CONSTANT_REGEX.PAN;
    } else if (name.includes("gst")) {
      validationPattern.current = CONSTANT_REGEX.GSTNO;
    } else if (name.includes("phone") || name.includes("mobile")) {
      validationPattern.current = CONSTANT_REGEX.MOBILE;
    } else if (name.includes("pin")) {
      validationPattern.current = CONSTANT_REGEX.PINCODE;
    } else {
      validationPattern.current = null;
    }
  }, [type, name]);

  // ✅ Recompute isComplete reactively
  const isComplete = useMemo(() => {
    if (!watchValue) return false;

    if (name.includes("pin") && watchValue.length === 6) return true;
    if (validationPattern.current) return validationPattern.current.test(watchValue);
    if (required) return watchValue.trim().length > 0;

    return true;
  }, [watchValue, name, required]);

  const togglePasswordVisibility = () => setShowPassword((prev) => !prev);

  const rawError = errors?.[fieldKey];
  const hasError = rawError && !isComplete;
  const errorMessage = hasError ? rawError.message : "";

  const inputClasses = classNames("shadow-sm w-100", {
    "is-invalid": hasError,
    "border-start-0": IconComponent,
    "border-end-0": isPassword,
    disabled: disabled,
  });

  const getBorderColor = () => {
    if (hasError) return "#dc3545";
    if (isComplete && watchValue) return "#198754";
    return "#ced4da";
  };

  const getBackgroundColor = () => {
    if (hasError) return "#fff8f8";
    if (isComplete && watchValue) return "#f8fff9";
    return "white";
  };

  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      {label && (
        <Form.Label className="fw-semibold d-block">
          {label}
          {required && <span className="text-danger ms-1">*</span>}
        </Form.Label>
      )}

      <InputGroup className="flex-nowrap w-100 flex-md-nowrap flex-wrap">
        {IconComponent && (
          <InputGroup.Text
            className={`bg-white border-end-0 ${
              hasError
                ? "border-danger text-danger"
                : isComplete && watchValue && !hasError
                ? "border-success text-success"
                : ""
            }`}
            style={{
              borderColor: getBorderColor(),
              transition: "all 0.3s ease",
            }}
          >
            <IconComponent
              size={18}
              color={
                hasError
                  ? "#dc3545"
                  : isComplete && watchValue && !hasError
                  ? "#198754"
                  : "#ced4da"
              }
            />
          </InputGroup.Text>
        )}

        <Form.Control
          ref={inputRef}
          type={inputType}
          name={name}
          placeholder={placeholder}
          {...register}
          disabled={disabled}
          onChange={onChange}
          maxLength={maxlength}
          readOnly={readOnly}
          onKeyDown={onKeyDown}
          min={0}
          className={inputClasses}
          aria-label={label}
          style={{
            ...style,
            borderColor: getBorderColor(),
            backgroundColor: getBackgroundColor(),
            transition: "all 0.3s ease",
          }}
          autoFocus={autoFocus}
        />

        {isPassword && (
          <OverlayTrigger
            placement="top"
            overlay={
              <Tooltip id={`tooltip-${name}`}>
                {showPassword ? "Hide password" : "Show password"}
              </Tooltip>
            }
          >
            <InputGroup.Text
              className={`bg-white border-start-0 ${
                hasError
                  ? "border-danger text-danger"
                  : isComplete && watchValue && !hasError
                  ? "border-success text-success"
                  : ""
              }`}
              role="button"
              onClick={togglePasswordVisibility}
              aria-label="Toggle password visibility"
              style={{
                cursor: "pointer",
                borderColor: getBorderColor(),
                transition: "all 0.3s ease",
              }}
            >
              {showPassword ? (
                <FaEyeSlash
                  size={18}
                  color={
                    hasError
                      ? "#dc3545"
                      : isComplete && watchValue && !hasError
                      ? "#198754"
                      : "#387AD4"
                  }
                />
              ) : (
                <FaEye
                  size={18}
                  color={
                    hasError
                      ? "#dc3545"
                      : isComplete && watchValue && !hasError
                      ? "#198754"
                      : "#387AD4"
                  }
                />
              )}
            </InputGroup.Text>
          </OverlayTrigger>
        )}
      </InputGroup>

      {description && (
        <Form.Text style={{ color: "#5A67D8" }} className="d-block mt-1">
          {description}
        </Form.Text>
      )}

      {hasError && (
        <Form.Text className="text-danger d-block">{errorMessage}</Form.Text>
      )}
    </Form.Group>
  );
};

export default InputText;
