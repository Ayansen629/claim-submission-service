import React, { useState, useEffect, useRef } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Button, Card, Badge, Stack } from 'react-bootstrap';
import { FaFileAlt, FaFileUpload, FaArrowLeft, FaArrowRight, FaDownload, FaArrowAltCircleLeft, FaCheckCircle, FaFileExcel, FaUser, FaBuilding } from 'react-icons/fa';
import { BsFileEarmarkX, BsDownload } from 'react-icons/bs';
import { useNavigate, useParams, useLocation } from 'react-router-dom';
import ActionDropdown from '../../../common/ActionDropdown';
import ApprovalModal from '../../../common/ApprovalModal';
import './userViewPage.css';
import NewLoader from '../../../common/NewLoader';
import DynamicViewFields from '../../../common/DynamicViewFields';
import { useTranslation } from 'react-i18next';

const UserViewPage = () => {
  const { t } = useTranslation();
  const { type, id } = useParams();
  const location = useLocation();
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(true);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [completedSteps, setCompletedSteps] = useState(new Set());
  const navigate = useNavigate();
  const actionsFromAPI = ["Approve", "Reject", "Request Changes"];
  const loaderRef = useRef();

  const isOwner = type === 'owner';
  const isBuilder = type === 'builder';
  const totalSteps = isOwner ? 3 : 2;
  const applicationData = location.state?.application;
  const applicationNumber = applicationData?.appNo || `${isOwner ? 'OWN' : 'BLD'}-2025-001`;

  const mockOwnerData = {
    categoryOfOwner: "Individual",
    ownerCompanyName: applicationData?.companyName || "John Doe Marine Services",
    emailId: "john.doe@example.com",
    phoneNumber: applicationData?.phoneNumber || "9876543210",
    panNo: "ABCDE1234F",
    gstNo: "22ABCDE1234F1Z5",
    addressLine1: "123 Marine Drive",
    addressLine2: "Building A",
    pin: "700001",
    district: applicationData?.district || "Kolkata",
    state: applicationData?.stateUt || "West Bengal",
    country: "India",
    authorisedFname: "John",
    authorisedLname: "Doe",
    authorisedMob: "9876543210",
    authorisedEmail: "john.doe@example.com",
    panCardUpload: "pan_card.pdf",
    gstCertificate: "gst_certificate.pdf",
    addressProof: "address_proof.pdf",
    authorizationLetter: "authorization_letter.pdf",
    status: applicationData?.status || "Pending Review"
  };

  const mockBuilderData = {
    builderName: applicationData?.companyName || "Marine Shipyard Pvt Ltd",
    emailId: "info@marineship.com",
    phoneNumber: applicationData?.phoneNumber || "9876543210",
    panNo: "ABCDE1234F",
    gstNo: "22ABCDE1234F1Z5",
    addressLine1: "456 Industrial Area",
    addressLine2: "Sector 5",
    pin: "700002",
    district: applicationData?.district || "Howrah",
    state: applicationData?.stateUt || "West Bengal",
    country: "India",
    companyDetails: "company_details.pdf",
    gstCertificate: "gst_certificate.pdf",
    panCardUpload: "pan_card.pdf",
    factoryLicense: "factory_license.pdf",
    addressProof: "address_proof.pdf",
    fireCertificate: "",
    esipfRegistration: "",
    iso9001: "iso9001.pdf",
    iso14001: "iso14001.pdf",
    iso45001: "",
    pollutionCertificate: "",
    experienceCertificate: "experience.pdf",
    status: applicationData?.status || "Pending Review"
  };

  useEffect(() => {
    setIsLoading(true);
    loaderRef.current?.show?.();
    setTimeout(() => {
      setFormData(isOwner ? mockOwnerData : mockBuilderData);
      setIsLoading(false);
      loaderRef.current?.hide?.();
      setCompletedSteps(new Set([1]));
    }, 500);
  }, [isOwner]);

  const methods = useForm({ defaultValues: { country: 'India' } });
  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading) {
      Object.keys(formData).forEach(key => {
        if (formData[key]) {
          setValue(key, formData[key]);
        }
      });
    }
  }, [isLoading, formData, setValue]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      ...formData,
    };
    console.log("Action submitted:", payload);
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleDownload = (filename) => {
    const blob = new Blob(["Dummy file content"], { type: "text/plain" });
    const link = document.createElement("a");
    link.href = window.URL.createObjectURL(blob);
    link.download = filename;
    link.click();
    window.URL.revokeObjectURL(link.href);
  };

  const noFileFields = ['fireCertificate', 'esipfRegistration', 'iso45001', 'pollutionCertificate'];
  
  const renderFileField = (value, fieldName) => {
    const hasFile = formData[fieldName] && formData[fieldName].trim() !== '';
    const shouldShowNoFile = isBuilder && noFileFields.includes(fieldName) && !hasFile;
    
    return (
      <div className="file-display-container">
        {shouldShowNoFile ? (
          <div className="file-display-no-doc">
            <BsFileEarmarkX className="no-doc-icon text-muted me-2" size={16} />
            <span className="no-doc-text">No document uploaded</span>
          </div>
        ) : (
          <div className="file-display-with-doc">
            <div className="file-info">
              <FaFileExcel className="file-icon text-success me-2" size={16} />
              <span className="file-name">
                {hasFile ? formData[fieldName] : `${fieldName.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase())}.pdf`}
              </span>
            </div>
            <Button
              variant="link"
              size="sm"
              className="file-download-btn"
              onClick={() => handleDownload(hasFile ? formData[fieldName] : `${fieldName}.pdf`)}
              tabIndex={-1}
              title="Download"
            >
              <BsDownload size={12} />
            </Button>
          </div>
        )}
      </div>
    );
  };

  const getFormFieldsConfig = () => {
    if (isOwner) {
      return {
        step1: [
          { name: "categoryOfOwner", label: t("vesselOwnerRegistration.Category of Owner"), type: "text", colSize: 6 },
          { name: "ownerCompanyName", label: t("vesselOwnerRegistration.Owner/Company Name"), type: "text", colSize: 6 },
          { name: "emailId", label: t("vesselOwnerRegistration.Email ID"), type: "email", colSize: 6 },
          { name: "phoneNumber", label: t("vesselOwnerRegistration.Phone Number"), type: "text", colSize: 6 },
          { name: "panNo", label: t("vesselOwnerRegistration.PAN Number"), type: "text", colSize: 6 },
          { name: "gstNo", label: t("vesselOwnerRegistration.GST Number"), type: "text", colSize: 6 },
          { name: "addressLine1", label: t("vesselOwnerRegistration.Address Line-1"), type: "text", colSize: 6 },
          { name: "addressLine2", label: t("vesselOwnerRegistration.Address Line-2"), type: "text", colSize: 6 },
          { name: "pin", label: t("vesselOwnerRegistration.PIN"), type: "text", colSize: 6 },
          { name: "district", label: t("vesselOwnerRegistration.District"), type: "text", colSize: 6 },
          { name: "state", label: t("vesselOwnerRegistration.State / UT"), type: "text", colSize: 6 },
          { name: "country", label: t("vesselOwnerRegistration.Country"), type: "text", colSize: 6 },
        ],
        step2: [
          { name: "authorisedFname", label: t("vesselOwnerRegistration.First Name"), type: "text", colSize: 6 },
          { name: "authorisedLname", label: t("vesselOwnerRegistration.Last Name"), type: "text", colSize: 6 },
          { name: "authorisedMob", label: t("vesselOwnerRegistration.Primary Mobile Number"), type: "text", colSize: 6 },
          { name: "authorisedEmail", label: t("vesselOwnerRegistration.Email ID"), type: "email", colSize: 6 },
          { name: "authorizationLetter", label: t("vesselOwnerRegistration.Letter of Authorization"), type: "file", colSize: 12 },
        ],
        step3: [
          { name: "panCardUpload", label: t("vesselOwnerRegistration.PAN Card"), type: "file", colSize: 6 },
          { name: "gstCertificate", label: t("vesselOwnerRegistration.GST Certificate"), type: "file", colSize: 6 },
          { name: "addressProof", label: t("vesselOwnerRegistration.Address Proof"), type: "file", colSize: 6 },
        ]
      };
    } else {
      return {
        step1: [
          { name: "builderName", label: t("builderRegistration.builderName"), type: "text", colSize: 6 },
          { name: "emailId", label: t("builderRegistration.Email ID"), type: "email", colSize: 6 },
          { name: "phoneNumber", label: t("builderRegistration.Phone Number"), type: "text", colSize: 6 },
          { name: "panNo", label: t("builderRegistration.PAN Number"), type: "text", colSize: 6 },
          { name: "gstNo", label: t("builderRegistration.GST Number"), type: "text", colSize: 6 },
          { name: "addressLine1", label: t("builderRegistration.Address Line-1"), type: "text", colSize: 6 },
          { name: "addressLine2", label: t("builderRegistration.Address Line-2"), type: "text", colSize: 6 },
          { name: "pin", label: t("builderRegistration.PIN"), type: "text", colSize: 6 },
          { name: "district", label: t("builderRegistration.District"), type: "text", colSize: 6 },
          { name: "state", label: t("builderRegistration.State / UT"), type: "text", colSize: 6 },
          { name: "country", label: t("builderRegistration.Country"), type: "text", colSize: 6 },
        ],
        step2: [
          { name: "companyDetails", label: t("builderRegistration.Company Details"), type: "file", colSize: 6 },
          { name: "gstCertificate", label: t("builderRegistration.GST Certificate"), type: "file", colSize: 6 },
          { name: "panCardUpload", label: t("builderRegistration.PAN Card"), type: "file", colSize: 6 },
          { name: "factoryLicense", label: t("builderRegistration.Factory License"), type: "file", colSize: 6 },
          { name: "addressProof", label: t("builderRegistration.Address Proof"), type: "file", colSize: 6 },
          { name: "fireCertificate", label: t("builderRegistration.Fire Certificate"), type: "file", colSize: 6 },
          { name: "esipfRegistration", label: t("builderRegistration.ESIPF Registration"), type: "file", colSize: 6 },
          { name: "iso9001", label: t("builderRegistration.ISO 9001 Certificate"), type: "file", colSize: 6 },
          { name: "iso14001", label: t("builderRegistration.ISO 14001 Certificate"), type: "file", colSize: 6 },
          { name: "iso45001", label: t("builderRegistration.ISO 45001 Certificate"), type: "file", colSize: 6 },
          { name: "pollutionCertificate", label: t("builderRegistration.Pollution Certificate"), type: "file", colSize: 6 },
          { name: "experienceCertificate", label: t("builderRegistration.Experience Certificate"), type: "file", colSize: 6 },
        ]
      };
    }
  };

  const formFields = getFormFieldsConfig();

  const getDisabledFormFieldsConfig = () => {
    const config = {};
    Object.keys(formFields).forEach(stepKey => {
      config[stepKey] = formFields[stepKey].map(field => ({
        ...field,
        disabled: true,
        inputClassName: 'disabled-field',
        render: field.type === 'file' ? (value) => renderFileField(value, field.name) : undefined
      }));
    });
    return config;
  };

  const disabledFormFields = getDisabledFormFieldsConfig();

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return disabledFormFields.step1;
      case 2: return disabledFormFields.step2;
      case 3: return disabledFormFields.step3 || [];
      default: return [];
    }
  };

  const handleNext = () => {
    if (currentStep < totalSteps) {
      setCompletedSteps(prev => new Set([...prev, currentStep]));
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const handleBackToList = () => {
    navigate('/dashboard');
  };

  const getStatusBadge = (status) => {
    const statusMap = {
      'Pending Review': 'warning',
      'Pending': 'warning',
      'Approved': 'success',
      'Completed': 'success',
      'Rejected': 'danger',
      'Processing': 'info'
    };
    return <Badge bg={statusMap[status] || 'secondary'} className="status-badge">{status}</Badge>;
  };

  const getStepIcon = (stepNumber) => {
    if (completedSteps.has(stepNumber)) {
      return <FaCheckCircle className="text-white" size={18} />;
    }
    
    if (isOwner) {
      const ownerIcons = [FaUser, FaUser, FaFileUpload];
      return currentStep === stepNumber ? 
        React.createElement(ownerIcons[stepNumber - 1], { className: "text-white", size: 16 }) : 
        stepNumber;
    } else {
      const builderIcons = [FaBuilding, FaFileUpload];
      return currentStep === stepNumber ? 
        React.createElement(builderIcons[stepNumber - 1], { className: "text-white", size: 16 }) : 
        stepNumber;
    }
  };

  const getStepTitles = () => {
    if (isOwner) {
      return [
        t("vesselOwnerRegistration.Vessel Owner Details"),
        t("vesselOwnerRegistration.Authorized Person's Details"),
        t("vesselOwnerRegistration.Documents Upload")
      ];
    } else {
      return [
        t("builderRegistration.Vessel Builder Details"),
        t("builderRegistration.Documents Upload")
      ];
    }
  };

  const stepTitles = getStepTitles();

  if (isLoading) {
    return <NewLoader ref={loaderRef} />;
  }

  return (
    <>
      <Container fluid className="py-4 officer-view-container">
        <Row className="justify-content-center">
          <Col size={12}>
            <Card className="shadow-lg border-0 modern-card">
              <Card.Header className="modern-header">
                <Stack direction="horizontal" gap={3} className="flex-wrap justify-content-between align-items-center">
                  <button
                    className="btn back-button modern-back-btn"
                    onClick={handleBackToList}
                  >
                    <FaArrowAltCircleLeft size={20} className="text-primary" />
                  </button>

                  <div className="flex-grow-1 d-flex flex-column align-items-center">
                    <div className="d-flex flex-wrap align-items-center justify-content-center gap-2">
                      <span className="application-label">Application Number:</span>
                      <span className="application-number">
                        {applicationNumber}
                      </span>
                    </div>
                  </div>
                  
                  <div className="status-container">
                    {getStatusBadge(formData.status)}
                  </div>
                </Stack>
              </Card.Header>

              <Card.Body className="modern-body">
                <div className="modern-stepper-wrapper">
                  {Array.from({ length: totalSteps }, (_, i) => i + 1).map((step, index) => (
                    <React.Fragment key={step}>
                      <div className={`modern-stepper-item ${currentStep === step ? 'active' : ''} ${completedSteps.has(step) ? 'completed' : ''}`}>
                        <div className="modern-step-counter">
                          {getStepIcon(step)}
                        </div>
                        <div className="modern-step-name">{stepTitles[step - 1]}</div>
                      </div>
                      
                      {index < totalSteps - 1 && (
                        <div className="stepper-connector"></div>
                      )}
                    </React.Fragment>
                  ))}
                </div>

                <FormProvider {...methods}>
                  <form>
                    <div className="form-content">
                      <Row className="g-4">
                        <DynamicViewFields
                          fields={getCurrentStepFields()}
                          setFormData={setFormData}
                        />
                      </Row>
                    </div>

                    <div className="navigation-footer">
                      <Button
                        variant="outline-primary"
                        onClick={handlePrevious}
                        disabled={currentStep === 1}
                        className="nav-btn prev-btn"
                      >
                        <FaArrowLeft className="me-2" size={14} /> Previous
                      </Button>
                      
                      {currentStep < totalSteps ? (
                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="nav-btn next-btn"
                        >
                          Next <FaArrowRight className="ms-2" size={14} />
                        </Button>
                      ) : (
                        <ActionDropdown
                          actions={actionsFromAPI}
                          onActionClick={handleActionClick}
                          variant="primary"
                          className="action-dropdown"
                        />
                      )}
                    </div>
                  </form>
                </FormProvider>
              </Card.Body>
            </Card>
          </Col>
        </Row>

        <ApprovalModal
          show={showApprovalModal}
          handleClose={handleCloseModal}
          handleSubmitData={handleActionSubmit}
          selectedAction={selectedAction}
        />
      </Container>
    </>
  );
};

export default UserViewPage;
.officer-view-container {
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  min-height: 100vh;
  padding: 2rem 1rem;
}

.modern-card {
  border-radius: 16px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  border: none;
  overflow: hidden;
}

.modern-header {
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  border-bottom: 1px solid #e2e8f0;
  padding: 2rem;
}

.modern-back-btn {
  background: none;
  border: none;
  padding: 0.5rem;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.modern-back-btn:hover {
  background: rgba(59, 130, 246, 0.1);
  transform: translateX(-2px);
}

.application-label {
  font-size: 1rem;
  font-weight: 600;
  color: #64748b;
  letter-spacing: 0.025em;
}

.application-number {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: white;
  padding: 0.5rem 1.25rem;
  border-radius: 25px;
  font-weight: 700;
  font-size: 0.95rem;
  letter-spacing: 0.05em;
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}

.status-container {
  min-width: 120px;
  text-align: center;
}

.status-badge {
  font-size: 0.85rem;
  padding: 0.6rem 1.2rem;
  border-radius: 20px;
  font-weight: 600;
  letter-spacing: 0.025em;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.modern-body {
  padding: 2.5rem;
  background: #ffffff;
}

.modern-stepper-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 3rem;
  position: relative;
}

.modern-stepper-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
}

.stepper-connector {
  flex: 1;
  height: 3px;
  background: linear-gradient(90deg, #e2e8f0 0%, #cbd5e1 100%);
  margin: 0 2rem;
  border-radius: 2px;
  position: relative;
}

.modern-stepper-item.completed ~ .stepper-connector::before,
.modern-stepper-item.active ~ .stepper-connector::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, #10b981 0%, #059669 100%);
  border-radius: 2px;
  width: 100%;
  transition: width 0.5s ease;
}

.modern-step-counter {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 1rem;
  margin-bottom: 0.75rem;
  transition: all 0.3s ease;
  background: #e2e8f0;
  color: #64748b;
  border: 2px solid #e2e8f0;
}

.modern-stepper-item.active .modern-step-counter {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: white;
  border-color: #3b82f6;
  box-shadow: 0 3px 10px rgba(59, 130, 246, 0.3);
  transform: scale(1.02);
}

.modern-stepper-item.completed .modern-step-counter {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: white;
  border-color: #10b981;
  box-shadow: 0 3px 10px rgba(16, 185, 129, 0.3);
}

.modern-step-name {
  font-size: 0.9rem;
  font-weight: 600;
  color: #64748b;
  text-align: center;
  letter-spacing: 0.025em;
}

.modern-stepper-item.active .modern-step-name {
  color: #3b82f6;
  font-weight: 700;
}

.modern-stepper-item.completed .modern-step-name {
  color: #10b981;
  font-weight: 700;
}

.form-content {
  padding: 1.5rem 0;
}

.disabled-field {
  background-color: #f8fafc !important;
  border: 1.5px solid #e2e8f0 !important;
  border-radius: 6px !important;
  color: #475569 !important;
  font-weight: 500;
  font-size: 0.9rem;
}

.file-display-container {
  width: 100%;
}

.file-display-with-doc {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem 0.8rem;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border: 1.5px solid #0ea5e9;
  border-radius: 6px;
  transition: all 0.2s ease;
  min-height: 40px;
}

.file-display-with-doc:hover {
  box-shadow: 0 2px 8px rgba(14, 165, 233, 0.15);
  border-color: #0284c7;
}

.file-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.file-name {
  font-weight: 600;
  color: #0369a1;
  font-size: 0.85rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200px;
}

.file-download-btn {
  color: #059669 !important;
  padding: 0.2rem 0.3rem !important;
  border-radius: 4px;
  transition: all 0.2s ease;
  text-decoration: none !important;
  min-width: auto;
  background: rgba(5, 150, 105, 0.1);
  border: 1px solid rgba(5, 150, 105, 0.2);
}

.file-download-btn:hover {
  background: rgba(5, 150, 105, 0.2);
  transform: scale(1.05);
  color: #047857 !important;
}

.file-display-no-doc {
  display: flex;
  align-items: center;
  padding: 0.6rem 0.8rem;
  background: #f8fafc;
  border: 1.5px dashed #cbd5e1;
  border-radius: 6px;
  min-height: 40px;
}

.no-doc-text {
  font-weight: 500;
  color: #64748b;
  font-size: 0.85rem;
  font-style: italic;
}

.navigation-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 2px solid #f1f5f9;
}

.nav-btn {
  padding: 0.7rem 1.8rem;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.85rem;
  letter-spacing: 0.025em;
  transition: all 0.2s ease;
  border: 1.5px solid;
}

.prev-btn {
  border-color: #3b82f6;
  color: #3b82f6;
  background: white;
}

.prev-btn:hover:not(:disabled) {
  background: #3b82f6;
  color: white;
  transform: translateX(-1px);
}

.next-btn {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  border-color: #3b82f6;
  color: white;
  box-shadow: 0 3px 10px rgba(59, 130, 246, 0.3);
}

.next-btn:hover {
  transform: translateX(1px);
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
}

.action-dropdown {
  padding: 0.7rem 1.8rem;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.85rem;
}

@media (max-width: 768px) {
  .officer-view-container {
    padding: 1rem 0.5rem;
  }
  
  .modern-header {
    padding: 1.5rem;
  }
  
  .modern-body {
    padding: 1.5rem;
  }
  
  .modern-stepper-wrapper {
    flex-direction: column;
    gap: 1rem;
  }
  
  .stepper-connector {
    width: 3px;
    height: 2rem;
    margin: 0;
  }
  
  .navigation-footer {
    flex-direction: column;
    gap: 1rem;
  }
  
  .nav-btn {
    width: 100%;
    justify-content: center;
  }
  
  .application-label {
    font-size: 0.9rem;
  }
  
  .application-number {
    font-size: 0.85rem;
    padding: 0.4rem 1rem;
  }
  
  .modern-step-name {
    font-size: 0.8rem;
  }
  
  .file-name {
    max-width: 150px;
  }
}
