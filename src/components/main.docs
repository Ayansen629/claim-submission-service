import React from "react";
import { Box, Typography, Divider, Stack } from "@mui/material";
import Stepper from "../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import { useForm } from "react-hook-form";

const StepTwo = () => <div>Step 2 Content</div>;
const StepThree = () => <div>Step 3 Content</div>;

const NewVesselRegistration = () => {
  const methods = useForm();
  const { trigger } = methods;

  const steps = [
    {
      label: "Vessel Details",
      component: <VesselDetails />,
      validate: () => false,
    },
    {
      label: "Invoicing",
      component: <StepTwo />,
      validate: () => false,
    },
    {
      label: "Final Payment",
      component: <StepThree />,
      validate: () => true,
    },
  ];


  const handleSave = () => {
    alert("All steps saved!");
  };

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {/* Clean Header */}
      <Stack spacing={0.5}>
        <Typography
          sx={{
            fontWeight: 550,
            color: "#2E57A7",
            fontSize: "1.2rem", // Smaller, refined font
          }}
        >
          New Vessel Registration
          &nbsp;
          <span style={{ color: "#666", fontSize: "0.65rem" }}>
            (Fill in the vessel details to complete registration)
          </span>
        </Typography>

      </Stack>

      {/* Stepper */}
      <Stepper steps={steps} onSave={handleSave} trigger={trigger} />
    </Box>
  );
};

export default NewVesselRegistration;

import React from "react";
import { useForm } from "react-hook-form";
import { Row, Col, Card } from "react-bootstrap";
import InputText from "../../common/InputText.tsx";
import InputSelect from "../../common/InputSelect.tsx";
import InputRadio from "../../common/InputRadio.tsx";
import InputFile from "../../common/InputFile.jsx";

const VesselDetails = () => {
    const {
        register,
        handleSubmit,
        formState: { errors },
    } = useForm({
        defaultValues: {
            ownerName: "",
            ownerAddress: "",
            mobile: "",
            email: "",
            pan: "",
            aadhar: "",
            tradeLicence: "",
            gst: "",
            vesselType: "",
            category: "",
            zone: "",
            supervisionAuthority: "",
            purchaseType: "",
            classificationSociety: "",
            constructedBy: '1',
            builder: '',
            builderName: '',
            builderAddress: '',
            builderEmail: '',
            builderMobile: '',
            builderTradeLicence: '',
            builderGST: '',
            builderAuth: '',
            authLetter: '',
            workOrderValue: ''

        },
    });

    const onSubmit = (data) => {
        console.log("Form Submitted:", data);
    };

    const headerStyle = {
        backgroundColor: "#EAF1FB",
        color: "#2466BF",
        fontWeight: 600,
        borderRadius: "0.4rem",
        padding: "0.75rem 1rem",
    };

    return (
        <form onSubmit={handleSubmit(onSubmit)}>
            {/* Owner Details Header */}
            <Card className="bg-transparent">
                <Card.Header style={headerStyle}>Basic Information</Card.Header>
            </Card>
            <Row className="gy-3" style={{ padding: '1rem' }}>
                <Col md={4}>
                    <InputText
                        label="Name of Owner"
                        name="ownerName"
                        placeholder="Please enter Name of Owner"
                        required
                        register={{
                            ...register("ownerName", { required: "Name is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="Address of Owner"
                        name="ownerAddress"
                        placeholder="Please enter Address of Owner"
                        required
                        register={{
                            ...register("ownerAddress", { required: "Address is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="Mobile"
                        name="mobile"
                        placeholder="Please enter Mobile"
                        required
                        register={{
                            ...register("mobile", { required: "Mobile is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="Email Id"
                        name="email"
                        placeholder="Please enter Email Id"
                        required
                        register={{
                            ...register("email", { required: "Email is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="PAN"
                        name="pan"
                        placeholder="Please enter PAN"
                        required
                        register={{
                            ...register("pan", { required: "PAN is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="Aadhar"
                        name="aadhar"
                        placeholder="Please enter Aadhar"
                        required
                        register={{
                            ...register("aadhar", { required: "Aadhar is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
            </Row>

            <Row className="gy-3" style={{ padding: '1rem' }}>
                <Col md={4}>
                    <InputText
                        label="Trade Licence"
                        name="tradeLicence"
                        placeholder="Please enter Trade Licence"
                        required
                        register={{
                            ...register("tradeLicence", { required: "Trade Licence is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="GST"
                        name="gst"
                        placeholder="Please enter GST"
                        required
                        register={{
                            ...register("gst", { required: "GST is required" }),
                        }}
                        errors={errors}
                    />
                </Col>
            </Row>

            <Row className="gy-3" style={{ padding: '1rem' }}>
                <Col md={4}>
                    <InputSelect
                        label="Type of Vessel"
                        name="vesselType"
                        required
                        options={[
                            { value: "new", label: "New Vessel" },
                            { value: "old", label: "Old Vessel" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Vessel Type:", val)}
                    />
                </Col>
                <Col md={4}>
                    <InputSelect
                        label="Category"
                        name="category"
                        required
                        options={[
                            { value: "A", label: "Category A" },
                            { value: "B", label: "Category B" },
                            { value: "C", label: "Category C" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Category:", val)}
                    />
                </Col>
                <Col md={4}>
                    <InputSelect
                        label="Zone"
                        name="zone"
                        options={[
                            { value: "1", label: "Zone 1" },
                            { value: "2", label: "Zone 2" },
                            { value: "3", label: "Zone 3" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Zone:", val)}
                    />
                </Col>
                <Col md={4}>
                    <InputSelect
                        label="Supervision Authority"
                        name="supervisionAuthority"
                        options={[
                            { value: "iwt", label: "IWT" },
                            { value: "classificationSociety", label: "Classification Society" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Authority:", val)}
                    />
                </Col>
                <Col md={4}>
                    <InputSelect
                        label="Purchase Type"
                        name="purchaseType"
                        options={[
                            { value: "new", label: "New" },
                            { value: "used", label: "Used" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Purchase Type:", val)}
                    />
                </Col>
                <Col md={4}>
                    <InputText
                        label="Name of the Classification Society"
                        name="classificationSociety"
                        placeholder="Please enter Name of the Classification Society"
                        register={{
                            ...register("classificationSociety"),
                        }}
                        errors={errors}
                    />
                </Col>
            </Row>

            <Row className="gy-3" style={{ padding: '1rem' }}>
                <Col md={6}>
                    <InputRadio
                        name="constructedBy"
                        label=" Constructed By ?"
                        options={[
                            { label: "Self", value: '1' },
                            { label: "Builder", value: '2' },
                        ]}
                        register={register}
                        rules={{ required: "Please select a Contructor Type" }}
                        errors={errors}
                    />
                </Col>


                <Col md={6}>
                    <InputSelect
                        label="Builder"
                        name="builder"
                        required
                        options={[
                            { value: "builder1", label: "Builder 1" },
                            { value: "builder2", label: "Builder 2" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Builder Type:", val)}
                    />
                </Col>



            </Row>


            <Card className="bg-transparent">
                <Card.Header style={headerStyle}>Builder Details</Card.Header>
            </Card>
            <Row className="gy-3" style={{ padding: '1rem' }}>
                <Col md={4}>
                    <InputText
                        label="Builder Name"
                        name="builderName"
                        required
                        placeholder="Please enter Builder Name"
                        register={{
                            ...register("builderName"),
                        }}
                        errors={errors}
                    />
                </Col>

                <Col md={4}>
                    <InputText
                        label="Builder Address"
                        name="builderAddress"
                        required
                        placeholder="Please enter Builder Address"
                        register={{
                            ...register("builderAddress"),
                        }}
                        errors={errors}
                    />
                </Col>

                <Col md={4}>
                    <InputText
                        label="Builder Email Id"
                        name="builderEmail"
                        required
                        placeholder="Please enter Builder Email Id"
                        register={{
                            ...register("builderEmail"),
                        }}
                        errors={errors}
                    />
                </Col>

                <Col md={4}>
                    <InputText
                        label="Mobile"
                        name="builderMobile"
                        required
                        placeholder="Please enter Mobile"
                        register={{
                            ...register("builderMobile"),
                        }}
                        errors={errors}
                    />
                </Col>

                <Col md={4}>
                    <InputText
                        label="Trade Licence"
                        name="builderTradeLicence"
                        required
                        placeholder="Please enter Trade Licence"
                        register={{
                            ...register("builderTradeLicence"),
                        }}
                        errors={errors}
                    />
                </Col>

                <Col md={4}>
                    <InputText
                        label="GST"
                        name="builderGST"
                        required
                        placeholder="Please enter GST"
                        register={{
                            ...register("builderGST"),
                        }}
                        errors={errors}
                    />
                </Col>

                <Col md={4}>
                    <InputSelect
                        label="Builder Authorization"
                        name="builderAuth"
                        required
                        options={[
                            { value: "auth", label: "Authorized" },
                            { value: "rejected", label: "Rejected" },
                        ]}
                        register={register}
                        errors={errors}
                        defaultValue={""}
                        onChange={(val) => console.log("Selected Builder Type:", val)}
                    />
                </Col>


                <Col md={4}>
                    <InputFile
                        label="Authorisation Letter"
                        name="authLetter"
                        required
                        placeholder="Please upload Authorisation Letter"
                        register={{
                            ...register("authLetter"),
                        }}
                        errors={errors}
                    />
                </Col>


                <Col md={4}>
                    <InputText
                        label="Work Order Value"
                        name="workOrderValue"
                        required
                        placeholder="Enter Work Order Value"
                        register={{
                            ...register("workOrderValue"),
                        }}
                        errors={errors}
                    />
                </Col>

            </Row>



            <Card className="bg-transparent">
                <Card.Header style={headerStyle}>Documents</Card.Header>
            </Card>

        </form>
    );
};

export default VesselDetails;
import React, { useState } from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";

const themeColor = "#2E57A7";
const errorColor = "#dc3545";
const successColor = "#28a745";

const Stepper = ({ steps, onSave }) => {
  const [activeStep, setActiveStep] = useState(0);
  const [completed, setCompleted] = useState({});
  const [errors, setErrors] = useState({});

  const totalSteps = steps.length;

  const validateStep = async () => {
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      try {
        const isValid = await currentStep.validate();
        setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
        return isValid;
      } catch {
        setErrors((prev) => ({ ...prev, [activeStep]: true }));
        return false;
      }
    }
    return true;
  };

  const handleNext = async () => {
    const valid = await validateStep();
    if (valid) {
      setCompleted({ ...completed, [activeStep]: true });
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
    } else {
      toast.error("Please fix the errors before proceeding.");
    }
  };

  const handleBack = () => {
    setActiveStep((prev) => Math.max(prev - 1, 0));
  };

  const handleSave = async () => {
    const valid = await validateStep();
    if (valid) {
      setCompleted({ ...completed, [activeStep]: true });
      onSave();
    } else {
      toast.error("Please fix the errors before proceeding.");
    }
  };

  return (
    <Box sx={{ width: "100%", padding: "1rem" }}>
      {/* Step Header */}
      <Paper
        elevation={3}
        sx={{
          padding: "0.75rem 1.5rem",
          borderRadius: "0.75rem",
          overflowX: "auto",
          whiteSpace: "nowrap",
          backgroundColor: "#fafafa",
        }}
      >
        <Stack direction="row" alignItems="center" spacing={1}>
          {steps.map((step, index) => (
            <React.Fragment key={index}>
              <Stack
                direction="row"
                alignItems="center"
                spacing={0.5}
                sx={{ cursor: "pointer" }}
                onClick={() => setActiveStep(index)}
              >
                {completed[index] ? (
                  <CheckCircleFill size={18} color={successColor} />
                ) : (
                  <Typography
                    sx={{
                      fontSize: "0.875rem",
                      width: "1.5rem",
                      height: "1.5rem",
                      textAlign: "center",
                      borderRadius: "50%",
                      backgroundColor: "#e0e0e0",
                      display: "inline-flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: "bold",
                      color: "#666",
                    }}
                  >
                    {index + 1}
                  </Typography>
                )}

                {/* Step Label */}
                <Typography
                  sx={{
                    fontWeight: index === activeStep ? "bold" : "normal",
                    color: index === activeStep ? themeColor : "#999",
                    fontSize: "0.875rem",
                    whiteSpace: "nowrap",
                  }}
                >
                  {step.label}
                </Typography>
              </Stack>

              {index < steps.length - 1 && <ChevronRight size={14} color="#ccc" />}
            </React.Fragment>
          ))}
        </Stack>
      </Paper>

      {/* Step Content */}
      <Paper
        elevation={2}
        sx={{
          marginTop: "1rem",
          borderRadius: "0.75rem",
          backgroundColor: "#fff",
          width: "100%",
        }}
      >
        {steps[activeStep].component}
        {errors[activeStep] }
      </Paper>

      <Divider sx={{ margin: "2rem 0" }} />

      {/* Navigation Buttons */}
      <Box
        sx={{
          display: "flex",
          justifyContent: "space-between",
          gap: "1rem",
          flexWrap: "wrap",
        }}
      >
        <Button
          variant="outlined"
          onClick={handleBack}
          disabled={activeStep === 0}
          sx={{
            color: themeColor,
            borderColor: themeColor,
            fontWeight: "bold",
            borderRadius: "0.5rem",
            minWidth: "8rem",
            fontSize: "0.9rem",
          }}
        >
          Previous
        </Button>
        {activeStep === totalSteps - 1 ? (
          <Button
            variant="contained"
            onClick={handleSave}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            Save
          </Button>
        ) : (
          <Button
            variant="contained"
            onClick={handleNext}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            Next
          </Button>
        )}
      </Box>
    </Box>
  );
};

export default Stepper;

// InputFile.tsx
import React, { useState, useEffect } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaCheckCircle } from "react-icons/fa";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  register?: any;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
  defaultValue?: string;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  register,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  style = {},
  watch,
  defaultValue
}) => {
  const hasError = errors && errors[name];
  // const [fileName, setFileName] = useState<string>(defaultValue && defaultValue.trim() !== "" ? defaultValue : "");
  
  // // Update fileName when component mounts or watch value changes
  // useEffect(() => {
  //   // Check if there's a value from watch
  //   if (watch) {
  //     const value = watch(name);
  //     if (value && typeof value === 'string' && value.trim() !== "") {
  //       console.log(`InputFile ${name} watch value:`, value);
  //       setFileName(value);
  //     }
  //   }
    
  //   // Also check defaultValue on mount
  //   if (defaultValue && defaultValue.trim() !== "" && !fileName) {
  //     setFileName(defaultValue);
  //   }
  // }, [watch, name, defaultValue]);
  
// Fix the useState initialization in InputFile.tsx
const [fileName, setFileName] = useState<string>(
  defaultValue && typeof defaultValue === 'string' && defaultValue.trim() !== "" 
    ? defaultValue 
    : ""
);

// Also fix the useEffect check
useEffect(() => {
  // Check if there's a value from watch
  if (watch) {
    const value = watch(name);
    if (value && typeof value === 'string' && value.trim() !== "") {
      console.log(`InputFile ${name} watch value:`, value);
      setFileName(value);
    }
  }
  
  // Also check defaultValue on mount
  if (defaultValue && typeof defaultValue === 'string' && defaultValue.trim() !== "" && !fileName) {
    setFileName(defaultValue);
  }
}, [watch, name, defaultValue]);

  
  // Handle file change internally
  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files[0]) {
      const file = e.target.files[0];
      setFileName(file.name);
      console.log(`File selected for ${name}:`, file.name);
    }
    
    // Call the parent onChange handler if provided
    if (onChange) {
      onChange(e);
    }
  };
  
  // Get file icon based on extension
  const getFileIcon = () => {
    if (!fileName || typeof fileName !== 'string') return <FaFile color="#0d6efd" />;
    
    const extension = fileName.split('.').pop()?.toLowerCase();
    
    if (extension === 'pdf') return <FaFilePdf color="#dc3545" />;
    if (['jpg', 'jpeg', 'png', 'gif'].includes(extension || '')) return <FaFileImage color="#28a745" />;
    return <FaFile color="#0d6efd" />;
  };
  
  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      <div 
        className={`file-upload border rounded p-3 ${hasError ? 'border-danger' : ''}`} 
        style={{
          ...style,
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderColor: hasError ? '#dc3545' : '#ced4da',
          borderRadius: '8px',
          transition: 'all 0.3s ease'
        }}
      >
        <div className="d-flex align-items-center justify-content-between">
          <label 
            htmlFor={name} 
            className={`file-label btn ${hasError ? 'btn-outline-danger' : 'btn-primary'} mb-0 d-inline-flex align-items-center`}
            style={{ 
              borderRadius: '6px',
              padding: '8px 16px',
              cursor: 'pointer',
              boxShadow: '0 2px 5px rgba(0,0,0,0.1)',
              transition: 'all 0.3s ease',
              minWidth: '120px'
            }}
          >
            <FaUpload className="file-icon me-2" />
            <span className="file-text">Choose File</span>
          </label>
          
          <div 
            className={`file-name-container ms-3 flex-grow-1 border rounded px-3 py-2 ${fileName ? 'bg-light-success' : 'bg-light'} d-flex align-items-center ${hasError ? 'border-danger' : fileName ? 'border-success' : ''}`}
            style={{
              backgroundColor: fileName ? '#f0f9f0' : '#f8f9fa'
            }}
          >
            {fileName ? (
              <>
                <FaCheckCircle className="text-success me-2" />
                <div>
                  <span className="text-success fw-bold" style={{ fontSize: '0.8rem' }}>Selected File:</span>
                  <div className="d-flex align-items-center">
                    <span className="file-icon-preview me-2">{getFileIcon()}</span>
                    <span className="text-dark fw-semibold" style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                      {fileName}
                    </span>
                  </div>
                </div>
              </>
            ) : (
              <span className="text-muted">No file chosen</span>
            )}
          </div>
        </div>
        
        <input 
          type="file" 
          id={name}
          {...register}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="file-input d-none"
        />
      </div>
      
      <Form.Text className="text-muted small mt-1">
        Upload PDF, JPG or PNG file (Max size: 2MB)
      </Form.Text>
      
      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
