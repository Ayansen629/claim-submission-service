/* Main modal styling */
.appointment-modal .modal-content {
  border-radius: 16px;
  border: none;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
  overflow: hidden;
  background: linear-gradient(135deg, #f8f9ff 0%, #ffffff 100%);
}

.appointment-modal .modal-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 1.5rem 2rem;
}

.appointment-modal .modal-title {
  color: white !important;
  font-size: 1.4rem;
  font-weight: 600;
}

.appointment-modal .btn-close {
  filter: brightness(0) invert(1);
  opacity: 0.8;
}

.appointment-modal .btn-close:hover {
  opacity: 1;
}

/* Slots container */
.slots-container {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 16px;
  max-height: 65vh;
  overflow-y: auto;
  padding: 20px 8px;
}

/* Time slot card */
.time-slot-card {
  position: relative;
  padding: 20px;
  border-radius: 12px;
  background: white;
  border: 2px solid #e8ecf4;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.time-slot-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, #667eea, #764ba2);
  transform: scaleX(0);
  transition: transform 0.3s ease;
}

.time-slot-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(102, 126, 234, 0.15);
  border-color: #667eea;
}

.time-slot-card:hover::before {
  transform: scaleX(1);
}

.time-slot-card.selected {
  background: linear-gradient(135deg, #f0f4ff 0%, #e8f2ff 100%);
  border: 2px solid #667eea;
  box-shadow: 0 8px 30px rgba(102, 126, 234, 0.2);
  transform: translateY(-2px);
}

.time-slot-card.selected::before {
  transform: scaleX(1);
}

/* Slot content */
.slot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.slot-day {
  font-size: 12px;
  font-weight: 600;
  color: #667eea;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.slot-date {
  font-size: 16px;
  font-weight: 700;
  color: #2d3748;
}

.slot-time {
  font-size: 14px;
  font-weight: 500;
  color: #4a5568;
  background: #f7fafc;
  padding: 8px 12px;
  border-radius: 8px;
  text-align: center;
  margin-top: 8px;
}

.time-slot-card.selected .slot-time {
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

/* Selection indicator */
.selection-indicator {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.selection-check {
  color: #667eea;
  font-size: 20px;
  animation: bounceIn 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes bounceIn {
  0% { 
    opacity: 0; 
    transform: scale(0.3); 
  }
  50% { 
    opacity: 1; 
    transform: scale(1.1); 
  }
  100% { 
    opacity: 1; 
    transform: scale(1); 
  }
}

/* Custom scrollbar */
.slots-container::-webkit-scrollbar {
  width: 8px;
}

.slots-container::-webkit-scrollbar-track {
  background: #f1f5f9;
  border-radius: 10px;
}

.slots-container::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 10px;
}

.slots-container::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(135deg, #5a67d8, #6b46c1);
}

/* Confirm button */
.confirm-btn {
  min-width: 180px;
  padding: 12px 24px;
  font-weight: 600;
  border-radius: 10px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: none;
  transition: all 0.3s ease;
}

.confirm-btn:hover:not(:disabled) {
  background: linear-gradient(135deg, #5a67d8 0%, #6b46c1 100%);
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
}

.confirm-btn:disabled {
  background: #e2e8f0;
  color: #a0aec0;
  cursor: not-allowed;
}

/* Modal body */
.appointment-modal .modal-body {
  padding: 2rem;
}

.appointment-modal .modal-footer {
  padding: 1.5rem 2rem;
  background: #f8fafc;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .slots-container {
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 12px;
    padding: 15px 5px;
  }
  
  .time-slot-card {
    padding: 16px;
  }
  
  .appointment-modal .modal-body {
    padding: 1.5rem;
  }
  
  .appointment-modal .modal-footer {
    padding: 1rem 1.5rem;
  }
}

@media (max-width: 576px) {
  .slots-container {
    grid-template-columns: 1fr;
  }
  
  .confirm-btn {
    min-width: 140px;
    padding: 10px 20px;
  }
}
