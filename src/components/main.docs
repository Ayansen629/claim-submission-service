import React, { useEffect, useState } from "react";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext.js";
import { Link, useLocation } from "react-router-dom";
import {
  FaHome,
  FaCog,
  FaChevronRight,
  FaShip,
  FaDatabase,
  FaTimes,
  FaClipboardCheck,
  FaAnchor,
  FaIdBadge,
  FaBell,
  FaChartBar,
  FaBalanceScale,
  FaGavel,
  FaMoneyCheckAlt,
  FaBoxes,
  FaDrawPolygon,
} from "react-icons/fa";
import styles from "./styles/Sidebar.module.css";
import { OFFICER_ROLES, USER_ROLES } from "../../utils/constants.ts";

const Sidebar = ({ isSidebarOpen, onMenuClick, onClose, userRole }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [activeMenu, setActiveMenu] = useState("");
  const [expandedMenus, setExpandedMenus] = useState({});
  const [animatingMenus, setAnimatingMenus] = useState({});
  const location = useLocation();

  // Menu configuration remains the same as your original code
  // ...

  useEffect(() => {
    const findActiveMenuName = (items) => {
      for (const item of items) {
        if (item.path === location.pathname) return item.name;
        if (item.subMenu) {
          const result = findActiveMenuName(item.subMenu);
          if (result) return item.name;
        }
      }
      return "";
    };
    setActiveMenu(findActiveMenuName(menuItems));
  }, [location]);

  const toggleSubMenu = (menuName) => {
    if (animatingMenus[menuName]) return;
    
    setAnimatingMenus(prev => ({ ...prev, [menuName]: true }));
    
    setExpandedMenus((prev) => ({
      ...prev,
      [menuName]: !prev[menuName],
    }));
    
    setTimeout(() => {
      setAnimatingMenus(prev => ({ ...prev, [menuName]: false }));
    }, 500); // Match this with your CSS transition duration
  };

  const SidebarItem = ({ item, depth = 0 }) => {
    const isActive = activeMenu === item.name;
    const hasSubMenu = !!item.subMenu;
    const isExpanded = !!expandedMenus[item.name];
    const isAnimating = !!animatingMenus[item.name];

    return (
      <li 
        className={`${styles.item} ${isActive ? styles.itemActive : ""}`}
        style={{
          '--depth': depth,
          '--delay': `${depth * 50}ms`
        }}
      >
        <div
          className={styles.link}
          onClick={() => {
            if (hasSubMenu) toggleSubMenu(item.name);
            else onMenuClick(item.name);
          }}
          aria-expanded={isExpanded}
        >
          <div className={styles.linkContent}>
            {item.icon && <span className={styles.icon}>{item.icon}</span>}
            <span className={styles.linkLabel}>{item.label}</span>
          </div>
          {hasSubMenu && isSidebarOpen && (
            <span 
              className={`${styles.chevron} ${isExpanded ? styles.rotate : ""}`}
              style={{ transitionDelay: `calc(${depth * 50}ms + 50ms)` }}
            >
              <FaChevronRight size={12} />
            </span>
          )}
        </div>
        {hasSubMenu && (
          <div 
            className={`${styles.submenu} ${isExpanded && isSidebarOpen ? styles.expanded : ""}`}
            style={{
              transitionDelay: `${depth * 30}ms`,
              marginLeft: `${8 + (depth * 4)}px`
            }}
          >
            <ul className={styles.submenuList}>
              {item.subMenu.map((sub, index) => (
                <SidebarItem 
                  key={sub.name + index} 
                  item={sub} 
                  depth={depth + 1}
                />
              ))}
            </ul>
          </div>
        )}
      </li>
    );
  };

  return (
    <div className={`${styles.sidebar} ${isSidebarOpen ? styles.expanded : styles.collapsed}`}>
      <div className={styles.close}>
        <FaTimes onClick={onClose} />
      </div>
      <ul className={styles.menu}>
        {menuItems.map((item, index) => (
          <SidebarItem key={item.name + index} item={item} depth={0} />
        ))}
      </ul>
    </div>
  );
};

export default Sidebar;
