/* Main modal styling */
.appointment-modal .modal-content {
  border-radius: 16px;
  border: none;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  overflow: hidden;
  font-family: 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
}

.modal-header {
  border-bottom: 1px solid #f0f0f0;
  padding: 20px 25px;
}

.modal-title {
  font-weight: 600;
  font-size: 1.25rem;
  color: #2d3748;
}

.modal-body {
  padding: 0 25px;
}

.modal-footer {
  border-top: 1px solid #f0f0f0;
  padding: 20px 25px;
}

/* Slots container */
.slots-container {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 15px;
  max-height: 55vh;
  overflow-y: auto;
  padding: 15px 0;
  margin: 0 -5px;
}

/* Time slot card */
.time-slot-card {
  position: relative;
  padding: 18px;
  border-radius: 12px;
  background: white;
  border: 1px solid #e2e8f0;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  margin: 0 5px;
}

.time-slot-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  border-color: #a3bffa;
}

.time-slot-card.selected {
  background: #f8fafc;
  border: 1px solid #0d6efd;
  box-shadow: 0 6px 20px rgba(13, 110, 253, 0.15);
  transform: translateY(-1px);
}

/* Slot content */
.slot-date {
  font-size: 0.9rem;
  font-weight: 600;
  color: #4a5568;
  margin-bottom: 8px;
}

.slot-time {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time-text {
  font-size: 1rem;
  font-weight: 600;
  color: #2d3748;
}

.time-duration {
  font-size: 0.8rem;
  color: #718096;
  background: #edf2f7;
  padding: 2px 8px;
  border-radius: 12px;
}

/* Selection indicator */
.selection-indicator {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 50%;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

/* Buttons */
.cancel-btn {
  min-width: 100px;
  padding: 8px 16px;
  font-weight: 500;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
  transition: all 0.2s;
}

.cancel-btn:hover {
  background: #f8f9fa;
  border-color: #cbd5e0;
}

.confirm-btn {
  min-width: 180px;
  padding: 8px 20px;
  font-weight: 500;
  border-radius: 8px;
  transition: all 0.2s;
}

.confirm-btn:disabled {
  opacity: 0.7;
}

/* Custom scrollbar */
.slots-container::-webkit-scrollbar {
  width: 6px;
}

.slots-container::-webkit-scrollbar-track {
  background: #f8f9fa;
  border-radius: 10px;
}

.slots-container::-webkit-scrollbar-thumb {
  background: #cbd5e0;
  border-radius: 10px;
}

.slots-container::-webkit-scrollbar-thumb:hover {
  background: #a0aec0;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .modal-header, .modal-body, .modal-footer {
    padding: 15px 20px;
  }
  
  .slots-container {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  
  .time-slot-card {
    padding: 16px;
  }
  
  .confirm-btn {
    min-width: 140px;
  }
}
