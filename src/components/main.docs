export const getChartColors = (count) => {
  const shuffled = [...chartColors]?.sort(() => 0.5 - Math.random()); // Shuffle for randomness
  while (shuffled.length < count) {
    shuffled.push(...chartColors.sort(() => 0.5 - Math.random()));
  }
  return shuffled.slice(0, count);
};

