import React from 'react';
import WelcomeBox from '../../common/WelcomeBox';
import { Card, Table, Form, InputGroup, Button } from 'react-bootstrap';
import { BsPersonBadge, BsClipboardData, BsSearch } from 'react-icons/bs';
import { FaUserGraduate } from 'react-icons/fa';
import './employeeDashboard.css';
import { headerStyle } from '../../../utils/constants.ts';

const EmployeeDashboard = () => {
  const statData = [
    { 
      title: 'Registration', 
      value: 12, 
      icon: BsPersonBadge, 
      color: '#1251a6',
      bgColor: 'rgba(18, 81, 166, 0.1)'
    },
    { 
      title: 'Survey', 
      value: 24, 
      icon: BsClipboardData, 
      color: '#28a745',
      bgColor: 'rgba(40, 167, 69, 0.1)'
    },
    { 
      title: 'Manning/Training & Certification', 
      value: 7, 
      icon: FaUserGraduate, 
      color: '#902424',
      bgColor: 'rgba(144, 36, 36, 0.1)'
    },
  ];

  const inboxData = [
    {
      appNo: 'APP-2025-001',
      appType: 'Registration',
      owner: 'John Doe',
      vesselNo: 'WB1423',
      date: '2025-05-22',
      status: 'Pending',
    },
    {
      appNo: 'APP-2025-002',
      appType: 'Survey',
      owner: 'Jane Smith',
      vesselNo: 'WB1424',
      date: '2025-05-20',
      status: 'Completed',
    },
  ];

  return (
    <>
      <WelcomeBox userName="Welcome John" desc="Here's your Dashboard overview." />

      <Card className="bg-transparent mb-4">
        <Card.Header style={headerStyle}>My WorkDesk</Card.Header>
        <Card.Body>
          <div className="stats-container">
            {/* Registration Card */}
            <Card className="status-card">
              <div className="status-card-content">
                <div className="icon-wrapper" style={{ backgroundColor: statData[0].bgColor }}>
                  <statData[0].icon size={20} color={statData[0].color} />
                </div>
                <div className="value" style={{ color: statData[0].color }}>
                  {statData[0].value}
                </div>
                <div className="title">{statData[0].title}</div>
                <div className="subtitle">Total Application</div>
              </div>
            </Card>

            {/* Survey Card */}
            <Card className="status-card">
              <div className="status-card-content">
                <div className="icon-wrapper" style={{ backgroundColor: statData[1].bgColor }}>
                  <statData[1].icon size={20} color={statData[1].color} />
                </div>
                <div className="value" style={{ color: statData[1].color }}>
                  {statData[1].value}
                </div>
                <div className="title">{statData[1].title}</div>
                <div className="subtitle">Total Application</div>
              </div>
            </Card>

            {/* Manning/Training Card with Search */}
            <div className="search-combined-card">
              <Card className="status-card" style={{ flex: 1 }}>
                <div className="status-card-content">
                  <div className="icon-wrapper" style={{ backgroundColor: statData[2].bgColor }}>
                    <statData[2].icon size={20} color={statData[2].color} />
                  </div>
                  <div className="value" style={{ color: statData[2].color }}>
                    {statData[2].value}
                  </div>
                  <div className="title">{statData[2].title}</div>
                  <div className="subtitle">Total Application</div>
                </div>
              </Card>
              <div className="search-container">
                <InputGroup className="search-input-group">
                  <Form.Control
                    type="text"
                    placeholder="Search application..."
                    aria-label="Search application"
                  />
                  <Button variant="primary">
                    <BsSearch />
                  </Button>
                </InputGroup>
              </div>
            </div>
          </div>
        </Card.Body>
      </Card>

      <Card className="bg-transparent mt-4">
        <Card.Header style={{ ...headerStyle, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <span>Inbox</span>
          <Form style={{ width: '300px' }}>
            <InputGroup>
              <Form.Control
                type="text"
                placeholder="Search by application number, type"
                aria-label="Search inbox"
              />
              <Button variant="primary">
                <BsSearch />
              </Button>
            </InputGroup>
          </Form>
        </Card.Header>
        <Table responsive="md" striped bordered hover className="custom-vessel-table mb-0">
          {/* Table content remains same */}
        </Table>
      </Card>
    </>
  );
};

export default EmployeeDashboard;
