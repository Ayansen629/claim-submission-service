import React, { useState, useEffect } from "react";
import { useForm, FormProvider, Controller } from "react-hook-form";
import Collapsible from "../formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip";
import { FaInfoCircle } from "react-icons/fa";
import { IFSCSearch } from "../formCommon/IFSCSearch";

const DynamicField = ({ fieldConfig, control, register, errors, setValue, getValues, watch }) => {
  const { name, label, type, options, rules, tooltip, placeholder, rows } = fieldConfig;
  const hasError = errors[name];

  const handleRadioChange = (value) => {
    setValue(name, value);
  };

  return (
    <div className="flex-item">
      <label>
        {label}
        {tooltip && (
          <Tooltip title={tooltip} arrow>
            <span style={{ marginLeft: "5px", cursor: "pointer" }}>
              <FaInfoCircle />
            </span>
          </Tooltip>
        )}
      </label>
      
      {type === "select" ? (
        <select
          {...register(name, rules)}
          className={`form-input ${hasError ? "input-error" : ""}`}
          onChange={(e) => {
            setValue(name, e.target.value);
            if (fieldConfig.onChange) fieldConfig.onChange(e.target.value);
          }}
        >
          {options.map((option) => (
            <option key={option.value} value={option.value} disabled={option.disabled}>
              {option.label}
            </option>
          ))}
        </select>
      ) : type === "radio" ? (
        <div className="radio-group">
          {options.map((option) => (
            <label key={option.value} className="radio-option">
              <input
                type="radio"
                {...register(name, rules)}
                value={option.value}
                checked={watch(name) === option.value}
                onChange={() => handleRadioChange(option.value)}
              />
              {option.label}
            </label>
          ))}
        </div>
      ) : type === "textarea" ? (
        <textarea
          {...register(name, rules)}
          className={`form-input ${hasError ? "input-error" : ""}`}
          rows={rows || 3}
          placeholder={placeholder}
        />
      ) : (
        <input
          {...register(name, rules)}
          type={type}
          className={`form-input ${hasError ? "input-error" : ""}`}
          placeholder={placeholder}
        />
      )}
      {hasError && <p className="error-message">{errors[name]?.message}</p>}
    </div>
  );
};

const FormCDetails = ({ provideSubmitHandler, formData }) => {
  const methods = useForm();
  const { register, handleSubmit, formState: { errors }, control, setValue, getValues, watch, reset } = methods;
  const [selectedClaimType, setSelectedClaimType] = useState("");
  const [showSecurityFields, setShowSecurityFields] = useState(false);
  const [showGuaranteeFields, setShowGuaranteeFields] = useState(false);
  const [beneficiaryCount, setBeneficiaryCount] = useState(1);
  const [guarantorCount, setGuarantorCount] = useState(1);
  const [principalBorrowerCount, setPrincipalBorrowerCount] = useState(1);

  const onSubmit = (data) => {
    if (provideSubmitHandler) {
      provideSubmitHandler(data);
    }
  };

  useEffect(() => {
    if (formData) {
      reset(formData);
      if (formData.claimType) {
        setSelectedClaimType(formData.claimType);
      }
      if (formData.hasSecurityInterest === "yes") {
        setShowSecurityFields(true);
      }
      if (formData.hasGuarantee === "yes") {
        setShowGuaranteeFields(true);
      }
    }
  }, [formData, reset]);

  const handleClaimTypeChange = (value) => {
    setSelectedClaimType(value);
    // Reset form when claim type changes
    reset({
      claimType: value,
      hasSecurityInterest: "",
      hasGuarantee: ""
    });
    setShowSecurityFields(false);
    setShowGuaranteeFields(false);
  };

  const handleSecurityInterestChange = (value) => {
    setShowSecurityFields(value === "yes");
  };

  const handleGuaranteeChange = (value) => {
    setShowGuaranteeFields(value === "yes");
  };

  const addBeneficiary = () => {
    setBeneficiaryCount(beneficiaryCount + 1);
  };

  const addGuarantor = () => {
    setGuarantorCount(guarantorCount + 1);
  };

  const addPrincipalBorrower = () => {
    setPrincipalBorrowerCount(principalBorrowerCount + 1);
  };

  // Claim type options
  const claimTypeOptions = [
    { value: "", label: "Select Claim Type", disabled: true },
    { value: "principalBorrower", label: "Corporate Debtor as Principal Borrower" },
    { value: "guarantor", label: "Corporate Debtor as Guarantor" },
    { value: "financialDebt", label: "Financial Debt Covered" },
  ];

  // Common fields for principal borrower and guarantor
  const commonClaimFields = [
    {
      name: "claimAmount",
      label: "Amount of claim",
      type: "number",
      rules: { required: "Claim amount is required" },
      placeholder: "Enter claim amount"
    },
    {
      name: "hasSecurityInterest",
      label: "Amount of claim covered by security interest",
      type: "radio",
      options: [
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" }
      ],
      rules: { required: "This field is required" },
      onChange: handleSecurityInterestChange
    },
    {
      name: "securityValue",
      label: "Value of the security",
      type: "number",
      rules: showSecurityFields ? { required: "Security value is required" } : {},
      placeholder: "Enter security value",
      show: showSecurityFields
    },
    {
      name: "securityDate",
      label: "Date of the security",
      type: "date",
      rules: showSecurityFields ? { required: "Security date is required" } : {},
      placeholder: "Select security date",
      show: showSecurityFields
    },
    {
      name: "hasGuarantee",
      label: "Amount of claim covered by guarantee",
      type: "radio",
      options: [
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" }
      ],
      rules: { required: "This field is required" },
      onChange: handleGuaranteeChange
    },
    {
      name: "guaranteeValue",
      label: "Value of the guarantee",
      type: "number",
      rules: showGuaranteeFields ? { required: "Guarantee value is required" } : {},
      placeholder: "Enter guarantee value",
      show: showGuaranteeFields
    },
    {
      name: "guaranteeDate",
      label: "Date of the guarantee",
      type: "date",
      rules: showGuaranteeFields ? { required: "Guarantee date is required" } : {},
      placeholder: "Select guarantee date",
      show: showGuaranteeFields
    }
  ];

  // Bank account fields
  const bankAccountFields = [
    {
      name: "accountNumber",
      label: "Account Number",
      type: "text",
      rules: { required: "Account number is required" },
      placeholder: "Enter account number"
    },
    {
      name: "ifscCode",
      label: "IFSC Code",
      type: "text",
      rules: { required: "IFSC code is required" },
      placeholder: "Enter IFSC code",
      component: IFSCSearch
    },
    {
      name: "branchName",
      label: "Branch Name",
      type: "text",
      rules: { required: "Branch name is required" },
      placeholder: "Enter branch name"
    },
    {
      name: "branchAddress",
      label: "Branch Address",
      type: "text",
      rules: { required: "Branch address is required" },
      placeholder: "Enter branch address"
    }
  ];

  return (
    <FormProvider {...methods}>
      <form className="form-stepper" onSubmit={handleSubmit(onSubmit)}>
        {/* Claim Type Selection */}
        <div className="mb-4 bg-light">
          <div className="flex-item">
            <label>
              Select Claim Type <span className="required-asterisk">*</span>
            </label>
            <select
              {...register("claimType", { required: "Claim type is required" })}
              className={`form-input ${errors.claimType ? "input-error" : ""}`}
              onChange={(e) => handleClaimTypeChange(e.target.value)}
              value={selectedClaimType}
            >
              {claimTypeOptions.map((option) => (
                <option key={option.value} value={option.value} disabled={option.disabled}>
                  {option.label}
                </option>
              ))}
            </select>
            {errors.claimType && <p className="error-message">{errors.claimType.message}</p>}
          </div>
        </div>

        {/* Claim Details Section */}
        {selectedClaimType && (
          <div className="mb-4 bg-light">
            <Collapsible title="Details of claim">
              <div className="flex-container">
                {/* Common fields for principal borrower and guarantor */}
                {(selectedClaimType === "principalBorrower" || selectedClaimType === "guarantor") && (
                  <>
                    {commonClaimFields.map((field) => (
                      (!field.show || field.show === true) && (
                        <DynamicField
                          key={field.name}
                          fieldConfig={field}
                          control={control}
                          register={register}
                          errors={errors}
                          setValue={setValue}
                          getValues={getValues}
                          watch={watch}
                        />
                      )
                    ))}

                    {/* Guarantor/Principal Borrower fields */}
                    {[...Array(selectedClaimType === "principalBorrower" ? principalBorrowerCount : guarantorCount)].map((_, index) => (
                      <React.Fragment key={index}>
                        <DynamicField
                          fieldConfig={{
                            name: `${selectedClaimType === "principalBorrower" ? "principalBorrower" : "guarantor"}Name${index + 1}`,
                            label: `Name of the ${selectedClaimType === "principalBorrower" ? "Principal Borrower" : "Guarantor"} ${index + 1}`,
                            type: "text",
                            rules: { required: "This field is required" },
                            placeholder: `Enter name`
                          }}
                          control={control}
                          register={register}
                          errors={errors}
                          setValue={setValue}
                          getValues={getValues}
                          watch={watch}
                        />

                        <DynamicField
                          fieldConfig={{
                            name: `${selectedClaimType === "principalBorrower" ? "principalBorrower" : "guarantor"}Address${index + 1}`,
                            label: `Address of the ${selectedClaimType === "principalBorrower" ? "Principal Borrower" : "Guarantor"} ${index + 1}`,
                            type: "text",
                            rules: { required: "This field is required" },
                            placeholder: `Enter address`
                          }}
                          control={control}
                          register={register}
                          errors={errors}
                          setValue={setValue}
                          getValues={getValues}
                          watch={watch}
                        />
                      </React.Fragment>
                    ))}

                    <button
                      type="button"
                      className="add-more-btn"
                      onClick={selectedClaimType === "principalBorrower" ? addPrincipalBorrower : addGuarantor}
                    >
                      + Add {selectedClaimType === "principalBorrower" ? "Principal Borrower" : "Guarantor"}
                    </button>
                  </>
                )}

                {/* Financial Debt fields */}
                {selectedClaimType === "financialDebt" && (
                  <>
                    <DynamicField
                      fieldConfig={{
                        name: "financialClaimAmount",
                        label: "Amount of claim",
                        type: "number",
                        rules: { required: "Claim amount is required" },
                        placeholder: "Enter claim amount"
                      }}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      getValues={getValues}
                      watch={watch}
                    />

                    {[...Array(beneficiaryCount)].map((_, index) => (
                      <React.Fragment key={index}>
                        <DynamicField
                          fieldConfig={{
                            name: `beneficiaryName${index + 1}`,
                            label: `Name of the Beneficiary ${index + 1}`,
                            type: "text",
                            rules: { required: "This field is required" },
                            placeholder: "Enter name"
                          }}
                          control={control}
                          register={register}
                          errors={errors}
                          setValue={setValue}
                          getValues={getValues}
                          watch={watch}
                        />

                        <DynamicField
                          fieldConfig={{
                            name: `beneficiaryAddress${index + 1}`,
                            label: `Address of the Beneficiary ${index + 1}`,
                            type: "text",
                            rules: { required: "This field is required" },
                            placeholder: "Enter address"
                          }}
                          control={control}
                          register={register}
                          errors={errors}
                          setValue={setValue}
                          getValues={getValues}
                          watch={watch}
                        />
                      </React.Fragment>
                    ))}

                    <button type="button" className="add-more-btn" onClick={addBeneficiary}>
                      + Add Beneficiary
                    </button>
                  </>
                )}

                {/* Common fields for all claim types */}
                <DynamicField
                  fieldConfig={{
                    name: "debtDetails",
                    label: "Details of how debt incurred",
                    type: "textarea",
                    rules: { required: "This field is required" },
                    placeholder: "Enter details of how debt was incurred"
                  }}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  getValues={getValues}
                  watch={watch}
                />

                <DynamicField
                  fieldConfig={{
                    name: "debtDate",
                    label: "Date of debt incurred",
                    type: "date",
                    rules: { required: "This field is required" },
                    placeholder: "Select date"
                  }}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  getValues={getValues}
                  watch={watch}
                />

                <DynamicField
                  fieldConfig={{
                    name: "mutualDetails",
                    label: "Details of any mutual credit, mutual debts, or other mutual dealings between the corporate debtor and the creditor which may be set-off against the claim",
                    type: "textarea",
                    rows: 5,
                    placeholder: "Enter details of any mutual dealings"
                  }}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  getValues={getValues}
                  watch={watch}
                />
              </div>
            </Collapsible>
          </div>
        )}

        {/* Bank Account Details Section */}
        {selectedClaimType && (
          <div className="mb-4 bg-light">
            <Collapsible title="Details of the bank account to which the amount of the claim or any part thereof can be transferred pursuant to a resolution plan">
              <div className="flex-container">
                {bankAccountFields.map((field) => (
                  field.component ? (
                    <field.component
                      key={field.name}
                      fieldConfig={field}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      getValues={getValues}
                      watch={watch}
                    />
                  ) : (
                    <DynamicField
                      key={field.name}
                      fieldConfig={field}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      getValues={getValues}
                      watch={watch}
                    />
                  )
                ))}
              </div>
            </Collapsible>
          </div>
        )}

        <button type="submit" className="submit-btn">
          Submit
        </button>
      </form>
    </FormProvider>
  );
};

export default FormCDetails;
