import React, { useState, useEffect } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams, useLocation,useNavigate } from "react-router-dom";
import Stepper from "../../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import Documents from "./Documents.js";
import { useForm } from "react-hook-form";
import Invoicing from "../../../common/Invoicing.js";
import PaymentModal from "../../../common/PaymentModal.js"; 
// import ActionDropdown from "../../../common/ActionDropdown";
// import ApprovalModal from "../../../common/ApprovalModal";
import NewVesselRegistrationSuccess from "./newVesselRegistrationSuccess.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import VesselRegistrationPreview from "./VesselRegistrationPreview.js";

const NewVesselRegistration = () => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const { id } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  
  const isEditMode = !!id && location.pathname.includes('/edit/');
  const isViewMode = !!id && location.pathname.includes('/view/');
  const isNormalMode = !isEditMode && !isViewMode;
  
  const methods = useForm({ mode: "onTouched" });
  const { trigger, getValues, setError, setValue, reset } = methods;

  const [showModal, setShowModal] = useState(false);
  const [paymentMode, setPaymentMode] = useState("offline");
  const [challanFile, setChallanFile] = useState(null);
  const [isLoading, setIsLoading] = useState(false);
  // const [showApprovalModal, setShowApprovalModal] = useState(false);
  // const [selectedAction, setSelectedAction] = useState("");

  // const actionsFromAPI = ["Approve", "Reject", "Request Changes"];

  const staticData = {
    ownerName: "John Doe",
    ownerAddress: "123 Main Street, Harbor City, State 12345",
    mobile: "9876543210",
    email: "john.doe@example.com",
    pan: "ABCDE1234F",
    aadhar: "123456789012",
    tradeLicence: "TL123456789",
    gst: "GST123456789012",
    grt: "500",
    workOrderValue: "1000000",
    vesselType: "new",
    category: "A",
    zone: "1",
    supervisionAuthority: "classificationSociety",
    purchaseType: "new",
    classificationSociety: "Lloyd's Register Classification Society",
    constructedBy: "2",
    builder: "builder1",
    builderName: "ABC Marine Shipyard Pvt Ltd",
    builderAddress: "456 Port Road, Shipyard Complex, Harbor City 54321",
    builderEmail: "contact@abcshipyard.com",
    builderMobile: "9876543211",
    builderTradeLicence: "BTL789012345",
    builderGST: "BGST987654321098",
    builderAuth: "auth",
    termsAccepted: true,
    
    // Work Order Files (50 files)
    ...Array.from({ length: 50 }, (_, i) => ({
      [`workOrder_file_${i + 1}`]: { 
        name: `Work_Order_Document_${String(i + 1).padStart(2, '0')}.pdf`, 
        size: Math.floor(Math.random() * 2000000) + 500000 
      },
      [`workOrder_desc_${i + 1}`]: `Work order document ${i + 1} - ${[
        'Main contract document',
        'Amendment and modifications',
        'Technical specifications',
        'Timeline and milestones',
        'Budget breakdown',
        'Quality requirements',
        'Safety protocols',
        'Environmental compliance',
        'Material specifications',
        'Equipment details'
      ][i % 10]}`
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    
    // Drawing Files (50 files)
    ...Array.from({ length: 50 }, (_, i) => ({
      [`drawings_file_${i + 1}`]: { 
        name: `Technical_Drawing_${String(i + 1).padStart(2, '0')}.pdf`, 
        size: Math.floor(Math.random() * 3000000) + 800000 
      },
      [`drawings_desc_${i + 1}`]: `Technical drawing ${i + 1} - ${[
        'General arrangement plan',
        'Hull structure details',
        'Machinery layout',
        'Electrical schematic',
        'Piping diagram',
        'Safety equipment layout',
        'Navigation equipment',
        'Interior arrangement',
        'Deck plan',
        'Cross-section view'
      ][i % 10]}`
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    
    tonnageBooklets: { name: "Tonnage_Booklets.pdf", size: 512000 },
    stabilityBooklets: { name: "Stability_Booklets.pdf", size: 768000 },
    authLetter: { name: "Authorization_Letter.pdf", size: 256000 }
  };

  useEffect(() => {
    if (isNormalMode) {
      reset();
    } else if (isEditMode || isViewMode) {
      setTimeout(() => {
        Object.keys(staticData).forEach(key => {
          setValue(key, staticData[key]);
        });
      }, 100);
    }
  }, [isEditMode, isViewMode, isNormalMode, setValue, reset, location.pathname]);

  const validateVesselDetails = async () => {
    if (isViewMode) return true;
    const basicFields = [
      "ownerName", "ownerAddress", "mobile", "email", "pan", 
      "aadhar", "tradeLicence", "gst", "grt", "workOrderValue",
      "vesselType", "category", "purchaseType", "constructedBy"
    ];
    
    const constructedBy = getValues("constructedBy");
    if (constructedBy === "2") {
      basicFields.push(
        "builderName", "builderAddress", "builderEmail", 
        "builderMobile", "builderTradeLicence", "builderGST", 
        "builderAuth", "authLetter"
      );
    }
    
    const valid = await trigger(basicFields);
    return valid;
  };

  const validateDocuments = async () => {
    if (isViewMode) return true;
    const requiredFields = ['tonnageBooklets', 'stabilityBooklets', 'termsAccepted'];
    const constructedBy = getValues("constructedBy");
    
    if (constructedBy === "2") {
      requiredFields.push('authLetter');
    }
    
    let hasErrors = false;
    
    requiredFields.forEach(fieldName => {
      const fieldValue = getValues(fieldName);
      
      if (!fieldValue || (fieldValue instanceof FileList && fieldValue.length === 0)) {
        setError(fieldName, {
          type: 'required',
          message: `${fieldName} is required`
        });
        hasErrors = true;
      }
    });
    
    return !hasErrors;
  };

  const supervisionAuthority = methods.watch("supervisionAuthority");

  const handleChallanUpload = (e) => {
    setChallanFile(e.target.files?.[0] || null);
  };

  const handleOnlinePay = () => {
    setIsLoading(true);
    setShowModal(false);
   
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  const handleOfflineSubmit = () => {
    setShowModal(false);
    setIsLoading(true);
    
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  // const handleActionClick = (action) => {
  //   setSelectedAction(action);
  //   setShowApprovalModal(true);
  // };

  // const handleActionSubmit = (formData) => {
  //   const payload = {
  //     action: selectedAction,
  //     ...formData,
  //   };
  //   console.log("Action submitted:", payload);
  //   setShowApprovalModal(false);
  //   setSelectedAction("");
  // };

  // const handleCloseModal = () => {
  //   setShowApprovalModal(false);
  //   setSelectedAction("");
  // };

  const steps = isViewMode ? [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={isViewMode} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateDocuments,
    }
  ] : [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={isViewMode} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateDocuments,
    },
    {
      label : t("Preview"),
      component: <VesselRegistrationPreview formData={methods.getValues()} isPreview={true}
    />
    },
    {
      label: t("Invoicing"),
      component: (
        <Invoicing
          supervisionAuthority={supervisionAuthority}
          onPayNow={() => setShowModal(true)}
        />
      ),
      validate: () => true,
    },
  ];

  const handleSave = () => {
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {isLoading ? (
        <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
          <div className="text-center">
            <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
              <span className="visually-hidden">Loading...</span>
            </div>
            <p className="mt-3">Processing your request...</p>
          </div>
        </div>
      ) : (
        <>
          <Stack spacing={0.5}>
            <Typography
              sx={{
                fontWeight: 550,
                color: "#2E57A7",
                fontSize: "1.2rem",
              }}
            >
             {isViewMode ? t("View Vessel Registration") + ` - ${id}` : 
              isEditMode ? t("Edit Vessel Registration") + ` - ${id}` : t("New Vessel Registration")}
              &nbsp;
              <span style={{ color: "#666", fontSize: "0.65rem" }}>
                {isViewMode ? t("(View vessel registration details)") :
                 isEditMode ? t("(Update vessel registration details)") : t("(Fill in the vessel details to complete registration)")}
              </span>
            </Typography>
          </Stack>
          <Stepper 
            steps={steps} 
            onSave={handleSave} 
            viewMode={isViewMode}
            // actionDropdown={isViewMode ? (
            //   <ActionDropdown
            //     actions={actionsFromAPI}
            //     onActionClick={handleActionClick}
            //     variant="primary"
            //     className="py-2 px-3"
            //   />
            // ) : null}
          />
          {!isViewMode && (
            <PaymentModal
              show={showModal}
              onHide={() => setShowModal(false)}
              paymentMode={paymentMode}
              setPaymentMode={setPaymentMode}
              challanFile={challanFile}
              onChallanUpload={handleChallanUpload}
              onOnlinePay={handleOnlinePay}
              onOfflineSubmit={handleOfflineSubmit}
              isLoading={isLoading}
              formMethods={methods}
            />
          )}
          {/* {isViewMode && (
            <ApprovalModal
              show={showApprovalModal}
              handleClose={handleCloseModal}
              handleSubmitData={handleActionSubmit}
              selectedAction={selectedAction}
            />
          )} */}
        </>
      )}
    </Box>
  );
};

export default NewVesselRegistration;
import React, { useState, useEffect, useRef } from "react";
import { useForm } from "react-hook-form";
import { Row, Col, Button } from "react-bootstrap";
import InputText from "../../../common/InputText.tsx";
import InputSelect from "../../../common/InputSelect.tsx";
import InputRadio from "../../../common/InputRadio.tsx";
import InputFile from "../../../common/InputFile.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import { renameFile } from "../../../../utils/constants.ts";
import { BsDownload } from "react-icons/bs";

const VesselDetails = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [formData, setFormData] = useState({});
  
  // const defaultValues = {
  //   ownerName: "",
  //   ownerAddress: "",
  //   mobile: "",
  //   email: "",
  //   pan: "",
  //   aadhar: "",
  //   tradeLicence: "",
  //   gst: "",
  //   grt: "",
  //   workOrderValue: "",
  //   vesselType: "",
  //   category: "",
  //   zone: "",
  //   supervisionAuthority: "",
  //   purchaseType: "",
  //   classificationSociety: "",
  //   constructedBy: "",
  //   builder: "",
  //   builderName: "",
  //   builderAddress: "",
  //   builderEmail: "",
  //   builderMobile: "",
  //   builderTradeLicence: "",
  //   builderGST: "",
  //   builderAuth: "",
  //   authLetter: "",
  //   termsAccepted: false,
  //   tonnageBooklets: null,
  //   stabilityBooklets: null,
  // };

  // const internalFormMethods = useForm({
  //   defaultValues,
  //   mode: "onTouched",

  // });

  // const methods = formMethods || internalFormMethods;
  
  const isCompMount = useRef(true);

  const {
    register,
    watch,
    setValue,
    clearErrors,
    trigger,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");
  const category = watch("category");

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [changeLanguage]);

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  useEffect(() => {
    if (category === "A") {
      setValue("zone", "1", { shouldValidate: true });
      setValue("supervisionAuthority", "classificationSociety", { shouldValidate: true });
      clearErrors("zone");
      clearErrors("supervisionAuthority");
    }
  }, [category, setValue, clearErrors]);

  const handleDownload = (fileName) => {
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
  };

  const DocumentViewCard = ({ fileName, onDownload }) => (
    <div className="mb-2 p-2 border rounded" style={{ backgroundColor: "#f8f9fa" }}>
      <div className="d-flex justify-content-between align-items-center">
        <div className="flex-grow-1">
          <strong className="text-primary small">{fileName}</strong>
        </div>
        <Button
          variant="outline-primary"
          size="sm"
          onClick={() => onDownload(fileName)}
        >
          <BsDownload size={14} />
        </Button>
      </div>
    </div>
  );

  const formFields = {
    basicInfo: [
      {
        name: 'ownerName',
        label: t('Name of Owner'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Name of Owner'),
        validation: { required: t('Name is required') }
      },
      {
        name: 'ownerAddress',
        label: t('Address of Owner'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Address of Owner'),
        validation: { required: t('Address is required') }
      },
      {
        name: 'mobile',
        label: t('Mobile'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Mobile'),
        validation: { required: t('Mobile is required') }
      },
      {
        name: 'email',
        label: t('Email Id'),
        type: 'email',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Email Id'),
        validation: { required: t('Email is required') }
      },
      {
        name: 'pan',
        label: t('PAN'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter PAN'),
        validation: { required: t('PAN is required') }
      },
      {
        name: 'aadhar',
        label: t('Aadhar'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Aadhar'),
        validation: { required: t('Aadhar is required') }
      },
      {
        name: 'tradeLicence',
        label: t('Trade Licence'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Trade Licence'),
        validation: { required: t('Trade Licence is required') }
      },
      {
        name: 'gst',
        label: t('GST'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GST'),
        validation: { required: t('GST is required') }
      },
      {
        name: 'grt',
        label: t('Gross Tonnage (GRT)'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GRT'),
        validation: { required: t('GRT is required') }
      },
      {
        name: 'workOrderValue',
        label: t('Work Order Value'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Enter Work Order Value'),
        validation: {
          required: t('Work Order Value is required'),
          pattern: {
            value: /^[0-9]+$/,
            message: t('Please enter a valid number')
          }
        }
      },
      {
        name: 'vesselType',
        label: t('Type of Vessel'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'new', label: t('New Vessel') },
          { value: 'old', label: t('Old Vessel') }
        ],
        validation: { required: t('vesselType is required') }
      },
      {
        name: 'category',
        label: t('Category'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'A', label: t('Category A') },
          { value: 'B', label: t('Category B') },
          { value: 'C', label: t('Category C') }
        ],
        validation: { required: t('category is required') }
      },
      {
        name: 'zone',
        label: t('Zone'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: '1', label: t('Zone 1') },
          { value: '2', label: t('Zone 2') },
          { value: '3', label: t('Zone 3') }
        ],
        validation: { required: category !== "A" && t('zone is required') },
        disabled: category === "A"
      },
      {
        name: 'supervisionAuthority',
        label: t('Supervision Authority'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'iwt', label: t('IWT') },
          { value: 'classificationSociety', label: t('Classification Society') }
        ],
        validation: { required: category !== "A" && t('Supervision Authority is required') },
        disabled: category === "A"
      },
      {
        name: 'purchaseType',
        label: t('Purchase Type'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'new', label: t('New') },
          { value: 'used', label: t('Used') }
        ],
        validation: { required: t('Purchase Type is required') }
      },
      {
        name: 'classificationSociety',
        label: t('Name of the Classification Society'),
        type: 'text',
        required: false,
        colSize: 4,
        placeholder: t('Please enter Name of the Classification Society'),
        validation: {}
      },
      {
        name: 'constructedBy',
        label: t('Constructed By ?'),
        type: 'radio',
        required: true,
        colSize: 6,
        options: [
          { label: t('Self'), value: '1' },
          { label: t('Builder'), value: '2' }
        ],
        validation: { required: t('Please select a Constructor Type') }
      },
      {
        name: 'builder',
        label: t('Builder'),
        type: 'select',
        required: true,
        colSize: 6,
        options: [
          { value: 'builder1', label: t('Builder 1') },
          { value: 'builder2', label: t('Builder 2') }
        ],
        showIf: () => constructedBy === "2",
        validation: { required: t('Builder is required') }
      }
    ],
    builderDetails: [
      {
        name: 'builderName',
        label: t('Builder Name'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Name'),
        validation: { required: t('Builder Name is required') }
      },
      {
        name: 'builderAddress',
        label: t('Builder Address'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Address'),
        validation: { required: t('Builder Address is required') }
      },
      {
        name: 'builderEmail',
        label: t('Builder Email Id'),
        type: 'email',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Email Id'),
        validation: {
          required: t('Builder Email is required'),
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: t('Invalid email address')
          }
        }
      },
      {
        name: 'builderMobile',
        label: t('Mobile'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Mobile'),
        validation: {
          required: t('Builder Mobile is required'),
          pattern: {
            value: /^[0-9]{10}$/,
            message: t('Invalid mobile number')
          }
        }
      },
      {
        name: 'builderTradeLicence',
        label: t('Trade Licence'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Trade Licence'),
        validation: { required: t('Builder Trade Licence is required') }
      },
      {
        name: 'builderGST',
        label: t('GST'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GST'),
        validation: { required: t('Builder GST is required') }
      },
      {
        name: 'builderAuth',
        label: t('Builder Authorization'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'auth', label: t('Authorized') },
          { value: 'rejected', label: t('Rejected') }
        ],
        validation: { required: t('Builder Authorization is required') }
      },
      {
        name: 'authLetter',
        label: t('Authorization Letter'),
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: t('Authorization Letter is required') }
      }
    ]
  };

  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'select':
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register(field.name, field.validation)}
            errors={errors}
            value={formData[field.name] || watch(field.name) || ""}
            onChange={(value) => {
              if (viewMode || field.disabled) return;
              setValue(field.name, value, { shouldValidate: true });
              clearErrors(field.name);
              setFormData(prev => ({
                ...prev,
                [field.name]: value
              }));
            }}
            disabled={viewMode || field.disabled}
          />
        );

      case 'file':
  if (viewMode) {
    const fileData = watch(field.name);
    if (fileData && fileData.name) {
      return (
        <div className="mb-3">
          <label className="form-label fw-bold">{field.label}</label>
          <DocumentViewCard
            fileName={fileData.name}
            onDownload={handleDownload}
          />
        </div>
      );
    }
    return null;
  }
  
  return (
    <div className="mb-2">
      <InputFile
        label={field.label}
        required={field.required}
        name={field.name}
        register={register(field.name, field.validation)}
        errors={errors}
        onChange={(e) => {
          if (viewMode) return;
          if (e.target.files && e?.target?.files[0]) {
            const file = e.target.files[0];
            
            const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
            if (!validTypes.includes(file.type)) {
              setError(field.name, {
                type: 'manual',
                message: t('Only PDF, JPG or PNG files are allowed')
              });
              setValue(field.name, null);
              return;
            }
            
            if (file.size > 10 * 1024 * 1024) {
              setError(field.name, {
                type: 'manual',
                message: t('File size should not exceed 10MB')
              });
              setValue(field.name, null);
              return;
            }
            
            const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
            const fileName = `${field.label}${extension}`;
            file.originalName = fileName;
            const renamedFile = renameFile(file, fileName);

            clearErrors(field.name);
            setValue(field.name, renamedFile, { shouldValidate: true });
            setFormData((prev) => ({
              ...prev,
              [field.name]: renamedFile
            }));
          }
        }}
        disabled={viewMode}
        watch={watch}
        defaultValue={watch(field.name)}
        clearErrors={clearErrors}
        accept=".pdf,.jpg,.jpeg,.png"
      />
    </div>
  );
      case 'radio':
        return (
          <InputRadio
            name={field.name}
            label={field.label}
            options={field.options}
            register={register}
            rules={field.validation}
            errors={errors}
            onChange={() => !viewMode && clearErrors(field.name)}
            disabled={viewMode}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field.name, field.validation)}
            onChange={handleChange}
            errors={errors}
            disabled={viewMode}
          />
        );
    }
  };

  return (
    <form autoComplete="off">
      <Collapsible title={t("Basic Information")} openStat={true}>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          {formFields.basicInfo.map((field, index) => (
            <Col key={index} md={field.colSize || 12}>
              <DynamicField field={field} />
            </Col>
          ))}
        </Row>
      </Collapsible>

      {constructedBy === "2" && (
        <Collapsible title={t("Builder Details")} openStat={true}>
          <Row className="gy-3" style={{ padding: "1rem" }}>
            {formFields.builderDetails.map((field, index) => (
              <Col key={index} md={field.colSize || 12}>
                <DynamicField field={field} />
              </Col>
            ))}
          </Row>
        </Collapsible>
      )}
    </form>
  );
};

export default VesselDetails;
import React from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useTranslation } from "react-i18next";
import { BsFileEarmarkPdf, BsDownload } from "react-icons/bs";
import { Card, Row, Col, Table, Button } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";

const VesselRegistrationPreview = ({ formData, isPreview=true }) => {
  const { t } = useTranslation();
  
  const previewData = {
    ownerDetails: {
      ownerName: formData?.ownerName || "John Doe",
      ownerAddress: formData?.ownerAddress || "123 Main Street, Harbor City, State 12345",
      mobile: formData?.mobile || "9876543210",
      email: formData?.email || "john.doe@example.com",
      pan: formData?.pan || "ABCDE1234F",
      aadhar: formData?.aadhar || "123456789012",
      tradeLicence: formData?.tradeLicence || "TL123456789",
      gst: formData?.gst || "GST123456789012"
    },
    vesselDetails: {
      grt: formData?.grt || "500",
      workOrderValue: formData?.workOrderValue || "1000000",
      vesselType: formData?.vesselType === "new" ? t("New Vessel") : t("Old Vessel"),
      category: formData?.category ? `${t("Category")} ${formData.category}` : t("Category A"),
      zone: formData?.zone ? `${t("Zone")} ${formData.zone}` : t("Zone 1"),
      supervisionAuthority: formData?.supervisionAuthority === "iwt" ? t("IWT") : t("Classification Society"),
      purchaseType: formData?.purchaseType === "new" ? t("New") : t("Used"),
      classificationSociety: formData?.classificationSociety || "Lloyd's Register Classification Society",
      constructedBy: formData?.constructedBy === "1" ? t("Self") : t("Builder")
    },
    builderDetails: {
      builderName: formData?.builderName || "ABC Marine Shipyard Pvt Ltd",
      builderAddress: formData?.builderAddress || "456 Port Road, Shipyard Complex, Harbor City 54321",
      builderEmail: formData?.builderEmail || "contact@abcshipyard.com",
      builderMobile: formData?.builderMobile || "9876543211",
      builderTradeLicence: formData?.builderTradeLicence || "BTL789012345",
      builderGST: formData?.builderGST || "BGST987654321098",
      builderAuth: formData?.builderAuth === "auth" ? t("Authorized") : t("Rejected")
    },
    documents: {
      workOrderFiles: getWorkOrderFiles(formData),
      drawingFiles: getDrawingFiles(formData),
      tonnageBooklets: formData?.tonnageBooklets ? {
        name: formData.tonnageBooklets.name,
        size: `${(formData.tonnageBooklets.size / 1024 / 1024).toFixed(1)} MB`
      } : { name: "Tonnage_Booklets.pdf", size: "0.5 MB" },
      stabilityBooklets: formData?.stabilityBooklets ? {
        name: formData.stabilityBooklets.name,
        size: `${(formData.stabilityBooklets.size / 1024 / 1024).toFixed(1)} MB`
      } : { name: "Stability_Booklets.pdf", size: "0.7 MB" },
      authLetter: formData?.authLetter ? {
        name: formData.authLetter.name,
        size: `${(formData.authLetter.size / 1024 / 1024).toFixed(1)} MB`
      } : { name: "Authorization_Letter.pdf", size: "0.3 MB" }
    },
    paymentDetails: {
      supervisionAuthority: formData?.supervisionAuthority === "iwt" ? t("IWT") : t("Classification Society"),
      paymentMode: t("Offline"),
      challanFile: "Payment_Challan.pdf",
      amount: "Rs. 590/-",
      status: t("Pending")
    }
  };

  function getWorkOrderFiles(formData) {
    const files = [];
    for (let i = 1; i <= 50; i++) {
      const file = formData?.[`workOrder_file_${i}`];
      const desc = formData?.[`workOrder_desc_${i}`];
      if (file && file.name) {
        files.push({
          name: file.name,
          description: desc || `Work order document ${i}`,
          size: `${(file.size / 1024 / 1024).toFixed(1)} MB`
        });
      }
    }
    return files.length > 0 ? files : [
      { name: "Work_Order_Document_01.pdf", description: "Main contract document", size: "1.2 MB" },
      { name: "Work_Order_Document_02.pdf", description: "Amendment and modifications", size: "0.8 MB" }
    ];
  }

  function getDrawingFiles(formData) {
    const files = [];
    for (let i = 1; i <= 50; i++) {
      const file = formData?.[`drawings_file_${i}`];
      const desc = formData?.[`drawings_desc_${i}`];
      if (file && file.name) {
        files.push({
          name: file.name,
          description: desc || `Drawing document ${i}`,
          size: `${(file.size / 1024 / 1024).toFixed(1)} MB`
        });
      }
    }
    return files.length > 0 ? files : [
      { name: "Technical_Drawing_01.pdf", description: "General arrangement plan", size: "2.1 MB" },
      { name: "Technical_Drawing_02.pdf", description: "Hull structure details", size: "1.5 MB" }
    ];
  }

  const handleDownload = (fileName) => {
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
  };

  const DocumentCard = ({ fileName, description, fileSize }) => (
    <Card className="mb-2 border-0 shadow-sm">
      <Card.Body className="p-3">
        <div className="d-flex justify-content-between align-items-center">
          <div className="d-flex align-items-center flex-grow-1">
            <div className="bg-danger bg-opacity-10 rounded-circle p-2 me-3">
              <BsFileEarmarkPdf className="text-danger" size={20} />
            </div>
            <div className="flex-grow-1">
              <h6 className="mb-1 text-primary fw-semibold" style={{ fontSize: "0.9rem" }}>
                {fileName}
              </h6>
              <p className="mb-0 text-muted small">
                {description}
                <span className="ms-2 badge bg-light text-dark">{fileSize}</span>
              </p>
            </div>
          </div>
          <Button
            variant="outline-primary"
            size="sm"
            onClick={() => handleDownload(fileName)}
            className="rounded-pill"
          >
            <BsDownload size={14} />
          </Button>
        </div>
      </Card.Body>
    </Card>
  );

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      <Stack spacing={0.5}>
        <Typography
          sx={{
            fontWeight: 550,
            color: "#2E57A7",
            fontSize: "1.2rem",
          }}
        >
          {t("Vessel Registration Preview")}
          &nbsp;
          <span style={{ color: "#666", fontSize: "0.65rem" }}>
            {t("(Review all vessel registration details before submission)")}
          </span>
        </Typography>
      </Stack>

      <div className="container py-4">
        {/* Owner Details Section */}
        <Collapsible title={t("Owner Details")} openStat={true}  >
          <div style={{ padding: "1rem" }}>
            <Row>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Name of Owner")}</label>
                  <div className="form-control bg-light">{previewData.ownerDetails.ownerName}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Address of Owner")}</label>
                  <div className="form-control bg-light">{previewData.ownerDetails.ownerAddress}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Mobile")}</label>
                  <div className="form-control bg-light">{previewData.ownerDetails.mobile}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Email Id")}</label>
                  <div className="form-control bg-light">{previewData.ownerDetails.email}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("PAN")}</label>
                  <div className="form-control bg-light">{previewData.ownerDetails.pan}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Aadhar")}</label>
                  <div className="form-control bg-light">{previewData.ownerDetails.aadhar}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Trade Licence")}</label>
                  <div className="form-control bg-light">{previewData.ownerDetails.tradeLicence}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("GST")}</label>
                  <div className="form-control bg-light">{previewData.ownerDetails.gst}</div>
                </div>
              </Col>
            </Row>
          </div>
        </Collapsible>

        {/* Vessel Details Section */}
        <Collapsible title={t("Vessel Details")} openStat={true}>
          <div style={{ padding: "1rem" }}>
            <Row>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Gross Tonnage (GRT)")}</label>
                  <div className="form-control bg-light">{previewData.vesselDetails.grt}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Work Order Value")}</label>
                  <div className="form-control bg-light">Rs. {previewData.vesselDetails.workOrderValue}/-</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Type of Vessel")}</label>
                  <div className="form-control bg-light">{previewData.vesselDetails.vesselType}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Category")}</label>
                  <div className="form-control bg-light">{previewData.vesselDetails.category}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Zone")}</label>
                  <div className="form-control bg-light">{previewData.vesselDetails.zone}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Supervision Authority")}</label>
                  <div className="form-control bg-light">{previewData.vesselDetails.supervisionAuthority}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Purchase Type")}</label>
                  <div className="form-control bg-light">{previewData.vesselDetails.purchaseType}</div>
                </div>
              </Col>
              <Col md={8}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Name of the Classification Society")}</label>
                  <div className="form-control bg-light">{previewData.vesselDetails.classificationSociety}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Constructed By")}</label>
                  <div className="form-control bg-light">{previewData.vesselDetails.constructedBy}</div>
                </div>
              </Col>
            </Row>
          </div>
        </Collapsible>

        {/* Builder Details Section */}
        {(formData?.constructedBy === "2" || !formData) && (
          <Collapsible title={t("Builder Details")} openStat={true}>
            <div style={{ padding: "1rem" }}>
              <Row>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Builder Name")}</label>
                    <div className="form-control bg-light">{previewData.builderDetails.builderName}</div>
                  </div>
                </Col>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Builder Address")}</label>
                    <div className="form-control bg-light">{previewData.builderDetails.builderAddress}</div>
                  </div>
                </Col>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Builder Email Id")}</label>
                    <div className="form-control bg-light">{previewData.builderDetails.builderEmail}</div>
                  </div>
                </Col>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Mobile")}</label>
                    <div className="form-control bg-light">{previewData.builderDetails.builderMobile}</div>
                  </div>
                </Col>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Trade Licence")}</label>
                    <div className="form-control bg-light">{previewData.builderDetails.builderTradeLicence}</div>
                  </div>
                </Col>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("GST")}</label>
                    <div className="form-control bg-light">{previewData.builderDetails.builderGST}</div>
                  </div>
                </Col>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Builder Authorization")}</label>
                    <div className="form-control bg-light">{previewData.builderDetails.builderAuth}</div>
                  </div>
                </Col>
                <Col md={8}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Authorization Letter")}</label>
                    <DocumentCard 
                      fileName={previewData.documents.authLetter.name} 
                      description="Builder authorization document"
                      fileSize={previewData.documents.authLetter.size}
                    />
                  </div>
                </Col>
              </Row>
            </div>
          </Collapsible>
        )}

        {/* Documents Section */}
        <Collapsible title={t("Documents")} openStat={true}>
          <div style={{ padding: "1rem" }}>
            <Row className="g-4">
              <Col lg={6} md={12}>
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-3">
                    <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
                      <BsFileEarmarkPdf className="text-primary me-2" />
                      {t("Work Order")} ({previewData.documents.workOrderFiles.length})
                    </h5>
                  </Card.Header>
                  <Card.Body className="p-3" style={{ maxHeight: "400px", overflowY: "auto" }}>
                    {previewData.documents.workOrderFiles.map((file, index) => (
                      <DocumentCard
                        key={index}
                        fileName={file.name}
                        description={file.description}
                        fileSize={file.size}
                      />
                    ))}
                  </Card.Body>
                </Card>
              </Col>

              <Col lg={6} md={12}>
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-3">
                    <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
                      <BsFileEarmarkPdf className="text-success me-2" />
                      {t("Drawings")} ({previewData.documents.drawingFiles.length})
                    </h5>
                  </Card.Header>
                  <Card.Body className="p-3" style={{ maxHeight: "400px", overflowY: "auto" }}>
                    {previewData.documents.drawingFiles.map((file, index) => (
                      <DocumentCard
                        key={index}
                        fileName={file.name}
                        description={file.description}
                        fileSize={file.size}
                      />
                    ))}
                  </Card.Body>
                </Card>
              </Col>

              <Col md={6}>
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-3">
                    <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
                      <BsFileEarmarkPdf className="text-warning me-2" />
                      {t('Tonnage Booklets')}
                    </h5>
                  </Card.Header>
                  <Card.Body className="p-3">
                    <DocumentCard
                      fileName={previewData.documents.tonnageBooklets.name}
                      description="Tonnage certification document"
                      fileSize={previewData.documents.tonnageBooklets.size}
                    />
                  </Card.Body>
                </Card>
              </Col>

              <Col md={6}>
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-3">
                    <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
                      <BsFileEarmarkPdf className="text-info me-2" />
                      {t('Stability Booklets')}
                    </h5>
                  </Card.Header>
                  <Card.Body className="p-3">
                    <DocumentCard
                      fileName={previewData.documents.stabilityBooklets.name}
                      description="Stability certification document"
                      fileSize={previewData.documents.stabilityBooklets.size}
                    />
                  </Card.Body>
                </Card>
              </Col>

              {/* <Col md={12}>
                <Card className="shadow-sm border-0">
                  <Card.Body className="p-4">
                    <div className="d-flex align-items-start">
                      <input
                        type="checkbox"
                        id="termsAccepted"
                        className="me-3 mt-1"
                        checked={formData?.termsAccepted || true}
                        disabled
                      />
                      <div>
                        <label
                          htmlFor="termsAccepted"
                          className="mb-0 fw-medium"
                          style={{ color: "#333", cursor: "default", lineHeight: "1.5" }}
                        >
                          {t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.')}
                        </label>
                      </div>
                    </div>
                  </Card.Body>
                </Card>
              </Col> */}
            </Row>
          </div>
        </Collapsible>

        {/* Payment Details Section */}
        <Collapsible title={t("Payment Summary")} openStat={true}>
          <div style={{ padding: "1rem" }}>
            <Row>
              <Col md={6}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Supervision Authority")}</label>
                  <div className="form-control bg-light">{previewData.paymentDetails.supervisionAuthority}</div>
                </div>
              </Col>
              <Col md={6}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Total Amount")}</label>
                  <div className="form-control bg-success text-white fw-bold">{previewData.paymentDetails.amount}</div>
                </div>
              </Col>
            </Row>
          </div>
        </Collapsible>
      </div>
    </Box>
  );
};

export default VesselRegistrationPreview;

import React, { useState } from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";
import ActionDropdown from "../common/ActionDropdown";
import ApprovalModal from "../common/ApprovalModal";

const themeColor = "#2E57A7";
const successColor = "#28a745";

const Stepper = ({ steps, onSave, viewMode = false }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [activeStep, setActiveStep] = useState(0);
  const [completed, setCompleted] = useState({});
  const [errors, setErrors] = useState({});
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");

  const totalSteps = steps.length;

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    
    const payload = {
      action: selectedAction,
      comments: formData.comments,
     
    };
    
    console.log("Action submitted:", payload);
    

    toast.success(`${selectedAction} action submitted successfully`);
    
   
    setShowApprovalModal(false);
    setSelectedAction("");
    

  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleNext = async () => {
    if (viewMode) {
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
      return;
    }
    
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
      } else {
        toast.error("Please fix the errors before proceeding.");
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
    }
  };

  const handleBack = () => {
    setActiveStep((prev) => Math.max(prev - 1, 0));
  };

  const handleSave = async () => {
    if (viewMode) return;
    
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        if (activeStep < totalSteps - 1) {
          setActiveStep((prev) => prev + 1);
        } else {
          onSave();
        }
      } else {
        toast.error("Please fix the errors before proceeding.");
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      if (activeStep < totalSteps - 1) {
        setActiveStep((prev) => prev + 1);
      } else {
        onSave();
      }
    }
  };

  const handlePayNow = () => {
    if (
      steps[activeStep] &&
      steps[activeStep].component &&
      typeof steps[activeStep].component.props.onPayNow === "function"
    ) {
      steps[activeStep].component.props.onPayNow();
    }
  };

  return (
    <Box sx={{ width: "100%", padding: "1rem" }}>
      <Paper
        elevation={3}
        sx={{
          padding: "0.75rem 1.5rem",
          borderRadius: "0.75rem",
          overflowX: "auto",
          whiteSpace: "nowrap",
          backgroundColor: "#fafafa",
        }}
      >
        <Stack direction="row" alignItems="center" spacing={1}>
          {steps.map((step, index) => (
            <React.Fragment key={index}>
              <Stack
                direction="row"
                alignItems="center"
                spacing={0.5}
                sx={{ cursor: "pointer" }}
                onClick={() => setActiveStep(index)}
              >
                {completed[index] ? (
                  <CheckCircleFill size={18} color={successColor} />
                ) : (
                  <Typography
                    sx={{
                      fontSize: "0.875rem",
                      width: "1.5rem",
                      height: "1.5rem",
                      textAlign: "center",
                      borderRadius: "50%",
                      backgroundColor: "#e0e0e0",
                      display: "inline-flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: "bold",
                      color: "#666",
                    }}
                  >
                    {index + 1}
                  </Typography>
                )}
                <Typography
                  sx={{
                    fontWeight: index === activeStep ? "bold" : "normal",
                    color: index === activeStep ? themeColor : "#999",
                    fontSize: "0.875rem",
                    whiteSpace: "nowrap",
                  }}
                >
                  {step.label}
                </Typography>
              </Stack>
              {index < steps.length - 1 && <ChevronRight size={14} color="#ccc" />}
            </React.Fragment>
          ))}
        </Stack>
      </Paper>

      <Paper
        elevation={2}
        sx={{
          marginTop: "1rem",
          borderRadius: "0.75rem",
          backgroundColor: "#fff",
          width: "100%",
        }}
      >
        {steps[activeStep].component}
        {errors[activeStep]}
      </Paper>

      {!viewMode && (
        <>
          <Divider sx={{ margin: "2rem 0" }} />

          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              gap: "1rem",
              flexWrap: "wrap",
            }}
          >
            <Button
              variant="outlined"
              onClick={handleBack}
              disabled={activeStep === 0}
              sx={{
                color: themeColor,
                borderColor: themeColor,
                fontWeight: "bold",
                borderRadius: "0.5rem",
                minWidth: "8rem",
                fontSize: "0.9rem",
              }}
            >
              {t("Previous")}
            </Button>
            
            {activeStep === totalSteps - 1 ? (
              <Button
                variant="contained"
                onClick={handlePayNow}
                sx={{
                  backgroundColor: themeColor,
                  fontWeight: "bold",
                  borderRadius: "0.5rem",
                  minWidth: "8rem",
                  fontSize: "0.9rem",
                  color: "#fff",
                  "&:hover": {
                    backgroundColor: "#1f4ea0",
                  },
                }}
              >
                {t("Pay Now")}
              </Button>
            ) : (
              <Button
                variant="contained"
                onClick={activeStep === 1 ? handleSave : handleNext}
                sx={{
                  backgroundColor: themeColor,
                  fontWeight: "bold",
                  borderRadius: "0.5rem",
                  minWidth: "8rem",
                  fontSize: "0.9rem",
                  color: "#fff",
                  "&:hover": {
                    backgroundColor: "#1f4ea0",
                  },
                }}
              >
                {activeStep === 1 ? t("Save & Next") : t("Next")}
              </Button>
            )}
          </Box>
        </>
      )}
      
      {viewMode && (
        <>
          <Divider sx={{ margin: "2rem 0" }} />
          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              gap: "1rem",
              flexWrap: "wrap",
            }}
          >
            <Button
              variant="outlined"
              onClick={handleBack}
              disabled={activeStep === 0}
              sx={{
                color: themeColor,
                borderColor: themeColor,
                fontWeight: "bold",
                borderRadius: "0.5rem",
                minWidth: "8rem",
                fontSize: "0.9rem",
              }}
            >
              {t("Previous")}
            </Button>
            
            {activeStep === 1 ? (
              <ActionDropdown
                actions={["Approve", "Reject", "Request Changes"]}
                onActionClick={handleActionClick}
                variant="contained"
                sx={{
                  backgroundColor: themeColor,
                  fontWeight: "bold",
                  borderRadius: "0.5rem",
                  minWidth: "8rem",
                  fontSize: "0.9rem",
                  color: "#fff",
                  "&:hover": {
                    backgroundColor: "#1f4ea0",
                  },
                }}
              />
            ) : (
              <Button
                variant="contained"
                onClick={handleNext}
                disabled={activeStep === totalSteps - 1}
                sx={{
                  backgroundColor: themeColor,
                  fontWeight: "bold",
                  borderRadius: "0.5rem",
                  minWidth: "8rem",
                  fontSize: "0.9rem",
                  color: "#fff",
                  "&:hover": {
                    backgroundColor: "#1f4ea0",
                  },
                }}
              >
                {t("Next")}
              </Button>
            )}
          </Box>
        </>
      )}

      {/* Approval Modal */}
      <ApprovalModal
        show={showApprovalModal}
        handleClose={handleCloseModal}
        handleSubmitData={handleActionSubmit}
        selectedAction={selectedAction}
      />
    </Box>
  );
};

export default Stepper;
import React, { useState } from "react";
import { Button, Modal, Form } from "react-bootstrap";
import InputFile from "./InputFile";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

const PaymentModal = ({
  show,
  onHide,
  paymentMode,
  setPaymentMode,
  challanFile,
  onChallanUpload,
  onOnlinePay,
  onOfflineSubmit,
  isLoading,
  formMethods, 
  supervisionAuthority, 
}) => {
  const [submitting, setSubmitting] = useState(false);
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  

  const handleOfflineSubmit = (e) => {
  e.preventDefault();
  if (!challanFile) return;
  
  setSubmitting(true);
  
  const formData = formMethods.getValues();


  const workOrderFiles = [];
  for (let i = 1; i <= 50; i++) {
    const file = formData[`workOrder_file_${i}`];
    const desc = formData[`workOrder_desc_${i}`];
    if (file && file.name) {
      workOrderFiles.push({
        file: file,
        description: desc || `Work order document ${i}`
      });
    }
  }

 
  const drawingFiles = [];
  for (let i = 1; i <= 50; i++) {
    const file = formData[`drawings_file_${i}`];
    const desc = formData[`drawings_desc_${i}`];
    if (file && file.name) {
      drawingFiles.push({
        file: file,
        description: desc || `Drawing document ${i}`
      });
    }
  }
 
  console.log("===== VESSEL REGISTRATION FORM DATA =====");
  console.log("1. Vessel Details:", {
    basicInfo: {
      ownerName: formData.ownerName,
      ownerAddress: formData.ownerAddress,
      mobile: formData.mobile,
      email: formData.email,
      pan: formData.pan,
      aadhar: formData.aadhar,
      tradeLicence: formData.tradeLicence,
      gst: formData.gst,
      grt: formData.grt,
      workOrderValue: formData.workOrderValue,
    },
    vesselSpecs: {
      vesselType: formData.vesselType,
      category: formData.category,
      zone: formData.zone,
      supervisionAuthority: formData.supervisionAuthority,
      purchaseType: formData.purchaseType,
      classificationSociety: formData.classificationSociety,
    },
    builderDetails: formData.constructedBy === "2" ? {
      builderName: formData.builderName,
      builderAddress: formData.builderAddress,
      builderEmail: formData.builderEmail,
      builderMobile: formData.builderMobile,
      builderTradeLicence: formData.builderTradeLicence,
      builderGST: formData.builderGST,
      builderAuth: formData.builderAuth,
      authLetter: formData.authLetter,
    } : null,
    documents: {
      workOrderFiles: workOrderFiles,
      drawingFiles: drawingFiles,
      tonnageBooklets: formData.tonnageBooklets,
      stabilityBooklets: formData.stabilityBooklets,
    },
    declaration: {
      termsAccepted: formData.termsAccepted,
    },
  });

  console.log("2. Invoicing Details:", {
    supervisionAuthority: supervisionAuthority,
    paymentMode: paymentMode,
    challanFile: challanFile?.name || null,
  });
  
  setTimeout(() => {
    setSubmitting(false);
    onOfflineSubmit();
  }, 800);
};

  return (
    <Modal show={show} onHide={onHide} centered>
      <Modal.Header closeButton>
        <Modal.Title>{t("Payment Option")}</Modal.Title>
      </Modal.Header>
      <Modal.Body>
        <Form onSubmit={handleOfflineSubmit}>
          <Form.Group>
            <Form.Label className="fw-semibold mb-2">
              {t("Select Payment Mode")}
            </Form.Label>
            <div className="d-flex gap-3 mb-3">
              <Form.Check
                type="radio"
                id="offline"
                label={t("Offline")}
                checked={paymentMode === "offline"}
                onChange={() => setPaymentMode("offline")}
                name="paymentMode"
              />
              <Form.Check
                type="radio"
                id="online"
                label={t("Online")}
                checked={paymentMode === "online"}
                onChange={() => setPaymentMode("online")}
                name="paymentMode"
              />
            </div>
          </Form.Group>
          {paymentMode === "offline" && (
            <div className="mb-3">
              <InputFile
                label={t("Upload Challan")}
                name="challan"
                required
                value={challanFile}
                onChange={onChallanUpload}
                errors={{}}
              />
            </div>
          )}
          <div className="d-flex justify-content-end gap-2 mt-4">
            <Button
              variant="secondary"
              onClick={onHide}
              style={{
                minWidth: 100,
                fontWeight: 500,
                borderRadius: 6,
                fontSize: "1rem",
              }}
              disabled={isLoading}
            >
             {t("Close")}
            </Button>
            {paymentMode === "offline" ? (
              <Button
                type="submit"
                variant="primary"
                disabled={submitting || isLoading || !challanFile}
                style={{
                  minWidth: 120,
                  fontWeight: 600,
                  borderRadius: 6,
                  fontSize: "1rem",
                }}
              >
                {submitting ? t("Submitting...") : t("Submit")}
              </Button>
            ) : (
              <Button
                variant="success"
                onClick={onOnlinePay}
                disabled={isLoading}
                style={{
                  minWidth: 160,
                  fontWeight: 600,
                  borderRadius: 6,
                  fontSize: "1rem",
                }}
              >
                {t("Proceed to Payment Gateway")}
              </Button>
            )}
          </div>
        </Form>
      </Modal.Body>
    </Modal>
  );
};

export default PaymentModal;
