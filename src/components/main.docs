import React, { useEffect, useState } from "react";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext.js";
import { Link, useLocation } from "react-router-dom";
import {
  FaHome,
  FaCog,
  FaChevronRight,
  FaShip,
  FaDatabase,
  FaTimes,
  FaClipboardCheck,
  FaAnchor,
  FaIdBadge,
  FaBell,
  FaChartBar,
  FaBalanceScale,
  FaGavel,
  FaMoneyCheckAlt,
  FaBoxes,
  FaDrawPolygon,
} from "react-icons/fa";
import styles from "./styles/Sidebar.module.css";
import { OFFICER_ROLES, USER_ROLES } from "../../utils/constants.ts";

const Sidebar = ({ isSidebarOpen, onMenuClick, onClose, userRole }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  const commonDashboard = {
    name: "dashboard",
    label: t("Dashboard"),
    icon: <FaHome />,
    path: "/dashboard",
  };

  const vesselRegistrationMenu = {
    name: "vessel-registration",
    label: t("Registration of Vessel"),
    path: "/vessel-registration/new-vessel",
    icon: <FaAnchor />,
    subMenu: [
      { name: "new-vessel-registration", label: t("New Vessel Registration"), path: "/vessel-registration/new-vessel" },
    ],
  };

  const existingVesselMenu = {
    name: "existing-vessel",
    label: t("Existing Vessel"),
    icon: <FaShip />,
    subMenu: [
      { name: "name-change", label: t("Name Change of Vessel"), path: "" },
      { name: "alteration-modification", label: t("Registration for Alteration/Modification of Inland Vessels"), path: "" },
      { name: "transfer-registry", label: t("Transfer of Registry"), path: "" },
      { name: "transfer-inland-vessel", label: t("Transfer of Inland Vessel"), path: "" },
      { name: "cancellation-registration", label: t("Cancellation of Registration"), path: "" },
      { name: "mortgage-registration", label: t("Registration for Mortgage of mechanically propelled inland vessel (Hypothecation)"), path: "" },
      { name: "de-mortgage-registration", label: t("De-registration for Mortgage of mechanically propelled inland vessel (De-hypothecation)"), path: "" },
      { name: "transfer-mortgage", label: t("Transfer for Mortgage of mechanically propelled inland vessel or share"), path: "" },
      { name: "duplicate-certificate", label: t("Duplicate Registration Certificatee"), path: "" },
      { name: "upload-legacy-data", label: t("Upload Legacy Data"), path: "/vessel-registration/upload-legacy-data" },
    ]
  };

  const surveyMenu = {
    name: "vessel-survey",
    label: t("Survey of Vessel"),
    path: "/vessel-survey/annual-survey",
    icon: <FaClipboardCheck />,
    subMenu: [
      { name: "annual-survey", label: t("Annual survey"), path: "/vessel-survey/annual-survey" },
      { name: "renewal-survey", label: t("Renewal Survey"), path: "renewal-survey" },
      { name: "extension-of-survey-certificate", label: t("Extension of Survey \nCertificate"), path: "extension-of-survey-certificate" },
      { name: "name-change-in-survey-certificate", label: t("Name change in Survey \nCertificate"), path: "name-change-in-survey-certificate" },
      { name: "state-inspection", label: t("State Inspection"), path: "state-inspection" },
      { name: "additional-survey-for-vessel-accident", label: t("Additional Survey \nfor Vessel Accident"), path: "additional-survey-for-vessel-accident" }
    ],
  };

  const masterMenu = {
    name: "master",
    label: t("Master"),
    icon: <FaDatabase />,
    subMenu: [
      { name: "manage-employee", label: t("Employee Management"), path: "/iwt/employee-management" },
    ],
  };

  const settingsItem = {
    name: "settings",
    label: t("Settings"),
    icon: <FaCog />,
    subMenu: [
      { name: "profile", label: t("Profile"), path: "/settings/profile" },
      { name: "security", label: t("Security"), path: "/settings/security" },
    ],
  };

  const officerCommonItems1 = [
    {
      name: "vessel-registration",
      label: t("Vessel Registration"),
      icon: <FaShip />,
    },
    {
      name: "survey-management",
      label: t("Survey Management"),
      icon: <FaClipboardCheck />,
      subMenu: [
        { name: "schedule-survey", label: t("Schedule Survey"), path: "" },
        { name: "survey-history", label: t("Survey History"), path: "" },
      ],
    },
    {
      name: "manning-certification",
      label: t("Manning & Certification"),
      icon: <FaIdBadge />,
      subMenu: [
        { name: "certification", label: t("Certification"), path: "/iwt/manning-certification/certification" },
      ],
    },
  ];

  const officerCommonItems2 = [
    {
      name: "mis-reports",
      label: "MIS Reports",
      icon: <FaChartBar />,
      subMenu: [
        { name: "vessel-report", label: "Vessel Reports", path: "/iwt/mis-reports/vessels" },
        { name: "survey-report", label: "Survey Reports", path: "/iwt/mis-reports/surveys" },
      ],
    },
    {
      name: "notifications",
      label: "Notifications",
      icon: <FaBell />,
      subMenu: [
        { name: "send-notification", label: "Send Notification", path: "/iwt/notifications/send" },
        { name: "notification-history", label: "Notification History", path: "/iwt/notifications/history" },
      ],
    },
  ];

  const commonDrawings = {
    name: "draing-approvas",
    label: "Approvals of Drawings",
    icon: <FaDrawPolygon />,
    path: "",
  };

  const DRAItems = [
    {
      name: "grievance-redressal",
      label: "Grievance Redressal",
      icon: <FaBalanceScale />,
    },
    {
      name: "offences-penalties",
      label: "Offences & Penalties",
      icon: <FaGavel />,
    },
    {
      name: "financial-dashboard",
      label: "Financial Dashboard",
      icon: <FaMoneyCheckAlt />,
    },
    {
      name: "inventory-procurement",
      label: "Inventory & Procurement",
      icon: <FaBoxes />,
    },
  ];

  const location = useLocation();
  const [activeMenu, setActiveMenu] = useState("");
  const [expandedMenus, setExpandedMenus] = useState({});

  const toggleSubMenu = (menuName) => {
    setExpandedMenus((prev) => {
      const isOpen = !!prev[menuName];
      return isOpen ? {} : { [menuName]: true };
    });
  };

  const getRoleSpecificMenuItems = () => {
    switch (true) {
      case userRole === USER_ROLES.ADMIN:
        return [commonDashboard, masterMenu];
      case [USER_ROLES.OFFICER_L1, USER_ROLES.OFFICER_L2].includes(userRole):
        return [commonDashboard, ...officerCommonItems1, ...officerCommonItems2];
      case [USER_ROLES.OFFICER_L3, USER_ROLES.OFFICER_L4].includes(userRole):
        return [commonDashboard, ...officerCommonItems1, commonDrawings, ...officerCommonItems2];
      case userRole === USER_ROLES.OFFICER_L5:
        return [commonDashboard, ...officerCommonItems1, ...DRAItems, masterMenu, ...officerCommonItems2];
      default:
        return [commonDashboard, vesselRegistrationMenu, existingVesselMenu, surveyMenu];
    }
  };

  const menuItems = [...getRoleSpecificMenuItems(), settingsItem];

  useEffect(() => {
    const findActiveMenuName = (items) => {
      for (const item of items) {
        if (item.path === location.pathname) return item.name;
        if (item.subMenu) {
          const result = findActiveMenuName(item.subMenu);
          if (result) return item.name;
        }
      }
      return "";
    };
    setActiveMenu(findActiveMenuName(menuItems));
  }, [location]);

  const SidebarItem = ({ item }) => {
    const isParentActive = activeMenu === item.name;
    const hasSubMenu = !!item.subMenu;
    const isExpanded = expandedMenus[item.name];

    // Check if any submenu item is active
    const isAnySubItemActive = hasSubMenu && item.subMenu.some(
      sub => location.pathname === sub.path
    );

    return (
      <li className={`${styles.item} ${isParentActive ? styles.activeParent : ""}`}>
        <div
          className={`${styles.link} ${isAnySubItemActive ? styles.parentWithActiveChild : ""}`}
          data-tooltip={item.label}
          onClick={() => {
            if (hasSubMenu) toggleSubMenu(item.name);
            else onMenuClick(item.name);
          }}
          aria-expanded={!!expandedMenus[item.name]}
        >
          <div className={styles.linkContent}>
            {item.icon && <span className={styles.icon}>{item.icon}</span>}
            {isSidebarOpen && <span>{item.label}</span>}
          </div>
          {hasSubMenu && isSidebarOpen && (
            <span className={`${styles.chevron} ${isExpanded ? styles.rotate : ""}`}>
              <FaChevronRight size={12} />
            </span>
          )}
        </div>

        {hasSubMenu && (
          <div className={`${styles.submenu} ${isExpanded && isSidebarOpen ? styles.expanded : styles.collapsed}`}>
            <ul className={styles.submenuList}>
              {item.subMenu.map((sub, index) =>
                sub.subMenu ? (
                  <SidebarItem key={sub.name + index} item={sub} />
                ) : (
                  <li key={sub.name + index}>
                    <Link
                      to={sub.path}
                      className={`${styles.sublink} ${location.pathname === sub.path ? styles.active : ""}`}
                      onClick={() => {
                        onMenuClick(sub.name);
                        setActiveMenu(item.name);
                      }}
                    >
                      {sub.label}
                    </Link>
                  </li>
                )
              )}
            </ul>
          </div>
        )}
      </li>
    );
  };

  return (
    <>
      {isSidebarOpen && window.innerWidth <= 768 && (
        <div className={`${styles.backdrop} ${styles.show}`} onClick={onClose} />
      )}
      <div className={`${styles.sidebar} ${isSidebarOpen ? styles.expanded : styles.collapsed}`}>
        <div className={styles.close}>
          <FaTimes onClick={onClose} />
        </div>
        <ul className={styles.menu}>
          {menuItems.map((item, index) => (
            <SidebarItem key={item.name + index} item={item} />
          ))}
        </ul>
      </div>
    </>
  );
};

export default Sidebar;
.sidebar {
  background: linear-gradient(135deg, #f4f8fc 0%, #e8f2ff 100%);
  color: #2466bf;
  height: calc(100vh - 60px);
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
  overflow-y: auto;
  overflow-x: hidden;
  padding-top: 0;
  box-shadow: 0 4px 20px rgba(36, 102, 191, 0.15);
  border-right: 1px solid #d1e7ff;
  position: fixed;
  top: 60px;
  z-index: 1000;
}

.collapsed {
  width: 70px;
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
}

.expanded {
  width: 18rem;
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
}

.menu,
.submenuList {
  list-style: none;
  padding: 0;
  margin: 0;
}

.item {
  transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  margin: 2px 8px;
  border-radius: 12px;
  overflow: hidden;
  opacity: 1;
}

/* Parent menu active state */
.activeParent > .link {
  /* background: rgba(36, 102, 191, 0.1); */
  /* color: #2466bf; */
  background: #2466bf;
  color: #fff;

  font-weight: 500;
}

/* Parent menu when child is active */
.parentWithActiveChild {
  background: rgba(36, 102, 191, 0.05);
}

.parentWithActiveChild > .link {
  font-weight: 500;
  color: #2466bf;
}

.parentWithActiveChild > .link:hover {
  background: rgba(36, 102, 191, 0.1);
}

.link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  border-radius: 12px;
  position: relative;
  overflow: hidden;
}

.link::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 1s ease-out;
}

.link:hover::before {
  left: 100%;
}

.link:hover {
  background: #2466bf;
  color: #fff;
  box-shadow: 0 2px 10px rgba(36, 102, 191, 0.1);
  transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

.linkContent {
  display: flex;
  align-items: center;
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.icon {
  margin-right: 14px;
  font-size: 1.2rem;
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
}

.sidebar.collapsed .icon {
  margin-right: 0;
  transform: scale(1.1);
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.chevron {
  margin-left: auto;
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
  opacity: 1;
  transform: rotate(0deg) scale(1);
}

.chevron.rotate {
  transform: rotate(90deg) scale(1.1);
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
}

.sidebar.collapsed .chevron {
  opacity: 0;
  transform: scale(0);
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.submenu {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 8px;
  border-radius: 0 0 12px 12px;
  backdrop-filter: blur(5px);
  transform-origin: top;
  transform: scaleY(0);
  transition: all 1.2s cubic-bezier(0.23, 1, 0.32, 1);
}

.submenu.expanded {
  max-height: 600px;
  opacity: 1;
  transform: scaleY(1);
  overflow-y: auto;
  transition: all 1.4s cubic-bezier(0.23, 1, 0.32, 1);
  padding: 8px 0;
}

.submenu.collapsed {
  max-height: 0;
  opacity: 0;
  transform: scaleY(0);
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
}

.submenuList {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sublink {
  margin: 3px 12px;
  display: block;
  padding: 12px 20px;
  color: #2466bf;
  text-decoration: none;
  font-size: 0.9rem;
  border-radius: 10px;
  transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  position: relative;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-20px);
}

.sublink::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 3px;
  background: linear-gradient(135deg, #2466bf, #1a4fa0);
  transform: scaleY(0);
  transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}

.sublink:hover::before,
.sublink.active::before {
  transform: scaleY(1);
}

.sublink:hover {
  background: rgba(36, 102, 191, 0.1);
  color: #2466bf;
  box-shadow: 0 2px 8px rgba(36, 102, 191, 0.1);
  transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

/* Active submenu item */
.sublink.active {
  background: #2466bf !important;
  color: #fff !important;
  font-weight: 600;
  box-shadow: 0 3px 12px rgba(36, 102, 191, 0.3);
}

.backdrop {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(2px);
  opacity: 0;
  transition: opacity 0.6s ease;
}

.backdrop.show {
  opacity: 1;
}

.close {
  display: none;
  justify-content: flex-end;
  padding: 1rem;
}

.close svg {
  cursor: pointer;
  font-size: 1.5rem;
  color: #2466bf;
  transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}

.close svg:hover {
  color: #1a4fa0;
  transform: rotate(90deg);
}

@media (max-width: 768px) {
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 280px;
    z-index: 1000;
    transition: transform 1s cubic-bezier(0.23, 1, 0.32, 1);
    background: linear-gradient(135deg, #f4f8fc 0%, #e8f2ff 100%);
  }

  .sidebar.collapsed {
    transform: translateX(-100%);
    transition: transform 1s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .sidebar.expanded {
    transform: translateX(0);
    transition: transform 1s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .close {
    display: flex;
  }

  .menu {
    padding-bottom: 2rem;
  }
}

.menu {
  list-style: none;
  padding: 12px 0;
  margin: 0;
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  max-height: calc(100vh - 60px);
}

.menu::-webkit-scrollbar {
  width: 6px;
}

.menu::-webkit-scrollbar-track {
  background: rgba(36, 102, 191, 0.1);
  border-radius: 3px;
}

.menu::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, rgba(36, 102, 191, 0.4), rgba(36, 102, 191, 0.6));
  border-radius: 3px;
  transition: background 0.6s ease;
}

.menu::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(135deg, rgba(36, 102, 191, 0.6), rgba(36, 102, 191, 0.8));
}

.submenu.expanded::-webkit-scrollbar {
  width: 4px;
}

.submenu.expanded::-webkit-scrollbar-thumb {
  background: rgba(36, 102, 191, 0.3);
  border-radius: 2px;
}

.sidebar.collapsed .menu {
  overflow: hidden;
}

.link span:not(.icon):not(.chevron) {
  transition: all 1s cubic-bezier(0.23, 1, 0.32, 1);
  opacity: 1;
  transform: translateX(0);
}

.sidebar.collapsed .link span:not(.icon):not(.chevron) {
  opacity: 0;
  transform: translateX(-20px);
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.sidebar.collapsed .link {
  position: relative;
}

.sidebar.collapsed .link::after {
  content: attr(data-tooltip);
  position: absolute;
  left: 100%;
  top: 50%;
  transform: translateY(-50%) scale(0.8);
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 8px 12px;
  border-radius: 6px;
  font-size: 0.85rem;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  z-index: 1000;
  margin-left: 10px;
}

.sidebar.collapsed .link:hover::after {
  opacity: 1;
  transform: translateY(-50%) translateX(5px) scale(1);
}

.submenu.expanded .sublink {
  animation: slideDownFade 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
}

.submenu.expanded .sublink:nth-child(1) { animation-delay: 0.1s; }
.submenu.expanded .sublink:nth-child(2) { animation-delay: 0.2s; }
.submenu.expanded .sublink:nth-child(3) { animation-delay: 0.3s; }
.submenu.expanded .sublink:nth-child(4) { animation-delay: 0.4s; }
.submenu.expanded .sublink:nth-child(5) { animation-delay: 0.5s; }
.submenu.expanded .sublink:nth-child(6) { animation-delay: 0.6s; }
.submenu.expanded .sublink:nth-child(7) { animation-delay: 0.7s; }
.submenu.expanded .sublink:nth-child(8) { animation-delay: 0.8s; }
.submenu.expanded .sublink:nth-child(9) { animation-delay: 0.9s; }

@keyframes slideDownFade {
  0% {
    opacity: 0;
    transform: translateY(-20px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.submenu.collapsed .sublink {
  animation: slideUpFade 0.5s cubic-bezier(0.23, 1, 0.32, 1) forwards;
}

@keyframes slideUpFade {
  0% {
    opacity: 1;
    transform: translateY(0);
  }
  100% {
    opacity: 0;
    transform: translateY(-20px);
  }
}

.link:active {
  transform: scale(0.98);
  transition: transform 0.1s ease;
}

.sublink:active {
  transform: scale(0.98);
  transition: transform 0.1s ease;
}
