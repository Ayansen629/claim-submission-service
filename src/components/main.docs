import React, { useCallback, useEffect, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepFirst.css";
import 'bootstrap/dist/css/bootstrap.min.css';

const StepFirst = ({ provideSubmitHandler, formData }) => {
    const [isUploading, setIsUploading] = useState(false);
    const [uploadError, setUploadError] = useState(null);
    const [identificationType, setIdentificationType] = useState("incorporated");

    const methods = useForm();
    const { register, handleSubmit, formState: { errors }, trigger, setValue, control, getValues, watch } = methods;

    const watchIdentificationType = watch("identificationTypeRadio", "incorporated");

    const handleFileUpload = async (file) => {
        try {
            setIsUploading(true);
            setUploadError(null);
            const result = await uploadDocument(file, 'identification');
            return result;
        } catch (error) {
            setUploadError(error.message);
            throw error;
        } finally {
            setIsUploading(false);
        }
    };

    const basicDetailsSchema = [
        {
            name: "financialCreditorName",
            label: <>Name of the financial creditor <span className="required-asterisk">*</span></>,
            type: "text",
            rules: { required: "Financial creditor name is required" },
            placeholder: "Enter financial creditor name",
            tooltip: "Legal name of the financial creditor"
        },
        {
            name: "financialCreditorEmail",
            label: <>Email address of the financial creditor <span className="required-asterisk">*</span></>,
            type: "email",
            rules: { 
                required: "Email is required",
                pattern: {
                    value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                    message: "Invalid email address"
                }
            },
            placeholder: "Enter email address",
            tooltip: "Official email address of the financial creditor"
        },
        {
            name: "identificationTypeRadio",
            label: <>Identification type <span className="required-asterisk">*</span></>,
            type: "radio-group",
            options: [
                { value: "incorporated", label: "Incorporated body" },
                { value: "partnership", label: "Partnership or individual" }
            ],
            rules: { required: "Identification type is required" },
            defaultValue: "incorporated"
        }
    ];

    const incorporatedBodyFields = [
        {
            name: "incorporatedIdentificationNumber",
            label: <>Identification Number <span className="required-asterisk">*</span></>,
            type: "text",
            rules: { 
                required: watchIdentificationType === "incorporated" && "Identification number is required",
                pattern: {
                    value: /^[A-Z0-9]{8,15}$/,
                    message: "Invalid identification number"
                }
            },
            placeholder: "Enter identification number",
            tooltip: "Corporate identification number or similar"
        },
        {
            name: "incorporatedProofDocument",
            label: <>Proof of identification <span className="required-asterisk">*</span></>,
            type: "file",
            rules: { 
                required: watchIdentificationType === "incorporated" && "Proof document is required",
                validate: {
                    fileSize: (files) => {
                        if (files && files[0]) {
                            const fileSizeInMB = files[0].size / (1024 * 1024);
                            return fileSizeInMB <= 5 || "File size must be ≤ 5MB";
                        }
                        return true;
                    }
                }
            },
            tooltip: "Upload certificate of incorporation or similar",
            accept: "image/*,.pdf",
            onFileUpload: handleFileUpload,
            isUploading,
            uploadError,
            note: "Max file size: 5MB (PDF, JPEG, PNG)"
        }
    ];

    const partnershipIndividualFields = [
        {
            name: "partnershipIdentificationRecords",
            label: <>Identification records <span className="required-asterisk">*</span></>,
            type: "textarea",
            rules: { 
                required: watchIdentificationType === "partnership" && "Identification records are required" 
            },
            placeholder: "Enter identification details",
            tooltip: "Details of identification records for all partners/individual"
        },
        {
            name: "partnershipProofDocument",
            label: <>Identification proof <span className="required-asterisk">*</span></>,
            type: "file",
            rules: { 
                required: watchIdentificationType === "partnership" && "Identification proof is required",
                validate: {
                    fileSize: (files) => {
                        if (files && files[0]) {
                            const fileSizeInMB = files[0].size / (1024 * 1024);
                            return fileSizeInMB <= 5 || "File size must be ≤ 5MB";
                        }
                        return true;
                    }
                }
            },
            tooltip: "Upload identification proof for all partners/individual",
            accept: "image/*,.pdf",
            onFileUpload: handleFileUpload,
            isUploading,
            uploadError,
            note: "Max file size: 5MB (PDF, JPEG, PNG)"
        }
    ];

    const addressDetailsSchema = [
        {
            name: "addressLine1",
            label: <>Address line 1 <span className="required-asterisk">*</span></>,
            type: "text",
            rules: { required: "Address line 1 is required" },
            placeholder: "Enter address line 1",
            tooltip: "Street address, P.O. box, company name"
        },
        {
            name: "addressLine2",
            label: "Address line 2",
            type: "text",
            placeholder: "Enter address line 2",
            tooltip: "Apartment, suite, unit, building, floor, etc."
        },
        {
            name: "city",
            label: <>City <span className="required-asterisk">*</span></>,
            type: "text",
            rules: { required: "City is required" },
            placeholder: "Enter city",
            tooltip: "City or locality"
        },
        {
            name: "state",
            label: <>State <span className="required-asterisk">*</span></>,
            type: "text",
            rules: { required: "State is required" },
            placeholder: "Enter state",
            tooltip: "State or province"
        },
        {
            name: "pincode",
            label: <>Pincode <span className="required-asterisk">*</span></>,
            type: "text",
            rules: { 
                required: "Pincode is required",
                pattern: {
                    value: /^[1-9][0-9]{5}$/,
                    message: "Invalid Indian pincode"
                }
            },
            placeholder: "Enter 6-digit pincode",
            tooltip: "Postal code or ZIP code"
        }
    ];

    const onSubmit = useCallback(async () => {
        const isValid = await trigger();
        if (!isValid) {
            console.error("Validation failed");
            return false;
        }
        return getValues();
    }, [trigger, getValues]);

    useEffect(() => {
        if (formData) {
            Object.keys(formData).forEach((key) => {
                setValue(key, formData[key]);
            });
            if (formData.identificationTypeRadio) {
                setIdentificationType(formData.identificationTypeRadio);
            }
        }
    }, [formData, setValue]);

    useEffect(() => {
        if (provideSubmitHandler) {
            provideSubmitHandler(onSubmit);
        }
    }, [provideSubmitHandler, onSubmit]);

    return (
        <FormProvider {...methods}>
            <form className="form-stepper">
                <div className="mb-4 bg-light">
                    <Collapsible title="Basic Details" defaultOpen={true}>
                        <div className="flex-container">
                            {basicDetailsSchema.map((fieldConfig) => (
                                <DynamicField
                                    key={fieldConfig.name}
                                    fieldConfig={fieldConfig}
                                    control={control}
                                    register={register}
                                    errors={errors}
                                    setValue={setValue}
                                    trigger={trigger}
                                    getValues={getValues}
                                />
                            ))}
                            
                            {watchIdentificationType === "incorporated" && (
                                <div className="conditional-fields">
                                    {incorporatedBodyFields.map((fieldConfig) => (
                                        <DynamicField
                                            key={fieldConfig.name}
                                            fieldConfig={{
                                                ...fieldConfig,
                                                isUploading,
                                                uploadError,
                                                setIsUploading,
                                                setUploadError,
                                                onFileUpload: handleFileUpload
                                            }}
                                            control={control}
                                            register={register}
                                            errors={errors}
                                            setValue={setValue}
                                            trigger={trigger}
                                            getValues={getValues}
                                        />
                                    ))}
                                </div>
                            )}

                            {watchIdentificationType === "partnership" && (
                                <div className="conditional-fields">
                                    {partnershipIndividualFields.map((fieldConfig) => (
                                        <DynamicField
                                            key={fieldConfig.name}
                                            fieldConfig={{
                                                ...fieldConfig,
                                                isUploading,
                                                uploadError,
                                                setIsUploading,
                                                setUploadError,
                                                onFileUpload: handleFileUpload
                                            }}
                                            control={control}
                                            register={register}
                                            errors={errors}
                                            setValue={setValue}
                                            trigger={trigger}
                                            getValues={getValues}
                                        />
                                    ))}
                                </div>
                            )}
                        </div>
                    </Collapsible>

                    <Collapsible title="Address Details" defaultOpen={true}>
                        <div className="flex-container">
                            {addressDetailsSchema.map((fieldConfig) => (
                                <DynamicField
                                    key={fieldConfig.name}
                                    fieldConfig={fieldConfig}
                                    control={control}
                                    register={register}
                                    errors={errors}
                                    setValue={setValue}
                                    trigger={trigger}
                                    getValues={getValues}
                                />
                            ))}
                        </div>
                    </Collapsible>
                </div>
            </form>
        </FormProvider>
    );
};

export default StepFirst;

import React from 'react';
import { useFormContext } from 'react-hook-form';

const DynamicField = ({
  fieldConfig,
  register,
  errors,
  setValue,
  trigger,
  getValues,
  control,
}) => {
  const {
    name,
    label,
    type,
    rules = {},
    options = [],
    placeholder = '',
    disabled = false,
    tooltip = '',
    note = '',
    accept = '',
    isUploading = false,
    uploadError = null,
    onFileUpload = () => {},
    setIsUploading = () => {},
    setUploadError = () => {},
    defaultValue = null,
  } = fieldConfig;

  const { watch } = useFormContext();
  const value = watch(name);

  const handleFileChange = async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    try {
      setIsUploading(true);
      setUploadError(null);
      const uploadedFile = await onFileUpload(file);
      setValue(name, uploadedFile);
      trigger(name);
    } catch (error) {
      setUploadError(error.message);
      setValue(name, null);
    } finally {
      setIsUploading(false);
    }
  };

  const renderField = () => {
    switch (type) {
      case 'text':
      case 'email':
      case 'number':
        return (
          <input
            type={type}
            id={name}
            className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
            placeholder={placeholder}
            disabled={disabled}
            {...register(name, rules)}
          />
        );
      case 'textarea':
        return (
          <textarea
            id={name}
            className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
            placeholder={placeholder}
            rows={3}
            {...register(name, rules)}
          />
        );
      case 'select':
        return (
          <select
            id={name}
            className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
            {...register(name, rules)}
          >
            {options.map((option) => (
              <option key={option.value} value={option.value}>
                {option.label}
              </option>
            ))}
          </select>
        );
      case 'radio-group':
        return (
          <div className="radio-group">
            {options.map((option) => (
              <div key={option.value} className="form-check form-check-inline">
                <input
                  type="radio"
                  id={`${name}-${option.value}`}
                  className="form-check-input"
                  value={option.value}
                  defaultChecked={defaultValue === option.value}
                  {...register(name, rules)}
                />
                <label
                  htmlFor={`${name}-${option.value}`}
                  className="form-check-label"
                >
                  {option.label}
                </label>
              </div>
            ))}
          </div>
        );
      case 'file':
        return (
          <div>
            <input
              type="file"
              id={name}
              className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
              accept={accept}
              onChange={handleFileChange}
              disabled={isUploading}
            />
            {note && <small className="form-text text-muted">{note}</small>}
            {isUploading && (
              <div className="mt-2 text-info">Uploading file...</div>
            )}
            {uploadError && (
              <div className="mt-2 text-danger">{uploadError}</div>
            )}
            {value && !isUploading && !uploadError && (
              <div className="mt-2 text-success">File uploaded successfully</div>
            )}
          </div>
        );
      default:
        return null;
    }
  };

  return (
    <div className={`form-group ${type === 'radio-group' ? 'radio-group-container' : ''}`}>
      <label htmlFor={name} className="form-label">
        {label}
        {tooltip && (
          <span
            className="ms-1 tooltip-icon"
            title={tooltip}
            data-bs-toggle="tooltip"
          >
            <i className="bi bi-info-circle"></i>
          </span>
        )}
      </label>
      {renderField()}
      {errors[name] && (
        <div className="invalid-feedback d-block">
          {errors[name].message}
        </div>
      )}
    </div>
  );
};

export default DynamicField;
