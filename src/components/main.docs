import React from "react";
import { Card, Row, Col, Table, Button } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

const invoiceData = {
  invoiceBreakupInfo: [
    { id: "1", label: "Tonnage Fees", amount: 2000.0 },
    { id: "2", label: "Registration Charges", amount: 1500.0 },
    { id: "3", label: "Survey Fees", amount: 1200.0 },
    {
      id: "4",
      label: "Inspection Charges",
      components: [
        { name: "Initial", amount: 800.0 },
        { name: "Follow-up", amount: 400.0 }
      ]
    },
    { id: "5", label: "Processing Fees", amount: 500.0 },
    {
      id: "6",
      label: "Port Clearance Tax",
      components: [
        { name: "Primary", amount: 1000.0 },
        { name: "Additional", amount: 300.0 }
      ]
    },
    { id: "7", label: "Manning Certification Fees", amount: 750.0 },
    { id: "8", label: "Environmental Cess", amount: 350.0 },
    { id: "9", label: "Duplicate Certificate Fees", amount: 250.0 }
  ],
  summary: {
    subTotal: 9250.0,
    cgst: 832.5,
    sgst: 832.5,
    totalPayable: 10915.0
  }
};

const Invoicing = ({ supervisionAuthority, onPayNow }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  const renderFeeStructure = () => {
    switch (supervisionAuthority) {
      case "iwt":
        return (
          <>
            <tr>
              <td>{t("Drawing Approval Fee")}</td>
              <td>
                {t("Rs. 0.1% of the work order value")}<br />
                <span style={{ color: "#888" }}>{t("Minimum Rs. 500/- + GST")}</span>
              </td>
            </tr>
            <tr>
              <td>{t("Supervision Fee")}</td>
              <td>
                <div>
                  {t("1% of the Contract Price up to 10 lac")}<br />
                  <span style={{ color: "#888" }}>{t("(Minimum Rs. 1000)")}</span>
                </div>
                <div className="mt-2">
                  {t("Above Rs. 10 lac to 40 lac:")} <br />
                  <span style={{ color: "#2466BF" }}>{t("Rs. 10,000/- + ½% of the cost above 10 lac")}</span>
                </div>
                <div className="mt-2">
                  {t("Above Rs. 40 lac:")} <br />
                  <span style={{ color: "#2466BF" }}>{t("Rs. 25,000/- + ¼% of the cost above 40 lac")}</span>
                </div>
              </td>
            </tr>
          </>
        );
      case "classificationSociety":
        return (
          <tr>
            <td>{t("Drawing Scrutiny Fee")}</td>
            <td>
              {t("0.05% of the work order value")}<br />
              <span style={{ color: "#888" }}>{t("Minimum Rs. 500/-")}</span>
            </td>
          </tr>
        );
      default:
        return null;
    }
  };

  const renderInvoiceBreakdown = () => (
    <Card className="shadow-sm mt-4">
      <Card.Header style={{ background: "#EAF1FB", color: "#2466BF", fontWeight: 600 }}>
        {t("Invoice Breakdown")}
      </Card.Header>
      <Card.Body>
        <Table bordered responsive className="mb-4">
          <thead style={{ background: "#f8f9fa" }}>
            <tr>
              <th width="50%">{t("Item Description")}</th>
              <th width="30%">{t("Components")}</th>
              <th width="20%" className="text-end">{t("Amount (₹)")}</th>
            </tr>
          </thead>
          <tbody>
            {invoiceData.invoiceBreakupInfo.map((item) => (
              <tr key={item.id}>
                <td>{item.label}</td>
                <td>
                  {item.components ? (
                    <ul className="list-unstyled mb-0">
                      {item.components.map((comp, idx) => (
                        <li key={idx}>
                          <small>
                            {comp.name}: ₹{comp.amount.toFixed(2)}
                          </small>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    "-"
                  )}
                </td>
                <td className="text-end">
                  {item.amount
                    ? `₹${item.amount.toFixed(2)}`
                    : item.components
                    ? `₹${item.components.reduce((sum, comp) => sum + comp.amount, 0).toFixed(2)}`
                    : "-"}
                </td>
              </tr>
            ))}
          </tbody>
        </Table>

        <Row className="justify-content-end">
          <Col md={6}>
            <Table borderless className="mb-0">
              <tbody>
                <tr>
                  <td>{t("Sub Total:")}</td>
                  <td className="text-end">₹{invoiceData.summary.subTotal.toFixed(2)}</td>
                </tr>
                <tr>
                  <td>{t("CGST (9%):")}</td>
                  <td className="text-end">₹{invoiceData.summary.cgst.toFixed(2)}</td>
                </tr>
                <tr>
                  <td>{t("SGST (9%):")}</td>
                  <td className="text-end">₹{invoiceData.summary.sgst.toFixed(2)}</td>
                </tr>
                <tr style={{ borderTop: "1px solid #dee2e6" }}>
                  <td className="pt-2" style={{ fontWeight: 600 }}>{t("Total Payable:")}</td>
                  <td className="text-end pt-2" style={{ fontWeight: 600, color: "#2466BF" }}>
                    ₹{invoiceData.summary.totalPayable.toFixed(2)}
                  </td>
                </tr>
              </tbody>
            </Table>
          </Col>
        </Row>

        <div className="d-flex justify-content-end mt-4">
          <Button
            variant="primary"
            onClick={onPayNow}
            style={{ background: "#2466BF", border: "none", padding: "0.5rem 2rem" }}
          >
            {t("Proceed to Payment")}
          </Button>
        </div>
      </Card.Body>
    </Card>
  );

  return (
    <div className="container py-4">
      <h2 className="mb-4" style={{ color: "#2466BF", fontWeight: 600 }}>
        {t("Invoicing")}
      </h2>
      <Row className="mb-4 justify-content-center">
        {supervisionAuthority ? (
          <Col md={10}>
            <Card className="shadow-sm">
              <Card.Header style={{ background: "#EAF1FB", color: "#2466BF", fontWeight: 600 }}>
                {t(`Supervision Authority: ${supervisionAuthority === "iwt" ? "IWT" : "Classification Society"}`)}
              </Card.Header>
              <Card.Body>
                <Table bordered responsive className="mb-0">
                  <thead>
                    <tr>
                      <th>{t("Payment")}</th>
                      <th>{t("Fee Structure")}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {renderFeeStructure()}
                  </tbody>
                </Table>
              </Card.Body>
            </Card>

            {renderInvoiceBreakdown()}
          </Col>
        ) : (
          <Col md={8}>
            <Card className="shadow-sm">
              <Card.Body>
                <div style={{ color: "#888", textAlign: "center" }}>
                  {t("Please select a Supervision Authority in Step 1 to view invoicing details.")}
                </div>
              </Card.Body>
            </Card>
          </Col>
        )}
      </Row>
    </div>
  );
};

export default Invoicing;
