<EquipmentTableRow
  key={category.categoryCode}
  category={category}
  fieldName={fieldName}
  equipmentId={equipment.id}
  categoryCode={category.categoryCode}
  register={register}
  errors={errors}
  watch={watch}
  handleConditionChange={handleConditionChange}
  isFieldDisabled={isFieldDisabled}
  viewMode={viewMode}
  values={values}
/>
