import React, { useState, useEffect } from "react";
import { FaPhone, FaEnvelope, FaCheckSquare, FaChevronDown, FaEdit } from "react-icons/fa";
import styles from './Profile.module.css';
import UserProfileLogo from "../../../assets/images/user-profilelogo.jpg";
import { getFromLocalStorage } from "../../../utils/localStorageUtils.js";
import { USER_ROLES } from "../../../utils/constants.ts";

const Profile = () => {
  const [profileData, setProfileData] = useState({
    name: "",
    phone: "",
    email: "",
    pan: "",
    aadhar: "",
    license: ""
  });

  useEffect(() => {
    const safeParse = (key) => {
      try {
        return JSON.parse(getFromLocalStorage(key) || "{}");
      } catch {
        return {};
      }
    };

    const userRole = getFromLocalStorage("userRole");
    let data = {};

    if (userRole === USER_ROLES.VESSEL_OWNER) {
      const ownerDetails = safeParse("ownerDetails");
      data = {
        name: ownerDetails.ownerCompanyName || ownerDetails.authorisedFname || "User",
        phone: ownerDetails.phoneNumber || "",
        email: ownerDetails.emailId || "",
        pan: ownerDetails.panNo ? `${ownerDetails.panNo.substring(0, 4)}*******` : "",
        aadhar: ownerDetails.aadharNumber ? `${ownerDetails.aadharNumber.substring(0, 4)} ${ownerDetails.aadharNumber.substring(4, 8)} ****` : "",
        license: ownerDetails.tradeLicenseNumber ? `${ownerDetails.tradeLicenseNumber.substring(0, 15)}******` : ""
      };
    } else {
      const employeeDetails = safeParse("employeeDetails");
      data = {
        name: `${employeeDetails.firstName || ""} ${employeeDetails.lastName || ""}`.trim() || "User",
        phone: employeeDetails.phoneNumber || "",
        email: employeeDetails.emailId || "",
        pan: "",
        aadhar: "",
        license: ""
      };
    }

    setProfileData(data);
  }, []);

  return (
    <div className={styles.container}>
      <div className={styles.card}>
        <div className={styles.circularImage}>
          <img 
            src={UserProfileLogo}
            alt="Profile"
          />
          <div className={styles.editIcon}>
            <FaEdit />
          </div>
        </div>
        
        <h1 className={styles.companyName}>{profileData.name}</h1>
        
        <div className={styles.contactRow}>
          <div className={styles.contactItem}>
            <FaPhone className={styles.phoneIcon} />
            <span>+91 {profileData.phone}</span>
          </div>
          <div className={styles.contactItem}>
            <FaEnvelope className={styles.emailIcon} />
            <span>{profileData.email}</span>
          </div>
        </div>
        
        <div className={styles.documentRow}>
          {profileData.pan && <span className={styles.docLabel}>PAN: {profileData.pan}</span>}
          {profileData.aadhar && <span className={styles.docLabel}>Aadhar: {profileData.aadhar}</span>}
          {profileData.license && <span className={styles.docLabel}>License: {profileData.license}</span>}
        </div>
        
        <div className={styles.vesselSection}>
          <div className={styles.vesselHeader}>
            <span>Vessel Details</span>
            <FaChevronDown className={styles.chevron} />
          </div>
          
          <div className={styles.optionsSection}>
            <div className={styles.option}>
              <FaCheckSquare className={styles.checkIcon} />
              <span>Name Change</span>
              <FaEdit className={styles.optionEditIcon} />
            </div>
            <div className={styles.option}>
              <FaCheckSquare className={styles.checkIcon} />
              <span>Address Change</span>
              <FaEdit className={styles.optionEditIcon} />
            </div>
          </div>
        </div>
        
        <button className={styles.proceedButton}>
          Proceed Now
        </button>
      </div>
    </div>
  );
};

export default Profile;
