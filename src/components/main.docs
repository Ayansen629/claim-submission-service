{/* Left Side: Logo + Brand Name */}
<div className="mt-0 col-12 d-flex flex-column align-items-center align-items-md-start">
  <div className="d-flex align-items-center justify-content-center" style={{ marginTop: "-2rem" }}>
    <img className="me-2" src={IWTIcon} alt="Logo" style={{ width: "5.5rem", borderRadius: "0px" }} />
  </div>
  <div className="text-center text-md-start">
    <p className={`${styles.brandName} mt-1`}>{t("home2.InlandWaterTransportServices")}</p>
    <p className={`${styles.brandName} mt-1`}>{t("home2.departmentOfWB")}</p>
  </div>
  
  {/* Mobile Login Button */}
  <Button variant="light" className={`${styles.homeLoginBtn} d-block d-md-none`} onClick={() => navigate("/login")}>
    {t("home2.Login")}
  </Button>
</div>
