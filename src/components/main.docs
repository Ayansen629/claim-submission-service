.collapseContainer {
   
  background-color: "#EAF1FB";
  color: "#2466BF";
  font-weight: 600;
  border-radius: "0.4rem";
  padding: "0.75rem 1rem";
  
  }
  
  .collapseContainer.open {
    background-color: #f0f0f0;
   /* margin-left: -1rem;
    margin-right: -1rem; */
     
  }
  
  
  .collapseContainer.closed {
    background-color: #ffffff; 
    /* margin-left: -1rem;
    margin-right: -1rem; */
  }
  .collapseDiv {
    display: flex;
    justify-content: space-between;
    padding: 6px 8px;
    align-items: center;
    margin-bottom: 0.75rem;
    cursor: pointer;
    background-color: rgb(234, 241, 251);
    color: rgb(36, 102, 191);
    
  }
  
  .collapseDiv title {
    color: #000;
    font-size: 1.125;
    font-weight: bold;
    
  }
  .open-collapse {
    width: 24px;
    height: 29px;
    border-radius: 50%;
    display: flex
;
    justify-content: center;
    align-items: center;
    margin-right: 8px;
  }
  .title {
    font-weight: 550;
    font-size: 0.85rem;
    font-family: 'Roboto', sans-serif;
    font-weight: bold;
  }

  .cptitle{
    font-size: 1rem!important;
    color: #2466BF!important;
  }
  
  .tiles_Size {
    border: 1px solid #0000001F !important;
    padding: 0;
  }
  .tiles_Size .card-body1 {
    flex: 1 1 auto;
    padding: 0 !important;
  color: var(--bs-card-color);
   }
  .card1 {
    background-color: white;
    padding: 2rem;
    border-radius: 8px;
    width: 100%;
    max-width: 1200px;
  }
