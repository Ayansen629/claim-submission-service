/* Pagination styles */
.paginationButton {
  background: linear-gradient(178deg, #7ec8f8, #0d5ed0);
  border: 1px solid #2466BF;
  border-radius: 6px;
  padding: 0.5rem 0.75rem;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2.5rem;
  font-weight: 500;
  color: white;
}

.paginationButton:hover:not(:disabled) {
  background: linear-gradient(178deg, #7ec8f8, #07387c);
  color: white;
  border-color: #1a4d8f;
  transform: translateY(-1px);
  box-shadow: 0 2px 5px rgba(11, 94, 215, 0.3);
}

.paginationButton:disabled {
  background-color: #e9ecef;
  border-color: #dee2e6;
  color: #adb5bd;
  opacity: 1;
  cursor: not-allowed;
}

.pageNumber {
  background: linear-gradient(178deg, #7ec8f8, #0d5ed0);
  border: 1px solid #2466BF;
  border-radius: 6px;
  min-width: 2.5rem;
  height: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  font-weight: 500;
  color: white;
}

.pageNumber:hover {
  background: linear-gradient(178deg, #7ec8f8, #07387c);
  border-color: #1a4d8f;
  transform: translateY(-1px);
}

.pageNumber.active {
  background: linear-gradient(178deg, #b4f8c8, #19ab4c);
  color: white;
  box-shadow: 0 4px 5px rgba(6, 130, 11, 0.5);
  border-color: #198754;
}

.paginationIcon {
  font-size: 1rem;
  line-height: 1;
}

.paginationEllipsis {
  margin: 0 0.2rem;
  color: #6c757d;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 2.5rem;
}

/* Table footer styles */
.tableFooter {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem;
  background-color: #f8f9fa;
  border-top: 1px solid #e9ecef;
  border-radius: 0 0 8px 8px;
}

.tableInfo {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.entriesInfo {
  color: #495057;
  font-size: 0.95rem;
  font-weight: 500;
}

.selectedBadge {
  background: linear-gradient(178deg, #7ec8f8, #0d5ed0);
  color: white;
  padding: 0.35rem 0.75rem;
  border-radius: 50px;
  font-size: 0.85rem;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  box-shadow: 0 2px 5px rgba(11, 94, 215, 0.25);
}

/* Responsive styles */
@media (max-width: 768px) {
  .tableFooter {
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }
  
  .tableInfo {
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .paginationButton,
  .pageNumber {
    min-width: 2rem;
    height: 2rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.85rem;
  }
}
