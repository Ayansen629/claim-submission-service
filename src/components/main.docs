.registrationCertificateContainer {
  background: white;
  border: 2px solid #2466BF;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 12px rgba(36, 102, 191, 0.15);
  margin-top: 1rem;
}

.certificateHeader {
  background: linear-gradient(135deg, #2466BF 0%, #1a4fa0 100%);
  padding: 1rem;
  text-align: center;
}

.certificateTitle {
  color: white;
  font-weight: 700;
  font-size: 1.3rem;
  margin: 0;
  letter-spacing: 1px;
}

.certificateBody {
  padding: 2rem;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
}

.expirySection, .issuedBySection {
  text-align: center;
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 6px;
  border: 1px solid #dee2e6;
  margin-bottom: 1rem;
}

.expiryLabel, .issuedLabel {
  font-weight: 600;
  color: #2466BF;
  font-size: 1rem;
}

.editableDate {
  border: 2px solid #2466BF;
  border-radius: 4px;
  padding: 0.5rem;
  font-size: 0.9rem;
  margin-left: 0.5rem;
  width: 150px;
  transition: border-color 0.2s ease;
}

.editableDate:focus {
  outline: none;
  border-color: #1a4fa0;
  box-shadow: 0 0 0 3px rgba(36, 102, 191, 0.1);
}

.sectionTitle {
  color: #2466BF;
  font-weight: 700;
  font-size: 1.1rem;
  text-align: center;
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-bottom: 2px solid #2466BF;
  padding-bottom: 0.5rem;
}

.particularsTable {
  font-size: 0.8rem;
  margin-bottom: 0;
  border-collapse: separate;
  border-spacing: 0;
}

.labelCell {
  background: linear-gradient(135deg, #2466BF 0%, #1a4fa0 100%);
  color: white;
  font-weight: 600;
  padding: 0.75rem 0.5rem;
  text-align: center;
  width: 12.5%;
  vertical-align: middle;
  border: 1px solid #1a4fa0;
}

.autoPopulateCell {
  background: #e8f4fd !important;
  color: #072957 !important;
  font-weight: 700;
  padding: 0.75rem 0.5rem;
  text-align: center;
  width: 12.5%;
  vertical-align: middle;
  font-style: italic;
  border: 1px solid #dee2e6;
}

.editableCell {
  background: #fff8dc;
  padding: 0.5rem;
  text-align: center;
  width: 12.5%;
  vertical-align: middle;
  border: 1px solid #dee2e6;
  position: relative;
}

.editableInput {
  border: 1px solid #ced4da;
  border-radius: 4px;
  padding: 0.4rem;
  width: 100%;
  text-align: center;
  font-size: 0.75rem;
  transition: border-color 0.2s ease;
}

.editableInput:focus {
  outline: none;
  border-color: #2466BF;
  box-shadow: 0 0 0 2px rgba(36, 102, 191, 0.1);
}

.surveyNote {
  background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
  border: 2px solid #ffeaa7;
  padding: 1.5rem;
  border-radius: 8px;
  text-align: center;
  margin-bottom: 1.5rem;
}

.noteText {
  margin: 0;
  font-weight: 600;
  color: #856404;
  font-size: 1rem;
}

.fieldLabel {
  display: block;
  font-weight: 600;
  color: #2466BF;
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
}

.required {
  font-weight: 700;
}

.asterisk {
  color: #dc3545;
  margin-left: 2px;
  font-weight: bold;
}

.crewSection {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  padding: 1.5rem;
  border-radius: 8px;
  border-left: 4px solid #2466BF;
  margin-bottom: 1.5rem;
}

.crewInfo {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.crewLabel {
  font-weight: 600;
  color: #495057;
  font-size: 1rem;
}

.crewValue {
  font-weight: 700;
  color: #2466BF;
  font-size: 1.2rem;
  background: white;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  border: 2px solid #2466BF;
}

.certificationStatement {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  padding: 2rem;
  border-radius: 8px;
  border-left: 4px solid #2466BF;
  margin-bottom: 1.5rem;
}

.statementText {
  text-align: justify;
  line-height: 1.8;
  margin: 0;
  color: #333;
  font-size: 0.95rem;
}

.ownerTable {
  font-size: 0.9rem;
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 8px;
  overflow: hidden;
}

.ownerHeader, .sharesHeader {
  background: linear-gradient(135deg, #2466BF 0%, #1a4fa0 100%);
  color: white;
  text-align: center;
  font-weight: 600;
  padding: 1rem;
  border: none;
}

.ownerInfo {
  padding: 1.5rem;
  line-height: 1.8;
  background: #e8f4fd;
  border: none;
}

.ownerInfo div {
  margin-bottom: 0.75rem;
  font-size: 0.95rem;
}

.sharesValue {
  text-align: center;
  font-weight: 700;
  color: #2466BF;
  font-size: 1.1rem;
  vertical-align: middle;
  padding: 1rem;
  background: #fff8dc;
  border: none;
}

.sharesInput {
  width: 60px;
  padding: 0.5rem;
  border: 2px solid #2466BF;
  border-radius: 4px;
  text-align: center;
  font-weight: bold;
  margin-right: 0.5rem;
  font-size: 1rem;
}

.sharesInput:focus {
  outline: none;
  border-color: #1a4fa0;
  box-shadow: 0 0 0 3px rgba(36, 102, 191, 0.1);
}

.checkboxSection {
  background: #f8f9fa;
  padding: 1.5rem;
  border-radius: 8px;
  border: 2px solid #dee2e6;
  margin-top: 1.5rem;
}

.checkboxLabel {
  display: flex;
  align-items: center;
  cursor: pointer;
  margin: 0;
}

.checkboxInput {
  width: 20px;
  height: 20px;
  margin-right: 1rem;
  cursor: pointer;
  accent-color: #2466BF;
}

.checkboxText {
  font-weight: 600;
  color: #495057;
  font-size: 1rem;
  line-height: 1.5;
}

.errorField {
  border: 2px solid #dc3545 !important;
  background-color: #fff5f5 !important;
}

.errorMessage {
  color: #dc3545;
  font-size: 0.75rem;
  margin-top: 4px;
  font-weight: 500;
  position: absolute;
  bottom: -20px;
  left: 0;
  right: 0;
  text-align: center;
}

@media (max-width: 768px) {
  .certificateBody {
    padding: 1rem;
  }
  
  .particularsTable {
    font-size: 0.7rem;
  }
  
  .labelCell, .autoPopulateCell, .editableCell {
    padding: 0.5rem 0.25rem;
  }
  
  .crewInfo {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  
  .checkboxLabel {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  
  .editableDate {
    width: 120px;
    margin-left: 0;
    margin-top: 0.5rem;
  }
}
