useEffect(() => {
  if (registrationData && intialSurveyData) {
    // Populate Book of Registration form fields
    const populateBookForm = () => {
      // VESSEL IDENTIFICATION
      setValue("bookOfRegistration.vesselInfo.officialNo", registrationData?.vessel?.registrationNo || "");
      setValue("bookOfRegistration.vesselInfo.vesselName", registrationData?.vessel?.vesselName || "");
      setValue("bookOfRegistration.vesselInfo.portOfRegistry", registrationData?.vessel?.registry || "Kolkata");
      setValue("bookOfRegistration.vesselInfo.yearOfRegistry", new Date().getFullYear().toString());
      setValue("bookOfRegistration.vesselInfo.ownerName", registrationData?.owner?.name || "");
      setValue("bookOfRegistration.vesselInfo.ownerAddress", registrationData?.owner?.address || "");

      // DESCRIPTION OF INLAND VESSEL
      setValue("bookOfRegistration.vesselDescription.typeOfVessel", registrationData?.vessel?.type || "");
      setValue("bookOfRegistration.vesselDescription.categoryOfVessel", registrationData?.vessel?.category || "");
      setValue("bookOfRegistration.vesselDescription.grossTonnage", registrationData?.vessel?.grt || "");
      setValue("bookOfRegistration.vesselDescription.registeredTonnage", intialSurveyData?.BasicVesselInformation?.netTonnage?.toString() || "");
      setValue("bookOfRegistration.vesselDescription.yearOfBuild", registrationData?.vessel?.yearOfBuild || "");
      setValue("bookOfRegistration.vesselDescription.placeOfBuild", registrationData?.vessel?.placeOfBuild || "");

      // PARTICULARS OF VESSELS
      setValue("bookOfRegistration.vesselParticulars.lengthOverall", intialSurveyData?.BasicVesselInformation?.lengthOfVessel || "");
      setValue("bookOfRegistration.vesselParticulars.breadthExtreme", intialSurveyData?.BasicVesselInformation?.breadthOfVessel || "");
      setValue("bookOfRegistration.vesselParticulars.depthOfDeck", intialSurveyData?.BasicVesselInformation?.depthOfVessel || "");
      setValue("bookOfRegistration.vesselParticulars.builderName", registrationData?.builder?.name || "");
      setValue("bookOfRegistration.vesselParticulars.builderAddress", registrationData?.builder?.address || "");
      setValue("bookOfRegistration.vesselParticulars.yearOfBuild", registrationData?.vessel?.yearOfBuild || "");
      setValue("bookOfRegistration.vesselParticulars.hullMaterial", intialSurveyData?.HullParticulars?.hullMaterial || "");
      setValue("bookOfRegistration.vesselParticulars.numberOfDecks", intialSurveyData?.BasicVesselInformation?.numberOfDecks?.toString() || "");
      setValue("bookOfRegistration.vesselParticulars.numberOfBulkheads", intialSurveyData?.HullParticulars?.noOfBulkheads?.toString() || "");

      // ENGINE
      setValue("bookOfRegistration.engine.numberOfSets", intialSurveyData?.DetailsofPropulsionofEngine?.noOfSet?.toString() || "");
      setValue("bookOfRegistration.engine.madeBy", intialSurveyData?.DetailsofPropulsionofEngine?.engineMake || "");
      setValue("bookOfRegistration.engine.yearOfMake", intialSurveyData?.DetailsofPropulsionofEngine?.yearOfMake || "");
      setValue("bookOfRegistration.engine.cylinderDiameter", intialSurveyData?.DetailsofPropulsionofEngine?.engineCylinder?.toString() || "");
      setValue("bookOfRegistration.engine.strokeInches", intialSurveyData?.DetailsofPropulsionofEngine?.stroke || "");
      setValue("bookOfRegistration.engine.rpm", intialSurveyData?.DetailsofPropulsionofEngine?.rpm?.toString() || "");
      setValue("bookOfRegistration.engine.bhp", intialSurveyData?.DetailsofPropulsionofEngine?.horsepower?.toString() || "");

      // PROPULSION
      setValue("bookOfRegistration.propulsion.propellerType", intialSurveyData?.DetailsofPropulsionofEngine?.propellerType || "");
      setValue("bookOfRegistration.propulsion.revolutionMints", intialSurveyData?.DetailsofPropulsionofEngine?.rpm?.toString() || "");
      setValue("bookOfRegistration.propulsion.vesselSpeed", intialSurveyData?.DetailsofPropulsionofEngine?.vesselSpeed?.toString() || "");
      setValue("bookOfRegistration.propulsion.gearType", intialSurveyData?.DetailsofPropulsionofEngine?.gearType || "");
      setValue("bookOfRegistration.propulsion.numberOfGear", intialSurveyData?.DetailsofPropulsionofEngine?.noOfGear?.toString() || "");
    };

    populateBookForm();
  }
}, [registrationData, intialSurveyData, setValue]);
