                            </label>
                          </div>
                          <small className="text-muted d-block mt-1">
                            {t("Allowed formats: PDF, JPG, PNG (Max: 2MB)")}
                          </small>
                          {errors.identityProof && (
                            <div
                              className="invalid-feedback d-block"
                              style={{ color: "#dc3545" }}
                            >
                              {errors.identityProof.message}
                            </div>
                          )}
                          {isEditMode &&
                            employeeData?.fileStoreMaps?.[1]?.downLoadFile && (
                              <div className="mt-2 download-link">
                                <Button
                                  variant="link"
                                  className="p-0 text-primary text-decoration-none"
                                  onClick={() =>
                                    handleFileDownload(
                                      employeeData.fileStoreMaps[1].downLoadFile
                                    )
                                  }
                                >
                                  <FaDownload className="me-1" />
                                  Download identity proof
                                </Button>
                              </div>
                            )}
                        </div>
                      </Col>

                      {/* Appointment Letter */}
                      <Col md={6}>
                        <div className="document-upload-container">
                          <label className="form-label fw-semibold">
                            {t("addEmployee.Appointment Letter")}{" "}
                            {!isEditMode && (
                              <span className="text-danger">*</span>
                            )}
                          </label>
                          <div className="file-input-wrapper">
                            <input
                              type="file"
                              id="appointmentLetter"
                              className={`form-control file-input ${
                                errors.appointmentLetter ? "is-invalid" : ""
                              }`}
                              accept=".jpg,.jpeg,.png,.pdf"
                              {...register("appointmentLetter", {
                                required:
                                  !isEditMode &&
                                  t(
                                    "addEmployee.Appointment Letter is required"
                                  ),
                                validate: {
                                  validFileType: (files) => {
                                    if (!files || !files.length) return true;
                                    const file = files[0];
                                    const validExtensions = [
                                      ".jpg",
                                      ".jpeg",
                                      ".png",
                                      ".pdf",
                                    ];
                                    const extension = file.name
                                      ?.substring(file.name.lastIndexOf("."))
                                      .toLowerCase();
                                    return (
                                      validExtensions.includes(extension) ||
                                      "Only JPG, PNG, and PDF files are allowed"
                                    );
                                  },
                                  validFileSize: (files) => {
                                    if (!files || !files.length) return true;
                                    return (
                                      files[0].size <= 2 * 1024 * 1024 ||
                                      "File size must be less than 2MB"
                                    );
                                  },
                                },
                              })}
                              onChange={(e) => {
                                const files = e.target.files;
                                if (!files || !files.length) return;

                                const file = files[0];
                                const validExtensions = [
                                  ".jpg",
                                  ".jpeg",
                                  ".png",
                                  ".pdf",
                                ];
                                const extension = file.name
                                  ?.substring(file.name.lastIndexOf("."))
                                  .toLowerCase();

                                if (
                                  !extension ||
                                  !validExtensions.includes(extension)
                                ) {
                                  toast.error(
                                    "Only JPG, PNG, and PDF files are allowed"
                                  );
                                  e.target.value = "";
                                  return;
                                }

                                if (file.size > 2 * 1024 * 1024) {
                                  toast.error(
                                    "File size must be less than 2MB"
                                  );
                                  e.target.value = "";
                                  return;
                                }

                                const fileName = `Appointment Letter${extension}`;
                                file.originalName = fileName;
                                setAppointmentLetterFile(
                                  renameFile(file, fileName)
                                );
                                clearErrors("appointmentLetter");
                              }}
                            />
                            <label
                              htmlFor="appointmentLetter"
                              className="file-input-label"
                            >
                              <span className="file-input-text">
                                {appointmentLetterFile
                                  ? appointmentLetterFile.name
                                  : t("Choose file...")}
                              </span>
                              <span className="file-input-button">
                                {t("Browse")}
                              </span>
                            </label>
                          </div>
                          <small className="text-muted d-block mt-1">
                            {t("Allowed formats: PDF, JPG, PNG (Max: 2MB)")}
                          </small>
                          {errors.appointmentLetter && (
                            <div
                              className="invalid-feedback d-block"
                              style={{ color: "#dc3545" }}
                            >
                              {errors.appointmentLetter.message}
                            </div>
                          )}
                          {isEditMode &&
                            employeeData?.fileStoreMaps?.[2]?.downLoadFile && (
                              <div className="mt-2 download-link">
                                <Button
                                  variant="link"
                                  className="p-0 text-primary text-decoration-none"
                                  onClick={() =>
                                    handleFileDownload(
                                      employeeData.fileStoreMaps[2].downLoadFile
                                    )
                                  }
                                >
                                  <FaDownload className="me-1" />
                                  Download appointment letter
                                </Button>
                              </div>
                            )}
                        </div>
                      </Col>
                    </Row>
                  </Card.Body>
                </Card>
              </Collapsible>

              {/* Form Actions */}
              <div className="d-flex justify-content-end mt-4 gap-2">
                <Col style={{ display: "flex" }}>
                  <strong style={{ marginTop: "5px" }}>
                    {t("addEmployee.User Status")} :
                  </strong>
                  &nbsp; &nbsp;
                  <Controller
                    name="isActive"
                    control={control}
                    defaultValue={true}
                    render={({ field }) => (
                      <AppToggleButton
                        labels={[
                          t("addEmployee.In-Active"),
                          t("addEmployee.Active"),
                        ]}
                        value={toggleValue}
                        onChange={(val) => {
                          field.onChange(val);
                          setToggleValue(val);
                          setValue("isActive", val);
                        }}
                      />
                    )}
                  />
                </Col>

                <Button variant="secondary" onClick={handleCancel}>
                  {t("addEmployee.Cancel")}
                </Button>
                <Button
                  variant="primary"
                  type="submit"
                  style={{
                    background: "linear-gradient(135deg, #0077b6, #023e8a)",
                    border: "none",
                    boxShadow: "0 4px 6px rgba(0, 0, 0, 0.1)",
                    padding: "8px 20px",
                  }}
                >
                  {isEditMode
                    ? t("addEmployee.Update")
                    : t("addEmployee.Submit")}
                </Button>
              </div>
            </form>
          </Card.Body>
        </Card>
      </Container>
    </>
  );
};

export default EmployeeRegistration;
