import React, { useState, useEffect } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams, useLocation, useNavigate } from "react-router-dom";
import Stepper from "../../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import Documents from "./Documents.js";
import { useForm } from "react-hook-form";
import Invoicing from "../../../common/Invoicing.js";
import PaymentModal from "../../../common/PaymentModal.js"; 
import NewVesselRegistrationSuccess from "./newVesselRegistrationSuccess.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import PreviewPage from "./PreviewPage"; // Import the PreviewPage component

const NewVesselRegistration = () => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const { id } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  
  const isEditMode = !!id && location.pathname.includes('/edit/');
  const isViewMode = !!id && location.pathname.includes('/view/');
  const isNormalMode = !isEditMode && !isViewMode;
  const [showPreview, setShowPreview] = useState(false); // State to control preview visibility
  
  const methods = useForm({ mode: "onTouched" });
  const { trigger, getValues, setError, setValue, reset } = methods;

  const [showModal, setShowModal] = useState(false);
  const [paymentMode, setPaymentMode] = useState("offline");
  const [challanFile, setChallanFile] = useState(null);
  const [isLoading, setIsLoading] = useState(false);

  // ... (keep all your existing staticData and other code until the steps definition)

  const steps = isViewMode ? [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={isViewMode} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateDocuments,
    }
  ] : [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={isViewMode} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateDocuments,
    },
    {
      label: t("Preview"),
      component: (
        <PreviewPage 
          data={getPreviewData()} 
          onBack={() => setShowPreview(false)}
          onSubmit={handlePreviewSubmit}
          submitButtonText={isEditMode ? "Update Registration" : "Submit Registration"}
        />
      ),
      validate: () => true,
    },
    {
      label: t("Invoicing"),
      component: (
        <Invoicing
          supervisionAuthority={supervisionAuthority}
          onPayNow={() => setShowModal(true)}
        />
      ),
      validate: () => true,
    },
  ];

  // Function to prepare data for preview
  const getPreviewData = () => {
    const formValues = getValues();
    
    return {
      vesselDetails: {
        ownerName: formValues.ownerName,
        ownerAddress: formValues.ownerAddress,
        mobile: formValues.mobile,
        email: formValues.email,
        pan: formValues.pan,
        aadhar: formValues.aadhar,
        tradeLicence: formValues.tradeLicence,
        gst: formValues.gst,
        grt: formValues.grt,
        workOrderValue: formValues.workOrderValue,
        vesselType: formValues.vesselType,
        category: formValues.category,
        zone: formValues.zone,
        supervisionAuthority: formValues.supervisionAuthority,
        purchaseType: formValues.purchaseType,
        classificationSociety: formValues.classificationSociety,
        constructedBy: formValues.constructedBy,
        builder: formValues.builder,
        builderName: formValues.builderName,
        builderAddress: formValues.builderAddress,
        builderEmail: formValues.builderEmail,
        builderMobile: formValues.builderMobile,
        builderTradeLicence: formValues.builderTradeLicence,
        builderGST: formValues.builderGST,
        builderAuth: formValues.builderAuth
      },
      documents: {
        tonnageBooklets: formValues.tonnageBooklets,
        stabilityBooklets: formValues.stabilityBooklets,
        authLetter: formValues.authLetter,
        ...Object.keys(formValues)
          .filter(key => key.startsWith('workOrder_file_'))
          .reduce((acc, key) => {
            const index = key.split('_')[2];
            acc[`Work Order ${index}`] = formValues[key];
            return acc;
          }, {}),
        ...Object.keys(formValues)
          .filter(key => key.startsWith('drawings_file_'))
          .reduce((acc, key) => {
            const index = key.split('_')[1];
            acc[`Drawing ${index}`] = formValues[key];
            return acc;
          }, {})
      }
    };
  };

  // Handle preview submission
  const handlePreviewSubmit = () => {
    if (isEditMode) {
      // Handle edit submission
      setIsLoading(true);
      setTimeout(() => {
        setIsLoading(false);
        navigate("/new-vessel/registration-success", { 
          state: { registrationId: id || "VR2024001" }
        });
      }, 1500);
    } else {
      // For normal registration, proceed to invoicing step
      navigate("#invoicing"); // Or however you handle stepper navigation
    }
  };

  // ... (keep all your existing handler functions)

  if (showPreview) {
    return (
      <PreviewPage 
        data={getPreviewData()} 
        onBack={() => setShowPreview(false)}
        onSubmit={handlePreviewSubmit}
        submitButtonText={isEditMode ? "Update Registration" : "Submit Registration"}
      />
    );
  }

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {isLoading ? (
        <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
          <div className="text-center">
            <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
              <span className="visually-hidden">Loading...</span>
            </div>
            <p className="mt-3">Processing your request...</p>
          </div>
        </div>
      ) : (
        <>
          <Stack spacing={0.5}>
            <Typography
              sx={{
                fontWeight: 550,
                color: "#2E57A7",
                fontSize: "1.2rem",
              }}
            >
             {isViewMode ? t("View Vessel Registration") + ` - ${id}` : 
              isEditMode ? t("Edit Vessel Registration") + ` - ${id}` : t("New Vessel Registration")}
              &nbsp;
              <span style={{ color: "#666", fontSize: "0.65rem" }}>
                {isViewMode ? t("(View vessel registration details)") :
                 isEditMode ? t("(Update vessel registration details)") : t("(Fill in the vessel details to complete registration)")}
              </span>
            </Typography>
          </Stack>
          <Stepper 
            steps={steps} 
            onSave={() => setShowPreview(true)} // Show preview when save is clicked
            viewMode={isViewMode}
          />
          {!isViewMode && (
            <PaymentModal
              show={showModal}
              onHide={() => setShowModal(false)}
              paymentMode={paymentMode}
              setPaymentMode={setPaymentMode}
              challanFile={challanFile}
              onChallanUpload={handleChallanUpload}
              onOnlinePay={handleOnlinePay}
              onOfflineSubmit={handleOfflineSubmit}
              isLoading={isLoading}
              formMethods={methods}
            />
          )}
        </>
      )}
    </Box>
  );
};

export default NewVesselRegistration;
