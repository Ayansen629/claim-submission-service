import React from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams, useLocation, useNavigate } from "react-router-dom";
import { useTranslation } from "react-i18next";
import { BsFileEarmarkPdf, BsDownload } from "react-icons/bs";
import { Card, Row, Col, Table, Button } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";

const VesselRegistrationPreview = ({ isPreview = true }) => {
  const { t } = useTranslation();
  
  const staticData = {
    ownerName: "John Doe",
    ownerAddress: "123 Main Street, Harbor City, State 12345",
    mobile: "9876543210",
    email: "john.doe@example.com",
    pan: "ABCDE1234F",
    aadhar: "123456789012",
    tradeLicence: "TL123456789",
    gst: "GST123456789012",
    grt: "500",
    workOrderValue: "1000000",
    vesselType: "new",
    category: "A",
    zone: "1",
    supervisionAuthority: "classificationSociety",
    purchaseType: "new",
    classificationSociety: "Lloyd's Register Classification Society",
    constructedBy: "2",
    builder: "builder1",
    builderName: "ABC Marine Shipyard Pvt Ltd",
    builderAddress: "456 Port Road, Shipyard Complex, Harbor City 54321",
    builderEmail: "contact@abcshipyard.com",
    builderMobile: "9876543211",
    builderTradeLicence: "BTL789012345",
    builderGST: "BGST987654321098",
    builderAuth: "auth",
    termsAccepted: true,
    
    ...Array.from({ length: 50 }, (_, i) => ({
      [`workOrder_file_${i + 1}`]: { 
        name: `Work_Order_Document_${String(i + 1).padStart(2, '0')}.pdf`, 
        size: Math.floor(Math.random() * 2000000) + 500000 
      },
      [`workOrder_desc_${i + 1}`]: `Work order document ${i + 1} - ${[
        'Main contract document',
        'Amendment and modifications',
        'Technical specifications',
        'Timeline and milestones',
        'Budget breakdown',
        'Quality requirements',
        'Safety protocols',
        'Environmental compliance',
        'Material specifications',
        'Equipment details'
      ][i % 10]}`
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    
    ...Array.from({ length: 50 }, (_, i) => ({
      [`drawings_file_${i + 1}`]: { 
        name: `Technical_Drawing_${String(i + 1).padStart(2, '0')}.pdf`, 
        size: Math.floor(Math.random() * 3000000) + 800000 
      },
      [`drawings_desc_${i + 1}`]: `Technical drawing ${i + 1} - ${[
        'General arrangement plan',
        'Hull structure details',
        'Machinery layout',
        'Electrical schematic',
        'Piping diagram',
        'Safety equipment layout',
        'Navigation equipment',
        'Interior arrangement',
        'Deck plan',
        'Cross-section view'
      ][i % 10]}`
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    
    tonnageBooklets: { name: "Tonnage_Booklets.pdf", size: 512000 },
    stabilityBooklets: { name: "Stability_Booklets.pdf", size: 768000 },
    authLetter: { name: "Authorization_Letter.pdf", size: 256000 }
  };

  const handleDownload = (fileName) => {
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
  };

  const DocumentCard = ({ fileName, description, fileSize }) => (
    <Card className="mb-2 border-0 shadow-sm">
      <Card.Body className="p-3">
        <div className="d-flex justify-content-between align-items-center">
          <div className="d-flex align-items-center flex-grow-1">
            <div className="bg-danger bg-opacity-10 rounded-circle p-2 me-3">
              <BsFileEarmarkPdf className="text-danger" size={20} />
            </div>
            <div className="flex-grow-1">
              <h6 className="mb-1 text-primary fw-semibold" style={{ fontSize: "0.9rem" }}>
                {fileName}
              </h6>
              <p className="mb-0 text-muted small">
                {description}
                {fileSize && (
                  <span className="ms-2 badge bg-light text-dark">
                    {(fileSize / 1024 / 1024).toFixed(1)} MB
                  </span>
                )}
              </p>
            </div>
          </div>
          <Button
            variant="outline-primary"
            size="sm"
            onClick={() => handleDownload(fileName)}
            className="rounded-pill"
          >
            <BsDownload size={14} />
          </Button>
        </div>
      </Card.Body>
    </Card>
  );

  const FileSection = ({ title, type, icon }) => {
    const filesWithData = [];
    
    for (let i = 1; i <= 50; i++) {
      const fileData = staticData[`${type}_file_${i}`];
      if (fileData && fileData.name) {
        filesWithData.push({
          id: i,
          fileData,
          descData: staticData[`${type}_desc_${i}`]
        });
      }
    }

    return (
      <Card className="h-100 shadow-sm border-0">
        <Card.Header className="bg-light border-0 py-3">
          <div className="d-flex justify-content-between align-items-center">
            <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
              {icon}
              <span className="ms-2">{title}</span>
            </h5>
            <span className="badge bg-primary rounded-pill">
              {filesWithData.length} files
            </span>
          </div>
        </Card.Header>

        <Card.Body className="p-0">
          <div style={{ maxHeight: "500px", overflowY: "auto" }} className="p-3">
            {filesWithData.length > 0 ? (
              filesWithData.map((file) => (
                <DocumentCard
                  key={file.id}
                  fileName={file.fileData.name}
                  description={file.descData || `${title} document ${file.id}`}
                  fileSize={file.fileData.size}
                />
              ))
            ) : (
              <div className="text-center py-5 text-muted">
                <div className="bg-light rounded-circle p-4 d-inline-flex mb-3">
                  <BsFileEarmarkPdf size={48} className="opacity-50" />
                </div>
                <p className="mb-0">No files uploaded</p>
              </div>
            )}
          </div>
        </Card.Body>
      </Card>
    );
  };

  const SingleFileSection = ({ title, fileName, fileSize, icon }) => (
    <Card className="h-100 shadow-sm border-0">
      <Card.Header className="bg-light border-0 py-3">
        <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
          {icon}
          <span className="ms-2">{title}</span>
        </h5>
      </Card.Header>
      <Card.Body className="p-3">
        {fileName ? (
          <DocumentCard
            fileName={fileName}
            description={`${title} document`}
            fileSize={fileSize}
          />
        ) : (
          <div className="text-center py-4 text-muted">
            <div className="bg-light rounded-circle p-4 d-inline-flex mb-3">
              <BsFileEarmarkPdf size={32} className="opacity-50" />
            </div>
            <p className="mb-0">No file uploaded</p>
          </div>
        )}
      </Card.Body>
    </Card>
  );

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      <Stack spacing={0.5}>
        <Typography
          sx={{
            fontWeight: 550,
            color: "#2E57A7",
            fontSize: "1.2rem",
          }}
        >
          {t("Vessel Registration Preview")}
          &nbsp;
          <span style={{ color: "#666", fontSize: "0.65rem" }}>
            {t("(Review all vessel registration details before submission)")}
          </span>
        </Typography>
      </Stack>

      <div className="container py-4">
        {/* Owner Details Section */}
        <Collapsible title={t("Owner Details")} openStat={true}>
          <div style={{ padding: "1rem" }}>
            <Row>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Name of Owner")}</label>
                  <div className="form-control bg-light">{staticData.ownerName}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Address of Owner")}</label>
                  <div className="form-control bg-light">{staticData.ownerAddress}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Mobile")}</label>
                  <div className="form-control bg-light">{staticData.mobile}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Email Id")}</label>
                  <div className="form-control bg-light">{staticData.email}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("PAN")}</label>
                  <div className="form-control bg-light">{staticData.pan}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Aadhar")}</label>
                  <div className="form-control bg-light">{staticData.aadhar}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Trade Licence")}</label>
                  <div className="form-control bg-light">{staticData.tradeLicence}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("GST")}</label>
                  <div className="form-control bg-light">{staticData.gst}</div>
                </div>
              </Col>
            </Row>
          </div>
        </Collapsible>

        {/* Vessel Details Section */}
        <Collapsible title={t("Vessel Details")} openStat={true}>
          <div style={{ padding: "1rem" }}>
            <Row>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Gross Tonnage (GRT)")}</label>
                  <div className="form-control bg-light">{staticData.grt}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Work Order Value")}</label>
                  <div className="form-control bg-light">{staticData.workOrderValue}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Type of Vessel")}</label>
                  <div className="form-control bg-light">
                    {staticData.vesselType === "new" ? t("New Vessel") : t("Old Vessel")}
                  </div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Category")}</label>
                  <div className="form-control bg-light">
                    {staticData.category === "A" ? t("Category A") : 
                     staticData.category === "B" ? t("Category B") : t("Category C")}
                  </div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Zone")}</label>
                  <div className="form-control bg-light">
                    {staticData.zone === "1" ? t("Zone 1") : 
                     staticData.zone === "2" ? t("Zone 2") : t("Zone 3")}
                  </div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Supervision Authority")}</label>
                  <div className="form-control bg-light">
                    {staticData.supervisionAuthority === "iwt" ? t("IWT") : t("Classification Society")}
                  </div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Purchase Type")}</label>
                  <div className="form-control bg-light">
                    {staticData.purchaseType === "new" ? t("New") : t("Used")}
                  </div>
                </div>
              </Col>
              <Col md={8}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Name of the Classification Society")}</label>
                  <div className="form-control bg-light">{staticData.classificationSociety}</div>
                </div>
              </Col>
              <Col md={4}>
                <div className="mb-3">
                  <label className="form-label fw-semibold">{t("Constructed By")}</label>
                  <div className="form-control bg-light">
                    {staticData.constructedBy === "1" ? t("Self") : t("Builder")}
                  </div>
                </div>
              </Col>
            </Row>
          </div>
        </Collapsible>

        {/* Builder Details Section */}
        {staticData.constructedBy === "2" && (
          <Collapsible title={t("Builder Details")} openStat={true}>
            <div style={{ padding: "1rem" }}>
              <Row>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Builder Name")}</label>
                    <div className="form-control bg-light">{staticData.builderName}</div>
                  </div>
                </Col>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Builder Address")}</label>
                    <div className="form-control bg-light">{staticData.builderAddress}</div>
                  </div>
                </Col>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Builder Email Id")}</label>
                    <div className="form-control bg-light">{staticData.builderEmail}</div>
                  </div>
                </Col>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Mobile")}</label>
                    <div className="form-control bg-light">{staticData.builderMobile}</div>
                  </div>
                </Col>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Trade Licence")}</label>
                    <div className="form-control bg-light">{staticData.builderTradeLicence}</div>
                  </div>
                </Col>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("GST")}</label>
                    <div className="form-control bg-light">{staticData.builderGST}</div>
                  </div>
                </Col>
                <Col md={4}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Builder Authorization")}</label>
                    <div className="form-control bg-light">
                      {staticData.builderAuth === "auth" ? t("Authorized") : t("Rejected")}
                    </div>
                  </div>
                </Col>
                <Col md={8}>
                  <div className="mb-3">
                    <label className="form-label fw-semibold">{t("Authorization Letter")}</label>
                    {staticData.authLetter ? (
                      <DocumentCard 
                        fileName={staticData.authLetter.name} 
                        fileSize={staticData.authLetter.size} 
                      />
                    ) : (
                      <div className="text-muted">No file uploaded</div>
                    )}
                  </div>
                </Col>
              </Row>
            </div>
          </Collapsible>
        )}

        {/* Documents Section */}
        <Collapsible title={t("Documents")} openStat={true}>
          <div style={{ padding: "1rem" }}>
            <Row className="g-4">
              <Col lg={6} md={12}>
                <FileSection
                  title={t("Work Order")}
                  type="workOrder"
                  icon={<BsFileEarmarkPdf className="text-primary" />}
                />
              </Col>

              <Col lg={6} md={12}>
                <FileSection
                  title={t("Drawings")}
                  type="drawings"
                  icon={<BsFileEarmarkPdf className="text-success" />}
                />
              </Col>

              <Col md={6}>
                <SingleFileSection
                  title={t('Tonnage Booklets')}
                  fileName={staticData.tonnageBooklets?.name}
                  fileSize={staticData.tonnageBooklets?.size}
                  icon={<BsFileEarmarkPdf className="text-warning" />}
                />
              </Col>

              <Col md={6}>
                <SingleFileSection
                  title={t('Stability Booklets')}
                  fileName={staticData.stabilityBooklets?.name}
                  fileSize={staticData.stabilityBooklets?.size}
                  icon={<BsFileEarmarkPdf className="text-info" />}
                />
              </Col>

              <Col md={12}>
                <Card className="shadow-sm border-0">
                  <Card.Body className="p-4">
                    <div className="d-flex align-items-start">
                      <input
                        type="checkbox"
                        id="termsAccepted"
                        className="me-3 mt-1"
                        checked={staticData.termsAccepted}
                        disabled
                      />
                      <div>
                        <label
                          htmlFor="termsAccepted"
                          className="mb-0 fw-medium"
                          style={{ color: "#333", cursor: "default", lineHeight: "1.5" }}
                        >
                          {t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.')}
                        </label>
                      </div>
                    </div>
                  </Card.Body>
                </Card>
              </Col>
            </Row>
          </div>
        </Collapsible>

        {/* Payment Details Section */}
        <Collapsible title={t("Payment Details")} openStat={true}>
          <div style={{ padding: "1rem" }}>
            {staticData.supervisionAuthority === "classificationSociety" && (
              <Row className="justify-content-center">
                <Col md={8}>
                  <Table bordered responsive className="mb-0">
                    <thead>
                      <tr>
                        <th>{t("Payment")}</th>
                        <th>{t("Fee Structure")}</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>{t("Drawing Scrutiny Fee")}</td>
                        <td>
                          {t("0.05% of the work order value")}<br />
                          <span style={{ color: "#888" }}>{t("Minimum Rs. 500/-")}</span>
                        </td>
                      </tr>
                    </tbody>
                  </Table>
                </Col>
              </Row>
            )}
          </div>
        </Collapsible>
      </div>
    </Box>
  );
};

export default VesselRegistrationPreview;
