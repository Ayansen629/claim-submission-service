import crewIcon from "../../assets/icons/home/crew&citizen.png";
import crewBtnIcon from "../../assets/icons/home/CrewBtn.png";

// article
import articleImg1 from "../../assets/images/article-img-1.jpg";
import articleImg2 from "../../assets/images/article-img-2.png";
import articleImg4 from "../../assets/images/article-image-4.jpg";
import articleImg3 from "../../assets/images/article-img-3.jpg";

import instaIcon from "../../assets/icons/home/insta-icon.png";
import heartIcon from "../../assets/icons/home/heart-icon.png"
import msgIcon from "../../assets/icons/home/message.png";
import svIcon from "../../assets/icons/home/save.png";
import chatIcon from "../../assets/icons/home/chat.png";

import fbIcon from "../../assets/icons/home/fb-icon.png";
import likeIcon from "../../assets/icons/home/like-icon.png";
import commentIcon from "../../assets/icons/home/comment-icon.png";
import shareIcon from "../../assets/icons/home/share-icon.png";
import linkedInIcon from "../../assets/icons/home/linkedin-icon.png";
import youtybeIcon from "../../assets/icons/home/youtube-icon.png";

//Footer


//Carousel
import HomeCarousel from "./IWTHomeCarousel";

//footer
import twiterIcon from "../../assets/icons/home/twitter-icon.png";
import appleStoreIcon from "../../assets/icons/home/applestore-icon.png";
import googleStoreIcon from "../../assets/icons/home/googleplay-icon.png";
import HeaderHome2 from "./HeaderHome2";
import { useNavigate } from "react-router-dom";
import { useTranslation } from "react-i18next";
import FooterHome2 from "./FooterHome2";
import { FaShip } from "react-icons/fa";



const IWTHomePage2 = () => {
    let navigate = useNavigate();
    const { t } = useTranslation();

    const leftPopupCardData = [
        {
            title: "5000+",
            text1: "Total Registered Vessels",
            text2: "Currently registered vessels in our network.",
            bgColor: "#0070C0"
        },
        {
            title: "2300+",
            text1: "Active Vessels",
            text2: "Currently operational vessels in our network.",
            bgColor: "#00A3E0"
        },
        {
            title: "98%",
            text1: "Compliance Rate",
            text2: "Vessels meeting all regulatory requirements.",
            bgColor: "#1DBF97"
        },
        {
            title: "24/7",
            text1: "Support Available",
            text2: "Our team is always ready to assist you.",
            bgColor: "#00D2E0"
        },
    ];

    const sectionCards = [
        {
            title: t("home2.vesselRegistration"),
            text: t("home2.vesselRegistrationText"),
            btnText: "Start now",
            icon: vesselRegistrationIcon,
            btnIcon: vesselRegBtn,
        },
        {
            title: t("home2.vesselSurvey"),
            text: t("home2.vesselSurveyText"),
            btnText: "Book A Servey",
            icon: vesselServeyIcon,
            btnIcon: vesselServeyBtn,
        },
        {
            title: t("home2.financialManagement"),
            text: t("home2.financialManagementText"),
            btnText: "Check Finance",
            icon: financialIcon,
            btnIcon: financialBtnIcon,
        },
        {
            title: t("home2.grievanceRedressal"),
            text: t("home2.grievanceRedressalText"),
            btnText: "View Details",
            icon: grevianceIcon,
            btnIcon: grevianceBtnIcon,
        },
        {
            title: t("home2.manningCertification"),
            text: t("home2.manningCertificationText"),
            btnText: "Proceed",
            icon: manningIcon,
            btnIcon: manningBtnIcon,
        },
        {
            title: t("home2.offencePenalty"),
            text: t("home2.offencePenaltyText"),
            btnText: "View Guidelines",
            icon: offenceIcon,
            btnIcon: offenceBtnIcon,
        },
        {
            title: t("home2.investigation"),
            text: t("home2.investigationText"),
            btnText: "Proceed",
            icon: investigationIcon,
            btnIcon: investigationBtnIcon,
        },
        {
            title: t("home2.crewCitizenInformationCenter"),
            text: t("home2.crewCitizenInformationCenterText"),
            btnText: "Proceed",
            icon: crewIcon,
            btnIcon: crewBtnIcon,
        },
    ];


    return (
        <>
            {/* Top Navbar */}
            <HeaderHome2 />


            {/* White separator line */}
            <div className={styles.separator}></div>

           




            {/* Hero Section */}
            <div className={styles.heroSection}>
                <div className={styles.overlay}></div>

                <div className="container-fluid position-relative z-2">
                    <div className={`row g-0 pt-4 px-4 ${styles.headerRow}`}>

                        {/* Nav Links Section */}
                        <div className={`${styles.topNavCol} mb-0 col-12 position-relative`}>
                            <div className="d-flex flex-column align-items-center w-100">
                                {/* Wrapper around Nav + underline */}
                                <div className="d-flex flex-column align-items-center">
                                    <Nav className="d-flex flex-wrap justify-content-center">
                                        <Nav.Link className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                                            {t("home2.home")}
                                        </Nav.Link>
                                        <Nav.Link onClick={() => navigate("/about-us")} className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                                            {t("home2.aboutUs")}
                                        </Nav.Link>
                                        <Nav.Link onClick={() => navigate("/our-services")} className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                                            {t("home2.services")}
                                        </Nav.Link>
                                        <Nav.Link onClick={() => navigate("/rules-and-act")} className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                                            {t("home2.RulesAndAct")}
                                        </Nav.Link>
                                        <Nav.Link onClick={() => navigate("/gallery")} className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                                            {t("home2.Gallery")}
                                        </Nav.Link>
                                        <Nav.Link onClick={() => navigate("/important-link")} className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                                            {t("home2.ImportantLink")}
                                        </Nav.Link>
                                        <Nav.Link onClick={() => navigate("/contact-us")} className={`${styles.navLinkItems} text-decoration-none px-2 py-0`}>
                                            {t("home2.contactUs")}
                                        </Nav.Link>
                                    </Nav>

                                    {/* underline directly under Nav */}
                                    <div className="border-top border-white mt-1 w-100"></div>
                                </div>
                            </div>
                            {/* Desktop Logo and Login */}
<div className="d-none d-xl-block">
  <img src={BengalLogo} alt="Logo" style={{ width: "4.25rem", height: "5rem", position: "absolute", top: "-17px", right: "0" }} />
  <Button variant="light" className={`${styles.homeLoginBtn}`} onClick={() => navigate("/login")}>
    {t("home2.Login")}
  </Button>
</div>

{/* Mobile/Tablet Logo */}
<div className="d-block d-xl-none text-center mt-2">
  <img src={BengalLogo} alt="Logo" style={{ width: "2.5rem", height: "3rem" }} />
</div>


                        </div>


                        {/* Left Side: Logo + Brand Name */}
                        <div className="mt-0 col-12 d-flex flex-column align-items-center align-items-md-start">
                            <div className="d-flex align-items-center justify-content-center" style={{ marginTop: "-2rem" }}>
                                <img className="me-2" src={IWTIcon} alt="Logo" style={{ width: "5.5rem", borderRadius: "0px" }} />
                            </div>
                            <div className="text-center text-md-start">
                                <p className={`${styles.brandName} mt-1`}>{t("home2.InlandWaterTransportServices")}</p>
                                <p className={`${styles.brandName} mt-1`}>{t("home2.departmentOfWB")}</p>
                            </div>

                            {/* Mobile Login Button */}
                            <Button variant="light" className={`${styles.homeLoginBtn} d-block d-xxl-none`} onClick={() => navigate("/login")}>
                                {t("home2.Login")}
                            </Button>
                        </div>
                    </div>
                </div>
            </div>

            {/* Branding section */}
            <Container
                fluid
                className="d-flex justify-content-center align-items-start position-relative mb-5 mx-1"
            >
                <div id="c1" style={{ maxWidth: "25rem", marginTop: "-90px", zIndex: 3 }} className="me-2">
                    <Row className="g-2">
                        {leftPopupCardData?.map((item) => (
                            <Col
                                className="d-flex justify-content-center align-items-center"
                                md={6}
                                key={item.text1}
                            >
                                <Card
                                    className={`${styles.popupCardParent} text-center`}
                                    style={{ backgroundColor: item.bgColor }}
                                >
                                    <Card.Body className="d-flex justify-content-center align-items-center">
                                        <Card className={`${styles.popupCardInner}`}>
                                            <Card.Body>
                                                <Card.Title className={`${styles.popupCardTitle}`}>
                                                    {item?.title}
                                                </Card.Title>
                                                <Card.Text className={`${styles.popupCardText}`}>
                                                    {item?.text1}
                                                </Card.Text>
                                                <Card.Text className={`${styles.popupCardText}`}>
                                                    {item?.text2}
                                                </Card.Text>
                                            </Card.Body>
                                        </Card>
                                    </Card.Body>
                                </Card>
                            </Col>
                        ))}
                    </Row>
                </div>

                <div id="c2" style={{ maxWidth: "37rem", marginTop: "-90px", zIndex: 3 }} className="ms-2">
                    <Card className="w-120 mb-3" style={{ boxShadow: "0 4px 5px rgba(0, 0, 0, 0.25)" }}>
                        <Card.Body className="ms-2 mt-1 mb-2 me-2">
                            <Card.Title className={`${styles.popup2CardTitle}`} style={{ color: "#0070C0" }}>What's <span style={{ color: "#92D050" }}>new?</span></Card.Title>
                            <Card.Text className="mt-1">
                                <Button className={`${styles.popup2CardText} btn-sm`} style={{ backgroundColor: "#92D050", borderRadius: "3px" }}>New</Button>
                            </Card.Text>
                            <Card.Text className={`${styles.popup2CardText}`} style={{ width: "90%" }}>
                                Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s.
                            </Card.Text>
                            <Card.Text className={`${styles.popup2CardText} d-flex justify-content-start`}>
                                <Button className="btn-sm me-2" style={{ backgroundColor: "#00A3E0", color: "white", borderRadius: "3px" }}>April 1, 2025</Button>
                                <Button className="btn-sm" style={{ backgroundColor: "#00A3E0", color: "white", borderRadius: "3px" }}>9:41 AM</Button>
                            </Card.Text>
                            <Card.Text className="mt-4 mb-4">
                                <span
                                    className="d-block w-100 mt-1"
                                    style={{ borderTop: "2px solid #00D2E0" }}
                                ></span>
                            </Card.Text>
                            <Card.Text className={`${styles.popup2CardText}`}>
                                <Button className="btn-sm" style={{ backgroundColor: "#92D050", borderRadius: "3px" }}>New</Button>
                            </Card.Text>
                            <Card.Text className={`${styles.popup2CardText}`} style={{ width: "90%" }}>
                                Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s.
                            </Card.Text>
                            <Card.Text className={`${styles.popup2CardText} d-flex justify-content-start`}>
                                <Button className="btn-sm me-2" style={{ backgroundColor: "#00A3E0", color: "white", borderRadius: "3px" }}>April 1, 2025</Button>
                                <Button className="btn-sm" style={{ backgroundColor: "#00A3E0", color: "white", borderRadius: "3px" }}>9:41 AM</Button>
                            </Card.Text>
                        </Card.Body>
                    </Card>
                </div>
            </Container>

            {/* Adevertisement section */}

            <div className="mb-4" style={{ width: "100%", backgroundColor: "#01355A" }}>
                <Row style={{ width: "100%" }}>
                    <Col md={5} className={`p-0 m-0`}>
                        <div className={`${styles.advertiseLeftCol}`}>
                            <img src={BgImage2} alt="image" className={`${styles.advLeftColImg}`} />
                            <h1 className={`${styles.advTitle}`}>
                                {t("home2.oneStopTitle")}
                            </h1>
                        </div>
                    </Col>
                    <Col md={7} className={`p-0 m-0`}>
                        <div className={`${styles.advertiseRightCol}`}>
                            <img src={BgImage2} alt="image" className={`${styles.advRightColImg}`} />
                            <p className={`${styles.advText}`}>
                                {t("home2.oneStopDesc")}
                            </p>
                        </div>
                    </Col>
                </Row>
            </div>

            {/* Services section */}
            <div className={styles.section2}>
                <img
                    src={BgImage2}
                    alt="Background image"
                    className={styles.bgImage}
                />
                <div className={`${styles.section2Content} d-flex flex-column align-items-center justify-content-center mx-3`} style={{ width: "100%" }}>
                    <div className="d-flex justify-content-start" style={{ width: "70%" }}>
                        <p className={`${styles.subText}`}>
                            Services
                            <span className={`${styles.hideBar} ${styles.subTextSpan}`}>|</span>
                            <span className={`${styles.subTextSpan} ${styles.subTextDynamic}`}>
                                Comprehensive digital solutions for all your inland water transport needs
                            </span>
                        </p>
                    </div>
                </div>
                <Container className={`${styles.serviceContainer} mt-5`}>
                    <Row className="gx-4 gy-2 justify-content-center">
                        {sectionCards.map((item, i) => (
                            <Col key={i} md={3} sm={6} xs={12} className="d-flex justify-content-center">
                                <Card className={`${styles.serviceCard} text-center`}>
                                    <Card.Body className="d-flex flex-column justify-content-center align-items-center mt-1 mb-1">
                                        <Card.Title>
                                            <img
                                                src={item.icon}
                                                alt={item.title}
                                                className={styles.serviceCardIcon}
                                            />
                                        </Card.Title>
                                        <Card.Title className={styles.serviceCardTitle}>{item.title}</Card.Title>
                                        <Card.Text className={styles.serviceCardText}>
                                            {item.text}
                                        </Card.Text>
                                        <Button className={styles.serviceCardBtn} onClick={() => navigate("/login")}>
                                            <img
                                                src={item.btnIcon}
                                                alt={item.title}
                                                className={`${styles.serviceCardBtnIcon} me-1`}
                                            />
                                            <span className={styles.serviceCardBtnText}>{item.btnText}</span>
                                        </Button>
                                    </Card.Body>
                                </Card>
                            </Col>
                        ))}
                    </Row>
                </Container>


            </div>

            {/* Carousel section */}
            <Container
                fluid
                className="d-flex justify-content-center align-items-start position-relative"

            >
                <HomeCarousel />
            </Container>

            {/* Article section */}
            <div className={styles.article}>
                <img
                    src={BgImage2}
                    alt="Background image"
                    className={styles.articleBgImage}
                />
                <div className={`${styles.atricleContent} d-flex justify-content-center mx-2`} style={{ width: "100%" }}>
                    <div className="d-flex justify-content start" style={{ width: "70%" }}>
                        <p className={`${styles.subText}`}>{t("home.Social Feed")}
                        </p>
                    </div>
                </div>
                <Container className={`${styles.socialContainer} my-5`}>
                    <Container fluid>
                        <Row className="g-4 align-items-stretch">
                            {/* Left Card */}
                            <Col xs={12} md={6} lg={4}>
                                <Card className={`${styles.artCard} ${styles.artGlobalCard}`}>
                                    {/* Image Wrapper */}
                                    <div style={{ position: "relative" }}>
                                        <Card.Img
                                            variant="top"
                                            src={articleImg1}
                                            alt="img"
                                            className={`${styles.artLeftImg}`}
                                        />
                                        <img
                                            src={instaIcon}
                                            alt="icon"
                                            className={`${styles.artLeftIcon}`}
                                        />
                                    </div>

                                    <Card.Body>
                                        <Card.Text>
                                            <Row>
                                                <Col xs={6} className="d-flex justify-content-start">
                                                    <img src={heartIcon} alt="icon" className={`me-2 ${styles.subIcons}`} />
                                                    <img src={chatIcon} alt="icon" className={`me-2 ${styles.subIcons}`} />
                                                    <img src={msgIcon} alt="icon" className={`${styles.subIcons}`} />
                                                </Col>
                                                <Col xs={6} className="d-flex justify-content-end">
                                                    <img src={svIcon} alt="icon" className={`${styles.subIcons}`} />
                                                </Col>
                                            </Row>
                                        </Card.Text>

                                        <Card.Text className={`${styles.artCardContent} mb-5`}>
                                            Lorem Ipsum is simply dummy text of the printing and typesetting industry...
                                        </Card.Text>
                                    </Card.Body>
                                </Card>
                            </Col>

                            {/* Middle Column with Two Cards */}
                            <Col xs={12} md={6} lg={4} className="d-flex flex-column justify-content-between">

                                <Card className={`${styles.artMidCard} ${styles.artGlobalCard} text-white`}>
                                    {/* Image fills card */}
                                    <Card.Img
                                        src={articleImg2}
                                        alt="img"
                                        className="w-100 h-100"
                                        style={{ objectFit: "cover" }}
                                    />

                                    {/* Overlay content */}
                                    <Card.ImgOverlay className="d-flex flex-column justify-content-end align-items-center p-0" style={{ borderRadius: "4px" }}>
                                        {/* Top-left icon */}
                                        <img
                                            src={linkedInIcon}
                                            alt="icon"
                                            className={`${styles.artLeftIcon}`}
                                        />

                                        {/* Bottom text */}
                                        <div className={`${styles.artMidCard1Div} mb-0`}
                                        >
                                            <Card.Text className={`${styles.artMidCard1Content} py-4 ps-3 pe-2`}>
                                                orem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s,
                                            </Card.Text>
                                        </div>
                                    </Card.ImgOverlay>
                                </Card>



                                <Card className={`${styles.artMidCard} ${styles.artGlobalCard} text-white mt-3`}>
                                    {/* Background image */}
                                    <Card.Img
                                        src={articleImg3}
                                        alt="img"
                                        className="w-100 h-100"
                                        style={{ objectFit: "cover" }}
                                    />

                                    {/* Overlay with flex center */}
                                    <Card.ImgOverlay className="d-flex justify-content-center align-items-center p-0">
                                        <img
                                            src={youtybeIcon}
                                            alt="icon"
                                            className={`${styles.artCenterIcon}`}
                                        />
                                    </Card.ImgOverlay>
                                </Card>


                            </Col>

                            {/* Right Card */}
                            <Col xs={12} md={6} lg={4}>
                                <Card className={`${styles.artCard} ${styles.artGlobalCard}`}>
                                    <Card.Body>
                                        <Card.Text>
                                            <img src={fbIcon} alt="icon" className={`${styles.artRightIcon}`} />
                                        </Card.Text>
                                        <Card.Text className={`${styles.artCardContent}`}>
                                            Lorem Ipsum is simply dummy text of the printing and typesetting industry...
                                        </Card.Text>
                                    </Card.Body>

                                    <Card.Img src={articleImg4} className={styles.artRightImg} alt="img" />

                                    <Card.Text>
                                        <Row className="text-center">
                                            <Col className="d-flex justify-content-center align-items-center my-3">
                                                <img src={likeIcon} alt="icon" className={`me-2 ${styles.subIcons}`} />
                                                <p className={`${styles.artCardContent} mb-0`}>Like</p>
                                            </Col>
                                            <Col className="d-flex justify-content-center align-items-center my-3">
                                                <img src={commentIcon} alt="icon" className={`me-2 ${styles.subIcons}`} />
                                                <p className={`${styles.artCardContent} mb-0`}>Comment</p>
                                            </Col>
                                            <Col className="d-flex justify-content-center align-items-center my-3">
                                                <img src={shareIcon} alt="icon" className={`me-2 ${styles.subIcons}`} />
                                                <p className={`${styles.artCardContent} mb-0`}>Share</p>
                                            </Col>
                                        </Row>
                                    </Card.Text>
                                </Card>
                            </Col>
                        </Row>
                    </Container>

                </Container>
            </div>
            <FooterHome2 />
        </>
    );
};

export default IWTHomePage2;

