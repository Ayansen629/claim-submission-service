              <Collapsible
                title={
                  <div className="d-flex align-items-center">
                    <FaBriefcase
                      className="me-2"
                      style={{ color: "#2466BF" }}
                    />
                    <span style={{ color: "#2466BF" }}>
                      {t("addEmployee.Professional Details")}
                    </span>
                  </div>
                }
                defaultOpen={true}
              >
                <Card className="form-section-card">
                  <Card.Body>
                    <Row className="g-3">
                      <Col md={4}>
                        <InputText
                          name="appointmentDate"
                          label={t("Appointment Date")}
                          type="date"
                          placeholder={t("Select appointment date")}
                          required={true}
                          register={{
                            ...register("appointmentDate", {
                              required: t("addEmployee.Appointment Date is required"),
                            }),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="employeeType"
                          label={t("addEmployee.Employee Type")}
                          required={true}
                          placeholder={t("addEmployee.Select employee type")}
                          options={
                            masterData?.employeeTypes?.map((type) => ({
                              value: type.valueCode,
                              label: type.valueLabel,
                            })) || []
                          }
                          register={register("employeeType", {
                            required: t("addEmployee.Employee Type is required"),
                          })}
                          errors={errors}
                          value={watch("employeeType") || ""}
                          onChange={(val) =>
                            setValue("employeeType", val, { shouldValidate: true })
                          }
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="employeeStatus"
                          label={t("addEmployee.Employee Status")}
                          required={true}
                          placeholder={t("addEmployee.Select employee status")}
                          options={
                            masterData?.employeeStatuses?.map((type) => ({
                              value: type.valueCode,
                              label: type.valueLabel,
                            })) || []
                          }
                          register={register("employeeStatus", {
                            required: t("addEmployee.Employee Status is required"),
                          })}
                          errors={errors}
                          value={watch("employeeStatus") || ""}
                          onChange={(val) =>
                            setValue("employeeStatus", val, { shouldValidate: true })
                          }
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="designation"
                          label={t("addEmployee.Designation")}
                          required={true}
                          placeholder={t("addEmployee.Select designation")}
                          options={
                            masterData?.designations?.map((type) => ({
                              value: type.valueCode,
                              label: type.valueLabel,
                            })) || []
                          }
                          register={register("designation", {
                            required: t("addEmployee.Designation is required"),
                          })}
                          errors={errors}
                          value={watch("designation") || ""}
                          onChange={(val) =>
                            setValue("designation", val, { shouldValidate: true })
                          }
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="department"
                          label={t("addEmployee.Department")}
