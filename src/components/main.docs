  //   if (!file) return;

  //   const maxSize = 10 * 1024 * 1024;
  //   if (file.size > maxSize) {
  //     toast.error("File size must be less than or equal to 10 MB.");
  //     e.target.value = null;
  //     return;
  //   }

  //   loaderRef.current?.show();

  //   try {
  //     const formData = new FormData();
  //     formData.append("file", file);

  //     const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
  //     const response = await postFORMdata(uploadUrl, formData);

  //     const fileStoreId = response?.data?.files[0]?.fileStoreId;

  //     if (fileStoreId) {
  //       const getStandardizedFileName = (docType) => {
  //         const fileNames = {
  //           authorizationFile: "Authorization of Authorised Person.pdf",
  //           paymentChallan: "Payment Challan_Acknowledgement.pdf",
  //           builderCertificate: "Builder Certificate.pdf",
  //           lastCertificateCopy: "Copy of last Certificate of Survey.pdf",
