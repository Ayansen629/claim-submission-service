import React from "react";
import {
  Container,
  Row,
  Col,
  Card,
  Button,
  Navbar,
  Nav,
} from "react-bootstrap";
import { NavDropdown } from "react-bootstrap";
import Banner from "../../assets/images/Banner.png";
import Ship from "../../assets/images/ship.png";
import Tower from "../../assets/images/tower.jpg";
import Map from "../../assets/images/map.png";
import vector from "../../assets/images/Vector.png";
import transfer from "../../assets/images/transfer.png";
import Navigation from "../../assets/images/Navigation.png";
import Suitcase from "../../assets/images/suitcase.png";
import Profile from "../../assets/images/pic.png";
import Notebook from "../../assets/images/note.svg";
import tick from "../../assets/images/tick.png";
import iwtnote from "../../assets/images/iwtnote.svg";
import Shield from "../../assets/images/Shield.png";
import Arrow from "../../assets/images/arrow.png";
import LastIcon from "../../assets/images/lasticon.png";
import Linkedin from "../../assets/images/Linkedin.png";
import Instagram from "../../assets/images/Instagram.png";
import HeaderLogo from "../../assets/images/bengal-logo.png";
import Login from "../../assets/images/iwtlogin.png";

const IWTHomePage = () => {
  const quickActionCards = [
    {
      id: 1,
      title: "Offences & Penalties",
      icon: (
        <img src={iwtnote} alt="Offences & Penalties" className="img-fluid" />
      ),
      buttonText: "Proceed",
    },
    {
      id: 2,
      title: "Investigation",
      icon: <img src={Shield} alt="Compliance Status" className="img-fluid" />,
      buttonText: "Proceed",
    },
    {
      id: 3,
      title: "Crew/Citizen Information",
      icon: <img src={Shield} alt="Inspection Reports" className="img-fluid" />,
      buttonText: "Proceed",
    },
    {
      id: 4,
      title: "Manning,Training & Certification",
      icon: <img src={LastIcon} alt="Vessel Details" className="img-fluid" />,
      buttonText: "Proceed",
    },
  ];

  const statsData = [
    { value: "5000+", label: "Total Registered Vessel", description: "Lorem Ipsum Dol sit amet. Lorem Ipsum Dol sit amet." },
    { value: "1200+", label: "Active Vessels", description: "Currently operational vessels in our network." },
    { value: "98%", label: "Compliance Rate", description: "Vessels meeting all regulatory requirements." },
    { value: "24/7", label: "Support Available", description: "Our team is always ready to assist you." }
  ];

  const vesselRegistrationItems = [
    { icon: vector, title: "New Vessel Registration", description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry." },
    { icon: Suitcase, title: "Renewal of Registration", description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry." },
    { icon: transfer, title: "Transfer of Registry", description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry." },
    { icon: Profile, title: "Change of Ownership", description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry." },
    { icon: Notebook, title: "Cancellation of Registration", description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry." },
    { icon: tick, title: "Status Check", description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry." }
  ];

  const vesselSurveyItems = [
    { icon: vector, title: "Initial Survey", description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry." },
    { icon: Suitcase, title: "Periodical Survey", description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry." },
    { icon: transfer, title: "Renewal Survey", description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry." },
    { icon: Profile, title: "Damage Survey", description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry." },
     { icon: Notebook, title: "Name Change of Vessel in Survey Certificate", description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry." },
    { icon: tick, title: "Additional Survey for Inland Vessel Accident ", description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry." }
  ];

  const newsItems = [
    { date: "April 06, 2025", text: "Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s." },
    { date: "March 28, 2025", text: "New regulations for inland water transport have been announced. All vessel owners must comply by June 2025." },
    { date: "March 15, 2025", text: "Our new online portal features make vessel registration 50% faster than before." }
  ];

  return (
    <div className="iwt-homepage">
      {/* Banner Section with Navbar */}
     <div className="hero-banner" style={{ backgroundImage: `url(${Banner})`  }}>
        <Navbar expand="lg" variant="dark" className="transparent-navbar">
          <Container fluid className="px-4">
            <Navbar.Brand href="#home" className="d-flex align-items-center">
              <img
                src={HeaderLogo}
                alt="Logo"
                className="navbar-logo"
              />
              <span className="ms-2 d-none d-lg-block">Inland Water Transport</span>
            </Navbar.Brand>

            <Navbar.Toggle aria-controls="basic-navbar-nav" />

            <Navbar.Collapse id="basic-navbar-nav">
              <Nav className="ms-auto align-items-center">
                <Nav.Link href="#home" className="mx-2">Home</Nav.Link>

                <NavDropdown
                  title="Vessel Registration"
                  id="vessel-registration-dropdown"
                  className="mx-2"
                >
                  <NavDropdown.Item href="#new-registration">New Registration</NavDropdown.Item>
                  <NavDropdown.Item href="#renewal">Renewal</NavDropdown.Item>
                </NavDropdown>

                <NavDropdown
                  title="Vessel Survey"
                  id="vessel-survey-dropdown"
                  className="mx-2"
                >
                  <NavDropdown.Item href="#survey-schedule">Survey Schedule</NavDropdown.Item>
                  <NavDropdown.Item href="#survey-reports">Survey Reports</NavDropdown.Item>
                </NavDropdown>

                <Nav.Link href="#finance" className="mx-2">Finance Accounts</Nav.Link>
                <Nav.Link href="#grievance" className="mx-2">Grievance Redressal</Nav.Link>

                <NavDropdown title="Quick Links" id="quick-links-dropdown" className="mx-2">
                  <NavDropdown.Item href="#link1">Link 1</NavDropdown.Item>
                  <NavDropdown.Item href="#link2">Link 2</NavDropdown.Item>
                </NavDropdown>

                <Button variant="outline-light" className="login-btn ms-2">
                  <img src={Login} alt="Login" className="login-icon" />
                  <span className="ms-1">Login</span>
                </Button>
              </Nav>
            </Navbar.Collapse>
          </Container>
        </Navbar>

       <div className="hero-content">
          <Container>
            {/* <h1 className="zoom-responsive-title">Welcome to Inland Water Transport</h1>
            <p className="lead">Streamlining vessel registration and management for a smoother sailing experience</p>
            <Button variant="primary" size="lg" className="mt-3">Get Started</Button> */}
          </Container>
        </div>
      </div>

      {/* Stats Section with Zoom Adjustments */}
      <section className="stats-section py-5">
        <Container fluid="xxl">
          <Row className="g-4 justify-content-center">
            {statsData.map((stat, index) => (
              <Col xl={3} lg={6} md={6} key={index}>
                <Card className="stat-card h-100">
                  <Card.Body className="text-center">
                    <h2 className="stat-value">{stat.value}</h2>
                    <h5 className="stat-label">{stat.label}</h5>
                    <p className="stat-description">{stat.description}</p>
                  </Card.Body>
                </Card>
              </Col>
            ))}
          </Row>
        </Container>
      </section>
   
      {/* Vessel Registration Section with Icon Fixes */}
      <section className="vessel-registration py-5 bg-light">
        <Container fluid="xxl">
          <div className="section-header mb-5" style={{ textAlign: 'left', maxWidth: 'none', marginLeft: 0 }}>
            <h2 className="section-title">Vessel Registration</h2>
            <p className="section-description">
            Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised in the 1960s with the release of Letraset sheets containing Lorem Ipsum passages, and more recently with desktop publishing software like Aldus PageMaker including versions of Lorem Ipsum.
            </p>
          </div>
          <Row className="align-items-stretch g-4">
            <Col xl={6} className="mb-4 mb-xl-0">
              <Row className="g-3 h-100">
                {vesselRegistrationItems.map((item, index) => (
                  <Col md={6} key={index} className="d-flex">
                    <Card className="w-100 service-card">
                      <Card.Body className="d-flex flex-column">
                        <div className="d-flex align-items-start h-100">
                          <div className="icon-container me-3">
                            <img 
                              src={item.icon} 
                              alt={item.title}
                              className="w-100 h-100 object-fit-contain"
                            />
                          </div>
                          <div className="content-wrapper flex-grow-1">
                            <h5 className="service-title">{item.title}</h5>
                            <p className="service-description">{item.description}</p>
                            <div className="mt-auto">
                              <Button variant="link" className="service-link p-0">
                                <img 
                                  src={Navigation} 
                                  alt="Navigate" 
                                  className="nav-icon"
                                />
                              </Button>
                            </div>
                          </div>
                        </div>
                      </Card.Body>
                    </Card>
                  </Col>
                ))}
              </Row>
            </Col>
            <Col xl={6} className="d-flex">
              <div className="vessel-image-container w-100" style={{ maxHeight: '600px' }}>
                <img 
                  src={Ship} 
                  alt="IWT Ship" 
                  className="img-fluid" 
                  style={{
                    objectFit: 'cover',
                    width: '100%',
                    height: '100%',
                    maxHeight: '600px'
                  }}
                />
              </div>
            </Col>
          </Row>
        </Container>
      </section>

      {/* Vessel Survey Section */}
      <section className="vessel-survey py-5">
        <Container fluid="xxl">
          <div className="section-header mb-5" style={{ textAlign: 'left', maxWidth: 'none', marginLeft: 0 }}>
            <h2 className="section-title">Vessel Survey</h2>
            <p className="section-description">
              Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised in the 1960s with the release of Letraset sheets containing Lorem Ipsum passages, and more recently with desktop publishing software like Aldus PageMaker including versions of Lorem Ipsum.
            </p>
          </div>

          <Row className="align-items-stretch">
            <Col lg={6} className="order-lg-2 mb-4 mb-lg-0">
              <Row className="g-3 h-100">
                {vesselSurveyItems.map((item, index) => (
                  <Col md={6} key={index} className="d-flex">
                    <Card className="w-100 service-card">
                      <Card.Body className="d-flex flex-column">
                        <div className="d-flex align-items-start h-100">
                          <div className="icon-container me-3">
                            <img 
                              src={item.icon} 
                              alt={item.title}
                              className="w-100 h-100 object-fit-contain"
                            />
                          </div>
                          <div className="content-wrapper flex-grow-1">
                            <h5 className="service-title">{item.title}</h5>
                            <p className="service-description">{item.description}</p>
                            <div className="mt-auto">
                              <Button variant="link" className="service-link p-0">
                                <img 
                                  src={Navigation} 
                                  alt="Navigate" 
                                  className="nav-icon"
                                />
                              </Button>
                            </div>
                          </div>
                        </div>
                      </Card.Body>
                    </Card>
                  </Col>
                ))}
              </Row>
            </Col>
            <Col lg={6} className="order-lg-1 d-flex">
              <div className="survey-image-container w-100" style={{ maxHeight: '600px' }}>
                <img 
                  src={Tower} 
                  alt="Survey Tower" 
                  className="img-fluid" 
                  style={{
                    objectFit: 'cover',
                    width: '100%',
                    height: '100%',
                    maxHeight: '600px'
                  }}
                />
              </div>
            </Col>
          </Row>
        </Container>
      </section>

      {/* Quick Action Section */}
      <section className="quick-actions py-5 bg-light">
        <Container>
          <div className="section-header mb-5 text-center">
            <h2 className="section-title">Quick Actions</h2>
            <p className="section-description">
              Access frequently used services with just one click
            </p>
          </div>

          <Row className="g-4">
            {quickActionCards.map((card) => (
              <Col lg={3} md={6} key={card.id}>
                <Card className="quick-action-card h-100 text-center">
                  <Card.Body>
                    <div className="action-icon mb-4">
                      {React.cloneElement(card.icon, {
                        style: { width: "48px", height: "48px" },
                      })}
                    </div>
                    <h5 className="action-title mb-4">{card.title}</h5>
                    <Button variant="primary" className="action-btn">{card.buttonText}</Button>
                  </Card.Body>
                </Card>
              </Col>
            ))}
          </Row>
        </Container>
      </section>

      {/* Map Information Section */}
      <section className="map-section py-5">
        <Container>
          <div className="section-header mb-5">
            <h2 className="section-title">Map Information</h2>
            <p className="section-description">
              Explore our network of waterways and ports
            </p>
          </div>

          <div className="map-container rounded shadow overflow-hidden">
            <img src={Map} alt="Waterways Map" className="img-fluid w-100" />
          </div>
        </Container>
      </section>

      {/* Social Feed and News Section */}
      <section className="social-news py-5 bg-light">
        <Container>
          <Row className="gx-4">
            <Col lg={8} className="mb-5 mb-lg-0">
              <div className="section-header mb-4">
                <h2 className="section-title">Social Feed</h2>
              </div>
              
              <Card className="social-card h-100 shadow-sm">
                <Card.Body className="p-4 d-flex flex-column">
                  <Row className="h-100">
                    <Col md={6} className="pe-md-4 mb-4 mb-md-0" style={{ borderRight: '1px solid #dee2e6' }}>
                      <div className="d-flex justify-content-between align-items-center mb-4">
                        <div className="d-flex align-items-center">
                          <img
                            src={Linkedin}
                            alt="Linkedin"
                            className="social-icon me-3"
                          />
                          <h5 className="mb-0">LinkedIn</h5>
                        </div>
                        <a href="#" className="text-primary">See All</a>
                      </div>
                      <div className="social-post">
                        <p>Latest updates from our LinkedIn page will appear here.</p>
                      </div>
                    </Col>
                    <Col md={6} className="ps-md-4">
                      <div className="d-flex justify-content-between align-items-center mb-4">
                        <div className="d-flex align-items-center">
                          <img
                            src={Instagram}
                            alt="Instagram"
                            className="social-icon me-3"
                          />
                          <h5 className="mb-0">Instagram</h5>
                        </div>
                        <a href="#" className="text-primary">See All</a>
                      </div>
                      <div className="social-post">
                        <p>Our Instagram feed will be displayed here.</p>
                      </div>
                    </Col>
                  </Row>
                </Card.Body>
              </Card>
            </Col>

            <Col lg={4}>
              <div className="section-header mb-4">
                <h2 className="section-title">What's New</h2>
              </div>
              
              <Card className="news-card h-100 shadow-sm">
                <Card.Body className="p-4">
                  {newsItems.map((item, index) => (
                    <React.Fragment key={index}>
                      <div className="news-item mb-3">
                        <div className="d-flex justify-content-between align-items-start mb-2">
                          <p className="news-text mb-0">{item.text}</p>
                          <span className="badge bg-danger">New</span>
                        </div>
                        <p className="news-date text-muted mb-0">
                          <small>{item.date}</small>
                        </p>
                      </div>
                      {index < newsItems.length - 1 && <hr />}
                    </React.Fragment>
                  ))}
                </Card.Body>
              </Card>
            </Col>
          </Row>
        </Container>
      </section>
<div className="py-5"></div>
      {/* Footer */}
      <footer className="footer py-5 bg-primary text-white">
        <Container>
          <Row>
            <Col lg={3} md={6} className="mb-4 mb-lg-0">
              <h5 className="footer-heading">Services</h5>
              <ul className="footer-links">
                <li><a href="#">Vessel Registration</a></li>
                <li><a href="#">Vessel Survey</a></li>
                <li><a href="#">Finance Accounts</a></li>
                <li><a href="#">Grievance Redressal</a></li>
              </ul>
            </Col>
            <Col lg={3} md={6} className="mb-4 mb-lg-0">
              <h5 className="footer-heading">Resources</h5>
              <ul className="footer-links">
                <li><a href="#">HR</a></li>
                <li><a href="#">Tools</a></li>
                <li><a href="#">Career & Learning</a></li>
                <li><a href="#">IT Helpdesk</a></li>
              </ul>
            </Col>
            <Col lg={3} md={6} className="mb-4 mb-md-0">
              <h5 className="footer-heading">Legal</h5>
              <ul className="footer-links">
                <li><a href="#">FAQs</a></li>
                <li><a href="#">About Us</a></li>
                <li><a href="#">Terms of Use</a></li>
                <li><a href="#">CMVR 1989</a></li>
              </ul>
            </Col>
            <Col lg={3} md={6}>
              <h5 className="footer-heading">Policies</h5>
              <ul className="footer-links">
                <li><a href="#">Privacy Policy</a></li>
                <li><a href="#">Hyperlink Policy</a></li>
                <li><a href="#">Website Policy</a></li>
                <li><a href="#">Content Policy</a></li>
                <li><a href="#">Contingency Plan</a></li>
              </ul>
            </Col>
          </Row>
          <hr className="mt-4 mb-4" />
          <Row>
            <Col md={6} className="mb-3 mb-md-0">
              <p className="mb-0">&copy; {new Date().getFullYear()} Inland Water Transport. All rights reserved.</p>
            </Col>
            <Col md={6} className="text-md-end">
              <div className="social-icons">
                <a href="#" className="text-white me-3"><i className="bi bi-facebook"></i></a>
                <a href="#" className="text-white me-3"><i className="bi bi-twitter"></i></a>
                <a href="#" className="text-white me-3"><i className="bi bi-linkedin"></i></a>
                <a href="#" className="text-white"><i className="bi bi-instagram"></i></a>
              </div>
            </Col>
          </Row>
        </Container>
      </footer>

      {/* Add this CSS in your stylesheet */}
      <style jsx>{`
        .iwt-homepage {
          font-size: 1rem;
          line-height: 1.5;
        }
       
        .zoom-responsive-title {
          font-size: clamp(1.5rem, 3vw, 2.5rem);
        }

        /* Icon container fixes */
        .icon-container {
          width: 50px;
          height: 50px;
          min-width: 50px;
          display: flex;
          align-items: center;
          justify-content: center;
          background: #f0f7ff;
          border-radius: 8px;
          padding: 10px;
        }

        .icon-container img, .service-icon img {
          width: 100%;
          height: 100%;
          object-fit: contain;
        }

        .nav-icon {
          width: 24px;
          height: 24px;
        }

        /* Service card fixes */
        .service-card {
          height: 100%;
          padding: 1.25rem;
          margin-bottom: 1rem;
          display: flex;
          flex-direction: column;
        }

        .service-card .card-body {
          display: flex;
          flex-direction: column;
          height: 100%;
        }

        /* Container width */
        @media (min-width: 1200px) {
          .container-fluid {
            max-width: 1600px;
          }
        }

        /* High DPI screen adjustments */
        @media screen and (min-resolution: 1.5dppx) {
          .iwt-homepage {
            font-size: 0.9em;
          }
          
          .service-card {
            margin-bottom: 1.5em;
          }
          
          .icon-container {
            width: 3.5em;
            height: 3.5em;
          }
        }

        /* Bootstrap overrides */
        .row {
          --bs-gutter-x: 1.5rem;
          margin-right: calc(-0.5 * var(--bs-gutter-x));
          margin-left: calc(-0.5 * var(--bs-gutter-x));
        }

        .col,.col-1,.col-10,.col-11,.col-12,.col-2,.col-3,.col-4,.col-5,.col-6,.col-7,.col-8,.col-9,.col-auto,.col-lg,.col-lg-1,.col-lg-10,.col-lg-11,.col-lg-12,.col-lg-2,.col-lg-3,.col-lg-4,.col-lg-5,.col-lg-6,.col-lg-7,.col-lg-8,.col-lg-9,.col-lg-auto,.col-md,.col-md-1,.col-md-10,.col-md-11,.col-md-12,.col-md-2,.col-md-3,.col-md-4,.col-md-5,.col-md-6,.col-md-7,.col-md-8,.col-md-9,.col-md-auto,.col-sm,.col-sm-1,.col-sm-10,.col-sm-11,.col-sm-12,.col-sm-2,.col-sm-3,.col-sm-4,.col-sm-5,.col-sm-6,.col-sm-7,.col-sm-8,.col-sm-9,.col-sm-auto,.col-xl,.col-xl-1,.col-xl-10,.col-xl-11,.col-xl-12,.col-xl-2,.col-xl-3,.col-xl-4,.col-xl-5,.col-xl-6,.col-xl-7,.col-xl-8,.col-xl-9,.col-xl-auto {
          padding-right: calc(var(--bs-gutter-x) * 0.5);
          padding-left: calc(var(--bs-gutter-x) * 0.5);
        }

        /* Image container fixes */
        .vessel-image-container, .survey-image-container {
          height: 100%;
          display: flex;
          align-items: center;
          justify-content: center;
          border-radius: 8px;
          overflow: hidden;
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .vessel-image-container img, .survey-image-container img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        /* Button styling */
        .btn {
          font-size: 0.9em;
          padding: 0.5em 1.2em;
          border-radius: 0.5em;
        }

        /* Hero banner */
        .hero-banner {
          background-size: cover;
          background-position: center;
          min-height: 600px;
          position: relative;
          color: white;
          display: flex;
          flex-direction: column;
        }
        
        .hero-banner::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          background: rgba(0, 0, 0, 0.5);
        }
        
        .transparent-navbar {
          padding: 15px 0;
        }
        
        .navbar-logo {
          width: 50px;
          height: 50px;
          margin-right: 10px;
        }
        
        .hero-content {
          position: relative;
          z-index: 1;
          flex: 1;
          display: flex;
          align-items: center;
          padding: 60px 0;
        }
        
        .hero-content h1 {
          font-size: 3rem;
          font-weight: 700;
          margin-bottom: 20px;
        }
        
        .hero-content .lead {
          font-size: 1.25rem;
          max-width: 600px;
        }
        
        /* Stats section with gradient */
        .stats-section {
          background: #f8f9fa;
        }
        
        .stat-card {
          border: none;
          border-radius: 10px;
          transition: transform 0.3s;
          background: linear-gradient(135deg, #00429C, #4695FF);
          height: 100%;
        }
        
        .stat-card:hover {
          transform: translateY(-5px);
          box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }
        
        .stat-value {
          color: #fff;
          font-weight: 700;
          font-size: 2.5rem;
        }
        
        .stat-label {
          color: #fff;
          font-weight: 600;
        }
        
        .stat-description {
          color: #fff;
          font-size: 0.9rem;
        }
        
        /* Section styling */
        .section-header {
          max-width: 800px;
          margin-left: auto;
          margin-right: auto;
          text-align: center;
        }
        
        .section-title {
          font-weight: 700;
          color: #333;
          margin-bottom: 15px;
        }
        
        .section-description {
          color: #666;
          font-size: 1.1rem;
        }
        
        /* Service cards */
        .service-card {
          border: none;
          border-radius: 10px;
          box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
          transition: transform 0.3s;
        }
        
        .service-card:hover {
          transform: translateY(-5px);
          box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
        }
        
        .service-icon {
          width: 50px;
          height: 50px;
          min-width: 50px;
          display: flex;
          align-items: center;
          justify-content: center;
          background: #f0f7ff;
          border-radius: 8px;
          padding: 10px;
          flex-shrink: 0;
        }
        
        .service-title {
          font-size: 1rem;
          font-weight: 600;
          color: #333;
        }
        
        .service-description {
          font-size: 0.85rem;
          color: #666;
        }
        
             .service-link img {
          width: 20px;
          height: 20px;
        }
        
        /* Content wrapper for service cards */
        .content-wrapper {
          display: flex;
          flex-direction: column;
          height: 100%;
        }
        
        /* Quick action cards */
        .quick-action-card {
          border: none;
          border-radius: 10px;
          box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
          transition: all 0.3s;
        }
        
        .quick-action-card:hover {
          transform: translateY(-5px);
          box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
        }
        
        .action-icon {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 80px;
          height: 80px;
          background: #f0f7ff;
          border-radius: 50%;
          margin: 0 auto;
        }
        
        .action-title {
          font-weight: 600;
          color: #333;
        }
        
        .action-btn {
          border-radius: 20px;
          padding: 8px 25px;
          font-weight: 500;
        }
        
        /* Map container */
        .map-container {
          height: 400px;
          background: #f5f5f5;
        }
        
        .map-container img {
          height: 100%;
          object-fit: cover;
          max-height: 400px;
        }
        
        /* Social and news cards */
        .social-card, .news-card {
          border: none;
          border-radius: 10px;
        }
        
        .social-icon {
          width: 40px;
          height: 40px;
        }
        
        .news-item {
          padding: 10px 0;
        }
        
        .news-text {
          font-size: 0.9rem;
          margin-right: 10px;
        }
        
        .news-date {
          font-size: 0.8rem;
        }
        
        /* Footer styling */
        .footer {
          background: #0d6efd;
        }
        
        .footer-heading {
          font-size: 1.1rem;
          font-weight: 600;
          margin-bottom: 20px;
          position: relative;
          padding-bottom: 10px;
        }
        
        .footer-heading::after {
          content: '';
          position: absolute;
          left: 0;
          bottom: 0;
          width: 50px;
          height: 2px;
          background: rgba(255, 255, 255, 0.5);
        }
        
        .footer-links {
          list-style: none;
          padding: 0;
        }
        
        .footer-links li {
          margin-bottom: 10px;
        }
        
        .footer-links a {
          color: rgba(255, 255, 255, 0.8);
          text-decoration: none;
          transition: color 0.3s;
        }
        
        .footer-links a:hover {
          color: white;
        }
        
        .social-icons a {
          display: inline-block;
          width: 36px;
          height: 36px;
          background: rgba(255, 255, 255, 0.1);
          border-radius: 50%;
          text-align: center;
          line-height: 36px;
          transition: background 0.3s;
        }
        
        .social-icons a:hover {
          background: rgba(255, 255, 255, 0.2);
        }
        
        /* Responsive adjustments */
        @media (max-width: 768px) {
          .hero-content h1 {
            font-size: 2.2rem;
          }
          
          .hero-content .lead {
            font-size: 1rem;
          }
          
          .section-title {
            font-size: 1.5rem;
          }
          
          .section-description {
            font-size: 1rem;
          }
          
          .vessel-image-container, .survey-image-container {
            min-height: 300px;
            margin-top: 1rem;
          }
          
          .social-column:first-child {
            border-right: none;
            border-bottom: 1px solid #dee2e6;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
          }
        }
      `}</style>
    </div>
  );
};

export default IWTHomePage;

