<style jsx>{`
  .social-card, .news-card {
    border: none;
    border-radius: 10px;
    min-height: 300px; // Minimum height for mobile
  }

  @media (min-width: 992px) {
    .social-card, .news-card {
      min-height: 450px;
    }
  }

  .hero-banner {
    background-attachment: fixed;
    background-size: cover;
  }

  .vessel-image-container img {
    object-fit: cover;
    object-position: center;
  }

  .stats-section {
    margin-top: -50px;
    position: relative;
    z-index: 2;
  }

  .stat-card {
    min-height: 200px;
  }

  @media (max-width: 768px) {
    .hero-banner {
      min-height: 50vh;
    }
    
    .stat-card {
      margin-bottom: 1rem;
    }
    
    .service-card {
      margin-bottom: 1rem;
    }
  }
`}</style>
