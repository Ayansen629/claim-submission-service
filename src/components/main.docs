// Update the handleConfirm function
const handleConfirm = async (appointments) => {
  setShowModal(false);
  setIsAppointmentBooked(true);
  try {
    const formattedAppointments = appointments.map((apt) => ({
      date: apt.date.toLocaleDateString("en-GB"),
      timeSlot: apt.time,
      appointmentStatus: "",
      isBooked: false,
      bookedBy: null,
    }));
    
    await onSubmitAppointments(formattedAppointments);
    setDisplayAppointment(false);
    
    // Show success message for officers
    if (isOfficer) {
      toast.success("Appointment slots proposed successfully. You can now take actions.");
    }
  } catch (error) {
    console.error("Error submitting appointments:", error);
  }
};

// Update the button condition
{(displayAppointment || userRole === USER_ROLES.VESSEL_OWNER) && 
 !hasBookedAppointment && 
 !isAppointmentBooked && (
  <Button
    variant="primary"
    onClick={() => setShowModal(true)}
    className="d-flex align-items-center gap-2"
    style={{
      backgroundColor: "#2E57A7",
      borderColor: "#2E57A7",
      fontWeight: 600,
      padding: "10px 24px",
      borderRadius: "8px",
      fontSize: "0.9rem",
      boxShadow: "0 4px 12px rgba(46, 87, 167, 0.2)",
      transition: "all 0.3s ease",
    }}
  >
    <BsCalendarCheck size={16} />
    {isOfficer ? "Propose Appointments" : "Schedule Appointment"}
  </Button>
)}

{/* Add message for officers when appointments are needed */}
{showCmnStepper && 
 (!registrationData?.appointmentSlots || registrationData.appointmentSlots.length === 0) &&
 isOfficer && (
  <div className="alert alert-warning mt-3" role="alert">
    <strong>Action Required:</strong> Please propose appointment slots before proceeding with workflow actions.
  </div>
)}
