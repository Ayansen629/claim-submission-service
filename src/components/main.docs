// Add new imports
import SurveyTracker from './SurveyTracker';
import { OFFICER_L2_STAT_DATA } from './employeeDashboardConstants';

// Update getStatData function
const getStatData = () => {
  switch(userRole) {
    case USER_ROLES.OFFICER_L1:
      return OFFICER_L1_STAT_DATA;
    case USER_ROLES.OFFICER_L2:
      return OFFICER_L2_STAT_DATA;
    case USER_ROLES.ADMIN:
    default:
      return EMPLOYEE_STAT_DATA;
  }
};

// Update getDashboardTitle function
const getDashboardTitle = () => {
  switch(userRole) {
    case USER_ROLES.OFFICER_L1:
      return "Officer L1 Dashboard";
    case USER_ROLES.OFFICER_L2:
      return "Officer L2 Dashboard";
    case USER_ROLES.ADMIN:
      return "Admin Dashboard";
    default:
      return "My WorkDesk";
  }
};

// Update StatusCard rendering to handle calendar
{getStatData().map((item, index) => (
  <div className="col-md-4 col-lg-3 col-sm-12" key={index}>
    {item.isCalendar ? (
      <StatusCard {...item} onClick={() => setShowCalendar(!showCalendar)} />
    ) : (
      <StatusCard {...item} />
    )}
  </div>
))}

// Add state for calendar visibility
const [showCalendar, setShowCalendar] = useState(false);

// Add calendar section after stats cards
{userRole === USER_ROLES.OFFICER_L2 && showCalendar && (
  <div className="col-12 mt-4">
    <Card className="bg-transparent dashboard-card">
      <Card.Header className="dashboard-card-header">
        Survey Tracker
      </Card.Header>
      <Card.Body>
        <SurveyTracker />
      </Card.Body>
    </Card>
  </div>
)}
