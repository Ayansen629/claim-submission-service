import React, { useState, useEffect, useRef } from "react";
import { useForm, FormProvider } from "react-hook-form";
import { useTranslation } from "react-i18next";
import { NavDropdown } from "react-bootstrap";
import { MdOutlineLanguage } from "react-icons/md";

import {
  Container,
  Row,
  Col,
  Form,
  Button,
  Card,
  Image,
  Alert,
} from "react-bootstrap";
import {
  FaUser,
  FaBuilding,
  FaFileUpload,
  FaCheck,
  FaArrowRight,
  FaArrowLeft,
  FaIdCard,
  FaEnvelope,
  FaPhone,
  FaMapMarkerAlt,
  FaUpload,
  FaShip,
} from "react-icons/fa";
import "./UserRegistration.css";
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";
import { toast } from "react-toastify";
import {
  getData,
  postData,
  postFORMdata,
} from "../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../utils/urlsConstants.ts";
import { handleErrorMessage } from "../../../utils/errorMessageHandler.js";
import {
  createOwnerOrBuilderPayload,
  mapToVesselUserDetails,
} from "../model/mapToVesselModel.ts";
import NewLoader from "../../common/NewLoader.js";
import InputText from "../../common/InputText.tsx";
import InputFile from "../../common/InputFile.tsx";
import i18n from "i18next";
import InputSelect from "../../common/InputSelect.tsx";
import {
  MasterDataProvider,
  useMasterData,
} from "../../context/MasterDataContext.js";
import { useLanguageContext } from "../../common/LanguageContext.js";

const VesselOwnerRegistrationPage = () => {
  const { i18n,t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const isCompMount = useRef(true);

  const { masterData } = useMasterData();

  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [successMessage, setSuccessMessage] = useState("");
  const [isCompany, setIsCompany] = useState(false);
  const [validationMessage, setValidationMessage] = useState("");
  const loaderRef = useRef();
  const PUBLIC_URL = process.env.REACT_APP_PUBLIC_URL;
  const methods = useForm({
    mode: "onBlur",
    defaultValues: { categoryOfOwner: "", country: "India" },
  });

  const {
    register,
    handleSubmit,
    formState: { errors },
    trigger,
    setValue,
    getValues,
    watch,
    clearErrors,
    setError,
  } = methods;

  const totalSteps = 3;

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [i18n.language]);

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach((key) => {
        if (formData[key] !== undefined) {
          console.log("Setting value for", key, formData[key]);
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [currentStep, setValue, formData]);

  const formFields = {
    step1: [
      {
        name: "categoryOfOwner",
        label: t("vesselOwnerRegistration.Category of Owner"),
        type: "select",
        options: [
          ...(masterData?.ownerTypes?.map((type) => ({
            value: type.valueCode,
            label: type.valueLabel,
            isCompany: type.isCompany,
          })) || []),
        ],
        required: true,
        icon: FaBuilding,
        colSize: 6,
        validation: { required: t("vesselOwnerRegistration.OwnerCatRequired") },
      },
      {
        name: "ownerCompanyName",
        label: t("vesselOwnerRegistration.Owner/Company Name"),
        type: "text",
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 150,
        placeholder: t("vesselOwnerRegistration.Enter owner or company name"),
        validation: {
          required: t("vesselOwnerRegistration.Owner name is required"),
        },
      },
      {
        name: "emailId",
        label: t("vesselOwnerRegistration.Email ID"),
        type: "email",
        required: true,
        icon: FaEnvelope,
        maxlength: 100,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Enter email address"),
        validation: {
          required: t("vesselOwnerRegistration.Email is required"),
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: t("vesselOwnerRegistration.Invalid email address"),
          },
        },
      },
      {
        name: "phoneNumber",
        label: t("vesselOwnerRegistration.Phone Number"),
        type: "text",
        required: true,
        icon: FaPhone,
        colSize: 6,
        maxlength: 10,
        placeholder: t("vesselOwnerRegistration.Enter 10-digit phone number"),
        validation: {
          required: t("vesselOwnerRegistration.Phone number is required"),
          pattern: {
            value: /^[0-9]{10}$/,
            message: t(
              "vesselOwnerRegistration.Phone number must be 10 digits"
            ),
          },
        },
      },
      {
        name: "cinNo",
        label: t("vesselOwnerRegistration.CIN Number"),
        type: "text",
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Enter CIN number"),
        validation: {
          pattern: {
            value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
            message: t("vesselOwnerRegistration.Invalid CIN format"),
          },
        },
        showIf: () => isCompany,
      },
      {
        name: "dinNo",
        label: t("vesselOwnerRegistration.DIN Number"),
        type: "text",
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Enter DIN number"),
        validation: {
          pattern: {
            value: /^[0-9]{8}$/,
            message: t("vesselOwnerRegistration.DIN must be 8 digits"),
          },
        },
        showIf: () => isCompany,
      },
      {
        name: "panNo",
        label: t("vesselOwnerRegistration.PAN Number"),
        type: "text",
        required: true,
        icon: FaIdCard,
        colSize: 6,
        maxlength: 10,
        placeholder: t(
          "vesselOwnerRegistration.Enter PAN number (e.g., ABCDE1234F)"
        ),
        validation: {
          required: t("vesselOwnerRegistration.PAN number is required"),
          pattern: {
            value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
            message: t("vesselOwnerRegistration.Invalid PAN format"),
          },
        },
      },
      {
        name: "gstNo",
        label: t("vesselOwnerRegistration.GST Number"),
        type: "text",
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: t(
          "vesselOwnerRegistration.Enter GST number (if applicable)"
        ),
        validation: {
          pattern: {
            value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
            message: t("vesselOwnerRegistration.Invalid GST format"),
          },
        },
      },
      {
        name: "addressLine1",
        label: t("vesselOwnerRegistration.Address Line-1"),
        type: "text",
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 150,
        placeholder: t("vesselOwnerRegistration.Enter address line 1"),
        validation: {
          required: t("vesselOwnerRegistration.Address is required"),
        },
      },
      {
        name: "addressLine2",
        label: t("vesselOwnerRegistration.Address Line-2"),
        type: "text",
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 150,
        placeholder: t(
          "vesselOwnerRegistration.Enter address line 2 (optional)"
        ),
      },
      {
        name: "pin",
        label: t("vesselOwnerRegistration.PIN"),
        type: "text",
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 6,
        placeholder: t("vesselOwnerRegistration.Enter 6-digit PIN code"),
        validation: {
          required: t("vesselOwnerRegistration.PIN code is required"),
          pattern: {
            value: /^[0-9]{6}$/,
            message: t("vesselOwnerRegistration.PIN must be 6 digits"),
          },
        },
        onChange: (e, setValue, watch) => {
          const changedValue = e?.target?.value || "";
          if (changedValue?.length === 6) {
            setValue("district", "");
            setValue("state", "");
            setValue("country", "India");
            getDetailsByPIN(changedValue);
          }
        },
      },
      {
        name: "district",
        label: t("vesselOwnerRegistration.District"),
        type: "text",
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Please enter district"),
      },
      {
        name: "state",
        label: t("vesselOwnerRegistration.State / UT"),
        type: "text",
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Please enter state"),
      },
      {
        name: "country",
        label: t("vesselOwnerRegistration.Country"),
        type: "text",
        required: false,
        disabled: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Please enter country"),
      },
    ],
    step2: [
      {
        name: "authorisedFname",
        label: t("vesselOwnerRegistration.First Name"),
        type: "text",
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 50,
        placeholder: t("Enter first name"),
        validation: {
          required: t("vesselOwnerRegistration.First name is required"),
        },
      },
      {
        name: "authorisedLname",
        maxlength: 50,
        label: t("vesselOwnerRegistration.Last Name"),
        type: "text",
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Enter last name"),
        validation: {
          required: t("vesselOwnerRegistration.Last name is required"),
        },
      },
      {
        name: "authorisedMob",
        label: t("vesselOwnerRegistration.Primary Mobile Number"),
        type: "text",
        required: true,
        icon: FaPhone,
        colSize: 6,
        maxlength: 10,
        placeholder: t("vesselOwnerRegistration.Enter 10-digit mobile number"),
        validation: {
          required: t("vesselOwnerRegistration.Mobile number is required"),
          pattern: {
            value: /^[0-9]{10}$/,
            message: t(
              "vesselOwnerRegistration.Mobile number must be 10 digits"
            ),
          },
        },
      },
      {
        name: "authorisedEmail",
        label: t("vesselOwnerRegistration.Email ID"),
        type: "email",
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        maxlength: 100,
        placeholder: t("vesselOwnerRegistration.Enter email address"),
        validation: {
          required: t("vesselOwnerRegistration.Email is required"),
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: t("vesselOwnerRegistration.Invalid email address"),
          },
        },
      },
      {
        name: "authorizationLetter",
        label: t("vesselOwnerRegistration.Letter of Authorization"),
        type: "file",
        required: false,
        colSize: 12,
      },
    ],
    step3: [
      {
        name: "panCardUpload",
        label: t("vesselOwnerRegistration.PAN Card"),
        type: "file",
        required: false,
        colSize: 6,
      },
      {
        name: "gstCertificate",
        label: t("vesselOwnerRegistration.GST Certificate"),
        type: "file",
        required: false,
        colSize: 6,
      },
      {
        name: "addressProof",
        label: t("vesselOwnerRegistration.Address Proof"),
        type: "file",
        required: false,
        colSize: 6,
      },
      {
        name: "companyRegistrationCertificate",
        label: t("vesselOwnerRegistration.Company Registration Certificate"),
        type: "file",
        required: false,
        colSize: 6,
      },
      {
        name: "companyRegistrationCertificate",
        label: t("Company Registration Certificate"),
        type: "file",
        required: false,
        colSize: 6,
        showIf: () => isCompany,
      },
      {
        name: "moaCertificate",
        label: t("vesselOwnerRegistration.MOA Certificate"),
        type: "file",
        required: false,
        colSize: 6,
        validation: {},
        showIf: () => isCompany,
      },
      {
        name: "aoaCertificate",
        label: t("vesselOwnerRegistration.AOA Certificate"),
        type: "file",
        required: false,
        colSize: 6,
        validation: {},
        showIf: () => isCompany,
      },
    ],
  };

  const getDetailsByPIN = async (pinCode) => {
    try {
      const URL =
        PUBLIC_URL +
        URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE +
        pinCode;
      loaderRef.current?.show();
      const response = await getData(URL);
      if (response?.status === 200 && response?.data?.length > 0) {
        setValue("district", response?.data[0]?.district);
        setValue("state", response?.data[0]?.stateName);
        loaderRef?.current?.hide();
      } else {
        loaderRef?.current?.hide();
        toast.info("No Data Found! Pleasee enter manually..", {
          position: "top-right",
        });
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  
  const getCurrentStepFields = () => {
    let fields = [];
    switch (currentStep) {
      case 1:
        fields = formFields.step1;
        break;
      case 2:
        fields = formFields.step2;
        break;
      case 3:
        fields = formFields.step3;
        break;
      default:
        fields = [];
    }
    
    
    return fields.filter(field => !field.showIf || field.showIf());
  };

  const validateStep = async () => {
    const currentFields = getCurrentStepFields();
    const requiredFields = currentFields.filter(field => field.required);

    // Set errors for empty required fields
    requiredFields.forEach((field) => {
      const value = getValues(field.name);
      if (!value || value === "") {
        setError(field.name, {
          type: "required",
          message: `${field.label} is required`,
        });
      } else if (field.validation && field.validation.pattern) {
        const pattern = field.validation.pattern.value;
        if (!pattern.test(value)) {
          setError(field.name, {
            type: "pattern",
            message: field.validation.pattern.message,
          });
        }
      }
    });

    // Validate all fields in the current step
    const fieldsToValidate = currentFields.map((field) => field.name);
    return await trigger(fieldsToValidate);
  };

  const handleNext = async () => {
    const isStepValid = await validateStep();

    if (isStepValid) {
      setValidationMessage("");

      const currentValues = getValues();
      console.log("Current values before next step:", currentValues);

      setFormData((prev) => {
        const newFormData = { ...prev };

        Object.keys(currentValues).forEach((key) => {
          if (currentValues[key] !== undefined) {
            newFormData[key] = currentValues[key];
          }
        });

        console.log("Updated formData:", newFormData);
        return newFormData;
      });

      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    }
  };

  const handlePrevious = () => {
    const currentValues = getValues();

    const fileFields = getCurrentStepFields().filter(
      (field) => field.type === "file"
    );
    fileFields.forEach((field) => {
      if (currentValues[field.name]) {
        setFormData((prev) => ({
          ...prev,
          [field.name]: currentValues[field.name],
        }));
      }
    });

    setFormData((prev) => ({ ...prev, ...currentValues }));

    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
    setValidationMessage("");
  };

  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };
    // console.log(finalData, "finalDatapayload");

    const payload = createOwnerOrBuilderPayload("VESSEL_OWNER", {
      ...finalData,
    });

    const files = [
      finalData?.addressProof,
      finalData?.panCardUpload,
      finalData?.gstCertificate,
      finalData?.authorizationLetter,
      finalData?.companyRegistrationCertificate,
      finalData?.moaCertificate,
      finalData?.aoaCertificate,
    ];
    const fd = new FormData();

    fd.append(
      "request",
      new Blob([JSON.stringify(payload)], { type: "application/json" })
    );
    files?.forEach((file) => {
      if (file) {
        fd.append(`files`, file);
      }
    });
    submitUserDetails(fd);
  };

  const submitUserDetails = async (payload) => {
    try {
      const URL =
        process.env.REACT_APP_AUTH_URL +
        URLS_ENDPOINT.USER_SERVICE.CREATE_UPDATE_USER;
      loaderRef.current?.show();
      const response = await postFORMdata(URL, payload);
      const apiRes = { ...response?.data };
      if (
        response?.status === 200 &&
        apiRes?.responseStatus?.status === "200"
      ) {
        loaderRef?.current?.hide();
        setIsSubmitted(true);
        setSuccessMessage(apiRes?.responseStatus?.message);
        window.scrollTo(0, 0);
      } else {
        loaderRef?.current?.hide();
        toast.info(
          apiRes?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const DynamicField = ({ field }) => {
    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case "select":
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register(field?.name, {
              ...field.validation,
            })}
            errors={errors}
            icon={field.icon}
            className="mb-3"
            onChange={(value, selObj) => {
              setIsCompany(selObj?.isCompany || false);
              setValue(field.name, value);
              if (errors[field.name]) {
                clearErrors(field.name);
              }
              setFormData((prev) => ({
                ...prev,
                [field.name]: value,
              }));
            }}
            value={formData[field.name] || watch(field.name)}
            autoFocus={field.autoFocus}
          />
        );

      case "file":
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e.target.files[0]) {
                const file = e.target.files[0];
                console.log("Selected file:", file);
                const extension = file?.name?.substring(
                  file?.name?.lastIndexOf(".")
                );
                const customFileName = `${field.label}${extension}`;

                file.originalName = customFileName;
                setValue(field.name, file);

                setFormData((prev) => {
                  const updated = { ...prev, [field.name]: file };
                  return updated;
                });

                if (errors[field.name]) {
                  clearErrors(field.name);
                }

                const validTypes = [
                  "application/pdf",
                  "image/jpeg",
                  "image/png",
                  "image/jpg",
                ];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: "manual",
                    message: "Only PDF, JPG or PNG files are allowed",
                  });
                }

                if (file.size > 2 * 1024 * 1024) {
                  setError(field.name, {
                    type: "manual",
                    message: "File size should not exceed 2MB",
                  });
                }
              }
            }}
            className="mb-3"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={formData[field.name]}
            autoFocus={field.autoFocus}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...field.validation,
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className="mb-3"
            style={{
              borderColor: errors[field.name] ? "#dc3545" : "#ced4da",
              backgroundColor: errors[field.name] ? "#fff8f8" : "white",
            }}
            autoFocus={field.autoFocus}
          />
        );
    }
  };

  const stepTitles = [
    {
      title: t("vesselOwnerRegistration.Vessel Owner Details"),
      icon: FaBuilding,
    },
    {
      title: t("vesselOwnerRegistration.Authorized Person's Details"),
      icon: FaUser,
    },
    {
      title: t("vesselOwnerRegistration.Documents Upload"),
      icon: FaFileUpload,
    },
  ];

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="registration-container py-5">
        <div
          style={{
            position: "absolute",
            top: "10px",
            right: "10px",
            zIndex: 1050,
          }}
        >
          <NavDropdown
            title={
              <MdOutlineLanguage
                className="language-icon"
                style={{ fontSize: "1.5rem", color: "#fff" }}
              />
            }
            id="language-nav-dropdown"
            className="mx-2"
            style={{
              display: "inline-block",
              marginTop: "10px",
              zIndex: 1050,
              position: "relative",
            }}
          >
            <NavDropdown.Item
              onClick={() => changeLanguage("en")}
              className="small-text"
              style={{
                color: "#000000",
                padding: "10px 15px",
              }}
            >
              English
            </NavDropdown.Item>
            <NavDropdown.Item
              onClick={() => changeLanguage("bn")}
              className="small-text"
              style={{
                color: "#000000",
                padding: "10px 15px",
              }}
            >
              বাংলা
            </NavDropdown.Item>
          </NavDropdown>
        </div>
        <Row className="justify-content-center">
          <Col lg={10} xl={9}>
            <Card className="registration-card">
              <Card.Header className="registration-header p-0">
                <div className="registration-header-content">
                  <div className="header-logo-container">
                    <Image
                      src={IWT_FULL_IMG}
                      alt="IWT Logo"
                      className="header-logo"
                    />
                  </div>
                  <h3 className="header-title">
                    {t("vesselOwnerRegistration.Vessel Owner Registration")}
                  </h3>
                </div>
              </Card.Header>

              <Card.Body className="registration-body p-4 p-md-5">
                {isSubmitted ? (
                  <div className="success-container text-center py-5">
                    <div
                      className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4"
                      style={{
                        width: "90px",
                        height: "90px",
                        boxShadow: "0 10px 20px rgba(40, 167, 69, 0.3)",
                      }}
                    >
                      <FaCheck className="success-icon text-white fs-1" />
                    </div>
                    <h4 className="success-title text-success mb-3 fw-bold">
                      Registration Successful!
                    </h4>
                    <div
                      className="registration-id p-4 bg-light rounded mb-4"
                      style={{ borderLeft: "4px solid #0077b6" }}
                    >
                      {successMessage ||
                        "Your vessel builder registration has been submitted successfully. You will receive a confirmation email shortly."}
                    </div>
                    <Button
                      variant="primary"
                      size="lg"
                      className="mt-2 d-flex align-items-center justify-content-center mx-auto"
                      style={{
                        background: "linear-gradient(135deg, #0077b6, #023e8a)",
                        border: "none",
                        boxShadow: "0 4px 15px rgba(0, 119, 182, 0.3)",
                        borderRadius: "8px",
                        padding: "12px 30px",
                        fontWeight: "600",
                        transition: "all 0.3s ease",
                        minWidth: "150px",
                        height: "50px",
                      }}
                      onClick={() => (window.location.href = "/")}
                    >
                      Go to Home
                    </Button>
                  </div>
                ) : (
                  <FormProvider {...methods}>
                    <form>
                      <div className="text-center mb-4">
                        <p className="text-muted">
                          {t(
                            "vesselOwnerRegistration.Please complete all required information to register your vessel"
                          )}
                        </p>
                      </div>

                      <div className="stepper-container mb-5">
                        <div className="stepper d-flex justify-content-between">
                          {[1, 2, 3].map((step) => (
                            <React.Fragment key={step}>
                              <div
                                className={`step ${
                                  currentStep >= step ? "active" : ""
                                } ${
                                  currentStep > step ? "completed" : ""
                                } flex-grow-1 text-center`}
                              >
                                <div
                                  className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2"
                                  style={{
                                    width: "60px",
                                    height: "60px",
                                    borderRadius: "50%",
                                    fontSize: "20px",
                                    fontWeight: "bold",
                                    boxShadow:
                                      currentStep >= step
                                        ? "0 5px 15px rgba(0, 119, 182, 0.3)"
                                        : "0 4px 10px rgba(0, 0, 0, 0.1)",
                                    background:
                                      currentStep >= step
                                        ? currentStep > step
                                          ? "linear-gradient(135deg, #28a745, #20c997)"
                                          : "linear-gradient(135deg, #0077b6, #023e8a)"
                                        : "#ffffff",
                                                                      border:
                                      currentStep >= step
                                        ? "none"
                                        : "2px solid #e9ecef",
                                    color:
                                      currentStep >= step ? "#fff" : "#6c757d",
                                    transition: "all 0.4s ease",
                                  }}
                                >
                                  {currentStep > step ? (
                                    <FaCheck size={22} />
                                  ) : (
                                    React.createElement(
                                      stepTitles[step - 1].icon,
                                      { size: 22 }
                                    )
                                  )}
                                </div>
                                <div
                                  className="step-label fw-bold"
                                  style={{
                                    color:
                                      currentStep >= step
                                        ? currentStep > step
                                          ? "#28a745"
                                          : "#0077b6"
                                        : "#6c757d",
                                    fontSize: "0.9rem",
                                    transition: "all 0.3s ease",
                                  }}
                                >
                                  {stepTitles[step - 1].title}
                                </div>
                              </div>
                              {step < 3 && (
                                <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                                  <div
                                    className={`connector-line w-100 ${
                                      currentStep > step ? "active" : ""
                                    }`}
                                    style={{
                                      height: "4px",
                                      background:
                                        currentStep > step
                                          ? "linear-gradient(to right, #28a745, #20c997)"
                                          : "#e9ecef",
                                      borderRadius: "2px",
                                      transition: "all 0.5s ease",
                                    }}
                                  ></div>
                                </div>
                              )}
                            </React.Fragment>
                          ))}
                        </div>
                      </div>

                      <div className="step-content">
                        <div className="form-section p-4 rounded mb-4">
                          <div className="section-title">
                            {React.createElement(
                              stepTitles[currentStep - 1].icon,
                              { className: "section-icon" }
                            )}
                            <h4 className="mb-0 fw-bold">
                             {stepTitles[currentStep - 1].title}
                            </h4>
                              {/* {stepTitles[currentStep - 1].dropdown}{" "} */}
                          </div>

                          <div className="form-content py-3">
                            <Row className="g-3">
                              {getCurrentStepFields().map((field, index) => (
                                <Col
                                  key={`${field.name}-${isCompany}`}
                                  md={field.colSize || 12}
                                  className="mb-0"
                                >
                                  <DynamicField field={field} />
                                </Col>
                              ))}
                            </Row>
                          </div>
                        </div>
                      </div>

                      <div
                        className="form-navigation mt-4"
                        style={{ display: "block" }}
                      >
                        {currentStep > 1 && (
                          <Button
                            variant="outline-secondary"
                            onClick={handlePrevious}
                            className="prev-btn"
                            style={{ float: "left" }}
                          >
                            <FaArrowLeft className="btn-icon me-2" />{" "}
                            {t("Previous")}
                          </Button>
                        )}

                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="next-btn"
                          style={{ float: "right" }}
                        >
                          {currentStep === totalSteps
                            ? t("Submit Registration")
                            : t("Next")}
                          {currentStep !== totalSteps && (
                            <FaArrowRight className="btn-icon ms-2" />
                          )}
                        </Button>
                      </div>
                    </form>
                  </FormProvider>
                )}
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Container>
    </>
  );
};

export default VesselOwnerRegistrationPage;

import React, { useState, useRef, useEffect } from "react";
import { Form, InputGroup, OverlayTrigger, Tooltip } from "react-bootstrap";
import { FaEye, FaEyeSlash } from "react-icons/fa";
import classNames from "classnames";
import { CONSTANT_REGEX } from "../../utils/constants.ts";

interface InputTextProps {
  label: string;
  required?: boolean;
  name: string;
  type?: string;
  placeholder?: string;
  register?: any;
  disabled?: boolean;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  maxlength?: number;
  readOnly?: boolean;
  errors?: any;
  className?: string;
  onKeyDown?: (e: React.KeyboardEvent<HTMLInputElement>) => void;
  icon?: React.ElementType;
  description?: string;
  style?: React.CSSProperties;
  autoFocus?: boolean;
}

// function getNestedError(errors: any, name: string) {
//   if (!errors || !name) return "";
//   const path = name.split(".");
//   let current = errors;
//   for (let i = 0; i < path.length; i++) {
//     if (current[path[i]] === undefined) return "";
//     current = current[path[i]];
//   }
//   return typeof current === "object" && current !== null && "message" in current
//     ? current.message
//     : typeof current === "string"
//     ? current
//     : "";
// }
const InputText: React.FC<InputTextProps> = ({
  label,
  required,
  name,
  type = "text",
  placeholder,
  register,
  disabled,
  onChange,
  maxlength,
  readOnly,
  errors,
  className = "",
  onKeyDown,
  icon: IconComponent,
  description,
  style = {},
  autoFocus,
}) => {
  const [showPassword, setShowPassword] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);
  const isPassword = type === "password";
  const inputType = isPassword ? (showPassword ? "text" : "password") : type;

  // const errorMessage = errors?.[name]?.message || "";
  // const errorMessage = getNestedError(errors, name);
 
  const errorMessage = name?.split('.')?.reduce((acc, key) => acc?.[key], errors)?.message || "";
  const [inputValue, setInputValue] = useState("");
  const [isValid, setIsValid] = useState(false);
  const [touched, setTouched] = useState(false);
  const [isTyping, setIsTyping] = useState(false);
  const validationPattern = useRef<RegExp | null>(null);

  useEffect(() => {
    if (type === "email") {
      validationPattern.current = CONSTANT_REGEX.EMAIL;
    } else if (name.includes("pan")) {
      validationPattern.current = CONSTANT_REGEX.PAN;
    } else if (name.includes("gst")) {
      validationPattern.current = CONSTANT_REGEX.GSTNO;
    } else if (name.includes("phone") || name.includes("mobile")) {
      validationPattern.current = CONSTANT_REGEX.MOBILE;
    } else if (name.includes("pin")) {
      validationPattern.current = CONSTANT_REGEX.PINCODE;
    } else {
      validationPattern.current = null;
    }
  }, [type, name]);

  useEffect(() => {
    if (!inputValue && !required) {
      setIsValid(true);
      return;
    }

    if (!inputValue) {
      setIsValid(false);
      return;
    }

    let valid = false;

    if (name.includes("pin") && inputValue.length === 6) {
      valid = true;
    } else if (validationPattern.current) {
      valid = validationPattern.current.test(inputValue);
    } else if (required) {
      valid = inputValue.length > 0;
    } else {
      valid = true;
    }

    setIsValid(valid);
  }, [inputValue, required, name]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const value = e.target.value;
    setInputValue(value);
    setTouched(true);
    setIsTyping(true);

    if (name.includes("pin") && value.length === 6) {
      setTimeout(() => {
        if (inputRef.current) {
          inputRef.current.value = value;
        }
      }, 100);
    }

    if (onChange) {
      onChange(e);
    }
  };

  const togglePasswordVisibility = () => setShowPassword((prev) => !prev);


  const showError = errorMessage && !isTyping;
  const showSuccess = touched && isValid && inputValue && !showError;
  
  const inputClasses = classNames("shadow-sm w-100", {
    "is-invalid": showError,
    "is-valid": showSuccess,
    "border-start-0": IconComponent,
    "border-end-0": isPassword,
    "disabled": disabled,
  });

  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      {label && (
        <Form.Label className="fw-semibold d-block">
          {label}
          {required && <span className="text-danger ms-1">*</span>}
        </Form.Label>
      )}

      <InputGroup className="flex-nowrap w-100 flex-md-nowrap flex-wrap">
        {IconComponent && (
          <InputGroup.Text
            className={`bg-white border-end-0 ${
              showError
                ? "border-danger text-danger"
                : showSuccess
                ? "border-success text-success"
                : ""
            }`}
            style={{
              borderColor:
                showError
                  ? "#dc3545"
                  : showSuccess
                  ? "#198754"
                  : "#ced4da",
              transition: "all 0.3s ease",
            }}
          >
            <IconComponent
              size={18}
              color={
                showError
                  ? "#dc3545"
                  : showSuccess
                  ? "#198754"
                  : "#2466BF"
              }
            />
          </InputGroup.Text>
        )}

        <Form.Control
          ref={inputRef}
          type={inputType}
          name={name}
          placeholder={placeholder}
          {...register}
          disabled={disabled}
          onChange={(e:any) => {
            handleChange(e);
            if (register?.onChange) {
              register.onChange(e);
            }
          }}
          maxLength={maxlength}
          readOnly={readOnly}
          onKeyDown={onKeyDown}
          min={0}
          className={inputClasses}
          aria-label={label}
          onBlur={(e) => {
            setTouched(true);
            setIsTyping(false);
            if (register?.onBlur) {
              register.onBlur(e);
            }
          }}
          style={{
            ...style,
            borderColor:
              showError
                ? "#dc3545"
                : showSuccess
                ? "#198754"
                : "#ced4da",
            backgroundColor:
              showError
                ? "#fff8f8"
                : showSuccess
                ? "#f8fff9"
                : "white",
            transition: "all 0.3s ease",
          }}
          autoFocus={autoFocus}
        />

        {isPassword && (
          <OverlayTrigger
            placement="top"
            overlay={
              <Tooltip id={`tooltip-${name}`}>
                {showPassword ? "Hide password" : "Show password"}
              </Tooltip>
            }
          >
            <InputGroup.Text
              className={`bg-white border-start-0 ${
                showError
                  ? "border-danger text-danger"
                  : showSuccess
                  ? "border-success text-success"
                  : ""
              }`}
              role="button"
              onClick={togglePasswordVisibility}
              aria-label="Toggle password visibility"
              style={{
                cursor: "pointer",
                borderColor:
                  showError
                    ? "#dc3545"
                    : showSuccess
                    ? "#198754"
                    : "#ced4da",
                transition: "all 0.3s ease",
              }}
            >
              {showPassword ? (
                <FaEyeSlash
                  size={18}
                  color={
                    showError
                      ? "#dc3545"
                      : showSuccess
                      ? "#198754"
                      : "#387AD4"
                  }
                />
              ) : (
                <FaEye
                  size={18}
                  color={
                    showError
                      ? "#dc3545"
                      : showSuccess
                      ? "#198754"
                      : "#387AD4"
                  }
                />
              )}
            </InputGroup.Text>
          </OverlayTrigger>
        )}
      </InputGroup>

      {description && (
        <Form.Text style={{ color: "#5A67D8" }} className="d-block mt-1">
          {description}
        </Form.Text>
      )}

      {showError && (
        <Form.Text className="text-danger d-block">
          {errorMessage }
          {/* {errorMessage || `${label} is required`} */}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputText;
import React, { useState, useEffect, useRef } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaCheckCircle } from "react-icons/fa";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
  defaultValue?: string | File;
  autoFocus?: boolean;
  clearErrors?: (fieldName: string) => void;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  watch,
  defaultValue,
  clearErrors
}) => {
  const hasError = errors && errors[name];
  const fileInputRef = useRef(null);
  const [fileSelected, setFileSelected] = useState(false);
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  const currentFile = watch ? watch(name) : null;

  useEffect(() => {
    if (currentFile && fileSelected) {
      clearErrors(name);
    }
  }, [currentFile, fileSelected, name, clearErrors]);

  const handleFileChange = (e) => {
    if (e.target.files && e.target.files[0]) {
      setFileSelected(true);
      if (onChange) {
        onChange(e);
      }
    }
  };

  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold text-dark mb-2" style={{ fontSize: '0.9rem' }}>
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      <div
        className={`file-upload border rounded p-2 ${hasError ? 'border-danger' : currentFile ? 'border-success' : ''}`}
        style={{
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderRadius: '8px',
          transition: 'all 0.3s ease'
        }}
      >
        <div className="d-flex align-items-center">
          <label
            htmlFor={name}
            className={`file-label btn ${hasError ? 'btn-outline-danger' : 'btn-primary'} mb-0 d-inline-flex align-items-center`}
            style={{
              borderRadius: '6px',
              padding: '6px 12px',
              cursor: disabled ? 'not-allowed' : 'pointer',
              opacity: disabled ? 0.6 : 1,
              minWidth: '100px',
              fontSize: '0.8rem',
              color: hasError ? '#dc3545' : '#fff',
            }}
          >
            <FaUpload className="file-icon me-1" size={12} style={{ color: hasError ? '#dc3545' : '#fff' }} />
            <span className="file-text" style={{ color: hasError ? '#dc3545' : '#fff' }}>Choose File</span>
          </label>
          <div
            className={`file-name-container ms-2 flex-grow-1 border rounded px-2 py-1 ${currentFile ? 'bg-light-success' : 'bg-light'} d-flex align-items-center ${hasError ? 'border-danger' : currentFile ? 'border-success' : ''}`}
            style={{
              overflow: 'hidden',
              minHeight: '32px'
            }}
          >
            {currentFile ? (
              <div className="d-flex align-items-center w-100">
                <FaCheckCircle className="text-success me-2 flex-shrink-0" size={12} />
                <span className="file-icon-preview me-2 flex-shrink-0">
                  {currentFile.name && currentFile.name.endsWith('.pdf') ? (
                    <FaFilePdf color="#dc3545" size={14} />
                  ) : (
                    <FaFileImage color="#28a745" size={14} />
                  )}
                </span>
                <span 
                  className="text-dark fw-medium" 
                  style={{ 
                    overflow: 'hidden', 
                    textOverflow: 'ellipsis', 
                    whiteSpace: 'nowrap',
                    fontSize: '0.8rem'
                  }}
                  title={currentFile.name}
                >
                  {currentFile.name}
                </span>
              </div>
            ) : (
              <span className="text-muted" style={{ fontSize: '0.8rem' }}>No file chosen</span>
            )}
          </div>
        </div>
        <input
          ref={fileInputRef}
          type="file"
          id={name}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="d-none"
        />
      </div>
      {hasError ? (
        <Form.Text className="text-danger small mt-1 d-block" style={{ fontSize: '0.75rem' }}>
         
{t(errors[name]?.message)}

        </Form.Text>
      ) : (
        <Form.Text className="text-muted small mt-1" style={{ fontSize: '0.75rem' }}>
          {t("Upload PDF, JPG or PNG file (Max size: 10MB)")}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
import React from "react";
import Select from "react-select";
import { Form } from "react-bootstrap";
import styles from "./styles/InputSelect.module.css"; 

interface InputSelectProps {
  label: string;
  required?: boolean;
  name: string;
  options: Array<{ value: string | number; label: string }>;
  register?: any;
  errors?: any;
  disabled?: boolean;
  onChange?: (value: string | number, selObj?: any) => void;
  className?: string;
  style?: React.CSSProperties;
  icon?: React.ElementType;
  value?: any;
  isMulti?: boolean;
  isClearable?: boolean;
  placeholder?: string;
}

const InputSelect: React.FC<InputSelectProps> = ({
  label,
  required,
  name,
  options,
  register,
  errors = {},
  disabled,
  onChange,
  className = "",
  style = {},
  icon: IconComponent,
  value,
  isMulti = false,
  isClearable = false,
  placeholder = "-- Select --",
}) => {
  // const fieldKey = name.includes(".") ? name.split(".").pop() : name;
  // const errorMessage = hasError?.message;

  const errorMessage = name?.split('.')?.reduce((acc, key) => acc?.[key], errors)?.message || "";
  const hasError = errorMessage ? true : false;

  const selectedOption = options?.find((opt) => String(opt.value) === String(value)) || null;

  const handleChange = (selected: any) => {
    onChange?.(selected ? selected.value : "", selected);
  };

  const menuPortalStyles = {
    menuPortal: (base: any) => ({ ...base, zIndex: 9999, fontSize : '14px' }),
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold d-block">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>

      <div className="position-relative">
        {IconComponent && (
          <div
            className={
              hasError 
                ? styles.inputIconError 
                : value 
                  ? styles.inputIconSuccess 
                  : styles.inputIconPrimary
            }
          >
            <IconComponent size={18} />
          </div>
        )}

        <Select
          options={options}
          value={selectedOption}
          onChange={handleChange}
          isDisabled={disabled}
          isMulti={isMulti}
          placeholder={placeholder}
          isClearable={isClearable}
          className={`react-select-container ${hasError ? "is-invalid" : ""}`}
          classNamePrefix="react-select"
          menuPosition="fixed" 
          menuPlacement="auto" 
          menuShouldScrollIntoView={true}
          menuPortalTarget={typeof document !== "undefined" ? document.body : undefined} 
          styles={{
            control: (base, state) => ({
              ...base,
              borderColor: hasError
                ? "#dc3545"
                : state.isFocused
                ? "#80bdff"
                : "#ced4da",
              boxShadow:
                state.isFocused && !hasError
                  ? "0 0 0 0.2rem rgba(0, 123, 255, 0.25)"
                  : "none",
              paddingLeft: IconComponent ? "40px" : "12px",
              backgroundColor: hasError ? "#fff8f8" : "white",
              minHeight: "calc(1.5em + 1rem + 2px)",
              "&:hover": {
                borderColor: hasError ? "#dc3545" : "#ced4da",
              },
              fontSize : '14px'
            }),
            menu: (base) => ({
              ...base,
              zIndex: 9999,
              position: "absolute",
            }),
            menuPortal: (base) => ({ ...base, zIndex: 9999 }), 
            ...menuPortalStyles,
          }}
        />
      </div>

      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errorMessage}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;
import React, { useState, useEffect, useRef } from "react";
import { useForm, FormProvider } from "react-hook-form";
import { Container, Row, Col, Button, Card, Image } from "react-bootstrap";
import {
  FaBuilding,
  FaFileUpload,
  FaCheck,
  FaArrowRight,
  FaArrowLeft,
} from "react-icons/fa";
import "./UserRegistration.css";
import i18n from "i18next";
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";
import { toast } from "react-toastify";
import NewLoader from "../../common/NewLoader.js";
import { getData, postFORMdata } from "../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../utils/urlsConstants.ts";
import { handleErrorMessage } from "../../../utils/errorMessageHandler.js";
import {
  createOwnerOrBuilderPayload,
  mapToVesselUserDetails,
} from "../model/mapToVesselModel.ts";
import ApprovalModal from "../../common/ApprovalModal.js";
import ActionDropdown from "../../common/ActionDropdown.js";
import DynamicFormFields from "../../common/DynamicFormFields";
import createFormFieldsConfig from "../../common/FormFieldsConfig";
import { NavDropdown } from "react-bootstrap";
import { MdOutlineLanguage } from "react-icons/md";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../common/LanguageContext.js";
const VesselBuilderRegistrationPage = () => {
  const { i18n,t } = useTranslation(); // Language translation hook
  const isCompMount = useRef(true);
  const { changeLanguage } = useLanguageContext();
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [successMessage, setSuccessMessage] = useState("");
  const [validationMessage, setValidationMessage] = useState("");
  const loaderRef = useRef();
  const PUBLIC_URL = process.env.REACT_APP_PUBLIC_URL;
  const actionsFromAPI = ["Accept", "Reject", "Send Back"];
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      ...formData,
    };
    console.log("Submitted Data:", payload);
    setShowApprovalModal(false);
    setSelectedAction("");
    // we need to API call here
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const methods = useForm({
    mode: "onBlur",
    defaultValues: { country: "India" },
  });

  const {
    handleSubmit,
    formState: { errors },
    trigger,
    setValue,
    getValues,
    watch,
    setError,
    clearErrors,
  } = methods;
  const totalSteps = 2;

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [i18n.language]);

  useEffect(() => {
    setTimeout(() => {
      // console.log("Current Step:", currentStep);
      // console.log("current form data:", formData);
      Object.keys(formData).forEach((key) => {
        if (formData[key]) {
          // console.log("Setting value for", key, formData[key]);
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [currentStep, setValue, formData]);

  const getDetailsByPIN = async (pinCode) => {
    try {
      const URL =
        PUBLIC_URL +
        URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE +
        pinCode;
      loaderRef.current?.show();
      const response = await getData(URL);

      if (response?.status === 200 && response?.data?.length > 0) {
        const [firstItem] = response.data;
        setValue("district", firstItem?.district || "");
        setValue("state", firstItem?.stateName || "");
        loaderRef?.current?.hide();
      } else {
        loaderRef?.current?.hide();

        toast.info("No Data Found! Please enter manually..", {
          position: "top-right",
        });
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const formFields = createFormFieldsConfig(getDetailsByPIN);

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1:
        return formFields.step1;
      case 2:
        return formFields.step2;
      default:
        return [];
    }
  };

  const validateStep = async () => {
    const currentFields = getCurrentStepFields();
    const currentValues = getValues();

    const isValid = await trigger(currentFields.map((field) => field.name));

    const fileFields = currentFields.filter(
      (field) => field.type === "file" && field.required
    );
    let fileErrorsExist = false;

    for (const field of fileFields) {
      const file = currentValues[field.name];

      if (!file) {
        setError(field.name, {
          type: "required",
          message: `${field.label} is required`,
        });
        fileErrorsExist = true;
        continue;
      }

      if (file instanceof File) {
        const validTypes = [
          "application/pdf",
          "image/jpeg",
          "image/png",
          "image/jpg",
        ];
        if (!validTypes.includes(file.type)) {
          setError(field.name, {
            type: "fileType",
            message: "Only PDF, JPG or PNG files are allowed",
          });
          fileErrorsExist = true;
          continue;
        }

        if (file.size > 5 * 1024 * 1024) {
          setError(field.name, {
            type: "fileSize",
            message: "File size should not exceed 5MB",
          });
          fileErrorsExist = true;
          continue;
        }
      }

      if (errors[field.name]) {
        clearErrors(field.name);
      }
    }

    return isValid && !fileErrorsExist;
  };

  const handleNext = async () => {
    const isStepValid = await validateStep();

    if (isStepValid) {
      setValidationMessage("");
      const currentValues = getValues();
      const fileFields = getCurrentStepFields().filter(
        (field) => field.type === "file"
      );

      fileFields.forEach((field) => {
        if (currentValues[field.name]) {
          setFormData((prev) => ({
            ...prev,
            [field.name]: currentValues[field.name],
          }));
        }
      });

      setFormData((prev) => ({ ...prev, ...currentValues }));

      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    } else {
      const firstError = Object.keys(errors)[0];
      if (firstError) {
        const element = document.getElementsByName(firstError)[0];
        if (element) {
          element.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      }
    }
  };

  const handlePrevious = () => {
    const currentValues = getValues();
    const fileFields = getCurrentStepFields().filter(
      (field) => field.type === "file"
    );
    fileFields.forEach((field) => {
      if (currentValues[field.name]) {
        setFormData((prev) => ({
          ...prev,
          [field.name]: currentValues[field.name],
        }));
      }
    });

    setFormData((prev) => ({ ...prev, ...currentValues }));
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
    setValidationMessage("");
  };

  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };
    const payload = createOwnerOrBuilderPayload("VESSEL_BUILDER", {
      ...finalData,
    });
    const filesToUpload = [
      finalData?.companyDetails,
      finalData?.gstCertificate,
      finalData?.panCardUpload,
      finalData?.factoryLicense,
      finalData?.addressProof,
      finalData?.fireCertificate,
      finalData?.esipfRegistration,
      finalData?.iso9001,
      finalData?.iso14001,
      finalData?.iso45001,
      finalData?.pollutionCertificate,
      finalData?.experienceCertificate,
    ].filter((file) => file);

    const fd = new FormData();
    fd.append(
      "request",
      new Blob([JSON.stringify(payload)], { type: "application/json" })
    );
    filesToUpload?.forEach((file) => {
      if (file) {
        fd.append(`files`, file);
      }
    });
    submitUserDetails(fd);
  };

  const submitUserDetails = async (payload) => {
    try {
      const URL =
        process.env.REACT_APP_AUTH_URL +
        URLS_ENDPOINT.USER_SERVICE.CREATE_UPDATE_USER;
      loaderRef.current?.show();
      const response = await postFORMdata(URL, payload);
      const apiRes = { ...response?.data };
      if (
        response?.status === 200 &&
        apiRes?.responseStatus?.status === "200"
      ) {
        loaderRef?.current?.hide();
        setIsSubmitted(true);
        setSuccessMessage(apiRes?.responseStatus?.message);
        window.scrollTo(0, 0);
      } else {
        loaderRef?.current?.hide();
        toast.info(
          apiRes?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err, "builder-error");
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const stepTitles = [
    {
      title: t("builderRegistration.Vessel Builder Details"),
      icon: FaBuilding,
    },
    { title: t("builderRegistration.Documents Upload"), icon: FaFileUpload },
  ];

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="registration-container py-5">
        <div
          style={{
            position: "absolute",
            top: "10px",
            right: "10px",
            zIndex: 1050,
          }}
        >
          <NavDropdown
            title={
              <MdOutlineLanguage
                style={{ fontSize: "1.5rem", color: "#fff" }}
              />
            }
            id="language-nav-dropdown"
            className="mx-2"
            style={{
              display: "inline-block",
              marginTop: "10px",
              zIndex: 1050,
              position: "relative",
            }}
          >
            <NavDropdown.Item
              onClick={() => changeLanguage("en")}
              className="small-text"
              style={{
                color: "#000000",
                padding: "10px 15px",
              }}
            >
              English
            </NavDropdown.Item>
            <NavDropdown.Item
              onClick={() => changeLanguage("bn")}
              className="small-text"
              style={{
                color: "#000000",
                padding: "10px 15px",
              }}
            >
              বাংলা
            </NavDropdown.Item>
          </NavDropdown>
        </div>
        <Row className="justify-content-center">
          <Col md={10} xl={9}>
            <Card className="registration-card">
              <Card.Header className="registration-header p-0">
                <div className="registration-header-content">
                  <div className="header-logo-container">
                    <Image
                      src={IWT_FULL_IMG}
                      alt="IWT Logo"
                      className="header-logo"
                    />
                  </div>
                  <h3 className="header-title">
                    {t("builderRegistration.Vessel Builder Registration")}
                  </h3>
                </div>
              </Card.Header>

              <Card.Body className="registration-body p-4 p-md-5">
                {isSubmitted ? (
                  <div className="success-container text-center py-5">
                    <div
                      className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4"
                      style={{
                        width: "90px",
                        height: "90px",
                        boxShadow: "0 10px 20px rgba(40, 167, 69, 0.3)",
                      }}
                    >
                      <FaCheck className="success-icon text-white fs-1" />
                    </div>
                    <h4 className="success-title text-success mb-3 fw-bold">
                      Registration Successful!
                    </h4>
                    <div
                      className="registration-id p-4 bg-light rounded mb-4"
                      style={{ borderLeft: "4px solid #0077b6" }}
                    >
                      {successMessage ||
                        "Your vessel builder registration has been submitted successfully. You will receive a confirmation email shortly."}
                    </div>
                    <Button
                      variant="primary"
                      size="lg"
                      className="mt-2 d-flex align-items-center justify-content-center mx-auto"
                      style={{
                        background: "linear-gradient(135deg, #0077b6, #023e8a)",
                        border: "none",
                        boxShadow: "0 4px 15px rgba(0, 119, 182, 0.3)",
                        borderRadius: "8px",
                        padding: "12px 30px",
                        fontWeight: "600",
                        transition: "all 0.3s ease",
                        minWidth: "150px",
                        height: "50px",
                      }}
                      onClick={() => (window.location.href = "/")}
                    >
                      Go to Home
                    </Button>
                  </div>
                ) : (
                  <FormProvider {...methods}>
                    <form>
                      <div className="text-center mb-4">
                        <p className="text-muted">
                          {t(
                            "builderRegistration.Please complete all required information to register as a vessel builder"
                          )}
                        </p>
                      </div>

                      <div className="stepper-container mb-5">
                        <div className="stepper d-flex justify-content-between">
                          {[1, 2].map((step) => (
                            <React.Fragment key={step}>
                              <div
                                className={`step ${
                                  currentStep >= step ? "active" : ""
                                } ${
                                  currentStep > step ? "completed" : ""
                                } flex-grow-1 text-center`}
                              >
                                <div
                                  className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2"
                                  style={{
                                    width: "60px",
                                    height: "60px",
                                    borderRadius: "50%",
                                    fontSize: "20px",
                                    fontWeight: "bold",
                                    boxShadow:
                                      currentStep >= step
                                        ? "0 5px 15px rgba(0, 119, 182, 0.3)"
                                        : "0 4px 10px rgba(0, 0, 0, 0.1)",
                                    background:
                                      currentStep >= step
                                        ? currentStep > step
                                          ? "linear-gradient(135deg, #28a745, #20c997)"
                                          : "linear-gradient(135deg, #0077b6, #023e8a)"
                                        : "#ffffff",
                                    border:
                                      currentStep >= step
                                        ? "none"
                                        : "2px solid #e9ecef",
                                    color:
                                      currentStep >= step ? "#fff" : "#6c757d",
                                    transition: "all 0.4s ease",
                                  }}
                                >
                                  {currentStep > step ? (
                                    <FaCheck size={22} />
                                  ) : (
                                    React.createElement(
                                      stepTitles[step - 1].icon,
                                      { size: 18 }
                                    )
                                  )}
                                </div>
                                <div
                                  className="step-label fw-bold"
                                  style={{
                                    color:
                                      currentStep >= step
                                        ? currentStep > step
                                          ? "#28a745"
                                          : "#0077b6"
                                        : "#6c757d",
                                    fontSize: "0.9em",
                                    transition: "all 0.3s ease",
                                  }}
                                >
                                  {stepTitles[step - 1].title}
                                </div>
                              </div>
                              {step < 2 && (
                                <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                                  <div
                                    className={`connector-line w-100 ${
                                      currentStep > step ? "active" : ""
                                    }`}
                                    style={{
                                      height: "4px",
                                      background:
                                        currentStep > step
                                          ? "linear-gradient(to right, #28a745, #20c997)"
                                          : "#e9ecef",
                                      borderRadius: "2px",
                                      transition: "all 0.5s ease",
                                    }}
                                  ></div>
                                </div>
                              )}
                            </React.Fragment>
                          ))}
                        </div>
                      </div>

                      <div className="step-content">
                        <div className="form-section p-4 rounded mb-4">
                          <div className="form-content">
                            <DynamicFormFields
                              fields={getCurrentStepFields()}
                              setFormData={setFormData}
                              errors={errors}
                              clearErrors={clearErrors}
                            />
                          </div>
                        </div>
                      </div>

                      <div
                        className="form-navigation mt-4"
                        style={{ display: "block" }}
                      >
                        {currentStep > 1 && (
                          <Button
                            variant="outline-secondary"
                            onClick={handlePrevious}
                            // hidden={currentStep === 1}
                            className="prev-btn"
                            style={{ float: "left" }}
                          >
                            <FaArrowLeft className="btn-icon me-2" />{" "}
                            {t("Previous")}
                          </Button>
                        )}

                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="next-btn"
                          style={{ float: "right" }}
                        >
                          {currentStep === totalSteps
                            ? t("Submit Registration")
                            : t("Next")}
                          {currentStep !== totalSteps && (
                            <FaArrowRight className="btn-icon ms-2" />
                          )}
                        </Button>
                        {/* <div style={{ 'float': 'right' }} className="d-flex flex-column align-items-center">
                          <ActionDropdown actions={actionsFromAPI} onActionClick={handleActionClick} />
                          <ApprovalModal
                            show={showApprovalModal}
                            handleClose={handleCloseModal}
                            handleSubmitData={handleActionSubmit}
                            selectedAction={selectedAction}
                          />
                        </div> */}
                      </div>
                    </form>
                  </FormProvider>
                )}
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Container>
    </>
  );
};

export default VesselBuilderRegistrationPage;
import React from "react";
import { Row, Col } from "react-bootstrap";
import { useFormContext } from "react-hook-form";
import InputText from "./InputText.tsx";
import InputFile from "./InputFile.tsx";
import { renameFile } from "../../utils/constants.ts";
import InputSelect from "./InputSelect.tsx";

const DynamicFormFields = ({ fields, setFormData, errors, clearErrors }) => {
  const { register, setValue, watch } = useFormContext();

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case "file":
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(
                  file?.name?.lastIndexOf(".")
                );
                const fileName = `${field.label}${extension}`;
                file.originalName = fileName;
                const renamedFile = renameFile(file, fileName);

                clearErrors(field.name);

                setValue(field.name, renamedFile, { shouldValidate: true });
                setFormData((prev) => {
                  const updated = { ...prev, [field.name]: renamedFile };
                  return updated;
                });
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={watch(field.name)}
            clearErrors={clearErrors}
          />
        );

      case "select":
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register(field?.name, {
              ...field.validation,
            })}
            errors={errors}
            icon={field.icon}
            className="mb-4"
            onChange={(value, selObj) => {
              setValue(field.name, value);
              if (errors[field.name]) {
                clearErrors(field.name);
              }
              setFormData((prev) => ({
                ...prev,
                [field.name]: value,
              }));
            }}
            autoFocus={field.autoFocus}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...field.validation,
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className="mb-4"
          />
        );
    }
  };

  return (
    <Row className="g-3">
      {fields.map((field, index) => (
        <Col key={index} md={field.colSize || 12}>
          {renderField(field)}
        </Col>
      ))}
    </Row>
  );
};

export default DynamicFormFields;
import React from "react";
import {
  FaUser,
  FaIdCard,
  FaEnvelope,
  FaPhone,
  FaMapMarkerAlt,
  FaDownload,
} from "react-icons/fa";
import { CONSTANT_REGEX } from "../../utils/constants.ts";
import { useTranslation } from "react-i18next";

const useCreateFormFieldsConfig = (getDetailsByPIN) => {
  const { t } = useTranslation();
  return {
    step1: [
      {
        name: "builderName",
        label: t("builderRegistration.builderName"),
        type: "text",
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 80,
        placeholder: t("builderRegistration.builderName_phl"),
        validation: { required: t("builderRegistration.builderName_req") },
      },
      // {
      //   name: "lastName",
      //   label: t("builderRegistration.Last Name"),
      //   type: "text",
      //   required: true,
      //   icon: FaUser,
      //   colSize: 6,
      //   maxlength: 80,
      //   placeholder: t("builderRegistration.Enter Builder's Last name"),
      //   validation: { required: t("builderRegistration.Last name is required") },
      // },
      {
        name: "emailId",
        label: t("builderRegistration.Email ID"),
        type: "email",
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        maxlength: 100,
        placeholder: t("builderRegistration.Enter email address"),
        validation: {
          required: t("builderRegistration.Email is required"),
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: t("builderRegistration.Invalid email address"),
          },
        },
      },
      {
        name: "phoneNumber",
        label: t("builderRegistration.Phone Number"),
        type: "text",
        required: true,
        icon: FaPhone,
        colSize: 6,
        maxlength: 10,
        placeholder: t("builderRegistration.Enter 10-digit phone number"),
        validation: {
          required: t("builderRegistration.Phone number is required (10 digits)"),
          pattern: {
            value: CONSTANT_REGEX.MOBILE,
            message: t("builderRegistration.Please enter a valid Phone number"),
          },
        },
      },
      {
        name: "panNo",
        label: t("builderRegistration.PAN Number"),
        type: "text",
        required: true,
        icon: FaIdCard,
        colSize: 6,
        maxlength: 10,
        placeholder: t("builderRegistration.Enter PAN number (e.g., ABCDE1234F)"),
        validation: {
          required: t("builderRegistration.PAN number is required"),
          pattern: {
            value: CONSTANT_REGEX.PAN,
            message: t("builderRegistration.Invalid PAN number"),
          },
        },
      },
      {
        name: "gstNo",
        label: t("builderRegistration.GST Number"),
        type: "text",
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: t("builderRegistration.Enter GST number"),
        maxlength: 15,
        validation: {
          required: t("builderRegistration.GST number is required"),
          pattern: {
            value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
            message: t("builderRegistration.Invalid GST No."),
          },
        },
      },
      {
        name: "addressLine1",
        label: t("builderRegistration.Address Line-1"),
        type: "text",
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 100,
        placeholder: t("builderRegistration.Enter address line 1"),
        validation: { required: t("builderRegistration.Address is required") },
      },
      {
        name: "addressLine2",
        label: t("builderRegistration.Address Line-2"),
        type: "text",
        required: false,
        maxlength: 100,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: t("builderRegistration.Enter address line 2 (optional)"),
      },
      {
        name: "pin",
        label: t("builderRegistration.PIN"),
        type: "text",
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 6,
        placeholder: t("builderRegistration.Enter 6-digit PIN code"),
        validation: {
          required: t("builderRegistration.PIN code is required"),
          pattern: {
            value: /^[0-9]{6}$/,
            message: t("builderRegistration.PIN must be 6 digits"),
          },
        },
        onChange: (e, setValue, watch) => {
          const changedValue = e?.target?.value || "";
          if (changedValue?.length === 6) {
            setValue("district", "");
            setValue("state", "");
            setValue("country", "India");
            getDetailsByPIN(changedValue);
          }
        },
      },
      {
        name: "district",
        label: t("builderRegistration.District"),
        type: "text",
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: t("builderRegistration.Please enter district"),
      },
      {
        name: "state",
        label: t("builderRegistration.State / UT"),
        type: "text",
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: t("builderRegistration.Please enter state"),
      },
      {
        name: "country",
        label: t("builderRegistration.Country"),
        type: "text",
        required: false,
        disabled: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: t("builderRegistration.Please enter country"),
      },
    ],
    // step2: [
    //   {
    //     name: 'addressProof',
    //     label: 'Address Proof',
    //     type: 'file',
    //     required: false,
    //     colSize: 6,
    //   },
    //   {
    //     name: 'panCardUpload',
    //     label: 'PAN Card',
    //     type: 'file',
    //     required: false,
    //     colSize: 6,
    //   },
    //   {
    //     name: 'gstCertificate',
    //     label: 'GST Certificate',
    //     type: 'file',
    //     required: false,
    //     colSize: 6,
    //   }
    // ]

    step2: [
      {
        name: "companyDetails",
        label: t("builderRegistration.Company Details"),
        type: "file",
        required: true,
        colSize: 6,
        disabled: true,
        displayOnly: true,
        accept: ".pdf,.jpg,.jpeg,.png",
        validation: {
          required: t("builderRegistration.Company details document is required"),
        },
      },
      {
        name: "gstCertificate",
        label: t("builderRegistration.GST Certificate"),
        type: "file",
        required: true,
        colSize: 6,
        disabled: true,
        displayOnly: true,
        accept: ".pdf,.jpg,.jpeg,.png",
        validation: {
          required: t("builderRegistration.GST certificate is required"),
        },
      },
      {
        name: "panCardUpload",
        label: t("builderRegistration.PAN Card"),
        type: "file",
        required: true,
        colSize: 6,
        disabled: true,
        displayOnly: true,
        accept: ".pdf,.jpg,.jpeg,.png",
        validation: {
          required: t("builderRegistration.PAN card is required"),
        },
      },
      {
        name: "factoryLicense",
        label: t("builderRegistration.Factory License"),
        type: "file",
        required: false,
        colSize: 6,
        disabled: true,
        displayOnly: true,
        accept: ".pdf,.jpg,.jpeg,.png",
      },
      {
        name: "addressProof",
        label: t("builderRegistration.Address Proof"),
        type: "file",
        required: false,
        colSize: 6,
        disabled: true,
        displayOnly: true,
      },
      {
        name: "fireCertificate",
        label: t("builderRegistration.Fire Certificate"),
        type: "file",
        required: false,
        colSize: 6,
        disabled: true,
        displayOnly: true,
        accept: ".pdf,.jpg,.jpeg,.png",
      },
      {
        name: "esipfRegistration",
        label: t("builderRegistration.ESIPF Registration"),
        type: "file",
        required: false,
        colSize: 6,
        disabled: true,
        displayOnly: true,
        accept: ".pdf,.jpg,.jpeg,.png",
      },
      {
        name: "iso9001",
        label: t("builderRegistration.ISO 9001 Certificate"),
        type: "file",
        required: false,
        colSize: 6,
        disabled: true,
        displayOnly: true,
        accept: ".pdf,.jpg,.jpeg,.png",
      },
      {
        name: "iso14001",
        label: t("builderRegistration.ISO 14001 Certificate"),
        type: "file",
        required: false,
        colSize: 6,
        disabled: true,
        displayOnly: true,
        accept: ".pdf,.jpg,.jpeg,.png",
      },
      {
        name: "iso45001",
        label: t("builderRegistration.ISO 45001 Certificate"),
        type: "file",
        required: false,
        colSize: 6,
        disabled: true,
        displayOnly: true,
        accept: ".pdf,.jpg,.jpeg,.png",
      },
      {
        name: "pollutionCertificate",
        label: t("builderRegistration.Pollution Certificate"),
        type: "file",
        required: false,
        colSize: 6,
        disabled: true,
        displayOnly: true,
        accept: ".pdf,.jpg,.jpeg,.png",
      },
      {
        name: "experienceCertificate",
        label: t("builderRegistration.Experience Certificate"),
        type: "file",
        required: false,
        colSize: 6,
        disabled: true,
        displayOnly: true,
        accept: ".pdf,.jpg,.jpeg,.png",
      },
    ],
  };
};

export default useCreateFormFieldsConfig;

import React, { useState, useEffect, useRef } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Button, Card, Badge, Stack } from 'react-bootstrap';
import { FaFileAlt, FaFileUpload, FaArrowLeft, FaArrowRight, FaDownload, FaList, FaRegArrowAltCircleLeft, FaArrowAltCircleLeft } from 'react-icons/fa';
import createFormFieldsConfig from '../../../common/FormFieldsConfig';
import { useNavigate } from 'react-router-dom';
import ActionDropdown from '../../../common/ActionDropdown';
import ApprovalModal from '../../../common/ApprovalModal';
import './userViewPage.css';
import NewLoader from '../../../common/NewLoader';
import DynamicViewFields from '../../../common/DynamicViewFields';

const UserViewPage = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(true);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const navigate = useNavigate();
  const totalSteps = 2;
  const actionsFromAPI = ["Approve", "Reject", "Request Changes"];
  const loaderRef = useRef();

  const applicationNumber = "APP-2025-001";

  const mockApplicationData = {
    firstName: "John",
    lastName: "Doe",
    emailId: "john.doe@example.com",
    phoneNumber: "9876543210",
    panNumber: "ABCDE1234F",
    gstNumber: "22ABCDE1234F1Z5",
    addressLine1: "123 Main Street",
    addressLine2: "Building A",
    pin: "700001",
    district: "Kolkata",
    stateUt: "West Bengal",
    country: "India",
    addressProof: "address_proof.pdf",
    panCardUpload: "pan_card.pdf",
    gstCertificate: "gst_certificate.pdf",
    status: "Pending Review"
  };

  useEffect(() => {
    setIsLoading(true);
    loaderRef.current?.show?.();
    setTimeout(() => {
      setFormData(mockApplicationData);
      setIsLoading(false);
      loaderRef.current?.hide?.();
    }, 500);
  }, []);

  const methods = useForm({ defaultValues: { country: 'India' } });
  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading) {
      Object.keys(formData).forEach(key => {
        if (formData[key]) {
          setValue(key, formData[key]);
        }
      });
    }
  }, [isLoading, formData, setValue]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      ...formData,
    };
    console.log("Action submitted:", payload);
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };


  const handleDownload = (filename) => {

    const blob = new Blob(["Dummy file content"], { type: "text/plain" });
    const link = document.createElement("a");
    link.href = window.URL.createObjectURL(blob);
    link.download = filename;
    link.click();
    window.URL.revokeObjectURL(link.href);
  };


  const renderFileField = (value) => (
    <div className="file-display d-flex align-items-center justify-content-between">
      <span className="file-name">{value || 'No file uploaded'}</span>
      {value && (
        <Button
          variant="link"
          size="sm"
          className="file-download-btn"
          onClick={() => handleDownload(value)}
          tabIndex={-1}
        >
          <FaDownload style={{ fontSize: 18 }} />
        </Button>
      )}
    </div>
  );

  const getDisabledFormFieldsConfig = () => {
    const originalConfig = createFormFieldsConfig(() => { });
    const disabledStep1 = originalConfig.step1.map(field => ({
      ...field,
      disabled: true,
      inputClassName: 'disabled-field'
    }));
    const disabledStep2 = originalConfig.step2.map(field => ({
      ...field,
      disabled: true,
      render: renderFileField
    }));
    return {
      step1: disabledStep1,
      step2: disabledStep2
    };
  };

  const formFields = getDisabledFormFieldsConfig();

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      default: return [];
    }
  };

  const handleNext = () => {
    if (currentStep < totalSteps) {
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const handleBackToList = () => {
    navigate('/user-registration/view');
  };

  const getStatusBadge = (status) => {
    const statusMap = {
      'Pending Review': 'warning',
      'Approved': 'success',
      'Rejected': 'danger',
      'Processing': 'info'
    };
    return <Badge bg={statusMap[status] || 'secondary'} className="status-badge" text='white' >{status}</Badge>;
  };

  if (isLoading) {
    return <NewLoader ref={loaderRef} />;
  }

  return (
    <>
      <Container fluid className="py-4 officer-view-container">
        <Row className="justify-content-center">
          <Col size={12}>
            <Card className="shadow-sm border-0">
              <Card.Header className="bg-white border-bottom-0 py-4">
                <Stack direction="horizontal" gap={3} className="flex-wrap justify-content-between align-items-center">
                  <button
                    className="btn back-button"
                    onClick={handleBackToList}
                    style={{
                      fontSize: "0.9rem",
                      left: 0,
                      transform: "translateY(-50%)",
                      textDecoration: "none",
                    }}
                  >
                    <FaArrowAltCircleLeft size={22} color='primary' />
                  </button>

                  <div className="flex-grow-1 d-flex flex-column align-items-center">
                    {/* <h3 className="mb-2 fw-bold app-header-title">Application Review</h3> */}
                    <div className="d-flex flex-wrap align-items-center justify-content-center gap-2">
                      <span className="application-label fw-semibold text-muted">Application Number:</span>
                      <span className="application-number px-3 py-1 rounded-pill fw-semibold">
                        {applicationNumber}
                      </span>
                    </div>
                  </div>
                  <div style={{ width: 160 }} >
                    <span className="ms-2">{getStatusBadge(formData.status)}</span>

                  </div>
                </Stack>
              </Card.Header>

              <Card.Body className="p-4">
                {/* Stepper */}
                <div className="stepper-wrapper mb-5">
                  <div className={`stepper-item ${currentStep === 1 ? 'active' : ''} ${currentStep > 1 ? 'completed' : ''}`}>
                    <div className="step-counter">
                      {currentStep > 1 ? <FaFileAlt className="text-success" /> : '1'}
                    </div>
                    <div className="step-name">Basic Details</div>
                  </div>
                  <div className={`stepper-item ${currentStep === 2 ? 'active' : ''} ${currentStep > 2 ? 'completed' : ''}`}>
                    <div className="step-counter">
                      {currentStep > 2 ? <FaFileUpload className="text-success" /> : '2'}
                    </div>
                    <div className="step-name">Documents</div>
                  </div>
                </div>

                <FormProvider {...methods}>
                  <form>
                    <div className="form-content px-3">
                      <Row className="g-3">
                        <DynamicViewFields
                          fields={getCurrentStepFields()}
                          setFormData={setFormData}
                        />
                      </Row>
                    </div>

                    <div className="d-flex justify-content-between mt-5 pt-4 border-top">
                      <Button
                        variant="outline-primary"
                        onClick={handlePrevious}
                        disabled={currentStep === 1}
                        className="px-4 py-2 d-flex align-items-center"
                      >
                        <FaArrowLeft className="me-2" /> Previous
                      </Button>
                      {currentStep < totalSteps ? (
                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="px-4 py-2 d-flex align-items-center"
                        >
                          Next <FaArrowRight className="ms-2" />
                        </Button>
                      ) : (
                        <div className="d-flex align-items-center">
                          <ActionDropdown
                            actions={actionsFromAPI}
                            onActionClick={handleActionClick}
                            variant="primary"
                            className="py-2 px-3"
                          />
                        </div>
                      )}
                    </div>
                  </form>
                </FormProvider>
              </Card.Body>
            </Card>
          </Col>
        </Row>

        {/* Approval Modal */}
        <ApprovalModal
          show={showApprovalModal}
          handleClose={handleCloseModal}
          handleSubmitData={handleActionSubmit}
          selectedAction={selectedAction}
        />
      </Container>
    </>
  );
};

export default UserViewPage;

.officer-view-container {
  background: linear-gradient(120deg, #f5f7fa 60%, #e3eafc 100%);
  min-height: 100vh;
  padding-bottom: 32px;
}

.card {
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(13,110,253,0.06);
  border: none;
}

.back-btn {
  min-width: 140px;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.app-header-title {
  letter-spacing: 0.5px;
  font-size: 1.7rem;
}

.application-label {
  font-size: 1.25rem;
  font-family: 'Roboto', sans-serif;
}

.application-number {
  background: linear-gradient(90deg, #e3eafc 0%, #b6d0fe 100%);
  color: #0d6efd;
  font-size: 1.05rem;
  font-family: 'Roboto Mono', monospace;
  border: 1.5px solid #b6d0fe;
  margin-right: 0;
}

.status-badge {
  font-size: 1rem;
  padding: 0.5em 1.2em;
  border-radius: 2em;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.stepper-wrapper {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32px;
  position: relative;
  background: transparent;
  padding: 24px 0 12px 0;
}

.stepper-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 120px;
}

.stepper-item:not(:last-child)::after {
  content: "";
  position: absolute;
  top: 18px;
  left: 50%;
  width: 100%;
  height: 4px;
  background: linear-gradient(90deg, #e3eafc 0%, #b6d0fe 100%);
  z-index: 0;
  transform: translateX(18px);
}

.stepper-item:last-child::after {
  display: none;
}

.stepper-item.active .step-counter,
.stepper-item.completed .step-counter {
  background: linear-gradient(135deg, #0d6efd 60%, #198754 100%);
  color: #fff;
  border-color: #0d6efd;
  box-shadow: 0 2px 8px rgba(13,110,253,0.08);
}

.stepper-item.completed .step-counter {
  background: linear-gradient(135deg, #198754 60%, #0d6efd 100%);
  border-color: #198754;
}

.stepper-item .step-counter {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  border: 2.5px solid #dee2e6;
  color: #6c757d;
  font-weight: 700;
  font-size: 1.2rem;
  margin-bottom: 10px;
  transition: all 0.2s;
}

.step-name {
  color: #6c757d;
  font-size: 1rem;
  font-weight: 500;
  letter-spacing: 0.01em;
  text-align: center;
}

.stepper-item.active .step-name {
  color: #0d6efd;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.stepper-item.completed .step-name {
  color: #198754;
  font-weight: 700;
}

.disabled-field {
  background-color: #f8f9fa !important;
  color: #495057 !important;
  cursor: not-allowed !important;
  border: 1.5px solid #e3eafc !important;
  border-radius: 6px !important;
}

.file-display {
  padding: 10px 16px;
  background-color: #f8f9fa;
  border-radius: 6px;
  border: 1.5px solid #dee2e6;
  font-size: 0.97rem;
  min-width: 180px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.file-name {
  font-weight: 500;
  color: #0d6efd;
  font-family: 'Roboto Mono', monospace;
  font-size: 1rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140px;
}

.file-download-btn {
  color: #198754 !important;
  margin-left: 8px;
  padding: 0 6px;
}

@media (max-width: 768px) {
  .stepper-wrapper {
    flex-direction: column;
    align-items: flex-start;
    padding: 16px 0 8px 0;
  }
  .stepper-item {
    flex-direction: row;
    margin-bottom: 18px;
    width: 100%;
    min-width: 0;
  }
  .stepper-item:not(:last-child)::after {
    display: none;
  }
  .stepper-item .step-counter {
    margin-right: 15px;
    margin-bottom: 0;
  }
  .step-name {
    margin-top: 3px;
    text-align: left;
  }
  .app-header-title {
    font-size: 1.2rem;
  }
}










