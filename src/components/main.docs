import React from "react";
import { Container, Row, Col, Card, Badge, Table } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { BsFileEarmarkPdf, BsCheckCircleFill } from "react-icons/bs";

const VesselRegistrationPreview = ({ formData, isPreview = true }) => {
  const { t } = useTranslation();

  // Static preview data
  const previewData = {
    ownerDetails: {
      ownerName: "John Doe",
      ownerAddress: "123 Main Street, Harbor City, State 12345",
      mobile: "9876543210",
      email: "john.doe@example.com",
      pan: "ABCDE1234F",
      aadhar: "123456789012",
      tradeLicence: "TL123456789",
      gst: "GST123456789012"
    },
    vesselDetails: {
      grt: "500",
      workOrderValue: "1000000",
      vesselType: "New Vessel",
      category: "Category A",
      zone: "Zone 1",
      supervisionAuthority: "Classification Society",
      purchaseType: "New",
      classificationSociety: "Lloyd's Register Classification Society",
      constructedBy: "Builder"
    },
    builderDetails: {
      builderName: "ABC Marine Shipyard Pvt Ltd",
      builderAddress: "456 Port Road, Shipyard Complex, Harbor City 54321",
      builderEmail: "contact@abcshipyard.com",
      builderMobile: "9876543211",
      builderTradeLicence: "BTL789012345",
      builderGST: "BGST987654321098",
      builderAuth: "Authorized"
    },
    documents: {
      workOrderFiles: [
        { name: "Work_Order_Document_01.pdf", description: "Main contract document", size: "1.2 MB" },
        { name: "Work_Order_Document_02.pdf", description: "Amendment and modifications", size: "0.8 MB" }
      ],
      drawingFiles: [
        { name: "Technical_Drawing_01.pdf", description: "General arrangement plan", size: "2.1 MB" },
        { name: "Technical_Drawing_02.pdf", description: "Hull structure details", size: "1.5 MB" }
      ],
      tonnageBooklets: { name: "Tonnage_Booklets.pdf", size: "0.5 MB" },
      stabilityBooklets: { name: "Stability_Booklets.pdf", size: "0.7 MB" },
      authLetter: { name: "Authorization_Letter.pdf", size: "0.3 MB" }
    },
    paymentDetails: {
      supervisionAuthority: "Classification Society",
      paymentMode: "Offline",
      challanFile: "Payment_Challan.pdf",
      amount: "Rs. 15,000/-",
      status: "Submitted"
    }
  };

  const SectionCard = ({ title, children, icon }) => (
    <Card className="mb-4 shadow-sm border-0">
      <Card.Header className="bg-light border-0 py-3">
        <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
          {icon && <span className="me-2">{icon}</span>}
          {title}
        </h5>
      </Card.Header>
      <Card.Body className="p-4">
        {children}
      </Card.Body>
    </Card>
  );

  const InfoRow = ({ label, value }) => (
    <Row className="mb-3">
      <Col md={4}>
        <strong className="text-muted">{label}:</strong>
      </Col>
      <Col md={8}>
        <span className="text-dark">{value || "N/A"}</span>
      </Col>
    </Row>
  );

  const DocumentCard = ({ fileName, description, size }) => (
    <Card className="mb-2 border-0 shadow-sm">
      <Card.Body className="p-3">
        <div className="d-flex align-items-center">
          <div className="bg-danger bg-opacity-10 rounded-circle p-2 me-3">
            <BsFileEarmarkPdf className="text-danger" size={20} />
          </div>
          <div className="flex-grow-1">
            <h6 className="mb-1 text-primary fw-semibold" style={{ fontSize: "0.9rem" }}>
              {fileName}
            </h6>
            <p className="mb-0 text-muted small">
              {description}
              <span className="ms-2 badge bg-light text-dark">{size}</span>
            </p>
          </div>
        </div>
      </Card.Body>
    </Card>
  );

  return (
    <Container fluid className="py-4" style={{ backgroundColor: "#f8f9fa" }}>
      <div className="mb-4 text-center">
        <h2 className="text-primary fw-bold">{t("Vessel Registration Preview")}</h2>
        <p className="text-muted">{t("Review all details before final submission")}</p>
      </div>

      {/* Owner Details */}
      <SectionCard title={t("Owner Details")} icon="👤">
        <Row>
          <Col md={6}>
            <InfoRow label={t("Name of Owner")} value={previewData.ownerDetails.ownerName} />
            <InfoRow label={t("Mobile")} value={previewData.ownerDetails.mobile} />
            <InfoRow label={t("PAN")} value={previewData.ownerDetails.pan} />
            <InfoRow label={t("Trade Licence")} value={previewData.ownerDetails.tradeLicence} />
          </Col>
          <Col md={6}>
            <InfoRow label={t("Address")} value={previewData.ownerDetails.ownerAddress} />
            <InfoRow label={t("Email")} value={previewData.ownerDetails.email} />
            <InfoRow label={t("Aadhar")} value={previewData.ownerDetails.aadhar} />
            <InfoRow label={t("GST")} value={previewData.ownerDetails.gst} />
          </Col>
        </Row>
      </SectionCard>

      {/* Vessel Details */}
      <SectionCard title={t("Vessel Details")} icon="🚢">
        <Row>
          <Col md={6}>
            <InfoRow label={t("Gross Tonnage (GRT)")} value={previewData.vesselDetails.grt} />
            <InfoRow label={t("Type of Vessel")} value={previewData.vesselDetails.vesselType} />
            <InfoRow label={t("Zone")} value={previewData.vesselDetails.zone} />
            <InfoRow label={t("Purchase Type")} value={previewData.vesselDetails.purchaseType} />
          </Col>
          <Col md={6}>
            <InfoRow label={t("Work Order Value")} value={`Rs. ${previewData.vesselDetails.workOrderValue}/-`} />
            <InfoRow label={t("Category")} value={previewData.vesselDetails.category} />
            <InfoRow label={t("Supervision Authority")} value={previewData.vesselDetails.supervisionAuthority} />
            <InfoRow label={t("Constructed By")} value={previewData.vesselDetails.constructedBy} />
          </Col>
        </Row>
      </SectionCard>

      {/* Builder Details */}
      <SectionCard title={t("Builder Details")} icon="🏗️">
        <Row>
          <Col md={6}>
            <InfoRow label={t("Builder Name")} value={previewData.builderDetails.builderName} />
            <InfoRow label={t("Builder Email")} value={previewData.builderDetails.builderEmail} />
            <InfoRow label={t("Trade Licence")} value={previewData.builderDetails.builderTradeLicence} />
            <InfoRow label={t("Authorization Status")} value={
              <Badge bg="success" className="px-3 py-2">
                <BsCheckCircleFill className="me-1" />
                {previewData.builderDetails.builderAuth}
              </Badge>
            } />
          </Col>
          <Col md={6}>
            <InfoRow label={t("Builder Address")} value={previewData.builderDetails.builderAddress} />
            <InfoRow label={t("Mobile")} value={previewData.builderDetails.builderMobile} />
            <InfoRow label={t("GST")} value={previewData.builderDetails.builderGST} />
          </Col>
        </Row>
      </SectionCard>

      {/* Documents */}
      <SectionCard title={t("Documents Uploaded")} icon="📄">
        <Row>
          <Col md={6}>
            <h6 className="text-primary mb-3">{t("Work Order Files")}</h6>
            {previewData.documents.workOrderFiles.map((file, index) => (
              <DocumentCard
                key={index}
                fileName={file.name}
                description={file.description}
                size={file.size}
              />
            ))}
            
            <h6 className="text-primary mb-3 mt-4">{t("Tonnage Booklets")}</h6>
            <DocumentCard
              fileName={previewData.documents.tonnageBooklets.name}
              description="Tonnage certification document"
              size={previewData.documents.tonnageBooklets.size}
            />
          </Col>
          <Col md={6}>
            <h6 className="text-primary mb-3">{t("Drawing Files")}</h6>
            {previewData.documents.drawingFiles.map((file, index) => (
              <DocumentCard
                key={index}
                fileName={file.name}
                description={file.description}
                size={file.size}
              />
            ))}
            
            <h6 className="text-primary mb-3 mt-4">{t("Stability Booklets")}</h6>
            <DocumentCard
              fileName={previewData.documents.stabilityBooklets.name}
              description="Stability certification document"
              size={previewData.documents.stabilityBooklets.size}
            />
            
            <h6 className="text-primary mb-3 mt-4">{t("Authorization Letter")}</h6>
            <DocumentCard
              fileName={previewData.documents.authLetter.name}
              description="Builder authorization document"
              size={previewData.documents.authLetter.size}
            />
          </Col>
        </Row>
      </SectionCard>

      {/* Payment Details */}
      <SectionCard title={t("Payment Details")} icon="💳">
        <Row>
          <Col md={6}>
            <InfoRow label={t("Supervision Authority")} value={previewData.paymentDetails.supervisionAuthority} />
            <InfoRow label={t("Payment Mode")} value={previewData.paymentDetails.paymentMode} />
          </Col>
          <Col md={6}>
            <InfoRow label={t("Amount")} value={previewData.paymentDetails.amount} />
            <InfoRow label={t("Status")} value={
              <Badge bg="success" className="px-3 py-2">
                <BsCheckCircleFill className="me-1" />
                {previewData.paymentDetails.status}
              </Badge>
            } />
          </Col>
        </Row>
        
        <hr className="my-4" />
        
        <div className="bg-light rounded p-3">
          <h6 className="text-primary mb-3">{t("Payment Challan")}</h6>
          <DocumentCard
            fileName={previewData.paymentDetails.challanFile}
            description="Payment challan document"
            size="0.2 MB"
          />
        </div>
      </SectionCard>

      {/* Terms Acceptance */}
      <Card className="shadow-sm border-0">
        <Card.Body className="p-4 text-center">
          <div className="d-flex align-items-center justify-content-center">
            <BsCheckCircleFill className="text-success me-2" size={24} />
            <span className="fw-medium text-success">
              {t("Terms and conditions have been accepted")}
            </span>
          </div>
        </Card.Body>
      </Card>
    </Container>
  );
};

export default VesselRegistrationPreview;
