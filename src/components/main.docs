import React, { useState, useEffect } from "react";
import { Link, useLocation } from "react-router-dom";
import { 
  FaChevronRight, 
  FaMoneyBill, 
  FaTimes, 
  FaBars,
  FaHome,
  FaChartLine,
  FaUsers,
  FaFileInvoiceDollar,
  FaCog,
  FaSignOutAlt
} from "react-icons/fa";
import { IoMdNotifications } from "react-icons/io";
import "./Sidebar.css";

const menuItems = [
  {
    name: "dashboard",
    label: "Dashboard",
    icon: <FaHome />,
    path: "/dashboard"
  },
  {
    name: "finance",
    label: "Finance",
    icon: <FaMoneyBill />,
    subMenu: [
      { name: "expense-bill", label: "Expense Bill", path: "/finance/expense-bill" },
      { name: "bank-transfer", label: "Bank Transfer", path: "/finance/bank-transfer" },
      { name: "contractor-bill", label: "Contractor Bill", path: "/finance/contractor-bill" },
      { name: "supplier-bill", label: "Supplier Bill", path: "/finance/supplier-bill" },
    ],
  },
  {
    name: "reports",
    label: "Reports",
    icon: <FaChartLine />,
    path: "/reports"
  },
  {
    name: "users",
    label: "User Management",
    icon: <FaUsers />,
    path: "/users"
  },
  {
    name: "invoices",
    label: "Invoices",
    icon: <FaFileInvoiceDollar />,
    path: "/invoices"
  },
  {
    name: "settings",
    label: "Settings",
    icon: <FaCog />,
    path: "/settings"
  }
];

const Sidebar = ({ isSidebarOpen, onMenuClick, onClose, onExpand }) => {
  const location = useLocation();
  const [expandedMenus, setExpandedMenus] = useState({});
  const [isMobile, setIsMobile] = useState(window.innerWidth <= 900);

  useEffect(() => {
    const handleResize = () => setIsMobile(window.innerWidth <= 900);
    window.addEventListener("resize", handleResize);
    return () => window.removeEventListener("resize", handleResize);
  }, []);

  const toggleMenu = (menuName) => {
    setExpandedMenus(prev => ({
      ...prev,
      [menuName]: !prev[menuName]
    }));
  };

  // Mini sidebar for desktop when closed
  if (!isSidebarOpen && !isMobile) {
    return (
      <div className="custom-sidebar mini">
        <div className="mini-sidebar-logo">
          <img
            src={require("../../assets/images/GovtLogo.png")}
            alt="Logo"
            className="mini-logo-img"
          />
        </div>
        <div className="mini-sidebar-icons">
          {menuItems.map((item) => (
            <div
              key={item.name}
              className={`mini-sidebar-icon ${
                location.pathname.startsWith(`/${item.name}`) ? "active" : ""
              }`}
              title={item.label}
              onClick={() => {
                if (item.subMenu) {
                  onExpand();
                  toggleMenu(item.name);
                } else {
                  onMenuClick(item.name);
                }
              }}
            >
              {item.icon}
            </div>
          ))}
        </div>
        <div className="mini-sidebar-footer">
          <div 
            className="mini-sidebar-icon"
            title="Logout"
            onClick={() => onMenuClick("logout")}
          >
            <FaSignOutAlt />
          </div>
          <div className="mini-sidebar-expand" onClick={onExpand} title="Expand">
            <FaBars />
          </div>
        </div>
      </div>
    );
  }

  return (
    <>
      {isSidebarOpen && isMobile && (
        <div className="custom-sidebar-backdrop" onClick={onClose}></div>
      )}
      <div className={`custom-sidebar ${isSidebarOpen ? "expanded" : "collapsed"}`}>
        <div className="custom-sidebar-close">
          <FaTimes onClick={onClose} />
        </div>
        
        <div className="sidebar-header">
          <img
            src={require("../../assets/images/GovtLogo.png")}
            alt="Logo"
            className="sidebar-logo-img"
          />
          {isSidebarOpen && <span className="sidebar-title">Digit Finance</span>}
        </div>
        
        <ul className="custom-sidebar-menu">
          {menuItems.map((item) => (
            <li className="custom-sidebar-item" key={item.name}>
              {item.subMenu ? (
                <>
                  <div
                    className={`custom-sidebar-link ${
                      location.pathname.startsWith(`/${item.name}`) ? "active" : ""
                    }`}
                    onClick={() => toggleMenu(item.name)}
                    aria-expanded={expandedMenus[item.name]}
                  >
                    <div className="custom-sidebar-link-content">
                      <span className="custom-sidebar-icon">
                        {item.icon}
                      </span>
                      {isSidebarOpen && <span>{item.label}</span>}
                    </div>
                    {isSidebarOpen && (
                      <span className={`custom-sidebar-chevron${
                        expandedMenus[item.name] ? " rotate" : ""
                      }`}>
                        <FaChevronRight size={12} />
                      </span>
                    )}
                  </div>
                  <div className={`custom-sidebar-submenu${
                    expandedMenus[item.name] && isSidebarOpen ? " expanded" : ""
                  }`}>
                    {item.subMenu.map((sub) => (
                      <Link
                        key={sub.name}
                        to={sub.path}
                        className={`custom-sidebar-sublink${
                          location.pathname === sub.path ? " active" : ""
                        }`}
                        onClick={() => {
                          onMenuClick && onMenuClick(sub.name);
                          if (isMobile) onClose();
                        }}
                      >
                        {sub.label}
                      </Link>
                    ))}
                  </div>
                </>
              ) : (
                <Link
                  to={item.path}
                  className={`custom-sidebar-link ${
                    location.pathname.startsWith(`/${item.name}`) ? "active" : ""
                  }`}
                  onClick={() => {
                    onMenuClick && onMenuClick(item.name);
                    if (isMobile) onClose();
                  }}
                >
                  <div className="custom-sidebar-link-content">
                    <span className="custom-sidebar-icon">
                      {item.icon}
                    </span>
                    {isSidebarOpen && <span>{item.label}</span>}
                  </div>
                </Link>
              )}
            </li>
          ))}
        </ul>
        
        <div className="sidebar-footer">
          {isSidebarOpen && (
            <Link
              to="/logout"
              className="logout-link"
              onClick={(e) => {
                e.preventDefault();
                onMenuClick("logout");
              }}
            >
              <FaSignOutAlt />
              <span>Logout</span>
            </Link>
          )}
          {isSidebarOpen && (
            <span className="copyright">© {new Date().getFullYear()} Digit Finance</span>
          )}
        </div>
      </div>
    </>
  );
};

export default Sidebar;
