.sidebar {
  background: linear-gradient(180deg, #f4f8fc 80%, #eaf2fb 100%);
  color: #2466bf;
  height: calc(100vh - 60px);
  transition:
    width 0.5s cubic-bezier(0.77, 0, 0.175, 1),
    min-width 0.5s cubic-bezier(0.77, 0, 0.175, 1),
    max-width 0.5s cubic-bezier(0.77, 0, 0.175, 1);
  overflow: hidden;
  padding-top: 1.5rem;
  box-shadow: 2px 0 16px rgba(36, 102, 191, 0.08);
  border-right: 1px solid #e1eaf5;
  position: fixed;
  top: 75px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  width: 17rem;
  min-width: 17rem;
  max-width: 17rem;
}

.collapsed {
  width: 60px;
  min-width: 60px;
  max-width: 60px;
}

.expanded {
  width: 17rem;
  min-width: 17rem;
  max-width: 17rem;
}

.menu,
.submenuList {
  list-style: none;
  padding: 0;
  margin: 0;
}

.item {
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
}

.itemActive > .link {
  background-color: #e3edfa;
  font-weight: 600;
  color: #174a8b;
}

.itemActive::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8px;
  bottom: 8px;
  width: 4px;
  border-radius: 4px;
  background: linear-gradient(180deg, #2466bf 60%, #5fa8e6 100%);
  transition: all 0.3s ease-out;
  animation: activeIndicator 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
}

@keyframes activeIndicator {
  0% {
    transform: scaleY(0.5);
    opacity: 0;
  }
  100% {
    transform: scaleY(1);
    opacity: 1;
  }
}

.link {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 12px 18px 12px 22px;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  border-radius: 0 24px 24px 0;
  position: relative;
  min-height: 44px;
  gap: 8px;
  overflow: hidden;
}

.link:hover {
  background-color: #e8f1fc;
  box-shadow: 0 2px 8px rgba(36, 102, 191, 0.07);
  color: #174a8b;
}

.link::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.2);
  transform: translateX(-100%);
  transition: transform 0.3s ease-out;
}

.link:hover::after {
  transform: translateX(0);
}

.linkContent {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.icon {
  margin-right: 10px;
  font-size: 1.25rem;
  min-width: 28px;
  text-align: center;
  color: #2466bf;
  transition: all 0.3s ease-out;
}

.link:hover .icon,
.itemActive .icon {
  color: #174a8b;
  transform: scale(1.1);
}

.linkLabel {
  display: inline-block;
  white-space: nowrap;
  overflow: hidden;
  transition:
    opacity 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
    width 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
    margin 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
    transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  opacity: 1;
  width: auto;
  margin-left: 4px;
  font-size: 1rem;
  letter-spacing: 0.01em;
  transform: translateX(0);
}

.collapsed .linkLabel {
  opacity: 0;
  width: 0;
  margin-left: 0;
  pointer-events: none;
  transform: translateX(-16px);
}

.chevron {
  margin-left: auto;
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  color: #b3c7e6;
  transform-origin: center;
}

.rotate {
  transform: rotate(90deg);
}

.submenu {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transform: translateY(-10px) scaleY(0.97);
  transition:
    max-height 0.5s cubic-bezier(0.25, 0.8, 0.25, 1),
    opacity 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
    transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
    padding 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  padding-top: 0;
  padding-bottom: 0;
  background: #f8fbff;
  border-radius: 0 0 16px 0;
  margin-left: 8px;
  will-change: transform, opacity, max-height;
}

.submenu.expanded {
  max-height: 800px;
  opacity: 1;
  transform: translateY(0) scaleY(1);
  padding-top: 4px;
  padding-bottom: 8px;
  overflow-y: auto;
}

.submenu.expanded::-webkit-scrollbar {
  width: 6px;
}

.submenu.expanded::-webkit-scrollbar-thumb {
  background-color: rgba(36, 102, 191, 0.12);
  border-radius: 4px;
}

.sublink {
  margin: 4px 8px 0 12px;
  display: block;
  padding: 9px 28px;
  color: #2466bf;
  text-decoration: none;
  font-size: 0.97rem;
  border-radius: 0 16px 16px 0;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
  transform-origin: left;
}

.sublink:hover {
  background-color: #e8f1fc;
  color: #174a8b;
  transform: translateX(4px);
}

.sublinkActive {
  background-color: #d6e6f9;
  color: #174a8b;
  font-weight: 500;
  animation: sublinkActive 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
}

@keyframes sublinkActive {
  0% {
    transform: translateX(-10px);
    opacity: 0;
  }
  100% {
    transform: translateX(0);
    opacity: 1;
  }
}

.backdrop {
  position: fixed;
  inset: 0;
  z-index: 999;
}

.close {
  display: none;
  justify-content: flex-end;
  padding: 0.75rem 1rem;
}

.close svg {
  cursor: pointer;
  font-size: 1.25rem;
  color: #2466bf;
  transition: transform 0.3s ease-out;
}

.close svg:hover {
  transform: rotate(90deg);
}

@media (max-width: 768px) {
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 250px;
    z-index: 1000;
    transition: transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
    background: linear-gradient(180deg, #f4f8fc 80%, #eaf2fb 100%);
    box-shadow: 4px 0 24px rgba(36, 102, 191, 0.15);
  }

  .collapsed {
    transform: translateX(-100%);
    transition: transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .expanded {
    transform: translateX(0);
    transition: transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .close {
    display: flex;
  }

  .menu {
    padding-bottom: 2rem;
  }
}

.menu {
  list-style: none;
  padding: 0;
  margin: 0;
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
}

.menu::-webkit-scrollbar {
  width: 6px;
}

.menu::-webkit-scrollbar-thumb {
  background-color: rgba(36, 102, 191, 0.13);
  border-radius: 4px;
}

.collapsed .menu {
  overflow: hidden;
}
