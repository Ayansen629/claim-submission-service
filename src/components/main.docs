const handleFileChange = async (e, documentType) => {
  if (isViewMode) return;
  const file = e?.target?.files[0];
  if (!file) return;

  const maxSize = 10 * 1024 * 1024;
  if (file.size > maxSize) {
    toast.error("File size must be less than or equal to 10 MB.");
    e.target.value = null;
    return;
  }

  loaderRef.current?.show();

  try {
    const formData = new FormData();
    formData.append("file", file);

    const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
    const response = await postFORMdata(uploadUrl, formData);

    const fileStoreId = response?.data?.files[0]?.fileStoreId;

    if (fileStoreId) {
      // Define mapping of document types to display names
      const displayNameMapping = {
        "thirdPartyInsurance": "Third Party Insurance",
        "builderCertificate": "Builder's Certificate",
        "instrumentOfSale": "Instrument of Sale",
        "mortgageDetails": "Mortgage Details",
        "pniInsurance": "Protection & Indemnity Insurance",
        "declarationOfOwnership": "Declaration of Ownership",
        "challan": "Challan"
      };

      // Get the file extension from the original file
      const fileExtension = file.name.split('.').pop();
      
      // Create the display name using the mapping + file extension
      const displayName = `${displayNameMapping[documentType] || documentType}.${fileExtension}`;

      setFileStates(prev => ({
        ...prev,
        [documentType]: {
          name: displayName,
          fileStoreId,
          originalName: file.name
        }
      }));
      setValue(`${documentType}FileStoreId`, fileStoreId);
      toast.success("File uploaded successfully!");
    }
  } catch (err) {
    console.error("File upload failed:", err);
    toast.error("File upload failed. Please try again.");
    setFileStates(prev => ({ ...prev, [documentType]: null }));
    e.target.value = null;
  } finally {
    loaderRef.current?.hide();
  }
};
