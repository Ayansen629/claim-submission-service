// Replace the classification society InfoRow with this:
{formData.classificationSociety && (
  <Row className="mb-3">
    <Col md={4}>
      <strong className="text-muted">{t("Classification Society")}:</strong>
    </Col>
    <Col md={8}>
      <span className="text-dark" style={{ wordBreak: "break-word", lineHeight: "1.4" }}>
        {formData.classificationSociety}
      </span>
    </Col>
  </Row>
)}
