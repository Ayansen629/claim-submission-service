<Col md={4}>
  <InputSelect
    name="typeOfEngine"
    label={t("Type of Engine")}
    placeholder={
      !isViewMode ? t("Select type of engine") : ""
    }
    options={engineTypeOptions}
    register={register("typeOfEngine")}
    errors={errors}
    value={watch("typeOfEngine") || ""}
    onChange={(val) =>
      handleDropdownChange("typeOfEngine", val)
    }
    clearErrors={clearErrors}
    disabled={isViewMode}
    style={{
      ...(isViewMode
        ? {
            backgroundColor: "#f5f5f5",
            cursor: "not-allowed",
            color: "black",
            fontWeight: 550,
          }
        : {}),
    }}
  />
</Col>
