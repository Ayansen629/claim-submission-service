import React from "react";
import { FaPhone, FaEnvelope, FaCheckSquare, FaChevronDown, FaEdit } from "react-icons/fa";
import styles from './Profile.module.css';
import UserProfileLogo from "../../../assets/images/user-profilelogo.jpg";
import { getFromLocalStorage } from "../../../utils/localStorageUtils.js";

const Profile = () => {
  return (
    <div className={styles.container}>
      <div className={styles.card}>
        {/* Circular Image */}
        <div className={styles.circularImage}>
          <img 
            src={UserProfileLogo}
            alt="Vessel"
          />
          <div className={styles.editIcon}>
            <FaEdit />
          </div>
        </div>
        
        {/* Company Name */}
        <h1 className={styles.companyName}>ABC Pvt Ltd</h1>
        
        {/* Contact Info */}
        <div className={styles.contactRow}>
          <div className={styles.contactItem}>
            <FaPhone className={styles.phoneIcon} />
            <span>+91 7044606052</span>
          </div>
          <div className={styles.contactItem}>
            <FaEnvelope className={styles.emailIcon} />
            <span>abc@gmail.com</span>
          </div>
        </div>
        
        {/* Document Numbers */}
        <div className={styles.documentRow}>
          <span className={styles.docLabel}>PAN: 23PK*******</span>
          <span className={styles.docLabel}>Aadhar: 2345 5367 8***</span>
          <span className={styles.docLabel}>License: WB/KMC/TL/2025/******</span>
        </div>
        
        {/* Vessel Details */}
        <div className={styles.vesselSection}>
          <div className={styles.vesselHeader}>
            <span>Vessel Details</span>
            <FaChevronDown className={styles.chevron} />
          </div>
          
          <div className={styles.optionsSection}>
            <div className={styles.option}>
              <FaCheckSquare className={styles.checkIcon} />
              <span>Name Change</span>
              <FaEdit className={styles.optionEditIcon} />
            </div>
            <div className={styles.option}>
              <FaCheckSquare className={styles.checkIcon} />
              <span>Address Change</span>
              <FaEdit className={styles.optionEditIcon} />
            </div>
          </div>
        </div>
        
        {/* Proceed Button */}
        <button className={styles.proceedButton}>
          Proceed Now
        </button>
      </div>
    </div>
  );
};

export default Profile;
THIS FILE FOR REFERENCE-->
import React, { useState, useEffect } from "react";
import { Link, useLocation, useNavigate } from "react-router-dom";
import Dropdown from "react-bootstrap/Dropdown";
import {
  FaBars,
  FaGlobe,
  FaKey,
  FaUser,
  FaSignOutAlt,
  FaCheck,
} from "react-icons/fa";
import { FiFlag } from "react-icons/fi";
import { GiIndiaGate } from "react-icons/gi";
import GovtLogo from "../../assets/images/GovtLogo.png";
import ProfileImg from "../../assets/images/Profile.png";
import InlandWaterTransport from "../../assets/images/Inland-Water-Transport.jpg";
import { useLanguageContext } from "./LanguageContext";
import { useTranslation } from "react-i18next";
import "./styles/Header.css";
import "./styles/ChangePassword.css";
import IWT_Icon from "../../assets/images/IWT_Icon.jpg";
import {
  clearAppStorage,
  getUserRoleName,
  USER_ROLES,
} from "../../utils/constants.ts";
import { getFromLocalStorage } from "../../utils/localStorageUtils";
import ChangePassword from "./ChangePassword";

const Header = ({ toggleSidebar, onLogout, isSidebarOpen }) => {
  const { changeLanguage, language } = useLanguageContext();
  const navigate = useNavigate();
  const { t } = useTranslation();
  const [showChangePassword, setShowChangePassword] = useState(false);
  const [userInfo, setUserInfo] = useState({ name: "", role: "" });

  useEffect(() => {
    const safeParse = (key) => {
      try {
        return JSON.parse(getFromLocalStorage(key) || "{}");
      } catch {
        return {};
      }
    };

    const userRole = getFromLocalStorage("userRole");
    let userName = "User";

    switch (userRole) {
      case USER_ROLES.VESSEL_OWNER: {
        const { ownerCompanyName, authorisedFname } = safeParse("ownerDetails");
        userName = ownerCompanyName || authorisedFname || userName;
        break;
      }
      case USER_ROLES.BUILDER: {
        const { builderCompanyName, authorisedFname } = safeParse("builderDetails");
        userName = builderCompanyName || authorisedFname || userName;
        break;
      }
      default: {
        const { firstName = "", lastName = "" } = safeParse("employeeDetails");
        userName = `${firstName} ${lastName}`.trim() || userName;
        break;
      }
    }

    setUserInfo({
      name: userName,
      role: getUserRoleName(userRole) || "",
    });
  }, []);

  const doLogout = () => {
    clearAppStorage();
    navigate("/");
  };

  return (
    <>
      <nav className="navbar navbar-expand-lg custom-navbar fixed-top px-3">
        <div className="d-flex align-items-center gap-2 flex-shrink-0">
          <img
            src={IWT_Icon}
            alt="IWT Logo"
            className="img-fluid mobile-logo"
            style={{ height: "3rem", borderRadius: "5px" }}
          />
          {isSidebarOpen && (
            <svg
              width="100%"
              height="46px"
              viewBox="0 0 800 200"
              xmlns="http://www.w3.org/2000/svg"
              className="d-none d-md-block"
            >
              <text
                x="50%"
                y="90"
                dominantBaseline="middle"
                textAnchor="middle"
                fontSize="69"
                fill="white"
                fontFamily="Segoe UI, sans-serif"
              >
                {t("Inland Water Transport")}
              </text>
              <text
                x="50%"
                y="140"
                dominantBaseline="middle"
                textAnchor="middle"
                fontSize="30"
                fill="white"
                fontFamily="Segoe UI, sans-serif"
              >
                {t("Transport Department, Government of West Bengal")}
              </text>
            </svg>
          )}
          <button
            className="btn text-white me-2 sidebar-toggle"
            onClick={toggleSidebar}
            aria-label="Toggle Sidebar"
          >
            <FaBars />
          </button>
        </div>

        <div className="flex-grow-1 d-none d-md-block"></div>

        <div className="header-right">
          <Dropdown>
            <Dropdown.Toggle
              variant="link"
              className="text-white nav-link p-0 d-flex align-items-center gap-1 language-dropdown"
            >
              <FaGlobe />
            </Dropdown.Toggle>
            <Dropdown.Menu className="language-dropdown-menu">
              <Dropdown.Item
                onClick={() => changeLanguage("en")}
                active={language === "en"}
                className="d-flex align-items-center gap-2"
              >
                <FiFlag size={18} style={{ color: "#2563eb" }} />
                <span>English</span>
                {language === "en" && (
                  <FaCheck className="ms-auto text-success" />
                )}
              </Dropdown.Item>
              <Dropdown.Item
                onClick={() => changeLanguage("bn")}
                active={language === "bn"}
                className="d-flex align-items-center gap-2"
              >
                <GiIndiaGate size={18} style={{ color: "#f59e42" }} />
                <span>বাংলা</span>
                {language === "bn" && (
                  <FaCheck className="ms-auto text-success" />
                )}
              </Dropdown.Item>
            </Dropdown.Menu>
          </Dropdown>

          <Dropdown align="end">
            <Dropdown.Toggle
              variant="link"
              className="d-flex align-items-center text-white nav-link p-0"
            >
              <img
                src={ProfileImg}
                alt="Profile"
                className="rounded-circle profile-img"
                style={{ width: "40px", height: "40px" }}
              />
            </Dropdown.Toggle>
            <Dropdown.Menu className="profile-dropdown-menu">
              <Dropdown.Item 
              as={Link}
              to="/users/profile"
              className="dropdown-item-custom">
                {/* <Dropdown.Item as={Link} to="/profile" className="dropdown-item-custom"> */}
                <FaUser className="dropdown-icon" />
                <span>
                  Hi! <span style={{ color: "#2466bf" }}>{userInfo.name}</span>{" "}
                  ({userInfo.role})
                </span>
              </Dropdown.Item>
              <Dropdown.Item
                onClick={() => setShowChangePassword(true)}
                className="dropdown-item-custom"
              >
                <FaKey className="dropdown-icon" />
                <span>{t("Change Password")}</span>
              </Dropdown.Item>
              <Dropdown.Divider />
              <Dropdown.Item
                className="dropdown-item-custom logout-item"
                onClick={doLogout}
              >
                <FaSignOutAlt className="dropdown-icon" />
                <span>{t("Logout")}</span>
              </Dropdown.Item>
            </Dropdown.Menu>
          </Dropdown>

          <img
            src={GovtLogo}
            alt="Govt Logo"
            className="rounded-circle d-none d-sm-block govt-logo"
            style={{ width: "3.5rem", height: "3.5rem" }}
          />
        </div>
      </nav>

      <ChangePassword
        show={showChangePassword}
        onHide={() => setShowChangePassword(false)}
      />
    </>
  );
};

export default Header;
