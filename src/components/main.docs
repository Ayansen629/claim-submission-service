/* Responsive Design */
@media (max-width: 1200px) {
  .safetyTable {
    min-width: 1000px;
  }
  
  .mainHeader, .groupHeader {
    font-size: 0.8rem;
    padding: 14px 8px;
  }
  
  .subHeader {
    font-size: 0.7rem;
    padding: 10px 6px;
  }
  
  .dateInputGroup {
    flex-wrap: wrap;
    gap: 10px;
  }
}

@media (max-width: 768px) {
  .certificateContainer {
    padding: 15px;
  }
  
  .certificateTitle {
    font-size: 1.5rem;
    letter-spacing: 1px;
  }
  
  .safetyTable {
    min-width: 900px;
  }
  
  .mainHeader, .groupHeader, .subHeader {
    font-size: 0.65rem;
    padding: 10px 4px;
  }
  
  .tableInput {
    max-width: 90px;
    padding: 8px 10px;
    font-size: 0.8rem;
  }
  
  .plyingLimitsContent {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  
  .capacityItem {
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }
  
  .capacityValue {
    text-align: center;
  }
  
  .dateInputGroup {
    justify-content: center;
  }
}

@media (max-width: 576px) {
  .certificateHeader {
    padding: 20px 15px;
  }
  
  .certificateTitle {
    font-size: 1.3rem;
  }
  
  .inputCell {
    padding: 10px 6px;
  }
  
  .tableInput {
    max-width: 70px;
    padding: 6px 8px;
    font-size: 0.75rem;
  }
  
  .certificationBox {
    padding: 20px 15px;
  }
  
  .validityBox {
    padding: 20px 15px;
  }
  
  .dateInput {
    width: 60px;
    padding: 8px;
  }
  
  .inlineInput {
    width: 80px;
  }
}

@media (max-width: 480px) {
  .safetyTable {
    min-width: 700px;
  }
  
  .tableNoDataCell i {
    font-size: 1rem;
  }
  
  .capacityContent {
    gap: 10px;
  }
  
  .capacityItem {
    padding: 12px;
  }
}
