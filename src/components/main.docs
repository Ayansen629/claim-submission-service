  const [provisionalCertData, setProvisionalCertData] = useState("");
  const [generatedCertificates, setGeneratedCertificates] = useState({
    survey: false,
    registration: false,
  });
 const [drwaingFiles, setDrwaingFiles] = useState([]);
const [radiographyFiles, setRadiographyFiles] = useState([]);
const [materialTestFiles, setMaterialTestFiles] = useState([]);
