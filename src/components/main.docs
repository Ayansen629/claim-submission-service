import React, { useState } from 'react';
import { Modal, Button, Spinner } from 'react-bootstrap';
import { format, addDays, setHours, setMinutes } from 'date-fns';
import { toast } from 'react-toastify';
import 'bootstrap/dist/css/bootstrap.min.css';
import './AppointmentModal.css';

const AppointmentModal = ({ show, handleClose, handleConfirm }) => {
  const [selectedSlot, setSelectedSlot] = useState(null);
  const [isLoading, setIsLoading] = useState(false);

  const generateSlots = () => {
    const slots = [];
    const today = new Date();
    
    for (let i = 0; i < 7; i++) {
      const date = addDays(today, i);
      const dateFormatted = format(date, 'MMM d');
      const dayName = format(date, 'EEE');
      
      const timeSlots = [
        { start: setHours(setMinutes(date, 0), 10), end: setHours(setMinutes(date, 0), 11), display: '10:00 AM - 11:00 AM' },
        { start: setHours(setMinutes(date, 0), 12), end: setHours(setMinutes(date, 0), 13), display: '12:00 PM - 1:00 PM' },
        { start: setHours(setMinutes(date, 0), 15), end: setHours(setMinutes(date, 0), 16), display: '3:00 PM - 4:00 PM' },
        { start: setHours(setMinutes(date, 0), 16), end: setHours(setMinutes(date, 0), 17), display: '4:00 PM - 5:00 PM' }
      ];
      
      timeSlots.forEach((timeSlot, j) => {
        slots.push({
          id: `${date.getTime()}-${j}`,
          ...timeSlot,
          dateDisplay: dateFormatted,
          dayName: dayName,
          fullDate: format(date, 'yyyy-MM-dd'),
          fullDisplay: `${timeSlot.display}, ${dateFormatted}`
        });
      });
    }
    
    return slots;
  };

  const timeSlots = generateSlots();

  const handleSlotSelect = (slot) => {
    setIsLoading(true);
    
    // Show loader for 1 second then update selection
    setTimeout(() => {
      setSelectedSlot(slot);
      setIsLoading(false);
      console.log('Slot selected:', slot);
    }, 1000);
  };

  const handleConfirmAppointment = () => {
    if (selectedSlot) {
      const appointmentData = {
        date: selectedSlot.fullDate,
        time: selectedSlot.display,
        startTime: format(selectedSlot.start, 'HH:mm'),
        endTime: format(selectedSlot.end, 'HH:mm'),
        dayName: selectedSlot.dayName,
        dateDisplay: selectedSlot.dateDisplay,
        fullDisplay: selectedSlot.fullDisplay
      };
      
      console.log('Confirmed Appointment:', JSON.stringify(appointmentData, null, 2));
      
      alert(`Appointment confirmed for ${appointmentData.fullDisplay}`);
      
      toast.success(`🎉 Appointment successfully booked for ${appointmentData.dateDisplay} at ${appointmentData.time}`, {
        position: "top-right",
        autoClose: 5000,
        hideProgressBar: false,
        closeOnClick: true,
        pauseOnHover: true,
        draggable: true,
      });
      
      if (handleConfirm) {
        handleConfirm(appointmentData);
      }
      
      handleClose();
      setSelectedSlot(null);
    }
  };

  const handleModalClose = () => {
    setSelectedSlot(null);
    setIsLoading(false);
    handleClose();
  };

  return (
    <Modal 
      show={show} 
      onHide={handleModalClose} 
      centered 
      className="appointment-modal" 
      size="md"
    >
      <Modal.Header closeButton className="border-0 pb-2 modal-header-custom">
        <Modal.Title className="fw-bold text-white d-flex align-items-center">
          <div className="icon-wrapper me-3">
            <i className="bi bi-calendar-check"></i>
          </div>
          <div>
            <div className="title-main">Select Appointment</div>
            <div className="title-sub">Choose your preferred time slot</div>
          </div>
        </Modal.Title>
      </Modal.Header>
      
      <Modal.Body className="pt-3 modal-body-custom">
        {selectedSlot && !isLoading && (
          <div className="selected-slot-banner">
            <div className="selected-icon">
              <i className="bi bi-check-circle-fill"></i>
            </div>
            <div className="selected-text">
              <strong>Selected:</strong> {selectedSlot.fullDisplay}
            </div>
          </div>
        )}
        
        {isLoading && (
          <div className="loading-overlay">
            <div className="loading-content">
              <Spinner animation="border" variant="primary" className="loading-spinner" />
              <div className="loading-text">Processing your selection...</div>
            </div>
          </div>
        )}
        
        <div className={`slots-container ${isLoading ? 'loading' : ''}`}>
          {timeSlots.map((slot, index) => (
            <div 
              key={slot.id}
              className={`time-slot-card ${selectedSlot?.id === slot.id ? 'selected' : ''} ${isLoading ? 'disabled' : ''}`}
              onClick={() => !isLoading && handleSlotSelect(slot)}
              style={{ animationDelay: `${index * 0.1}s` }}
            >
              <div className="slot-content">
                <div className="slot-header">
                  <div className="slot-day">{slot.dayName}</div>
                  <div className="slot-date">{slot.dateDisplay}</div>
                </div>
                <div className="slot-time">
                  <i className="bi bi-clock me-2"></i>
                  {slot.display}
                </div>
              </div>
              
              <div className="card-glow"></div>
            </div>
          ))}
        </div>
      </Modal.Body>
      
      <Modal.Footer className="border-0 pt-0 modal-footer-custom">
        <Button 
          variant="outline-secondary" 
          onClick={handleModalClose} 
          className="btn-cancel"
          disabled={isLoading}
        >
          <i className="bi bi-x-lg me-2"></i>
          Cancel
        </Button>
        <Button 
          variant="primary" 
          onClick={handleConfirmAppointment}
          disabled={!selectedSlot || isLoading}
          className="btn-confirm"
        >
          <i className="bi bi-check-lg me-2"></i>
          Confirm Appointment
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default AppointmentModal;
