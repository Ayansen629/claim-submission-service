import React, { useCallback, useEffect, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepFirst.css";
import 'bootstrap/dist/css/bootstrap.min.css';
import { useRegistration } from "../../context/ApplicationContext";
import { FaPlus, FaTimes, FaDownload, FaBuilding, FaUser, FaHome, FaIdCard } from "react-icons/fa";

const StepFirst = ({ provideSubmitHandler, formData, onValidationComplete, onNext }) => {
  const {
    registrationData,
    handleStepDataFetch,
    updateRegistrationData,
    handleApplicatioNFormView,
    isDataLoaded,
    applicationDetails
  } = useRegistration();

  const [uploadError, setUploadError] = useState(null);
  const [incorporatedRecords, setIncorporatedRecords] = useState([
    { id: 1, details: "", proof: null }
  ]);
  const [partnershipRecords, setPartnershipRecords] = useState([
    { id: 1, details: "", proof: null }
  ]);
  const [uploadingRecordId, setUploadingRecordId] = useState(null);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [initialData, setInitialData] = useState({
    corporateDebtorName: "",
    financialCreditorName: "",
    financialCreditorEmail: ""
  });

  // Load initial data from localStorage or applicationDetails
  useEffect(() => {
    const storedData = localStorage.getItem('userFormData');
    if (storedData) {
      const parsedData = JSON.parse(storedData);
      setInitialData({
        corporateDebtorName: parsedData.corporateDebtorName || "",
        financialCreditorName: parsedData.userDetails?.claimantName || "",
        financialCreditorEmail: parsedData.userDetails?.emailId || ""
      });
    } else if (applicationDetails) {
      setInitialData({
        corporateDebtorName: applicationDetails.creditorBasicDetails?.financialDebtorName || "",
        financialCreditorName: applicationDetails.creditorBasicDetails?.financialCreditorName || "",
        financialCreditorEmail: applicationDetails.creditorBasicDetails?.financialCreditorEmail || ""
      });
    }
  }, [applicationDetails]);

  const methods = useForm({
    mode: "onChange",
    reValidateMode: "onChange",
    defaultValues: {
      corporateDebtorName: "",
      identificationType: "INCORPORATED",
      financialCreditorName: "",
      financialCreditorEmail: "",
      addressLine1: "",
      addressLine2: "",
      city: "",
      state: "",
      pincode: "",
      identificationtype_details: [{ id: 1, details: "", proof: null }]
    }
  });

  const {
    register,
    handleSubmit,
    formState: { errors, isValid },
    trigger,
    setValue,
    control,
    getValues,
    watch,
    resetField
  } = methods;

  // Set initial values when they're loaded
  useEffect(() => {
    if (initialData.corporateDebtorName || initialData.financialCreditorName || initialData.financialCreditorEmail) {
      setValue('corporateDebtorName', initialData.corporateDebtorName);
      setValue('financialCreditorName', initialData.financialCreditorName);
      setValue('financialCreditorEmail', initialData.financialCreditorEmail);
    }
  }, [initialData, setValue]);

  const watchIdentificationType = watch("identificationType", "INCORPORATED");

  // Rest of your component code remains the same...
  // [Previous code for handleFileUpload, addIdentificationRecord, etc.]

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        {/* Your existing JSX remains the same */}
      </form>
    </FormProvider>
  );
};

export default StepFirst;
