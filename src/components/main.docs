/* Add this to employeeDashboard.css */
.status-card {
  height: 100%;
  min-height: 220px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  border: none;
  background: #fff;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.status-card-content {
  padding: 20px;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.status-card .icon-wrapper {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.status-card .value {
  font-size: 32px;
  font-weight: 700;
  margin: 8px 0;
  line-height: 1;
}

.status-card .title {
  font-size: 15px;
  color: #555;
  margin-bottom: 6px;
  font-weight: 500;
}

.status-card .subtitle {
  font-size: 13px;
  color: #888;
  margin-bottom: 10px;
}

/* Row adjustments for consistent card heights */
.row.g-3 > [class*="col-"] {
  display: flex;
  flex-direction: column;
}
