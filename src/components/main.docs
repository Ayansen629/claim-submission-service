import React from "react";
import { Form } from "react-bootstrap";
import styles from "./styles/InputRadio.module.css";

type OptionType = {
  label: string;
  value: string;
};

interface InputRadioProps {
  name: string;
  label: string;
  options: OptionType[];
  register: any;
  rules?: any;
  errors?: any;
  className?: string;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  disabled?: boolean;
}

const InputRadio: React.FC<InputRadioProps> = ({
  name,
  label,
  options,
  register,
  rules = {},
  errors,
  className = "",
  onChange,
  disabled = false,
}) => {
  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      <div className="d-flex align-items-center flex-wrap gap-3">
        <Form.Label className="fw-bold mb-0 me-3">{label}</Form.Label>
        <div className={`d-flex flex-wrap gap-3 ${styles.radioButtonGroup}`}>
          {options?.map((option) => (
            <label
              className={styles.radioButton}
              key={option.value}
              htmlFor={`${name}-${option.value}`}
            >
              <input
                type="radio"
                id={`${name}-${option.value}`}
                value={option.value}
                {...register(name, {
                  ...rules,
                  onChange,
                })}
                className={styles.radioInput}
                disabled={disabled}
              />
              <span className={styles.radioLabel}>{option.label}</span>
            </label>
          ))}
        </div>
      </div>
      {errors?.[name] && (
        <p className="text-danger mt-1 small">{errors[name]?.message}</p>
      )}
    </Form.Group>
  );
};

export default InputRadio;
