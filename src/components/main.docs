.actionToggle {
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%) !important;
  border: 1px solid rgba(126, 200, 248, 0.2) !important;
  border-radius: 12px !important;
  padding: 12px 16px !important;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
  box-shadow: 0 8px 25px rgba(126, 200, 248, 0.1) !important;
  position: relative !important;
}

.actionToggle:hover {
  background: linear-gradient(178deg, #7ec8f8, #0d5ed0) !important;
  color: white !important;
  border-color: #0d5ed0 !important;
  box-shadow: 0 12px 35px rgba(126, 200, 248, 0.3) !important;
  transform: translateY(-3px) scale(1.05) !important;
}

.actionMenu {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.95)) !important;
  backdrop-filter: blur(30px) saturate(200%) !important;
  -webkit-backdrop-filter: blur(30px) saturate(200%) !important;
  border: 1px solid rgba(126, 200, 248, 0.2) !important;
  border-radius: 20px !important;
  box-shadow: 
    0 30px 60px -12px rgba(126, 200, 248, 0.25),
    0 18px 36px -18px rgba(13, 94, 208, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.4) !important;
  padding: 16px 0 !important;
  min-width: 240px !important;
  margin-top: 12px !important;
  animation: dropdownAppear 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

.actionMenu .dropdown-item {
  padding: 16px 24px !important;
  font-size: 15px !important;
  font-weight: 600 !important;
  color: #1e293b !important;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  display: flex !important;
  align-items: center !important;
  gap: 16px !important;
  margin: 4px 12px !important;
  border-radius: 14px !important;
  position: relative !important;
  overflow: hidden !important;
  background: transparent !important;
}

.actionMenu .dropdown-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(178deg, #7ec8f8, #0d5ed0) !important;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: -1;
  border-radius: 14px;
}

.actionMenu .dropdown-item::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 12px;
  width: 4px;
  height: 0;
  background: rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
  border-radius: 2px;
  transform: translateY(-50%);
}

.actionMenu .dropdown-item:hover::before {
  left: 0;
}

.actionMenu .dropdown-item:hover::after {
  height: 60%;
}

.actionMenu .dropdown-item:hover {
  color: #ffffff !important;
  transform: translateX(8px) scale(1.03) !important;
  box-shadow: 0 8px 25px rgba(126, 200, 248, 0.4) !important;
  font-weight: 700 !important;
}

.actionMenu .dropdown-item svg {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  padding: 4px !important;
  border-radius: 8px !important;
  background: rgba(126, 200, 248, 0.1) !important;
  width: 28px !important;
  height: 28px !important;
}

.actionMenu .dropdown-item:hover svg {
  transform: scale(1.2) rotate(5deg) !important;
  background: rgba(255, 255, 255, 0.2) !important;
  box-shadow: 0 4px 12px rgba(255, 255, 255, 0.3) !important;
}

/* Special destructive item styling */
.actionMenu .dropdown-item.destructive {
  color: #dc2626 !important;
}

.actionMenu .dropdown-item.destructive svg {
  background: rgba(220, 38, 38, 0.1) !important;
}

.actionMenu .dropdown-item.destructive::before {
  background: linear-gradient(178deg, #fca5a5, #dc2626) !important;
}

.actionMenu .dropdown-item.destructive:hover svg {
  background: rgba(255, 255, 255, 0.2) !important;
}

/* Divider styling */
.actionMenu .dropdown-divider {
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(126, 200, 248, 0.3), transparent);
  margin: 12px 20px;
  border: none;
  border-radius: 1px;
}

@keyframes dropdownAppear {
  from {
    opacity: 0;
    transform: translateY(-20px) scale(0.85) rotateX(-10deg);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1) rotateX(0deg);
  }
}

/* Responsive */
@media (max-width: 768px) {
  .actionMenu {
    min-width: 220px !important;
  }
  
  .actionMenu .dropdown-item {
    padding: 14px 20px !important;
    font-size: 14px !important;
  }
}
