import React, { useState } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Form, Button, Card, ProgressBar, Alert } from 'react-bootstrap';
import { FaUser, FaBuilding, FaFileUpload, FaCheck } from 'react-icons/fa';

// Step 1: Owner Details Component
const OwnerDetailsForm = ({ register, errors, watch }) => {
  const ownerCategory = watch('ownerCategory');
  
  const handlePinCodeChange = (e) => {
    const pincode = e.target.value;
    if (pincode.length === 6) {
      // In a real app, you would fetch district/state data based on PIN
      // For demo, we'll just set some values
      setValue('district', 'Sample District');
      setValue('state', 'Sample State');
      setValue('country', 'India');
    }
  };

  return (
    <Card className="mb-4">
      <Card.Header className="bg-primary text-white">
        <FaUser className="me-2" /> Vessel Owner Details
      </Card.Header>
      <Card.Body>
        <Row className="mb-3">
          <Col md={6}>
            <Form.Group controlId="ownerCategory">
              <Form.Label>Category of Owner <span className="text-danger">*</span></Form.Label>
              <Form.Select 
                {...register('ownerCategory', { required: 'Owner category is required' })}
                isInvalid={!!errors.ownerCategory}
              >
                <option value="">Select Category</option>
                <option value="individual">Individual</option>
                <option value="company">Company</option>
                <option value="organization">Organization</option>
              </Form.Select>
              {errors.ownerCategory && <Form.Control.Feedback type="invalid">{errors.ownerCategory.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
          
          <Col md={6}>
            <Form.Group controlId="ownerName">
              <Form.Label>Owner/Company Name <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="text" 
                {...register('ownerName', { required: 'Owner name is required' })}
                isInvalid={!!errors.ownerName}
              />
              {errors.ownerName && <Form.Control.Feedback type="invalid">{errors.ownerName.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
        </Row>

        <Row className="mb-3">
          <Col md={6}>
            <Form.Group controlId="email">
              <Form.Label>Email ID <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="email" 
                {...register('email', { 
                  required: 'Email is required',
                  pattern: {
                    value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                    message: 'Invalid email address'
                  }
                })}
                isInvalid={!!errors.email}
              />
              {errors.email && <Form.Control.Feedback type="invalid">{errors.email.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
          
          <Col md={6}>
            <Form.Group controlId="phoneNumber">
              <Form.Label>Phone Number <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="text" 
                {...register('phoneNumber', { 
                  required: 'Phone number is required',
                  pattern: {
                    value: /^[0-9]{10}$/,
                    message: 'Phone number must be 10 digits'
                  }
                })}
                isInvalid={!!errors.phoneNumber}
              />
              {errors.phoneNumber && <Form.Control.Feedback type="invalid">{errors.phoneNumber.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
        </Row>

        <Row className="mb-3">
          <Col md={6}>
            <Form.Group controlId="panNumber">
              <Form.Label>PAN Number <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="text" 
                {...register('panNumber', { 
                  required: 'PAN number is required',
                  pattern: {
                    value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
                    message: 'Invalid PAN format'
                  }
                })}
                isInvalid={!!errors.panNumber}
              />
              {errors.panNumber && <Form.Control.Feedback type="invalid">{errors.panNumber.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
          
          <Col md={6}>
            <Form.Group controlId="gstNumber">
              <Form.Label>GST Number</Form.Label>
              <Form.Control 
                type="text" 
                {...register('gstNumber', { 
                  pattern: {
                    value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
                    message: 'Invalid GST format'
                  }
                })}
                isInvalid={!!errors.gstNumber}
              />
              {errors.gstNumber && <Form.Control.Feedback type="invalid">{errors.gstNumber.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
        </Row>

        <h5 className="mt-4 mb-3">Address Details</h5>
        
        <Row className="mb-3">
          <Col md={6}>
            <Form.Group controlId="addressLine1">
              <Form.Label>Address Line-1 <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="text" 
                {...register('addressLine1', { required: 'Address is required' })}
                isInvalid={!!errors.addressLine1}
              />
              {errors.addressLine1 && <Form.Control.Feedback type="invalid">{errors.addressLine1.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
          
          <Col md={6}>
            <Form.Group controlId="addressLine2">
              <Form.Label>Address Line-2</Form.Label>
              <Form.Control 
                type="text" 
                {...register('addressLine2')}
              />
            </Form.Group>
          </Col>
        </Row>

        <Row className="mb-3">
          <Col md={6}>
            <Form.Group controlId="pincode">
              <Form.Label>PIN <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="text" 
                {...register('pincode', { 
                  required: 'PIN code is required',
                  pattern: {
                    value: /^[0-9]{6}$/,
                    message: 'PIN must be 6 digits'
                  }
                })}
                onChange={handlePinCodeChange}
                isInvalid={!!errors.pincode}
              />
              {errors.pincode && <Form.Control.Feedback type="invalid">{errors.pincode.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
          
          <Col md={6}>
            <Form.Group controlId="district">
              <Form.Label>District</Form.Label>
              <Form.Control 
                type="text" 
                {...register('district')}
                readOnly
                placeholder="Auto-populated based on PIN"
              />
            </Form.Group>
          </Col>
        </Row>

        <Row className="mb-3">
          <Col md={6}>
            <Form.Group controlId="state">
              <Form.Label>State/UT</Form.Label>
              <Form.Control 
                type="text" 
                {...register('state')}
                readOnly
                placeholder="Auto-populated based on PIN"
              />
            </Form.Group>
          </Col>
          
          <Col md={6}>
            <Form.Group controlId="country">
              <Form.Label>Country</Form.Label>
              <Form.Control 
                type="text" 
                {...register('country')}
                readOnly
                defaultValue="India"
              />
            </Form.Group>
          </Col>
        </Row>
      </Card.Body>
    </Card>
  );
};

// Step 2: Authorized Person Details Component
const AuthorizedPersonForm = ({ register, errors, setValue, watch }) => {
  const handleFileChange = (e) => {
    const file = e.target.files[0];
    if (file) {
      // In a real app, you would upload the file to a server
      // For demo, we'll just store the file name
      setValue('authorizationLetter', file.name);
    }
  };

  return (
    <Card className="mb-4">
      <Card.Header className="bg-primary text-white">
        <FaUser className="me-2" /> Authorized Person's Details
      </Card.Header>
      <Card.Body>
        <Row className="mb-3">
          <Col md={6}>
            <Form.Group controlId="firstName">
              <Form.Label>First Name <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="text" 
                {...register('firstName', { required: 'First name is required' })}
                isInvalid={!!errors.firstName}
              />
              {errors.firstName && <Form.Control.Feedback type="invalid">{errors.firstName.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
          
          <Col md={6}>
            <Form.Group controlId="lastName">
              <Form.Label>Last Name <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="text" 
                {...register('lastName', { required: 'Last name is required' })}
                isInvalid={!!errors.lastName}
              />
              {errors.lastName && <Form.Control.Feedback type="invalid">{errors.lastName.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
        </Row>

        <Row className="mb-3">
          <Col md={6}>
            <Form.Group controlId="mobileNumber">
              <Form.Label>Primary Mobile Number <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="text" 
                {...register('mobileNumber', { 
                  required: 'Mobile number is required',
                  pattern: {
                    value: /^[0-9]{10}$/,
                    message: 'Mobile number must be 10 digits'
                  }
                })}
                isInvalid={!!errors.mobileNumber}
              />
              {errors.mobileNumber && <Form.Control.Feedback type="invalid">{errors.mobileNumber.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
          
          <Col md={6}>
            <Form.Group controlId="authorizedEmail">
              <Form.Label>Email ID <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="email" 
                {...register('authorizedEmail', { 
                  required: 'Email is required',
                  pattern: {
                    value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                    message: 'Invalid email address'
                  }
                })}
                isInvalid={!!errors.authorizedEmail}
              />
              {errors.authorizedEmail && <Form.Control.Feedback type="invalid">{errors.authorizedEmail.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
        </Row>

        <Row className="mb-3">
          <Col md={12}>
            <Form.Group controlId="authorizationLetter">
              <Form.Label>Upload Letter of Authorization <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="file" 
                onChange={handleFileChange}
                isInvalid={!!errors.authorizationLetter}
              />
              <Form.Text className="text-muted">
                Upload PDF, JPG or PNG file (Max size: 2MB)
              </Form.Text>
              {errors.authorizationLetter && <Form.Control.Feedback type="invalid">{errors.authorizationLetter.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
        </Row>
      </Card.Body>
    </Card>
  );
};

// Step 3: Documents Upload Component
const DocumentsUploadForm = ({ register, errors, setValue, watch }) => {
  const ownerCategory = watch('ownerCategory');
  
  const handleFileChange = (name) => (e) => {
    const file = e.target.files[0];
    if (file) {
      // In a real app, you would upload the file to a server
      // For demo, we'll just store the file name
      setValue(name, file.name);
    }
  };

  return (
    <Card className="mb-4">
      <Card.Header className="bg-primary text-white">
        <FaFileUpload className="me-2" /> Documents Upload
      </Card.Header>
      <Card.Body>
        <Row className="mb-3">
          <Col md={6}>
            <Form.Group controlId="panCardUpload">
              <Form.Label>PAN Card <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="file" 
                onChange={handleFileChange('panCardUpload')}
                isInvalid={!!errors.panCardUpload}
              />
              <Form.Text className="text-muted">
                Upload PDF, JPG or PNG file (Max size: 2MB)
              </Form.Text>
              {errors.panCardUpload && <Form.Control.Feedback type="invalid">{errors.panCardUpload.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
          
          <Col md={6}>
            <Form.Group controlId="gstCertificate">
              <Form.Label>GST Certificate</Form.Label>
              <Form.Control 
                type="file" 
                onChange={handleFileChange('gstCertificate')}
              />
              <Form.Text className="text-muted">
                Upload PDF, JPG or PNG file (Max size: 2MB)
              </Form.Text>
            </Form.Group>
          </Col>
        </Row>

        <Row className="mb-3">
          <Col md={6}>
            <Form.Group controlId="addressProof">
              <Form.Label>Address Proof <span className="text-danger">*</span></Form.Label>
              <Form.Control 
                type="file" 
                onChange={handleFileChange('addressProof')}
                isInvalid={!!errors.addressProof}
              />
              <Form.Text className="text-muted">
                Upload PDF, JPG or PNG file (Max size: 2MB)
              </Form.Text>
              {errors.addressProof && <Form.Control.Feedback type="invalid">{errors.addressProof.message}</Form.Control.Feedback>}
            </Form.Group>
          </Col>
          
          {ownerCategory !== 'organization' && (
            <Col md={6}>
              <Form.Group controlId="companyRegistrationCertificate">
                <Form.Label>Company Registration Certificate <span className="text-danger">*</span></Form.Label>
                <Form.Control 
                  type="file" 
                  onChange={handleFileChange('companyRegistrationCertificate')}
                  isInvalid={!!errors.companyRegistrationCertificate}
                />
                <Form.Text className="text-muted">
                  Upload PDF, JPG or PNG file (Max size: 2MB)
                </Form.Text>
                {errors.companyRegistrationCertificate && <Form.Control.Feedback type="invalid">{errors.companyRegistrationCertificate.message}</Form.Control.Feedback>}
              </Form.Group>
            </Col>
          )}
        </Row>

        {ownerCategory === 'company' && (
          <>
            <Row className="mb-3">
              <Col md={6}>
                <Form.Group controlId="cinNumber">
                  <Form.Label>CIN Number <span className="text-danger">*</span></Form.Label>
                  <Form.Control 
                    type="text" 
                    {...register('cinNumber', { 
                      required: ownerCategory === 'company' ? 'CIN number is required' : false,
                      pattern: {
                        value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
                        message: 'Invalid CIN format'
                      }
                    })}
                    isInvalid={!!errors.cinNumber}
                  />
                  {errors.cinNumber && <Form.Control.Feedback type="invalid">{errors.cinNumber.message}</Form.Control.Feedback>}
                </Form.Group>
              </Col>
              
              <Col md={6}>
                <Form.Group controlId="dinNumber">
                  <Form.Label>DIN Number <span className="text-danger">*</span></Form.Label>
                  <Form.Control 
                    type="text" 
                    {...register('dinNumber', { 
                      required: ownerCategory === 'company' ? 'DIN number is required' : false,
                      pattern: {
                        value: /^[0-9]{8}$/,
                        message: 'DIN must be 8 digits'
                      }
                    })}
                    isInvalid={!!errors.dinNumber}
                  />
                  {errors.dinNumber && <Form.Control.Feedback type="invalid">{errors.dinNumber.message}</Form.Control.Feedback>}
                </Form.Group>
              </Col>
            </Row>

            <Row className="mb-3">
              <Col md={6}>
                <Form.Group controlId="moaCertificate">
                  <Form.Label>MOA Certificate <span className="text-danger">*</span></Form.Label>
                  <Form.Control 
                    type="file" 
                    onChange={handleFileChange('moaCertificate')}
                    isInvalid={!!errors.moaCertificate}
                  />
                  <Form.Text className="text-muted">
                    Upload PDF, JPG or PNG file (Max size: 2MB)
                  </Form.Text>
                  {errors.moaCertificate && <Form.Control.Feedback type="invalid">{errors.moaCertificate.message}</Form.Control.Feedback>}
                </Form.Group>
              </Col>
              
              <Col md={6}>
                <Form.Group controlId="aoaCertificate">
                  <Form.Label>AOA Certificate <span className="text-danger">*</span></Form.Label>
                  <Form.Control 
                    type="file" 
                    onChange={handleFileChange('aoaCertificate')}
                    isInvalid={!!errors.aoaCertificate}
                  />
                  <Form.Text className="text-muted">
                    Upload PDF, JPG or PNG file (Max size: 2MB)
                  </Form.Text>
                  {errors.aoaCertificate && <Form.Control.Feedback type="invalid">{errors.aoaCertificate.message}</Form.Control.Feedback>}
                </Form.Group>
              </Col>
            </Row>
          </>
        )}
      </Card.Body>
    </Card>
  );
};

// Main Registration Form Component
const VesselOwnerRegistrationForm = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  
  const methods = useForm({
    mode: 'onChange',
    defaultValues: {
      ownerCategory: '',
      country: 'India'
    }
  });
  
  const { 
    register, 
    handleSubmit, 
    formState: { errors, isValid }, 
    trigger,
    setValue,
    getValues,
    watch
  } = methods;

  const totalSteps = 3;
  const progress = (currentStep / totalSteps) * 100;

  const validateStep = async () => {
    let fieldsToValidate = [];
    
    switch (currentStep) {
      case 1:
        fieldsToValidate = [
          'ownerCategory', 'ownerName', 'email', 'phoneNumber', 
          'panNumber', 'addressLine1', 'pincode'
        ];
        break;
      case 2:
        fieldsToValidate = [
          'firstName', 'lastName', 'mobileNumber', 'authorizedEmail', 'authorizationLetter'
        ];
        break;
      case 3:
        fieldsToValidate = ['panCardUpload', 'addressProof'];
        
        const ownerCategory = watch('ownerCategory');
        if (ownerCategory !== 'organization') {
          fieldsToValidate.push('companyRegistrationCertificate');
        }
        
        if (ownerCategory === 'company') {
          fieldsToValidate.push('cinNumber', 'dinNumber', 'moaCertificate', 'aoaCertificate');
        }
        break;
      default:
        break;
    }
    
    const result = await trigger(fieldsToValidate);
    return result;
  };

  const handleNext = async () => {
    const isStepValid = await validateStep();
    
    if (isStepValid) {
      // Save current step data
      const currentValues = getValues();
      setFormData(prev => ({ ...prev, ...currentValues }));
      
      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
      } else {
        // Submit the form
        onSubmit(currentValues);
      }
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
  };

  const onSubmit = (data) => {
    // Combine all form data
    const finalData = { ...formData, ...data };
    
    // In a real app, you would send this data to your backend
    console.log('Form submitted with data:', finalData);
    
    // Show success message
    setIsSubmitted(true);
    
    // You could also redirect the user or show a success modal
  };

  const renderStepContent = () => {
    switch (currentStep) {
      case 1:
        return <OwnerDetailsForm register={register} errors={errors} setValue={setValue} watch={watch} />;
      case 2:
        return <AuthorizedPersonForm register={register} errors={errors} setValue={setValue} watch={watch} />;
      case 3:
        return <DocumentsUploadForm register={register} errors={errors} setValue={setValue} watch={watch} />;
      default:
        return null;
    }
  };

  return (
    <Container className="py-5">
      <Row className="justify-content-center">
        <Col md={10}>
          <Card className="shadow-sm">
            <Card.Header className="bg-primary text-white">
              <h4 className="mb-0">Vessel Owner Registration Form</h4>
            </Card.Header>
            <Card.Body>
              {isSubmitted ? (
                <Alert variant="success">
                  <Alert.Heading><FaCheck className="me-2" /> Registration Successful!</Alert.Heading>
                  <p>Your vessel owner registration has been submitted successfully. You will receive a confirmation email shortly.</p>
                  <hr />
                  <p className="mb-0">
                    Registration ID: {Math.random().toString(36).substring(2, 10).toUpperCase()}
                  </p>
                </Alert>
              ) : (
                <FormProvider {...methods}>
                  <form>
                    {/* Progress Bar */}
                    <div className="mb-4">
                      <div className="d-flex justify-content-between mb-2">
                        <span>Step {currentStep} of {totalSteps}</span>
                        <span>{Math.round(progress)}% Complete</span>
                      </div>
                      <ProgressBar now={progress} variant="primary" />
                    </div>
                    
                    {/* Step Indicators */}
                    <div className="d-flex justify-content-center mb-4">
                      <div className="step-indicators">
                        <div className={`step-indicator ${currentStep >= 1 ? 'active' : ''}`}>
                          <div className="step-number">1</div>
                          <div className="step-label">Owner Details</div>
                        </div>
                        <div className="step-line"></div>
                        <div className={`step-indicator ${currentStep >= 2 ? 'active' : ''}`}>
                          <div className="step-number">2</div>
                          <div className="step-label">Authorized Person</div>
                        </div>
                        <div className="step-line"></div>
                        <div className={`step-indicator ${currentStep >= 3 ? 'active' : ''}`}>
                          <div className="step-number">3</div>
                          <div className="step-label">Documents</div>
                        </div>
                      </div>
                    </div>
                    
                    {/* Step Content */}
                    {renderStepContent()}
                    
                    {/* Navigation Buttons */}
                    <div className="d-flex justify-content-between mt-4">
                      <Button 
                        variant="outline-secondary" 
                        onClick={handlePrevious}
                        disabled={currentStep === 1}
                      >
                        Previous
                      </Button>
                      
                      <Button 
                        variant="primary" 
                        onClick={handleNext}
                      >
                        {currentStep === totalSteps ? 'Submit' : 'Next'}
                      </Button>
                    </div>
                  </form>
                </FormProvider>
              )}
            </Card.Body>
          </Card>
        </Col>
      </Row>
      
      <style jsx>{`
        .step-indicators {
          display: flex;
          align-items: center;
          width: 80%;
        }
        
        .step-indicator {
          display: flex;
          flex-direction: column;
          align-items: center;
          flex: 1;
        }
        
        .step-number {
          width: 40px;
          height: 40px;
          border-radius: 50%;
          background-color: #e9ecef;
          color: #6c757d;
          display: flex;
          align-items: center;
          justify-content: center;
          font-weight: bold;
          margin-bottom: 8px;
          transition: all 0.3s;
        }
        
        .step-indicator.active .step-number {
          background-color: #0d6efd;
          color: white;
        }
        
        .step-label {
          font-size: 0.875rem;
          color: #6c757d;
          transition: all 0.3s;
        }
        
        .step-indicator.active .step-label {
          color: #0d6efd;
          font-weight: 500;
        }
        
        .step-line {
          flex: 1;
          height: 2px;
          background-color: #e9ecef;
          margin: 0 10px;
          margin-bottom: 30px;
        }
      `}</style>
    </Container>
  );
};

export default VesselOwnerRegistrationForm;
