// ReviewStep.js
import React, { useEffect, useMemo } from "react";
import { Container, Row, Col, Spinner } from "react-bootstrap";
import Collapsible from "./formCommon/Collapsible";
import { useFormData } from "../../context/FormDataContext";
import PreviewCard from "../../private/Dashboard/PreviewCard";

const ReviewStep = () => {
  const { formData } = useFormData();
  const [hasLoggedData, setHasLoggedData] = React.useState(false);

  // Memoize the formatted data to prevent unnecessary re-renders
  const formattedData = useMemo(() => {
    if (!formData || !formData.applicationDetails) return null;

    const { 
      creditorBasicDetails, 
      claimDetails, 
      signatoryDetails 
    } = formData.applicationDetails;

    // Helper function to format file information
    const formatFileInfo = (doc) => {
      if (!doc) return "No document uploaded";
      return doc.docName || "Document uploaded";
    };

    return {
      step1: {
        creditorDetails: {
          "Debtor Name": creditorBasicDetails?.debtorName || "N/A",
          "Creditor Name": creditorBasicDetails?.creditorName || "N/A",
          "Total Claim Amount": creditorBasicDetails?.totalClaimAmount || "N/A",
          "Debt Details": creditorBasicDetails?.debtDetails || "N/A",
          "Mutual Credit Details": creditorBasicDetails?.mutualCreditDetails || "N/A",
        },
        identificationDetails: {
          "Identification Document": formatFileInfo(creditorBasicDetails?.document),
        }
      },
      step2: {
        financialDetails: {
          "Security Interest Amount": claimDetails?.securityInterestAmount || "N/A",
          "Guarantee Amount": claimDetails?.guaranteeAmount || "N/A",
          "Guarantor Name": claimDetails?.guarantorName || "N/A",
          "Guarantor Address": claimDetails?.guarantorAddress || "N/A",
          "Creditor Address": claimDetails?.creditorAddress || "N/A",
          "Creditor Email": claimDetails?.creditorEmail || "N/A",
        },
        beneficiaryDetails: {
          "Beneficiary Name": claimDetails?.beneficiaryName || "N/A",
          "Beneficiary Address": claimDetails?.beneficiaryAddress || "N/A",
          "Corporate Debtor Security Amount": claimDetails?.corporateDebtorSecurityAmount || "N/A",
          "Corporate Debtor Guarantee Amount": claimDetails?.corporateDebtorGuaranteeAmount || "N/A",
        },
        addressproofDetails: {
          "Address Proof Document": formatFileInfo(claimDetails?.document),
        },
        bankDetails: {
          "Principal Borrower Name": claimDetails?.principalBorrowerName || "N/A",
          "Principal Borrower Address": claimDetails?.principalBorrowerAddress || "N/A",
          "Account Number": claimDetails?.bankAccountNumber || "N/A",
          "IFSC Code": claimDetails?.bankIfscCode || "N/A",
          "Branch Name": claimDetails?.bankBranchName || "N/A",
        }
      },
      step3: {
        signatoryDetails: {
          "Signatory Name": signatoryDetails?.name || "N/A",
          "Signatory Position": signatoryDetails?.position || "N/A",
          "Signatory Address": signatoryDetails?.address || "N/A",
          "Signatory Document": formatFileInfo(signatoryDetails?.document),
        }
      }
    };
  }, [formData]);

  useEffect(() => {
    if (formattedData && !hasLoggedData) {
      console.log("Review formdata:", formattedData);
      setHasLoggedData(true);
    }
  }, [formattedData, hasLoggedData]);

  const renderPreviewSection = (fields) => (
    <Container fluid>
      <Row className="g-3">
        {Object.entries(fields).map(([key, value]) => (
          <Col key={key} xs={12} sm={6} md={3} className="mb-3">
            <PreviewCard 
              title={key} 
              value={value} 
            />
          </Col>
        ))}
      </Row>
    </Container>
  );

  const renderCard = (title, fields) => (
    <div className="mb-3">
      <h5 style={{ fontWeight: 600 }}>{title}</h5>
      {renderPreviewSection(fields)}
    </div>
  );

  if (!formattedData) {
    return (
      <div className="d-flex justify-content-center align-items-center" style={{ height: "100vh" }}>
        <Spinner animation="border" />
      </div>
    );
  }

  return (
    <div className="form-stepper">
      <Collapsible title="Step 1: Creditor and Identification Details">
        {renderCard("Creditor Details", formattedData.step1.creditorDetails)}
        {renderCard("Identification Details", formattedData.step1.identificationDetails)}
      </Collapsible>

      <Collapsible title="Step 2: Financial and Beneficiary Details">
        {renderCard("Financial Details", formattedData.step2.financialDetails)}
        {renderCard("Address Proof Details", formattedData.step2.addressproofDetails)}
        {renderCard("Beneficiary Details", formattedData.step2.beneficiaryDetails)}
        {renderCard("Bank Details", formattedData.step2.bankDetails)}
      </Collapsible>

      <Collapsible title="Step 3: Signatory Details">
        {renderCard("Signatory Details", formattedData.step3.signatoryDetails)}
      </Collapsible>
    </div>
  );
};

export default React.memo(ReviewStep);
