//     finalData?.partnerRegCertUpload,
//     finalData?.partnerDeedUpload,
//     finalData?.trustRegCertUpload,
//     finalData?.trustDeedUpload,
//     finalData?.fdiRegCertUpload,
//     finalData?.fdiResolutionUpload,
//     finalData?.fdiProofUpload,
//     finalData?.vslBareboatUpload,
//     finalData?.vslChartererProofUpload,
//     finalData?.stateAoaUpload,
//     finalData?.stateMoaUpload,
//     finalData?.centralAoaUpload,
//     finalData?.centralMoaUpload,
//     finalData?.localAoaUpload,
//     finalData?.localMoaUpload,
//     finalData?.otherPanUpload,
//     finalData?.otherGstUpload,
    
//     // Additional documents
//     ...additionalDocs
//   ];

//   const fd = new FormData();
//   fd.append(
//     "request",
//     new Blob([JSON.stringify(payload)], { type: "application/json" })
//   );
  
//   files?.forEach((file) => {
//     if (file) {
//       fd.append(`files`, file);
//     }
//   });
  
//   submitUserDetails(fd);
// };
 const onSubmit = (data) => {
  const finalData = { ...formData, ...data };

  const payload = createOwnerOrBuilderPayload("VESSEL_OWNER", {
    ...finalData,
  });

  // Get additional documents
  const additionalDocs = [];
  additionalFiles.forEach(file => {
    const fileData = finalData[`ADDITIONAL_DOCS_file_${file.id}`];
    if (fileData) {
      additionalDocs.push(fileData);
    }
  });

  const files = [
    finalData?.addressProof,
    finalData?.panCardUpload,
    finalData?.gstCertificate,
    finalData?.authorizationLetter,
    finalData?.companyRegistrationCertificate,
    finalData?.moaCertificate,
    finalData?.aoaCertificate,
    finalData?.tradeLicenseUpload,
    ...additionalDocs // Add additional documents
  ];

  console.log(payload,"vessel-owner payload")

  const fd = new FormData();
  fd.append(
    "request",
    new Blob([JSON.stringify(payload)], { type: "application/json" })
  );
  
  files?.forEach((file) => {
    if (file) {
      fd.append(`files`, file);
    }
  });
  
  submitUserDetails(fd);
};

  const submitUserDetails = async (payload) => {
    try {
      const URL =
        process.env.REACT_APP_AUTH_URL +
        URLS_ENDPOINT.USER_SERVICE.CREATE_UPDATE_USER;
      loaderRef.current?.show();
      const response = await postFORMdata(URL, payload);
      const apiRes = { ...response?.data };
      if (
        response?.status === 200 &&
        apiRes?.responseStatus?.status === "200"
      ) {
        loaderRef?.current?.hide();
        setIsSubmitted(true);
        setSuccessMessage(apiRes?.responseStatus?.message);
        setApplicationData(apiRes?.data);
        window.scrollTo(0, 0);
      } else {
        loaderRef?.current?.hide();
        toast.info(
          apiRes?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const DynamicField = ({ field }) => {
    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case "select":
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register(field?.name, {
              ...field.validation,
            })}
            errors={errors}
            icon={field.icon}
            className="mb-3"
            onChange={(value, selObj) => {
              if (field?.name === "categoryOfOwner") {
                setIsCompany(selObj?.isCompany || false);

                const isIndividual =
                  value?.toLowerCase()?.includes("indv") || "";
                setIsExemptCategory(!isIndividual);

                setValue(field.name, value);

                if (!isIndividual) {
                  clearErrors(["panNo", "aadharNumber", "tradeLicenseNumber"]);
                } else {
                  trigger(["panNo", "aadharNumber", "tradeLicenseNumber"]);
                }

                if (errors[field.name]) {
                  clearErrors(field.name);
                }

                setFormData((prev) => ({
                  ...prev,
                  [field.name]: value,
                }));
              } else {
                setValue(field.name, value);
                if (errors[field.name]) clearErrors(field.name);
                setFormData((prev) => ({
                  ...prev,
                  [field.name]: value,
                }));
              }
            }}
            value={formData[field.name] || watch(field.name)}
            autoFocus={field.autoFocus}
          />
        );

     case "file":
  return (
    // <div style={{ position: "relative" }}>
      <InputFile
        label={field.label}
        required={
          typeof field.required === "function"
            ? field.required()
            : field.required
        }
        name={field.name}
        key={field.name}
        register={register(field.name, {
          required: (
            typeof field.required === "function"
              ? field.required()
              : field.required
          )
            ? `${field.label} is required`
            : false,
        })}
        errors={errors}
        onChange={(e) => {
          if (e.target.files && e.target.files[0]) {
            const file = e.target.files[0];
            const extension = file.name.substring(
              file.name.lastIndexOf(".")
            );

            const modifiedFile = new File(
              [file],
              `${field.label
                .replace(/\s+/g, "")
                .toLowerCase()}${extension}`,
              {
                type: file.type,
                lastModified: file.lastModified,
              }
            );

            setValue(field.name, modifiedFile);

            setFormData((prev) => {
              const updated = { ...prev, [field.name]: modifiedFile };
              return updated;
            });

            if (errors[field.name]) {
              clearErrors(field.name);
            }

            const validTypes = [
              "application/pdf",
              "image/jpeg",
              "image/png",
              "image/jpg",
            ];
            if (!validTypes.includes(file.type)) {
              setError(field.name, {
                type: "manual",
                message: "Only PDF, JPG or PNG files are allowed",
              });
            }

            if (file.size > 10 * 1024 * 1024) {
              setError(field.name, {
                type: "manual",
                message: "File size should not exceed 10MB",
              });
            }
          }
        }}
        className="mb-3"
        watch={watch}
        accept=".pdf,.jpg,.jpeg,.png"
        defaultValue={formData[field.name]}
        autoFocus={field.autoFocus}
        style={{
          borderColor: errors[field.name] ? "#dc3545" : "#ced4da",
          backgroundColor: errors[field.name] ? "#fff8f8" : "white",
        }}
      />
      
    //   {/* Add cross button for regular files */}
    //   {watch(field.name) && (
    //     <FaTimesCircle
    //       className="text-danger position-absolute"
    //       style={{
    //         top: "60%",
    //         right: "1.5rem",
    //         transform: "translateY(-50%)",
    //         cursor: "pointer",
    //         zIndex: 10,
    //       }}
    //       size={16}
    //       title="Remove file"
    //       onClick={() => {
    //         setValue(field.name, null);
    //         clearErrors(field.name);
    //         setFormData(prev => {
    //           const updated = { ...prev };
    //           delete updated[field.name];
    //           return updated;
    //         });
    //       }}
    //     />
    //   )}
    // </div>
  );

 case "multifile":
      return (
        <MultiFile
          title={field.label}
          files={additionalFiles}
          type="ADDITIONAL_DOCS"
          icon={<FaFileUpload className="me-2" />}
          watch={watch}
          viewMode={false}
          editMode={false}
          clearErrors={clearErrors}
          register={register}
          errors={errors}
          setError={setError}
          setValue={setValue}
          unregister={() => {}} 
          localFiles={additionalFiles}
          setFiles={setAdditionalFiles}
          isRegistrationMode={true}
          ref={loaderRef}
        />
      );
        
      default:
        return (
          // <InputText
          //   label={field.label}
          //   required={
          //     isExemptCategory &&
          //     ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
          //       field.name
          //     )
          //       ? false
          //       : field.required
          //   }
          //   name={field.name}
          //   key={field.name}
          //   type={field.type}
          //   placeholder={field.placeholder}
          //   register={register(field?.name, {
          //     ...(isExemptCategory &&
          //     ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
          //       field.name
          //     )
          //       ? {}
          //       : field.validation),
          //   })}
          //   onChange={handleChange}
          //   errors={errors}
          //   readOnly={field.readOnly}
          //   icon={field.icon}
          //   maxlength={field?.maxlength}
          //   onKeyDown={field?.keyDown}
          //   disabled={field?.disabled || false}
          //   className="mb-3"
          //   style={{
          //     borderColor:
          //       errors[field.name] &&
          //       !(
          //         isExemptCategory &&
          //         ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
          //           field.name
          //         )
          //       )
          //         ? "#dc3545"
          //         : "#ced4da",
          //     backgroundColor:
          //       errors[field.name] &&
          //       !(
          //         isExemptCategory &&
          //         ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
          //           field.name
          //         )
          //       )
          //         ? "#fff8f8"
          //         : "white",
          //   }}
          //   autoFocus={field.autoFocus}
          // />

          <InputText
            label={field.label}
            required={
              ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
                field.name
              )
                ? isIndividualOwner(formData)
                : field.required
            }
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...(["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
                field.name
              )
                ? isIndividualOwner(formData)
                  ? field.validation
                  : {}
                : field.validation),
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className="mb-3"
            style={{
              borderColor:
                errors[field.name] &&
                (["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
                  field.name
                )
                  ? isIndividualOwner(formData)
                  : true)
                  ? "#dc3545"
                  : "#ced4da",
              backgroundColor:
                errors[field.name] &&
                (["panNo", "aadharNumber", "tradeLicenseNumber"].includes(
                  field.name
                )
                  ? isIndividualOwner(formData)
                  : true)
                  ? "#fff8f8"
                  : "white",
            }}
            autoFocus={field.autoFocus}
          />
        );
    }
  };

  const stepTitles = [
    {
      title: t("vesselOwnerRegistration.Vessel Owner Details"),
      icon: FaBuilding,
    },
    {
      title: t("vesselOwnerRegistration.Authorized Person's Details"),
      icon: FaUser,
    },
    {
      title: t("vesselOwnerRegistration.Documents Upload"),
      icon: FaFileUpload,
    },
  ];

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="registration-container py-5">
        <div
          style={{
            position: "absolute",
            top: "10px",
            right: "10px",
            zIndex: 1050,
          }}
        >
          <Dropdown>
            <Dropdown.Toggle
              variant="link"
              className="p-0 d-flex align-items-center gap-1"
              style={{
                color: "#fff",
                textDecoration: "none",
                fontSize: "1.5rem",
                marginTop: "10px",
              }}
            >
              <FaGlobe />
            </Dropdown.Toggle>
            <Dropdown.Menu className="language-dropdown-menu">
              <Dropdown.Item
                onClick={() => changeLanguage("en")}
                active={language === "en"}
                className="d-flex align-items-center gap-2"
              >
                <FiFlag size={18} style={{ color: "#2563eb" }} />
                <span>English</span>
                {language === "en" && (
                  <FaCheck className="ms-auto text-success" />
                )}
              </Dropdown.Item>
              <Dropdown.Item
                onClick={() => changeLanguage("bn")}
                active={language === "bn"}
                className="d-flex align-items-center gap-2"
              >
                <GiIndiaGate size={18} style={{ color: "#f59e42" }} />
                <span>বাংলা</span>
                {language === "bn" && (
                  <FaCheck className="ms-auto text-success" />
                )}
              </Dropdown.Item>
            </Dropdown.Menu>
          </Dropdown>
        </div>
        <Row className="justify-content-center">
          <Col lg={10} xl={9}>
            <Card className="registration-card">
              <Card.Header className="registration-header p-0">
                <div className="registration-header-content">
                  <div className="header-logo-container">
                    <Image
                      src={IWT_FULL_IMG}
                      alt="IWT Logo"
                      className="header-logo"
                    />
                  </div>
                  <h3 className="header-title">
                    {t("vesselOwnerRegistration.Vessel Owner Registration")}
                  </h3>
                </div>
              </Card.Header>

              <Card.Body className="registration-body p-4 p-md-5">
                {isSubmitted ? (
                  <div className="success-container text-center py-5">
                    <div
                      className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4"
                      style={{
                        width: "90px",
                        height: "90px",
                        boxShadow: "0 10px 20px rgba(40, 167, 69, 0.3)",
                      }}
                    >
                      <FaCheck className="success-icon text-white fs-1" />
                    </div>
                    <h4 className="success-title text-success mb-3 fw-bold">
                      Registration Successful!
                    </h4>
                    <div
                      className="registration-id p-4 bg-light rounded mb-4"
                      // style={{ borderLeft: "4px solid #0077b6" }}
                    >
                      <div className="mb-3">
                        <strong>Registration Number:</strong>
                        <div className="text-primary fs-5 fw-bold mt-2">
                          {applicationData?.userBasicDetails
                            ?.registrationNumber || "N/A"}
                        </div>
                      </div>
                      <p className="mb-0">
                        {successMessage ||
                          //  `Your vessel owner registration has been submitted successfully with Registration Number: ${applicationData?.userBasicDetails?.registrationNumber || "N/A"}. You will receive a confirmation email shortly.`}
                          "Your vessel owner registration has been submitted successfully. You will receive a confirmation email shortly."}
                      </p>
                    </div>
                    {/* <div
                      className="registration-id p-4 bg-light rounded mb-4"
                      // style={{ borderLeft: "4px solid #0077b6" }}
                    >
                      {successMessage ||
                        "Your vessel builder registration has been submitted successfully. You will receive a confirmation email shortly."}
                    </div> */}
                    <Button
                      variant="primary"
                      size="lg"
                      className="mt-2 d-flex align-items-center justify-content-center mx-auto"
                      style={{
                        background: "linear-gradient(135deg, #0077b6, #023e8a)",
                        border: "none",
                        boxShadow: "0 4px 15px rgba(0, 119, 182, 0.3)",
                        borderRadius: "8px",
                        padding: "12px 30px",
                        fontWeight: "600",
                        transition: "all 0.3s ease",
                        minWidth: "150px",
                        height: "50px",
                      }}
                      onClick={() => (window.location.href = "/")}
                    >
                      Go to Home
                    </Button>
                  </div>
                ) : (
                  <FormProvider {...methods}>
                    <form>
                      <div className="stepper-container">
                        <div className="stepper">
                          {[1, 2, 3].map((step, index) => (
                            <React.Fragment key={step}>
                              <div
                                className={`step ${
                                  currentStep >= step ? "active" : ""
                                } ${currentStep > step ? "completed" : ""}`}
                              >
                                <div className="step-circle">
                                  {currentStep > step ? (
                                    <FaCheck size={16} />
                                  ) : (
                                    React.createElement(
                                      stepTitles[step - 1].icon,
                                      { size: 16 }
                                    )
                                  )}
                                </div>
                                <div className="step-label">
                                  {stepTitles[step - 1].title}
                                </div>
                              </div>
                              {index < 2 && (
                                <div
                                  className={`step-connector ${
                                    currentStep > step ? "active" : ""
                                  }`}
                                ></div>
                              )}
                            </React.Fragment>
                          ))}
                        </div>
                      </div>

                      <div className="text-center mb-4">
                        <p className="text-muted">
                          {t(
                            "vesselOwnerRegistration.Please complete all required information to register your vessel"
                          )}
                        </p>
                      </div>

                      <div className="step-content">
                        <div className="form-section p-4 rounded mb-2">
                          <div className="section-title">
                            {React.createElement(
                              stepTitles[currentStep - 1].icon,
                              { className: "section-icon" }
                            )}
                            <h4 className="mb-0 fw-bold">
                              {stepTitles[currentStep - 1].title}
                            </h4>
                          </div>

                          <div className="form-content py-3">
                            <Row className="g-3">
                              {getCurrentStepFields().map((field, index) => (
                                <Col
                                  key={`${field.name}-${isCompany}-${isExemptCategory}`}
                                  md={field.colSize || 12}
                                  className="mb-0"
                                >
                                  <DynamicField field={field} />
                                </Col>
                              ))}

                              {/* For multiple owners input chip testing */}
                              {/* {
                                <Col md={6} className="mb-0">
                                  <InputChip
                                    name="owners"
                                    label="Mutiple Owner Names"
                                    required
                                    initialValues={formData?.owners || []}
                                    tooltipText="Enter names separated by 'Enter' or 'Comma' "
                                    placeholder="Type a Name and press Enter"
                                    register={register}
                                    rules={{
                                      required:
                                        "At least one owner is required",
                                    }}
                                    errors={errors}
                                    clearErrors={clearErrors}
                                    maxChips={10}
                                    onChange={(names) => setOwners(names)}
                                  />
                                </Col>
                              } */}
                            </Row>
                          </div>
                        </div>
                      </div>

                      <div
                        className="form-navigation mt-4"
                        style={{ display: "block" }}
                      >
                        {currentStep > 1 && (
                          <Button
                            variant="outline-secondary"
                            onClick={handlePrevious}
                            className="prev-btn"
                            style={{ float: "left" }}
                          >
                            <FaArrowLeft className="btn-icon me-2" />{" "}
                            {t("Previous")}
                          </Button>
                        )}

                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="next-btn"
                          style={{ float: "right" }}
                        >
                          {currentStep === totalSteps
                            ? t("Submit Registration")
                            : t("Next")}
                          {currentStep !== totalSteps && (
                            <FaArrowRight className="btn-icon ms-2" />
                          )}
                        </Button>
                      </div>
                    </form>
                  </FormProvider>
                )}
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Container>
    </>
  );
};

export default VesselOwnerRegistrationPage;
.registration-container {
  /* background-image: linear-gradient(rgba(36, 102, 191, 0.5), rgba(70, 149, 255, 0.5)),
                    url('../../../assets/images/iwt-wallpaper.png'); */
  /* background-image: url('../../../assets/images/login-bg.jpg');
   */
  background-image: linear-gradient(
      rgba(36, 102, 191, 0.5),
      rgba(70, 149, 255, 0.5)
    ),
    url("../../../assets/images/iwt_bg1.jpg");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  min-height: 100vh;
  overflow-x: hidden;
}

.registration-card {
  transition: all 0.3s ease;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border: none !important;
}

.registration-header {
  border-bottom: none;
  position: relative;
}

.registration-header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.2rem 1.5rem;
  background: linear-gradient(135deg, #ffffff, #f8f9fa);
  border-bottom: 2px solid #0077b6;
  position: relative;
  overflow: hidden;
}

.registration-header-content::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: url("../../../assets/images/iwt-whole.jpg");
  background-size: cover;
  opacity: 0.05;
  z-index: 0;
}

.header-logo-container {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.header-logo {
  height: 70px;
  object-fit: contain;
  margin-right: 20px;
}

.header-title {
  margin: 0;
  font-weight: 700;
  color: #0077b6;
  position: relative;
  z-index: 1;
  font-size: 1.8rem;
  text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.05);
}

.header-title::after {
  content: "";
  position: absolute;
  bottom: -5px;
  left: 0;
  width: 40px;
  height: 3px;
  background: linear-gradient(to right, #dfbe08, #f8d231);
  border-radius: 3px;
}

.form-section {
  transition: all 0.3s ease;
  background-color: rgba(255, 255, 255, 0.9) !important;
  border-radius: 12px;
}

.form-section:hover {
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08) !important;
}

.section-title {
  display: flex;
  align-items: center;
  padding-bottom: 0.75rem;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

.section-icon {
  color: #0077b6;
  margin-right: 0.75rem;
  font-size: 1.5rem;
}

/* Fix for input with icon alignment */
.input-with-icon {
  position: relative;
}

.input-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  color: #0077b6;
}

.custom-input,
.custom-select {
  padding-left: 40px !important;
}

.form-select {
  padding-left: 40px !important;
  background-position: right 0.75rem center !important;
}

/* Stepper styling */
.stepper-container {
  margin-bottom: 2rem;
}

.step-icon {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.step.active .step-icon {
  transform: scale(1.05);
}

.step.completed .step-icon {
  transform: scale(1);
}

.connector-line {
  transition: all 0.5s ease;
}

/* Button styling */
.form-navigation {
  margin-top: 2rem;
}

.prev-btn,
.next-btn {
  min-width: 150px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  border-radius: 8px;
  transition: all 0.3s ease;
}

.next-btn {
  background: linear-gradient(135deg, #0077b6, #023e8a);
  border: none;
  box-shadow: 0 4px 15px rgba(0, 119, 182, 0.3);
}

.next-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 119, 182, 0.4);
}

.prev-btn {
  border: 2px solid #6c757d;
  background: white;
  color: #6c757d;
}

.prev-btn:hover {
  background-color: #5a6268;
  border-color: #f8f9fa;
  color: white;
}

/* Success container styling */
.success-container {
  animation: fadeIn 0.5s ease;
}

.success-icon-container {
  animation: scaleIn 0.5s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes scaleIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .header-title {
    font-size: 1.5rem;
  }

  .header-logo {
    height: 50px;
    margin-right: 15px;
  }

  .registration-header-content {
    padding: 1rem;
  }

  .step-label {
    font-size: 0.8rem !important;
  }

  .step-icon {
    width: 50px !important;
    height: 50px !important;
  }
}

@media (max-width: 576px) {
  .header-title {
    font-size: 1.2rem;
  }

  .header-logo {
    height: 40px;
    margin-right: 10px;
  }

  .form-navigation {
    flex-direction: column;
    gap: 1rem;
  }

  .prev-btn,
  .next-btn {
    width: 100%;
    margin-bottom: 10px;
  }
}
export const OWNER_DOC_CONFIG = {
  baseDocuments: [
    {
      name: "panCardUpload",
      code: "PAN",
      label: "PAN Card",
      labelKey: "PAN Card",
      type: "file",
      required: (formData) =>
        formData?.categoryOfOwner?.toLowerCase() === "indv",
      colSize: 6,
    },
    {
      name: "gstUpload",
      code: "GST",
      label: "GST Certificate",
      labelKey: "GST Certificate",
      type: "file",
      required: () => false,
      colSize: 6,
    },
    {
      name: "tradeLicenseUpload",
      code: "TRADE_LICENSE",
      label: "Trade License",
      labelKey: "Trade License",
      type: "file",
      required: () => false,
      colSize: 6,
    },
  ],

  categoryDocuments: {
    INDV: [
      {
        name: "aadhaarUpload",
        code: "AADHAAR",
        label: "Aadhaar Card",
        labelKey: "Aadhaar Card",
        type: "file",
        required: () => true,
        colSize: 6,
      },
      {
        name: "dlUpload",
        code: "DL",
        label: "Driving License",
        labelKey: "DL",
        type: "file",
        required: () => false,
        colSize: 6,
      },
    ],
    COS: [
      {
        name: "cosRegCertUpload",
        code: "COS_REG_CERT",
        label: "Certificate of Registration of Co-operative Society",
        labelKey: "COS_REG_CERT",
        type: "file",
        required: () => true,
        colSize: 6,
      },
      {
        name: "cosResolutionUpload",
        code: "COS_RESOLUTION",
        label: "Board or General Body Resolution",
        labelKey: "COS_RESOLUTION",
        type: "file",
        required: () => true,
        colSize: 6,
      },
    ],
    BE_COS: [
      {
        name: "beCosRegDocsUpload",
        code: "BE_COS_REG_DOCS",
        label: "Relevant Registration/Incorporation Documents",
        labelKey: "BE_COS_REG_DOCS",
        type: "file",
        required: () => true,
        colSize: 6,
      },
      {
        name: "beCosGovDocsUpload",
        code: "BE_COS_GOV_DOCS",
        label: "Governing Documents",
        labelKey: "BE_COS_GOV_DOCS",
        type: "file",
        required: () => true,
        colSize: 6,
      },
      {
        name: "beCosResolutionUpload",
        code: "BE_COS_RESOLUTION",
        label: "Board Resolution Authorizing Ownership",
        labelKey: "BE_COS_RESOLUTION",
        type: "file",
        required: () => true,
        colSize: 6,
      },
    ],
    COMPANY: [
      {
        name: "compRegCertUpload",
        code: "COMP_REG_CERT",
        label: "Certificate of Registration",
        labelKey: "COMP_REG_CERT",
        type: "file",
        required: () => true,
        colSize: 6,
      },
      {
        name: "compMoaAoaUpload",
        code: "COMP_MOA_AOA",
        label: "Memorandum & Articles of Association",
        labelKey: "COMP_MOA_AOA",
        type: "file",
        required: () => true,
        colSize: 6,
      },
      {
