// Step 3: Certificate of Registration  
if (stepInfo.index === 3) {
  const isValid = await validateCertificateForm();
  if (!isValid) {
    toast.error("Please fill all required fields before proceeding.");
    return;
  }
  
  const success = await handleCertificateSubmit();
  if (success) {
    return; // handleCertificateSubmit already navigates to dashboard
  }
}
