import React from 'react';
import { useFormContext } from 'react-hook-form';
import { Download, CheckCircle, Info, X, UploadCloud } from 'lucide-react';
import { Button, Tooltip, OverlayTrigger } from 'react-bootstrap';

const DynamicField = ({
  fieldConfig,
  register,
  errors,
  setValue,
  trigger,
  getValues,
  control,
}) => {
  const {
    name,
    label,
    type,
    rules = {},
    options = [],
    placeholder = '',
    disabled = false,
    tooltip = '',
    note = '',
    accept = '',
    isUploading = false,
    uploadError = null,
    onFileUpload = () => {},
    setIsUploading = () => {},
    setUploadError = () => {},
    defaultValue = null,
    onChange = () => {},
    inline = false,
    icon = null,
  } = fieldConfig;

  const { watch } = useFormContext();
  const value = watch(name);
  const hasError = errors[name];
  const [uploadSuccess, setUploadSuccess] = React.useState(false);
  const fileInputRef = React.useRef(null);

  const handleFileChange = async (e) => {
    const file = e.target.files[0];
    if (file && fieldConfig.onFileUpload) {
      try {
        fieldConfig.setIsUploading(true);
        fieldConfig.setUploadError(null);
        setUploadSuccess(false);

        const result = await fieldConfig.onFileUpload(file);

        if (result.success) {
          setValue(name, {
            fileId: result.fileId,
            docName: result.docName,
            docType: result.docType,
            docSource: result.docSource,
            fileUrl: result.fileUrl,
            file: file // Keep the original file reference
          }, { shouldValidate: true });
          setUploadSuccess(true);
        }
      } catch (error) {
        fieldConfig.setUploadError(error.message);
        setValue(name, null, { shouldValidate: true });
        setUploadSuccess(false);
      } finally {
        fieldConfig.setIsUploading(false);
      }
    }
  };

  const handleRemoveFile = () => {
    setValue(name, null, { shouldValidate: true });
    setUploadSuccess(false);
    fieldConfig.setUploadError(null);
    if (fileInputRef.current) {
      fileInputRef.current.value = '';
    }
  };

  const renderFilePreview = (fileValue) => {
    if (!fileValue) return null;

    const fileUrl = typeof fileValue === 'object' ? 
      `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileValue.fileId}` : 
      fileValue;

    const fileName = typeof fileValue === 'object' ? 
      fileValue.docName || fileValue.name || 'Uploaded file' : 
      fileValue;

    return (
      <div className="file-preview-container mt-3">
        {uploadSuccess && (
          <div className="text-success d-flex align-items-center gap-2 mb-2">
            <CheckCircle size={16} />
            <span>File uploaded successfully!</span>
          </div>
        )}
        <div className="d-flex align-items-center gap-2 bg-light p-2 rounded border">
          <div className="flex-grow-1 text-truncate" style={{ maxWidth: '200px' }}>
            {fileName}
          </div>
          <div className="d-flex gap-1">
            <Button
              variant="outline-primary"
              size="sm"
              href={fileUrl}
              target="_blank"
              rel="noopener noreferrer"
              download
              className="p-1"
              title="Download file"
            >
              <Download size={16} />
            </Button>
            <Button
              variant="outline-danger"
              size="sm"
              onClick={handleRemoveFile}
              className="p-1"
              title="Remove file"
            >
              <X size={16} />
            </Button>
          </div>
        </div>
      </div>
    );
  };

  const renderSignatureUpload = () => {
    return (
      <div className="signature-upload-container">
        {note && (
          <small className="text-muted d-block mb-2">
            {note}
          </small>
        )}
        
        <input
          type="file"
          id={name}
          onChange={handleFileChange}
          className="d-none"
          disabled={isUploading || disabled}
          accept={accept}
          ref={fileInputRef}
        />
        
        <label
          htmlFor={name}
          className={`d-flex flex-column align-items-center justify-content-center p-4 border-2 rounded border-dashed ${
            isUploading ? 'disabled' : 'cursor-pointer hover:border-primary'
          }`}
          style={{
            borderColor: hasError ? '#dc3545' : '#dee2e6',
            minHeight: '120px',
            backgroundColor: value ? '#f8f9fa' : 'transparent',
          }}
        >
          {value ? (
            <div className="text-center">
              <div className="mb-2">
                <CheckCircle size={24} className="text-success" />
              </div>
              <div className="text-truncate" style={{ maxWidth: '200px' }}>
                {value.docName || value.name || 'Uploaded file'}
              </div>
            </div>
          ) : (
            <>
              <UploadCloud size={24} className="mb-2 text-muted" />
              <div className="text-center">
                <div className="fw-medium">Click to upload signature</div>
                <small className="text-muted">Supports JPG, PNG, PDF (max 5MB)</small>
              </div>
            </>
          )}
        </label>
        
        {isUploading && (
          <div className="mt-2 text-center">
            <div className="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
            <span>Uploading...</span>
          </div>
        )}
        
        {value && renderFilePreview(value)}
        
        {uploadError && (
          <div className="text-danger mt-2 small">
            {uploadError}
          </div>
        )}
      </div>
    );
  };

  const handleRadioChange = (e) => {
    const selectedValue = e.target.value;
    setValue(name, selectedValue, { shouldValidate: true });
    onChange(e);
  };

  const renderTooltip = (text) => (
    <Tooltip id={`tooltip-${name}`}>{text}</Tooltip>
  );

  const renderField = () => {
    switch (type) {
      case 'text':
      case 'email':
      case 'number':
        return (
          <input
            type={type}
            id={name}
            className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
            placeholder={placeholder}
            disabled={disabled}
            {...register(name, rules)}
          />
        );
      case 'textarea':
        return (
          <textarea
            id={name}
            className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
            placeholder={placeholder}
            rows={3}
            {...register(name, rules)}
          />
        );
      case 'select':
        return (
          <select
            id={name}
            className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
            {...register(name, rules)}
          >
            <option value="">{placeholder || 'Select an option'}</option>
            {options.map((option) => (
              <option key={option.value} value={option.value}>
                {option.label}
              </option>
            ))}
          </select>
        );
      case 'radio':
        return (
          <div className={`d-flex ${inline ? 'flex-wrap gap-3' : 'flex-column gap-2'}`}>
            {options.map((option) => (
              <div key={option.value} className="form-check">
                <input
                  type="radio"
                  id={`${name}-${option.value}`}
                  className="form-check-input"
                  style={{
                    backgroundColor: value === option.value ? '#269ccc' : '',
                    borderColor: '#269ccc',
                  }}
                  value={option.value}
                  checked={value === option.value}
                  {...register(name, rules)}
                  onChange={handleRadioChange}
                />
                <label
                  htmlFor={`${name}-${option.value}`}
                  className="form-check-label"
                >
                  {option.label}
                </label>
              </div>
            ))}
          </div>
        );
      case 'file':
        if (name === 'signatureFile') {
          return renderSignatureUpload();
        }
        return (
          <div className="custom-file-input">
            {note && (
              <small className="text-muted d-block mb-2">
                {note}
              </small>
            )}
            <input
              type="file"
              id={name}
              onChange={handleFileChange}
              className="d-none"
              disabled={isUploading || disabled}
              accept={accept}
              ref={fileInputRef}
            />
            <div className="d-flex gap-2">
              <label
                htmlFor={name}
                className={`btn ${isUploading ? 'btn-outline-secondary disabled' : 'btn-outline-primary'}`}
              >
                {isUploading ? (
                  <>
                    <span className="spinner-border spinner-border-sm me-2" role="status"></span>
                    Uploading...
                  </>
                ) : (
                  'Choose File'
                )}
              </label>
              {value && (
                <Button
                  variant="outline-danger"
                  onClick={handleRemoveFile}
                  disabled={isUploading}
                >
                  <X size={16} />
                </Button>
              )}
            </div>
            {value && renderFilePreview(value)}
            {uploadError && (
              <div className="text-danger mt-2 small">
                {uploadError}
              </div>
            )}
          </div>
        );
      default:
        return null;
    }
  };

  return (
    <div className={`mb-3 ${type === 'radio' ? 'radio-field' : ''}`}>
      <label htmlFor={name} className="form-label d-flex align-items-center">
        {icon && <span className="me-2">{icon}</span>}
        {label}
        {tooltip && (
          <OverlayTrigger
            placement="top"
            overlay={renderTooltip(tooltip)}
          >
            <span className="ms-2">
              <Info size={14} className="text-muted" />
            </span>
          </OverlayTrigger>
        )}
      </label>
      {renderField()}
      {errors[name] && (
        <div className="invalid-feedback d-block">
          {errors[name].message}
        </div>
      )}
    </div>
  );
};

export default DynamicField;
