/* Sidebar.css */
:root {
  --sidebar-bg: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
  --sidebar-text: #e2e8f0;
  --sidebar-active: #f8fafc;
  --sidebar-icon: #f59e0b;
  --sidebar-hover: rgba(226, 232, 240, 0.08);
  --sidebar-border: rgba(255, 255, 255, 0.05);
  --sidebar-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --sidebar-width: 280px;
  --sidebar-mini-width: 80px;
  --header-height: 70px;
}

/* Main sidebar styles */
.custom-sidebar {
  background: var(--sidebar-bg);
  color: var(--sidebar-text);
  box-shadow: var(--sidebar-shadow);
  position: fixed;
  top: var(--header-height);
  left: 0;
  height: calc(100vh - var(--header-height));
  width: var(--sidebar-width);
  z-index: 1000;
  transform: translateX(-100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  border-right: 1px solid var(--sidebar-border);
}

.custom-sidebar.expanded {
  transform: translateX(0);
}

.custom-sidebar.collapsed {
  transform: translateX(-100%);
}

.custom-sidebar-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  color: var(--sidebar-icon);
  font-size: 1.25rem;
  cursor: pointer;
  display: none;
  z-index: 2;
  transition: all 0.2s;
}

.custom-sidebar-close:hover {
  color: var(--sidebar-active);
}

/* Mini sidebar styles */
.custom-sidebar.mini {
  width: var(--sidebar-mini-width);
  transform: translateX(0);
  padding: 0;
  align-items: center;
}

.mini-sidebar-logo {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 1.5rem 0 1rem;
}

.mini-logo-img {
  height: 2.5rem;
  border-radius: 8px;
  object-fit: contain;
}

.mini-sidebar-icons {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  margin-top: 1rem;
}

.mini-sidebar-icon {
  color: var(--sidebar-icon);
  font-size: 1.4rem;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 1rem 0;
  cursor: pointer;
  transition: all 0.2s;
  position: relative;
}

.mini-sidebar-icon:hover {
  color: var(--sidebar-active);
  background: var(--sidebar-hover);
}

.mini-sidebar-icon.active {
  color: var(--sidebar-active);
  background: var(--sidebar-hover);
  border-left: 3px solid var(--sidebar-icon);
}

.mini-sidebar-footer {
  margin-top: auto;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 0;
}

.mini-sidebar-expand {
  color: var(--sidebar-icon);
  font-size: 1.25rem;
  cursor: pointer;
  padding: 0.75rem;
  transition: all 0.2s;
  border-radius: 50%;
}

.mini-sidebar-expand:hover {
  background: var(--sidebar-hover);
  color: var(--sidebar-active);
}

/* Sidebar header */
.sidebar-header {
  padding: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  border-bottom: 1px solid var(--sidebar-border);
}

.sidebar-logo-img {
  height: 2.5rem;
  border-radius: 8px;
}

.sidebar-title {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--sidebar-active);
}

/* Menu and submenu */
.custom-sidebar-menu {
  list-style: none;
  padding: 1rem 0;
  margin: 0;
  flex: 1;
}

.custom-sidebar-item {
  margin-bottom: 0.25rem;
}

.custom-sidebar-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1.5rem;
  cursor: pointer;
  transition: all 0.2s;
  font-weight: 500;
  color: var(--sidebar-text);
  text-decoration: none;
}

.custom-sidebar-link:hover,
.custom-sidebar-link:focus {
  background: var(--sidebar-hover);
  color: var(--sidebar-active);
}

.custom-sidebar-link.active {
  background: rgba(245, 158, 11, 0.1);
  color: var(--sidebar-active);
  border-left: 3px solid var(--sidebar-icon);
}

.custom-sidebar-link-content {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.custom-sidebar-icon {
  font-size: 1.2rem;
  color: var(--sidebar-icon);
}

.custom-sidebar-chevron {
  transition: transform 0.2s;
  color: var(--sidebar-icon);
}

.custom-sidebar-chevron.rotate {
  transform: rotate(90deg);
}

.custom-sidebar-submenu {
  background: rgba(255, 255, 255, 0.03);
  padding-left: 3.5rem;
  display: none;
  flex-direction: column;
}

.custom-sidebar-submenu.expanded {
  display: flex;
}

.custom-sidebar-sublink {
  color: var(--sidebar-text);
  padding: 0.65rem 0;
  text-decoration: none;
  font-size: 0.95rem;
  transition: all 0.2s;
}

.custom-sidebar-sublink:hover,
.custom-sidebar-sublink:focus {
  color: var(--sidebar-active);
}

.custom-sidebar-sublink.active {
  color: var(--sidebar-icon);
  font-weight: 500;
}

/* Sidebar footer */
.sidebar-footer {
  margin-top: auto;
  padding: 1.5rem;
  border-top: 1px solid var(--sidebar-border);
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.logout-link {
  display: flex;
  align-items: center;
  gap: 1rem;
  color: var(--sidebar-text);
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s;
}

.logout-link:hover {
  color: #ef4444;
}

.copyright {
  font-size: 0.85rem;
  color: #94a3b8;
  text-align: center;
}

/* Backdrop for mobile */
.custom-sidebar-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  backdrop-filter: blur(2px);
}

/* Responsive styles */
@media (max-width: 900px) {
  .custom-sidebar {
    width: 80vw;
    max-width: 320px;
  }
  
  .custom-sidebar-close {
    display: block;
  }
  
  .custom-sidebar.mini {
    display: none;
  }
}
