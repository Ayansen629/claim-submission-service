const handleSubmit = async () => {
  try {
    loaderRef.current?.show();

    const formData = methods?.getValues();
    let registrationFormData = {};
    if (registrationFormRef?.current?.getFormData) {
      registrationFormData = registrationFormRef?.current?.getFormData();
      // Add file states to registrationFormData
      registrationFormData.fileStates = registrationFormRef?.current?.fileStates;
    }

    const payload = createRegistrationPayload(formData, registrationFormData);

    const apiUrl =
      SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.VESSEL_SERVICE.CREATE;
    const response = await postData(apiUrl, payload);

    if (response?.status === 200 && response?.data?.responseStatus) {
      toast.success(
        response?.data?.responseStatus?.message ||
          "Registration submitted successfully!"
      );
      setDisableSubmit(true);
      setInitialStep(steps.length - 1);
    } else {
      toast.error(
        response?.data?.responseStatus?.message ||
          "Submission failed. Please try again."
      );
    }
  } catch (error) {
    console.error("Submission error:", error);
    toast.error("Failed to submit form. Please try again.");
  } finally {
    loaderRef.current?.hide();
  }
};
