        applicationId: response.data.applicationDetails.applicationNumber,
        formData: updatedFormData
      }
    });
    
    // Also store in localStorage as fallback
    localStorage.setItem("lastSubmittedApplication", response.data.applicationDetails.applicationNumber);
    localStorage.setItem("lastSubmittedFormData", JSON.stringify(updatedFormData));
  } else {
    toast.error(`Failed to submit form: ${response.data.status.message}`);
  }

  // ... rest of the code ...
};

import TrackingPage from './pages/TrackingPage';

// In your routes
<Route path="/tracking" element={<TrackingPage />} />
