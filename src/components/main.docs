// Add this useEffect after the existing ones
useEffect(() => {
    if (!vesselData) return;

    const fieldMappings = {
        "vesselDetails.portOfRegistry": vesselData.portOfRegistry,
        "basicVesselInfo.officialNo": vesselData.registrationNumber,
        "vesselDetails.vesselName": vesselData.vesselName,
        "vesselDetails.typeOfVessel": vesselData.typeOfVessel,
        "vesselDetails.categoryOfVessel": vesselData.categoryOfVessel,
        "vesselDetails.yearOfBuild": vesselData.yearOfBuild,
        "vesselDetails.grossTonnage": vesselData.grossTonnage,
        "vesselDetails.lengthOfVessel": vesselData.lengthOfVessel,
        "vesselDetails.breadthOfVessel": vesselData.breadthOfVessel,
        "vesselDetails.depthOfVessel": vesselData.depthOfVessel,
        "vesselDetails.previousPort": vesselData.previousPort,
        "basicVesselInfo.reasonForTransfer": vesselData.reasonOfChange
    };

    Object.entries(fieldMappings).forEach(([fieldName, value]) => {
        if (value !== null && value !== undefined && value !== "") {
            setValue(fieldName, value);
        }
    });
}, [vesselData, setValue]);
