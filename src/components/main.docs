const ClaimTypeFields = ({ 
  claimType, 
  control, 
  register, 
  errors, 
  setValue, 
  getValues, 
  watch,
  trigger
}) => {
  // ... (keep all existing state and effect hooks)

  // Field icons mapping
  const fieldIcons = {
    claimAmount: <FaMoneyBillWave className="field-icon me-2" />,
    hasSecurityInterest: <FaBalanceScale className="field-icon me-2" />,
    securityValue: <FaMoneyBillWave className="field-icon me-2" />,
    securityDate: <FaCalendarAlt className="field-icon me-2" />,
    hasGuarantee: <FaHandshake className="field-icon me-2" />,
    guaranteeValue: <FaMoneyBillWave className="field-icon me-2" />,
    guaranteeDate: <FaCalendarAlt className="field-icon me-2" />,
    name: <FaUser className="field-icon me-2" />,
    address: <FaMapMarkerAlt className="field-icon me-2" />
  };

  // Common claim fields with icons
  const commonClaimFields = [
    {
      name: "claimAmount",
      label: "Amount of claim",
      type: "number",
      icon: fieldIcons.claimAmount,
      rules: { 
        required: "Claim amount is required",
        min: { value: 1, message: "Amount must be greater than 0" }
      },
      placeholder: "Enter claim amount"
    }
  ];

  // Additional fields with icons
  const additionalFields = [
    {
      name: "hasSecurityInterest",
      label: "Amount covered by security interest",
      type: "radio",
      icon: fieldIcons.hasSecurityInterest,
      options: [
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" }
      ],
      rules: { required: "This field is required" },
      onChange: handleSecurityInterestChange,
      show: claimType !== "BENEFICIARY"
    },
    {
      name: "securityValue",
      label: "Value of the security",
      type: "number",
      icon: fieldIcons.securityValue,
      rules: showSecurityFields ? { 
        required: "Security value is required",
        min: { value: 1, message: "Value must be greater than 0" }
      } : {},
      placeholder: "Enter security value",
      show: showSecurityFields && claimType !== "BENEFICIARY"
    },
    {
      name: "securityDate",
      label: "Date of the security",
      type: "date",
      icon: fieldIcons.securityDate,
      rules: showSecurityFields ? { 
        required: "Security date is required",
        validate: value => {
          const today = new Date().toISOString().split('T')[0];
          return value <= today || "Date cannot be in the future";
        }
      } : {},
      placeholder: "Select security date",
      show: showSecurityFields && claimType !== "BENEFICIARY"
    },
    {
      name: "hasGuarantee",
      label: "Amount covered by guarantee",
      type: "radio",
      icon: fieldIcons.hasGuarantee,
      options: [
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" }
      ],
      rules: { required: "This field is required" },
      onChange: handleGuaranteeChange,
      show: claimType !== "BENEFICIARY"
    },
    {
      name: "guaranteeValue",
      label: "Value of the guarantee",
      type: "number",
      icon: fieldIcons.guaranteeValue,
      rules: showGuaranteeFields ? { 
        required: "Guarantee value is required",
        min: { value: 1, message: "Value must be greater than 0" }
      } : {},
      placeholder: "Enter guarantee value",
      show: showGuaranteeFields && claimType !== "BENEFICIARY"
    },
    {
      name: "guaranteeDate",
      label: "Date of the guarantee",
      type: "date",
      icon: fieldIcons.guaranteeDate,
      rules: showGuaranteeFields ? { 
        required: "Guarantee date is required",
        validate: value => {
          const today = new Date().toISOString().split('T')[0];
          return value <= today || "Date cannot be in the future";
        }
      } : {},
      placeholder: "Select guarantee date",
      show: showGuaranteeFields && claimType !== "BENEFICIARY"
    }
  ];

  // ... (keep getEntityFieldLabels function)

  return (
    <div className="form-section">
      {/* Common claim field */}
      <div className="row g-0 mb-3">
        {commonClaimFields.map((field) => (
          <div key={field.name} className="col-md-6 pe-2">
            <div className="form-group mb-0">
              <label className="form-label d-flex align-items-center">
                {field.icon}
                {field.label} {field.rules?.required && <span className="required-asterisk">*</span>}
              </label>
              <DynamicField
                fieldConfig={field}
                control={control}
                register={register}
                errors={errors}
                setValue={setValue}
                getValues={getValues}
                watch={watch}
              />
            </div>
          </div>
        ))}
      </div>

      {/* Additional fields in tight two-column layout */}
      {additionalFields.map((field, index) => (
        field.show !== false && (
          <div key={field.name} className={`row g-0 ${index < additionalFields.length - 1 ? 'mb-3' : ''}`}>
            <div className="col-md-6 pe-2">
              <div className="form-group mb-0">
                <label className="form-label d-flex align-items-center">
                  {field.icon}
                  {field.label} {field.rules?.required && <span className="required-asterisk">*</span>}
                </label>
                <DynamicField
                  fieldConfig={field}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  getValues={getValues}
                  watch={watch}
                />
              </div>
            </div>
          </div>
        )
      ))}

      {/* Entity fields in tight two-column layout */}
      {entityData.map((entity, index) => (
        <div key={entity.id} className="entity-field-group mb-3 p-3 border rounded bg-light">
          <div className="d-flex justify-content-between align-items-center mb-2">
            <h6 className="mb-0">
              {claimType === "GUARANTOR" ? "Principal Borrower" : 
               claimType === "PRINCIPAL_BORROWER" ? "Guarantor" : "Beneficiary"} {index + 1}
            </h6>
            {entityData.length > 1 && (
              <button
                type="button"
                className="btn btn-sm btn-danger"
                onClick={() => removeEntityField(entity.id)}
              >
                <FaMinus className="me-1" /> Remove
              </button>
            )}
          </div>
          
          <div className="row g-0">
            <div className="col-md-6 pe-2">
              <div className="form-group mb-0">
                <label className="form-label d-flex align-items-center">
                  {fieldIcons.name}
                  {nameLabel} <span className="required-asterisk">*</span>
                </label>
                <input
                  type="text"
                  className={`form-control ${errors.entityData?.[index]?.name ? "is-invalid" : ""}`}
                  value={entity.name || ""}
                  onChange={(e) => updateEntityDetails(entity.id, "name", e.target.value)}
                  placeholder={`Enter ${nameLabel.toLowerCase()}`}
                />
                {errors.entityData?.[index]?.name && (
                  <div className="invalid-feedback">{errors.entityData[index].name.message}</div>
                )}
              </div>
            </div>
            
            <div className="col-md-6">
              <div className="form-group mb-0">
                <label className="form-label d-flex align-items-center">
                  {fieldIcons.address}
                  {addressLabel} <span className="required-asterisk">*</span>
                </label>
                <input
                  type="text"
                  className={`form-control ${errors.entityData?.[index]?.address ? "is-invalid" : ""}`}
                  value={entity.address || ""}
                  onChange={(e) => updateEntityDetails(entity.id, "address", e.target.value)}
                  placeholder={`Enter ${addressLabel.toLowerCase()}`}
                />
                {errors.entityData?.[index]?.address && (
                  <div className="invalid-feedback">{errors.entityData[index].address.message}</div>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}

      <button 
        type="button" 
        className="btn btn-outline-primary btn-sm add-more-btn mt-2"
        onClick={addEntityField}
      >
        <FaPlus className="me-2" /> Add {claimType === "GUARANTOR" ? "Principal Borrower" : 
                      claimType === "PRINCIPAL_BORROWER" ? "Guarantor" : "Beneficiary"}
      </button>
    </div>
  );
};
