.registrationCertificateContainer {
  background: white;
  border: 2px solid #2466BF;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 12px rgba(36, 102, 191, 0.15);
  margin-top: 1rem;
}

.certificateHeader {
  background: linear-gradient(135deg, #2466BF 0%, #1a4fa0 100%);
  padding: 1.5rem;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.certificateHeader::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, #4facfe, #00f2fe, #2466BF);
}

.certificateTitle {
  color: white;
  font-weight: 700;
  font-size: 1.5rem;
  margin: 0;
  letter-spacing: 1px;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.certificateSubtitle {
  color: rgba(255, 255, 255, 0.9);
  font-size: 0.9rem;
  margin-top: 0.5rem;
}

.certificateBody {
  padding: 2rem;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
}

/* Expiry and Issued Sections */
.expirySection, .issuedBySection {
  text-align: center;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  padding: 1.25rem;
  border-radius: 8px;
  border: 1px solid #dee2e6;
  margin-bottom: 1.5rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.expiryLabel, .issuedLabel {
  font-weight: 700;
  color: #2466BF;
  font-size: 1.1rem;
  margin-right: 0.5rem;
}

.expiryLabel.required::after, .issuedLabel.required::after {
  content: '*';
  color: #dc3545;
  margin-left: 4px;
}

.editableDate {
  border: 2px solid #2466BF;
  border-radius: 6px;
  padding: 0.5rem;
  font-size: 1rem;
  margin-left: 0.5rem;
  width: 140px;
  font-weight: 600;
  color: #2466BF;
  transition: all 0.3s ease;
}

.editableDate:focus {
  outline: none;
  border-color: #1a4fa0;
  box-shadow: 0 0 0 3px rgba(36, 102, 191, 0.1);
}

.editableDate.error {
  border-color: #dc3545;
  box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1);
}

/* Section Titles */
.sectionTitle {
  color: #2466BF;
  font-weight: 800;
  font-size: 1.3rem;
  text-align: center;
  margin: 2rem 0 1.5rem 0;
  text-transform: uppercase;
  letter-spacing: 1px;
  border-bottom: 3px solid #2466BF;
  padding-bottom: 0.75rem;
  position: relative;
}

.sectionTitle::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: 3px;
  background: linear-gradient(90deg, #4facfe, #00f2fe);
}

/* Table Styles */
.particularsTable {
  font-size: 0.85rem;
  margin-bottom: 2rem;
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.particularsTable th,
.particularsTable td {
  padding: 0.75rem;
  text-align: center;
  vertical-align: middle;
  border: 1px solid #dee2e6;
}

.labelCell {
  background: linear-gradient(135deg, #2466BF 0%, #1a4fa0 100%);
  color: white;
  font-weight: 700;
  text-transform: uppercase;
  font-size: 0.8rem;
  letter-spacing: 0.5px;
  width: 12.5%;
}

.autoPopulateCell {
  background: #f8f9fa;
  color: #2c5282;
  font-weight: 600;
  padding: 0.75rem;
}

.autoPopulateCell.highlight {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  color: #1a4fa0;
  font-weight: 700;
}

.editableCell {
  background: #fff8e1;
  padding: 0.5rem;
  position: relative;
}

.editableCell input {
  border: 2px solid #ffc107;
  border-radius: 4px;
  padding: 0.5rem;
  width: 100%;
  text-align: center;
  font-size: 0.85rem;
  font-weight: 600;
  color: #2c5282;
  transition: all 0.3s ease;
}

.editableCell input:focus {
  outline: none;
  border-color: #2466BF;
  box-shadow: 0 0 0 3px rgba(36, 102, 191, 0.1);
}

.editableCell input.error {
  border-color: #dc3545;
  box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1);
}

/* Error Messages */
.errorMessage {
  color: #dc3545;
  font-size: 0.75rem;
  margin-top: 0.25rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.errorMessage::before {
  content: '⚠';
  font-size: 0.875rem;
}

/* Survey Note */
.surveyNote {
  background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
  border: 2px solid #ffc107;
  padding: 1.5rem;
  border-radius: 8px;
  text-align: center;
  margin: 1.5rem 0;
  box-shadow: 0 2px 8px rgba(255, 193, 7, 0.2);
}

.noteText {
  margin: 0;
  font-weight: 700;
  color: #856404;
  font-size: 1rem;
}

/* Textarea for Detailed Summary */
.detailedSummary {
  margin: 1.5rem 0;
}

.detailedSummary textarea {
  width: 100%;
  border: 2px solid #2466BF;
  border-radius: 8px;
  padding: 1rem;
  font-size: 0.9rem;
  font-weight: 500;
  color: #2c5282;
  resize: vertical;
  min-height: 120px;
  transition: all 0.3s ease;
}

.detailedSummary textarea:focus {
  outline: none;
  border-color: #1a4fa0;
  box-shadow: 0 0 0 3px rgba(36, 102, 191, 0.1);
}

.detailedSummary textarea.error {
  border-color: #dc3545;
  box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1);
}

/* Crew Section */
.crewSection {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  padding: 1.5rem;
  border-radius: 8px;
  border-left: 4px solid #2466BF;
  margin: 1.5rem 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.crewInfo {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.crewLabel {
  font-weight: 700;
  color: #2c5282;
  font-size: 1.1rem;
}

.crewValue {
  font-weight: 800;
  color: #2466BF;
  font-size: 1.3rem;
  background: white;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  border: 2px solid #2466BF;
}

/* Certification Statement */
.certificationStatement {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  padding: 2rem;
  border-radius: 8px;
  border-left: 4px solid #2466BF;
  margin: 2rem 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.statementText {
  text-align: justify;
  line-height: 1.7;
  margin: 0;
  color: #2d3748;
  font-size: 1rem;
}

.statementText strong {
  color: #2466BF;
  font-weight: 700;
}

/* Owner Table */
.ownerTable {
  font-size: 0.9rem;
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  margin: 2rem 0;
}

.ownerHeader, .sharesHeader {
  background: linear-gradient(135deg, #2466BF 0%, #1a4fa0 100%);
  color: white;
  text-align: center;
  font-weight: 700;
  padding: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.ownerInfo {
  padding: 1.5rem;
  line-height: 1.8;
  background: #f8f9fa;
  border-right: 1px solid #dee2e6;
}

.ownerInfo div {
  margin-bottom: 0.75rem;
}

.ownerInfo strong {
  color: #2466BF;
  font-weight: 700;
}

.sharesCell {
  background: #e8f4fd;
  padding: 1rem;
  text-align: center;
  vertical-align: middle;
}

.sharesValue {
  font-weight: 800;
  color: #2466BF;
  font-size: 1.2rem;
  background: white;
  padding: 0.75rem;
  border-radius: 6px;
  border: 2px solid #2466BF;
  display: inline-block;
  min-width: 80px;
}

/* Checkbox for Tenth Shares */
.tenthSharesCheckbox {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.tenthSharesCheckbox input {
  width: 18px;
  height: 18px;
  border: 2px solid #2466BF;
  border-radius: 3px;
}

.tenthSharesCheckbox label {
  font-weight: 600;
  color: #2c5282;
  font-size: 0.9rem;
}

/* Validation Summary */
.validationSummary {
  background: #f8d7da;
  border: 1px solid #f5c6cb;
  border-radius: 6px;
  padding: 1rem;
  margin-bottom: 1.5rem;
}

.validationSummaryTitle {
  color: #721c24;
  font-weight: 700;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.validationSummaryTitle::before {
  content: '⚠';
  font-size: 1.1rem;
}

.validationSummaryList {
  margin: 0;
  padding-left: 1.5rem;
  color: #721c24;
}

.validationSummaryItem {
  font-size: 0.875rem;
  margin-bottom: 0.25rem;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .particularsTable {
    font-size: 0.8rem;
  }
  
  .labelCell, .autoPopulateCell, .editableCell {
    padding: 0.5rem;
  }
}

@media (max-width: 992px) {
  .certificateBody {
    padding: 1.5rem;
  }
  
  .particularsTable {
    display: block;
    overflow-x: auto;
  }
  
  .crewInfo {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
}

@media (max-width: 768px) {
  .certificateHeader {
    padding: 1rem;
  }
  
  .certificateTitle {
    font-size: 1.2rem;
  }
  
  .certificateBody {
    padding: 1rem;
  }
  
  .expirySection, .issuedBySection {
    padding: 1rem;
  }
  
  .expiryLabel, .issuedLabel {
    font-size: 1rem;
    display: block;
    margin-bottom: 0.5rem;
  }
  
  .editableDate {
    margin-left: 0;
    width: 100%;
    max-width: 200px;
  }
  
  .sectionTitle {
    font-size: 1.1rem;
    margin: 1.5rem 0 1rem 0;
  }
  
  .ownerTable {
    font-size: 0.8rem;
  }
  
  .ownerInfo, .sharesCell {
    padding: 1rem;
  }
}

@media (max-width: 576px) {
  .registrationCertificateContainer {
    border-radius: 8px;
    margin-top: 0.5rem;
  }
  
  .certificateTitle {
    font-size: 1.1rem;
  }
  
  .certificateSubtitle {
    font-size: 0.8rem;
  }
  
  .sectionTitle {
    font-size: 1rem;
  }
  
  .statementText {
    font-size: 0.9rem;
    line-height: 1.6;
  }
  
  .ownerInfo div {
    font-size: 0.85rem;
  }
  
  .sharesValue {
    font-size: 1.1rem;
    padding: 0.5rem;
  }
}
