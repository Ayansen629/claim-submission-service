import React, { useState, useEffect } from 'react';
import { useForm } from 'react-hook-form';
import { Link, useNavigate } from 'react-router-dom';
import { toast } from 'react-toastify';
import 'react-toastify/dist/ReactToastify.css';
import './CorporateRegister.css'; // Assuming you have a CSS file for styling

const CorporateDebtorRegister = () => {
  const navigate = useNavigate();
  const [loading, setLoading] = useState(false);
  const [processTypesFromApi, setProcessTypesFromApi] = useState([]);

  const {
    register,
    handleSubmit,
    watch,
    formState: { errors, isValid, isDirty }
  } = useForm({
    mode: 'onChange'
  });

  useEffect(() => {
    // Function to fetch process types from the API
    const fetchProcessTypes = async () => {
      try {
        const apiUrl = '/cms/claimantsMasterData';
        const requestBody = {
          "debtorsUuid": "",
          "processTypeUuid": "",
          "processTypeValue": "",
          "claimantTypeUuid": "",
          "claimantCategoryUuid": "",
          "formUuid": ""
        };

        const response = await fetch(apiUrl, {
          method: 'POST', // Assuming it's a POST request based on the body
          headers: {
            'Content-Type': 'application/json',
            // Add any other necessary headers like authorization tokens
          },
          body: JSON.stringify(requestBody),
        });

        if (!response.ok) {
          const errorData = await response.json();
          console.error('Error fetching process types:', errorData);
          toast.error('Failed to load process types.');
          return;
        }

        const data = await response.json();
        if (data && data.claimantMasterData && data.claimantMasterData.processTypes) {
          setProcessTypesFromApi(data.claimantMasterData.processTypes);
        } else {
          console.warn('Process types not found in the API response.');
          toast.warn('Could not find process types.');
        }

      } catch (error) {
        console.error('Error fetching process types:', error);
        toast.error('An error occurred while loading process types.');
      }
    };

    fetchProcessTypes();
  }, []); // Empty dependency array ensures this runs only once after the initial render

  // const processTypeOptions = [
  //   { value: 'CIRP', label: 'Corporate Insolvency Resolution Process (CIRP)' },
  //   { value: 'Liquidation', label: 'Liquidation' },
  //   { value: 'VoluntaryLiquidation', label: 'Voluntary Liquidation' },
  //   { value: 'PPIRP', label: 'Pre-Packaged Insolvency Resolution Process (PPIRP)' },
  // ];

  const onSubmit = async (data) => {
    console.log('Form Data:', data);
    setLoading(true);
    setTimeout(() => {
      console.log('Registration Data:', {
        name: data.name,
        email: data.email,
        // mobile: data.mobile,
        cin: data.cin,
        processType: data.processType
      });
      toast.success('Registration successful!');
      setLoading(false);
      navigate('/login');
    }, 1500);
  };

  const password = watch("password");

  return (
    <div className='register-page'>
      <div className="register-container">
        <div className="register-header">
          <h1 className="register-textmain">Corporate Debtor Registration</h1>
        </div>

        <form className="register-form" onSubmit={handleSubmit(onSubmit)}>
          {/* Name */}
          <div className="form-group">
            <input
              type="text"
              {...register("name", { required: "Company name is required" })}
              placeholder="Company Name"
              className="user-input"
            />
            {errors.name && <span className="error">{errors.name.message}</span>}
          </div>

          {/* Email */}
          <div className="form-group">
            <input
              type="email"
              {...register("email", {
                required: "Email is required",
                pattern: {
                  value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                  message: "Invalid email address"
                }
              })}
              placeholder="Email ID"
              className="user-input"
            />
            {errors.email && <span className="error">{errors.email.message}</span>}
          </div>

          {/* Mobile Number */}
          {/* <div className="form-group">
            <input
              type="tel"
              {...register("mobile", {
                required: "Mobile number is required",
                pattern: {
                  value: /^[6-9]\d{9}$/,
                  message: "Invalid Indian mobile number"
                }
              })}
              placeholder="Mobile Number"
              className="user-input"
            />
            {errors.mobile && <span className="error">{errors.mobile.message}</span>}
          </div> */}

          {/* CIN Number */}
          <div className="form-group">
            <input
              type="text"
              {...register("cin", {
                // required: "CIN is required",
                // pattern: {
                //    value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
                //    message: "Invalid CIN format (e.g., U12345AB6789CDE12345)"
                // }
              })}
              placeholder="CIN Number"
              className="user-input"
            />
            {errors.cin && <span className="error">{errors.cin.message}</span>}
          </div>

          {/* Process Type */}
          <div className="form-group">
            <select
              className="dropdown-select"
              {...register("processType", { required: "Process type is required" })}
            >
              <option value="">Select Process Type</option>
              {processTypesFromApi.map(opt => (
                <option key={opt.uuid} value={opt.processTypeValue}>{opt.processTypeName}</option>
              ))}
            </select>
            {errors.processType && <span className="error">{errors.processType.message}</span>}
          </div>

          {/* Password */}
          <div className="form-group">
            <input
              type="password"
              {...register("password", {
                required: "Password is required",
                minLength: {
                  value: 8,
                  message: "Password must be at least 8 characters"
                }
              })}
              placeholder="Password"
              className="user-input"
            />
            {errors.password && <span className="error">{errors.password.message}</span>}
          </div>

          {/* Confirm Password */}
          <div className="form-group">
            <input
              type="password"
              {...register("confirmPassword", {
                required: "Please confirm your password",
                validate: value =>
                  value === password || "Passwords do not match"
              })}
              placeholder="Confirm Password"
              className="user-input"
            />
            {errors.confirmPassword && <span className="error">{errors.confirmPassword.message}</span>}
          </div>

          {/* Register Button */}
          <button
            type="submit"
            className="register-btn"
            disabled={!isValid || loading}
          >
            {loading ? "Registering..." : "Register"}
          </button>
        </form>

        <div className="login-link">
          Already have an account? <Link to="/login">Login here</Link>
        </div>
      </div>
    </div>
  );
};

export default CorporateDebtorRegister;
