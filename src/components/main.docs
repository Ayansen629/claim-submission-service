import React from "react";
import Select from "react-select";
import { Form } from "react-bootstrap";
import { useController } from "react-hook-form";

interface InputSelectProps {
  label: string;
  required?: boolean;
  name: string;
  options: Array<{ value: string | number; label: string }>;
  register?: any;
  errors?: any;
  disabled?: boolean;
  onChange?: (value: string | number, selObj?: any) => void;
  className?: string;
  style?: React.CSSProperties;
  icon?: React.ElementType;
  value?: any;
  isMulti?: boolean;
  isClearable?: boolean;
  placeholder?: string;
  control?: any;
  defaultValue?: any;
}

const InputSelect: React.FC<InputSelectProps> = ({
  label,
  required,
  name,
  options,
  register,
  errors = {},
  disabled,
  onChange,
  className = "",
  style = {},
  icon: IconComponent,
  value,
  isMulti = false,
  isClearable = false,
  placeholder = "-- Select --",
  control,
  defaultValue,
}) => {
  const {
    field: { onChange: controllerOnChange, onBlur, value: controllerValue, ref },
  } = useController({
    name,
    control,
    defaultValue: defaultValue || "",
  });

  const isControlled = control !== undefined;
  const currentValue = isControlled ? controllerValue : value;

  const selectedOption = options.find(
    (opt) => String(opt.value) === String(currentValue)
  ) || null;

  const handleChange = (selected: any) => {
    const selectedValue = selected ? selected.value : "";
    
    if (isControlled) {
      controllerOnChange(selectedValue);
    } else if (onChange) {
      onChange(selectedValue, selected);
    }
  };

  const menuPortalStyles = {
    menuPortal: (base: any) => ({ ...base, zIndex: 9999 }),
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold d-block">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>

      <div className="position-relative">
        {IconComponent && (
          <div
            className={`input-icon position-absolute ${
              errors[name] ? "text-danger" : currentValue ? "text-success" : "text-primary"
            }`}
            style={{
              left: "10px",
              top: "50%",
              transform: "translateY(-50%)",
              zIndex: 2,
            }}
          >
            <IconComponent size={18} />
          </div>
        )}

        <Select
          options={options}
          value={selectedOption}
          onChange={handleChange}
          isDisabled={disabled}
          isMulti={isMulti}
          placeholder={placeholder}
          isClearable={isClearable}
          className={`react-select-container ${errors[name] ? "is-invalid" : ""}`}
          classNamePrefix="react-select"
          menuPosition="fixed"
          menuPlacement="auto"
          menuShouldScrollIntoView={true}
          menuPortalTarget={typeof document !== "undefined" ? document.body : undefined}
          styles={{
            control: (base, state) => ({
              ...base,
              borderColor: errors[name]
                ? "#dc3545"
                : state.isFocused
                ? "#80bdff"
                : "#ced4da",
              boxShadow:
                state.isFocused && !errors[name]
                  ? "0 0 0 0.2rem rgba(0, 123, 255, 0.25)"
                  : "none",
              paddingLeft: IconComponent ? "40px" : "12px",
              backgroundColor: errors[name] ? "#fff8f8" : "white",
              minHeight: "calc(1.5em + 1rem + 2px)",
              "&:hover": {
                borderColor: errors[name] ? "#dc3545" : "#ced4da",
              },
            }),
            ...menuPortalStyles,
          }}
          ref={ref}
          onBlur={onBlur}
        />
      </div>

      {errors[name] && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name].message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;
