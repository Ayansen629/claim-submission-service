import React, { useCallback, useState, useEffect } from "react";
import { useForm, FormProvider, Controller } from "react-hook-form";
import DatePicker from "react-datepicker";
import "react-datepicker/dist/react-datepicker.css";
import Collapsible from "../formCommon/Collapsible"; // Assuming this is in a relative path
import Tooltip from "@mui/material/Tooltip"; // Ensure @mui/material is installed: npm install @mui/material
import { FaInfoCircle } from "react-icons/fa"; // Ensure react-icons is installed: npm install react-icons
import { uploadDocument } from "../../../../services/documentUploadService"; // Assuming this service exists and is correctly located

// Dynamic field renderer component
const DynamicField = ({ fieldConfig, control, register, errors, setValue, trigger, getValues, watch }) => {
  const { name, label, type, options, rules, tooltip, placeholder, accept, isMultiFile } = fieldConfig; // Added isMultiFile

  // Check if the field has an error
  const hasError = errors[name];

  // Allow only valid numeric keys
  const handleKeyPress = (e) => {
    if (type === "number" && !/^\d$/.test(e.key) && e.key !== "Backspace") {
      e.preventDefault();
    }
  };

  const handleFileChange = async (e) => {
    const files = e.target.files;

    if (files && files.length > 0) {
      if (isMultiFile) {
        // Handle multiple file upload
        const fileData = [];
        let allUploadsSuccessful = true;
        let firstError = null;

        for (let i = 0; i < files.length; i++) {
          const file = files[i];
          try {
            fieldConfig.setIsUploading(true);
            fieldConfig.setUploadError(null);
            const result = await fieldConfig.onFileUpload(file); // Await here

            if (result && result.success) {
              fileData.push({
                fileId: result.fileId,
                docName: result.docName,
                docType: result.docType,
                docSource: result.docSource,
                fileUrl: result.fileUrl,
              });
            } else if (result && result.error) {
              allUploadsSuccessful = false;
              firstError = result.error; // Store the first error
              break; // Exit the loop on first error
            } else {
              allUploadsSuccessful = false;
              firstError = "File upload failed.";
              break;
            }
          } catch (error) {
            allUploadsSuccessful = false;
            firstError = error.message || "An unexpected error occurred during upload.";
            break; // Exit on exception
          } finally {
            fieldConfig.setIsUploading(false);
          }
        }

        if (allUploadsSuccessful) {
          setValue(name, fileData, { shouldValidate: true });
        } else {
          fieldConfig.setUploadError(firstError); // Set the error message
          setValue(name, [], { shouldValidate: true }); // Clear the field
        }
      }
       else {
        // Handle single file upload
        try {
          fieldConfig.setIsUploading(true);
          fieldConfig.setUploadError(null);
          const result = await fieldConfig.onFileUpload(files[0]);

          if (result && result.success) {
            setValue(name, {
              fileId: result.fileId,
              docName: result.docName,
              docType: result.docType,
              docSource: result.docSource,
              fileUrl: result.fileUrl,
            }, { shouldValidate: true });
          } else if (result && result.error) {
            fieldConfig.setUploadError(result.error);
            setValue(name, null, { shouldValidate: true });
          }
           else {
            fieldConfig.setUploadError("File upload failed.");
            setValue(name, null, { shouldValidate: true });
          }
        } catch (error) {
          fieldConfig.setUploadError(error.message || "An unexpected error occurred during upload.");
          setValue(name, null, { shouldValidate: true });
        } finally {
          fieldConfig.setIsUploading(false);
        }
      }
    }
  };

  // Render different input types
  return (
    <div className="flex-item">
      <label>
        {label}
        {tooltip && (
          <Tooltip title={tooltip} arrow>
            <span style={{ marginLeft: "5px", cursor: "pointer" }}>
              <FaInfoCircle />
            </span>
          </Tooltip>
        )}
      </label>
      {type === "select" ? (
        <Controller
          name={name}
          control={control}
          rules={rules}
          render={({ field }) => (
            <select
              {...field}
              className={`form-input ${hasError ? "input-error" : ""}`}
              onChange={(e) => {
                field.onChange(e);
                if (fieldConfig.onChange) fieldConfig.onChange(e.target.value);
              }}
            >
              <option value="" disabled>
                {placeholder || `Select ${label}`}
              </option>
              {options.map((option) => (
                <option key={option.value} value={option.value}>
                  {option.label}
                </option>
              ))}
            </select>
          )}
        />
      ) : type === "date" ? (
        <Controller
          name={name}
          control={control}
          rules={rules}
          render={({ field }) => (
            <DatePicker
              {...field}
              selected={field.value}
              onChange={(date) => {
                setValue(name, date);
                trigger(name);
              }}
              className={`form-input ${hasError ? "input-error" : ""}`}
              dateFormat="yyyy-MM-dd"
              placeholderText={placeholder || "Select a date"}
            />
          )}
        />
      ) : type === "file" ? (
        <div className="custom-file-input">
          <input
            type="file"
            id={name}
            onChange={handleFileChange}
            className={`form-input ${hasError ? "input-error" : ""}`}
            style={{ display: "none" }}
            disabled={fieldConfig.isUploading}
            accept={accept}
            multiple={isMultiFile} // Set multiple attribute
          />
          <label
            htmlFor={name}
            className={`file-label ${hasError ? "input-error" : ""} ${fieldConfig.isUploading ? "uploading" : ""}`}
          >
            {fieldConfig.isUploading ? "Uploading..." : "Choose File"}
          </label>

          {/* Display file name(s) */}
          {isMultiFile ? (
            getValues(name) && Array.isArray(getValues(name)) && getValues(name).length > 0 && (
              <div style={{ marginTop: "8px" }}>
                <div>
                  Files:
                  {getValues(name)
                    .map((file, index) => (
                      <span key={index}>
                        {file.docName || file.name}
                        {index < getValues(name).length - 1 ? ", " : ""}
                      </span>
                    ))
                    .join("")}
                </div>
              </div>
            )
          ) : (
            getValues(name)?.docName && !fieldConfig.isUploading && (
              <div style={{ marginTop: "8px" }}>
                <div>File: {getValues(name).docName}</div>
              </div>
            )
          )}
          {!isMultiFile && getValues(name)?.name && !fieldConfig.isUploading && !getValues(name)?.docName && (
            <div style={{ marginTop: "8px" }}>
              <div>File: {getValues(name).name}</div>
            </div>
          )}

          {fieldConfig.uploadError && <p className="error-message">{fieldConfig.uploadError}</p>}
          {hasError && !fieldConfig.uploadError && <p className="error-message">{errors[name]?.message}</p>}
        </div>
      ) : (
        // Default input
        <input
          {...register(name, rules)}
          type={type}
          className={`form-input ${hasError ? "input-error" : ""}`}
          onChange={(e) => {
            setValue(name, e.target.value);
            trigger(name);
          }}
          onKeyPress={handleKeyPress} // Restrict input for numeric fields
          placeholder={placeholder || `Enter ${label.toLowerCase()}`}
        />
      )}
      {hasError && <p className="error-message">{errors[name]?.message}</p>}
    </div>
  );
};

// Main form component
const FormCDetails = ({ provideSubmitHandler, formData }) => {
  const [isUploading, setIsUploading] = useState(false);
  const [uploadError, setUploadError] = useState(null);
  const [activeSection, setActiveSection] = useState("principalBorrower"); // Default active section
  const methods = useForm();
  const { register, handleSubmit, formState: { errors }, trigger, clearErrors, setValue, control, getValues, watch } = methods;

  // Function to handle form submission
  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    if (!isValid) {
      console.error("Validation failed");
      return false;
    }
    return getValues();
  }, [trigger, getValues]);

  // Populate form with initial data
  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        setValue(key, formData[key]);
      });
    }
  }, [formData, setValue]);

  // Function to handle file upload using the provided service
    const handleFileUpload = async (file) => {
    try {
      const result = await uploadDocument(file, 'addressProofDocument');
      return result;
    } catch (error) {
      console.error("Error uploading file:", error);
      return { success: false, error: "File upload failed" }; // Consistent error return
    }
  };

  // Provide submit handler to parent component
  useEffect(() => {
    if (provideSubmitHandler) {
      provideSubmitHandler(onSubmit);
    }
  }, [provideSubmitHandler, onSubmit]);

  // Field configurations for each section of the form
  const claimDetailsSchema = [
    {
      name: "securityInterestAmount",
      label: <>Security Interest Amount <span className="required-asterisk">*</span></>,
      type: "number",
      rules: { required: "Security interest amount is required" },
      tooltip: "Amount of claim covered by security interest, if any (Please provide details of security interest, the value of the security, and the date it was given)",
      placeholder: "Enter security interest amount",
    },
    {
      name: "guaranteeAmount",
      label: <>Guarantee Amount <span className="required-asterisk">*</span></>,
      type: "number",
      rules: { required: "Guarantee amount is required" },
      tooltip: "Amount of claim covered by guarantee, if any (Please provide details of guarantee held, the value of the guarantee, and the date it was given)",
      placeholder: "Enter guarantee amount",
    },
    {
      name: "guarantorName",
      label: <>Guarantor Name <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Guarantor name is required" },
      placeholder: "Enter guarantor name",
    },
    {
      name: "guarantorAddress",
      label: <>Guarantor Address <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Guarantor address is required" },
      placeholder: "Enter guarantor address",
    },
    {
      name: "addressProofType",
      label: <>Address Proof Type <span className="required-asterisk">*</span></>,
      type: "select",
      options: [
        { value: "", label: "Select Address Proof Type", disabled: true },
        { value: "Aadhar", label: "Aadhar" },
        { value: "PAN", label: "PAN" },
        { value: "Voter", label: "Voter ID" },
        { value: "Passport", label: "Passport" },
      ],
      rules: { required: "Address proof type is required" },
      tooltip: "Select the type of address proof document provided",
    },
    {
      name: "addressProofNumber",
      label: <>Address Proof Number <span className="required-asterisk">*</span></>,
      type: "text",
      rules: {
        required: "Address proof number is required",
      },
      tooltip: "Enter your Address Proof Number",
      placeholder: "Enter Address Proof Number",
    },
    {
      name: "addressProofDocument",
      label: <>Address Proof Document <span className="required-asterisk">*</span></>,
      type: "file",
      rules: {
        required: "Address proof document is required",
        validate: {
          fileUploaded: (value) => value !== null || "Please upload the document",
        },
      },
      tooltip: "Upload a clear scan of your address proof document",
      accept: "image/*,.pdf",
      onFileUpload: handleFileUpload,
      isUploading,
      uploadError,
      setIsUploading,
      setUploadError,
    },
    {
      name: "creditorAddress",
      label: <>Address of Creditor for Correspondence <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Creditor address is required" },
      placeholder: "Enter creditor address",
    },
    {
      name: "creditorEmail",
      label: <>Email Address of Creditor for Correspondence <span className="required-asterisk">*</span></>,
      type: "email",
      rules: {
        required: "Email address is required",
        pattern: {
          value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
          message: "Invalid email address",
        },
      },
      placeholder: "Enter creditor email",
    },
  ];

  const beneficiaryDetailsSchema = [
    {
      name: "beneficiaryName",
      label: <>Beneficiary Name <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Beneficiary name is required" },
      placeholder: "Enter beneficiary name",
    },
    {
      name: "beneficiaryAddress",
      label: <>Beneficiary Address <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Beneficiary address is required" },
      placeholder: "Enter beneficiary address",
    },
  ];

  const corporateDebtorSchema = [
    {
      name: "corporateDebtorSecurityAmount",
      label: <>Security Amount <span className="required-asterisk">*</span></>,
      type: "number",
      rules: { required: "Security amount is required" },
      tooltip: "Amount of claim covered by security interest, if any (Please provide details of security interest, the value of the security, and the date it was given)",
      placeholder: "Enter security amount",
    },
    {
      name: "corporateDebtorGuaranteeAmount",
      label: <>Guarantee Amount <span className="required-asterisk">*</span></>,
      type: "number",
      rules: { required: "Guarantee amount is required" },
      tooltip: "Amount of claim covered by guarantee, if any (Please provide details of guarantee held, the value of the guarantee, and the date it was given)",
      placeholder: "Enter guarantee amount",
    },
    {
      name: "principalBorrowerName",
      label: <>Principal Borrower Name <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Principal borrower name is required" },
      placeholder: "Enter principal borrower name",
    },
    {
      name: "principalBorrowerAddress",
      label: <>Principal Borrower Address <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Principal borrower address is required" },
      placeholder: "Enter principal borrower address",
    },
  ];

  const bankAccountDetailsSchema = [
    {
      name: "accountNumber",
      label: <>Account Number <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Account number is required" },
      placeholder: "Enter account number",
    },
    {
      name: "ifscCode",
      label: <>IFSC Code <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "IFSC code is required" },
      placeholder: "Enter IFSC code",
    },
    {
      name: "branchName",
      label: <>Branch Name <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Branch name is required" },
      placeholder: "Enter branch name",
    },
  ];

  // Watch addressProofType for validation
  const addressProofType = watch("addressProofType");
  useEffect(() => {
    if (addressProofType) {
      localStorage.setItem("selectedAddressProofType", addressProofType);
      trigger("addressProofNumber");
    }
  }, [addressProofType, trigger]);

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        {/* Details of Claim Section */}
        <div className="mb-4 bg-light">
          <Tooltip title="Details of claim, if it is made in respect of financial debt covered under clauses (h) and (i) of sub-section (8) of section 5 of the Code, extended by the creditor" arrow>
            <div>
              <Collapsible
                title="Details of claim: corporate debtor as principal borrower"
                isOpen={activeSection === "principalBorrower"}
                onToggle={() => setActiveSection("principalBorrower")}
              >
                <div className="flex-container">
                  {activeSection === "principalBorrower" &&
                    claimDetailsSchema.map((fieldConfig) => (
                      <DynamicField
                        key={fieldConfig.name}
                        fieldConfig={fieldConfig}
                        control={control}
                        register={register}
                        errors={errors}
                        setValue={setValue}
                        trigger={trigger}
                        getValues={getValues}
                        watch={watch}
                      />
                    ))}
                </div>
              </Collapsible>
            </div>
          </Tooltip>
        </div>

        {/* Beneficiary Details Section */}
        <div className="mb-4 bg-light">
          <Tooltip title="Beneficiary details (Details of claim, if it is made in respect of financial debt covered under clauses (h) and (i) of sub-section (8) of section 5 of the Code, extended by the creditor)" arrow>
            <div>
              <Collapsible
                title="Details of claim: corporate debtor as beneficiary"
                isOpen={activeSection === "beneficiary"}
                onToggle={() => setActiveSection("beneficiary")}
              >
                <div className="flex-container">
                  {activeSection === "beneficiary" &&
                    beneficiaryDetailsSchema.map((fieldConfig) => (
                      <DynamicField
                        key={fieldConfig.name}
                        fieldConfig={fieldConfig}
                        control={control}
                        register={register}
                        errors={errors}
                        setValue={setValue}
                        trigger={trigger}
                        getValues={getValues}
                        watch={watch}
                      />
                    ))}
                </div>
              </Collapsible>
            </div>
          </Tooltip>
        </div>

        {/* Corporate Debtor as Guarantor Section */}
        <div className="mb-4 bg-light">
          <Collapsible
            title="Details of claim: corporate debtor as guarantor"
            isOpen={activeSection === "guarantor"}
            onToggle={() => setActiveSection("guarantor")}
          >
            <div className="flex-container">
              {activeSection === "guarantor" &&
                corporateDebtorSchema.map((fieldConfig) => (
                  <DynamicField
                    key={fieldConfig.name}
                    fieldConfig={fieldConfig}
                    control={control}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    trigger={trigger}
                    getValues={getValues}
                    watch={watch}
                  />
                ))}
            </div>
          </Collapsible>
        </div>

        {/* Bank Account Details Section */}
        <div className="mb-4 bg-light">
          <Tooltip title="Bank account details (Details of the bank account to which the amount of the claim or any part thereof can be transferred pursuant to a resolution plan)" arrow>
            <div>
              <Collapsible
                title="Bank Account Details"
                isOpen={activeSection === "bankDetails"}
                onToggle={() => setActiveSection("bankDetails")}
              >
                <div className="flex-container">
                  {activeSection === "bankDetails" &&
                    bankAccountDetailsSchema.map((fieldConfig) => (
                      <DynamicField
                        key={fieldConfig.name}
                        fieldConfig={fieldConfig}
                        control={control}
                        register={register}
                        errors={errors}
                        setValue={setValue}
                        trigger={trigger}
                        getValues={getValues}
                        watch={watch}
                      />
                    ))}
                </div>
              </Collapsible>
            </div>
          </Tooltip>
        </div>
      </form>
    </FormProvider>
  );
};

export default FormCDetails;
