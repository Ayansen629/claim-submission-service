{/* DECLARATION OF OWNERSHIP */}
<Collapsible
  title={
    <div className="d-flex align-items-center">
      <FaUser className="me-2" style={{ color: "#2466BF" }} />
      <span style={{ color: "#2466BF" }}>
        {t("DECLARATION OF OWNERSHIP")}
      </span>
    </div>
  }
  defaultOpen={true}
>
  <Card className="form-section-card">
    <Card.Body>
      <div className="declaration-content mb-3">
        <p className="mb-2">
          I/We <strong>{watch("ownerName") || "[Owner Name]"}</strong> residing permanently at{" "}
          <strong>{watch("address") || "[Address of Owner]"}</strong> having original place of business at{" "}
          <strong>{watch("originalPlaceOfBusiness") || "[Place of Business]"}</strong>
        </p>
        <p className="mb-2">
          do hereby declare that vessel named <strong>{watch("vesselName") || "[Vessel Name]"}</strong> was built at{" "}
          <strong>{watch("placeOfBuild") || "[Place of Build]"}</strong>
        </p>
        <p className="mb-2">
          in the year <strong>{watch("vesselyearOfBuild") || "[Year of Build]"}</strong> and was purchased by me on{" "}
          <strong>[Work Order Date]</strong> for rupees <strong>{watch("workOrderValue") || "[Work Order Value]"}</strong> and wish to have the same registered in my name at the port of{" "}
          <strong>{watch("nameOfRegistry") || "[Port of Registry]"}</strong> and that I am the owner of the same.
        </p>
      </div>
      
      {!isViewMode && (
        <div className="text-end mb-3">
          <Button
            variant="primary"
            onClick={() => {
              toast.success("Declaration of Ownership generated successfully!");
            }}
            className="btn btn-primary"
          >
            Generate Declaration
          </Button>
        </div>
      )}
    </Card.Body>
  </Card>
</Collapsible>
