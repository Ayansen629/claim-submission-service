/* SurveyTrackerCard.css */
.calendar-wrapper {
  margin-top: 10px;
  width: 100%;
}

.survey-calendar {
  width: 100% !important;
  font-family: inherit !important;
  border: none !important;
  background: transparent !important;
}

.survey-calendar .react-datepicker__month-container {
  width: 100%;
  float: none;
}

.survey-calendar .react-datepicker__header {
  background-color: transparent;
  border-bottom: none;
  padding-top: 0.5em;
}

.survey-calendar .react-datepicker__day-names {
  display: flex;
  justify-content: space-around;
  margin-bottom: 0.4em;
}

.survey-calendar .react-datepicker__day-name {
  color: #666;
  font-weight: 500;
  font-size: 0.7rem;
  margin: 0;
  width: 2em;
  line-height: 2em;
}

.survey-calendar .react-datepicker__month {
  margin: 0;
}

.survey-calendar .react-datepicker__week {
  display: flex;
  justify-content: space-around;
}

.survey-calendar .react-datepicker__day {
  margin: 0;
  width: 2em;
  line-height: 2em;
  font-size: 0.8rem;
  color: #333;
}

.survey-calendar .react-datepicker__day--selected,
.survey-calendar .react-datepicker__day--keyboard-selected {
  background-color: #6f42c1;
  color: white;
}

.survey-calendar .react-datepicker__day--today {
  font-weight: bold;
  color: #0d6efd;
}

.survey-calendar .react-datepicker__navigation {
  top: 0.5em;
}

.day-container {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.day-number {
  font-size: 0.8rem;
}

.event-indicators {
  position: absolute;
  bottom: 1px;
  display: flex;
  gap: 2px;
}

.event-indicator {
  width: 4px;
  height: 4px;
  border-radius: 50%;
}

/* Update status card to ensure consistent height */
.status-card {
  height: 100%;
  min-height: 220px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  border: none;
  background: #fff;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.status-card-content {
  padding: 20px;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.status-card .icon-wrapper {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.status-card .value {
  font-size: 32px;
  font-weight: 700;
  margin: 8px 0;
  line-height: 1;
}

.status-card .title {
  font-size: 15px;
  color: #555;
  margin-bottom: 6px;
  font-weight: 500;
}

.status-card .subtitle {
  font-size: 13px;
  color: #888;
  margin-bottom: 10px;
}
