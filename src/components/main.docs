import React, { useState, useEffect, useRef } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams, useLocation, useNavigate } from "react-router-dom";
import Stepper from "../../../../common/Stepper.jsx";
import { useForm } from "react-hook-form";
import ActionDropdown from "../../../../common/ActionDropdown";
import ApprovalModal from "../../../../common/ApprovalModal";
import { useTranslation } from "react-i18next";
import { toast } from "react-toastify";
import { postData } from "../../../../../services/http.service.ts";
import { SERVICE_BASE, URLS_ENDPOINT } from "../../../../../utils/urlsConstants.ts";
import VesselBasicDetailsView from "./VesselBasicDetailsView.js";
import ReportsDashboard from "./reports/reportsDashboard.js";

const VesselReportsAndDocs = () => {
  const { t } = useTranslation();
  const { id } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  const isEditMode = !!id && location.pathname.includes("/edit/");
  const isViewMode = !!id && location.pathname.includes("/view/");
  const stepperRef = useRef();

  const methods = useForm({ mode: "onTouched" });
  const { trigger, getValues, setValue } = methods;

  const [isLoading, setIsLoading] = useState(false);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [registrationData, setRegistrationData] = useState(null);

  const actionsFromAPI = ["Approve", "Reject", "Request Changes"];

  const fetchRegistrationDetails = async () => {
    setIsLoading(true);
    try {
      const payload = {
        applicationNumber: "REG-2025-576219"
      };
      
      const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.USER_SERVICE.REGISTRATION_SEARCH_BY_ID;
      const response = await postData(apiUrl, payload);
      
      if (response?.status === 200 && response?.data?.responseStatus?.status === "Registration details fetched successfully") {
        const data = response.data.data[0];
        setRegistrationData(data);
        
        if (data.basicDetails?.ownerDetails) {
          const owner = data.basicDetails.ownerDetails;
          setValue("ownerName", owner.ownerCompanyName);
          setValue("ownerAddress", `${owner.addressLine1}, ${owner.addressLine2}`);
          setValue("mobile", owner.phoneNumber);
          setValue("email", owner.emailId);
          setValue("pan", owner.panNo);
          setValue("gst", owner.gstNo);
          setValue("aadhar", owner.aadharNumber);
          setValue("tradeLicence", owner.tradeLicenseNumber);
        }
        
        if (data.vesselDetails) {
          const vessel = data.vesselDetails;
          setValue("grt", vessel.grossTonnage);
          setValue("workOrderValue", vessel.workOrderValue);
          setValue("vesselType", vessel.typeOfVessel);
          setValue("category", vessel.categoryOfVessel);
          setValue("zone", vessel.zone);
          setValue("purchaseType", vessel.purchaseType);
          setValue("supervisionAuthority", vessel.supervisionAuthority);
          setValue("classificationSociety", vessel.nameOfClassificationSociety);
        }
        
        if (data.basicDetails?.builderDetails) {
          const builder = data.basicDetails.builderDetails;
          setValue("constructedBy", "2");
          setValue("builderName", builder.builderName);
          setValue("builderAddress", `${builder.addressLine1}, ${builder.addressLine2}`);
          setValue("builderEmail", builder.emailId);
          setValue("builderMobile", builder.phone);
          setValue("builderGST", builder.gstNo);
          setValue("builderTradeLicence", builder.tradeLicenseNumber);
          setValue("builderAuth", data.basicDetails.builderAuthorization);
        }
      }
    } catch (err) {
      console.error("Failed to fetch registration details:", err);
      toast.error("Failed to fetch registration details");
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchRegistrationDetails();
  }, []);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      comments: formData.comments,
    };
    console.log("Action submitted:", payload);
    toast.success(`${selectedAction} action submitted successfully`);
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const steps = [
    {
      label: "Basic Details",
      component: (
        <VesselBasicDetailsView 
          formMethods={methods} 
          isPreview={true}
          formData={getValues()}
          registrationData={registrationData}
        />
      ),
      getFormData: () => methods?.getValues(),
      goToNextStepNoValidtion: true,
    },
    {
      label: "Reports & Documents",
      component: (
        <ReportsDashboard
          formMethods={methods}
          viewMode={isViewMode}
          editMode={isEditMode}
          applicationNumber="REG-2025-576219"
        />
      ),
      getFormData: () => methods?.getValues(),
      goToNextStepNoValidtion: true,
    },
  ];

  const handleFormSubmit = async (stepInfo) => {
    console.log("Current Step Info from Stepper:", stepInfo);
  };

  const actionDropdown = isViewMode ? (
    <ActionDropdown
      actions={actionsFromAPI}
      onActionClick={handleActionClick}
      variant="contained"
      sx={{
        backgroundColor: "#2E57A7",
        fontWeight: "bold",
        borderRadius: "0.5rem",
        minWidth: "8rem",
        fontSize: "0.9rem",
        color: "#fff",
        "&:hover": {
          backgroundColor: "#1f4ea0",
        },
      }}
    />
  ) : null;

  return (
    <Box sx={{ padding: "1rem 0.5rem 0 0.5rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {isLoading ? (
        <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
          <div className="text-center">
            <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
              <span className="visually-hidden">Loading...</span>
            </div>
            <p className="mt-3">Processing your request...</p>
          </div>
        </div>
      ) : (
        <>
          <Stepper
            ref={stepperRef}
            steps={steps}
            viewMode={true}
            actionComponent={actionDropdown}
            onSyncData={handleFormSubmit}
          />
          {isViewMode && (
            <ApprovalModal
              show={showApprovalModal}
              handleClose={handleCloseModal}
              handleSubmitData={handleActionSubmit}
              selectedAction={selectedAction}
            />
          )}
        </>
      )}
    </Box>
  );
};

export default VesselReportsAndDocs;
