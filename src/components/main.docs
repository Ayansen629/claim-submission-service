// Add this useEffect after existing useEffects in VesselDetails.js
useEffect(() => {
  // Only trigger validation in edit mode when GRT changes
  const grtValue = watch("grt");
  if (isEditMode && grtValue && grtValue.trim() !== "") {
    setTimeout(() => {
      // Trigger validation for tonnage and stability in Documents component
      trigger(["tonnageBooklets", "stabilityBooklets"]);
    }, 100);
  }
}, [watch("grt"), trigger, editMode]);
