.declaration-text {
  line-height: 1.8;
  font-size: 16px;
  text-align: justify;
}

.declaration-text p {
  margin-bottom: 1.5rem;
  text-indent: 2rem;
}

.highlight-field {
  background-color: #fff3cd;
  padding: 2px 6px;
  border-radius: 3px;
  border: 1px solid #ffeaa7;
}

.highlight-field.auto-populated {
  background-color: #d1ecf1;
  border-color: #bee5eb;
}

<div className="declaration-content" style={{ 
  padding: "20px", 
  backgroundColor: "#f8f9fa", 
  borderRadius: "8px",
  border: "1px solid #dee2e6"
}}>
