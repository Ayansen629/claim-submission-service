// Add imports
import CalendarCard from './CalendarCard';
import { OFFICER_L2_STAT_DATA, SURVEY_EVENTS } from './employeeDashboardConstants';

// Update the stats rendering section
<Card.Body>
  <div className="row g-3">
    {getStatData().map((item, index) => (
      <div className="col-md-4 col-lg-3 col-sm-12" key={index}>
        {item.isCalendar ? (
          <CalendarCard 
            title={item.title}
            value={item.value}
            events={item.events}
            color={item.color}
          />
        ) : (
          <StatusCard {...item} />
        )}
      </div>
    ))}
  </div>
</Card.Body>
