.sidebar {
  background: linear-gradient(180deg, #f4f8fc 80%, #eaf2fb 100%);
  color: #2466bf;
  height: calc(100vh - 60px);
  transition:
    width 0.5s cubic-bezier(0.77, 0, 0.175, 1),
    min-width 0.5s cubic-bezier(0.77, 0, 0.175, 1),
    max-width 0.5s cubic-bezier(0.77, 0, 0.175, 1);
  overflow: hidden;
  padding-top: 1.5rem;
  box-shadow: 2px 0 16px rgba(36, 102, 191, 0.08);
  border-right: 1px solid #e1eaf5;
  position: fixed;
  top: 75px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  width: 17rem;
  min-width: 17rem;
  max-width: 17rem;
}

.collapsed {
  width: 60px;
  min-width: 60px;
  max-width: 60px;
}

.expanded {
  width: 17rem;
  min-width: 17rem;
  max-width: 17rem;
}

.menu,
.submenuList {
  list-style: none;
  padding: 0;
  margin: 0;
}

.item {
  transition: background 0.4s cubic-bezier(0.77, 0, 0.175, 1);
  position: relative;
}

.itemActive > .link {
  background-color: #e3edfa;
  font-weight: 600;
  color: #174a8b;
}

.itemActive::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8px;
  bottom: 8px;
  width: 4px;
  border-radius: 4px;
  background: linear-gradient(180deg, #2466bf 60%, #5fa8e6 100%);
  transition: background 0.3s;
}

.link {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 12px 18px 12px 22px;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.4s cubic-bezier(0.77, 0, 0.175, 1), color 0.3s;
  border-radius: 0 24px 24px 0;
  position: relative;
  min-height: 44px;
  gap: 8px;
}

.link:hover {
  background-color: #e8f1fc;
  box-shadow: 0 2px 8px rgba(36, 102, 191, 0.07);
  color: #174a8b;
}

.linkContent {
  display: flex;
  align-items: center;
}

.icon {
  margin-right: 10px;
  font-size: 1.25rem;
  min-width: 28px;
  text-align: center;
  color: #2466bf;
  transition: color 0.3s;
}

.link:hover .icon,
.itemActive .icon {
  color: #174a8b;
}

.linkLabel {
  display: inline-block;
  white-space: nowrap;
  overflow: hidden;
  transition:
    opacity 0.4s cubic-bezier(0.77, 0, 0.175, 1),
    width 0.4s cubic-bezier(0.77, 0, 0.175, 1),
    margin 0.4s cubic-bezier(0.77, 0, 0.175, 1),
    transform 0.4s cubic-bezier(0.77, 0, 0.175, 1);
  opacity: 1;
  width: auto;
  margin-left: 4px;
  font-size: 1rem;
  letter-spacing: 0.01em;
  transform: translateX(0);
}

.collapsed .linkLabel {
  opacity: 0;
  width: 0;
  margin-left: 0;
  pointer-events: none;
  transform: translateX(-16px);
}

.chevron {
  margin-left: auto;
  transition: transform 0.4s cubic-bezier(0.77, 0, 0.175, 1);
  color: #b3c7e6;
}

.rotate {
  transform: rotate(90deg);
}

.submenu {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transform: translateY(-10px) scaleY(0.97);
  transition:
    max-height 0.7s cubic-bezier(0.77, 0, 0.175, 1),
    opacity 0.7s cubic-bezier(0.77, 0, 0.175, 1),
    transform 0.7s cubic-bezier(0.77, 0, 0.175, 1),
    padding 0.7s cubic-bezier(0.77, 0, 0.175, 1);
  padding-top: 0;
  padding-bottom: 0;
  background: #f8fbff;
  border-radius: 0 0 16px 0;
  margin-left: 8px;
}

.submenu.expanded {
  max-height: 800px; /* Large enough for all items */
  opacity: 1;
  transform: translateY(0) scaleY(1);
  padding-top: 4px;
  padding-bottom: 8px;
  overflow-y: auto;
}
.submenu.expanded::-webkit-scrollbar {
  width: 6px;
}
.submenu.expanded::-webkit-scrollbar-thumb {
  background-color: rgba(36, 102, 191, 0.12);
  border-radius: 4px;
}

.sublink {
  margin: 4px 8px 0 12px;
  display: block;
  padding: 9px 28px;
  color: #2466bf;
  text-decoration: none;
  font-size: 0.97rem;
  border-radius: 0 16px 16px 0;
  transition: background 0.3s, color 0.3s;
  position: relative;
}

.sublink:hover {
  background-color: #e8f1fc;
  color: #174a8b;
}

.sublinkActive {
  background-color: #d6e6f9;
  color: #174a8b;
  font-weight: 500;
}

.backdrop {
  position: fixed;
  inset: 0;
  z-index: 999;
}

.close {
  display: none;
  justify-content: flex-end;
  padding: 0.75rem 1rem;
}

.close svg {
  cursor: pointer;
  font-size: 1.25rem;
  color: #2466bf;
}

@media (max-width: 768px) {
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 250px;
    z-index: 1000;
    transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
    background: linear-gradient(180deg, #f4f8fc 80%, #eaf2fb 100%);
  }

  .collapsed {
    transform: translateX(-100%);
    transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .expanded {
    transform: translateX(0);
    transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .close {
    display: flex;
  }

  .menu {
    padding-bottom: 2rem;
  }
}

.menu {
  list-style: none;
  padding: 0;
  margin: 0;
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
}

.menu::-webkit-scrollbar {
  width: 6px;
}
.menu::-webkit-scrollbar-thumb {
  background-color: rgba(36, 102, 191, 0.13);
  border-radius: 4px;
}

.collapsed .menu {
  overflow: hidden;
}
import React, { useEffect, useState } from "react";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext.js";
import { Link, useLocation } from "react-router-dom";
import {
  FaHome,
  FaCog,
  FaChevronRight,
  FaShip,
  FaDatabase,
  FaTimes,
  FaClipboardCheck,
  FaAnchor,
  FaIdBadge,
  FaBell,
  FaChartBar,
  FaBalanceScale,
  FaGavel,
  FaMoneyCheckAlt,
  FaBoxes,
  FaDrawPolygon,
} from "react-icons/fa";
import styles from "./styles/Sidebar.module.css";
import { OFFICER_ROLES, USER_ROLES } from "../../utils/constants.ts";

const Sidebar = ({ isSidebarOpen, onMenuClick, onClose, userRole }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const commonDashboard = {
    name: "dashboard",
    label: t("Dashboard"),
    icon: <FaHome />,
    path: "/dashboard",
  };

  const vesselRegistrationMenu = {
    name: "vessel-registration",
    label: t("Registration of Vessel"),
    path: "/vessel-registration/new-vessel",
    icon: <FaAnchor />,
    subMenu: [
      { name: "new-vessel", label: t("New Vessel"), path: "/vessel-registration/new-vessel" },
      {
        name: "existing-vessel",
        label: t("Existing Vessel"),
        icon: <FaShip />,
        subMenu: [
          { name: "", label: t("Name Change of Vessel"), path: "" },
          { name: "", label: t("Registration for Alteration/Modification of Inland Vessels"), path: "" },
          { name: "", label: t("Transfer of Registry"), path: "" },
          { name: "", label: t("Transfer of Inland Vessel"), path: "" },
          { name: "", label: t("Cancellation of Registration"), path: "" },
          { name: "", label: t("Registration for Mortgage of mechanically propelled inland vessel (Hypothecation)"), path: "" },
          { name: "", label: t("De-registration for Mortgage of mechanically propelled inland vessel (De-hypothecation)"), path: "" },
          { name: "", label: t("Transfer for Mortgage of mechanically propelled inland vessel or share"), path: "" },
          { name: "", label: t("Duplicate Registration Certificatee"), path: "" },
        ]
      },
      { name: "upload-legacy-data", label: t("Upload Legacy Data"), path: "/vessel-registration/upload-legacy-data" },
    ],
  };

  const surveyMenu = {
    name: "vessel-survey",
    label: t("Survey of Vessel"),
    path: "/vessel-survey/annual-survey",
    icon: <FaClipboardCheck />,
    subMenu: [
      { name: "annual-survey", label: t("Annual survey"), path: "/vessel-survey/annual-survey" },
      { name: "renewal-survey", label: t("Renewal Survey"), path: "renewal-survey" },
      { name: "extension-of-survey-certificate", label: t("Extension of Survey \nCertificate"), path: "extension-of-survey-certificate" },
      { name: "name-change-in-survey-certificate", label: t("Name change in Survey \nCertificate"), path: "name-change-in-survey-certificate" },
      { name: "state-inspection", label: t("State Inspection"), path: "state-inspection" },
      { name: "additional-survey-for-vessel-accident", label: t("Additional Survey \nfor Vessel Accident"), path: "additional-survey-for-vessel-accident" }
    ],
  };

  const masterMenu = {
    name: "master",
    label: t("Master"),
    icon: <FaDatabase />,
    subMenu: [
      { name: "manage-employee", label: t("Employee Management"), path: "/iwt/employee-management" },
    ],
  };

  const settingsItem = {
    name: "settings",
    label: t("Settings"),
    icon: <FaCog />,
    subMenu: [
      { name: "profile", label: t("Profile"), path: "/settings/profile" },
      { name: "security", label: t("Security"), path: "/settings/security" },
    ],
  };

  const officerCommonItems1 = [
    {
      name: "vessel-registration",
      label: t("Vessel Registration"),
      icon: <FaShip />,
    },
    {
      name: "survey-management",
      label: t("Survey Management"),
      icon: <FaClipboardCheck />,
      subMenu: [
        { name: "schedule-survey", label: t("Schedule Survey"), path: "" },
        { name: "survey-history", label: t("Survey History"), path: "" },
      ],
    },
    {
      name: "manning-certification",
      label: t("Manning & Certification"),
      icon: <FaIdBadge />,
      subMenu: [
        { name: "certification", label: t("Certification"), path: "/iwt/manning-certification/certification" },
      ],
    },
  ];

  const officerCommonItems2 = [
    {
      name: "mis-reports",
      label: "MIS Reports",
      icon: <FaChartBar />,
      subMenu: [
        { name: "vessel-report", label: "Vessel Reports", path: "/iwt/mis-reports/vessels" },
        { name: "survey-report", label: "Survey Reports", path: "/iwt/mis-reports/surveys" },
      ],
    },
    {
      name: "notifications",
      label: "Notifications",
      icon: <FaBell />,
      subMenu: [
        { name: "send-notification", label: "Send Notification", path: "/iwt/notifications/send" },
        { name: "notification-history", label: "Notification History", path: "/iwt/notifications/history" },
      ],
    },
  ];

  const commonDrawings = {
    name: "draing-approvas",
    label: "Approvals of Drawings",
    icon: <FaDrawPolygon />,
    path: "",
  };

  const DRAItems = [
    {
      name: "grievance-redressal",
      label: "Grievance Redressal",
      icon: <FaBalanceScale />,
    },
    {
      name: "offences-penalties",
      label: "Offences & Penalties",
      icon: <FaGavel />,
    },
    {
      name: "financial-dashboard",
      label: "Financial Dashboard",
      icon: <FaMoneyCheckAlt />,
    },
    {
      name: "inventory-procurement",
      label: "Inventory & Procurement",
      icon: <FaBoxes />,
    },
  ];

  const location = useLocation();
  const [activeMenu, setActiveMenu] = useState("");
  const [expandedMenus, setExpandedMenus] = useState({});

  const getRoleSpecificMenuItems = () => {
    switch (true) {
      case userRole === USER_ROLES.ADMIN:
        return [commonDashboard, masterMenu];
      case [USER_ROLES.OFFICER_L1, USER_ROLES.OFFICER_L2].includes(userRole):
        return [commonDashboard, ...officerCommonItems1, ...officerCommonItems2];
      case [USER_ROLES.OFFICER_L3, USER_ROLES.OFFICER_L4].includes(userRole):
        return [commonDashboard, ...officerCommonItems1, commonDrawings, ...officerCommonItems2];
      case userRole === USER_ROLES.OFFICER_L5:
        return [commonDashboard, ...officerCommonItems1, ...DRAItems, masterMenu, ...officerCommonItems2];
      default:
        return [commonDashboard, vesselRegistrationMenu, surveyMenu];
    }
  };

  const menuItems = [...getRoleSpecificMenuItems(), settingsItem];

  useEffect(() => {
    const findActiveMenuName = (items) => {
      for (const item of items) {
        if (item.path === location.pathname) return item.name;
        if (item.subMenu) {
          const result = findActiveMenuName(item.subMenu);
          if (result) return item.name;
        }
      }
      return "";
    };
    setActiveMenu(findActiveMenuName(menuItems));
  }, [location]);

  const toggleSubMenu = (menuName) => {
    setExpandedMenus((prev) => ({
      ...prev,
      [menuName]: !prev[menuName],
    }));
  };

  const SidebarItem = ({ item }) => {
    const isActive = activeMenu === item.name;
    const hasSubMenu = !!item.subMenu;

    return (
      <li className={`${styles.item} ${isActive ? styles.itemActive : ""}`}>
        <div
          className={styles.link}
          onClick={() => {
            if (hasSubMenu) toggleSubMenu(item.name);
            else onMenuClick(item.name);
          }}
          aria-expanded={!!expandedMenus[item.name]}
        >
          <div className={styles.linkContent}>
            {item.icon && <span className={styles.icon}>{item.icon}</span>}
            <span className={styles.linkLabel}>{item.label}</span>
          </div>
          {hasSubMenu && isSidebarOpen && (
            <span className={`${styles.chevron} ${expandedMenus[item.name] ? styles.rotate : ""}`}>
              <FaChevronRight size={12} />
            </span>
          )}
        </div>
        {hasSubMenu && (
          <div className={`${styles.submenu} ${expandedMenus[item.name] && isSidebarOpen ? styles.expanded : styles.collapsed}`}>
            <ul className={styles.submenuList}>
              {item.subMenu.map((sub, index) =>
                sub.subMenu ? (
                  <SidebarItem key={sub.name + index} item={sub} />
                ) : (
                  <li key={sub.name + index}>
                    <Link
                      to={sub.path}
                      className={`${styles.sublink} ${location.pathname === sub.path ? styles.sublinkActive : ""}`}
                      onClick={() => onMenuClick(sub.name)}
                    >
                      {sub.label}
                    </Link>
                  </li>
                )
              )}
            </ul>
          </div>
        )}
      </li>
    );
  };

  return (
    <div className={`${styles.sidebar} ${isSidebarOpen ? styles.expanded : styles.collapsed}`}>
      <div className={styles.close}>
        <FaTimes onClick={onClose} />
      </div>
      <ul className={styles.menu}>
        {menuItems.map((item, index) => (
          <SidebarItem key={item.name + index} item={item} />
        ))}
      </ul>
    </div>
  );
};

export default Sidebar;
