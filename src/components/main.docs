                                        e.currentTarget.style.color = "";
                                      }}
                                      style={{
                                        cursor: "pointer",
                                        transition:
                                          "background-color 0.3s ease, color 0.3s ease",
                                      }}
                                    >
                                      <Pencil size={16} className="me-2" />
                                      Revised Drawing
                                    </Dropdown.Item>
                                  )}

                                  {(o.actions.includes("paySupervisionFee") ||
                                    !row?.isEnableSupervisionFee) && (
                                    <Dropdown.Item
                                      onClick={() =>
                                        handlePaySupervisionFee(row)
                                      }
                                      onMouseEnter={(e) => {
                                        e.currentTarget.style.background =
                                          "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                        e.currentTarget.style.color = "#fff";
                                      }}
                                      onMouseLeave={(e) => {
                                        e.currentTarget.style.background = "";
                                        e.currentTarget.style.color = "";
                                      }}
                                      style={{
                                        cursor: "pointer",
                                        transition:
                                          "background-color 0.3s ease, color 0.3s ease",
                                      }}
                                    >
                                      <CreditCard size={16} className="me-2" />
                                      Pay Supervision Fee
                                    </Dropdown.Item>
                                  )}

                                  {o.actions.includes("applyInitialSurvey") ||
                                    (row?.enableInitialSurvey && (
                                      <Dropdown.Item
                                        onClick={() =>
                                          handleApplyInitialSurvey(row)
                                        }
                                        onMouseEnter={(e) => {
                                          e.currentTarget.style.background =
                                            "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                          e.currentTarget.style.color = "#fff";
                                        }}
                                        onMouseLeave={(e) => {
                                          e.currentTarget.style.background = "";
                                          e.currentTarget.style.color = "";
                                        }}
                                        style={{
                                          cursor: "pointer",
                                          transition:
                                            "background-color 0.3s ease, color 0.3s ease",
                                        }}
                                      >
                                        <ClipboardCheck
                                          size={16}
                                          className="me-2 text-success"
                                        />
                                        Apply Initial Survey
                                      </Dropdown.Item>
                                    ))}
                                  {row?.isCMNGenerated && (
                                    <>
                                      <Dropdown.Item
                                        onClick={() => handleDownloadCMN(row)}
                                        onMouseEnter={(e) => {
                                          e.currentTarget.style.background =
                                            "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                          e.currentTarget.style.color = "#fff";
                                        }}
                                        onMouseLeave={(e) => {
                                          e.currentTarget.style.background = "";
                                          e.currentTarget.style.color = "";
                                        }}
                                        style={{
                                          cursor: "pointer",
                                          transition:
                                            "background-color 0.3s ease, color 0.3s ease",
                                        }}
                                      >
                                        <Download size={16} className="me-2" />
                                        Download CMN
                                      </Dropdown.Item>
                                    </>
                                  )}

                                  {row?.isCMNGenerated &&
                                    !row.enableInitialSurvey && (
                                      <Dropdown.Item
                                        onClick={() => handleSlotBooking(row)}
                                        onMouseEnter={(e) => {
                                          e.currentTarget.style.background =
                                            "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                          e.currentTarget.style.color = "#fff";
                                        }}
                                        onMouseLeave={(e) => {
                                          e.currentTarget.style.background = "";
                                          e.currentTarget.style.color = "";
                                        }}
                                        style={{
                                          cursor: "pointer",
                                          transition:
                                            "background-color 0.3s ease, color 0.3s ease",
                                        }}
                                      >
                                        <Calendar2Check
                                          size={16}
                                          className="me-2"
                                        />
                                        Slot Booking
                                      </Dropdown.Item>
                                    )}
                                </Dropdown.Menu>
                              </Dropdown>
when click dropdown model design need professionl & item hover background use blue colour
