import React, { useCallback, useEffect, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepFirst.css";
import 'bootstrap/dist/css/bootstrap.min.css';
import { FaPlus, FaTimes, FaDownload } from "react-icons/fa";

const StepFirst = ({ provideSubmitHandler, formData, onValidationComplete }) => {
  const [isUploading, setIsUploading] = useState(false);
  const [uploadError, setUploadError] = useState(null);
  const [identificationRecords, setIdentificationRecords] = useState([
    { id: 1, details: "", proof: null }
  ]);

  const methods = useForm({
    mode: "onChange",
    reValidateMode: "onChange",
    defaultValues: {
      identificationType: "incorporated",
      financialCreditorName: "",
      financialCreditorEmail: "",
      incorporatedIdentificationNumber: "",
      incorporatedProofDocument: null,
      addressLine1: "",
      addressLine2: "",
      city: "",
      state: "",
      pincode: "",
      identification_records: [{ id: 1, details: "", proof: null }]
    }
  });

  const {
    register,
    handleSubmit,
    formState: { errors, isValid },
    trigger,
    setValue,
    control,
    getValues,
    watch,
    resetField
  } = methods;

  const watchIdentificationType = watch("identificationType", "incorporated");

  // Initialize form data
  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        if (key !== "identification_records") {
          setValue(key, formData[key]);
        }
      });

      if (formData.identification_records && formData.identification_records.length > 0) {
        setIdentificationRecords(formData.identification_records);
        setValue("identification_records", formData.identification_records);
      }
    }
  }, [formData, setValue]);

  // Clear partnership data when switching to incorporated body
  useEffect(() => {
    if (watchIdentificationType === "incorporated") {
      setIdentificationRecords([{ id: 1, details: "", proof: null }]);
      setValue("identification_records", [{ id: 1, details: "", proof: null }]);
      setValue("incorporatedProofDocument", null); // clear document
    }
  }, [watchIdentificationType, setValue]);

  const handleFileUpload = async (file) => {
    try {
      setIsUploading(true);
      setUploadError(null);
      const result = await uploadDocument(file, 'identification');
      return {
        fileId: result.fileId,
        fileName: file.name,
        fileType: file.type
      };
    } catch (error) {
      setUploadError(error.message || "Upload failed");
      throw error;
    } finally {
      setIsUploading(false);
    }
  };

  const addIdentificationRecord = () => {
    const newId = identificationRecords.length > 0
      ? Math.max(...identificationRecords.map(r => r.id)) + 1
      : 1;
    const newRecord = { id: newId, details: "", proof: null };
    setIdentificationRecords([...identificationRecords, newRecord]);
    setValue("identification_records", [...identificationRecords, newRecord]);
  };

  const removeIdentificationRecord = (id) => {
    if (identificationRecords.length > 1) {
      const updatedRecords = identificationRecords.filter(r => r.id !== id);
      setIdentificationRecords(updatedRecords);
      setValue("identification_records", updatedRecords);
    }
  };

  const updateRecordDetails = (id, value) => {
    const updatedRecords = identificationRecords.map(record =>
      record.id === id ? { ...record, details: value } : record
    );
    setIdentificationRecords(updatedRecords);
    setValue("identification_records", updatedRecords);
  };

  const updateRecordProof = async (e, id) => {
    const file = e.target.files[0];
    if (!file) return;
    try {
      const doc = await handleFileUpload(file);
      const updatedRecords = identificationRecords.map(record =>
        record.id === id ? { ...record, proof: doc } : record
      );
      setIdentificationRecords(updatedRecords);
      setValue("identification_records", updatedRecords);
    } catch (err) {
      console.error("Upload failed:", err);
    }
  };

  const handleRemoveProof = (id) => {
    const updatedRecords = identificationRecords.map(record =>
      record.id === id ? { ...record, proof: null } : record
    );
    setIdentificationRecords(updatedRecords);
    setValue("identification_records", updatedRecords);
  };

  const handleIncorporatedProofChange = async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    try {
      const doc = await handleFileUpload(file);
      setValue("incorporatedProofDocument", doc);
    } catch (err) {
      console.error("Upload failed:", err);
    }
  };

  const handleRemoveIncorporatedProof = () => {
    setValue("incorporatedProofDocument", null);
  };

  const basicDetailsSchema = [
    {
      name: "financialCreditorName",
      label: <>Name of the financial creditor <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Financial creditor name is required" }
    },
    {
      name: "financialCreditorEmail",
      label: <>Email address of the financial creditor <span className="required-asterisk">*</span></>,
      type: "email",
      rules: {
        required: "Email is required",
        pattern: {
          value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
          message: "Invalid email address"
        }
      }
    },
    {
      name: "identificationType",
      label: <>Identification type <span className="required-asterisk">*</span></>,
      type: "radio",
      options: [
        { value: "incorporated", label: "Incorporated body" },
        { value: "partnership", label: "Partnership or individual" }
      ],
      rules: { required: "Select an identification type" }
    }
  ];

  const incorporatedBodyFields = [
    {
      name: "incorporatedIdentificationNumber",
      label: <>Identification Number <span className="required-asterisk">*</span></>,
      type: "text",
      rules: {
        required: watchIdentificationType === "incorporated" && "Identification number is required"
      }
    }
  ];

  const addressDetailsSchema = [
    { name: "addressLine1", label: <>Address line 1 <span className="required-asterisk">*</span></>, type: "text", rules: { required: "Address line 1 is required" } },
    { name: "addressLine2", label: "Address line 2", type: "text" },
    { name: "city", label: <>City <span className="required-asterisk">*</span></>, type: "text", rules: { required: "City is required" } },
    { name: "state", label: <>State <span className="required-asterisk">*</span></>, type: "text", rules: { required: "State is required" } },
    { name: "pincode", label: <>Pincode <span className="required-asterisk">*</span></>, type: "text", rules: { required: "Pincode is required" } }
  ];

  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    if (!isValid) return false;
    return getValues();
  }, [trigger, getValues]);

  useEffect(() => {
    if (onValidationComplete) onValidationComplete(isValid);
  }, [isValid, onValidationComplete]);

  useEffect(() => {
    if (provideSubmitHandler) provideSubmitHandler(onSubmit);
  }, [provideSubmitHandler, onSubmit]);

  const incorporatedProofDocument = watch("incorporatedProofDocument");

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        <div className="mb-4 bg-light p-4 rounded-3">
          <Collapsible title="Basic Details" defaultOpen>
            <div className="container-fluid">
              <div className="row g-3">
                {basicDetailsSchema.map((f) => (
                  <div key={f.name} className="col-md-6">
                    <DynamicField
                      fieldConfig={f}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      trigger={trigger}
                      getValues={getValues}
                    />
                  </div>
                ))}
              </div>

              {watchIdentificationType === "incorporated" && (
                <div className="row g-3 mt-3">
                  {incorporatedBodyFields.map((f) => (
                    <div key={f.name} className="col-md-6">
                      <DynamicField
                        fieldConfig={f}
                        control={control}
                        register={register}
                        errors={errors}
                        setValue={setValue}
                        trigger={trigger}
                        getValues={getValues}
                      />
                    </div>
                  ))}

                  {/* Incorporated Proof Upload */}
                  <div className="col-md-6">
                    <div className="form-group">
                      <label htmlFor="incorporatedProofDocument">
                        Proof of Identification <span className="required-asterisk">*</span>
                      </label>
                      {incorporatedProofDocument ? (
                        <div className="d-flex align-items-center mt-2">
                          <span className="me-2">{incorporatedProofDocument.fileName}</span>
                          <a
                            href={`${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${incorporatedProofDocument.fileId}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="btn btn-sm btn-outline-primary me-2"
                          >
                            <FaDownload /> Download
                          </a>
                          <button
                            type="button"
                            className="btn btn-sm btn-outline-danger"
                            onClick={handleRemoveIncorporatedProof}
                          >
                            <FaTimes /> Remove
                          </button>
                        </div>
                      ) : null}
                      <input
                        type="file"
                        id="incorporatedProofDocument"
                        accept=".pdf,.jpg,.jpeg,.png"
                        onChange={handleIncorporatedProofChange}
                        className="d-none"
                        disabled={isUploading}
                      />
                      <label htmlFor="incorporatedProofDocument" className="btn btn-outline-primary w-100 mt-2">
                        {isUploading ? (
                          <>
                            <span className="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            Uploading...
                          </>
                        ) : "Choose File"}
                      </label>
                      {errors.incorporatedProofDocument && (
                        <div className="invalid-feedback d-block">
                          {errors.incorporatedProofDocument.message}
                        </div>
                      )}
                      <small className="form-text text-muted mt-1">Max file size: 5MB (PDF, JPEG, PNG)</small>
                    </div>
                  </div>
                </div>
              )}

              {watchIdentificationType === "partnership" && (
                <div className="mt-3">
                  {identificationRecords.map((record, index) => (
                    <div key={record.id} className="mb-4 p-3 border rounded">
                      <div className="d-flex justify-content-between align-items-center mb-3">
                        <h6>Identification Record {index + 1}</h6>
                        {identificationRecords.length > 1 && (
                          <button
                            type="button"
                            className="btn btn-sm btn-danger"
                            onClick={() => removeIdentificationRecord(record.id)}
                          >
                            <FaTimes /> Remove
                          </button>
                        )}
                      </div>
                      <div className="row g-3">
                        <div className="col-12">
                          <label>Identification Details <span className="required-asterisk">*</span></label>
                          <textarea
                            className={`form-control ${errors.identification_records?.[index]?.details ? 'is-invalid' : ''}`}
                            value={record.details}
                            onChange={(e) => updateRecordDetails(record.id, e.target.value)}
                            placeholder="Enter identification details"
                          />
                          {errors.identification_records?.[index]?.details && (
                            <div className="invalid-feedback d-block">
                              {errors.identification_records[index].details.message}
                            </div>
                          )}
                        </div>
                        <div className="col-12">
                          <label>Proof of identification <span className="required-asterisk">*</span></label>
                          {record.proof ? (
                            <div className="d-flex align-items-center mt-2">
                              <span className="me-2">{record.proof.fileName}</span>
                              <a
                                href={`${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${record.proof.fileId}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                className="btn btn-sm btn-outline-primary me-2"
                              >
                                <FaDownload /> Download
                              </a>
                              <button
                                type="button"
                                className="btn btn-sm btn-outline-danger"
                                onClick={() => handleRemoveProof(record.id)}
                              >
                                <FaTimes /> Remove
                              </button>
                            </div>
                          ) : null}
                          <input
                            type="file"
                            id={`proof_${record.id}`}
                            onChange={(e) => updateRecordProof(e, record.id)}
                            className="d-none"
                            disabled={isUploading}
                          />
                          <label htmlFor={`proof_${record.id}`} className="btn btn-outline-primary w-100 mt-2">
                            {isUploading ? (
                              <>
                                <span className="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Uploading...
                              </>
                            ) : "Choose File"}
                          </label>
                          {errors.identification_records?.[index]?.proof && (
                            <div className="invalid-feedback d-block">
                              {errors.identification_records[index].proof.message}
                            </div>
                          )}
                          <small className="form-text text-muted mt-1">Max file size: 5MB (PDF, JPEG, PNG)</small>
                        </div>
                      </div>
                    </div>
                  ))}
                  <button
                    type="button"
                    className="btn btn-outline-primary mt-2"
                    onClick={addIdentificationRecord}
                  >
                    <FaPlus /> Add Another Identification Record
                  </button>
                </div>
              )}
            </div>
          </Collapsible>

          {/* Address Section */}
          <Collapsible title="Address Details" defaultOpen>
            <div className="container-fluid">
              <div className="row g-3">
                {addressDetailsSchema.map((f) => (
                  <div key={f.name} className="col-md-6">
                    <DynamicField
                      fieldConfig={f}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      trigger={trigger}
                      getValues={getValues}
                    />
                  </div>
                ))}
              </div>
            </div>
          </Collapsible>
        </div>
      </form>
    </FormProvider>
  );
};

export default StepFirst;
