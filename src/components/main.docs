import React, { useState, useEffect } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Form, Button, Card } from 'react-bootstrap';
import { 
  FaUser, FaBuilding, FaFileUpload, FaCheck, FaArrowRight, 
  FaArrowLeft, FaIdCard, FaEnvelope, FaPhone, FaMapMarkerAlt, FaUpload, FaShip 
} from 'react-icons/fa';
import './VesselRegistration.css';

// Main Registration Form Component
const VesselOwnerRegistrationForm = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  
  const methods = useForm({
    mode: 'all',
    criteriaMode: 'all',
    defaultValues: { ownerCategory: '', country: 'India' }
  });
  
  const { 
    register, 
    handleSubmit, 
    formState: { errors, isValid, dirtyFields, touchedFields }, 
    trigger, 
    setValue, 
    getValues, 
    watch,
    clearErrors
  } = methods;
  
  const totalSteps = 3;
  const ownerCategory = watch('ownerCategory');

  // Form field definitions for all steps
  const formFields = {
    step1: [
      {
        name: 'ownerCategory',
        label: 'Category of Owner',
        type: 'select',
        options: [
          { value: '', label: 'Select Category' },
          { value: 'individual', label: 'Individual' },
          { value: 'company', label: 'Company' },
          { value: 'organization', label: 'Organization' }
        ],
        required: true,
        icon: FaBuilding,
        colSize: 6,
        validation: { required: 'Owner category is required' }
      },
      {
        name: 'ownerName',
        label: 'Owner/Company Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter owner or company name',
        validation: { required: 'Owner name is required' }
      },
      {
        name: 'email',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: { 
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      {
        name: 'phoneNumber',
        label: 'Phone Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        placeholder: 'Enter 10-digit phone number',
        validation: { 
          required: 'Phone number is required',
          pattern: {
            value: /^[0-9]{10}$/,
            message: 'Phone number must be 10 digits'
          }
        }
      },
      {
        name: 'panNumber',
        label: 'PAN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter PAN number (e.g., ABCDE1234F)',
        validation: { 
          required: 'PAN number is required',
          pattern: {
            value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
            message: 'Invalid PAN format'
          }
        }
      },
      {
        name: 'gstNumber',
        label: 'GST Number',
        type: 'text',
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter GST number (if applicable)',
        validation: { 
          pattern: {
            value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
            message: 'Invalid GST format'
          }
        }
      },
      {
        name: 'addressLine1',
        label: 'Address Line-1',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 1',
        validation: { required: 'Address is required' }
      },
      {
        name: 'addressLine2',
        label: 'Address Line-2',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 2 (optional)'
      },
      {
        name: 'pincode',
        label: 'PIN',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter 6-digit PIN code',
        validation: { 
          required: 'PIN code is required',
          pattern: {
            value: /^[0-9]{6}$/,
            message: 'PIN must be 6 digits'
          }
        },
        onChangeCustom: (e, setValue, trigger) => {
          const value = e.target.value;
          if (value.length === 6) {
            setValue('district', 'Sample District');
            setValue('state', 'Sample State');
            setValue('country', 'India');
          }
          trigger('pincode');
        }
      },
      {
        name: 'district',
        label: 'District',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Auto-populated based on PIN',
        readOnly: true
      },
      {
        name: 'state',
        label: 'State/UT',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Auto-populated based on PIN',
        readOnly: true
      },
      {
        name: 'country',
        label: 'Country',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'India',
        readOnly: true,
        defaultValue: 'India'
      }
    ],
    step2: [
      {
        name: 'firstName',
        label: 'First Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter first name',
        validation: { required: 'First name is required' }
      },
      {
        name: 'lastName',
        label: 'Last Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter last name',
        validation: { required: 'Last name is required' }
      },
      {
        name: 'mobileNumber',
        label: 'Primary Mobile Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        placeholder: 'Enter 10-digit mobile number',
        validation: { 
          required: 'Mobile number is required',
          pattern: {
            value: /^[0-9]{10}$/,
            message: 'Mobile number must be 10 digits'
          }
        }
      },
      {
        name: 'authorizedEmail',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: { 
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      {
        name: 'authorizationLetter',
        label: 'Upload Letter of Authorization',
        type: 'file',
        required: true,
        colSize: 12,
        validation: { required: 'Authorization letter is required' }
      }
    ],
    step3: [
      {
        name: 'panCardUpload',
        label: 'PAN Card',
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: 'PAN card upload is required' }
      },
      {
        name: 'gstCertificate',
        label: 'GST Certificate',
        type: 'file',
        required: false,
        colSize: 6
      },
      {
        name: 'addressProof',
        label: 'Address Proof',
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: 'Address proof is required' }
      },
      {
        name: 'companyRegistrationCertificate',
        label: 'Company Registration Certificate',
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: 'Company registration certificate is required' },
        showIf: () => ownerCategory !== 'organization'
      },
      {
        name: 'cinNumber',
        label: 'CIN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter CIN number',
        validation: { 
          required: 'CIN number is required',
          pattern: {
            value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
            message: 'Invalid CIN format'
          }
        },
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'dinNumber',
        label: 'DIN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter DIN number',
        validation: { 
          required: 'DIN number is required',
          pattern: {
            value: /^[0-9]{8}$/,
            message: 'DIN must be 8 digits'
          }
        },
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'moaCertificate',
        label: 'MOA Certificate',
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: 'MOA certificate is required' },
        showIf: () => ownerCategory === 'company'
      },
      {
        name: 'aoaCertificate',
        label: 'AOA Certificate',
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: 'AOA certificate is required' },
        showIf: () => ownerCategory === 'company'
      }
    ]
  };

  // Get fields for current step
  const getCurrentStepFields = () => {
    switch(currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      case 3: return formFields.step3;
      default: return [];
    }
  };

  // Validate current step
  const validateStep = async () => {
    const fieldsToValidate = getCurrentStepFields()
      .filter(field => field.required && (!field.showIf || field.showIf()))
      .map(field => field.name);
    
    return await trigger(fieldsToValidate);
  };

  // Handle next button click
  const handleNext = async () => {
    const isStepValid = await validateStep();
    
    if (isStepValid) {
      const currentValues = getValues();
      setFormData(prev => ({ ...prev, ...currentValues }));
      
      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        onSubmit(currentValues);
      }
    }
  };

  // Handle previous button click
  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  // Handle form submission
  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };
    console.log('Form submitted with data:', finalData);
    setIsSubmitted(true);
    window.scrollTo(0, 0);
  };

  // Step titles
  const stepTitles = [
    { title: "Vessel Owner Details", icon: FaBuilding },
    { title: "Authorized Person's Details", icon: FaUser },
    { title: "Documents Upload", icon: FaFileUpload }
  ];

  // Dynamic Field Component
  const DynamicField = ({ field }) => {
    // Skip rendering if showIf condition is false
    if (field.showIf && !field.showIf()) return null;

    switch(field.type) {
      case 'select':
        return (
          <Form.Group className="form-group">
            <Form.Label>
              {field.label} {field.required && <span className="required">*</span>}
            </Form.Label>
            <div className="input-with-icon">
              <Form.Select 
                {...register(field.name, {
                  ...field.validation,
                  onChange: (e) => {
                    if (field.onChangeCustom) {
                      field.onChangeCustom(e, setValue, trigger);
                    }
                    // Validate immediately after change
                    setTimeout(() => trigger(field.name), 0);
                  }
                })}
                className={errors[field.name] ? 'is-invalid' : ''}
                disabled={field.readOnly}
              >
                {field.options.map((option, idx) => (
                  <option key={idx} value={option.value}>{option.label}</option>
                ))}
              </Form.Select>
              {field.icon && React.createElement(field.icon, { className: "input-icon" })}
            </div>
            {errors[field.name] && <div className="error-message">{errors[field.name].message}</div>}
          </Form.Group>
        );
      
      case 'file':
        return (
          <Form.Group className="form-group">
            <Form.Label>
              {field.label} {field.required && <span className="required">*</span>}
            </Form.Label>
            <div className="file-upload">
              <input 
                type="file" 
                id={field.name}
                onChange={(e) => {
                  if (e.target.files[0]) {
                    setValue(field.name, e.target.files[0].name, { shouldValidate: true });
                    // Clear error if file is selected
                    if (errors[field.name]) {
                      clearErrors(field.name);
                    }
                  }
                }}
                className="file-input"
              />
              <label htmlFor={field.name} className="file-label">
                <FaUpload className="file-icon" />
                <span className="file-text">Choose File</span>
              </label>
              <span className="file-name">
                {watch(field.name) ? watch(field.name) : 'No file chosen'}
              </span>
            </div>
            <div className="file-help-text">Upload PDF, JPG or PNG file (Max size: 2MB)</div>
            {errors[field.name] && <div className="error-message">{errors[field.name].message}</div>}
          </Form.Group>
        );
      
      default: // text, email, etc.
        return (
          <Form.Group className="form-group">
            <Form.Label>
              {field.label} {field.required && <span className="required">*</span>}
            </Form.Label>
            <div className="input-with-icon">
              <Form.Control 
                type={field.type} 
                {...register(field.name, {
                  ...field.validation,
                  onChange: (e) => {
                    if (field.onChangeCustom) {
                      field.onChangeCustom(e, setValue, trigger);
                    }
                    // Validate immediately after change
                    setTimeout(() => trigger(field.name), 0);
                  }
                })}
                className={errors[field.name] ? 'is-invalid' : field.readOnly ? 'auto-populated' : ''}
                placeholder={field.placeholder}
                readOnly={field.readOnly}
                defaultValue={field.defaultValue}
              />
              {field.icon && React.createElement(field.icon, { className: "input-icon" })}
            </div>
            {errors[field.name] && <div className="error-message">{errors[field.name].message}</div>}
          </Form.Group>
        );
    }
  };

  return (
    <Container fluid className="registration-container">
      <Row className="justify-content-center">
        <Col lg={10} xl={9}>
          <Card className="registration-card">
            <Card.Header className="registration-header">
              <div className="d-flex align-items-center">
                <FaShip className="header-icon" />
                <h3 className="mb-0">Vessel Owner Registration Form</h3>
              </div>
            </Card.Header>
            
            <Card.Body className="registration-body">
              {isSubmitted ? (
                <div className="success-container">
                  <div className="success-icon-container">
                    <FaCheck className="success-icon" />
                  </div>
                  <h4 className="success-title">Registration Successful!</h4>
                  <p className="success-message">
                    Your vessel owner registration has been submitted successfully. 
                    You will receive a confirmation email shortly.
                  </p>
                  <div className="registration-id">
                    Registration ID: {Math.random().toString(36).substring(2, 10).toUpperCase()}
                  </div>
                  <Button 
                    variant="primary" 
                    className="mt-4"
                    onClick={() => window.location.href = '/dashboard'}
                  >
                    Go to Dashboard
                  </Button>
                </div>
              ) : (
                <FormProvider {...methods}>
                  <form>
                    {/* Stepper */}
                    <div className="stepper-container">
                      <div className="stepper">
                        {[1, 2, 3].map((step) => (
                          <React.Fragment key={step}>
                            <div className={`step ${currentStep >= step ? 'active' : ''} ${currentStep > step ? 'completed' : ''}`}>
                              <div className="step-icon">
                                {currentStep > step ? <FaCheck /> : step}
                              </div>
                              <div className="step-label">{stepTitles[step-1].title}</div>
                            </div>
                            {step < 3 && (
                              <div className="step-connector">
                                <div className={`connector-line ${currentStep > step ? 'active' : ''}`}></div>
                              </div>
                            )}
                          </React.Fragment>
                        ))}
                      </div>
                    </div>
                    
                    {/* Step Content */}
                    <div className="step-content">
                      <div className="form-section">
                        <div className="section-title">
                          {React.createElement(stepTitles[currentStep-1].icon, { className: "section-icon" })}
                          <h4>{stepTitles[currentStep-1].title}</h4>
                        </div>
                        
                        <div className="form-content">
                          <Row>
                            {getCurrentStepFields().map((field, index) => (
                              <Col key={index} md={field.colSize || 12}>
                                <DynamicField field={field} />
                              </Col>
                            ))}
                          </Row>
                        </div>
                      </div>
                    </div>
                    
                    {/* Navigation Buttons */}
                    <div className="form-navigation">
                      <Button 
                        variant="outline-secondary" 
                        onClick={handlePrevious}
                        disabled={currentStep === 1}
                        className="prev-btn"
                      >
                        <FaArrowLeft className="btn-icon" /> Previous
                      </Button>
                      
                      <Button 
                        variant="primary" 
                        onClick={handleNext}
                        className="next-btn"
                      >
                        {currentStep === totalSteps ? 'Submit Registration' : 'Next'} 
                        {currentStep !== totalSteps && <FaArrowRight className="btn-icon" />}
                      </Button>
                    </div>
                  </form>
                </FormProvider>
              )}
            </Card.Body>
          </Card>
        </Col>
      </Row>
    </Container>
  );
};

export default VesselOwnerRegistrationForm;
