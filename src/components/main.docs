import React, { useImperativeHandle, forwardRef, useState } from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";
import { useNavigate, useParams } from "react-router-dom";

const themeColor = "#2E57A7";
const successColor = "#28a745";

const Stepper = forwardRef(
  (
    {
      steps,
      onSave,
      viewMode = false,
      editMode = false,
      actionComponent = null,
      onNext,
      onBack,
      onPayNow,
      onSyncData,
      onSubmit,
      onGetInvoice,
      disableStepNavigation = false,
      disableSubmit = false,
      initialStep = 0,
      omitSubmitButton = false,
      registrationData,
      pageName = "",
      displayProvision = false,
      handleProvisionModalOpen = (type) => {},
    },
    ref
  ) => {
    const { t } = useTranslation();
    const navigate = useNavigate();
    const { id } = useParams();
    const [activeStep, setActiveStep] = useState(initialStep);
    const [completed, setCompleted] = useState({});
    const [errors, setErrors] = useState({});

    const totalSteps = steps.length;
    const currentStep = steps[activeStep];

    const buttonStyle = {
      fontWeight: "600",
      borderRadius: "6px",
      fontSize: "0.75rem",
      color: "#fff",
      backgroundColor: themeColor,
      height: "32px",
      minWidth: "80px",
      maxWidth: "120px",
      padding: "6px 12px",
      textTransform: "none",
      boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
      transition: "all 0.2s ease",
      "&:hover": {
        backgroundColor: "#1f4ea0",
      },
    };

    useImperativeHandle(ref, () => ({
      goToNextStep,
      goToStep,
    }));

    const goToNextStep = () => {
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
    };

    const markStepCompleted = () => {
      setCompleted((prev) => ({ ...prev, [activeStep]: true }));
    };

    const validateAndProceed = async (callback) => {
      if (currentStep.validate) {
        const isValid = await currentStep.validate();
        setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));

        if (!isValid) {
          toast.error("Please fix the errors before proceeding.");
          return;
        }
      }

      markStepCompleted();
      callback();
    };

    const handleNext = () => {
      if (viewMode || steps?.goToNextStepNoValidtion || editMode) {
        goToNextStep();
        markStepCompleted();
      } else {
        validateAndProceed(() => {
          goToNextStep();
          onNext?.(activeStep);
        });
      }
    };

    const handleBack = () => {
      setActiveStep((prev) => Math.max(prev - 1, 0));
      onBack?.(activeStep);
    };

    const handleSave = () => {
      if (viewMode) {
        if (steps[activeStep]?.showSavaAndNextButton) {
          const currentStepInfo = {
            index: activeStep,
            label: currentStep?.label,
            component: currentStep?.component,
            validate: currentStep?.validate,
            isLastStep: activeStep === totalSteps - 1,
            completedSteps: completed,
            getFormData: currentStep?.getFormData,
          };
          onSyncData?.(currentStepInfo);
          return;
        }
        return;
      }

      if (steps[activeStep]?.goToNextStepNoValidtion || editMode) {
        goToNextStep();
        markStepCompleted();
        return;
      }

      validateAndProceed(() => {
        if (activeStep < totalSteps - 1) {
          const currentStepInfo = {
            index: activeStep,
            label: currentStep?.label,
            component: currentStep?.component,
            validate: currentStep?.validate,
            isLastStep: activeStep === totalSteps - 1,
            completedSteps: completed,
            getFormData: currentStep?.getFormData,
          };
          onSyncData?.(currentStepInfo);
        } else {
          onSave?.();
        }
      });
    };

    const handlePayNow = () => {
      // const invoiceId = id || "INV-DEFAULT";
      // navigate(`/payment/${invoiceId}`);
      onPayNow();
      // onPayNow?.() || currentStep?.component?.props?.onPayNow?.();
    };

    const handleGetInvoice = () => {
      onGetInvoice();
    };

    const handleSubmit = async () => {
      if (currentStep.validate) {
        const isValid = await currentStep.validate();
        if (!isValid) {
          toast.error("Please fix all errors before submitting.");
          return;
        }
      }

      onSubmit?.();
    };

    // console.log("showOfficerActions inside",showOfficerActions);
    // const renderActionButton = () => {
    //   if (viewMode) {
    //     return activeStep === totalSteps - 1 ? (
    //       actionComponent || (
    //         <>
    //           {!omitSubmitButton &&
    //           !registrationData?.basicDetails?.isCmnGenerated ? (
    //             <>
    //               <Button
    //                 disabled={disableSubmit}
    //                 variant="contained"
    //                 sx={buttonStyle}
    //                 onClick={handleSubmit}
    //               >
    //                 Submit
    //               </Button>
    //               {disableSubmit && (
    //                 <Button
    //                   style={{ marginLeft: "1rem" }}
    //                   variant="contained"
    //                   sx={buttonStyle}
    //                   onClick={handleGetInvoice}
    //                 >
    //                   {t("Get Invoice")}
    //                 </Button>
    //               )}
    //             </>
    //           ) : registrationData?.basicDetails?.isCmnGenerated   ? (
    //             <Button
    //               variant="contained"
    //               sx={buttonStyle}
    //               onClick={() => navigate("/dashboard")}
    //             >
    //               Close
    //             </Button>
    //           ) : null}
    //         </>
    //       )
    //     ) : (
    //       <Button variant="contained" sx={buttonStyle} onClick={handleNext}>
    //         {t("Next")}
    //       </Button>
    //     );
    //   }

    //   return activeStep === totalSteps - 1 ? (
    //     <Button variant="contained" sx={buttonStyle} onClick={handlePayNow}>
    //       {t("Proceed to Pay")}
    //     </Button>
    //   ) : (
    //     <Button variant="contained" sx={buttonStyle} onClick={handleSave}>
    //       {t("Save & Next")}
    //     </Button>
    //   );
    // };

    const renderActionButton = () => {
      if (viewMode) {
        if (steps[activeStep]?.showSavaAndNextButton) {
          return (
            <Button
              variant="contained"
              sx={buttonStyle}
              onClick={handleSave}
              title="Save current step and continue"
            >
              {t("Save & Next")}
            </Button>
          );
        }

        
        if (steps[activeStep]?.showSubmitButton) {
          const actionCheck = actionComponent || (
            <Button
              variant="contained"
              sx={buttonStyle}
              onClick={() => navigate("/dashboard")}
              title="Close and return to dashboard"
            >
              Close
            </Button>
          );

          return (
            < div style={{ display: "flex" ,gap:"8px"}}>
              <Button
                variant="contained"
                sx={buttonStyle}
                onClick={handleSubmit}
                title="Submit Certification of Registration"
              >
                {t("Save as Draft")}
              </Button>

              {/* Show Close button only on last step */}
              {activeStep === totalSteps - 1 && actionCheck}
            </div>
          );
        }

        return activeStep === totalSteps - 1 ? (
          actionComponent || (
            <>
              <Button
                variant="contained"
                sx={buttonStyle}
                onClick={() => navigate("/dashboard")}
                title="Close and return to dashboard"
              >
                Close
              </Button>
            </>
          )
        ) : (
          <Button
            variant="contained"
            sx={buttonStyle}
            onClick={handleNext}
            title="Go to next step"
          >
            {t("Next")}
          </Button>
        );
      }

      return activeStep === totalSteps - 1 ? (
        // pageName === "uploadReports"
        currentStep?.showCloseButton 
         ? (
          <Button
            variant="contained"
            sx={buttonStyle}
            onClick={() => navigate("/dashboard")}
            title="Close and return to dashboard"
          >
            Close
          </Button>
        ) : 
        // pageName === "vesselRegistration" ? 
        currentStep?.showSubmitWithInvoice ? (
          <>
            {!omitSubmitButton ? (
              <div style={{ display: "flex" ,gap:"8px"}}>
                <Button
                  disabled={disableSubmit}
                  variant="contained"
                  sx={buttonStyle}
                  onClick={handleSubmit}
                  title="Submit the form"
                >
                  Submit
                </Button>
                {disableSubmit && (
                  <Button
                    style={{ marginLeft: "8px" }}
                    variant="contained"
                    sx={buttonStyle}
                    onClick={handleGetInvoice}
                    title="Get invoice for payment"
                  >
                    {t("Get Invoice")}
                  </Button>
                )}
              </div>
            ) : null}
          </>
        ) : (
          <Button
            variant="contained"
            sx={buttonStyle}
            onClick={handlePayNow}
            title="Proceed to payment"
          >
            {t("Proceed to Pay")}
          </Button>
        )
      ) : (
        <Button
          variant="contained"
          sx={buttonStyle}
          onClick={handleSave}
          title="Save current step and continue"
        >
          {t("Save & Next")}
        </Button>
      );
    };

    const goToStep = (index) => {
      if (index >= 0 && index < totalSteps) {
        setActiveStep(index);
      }
    };

    return (
      <Box sx={{ width: "100%", padding: "1rem" }}>
        <Paper
          elevation={3}
          sx={{
            padding: "0.75rem 1.5rem",
            borderRadius: "0.75rem",
            overflowX: "auto",
            whiteSpace: "nowrap",
            backgroundColor: "#fafafa",
          }}
        >
          <Stack direction="row" alignItems="center" spacing={1}>
            {steps?.map((step, index) => (
              <React.Fragment key={index}>
                <Stack
                  direction="row"
                  alignItems="center"
                  spacing={0.5}
                  sx={{ cursor: "pointer" }}
                  onClick={() => {
                    if (
                      !disableStepNavigation &&
                      (viewMode || completed[index] || editMode)
                    ) {
                      goToStep(index);
                    }
                  }}
                >
                  {completed[index] ? (
                    <CheckCircleFill size={18} color={successColor} />
                  ) : (
                    <Typography
                      sx={{
                        fontSize: "0.875rem",
                        width: "1.5rem",
                        height: "1.5rem",
                        textAlign: "center",
                        borderRadius: "50%",
                        backgroundColor: "#e0e0e0",
                        display: "inline-flex",
                        alignItems: "center",
                        justifyContent: "center",
                        fontWeight: "bold",
                        color: "#666",
                      }}
                    >
                      {index + 1}
                    </Typography>
                  )}
                  <Typography
                    sx={{
                      fontWeight:
                        index === activeStep || completed[index]
                          ? "bold"
                          : "normal",
                      color: index === activeStep ? themeColor : "#999",
                      fontSize: "0.875rem",
                      whiteSpace: "nowrap",
                    }}
                  >
                    {step.label}
                  </Typography>
                </Stack>
                {index < steps.length - 1 && (
                  <ChevronRight size={14} color="green" />
                )}
              </React.Fragment>
            ))}
          </Stack>
        </Paper>

        <Paper
          elevation={2}
          sx={{
            marginTop: "1rem",
            borderRadius: "0.75rem",
            backgroundColor: "#fff",
            width: "100%",
          }}
        >
          {currentStep.component}
          {errors[activeStep]}
        </Paper>

        <Divider sx={{ margin: "2rem 0" }} />

        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            gap: "1rem",
            flexDirection: { xs: "column", sm: "row" },
            alignItems: { xs: "stretch", sm: "center" },
          }}
        >
          <Button
            variant="outlined"
            onClick={handleBack}
            disabled={activeStep === 0}
            sx={{
              color: themeColor,
              borderColor: themeColor,
              fontWeight: "600",
              borderRadius: "6px",
              fontSize: "0.75rem",
              height: "32px",
              minWidth: "80px",
              maxWidth: "120px",
              padding: "6px 12px",
              textTransform: "none",
              boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
              transition: "all 0.2s ease",
            }}
            title="Go to previous step"
          >
            {t("Previous")}
          </Button>

          {renderActionButton()}
        </Box>
      </Box>
    );
  }
);

export default Stepper;
