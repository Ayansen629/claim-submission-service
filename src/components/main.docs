import React, { useState, useEffect, useRef } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams, useLocation, useNavigate } from "react-router-dom";
import Stepper from "../../../../common/Stepper.jsx";
import VesselSurveyForm from "./VesselSurveyForm.js";
// import Documents from "./Documents.js";
import { useForm } from "react-hook-form";
import { useTranslation } from "react-i18next";
import { toast } from "react-toastify";
import { Button } from "react-bootstrap";
import { BsArrowLeft } from "react-icons/bs";
import { postFORMdata } from "../../../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../../../utils/urlsConstants.ts";
import VesselEquipmentForm from "./VesselEquipmentForm.js";

const VesselSurveyRegistration = () => {
  const { t } = useTranslation();
  const { id } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  const isEditMode = !!id && location.pathname.includes("/edit/");
  const isViewMode = !!id && location.pathname.includes("/view/");
  const stepperRef = useRef();

  const methods = useForm({ mode: "onTouched" });
  const { trigger, getValues, setError, setValue, reset } = methods;

  const [isLoading, setIsLoading] = useState(false);

  const validateSurveyForm = async () => {
    if (isViewMode) return true;
    
    const requiredFields = [
      "typeOfSurvey",
      "placeYardNo", 
      "netTonnage",
      "hullLength",
      "hullBreadth", 
      "hullDepth"
    ];

    const crewDetails = getValues("crewDetails") || [];
    const hasValidCrew = crewDetails.some(crew => crew.crewType && crew.name);
    
    if (!hasValidCrew) {
      setError("crewDetails", {
        type: "required",
        message: t("At least one crew member is required")
      });
      return false;
    }

    return await trigger(requiredFields);
  };

  const validateEquipmentForm = async () => {
    if (isViewMode) return true;
    return true;
  };
//   const validateDocuments = async () => {
//     if (isViewMode) return true;

//     const requiredFiles = [
//       "authorizationFile",
//       "paymentChallan", 
//       "lastCertificateCopy",
//       "registrationCertificateCopy"
//     ];

//     let hasErrors = false;
//     requiredFiles.forEach(fieldName => {
//       const fieldValue = getValues(fieldName);
//       if (!fieldValue && !isEditMode) {
//         setError(fieldName, {
//           type: "required",
//           message: `${fieldName} is required`
//         });
//         hasErrors = true;
//       }
//     });

//     return !hasErrors;
//   };

  const handleFormSubmit = async (stepInfo) => {
    if (stepInfo.index === 0) {
      const formValues = stepInfo?.getFormData?.() || {};
      
      const request = {
        surveyDetails: {
          typeOfSurvey: formValues.typeOfSurvey,
          placeYardNo: formValues.placeYardNo,
          netTonnage: formValues.netTonnage,
          hullLength: formValues.hullLength,
          hullBreadth: formValues.hullBreadth,
          hullDepth: formValues.hullDepth,
          hullMaterial: formValues.hullMaterial,
          hullPlattingThickness: formValues.hullPlattingThickness,
          keelLayingDate: formValues.keelLayingDate,
          agentName: formValues.agentName,
          agentAddress: formValues.agentAddress,
          agentTelephone: formValues.agentTelephone,
          placeOfLastSurvey: formValues.placeOfLastSurvey,
          dateOfLastSurvey: formValues.dateOfLastSurvey,
          dateOfProposedVisit: formValues.dateOfProposedVisit,
          crewDetails: formValues.crewDetails?.filter(crew => crew.crewType && crew.name) || []
        }
      };

      const fd = new FormData();
      fd.append("request", new Blob([JSON.stringify(request)], { type: "application/json" }));

      try {
        setIsLoading(true);
        const URL = process.env.REACT_APP_IWT_URL + URLS_ENDPOINT.VESSEL_SERVICE.CREATE_SURVEY;
        const response = await postFORMdata(URL, fd);
        
        if (response?.status === 200) {
          toast.success("Survey details saved successfully.");
          stepperRef.current?.goToNextStep();
        } else {
          toast.error("Something went wrong.");
        }
      } catch (err) {
        console.error(err);
        toast.error("Error saving survey details.");
      } finally {
        setIsLoading(false);
      }
    }
  };

  const handleSave = () => {
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      navigate("/vessel-survey/success", {
        state: { surveyId: "VS2024001" }
      });
    }, 1500);
  };

  const steps = [
    {
      label: t("Survey Details"),
      component: (
        <VesselSurveyForm
          formMethods={methods}
          viewMode={isViewMode}
          editMode={isEditMode}
        />
      ),
      validate: validateSurveyForm,
      getFormData: () => methods?.getValues(),
    },
    {
        label: t("Vessel Equipment"),
        component: (
            <VesselEquipmentForm
            formMethods={methods}
            viewMode={isViewMode}
            editMode={isEditMode}
            />
        ),
        validate: validateEquipmentForm,
        getFormData: () => methods?.getValues(),

    }
    // {
    //   label: t("Documents"),
    //   component: (
    //     <Documents
    //       formMethods={methods}
    //       viewMode={isViewMode}
    //       editMode={isEditMode}
    //     />
    //   ),
    //   validate: validateDocuments,
    //   getFormData: () => methods?.getValues(),
    // }
  ];

  return (
    <Box sx={{ padding: "1rem 0.5rem 0 0.5rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {isLoading ? (
        <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
          <div className="text-center">
            <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
              <span className="visually-hidden">Loading...</span>
            </div>
            <p className="mt-3">Processing your request...</p>
          </div>
        </div>
      ) : (
        <>
          <div className="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
            <div className="d-flex align-items-center flex-grow-1" style={{ gap: '20px' }}>
              <Button
                variant="outline-primary"
                size="sm"
                onClick={() => navigate("/dashboard")}
                className="d-flex align-items-center shadow-sm"
                style={{
                  borderRadius: "8px",
                  fontSize: "0.6rem",
                  fontWeight: "200",
                  border: "2px solid #2E57A7",
                  color: "#2E57A7",
                  backgroundColor: "#fff",
                  transition: "all 0.3s ease",
                  minWidth: "auto",
                  whiteSpace: "nowrap"
                }}
              >
                <BsArrowLeft className="me-2" size={10} />
                Back
              </Button>
              <Stack spacing={0.5} className="flex-grow-1">
                <Typography
                  sx={{
                    fontWeight: 550,
                    color: "#2E57A7",
                    fontSize: { xs: "1rem", sm: "1.1rem", md: "1.2rem" },
                    lineHeight: 1.2,
                  }}
                >
                  {isViewMode
                    ? t("View Vessel Survey") + ` - ${id}`
                    : isEditMode
                    ? t("Edit Vessel Survey") + ` - ${id}`
                    : t("New Vessel Survey")}
                </Typography>
                <Typography
                  sx={{
                    color: "#666",
                    fontSize: { xs: "0.6rem", sm: "0.65rem" },
                    lineHeight: 1.3,
                  }}
                >
                  {isViewMode
                    ? t("(View vessel survey details)")
                    : isEditMode
                    ? t("(Update vessel survey details)")
                    : t("(Fill in the survey details to complete registration)")}
                </Typography>
              </Stack>
            </div>
          </div>

          <Stepper
            ref={stepperRef}
            steps={steps}
            onSave={handleSave}
            viewMode={isViewMode}
            onSyncData={handleFormSubmit}
          />
        </>
      )}
    </Box>
  );
};

export default VesselSurveyRegistration;
import React, { useState, useEffect, useRef, useCallback } from "react";
import { useForm, useFieldArray } from "react-hook-form";
import { Row, Col, Button } from "react-bootstrap";
import InputText from "../../../../common/InputText.tsx";
import InputSelect from "../../../../common/InputSelect.tsx";
import InputFile from "../../../../common/InputFile.tsx";
import Collapsible from "../../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import { FaShip, FaCog, FaBroadcastTower, FaLeaf, FaUsers, FaFileUpload, FaPlus, FaTrash } from "react-icons/fa";
// import { useMasterData } from "../../../context/MasterDataContext.js";

const VesselSurveyForm = ({ formMethods, viewMode = false, editMode = false }) => {
  const { t } = useTranslation();
  // const { masterData } = useMasterData();

  const defaultValues = {
    // Basic Vessel Information
    typeOfSurvey: "",
    placeYardNo: "",
    nameOfVessel: "",
    officialNo: "",
    portOfRegistry: "",
    grossTonnage: "",
    netTonnage: "",
    typeOfVessel: "",
    categoryOfVessel: "",
    yearOfBuild: "",
    nameOfOwner: "",
    addressOfOwner: "",
    ownerTelephone: "",
    nameOfBuilder: "",
    addressOfBuilder: "",
    agentName: "",
    agentAddress: "",
    agentTelephone: "",
    placeOfLastSurvey: "",
    dateOfLastSurvey: "",
    dateOfProposedVisit: "",

    // Hull Particulars
    hullLength: "",
    hullBreadth: "",
    hullDepth: "",
    hullMaterial: "",
    hullPlattingThickness: "",
    keelLayingDate: "",

    // Engine Details
    typeOfEngine: "",
    engineMake: "",
    engineMakerAddress: "",
    modelNo: "",
    numberOfEngine: "",
    yearOfMake: "",
    horsepower: "",
    speedRPM: "",
    strokeEngine: "",
    numberOfSetFitted: "",
    setSrNo: "",
    engineCylinderDiameter: "",
    propellerType: "",
    gearType: "",
    noOfGear: "",
    vesselSpeed: "",
    revolutionMints: "",

    // Radio and Navigation Equipment
    magneticCompass: "",
    vhfRadio: "",
    classBAutoAIS: "",
    gpsNavigator: "",
    binocular: "",
    aldisLamp: "",
    rudderAngleIndicator: "",
    othersNavigation: "",

    // Pollution Control Devices
    bilgeWaterSeparator: "",
    bilgeCapacity: "",
    bilgeMakeModel: "",
    sewageTreatmentPlant: "",
    sewageCapacity: "",
    sewageMakeModel: "",
    oilyWaterFilter: "",
    oilyCapacity: "",
    oilyMakeModel: "",
    exhaustGasCleaning: "",
    exhaustCapacity: "",
    exhaustMakeModel: "",
    othersPollution: "",
    othersCapacity: "",
    othersMakeModel: "",

    // Crew Details
    crewDetails: [
      {
        crewType: "",
        name: "",
        rank: "",
        cocNo: "",
        validity: "",
        experience: ""
      }
    ],

    // Enclosures
    authorizationFile: null,
    paymentChallan: null,
    lastCertificateCopy: null,
    registrationCertificateCopy: null
  };

  const internalFormMethods = useForm({
    defaultValues,
    mode: "onTouched",
  });

  const methods = formMethods || internalFormMethods;
  const { register, watch, setValue, clearErrors, formState: { errors } } = methods;

  const { fields, append, remove } = useFieldArray({
    control: methods.control,
    name: "crewDetails"
  });
useEffect(() => {
  const currentCrewDetails = watch("crewDetails");
  if (!currentCrewDetails || currentCrewDetails.length === 0) {
    setValue("crewDetails", [{
      crewType: "",
      name: "",
      rank: "",
      cocNo: "",
      validity: "",
      experience: ""
    }]);
  }
}, [setValue, watch]);
  const handleFileChange = useCallback((name, file) => {
    if (!file) return;

    const validTypes = ["application/pdf", "image/jpeg", "image/png", "image/jpg"];
    if (!validTypes.includes(file.type)) {
      methods.setError(name, {
        type: "manual",
        message: t("Only PDF, JPG or PNG files are allowed"),
      });
      setValue(name, null);
      return;
    }

    if (file.size > 10 * 1024 * 1024) {
      methods.setError(name, {
        type: "manual",
        message: t("File size should not exceed 10MB"),
      });
      setValue(name, null);
      return;
    }

    clearErrors(name);
    setValue(name, file, { shouldValidate: true });
  }, [setValue, clearErrors, methods, t]);

  const surveyTypeOptions = [
    { value: "", label: "-- Select --" },
    { value: "INITIAL", label: "Initial Survey" },
    { value: "ANNUAL", label: "Annual Survey" },
    { value: "INTERMEDIATE", label: "Intermediate Survey" },
    { value: "RENEWAL", label: "Renewal Survey" }
  ];

  const propellerTypeOptions = [
    { value: "", label: "-- Select --" },
    { value: "FIXED", label: "Fixed Pitch" },
    { value: "VARIABLE", label: "Variable Pitch" },
    { value: "CONTROLLABLE", label: "Controllable Pitch" }
  ];

  const crewTypeOptions = [
    { value: "", label: "-- Select --" },
    { value: "MASTER", label: "Master" },
    { value: "CHIEF_ENGINEER", label: "Chief Engineer" },
    { value: "DECK_OFFICER", label: "Deck Officer" },
    { value: "ENGINE_OFFICER", label: "Engine Officer" },
    { value: "CREW", label: "Crew Member" }
  ];

  return (
    <form autoComplete="off">
      {/* Basic Vessel Information */}
      <Collapsible
        title={
          <>
            <FaShip className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Basic Vessel Information")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputSelect
              label={t("Type of Survey")}
              required={true}
              name="typeOfSurvey"
              options={surveyTypeOptions}
              register={register("typeOfSurvey", {
                required: t("Type of Survey is required"),
              })}
              errors={errors}
              value={watch("typeOfSurvey") || ""}
              onChange={(value) => !viewMode && setValue("typeOfSurvey", value)}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Place/Yard No.")}
              required={true}
              name="placeYardNo"
              placeholder={t("Enter Place/Yard No.")}
              register={register("placeYardNo", {
                required: t("Place/Yard No. is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Name of Vessel")}
              name="nameOfVessel"
              placeholder={t("Auto Populated")}
              register={register("nameOfVessel")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Official No. of the Vessel")}
              name="officialNo"
              placeholder={t("Auto Populated")}
              register={register("officialNo")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Port of Registry of Vessel")}
              name="portOfRegistry"
              placeholder={t("Auto Populated")}
              register={register("portOfRegistry")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Gross Tonnage")}
              name="grossTonnage"
              placeholder={t("Auto Populated")}
              register={register("grossTonnage")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Net Tonnage")}
              required={true}
              name="netTonnage"
              type="number"
              placeholder={t("Enter Net Tonnage")}
              register={register("netTonnage", {
                required: t("Net Tonnage is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Type of Vessel")}
              name="typeOfVessel"
              placeholder={t("Auto Populated")}
              register={register("typeOfVessel")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Category of Vessel")}
              name="categoryOfVessel"
              placeholder={t("Auto Populated")}
              register={register("categoryOfVessel")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Year of Build")}
              name="yearOfBuild"
              placeholder={t("Auto Populated")}
              register={register("yearOfBuild")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Name of Owner")}
              name="nameOfOwner"
              placeholder={t("Auto Populated")}
              register={register("nameOfOwner")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Address of Owner")}
              name="addressOfOwner"
              placeholder={t("Auto Populated")}
              register={register("addressOfOwner")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Owner's Telephone No.")}
              name="ownerTelephone"
              placeholder={t("Auto Populated")}
              register={register("ownerTelephone")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Name of Builder")}
              name="nameOfBuilder"
              placeholder={t("Auto Populated")}
              register={register("nameOfBuilder")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Address of Builder")}
              name="addressOfBuilder"
              placeholder={t("Auto Populated")}
              register={register("addressOfBuilder")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Agent's Name")}
              name="agentName"
              placeholder={t("Enter Agent's Name")}
              register={register("agentName")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Agent's Address")}
              name="agentAddress"
              placeholder={t("Enter Agent's Address")}
              register={register("agentAddress")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Agent's Telephone No.")}
              name="agentTelephone"
              placeholder={t("Enter Agent's Telephone")}
              register={register("agentTelephone")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Place of Last Survey")}
              name="placeOfLastSurvey"
              placeholder={t("Enter Place of Last Survey")}
              register={register("placeOfLastSurvey")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Date of Last Survey")}
              name="dateOfLastSurvey"
              type="date"
              register={register("dateOfLastSurvey")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Date of Proposed Visit of Surveyor")}
              name="dateOfProposedVisit"
              type="date"
              register={register("dateOfProposedVisit")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Hull Particulars */}
      <Collapsible
        title={
          <>
            <FaShip className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Hull Particulars")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Length of the Hull (Meter)")}
              required={true}
              name="hullLength"
              type="number"
              placeholder={t("Enter Hull Length")}
              register={register("hullLength", {
                required: t("Hull Length is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Breadth of the Hull (Meter)")}
              required={true}
              name="hullBreadth"
              type="number"
              placeholder={t("Enter Hull Breadth")}
              register={register("hullBreadth", {
                required: t("Hull Breadth is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Depth of the Hull (Meter)")}
              required={true}
              name="hullDepth"
              type="number"
              placeholder={t("Enter Hull Depth")}
              register={register("hullDepth", {
                required: t("Hull Depth is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Hull Material")}
              name="hullMaterial"
              placeholder={t("Enter Hull Material")}
              register={register("hullMaterial")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Hull Platting Thickness (mm)")}
              name="hullPlattingThickness"
              type="number"
              placeholder={t("Enter Thickness")}
              register={register("hullPlattingThickness")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Keel Laying Date")}
              name="keelLayingDate"
              type="date"
              register={register("keelLayingDate")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Engine Details */}
      <Collapsible
        title={
          <>
            <FaCog className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Details of Propulsion of Engine")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Type of Engine")}
              name="typeOfEngine"
              placeholder={t("Auto Populated")}
              register={register("typeOfEngine")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Engine Make")}
              name="engineMake"
              placeholder={t("Auto Populated")}
              register={register("engineMake")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Engine Maker Address")}
              name="engineMakerAddress"
              placeholder={t("Auto Populated")}
              register={register("engineMakerAddress")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Model No.")}
              name="modelNo"
              placeholder={t("Enter Model No.")}
              register={register("modelNo")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Number of Engine")}
              name="numberOfEngine"
              type="number"
              placeholder={t("Enter Number of Engine")}
              register={register("numberOfEngine")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Year of Make")}
              name="yearOfMake"
              placeholder={t("Auto Populated")}
              register={register("yearOfMake")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Horsepower")}
              name="horsepower"
              placeholder={t("Auto Populated")}
              register={register("horsepower")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Speed/RPM")}
              name="speedRPM"
              placeholder={t("Auto Populated")}
              register={register("speedRPM")}
              errors={errors}
              disabled={true}
              style={{ backgroundColor: "#f8f9fa" }}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Stroke (Engine)")}
              name="strokeEngine"
              placeholder={t("Enter Stroke")}
              register={register("strokeEngine")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Number of Set Fitted")}
              name="numberOfSetFitted"
              type="number"
              placeholder={t("Enter Number of Set")}
              register={register("numberOfSetFitted")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Set Sr. No.")}
              name="setSrNo"
              placeholder={t("Enter Set Sr. No.")}
              register={register("setSrNo")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Engine Cylinder Diameter (mm)")}
              name="engineCylinderDiameter"
              type="number"
              placeholder={t("Enter Diameter")}
              register={register("engineCylinderDiameter")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputSelect
              label={t("Propeller Type")}
              name="propellerType"
              options={propellerTypeOptions}
              register={register("propellerType")}
              errors={errors}
              value={watch("propellerType") || ""}
              onChange={(value) => !viewMode && setValue("propellerType", value)}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Gear Type")}
              name="gearType"
              placeholder={t("Enter Gear Type")}
              register={register("gearType")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("No. of Gear")}
              name="noOfGear"
              type="number"
              placeholder={t("Enter No. of Gear")}
              register={register("noOfGear")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Vessel Speed")}
              name="vesselSpeed"
              placeholder={t("Enter Vessel Speed")}
              register={register("vesselSpeed")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Revolution/mints")}
              name="revolutionMints"
              type="number"
              placeholder={t("Enter Revolution/mints")}
              register={register("revolutionMints")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Radio and Navigation Equipment */}
      <Collapsible
        title={
          <>
            <FaBroadcastTower className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Radio and navigation equipment")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Magnetic Compass")}
              name="magneticCompass"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("magneticCompass")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Very High Frequency (VHF) radio")}
              name="vhfRadio"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("vhfRadio")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Class B Automatic Identification System (AIS) with display")}
              name="classBAutoAIS"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("classBAutoAIS")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Global Positioning System (GPS) Navigator")}
              name="gpsNavigator"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("gpsNavigator")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Binocular")}
              name="binocular"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("binocular")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Aldis lamp or search light")}
              name="aldisLamp"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("aldisLamp")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Rudder angle indicator")}
              name="rudderAngleIndicator"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("rudderAngleIndicator")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Others")}
              name="othersNavigation"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("othersNavigation")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Pollution Control Devices */}
      <Collapsible
        title={
          <>
            <FaLeaf className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Pollution Control Devices")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Bilge Water Separator")}
              name="bilgeWaterSeparator"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("bilgeWaterSeparator")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Capacity (m3/hr)")}
              name="bilgeCapacity"
              placeholder={t("Enter capacity")}
              register={register("bilgeCapacity")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Make & Model")}
              name="bilgeMakeModel"
              placeholder={t("Enter make & model")}
              register={register("bilgeMakeModel")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Sewage Treatment Plant")}
              name="sewageTreatmentPlant"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("sewageTreatmentPlant")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Capacity (m3/hr)")}
              name="sewageCapacity"
              placeholder={t("Enter capacity")}
              register={register("sewageCapacity")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Make & Model")}
              name="sewageMakeModel"
              placeholder={t("Enter make & model")}
              register={register("sewageMakeModel")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Oily Water Filter")}
              name="oilyWaterFilter"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("oilyWaterFilter")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Capacity (m3/hr)")}
              name="oilyCapacity"
              placeholder={t("Enter capacity")}
              register={register("oilyCapacity")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Make & Model")}
              name="oilyMakeModel"
              placeholder={t("Enter make & model")}
              register={register("oilyMakeModel")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Exhaust Gas Cleaning System")}
              name="exhaustGasCleaning"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("exhaustGasCleaning")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Capacity (m3/hr)")}
              name="exhaustCapacity"
              placeholder={t("Enter capacity")}
              register={register("exhaustCapacity")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Make & Model")}
              name="exhaustMakeModel"
              placeholder={t("Enter make & model")}
              register={register("exhaustMakeModel")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Others")}
              name="othersPollution"
              type="number"
              placeholder={t("Enter quantity")}
              register={register("othersPollution")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Capacity (m3/hr)")}
              name="othersCapacity"
              placeholder={t("Enter capacity")}
              register={register("othersCapacity")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Make & Model")}
              name="othersMakeModel"
              placeholder={t("Enter make & model")}
              register={register("othersMakeModel")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
        </Row>
      </Collapsible>

      {/* Crew Details */}
      <Collapsible
        title={
          <>
            <FaUsers className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Crew Details")}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem" }}>
          {fields.map((field, index) => (
            <Row key={field.id} className="gy-3 mb-3 border-bottom pb-3">
              <Col md={2}>
                <InputSelect
                  label={t("Crew Type")}
                  required={true}
                  name={`crewDetails.${index}.crewType`}
                  options={crewTypeOptions}
                  register={register(`crewDetails.${index}.crewType`, {
                    required: t("Crew Type is required"),
                  })}
                  errors={errors}
                  value={watch(`crewDetails.${index}.crewType`) || ""}
                  onChange={(value) => !viewMode && setValue(`crewDetails.${index}.crewType`, value)}
                  disabled={viewMode}
                />
              </Col>
              <Col md={2}>
                <InputText
                  label={t("Name")}
                  required={true}
                  name={`crewDetails.${index}.name`}
                  placeholder={t("Enter Name")}
                  register={register(`crewDetails.${index}.name`, {
                    required: t("Name is required"),
                  })}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={2}>
                <InputText
                  label={t("Rank")}
                  name={`crewDetails.${index}.rank`}
                  placeholder={t("Enter Rank")}
                  register={register(`crewDetails.${index}.rank`)}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={2}>
                <InputText
                  label={t("COC No.")}
                  name={`crewDetails.${index}.cocNo`}
                  placeholder={t("Enter COC No.")}
                  register={register(`crewDetails.${index}.cocNo`)}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={2}>
                <InputText
                  label={t("Validity")}
                  name={`crewDetails.${index}.validity`}
                  placeholder={t("Enter Validity")}
                  register={register(`crewDetails.${index}.validity`)}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={2}>
                <InputText
                  label={t("Experience")}
                  name={`crewDetails.${index}.experience`}
                  placeholder={t("Enter Experience")}
                  register={register(`crewDetails.${index}.experience`)}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              {!viewMode && index > 0 && (
                <Col md={12} className="text-end">
                  <Button
                    variant="danger"
                    size="sm"
                    onClick={() => remove(index)}
                    className="mt-1"
                  >
                    <FaTrash /> Remove
                  </Button>
                </Col>
              )}
            </Row>
          ))}
          {!viewMode && (
            <Button
              variant="outline-primary"
              onClick={() => append({
                crewType: "",
                name: "",
                rank: "",
                cocNo: "",
                validity: "",
                experience: ""
              })}
              className="mt-2"
            >
              <FaPlus className="me-2" /> Add Crew Member
            </Button>
          )}
        </div>
      </Collapsible>

      {/* Enclosure */}
      <Collapsible
        title={
          <>
            <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Enclosure")}</span>
          </>
        }
        openStat={true}
      >
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={6}>
            <InputFile
              label={t("Authorization of Authorised Person")}
              required={true}
              name="authorizationFile"
              register={register("authorizationFile", {
                required: !editMode && t("Authorization file is required"),
              })}
              errors={errors}
              onChange={(e) => {
                if (viewMode) return;
                if (e.target.files && e.target.files[0]) {
                  handleFileChange("authorizationFile", e.target.files[0]);
                }
              }}
              disabled={viewMode}
              watch={watch}
              defaultValue={watch("authorizationFile")}
              clearErrors={clearErrors}
              accept=".pdf,.jpg,.jpeg,.png"
            />
          </Col>
          <Col md={6}>
            <InputFile
              label={t("Payment Challan/Acknowledgement")}
              required={true}
              name="paymentChallan"
              register={register("paymentChallan", {
                required: !editMode && t("Payment challan is required"),
              })}
              errors={errors}
              onChange={(e) => {
                if (viewMode) return;
                if (e.target.files && e.target.files[0]) {
                  handleFileChange("paymentChallan", e.target.files[0]);
                }
              }}
              disabled={viewMode}
              watch={watch}
              defaultValue={watch("paymentChallan")}
              clearErrors={clearErrors}
              accept=".pdf,.jpg,.jpeg,.png"
            />
          </Col>
          <Col md={6}>
            <InputFile
              label={t("Copy of last Certificate of Survey")}
              required={true}
              name="lastCertificateCopy"
              register={register("lastCertificateCopy", {
                required: !editMode && t("Last certificate copy is required"),
              })}
              errors={errors}
              onChange={(e) => {
                if (viewMode) return;
                if (e.target.files && e.target.files[0]) {
                  handleFileChange("lastCertificateCopy", e.target.files[0]);
                }
              }}
              disabled={viewMode}
              watch={watch}
              defaultValue={watch("lastCertificateCopy")}
              clearErrors={clearErrors}
              accept=".pdf,.jpg,.jpeg,.png"
            />
          </Col>
          <Col md={6}>
            <InputFile
              label={t("Copy of Certificate of Registration")}
              required={true}
              name="registrationCertificateCopy"
              register={register("registrationCertificateCopy", {
                required: !editMode && t("Registration certificate copy is required"),
              })}
              errors={errors}
              onChange={(e) => {
                if (viewMode) return;
                if (e.target.files && e.target.files[0]) {
                  handleFileChange("registrationCertificateCopy", e.target.files[0]);
                }
              }}
              disabled={viewMode}
              watch={watch}
              defaultValue={watch("registrationCertificateCopy")}
              clearErrors={clearErrors}
              accept=".pdf,.jpg,.jpeg,.png"
            />
          </Col>
        </Row>
      </Collapsible>
    </form>
  );
};

export default VesselSurveyForm;
import React, { useState } from "react";
import { Row, Col, Table, Form } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import Collapsible from "../../../../common/Collapsible.js";
import { FaFire, FaCog, FaCompass, FaUsers, FaShieldAlt, FaBolt, FaHome } from "react-icons/fa";

const VesselEquipmentForm = ({ formMethods, viewMode = false, editMode = false }) => {
  const { t } = useTranslation();
  const { register, watch, setValue, formState: { errors } } = formMethods;

  const [equipmentData, setEquipmentData] = useState({
    fireFighting: {
      fireFightingPlan: { number: "", type: "", location: "", condition: "", remarks: "" },
      firePumpsMech: { number: "", type: "", location: "", condition: "", remarks: "" },
      firePumpsHand: { number: "", type: "", location: "", condition: "", remarks: "" },
      portableExtinguishers: { number: "", type: "", location: "", condition: "", remarks: "" },
      fixedExtinguishing: { number: "", type: "", location: "", condition: "", remarks: "" },
      fireBuckets: { number: "", type: "", location: "", condition: "", remarks: "" },
      sandBoxes: { number: "", type: "", location: "", condition: "", remarks: "" },
      hydrants: { number: "", type: "", location: "", condition: "", remarks: "" },
      hosesAndFittings: { number: "", type: "", location: "", condition: "", remarks: "" }
    },
    equipment: {
      anchors: { number: "", type: "", location: "", condition: "", remarks: "" },
      anchorCables: { number: "", type: "", location: "", condition: "", remarks: "" },
      bilgePumps: { number: "", type: "", location: "", condition: "", remarks: "" },
      winches: { number: "", type: "", location: "", condition: "", remarks: "" },
      cranes: { number: "", type: "", location: "", condition: "", remarks: "" },
      derricks: { number: "", type: "", location: "", condition: "", remarks: "" },
      towingEquipment: { number: "", type: "", location: "", condition: "", remarks: "" },
      ropesAndLines: { number: "", type: "", location: "", condition: "", remarks: "" },
      collisionMat: { number: "", type: "", location: "", condition: "", remarks: "" },
      gangway: { number: "", type: "", location: "", condition: "", remarks: "" },
      fenders: { number: "", type: "", location: "", condition: "", remarks: "" },
      boatHook: { number: "", type: "", location: "", condition: "", remarks: "" },
      firstAidKit: { number: "", type: "", location: "", condition: "", remarks: "" },
      binoculars: { number: "", type: "", location: "", condition: "", remarks: "" },
      wasteContainers: { number: "", type: "", location: "", condition: "", remarks: "" },
      heavingLine: { number: "", type: "", location: "", condition: "", remarks: "" },
      axe: { number: "", type: "", location: "", condition: "", remarks: "" },
      torch: { number: "", type: "", location: "", condition: "", remarks: "" }
    },
    navigation: {
      navigationLights: { number: "", type: "", location: "", condition: "", remarks: "" },
      soundSignals: { number: "", type: "", location: "", condition: "", remarks: "" },
      shapes: { number: "", type: "", location: "", condition: "", remarks: "" },
      magneticCompass: { number: "", type: "", location: "", condition: "", remarks: "" },
      classBais: { number: "", type: "", location: "", condition: "", remarks: "" },
      communicationEquipment: { number: "", type: "", location: "", condition: "", remarks: "" },
      nauticalPublications: { number: "", type: "", location: "", condition: "", remarks: "" }
    },
    lifeSaving: {
      lifejackets: { number: "", type: "", location: "", condition: "", remarks: "" },
      liferafts: { number: "", type: "", location: "", condition: "", remarks: "" },
      launchingArrangements: { number: "", type: "", location: "", condition: "", remarks: "" },
      flotationDevices: { number: "", type: "", location: "", condition: "", remarks: "" },
      lifebuoys: { number: "", type: "", location: "", condition: "", remarks: "" },
      flaresParachute: { number: "", type: "", location: "", condition: "", remarks: "" },
      flaresHandHeld: { number: "", type: "", location: "", condition: "", remarks: "" },
      smokeSignals: { number: "", type: "", location: "", condition: "", remarks: "" },
      lifeRaftEquipment: { number: "", type: "", location: "", condition: "", remarks: "" },
      emergencyCommunications: { number: "", type: "", location: "", condition: "", remarks: "" }
    },
    machinery: {
      mainMachinery: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      mainGenerator: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      emergencyGenerator: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      mainSteeringGear: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      auxiliarySteeringGear: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      switchboard: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      shoreConnection: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      batteries: { bhp: "", type: "", location: "", condition: "", remarks: "" },
      signalLightSwitches: { bhp: "", type: "", location: "", condition: "", remarks: "" }
    },
    accommodation: {
      escapeRoutes: { number: "", type: "", location: "", condition: "", remarks: "" },
      washrooms: { number: "", type: "", location: "", condition: "", remarks: "" },
      toilets: { number: "", type: "", location: "", condition: "", remarks: "" },
      galley: { number: "", type: "", location: "", condition: "", remarks: "" },
      messroom: { number: "", type: "", location: "", condition: "", remarks: "" },
      waterTanks: { number: "", type: "", location: "", condition: "", remarks: "" },
      hvac: { number: "", type: "", location: "", condition: "", remarks: "" },
      berthLocker: { number: "", type: "", location: "", condition: "", remarks: "" },
      accessToAccommodation: { number: "", type: "", location: "", condition: "", remarks: "" },
      lighting: { number: "", type: "", location: "", condition: "", remarks: "" },
      machineryGuards: { number: "", type: "", location: "", condition: "", remarks: "" },
      guardRails: { number: "", type: "", location: "", condition: "", remarks: "" },
      nonSlipSurfaces: { number: "", type: "", location: "", condition: "", remarks: "" },
      laddersCompanionways: { number: "", type: "", location: "", condition: "", remarks: "" },
      noiseInsulation: { number: "", type: "", location: "", condition: "", remarks: "" },
      foamFlotation: { number: "", type: "", location: "", condition: "", remarks: "" }
    }
  });

  const [passengerDecks, setPassengerDecks] = useState([
    { deckType: "", size: "", function: "", maxPassengers: "", remarks: "" }
  ]);

  const [freeboardData, setFreeboardData] = useState([
    { minFreeboard: "", passengers: "", cargo: "" }
  ]);

  const handleInputChange = (section, item, field, value) => {
    if (viewMode) return;
    setEquipmentData(prev => ({
      ...prev,
      [section]: {
        ...prev[section],
        [item]: {
          ...prev[section][item],
          [field]: value
        }
      }
    }));
  };

  const renderEquipmentTable = (title, icon, section, data, isNumberField = true) => (
    <Collapsible
      title={
        <>
          {icon}
          <span>{t(title)}</span>
        </>
      }
      openStat={true}
    >
      <div style={{ padding: "1rem", overflowX: "auto" }}>
        <Table striped bordered hover responsive className="mb-0">
          <thead style={{ backgroundColor: "#f8f9fa" }}>
            <tr>
              <th style={{ minWidth: "200px", fontWeight: "600", color: "#2466BF" }}>
                {t("Equipment")}
              </th>
              <th style={{ minWidth: "100px", fontWeight: "600", color: "#2466BF" }}>
                {isNumberField ? t("Number") : t("BHP")}
              </th>
              <th style={{ minWidth: "150px", fontWeight: "600", color: "#2466BF" }}>
                {t("Type")}
              </th>
              <th style={{ minWidth: "150px", fontWeight: "600", color: "#2466BF" }}>
                {t("Location")}
              </th>
              <th style={{ minWidth: "120px", fontWeight: "600", color: "#2466BF" }}>
                {t("Condition")}
              </th>
              <th style={{ minWidth: "200px", fontWeight: "600", color: "#2466BF" }}>
                {t("Remarks")}
              </th>
            </tr>
          </thead>
          <tbody>
            {Object.entries(data).map(([key, item]) => (
              <tr key={key}>
                <td style={{ fontWeight: "500", backgroundColor: "#fafafa" }}>
                  {t(key.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()))}
                </td>
                <td>
                  <Form.Control
                    size="sm"
                    type={isNumberField ? "number" : "text"}
                    value={item[isNumberField ? 'number' : 'bhp']}
                    onChange={(e) => handleInputChange(section, key, isNumberField ? 'number' : 'bhp', e.target.value)}
                    disabled={viewMode}
                    style={{ border: "1px solid #ddd", borderRadius: "4px" }}
                  />
                </td>
                <td>
                  <Form.Control
                    size="sm"
                    type="text"
                    value={item.type}
                    onChange={(e) => handleInputChange(section, key, 'type', e.target.value)}
                    disabled={viewMode}
                    style={{ border: "1px solid #ddd", borderRadius: "4px" }}
                  />
                </td>
                <td>
                  <Form.Control
                    size="sm"
                    type="text"
                    value={item.location}
                    onChange={(e) => handleInputChange(section, key, 'location', e.target.value)}
                    disabled={viewMode}
                    style={{ border: "1px solid #ddd", borderRadius: "4px" }}
                  />
                </td>
                <td>
                  <Form.Select
                    size="sm"
                    value={item.condition}
                    onChange={(e) => handleInputChange(section, key, 'condition', e.target.value)}
                    disabled={viewMode}
                    style={{ border: "1px solid #ddd", borderRadius: "4px" }}
                  >
                    <option value="">Select</option>
                    <option value="Good">Good</option>
                    <option value="Fair">Fair</option>
                    <option value="Poor">Poor</option>
                    <option value="N/A">N/A</option>
                  </Form.Select>
                </td>
                <td>
                  <Form.Control
                    size="sm"
                    type="text"
                    value={item.remarks}
                    onChange={(e) => handleInputChange(section, key, 'remarks', e.target.value)}
                    disabled={viewMode}
                    style={{ border: "1px solid #ddd", borderRadius: "4px" }}
                  />
                </td>
              </tr>
            ))}
          </tbody>
        </Table>
      </div>
    </Collapsible>
  );

  return (
    <form autoComplete="off">
      {/* Fire Fighting Items */}
      {renderEquipmentTable(
        "Fire Fighting Items",
        <FaFire className="me-2" style={{ color: "#2466BF" }} />,
        "fireFighting",
        equipmentData.fireFighting
      )}

      {/* Equipment */}
      {renderEquipmentTable(
        "Equipment",
        <FaCog className="me-2" style={{ color: "#2466BF" }} />,
        "equipment",
        equipmentData.equipment
      )}

      {/* Navigational Equipment */}
      {renderEquipmentTable(
        "Navigational Equipment",
        <FaCompass className="me-2" style={{ color: "#2466BF" }} />,
        "navigation",
        equipmentData.navigation
      )}

      {/* Passenger Location */}
      <Collapsible
        title={
          <>
            <FaUsers className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Location of passengers on specific decks and spaces in maximum loaded condition")}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem", overflowX: "auto" }}>
          <Table striped bordered hover responsive className="mb-0">
            <thead style={{ backgroundColor: "#f8f9fa" }}>
              <tr>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Deck/Space Type")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Size")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Function")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Max. No. of Passenger")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Remarks")}</th>
              </tr>
            </thead>
            <tbody>
              {passengerDecks.map((deck, index) => (
                <tr key={index}>
                  <td>
                    <Form.Control
                      size="sm"
                      type="text"
                      value={deck.deckType}
                      onChange={(e) => {
                        const newDecks = [...passengerDecks];
                        newDecks[index].deckType = e.target.value;
                        setPassengerDecks(newDecks);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <Form.Control
                      size="sm"
                      type="text"
                      value={deck.size}
                      onChange={(e) => {
                        const newDecks = [...passengerDecks];
                        newDecks[index].size = e.target.value;
                        setPassengerDecks(newDecks);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <Form.Control
                      size="sm"
                      type="text"
                      value={deck.function}
                      onChange={(e) => {
                        const newDecks = [...passengerDecks];
                        newDecks[index].function = e.target.value;
                        setPassengerDecks(newDecks);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <Form.Control
                      size="sm"
                      type="number"
                      value={deck.maxPassengers}
                      onChange={(e) => {
                        const newDecks = [...passengerDecks];
                        newDecks[index].maxPassengers = e.target.value;
                        setPassengerDecks(newDecks);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <Form.Control
                      size="sm"
                      type="text"
                      value={deck.remarks}
                      onChange={(e) => {
                        const newDecks = [...passengerDecks];
                        newDecks[index].remarks = e.target.value;
                        setPassengerDecks(newDecks);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                </tr>
              ))}
            </tbody>
          </Table>
        </div>
      </Collapsible>

      {/* Freeboard */}
      <Collapsible
        title={
          <>
            <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Freeboard")}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem", overflowX: "auto" }}>
          <Table striped bordered hover responsive className="mb-0">
            <thead style={{ backgroundColor: "#f8f9fa" }}>
              <tr>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Minimum freeboard")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Number of Passengers")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Cargo (Tonne)")}</th>
              </tr>
            </thead>
            <tbody>
              {freeboardData.map((item, index) => (
                <tr key={index}>
                  <td>
                    <Form.Control
                      size="sm"
                      type="text"
                      value={item.minFreeboard}
                      onChange={(e) => {
                        const newData = [...freeboardData];
                        newData[index].minFreeboard = e.target.value;
                        setFreeboardData(newData);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <Form.Control
                      size="sm"
                      type="number"
                      value={item.passengers}
                      onChange={(e) => {
                        const newData = [...freeboardData];
                        newData[index].passengers = e.target.value;
                        setFreeboardData(newData);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <Form.Control
                      size="sm"
                      type="number"
                      value={item.cargo}
                      onChange={(e) => {
                        const newData = [...freeboardData];
                        newData[index].cargo = e.target.value;
                        setFreeboardData(newData);
                      }}
                      disabled={viewMode}
                    />
                  </td>
                </tr>
              ))}
            </tbody>
          </Table>
        </div>
      </Collapsible>

      {/* Life-Saving Equipment */}
      {renderEquipmentTable(
        "Life-Saving Equipment",
        <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />,
        "lifeSaving",
        equipmentData.lifeSaving
      )}

      {/* Machinery/Electrical */}
      {renderEquipmentTable(
        "Machinery/Electrical",
        <FaBolt className="me-2" style={{ color: "#2466BF" }} />,
        "machinery",
        equipmentData.machinery,
        false
      )}

      {/* Accommodation/Safety */}
      {renderEquipmentTable(
        "Accommodation/Safety",
        <FaHome className="me-2" style={{ color: "#2466BF" }} />,
        "accommodation",
        equipmentData.accommodation
      )}
    </form>
  );
};

export default VesselEquipmentForm;
import React, { useImperativeHandle, forwardRef, useState } from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";

const themeColor = "#2E57A7";
const successColor = "#28a745";

const Stepper = forwardRef(
  (
    {
      steps,
      onSave,
      viewMode = false,
      isEditMode = false,
      actionComponent = null,
      onNext,
      onBack,
      onPayNow,
      onSyncData,
    },
    ref
  ) => {
    const { t } = useTranslation();
    const [activeStep, setActiveStep] = useState(0);
    const [completed, setCompleted] = useState({});
    const [errors, setErrors] = useState({});

    const totalSteps = steps.length;
    const currentStep = steps[activeStep];

    const buttonStyle = {
      fontWeight: "bold",
      borderRadius: "0.5rem",
      minWidth: "8rem",
      fontSize: "0.9rem",
      color: "#fff",
      backgroundColor: themeColor,
      "&:hover": {
        backgroundColor: "#1f4ea0",
      },
    };

    useImperativeHandle(ref, () => ({
      goToNextStep,
    }));

    const goToNextStep = () => {
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
    };

    const markStepCompleted = () => {
      setCompleted((prev) => ({ ...prev, [activeStep]: true }));
    };

    const validateAndProceed = async (callback) => {
      if (currentStep.validate) {
        const isValid = await currentStep.validate();
        setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));

        if (!isValid) {
          toast.error("Please fix the errors before proceeding.");
          return;
        }
      }

      markStepCompleted();
      callback();
    };

    const handleNext = () => {
      if (viewMode || steps?.goToNextStepNoValidtion || isEditMode) {
        goToNextStep();
        markStepCompleted();
      } else {
        validateAndProceed(() => {
          goToNextStep();
          onNext?.(activeStep);
        });
      }
    };

    const handleBack = () => {
      setActiveStep((prev) => Math.max(prev - 1, 0));
      onBack?.(activeStep);
    };

    const handleSave = () => {
      if (viewMode) return;

      if (steps?.goToNextStepNoValidtion || isEditMode) {
        goToNextStep();
        markStepCompleted();
        return;
      }

      validateAndProceed(() => {
        if (activeStep < totalSteps - 1) {
          const currentStepInfo = {
            index: activeStep,
            label: currentStep?.label,
            component: currentStep?.component,
            validate: currentStep?.validate,
            isLastStep: activeStep === totalSteps - 1,
            completedSteps: completed,
            getFormData: currentStep?.getFormData,
          };
          onSyncData?.(currentStepInfo);

          // goToNextStep();
        } else {
          onSave?.();
        }
      });
    };

    const handlePayNow = () => {
      onPayNow?.() || currentStep?.component?.props?.onPayNow?.();
    };

    const renderActionButton = () => {
      if (viewMode) {
        return activeStep === totalSteps - 1 ? (
          actionComponent || (
            <Button variant="contained" sx={buttonStyle}>
              {t("Take Action")}
            </Button>
          )
        ) : (
          <Button variant="contained" sx={buttonStyle} onClick={handleNext}>
            {t("Next")}
          </Button>
        );
      }

      return activeStep === totalSteps - 1 ? (
        <Button variant="contained" sx={buttonStyle} onClick={handlePayNow}>
          {t("Submit")}
        </Button>
      ) : (
        <Button variant="contained" sx={buttonStyle} onClick={handleSave}>
          {t("Save & Next")}
        </Button>
      );
    };

    return (
      <Box sx={{ width: "100%", padding: "1rem" }}>
        <Paper
          elevation={3}
          sx={{
            padding: "0.75rem 1.5rem",
            borderRadius: "0.75rem",
            overflowX: "auto",
            whiteSpace: "nowrap",
            backgroundColor: "#fafafa",
          }}
        >
          <Stack direction="row" alignItems="center" spacing={1}>
            {steps.map((step, index) => (
              <React.Fragment key={index}>
                <Stack
                  direction="row"
                  alignItems="center"
                  spacing={0.5}
                  sx={{ cursor: "pointer" }}
                >
                  {completed[index] ? (
                    <CheckCircleFill size={18} color={successColor} />
                  ) : (
                    <Typography
                      sx={{
                        fontSize: "0.875rem",
                        width: "1.5rem",
                        height: "1.5rem",
                        textAlign: "center",
                        borderRadius: "50%",
                        backgroundColor: "#e0e0e0",
                        display: "inline-flex",
                        alignItems: "center",
                        justifyContent: "center",
                        fontWeight: "bold",
                        color: "#666",
                      }}
                    >
                      {index + 1}
                    </Typography>
                  )}
                  <Typography
                    sx={{
                      fontWeight: index === activeStep ? "bold" : "normal",
                      color: index === activeStep ? themeColor : "#999",
                      fontSize: "0.875rem",
                      whiteSpace: "nowrap",
                    }}
                  >
                    {step.label}
                  </Typography>
                </Stack>
                {index < steps.length - 1 && (
                  <ChevronRight size={14} color="#ccc" />
                )}
              </React.Fragment>
            ))}
          </Stack>
        </Paper>

        <Paper
          elevation={2}
          sx={{
            marginTop: "1rem",
            borderRadius: "0.75rem",
            backgroundColor: "#fff",
            width: "100%",
          }}
        >
          {currentStep.component}
          {errors[activeStep]}
        </Paper>

        <Divider sx={{ margin: "2rem 0" }} />

        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            gap: "1rem",
            flexDirection: { xs: "column", sm: "row" },
            alignItems: { xs: "stretch", sm: "center" },
          }}
        >
          <Button
            variant="outlined"
            onClick={handleBack}
            disabled={activeStep === 0}
            sx={{
              color: themeColor,
              borderColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: { xs: "100%", sm: "8rem" },
              fontSize: "0.9rem",
            }}
          >
            {t("Previous")}
          </Button>

          {renderActionButton()}
        </Box>
      </Box>
    );
  }
);

export default Stepper;
