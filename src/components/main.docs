:root {
  /* Existing variables */
  --primary-color: #2466BF;
  --primary-gradient: linear-gradient(135deg, #00429c, #4695ff);
  --text-color: #545D69;
  --placeholder-color: #999;
  --disabled-bg: #f5f5f5;
  --dropdown-hover: #e6f0fa;
  
  /* New variables for homepage */
  --primary-light: #f0f7ff;
  --dark-text: #333;
  --medium-text: #666;
  --white: #fff;
  --card-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  --card-hover-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
  --section-bg: #f8f9fa;
  --overlay-bg: rgba(0, 0, 0, 0.5);
  --footer-link: rgba(255, 255, 255, 0.8);
  --social-icon-bg: rgba(255, 255, 255, 0.1);
  --social-icon-hover: rgba(255, 255, 255, 0.2);
  --border-color: #dee2e6;
}
///////////////
.iwt-homepage {
  font-size: 1rem;
  line-height: 1.5;
}

#quick-links-dropdown .dropdown-item {
  background: red; /* This seems intentional for highlighting */
}

.zoom-responsive-title {
  font-size: clamp(1.5rem, 3vw, 2.5rem);
}

.stat-label {
  color: var(--white) !important;
}

/* Icon container */
.icon-container {
  width: 50px;
  height: 50px;
  min-width: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-light);
  border-radius: 8px;
  padding: 10px;
}

.icon-container img,
.service-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.nav-icon {
  width: 24px;
  height: 24px;
}

/* Service card */
.service-card {
  height: 80%;
  padding: 1.25rem;
  margin-bottom: 1rem;
  display: flex;
  border: none;
  border-radius: 10px;
  box-shadow: var(--card-shadow);
  transition: transform 0.3s;
}

.service-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--card-hover-shadow);
}

.service-card .card-body {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* Container width */
@media (min-width: 1200px) {
  .container-fluid {
    max-width: 1600px;
  }
}

/* High DPI screen adjustments */
@media screen and (min-resolution: 1.5dppx) {
  .iwt-homepage {
    font-size: 0.9em;
  }

  .service-card {
    margin-bottom: 1.5em;
  }

  .icon-container {
    width: 3.5em;
    height: 3.5em;
  }
}

/* Image containers */
.vessel-image-container,
.survey-image-container {
  height: 94%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.vessel-image-container img,
.survey-image-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Hero banner */
.hero-banner .carousel-item img {
  height: 600px;
  object-fit: cover;
}

.carousel-item {
  height: 600px;
}

.carousel-item img {
  height: 100%;
  object-fit: cover;
}

.hero-banner::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-bg);
}

.transparent-navbar {
  padding: 5px 0;
  background: var(--primary-gradient);
}

.hero-content {
  position: absolute;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: center;
  padding: 60px 0;
  bottom: 10%;
  left: 5%;
  color: var(--white);
}

.hero-content h1 {
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 20px;
}

.hero-content .lead {
  font-size: 1.25rem;
  max-width: 600px;
}

/* Stats section */
.stats-section {
  background: var(--section-bg);
}

.stat-card {
  border: none;
  border-radius: 10px;
  transition: transform 0.3s;
  background: var(--primary-gradient);
  height: 100%;
}

.stat-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--card-hover-shadow);
}

.stat-value,
.stat-label,
.stat-description {
  color: var(--white);
}

/* Section styling */
.section-title {
  font-weight: 700;
  color: var(--dark-text);
  margin-bottom: 15px;
}

.section-description {
  color: var(--medium-text);
  font-size: 1.1rem;
}

/* Service elements */
.service-icon {
  background: var(--primary-light);
}

.service-title {
  color: var(--dark-text);
}

.service-description {
  color: var(--medium-text);
}

/* Quick action cards */
.quick-action-card {
  border: none;
  border-radius: 10px;
  box-shadow: var(--card-shadow);
}

.action-icon {
  background: var(--primary-light);
}

.action-title {
  color: var(--dark-text);
}

/* Footer */
.footer {
  background: var(--primary-gradient);
}

.footer-links a {
  color: var(--footer-link);
}

.footer-links a:hover {
  color: var(--white);
}

.social-icons a {
  background: var(--social-icon-bg);
}

.social-icons a:hover {
  background: var(--social-icon-hover);
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .social-column:first-child {
    border-right: none;
    border-bottom: 1px solid var(--border-color);
  }
}
