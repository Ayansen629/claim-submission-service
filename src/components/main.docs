const handleFormSubmit = async (stepInfo) => {
  window.scrollTo({ top: 0, behavior: "smooth" });

  //-- Step 1: Initial Survey Form Submission -- //
  if (stepInfo.index === 0) {
    const formValues = stepInfo?.getFormData?.() || {};
    const surveyPayload = buildSurveyPayload(formValues, registrationData);
    submitIntialSurveyData(surveyPayload, stepInfo);
  }

  //-- Step 2: Equipment Form Submission -- //
  if (stepInfo.index === 1) {
    const formValues = stepInfo?.getFormData?.() || {};
    
    // For officer save in view mode - update existing survey data
    if (isOfficerLogin && isViewMode) {
      // Get the latest survey data first to ensure we have all current values
      try {
        loaderRef.current?.show();
        const apiUrl =
          SERVICE_BASE.IWT_SURVEY_SERVICE +
          URLS_ENDPOINT.SURVEY_SERVICE.SURVEY_SEARCH;

        const response = await postData(apiUrl, {
          iwtVesRegBasicDetailsTFk: [registrationData?.vessel?.iwtVesselBasicDetailsTFk],
        });

        if (response?.status === 200 || response?.status === 201) {
          const latestSurveyData = response?.data[0] || {};
          
          // Build the payload with the updated equipment data
          const equipmentPayload = buildEquipmentPayload(formValues, latestSurveyData);
          
          // Submit the updated data
          await submitIntialSurveyData(equipmentPayload, null);
        } else {
          toast.error("Failed to fetch latest survey data");
        }
      } catch (err) {
        handleErrorMessage("Failed to fetch latest survey data");
      } finally {
        loaderRef?.current?.hide();
      }
      return;
    }
    
    // For regular submission
    const equipmentPayload = buildEquipmentPayload(formValues, intialSurveyData);
    submitIntialSurveyData(equipmentPayload, stepInfo);
  }
};
