.certificateContainer {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
  background: #fff;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.certificateHeader {
  text-align: center;
  margin-bottom: 30px;
  padding: 20px;
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  color: white;
  border-radius: 8px;
}

.certificateTitle {
  font-size: 1.8rem;
  font-weight: 700;
  margin: 0;
  letter-spacing: 1px;
}

.subtitle {
  margin: 5px 0 0 0;
  font-size: 0.9rem;
  opacity: 0.9;
}

.infoCard, .detailsCard {
  margin-bottom: 20px;
  border: none;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  border-radius: 8px;
}

.cardHeader {
  background: #f8f9fa;
  border-bottom: 2px solid #e9ecef;
  padding: 15px 20px;
}

.cardHeader h5 {
  margin: 0;
  color: #2c3e50;
  font-weight: 600;
}

.fieldGroup {
  margin-bottom: 15px;
}

.fieldLabel {
  display: block;
  font-weight: 600;
  color: #34495e;
  margin-bottom: 5px;
  font-size: 0.9rem;
}

.fieldValue {
  padding: 8px 12px;
  background: #f8f9fa;
  border: 1px solid #e9ecef;
  border-radius: 4px;
  color: #2c3e50;
  font-weight: 500;
}

.editableInput, .editableSelect {
  width: 100%;
  padding: 8px 12px;
  border: 2px solid #3498db;
  border-radius: 4px;
  font-size: 0.9rem;
  transition: border-color 0.3s;
}

.editableInput:focus, .editableSelect:focus {
  outline: none;
  border-color: #2980b9;
  box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.dateInputGroup {
  display: flex;
  align-items: center;
  gap: 8px;
}

.dateInput {
  width: 60px;
  padding: 8px;
  border: 2px solid #3498db;
  border-radius: 4px;
  text-align: center;
  font-weight: 600;
}

.dateSeparator {
  font-weight: bold;
  color: #7f8c8d;
}

.statementBox {
  background: #ecf0f1;
  padding: 20px;
  border-radius: 8px;
  margin: 20px 0;
  border-left: 4px solid #3498db;
}

.plyingLimitsContent {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
}

.inlineLabel {
  font-weight: 600;
  color: #2c3e50;
}

.inlineValue {
  background: #f8f9fa;
  padding: 4px 8px;
  border-radius: 4px;
  font-weight: 500;
}

.inlineInput {
  width: 80px;
  padding: 6px 8px;
  border: 2px solid #3498db;
  border-radius: 4px;
  text-align: center;
}

.capacityItem {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px;
  background: #f8f9fa;
  border-radius: 6px;
  border: 1px solid #e9ecef;
}

.capacityLabel {
  font-weight: 600;
  color: #2c3e50;
}

.capacityValue {
  font-weight: 700;
  color: #27ae60;
}

.safetyTable {
  margin: 0;
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.safetyTable thead th {
  background: #34495e;
  color: white;
  font-weight: 600;
  padding: 12px 8px;
  text-align: center;
  border: none;
  font-size: 0.85rem;
}

.safetyTable tbody td {
  padding: 8px;
  text-align: center;
  border: 1px solid #e9ecef;
  background: #fff;
}

.tableInput {
  width: 100%;
  padding: 6px 8px;
  border: 1px solid #bdc3c7;
  border-radius: 4px;
  text-align: center;
  font-size: 0.85rem;
}

.tableInput:focus {
  outline: none;
  border-color: #3498db;
  box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.2);
}

.certificationBox {
  background: #2c3e50;
  color: white;
  padding: 25px;
  border-radius: 8px;
  margin: 30px 0 20px 0;
  text-align: center;
}

.certificationTitle {
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 15px;
  color: #ecf0f1;
}

.certificationText {
  margin: 0;
  line-height: 1.6;
  font-size: 0.95rem;
}

.validityBox {
  background: #e8f5e8;
  border: 2px solid #27ae60;
  padding: 20px;
  border-radius: 8px;
  text-align: center;
  margin-top: 20px;
}

.validityBox p {
  margin: 0;
  font-weight: 500;
  color: #2c3e50;
}

/* Responsive Design */
@media (max-width: 768px) {
  .certificateContainer {
    padding: 15px;
  }
  
  .certificateTitle {
    font-size: 1.4rem;
  }
  
  .dateInputGroup {
    justify-content: center;
  }
  
  .plyingLimitsContent {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  
  .safetyTable {
    font-size: 0.8rem;
  }
  
  .safetyTable thead th {
    padding: 8px 4px;
    font-size: 0.75rem;
  }
  
  .tableInput {
    font-size: 0.8rem;
    padding: 4px 6px;
  }
}

@media (max-width: 576px) {
  .capacityItem {
    flex-direction: column;
    gap: 5px;
    text-align: center;
  }
  
  .certificationBox {
    padding: 20px 15px;
  }
  
  .validityBox {
    padding: 15px;
  }
}
