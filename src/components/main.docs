
import React, { useState, useEffect } from "react";
import { Row, Col, Form, Button } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile.tsx";
import InputText from "../../../common/InputText.tsx";
import { renameFile } from "../../../../utils/constants.ts";

const Documents = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  const [workOrderFiles, setWorkOrderFiles] = useState([{ id: 1 }]);
  const [drawingsFiles, setDrawingsFiles] = useState([{ id: 1 }]);
  
  const {
    register,
    watch,
    setValue,
    clearErrors,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  const addFileInput = (type) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      const newId = workOrderFiles.length > 0 ? Math.max(...workOrderFiles.map(f => f.id)) + 1 : 1;
      setWorkOrderFiles([...workOrderFiles, { id: newId }]);
    } else if (type === 'drawings') {
      const newId = drawingsFiles.length > 0 ? Math.max(...drawingsFiles.map(f => f.id)) + 1 : 1;
      setDrawingsFiles([...drawingsFiles, { id: newId }]);
    }
  };

  const removeFileInput = (type, id) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      setWorkOrderFiles(workOrderFiles.filter(file => file.id !== id));
      setValue(`workOrder_file_${id}`, null);
      setValue(`workOrder_desc_${id}`, "");
      clearErrors([`workOrder_file_${id}`, `workOrder_desc_${id}`]);
    } else if (type === 'drawings') {
      setDrawingsFiles(drawingsFiles.filter(file => file.id !== id));
      setValue(`drawings_file_${id}`, null);
      setValue(`drawings_desc_${id}`, "");
      clearErrors([`drawings_file_${id}`, `drawings_desc_${id}`]);
    }
  };

  const formFields = [
    {
      name: 'tonnageBooklets',
      label: t('Tonnage Booklets'),
      type: 'file',
      required: true,
      colSize: 6,
      validation: { required: t('Tonnage Booklets are required') }
    },
    {
      name: 'stabilityBooklets',
      label: t('Stability Booklets'),
      type: 'file',
      required: true,
      colSize: 6,
      validation: { required: t('Stability Booklets are required') }
    },
    // {
    //   name: 'authLetter',
    //   label: t('Authorisation Letter'),
    //   type: 'file',
    //   required: false,
    //   colSize: 6,
    //   showIf: () => constructedBy === "2",
    //   validation: { required: constructedBy === "2" && t('Authorization Letter is required') }
    // },
    {
      name: 'termsAccepted',
      label: t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.'),
      type: 'checkbox',
      required: true,
      colSize: 12,
      validation: { required: t('You must accept the terms and conditions') }
    }
  ];

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    switch (field.type) {
      case "file":
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(
                  file?.name?.lastIndexOf(".")
                );
                const fileName = `${field.label}${extension}`;
                file.originalName = fileName;
                const renamedFile = renameFile(file, fileName);

                clearErrors(field.name);

                setValue(field.name, renamedFile, { shouldValidate: true });
                setFormData((prev) => {
                  const updated = { ...prev, [field.name]: renamedFile };
                  return updated;
                });
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={watch(field.name)}
            clearErrors={clearErrors}
          />
        );

      case 'checkbox':
        return (
          <div className="mb-3">
            <div className="d-flex align-items-start">
              <input
                type="checkbox"
                id={field.name}
                className="me-2 mt-1"
                {...register(field.name, field.validation)}
                disabled={viewMode}
              />
              <div>
                <label
                  htmlFor={field.name}
                  className="mb-0"
                  style={{ fontWeight: 500, color: "#333", cursor: "pointer" }}
                >
                  {field.label}
                </label>
                {errors[field.name] && (
                  <div className="text-danger small mt-1" style={{ display: "block" }}>
                    {errors[field.name].message}
                  </div>
                )}
              </div>
            </div>
          </div>
        );

      default:
        return null;
    }
  };

  return (
    <div>
      <Collapsible title={t("Documents")} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <Row className="gy-4">
            {/* Work Order Section */}
            <Col lg={6} md={12}>
              <div className="border rounded p-3" style={{ backgroundColor: "#f8f9fa" }}>
                <div className="d-flex justify-content-between align-items-center mb-3">
                  <h6 className="mb-0 fw-bold text-primary">{t("Work Order")}</h6>
                  {!viewMode && (
                    <Button
                      variant="primary"
                      size="sm"
                      onClick={() => addFileInput('workOrder')}
                      style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
                    >
                      + Add
                    </Button>
                  )}
                </div>
                {workOrderFiles.map((fileInput, idx) => (
                  <div key={fileInput.id} className="mb-3 p-2 border rounded" style={{ backgroundColor: "white" }}>
                    <div className="mb-2">
                      <InputFile
                        label={`${t("Choose File")} ${idx + 1}`}
                        name={`workOrder_file_${fileInput.id}`}
                        register={register(`workOrder_file_${fileInput.id}`)}
                        errors={errors}
                        onChange={(e) => {
                          if (e.target.files && e?.target?.files[0]) {
                            const file = e.target.files[0];
                            const extension = file?.name?.substring(
                              file?.name?.lastIndexOf(".")
                            );
                            const fileName = `Work Order${extension}`;
                            file.originalName = fileName;
                            const renamedFile = renameFile(file, fileName);

                            clearErrors(`workOrder_file_${fileInput.id}`);

                            setValue(`workOrder_file_${fileInput.id}`, renamedFile, { shouldValidate: true });
                            setFormData((prev) => {
                              const updated = { ...prev, [`workOrder_file_${fileInput.id}`]: renamedFile };
                              return updated;
                            });
                          }
                        }}
                        disabled={viewMode}
                        watch={watch}
                        defaultValue={watch(`workOrder_file_${fileInput.id}`)}
                        clearErrors={clearErrors}
                      />
                    </div>
                    <div className="mb-2">
                      <InputText
                        label={t("Description")}
                        name={`workOrder_desc_${fileInput.id}`}
                        placeholder={t("Enter file description")}
                        register={register(`workOrder_desc_${fileInput.id}`)}
                        errors={errors}
                        onChange={() => !viewMode && clearErrors(`workOrder_desc_${fileInput.id}`)}
                        disabled={viewMode}
                      />
                    </div>
                    {workOrderFiles.length > 1 && !viewMode && (
                      <div className="text-end">
                        <Button
                          variant="outline-danger"
                          size="sm"
                          onClick={() => removeFileInput('workOrder', fileInput.id)}
                        >
                          Remove
                        </Button>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </Col>

            {/* Drawings Section */}
            <Col lg={6} md={12}>
              <div className="border rounded p-3" style={{ backgroundColor: "#f8f9fa" }}>
                <div className="d-flex justify-content-between align-items-center mb-3">
                  <h6 className="mb-0 fw-bold text-primary">{t("Drawings")}</h6>
                  {!viewMode && (
                    <Button
                      variant="primary"
                      size="sm"
                      onClick={() => addFileInput('drawings')}
                      style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
                    >
                      + Add
                    </Button>
                  )}
                </div>
                {drawingsFiles.map((fileInput, idx) => (
                  <div key={fileInput.id} className="mb-3 p-2 border rounded" style={{ backgroundColor: "white" }}>
                    <div className="mb-2">
                      <InputFile
                        label={`${t("Choose File")} ${idx + 1}`}
                        name={`drawings_file_${fileInput.id}`}
                        register={register(`drawings_file_${fileInput.id}`)}
                        errors={errors}
                        onChange={(e) => {
                          if (e.target.files && e?.target?.files[0]) {
                            const file = e.target.files[0];
                            const extension = file?.name?.substring(
                              file?.name?.lastIndexOf(".")
                            );
                            const fileName = `Drawings${extension}`;
                            file.originalName = fileName;
                            const renamedFile = renameFile(file, fileName);

                            clearErrors(`drawings_file_${fileInput.id}`);

                            setValue(`drawings_file_${fileInput.id}`, renamedFile, { shouldValidate: true });
                            setFormData((prev) => {
                              const updated = { ...prev, [`drawings_file_${fileInput.id}`]: renamedFile };
                              return updated;
                            });
                          }
                        }}
                        disabled={viewMode}
                        watch={watch}
                        defaultValue={watch(`drawings_file_${fileInput.id}`)}
                        clearErrors={clearErrors}
                      />
                    </div>
                    <div className="mb-2">
                      <InputText
                        label={t("Description")}
                        name={`drawings_desc_${fileInput.id}`}
                        placeholder={t("Enter file description")}
                        register={register(`drawings_desc_${fileInput.id}`)}
                        errors={errors}
                        onChange={() => !viewMode && clearErrors(`drawings_desc_${fileInput.id}`)}
                        disabled={viewMode}
                      />
                    </div>
                    {drawingsFiles.length > 1 && !viewMode && (
                      <div className="text-end">
                        <Button
                          variant="outline-danger"
                          size="sm"
                          onClick={() => removeFileInput('drawings', fileInput.id)}
                        >
                          Remove
                        </Button>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </Col>

            {formFields.map((field, index) => (
              <Col key={index} md={field.colSize || 12} className="mb-2">
                {renderField(field)}
              </Col>
            ))}
          </Row>
        </div>
      </Collapsible>
    </div>
  );
};

export default Documents;
