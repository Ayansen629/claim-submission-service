const renderFileField = (docType, label) => {
  if (viewMode) {
    return (
      <>
        <label className="form-label">{t(label)}</label>
        {fileStates[docType] ? (
          <div
            className="d-flex align-items-center p-2 border rounded"
            style={{ backgroundColor: "#f8f9fa" }}
          >
            <span className="me-2">{fileStates[docType].name}</span>
            <button
              type="button"
              className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
              onClick={() =>
                handleFileDownload(
                  fileStates[docType].fileStoreId,
                  fileStates[docType].name,
                  fileStates[docType].originalName
                )
              }
              title="Download file"
              style={{ width: "24px", height: "24px", padding: "0" }}
            >
              <FaDownload size={10} />
            </button>
          </div>
        ) : (
          <div
            className="p-2 border rounded text-muted"
            style={{ backgroundColor: "#f8f9fa" }}
          >
            No file uploaded
          </div>
        )}
      </>
    );
  }

  return (
    <div className="mb-2" style={{ display: "flex" }}>
      <InputFile
        style={{ width: "100%" }}
        label={t(label)}
        required={!fileStates[docType]}
        name={`enclosure.${docType}`}
        id={docType}
        register={register(`enclosure.${docType}`, {
          required: !fileStates[docType] && t(`${label} is required`),
        })}
        errors={errors}
        onChange={(e) => handleFileChange(e, docType)}
        disabled={viewMode}
        watch={watch}
        defaultValue={fileStates[docType]?.displayFile || watch(`enclosure.${docType}`)}
        clearErrors={clearErrors}
        accept=".pdf,.jpg,.jpeg,.png"
        key={`${docType}-${fileStates[docType] ? 'uploaded' : 'empty'}`} // Force re-render
      />
      
      {fileStates[docType] && !viewMode && (
        <FaTimesCircle
          className="text-danger position-relative"
          style={{
            top: "3rem",
            right: "3.5rem",
            cursor: "pointer",
          }}
          size={18}
          title="Remove file"
          onClick={() => {
            setFileStates((prev) => ({
              ...prev,
              [docType]: null,
            }));
            setValue(`enclosure.${docType}`, null);
            setValue(`enclosure.${docType}FileStoreId`, null);
            setValue(`enclosure.${docType}OriginalName`, null);
            clearErrors(`enclosure.${docType}`);
            
            // Force clear the file input by recreating it
            const fileInput = document.getElementById(docType);
            if (fileInput) {
              fileInput.value = '';
              // Trigger a change event to ensure form state is updated
              const event = new Event('change', { bubbles: true });
              fileInput.dispatchEvent(event);
            }
          }}
        />
      )}

      {fileStates[docType] && (
        <div className="text-end" style={{
          display: "flex",
          justifyContent: "flex-end",
          marginRight: "0.9rem",
          marginTop: "0.5rem"
        }}>
          <button
            type="button"
            className="btn btn-outline-primary btn-sm rounded-pill d-flex align-items-center"
            style={{ fontSize: "0.65rem", padding: "4px 8px" }}
            onClick={() => handleFileDownload(
              fileStates[docType].fileStoreId,
              fileStates[docType].name,
              fileStates[docType].originalName
            )}
          >
            <FaDownload size={10} />
            <span className="ms-1">Download</span>
          </button>
        </div>
      )}
    </div>
  );
};
