.declaration-text {
  font-size: 1rem;
  line-height: 1.8;
  color: #333;
  text-align: justify;
  text-justify: inter-word;
  word-spacing: 0.05em;
}

.declaration-text p {
  text-align: justify;
  margin-bottom: 1.5rem;
  text-indent: 2rem;
  hyphens: auto;
  -webkit-hyphens: auto;
  -ms-hyphens: auto;
  word-spacing: inherit;
  letter-spacing: 0.02em;
}

.highlight-field {
  background: linear-gradient(120deg, #2466BF 0%, #1976d2 100%);
  color: white !important;
  padding: 2px 6px;
  border-radius: 3px;
  font-weight: bold !important;
  font-style: italic !important;
  display: inline;
  white-space: nowrap;
}

.declaration-content {
  background: white;
  padding: 2rem 3rem;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  text-rendering: optimizeLegibility;
}
