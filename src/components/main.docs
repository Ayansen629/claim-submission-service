const DynamicField = ({ field }) => {
  const handleChange = (e) => {
    if (field?.onChange) field.onChange(e, setValue, watch);
  };

  switch (field.type) {
    case "select":
      // ... existing select case

    case "file":
      // ... existing file case

    case "multifile":
      return (
        <MultiFile
          title={field.label}
          files={additionalFiles}
          type="ADDITIONAL_DOCS"
          icon={<FaFileUpload className="me-2" />}
          watch={watch}
          viewMode={false}
          editMode={false}
          clearErrors={clearErrors}
          register={register}
          errors={errors}
          setError={setError}
          setValue={setValue}
          unregister={() => {}} // Add unregister function if needed
          localFiles={additionalFiles}
          setFiles={setAdditionalFiles}
          ref={loaderRef}
        />
      );

    default:
      // ... existing default case
  }
};
