.tabs-wrapper {
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  border: 1px solid #e9ecef;
  overflow: hidden;
}

.tabs-header {
  position: relative;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-bottom: 2px solid #e9ecef;
  padding: 0;
}

.tabs-header.with-arrows {
  padding: 0 50px;
}

.scroll-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  background: linear-gradient(135deg, #2E57A7, #1f4ea0);
  border: none;
  border-radius: 50%;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  box-shadow: 0 4px 12px rgba(46, 87, 167, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.scroll-btn:hover {
  transform: translateY(-50%) scale(1.1);
  box-shadow: 0 6px 20px rgba(46, 87, 167, 0.4);
}

.scroll-btn.left {
  left: 8px;
}

.scroll-btn.right {
  right: 8px;
}

.tabs-scroll {
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.tabs-scroll::-webkit-scrollbar {
  display: none;
}

.tab-list {
  display: flex;
  list-style: none;
  margin: 0;
  padding: 0;
  min-height: 60px;
  align-items: center;
}

.tab-item {
  flex-shrink: 0;
}

.tab-btn {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 16px 24px;
  background: transparent;
  border: none;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  color: #6c757d;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  white-space: nowrap;
  border-radius: 0;
  min-height: 60px;
  overflow: hidden;
}

.tab-btn::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(90deg, #2E57A7, #1f4ea0);
  transform: scaleX(0);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  transform-origin: left;
}

.tab-btn:hover {
  color: #2E57A7;
  background: rgba(46, 87, 167, 0.05);
}

.tab-btn:hover::before {
  transform: scaleX(0.3);
}

.tab-btn.active {
  color: #2E57A7;
  font-weight: 600;
  background: rgba(46, 87, 167, 0.08);
}

.tab-btn.active::before {
  transform: scaleX(1);
}

.tab-icon {
  font-size: 16px;
  display: flex;
  align-items: center;
}

.tab-title {
  font-size: 14px;
  line-height: 1.4;
}

.tab-badge {
  background: linear-gradient(135deg, #dc3545, #c82333);
  color: white;
  border-radius: 12px;
  padding: 2px 8px;
  font-size: 11px;
  font-weight: 600;
  min-width: 18px;
  text-align: center;
  box-shadow: 0 2px 4px rgba(220, 53, 69, 0.3);
}

.tabs-content {
  padding: 24px;
  background: #ffffff;
  min-height: 400px;
}

/* Responsive Design */
@media (max-width: 768px) {
  .tab-btn {
    padding: 12px 16px;
    font-size: 13px;
    min-height: 50px;
  }
  
  .tabs-content {
    padding: 16px;
  }
  
  .scroll-btn {
    width: 36px;
    height: 36px;
  }
  
  .tabs-header.with-arrows {
    padding: 0 45px;
  }
}

@media (max-width: 480px) {
  .tab-btn {
    padding: 10px 12px;
    gap: 6px;
  }
  
  .tab-title {
    font-size: 13px;
  }
}
