const Stepper = ({ steps, onSave }) => {
  // ... existing code ...

  return (
    <Box sx={{ width: "100%", padding: "1rem" }}>
      {/* Step Header - remains the same */}

      {/* Step Content - remains the same */}

      <Divider sx={{ margin: "2rem 0" }} />

      {/* Navigation Buttons */}
      <Box
        sx={{
          display: "flex",
          justifyContent: "space-between",
          gap: "1rem",
          flexWrap: "wrap",
        }}
      >
        <Button
          variant="outlined"
          onClick={handleBack}
          disabled={activeStep === 0}
          sx={{
            color: themeColor,
            borderColor: themeColor,
            fontWeight: "bold",
            borderRadius: "0.5rem",
            minWidth: "8rem",
            fontSize: "0.9rem",
          }}
        >
          {t("Previous")}
        </Button>
        
        {activeStep === totalSteps - 1 ? (
          <Button
            variant="contained"
            onClick={handlePayNow}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            {t("Pay Now")}
          </Button>
        ) : (
          <Button
            variant="contained"
            onClick={activeStep === 1 ? handleSave : handleNext}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            {activeStep === 1 ? t("Save & Next") : t("Next")}
          </Button>
        )}
      </Box>
    </Box>
  );
};
