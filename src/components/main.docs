const submitTransferData = async (formValues, stepIndex, stepInfo = null) => {
  try {
    loaderRef.current?.show();
    
    const ownerDetails = getFromLocalStorage("ownerDetails") 
      ? JSON.parse(getFromLocalStorage("ownerDetails")) 
      : null;

    // Base payload from 1st step response or new
    const basePayload = {
      registrationRequest: {
        id: registrationData?.RegistrationResponse?.id || "",
        applicationNumber: registrationData?.RegistrationResponse?.applicationNumber || "",
        applicationType: "TRANSFER_OF_REGISTRY",
        basicDetails: {
          id: registrationData?.RegistrationResponse?.basicDetails?.id || "",
          applicationNumber: registrationData?.RegistrationResponse?.applicationNumber || "",
          status: registrationData?.RegistrationResponse?.basicDetails?.status || "",
          ownerDetails: { id: ownerDetails?.id || "" },
          builderDetails: { id: registrationData?.RegistrationResponse?.basicDetails?.builderDetails?.id || "" },
        },
        vesselDetails: {
          id: registrationData?.RegistrationResponse?.vesselDetails?.id || "",
          typeOfVessel: formValues?.vesselDetails?.typeOfVessel || "",
          categoryOfVessel: formValues?.vesselDetails?.categoryOfVessel || "",
          grossTonnage: parseFloat(formValues?.vesselDetails?.grossTonnage) || 0,
          registrationNumber: formValues?.basicVesselInfo?.officialNo || "",
          vesselName: formValues?.vesselDetails?.vesselName || "",
          yearOfBuild: parseInt(formValues?.vesselDetails?.yearOfBuild) || 0,
          lengthOfVessel: parseFloat(formValues?.vesselDetails?.lengthOfVessel) || 0,
          breadthOfVessel: parseFloat(formValues?.vesselDetails?.breadthOfVessel) || 0,
          depthOfVessel: parseFloat(formValues?.vesselDetails?.depthOfVessel) || 0,
          previousPort: formValues?.vesselDetails?.portOfRegistry || "",
          reasonOfChange: formValues?.basicVesselInfo?.reasonForTransfer || ""
        },
        engineDetails: {
          id: registrationData?.RegistrationResponse?.engineDetails?.id || "",
          yearOfBuild: formValues?.vesselDetails?.yearOfBuild || "",
          engineType: formValues?.engineDetails?.engineType || "",
          engineMake: formValues?.engineDetails?.engineMake || "",
          horsepower: parseFloat(formValues?.engineDetails?.horsepower) || 0.00,
          speed: parseFloat(formValues?.engineDetails?.speed) || 0.00,
          numberOfEngine: parseInt(formValues?.engineDetails?.numberOfEngine) || 0
        }
      },
      initialSurveyRequest: {
        surveyId: initialRegistryData?.surveyId || "",
        BasicVesselInformation: {
          id: initialRegistryData?.BasicVesselInformation?.id || "",
          typeOfSurveyId: "Initial",
          placeYardNo: formValues?.basicVesselInfo?.proposedPortOfRegistry || "",
          netTonnage: parseFloat(formValues?.vesselDetails?.netTonnage) || 0,
          placeOfLastSurvey: formValues?.basicVesselInfo?.placeOfLastSurvey || "",
          dateOfLastSurvey: formValues?.basicDetails?.builderDetails?.dateOfLastSurvey || "",
          status: "NEW",
          lengthOfVessel: formValues?.vesselDetails?.lengthOfVessel || "",
          breadthOfVessel: formValues?.vesselDetails?.breadthOfVessel || "",
          depthOfVessel: formValues?.vesselDetails?.depthOfVessel || "",
          draft: formValues?.basicVesselInfo?.draft || "",
          iwtVesRegBasicDetailsTFk: registrationData?.RegistrationResponse?.basicDetails?.id || ""
        }
      },
      enclosers: extractAllEnclosures(formValues)
    };

    // For step 2, add equipment data to the survey request
    if (stepIndex === 1) {
      const equipmentPayload = buildEquipmentPayload(formValues, initialRegistryData);
      basePayload.initialSurveyRequest = {
        ...basePayload.initialSurveyRequest,
        ...equipmentPayload
      };
    }

    const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.TRANSFER_OF_REGISTRY.TRANSFER_OF_REGISTRY_CREATE;
    const response = await postData(apiUrl, basePayload);

    if (response?.status === 200 || response?.status === 201) {
      const responseData = response?.data?.data;
      
      setRegistrationData({
        RegistrationResponse: responseData?.RegistrationResponse,
        vessel: {
          applicationNumber: responseData?.RegistrationResponse?.applicationNumber,
          iwtVesselBasicDetailsTFk: responseData?.RegistrationResponse?.basicDetails?.id
        }
      });
      setInitialRegistryData(responseData?.IwtInitialSurveyResponse);
      
      toast.success(stepIndex === 0 ? "Transfer application submitted successfully!" : "Equipment data updated successfully!");

      if (stepInfo) {
        stepperRef.current?.goToNextStep();
      }
    } else {
      toast.error("Failed to submit data");
    }
  } catch (err) {
    console.error("Error:", err);
    toast.error("Error submitting data");
  } finally {
    loaderRef?.current?.hide();
  }
};

const handleFormSubmit = async (stepInfo) => {
  window.scrollTo({ top: 0, behavior: "smooth" });
  const formValues = stepInfo?.getFormData?.() || {};
  await submitTransferData(formValues, stepInfo.index, stepInfo);
};
