import React, { useState, useEffect, useRef } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Form, Button, Card, Image, Alert } from 'react-bootstrap';
import {
  FaUser, FaBuilding, FaFileUpload, FaCheck, FaArrowRight,
  FaArrowLeft, FaIdCard, FaEnvelope, FaPhone, FaMapMarkerAlt, FaUpload, FaShip
} from 'react-icons/fa';
import './UserRegistration.css';
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";
import { toast } from "react-toastify";
import InputText from '../../common/InputText.tsx';
import InputFile from '../../common/InputFile.tsx';
import { CONSTANT_REGEX_SAMPLE } from '../../../utils/constants.ts';
import NewLoader from '../../common/NewLoader.js';
import { getData, postData } from "../../../services/http.service.ts";
import { URLS_ENDPOINT } from '../../../utils/urlsConstants.ts';
import { handleErrorMessage } from '../../../utils/errorMessageHandler.js';

const VesselBuilderRegistrationPage = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [validationMessage, setValidationMessage] = useState("");
  const loaderRef = useRef();
  const PUBLIC_URL = process.env.REACT_APP_PUBLIC_URL;

  const methods = useForm({
    mode: 'onBlur',
    defaultValues: { country: 'India' }
  });

  const { register, handleSubmit, formState: { errors }, trigger, setValue, getValues, watch, clearErrors, setError } = methods;
  const totalSteps = 2;

  useEffect(() => {

    setTimeout(() => {
      console.log("Current Step:", currentStep);
      console.log("current form data:", formData);
      Object.keys(formData).forEach(key => {
        if (formData[key]) {
          console.log("Setting value for", key, formData[key]);
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [currentStep, setValue, formData]);


  const formFields = {
    step1: [
      {
        name: 'firstName',
        label: 'First Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 80,
        placeholder: "Enter Builder's First name",
        validation: { required: 'First name is required' }
      },
      {
        name: 'lastName',
        label: 'Last Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 80,
        placeholder: "Enter Builder's Last name",
        validation: { required: 'Last name is required' }
      },
      {
        name: 'emailId',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: {
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      {
        name: 'phoneNumber',
        label: 'Phone Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        maxlength: 10,
        placeholder: 'Enter 10-digit phone number',
        validation: {
          required: 'Phone number is required (10 digits)',
          pattern: {
            value: CONSTANT_REGEX_SAMPLE.MOBILE,
            message: 'Please enter a valid Phone number'
          }
        },

      },
      {
        name: 'panNumber',
        label: 'PAN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        maxlength: 10,
        placeholder: 'Enter PAN number (e.g., ABCDE1234F)',
        validation: {
          required: 'PAN number is required',
          pattern: {
            value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
            message: 'Invalid PAN number'
          }
        }
      },
      {
        name: 'gstNumber',
        label: 'GST Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter GST number',
        maxlength: 15,
        validation: {
          required: 'GST number is required',
          pattern: {
            value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
            message: 'Invalid GST No.'
          }
        }
      },
      {
        name: 'addressLine1',
        label: 'Address Line-1',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 100,
        placeholder: 'Enter address line 1',
        validation: { required: 'Address is required' }
      },
      {
        name: 'addressLine2',
        label: 'Address Line-2',
        type: 'text',
        required: false,
        maxlength: 100,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 2 (optional)'
      },
      {
        name: 'pin',
        label: 'PIN',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 6,
        placeholder: 'Enter 6-digit PIN code',
        validation: {
          required: 'PIN code is required',
          pattern: {
            value: /^[0-9]{6}$/,
            message: 'PIN must be 6 digits'
          }
        },
        onChange: (e, setValue, watch) => {
          const changedValue = e?.target?.value || "";
          if (changedValue?.length === 6) {
            setValue('district', '');
            setValue('stateUt', '');
            setValue('country', 'India');
            getDetailsByPIN(changedValue);
          }
        },
      },
      {
        name: 'district',
        label: 'District',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter district',
      },
      {
        name: 'stateUt',
        label: 'State / UT',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter state',
      },
      {
        name: 'country',
        label: 'Country',
        type: 'text',
        required: false,
        disabled : true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter country',
      }
    ],
    step2: [
      {
        name: 'addressProof',
        label: 'Address Proof',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'panCardUpload',
        label: 'PAN Card',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'gstCertificate',
        label: 'GST Certificate',
        type: 'file',
        required: false,
        colSize: 6,
      }
    ]
  };


  const getDetailsByPIN = async (pinCode) => {
    try {
      const URL = PUBLIC_URL + URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE + pinCode;
      loaderRef.current?.show();
      const response = await getData(URL);
      console.log(response);
      if (response?.status === 200 && response?.data?.length > 0) {
        setValue('district', response?.data[0]?.district);
        setValue('stateUt', response?.data[0]?.stateName);
        loaderRef?.current?.hide();
      } else {
        loaderRef?.current?.hide();
        toast.info("No Data Found! Pleasee enter manually..", { position: "top-right" });
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  }

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      default: return [];
    }
  };

  // Validate current step
  const validateStep = async () => {
    // Get all required fields for current step
    const requiredFields = getCurrentStepFields()
      .filter(field => field.required && (!field.showIf || field.showIf()));

    // Check for empty required fields
    let missingFields = [];
    requiredFields.forEach(field => {
      const value = getValues(field.name);
      if (!value || value === '') {
        missingFields.push(field.label);
        setError(field.name, {
          type: 'required',
          message: `${field.label} is required`
        });
      }
    });


    // Validate all fields in current step
    const fieldsToValidate = requiredFields.map(field => field.name);
    return await trigger(fieldsToValidate);
  };

  // Handle next button click
  const handleNext = async () => {
    const isStepValid = await validateStep();

    if (isStepValid) {
      // Clear validation message when all fields are valid
      setValidationMessage("");

      // Save all form values including file selections
      const currentValues = getValues();


      const fileFields = getCurrentStepFields().filter(field => field.type === 'file');
      fileFields.forEach(field => {
        if (currentValues[field.name]) {

          setFormData(prev => ({
            ...prev,
            [field.name]: currentValues[field.name]
          }));
        }
      });

      // Save all other form values
      setFormData(prev => ({ ...prev, ...currentValues }));

      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    }
  };

  // Handle previous button click
  const handlePrevious = () => {
    // Save current values before navigating
    const currentValues = getValues();


    const fileFields = getCurrentStepFields().filter(field => field.type === 'file');
    fileFields.forEach(field => {
      if (currentValues[field.name]) {

        setFormData(prev => ({
          ...prev,
          [field.name]: currentValues[field.name]
        }));
      }
    });

    // Save all other form values
    setFormData(prev => ({ ...prev, ...currentValues }));

    // Navigate to previous step
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
    setValidationMessage("");
  };

  // Handle form submission
  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };
    console.log('Form submitted with data:', JSON.stringify(finalData, null, 2));
    setIsSubmitted(true);
    window.scrollTo(0, 0);
  };




  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field.onChange) field.onChange(e, setValue, watch);

      if (e.target.value && errors[field.name]) {
        clearErrors(field.name);
        setValidationMessage("");
      }
    };

    switch (field.type) {


      case 'file':
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e.target.files[0]) {
                const file = e.target.files[0];

                // Store file name in form data
                setValue(field.name, file.name);
                setFormData(prev => {
                  const updated = { ...prev, [field.name]: file.name };
                  console.log(`Updated formData with file ${field.name}:`, updated);
                  return updated;
                });

                // Clear any errors
                if (errors[field.name]) {
                  clearErrors(field.name);
                }

                // File type validation
                const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'Only PDF, JPG or PNG files are allowed'
                  });
                }

                // File size validation (max 2MB)
                if (file.size > 2 * 1024 * 1024) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'File size should not exceed 2MB'
                  });
                }
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={formData[field.name]}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...field.validation,
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className="mb-4"
            style={{
              borderColor: errors[field.name] ? '#dc3545' : '#ced4da',
              backgroundColor: errors[field.name] ? '#fff8f8' : 'white'
            }}
          />
        );
    }
  };
  // Step titles
  const stepTitles = [
    { title: "Vessel Builder Details", icon: FaBuilding },
    { title: "Documents Upload", icon: FaFileUpload }
  ];

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="registration-container py-5">
        <Row className="justify-content-center">
          <Col md={10} xl={9}>
            <Card className="registration-card">
              <Card.Header className="registration-header p-0">
                <div className="registration-header-content">
                  <div className="header-logo-container">
                    <Image
                      src={IWT_FULL_IMG}
                      alt="IWT Logo"
                      className="header-logo"
                    />
                  </div>
                  <h3 className="header-title">
                    Vessel Builder Registration
                  </h3>
                </div>
              </Card.Header>

              <Card.Body className="registration-body p-4 p-md-5">
                {isSubmitted ? (
                  <div className="success-container text-center py-5">
                    <div className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style={{ width: '90px', height: '90px', boxShadow: '0 10px 20px rgba(40, 167, 69, 0.3)' }}>
                      <FaCheck className="success-icon text-white fs-1" />
                    </div>
                    <h4 className="success-title text-success mb-3 fw-bold">Registration Successful!</h4>
                    <p className="success-message mb-4 text-muted fs-5">
                      Your vessel builder registration has been submitted successfully.
                      You will receive a confirmation email shortly.
                    </p>
                    <div className="registration-id p-4 bg-light rounded mb-4" style={{ borderLeft: '4px solid #0077b6' }}>
                      <strong>Registration ID:</strong> {Math.random().toString(36).substring(2, 10).toUpperCase()}
                    </div>
                    <Button
                      variant="primary"
                      size="lg"
                      className="mt-2 d-flex align-items-center justify-content-center mx-auto"
                      style={{
                        background: 'linear-gradient(135deg, #0077b6, #023e8a)',
                        border: 'none',
                        boxShadow: '0 4px 15px rgba(0, 119, 182, 0.3)',
                        borderRadius: '8px',
                        padding: '12px 30px',
                        fontWeight: '600',
                        transition: 'all 0.3s ease',
                        minWidth: '150px',
                        height: '50px'
                      }}
                      onClick={() => window.location.href = '/dashboard'}
                    >
                      Go to Dashboard
                    </Button>
                  </div>
                ) : (
                  <FormProvider {...methods}>
                    <form>
                      {/* Form instruction */}
                      <div className="text-center mb-4">
                        <p className="text-muted">Please complete all required information to register as a vessel builder</p>
                      </div>


                      {/* Stepper */}
                      <div className="stepper-container mb-5">
                        <div className="stepper d-flex justify-content-between">
                          {[1, 2].map((step) => (
                            <React.Fragment key={step}>
                              <div className={`step ${currentStep >= step ? 'active' : ''} ${currentStep > step ? 'completed' : ''} flex-grow-1 text-center`}>
                                <div
                                  className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2"
                                  style={{
                                    width: '60px',
                                    height: '60px',
                                    borderRadius: '50%',
                                    fontSize: '20px',
                                    fontWeight: 'bold',
                                    boxShadow: currentStep >= step ? '0 5px 15px rgba(0, 119, 182, 0.3)' : '0 4px 10px rgba(0, 0, 0, 0.1)',
                                    background: currentStep >= step ?
                                      (currentStep > step ? 'linear-gradient(135deg, #28a745, #20c997)' : 'linear-gradient(135deg, #0077b6, #023e8a)') :
                                      '#ffffff',
                                    border: currentStep >= step ? 'none' : '2px solid #e9ecef',
                                    color: currentStep >= step ? '#fff' : '#6c757d',
                                    transition: 'all 0.4s ease'
                                  }}>
                                  {currentStep > step ? <FaCheck size={22} /> : React.createElement(stepTitles[step - 1].icon, { size: 22 })}
                                </div>
                                <div className="step-label fw-bold"
                                  style={{
                                    color: currentStep >= step ? (currentStep > step ? '#28a745' : '#0077b6') : '#6c757d',
                                    fontSize: '0.9rem',
                                    transition: 'all 0.3s ease'
                                  }}>
                                  {stepTitles[step - 1].title}
                                </div>
                              </div>
                              {step < 2 && (
                                <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                                  <div className={`connector-line w-100 ${currentStep > step ? 'active' : ''}`}
                                    style={{
                                      height: '4px',
                                      background: currentStep > step ? 'linear-gradient(to right, #28a745, #20c997)' : '#e9ecef',
                                      borderRadius: '2px',
                                      transition: 'all 0.5s ease'
                                    }}></div>
                                </div>
                              )}
                            </React.Fragment>
                          ))}
                        </div>
                      </div>

                      {/* Step Content */}
                      <div className="step-content">
                        <div className="form-section p-4 rounded mb-4">
                          <div className="section-title">
                            {React.createElement(stepTitles[currentStep - 1].icon, { className: "section-icon" })}
                            <h4 className="mb-0 fw-bold">{stepTitles[currentStep - 1].title}</h4>
                          </div>

                          <div className="form-content">
                            <Row className="g-3">
                              {getCurrentStepFields().map((field, index) => (
                                <Col key={index} md={field.colSize || 12}>
                                  <DynamicField field={field} />
                                </Col>
                              ))}
                            </Row>
                          </div>
                        </div>
                      </div>

                      <div className="form-navigation  mt-4" style={{ display: 'block' }}>

                        {
                          currentStep > 1 &&
                          <Button
                            variant="outline-secondary"
                            onClick={handlePrevious}
                            // hidden={currentStep === 1}
                            className="prev-btn"
                            style={{ 'float': 'left' }}
                          >
                            <FaArrowLeft className="btn-icon me-2" /> Previous
                          </Button>
                        }

                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="next-btn"
                          style={{ 'float': 'right' }}

                        >
                          {currentStep === totalSteps ? 'Submit Registration' : 'Next'}
                          {currentStep !== totalSteps && <FaArrowRight className="btn-icon ms-2" />}
                        </Button>
                      </div>
                    </form>
                  </FormProvider>
                )}
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Container>
    </>

  );
};

export default VesselBuilderRegistrationPage;


// InputFile.tsx
import React, { useState, useEffect } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaCheckCircle } from "react-icons/fa";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  register?: any;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
  defaultValue?: string;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  register,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  style = {},
  watch,
  defaultValue
}) => {
  const hasError = errors && errors[name];
  // const [fileName, setFileName] = useState<string>(defaultValue && defaultValue.trim() !== "" ? defaultValue : "");
  
  // // Update fileName when component mounts or watch value changes
  // useEffect(() => {
  //   // Check if there's a value from watch
  //   if (watch) {
  //     const value = watch(name);
  //     if (value && typeof value === 'string' && value.trim() !== "") {
  //       console.log(`InputFile ${name} watch value:`, value);
  //       setFileName(value);
  //     }
  //   }
    
  //   // Also check defaultValue on mount
  //   if (defaultValue && defaultValue.trim() !== "" && !fileName) {
  //     setFileName(defaultValue);
  //   }
  // }, [watch, name, defaultValue]);
  
// Fix the useState initialization in InputFile.tsx
const [fileName, setFileName] = useState<string>(
  defaultValue && typeof defaultValue === 'string' && defaultValue.trim() !== "" 
    ? defaultValue 
    : ""
);

// Also fix the useEffect check
useEffect(() => {
  // Check if there's a value from watch
  if (watch) {
    const value = watch(name);
    if (value && typeof value === 'string' && value.trim() !== "") {
      console.log(`InputFile ${name} watch value:`, value);
      setFileName(value);
    }
  }
  
  // Also check defaultValue on mount
  if (defaultValue && typeof defaultValue === 'string' && defaultValue.trim() !== "" && !fileName) {
    setFileName(defaultValue);
  }
}, [watch, name, defaultValue]);

  
  // Handle file change internally
  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files[0]) {
      const file = e.target.files[0];
      setFileName(file.name);
      console.log(`File selected for ${name}:`, file.name);
    }
    
    // Call the parent onChange handler if provided
    if (onChange) {
      onChange(e);
    }
  };
  
  // Get file icon based on extension
  const getFileIcon = () => {
    if (!fileName || typeof fileName !== 'string') return <FaFile color="#0d6efd" />;
    
    const extension = fileName.split('.').pop()?.toLowerCase();
    
    if (extension === 'pdf') return <FaFilePdf color="#dc3545" />;
    if (['jpg', 'jpeg', 'png', 'gif'].includes(extension || '')) return <FaFileImage color="#28a745" />;
    return <FaFile color="#0d6efd" />;
  };
  
  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {/* {required && <span className="text-danger ms-1">*</span>} */}
      </Form.Label>
      
      <div 
        className={`file-upload border rounded p-3 ${hasError ? 'border-danger' : ''}`} 
        style={{
          ...style,
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderColor: hasError ? '#dc3545' : '#ced4da',
          borderRadius: '8px',
          transition: 'all 0.3s ease'
        }}
      >
        <div className="d-flex align-items-center justify-content-between">
          <label 
            htmlFor={name} 
            className={`file-label btn ${hasError ? 'btn-outline-danger' : 'btn-primary'} mb-0 d-inline-flex align-items-center`}
            style={{ 
              borderRadius: '6px',
              padding: '8px 16px',
              cursor: 'pointer',
              boxShadow: '0 2px 5px rgba(0,0,0,0.1)',
              transition: 'all 0.3s ease',
              minWidth: '120px'
            }}
          >
            <FaUpload className="file-icon me-2" />
            <span className="file-text">Choose File</span>
          </label>
          
          <div 
            className={`file-name-container ms-3 flex-grow-1 border rounded px-3 py-2 ${fileName ? 'bg-light-success' : 'bg-light'} d-flex align-items-center ${hasError ? 'border-danger' : fileName ? 'border-success' : ''}`}
            style={{
              backgroundColor: fileName ? '#f0f9f0' : '#f8f9fa'
            }}
          >
            {fileName ? (
              <>
                <FaCheckCircle className="text-success me-2" />
                <div>
                  <span className="text-success fw-bold" style={{ fontSize: '0.8rem' }}>Selected File:</span>
                  <div className="d-flex align-items-center">
                    <span className="file-icon-preview me-2">{getFileIcon()}</span>
                    <span className="text-dark fw-semibold" style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                      {fileName}
                    </span>
                  </div>
                </div>
              </>
            ) : (
              <span className="text-muted">No file chosen</span>
            )}
          </div>
        </div>
        
        <input 
          type="file" 
          id={name}
          {...register}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="file-input d-none"
        />
      </div>
      
      <Form.Text className="text-muted small mt-1">
        Upload PDF, JPG or PNG file (Max size: 2MB)
      </Form.Text>
      
      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;

import React, { useState, useEffect } from "react";
import { Form, InputGroup, OverlayTrigger, Tooltip } from "react-bootstrap";
import { FaEye, FaEyeSlash } from "react-icons/fa";
import classNames from "classnames";

interface InputTextProps {
  label: string;
  required?: boolean;
  name: string;
  type?: string;
  placeholder?: string;
  register?: any;
  disabled?: boolean;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  maxlength?: number;
  readOnly?: boolean;
  errors?: any;
  className?: string;
  onKeyDown?: (e: React.KeyboardEvent<HTMLInputElement>) => void;
  icon?: React.ElementType;
  description?: string;
  style?: React.CSSProperties;
}

const InputText: React.FC<InputTextProps> = ({
  label,
  required,
  name,
  type = "text",
  placeholder,
  register,
  disabled,

  onChange,
  maxlength,
  readOnly,
  errors,
  className = "",
  onKeyDown,
  icon: IconComponent,
  description,
  style = {},
}) => {
  const [showPassword, setShowPassword] = useState(false);
  const [value, setValue] = useState("");

  const isPassword = type === "password";
  const inputType = isPassword ? (showPassword ? "text" : "password") : type;
  const hasError = errors && errors[name];

  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    setValue(e.target.value);

    if (onChange) {
      onChange(e);
    }
  };

  const togglePasswordVisibility = () => setShowPassword((prev) => !prev);

  const inputClasses = classNames("shadow-sm w-100", {
    "is-invalid": hasError,
    "border-start-0": IconComponent,
    "border-end-0": isPassword,
    "disabled": disabled,
  });

  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      {label && (
        <Form.Label className="fw-semibold d-block">
          {label}
          {required && <span className="text-danger ms-1">*</span>}
        </Form.Label>
      )}

      <InputGroup className="flex-nowrap w-100 flex-md-nowrap flex-wrap">
        {IconComponent && (
          <InputGroup.Text
            className={`bg-white border-end-0 ${
              hasError ? "border-danger text-danger" : ""
            }`}
            style={{
              borderColor: hasError ? "#dc3545" : "#ced4da",
              transition: "all 0.3s ease",
            }}
          >
            <IconComponent size={18} color={hasError ? "#dc3545" : "#387AD4"} />
          </InputGroup.Text>
        )}

        <Form.Control
          type={inputType}
          name={name}
          placeholder={placeholder}
          {...register}
          disabled={disabled}
          onChange={handleChange}
          maxLength={maxlength}
          readOnly={readOnly}
          onKeyDown={onKeyDown}
          min={0}
          className={inputClasses}
          aria-label={label}
          style={{
            ...style,
            borderColor: hasError ? "#dc3545" : "#ced4da",
            backgroundColor: hasError ? "#fff8f8" : "white",
            transition: "all 0.3s ease",
          }}
        />

        {isPassword && (
          <OverlayTrigger
            placement="top"
            overlay={
              <Tooltip id={`tooltip-${name}`}>
                {showPassword ? "Hide password" : "Show password"}
              </Tooltip>
            }
          >
            <InputGroup.Text
              className={`bg-white border-start-0 ${
                hasError ? "border-danger" : ""
              }`}
              role="button"
              onClick={togglePasswordVisibility}
              aria-label="Toggle password visibility"
              style={{
                cursor: "pointer",
                borderColor: hasError ? "#dc3545" : "#ced4da",
              }}
            >
              {showPassword ? (
                <FaEyeSlash
                  size={18}
                  color={hasError ? "#dc3545" : "#387AD4"}
                />
              ) : (
                <FaEye size={18} color={hasError ? "#dc3545" : "#387AD4"} />
              )}
            </InputGroup.Text>
          </OverlayTrigger>
        )}
      </InputGroup>

      {description && (
        <Form.Text style={{ color: "#5A67D8" }} className="d-block mt-1">
          {description}
        </Form.Text>
      )}

      {hasError?.message && (
        <Form.Text className="text-danger d-block">
          {errors?.[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputText;
