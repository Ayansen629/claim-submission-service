import React from "react";
import { Controller } from "react-hook-form";
import Tooltip from "@mui/material/Tooltip";
import { FaInfoCircle } from "react-icons/fa";
import DatePicker from "react-datepicker";
import "react-datepicker/dist/react-datepicker.css";

const DynamicField = ({ fieldConfig, control, register, errors, setValue, trigger, getValues }) => {
  const { name, label, type, options, rules, tooltip, placeholder, disabled } = fieldConfig; // Destructure disabled
  const hasError = errors[name];
  const userFormData = JSON.parse(localStorage.getItem("userFormData"));
  const applicationStatus = JSON.parse(localStorage.getItem("applicationdatastatus"));
  const hasUserType = userFormData?.userType;
  console.log(hasUserType, "hasUserType");

  const handleKeyPress = (e) => {
    if (type === "number" && !/^\d$/.test(e.key) && e.key !== "Backspace") {
      e.preventDefault();
    }
  };

  const handleFileChange = async (e) => {
    const file = e.target.files[0];
    if (file && fieldConfig.onFileUpload) {
      try {
        fieldConfig.setIsUploading(true);
        fieldConfig.setUploadError(null);

        const result = await fieldConfig.onFileUpload(file);

        if (result.success) {
          setValue(name, {
            fileId: result.fileId,
            docName: result.docName,
            docType: result.docType,
            docSource: result.docSource,
            fileUrl: result.fileUrl
          }, { shouldValidate: true });
        }
      } catch (error) {
        fieldConfig.setUploadError(error.message);
        setValue(name, null, { shouldValidate: true });
      } finally {
        fieldConfig.setIsUploading(false);
      }
    }
  };

  console.log(getValues(name), "getValues(name)");

  return (
    <div className="flex-item">
      <label>
        {label}
        {tooltip && (
          <Tooltip title={tooltip} arrow>
            <span style={{ marginLeft: "5px", cursor: "pointer" }}>
              <FaInfoCircle />
            </span>
          </Tooltip>
        )}
      </label>

      {type === "select" ? (
        <Controller
          name={name}
          control={control}
          rules={rules}
          render={({ field }) => (
            <select
              {...field}
              className={`form-input ${hasError ? "input-error" : ""}`}
              onChange={(e) => {
                field.onChange(e);
                if (fieldConfig.onChange) fieldConfig.onChange(e.target.value);
              }}
              disabled={disabled} // Apply the disabled prop here
            >
              <option value="" disabled>
                Select {label}
              </option>
              {options.map((option) => (
                <option key={option.value} value={option.value} disabled={option.disabled}>
                  {option.label}
                </option>
              ))}
            </select>
          )}
        />
      ) : type === "date" ? (
        <Controller
          name={name}
          control={control}
          rules={rules}
          render={({ field }) => (
            <DatePicker
              {...field}
              selected={field.value}
              onChange={(date) => {
                setValue(name, date);
                trigger(name);
              }}
              className={`form-input ${hasError ? "input-error" : ""}`}
              dateFormat="yyyy-MM-dd"
              placeholderText={placeholder || "Select a date"}
              disabled={disabled} // Apply the disabled prop here
            />
          )}
        />
      ) : type === "file" ? (
        <div className="custom-file-input">
          <input
            type="file"
            id={name}
            onChange={handleFileChange}
            className={`form-input ${hasError ? "input-error" : ""}`}
            style={{ display: "none" }}
            disabled={fieldConfig.isUploading || disabled} // Apply the disabled prop here
            accept={fieldConfig.accept}
          />
          <label
            htmlFor={name}
            className={`file-label ${hasError ? "input-error" : ""} ${fieldConfig.isUploading ? "uploading" : ""}`}
          >
            {fieldConfig.isUploading ? "Uploading..." : "Choose File"}
          </label>

          {getValues(name) && !fieldConfig.isUploading && (
  <div style={{ marginTop: "8px" }}>
    {(() => {
      const fileValue = getValues(name);
      
      // Handle case where fileValue is an object (CLM case)
      if (typeof fileValue === 'object' && fileValue !== null) {
        return <div>File: {fileValue.docName || fileValue.name || 'Uploaded file'}</div>;
      }
      
      // Handle case where fileValue is a string (file path/name)
      if (typeof fileValue === 'string') {
        return <div>File: {fileValue}</div>;
      }
      
      // Fallback for other cases
      return <div>File: Uploaded file</div>;
    })()}
  </div>
)}




{/* {getValues(name) && !fieldConfig.isUploading && (
            <div style={{ marginTop: "8px" }}>
              {
                hasUserType === "CLM" ? (
                  <div>File: {getValues(name).docName || getValues(name).name}</div>
                ) : (
                  <div>File: {getValues(name) || getValues(name)}</div>
                )

                

              }
              
             
            </div>
          )} */}
              
             
          

          {fieldConfig.uploadError && <p className="error-message">{fieldConfig.uploadError}</p>}
          {hasError && !fieldConfig.uploadError && <p className="error-message">{errors[name]?.message}</p>}
        </div>
      ) : type === "textarea" ? (
        <textarea
          {...register(name, rules)}
          className={`form-input ${hasError ? "input-error" : ""}`}
          placeholder={placeholder}
          onChange={(e) => {
            setValue(name, e.target.value);
            trigger(name);
          }}
          disabled={disabled} // Apply the disabled prop here
        />
      ) : (
        <input
          {...register(name, rules)}
          type={type}
          className={`form-input ${hasError ? "input-error" : ""}`}
          placeholder={placeholder}
          onChange={(e) => {
            setValue(name, e.target.value);
            trigger(name);
          }}
          onKeyPress={handleKeyPress}
          disabled={disabled} // Apply the disabled prop here
        />
      )}
      {hasError && <p className="error-message">{errors[name]?.message}</p>}
    </div>
  );
};

export default DynamicField;

import axios from "axios";
import { URLS_ENDPOINT } from "../utils/urlsConstants.ts";

export const uploadDocument = async (file, docType) => {
  console.log("Uploading file:", file, docType);

  const formData = new FormData();
  formData.append("file", file);
  formData.append("fileStoreId", "");

  try {
    const UPLOAD_URL = `${process.env.REACT_APP_FILE_SERVICE}${URLS_ENDPOINT.APP_SERVICES.UPLOAD_FILE}`;

    const response = await axios.post(UPLOAD_URL, formData, {
      headers: {
        "Content-Type": "multipart/form-data",
        Accept: "application/json",
      },
    });

    const files = response?.data?.files;

    if (files && files.length) {
      const uploadedFileData = {
        success: true,
        fileId: files[0].fileStoreId,
        docName: file.name,
        docType: docType,
        docSource: "web_upload",
        fileUrl: "",
        timestamp: new Date().toISOString()
      };

      // Save to localStorage based on docType
      saveToLocalStorage(docType, uploadedFileData);

      return uploadedFileData;
    } else {
      throw new Error("File upload failed: No file in response.");
    }
  } catch (error) {
    console.error("Upload error:", error);
    throw new Error(
      error?.response?.data?.message || "Failed to upload document"
    );
  }
};

// Helper function to save uploaded files to localStorage by docType
const saveToLocalStorage = (docType, fileData) => {
  try {
    // Get existing uploads from localStorage
    const existingUploads = JSON.parse(localStorage.getItem('fileUploads') || '{}');
    
    // Initialize array for this docType if it doesn't exist
    if (!existingUploads[docType]) {
      existingUploads[docType] = [];
    }
    
    // Add the new file data
    existingUploads[docType].push(fileData);
    
    // Save back to localStorage
    localStorage.setItem('fileUploads', JSON.stringify(existingUploads));
    
    console.log(`File saved to localStorage under docType: ${docType}`);
  } catch (error) {
    console.error("Error saving to localStorage:", error);
  }
};

// Helper function to get uploaded files by docType
export const getUploadedFilesByType = (docType) => {
  try {
    const allUploads = JSON.parse(localStorage.getItem('fileUploads') || '{}');
    return allUploads[docType] || [];
  } catch (error) {
    console.error("Error reading from localStorage:", error);
    return [];
  }
};

// Helper function to clear files for a specific docType
export const clearFilesByType = (docType) => {
  try {
    const allUploads = JSON.parse(localStorage.getItem('fileUploads') || '{}');
    delete allUploads[docType];
    localStorage.setItem('fileUploads', JSON.stringify(allUploads));
  } catch (error) {
    console.error("Error clearing files from localStorage:", error);
  }
};
import React, { useEffect, useCallback, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip";
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepFirst.css";

const StepFirst = ({ provideSubmitHandler, formData }) => {
  const userFormData = JSON.parse(localStorage.getItem("userFormData")) || {};
  const hasCreditorName = !!userFormData?.claimantName;
  const hasDebtorName = !!userFormData?.corporateDebtorName;
  const [isUploading, setIsUploading] = useState(false);
  const [uploadError, setUploadError] = useState(null);

  const methods = useForm({
    defaultValues: {
      CreditorName: userFormData?.claimantName || "",
      debtorName: userFormData?.corporateDebtorName || "",
      // identificationType: userFormData?.userDetails?.aadharNumber ? "Aadhar" :
      //                        userFormData?.userDetails?.panNumber ? "PAN" : "",
      // identificationNumber: userFormData?.userDetails?.aadharNumber ||
      //                          userFormData?.userDetails?.panNumber || ""
    }
  });

  const { register, handleSubmit, formState: { errors }, trigger, setValue, control, getValues, watch } = methods;

  const handleFileUpload = async (file) => {
    try {
      const result = await uploadDocument(file, 'identification');
      return result;
    } catch (error) {
      throw error;
    }
  };

  const claimantDetailsSchema = [
    {
      name: "CreditorName",
      label: <>Creditor Name <span className="required-asterisk">*</span></>,
      type: "text",
      rules: {
        required: !hasCreditorName && "Creditor Name is required",
      },
      placeholder: "Enter Creditor Name",
      disabled: hasCreditorName,
      tooltip: "Name of the creditor filing the claim"
    },
    {
      name: "totalClaimAmount",
      label: <>Total Claim Amount <span className="required-asterisk">*</span></>,
      type: "number",
      rules: {
        required: "Total Claim Amount is required",
        min: { value: 0, message: "Value must be greater than or equal to 0" }
      },
      placeholder: "Enter Total Claim Amount",
      tooltip: "The total amount being claimed against the debtor"
    },
    {
      name: "debtDetails",
      label: <>Debt Incurred Details <span className="required-asterisk">*</span></>,
      type: "textarea",
      rules: { required: "Debt Details are required" },
      tooltip: "Details of how and when debt incurred",
      placeholder: "Enter details including dates, nature of debt, and agreements"
    },
    {
      name: "mutualCreditDetails",
      label: <>Mutual Credit/Debts Details <span className="required-asterisk">*</span></>,
      type: "textarea",
      rules: { required: "Mutual Credit Details are required" },
      tooltip: "Details of any mutual credit, mutual debts, or other mutual dealings between the corporate debtor and the creditor which may be set-off against the claim",
      placeholder: "Enter details of any mutual transactions or set-offs"
    },
    {
      name: "identificationType",
      label: <>Identification Type <span className="required-asterisk">*</span></>,
      type: "select",
      options: [
        { value: "", label: "Select Identification Type" },
        { value: "Aadhar", label: "Aadhar" },
        { value: "PAN", label: "PAN" },
        { value: "Passport", label: "Passport" },
      ],
      // rules: { required: "Identification type is required" },
      tooltip: "Select the type of identification document provided",
    },
    {
      name: "identificationNumber",
      label: <>Identification Number <span className="required-asterisk">*</span></>,
      type: "text",
      rules: {
        required: "Identification number is required",
        validate: {
          aadhar: (value) =>
            watch("identificationType") === "Aadhar"
              ? /^[2-9]{1}[0-9]{3}[0-9]{4}[0-9]{4}$/.test(value) || "Please enter a valid 12-digit Aadhar number"
              : true,
          pan: (value) =>
            watch("identificationType") === "PAN"
              ? /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/.test(value) || "Please enter a valid PAN number (format: ABCDE1234F)"
              : true,
          passport: (value) =>
            watch("identificationType") === "Passport"
              ? /^[A-PR-W][0-9]{7}$/.test(value) || "Please enter a valid Passport number (common format)"
              : true,
        },
      },
      tooltip: "Enter your Aadhar, PAN, or Passport number",
      placeholder: "Enter Identification Number",
    },
    {
      name: "identificationDocument",
      label: <>Identification Document <span className="required-asterisk">*</span></>,
      // label: "Identification Document",
      type: "file",
      rules: {
        required: "Identification document is required",
        validate: {
          fileUploaded: (value) => value !== null || getValues("identificationDocument") !== null || "Please upload the document"
        }
      },
      tooltip: "Upload a clear scan of your identification document",
      accept: "image/*,.pdf",
      onFileUpload: handleFileUpload,
      isUploading,
      uploadError,
      setIsUploading,
      setUploadError
    },
  ];

  const debtorDetailsSchema = [
    {
      name: "debtorName",
      label: <>Debtor Name <span className="required-asterisk">*</span></>,
      type: "text",
      rules: {
        required: !hasDebtorName && "Debtor Name is required"
      },
      placeholder: "Enter Debtor Name",
      tooltip: "Name of the corporate debtor against whom the claim is being filed",
      disabled: hasDebtorName
    }
  ];

  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    if (!isValid) {
      console.error("Validation failed");
      return false;
    }
    return getValues();
  }, [trigger, getValues]);

  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        setValue(key, formData[key]);
      });
    }

    if (!formData?.CreditorName && hasCreditorName) {
      setValue("CreditorName", userFormData.claimantName);
    }
    if (!formData?.debtorName && hasDebtorName) {
      setValue("debtorName", userFormData.corporateDebtorName);
    }
  }, [formData, setValue, hasCreditorName, userFormData.claimantName, hasDebtorName, userFormData.corporateDebtorName]);

  useEffect(() => {
    if (provideSubmitHandler) {
      provideSubmitHandler(onSubmit);
    }
  }, [provideSubmitHandler, onSubmit]);

  const identificationType = watch("identificationType");
  useEffect(() => {
    if (identificationType) {
      trigger("identificationNumber");
      localStorage.setItem("selectedIdentificationType", identificationType);
    }
  }, [identificationType, trigger]);

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        <div className="mb-4 bg-light">
          <div className="mb-4 bg-light">
            <Collapsible title="Debtor Details" defaultOpen={true}>
              <div className="flex-container">
                {debtorDetailsSchema.map((fieldConfig) => (
                  <DynamicField
                    key={fieldConfig.name}
                    fieldConfig={fieldConfig}
                    control={control}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    trigger={trigger}
                    getValues={getValues}
                  />
                ))}
              </div>
            </Collapsible>
          </div>
          <Collapsible title="Creditor Basic Details" defaultOpen={true}>
            <div className="flex-container">
              {claimantDetailsSchema.map((fieldConfig) => (
                <DynamicField
                  key={fieldConfig.name}
                  fieldConfig={fieldConfig}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  trigger={trigger}
                  getValues={getValues}
                />
              ))}
            </div>
          </Collapsible>
        </div>
      </form>
    </FormProvider>
  );
};

export default StepFirst;
