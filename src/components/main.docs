.certificateContainer {
  background: white;
  border: 2px solid #2466BF;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 4px 12px rgba(36, 102, 191, 0.15);
  margin-top: 1rem;
  font-family: 'Arial', sans-serif;
}

.certificateHeader {
  background: linear-gradient(135deg, #2466BF 0%, #1a4fa0 100%);
  padding: 1rem;
  text-align: center;
}

.certificateTitle {
  color: white;
  font-weight: 700;
  font-size: 1.3rem;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.certificateBody {
  padding: 2rem;
  background: #ffffff;
}

.mb2 {
  margin-bottom: 0.5rem;
}

.mb3 {
  margin-bottom: 1rem;
}

.mb4 {
  margin-bottom: 1.5rem;
}

.infoField {
  display: flex;
  align-items: center;
  margin-bottom: 0.5rem;
  padding: 0.5rem;
  background: #f8f9fa;
  border-radius: 4px;
  border-left: 3px solid #2466BF;
}

.fieldLabel {
  color: #333;
  font-weight: 600;
  font-size: 0.85rem;
  min-width: 200px;
  margin-right: 1rem;
}

.fieldValue {
  color: #2466BF;
  font-weight: 700;
  font-size: 0.9rem;
  flex: 1;
}

.expirySection {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  padding: 0.5rem;
  border-radius: 4px;
  border-left: 3px solid #2466BF;
}

.dateFields {
  display: flex;
  align-items: center;
  margin-left: 1rem;
}

.dateInput {
  background: white;
  border: 1px solid #ced4da;
  padding: 0.25rem 0.5rem;
  border-radius: 3px;
  font-weight: 600;
  width: 40px;
  text-align: center;
  color: #2466BF;
}

.dateSeparator {
  margin: 0 0.25rem;
  color: #666;
  font-weight: bold;
}

.editableField {
  background: white;
  border: 1px solid #ced4da;
  padding: 0.25rem 0.5rem;
  border-radius: 3px;
  font-weight: 600;
  color: #2466BF;
  width: 100px;
}

.editableSelect {
  background: white;
  border: 1px solid #ced4da;
  padding: 0.25rem 0.5rem;
  border-radius: 3px;
  font-weight: 600;
  color: #2466BF;
}

.sectionTitle {
  color: #2466BF;
  font-weight: 700;
  font-size: 1rem;
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-bottom: 2px solid #2466BF;
  padding-bottom: 0.5rem;
}

.certificateStatement {
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 6px;
  border-left: 4px solid #2466BF;
  font-style: italic;
}

.certificationText {
  text-align: justify;
  line-height: 1.6;
  margin: 0;
}

.validityStatement {
  background: #fff3cd;
  border: 1px solid #ffeaa7;
  padding: 1rem;
  border-radius: 6px;
  text-align: center;
  font-weight: 600;
}

.vesselDetails {
  border: 1px solid #dee2e6;
  border-radius: 6px;
  padding: 1rem;
  background: #f8f9fa;
}

.plyingLimits {
  border: 1px solid #dee2e6;
  border-radius: 6px;
  padding: 1rem;
  background: #f8f9fa;
}

.plyingInputContainer {
  display: flex;
  align-items: center;
}

.plyingInput {
  background: white;
  border: 1px solid #ced4da;
  padding: 0.25rem 0.5rem;
  border-radius: 3px;
  font-weight: 600;
  width: 50px;
  text-align: center;
  color: #2466BF;
  margin-right: 0.5rem;
}

.plyingText {
  color: #2466BF;
  font-weight: 600;
}

.capacitySection {
  border: 1px solid #dee2e6;
  border-radius: 6px;
  padding: 1rem;
  background: #f8f9fa;
}

.capacityFields {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.capacityField {
  display: flex;
  align-items: center;
}

.capacityLabel {
  color: #333;
  font-weight: 600;
  font-size: 0.85rem;
  margin-right: 0.5rem;
}

.capacityInput {
  background: white;
  border: 1px solid #ced4da;
  padding: 0.25rem 0.5rem;
  border-radius: 3px;
  font-weight: 600;
  width: 60px;
  text-align: center;
  color: #2466BF;
}

.safetyEquipment {
  border: 1px solid #dee2e6;
  border-radius: 6px;
  padding: 1rem;
  background: #f8f9fa;
}

.safetyTable {
  font-size: 0.8rem;
  margin-bottom: 0;
}

.safetyTable th {
  background: #2466BF;
  color: white;
  text-align: center;
  font-weight: 600;
  padding: 0.5rem;
  vertical-align: middle;
}

.safetyTable td {
  text-align: center;
  padding: 0.25rem;
  font-weight: 600;
  color: #2466BF;
  vertical-align: middle;
}

.tableInput {
  background: white;
  border: 1px solid #ced4da;
  padding: 0.25rem;
  border-radius: 3px;
  font-weight: 600;
  width: 100%;
  text-align: center;
  color: #2466BF;
}

@media (max-width: 768px) {
  .certificateBody {
    padding: 1rem;
  }
  
  .infoField {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .fieldLabel {
    min-width: auto;
    margin-right: 0;
    margin-bottom: 0.25rem;
  }
  
  .fieldValue {
    text-align: left;
  }
  
  .expirySection {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .dateFields {
    margin-left: 0;
    margin-top: 0.5rem;
  }
  
  .capacityFields {
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .safetyTable {
    font-size: 0.7rem;
  }
  
  .safetyTable th,
  .safetyTable td {
    padding: 0.25rem;
  }
}
