
/* Stepper Styles */
.stepper-wrapper {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20px;
  position: relative;
}

.stepper-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stepper-item::before {
  position: absolute;
  content: "";
  border-bottom: 2px solid #dee2e6;
  width: 100%;
  top: 15px;
  left: -50%;
  z-index: 1;
}

.stepper-item:first-child::before {
  content: none;
}

.stepper-item.active .step-counter {
  background-color: #0d6efd;
  color: white;
  border-color: #0d6efd;
}

.stepper-item.completed .step-counter {
  background-color: #198754;
  color: white;
  border-color: #198754;
}

.step-counter {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #fff;
  border: 2px solid #dee2e6;
  color: #6c757d;
  font-weight: 600;
  margin-bottom: 8px;
}

.step-name {
  color: #6c757d;
  font-size: 0.875rem;
  font-weight: 500;
}

.stepper-item.active .step-name {
  color: #0d6efd;
  font-weight: 600;
}

/* Form Styles */
.disabled-field {
  background-color: #f8f9fa !important;
  color: #495057 !important;
  cursor: not-allowed !important;
}

.file-display {
  padding: 8px 12px;
  background-color: #f8f9fa;
  border-radius: 4px;
  border: 1px solid #dee2e6;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .stepper-wrapper {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .stepper-item {
    flex-direction: row;
    margin-bottom: 15px;
    width: 100%;
  }
  
  .stepper-item::before {
    display: none;
  }
  
  .step-counter {
    margin-right: 15px;
    margin-bottom: 0;
  }
  
  .step-name {
    margin-top: 3px;
  }
}

/* Card and container styles */
.officer-view-container {
  background-color: #f5f7fa;
  min-height: 100vh;
}

.card {
  border-radius: 10px;
  overflow: hidden;
}
