import React from 'react';
import { Container, Row, Col, Card, Table, Button, Badge } from 'react-bootstrap';
import { FaShip, FaUser, FaFileAlt, FaReceipt, FaCheck, FaArrowLeft, FaArrowRight, FaEdit } from 'react-icons/fa';
import './PreviewPage.css';

const PreviewPage = ({
  data = {},
  sections = [],
  title = "Preview",
  subtitle = "Please review all information before final submission",
  onBack,
  onSubmit,
  submitButtonText = "Submit",
  icons = {}
}) => {
  
  const defaultIcons = {
    vessel: FaShip,
    owner: FaUser,
    documents: FaFileAlt,
    invoice: FaReceipt,
    edit: FaEdit,
    back: FaArrowLeft,
    submit: FaArrowRight,
    check: FaCheck,
    ...icons
  };

  // Function to render a data table
  const renderDataTable = (items, columns = 1) => {
    const itemsPerColumn = Math.ceil(Object.keys(items).length / columns);
    const columnWidth = 12 / columns;
    
    return (
      <Row>
        {Array.from({ length: columns }).map((_, colIndex) => {
          const startIndex = colIndex * itemsPerColumn;
          const endIndex = startIndex + itemsPerColumn;
          const columnItems = Object.entries(items).slice(startIndex, endIndex);
          
          return columnItems.length > 0 ? (
            <Col md={columnWidth} key={colIndex}>
              <Table borderless size="sm" className="preview-table">
                <tbody>
                  {columnItems.map(([key, value]) => (
                    <tr key={key}>
                      <th className="preview-label">{formatLabel(key)}</th>
                      <td className="preview-value">{renderValue(value)}</td>
                    </tr>
                  ))}
                </tbody>
              </Table>
            </Col>
          ) : null;
        })}
      </Row>
    );
  };

  // Function to render document list
  const renderDocuments = (documents) => {
    return (
      <Row>
        {Object.entries(documents).map(([key, value]) => (
          <Col md={6} key={key} className="mb-3">
            <div className="document-item">
              <div className="document-icon">
                <FaCheck className="text-success" />
              </div>
              <div className="document-details">
                <div className="document-name">{formatLabel(key)}</div>
                <div className="document-filename">{value}</div>
              </div>
            </div>
          </Col>
        ))}
      </Row>
    );
  };

  // Function to render fee breakdown
  const renderFeeBreakdown = (fees) => {
    const { totalAmount, ...otherFees } = fees;
    
    return (
      <div className="fee-breakdown">
        {Object.entries(otherFees).map(([key, value]) => (
          <div className="fee-item" key={key}>
            <span className="fee-label">{formatLabel(key)}:</span>
            <span className="fee-value">₹ {formatCurrency(value)}</span>
          </div>
        ))}
        <div className="fee-divider"></div>
        <div className="fee-total">
          <span className="fee-total-label">Total Amount:</span>
          <span className="fee-total-value">₹ {formatCurrency(totalAmount)}</span>
        </div>
      </div>
    );
  };

  // Helper function to format labels
  const formatLabel = (key) => {
    return key
      .replace(/([A-Z])/g, ' $1')
      .replace(/^./, str => str.toUpperCase())
      .replace(/Id$/, 'ID');
  };

  // Helper function to format currency
  const formatCurrency = (value) => {
    const numValue = parseFloat(value);
    return isNaN(numValue) ? value : numValue.toLocaleString();
  };

  // Helper function to render different value types
  const renderValue = (value) => {
    if (value === null || value === undefined) return "-";
    
    if (typeof value === 'boolean') {
      return value ? "Yes" : "No";
    }
    
    if (typeof value === 'object' && value.status) {
      return (
        <Badge bg={getBadgeColor(value.status)}>
          {value.status}
        </Badge>
      );
    }
    
    return value.toString();
  };

  // Helper function to get badge color based on status
  const getBadgeColor = (status) => {
    const statusMap = {
      'Pending': 'warning',
      'Approved': 'success',
      'Rejected': 'danger',
      'In Progress': 'info',
      'Paid': 'success',
      'Unpaid': 'danger'
    };
    
    return statusMap[status] || 'secondary';
  };

  
  const renderSection = (section) => {
    const { title, type, data: sectionData, icon, columns = 2, color = 'primary' } = section;
    const IconComponent = defaultIcons[icon] || defaultIcons.vessel;
    
    return (
      <Card className="preview-card mb-4">
        <Card.Header className={`bg-${color} preview-header`}>
          <IconComponent className="preview-header-icon" />
          <h5 className="preview-header-title">{title}</h5>
        </Card.Header>
        <Card.Body className="preview-body">
          {type === 'table' && renderDataTable(sectionData, columns)}
          {type === 'documents' && renderDocuments(sectionData)}
          {type === 'fees' && renderFeeBreakdown(sectionData)}
          {type === 'custom' && section.render(sectionData)}
        </Card.Body>
      </Card>
    );
  };

 
  const TitleIcon = icons.title ? defaultIcons[icons.title] || icons.title : null;

  return (
    <Container className="preview-container">
      <div className="preview-header-container">
        <h2 className="preview-title">
          {TitleIcon && <TitleIcon className="preview-title-icon" />}
          {title}
        </h2>
        <p className="preview-subtitle">{subtitle}</p>
      </div>
      
      {sections.length > 0 ? (
        sections.map((section, index) => (
          <React.Fragment key={index}>
            {renderSection({
              ...section,
              data: section.dataKey ? data[section.dataKey] : section.data
            })}
          </React.Fragment>
        ))
      ) : (
       
        <>
          {data.vesselDetails && (
            <Card className="preview-card mb-4">
              <Card.Header className="bg-primary preview-header">
                <FaShip className="preview-header-icon" />
                <h5 className="preview-header-title">Vessel Details</h5>
              </Card.Header>
              <Card.Body className="preview-body">
                {renderDataTable(data.vesselDetails, 2)}
              </Card.Body>
            </Card>
          )}
          
          {data.ownerDetails && (
            <Card className="preview-card mb-4">
              <Card.Header className="bg-info preview-header">
                <FaUser className="preview-header-icon" />
                <h5 className="preview-header-title">Owner Details</h5>
              </Card.Header>
              <Card.Body className="preview-body">
                {renderDataTable(data.ownerDetails, 2)}
              </Card.Body>
            </Card>
          )}
          
          {data.documents && (
            <Card className="preview-card mb-4">
              <Card.Header className="bg-success preview-header">
                <FaFileAlt className="preview-header-icon" />
                <h5 className="preview-header-title">Uploaded Documents</h5>
              </Card.Header>
              <Card.Body className="preview-body">
                {renderDocuments(data.documents)}
              </Card.Body>
            </Card>
          )}
          
          {data.invoiceDetails && (
            <Card className="preview-card mb-4">
              <Card.Header className="bg-warning preview-header">
                <FaReceipt className="preview-header-icon" />
                <h5 className="preview-header-title">Invoice Details</h5>
              </Card.Header>
              <Card.Body className="preview-body">
                <Row>
                  <Col md={6}>
                    {renderDataTable({
                      invoiceNumber: data.invoiceDetails.invoiceNumber,
                      invoiceDate: data.invoiceDetails.invoiceDate,
                      paymentStatus: {
                        status: data.invoiceDetails.paymentStatus
                      },
                      paymentMode: data.invoiceDetails.paymentMode
                    }, 1)}
                  </Col>
                  <Col md={6}>
                    <Card className="fee-card">
                      <Card.Body>
                        {renderFeeBreakdown(data.invoiceDetails)}
                      </Card.Body>
                    </Card>
                  </Col>
                </Row>
              </Card.Body>
            </Card>
          )}
        </>
      )}
      
      <div className="preview-actions">
        {onBack && (
          <Button 
            variant="outline-secondary" 
            onClick={onBack}
            className="preview-back-btn"
          >
            <FaArrowLeft className="preview-btn-icon" /> Back to Edit
          </Button>
        )}
        
        {onSubmit && (
          <Button 
            variant="primary" 
            onClick={onSubmit}
            className="preview-submit-btn"
          >
            {submitButtonText} <FaArrowRight className="preview-btn-icon" />
          </Button>
        )}
      </div>
    </Container>
  );
};

export default PreviewPage;


.preview-container {
  padding: 2rem 0;
}

.preview-header-container {
  text-align: center;
  margin-bottom: 2rem;
}

.preview-title {
  font-weight: 600;
  color: #0a3161;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-title-icon {
  margin-right: 0.75rem;
}

.preview-subtitle {
  color: #6c757d;
  font-size: 1rem;
}

.preview-card {
  border: none;
  box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
  margin-bottom: 1.5rem;
  border-radius: 0.5rem;
  overflow: hidden;
}

.preview-header {
  display: flex;
  align-items: center;
  padding: 1rem 1.25rem;
}

.preview-header-icon {
  margin-right: 0.75rem;
  font-size: 1.25rem;
}

.preview-header-title {
  margin-bottom: 0;
  font-weight: 600;
}

.preview-body {
  padding: 1.5rem;
}

.preview-table {
  margin-bottom: 0;
}

.preview-table th {
  width: 40%;
  font-weight: 600;
  color: #495057;
  padding: 0.5rem 0.75rem 0.5rem 0;
  vertical-align: top;
}

.preview-table td {
  padding: 0.5rem 0;
  color: #212529;
}

.preview-label {
  font-weight: 600;
  color: #495057;
}

.preview-value {
  color: #212529;
}

.document-item {
  display: flex;
  align-items: flex-start;
  padding: 0.75rem;
  background-color: #f8f9fa;
  border-radius: 0.375rem;
  transition: all 0.2s ease;
}

.document-item:hover {
  background-color: #e9ecef;
}

.document-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  background-color: #e8f5e9;
  border-radius: 50%;
  margin-right: 0.75rem;
}

.document-details {
  flex: 1;
}

.document-name {
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.document-filename {
  font-size: 0.875rem;
  color: #6c757d;
}

.fee-card {
  background-color: #f8f9fa;
  border: none;
  border-radius: 0.375rem;
}

.fee-breakdown {
  padding: 0.5rem 0;
}

.fee-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}

.fee-label {
  color: #495057;
}

.fee-value {
  font-weight: 500;
}

.fee-divider {
  height: 1px;
  background-color: #dee2e6;
  margin: 0.75rem 0;
}

.fee-total {
  display: flex;
  justify-content: space-between;
  font-weight: 700;
  font-size: 1.125rem;
}

.preview-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 2rem;
}

.preview-back-btn,
.preview-submit-btn {
  display: flex;
  align-items: center;
  padding: 0.625rem 1.25rem;
  font-weight: 500;
}

.preview-btn-icon {
  margin-left: 0.5rem;
  margin-right: 0.5rem;
}

.preview-submit-btn {
  background: linear-gradient(135deg, #0077b6, #023e8a);
  border: none;
  box-shadow: 0 0.25rem 0.75rem rgba(0, 119, 182, 0.3);
  transition: all 0.3s ease;
}

.preview-submit-btn:hover {
  background: linear-gradient(135deg, #023e8a, #01233f);
  transform: translateY(-1px);
  box-shadow: 0 0.375rem 1rem rgba(0, 119, 182, 0.4);
}

@media (max-width: 767.98px) {
  .preview-actions {
    flex-direction: column;
    gap: 1rem;
  }
  
  .preview-back-btn,
  .preview-submit-btn {
    width: 100%;
    justify-content: center;
  }
}
