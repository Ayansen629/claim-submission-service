import React, { useState, useEffect, useRef, useCallback } from "react";
// ... other imports

const VesselReportsAndDocs = () => {
  // ... existing state and variables

  // Use useCallback to memoize the function
  const handleSubmitAppointments = useCallback(async (appointmentSlots) => {
    try {
      loaderRef.current?.show();
      
      const payload = {
        ...createRegistrationPayload(methods.getValues(), {}),
        appointmentSlots
      };

      const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.VESSEL_SERVICE.CREATE;
      const response = await postData(apiUrl, payload);

      if (response?.status === 200 && response?.data?.responseStatus) {
        toast.success(
          response?.data?.responseStatus?.message ||
          "Appointment slots submitted successfully!"
        );
        // Don't redirect, just close the modal and refresh steps
        setShowCmnStepper(false);
      } else {
        toast.error(
          response?.data?.responseStatus?.message ||
          "Failed to submit appointment slots"
        );
      }
    } catch (error) {
      console.error("Appointment submission error:", error);
      toast.error("Failed to submit appointment slots. Please try again.");
    } finally {
      loaderRef.current?.hide();
    }
  }, [methods, registrationData]); // Add dependencies

  // Update useEffect dependencies
  useEffect(() => {
    if (!registrationData) return;

    const createStep = (
      label,
      component,
      validate = null,
      noValidation = true
    ) => ({
      label,
      component,
      getFormData: () => methods?.getValues(),
      validate,
      goToNextStepNoValidtion: noValidation,
    });

    // ... existing step creation logic

    if (isOfficerLogin && isViewMode) {
      const stepsList = [];
      
      // ... existing steps logic

      if (registrationData?.basicDetails?.isCmnGenerated || showCmnStepper) {
        if (userRole === USER_ROLES.OFFICER_L5) {
          stepsList.push(
            createStep(
              "Director Review",
              <CurvingMarkingNoteL5
                registrationData={registrationData}
              />
            )
          );
        } else if (
          userRole === USER_ROLES.OFFICER_L3 ||
          userRole === USER_ROLES.OFFICER_L4
        ) {
          stepsList.push(
            createStep(
              "Curving & Marking Note",
              <CurvingMarkingNote
                registrationData={registrationData}
                onSubmitAppointments={handleSubmitAppointments}
              />
            )
          );
        }
      }

      setSteps(stepsList);
    } else {
      // ... existing else logic
    }
  }, [
    pageName,
    rowData,
    registrationData,
    isViewMode,
    isOfficerLogin,
    userRole,
    showCmnStepper,
    handleSubmitAppointments, // This is now stable due to useCallback
  ]);

  // ... rest of the component
};
