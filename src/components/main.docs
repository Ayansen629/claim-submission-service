const RenderDynamicEquipmentTable = memo(({ equipment, register, errors, watch, handleConditionChange, isFieldDisabled, viewMode, getEquipmentIcon, values, isConditionDisabled }) => {
  return (
    <Collapsible
      title={
        <>
          {getEquipmentIcon(equipment.equipmentName)}
          <span>{equipment.equipmentName}</span>
        </>
      }
      openStat={true}
    >
      <div className="table-container">
        <Table striped bordered hover responsive className="mb-0 equipment-table">
          <thead>
            <tr>
              <th>{equipment.equipmentName}</th>
              <th>Number</th>
              <th>Type</th>
              <th>Capacity</th>
              <th>Location</th>
              {viewMode && (
                <>
                  <th style={{minWidth: "200px"}}>Condition</th>
                  <th>Remarks</th>
                </>
              )}
            </tr>
          </thead>
          <tbody>
            {equipment.equipmentCategories.map((category) => {
              const fieldName = `equipment.${equipment.id}.${category.categoryCode}`;
              return (
                <EquipmentTableRow
                  key={category.categoryCode}
                  category={category}
                  fieldName={fieldName}
                  register={register}
                  errors={errors}
                  watch={watch}
                  handleConditionChange={handleConditionChange}
                  isFieldDisabled={isFieldDisabled}
                  viewMode={viewMode}
                  values={values}
                  isConditionDisabled={isConditionDisabled}
                />
              );
            })}
          </tbody>
        </Table>
      </div>
    </Collapsible>
  );
});
