const FormCDetails = ({ provideSubmitHandler, formData, onValidationComplete }) => {
  const methods = useForm({ mode: "onChange" });
  const { 
    register, 
    handleSubmit, 
    formState: { errors, isValid }, 
    control, 
    setValue, 
    getValues, 
    watch, 
    reset, 
    trigger 
  } = methods;
  
  const [selectedClaimType, setSelectedClaimType] = useState("");

  const bankAccountFields = [
    {
      name: "accountNumber",
      label: "Account Number",
      type: "text",
      rules: { 
        required: "Account number is required",
        pattern: {
          value: /^[0-9]{9,18}$/,
          message: "Account number must be 9-18 digits"
        }
      },
      placeholder: "Enter account number",
      icon: <FaUniversity className="field-icon me-2" />
    },
    {
      name: "ifscCode",
      label: "IFSC Code",
      type: "text",
      rules: { 
        required: "IFSC code is required",
        pattern: {
          value: /^[A-Za-z]{4}0[A-Za-z0-9]{6}$/,
          message: "Invalid IFSC code format (e.g., ABCD0123456)"
        }
      },
      placeholder: "Enter IFSC code (e.g., ABCD0123456)",
      component: IFSCSearch,
      icon: <GiBank className="field-icon me-2" />
    },
    {
      name: "bankName",
      label: "Bank Name",
      type: "text",
      rules: { required: "Bank name is required" },
      placeholder: "Enter bank name",
      icon: <FaLandmark className="field-icon me-2" />
    },
    {
      name: "branchName",
      label: "Branch Name",
      type: "text",
      rules: { required: "Branch name is required" },
      placeholder: "Enter branch name",
      icon: <BsBuilding className="field-icon me-2" />
    },
    {
      name: "branchAddress",
      label: "Branch Address",
      type: "text",
      rules: { required: "Branch address is required" },
      placeholder: "Enter branch address",
      icon: <FaMapMarkerAlt className="field-icon me-2" />
    },
    {
      name: "city",
      label: "City",
      type: "text",
      rules: { required: "City is required" },
      placeholder: "Enter city",
      icon: <FaCity className="field-icon me-2" />
    },
    {
      name: "state",
      label: "State",
      type: "text",
      rules: { required: "State is required" },
      placeholder: "Enter state",
      icon: <FaGlobeAmericas className="field-icon me-2" />
    },
    {
      name: "district",
      label: "District",
      type: "text",
      rules: { required: "District is required" },
      placeholder: "Enter district",
      icon: <FaMapMarkerAlt className="field-icon me-2" />
    }
  ];

  const claimTypeOptions = [
    { value: "", label: "Select Claim Type", disabled: true },
    { value: "PRINCIPAL_BORROWER", label: "Corporate Debtor as Principal Borrower" },
    { value: "GUARANTOR", label: "Corporate Debtor as Guarantor" },
    { value: "BENEFICIARY", label: "Financial Debt Covered" },
  ];

  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    if (!isValid) {
      console.error("Validation failed");
      return false;
    }
    
    // Get all form values including entity data
    const formValues = getValues();
    
    // Log the complete form data with entity data
    console.log("Form Submit Data with Entity Data:", formValues);
    
    return formValues;
  }, [trigger, getValues]);

  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        setValue(key, formData[key]);
      });
      if (formData.claimType) {
        setSelectedClaimType(formData.claimType);
      }
    }
  }, [formData, setValue]);

  // Function to get entity type based on claim type
  function getEntityTypeFromClaimType(claimType) {
    switch(claimType) {
      case "PRINCIPAL_BORROWER": return "GUARANTOR";
      case "GUARANTOR": return "PRINCIPAL_BORROWER";
      case "BENEFICIARY": return "BENEFICIARY";
      default: return "";
    }
  }

  const handleClaimTypeChange = async (value) => {
    setSelectedClaimType(value);
    
    const baseReset = {
      claimType: value,
      claimAmount: "",
      hasSecurityInterest: "",
      hasGuarantee: "",
      securityValue: "",
      securityDate: "",
      guaranteeValue: "",
      guaranteeDate: "",
    };

    reset(baseReset);
    await trigger();
  };

  useEffect(() => {
    if (provideSubmitHandler) {
      provideSubmitHandler(onSubmit);
    }
  }, [provideSubmitHandler, onSubmit]);

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        {/* Claim Details Section */}
        <div className="form-section-container mb-4 bg-white p-4 rounded-3 shadow-sm">
          <Collapsible 
            title={
              <div className="section-header d-flex align-items-center">
                <FaFileAlt className="section-icon me-2" />
                <span>Details of Claim</span>
              </div>
            } 
            defaultOpen={true}
            iconColor="#269ccc"
          >
            <div className="container-fluid">
              <div className="row g-3 mb-4">
                {/* Claim Type Dropdown */}
                <div className="col-md-6">
                  <div className="form-group">
                    <label className="form-label">
                      <FaMoneyBillWave className="field-icon me-2" />
                      Select Claim Type <span className="required-asterisk">*</span>
                    </label>
                    <select
                      {...register("claimType", { required: "Claim type is required" })}
                      className={`form-control ${errors.claimType ? "is-invalid" : ""}`}
                      onChange={(e) => handleClaimTypeChange(e.target.value)}
                      value={selectedClaimType}
                    >
                      {claimTypeOptions.map((option) => (
                        <option key={option.value} value={option.value} disabled={option.disabled}>
                          {option.label}
                        </option>
                      ))}
                    </select>
                    {errors.claimType && <div className="invalid-feedback">{errors.claimType.message}</div>}
                  </div>
                </div>
              </div>

              {/* Claim Type Specific Fields */}
              {selectedClaimType && (
                <ClaimTypeFields
                  claimType={selectedClaimType}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  getValues={getValues}
                  watch={watch}
                  trigger={trigger}
                />
              )}

              <div className="row g-3 mt-3">
                {/* Details of How Debt Incurred */}
                <div className="col-md-12">
                  <div className="form-group">
                    <label className="form-label">
                      <FaFileAlt className="field-icon me-2" />
                      Details of how debt incurred <span className="required-asterisk">*</span>
                    </label>
                    <textarea
                      {...register("debtDetails", { required: "This field is required" })}
                      className={`form-control ${errors.debtDetails ? "is-invalid" : ""}`}
                      placeholder="Enter details of how debt was incurred"
                      rows={3}
                    />
                    {errors.debtDetails && <div className="invalid-feedback">{errors.debtDetails.message}</div>}
                  </div>
                </div>

                {/* Date of Debt Incurred */}
                <div className="col-md-6">
                  <div className="form-group">
                    <label className="form-label">
                      <FaCalendarAlt className="field-icon me-2" />
                      Date of debt incurred <span className="required-asterisk">*</span>
                    </label>
                    <input
                      {...register("debtDate", {
                        required: "This field is required",
                        validate: (value) => {
                          const today = new Date().toISOString().split("T")[0];
                          return value <= today || "Date cannot be in the future";
                        },
                      })}
                      type="date"
                      className={`form-control ${errors.debtDate ? "is-invalid" : ""}`}
                      placeholder="Select date"
                    />
                    {errors.debtDate && <div className="invalid-feedback">{errors.debtDate.message}</div>}
                  </div>
                </div>

                {/* Mutual Dealings */}
                <div className="col-md-12">
                  <div className="form-group">
                    <label className="form-label">
                      <FaHandshake className="field-icon me-2" />
                      Details of any mutual credit, mutual debts, or other mutual dealings
                    </label>
                    <textarea
                      {...register("mutualDetails")}
                      className="form-control"
                      placeholder="Enter details of any mutual dealings"
                      rows={3}
                    />
                  </div>
                </div>
              </div>
            </div>
          </Collapsible>
        </div>

        {/* Bank Account Details Section */}
        <div className="form-section-container mb-4 bg-white p-4 rounded-3 shadow-sm">
          <Collapsible 
            title={
              <div className="section-header d-flex align-items-center">
                <BsBank2 className="section-icon me-2" />
                <span>Bank Account Details</span>
              </div>
            } 
            defaultOpen={true}
            iconColor="#269ccc"
          >
            <div className="container-fluid">
              <div className="row g-3">
                {/* First row: Account Number and IFSC Code */}
                <div className="col-md-6">
                  <div className="form-group">
                    <label className="form-label">
                      <FaUniversity className="field-icon me-2" />
                      Account Number <span className="required-asterisk">*</span>
                    </label>
                    <input
                      {...register("accountNumber", { 
                        required: "Account number is required",
                        pattern: {
                          value: /^[0-9]{9,18}$/,
                          message: "Account number must be 9-18 digits"
                        }
                      })}
                      type="text"
                      className={`form-control ${errors.accountNumber ? "is-invalid" : ""}`}
                      placeholder="Enter account number"
                    />
                    {errors.accountNumber && <div className="invalid-feedback">{errors.accountNumber.message}</div>}
                  </div>
                </div>
                
                <div className="col-md-6">
                  <IFSCSearch
                    fieldConfig={{
                      name: "ifscCode",
                      label: "IFSC Code",
                      rules: { 
                        required: "IFSC code is required",
                        pattern: {
                          value: /^[A-Za-z]{4}0[A-Za-z0-9]{6}$/,
                          message: "Invalid IFSC code format (e.g., ABCD0123456)"
                        }
                      },
                      placeholder: "Enter IFSC code (e.g., ABCD0123456)",
                    }}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    trigger={trigger}
                  />
                </div>

                {/* Second row: Bank Name and Branch Name */}
                <div className="col-md-6">
                  <div className="form-group">
                    <label className="form-label">
                      <FaLandmark className="field-icon me-2" />
                      Bank Name <span className="required-asterisk">*</span>
                    </label>
                    <input
                      {...register("bankName", { required: "Bank name is required" })}
                      type="text"
                      className={`form-control ${errors.bankName ? "is-invalid" : ""}`}
                      placeholder="Enter bank name"
                    />
                    {errors.bankName && <div className="invalid-feedback">{errors.bankName.message}</div>}
                  </div>
                </div>
                
                <div className="col-md-6">
                  <div className="form-group">
                    <label className="form-label">
                      <BsBuilding className="field-icon me-2" />
                      Branch Name <span className="required-asterisk">*</span>
                    </label>
                    <input
                      {...register("branchName", { required: "Branch name is required" })}
                      type="text"
                      className={`form-control ${errors.branchName ? "is-invalid" : ""}`}
                      placeholder="Enter branch name"
                    />
                    {errors.branchName && <div className="invalid-feedback">{errors.branchName.message}</div>}
                  </div>
                </div>

                {/* Third row: Branch Address */}
                <div className="col-md-12">
                  <div className="form-group">
                    <label className="form-label">
                      <FaMapMarkerAlt className="field-icon me-2" />
                      Branch Address <span className="required-asterisk">*</span>
                    </label>
                    <input
                      {...register("branchAddress", { required: "Branch address is required" })}
                      type="text"
                      className={`form-control ${errors.branchAddress ? "is-invalid" : ""}`}
                      placeholder="Enter branch address"
                    />
                    {errors.branchAddress && <div className="invalid-feedback">{errors.branchAddress.message}</div>}
                  </div>
                </div>

                {/* Fourth row: City, State, District */}
                <div className="col-md-4">
                  <div className="form-group">
                    <label className="form-label">
                      <FaCity className="field-icon me-2" />
                      City <span className="required-asterisk">*</span>
                    </label>
                    <input
                      {...register("city", { required: "City is required" })}
                      type="text"
                      className={`form-control ${errors.city ? "is-invalid" : ""}`}
                      placeholder="Enter city"
                    />
                    {errors.city && <div className="invalid-feedback">{errors.city.message}</div>}
                  </div>
                </div>
                
                <div className="col-md-4">
                  <div className="form-group">
                    <label className="form-label">
                      <FaGlobeAmericas className="field-icon me-2" />
                      State <span className="required-asterisk">*</span>
                    </label>
                    <input
                      {...register("state", { required: "State is required" })}
                      type="text"
                      className={`form-control ${errors.state ? "is-invalid" : ""}`}
                      placeholder="Enter state"
                    />
                    {errors.state && <div className="invalid-feedback">{errors.state.message}</div>}
                  </div>
                </div>
                
                <div className="col-md-4">
                  <div className="form-group">
                    <label className="form-label">
                      <FaMapMarkerAlt className="field-icon me-2" />
                      District <span className="required-asterisk">*</span>
                    </label>
                    <input
                      {...register("district", { required: "District is required" })}
                      type="text"
                      className={`form-control ${errors.district ? "is-invalid" : ""}`}
                      placeholder="Enter district"
                    />
                    {errors.district && <div className="invalid-feedback">{errors.district.message}</div>}
                  </div>
                </div>
              </div>
            </div>
          </Collapsible>
        </div>
      </form>
    </FormProvider>
  );
};


/* Add these styles to your FormC.css file */

/* Form layout improvements */
.form-stepper {
  max-width: 100%;
}

.form-section-container {
  margin-bottom: 1.5rem;
  border-radius: 8px;
  overflow: hidden;
}

/* Form group styling */
.form-group {
  margin-bottom: 1.25rem;
  position: relative;
}

/* Label styling */
.form-label {
  display: flex;
  align-items: center;
  font-weight: 500;
  margin-bottom: 0.5rem;
  color: #495057;
}

/* Field icon styling */
.field-icon {
  color: #269ccc;
  font-size: 1rem;
  margin-right: 0.5rem;
}

.section-icon {
  color: #269ccc;
  font-size: 1.25rem;
}

/* Input styling */
.form-control {
  padding: 0.625rem 0.75rem;
  border: 1px solid #ced4da;
  border-radius: 6px;
  transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
  height: calc(2.5rem + 2px);
}

.form-control:focus {
  border-color: #269ccc;
  box-shadow: 0 0 0 0.2rem rgba(38, 156, 204, 0.25);
}

textarea.form-control {
  height: auto;
  min-height: 100px;
}

/* Required field indicator */
.required-asterisk {
  color: #dc3545;
  margin-left: 4px;
}

/* Radio button styling */
.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 0.5rem;
}

.radio-option {
  display: flex;
  align-items: center;
  cursor: pointer;
  margin-right: 1rem;
}

.radio-input {
  margin-right: 0.5rem;
}

/* Entity fields styling */
.entity-field-group {
  background-color: #f8f9fa;
  border: 1px solid #e9ecef;
  border-radius: 8px;
  padding: 1.25rem;
  margin-bottom: 1.25rem;
}

/* Add more button styling */
.add-more-btn {
  display: inline-flex;
  align-items: center;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  border-radius: 6px;
  margin-top: 0.5rem;
}

/* Tooltip styling */
.form-tooltip {
  display: inline-flex;
  margin-left: 0.5rem;
  color: #6c757d;
  cursor: help;
}

/* IFSC Search specific styling */
.loading-indicator {
  font-size: 0.875rem;
  color: #269ccc;
  margin-top: 0.25rem;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .col-md-4, .col-md-6 {
    margin-bottom: 1rem;
  }
  
  .radio-group {
    flex-direction: column;
    gap: 0.5rem;
  }
}

/* Consistent height for inputs */
.form-control, 
select.form-control,
input[type="date"].form-control {
  height: 42px;
}

/* Improve alignment of form elements */
.row.g-3 {
  margin-left: -0.75rem;
  margin-right: -0.75rem;
}

.row.g-3 > [class*="col-"] {
  padding-left: 0.75rem;
  padding-right: 0.75rem;
}

/* Improve validation feedback */
.invalid-feedback {
  display: block;
  font-size: 0.75rem;
  margin-top: 0.25rem;
}
