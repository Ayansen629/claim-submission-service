import React, { useState, useEffect } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams, useLocation, useNavigate } from "react-router-dom";
import Stepper from "../../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import Documents from "./Documents.js";
import PaymentDetails from "./PaymentDetails.js";
import { useForm } from "react-hook-form";
import Invoicing from "../../../common/Invoicing.js";
import PaymentModal from "../../../common/PaymentModal.js"; 
import ActionDropdown from "../../../common/ActionDropdown";
import ApprovalModal from "../../../common/ApprovalModal";
import NewVesselRegistrationSuccess from "./newVesselRegistrationSuccess.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import { toast } from "react-toastify";
import { Button, Offcanvas, Form, Card } from "react-bootstrap";
import { BsSticky, BsPlus, BsTrash, BsSave } from "react-icons/bs";

const NewVesselRegistration = () => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const { id } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  
  const isEditMode = !!id && location.pathname.includes('/edit/');
  const isViewMode = !!id && location.pathname.includes('/view/');
  const isNormalMode = !isEditMode && !isViewMode;
  
  const methods = useForm({ mode: "onTouched" });
  const { trigger, getValues, setError, setValue, reset } = methods;

  const [showModal, setShowModal] = useState(false);
  const [paymentMode, setPaymentMode] = useState("offline");
  const [challanFile, setChallanFile] = useState(null);
  const [isLoading, setIsLoading] = useState(false);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [showNoteSheet, setShowNoteSheet] = useState(false);
  const [notes, setNotes] = useState([
    { id: 1, title: "Initial Review", content: "Document verification completed", date: "2024-01-15", author: "John Doe" },
    { id: 2, title: "Technical Assessment", content: "All technical drawings approved", date: "2024-01-16", author: "Jane Smith" }
  ]);
  const [newNote, setNewNote] = useState({ title: "", content: "" });

  const actionsFromAPI = ["Approve", "Reject", "Request Changes"];

  const staticData = {
    ownerName: "John Doe",
    ownerAddress: "123 Main Street, Harbor City, State 12345",
    mobile: "9876543210",
    email: "john.doe@example.com",
    pan: "ABCDE1234F",
    aadhar: "123456789012",
    tradeLicence: "TL123456789",
    gst: "GST123456789012",
    grt: "500",
    workOrderValue: "1000000",
    vesselType: "new",
    category: "A",
    zone: "1",
    supervisionAuthority: "classificationSociety",
    purchaseType: "new",
    classificationSociety: "Lloyd's Register Classification Society",
    constructedBy: "2",
    builder: "builder1",
    builderName: "ABC Marine Shipyard Pvt Ltd",
    builderAddress: "456 Port Road, Shipyard Complex, Harbor City 54321",
    builderEmail: "contact@abcshipyard.com",
    builderMobile: "9876543211",
    builderTradeLicence: "BTL789012345",
    builderGST: "BGST987654321098",
    builderAuth: "auth",
    termsAccepted: true,
    
    // Work Order Files (50 files)
    ...Array.from({ length: 50 }, (_, i) => ({
      [`workOrder_file_${i + 1}`]: { 
        name: `WorkOrder_${String(i + 1).padStart(2, '0')}.pdf`, 
        size: Math.floor(Math.random() * 2000000) + 500000 
      },
      [`workOrder_desc_${i + 1}`]: `Work order document ${i + 1} - ${[
        'Main contract document',
        'Amendment and modifications',
        'Technical specifications',
        'Timeline and milestones',
        'Budget breakdown',
        'Quality requirements',
        'Safety protocols',
        'Environmental compliance',
        'Material specifications',
        'Equipment details'
      ][i % 10]}`
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    
    // Drawing Files (50 files)
    ...Array.from({ length: 50 }, (_, i) => ({
      [`drawings_file_${i + 1}`]: { 
        name: `Drawing_${String(i + 1).padStart(2, '0')}.pdf`, 
        size: Math.floor(Math.random() * 3000000) + 800000 
      },
      [`drawings_desc_${i + 1}`]: `Technical drawing ${i + 1} - ${[
        'General arrangement plan',
        'Hull structure details',
        'Machinery layout',
        'Electrical schematic',
        'Piping diagram',
        'Safety equipment layout',
        'Navigation equipment',
        'Interior arrangement',
        'Deck plan',
        'Cross-section view'
      ][i % 10]}`
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    
    tonnageBooklets: { name: "Tonnage_Booklets.pdf", size: 512000 },
    stabilityBooklets: { name: "Stability_Booklets.pdf", size: 768000 },
    authLetter: { name: "Authorization_Letter.pdf", size: 256000 }
  };

  useEffect(() => {
    if (isNormalMode) {
      reset();
    } else if (isEditMode || isViewMode) {
      setTimeout(() => {
        Object.keys(staticData).forEach(key => {
          setValue(key, staticData[key]);
        });
      }, 100);
    }
  }, [isEditMode, isViewMode, isNormalMode, setValue, reset, location.pathname]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      comments: formData.comments,
    };
    
    console.log("Action submitted:", payload);
    toast.success(`${selectedAction} action submitted successfully`);
    
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleChallanUpload = (e) => {
    setChallanFile(e.target.files?.[0] || null);
  };

  const handleOnlinePay = () => {
    setIsLoading(true);
    setShowModal(false);
   
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  const handleOfflineSubmit = () => {
    setShowModal(false);
    setIsLoading(true);
    
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  const handlePayNow = () => {
    setShowModal(true);
  };

  const addNote = () => {
    if (newNote.title.trim() && newNote.content.trim()) {
      const note = {
        id: Date.now(),
        title: newNote.title,
        content: newNote.content,
        date: new Date().toISOString().split('T')[0],
        author: "Current User"
      };
      setNotes([note, ...notes]);
      setNewNote({ title: "", content: "" });
      toast.success(t("Note added successfully"));
    }
  };

  const deleteNote = (id) => {
    setNotes(notes.filter(note => note.id !== id));
    toast.success(t("Note deleted successfully"));
  };

  // Validation functions
  const validateVesselDetails = async () => {
    if (isViewMode) return true;
    const basicFields = [
      "ownerName", "ownerAddress", "mobile", "email", "pan", 
      "aadhar", "tradeLicence", "gst", "grt", "workOrderValue",
      "vesselType", "category", "purchaseType", "constructedBy"
    ];
    
    const constructedBy = getValues("constructedBy");
    if (constructedBy === "2") {
      basicFields.push(
        "builderName", "builderAddress", "builderEmail", 
        "builderMobile", "builderTradeLicence", "builderGST", 
        "builderAuth"
      );
      
      const authLetter = getValues("authLetter");
      if (!authLetter && !isEditMode) {
        basicFields.push("authLetter");
      }
    }
    
    const valid = await trigger(basicFields);
    return valid;
  };

  const validateDocuments = async () => {
    if (isViewMode) return true;
    
    const requiredFields = [];
    
    const tonnageBooklets = getValues("tonnageBooklets");
    const stabilityBooklets = getValues("stabilityBooklets");
    const termsAccepted = getValues("termsAccepted");
    
    if (!tonnageBooklets && !isEditMode) {
      requiredFields.push('tonnageBooklets');
    }
    
    if (!stabilityBooklets && !isEditMode) {
      requiredFields.push('stabilityBooklets');
    }
    
    if (!termsAccepted) {
      requiredFields.push('termsAccepted');
    }
    
    let hasErrors = false;
    
    requiredFields.forEach(fieldName => {
      const fieldValue = getValues(fieldName);
      
      if (!fieldValue || (fieldValue instanceof FileList && fieldValue.length === 0)) {
        setError(fieldName, {
          type: 'required',
          message: `${fieldName} is required`
        });
        hasErrors = true;
      }
    });
    
    return !hasErrors;
  };

  const supervisionAuthority = methods.watch("supervisionAuthority");

  const steps = isViewMode ? [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateDocuments,
    },
    {
      label: t("Payment Details"),
      component: <PaymentDetails supervisionAuthority={supervisionAuthority} formData={methods.getValues()} />,
      validate: () => true,
    }
  ] : [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateDocuments,
    },
    {
      label: t("Invoicing"),
      component: (
        <Invoicing
          supervisionAuthority={supervisionAuthority}
          onPayNow={handlePayNow}
        />
      ),
      validate: () => true,
    },
  ];

  const handleSave = () => {
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  const actionDropdown = isViewMode ? (
    <ActionDropdown
      actions={actionsFromAPI}
      onActionClick={handleActionClick}
      variant="contained"
      sx={{
        backgroundColor: "#2E57A7",
        fontWeight: "bold",
        borderRadius: "0.5rem",
        minWidth: "8rem",
        fontSize: "0.9rem",
        color: "#fff",
        "&:hover": {
          backgroundColor: "#1f4ea0",
        },
      }}
    />
  ) : null;

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {isLoading ? (
        <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
          <div className="text-center">
            <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
              <span className="visually-hidden">Loading...</span>
            </div>
            <p className="mt-3">Processing your request...</p>
          </div>
        </div>
      ) : (
        <>
          <Stack spacing={0.5}>
            <Typography
              sx={{
                fontWeight: 550,
                color: "#2E57A7",
                fontSize: "1.2rem",
              }}
            >
             {isViewMode ? t("View Vessel Registration") + ` - ${id}` : 
              isEditMode ? t("Edit Vessel Registration") + ` - ${id}` : t("New Vessel Registration")}
              &nbsp;
              <span style={{ color: "#666", fontSize: "0.65rem" }}>
                {isViewMode ? t("(View vessel registration details)") :
                 isEditMode ? t("(Update vessel registration details)") : t("(Fill in the vessel details to complete registration)")}
              </span>
            </Typography>
          </Stack>
          
          <Stepper 
            steps={steps} 
            onSave={handleSave} 
            viewMode={isViewMode}
            actionComponent={actionDropdown}
            onPayNow={handlePayNow}
          />

          {/* Floating Note Sheet Button - Only for View Mode */}
          {isViewMode && (
            <Button
              variant="primary"
              className="position-fixed rounded-circle shadow-lg"
              style={{
                bottom: "30px",
                right: "30px",
                width: "60px",
                height: "60px",
                zIndex: 1000,
                background: "linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%)",
                border: "none"
              }}
              onClick={() => setShowNoteSheet(true)}
            >
              <BsSticky size={24} />
            </Button>
          )}

          {/* Note Sheet Offcanvas */}
          <Offcanvas 
            show={showNoteSheet} 
            onHide={() => setShowNoteSheet(false)} 
            placement="start"
            style={{ width: "400px" }}
          >
            <Offcanvas.Header closeButton className="bg-primary text-white">
              <Offcanvas.Title className="fw-bold">
                <BsSticky className="me-2" />
                {t("Note Sheet")}
              </Offcanvas.Title>
            </Offcanvas.Header>
            <Offcanvas.Body className="p-0">
              {/* Add New Note Section */}
              <div className="p-3 border-bottom bg-light">
                <h6 className="fw-bold mb-3">{t("Add New Note")}</h6>
                <Form.Group className="mb-2">
                  <Form.Control
                    type="text"
                    placeholder={t("Note title...")}
                    value={newNote.title}
                    onChange={(e) => setNewNote({...newNote, title: e.target.value})}
                    size="sm"
                  />
                </Form.Group>
                <Form.Group className="mb-3">
                  <Form.Control
                    as="textarea"
                    rows={3}
                    placeholder={t("Write your note here...")}
                    value={newNote.content}
                    onChange={(e) => setNewNote({...newNote, content: e.target.value})}
                    size="sm"
                  />
                </Form.Group>
                <Button 
                  variant="primary" 
                  size="sm" 
                  onClick={addNote}
                  disabled={!newNote.title.trim() || !newNote.content.trim()}
                  className="w-100"
                >
                  <BsPlus className="me-1" />
                  {t("Add Note")}
                </Button>
              </div>

              {/* Notes List */}
              <div className="p-3" style={{ maxHeight: "calc(100vh - 300px)", overflowY: "auto" }}>
                <h6 className="fw-bold mb-3">{t("Notes")} ({notes.length})</h6>
                {notes.length === 0 ? (
                  <div className="text-center text-muted py-4">
                    <BsSticky size={48} className="opacity-25 mb-2" />
                    <p className="mb-0">{t("No notes yet")}</p>
                  </div>
                ) : (
                  notes.map((note) => (
                    <Card key={note.id} className="mb-3 shadow-sm">
                      <Card.Body className="p-3">
                        <div className="d-flex justify-content-between align-items-start mb-2">
                          <h6 className="fw-bold mb-0 text-primary" style={{ fontSize: "0.9rem" }}>
                            {note.title}
                          </h6>
                          <Button
                            variant="outline-danger"
                            size="sm"
                            onClick={() => deleteNote(note.id)}
                            className="rounded-circle p-1"
                            style={{ width: "24px", height: "24px" }}
                          >
                            <BsTrash size={10} />
                          </Button>
                        </div>
                        <p className="mb-2 text-dark" style={{ fontSize: "0.85rem" }}>
                          {note.content}
                        </p>
                        <div className="d-flex justify-content-between align-items-center">
                          <small className="text-muted">{note.author}</small>
                          <small className="text-muted">{note.date}</small>
                        </div>
                      </Card.Body>
                    </Card>
                  ))
                )}
              </div>
            </Offcanvas.Body>
          </Offcanvas>
          
          {!isViewMode && (
            <PaymentModal
              show={showModal}
              onHide={() => setShowModal(false)}
              paymentMode={paymentMode}
              setPaymentMode={setPaymentMode}
              challanFile={challanFile}
              onChallanUpload={handleChallanUpload}
              onOnlinePay={handleOnlinePay}
              onOfflineSubmit={handleOfflineSubmit}
              isLoading={isLoading}
              formMethods={methods}
            />
          )}
          
          {isViewMode && (
            <ApprovalModal
              show={showApprovalModal}
              handleClose={handleCloseModal}
              handleSubmitData={handleActionSubmit}
              selectedAction={selectedAction}
            />
          )}
        </>
      )}
    </Box>
  );
};

export default NewVesselRegistration;
