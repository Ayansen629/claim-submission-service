import React, { useState, useEffect } from "react";
import WelcomeBox from "../../../common/WelcomeBox.js";
import { Card, Form, InputGroup, Button, Row, Col } from "react-bootstrap";
import { BsSearch, BsFilter } from "react-icons/bs";
import ActionTable from "../../../common/ActionTable.tsx";
import { useNavigate } from "react-router-dom";
import UserRegFilter from "./userRegFilter.js"; // Our new filter component
import { headerStyle } from "../../../../utils/constants.ts";

const INBOX_COLUMNS = [
  {
    colName: "Application No",
    fieldName: "appNo",
    clsName: "column-text-start",
  },
  {
    colName: "Application Type",
    fieldName: "appType",
    clsName: "column-text-start",
  },
  {
    colName: "Phone No",
    fieldName: "phoneNumber",
    clsName: "column-text-start",
  },
  {
    colName: "State",
    fieldName: "stateUt",
    clsName: "column-text-start",
  },
  {
    colName: "District",
    fieldName: "district",
    clsName: "column-text-start",
  },
  {
    colName: "Date of Submission",
    fieldName: "date",
    clsName: "column-text-start",
  },
  {
    colName: "Status",
    fieldName: "status",
    clsName: "column-text-start",
    render: (value) => (
      <span className={`status-badge ${value.toLowerCase()}`}>{value}</span>
    ),
  },
  {
    colName: "Action",
    fieldName: "action",
    actions: ['view'],
    clsName: "col-sm-2 column-text-start actions-column",
  },
];

const UserRegDashboard = () => {
  const navigate = useNavigate();
  const [inboxData, setInboxData] = useState([]);
  const [filteredData, setFilteredData] = useState([]);
  const [currentPage, setCurrentPage] = useState(1);
  const [searchTerm, setSearchTerm] = useState("");
  const [filters, setFilters] = useState({});
  const itemsPerPage = 5;


  const generateInboxData = () => {
    const statuses = ["Pending", "Completed", "Processing", "Rejected"];
    const states = ["West Bengal", "Kerala", "Tamil Nadu", "Gujarat", "Maharashtra"];
    const districts = ["Kolkata", "Howrah", "North 24 Parganas", "South 24 Parganas", "Hooghly"];
    const phoneNumbers = ["9876543210", "8765432109", "7654321098", "6543210987", "9432109876"];

    return Array.from({ length: 20 }, (_, i) => ({
      id: i + 1,
      appNo: `APP-2025-${(i + 1).toString().padStart(3, "0")}`,
      appType: i % 2 === 0 ? "Ship Builder" : "Vessel Owner",
      phoneNumber: phoneNumbers[i % 5],
      stateUt: states[i % 5],
      district: districts[i % 5],
      date: new Date(
        2025,
        Math.floor(Math.random() * 12),
        Math.floor(Math.random() * 28) + 1
      )
        .toISOString()
        .split("T")[0],
      status: statuses[Math.floor(Math.random() * statuses.length)],
    }));
  };

 
  useEffect(() => {
    const data = generateInboxData();
    setInboxData(data);
    setFilteredData(data);
  }, []);

  useEffect(() => {
    const results = inboxData.filter(
      (item) =>
        item.appNo.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.appType.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.phoneNumber.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.stateUt.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.district.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.status.toLowerCase().includes(searchTerm.toLowerCase())
    );
    setFilteredData(results);
    setCurrentPage(1);
  }, [searchTerm, inboxData]);

 
  const applyFilters = (filterData) => {
    setFilters(filterData);
    
    let results = inboxData;
    
   
    if (filterData.applicationNumber) {
      results = results.filter(item =>
        item.appNo.toLowerCase().includes(filterData.applicationNumber.toLowerCase())
      );
    }
    
    if (filterData.applicationType) {
      results = results.filter(item =>
        item.appType.toLowerCase().replace(/\s+/g, '_') === filterData.applicationType.toLowerCase()
      );
    }
    
    if (filterData.applicationStatus) {
      results = results.filter(item =>
        item.status.toLowerCase() === filterData.applicationStatus.toLowerCase()
      );
    }
    
    if (filterData.phoneNumber) {
      results = results.filter(item =>
        item.phoneNumber.includes(filterData.phoneNumber)
      );
    }
    
    if (filterData.fromDate && filterData.toDate) {
      results = results.filter(item => {
        const itemDate = new Date(item.date);
        const fromDate = new Date(filterData.fromDate);
        const toDate = new Date(filterData.toDate);
        return itemDate >= fromDate && itemDate <= toDate;
      });
    }
    
    setFilteredData(results);
    setCurrentPage(1);
  };

  const handleTablePageChange = (page) => {
    setCurrentPage(page);
  };

  const handleOnViewRow = (rowData) => {
    navigate('/user-dashboard/owner/123', {
      state: { application: rowData },
    });
  };


  return (
    <>
   
      
      {/* Filter Component */}
      <UserRegFilter onFilterSubmit={applyFilters} handleGoBack={()=> navigate('/dashboard')} />
      
      {/* Inbox Table */}
      <Card className="bg-transparent mt-4 dashboard-card">
        <Card.Header
          style={headerStyle}
          className="dashboard-card-header d-flex justify-content-between align-items-center flex-wrap"
        >
          <div className="d-flex align-items-center">
            <h5 className="mb-0 me-2">Inbox</h5>
            <span className="badge bg-primary rounded-pill">
              {filteredData.length}
            </span>
          </div>
          <div className="d-flex align-items-center">
            <Button variant="outline-secondary" className="filter-btn me-2">
              <BsFilter size={18} />
              <span className="ms-1 d-none d-sm-inline">Filter</span>
            </Button>
            <Form className="inbox-search">
              <InputGroup>
                <Form.Control
                  type="text"
                  placeholder="Search inbox..."
                  aria-label="Search inbox"
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                />
                <Button variant="primary">
                  <BsSearch />
                </Button>
              </InputGroup>
            </Form>
          </div>
        </Card.Header>
        <div style={{ position: 'relative', bottom: '2rem' }}>
          <ActionTable
            columns={INBOX_COLUMNS}
            rowData={filteredData}
            tableHeader={null}
            hideExportBtn={true}
            hideSearchBar={true}
            pagination={true}
            currentPage={currentPage}
            itemsPerPage={itemsPerPage}
            onPageChange={handleTablePageChange}
            onViewRow={handleOnViewRow}
            noDataText={
              <div className="no-results text-center py-4">
                <BsSearch size={24} className="mb-2" />
                <p>No results found</p>
                <small>
                  Try adjusting your search to find what you're looking for.
                </small>
              </div>
            }
          />
        </div>
      </Card>
    </>
  );
};

export default UserRegDashboard;
