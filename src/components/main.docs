import React, { useCallback, useState, useEffect } from "react";
import { useForm, FormProvider, Controller } from "react-hook-form";
import DatePicker from "react-datepicker";
import "react-datepicker/dist/react-datepicker.css";
import Collapsible from "../formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip";
import { FaInfoCircle } from "react-icons/fa";
import { uploadDocument } from "../../../../services/documentUploadService";
import { Button } from 'react-bootstrap';
import { Download, Upload, CheckCircle, File } from "lucide-react";
import 'bootstrap/dist/css/bootstrap.min.css';

// Dynamic field renderer
const DynamicField = ({ fieldConfig, control, register, errors, setValue, trigger, getValues, watch }) => {
  const { name, label, type, options, rules, tooltip, placeholder, accept } = fieldConfig;
  const userFormData = JSON.parse(localStorage.getItem("userFormData"));
  const hasUserType = userFormData?.userType;
  const hasError = errors[name];

  const handleKeyPress = (e) => {
    if (type === "number" && !/^\d$/.test(e.key) && e.key !== "Backspace") {
      e.preventDefault();
    }
  };

  const handleFileChange = async (e) => {
    const file = e.target.files[0];
    if (file && fieldConfig.onFileUpload) {
      try {
        fieldConfig.setIsUploading(true);
        fieldConfig.setUploadError(null);
        fieldConfig.setUploadSuccess(false);
        
        const result = await fieldConfig.onFileUpload(file);
        
        if (result.success) {
          setValue(name, {
            fileId: result.fileId,
            docName: result.docName,
            docType: result.docType,
            docSource: result.docSource,
            fileUrl: result.fileUrl
          }, { shouldValidate: true });
          fieldConfig.setUploadSuccess(true);
          fieldConfig.setUploadedFileUrl(`${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${result.fileId}`);
        }
      } catch (error) {
        fieldConfig.setUploadError(error.message);
        setValue(name, null, { shouldValidate: true });
        fieldConfig.setUploadSuccess(false);
      } finally {
        fieldConfig.setIsUploading(false);
      }
    }
  };

  return (
    <div className="flex-item">
      <label>
        {label}
        {tooltip && (
          <Tooltip title={tooltip} arrow>
            <span style={{ marginLeft: "5px", cursor: "pointer" }}>
              <FaInfoCircle />
            </span>
          </Tooltip>
        )}
      </label>
      
      {type === "select" ? (
        <Controller
          name={name}
          control={control}
          rules={rules}
          render={({ field }) => (
            <select
              {...field}
              className={`form-input ${hasError ? "input-error" : ""}`}
              onChange={(e) => {
                field.onChange(e);
                if (fieldConfig.onChange) fieldConfig.onChange(e.target.value);
              }}
            >
              <option value="" disabled>
                {placeholder || `Select ${label}`}
              </option>
              {options.map((option) => (
                <option key={option.value} value={option.value}>
                  {option.label}
                </option>
              ))}
            </select>
          )}
        />
      ) : type === "date" ? (
        <Controller
          name={name}
          control={control}
          rules={rules}
          render={({ field }) => (
            <DatePicker
              {...field}
              selected={field.value}
              onChange={(date) => {
                setValue(name, date);
                trigger(name);
              }}
              className={`form-input ${hasError ? "input-error" : ""}`}
              dateFormat="yyyy-MM-dd"
              placeholderText={placeholder || "Select a date"}
            />
          )}
        />
      ) : type === "file" ? (
        <div className="file-upload-container">
          <div className="d-flex align-items-center gap-2">
            <input
              type="file"
              id={name}
              onChange={handleFileChange}
              className={`form-input ${hasError ? "input-error" : ""}`}
              style={{ display: "none" }}
              disabled={fieldConfig.isUploading}
              accept={fieldConfig.accept}
            />
            <label
              htmlFor={name}
              className={`file-label ${hasError ? "input-error" : ""} ${fieldConfig.isUploading ? "uploading" : ""}`}
            >
              {fieldConfig.isUploading ? (
                <span className="d-flex align-items-center gap-1">
                  <span className="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                  Uploading...
                </span>
              ) : (
                <span className="d-flex align-items-center gap-1">
                  <Upload size={16} />
                  Choose File
                </span>
              )}
            </label>
            
            {fieldConfig.uploadSuccess && (
              <span className="text-success d-flex align-items-center gap-1">
                <CheckCircle size={16} />
                <span>Uploaded</span>
              </span>
            )}
          </div>

          {getValues(name) && (
            <div className="file-info mt-2">
              <div className="d-flex align-items-center gap-2">
                <File size={16} />
                <span>
                  {(() => {
                    const fileValue = getValues(name);
                    if (typeof fileValue === 'object' && fileValue !== null) {
                      return fileValue.docName || fileValue.name || 'Uploaded file';
                    }
                    if (typeof fileValue === 'string') {
                      return fileValue;
                    }
                    return 'Uploaded file';
                  })()}
                </span>
              </div>
              
              {fieldConfig.uploadedFileUrl && (
                <Button
                  variant="link"
                  size="sm"
                  className="mt-1 p-0 download-btn"
                  href={fieldConfig.uploadedFileUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  download
                >
                  <span className="d-flex align-items-center gap-1">
                    <Download size={14} />
                    Download
                  </span>
                </Button>
              )}
            </div>
          )}
          
          {fieldConfig.uploadError && (
            <div className="error-message mt-1">
              {fieldConfig.uploadError}
            </div>
          )}
          {hasError && !fieldConfig.uploadError && (
            <div className="error-message mt-1">
              {errors[name]?.message}
            </div>
          )}
        </div>
      ) : type === "multifile" ? (
        <input
          type="file"
          multiple
          onChange={handleFileChange}
          className={`form-input ${hasError ? "input-error" : ""}`}
          placeholder={placeholder || "Upload multiple files"}
        />
      ) : (
        <input
          {...register(name, rules)}
          type={type}
          className={`form-input ${hasError ? "input-error" : ""}`}
          onChange={(e) => {
            setValue(name, e.target.value);
            trigger(name);
          }}
          onKeyPress={handleKeyPress}
          placeholder={placeholder || `Enter ${label.toLowerCase()}`}
        />
      )}
    </div>
  );
};

const FormCDetails = ({ provideSubmitHandler, formData }) => {
  const [isUploading, setIsUploading] = useState(false);
  const [uploadError, setUploadError] = useState(null);
  const [uploadSuccess, setUploadSuccess] = useState(false);
  const [uploadedFileUrl, setUploadedFileUrl] = useState(null);

  const methods = useForm();
  const { register, handleSubmit, formState: { errors }, trigger, clearErrors, setValue, control, getValues, watch } = methods;

  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    if (!isValid) {
      console.error("Validation failed");
      return false;
    }
    return getValues();
  }, [trigger, getValues]);

  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        setValue(key, formData[key]);
      });
    }
  }, [formData, setValue]);

  const handleFileUpload = async (file) => {
    try {
      setIsUploading(true);
      setUploadError(null);
      setUploadSuccess(false);
      
      const result = await uploadDocument(file, 'addressProofDocument');
      if (result.success) {
        setUploadSuccess(true);
        setUploadedFileUrl(`${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${result.fileId}`);
      }
      return result;
    } catch (error) {
      setUploadError(error.message);
      throw error;
    } finally {
      setIsUploading(false);
    }
  };

  useEffect(() => {
    if (provideSubmitHandler) {
      provideSubmitHandler(onSubmit);
    }
  }, [provideSubmitHandler, onSubmit]);

  // Field configurations for each section (same as before)
  const claimDetailsSchema = [
    // ... (your existing schema definitions)
    {
      name: "addressProofDocument",
      label: <>Address Proof Document <span className="required-asterisk">*</span></>,
      type: "file",
      rules: { 
        required: "Address proof document is required",
        validate: {
          fileUploaded: (value) => value !== null || "Please upload the document"
        }
      },
      tooltip: "Upload a clear scan of your address proof document",
      accept: "image/*,.pdf",
      onFileUpload: handleFileUpload,
      isUploading,
      uploadError,
      uploadSuccess,
      uploadedFileUrl,
      setIsUploading,
      setUploadError,
      setUploadSuccess,
      setUploadedFileUrl
    },
    // ... (rest of your schema)
  ];

  // ... (rest of your component remains the same)

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        {/* Sections with improved file upload handling */}
        <div className="mb-4 bg-light">
          <Tooltip title="Details of claim..." arrow>
            <div>
              <Collapsible title="Details of claim: corporate debtor as principal borrower">
                <div className="flex-container">
                  {claimDetailsSchema.map((fieldConfig) => (
                    <DynamicField
                      key={fieldConfig.name}
                      fieldConfig={fieldConfig}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      trigger={trigger}
                      getValues={getValues}
                      watch={watch}
                    />
                  ))}
                </div>
              </Collapsible>
            </div>
          </Tooltip>
        </div>
        {/* ... other sections */}
      </form>
    </FormProvider>
  );
};

export default FormCDetails;


/* File Upload Styles */
.file-upload-container {
  margin-bottom: 1rem;
}

.file-label {
  display: inline-block;
  padding: 0.375rem 0.75rem;
  background-color: #f8f9fa;
  border: 1px solid #ced4da;
  border-radius: 0.25rem;
  cursor: pointer;
  transition: all 0.2s;
}

.file-label:hover {
  background-color: #e9ecef;
}

.file-label.uploading {
  background-color: #e9ecef;
  cursor: not-allowed;
}

.file-label.input-error {
  border-color: #dc3545;
}

.file-info {
  background-color: #f8f9fa;
  padding: 0.5rem;
  border-radius: 0.25rem;
  border: 1px solid #dee2e6;
}

.download-btn {
  color: #0d6efd;
  text-decoration: none;
}

.download-btn:hover {
  text-decoration: underline;
}

/* Spinner for upload */
.spinner-border {
  display: inline-block;
  width: 1rem;
  height: 1rem;
  vertical-align: text-bottom;
  border: 0.15em solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: spinner-border 0.75s linear infinite;
}

@keyframes spinner-border {
  to { transform: rotate(360deg); }
}

/* Error message styling */
.error-message {
  color: #dc3545;
  font-size: 0.875rem;
  margin-top: 0.25rem;
}
