import React from "react";
import { Card, Row, Col, Table, Badge, Button } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { BsCheckCircleFill, BsClock, BsXCircleFill, BsDownload } from "react-icons/bs";
import ActionTable from "../../../common/ActionTable.tsx";

const PaymentDetailsView = ({ supervisionAuthority, formData }) => {
  const { t } = useTranslation();

  const paymentData = {
    invoiceNumber: "INV-2024-001",
    invoiceDate: "2024-01-15",
    dueDate: "2024-01-30",
    totalAmount: 590,
    paidAmount: 590,
    status: "paid", 
    paymentMethod: "offline",
    transactionId: "TXN123456789",
    paymentDate: "2024-01-16",
    challanNumber: "CH-2024-001"
  };

  // Payment table data
  const paymentTableData = [
    {
      id: 1,
      paymentId: "PAY-2024-001",
      status: "Paid",
      paymentDate: "2024-01-16",
      receipt: "receipt_001.pdf"
    },
    {
      id: 2,
      paymentId: "PAY-2024-002", 
      status: "Pending",
      paymentDate: "2024-01-20",
      receipt: "receipt_002.pdf"
    }
  ];

  // Payment table columns
  const paymentColumns = [
    {
      colName: t("Payment ID"),
      fieldName: "paymentId",
      clsName: "column-text-start",
    },
    {
      colName: t("Status"),
      fieldName: "status",
      clsName: "column-text-start",
      render: (value) => getStatusBadge(value.toLowerCase())
    },
    {
      colName: t("Payment Date"),
      fieldName: "paymentDate",
      clsName: "column-text-start",
    },
    {
      colName: t("Receipt"),
      fieldName: "receipt",
      clsName: "column-text-start",
      render: (value, row) => (
        <Button
          variant="outline-primary"
          size="sm"
          onClick={() => handleDownloadReceipt(value)}
          className="d-flex align-items-center"
        >
          <BsDownload size={14} className="me-1" />
          {t("Download")}
        </Button>
      )
    }
  ];

  const handleDownloadReceipt = (fileName) => {
    // Mock download functionality
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
    console.log(`Downloading: ${fileName}`);
  };

  const getStatusBadge = (status) => {
    switch (status) {
      case 'paid':
        return <Badge bg="success" className="d-flex align-items-center gap-1">
          <BsCheckCircleFill size={12} /> {t("Paid")}
        </Badge>;
      case 'pending':
        return <Badge bg="warning" className="d-flex align-items-center gap-1">
          <BsClock size={12} /> {t("Pending")}
        </Badge>;
      case 'failed':
        return <Badge bg="danger" className="d-flex align-items-center gap-1">
          <BsXCircleFill size={12} /> {t("Failed")}
        </Badge>;
      default:
        return <Badge bg="secondary">{t("Unknown")}</Badge>;
    }
  };

  const calculateFees = () => {
    const workOrderValue = parseFloat(formData?.workOrderValue || 1000000);
    
    if (supervisionAuthority === "iwt") {
      const drawingFee = Math.max(workOrderValue * 0.001, 500);
      let supervisionFee;
      
      if (workOrderValue <= 1000000) {
        supervisionFee = Math.max(workOrderValue * 0.01, 1000);
      } else if (workOrderValue <= 4000000) {
        supervisionFee = 10000 + (workOrderValue - 1000000) * 0.005;
      } else {
        supervisionFee = 25000 + (workOrderValue - 4000000) * 0.0025;
      }
      
      return {
        drawingFee: drawingFee,
        supervisionFee: supervisionFee,
        total: drawingFee + supervisionFee
      };
    } else {
      const drawingFee = Math.max(workOrderValue * 0.0005, 500);
      return {
        drawingFee: drawingFee,
        supervisionFee: 0,
        total: drawingFee
      };
    }
  };

  const fees = calculateFees();

  return (
    <div className="container py-4">
      <Row className="g-4">
        {/* Payment Summary Card */}
        <Col lg={6}>
          <Card className="h-100 shadow-sm border-0">
            <Card.Header 
              className="text-white py-3"
              style={{ background: "linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%)" }}
            >
              <h5 className="mb-0 fw-bold text-white">{t("Payment Summary")}</h5>
            </Card.Header>
            <Card.Body className="p-4">
              <div className="mb-3 d-flex justify-content-between align-items-center">
                <span className="fw-semibold">{t("Invoice Number")}:</span>
                <span className="text-primary fw-bold">{paymentData.invoiceNumber}</span>
              </div>
              
              <div className="mb-3 d-flex justify-content-between align-items-center">
                <span className="fw-semibold">{t("Invoice Date")}:</span>
                <span>{paymentData.invoiceDate}</span>
              </div>
              
              <div className="mb-3 d-flex justify-content-between align-items-center">
                <span className="fw-semibold">{t("Status")}:</span>
                {getStatusBadge(paymentData.status)}
              </div>
              
              <hr />
              
              <div className="mb-2 d-flex justify-content-between">
                <span>{supervisionAuthority === "iwt" ? t("Drawing Approval Fee") : t("Drawing Scrutiny Fee")}:</span>
                <span>₹{fees.drawingFee.toFixed(2)}</span>
              </div>
              
              {supervisionAuthority === "iwt" && (
                <div className="mb-2 d-flex justify-content-between">
                  <span>{t("Supervision Fee")}:</span>
                  <span>₹{fees.supervisionFee.toFixed(2)}</span>
                </div>
              )}
              
              <hr />
              
              <div className="d-flex justify-content-between align-items-center">
                <span className="fw-bold fs-5">{t("Total Amount")}:</span>
                <span className="fw-bold fs-5 text-success">₹{fees.total.toFixed(2)}</span>
              </div>
            </Card.Body>
          </Card>
        </Col>

        {/* Payment Details Card */}
        <Col lg={6}>
          <Card className="h-100 shadow-sm border-0">
            <Card.Header 
              className="text-white py-3"
              style={{ background: "linear-gradient(135deg, #28a745 0%, #20c997 100%)" }}
            >
              <h5 className="mb-0 fw-bold text-white">{t("Payment Details")}</h5>
            </Card.Header>
            <Card.Body className="p-4">
              <div className="mb-3">
                <label className="fw-semibold text-muted small">{t("Payment Method")}</label>
                <div className="mt-1">
                  <Badge bg="info" className="px-3 py-2">
                    {paymentData.paymentMethod === 'offline' ? t("Offline Payment") : t("Online Payment")}
                  </Badge>
                </div>
              </div>

              {paymentData.paymentMethod === 'offline' && (
                <div className="mb-3">
                  <label className="fw-semibold text-muted small">{t("Challan Number")}</label>
                  <div className="mt-1 p-2 bg-light rounded">
                    <span className="fw-medium">{paymentData.challanNumber}</span>
                  </div>
                </div>
              )}

              <div className="mb-3">
                <label className="fw-semibold text-muted small">{t("Transaction ID")}</label>
                <div className="mt-1 p-2 bg-light rounded">
                  <span className="fw-medium font-monospace">{paymentData.transactionId}</span>
                </div>
              </div>

              <div className="mb-3">
                <label className="fw-semibold text-muted small">{t("Payment Date")}</label>
                <div className="mt-1 p-2 bg-light rounded">
                  <span className="fw-medium">{paymentData.paymentDate}</span>
                </div>
              </div>

              <div className="mb-3">
                <label className="fw-semibold text-muted small">{t("Amount Paid")}</label>
                <div className="mt-1 p-3 bg-success bg-opacity-10 rounded border border-success border-opacity-25">
                  <span className="fw-bold text-success fs-5">₹{paymentData.paidAmount.toFixed(2)}</span>
                </div>
              </div>
            </Card.Body>
          </Card>
        </Col>

        {/* Payment History Table */}
        <Col lg={12}>
          <Card className="shadow-sm border-0">
            <Card.Header 
              className="py-3"
              style={{ background: "linear-gradient(135deg, #6f42c1 0%, #e83e8c 100%)" }}
            >
              <h5 className="mb-0 fw-bold text-white">{t("Payment History")}</h5>
            </Card.Header>
            <Card.Body className="p-0">
              <ActionTable
                columns={paymentColumns}
                rowData={paymentTableData}
                tableHeader={null}
                hideExportBtn={true}
                hideSearchBar={true}
                pagination={false}
                noDataText={
                  <div className="text-center py-4 text-muted">
                    <p className="mb-0">{t("No payment records found")}</p>
                  </div>
                }
              />
            </Card.Body>
          </Card>
        </Col>

        {/* Fee Breakdown Table */}
        <Col lg={12}>
          <Card className="shadow-sm border-0">
            <Card.Header 
              className="py-3"
              style={{ background: "linear-gradient(135deg, #fd7e14 0%, #ffc107 100%)" }}
            >
              <h5 className="mb-0 fw-bold text-white">{t("Fee Breakdown")}</h5>
            </Card.Header>
            <Card.Body className="p-0">
              <Table responsive className="mb-0">
                <thead className="bg-light">
                  <tr>
                    <th className="py-3 px-4">{t("Description")}</th>
                    <th className="py-3 px-4">{t("Calculation")}</th>
                    <th className="py-3 px-4 text-end">{t("Amount")}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td className="py-3 px-4 fw-semibold">
                      {supervisionAuthority === "iwt" ? t("Drawing Approval Fee") : t("Drawing Scrutiny Fee")}
                    </td>
                    <td className="py-3 px-4 text-muted">
                      {supervisionAuthority === "iwt" 
                        ? t("0.1% of work order value (Min ₹500)")
                        : t("0.05% of work order value (Min ₹500)")
                      }
                    </td>
                    <td className="py-3 px-4 text-end fw-semibold">₹{fees.drawingFee.toFixed(2)}</td>
                  </tr>
                  
                  {supervisionAuthority === "iwt" && (
                    <tr>
                      <td className="py-3 px-4 fw-semibold">{t("Supervision Fee")}</td>
                      <td className="py-3 px-4 text-muted">
                        {t("Based on work order value tiers")}
                      </td>
                      <td className="py-3 px-4 text-end fw-semibold">₹{fees.supervisionFee.toFixed(2)}</td>
                    </tr>
                  )}
                  
                  <tr className="table-success">
                    <td className="py-3 px-4 fw-bold">{t("Total")}</td>
                    <td className="py-3 px-4"></td>
                    <td className="py-3 px-4 text-end fw-bold fs-5">₹{fees.total.toFixed(2)}</td>
                  </tr>
                </tbody>
              </Table>
            </Card.Body>
          </Card>
        </Col>
      </Row>
    </div>
  );
};

export default PaymentDetailsView;
