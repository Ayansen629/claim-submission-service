                placeholder={t("Auto Populated")}
                register={register("basicVesselInfo.addressOfBuilder")}
                errors={errors}
                disabled={true}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Agent's Name")}
                name="basicVesselInfo.agentName"
                placeholder={t("Enter Agent's Name")}
                register={register("basicVesselInfo.agentName")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Agent's Address")}
                name="basicVesselInfo.agentAddress"
                placeholder={t("Enter Agent's Address")}
                register={register("basicVesselInfo.agentAddress")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Agent's Telephone No.")}
                name="basicVesselInfo.agentTelephone"
                placeholder={t("Enter Agent's Telephone")}
                register={register("basicVesselInfo.agentTelephone")}
                errors={errors}
                maxlength={10}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Place of Last Survey")}
                name="basicVesselInfo.placeOfLastSurvey"
                placeholder={t("Enter Place of Last Survey")}
                register={register("basicVesselInfo.placeOfLastSurvey")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Date of Last Survey")}
                name="basicVesselInfo.dateOfLastSurvey"
                type="date"
                register={register("basicVesselInfo.dateOfLastSurvey")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Date of Proposed Visit of Surveyor")}
                name="basicVesselInfo.dateOfProposedVisit"
                type="date"
                register={register("basicVesselInfo.dateOfProposedVisit")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Draft")}
                name="basicVesselInfo.draft"
                type="number"
                placeholder={t("Enter Draft")}
                register={register("basicVesselInfo.draft")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
          </Row>
        </Collapsible>

        {/* Hull Particulars */}
        <Collapsible
          title={
            <>
              <FaShip className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Hull Particulars")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Hull Material")}
                name="hullParticulars.hullMaterial"
                placeholder={t("Enter Hull Material")}
