        minWidth: "150px"
    },
    {
        title: "Capacity",
        minWidth: "150px"
    },
    {
        title: "Location",
        minWidth: "150px"
    },
    {
        title: "Condition",
        minWidth: "200px"
    },
    {
        title: "Remarks",
        minWidth: "200px"
    },
]
