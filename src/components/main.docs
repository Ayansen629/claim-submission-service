const DynamicFormFields = ({ fields, setFormData }) => {
  const { register, formState: { errors }, setValue, watch, setError, clearErrors } = useFormContext();

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'file':
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
                const fileName = `${field.label}${extension}`;
                file.originalName = fileName;
                setValue(field.name, renameFile(file, fileName), { shouldValidate: true });
                setFormData(prev => ({ ...prev, [field.name]: file }));
                clearErrors(field.name);
              } else if (field.required) {
                setError(field.name, {
                  type: 'required',
                  message: `${field.label} is required`
                });
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={watch(field.name)}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...field.validation,
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className="mb-4"
          />
        );
    }
  };

  return (
    <Row className="g-3">
      {fields.map((field, index) => (
        <Col key={index} md={field.colSize || 12}>
          {renderField(field)}
        </Col>
      ))}
    </Row>
  );
};
