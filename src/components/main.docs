const handleFileChange = useCallback(
  async (name, file) => {
    if (!file) return;

    const validTypes = [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "image/jpg",
    ];
    if (!validTypes.includes(file.type)) {
      setError(name, {
        type: "manual",
        message: t("Only PDF, JPG or PNG files are allowed"),
      });
      setValue(name, null);
      return;
    }

    if (file.size > 10 * 1024 * 1024) {
      setError(name, {
        type: "manual",
        message: t("File size should not exceed 10MB"),
      });
      setValue(name, null);
      return;
    }

    const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
    const fileName = `${name}${extension}`;
    file.originalName = fileName;
    const renamedFile = renameFile(file, fileName);

    clearErrors(name);
    setValue(name, renamedFile, { shouldValidate: true });
    setFormData((prev) => ({
      ...prev,
      [name]: renamedFile,
    }));

    if (name === "authLetter") {
      setValue("authLetterFileStoreId", null);
      
      // Store the standardized filename (label + extension)
      const standardizedName = `Authorization Letter${extension}`;
      setValue("authLetterStandardizedName", standardizedName);
      setValue("authLetterOriginalName", file.name);
      
      try {
        const formData = new FormData();
        formData.append("file", file);
        const uploadUrl =
          BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
        loaderRef?.current?.show();
        const response = await postFORMdata(uploadUrl, formData);
        loaderRef?.current?.hide();
        const fileStoreId = response?.data?.files[0]?.fileStoreId;
        if (fileStoreId) {
          console.log("authfileStoreId ", fileStoreId);
          setValue("authLetterFileStoreId", fileStoreId);
        } else {
          toast.error("File addition failed. Please try again.");
          setValue("authLetter", null);
          setValue("authLetterStandardizedName", null);
          setValue("authLetterOriginalName", null);
          setFormData((prev) => ({
            ...prev,
            [name]: null,
          }));
        }
      } catch (error) {
        loaderRef?.current?.hide();
        clearErrors(name);
        setValue("authLetter", null);
        setValue("authLetterStandardizedName", null);
        setValue("authLetterOriginalName", null);
        setFormData((prev) => ({
          ...prev,
          [name]: null,
        }));
        console.error("File upload failed", error);
        toast.error("File upload failed. Please try again.");
      }
    }
  },
  [setValue, clearErrors, setError, t]
);
