import React, { useState } from 'react';
import { Modal, Button } from 'react-bootstrap';
import { format, addDays, setHours, setMinutes } from 'date-fns';
import 'bootstrap/dist/css/bootstrap.min.css';
import './AppointmentModal.css';

const AppointmentModal = ({ show, handleClose, handleConfirm }) => {
  // Generate date and time slots
  const generateSlots = () => {
    const slots = [];
    const today = new Date();
    
    // For each of the next 7 days
    for (let i = 0; i < 7; i++) {
      const date = addDays(today, i);
      const dateFormatted = format(date, 'MMM d');
      
      // Generate 4 time slots per day (10AM-11AM, 12PM-1PM, 3PM-4PM, 4PM-5PM)
      const timeSlots = [
        { start: setHours(setMinutes(date, 0), 10), end: setHours(setMinutes(date, 0), 11), display: '10:00 AM - 11:00 AM' },
        { start: setHours(setMinutes(date, 0), 12), end: setHours(setMinutes(date, 0), 13), display: '12:00 PM - 1:00 PM' },
        { start: setHours(setMinutes(date, 0), 15), end: setHours(setMinutes(date, 0), 16), display: '3:00 PM - 4:00 PM' },
        { start: setHours(setMinutes(date, 0), 16), end: setHours(setMinutes(date, 0), 17), display: '4:00 PM - 5:00 PM' }
      ];
      
      timeSlots.forEach((timeSlot, j) => {
        slots.push({
          id: `${date.getTime()}-${j}`,
          ...timeSlot,
          dateDisplay: dateFormatted,
          fullDisplay: `${timeSlot.display}, ${dateFormatted}`
        });
      });
    }
    
    return slots;
  };

  const [selectedSlot, setSelectedSlot] = useState(null);
  const timeSlots = generateSlots();

  return (
    <Modal show={show} onHide={handleClose} centered className="appointment-modal">
      <Modal.Header closeButton className="border-0 pb-0">
        <Modal.Title className="fw-bold">Select Appointment Slot</Modal.Title>
      </Modal.Header>
      
      <Modal.Body className="pt-0">
        <div className="slots-container">
          {timeSlots.map((slot) => (
            <div 
              key={slot.id}
              className={`time-slot-card ${selectedSlot?.id === slot.id ? 'selected' : ''}`}
              onClick={() => setSelectedSlot(slot)}
            >
              <div className="slot-date">{slot.dateDisplay}</div>
              <div className="slot-time">{slot.display}</div>
              <div className="selection-indicator">
                {selectedSlot?.id === slot.id && (
                  <div className="selection-dot"></div>
                )}
              </div>
            </div>
          ))}
        </div>
      </Modal.Body>
      
      <Modal.Footer className="border-0">
        <Button variant="outline-secondary" onClick={handleClose}>
          Cancel
        </Button>
        <Button 
          variant="primary" 
          onClick={() => {
            if (selectedSlot) {
              handleConfirm(selectedSlot);
              handleClose();
            }
          }}
          disabled={!selectedSlot}
          className="confirm-btn"
        >
          Confirm Appointment
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default AppointmentModal;
