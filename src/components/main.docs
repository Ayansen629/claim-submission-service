  if (o.fieldName === "options") {
                          return (
                            <td
                              key={colIndex}
                              className={`px-3 py-2 ${style.actionTable_table_data}`}
                              style={{
                                width: o?.minWidth || "5rem",
                                fontSize: "1.1rem",
                              }}
                            >
                              <Dropdown align="end">
                                <OverlayTrigger
                                  placement="top"
                                  overlay={
                                    <BSTooltip id={`tooltip-${row?.id}`}>
                                      More Actions
                                    </BSTooltip>
                                  }
                                >
                                  <Dropdown.Toggle
                                    variant="link"
                                    id={`dropdown-${row?.id}`}
                                    className="action-toggle"
                                  >
                                    <ThreeDots size={20} />
                                  </Dropdown.Toggle>
                                </OverlayTrigger>

                                <Dropdown.Menu className="action-menu animated-dropdown shadow-sm">
                                  {(o.actions.includes("edit") ||
                                    row?.isEditable) && (
                                    <Dropdown.Item
                                      onClick={() => handleEdit(row)}
                                      onMouseEnter={(e) => {
                                        e.currentTarget.style.background =
                                          "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                        e.currentTarget.style.color = "#fff";
                                      }}
                                      onMouseLeave={(e) => {
                                        e.currentTarget.style.background = "";
                                        e.currentTarget.style.color = "";
                                      }}
                                      style={{
                                        cursor: "pointer",
                                        transition:
                                          "background-color 0.3s ease, color 0.3s ease",
                                      }}
                                    >
                                      <PencilSquare
                                        size={16}
                                        className="me-2"
                                      />
                                      Edit
                                    </Dropdown.Item>
                                  )}

                                  {o.actions.includes("view") && (
                                    <Dropdown.Item
                                      onClick={() => handleView(row)}
                                      onMouseEnter={(e) => {
                                        e.currentTarget.style.background =
                                          "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                        e.currentTarget.style.color = "#fff";
                                      }}
                                      onMouseLeave={(e) => {
                                        e.currentTarget.style.background = "";
                                        e.currentTarget.style.color = "";
                                      }}
                                      style={{
                                        cursor: "pointer",
                                        transition:
                                          "background-color 0.3s ease, color 0.3s ease",
                                      }}
                                    >
                                      <FaEye size={16} className="me-2" />
                                      View
                                    </Dropdown.Item>
                                  )}

                                  {o.actions.includes("delete") && (
                                    <Dropdown.Item
                                      onClick={() => handleDeleteRow(row)}
                                      onMouseEnter={(e) => {
                                        e.currentTarget.style.background =
                                          "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                        e.currentTarget.style.color = "#fff";
                                      }}
                                      onMouseLeave={(e) => {
                                        e.currentTarget.style.background = "";
                                        e.currentTarget.style.color = "";
                                      }}
                                      style={{
                                        cursor: "pointer",
                                        transition:
                                          "background-color 0.3s ease, color 0.3s ease",
                                      }}
                                    >
                                      <FaTrash
                                        size={16}
                                        className="me-2 text-danger"
                                      />
                                      Delete
                                    </Dropdown.Item>
                                  )}

                                  {o.actions.includes("download") && (
                                    <Dropdown.Item
                                      onClick={() => handleDownload(row)}
                                      onMouseEnter={(e) => {
                                        e.currentTarget.style.background =
                                          "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                        e.currentTarget.style.color = "#fff";
                                      }}
                                      onMouseLeave={(e) => {
                                        e.currentTarget.style.background = "";
                                        e.currentTarget.style.color = "";
                                      }}
                                      style={{
                                        cursor: "pointer",
                                        transition:
                                          "background-color 0.3s ease, color 0.3s ease",
                                      }}
                                    >
                                      <FaDownload size={16} className="me-2" />
                                      Download
                                    </Dropdown.Item>
                                  )}

                                  {o.actions.includes("upload") && (
                                    <Dropdown.Item
                                      onClick={() => handleView(row)}
                                    >
                                      <FaUpload size={16} className="me-2" />
                                      Upload
                                    </Dropdown.Item>
                                  )}

                                  {(o.actions.includes("uploadReports") ||
                                    row?.isEnableUploadReports) && (
                                    <Dropdown.Item
                                      onClick={() => handleUploadReports(row)}
                                      onMouseEnter={(e) => {
                                        e.currentTarget.style.background =
                                          "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                        e.currentTarget.style.color = "#fff";
                                      }}
                                      onMouseLeave={(e) => {
                                        e.currentTarget.style.background = "";
                                        e.currentTarget.style.color = "";
                                      }}
                                      style={{
                                        cursor: "pointer",
                                        transition:
                                          "background-color 0.3s ease, color 0.3s ease",
                                      }}
                                    >
                                      <Upload size={16} className="me-2" />
                                      Upload Reports
                                    </Dropdown.Item>
                                  )}

                                  {(o.actions.includes("vesselRegistration") ||
                                    row?.isEnableApplicationRegistration) && (
                                    <Dropdown.Item
                                      onClick={() =>
                                        handleVesselRegistration(row)
                                      }
                                      onMouseEnter={(e) => {
                                        e.currentTarget.style.background =
                                          "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                        e.currentTarget.style.color = "#fff";
                                      }}
                                      onMouseLeave={(e) => {
                                        e.currentTarget.style.background = "";
                                        e.currentTarget.style.color = "";
                                      }}
                                      style={{
                                        cursor: "pointer",
                                        transition:
                                          "background-color 0.3s ease, color 0.3s ease",
                                      }}
                                    >
                                      <FileEarmarkText
                                        size={16}
                                        className="me-2"
                                      />
                                      Vessel Registration
                                    </Dropdown.Item>
                                  )}

                                  {(o.actions.includes(
                                    "provisionalCertificate"
                                  ) ||
                                    row?.isEnableProvisionalCertificate) && (
                                    <Dropdown.Item
                                      onClick={() =>
                                        handleProvisionalCertificate(row)
                                      }
                                      onMouseEnter={(e) => {
                                        e.currentTarget.style.background =
                                          "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                        e.currentTarget.style.color = "#fff";
                                      }}
                                      onMouseLeave={(e) => {
                                        e.currentTarget.style.background = "";
                                        e.currentTarget.style.color = "";
                                      }}
                                      style={{
                                        cursor: "pointer",
                                        transition:
                                          "background-color 0.3s ease, color 0.3s ease",
                                      }}
                                    >
                                      <Award size={16} className="me-2" />
                                      Provisional Certificate
                                    </Dropdown.Item>
                                  )}

                                  {o.actions.includes("revisedDrawing") && (
                                    <Dropdown.Item
                                      onClick={() => handleRevisedDrawing(row)}
                                      onMouseEnter={(e) => {
                                        e.currentTarget.style.background =
                                          "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                        e.currentTarget.style.color = "#fff";
                                      }}
                                      onMouseLeave={(e) => {
                                        e.currentTarget.style.background = "";
                                        e.currentTarget.style.color = "";
                                      }}
                                      style={{
                                        cursor: "pointer",
                                        transition:
                                          "background-color 0.3s ease, color 0.3s ease",
                                      }}
                                    >
                                      <Pencil size={16} className="me-2" />
                                      Revised Drawing
                                    </Dropdown.Item>
                                  )}

                                  {(o.actions.includes("paySupervisionFee") ||
                                    !row?.isEnableSupervisionFee) && (
                                    <Dropdown.Item
                                      onClick={() =>
                                        handlePaySupervisionFee(row)
                                      }
                                      onMouseEnter={(e) => {
                                        e.currentTarget.style.background =
                                          "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                        e.currentTarget.style.color = "#fff";
                                      }}
                                      onMouseLeave={(e) => {
                                        e.currentTarget.style.background = "";
                                        e.currentTarget.style.color = "";
                                      }}
                                      style={{
                                        cursor: "pointer",
                                        transition:
                                          "background-color 0.3s ease, color 0.3s ease",
                                      }}
                                    >
                                      <CreditCard size={16} className="me-2" />
                                      Pay Supervision Fee
                                    </Dropdown.Item>
                                  )}

                                  {o.actions.includes("applyInitialSurvey") ||
                                    (row?.enableInitialSurvey && (
                                      <Dropdown.Item
                                        onClick={() =>
                                          handleApplyInitialSurvey(row)
                                        }
                                        onMouseEnter={(e) => {
                                          e.currentTarget.style.background =
                                            "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                          e.currentTarget.style.color = "#fff";
                                        }}
                                        onMouseLeave={(e) => {
                                          e.currentTarget.style.background = "";
                                          e.currentTarget.style.color = "";
                                        }}
                                        style={{
                                          cursor: "pointer",
                                          transition:
                                            "background-color 0.3s ease, color 0.3s ease",
                                        }}
                                      >
                                        <ClipboardCheck
                                          size={16}
                                          className="me-2 text-success"
                                        />
                                        Apply Initial Survey
                                      </Dropdown.Item>
                                    ))}
                                  {row?.isCMNGenerated && (
                                    <>
                                      <Dropdown.Item
                                        onClick={() => handleDownloadCMN(row)}
                                        onMouseEnter={(e) => {
                                          e.currentTarget.style.background =
                                            "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                          e.currentTarget.style.color = "#fff";
                                        }}
                                        onMouseLeave={(e) => {
                                          e.currentTarget.style.background = "";
                                          e.currentTarget.style.color = "";
                                        }}
                                        style={{
                                          cursor: "pointer",
                                          transition:
                                            "background-color 0.3s ease, color 0.3s ease",
                                        }}
                                      >
                                        <Download size={16} className="me-2" />
                                        Download CMN
                                      </Dropdown.Item>
                                    </>
                                  )}

                                  {row?.isCMNGenerated &&
                                    !row.enableInitialSurvey && (
                                      <Dropdown.Item
                                        onClick={() => handleSlotBooking(row)}
                                        onMouseEnter={(e) => {
                                          e.currentTarget.style.background =
                                            "linear-gradient(178deg, #7ec8f8, #0d5ed0)";
                                          e.currentTarget.style.color = "#fff";
                                        }}
                                        onMouseLeave={(e) => {
                                          e.currentTarget.style.background = "";
                                          e.currentTarget.style.color = "";
                                        }}
                                        style={{
                                          cursor: "pointer",
                                          transition:
                                            "background-color 0.3s ease, color 0.3s ease",
                                        }}
                                      >
                                        <Calendar2Check
                                          size={16}
                                          className="me-2"
                                        />
                                        Slot Booking
                                      </Dropdown.Item>
                                    )}
                                </Dropdown.Menu>
                              </Dropdown>
                            </td>
                          );
                        }
