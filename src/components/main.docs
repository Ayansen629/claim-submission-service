.highlight-field {
  background: linear-gradient(120deg, #2466BF 0%, #1976d2 100%);
  color: white;
  padding: 2px 8px;
  border-radius: 4px;
  font-weight: 600;
  display: inline-block;
  margin: 0 2px;
  font-style: italic; /* Add italic */
}

.highlight-field.auto-populated {
  font-weight: 700; /* Make auto-populated fields bolder */
  font-style: italic;
  background: linear-gradient(120deg, #1976d2 0%, #0d47a1 100%);
}

.editable-field {
  background: linear-gradient(120deg, #28a745 0%, #20c997 100%) !important;
  cursor: pointer;
  transition: all 0.3s ease;
  font-weight: 700; /* Bold for editable fields */
  font-style: italic;
}
