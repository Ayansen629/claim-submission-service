const StatusCard = ({ title, value, icon: IconComponent, color, bgColor, subtitle }) => (
  <Card className="status-card">
    <div className="status-card-content">
      <div className="icon-wrapper" style={{ backgroundColor: bgColor }}>
        <IconComponent size={20} color={color} />
      </div>
      <div className="value" style={{ color }}>{value}</div>
      <div className="title">{title}</div>
      <div className="subtitle">{subtitle}</div>
    </div>
  </Card>
);

const EmployeeDashboard = () => {
  const statData = [
    { 
      title: 'Registration', 
      value: 12, 
      icon: BsPersonBadge, 
      color: '#1251a6',
      bgColor: 'rgba(18, 81, 166, 0.1)'
    },
    // ... other data items
  ];

  return (
    <div className="stats-container">
      {statData.slice(0, 2).map((item, index) => (
        <StatusCard key={index} {...item} subtitle="Total Application" />
      ))}
      
      {/* Combined card with search */}
      <div className="search-combined-card">
        <StatusCard {...statData[2]} subtitle="Total Application" />
        <div className="search-container">
          <InputGroup className="search-input-group">
            <Form.Control placeholder="Search application..." />
            <Button variant="primary"><BsSearch /></Button>
          </InputGroup>
        </div>
      </div>
    </div>
  );
};
