// Update the InputFile component to handle errors better
import React, { useState, useEffect, useRef } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaCheckCircle } from "react-icons/fa";

const InputFile = ({
  label,
  required,
  name,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  style = {},
  watch,
  defaultValue,
  autoFocus = false,
  register
}) => {
  const hasError = errors && errors[name];
  const fileInputRef = useRef();
  const [localFileName, setLocalFileName] = useState("");
  
  // Get file value from watch
  const watchedValue = watch ? watch(name) : undefined;
  
  useEffect(() => {
    if (watchedValue instanceof File) {
      setLocalFileName(watchedValue.originalName || watchedValue.name);
      // If we have a file, clear any errors
      if (errors && errors[name]) {
        delete errors[name];
      }
    } else if (typeof watchedValue === "string" && watchedValue.trim() !== "") {
      setLocalFileName(watchedValue);
    } else if (defaultValue) {
      if (defaultValue instanceof File) {
        setLocalFileName(defaultValue.originalName || defaultValue.name);
      } else if (typeof defaultValue === "string") {
        setLocalFileName(defaultValue);
      }
    }
  }, [watchedValue, defaultValue, name, errors]);

  // Handle file change
  const handleFileChange = (e) => {
    if (e.target.files && e.target.files[0]) {
      setLocalFileName(e.target.files[0].name);
    }
    if (onChange) {
      onChange(e);
    }
  };

  // Get file icon based on extension
  const getFileIcon = () => {
    if (!localFileName) return <FaFile color="#0d6efd" />;
    const extension = localFileName.split('.').pop()?.toLowerCase();
    if (extension === 'pdf') return <FaFilePdf color="#dc3545" />;
    if (['jpg', 'jpeg', 'png', 'gif'].includes(extension || '')) return <FaFileImage color="#28a745" />;
    return <FaFile color="#0d6efd" />;
  };

  // If we have a file, don't show error
  const showError = hasError && !localFileName;

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      <div
        className={`file-upload border rounded p-3 ${showError ? 'border-danger' : ''}`}
        style={{
          ...style,
          backgroundColor: showError ? '#fff8f8' : 'white',
          borderColor: showError ? '#dc3545' : '#ced4da',
          borderRadius: '8px',
          transition: 'all 0.3s ease'
        }}
      >
        <div className="d-flex align-items-center">
          <label
            htmlFor={name}
            className={`file-label btn ${showError ? 'btn-outline-danger' : 'btn-primary'} mb-0 d-inline-flex align-items-center`}
            style={{
              borderRadius: '6px',
              padding: '8px 16px',
              cursor: disabled ? 'not-allowed' : 'pointer',
              boxShadow: '0 2px 5px rgba(0,0,0,0.1)',
              transition: 'all 0.3s ease',
              minWidth: '120px',
              color: 'white!important',
              flexShrink: 0,
              opacity: disabled ? 0.65 : 1
            }}
          >
            <FaUpload className="file-icon me-2" />
            <span className="file-text">Choose File</span>
          </label>
          <div
            className={`file-name-container ms-3 flex-grow-1 border rounded px-3 py-2 ${localFileName ? 'bg-light-success' : 'bg-light'} d-flex align-items-center ${showError ? 'border-danger' : localFileName ? 'border-success' : ''}`}
            style={{
              backgroundColor: localFileName ? '#f0f9f0' : '#f8f9fa',
              overflow: 'hidden'
            }}
          >
            {localFileName ? (
              <>
                <FaCheckCircle className="text-success me-2 flex-shrink-0" />
                <div className="overflow-hidden">
                  <span className="text-success fw-bold" style={{ fontSize: '0.8rem' }}>Selected File:</span>
                  <div className="d-flex align-items-center">
                    <span className="file-icon-preview me-2 flex-shrink-0">{getFileIcon()}</span>
                    <span className="text-dark fw-semibold" style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                      {localFileName}
                    </span>
                  </div>
                </div>
              </>
            ) : (
              <span className="text-muted">No file chosen</span>
            )}
          </div>
        </div>
        <input
          ref={fileInputRef}
          type="file"
          id={name}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="file-input d-none"
          {...register}
        />
      </div>
      <Form.Text className="text-muted small mt-1">
        Upload PDF, JPG or PNG file (Max size: 2MB)
      </Form.Text>
      {showError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
