const fetchReports = async () => {
  setLoading(true);
  try {
    const payload = {
      applicationNo: applicationNumber
    };
    
    const searchApiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.USER_SERVICE.REPORT_SEARCH;
    
    // Use fetch with explicit headers to avoid CORS OPTIONS issue
    const response = await fetch(searchApiUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
      },
      body: JSON.stringify(payload)
    });

    const responseData = await response.json();
    console.log("Report search response:", responseData);
    
    if (response.ok && responseData?.responseStatus?.status === "Document(s) fetched successfully.") {
      const fetchedReports = responseData.data || [];
      
      const categorizedReports = {
        materialTest: [],
        radiography: [],
        inspection: [],
        other: [],
      };
      
      fetchedReports.forEach(report => {
        const reportData = {
          id: report.id,
          fileName: report.documentName,
          description: report.description || t("No description"),
          remarks: t("Active"),
        };
        
        switch (report.documentType) {
          case "MATERIAL_TEST_REPORT":
            categorizedReports.materialTest.push(reportData);
            break;
          case "RADIOGRAPHY_REPORT":
            categorizedReports.radiography.push(reportData);
            break;
          case "INSPECTION_REPORT":
            categorizedReports.inspection.push(reportData);
            break;
          case "OTHER_REPORT":
            categorizedReports.other.push(reportData);
            break;
        }
      });
      
      setReports(categorizedReports);
    } else {
      console.error("API Error:", responseData);
      toast.error("Failed to fetch reports");
    }
  } catch (err) {
    console.error("Failed to fetch reports:", err);
    toast.error("Failed to fetch reports");
  } finally {
    setLoading(false);
  }
};
