import React, { useState, useEffect, useRef } from "react";
import { useForm, FormProvider } from "react-hook-form";
import { Container, Row, Col, Button, Card, Image } from "react-bootstrap";
import {
  FaBuilding, FaFileUpload, FaCheck, FaArrowRight,
  FaArrowLeft, FaReceipt
} from "react-icons/fa";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import InputText from "../../../common/InputText.tsx";
import InputFile from "../../../common/InputFile.tsx";
import InputSelect from "../../../common/InputSelect.tsx";
import InputRadio from "../../../common/InputRadio.tsx";
import PaymentModal from "../../../common/PaymentModal.js";
import PreviewPage from "../../../common/PreviewPage";
import { vesselData, previewSections } from "./vesselData";
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";
import { toast } from "react-toastify";

const NewVesselRegistration = () => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [showModal, setShowModal] = useState(false);
  const [paymentMode, setPaymentMode] = useState("offline");
  const [challanFile, setChallanFile] = useState(null);
  const [showPreview, setShowPreview] = useState(false);
  const [isLoading, setIsLoading] = useState(false);

  const methods = useForm({
    mode: 'onBlur',
    defaultValues: { country: 'India' }
  });

  const { register, handleSubmit, formState: { errors }, trigger, setValue, getValues, watch, clearErrors, setError } = methods;
  const totalSteps = 3;

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [currentStep, setValue, formData]);

  const formFields = {
    step1: [
      {
        name: 'ownerName',
        label: t('Name of Owner'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Name of Owner'),
        validation: { required: t('Name is required') }
      },
      {
        name: 'ownerAddress',
        label: t('Address of Owner'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Address of Owner'),
        validation: { required: t('Address is required') }
      },
      {
        name: 'mobile',
        label: t('Mobile'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Mobile'),
        validation: { required: t('Mobile is required') }
      },
      {
        name: 'email',
        label: t('Email Id'),
        type: 'email',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Email Id'),
        validation: { required: t('Email is required') }
      },
      {
        name: 'pan',
        label: t('PAN'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter PAN'),
        validation: { required: t('PAN is required') }
      },
      {
        name: 'aadhar',
        label: t('Aadhar'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Aadhar'),
        validation: { required: t('Aadhar is required') }
      },
      {
        name: 'tradeLicence',
        label: t('Trade Licence'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Trade Licence'),
        validation: { required: t('Trade Licence is required') }
      },
      {
        name: 'gst',
        label: t('GST'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GST'),
        validation: { required: t('GST is required') }
      },
      {
        name: 'grt',
        label: t('Gross Tonnage (GRT)'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GRT'),
        validation: { required: t('GRT is required') }
      },
      {
        name: 'workOrderValue',
        label: t('Work Order Value'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Enter Work Order Value'),
        validation: {
          required: t('Work Order Value is required'),
          pattern: {
            value: /^[0-9]+$/,
            message: t('Please enter a valid number')
          }
        }
      },
      {
        name: 'vesselType',
        label: t('Type of Vessel'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'new', label: t('New Vessel') },
          { value: 'old', label: t('Old Vessel') }
        ],
        validation: { required: t('vesselType is required') }
      },
      {
        name: 'category',
        label: t('Category'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'A', label: t('Category A') },
          { value: 'B', label: t('Category B') },
          { value: 'C', label: t('Category C') }
        ],
        validation: { required: t('category is required') }
      },
      {
        name: 'zone',
        label: t('Zone'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: '1', label: t('Zone 1') },
          { value: '2', label: t('Zone 2') },
          { value: '3', label: t('Zone 3') }
        ],
        validation: { required: t('zone is required') }
      },
      {
        name: 'supervisionAuthority',
        label: t('Supervision Authority'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'iwt', label: t('IWT') },
          { value: 'classificationSociety', label: t('Classification Society') }
        ],
        validation: { required: t('Supervision Authority is required') }
      },
      {
        name: 'purchaseType',
        label: t('Purchase Type'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'new', label: t('New') },
          { value: 'used', label: t('Used') }
        ],
        validation: { required: t('Purchase Type is required') }
      },
      {
        name: 'constructedBy',
        label: t('Constructed By ?'),
        type: 'radio',
        required: true,
        colSize: 6,
        options: [
          { label: t('Self'), value: '1' },
          { label: t('Builder'), value: '2' }
        ],
        validation: { required: t('Please select a Constructor Type') }
      }
    ],
    step2: [
      {
        name: 'workOrderFiles',
        label: t('Work Order'),
        type: 'file',
        required: false,
        colSize: 6
      },
      {
        name: 'drawingsFiles',
        label: t('Drawings'),
        type: 'file',
        required: false,
        colSize: 6
      },
      {
        name: 'tonnageBooklets',
        label: t('Tonnage Booklets'),
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: t('Tonnage Booklets are required') }
      },
      {
        name: 'stabilityBooklets',
        label: t('Stability Booklets'),
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: t('Stability Booklets are required') }
      },
      {
        name: 'termsAccepted',
        label: t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.'),
        type: 'checkbox',
        required: true,
        colSize: 12,
        validation: { required: t('You must accept the terms and conditions') }
      }
    ],
    step3: []
  };

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      case 3: return formFields.step3;
      default: return [];
    }
  };

  const validateStep = async () => {
    const currentFields = getCurrentStepFields();
    const requiredFields = currentFields
      .filter(field => field.required && (!field.showIf || field.showIf()));

    requiredFields.forEach(field => {
      const value = getValues(field.name);
      if (!value || value === '') {
        setError(field.name, {
          type: 'required',
          message: `${field.label} is required`
        });
      } else if (field.validation && field.validation.pattern) {
        const pattern = field.validation.pattern.value;
        if (!pattern.test(value)) {
          setError(field.name, {
            type: 'pattern',
            message: field.validation.pattern.message
          });
        }
      }
    });

    const fieldsToValidate = currentFields
      .filter(field => !field.showIf || field.showIf())
      .map(field => field.name);

    return await trigger(fieldsToValidate);
  };

  const handleNext = async () => {
    if (currentStep === 3) {
      setShowModal(true);
      return;
    }

    const isStepValid = await validateStep();

    if (isStepValid) {
      const currentValues = getValues();
      setFormData(prev => {
        const newFormData = { ...prev };
        Object.keys(currentValues).forEach(key => {
          if (currentValues[key] !== undefined) {
            newFormData[key] = currentValues[key];
          }
        });
        return newFormData;
      });

      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      }
    } else {
      toast.error("Please fix the errors before proceeding.");
    }
  };

  const handlePrevious = () => {
    const currentValues = getValues();
    const fileFields = getCurrentStepFields().filter(field => field.type === 'file');
    fileFields.forEach(field => {
      if (currentValues[field.name]) {
        setFormData(prev => ({
          ...prev,
          [field.name]: currentValues[field.name]
        }));
      }
    });
    setFormData(prev => ({ ...prev, ...currentValues }));
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const handleChallanUpload = (e) => {
    setChallanFile(e.target.files?.[0] || null);
  };

  const handleOnlinePay = () => {
    setIsLoading(true);
    setShowModal(false);
    setTimeout(() => {
      setIsLoading(false);
      setShowPreview(true);
    }, 1500);
  };

  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };
    console.log("Form submitted:", finalData);
    setShowPreview(true);
  };

  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'select':
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register}
            errors={errors}
            className="mb-4"
            onChange={(value) => {
              setValue(field.name, value);
              if (errors[field.name]) {
                clearErrors(field.name);
              }
              setFormData(prev => ({
                ...prev,
                [field.name]: value
              }));
            }}
            value={formData[field.name] || watch(field.name)}
          />
        );

      case 'file':
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e.target.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
                const customFileName = `${field.label}${extension}`;
                file.originalName = customFileName;
                setValue(field.name, file);

                setFormData(prev => ({
                  ...prev,
                  [field.name]: file
                }));

                if (errors[field.name]) {
                  clearErrors(field.name);
                }

                const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'Only PDF, JPG or PNG files are allowed'
                  });
                } else if (file.size > 2 * 1024 * 1024) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'File size should not exceed 2MB'
                  });
                }
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={formData[field.name]}
            clearErrors={clearErrors}
            setValue={setValue}
          />
        );

      case 'radio':
        return (
          <InputRadio
            name={field.name}
            label={field.label}
            options={field.options}
            register={register}
            rules={field.validation}
            errors={errors}
            onChange={() => clearErrors(field.name)}
          />
        );

      case 'checkbox':
        return (
          <div className="mb-3">
            <div className="d-flex align-items-start">
              <input
                type="checkbox"
                id={field.name}
                className="me-2 mt-1"
                {...register(field.name, field.validation)}
              />
              <div>
                <label
                  htmlFor={field.name}
                  className="mb-0"
                  style={{ fontWeight: 500, color: "#333", cursor: "pointer" }}
                >
                  {field.label}
                </label>
                {errors[field.name] && (
                  <div className="text-danger small mt-1" style={{ display: "block" }}>
                    {errors[field.name].message}
                  </div>
                )}
              </div>
            </div>
          </div>
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, field.validation)}
            onChange={handleChange}
            errors={errors}
            className="mb-4"
          />
        );
    }
  };

  const stepTitles = [
    { title: t("Vessel Details"), icon: FaBuilding },
    { title: t("Documents"), icon: FaFileUpload },
    { title: t("Invoicing"), icon: FaReceipt }
  ];

  if (showPreview) {
    return (
      <PreviewPage
        data={vesselData}
        sections={previewSections}
        title="Vessel Registration Preview"
        subtitle="Registration details submitted successfully"
        onBack={() => setShowPreview(false)}
        submitButtonText="Take Action"
        onSubmit={() => alert("Taking action...")}
        icons={{ title: "vessel" }}
        viewMode={true}
      />
    );
  }

  return (
    <>
      <Container fluid className="registration-container py-5">
        <Row className="justify-content-center">
          <Col md={10} xl={9}>
            <Card className="registration-card">
              <Card.Header className="registration-header p-0">
                <div className="registration-header-content">
                  <div className="header-logo-container">
                    <Image
                      src={IWT_FULL_IMG}
                      alt="IWT Logo"
                      className="header-logo"
                    />
                  </div>
                  <h3 className="header-title">
                    {t("New Vessel Registration")}
                  </h3>
                </div>
              </Card.Header>

              <Card.Body className="registration-body p-4 p-md-5">
                {isLoading ? (
                  <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
                    <div className="text-center">
                      <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
                        <span className="visually-hidden">Loading...</span>
                      </div>
                      <p className="mt-3">Processing your request...</p>
                    </div>
                  </div>
                ) : (
                  <FormProvider {...methods}>
                    <form>
                      <div className="text-center mb-4">
                        <p className="text-muted">{t("Fill in the vessel details to complete registration")}</p>
                      </div>

                      {/* Stepper */}
                      <div className="stepper-container mb-5">
                        <div className="stepper d-flex justify-content-between">
                          {[1, 2, 3].map((step) => (
                            <React.Fragment key={step}>
                              <div className={`step ${currentStep >= step ? 'active' : ''} ${currentStep > step ? 'completed' : ''} flex-grow-1 text-center`}>
                                <div
                                  className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2"
                                  style={{
                                    width: '60px',
                                    height: '60px',
                                    borderRadius: '50%',
                                    fontSize: '20px',
                                    fontWeight: 'bold',
                                    boxShadow: currentStep >= step ? '0 5px 15px rgba(0, 119, 182, 0.3)' : '0 4px 10px rgba(0, 0, 0, 0.1)',
                                    background: currentStep >= step ?
                                      (currentStep > step ? 'linear-gradient(135deg, #28a745, #20c997)' : 'linear-gradient(135deg, #0077b6, #023e8a)') :
                                      '#ffffff',
                                    border: currentStep >= step ? 'none' : '2px solid #e9ecef',
                                    color: currentStep >= step ? '#fff' : '#6c757d',
                                    transition: 'all 0.4s ease'
                                  }}>
                                  {currentStep > step ? <FaCheck size={22} /> : React.createElement(stepTitles[step - 1].icon, { size: 18 })}
                                </div>
                                <div className="step-label fw-bold"
                                  style={{
                                    color: currentStep >= step ? (currentStep > step ? '#28a745' : '#0077b6') : '#6c757d',
                                    fontSize: '0.9em',
                                    transition: 'all 0.3s ease'
                                  }}>
                                  {stepTitles[step - 1].title}
                                </div>
                              </div>
                              {step < 3 && (
                                <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                                  <div className={`connector-line w-100 ${currentStep > step ? 'active' : ''}`}
                                    style={{
                                      height: '4px',
                                      background: currentStep > step ? 'linear-gradient(to right, #28a745, #20c997)' : '#e9ecef',
                                      borderRadius: '2px',
                                      transition: 'all 0.5s ease'
                                    }}></div>
                                </div>
                              )}
                            </React.Fragment>
                          ))}
                        </div>
                      </div>

                      {/* Step Content */}
                      <div className="step-content">
                        <div className="form-section p-4 rounded mb-4">
                          <div className="section-title">
                            {React.createElement(stepTitles[currentStep - 1].icon, { className: "section-icon" })}
                            <h4 className="mb-0 fw-bold">{stepTitles[currentStep - 1].title}</h4>
                          </div>

                          <div className="form-content py-3">
                            {currentStep === 3 ? (
                              <div className="container py-4">
                                <h2 className="mb-4" style={{ color: "#2466BF", fontWeight: 600 }}>
                                  {t("Invoicing")}
                                </h2>
                                <div className="text-center">
                                  <p>{t("Please click Pay Now to proceed with payment")}</p>
                                </div>
                              </div>
                            ) : (
                              <Row className="g-4">
                                {getCurrentStepFields().map((field, index) => (
                                  <Col key={index} md={field.colSize || 12} className="mb-2">
                                    <DynamicField field={field} />
                                  </Col>
                                ))}
                              </Row>
                            )}
                          </div>
                        </div>
                      </div>

                      {/* Navigation Buttons */}
                      <div className="form-navigation mt-4" style={{ display: 'block' }}>
                        {currentStep > 1 && (
                          <Button
                            variant="outline-secondary"
                            onClick={handlePrevious}
                            className="prev-btn"
                            style={{ 'float': 'left' }}
                          >
                            <FaArrowLeft className="btn-icon me-2" /> {t("Previous")}
                          </Button>
                        )}

                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="next-btn"
                          style={{ 'float': 'right' }}
                        >
                          {currentStep === 3 ? t('Pay Now') : 
                           currentStep === 2 ? t('Save & Next') : t('Next')}
                          {currentStep < 3 && <FaArrowRight className="btn-icon ms-2" />}
                        </Button>
                      </div>
                    </form>
                  </FormProvider>
                )}
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Container>

      <PaymentModal
        show={showModal}
        onHide={() => setShowModal(false)}
        paymentMode={paymentMode}
        setPaymentMode={setPaymentMode}
        challanFile={challanFile}
        onChallanUpload={handleChallanUpload}
        onOnlinePay={handleOnlinePay}
        isLoading={isLoading}
        formMethods={methods}
      />
    </>
  );
};

export default NewVesselRegistration;
