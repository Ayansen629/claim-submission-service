    //       other: {
    //         occupation: basicDetails?.occupation ?? "",
    //         originalPlaceOfBusiness: basicDetails?.originalPlaceBusiness ?? "",

    //         otherDetailsId: basicDetails?.otherDetailsId ?? "",
    //       },

    //       actions: processActionMapResponce || [],
    //     };

    //     loaderRef.current?.hide();
    //     if (vesselDetails?.iwtVesselBasicDetailsTFk) {
    //       getSurveyDetails(vesselDetails?.iwtVesselBasicDetailsTFk);
    //     }

    //     if (isOfficerLogin) {
