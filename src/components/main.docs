// Add this new function after buildSurveyPayload
const buildEquipmentPayload = (formData, existingSurveyData) => {
  return {
    ...existingSurveyData, // Include all step 1 data
    equipmentInventoryDetails: formData.equipment || {},
    deckSpaceDetails: formData.deckSpaces || [],
    freeboardDetails: formData.freeboard || {}
  };
};

const handleFormSubmit = async (stepInfo) => {
  window.scrollTo({ top: 0, behavior: "smooth" });

  //-- Step 1  Intial Survey Form Submission -- //
  if (stepInfo.index === 0) {
    const formValues = stepInfo?.getFormData?.() || {};
    const surveyPayload = buildSurveyPayload(formValues, registrationData);
    submitIntialSurveyData(surveyPayload);
  }

  //-- Step 2  Equipment Form Submission -- //
  if (stepInfo.index === 1) {
    const formValues = stepInfo?.getFormData?.() || {};

    console.log("=== EQUIPMENT FORM DATA ===");
    console.log("Equipment Data:", formValues.equipment);
    console.log("Deck Spaces:", formValues.deckSpaces);
    console.log("Freeboard:", formValues.freeboard);
    console.log("===========================");

    // Build equipment payload with step 1 + step 2 data
    const equipmentPayload = buildEquipmentPayload(formValues, intialSurveyData);
    
    console.log("=== COMBINED PAYLOAD ===");
    console.log("Equipment Payload:", equipmentPayload);
    console.log("========================");

    // Call same API with combined data
    submitIntialSurveyData(equipmentPayload);
  }
};
