import React, { useState, useRef, useEffect, useContext } from "react";
import { useNavigate, Link } from "react-router-dom";
import "./Header.css";
import Logo from "../../assests/images/Logo.png";
import Profile from "../../assests/images/Profile.png";
import { UserContext } from "../../components/context/UserContext.js";

const Header = () => {
  const [isUserMenuOpen, setIsUserMenuOpen] = useState(false);
  const [isCreateClaimDropdownOpen, setIsCreateClaimDropdownOpen] = useState(false);
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const userMenuRef = useRef(null);
  const navigate = useNavigate();
  const { userData, updateFormType } = useContext(UserContext);

  const selectedRadio = userData || {};

  const toggleUserMenu = () => {
    setIsUserMenuOpen(!isUserMenuOpen);
  };

  const toggleCreateClaimDropdown = () => {
    setIsCreateClaimDropdownOpen(!isCreateClaimDropdownOpen);
  };

  const toggleMobileMenu = () => {
    setIsMobileMenuOpen(!isMobileMenuOpen);
  };

  useEffect(() => {
    const handleClickOutside = (event) => {
      if (userMenuRef.current && !userMenuRef.current.contains(event.target)) {
        setIsUserMenuOpen(false);
      }
    };

    document.addEventListener("mousedown", handleClickOutside);
    return () => {
      document.removeEventListener("mousedown", handleClickOutside);
    };
  }, []);

  const handleLogout = () => {
    localStorage.clear();
    navigate("/login");
  };

  const handleMyProfileClick = () => {
    navigate("/my-profile");
    setIsUserMenuOpen(false);
  };

  const handleChangePasswordClick = () => {
    navigate("/change-password");
    setIsUserMenuOpen(false);
  };

  const getFormPath = () => {
    const { claimantType, claimantCategoryType } = selectedRadio;
    let formType = "";

    if (claimantType === "Financial Creditors") {
      if (
        claimantCategoryType === "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)" ||
        claimantCategoryType === "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)" ||
        claimantCategoryType === "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)"
      ) {
        formType = "Form C";
      } else if (claimantCategoryType === "Unsecured Financial Creditors in Class of Creditors (Homebuyers)") {
        formType = "Form CA";
      }
    } else if (claimantType === "Operational Creditors") {
      formType = "Form B";
    } else if (claimantType === "Employees and Workmen") {
      formType = "Form D";
    } else if (claimantType === "Employees and Workmen – Through Authorised Representative") {
      formType = "Form E";
    } else if (claimantType === "Other Creditors (other than financial and operational creditors)") {
      formType = "Form F";
    }

    if (formType) {
      updateFormType(formType);
      return "/apply-claim";
    }
    return "#";
  };

  return (
    <header className="app-header">
      <div className="header-left">
        <div className="logo-container">
          <img src={Logo} alt="Logo" className="logo" />
        </div>
        <div className="header-title">
          <h4>Claim Submission</h4>
          <p>Service</p>
        </div>
      </div>

      <div className="hamburger-menu" onClick={toggleMobileMenu}>
        <div></div>
        <div></div>
        <div></div>
      </div>

      <nav className={`header-nav ${isMobileMenuOpen ? "active" : ""}`}>
        <ul className="nav-list">
          <li className="nav-item">
            <Link to="/dashboard" className="nav-link" onClick={toggleMobileMenu}>
              Home
            </Link>
          </li>
          <li className="nav-item">
            <Link to="/about" className="nav-link" onClick={toggleMobileMenu}>
              About Us
            </Link>
          </li>
          <li className="nav-item">
            {selectedRadio.userType === "CRP" ? (
              <Link to="/create-claim" className="nav-link" onClick={toggleMobileMenu}>
                Claim Management
              </Link>
            ) : (
              <div className="dropdown">
                <a
                  href="#"
                  className="nav-link dropdown-toggle"
                  onClick={toggleCreateClaimDropdown}
                >
                  Claim Management
                </a>
                <ul className="dropdown-createmenu">
                  <li>
                    <Link
                      to={getFormPath()}
                      className="dropdown-item-header"
                      onClick={(e) => {
                        if (getFormPath() === "#") {
                          e.preventDefault();
                          alert("Could not determine the appropriate form for your claimant type. Please contact support.");
                        }
                        toggleMobileMenu();
                      }}
                    >
                      Apply for Claim
                    </Link>
                  </li>
                </ul>
              </div>
            )}
          </li>
        </ul>
      </nav>

      <div className="user-menu" ref={userMenuRef}>
        <img
          src={Profile}
          alt="User"
          className="user-profile"
          onClick={toggleUserMenu}
        />
        {isUserMenuOpen && (
          <ul className="dropdown-menu dropdown-menu-end">
            <li>
              <button className="dropdown-rightheader" onClick={handleMyProfileClick}>
                My Profile
              </button>
            </li>
            <li>
              <button className="dropdown-rightheader" onClick={handleChangePasswordClick}>
                Change Password
              </button>
            </li>
            <li>
              <button className="dropdown-rightheader" onClick={handleLogout}>
                Logout
              </button>
            </li>
          </ul>
        )}
      </div>
    </header>
  );
};

export default Header;
