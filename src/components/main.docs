export const initialEquipementData = {
    equipment: {},
    deckSpaces: [
        {
            deckType: "",
            size: "",
            function: "",
            maxPassengers: "",
            remarks: ""
        }
    ],
    freeboard: {
        minFreeboard: "",
        numPassengers: "",
        cargo: ""
    }
};

export const conditionOptions = [
    { value: "", label: "Select Condition" },
    { value: "GOOD", label: "Good" },
    { value: "FAIR", label: "Fair" },
    { value: "POOR", label: "Poor" },
    { value: "NOT_AVAILABLE", label: "Not Available" },
];
const commonTableItems = [
    {
        item: 'number',
        type: 'number',
        placeholder: "Enter Number",
        required: false,
        register: {},
    },
    {
        item: 'type',
        type: "text",
        placeholder: "Enter Type",
        required: false,
        register: {},
    },
    {
        item: 'capacity',
        type: "text",
        placeholder: "Enter Capacity",
        required: false,
        register: {},
    },
    {
        item: 'location',
        type: "text",
        placeholder: "Enter Location",
        required: false,
        register: {},
    },
    {
        item: 'condition',
        type: "select",
        placeholder: "Select Condition",
        options: conditionOptions,
        required: false,
        register: {},
    },
    {
        item: 'remarks',
        type: "text",
        placeholder: "Enter Remarks",
        required: false,
        register: {},
    },

];

