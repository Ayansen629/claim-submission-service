import React, { useState, useRef, useCallback } from "react";
import { Button } from "@mui/material";
import { FaArrowLeft } from "react-icons/fa";
import { useNavigate, useLocation } from "react-router-dom";
import Stepper from "../../../common/Stepper";
import NameChange from "./NameChange";
import Invoicing from "../../../common/Invoicing";
import styles from './ApplicationDetailsUpdate.module.css';

const ApplicationDetailsUpdate = () => {
  const navigate = useNavigate();
  const location = useLocation();
  const stepperRef = useRef();
  const selectedOption = location.state?.selectedOption || "";
  
  const [isValid, setIsValid] = useState(false);
  const [formData, setFormData] = useState({});

  // Mock payment data for invoicing
  const mockPaymentData = {
    summary: {
      subTotal: 1000,
      cgst: 90,
      sgst: 90,
      igst: 0,
      totalPayable: 1180
    },
    invoiceBreakupInfo: [
      {
        id: 1,
        categoryHeader: "Registration Charges",
        label: "Application processing fee",
        amount: 500
      },
      {
        id: 2,
        categoryHeader: "Documentation Charges",
        label: "Certificate issuance fee",
        amount: 300
      },
      {
        id: 3,
        categoryHeader: "Processing Fees",
        label: "Administrative charges",
        amount: 200
      }
    ]
  };

  const handleValidationChange = useCallback((valid) => {
    setIsValid(valid);
  }, []);

  const handleDataChange = useCallback((data) => {
    setFormData(data);
  }, []);

  const validateStep = () => {
    return isValid;
  };

  const getFormData = () => {
    return formData;
  };

  const handleSaveAndNext = (stepInfo) => {
    console.log("Saving step data:", stepInfo);
  };

  const handlePayNow = () => {
    console.log("Proceeding to payment...");
    // Add payment logic here
  };

  const handleSubmit = () => {
    console.log("Submitting application...");
    // Add submit logic here
    navigate("/dashboard");
  };

  const steps = [
    {
      label: "Registration Information",
      component: (
        <NameChange 
          selectedOption={selectedOption}
          onValidationChange={handleValidationChange}
          onDataChange={handleDataChange}
        />
      ),
      validate: validateStep,
      getFormData: getFormData,
      showSavaAndNextButton: true,
      hasActions: true
    },
    {
      label: "Invoice",
      component: (
        <Invoicing
          supervisionAuthority="iwt"
          onPayNow={handlePayNow}
          paymentData={mockPaymentData}
        />
      ),
      validate: () => true,
      getFormData: () => ({}),
      showPayBtn: true
    },
    {
      label: "Submit",
      component: (
        <div className={styles.submitStep}>
          <div className={styles.submitContent}>
            <h4>Review and Submit</h4>
            <p>Please review all the information and submit your application.</p>
            <div className={styles.summaryBox}>
              <h6>Application Summary:</h6>
              <p><strong>Change Type:</strong> {selectedOption}</p>
              <p><strong>Previous Name:</strong> {formData.previousName || "N/A"}</p>
              <p><strong>Updated Name:</strong> {formData.updatedNewName || "N/A"}</p>
              <p><strong>Document:</strong> {formData.uploadedFile?.name || "No file uploaded"}</p>
            </div>
          </div>
        </div>
      ),
      validate: () => true,
      getFormData: () => ({}),
      showSubmitWithInvoice: true
    }
  ];

  return (
    <div className={styles.container}>
      <div className={styles.header}>
        <Button
          startIcon={<FaArrowLeft />}
          onClick={() => navigate(-1)}
          className={styles.backButton}
        >
        </Button>
        <h5 className={styles.title}>
          Application Details Update - {selectedOption}
        </h5>
        <div className={styles.applicationId}>
          WB-IWT/REG/2025/302748
        </div>
      </div>
      
      <Stepper
        ref={stepperRef}
        steps={steps}
        onSyncData={handleSaveAndNext}
        onPayNow={handlePayNow}
        onSubmit={handleSubmit}
        viewMode={true}
        editMode={false}
        initialStep={0}
      />
    </div>
  );
};

export default ApplicationDetailsUpdate;
