import { Tooltip } from "react-tooltip";

const actionDropdown =
  isViewMode && isOfficerLogin && actionsFromAPI?.length > 0 ? (
    <>
      <div
        style={{
          display: "flex",
          gap: "8px",
          alignItems: "center",
          flexWrap: "wrap",
        }}
      >
        {/* Certificate Buttons */}
        {userRole === USER_ROLES?.OFFICER_L3 && showOfficerActions && (
          <>
            {!generatedCertificates.survey && (
              <Button
                variant="contained"
                onClick={() => handleProvisionModalOpen("survey")}
                data-tooltip-id="survey-cert-tooltip"
                data-tooltip-content="Generate Provisional Certificate of Survey for vessel inspection"
                style={{
                  background: "#10b981",
                  color: "#fff",
                  fontWeight: "600",
                  borderRadius: "6px",
                  fontSize: "0.75rem",
                  padding: "6px 12px",
                  height: "32px",
                  minWidth: "80px",
                  maxWidth: "80px",
                  textTransform: "none",
                  border: "none",
                  boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
                  transition: "all 0.2s ease",
                }}
              >
                Survey Cert
              </Button>
            )}
            
            {!generatedCertificates.registration && (
              <Button
                variant="contained"
                onClick={() => handleProvisionModalOpen("registration")}
                data-tooltip-id="reg-cert-tooltip"
                data-tooltip-content="Generate Provisional Certificate of Registration for vessel registry"
                style={{
                  background: "#10b981",
                  color: "#fff",
                  fontWeight: "600",
                  borderRadius: "6px",
                  fontSize: "0.75rem",
                  padding: "6px 12px",
                  height: "32px",
                  minWidth: "80px",
                  maxWidth: "80px",
                  textTransform: "none",
                  border: "none",
                  boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
                  transition: "all 0.2s ease",
                }}
              >
                Registry Cert
              </Button>
            )}
          </>
        )}

        {/* Save Button */}
        <Button
          variant="contained"
          onClick={() =>
            handleFormSubmit({
              index: 1,
              getFormData: () => methods?.getValues(),
            })
          }
          data-tooltip-id="save-tooltip"
          data-tooltip-content="Save current form data and changes"
          style={{
            backgroundColor: "#2E57A7",
            fontWeight: "600",
            borderRadius: "6px",
            fontSize: "0.75rem",
            color: "#fff",
            padding: "6px 12px",
            height: "32px",
            minWidth: "80px",
            maxWidth: "80px",
            textTransform: "none",
            boxShadow: "0 1px 3px rgba(0,0,0,0.12)",
            transition: "all 0.2s ease",
          }}
        >
          Save
        </Button>

        {/* Action Dropdown */}
        <ActionDropdown
          actions={actionsFromAPI}
          onActionClick={handleWorkflowActionClick}
        />
      </div>

      {/* Tooltips */}
      <Tooltip 
        id="survey-cert-tooltip" 
        place="top"
        style={{
          backgroundColor: "#333",
          color: "#fff",
          fontSize: "0.75rem",
          padding: "6px 10px",
          borderRadius: "4px",
          zIndex: 9999,
          maxWidth: "200px"
        }}
      />
      <Tooltip 
        id="reg-cert-tooltip" 
        place="top"
        style={{
          backgroundColor: "#333",
          color: "#fff",
          fontSize: "0.75rem",
          padding: "6px 10px",
          borderRadius: "4px",
          zIndex: 9999,
          maxWidth: "200px"
        }}
      />
      <Tooltip 
        id="save-tooltip" 
        place="top"
        style={{
          backgroundColor: "#333",
          color: "#fff",
          fontSize: "0.75rem",
          padding: "6px 10px",
          borderRadius: "4px",
          zIndex: 9999,
          maxWidth: "200px"
        }}
      />
    </>
  ) : null;
