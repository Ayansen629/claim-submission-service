  //         identificationNumber: registrationData.creditorBasicDetails?.document?.docId,
  //         identificationDocument: registrationData.creditorBasicDetails?.document
  //           ? { id: registrationData.creditorBasicDetails.document.docId, name: registrationData.creditorBasicDetails.document.docName, type: registrationData.creditorBasicDetails.document.docType }
  //           : null,
  //       },
  //       step2: {
  //         securityInterestAmount: registrationData.claimDetails?.securityInterestAmount,
  //         guaranteeAmount: registrationData.claimDetails?.guaranteeAmount,
  //         guarantorName: registrationData.claimDetails?.guarantorName,
  //         guarantorAddress: registrationData.claimDetails?.guarantorAddress,
  //         creditorAddress: registrationData.claimDetails?.creditorAddress,
  //         creditorEmail: registrationData.claimDetails?.creditorEmail,
  //         beneficiaryName: registrationData.claimDetails?.beneficiaryName,
  //         beneficiaryAddress: registrationData.claimDetails?.beneficiaryAddress,
  //         corporateDebtorSecurityAmount: registrationData.claimDetails?.corporateDebtorSecurityAmount,
  //         corporateDebtorGuaranteeAmount: registrationData.claimDetails?.corporateDebtorGuaranteeAmount,
  //         principalBorrowerName: registrationData.claimDetails?.principalBorrowerName,
