/* Add these CSS rules to fix the gap issue */
.header-sidebar-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.main-layout {
  display: flex;
  flex: 1;
  margin-top: 0; /* Remove any top margin */
}

.content-container {
  flex: 1;
  padding-top: 0; /* Remove top padding */
  overflow-y: auto;
}

/* Adjust the custom-navbar to remove bottom margin */
.custom-navbar {
  margin-bottom: 0;
}

/* Ensure there's no default margin on the Sidebar component */
.sidebar {
  margin-top: 0;
}
