
import React, { useState, useEffect, useRef } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Button, Card, Badge, Stack } from 'react-bootstrap';
import { FaFileAlt, FaFileUpload, FaArrowLeft, FaArrowRight, FaDownload, FaList, FaRegArrowAltCircleLeft, FaArrowAltCircleLeft } from 'react-icons/fa';
import createFormFieldsConfig from '../../../common/FormFieldsConfig';
import { useNavigate } from 'react-router-dom';
import ActionDropdown from '../../../common/ActionDropdown';
import ApprovalModal from '../../../common/ApprovalModal';
import './userViewPage.css';
import NewLoader from '../../../common/NewLoader';
import DynamicViewFields from '../../../common/DynamicViewFields';

const UserViewPage = () => {
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(true);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const navigate = useNavigate();
  const totalSteps = 2;
  const actionsFromAPI = ["Approve", "Reject", "Request Changes"];
  const loaderRef = useRef();

  const applicationNumber = "APP-2025-001";

  const mockApplicationData = {
    firstName: "John",
    lastName: "Doe",
    emailId: "john.doe@example.com",
    phoneNumber: "9876543210",
    panNumber: "ABCDE1234F",
    gstNumber: "22ABCDE1234F1Z5",
    addressLine1: "123 Main Street",
    addressLine2: "Building A",
    pin: "700001",
    district: "Kolkata",
    stateUt: "West Bengal",
    country: "India",
    addressProof: "address_proof.pdf",
    panCardUpload: "pan_card.pdf",
    gstCertificate: "gst_certificate.pdf",
    status: "Pending Review"
  };

  useEffect(() => {
    setIsLoading(true);
    loaderRef.current?.show?.();
    setTimeout(() => {
      setFormData(mockApplicationData);
      setIsLoading(false);
      loaderRef.current?.hide?.();
    }, 500);
  }, []);

  const methods = useForm({ defaultValues: { country: 'India' } });
  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading) {
      Object.keys(formData).forEach(key => {
        if (formData[key]) {
          setValue(key, formData[key]);
        }
      });
    }
  }, [isLoading, formData, setValue]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      ...formData,
    };
    console.log("Action submitted:", payload);
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };


  const handleDownload = (filename) => {

    const blob = new Blob(["Dummy file content"], { type: "text/plain" });
    const link = document.createElement("a");
    link.href = window.URL.createObjectURL(blob);
    link.download = filename;
    link.click();
    window.URL.revokeObjectURL(link.href);
  };


  const renderFileField = (value) => (
    <div className="file-display d-flex align-items-center justify-content-between">
      <span className="file-name">{value || 'No file uploaded'}</span>
      {value && (
        <Button
          variant="link"
          size="sm"
          className="file-download-btn"
          onClick={() => handleDownload(value)}
          tabIndex={-1}
        >
          <FaDownload style={{ fontSize: 18 }} />
        </Button>
      )}
    </div>
  );

  const getDisabledFormFieldsConfig = () => {
    const originalConfig = createFormFieldsConfig(() => { });
    const disabledStep1 = originalConfig.step1.map(field => ({
      ...field,
      disabled: true,
      inputClassName: 'disabled-field'
    }));
    const disabledStep2 = originalConfig.step2.map(field => ({
      ...field,
      disabled: true,
      render: renderFileField
    }));
    return {
      step1: disabledStep1,
      step2: disabledStep2
    };
  };

  const formFields = getDisabledFormFieldsConfig();

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return formFields.step1;
      case 2: return formFields.step2;
      default: return [];
    }
  };

  const handleNext = () => {
    if (currentStep < totalSteps) {
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const handleBackToList = () => {
    navigate('/user-registration/view');
  };

  const getStatusBadge = (status) => {
    const statusMap = {
      'Pending Review': 'warning',
      'Approved': 'success',
      'Rejected': 'danger',
      'Processing': 'info'
    };
    return <Badge bg={statusMap[status] || 'secondary'} className="status-badge" text='white' >{status}</Badge>;
  };

  if (isLoading) {
    return <NewLoader ref={loaderRef} />;
  }

  return (
    <>
      <Container fluid className="py-4 officer-view-container">
        <Row className="justify-content-center">
          <Col size={12}>
            <Card className="shadow-sm border-0">
              <Card.Header className="bg-white border-bottom-0 py-4">
                <Stack direction="horizontal" gap={3} className="flex-wrap justify-content-between align-items-center">
                  <button
                    className="btn back-button"
                    onClick={handleBackToList}
                    style={{
                      fontSize: "0.9rem",
                      left: 0,
                      transform: "translateY(-50%)",
                      textDecoration: "none",
                    }}
                  >
                    <FaArrowAltCircleLeft size={22} color='primary' />
                  </button>

                  <div className="flex-grow-1 d-flex flex-column align-items-center">
                    {/* <h3 className="mb-2 fw-bold app-header-title">Application Review</h3> */}
                    <div className="d-flex flex-wrap align-items-center justify-content-center gap-2">
                      <span className="application-label fw-semibold text-muted">Application Number:</span>
                      <span className="application-number px-3 py-1 rounded-pill fw-semibold">
                        {applicationNumber}
                      </span>
                    </div>
                  </div>
                  <div style={{ width: 160 }} >
                    <span className="ms-2">{getStatusBadge(formData.status)}</span>

                  </div>
                </Stack>
              </Card.Header>

              <Card.Body className="p-4">
                {/* Stepper */}
                <div className="stepper-wrapper mb-5">
                  <div className={`stepper-item ${currentStep === 1 ? 'active' : ''} ${currentStep > 1 ? 'completed' : ''}`}>
                    <div className="step-counter">
                      {currentStep > 1 ? <FaFileAlt className="text-success" /> : '1'}
                    </div>
                    <div className="step-name">Basic Details</div>
                  </div>
                  <div className={`stepper-item ${currentStep === 2 ? 'active' : ''} ${currentStep > 2 ? 'completed' : ''}`}>
                    <div className="step-counter">
                      {currentStep > 2 ? <FaFileUpload className="text-success" /> : '2'}
                    </div>
                    <div className="step-name">Documents</div>
                  </div>
                </div>

                <FormProvider {...methods}>
                  <form>
                    <div className="form-content px-3">
                      <Row className="g-3">
                        <DynamicViewFields
                          fields={getCurrentStepFields()}
                          setFormData={setFormData}
                        />
                      </Row>
                    </div>

                    <div className="d-flex justify-content-between mt-5 pt-4 border-top">
                      <Button
                        variant="outline-primary"
                        onClick={handlePrevious}
                        disabled={currentStep === 1}
                        className="px-4 py-2 d-flex align-items-center"
                      >
                        <FaArrowLeft className="me-2" /> Previous
                      </Button>
                      {currentStep < totalSteps ? (
                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="px-4 py-2 d-flex align-items-center"
                        >
                          Next <FaArrowRight className="ms-2" />
                        </Button>
                      ) : (
                        <div className="d-flex align-items-center">
                          <ActionDropdown
                            actions={actionsFromAPI}
                            onActionClick={handleActionClick}
                            variant="primary"
                            className="py-2 px-3"
                          />
                        </div>
                      )}
                    </div>
                  </form>
                </FormProvider>
              </Card.Body>
            </Card>
          </Col>
        </Row>

        {/* Approval Modal */}
        <ApprovalModal
          show={showApprovalModal}
          handleClose={handleCloseModal}
          handleSubmitData={handleActionSubmit}
          selectedAction={selectedAction}
        />
      </Container>
    </>
  );
};

export default UserViewPage;

import React, { useState, useEffect } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams, useLocation,useNavigate } from "react-router-dom";
import Stepper from "../../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import Documents from "./Documents.js";
import { useForm } from "react-hook-form";
import Invoicing from "../../../common/Invoicing.js";
import PaymentModal from "../../../common/PaymentModal.js"; 
import NewVesselRegistrationSuccess from "./newVesselRegistrationSuccess.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";

const NewVesselRegistration = () => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const { id } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  
  const isEditMode = !!id && location.pathname.includes('/edit/');
  const isViewMode = !!id && location.pathname.includes('/view/');
  const isNormalMode = !isEditMode && !isViewMode;
  
  const methods = useForm({ mode: "onTouched" });
  const { trigger, getValues, setError, setValue, reset } = methods;

  const staticData = {
    ownerName: "John Doe",
    ownerAddress: "123 Main Street, Harbor City, State 12345",
    mobile: "9876543210",
    email: "john.doe@example.com",
    pan: "ABCDE1234F",
    aadhar: "123456789012",
    tradeLicence: "TL123456789",
    gst: "GST123456789012",
    grt: "500",
    workOrderValue: "1000000",
    vesselType: "new",
    category: "A",
    zone: "1",
    supervisionAuthority: "classificationSociety",
    purchaseType: "new",
    classificationSociety: "Lloyd's Register Classification Society",
    constructedBy: "2",
    builder: "builder1",
    builderName: "ABC Marine Shipyard Pvt Ltd",
    builderAddress: "456 Port Road, Shipyard Complex, Harbor City 54321",
    builderEmail: "contact@abcshipyard.com",
    builderMobile: "9876543211",
    builderTradeLicence: "BTL789012345",
    builderGST: "BGST987654321098",
    builderAuth: "auth",
    termsAccepted: true,
    
    // Work Order Files (50 files)
    ...Array.from({ length: 50 }, (_, i) => ({
      [`workOrder_file_${i + 1}`]: { 
        name: `Work_Order_Document_${String(i + 1).padStart(2, '0')}.pdf`, 
        size: Math.floor(Math.random() * 2000000) + 500000 
      },
      [`workOrder_desc_${i + 1}`]: `Work order document ${i + 1} - ${[
        'Main contract document',
        'Amendment and modifications',
        'Technical specifications',
        'Timeline and milestones',
        'Budget breakdown',
        'Quality requirements',
        'Safety protocols',
        'Environmental compliance',
        'Material specifications',
        'Equipment details'
      ][i % 10]}`
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    
    // Drawing Files (50 files)
    ...Array.from({ length: 50 }, (_, i) => ({
      [`drawings_file_${i + 1}`]: { 
        name: `Technical_Drawing_${String(i + 1).padStart(2, '0')}.pdf`, 
        size: Math.floor(Math.random() * 3000000) + 800000 
      },
      [`drawings_desc_${i + 1}`]: `Technical drawing ${i + 1} - ${[
        'General arrangement plan',
        'Hull structure details',
        'Machinery layout',
        'Electrical schematic',
        'Piping diagram',
        'Safety equipment layout',
        'Navigation equipment',
        'Interior arrangement',
        'Deck plan',
        'Cross-section view'
      ][i % 10]}`
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    
    tonnageBooklets: { name: "Tonnage_Booklets.pdf", size: 512000 },
    stabilityBooklets: { name: "Stability_Booklets.pdf", size: 768000 },
    authLetter: { name: "Authorization_Letter.pdf", size: 256000 }
  };

  const [showModal, setShowModal] = useState(false);
  const [paymentMode, setPaymentMode] = useState("offline");
  const [challanFile, setChallanFile] = useState(null);
  const [isLoading, setIsLoading] = useState(false);

  useEffect(() => {
    if (isNormalMode) {
      reset();
    } else if (isEditMode || isViewMode) {
      setTimeout(() => {
        Object.keys(staticData).forEach(key => {
          setValue(key, staticData[key]);
        });
      }, 100);
    }
  }, [isEditMode, isViewMode, isNormalMode, setValue, reset, location.pathname]);

  const validateVesselDetails = async () => {
    if (isViewMode) return true;
    const basicFields = [
      "ownerName", "ownerAddress", "mobile", "email", "pan", 
      "aadhar", "tradeLicence", "gst", "grt", "workOrderValue",
      "vesselType", "category", "purchaseType", "constructedBy"
    ];
    
    const constructedBy = getValues("constructedBy");
    if (constructedBy === "2") {
      basicFields.push(
        "builderName", "builderAddress", "builderEmail", 
        "builderMobile", "builderTradeLicence", "builderGST", 
        "builderAuth", "authLetter"
      );
    }
    
    const valid = await trigger(basicFields);
    return valid;
  };

  const validateDocuments = async () => {
    if (isViewMode) return true;
    const requiredFields = ['tonnageBooklets', 'stabilityBooklets', 'termsAccepted'];
    const constructedBy = getValues("constructedBy");
    
    if (constructedBy === "2") {
      requiredFields.push('authLetter');
    }
    
    let hasErrors = false;
    
    requiredFields.forEach(fieldName => {
      const fieldValue = getValues(fieldName);
      
      if (!fieldValue || (fieldValue instanceof FileList && fieldValue.length === 0)) {
        setError(fieldName, {
          type: 'required',
          message: `${fieldName} is required`
        });
        hasErrors = true;
      }
    });
    
    return !hasErrors;
  };

  const supervisionAuthority = methods.watch("supervisionAuthority");

  const handleChallanUpload = (e) => {
    setChallanFile(e.target.files?.[0] || null);
  };

  const handleOnlinePay = () => {
    setIsLoading(true);
    setShowModal(false);
   
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  const handleOfflineSubmit = () => {
    setShowModal(false);
    setIsLoading(true);
    
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  const steps = [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={isViewMode} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateDocuments,
    },
    {
      label: t("Invoicing"),
      component: (
        <Invoicing
          supervisionAuthority={supervisionAuthority}
          onPayNow={() => setShowModal(true)}
        />
      ),
      validate: () => true,
    },
  ];

  const handleSave = () => {
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {isLoading ? (
        <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
          <div className="text-center">
            <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
              <span className="visually-hidden">Loading...</span>
            </div>
            <p className="mt-3">Processing your request...</p>
          </div>
        </div>
      ) : (
        <>
          <Stack spacing={0.5}>
            <Typography
              sx={{
                fontWeight: 550,
                color: "#2E57A7",
                fontSize: "1.2rem",
              }}
            >
             {isViewMode ? t("View Vessel Registration") + ` - ${id}` : 
              isEditMode ? t("Edit Vessel Registration") + ` - ${id}` : t("New Vessel Registration")}
              &nbsp;
              <span style={{ color: "#666", fontSize: "0.65rem" }}>
                {isViewMode ? t("(View vessel registration details)") :
                 isEditMode ? t("(Update vessel registration details)") : t("(Fill in the vessel details to complete registration)")}
              </span>
            </Typography>
          </Stack>
          <Stepper steps={steps} onSave={handleSave} viewMode={isViewMode} />
          {!isViewMode && (
            <PaymentModal
              show={showModal}
              onHide={() => setShowModal(false)}
              paymentMode={paymentMode}
              setPaymentMode={setPaymentMode}
              challanFile={challanFile}
              onChallanUpload={handleChallanUpload}
              onOnlinePay={handleOnlinePay}
              onOfflineSubmit={handleOfflineSubmit}
              isLoading={isLoading}
              formMethods={methods}
            />
          )}
        </>
      )}
    </Box>
  );
};

export default NewVesselRegistration;
import React, { useState, useEffect, useRef } from "react";
import { useForm } from "react-hook-form";
import { Row, Col, Button } from "react-bootstrap";
import InputText from "../../../common/InputText.tsx";
import InputSelect from "../../../common/InputSelect.tsx";
import InputRadio from "../../../common/InputRadio.tsx";
import InputFile from "../../../common/InputFile.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import { renameFile } from "../../../../utils/constants.ts";
import { BsDownload } from "react-icons/bs";

const VesselDetails = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [formData, setFormData] = useState({});
  
  // const defaultValues = {
  //   ownerName: "",
  //   ownerAddress: "",
  //   mobile: "",
  //   email: "",
  //   pan: "",
  //   aadhar: "",
  //   tradeLicence: "",
  //   gst: "",
  //   grt: "",
  //   workOrderValue: "",
  //   vesselType: "",
  //   category: "",
  //   zone: "",
  //   supervisionAuthority: "",
  //   purchaseType: "",
  //   classificationSociety: "",
  //   constructedBy: "",
  //   builder: "",
  //   builderName: "",
  //   builderAddress: "",
  //   builderEmail: "",
  //   builderMobile: "",
  //   builderTradeLicence: "",
  //   builderGST: "",
  //   builderAuth: "",
  //   authLetter: "",
  //   termsAccepted: false,
  //   tonnageBooklets: null,
  //   stabilityBooklets: null,
  // };

  // const internalFormMethods = useForm({
  //   defaultValues,
  //   mode: "onTouched",

  // });

  // const methods = formMethods || internalFormMethods;
  
  const isCompMount = useRef(true);

  const {
    register,
    watch,
    setValue,
    clearErrors,
    trigger,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");
  const category = watch("category");

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [changeLanguage]);

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  useEffect(() => {
    if (category === "A") {
      setValue("zone", "1", { shouldValidate: true });
      setValue("supervisionAuthority", "classificationSociety", { shouldValidate: true });
      clearErrors("zone");
      clearErrors("supervisionAuthority");
    }
  }, [category, setValue, clearErrors]);

  const handleDownload = (fileName) => {
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
  };

  const DocumentViewCard = ({ fileName, onDownload }) => (
    <div className="mb-2 p-2 border rounded" style={{ backgroundColor: "#f8f9fa" }}>
      <div className="d-flex justify-content-between align-items-center">
        <div className="flex-grow-1">
          <strong className="text-primary small">{fileName}</strong>
        </div>
        <Button
          variant="outline-primary"
          size="sm"
          onClick={() => onDownload(fileName)}
        >
          <BsDownload size={14} />
        </Button>
      </div>
    </div>
  );

  const formFields = {
    basicInfo: [
      {
        name: 'ownerName',
        label: t('Name of Owner'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Name of Owner'),
        validation: { required: t('Name is required') }
      },
      {
        name: 'ownerAddress',
        label: t('Address of Owner'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Address of Owner'),
        validation: { required: t('Address is required') }
      },
      {
        name: 'mobile',
        label: t('Mobile'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Mobile'),
        validation: { required: t('Mobile is required') }
      },
      {
        name: 'email',
        label: t('Email Id'),
        type: 'email',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Email Id'),
        validation: { required: t('Email is required') }
      },
      {
        name: 'pan',
        label: t('PAN'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter PAN'),
        validation: { required: t('PAN is required') }
      },
      {
        name: 'aadhar',
        label: t('Aadhar'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Aadhar'),
        validation: { required: t('Aadhar is required') }
      },
      {
        name: 'tradeLicence',
        label: t('Trade Licence'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Trade Licence'),
        validation: { required: t('Trade Licence is required') }
      },
      {
        name: 'gst',
        label: t('GST'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GST'),
        validation: { required: t('GST is required') }
      },
      {
        name: 'grt',
        label: t('Gross Tonnage (GRT)'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GRT'),
        validation: { required: t('GRT is required') }
      },
      {
        name: 'workOrderValue',
        label: t('Work Order Value'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Enter Work Order Value'),
        validation: {
          required: t('Work Order Value is required'),
          pattern: {
            value: /^[0-9]+$/,
            message: t('Please enter a valid number')
          }
        }
      },
      {
        name: 'vesselType',
        label: t('Type of Vessel'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'new', label: t('New Vessel') },
          { value: 'old', label: t('Old Vessel') }
        ],
        validation: { required: t('vesselType is required') }
      },
      {
        name: 'category',
        label: t('Category'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'A', label: t('Category A') },
          { value: 'B', label: t('Category B') },
          { value: 'C', label: t('Category C') }
        ],
        validation: { required: t('category is required') }
      },
      {
        name: 'zone',
        label: t('Zone'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: '1', label: t('Zone 1') },
          { value: '2', label: t('Zone 2') },
          { value: '3', label: t('Zone 3') }
        ],
        validation: { required: category !== "A" && t('zone is required') },
        disabled: category === "A"
      },
      {
        name: 'supervisionAuthority',
        label: t('Supervision Authority'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'iwt', label: t('IWT') },
          { value: 'classificationSociety', label: t('Classification Society') }
        ],
        validation: { required: category !== "A" && t('Supervision Authority is required') },
        disabled: category === "A"
      },
      {
        name: 'purchaseType',
        label: t('Purchase Type'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'new', label: t('New') },
          { value: 'used', label: t('Used') }
        ],
        validation: { required: t('Purchase Type is required') }
      },
      {
        name: 'classificationSociety',
        label: t('Name of the Classification Society'),
        type: 'text',
        required: false,
        colSize: 4,
        placeholder: t('Please enter Name of the Classification Society'),
        validation: {}
      },
      {
        name: 'constructedBy',
        label: t('Constructed By ?'),
        type: 'radio',
        required: true,
        colSize: 6,
        options: [
          { label: t('Self'), value: '1' },
          { label: t('Builder'), value: '2' }
        ],
        validation: { required: t('Please select a Constructor Type') }
      },
      {
        name: 'builder',
        label: t('Builder'),
        type: 'select',
        required: true,
        colSize: 6,
        options: [
          { value: 'builder1', label: t('Builder 1') },
          { value: 'builder2', label: t('Builder 2') }
        ],
        showIf: () => constructedBy === "2",
        validation: { required: t('Builder is required') }
      }
    ],
    builderDetails: [
      {
        name: 'builderName',
        label: t('Builder Name'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Name'),
        validation: { required: t('Builder Name is required') }
      },
      {
        name: 'builderAddress',
        label: t('Builder Address'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Address'),
        validation: { required: t('Builder Address is required') }
      },
      {
        name: 'builderEmail',
        label: t('Builder Email Id'),
        type: 'email',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Email Id'),
        validation: {
          required: t('Builder Email is required'),
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: t('Invalid email address')
          }
        }
      },
      {
        name: 'builderMobile',
        label: t('Mobile'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Mobile'),
        validation: {
          required: t('Builder Mobile is required'),
          pattern: {
            value: /^[0-9]{10}$/,
            message: t('Invalid mobile number')
          }
        }
      },
      {
        name: 'builderTradeLicence',
        label: t('Trade Licence'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Trade Licence'),
        validation: { required: t('Builder Trade Licence is required') }
      },
      {
        name: 'builderGST',
        label: t('GST'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GST'),
        validation: { required: t('Builder GST is required') }
      },
      {
        name: 'builderAuth',
        label: t('Builder Authorization'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'auth', label: t('Authorized') },
          { value: 'rejected', label: t('Rejected') }
        ],
        validation: { required: t('Builder Authorization is required') }
      },
      {
        name: 'authLetter',
        label: t('Authorization Letter'),
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: t('Authorization Letter is required') }
      }
    ]
  };

  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'select':
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register(field.name, field.validation)}
            errors={errors}
            value={formData[field.name] || watch(field.name) || ""}
            onChange={(value) => {
              if (viewMode || field.disabled) return;
              setValue(field.name, value, { shouldValidate: true });
              clearErrors(field.name);
              setFormData(prev => ({
                ...prev,
                [field.name]: value
              }));
            }}
            disabled={viewMode || field.disabled}
          />
        );

      case 'file':
  if (viewMode) {
    const fileData = watch(field.name);
    if (fileData && fileData.name) {
      return (
        <div className="mb-3">
          <label className="form-label fw-bold">{field.label}</label>
          <DocumentViewCard
            fileName={fileData.name}
            onDownload={handleDownload}
          />
        </div>
      );
    }
    return null;
  }
  
  return (
    <div className="mb-2">
      <InputFile
        label={field.label}
        required={field.required}
        name={field.name}
        register={register(field.name, field.validation)}
        errors={errors}
        onChange={(e) => {
          if (viewMode) return;
          if (e.target.files && e?.target?.files[0]) {
            const file = e.target.files[0];
            
            const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
            if (!validTypes.includes(file.type)) {
              setError(field.name, {
                type: 'manual',
                message: t('Only PDF, JPG or PNG files are allowed')
              });
              setValue(field.name, null);
              return;
            }
            
            if (file.size > 10 * 1024 * 1024) {
              setError(field.name, {
                type: 'manual',
                message: t('File size should not exceed 10MB')
              });
              setValue(field.name, null);
              return;
            }
            
            const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
            const fileName = `${field.label}${extension}`;
            file.originalName = fileName;
            const renamedFile = renameFile(file, fileName);

            clearErrors(field.name);
            setValue(field.name, renamedFile, { shouldValidate: true });
            setFormData((prev) => ({
              ...prev,
              [field.name]: renamedFile
            }));
          }
        }}
        disabled={viewMode}
        watch={watch}
        defaultValue={watch(field.name)}
        clearErrors={clearErrors}
        accept=".pdf,.jpg,.jpeg,.png"
      />
    </div>
  );
      case 'radio':
        return (
          <InputRadio
            name={field.name}
            label={field.label}
            options={field.options}
            register={register}
            rules={field.validation}
            errors={errors}
            onChange={() => !viewMode && clearErrors(field.name)}
            disabled={viewMode}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field.name, field.validation)}
            onChange={handleChange}
            errors={errors}
            disabled={viewMode}
          />
        );
    }
  };

  return (
    <form autoComplete="off">
      <Collapsible title={t("Basic Information")} openStat={true}>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          {formFields.basicInfo.map((field, index) => (
            <Col key={index} md={field.colSize || 12}>
              <DynamicField field={field} />
            </Col>
          ))}
        </Row>
      </Collapsible>

      {constructedBy === "2" && (
        <Collapsible title={t("Builder Details")} openStat={true}>
          <Row className="gy-3" style={{ padding: "1rem" }}>
            {formFields.builderDetails.map((field, index) => (
              <Col key={index} md={field.colSize || 12}>
                <DynamicField field={field} />
              </Col>
            ))}
          </Row>
        </Collapsible>
      )}
    </form>
  );
};

export default VesselDetails;
import React, { useState, useEffect } from "react";
import { Row, Col, Button, ListGroup, Card } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile.tsx";
import InputText from "../../../common/InputText.tsx";
import { renameFile } from "../../../../utils/constants.ts";
import { BsDownload, BsFileEarmarkPdf, BsPlus, BsTrash } from "react-icons/bs";

const Documents = ({ formMethods, viewMode = false, editMode = false }) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  const [workOrderFiles, setWorkOrderFiles] = useState([{ id: 1 }]);
  const [drawingsFiles, setDrawingsFiles] = useState([{ id: 1 }]);
  
  const {
    register,
    watch,
    setValue,
    clearErrors,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  useEffect(() => {
    if (viewMode || editMode) {
      const workOrderIds = [];
      const drawingIds = [];
      
      for (let i = 1; i <= 50; i++) {
        const workOrderFile = getValues(`workOrder_file_${i}`);
        const drawingFile = getValues(`drawings_file_${i}`);
        
        if (workOrderFile && workOrderFile.name) {
          workOrderIds.push({ id: i });
        }
        if (drawingFile && drawingFile.name) {
          drawingIds.push({ id: i });
        }
      }
      
      if (workOrderIds.length > 0) setWorkOrderFiles(workOrderIds);
      if (drawingIds.length > 0) setDrawingsFiles(drawingIds);
    }
  }, [viewMode, editMode, getValues]);

  const DocumentCard = ({ fileName, description, onDownload, fileSize, onRemove, showRemove = false }) => (
    <Card className="mb-2 border-0 shadow-sm">
      <Card.Body className="p-3">
        <div className="d-flex justify-content-between align-items-center">
          <div className="d-flex align-items-center flex-grow-1">
            <div className="bg-danger bg-opacity-10 rounded-circle p-2 me-3">
              <BsFileEarmarkPdf className="text-danger" size={20} />
            </div>
            <div className="flex-grow-1">
              <h6 className="mb-1 text-primary fw-semibold" style={{ fontSize: "0.9rem" }}>
                {fileName}
              </h6>
              <p className="mb-0 text-muted small">
                {description}
                {fileSize && (
                  <span className="ms-2 badge bg-light text-dark">
                    {(fileSize / 1024 / 1024).toFixed(1)} MB
                  </span>
                )}
              </p>
            </div>
          </div>
          <div className="d-flex gap-2">
            <Button
              variant="outline-primary"
              size="sm"
              onClick={() => onDownload(fileName)}
              className="rounded-pill"
            >
              <BsDownload size={14} />
            </Button>
            {showRemove && (
              <Button
                variant="outline-danger"
                size="sm"
                onClick={onRemove}
                className="rounded-pill"
              >
                <BsTrash size={14} />
              </Button>
            )}
          </div>
        </div>
      </Card.Body>
    </Card>
  );

  const FileUploadCard = ({ label, name, onRemove, showRemove = false }) => (
    <Card className="mb-3 border-2 border-dashed border-primary border-opacity-25">
      <Card.Body className="p-3">
        <div className="mb-3">
          <InputFile
            label={label}
            name={name}
            register={register(name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                
                if (file.size > 10 * 1024 * 1024) {
                  setError(name, {
                    type: 'manual',
                    message: t('File size should not exceed 10MB')
                  });
                  return;
                }
                
                const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                const fileName = `Document${extension}`;
                file.originalName = fileName;
                const renamedFile = renameFile(file, fileName);

                clearErrors(name);
                setValue(name, renamedFile, { shouldValidate: true });
                setFormData((prev) => ({
                  ...prev,
                  [name]: renamedFile
                }));
              }
            }}
            watch={watch}
            defaultValue={watch(name)}
            clearErrors={clearErrors}
            accept=".pdf,.jpg,.jpeg,.png"
          />
        </div>
        <div className="mb-3">
          <InputText
            label={t("Description")}
            name={name.replace('_file_', '_desc_')}
            placeholder={t("Enter file description")}
            register={register}
            errors={errors}
            onChange={() => clearErrors(name.replace('_file_', '_desc_'))}
          />
        </div>
        {showRemove && (
          <div className="text-end">
            <Button
              variant="outline-danger"
              size="sm"
              onClick={onRemove}
              className="rounded-pill"
            >
              <BsTrash className="me-1" size={14} />
              Remove
            </Button>
          </div>
        )}
      </Card.Body>
    </Card>
  );

  const FileSection = ({ title, files, type, icon }) => {
    const filesWithData = files.filter(file => {
      const fileData = watch(`${type}_file_${file.id}`);
      return fileData && fileData.name;
    });

    return (
      <Card className="h-100 shadow-sm border-0">
        <Card.Header className="bg-light border-0 py-3">
          <div className="d-flex justify-content-between align-items-center">
            <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
              {icon}
              <span className="ms-2">{title}</span>
            </h5>
            <span className="badge bg-primary rounded-pill">
              {viewMode ? filesWithData.length : files.length} files
            </span>
          </div>
        </Card.Header>

        <Card.Body className="p-0">
          <div style={{ maxHeight: "500px", overflowY: "auto" }} className="p-3">
            {viewMode ? (
              filesWithData.length > 0 ? (
                filesWithData.map((fileInput) => {
                  const fileData = watch(`${type}_file_${fileInput.id}`);
                  const descData = watch(`${type}_desc_${fileInput.id}`);
                  
                  return (
                    <DocumentCard
                      key={fileInput.id}
                      fileName={fileData.name}
                      description={descData || `${title} document ${fileInput.id}`}
                      fileSize={fileData.size}
                      onDownload={() => handleDownload(fileData.name)}
                    />
                  );
                })
              ) : (
                <div className="text-center py-5 text-muted">
                  <div className="bg-light rounded-circle p-4 d-inline-flex mb-3">
                    <BsFileEarmarkPdf size={48} className="opacity-50" />
                  </div>
                  <p className="mb-0">No files uploaded</p>
                </div>
              )
            ) : (
              <>
                {files.map((fileInput, idx) => (
                  <FileUploadCard
                    key={fileInput.id}
                    label={`${t("Choose File")} ${idx + 1}`}
                    name={`${type}_file_${fileInput.id}`}
                    onRemove={() => removeFileInput(type, fileInput.id)}
                    showRemove={files.length > 1}
                  />
                ))}
              </>
            )}
          </div>
        </Card.Body>

        {!viewMode && (
          <Card.Footer className="bg-light border-0 text-center py-3">
            <Button
              variant="primary"
              size="sm"
              onClick={() => addFileInput(type)}
              className="rounded-pill px-4"
            >
              <BsPlus className="me-1" size={18} />
              Add {title}
            </Button>
          </Card.Footer>
        )}
      </Card>
    );
  };

  const SingleFileSection = ({ title, fileName, onDownload, fileSize, icon }) => (
    <Card className="h-100 shadow-sm border-0">
      <Card.Header className="bg-light border-0 py-3">
        <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
          {icon}
          <span className="ms-2">{title}</span>
        </h5>
      </Card.Header>
      <Card.Body className="p-3">
        {fileName ? (
          <DocumentCard
            fileName={fileName}
            description={`${title} document`}
            fileSize={fileSize}
            onDownload={() => onDownload(fileName)}
          />
        ) : (
          <div className="text-center py-4 text-muted">
            <div className="bg-light rounded-circle p-4 d-inline-flex mb-3">
              <BsFileEarmarkPdf size={32} className="opacity-50" />
            </div>
            <p className="mb-0">No file uploaded</p>
          </div>
        )}
      </Card.Body>
    </Card>
  );

  const addFileInput = (type) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      const newId = workOrderFiles.length > 0 ? Math.max(...workOrderFiles.map(f => f.id)) + 1 : 1;
      setWorkOrderFiles([...workOrderFiles, { id: newId }]);
    } else if (type === 'drawings') {
      const newId = drawingsFiles.length > 0 ? Math.max(...drawingsFiles.map(f => f.id)) + 1 : 1;
      setDrawingsFiles([...drawingsFiles, { id: newId }]);
    }
  };

  const removeFileInput = (type, id) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      setWorkOrderFiles(workOrderFiles.filter(file => file.id !== id));
    } else if (type === 'drawings') {
      setDrawingsFiles(drawingsFiles.filter(file => file.id !== id));
    }
    setValue(`${type}_file_${id}`, null);
    setValue(`${type}_desc_${id}`, "");
    clearErrors([`${type}_file_${id}`, `${type}_desc_${id}`]);
  };

  const handleDownload = (fileName) => {
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
  };

  return (
    <div>
      <Collapsible title={t("Documents")} openStat={true}>
        <div style={{ padding: "2rem", backgroundColor: "#f8f9fa" }}>
          <Row className="g-4">
            <Col lg={6} md={12}>
              <FileSection
                title={t("Work Order")}
                files={workOrderFiles}
                type="workOrder"
                icon={<BsFileEarmarkPdf className="text-primary" />}
              />
            </Col>

            <Col lg={6} md={12}>
              <FileSection
                title={t("Drawings")}
                files={drawingsFiles}
                type="drawings"
                icon={<BsFileEarmarkPdf className="text-success" />}
              />
            </Col>

            <Col md={6}>
              {viewMode ? (
                <SingleFileSection
                  title={t('Tonnage Booklets')}
                  fileName={watch("tonnageBooklets")?.name}
                  fileSize={watch("tonnageBooklets")?.size}
                  onDownload={handleDownload}
                  icon={<BsFileEarmarkPdf className="text-warning" />}
                />
              ) : (
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-3">
                    <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
                      <BsFileEarmarkPdf className="text-warning me-2" />
                      {t('Tonnage Booklets')}
                    </h5>
                  </Card.Header>
                  <Card.Body className="p-3">
                    <InputFile
                      label={t('Tonnage Booklets')}
                      required={true}
                      name="tonnageBooklets"
                      register={register("tonnageBooklets")}
                      errors={errors}
                      onChange={(e) => {
                        if (e.target.files && e?.target?.files[0]) {
                          const file = e.target.files[0];
                          if (file.size > 10 * 1024 * 1024) {
                            setError("tonnageBooklets", {
                              type: 'manual',
                              message: t('File size should not exceed 10MB')
                            });
                            return;
                          }
                          const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                          const fileName = `Tonnage Booklets${extension}`;
                          file.originalName = fileName;
                          const renamedFile = renameFile(file, fileName);
                          clearErrors("tonnageBooklets");
                          setValue("tonnageBooklets", renamedFile, { shouldValidate: true });
                        }
                      }}
                      watch={watch}
                      accept=".pdf,.jpg,.jpeg,.png"
                      defaultValue={watch("tonnageBooklets")}
                      clearErrors={clearErrors}
                    />
                  </Card.Body>
                </Card>
              )}
            </Col>

            <Col md={6}>
              {viewMode ? (
                <SingleFileSection
                  title={t('Stability Booklets')}
                  fileName={watch("stabilityBooklets")?.name}
                  fileSize={watch("stabilityBooklets")?.size}
                  onDownload={handleDownload}
                  icon={<BsFileEarmarkPdf className="text-info" />}
                />
              ) : (
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-3">
                    <h5 className="mb-0 text-primary fw-bold d-flex align-items-center">
                      <BsFileEarmarkPdf className="text-info me-2" />
                      {t('Stability Booklets')}
                    </h5>
                  </Card.Header>
                  <Card.Body className="p-3">
                    <InputFile
                      label={t('Stability Booklets')}
                      required={true}
                      name="stabilityBooklets"
                      register={register("stabilityBooklets")}
                      errors={errors}
                      onChange={(e) => {
                        if (e.target.files && e?.target?.files[0]) {
                          const file = e.target.files[0];
                          if (file.size > 10 * 1024 * 1024) {
                            setError("stabilityBooklets", {
                              type: 'manual',
                              message: t('File size should not exceed 10MB')
                            });
                            return;
                          }
                          const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                          const fileName = `Stability Booklets${extension}`;
                          file.originalName = fileName;
                          const renamedFile = renameFile(file, fileName);
                          clearErrors("stabilityBooklets");
                          setValue("stabilityBooklets", renamedFile, { shouldValidate: true });
                        }
                      }}
                      watch={watch}
                      accept=".pdf,.jpg,.jpeg,.png"
                      defaultValue={watch("stabilityBooklets")}
                      clearErrors={clearErrors}
                    />
                  </Card.Body>
                </Card>
              )}
            </Col>

            <Col md={12}>
              <Card className="shadow-sm border-0">
                <Card.Body className="p-4">
                  <div className="d-flex align-items-start">
                    <input
                      type="checkbox"
                      id="termsAccepted"
                      className="me-3 mt-1"
                      {...register("termsAccepted", { required: t('You must accept the terms and conditions') })}
                      disabled={viewMode}
                      checked={viewMode ? watch("termsAccepted") : undefined}
                    />
                    <div>
                      <label
                        htmlFor="termsAccepted"
                        className="mb-0 fw-medium"
                        style={{ color: "#333", cursor: viewMode ? "default" : "pointer", lineHeight: "1.5" }}
                      >
                        {t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.')}
                      </label>
                      {errors.termsAccepted && !viewMode && (
                        <div className="text-danger small mt-2">
                          {errors.termsAccepted.message}
                        </div>
                      )}
                    </div>
                  </div>
                </Card.Body>
              </Card>
            </Col>
          </Row>
        </div>
      </Collapsible>
    </div>
  );
};

export default Documents;

import React, { useState } from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

const themeColor = "#2E57A7";
const successColor = "#28a745";

const Stepper = ({ steps, onSave, viewMode = false }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [activeStep, setActiveStep] = useState(0);
  const [completed, setCompleted] = useState({});
  const [errors, setErrors] = useState({});

  const totalSteps = steps.length;

  const handleNext = async () => {
    if (viewMode) {
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
      return;
    }
    
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
      } else {
        toast.error("Please fix the errors before proceeding.");
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
    }
  };

  const handleBack = () => {
    setActiveStep((prev) => Math.max(prev - 1, 0));
  };

  const handleSave = async () => {
    if (viewMode) return;
    
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        if (activeStep < totalSteps - 1) {
          setActiveStep((prev) => prev + 1);
        } else {
          onSave();
        }
      } else {
        toast.error("Please fix the errors before proceeding.");
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      if (activeStep < totalSteps - 1) {
        setActiveStep((prev) => prev + 1);
      } else {
        onSave();
      }
    }
  };

  const handlePayNow = () => {
    if (
      steps[activeStep] &&
      steps[activeStep].component &&
      typeof steps[activeStep].component.props.onPayNow === "function"
    ) {
      steps[activeStep].component.props.onPayNow();
    }
  };

  return (
    <Box sx={{ width: "100%", padding: "1rem" }}>
      <Paper
        elevation={3}
        sx={{
          padding: "0.75rem 1.5rem",
          borderRadius: "0.75rem",
          overflowX: "auto",
          whiteSpace: "nowrap",
          backgroundColor: "#fafafa",
        }}
      >
        <Stack direction="row" alignItems="center" spacing={1}>
          {steps.map((step, index) => (
            <React.Fragment key={index}>
              <Stack
                direction="row"
                alignItems="center"
                spacing={0.5}
                sx={{ cursor: "pointer" }}
                onClick={() => setActiveStep(index)}
              >
                {completed[index] ? (
                  <CheckCircleFill size={18} color={successColor} />
                ) : (
                  <Typography
                    sx={{
                      fontSize: "0.875rem",
                      width: "1.5rem",
                      height: "1.5rem",
                      textAlign: "center",
                      borderRadius: "50%",
                      backgroundColor: "#e0e0e0",
                      display: "inline-flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: "bold",
                      color: "#666",
                    }}
                  >
                    {index + 1}
                  </Typography>
                )}
                <Typography
                  sx={{
                    fontWeight: index === activeStep ? "bold" : "normal",
                    color: index === activeStep ? themeColor : "#999",
                    fontSize: "0.875rem",
                    whiteSpace: "nowrap",
                  }}
                >
                  {step.label}
                </Typography>
              </Stack>
              {index < steps.length - 1 && <ChevronRight size={14} color="#ccc" />}
            </React.Fragment>
          ))}
        </Stack>
      </Paper>

      <Paper
        elevation={2}
        sx={{
          marginTop: "1rem",
          borderRadius: "0.75rem",
          backgroundColor: "#fff",
          width: "100%",
        }}
      >
        {steps[activeStep].component}
        {errors[activeStep]}
      </Paper>

      {!viewMode && (
        <>
          <Divider sx={{ margin: "2rem 0" }} />

          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              gap: "1rem",
              flexWrap: "wrap",
            }}
          >
            <Button
              variant="outlined"
              onClick={handleBack}
              disabled={activeStep === 0}
              sx={{
                color: themeColor,
                borderColor: themeColor,
                fontWeight: "bold",
                borderRadius: "0.5rem",
                minWidth: "8rem",
                fontSize: "0.9rem",
              }}
            >
              {t("Previous")}
            </Button>
            
            {activeStep === totalSteps - 1 ? (
              <Button
                variant="contained"
                onClick={handlePayNow}
                sx={{
                  backgroundColor: themeColor,
                  fontWeight: "bold",
                  borderRadius: "0.5rem",
                  minWidth: "8rem",
                  fontSize: "0.9rem",
                  color: "#fff",
                  "&:hover": {
                    backgroundColor: "#1f4ea0",
                  },
                }}
              >
                {t("Pay Now")}
              </Button>
            ) : (
              <Button
                variant="contained"
                onClick={activeStep === 1 ? handleSave : handleNext}
                sx={{
                  backgroundColor: themeColor,
                  fontWeight: "bold",
                  borderRadius: "0.5rem",
                  minWidth: "8rem",
                  fontSize: "0.9rem",
                  color: "#fff",
                  "&:hover": {
                    backgroundColor: "#1f4ea0",
                  },
                }}
              >
                {activeStep === 1 ? t("Save & Next") : t("Next")}
              </Button>
            )}
          </Box>
        </>
      )}
      
      {viewMode && (
        <>
          <Divider sx={{ margin: "2rem 0" }} />
          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              gap: "1rem",
              flexWrap: "wrap",
            }}
          >
            <Button
              variant="outlined"
              onClick={handleBack}
              disabled={activeStep === 0}
              sx={{
                color: themeColor,
                borderColor: themeColor,
                fontWeight: "bold",
                borderRadius: "0.5rem",
                minWidth: "8rem",
                fontSize: "0.9rem",
              }}
            >
              {t("Previous")}
            </Button>
            
            <Button
              variant="contained"
              onClick={handleNext}
              disabled={activeStep === totalSteps - 1}
              sx={{
                backgroundColor: themeColor,
                fontWeight: "bold",
                borderRadius: "0.5rem",
                minWidth: "8rem",
                fontSize: "0.9rem",
                color: "#fff",
                "&:hover": {
                  backgroundColor: "#1f4ea0",
                },
              }}
            >
              {t("Next")}
            </Button>
          </Box>
        </>
      )}
    </Box>
  );
};

export default Stepper;
