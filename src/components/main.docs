// In the getSurveyDetails function, add this after setIntialSurveyData:
const getSurveyDetails = async (vesselId) => {
  try {
    loaderRef.current?.show();
    const apiUrl =
      SERVICE_BASE.IWT_SURVEY_SERVICE +
      URLS_ENDPOINT.SURVEY_SERVICE.SURVEY_SEARCH;

    const response = await postData(apiUrl, {
      iwtVesRegBasicDetailsTFk: [vesselId],
    });

    if (response?.status === 200 || response?.status === 201) {
      const surveyData = response?.data[0] || {};
      console.log("Survey data :", surveyData);

      setIntialSurveyData(surveyData);
      
      // Add actions to registrationData if officer login
      if (isOfficerLogin && surveyData?.processActionMapResponce) {
        let actionsItems = surveyData?.processActionMapResponce?.[0]?.processs?.[0]?.actions ?? [];
        if (actionsItems?.length > 0) {
          setActionsFromAPI(actionsItems);
        }
      }
      
      populateFormWithSurveyData(surveyData);
    } else {
      toast.error(
        response?.data?.responseStatus?.message ||
        "Failed to fetch survey details."
      );
    }
  } catch (err) {
    handleErrorMessage(
      err?.response?.data ||
      "Failed to fetch survey details. Check console for details."
    );
  } finally {
    loaderRef?.current?.hide();
  }
};

// Update the Stepper component call:
<Stepper
  ref={stepperRef}
  steps={steps}
  onSave={handleSave}
  actionComponent={actionDropdown}
  viewMode={isViewMode}
  onSyncData={handleFormSubmit}
  onPayNow={handlePayNow}
  displayProvision={userRole === USER_ROLES?.OFFICER_L3}
  handleProvisionModalOpen={handleProvisionModalOpen}
  showOfficerActions={isOfficerLogin && actionsFromAPI?.length > 0}
/>
