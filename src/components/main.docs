// Update the validateDocuments function
const validateDocuments = async () => {
  if (isViewMode) return true;

  const requiredFields = [];
  const grossTonnage = getValues("grossTonnage");

  // Check tonnage booklets requirement
  const tonnageBooklets = getValues("tonnageBooklets");
  const isTonnageRequired = editMode ? 
    !!(id || grossTonnage) : // In edit mode with ID, assume file exists
    !!(grossTonnage && grossTonnage.trim() !== "");

  if (isTonnageRequired && !tonnageBooklets) {
    requiredFields.push("tonnageBooklets");
  }

  // Check stability booklets requirement
  const stabilityBooklets = getValues("stabilityBooklets");
  const isStabilityRequired = editMode ? 
    !!(id || grossTonnage) : // In edit mode with ID, assume file exists
    !!(grossTonnage && grossTonnage.trim() !== "");

  if (isStabilityRequired && !stabilityBooklets) {
    requiredFields.push("stabilityBooklets");
  }

  // Terms acceptance is always required
  const termsAccepted = getValues("termsAccepted");
  if (!termsAccepted) {
    requiredFields.push("termsAccepted");
  }

  let hasErrors = false;

  requiredFields.forEach((fieldName) => {
    const fieldValue = getValues(fieldName);

    if (!fieldValue || (fieldValue instanceof FileList && fieldValue.length === 0)) {
      setError(fieldName, {
        type: "required",
        message: `${fieldName} is required`,
      });
      hasErrors = true;
    }
  });

  return !hasErrors;
};

// Update the Documents step to pass the id
{
  label: t("vesselDetails.Documents"),
  component: (
    <Documents
      formMethods={methods}
      viewMode={isViewMode}
      editMode={isEditMode}
      id={id} // Pass the ID to Documents component
    />
  ),
  validate: validateDocuments,
  getFormData: () => methods?.getValues(),
  goToNextStepNoValidtion : true
},
