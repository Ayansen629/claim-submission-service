import React, { act } from "react";
import { Card, Badge, Button } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { BsCheckCircleFill, BsClock, BsXCircleFill, BsDownload, BsCreditCard } from "react-icons/bs";
import ActionTable from "../../../common/ActionTable.tsx";

const PaymentDetailsView = ({ supervisionAuthority, formData }) => {
  const { t } = useTranslation();

  // Payment table data
  const paymentTableData = [
    {
      id: 1,
      paymentId: "PAY-2024-001",
      status: "paid",
      paymentDate: "2024-01-16",
      receipt: "receipt_001.pdf"
    },
    {
      id: 2,
      paymentId: "PAY-2024-002", 
      status: "pending",
      paymentDate: "2024-01-20",
      receipt: "receipt_002.pdf"
    },
    {
      id: 3,
      paymentId: "PAY-2024-003", 
      status: "failed",
      paymentDate: "2024-01-18",
      receipt: "receipt_003.pdf"
    }
  ];

  // Payment table columns
  const paymentColumns = [
    {
      colName: t("Payment ID"),
      fieldName: "paymentId",
      clsName: "column-text-start",
      render: (value) => (
        <span className="fw-semibold text-primary">{value}</span>
      )
    },
    {
      colName: t("Status"),
      fieldName: "status",
      clsName: "column-text-center",
      render: (value) => getStatusBadge(value)
    },
    {
      colName: t("Payment Date"),
      fieldName: "paymentDate",
      clsName: "column-text-center",
      render: (value) => (
        <span className="fw-medium">{value}</span>
      )
    },
    {
      colName: t("Receipt"),
      fieldName: "receipt",
      clsName: "column-text-center",
    // render: (value) => (
    //     <span className="fw-medium">{value}</span>
    //   )
    
    },
  //       {
  //   colName: "Action",
  //   fieldName: "action",
  //   actions: [
  //       'download'
     
  //   ],
  //   clsName: "col-sm-2 column-text-start actions-column",
  // },
  ];

const handleDownloadReciept= (rowData) => {
  console.log("Download receipt for row:", rowData.receipt);
}

  const getStatusBadge = (status) => {
    switch (status) {
      case 'paid':
        return (
          <Badge 
            className="d-flex align-items-center gap-2 px-3 py-2 rounded-pill"
            style={{ 
              background: "linear-gradient(135deg, #28a745 0%, #20c997 100%)",
              border: "none",
              fontSize: "0.8rem",
              fontWeight: "600"
            }}
          >
            <BsCheckCircleFill size={12} /> {t("Paid")}
          </Badge>
        );
      case 'pending':
        return (
          <Badge 
            className="d-flex align-items-center gap-2 px-3 py-2 rounded-pill"
            style={{ 
              background: "linear-gradient(135deg, #ffc107 0%, #fd7e14 100%)",
              border: "none",
              fontSize: "0.8rem",
              fontWeight: "600",
              color: "white"
            }}
          >
            <BsClock size={12} /> {t("Pending")}
          </Badge>
        );
      case 'failed':
        return (
          <Badge 
            className="d-flex align-items-center gap-2 px-3 py-2 rounded-pill"
            style={{ 
              background: "linear-gradient(135deg, #dc3545 0%, #e83e8c 100%)",
              border: "none",
              fontSize: "0.8rem",
              fontWeight: "600"
            }}
          >
            <BsXCircleFill size={12} /> {t("Failed")}
          </Badge>
        );
      default:
        return <Badge bg="secondary">{t("Unknown")}</Badge>;
    }
  };

  return (
    <div className="container py-4">
      <Card className="shadow-lg border-0" style={{ borderRadius: "15px", overflow: "hidden" }}>
        <Card.Header 
          className="text-white py-4 d-flex align-items-center"
          style={{ 
            background: "linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%)",
            borderBottom: "none"
          }}
        >
          <BsCreditCard size={24} className="me-3" />
          <div>
            <h4 className="mb-1 fw-bold text-white">{t("Payment Details")}</h4>
            <p className="mb-0 text-white-50">{t("View and download payment receipts")}</p>
          </div>
        </Card.Header>
        
        <Card.Body className="p-0" style={{ background: "#f8f9fa" }}>
          <div className="p-4">
            <ActionTable
              columns={paymentColumns}
              rowData={paymentTableData}
              onDownloadReceipt={handleDownloadReciept}
              tableHeader={null}
              hideExportBtn={true}
              hideSearchBar={true}
              pagination={true}
              itemsInboxPerPage={10}
              tableClassName="table-hover"
              noDataText={
                <div className="text-center py-5 text-muted">
                  <BsCreditCard size={48} className="mb-3 opacity-25" />
                  <h6 className="mb-2">{t("No Payment Records")}</h6>
                  <p className="mb-0">{t("No payment transactions found for this registration")}</p>
                </div>
              }
            />
          </div>
        </Card.Body>
      </Card>
    </div>
  );
};

export default PaymentDetailsView;
