                          placeholder={t("addEmployee.Select Department")}
                          options={
                            masterData?.departments?.map((type) => ({
                              value: type.valueCode,
                              label: type.valueLabel,
                            })) || []
                          }
                          register={register("department", {
                            required: t("addEmployee.Department is required"),
                          })}
                          errors={errors}
                          value={watch("department") || ""}
                          onChange={(val) =>
                            setValue("department", val, { shouldValidate: true })
                          }
                        />
                      </Col>
                      <Col md={4}>
                        <InputText
                          name="section"
                          label={t("addEmployee.Section")}
                          placeholder={t("addEmployee.Enter section")}
                          register={{
                            ...register("section"),
                          }}
                          errors={errors}
                        />
                      </Col>
                      <Col md={4}>
                        <InputSelect
                          name="roles"
                          label={t("addEmployee.Roles")}
                          required={true}
                          placeholder={t("addEmployee.Select role")}
                          options={
                            masterData?.roles?.map((type) => ({
                              value: type.valueCode,
                              label: type.valueLabel,
                            })) || []
                          }
                          register={register("roles", {
                            required: t("addEmployee.Role is required"),
