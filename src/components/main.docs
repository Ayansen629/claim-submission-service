                type="number"
                placeholder={t("Enter quantity")}
                register={register("navigationEquipment.gpsNavigator")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Binocular")}
                name="navigationEquipment.binocular"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("navigationEquipment.binocular")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Aldis lamp or search light")}
                name="navigationEquipment.aldisLamp"
                type="number"
                placeholder={t("Enter quantity")}
                register={register("navigationEquipment.aldisLamp")}
                errors={errors}
                disabled={viewMode}
              />
