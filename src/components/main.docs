const buildSurveyPayload = (formData, registrationData) => {
  // Get current equipment data from form
  const currentEquipmentData = getValues("equipment") || {};
  const currentDeckSpaces = getValues("deckSpaces") || [];
  const currentFreeboard = getValues("freeboard") || {};

  // Transform current form equipment data to API format
  const transformEquipmentData = (equipmentData) => {
    const transformed = {};
    
    if (equipmentData) {
      Object.keys(equipmentData).forEach(equipmentId => {
        const equipmentCategories = equipmentData[equipmentId];
        Object.keys(equipmentCategories).forEach(categoryCode => {
          const categoryData = equipmentCategories[categoryCode];
          
          const equipment = masterData?.equipmentCategories?.find(eq => eq.id == equipmentId);
          const equipmentName = equipment?.equipmentName;
          
          if (equipmentName) {
            const equipmentKeyMap = {
              "Fire Fighting Items": "EquipmentFireFightingItems",
              "Equipments": "Equipments", 
              "Navigational Equipments": "EquipmentNavigationalEquipments",
              "Life-Saving Equipment": "EquipmentLifeSavingEquipment",
              "Machinery/Electrical": "EquipmentMachineryElectrical",
              "Accommodation/Safety": "EquipmentAccommodationSafety"
            };
            
            const apiKey = equipmentKeyMap[equipmentName];
            if (apiKey) {
              if (!transformed[apiKey]) {
                transformed[apiKey] = [];
              }
              
              transformed[apiKey].push({
                id: "",
                source: apiKey,
                surveyId: intialSurveyData?.surveyId || "",
                categoryCode: categoryCode,
                number: parseInt(categoryData.number) || 0,
                type: categoryData.type || "",
                location: categoryData.location || "",
                condition: categoryData.condition || "",
                remarks: categoryData.remarks || "",
                status: "ACTIVE",
                basicDetailsFk: "",
                auditDetails: null
              });
            }
          }
        });
      });
    }
    
    return transformed;
  };

  const transformDeckSpaces = (deckSpaces) => {
    if (!deckSpaces || !Array.isArray(deckSpaces)) return [];
    
    return deckSpaces.map(deck => ({
      id: "",
      iwtVesRegBasicDetailsTFk: registrationData?.vessel?.iwtVesselBasicDetailsTFk || "",
      surveyId: intialSurveyData?.surveyId || "",
      deckName: deck.deckType || "",
      spaceType: deck.deckType || "",
      maxPassengers: parseInt(deck.maxPassengers) || 0,
      sizeSqm: parseFloat(deck.size) || 0,
      function: deck.function || "",
      source: "Manual Entry",
      condition: "Good",
      remarks: deck.remarks || ""
    }));
  };

  const transformFreeboardData = (freeboard) => {
    if (!freeboard) return null;
    
    return {
      id: "",
      minimumFreeboard: parseFloat(freeboard.minFreeboard) || 0,
      numberOfPassengers: parseInt(freeboard.numPassengers) || 0,
      cargoTonnes: parseFloat(freeboard.cargo) || 0
    };
  };

  return {
    surveyId: intialSurveyData?.surveyId || "",
    BasicVesselInformation: {
      id: intialSurveyData?.BasicVesselInformation?.id || "",
      typeOfSurveyId: formData?.basicVesselInfo?.typeOfSurvey || "",
      placeYardNo: formData?.basicVesselInfo?.placeYardNo || "",
      netTonnage: parseFloat(formData?.basicVesselInfo?.netTonnage) || 0,
      agentsName: formData?.basicVesselInfo?.agentName || "",
      agentsAddress: formData?.basicVesselInfo?.agentAddress || "",
      agentsTelephone: formData?.basicVesselInfo?.agentTelephone || "",
      placeOfLastSurvey: formData?.basicVesselInfo?.placeOfLastSurvey || "",
      dateOfLastSurvey: formData?.basicVesselInfo?.dateOfLastSurvey || "",
      dateOfProposedVisitSurveyor: formData?.basicVesselInfo?.dateOfProposedVisit || "",
      iwtVesRegBasicDetailsTFk: registrationData?.vessel?.iwtVesselBasicDetailsTFk || "",
      status: "ACTIVE",
      lengthOfVessel: formData?.basicVesselInfo?.lengthOfVessel || "",
      breadthOfVessel: formData?.basicVesselInfo?.breadthOfVessel || "",
      depthOfVessel: formData?.basicVesselInfo?.depthOfVessel || "",
      draft: formData?.basicVesselInfo?.draft || "",
      enableprovisonalsurveycert: formData?.provisionalCertificates.surveyCertificate || false,
      enableprovisonalregistrationcert: formData?.provisionalCertificates.registrationCertificate || false,
    },

    HullParticulars: {
      id: intialSurveyData?.HullParticulars?.id || "",
      frameMaterial: formData?.hullParticulars?.frameMaterial || "",
      frameThickness: parseFloat(formData?.hullParticulars?.frameThickness) || 0,
      floorMaterial: formData?.hullParticulars?.floorMaterial || "",
      hullMaterial: formData?.hullParticulars?.hullMaterial || "",
      hullPlatingThickness: parseFloat(formData?.hullParticulars?.hullPlattingThickness) || 0,
      keelLayingDate: formData?.hullParticulars?.keelLayingDate || "",
      iwtVesBasicSurveyDetTFk: intialSurveyData?.HullParticulars?.iwtVesBasicSurveyDetTFk || "",
      status: "ACTIVE",
      hullPlatingMaterial: formData?.hullParticulars?.hullPlatingMaterial || "",
      noOfBulkheads: parseInt(formData?.hullParticulars?.numberOfBulkheads) || 0,
      bulkheadPlacement: formData?.hullParticulars?.bulkheadPlacement || "",
      bulkheadThickness: parseFloat(formData?.hullParticulars?.bulkheadThickness) || 0,
      floorThickness: parseFloat(formData?.hullParticulars?.floorThickness) || 0,
    },

    RadioandNavigationEquipment: {
      id: intialSurveyData?.RadioandNavigationEquipment?.id || "",
      magneticCompass: parseInt(formData?.navigationEquipment?.magneticCompass) || 0,
      vhfRadio: parseInt(formData?.navigationEquipment?.vhfRadio) || 0,
      aisIdentifiSystem: parseInt(formData?.navigationEquipment?.classBAutoAIS) || 0,
      gps: parseInt(formData?.navigationEquipment?.gpsNavigator) || 0,
      binocular: parseInt(formData?.navigationEquipment?.binocular) || 0,
      aldisLamp: parseInt(formData?.navigationEquipment?.aldisLamp) || 0,
      rudderAngleIndicator: parseInt(formData?.navigationEquipment?.rudderAngleIndicator) || 0,
      others: parseInt(formData?.navigationEquipment?.othersNavigation) || 0,
      iwtVesBasicSurveyDetTFk: intialSurveyData?.RadioandNavigationEquipment?.iwtVesBasicSurveyDetTFk || "",
      status: "ACTIVE",
    },

    PollutionControlDevices: {
      id: intialSurveyData?.PollutionControlDevices?.id || "",
      bilgeWaterSeperator: parseInt(formData?.polutionControl?.bilgeWaterSeparator) || 0,
      capacity: formData?.polutionControl?.bilgeCapacity || "",
      makeModel: formData?.polutionControl?.bilgeMakeModel || "",
      stp: parseInt(formData?.polutionControl?.sewageTreatmentPlant) || 0,
      stpCapacity: formData?.polutionControl?.sewageCapacity || "",
      stpMakeModel: formData?.polutionControl?.sewageMakeModel || "",
      owf: parseInt(formData?.polutionControl?.oilyWaterFilter) || 0,
      owfCapacity: formData?.polutionControl?.oilyCapacity || "",
      owfMakeModel: formData?.polutionControl?.oilyMakeModel || "",
      egasCleaningSystm: parseInt(formData?.polutionControl?.exhaustGasCleaning) || 0,
      egasCleaningSystmCapacity: formData?.polutionControl?.exhaustCapacity || "",
      egasCleaningSystmMakeModel: formData?.polutionControl?.exhaustMakeModel || "",
      other: parseInt(formData?.polutionControl?.othersPollution) || 0,
      otherCapacity: formData?.polutionControl?.othersCapacity || "",
      otherMakeModel: formData?.polutionControl?.othersMakeModel || "",
      status: "ACTIVE",
      iwtVesBasicSurveyDetTFk: intialSurveyData?.PollutionControlDevices?.iwtVesBasicSurveyDetTFk || "",
    },

    CrewDetails: extractCrewDetails(formData?.crewDetails?.crewDetails),
    equipmentInventoryDetails: null,
    Enclosure: extractEnclosures(
      formData?.enclosure,
      registrationData?.applicationNumber || registrationData?.vessel?.applicationNumber || "",
      intialSurveyData?.Enclosure || []
    ),

    DetailsofPropulsionofEngine: {
      id: intialSurveyData?.DetailsofPropulsionofEngine?.id || "",
      yearOfBuild: formData?.basicVesselInfo?.yearOfBuild || "",
      engineType: formData?.detailsOfPropulsion?.typeOfEngine || "",
      engineMake: formData?.detailsOfPropulsion?.engineMake || "",
      makerAddress: formData?.detailsOfPropulsion?.engineMakerAddress || "",
      pin: registrationData?.engine?.pin || "",
      mobile: registrationData?.engine?.mobile || "",
      email: registrationData?.engine?.email || "",
      horsepower: parseInt(formData?.detailsOfPropulsion?.horsepower) || 0,
      speed: parseInt(formData?.detailsOfPropulsion?.speedRPM) || 0,
      yearOfMake: formData?.detailsOfPropulsion?.yearOfMake || "",
      applRegistrationTFk: registrationData?.vessel?.iwtVesselBasicDetailsTFk || "",
      modelNo: formData?.detailsOfPropulsion?.modelNo || "",
      noOfSet: formData?.detailsOfPropulsion?.numberOfSetFitted || null,
      numberOfEngine: parseInt(formData?.detailsOfPropulsion?.numberOfEngine) || 0,
      setSerialNo: formData?.detailsOfPropulsion?.setSrNo || "",
      propellerType: formData?.detailsOfPropulsion?.propellerType || "",
      gearType: formData?.detailsOfPropulsion?.gearType || "",
      noOfGear: formData?.detailsOfPropulsion?.noOfGear || null,
      vesselSpeed: formData?.detailsOfPropulsion?.vesselSpeed || null,
      rpm: formData?.detailsOfPropulsion?.revolutionMints || null,
      engineCylinder: formData?.detailsOfPropulsion?.engineCylinderDiameter || null,
      stroke: formData?.detailsOfPropulsion?.strokeEngine || null,
      iwtVesBasicSurveyDetTFk: intialSurveyData?.DetailsofPropulsionofEngine?.iwtVesBasicSurveyDetTFk || "",
    },

    // Include equipment data from step 2
    SurveyEquipments: transformEquipmentData(currentEquipmentData),
    passengerDistributionMaxLoad: transformDeckSpaces(currentDeckSpaces),
    vesselFreeboardData: transformFreeboardData(currentFreeboard)
  };
};
