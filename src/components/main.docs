import React, { useState, useEffect } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams, useLocation, useNavigate } from "react-router-dom";
import Stepper from "../../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import Documents from "./Documents.js";
import NoteSheet from "./NoteSheet.js";
import { useForm } from "react-hook-form";
import Invoicing from "../../../common/Invoicing.js";
import PaymentModal from "../../../common/PaymentModal.js"; 
import ActionDropdown from "../../../common/ActionDropdown";
import ApprovalModal from "../../../common/ApprovalModal";
import NewVesselRegistrationSuccess from "./newVesselRegistrationSuccess.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import { toast } from "react-toastify";
import { Button } from "react-bootstrap";
import { BsSticky } from "react-icons/bs";
import PaymentDetailsView from "./paymentDetailsView.js";

const NewVesselRegistration = () => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const { id } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  
  const isEditMode = !!id && location.pathname.includes('/edit/');
  const isViewMode = !!id && location.pathname.includes('/view/');
  const isNormalMode = !isEditMode && !isViewMode;
  
  const methods = useForm({ mode: "onTouched" });
  const { trigger, getValues, setError, setValue, reset } = methods;

  const [showModal, setShowModal] = useState(false);
  const [paymentMode, setPaymentMode] = useState("offline");
  const [challanFile, setChallanFile] = useState(null);
  const [isLoading, setIsLoading] = useState(false);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [showNoteSheet, setShowNoteSheet] = useState(false);

  const actionsFromAPI = ["Approve", "Reject", "Request Changes"];

  const initialNotes = [
    { id: 1, title: "Initial Review", content: "Document verification completed successfully. All required documents are present and properly formatted.", date: "2024-01-15", author: "John Doe" },
    { id: 2, title: "Technical Assessment", content: "All technical drawings have been reviewed and approved by the engineering team.", date: "2024-01-16", author: "Jane Smith" }
  ];

  const staticData = {
    ownerName: "John Doe",
    ownerAddress: "123 Main Street, Harbor City, State 12345",
    mobile: "9876543210",
    email: "john.doe@example.com",
    pan: "ABCDE1234F",
    aadhar: "123456789012",
    tradeLicence: "TL123456789",
    gst: "GST123456789012",
    grt: "500",
    workOrderValue: "1000000",
    vesselType: "new",
    category: "A",
    zone: "1",
    supervisionAuthority: "classificationSociety",
    purchaseType: "new",
    classificationSociety: "Lloyd's Register Classification Society",
    constructedBy: "2",
    builder: "builder1",
    builderName: "ABC Marine Shipyard Pvt Ltd",
    builderAddress: "456 Port Road, Shipyard Complex, Harbor City 54321",
    builderEmail: "contact@abcshipyard.com",
    builderMobile: "9876543211",
    builderTradeLicence: "BTL789012345",
    builderGST: "BGST987654321098",
    builderAuth: "auth",
    termsAccepted: true,
    
    // Work Order Files (50 files)
    ...Array.from({ length: 50 }, (_, i) => ({
      [`workOrder_file_${i + 1}`]: { 
        name: `WorkOrder_${String(i + 1).padStart(2, '0')}.pdf`, 
        size: Math.floor(Math.random() * 2000000) + 500000 
      },
      [`workOrder_desc_${i + 1}`]: `Work order document ${i + 1} - ${[
        'Main contract document',
        'Amendment and modifications',
        'Technical specifications',
        'Timeline and milestones',
        'Budget breakdown',
        'Quality requirements',
        'Safety protocols',
        'Environmental compliance',
        'Material specifications',
        'Equipment details'
      ][i % 10]}`
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    
    // Drawing Files (50 files)
    ...Array.from({ length: 50 }, (_, i) => ({
      [`drawings_file_${i + 1}`]: { 
        name: `Drawing_${String(i + 1).padStart(2, '0')}.pdf`, 
        size: Math.floor(Math.random() * 3000000) + 800000 
      },
      [`drawings_desc_${i + 1}`]: `Technical drawing ${i + 1} - ${[
        'General arrangement plan',
        'Hull structure details',
        'Machinery layout',
        'Electrical schematic',
        'Piping diagram',
        'Safety equipment layout',
        'Navigation equipment',
        'Interior arrangement',
        'Deck plan',
        'Cross-section view'
      ][i % 10]}`
    })).reduce((acc, curr) => ({ ...acc, ...curr }), {}),
    
    tonnageBooklets: { name: "Tonnage_Booklets.pdf", size: 512000 },
    stabilityBooklets: { name: "Stability_Booklets.pdf", size: 768000 },
    authLetter: { name: "Authorization_Letter.pdf", size: 256000 }
  };

  useEffect(() => {
    if (isNormalMode) {
      reset();
    } else if (isEditMode || isViewMode) {
      setTimeout(() => {
        Object.keys(staticData).forEach(key => {
          setValue(key, staticData[key]);
        });
      }, 100);
    }
  }, [isEditMode, isViewMode, isNormalMode, setValue, reset, location.pathname]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      comments: formData.comments,
    };
    
    console.log("Action submitted:", payload);
    toast.success(`${selectedAction} action submitted successfully`);
    
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const handleChallanUpload = (e) => {
    setChallanFile(e.target.files?.[0] || null);
  };

  const handleOnlinePay = () => {
    setIsLoading(true);
    setShowModal(false);
   
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  const handleOfflineSubmit = () => {
    setShowModal(false);
    setIsLoading(true);
    
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  const handlePayNow = () => {
    setShowModal(true);
  };

  // Validation functions
  const validateVesselDetails = async () => {
    if (isViewMode) return true;
    const basicFields = [
      "ownerName", "ownerAddress", "mobile", "email", "pan", 
      "aadhar", "tradeLicence", "gst", "grt", "workOrderValue",
      "vesselType", "category", "purchaseType", "constructedBy"
    ];
    
    const constructedBy = getValues("constructedBy");
    if (constructedBy === "2") {
      basicFields.push(
        "builderName", "builderAddress", "builderEmail", 
        "builderMobile", "builderTradeLicence", "builderGST", 
        "builderAuth"
      );
      
      const authLetter = getValues("authLetter");
      if (!authLetter && !isEditMode) {
        basicFields.push("authLetter");
      }
    }
    
    const valid = await trigger(basicFields);
    return valid;
  };

  const validateDocuments = async () => {
    if (isViewMode) return true;
    
    const requiredFields = [];
    
    const tonnageBooklets = getValues("tonnageBooklets");
    const stabilityBooklets = getValues("stabilityBooklets");
    const termsAccepted = getValues("termsAccepted");
    
    if (!tonnageBooklets && !isEditMode) {
      requiredFields.push('tonnageBooklets');
    }
    
    if (!stabilityBooklets && !isEditMode) {
      requiredFields.push('stabilityBooklets');
    }
    
    if (!termsAccepted) {
      requiredFields.push('termsAccepted');
    }
    
    let hasErrors = false;
    
    requiredFields.forEach(fieldName => {
      const fieldValue = getValues(fieldName);
      
      if (!fieldValue || (fieldValue instanceof FileList && fieldValue.length === 0)) {
        setError(fieldName, {
          type: 'required',
          message: `${fieldName} is required`
        });
        hasErrors = true;
      }
    });
    
    return !hasErrors;
  };

  const supervisionAuthority = methods.watch("supervisionAuthority");

  const steps = isViewMode ? [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateDocuments,
    },
    {
      label: t("Payment Details"),
      component: <PaymentDetailsView supervisionAuthority={supervisionAuthority} formData={methods.getValues()} />,
      validate: () => true,
    }
  ] : [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={isViewMode} editMode={isEditMode} />,
      validate: validateDocuments,
    },
    {
      label: t("Invoicing"),
      component: (
        <Invoicing
          supervisionAuthority={supervisionAuthority}
          onPayNow={handlePayNow}
        />
      ),
      validate: () => true,
    },
  ];

  const handleSave = () => {
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      navigate("/new-vessel/registration-success", { 
        state: { registrationId: "VR2024001" }
      });
    }, 1500);
  };

  const actionDropdown = isViewMode ? (
    <ActionDropdown
      actions={actionsFromAPI}
      onActionClick={handleActionClick}
      variant="contained"
      sx={{
        backgroundColor: "#2E57A7",
        fontWeight: "bold",
        borderRadius: "0.5rem",
        minWidth: "8rem",
        fontSize: "0.9rem",
        color: "#fff",
        "&:hover": {
          backgroundColor: "#1f4ea0",
        },
      }}
    />
  ) : null;

  return (
    <Box sx={{ padding: "1rem 0.5rem 0 0.5rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {isLoading ? (
        <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
          <div className="text-center">
            <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
              <span className="visually-hidden">Loading...</span>
            </div>
            <p className="mt-3">Processing your request...</p>
          </div>
        </div>
      ) : (
        <>
          {/* Header with Note Sheet Button - Responsive */}
          <div className="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
            <Stack spacing={0.5} className="flex-grow-1">
              <Typography
                sx={{
                  fontWeight: 550,
                  color: "#2E57A7",
                  fontSize: { xs: "1rem", sm: "1.1rem", md: "1.2rem" },
                  lineHeight: 1.2,
                }}
              >
               {isViewMode ? t("View Vessel Registration") + ` - ${id}` : 
                isEditMode ? t("Edit Vessel Registration") + ` - ${id}` : t("New Vessel Registration")}
              </Typography>
              <Typography
                sx={{
                  color: "#666",
                  fontSize: { xs: "0.6rem", sm: "0.65rem" },
                  lineHeight: 1.3,
                }}
              >
                {isViewMode ? t("(View vessel registration details)") :
                 isEditMode ? t("(Update vessel registration details)") : t("(Fill in the vessel details to complete registration)")}
              </Typography>
            </Stack>
            
            {/* Note Sheet Button - Only for View Mode */}
            {isViewMode && (
              <Button
                variant="primary"
                className="d-flex align-items-center shadow-sm flex-shrink-0"
                style={{
                  background: "linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%)",
                  border: "none",
                  borderRadius: "8px",
                  padding: "6px 12px",
                  fontSize: "0.8rem",
                  fontWeight: "600",
                  minWidth: "auto",
                  whiteSpace: "nowrap"
                }}
                onClick={() => setShowNoteSheet(true)}
              >
                <BsSticky className="me-1 me-sm-2" size={14} />
                <span className="d-none d-sm-inline">{t("Note Sheet")}</span>
                <span className="d-sm-none">{t("Notes")}</span>
              </Button>
            )}
          </div>
          
          <Stepper 
            steps={steps} 
            onSave={handleSave} 
            viewMode={isViewMode}
            actionComponent={actionDropdown}
            onPayNow={handlePayNow}
          />

          {/* Note Sheet Component */}
          <NoteSheet
            show={showNoteSheet}
            onHide={() => setShowNoteSheet(false)}
            initialNotes={initialNotes}
          />
          
          {!isViewMode && (
            <PaymentModal
              show={showModal}
              onHide={() => setShowModal(false)}
              paymentMode={paymentMode}
              setPaymentMode={setPaymentMode}
              challanFile={challanFile}
              onChallanUpload={handleChallanUpload}
              onOnlinePay={handleOnlinePay}
              onOfflineSubmit={handleOfflineSubmit}
              isLoading={isLoading}
              formMethods={methods}
            />
          )}
          
          {isViewMode && (
            <ApprovalModal
              show={showApprovalModal}
              handleClose={handleCloseModal}
              handleSubmitData={handleActionSubmit}
              selectedAction={selectedAction}
            />
          )}
        </>
      )}
    </Box>
  );
};

export default NewVesselRegistration;
import React, { useState, useEffect, useRef, useCallback } from "react";
import { useForm } from "react-hook-form";
import { Row, Col } from "react-bootstrap";
import InputText from "../../../common/InputText.tsx";
import InputSelect from "../../../common/InputSelect.tsx";
import InputRadio from "../../../common/InputRadio.tsx";
import InputFile from "../../../common/InputFile.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import { renameFile } from "../../../../utils/constants.ts";
import { BsDownload } from "react-icons/bs";

const VesselDetails = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [formData, setFormData] = useState({});

  const defaultValues = {
    ownerName: "",
    ownerAddress: "",
    mobile: "",
    email: "",
    pan: "",
    aadhar: "",
    tradeLicence: "",
    gst: "",
    grt: "",
    workOrderValue: "",
    vesselType: "",
    category: "",
    zone: "",
    supervisionAuthority: "",
    purchaseType: "",
    classificationSociety: "",
    constructedBy: "",
    builder: "",
    builderName: "",
    builderAddress: "",
    builderEmail: "",
    builderMobile: "",
    builderTradeLicence: "",
    builderGST: "",
    builderAuth: "",
    authLetter: "",
    termsAccepted: false,
    tonnageBooklets: null,
    stabilityBooklets: null,
  };

  const internalFormMethods = useForm({
    defaultValues,
    mode: "onTouched",
  });

  const methods = formMethods || internalFormMethods;

  const isCompMount = useRef(true);

  const {
    register,
    watch,
    setValue,
    clearErrors,
    trigger,
    getValues,
    setError,
    formState: { errors },
  } = methods;

  const constructedBy = watch("constructedBy");
  const category = watch("category");

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [changeLanguage]);

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach((key) => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  const handleInputChange = useCallback(
    (name, value) => {
      setValue(name, value, { shouldValidate: true });
      clearErrors(name);
      setFormData((prev) => ({
        ...prev,
        [name]: value,
      }));
    },
    [setValue, clearErrors]
  );

  const handleFileChange = useCallback(
    (name, file) => {
      if (!file) return;

      const validTypes = [
        "application/pdf",
        "image/jpeg",
        "image/png",
        "image/jpg",
      ];
      if (!validTypes.includes(file.type)) {
        setError(name, {
          type: "manual",
          message: t("Only PDF, JPG or PNG files are allowed"),
        });
        setValue(name, null);
        return;
      }

      if (file.size > 10 * 1024 * 1024) {
        setError(name, {
          type: "manual",
          message: t("File size should not exceed 10MB"),
        });
        setValue(name, null);
        return;
      }

      const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
      const fileName = `${name}${extension}`;
      file.originalName = fileName;
      const renamedFile = renameFile(file, fileName);

      clearErrors(name);
      setValue(name, renamedFile, { shouldValidate: true });
      setFormData((prev) => ({
        ...prev,
        [name]: renamedFile,
      }));
    },
    [setValue, clearErrors, setError, t]
  );

  useEffect(() => {
    if (category === "A") {
      setValue("zone", "1", { shouldValidate: true });
      setValue("supervisionAuthority", "classificationSociety", {
        shouldValidate: true,
      });
      clearErrors("zone");
      clearErrors("supervisionAuthority");
    }
  }, [category, setValue, clearErrors]);

  const handleDownload = (fileName) => {
    const link = document.createElement("a");
    link.href = "#";
    link.download = fileName;
    link.click();
  };

  return (
    <form autoComplete="off">
      <Collapsible title={t("Basic Information")} openStat={true}>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputText
              label={t("Name of Owner")}
              required={true}
              name="ownerName"
              placeholder={t("Please enter Name of Owner")}
              register={register("ownerName", {
                required: t("Name is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Address of Owner")}
              required={true}
              name="ownerAddress"
              placeholder={t("Please enter Address of Owner")}
              register={register("ownerAddress", {
                required: t("Address is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Mobile")}
              required={true}
              name="mobile"
              placeholder={t("Please enter Mobile")}
              register={register("mobile", {
                required: t("Mobile is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Email Id")}
              required={true}
              name="email"
              type="email"
              placeholder={t("Please enter Email Id")}
              register={register("email", { required: t("Email is required") })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("PAN")}
              required={true}
              name="pan"
              placeholder={t("Please enter PAN")}
              register={register("pan", { required: t("PAN is required") })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Aadhar")}
              required={true}
              name="aadhar"
              placeholder={t("Please enter Aadhar")}
              register={register("aadhar", {
                required: t("Aadhar is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Trade Licence")}
              required={true}
              name="tradeLicence"
              placeholder={t("Please enter Trade Licence")}
              register={register("tradeLicence", {
                required: t("Trade Licence is required"),
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("GST")}
              required={true}
              name="gst"
              placeholder={t("Please enter GST")}
              register={register("gst", { required: t("GST is required") })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
        </Row>
      </Collapsible>

      <Collapsible title={t("Vessel Details")} openStat={true}>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          <Col md={4}>
            <InputSelect
              label={t("Type of Vessel")}
              required={true}
              name="vesselType"
              options={[
                { value: "new", label: t("New Vessel") },
                { value: "old", label: t("Old Vessel") },
              ]}
              register={register("vesselType", {
                required: t("vesselType is required"),
              })}
              errors={errors}
              value={formData.vesselType || watch("vesselType") || ""}
              onChange={(value) =>
                !viewMode && handleInputChange("vesselType", value)
              }
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputSelect
              label={t("Category")}
              required={true}
              name="category"
              options={[
                { value: "A", label: t("Category A") },
                { value: "B", label: t("Category B") },
                { value: "C", label: t("Category C") },
              ]}
              register={register("category", {
                required: t("category is required"),
              })}
              errors={errors}
              value={formData.category || watch("category") || ""}
              onChange={(value) =>
                !viewMode && handleInputChange("category", value)
              }
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputSelect
              label={t("Zone")}
              required={true}
              name="zone"
              options={[
                { value: "1", label: t("Zone 1") },
                { value: "2", label: t("Zone 2") },
                { value: "3", label: t("Zone 3") },
              ]}
              register={register("zone", {
                required: category !== "A" && t("zone is required"),
              })}
              errors={errors}
              value={formData.zone || watch("zone") || ""}
              onChange={(value) =>
                !viewMode && handleInputChange("zone", value)
              }
              disabled={viewMode || category === "A"}
            />
          </Col>

          <Col md={4}>
            <InputText
              label={t("Gross Tonnage (GRT)")}
              required={true}
              name="grt"
              placeholder={t("Please enter GRT")}
              register={register("grt", { required: t("GRT is required") })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={4}>
            <InputText
              label={t("Work Order Value")}
              required={true}
              name="workOrderValue"
              placeholder={t("Enter Work Order Value")}
              register={register("workOrderValue", {
                required: t("Work Order Value is required"),
                pattern: {
                  value: /^[0-9]+$/,
                  message: t("Please enter a valid number"),
                },
              })}
              errors={errors}
              disabled={viewMode}
            />
          </Col>

          <Col md={4}>
            <InputSelect
              label={t("Supervision Authority")}
              required={true}
              name="supervisionAuthority"
              options={[
                { value: "iwt", label: t("IWT") },
                {
                  value: "classificationSociety",
                  label: t("Classification Society"),
                },
              ]}
              register={register("supervisionAuthority", {
                required:
                  category !== "A" && t("Supervision Authority is required"),
              })}
              errors={errors}
              value={
                formData.supervisionAuthority ||
                watch("supervisionAuthority") ||
                ""
              }
              onChange={(value) =>
                !viewMode && handleInputChange("supervisionAuthority", value)
              }
              disabled={viewMode || category === "A"}
            />
          </Col>
          <Col md={4}>
            <InputSelect
              label={t("Purchase Type")}
              required={true}
              name="purchaseType"
              options={[
                { value: "new", label: t("New") },
                { value: "used", label: t("Used") },
              ]}
              register={register("purchaseType", {
                required: t("Purchase Type is required"),
              })}
              errors={errors}
              value={formData.purchaseType || watch("purchaseType") || ""}
              onChange={(value) =>
                !viewMode && handleInputChange("purchaseType", value)
              }
              disabled={viewMode}
            />
          </Col>
          <Col md={5}>
            <InputText
              label={t("Name of the Classification Society")}
              name="classificationSociety"
              placeholder={t("Please enter Name of the Classification Society")}
              register={register("classificationSociety")}
              errors={errors}
              disabled={viewMode}
            />
          </Col>
          <Col md={6} style={{ paddingTop: "1rem" }}>
            <InputRadio
              name="constructedBy"
              label={t("Constructed By ?")}
              options={[
                { label: t("Self"), value: "1" },
                { label: t("Builder"), value: "2" },
              ]}
              register={register}
              rules={{ required: t("Please select a Constructor Type") }}
              errors={errors}
              onChange={() => !viewMode && clearErrors("constructedBy")}
              disabled={viewMode}
            />
          </Col>
          {constructedBy === "2" && (
            <Col md={6}>
              <InputSelect
                label={t("Builder")}
                required={true}
                name="builder"
                options={[
                  { value: "builder1", label: t("Builder 1") },
                  { value: "builder2", label: t("Builder 2") },
                ]}
                register={register("builder", {
                  required: t("Builder is required"),
                })}
                errors={errors}
                value={formData.builder || watch("builder") || ""}
                onChange={(value) =>
                  !viewMode && handleInputChange("builder", value)
                }
                disabled={viewMode}
              />
            </Col>
          )}
        </Row>
      </Collapsible>

      {constructedBy === "2" && (
        <Collapsible title={t("Builder Details")} openStat={true}>
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Builder Name")}
                required={true}
                name="builderName"
                placeholder={t("Please enter Builder Name")}
                register={register("builderName", {
                  required: t("Builder Name is required"),
                })}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Builder Address")}
                required={true}
                name="builderAddress"
                placeholder={t("Please enter Builder Address")}
                register={register("builderAddress", {
                  required: t("Builder Address is required"),
                })}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Builder Email Id")}
                required={true}
                name="builderEmail"
                type="email"
                placeholder={t("Please enter Builder Email Id")}
                register={register("builderEmail", {
                  required: t("Builder Email is required"),
                  pattern: {
                    value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                    message: t("Invalid email address"),
                  },
                })}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Mobile")}
                required={true}
                name="builderMobile"
                placeholder={t("Please enter Mobile")}
                register={register("builderMobile", {
                  required: t("Builder Mobile is required"),
                  pattern: {
                    value: /^[0-9]{10}$/,
                    message: t("Invalid mobile number"),
                  },
                })}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Trade Licence")}
                required={true}
                name="builderTradeLicence"
                placeholder={t("Please enter Trade Licence")}
                register={register("builderTradeLicence", {
                  required: t("Builder Trade Licence is required"),
                })}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("GST")}
                required={true}
                name="builderGST"
                placeholder={t("Please enter GST")}
                register={register("builderGST", {
                  required: t("Builder GST is required"),
                })}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputSelect
                label={t("Builder Authorization")}
                required={true}
                name="builderAuth"
                options={[
                  { value: "auth", label: t("Authorized") },
                  { value: "rejected", label: t("Rejected") },
                ]}
                register={register("builderAuth", {
                  required: t("Builder Authorization is required"),
                })}
                errors={errors}
                value={formData.builderAuth || watch("builderAuth") || ""}
                onChange={(value) =>
                  !viewMode && handleInputChange("builderAuth", value)
                }
                disabled={viewMode}
              />
            </Col>
   <Col md={6}>
  {viewMode ? (
    watch("authLetter") && watch("authLetter").name ? (
      <div className="mb-3">
        <label className="form-label fw-bold" style={{ fontSize: "0.9rem" }}>
          {t("Authorization Letter")}
        </label>
        <div className="p-2 p-sm-3 border rounded bg-light">
          <div className="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
            <div className="flex-grow-1 min-width-0">
              <div className="fw-semibold text-primary mb-1" style={{ 
                fontSize: "0.8rem",
                overflow: 'hidden',
                textOverflow: 'ellipsis',
                whiteSpace: 'nowrap'
              }}>
                {watch("authLetter").name}
              </div>
              <small className="text-muted" style={{ fontSize: "0.7rem" }}>
                {((watch("authLetter").size || 0) / 1024 / 1024).toFixed(1)} MB
              </small>
            </div>
            <button
              type="button"
              className="btn btn-outline-primary btn-sm d-flex align-items-center flex-shrink-0"
              style={{ fontSize: "0.75rem", padding: "4px 8px" }}
              onClick={() => handleDownload(watch("authLetter").name)}
            >
              <BsDownload size={12} className="me-1" />
              <span>{t("Download")}</span>
            </button>
          </div>
        </div>
      </div>
    ) : (
      <div className="mb-3">
        <label className="form-label fw-bold" style={{ fontSize: "0.9rem" }}>
          {t("Authorization Letter")}
        </label>
        <div className="p-2 p-sm-3 border rounded bg-light text-muted text-center" style={{ fontSize: "0.8rem" }}>
          {t("No file uploaded")}
        </div>
      </div>
    )
  ) : (
    <div className="mb-2">
      <InputFile
        label={t("Authorization Letter")}
        required={true}
        name="authLetter"
        register={register("authLetter", {
          required: t("Authorization Letter is required"),
        })}
        errors={errors}
        onChange={(e) => {
          if (viewMode) return;
          if (e.target.files && e?.target?.files[0]) {
            handleFileChange("authLetter", e.target.files[0]);
          }
        }}
        disabled={viewMode}
        watch={watch}
        defaultValue={watch("authLetter")}
        clearErrors={clearErrors}
        accept=".pdf,.jpg,.jpeg,.png"
      />
    </div>
  )}
</Col>
          </Row>
        </Collapsible>
      )}
    </form>
  );
};

export default VesselDetails;

import React, { useState, useEffect } from "react";
import { Row, Col, Button, Card } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile.tsx";
import InputText from "../../../common/InputText.tsx";
import { renameFile } from "../../../../utils/constants.ts";
import { BsDownload, BsFileEarmarkPdf, BsPlus, BsTrash } from "react-icons/bs";

const Documents = ({ formMethods, viewMode = false, editMode = false }) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  const [workOrderFiles, setWorkOrderFiles] = useState([{ id: 1 }]);
  const [drawingsFiles, setDrawingsFiles] = useState([{ id: 1 }]);
  
  const {
    register,
    watch,
    setValue,
    clearErrors,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  useEffect(() => {
    if (viewMode || editMode) {
      const workOrderIds = [];
      const drawingIds = [];
      
      for (let i = 1; i <= 50; i++) {
        const workOrderFile = getValues(`workOrder_file_${i}`);
        const drawingFile = getValues(`drawings_file_${i}`);
        
        if (workOrderFile && workOrderFile.name) {
          workOrderIds.push({ id: i });
        }
        if (drawingFile && drawingFile.name) {
          drawingIds.push({ id: i });
        }
      }
      
      if (workOrderIds.length > 0) setWorkOrderFiles(workOrderIds);
      if (drawingIds.length > 0) setDrawingsFiles(drawingIds);
    }
  }, [viewMode, editMode, getValues]);

  const DocumentCard = ({ fileName, description, onDownload, fileSize, onRemove, showRemove = false }) => (
    <Card className="mb-1 border-0 shadow-sm">
      <Card.Body className="p-2">
        <div className="d-flex justify-content-between align-items-start">
          <div className="d-flex align-items-start flex-grow-1 me-2">
            <div className="bg-danger bg-opacity-10 rounded-circle p-1 me-2 flex-shrink-0">
              <BsFileEarmarkPdf className="text-danger" size={10} />
            </div>
            <div className="flex-grow-1 min-width-0">
              <h6 className="mb-1 text-primary fw-semibold" style={{ 
                fontSize: "0.7rem",
                overflow: 'hidden',
                textOverflow: 'ellipsis',
                whiteSpace: 'nowrap'
              }}>
                {fileName}
              </h6>
              <p className="mb-0 text-muted" style={{ 
                fontSize: '0.6rem',
                overflow: 'hidden',
                textOverflow: 'ellipsis',
                whiteSpace: 'nowrap'
              }}>
                {description}
              </p>
              {fileSize && (
                <span className="badge bg-light text-dark mt-1" style={{ fontSize: '0.55rem' }}>
                  {(fileSize / 1024 / 1024).toFixed(1)} MB
                </span>
              )}
            </div>
          </div>
          <div className="d-flex gap-1 flex-shrink-0">
            <Button
              variant="outline-primary"
              size="sm"
              onClick={() => onDownload(fileName)}
              className="rounded-pill p-1 d-flex align-items-center"
              style={{ minWidth: 'auto', fontSize: '0.6rem', padding: '2px 4px' }}
            >
              <BsDownload size={8} />
              <span className="ms-1 d-none d-sm-inline">
                {t("Download")}
              </span>
            </Button>
            {showRemove && (
              <Button
                variant="outline-danger"
                size="sm"
                onClick={onRemove}
                className="rounded-pill p-1"
                style={{ minWidth: 'auto', padding: '2px 4px' }}
              >
                <BsTrash size={8} />
              </Button>
            )}
          </div>
        </div>
      </Card.Body>
    </Card>
  );

  const FileUploadCard = ({ label, name, onRemove, showRemove = false }) => (
    <Card className="mb-2 border-2 border-dashed border-primary border-opacity-25">
      <Card.Body className="p-2">
        <div className="mb-2" style={{ fontSize: "0.8rem" }}>
          <InputFile
            label={label}
            name={name}
            register={register(name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                
                if (file.size > 10 * 1024 * 1024) {
                  setError(name, {
                    type: 'manual',
                    message: t('File size should not exceed 10MB')
                  });
                  return;
                }
                
                const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                const fileName = `${label}${extension}`;
                file.originalName = fileName;
                const renamedFile = renameFile(file, fileName);

                clearErrors(name);
                setValue(name, renamedFile, { shouldValidate: true });
                setFormData((prev) => ({
                  ...prev,
                  [name]: renamedFile
                }));
              }
            }}
            watch={watch}
            defaultValue={watch(name)}
            clearErrors={clearErrors}
            accept=".pdf,.jpg,.jpeg,.png"
          />
        </div>
        <div className="mb-2" style={{ fontSize: "0.8rem" }}>
          <InputText
            label={t("Description")}
            name={name.replace('_file_', '_desc_')}
            placeholder={t("Enter file description")}
            register={register(name.replace('_file_', '_desc_'))}
            errors={errors}
          />
        </div>
        {showRemove && (
          <div className="text-end">
            <Button
              variant="outline-danger"
              size="sm"
              onClick={onRemove}
              className="rounded-pill"
              style={{ fontSize: "0.65rem", padding: "2px 6px" }}
            >
              <BsTrash className="me-1" size={8} />
              <span>Remove</span>
            </Button>
          </div>
        )}
      </Card.Body>
    </Card>
  );

  const FileSection = ({ title, files, type, icon }) => {
    const filesWithData = files.filter(file => {
      const fileData = watch(`${type}_file_${file.id}`);
      return fileData && fileData.name;
    });

    return (
      <Card className="h-100 shadow-sm border-0">
        <Card.Header className="bg-light border-0 py-2">
          <div className="d-flex justify-content-between align-items-center">
            <h6 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: '0.75rem' }}>
              {icon}
              <span className="ms-2">{title}</span>
            </h6>
            <span className="badge bg-primary rounded-pill" style={{ fontSize: '0.6rem' }}>
              {viewMode ? filesWithData.length : files.length} files
            </span>
          </div>
        </Card.Header>

        <Card.Body className="p-0">
          <div style={{ maxHeight: "250px", overflowY: "auto" }} className="p-1">
            {viewMode ? (
              filesWithData.length > 0 ? (
                <div className="row g-1">
                  {filesWithData.map((fileInput, index) => {
                    const fileData = watch(`${type}_file_${fileInput.id}`);
                    const descData = watch(`${type}_desc_${fileInput.id}`);
                    
                    return (
                      <div key={fileInput.id} className="col-12">
                        <DocumentCard
                          fileName={fileData.name}
                          description={descData || `${title} document ${index + 1}`}
                          fileSize={fileData.size}
                          onDownload={() => handleDownload(fileData.name)}
                        />
                      </div>
                    );
                  })}
                </div>
              ) : (
                <div className="text-center py-2 text-muted">
                  <div className="bg-light rounded-circle p-2 d-inline-flex mb-2">
                    <BsFileEarmarkPdf size={20} className="opacity-50" />
                  </div>
                  <p className="mb-0" style={{ fontSize: '0.7rem' }}>No files uploaded</p>
                </div>
              )
            ) : (
              <>
                {files.map((fileInput, idx) => (

                  <FileUploadCard
                    key={fileInput.id}
                    label={`${t("Choose File")} ${idx + 1}`}
                    fileName={type === 'workOrder' ? `WorkOrder_${fileInput.id}` : `Drawing_${fileInput.id}`}
                    name={`${type}_file_${fileInput.id}`}
                    onRemove={() => removeFileInput(type, fileInput.id)}
                    showRemove={files.length > 1}
                  />
                ))}
              </>
            )}
          </div>
        </Card.Body>

        {!viewMode && (
          <Card.Footer className="bg-light border-0 text-center py-1">
            <Button
              variant="primary"
              size="sm"
              onClick={() => addFileInput(type)}
              className="rounded-pill px-2"
              style={{ fontSize: '0.65rem' }}
            >
              <BsPlus className="me-1" size={10} />
              Add {title}
            </Button>
          </Card.Footer>
        )}
      </Card>
    );
  };

  const SingleFileSection = ({ title, fileName, onDownload, fileSize, icon }) => (
    <Card className="h-100 shadow-sm border-0">
      <Card.Header className="bg-light border-0 py-2">
        <h6 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: '0.75rem' }}>
          {icon}
          <span className="ms-2">{title}</span>
        </h6>
      </Card.Header>
      <Card.Body className="p-2">
        {fileName ? (
          <DocumentCard
            fileName={fileName}
            description={`${title} document`}
            fileSize={fileSize}
            onDownload={() => onDownload(fileName)}
          />
        ) : (
          <div className="text-center py-2 text-muted">
            <div className="bg-light rounded-circle p-2 d-inline-flex mb-2">
              <BsFileEarmarkPdf size={20} className="opacity-50" />
            </div>
            <p className="mb-0" style={{ fontSize: '0.7rem' }}>No file uploaded</p>
          </div>
        )}
      </Card.Body>
    </Card>
  );

  const addFileInput = (type) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      const newId = workOrderFiles.length > 0 ? Math.max(...workOrderFiles.map(f => f.id)) + 1 : 1;
      setWorkOrderFiles([...workOrderFiles, { id: newId }]);
    } else if (type === 'drawings') {
      const newId = drawingsFiles.length > 0 ? Math.max(...drawingsFiles.map(f => f.id)) + 1 : 1;
      setDrawingsFiles([...drawingsFiles, { id: newId }]);
    }
  };

  const removeFileInput = (type, id) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      setWorkOrderFiles(workOrderFiles.filter(file => file.id !== id));
    } else if (type === 'drawings') {
      setDrawingsFiles(drawingsFiles.filter(file => file.id !== id));
    }
    setValue(`${type}_file_${id}`, null);
    setValue(`${type}_desc_${id}`, "");
    clearErrors([`${type}_file_${id}`, `${type}_desc_${id}`]);
  };

  const handleDownload = (fileName) => {
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
  };

  return (
    <div>
      <Collapsible title={t("Documents")} openStat={true}>
        <div style={{ padding: "1rem", backgroundColor: "#f8f9fa" }}>
          <Row className="g-3">
            <Col lg={6} md={12}>
              <FileSection
                title={t("Work Order")}
                files={workOrderFiles}
                type="workOrder"
                icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
              />
            </Col>

            <Col lg={6} md={12}>
              <FileSection
                title={t("Drawings")}
                files={drawingsFiles}
                type="drawings"
                icon={<BsFileEarmarkPdf className="text-success" size={12} />}
              />
            </Col>

            <Col md={6}>
              {viewMode ? (
                <SingleFileSection
                  title={t('Tonnage Booklets')}
                  fileName={watch("tonnageBooklets")?.name}
                  fileSize={watch("tonnageBooklets")?.size}
                  onDownload={handleDownload}
                  icon={<BsFileEarmarkPdf className="text-warning" size={12} />}
                />
              ) : (
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-2">
                    <h6 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: '0.75rem' }}>
                      <BsFileEarmarkPdf className="text-warning me-2" size={12} />
                      {t('Tonnage Booklets')}
                    </h6>
                  </Card.Header>
                  <Card.Body className="p-2">
                    <div style={{ fontSize: "0.8rem" }}>
                      <InputFile
                        label={t('Tonnage Booklets')}
                        required={true}
                        name="tonnageBooklets"
                        register={register("tonnageBooklets")}
                        errors={errors}
                        onChange={(e) => {
                          if (e.target.files && e?.target?.files[0]) {
                            const file = e.target.files[0];
                            if (file.size > 10 * 1024 * 1024) {
                              setError("tonnageBooklets", {
                                type: 'manual',
                                message: t('File size should not exceed 10MB')
                              });
                              return;
                            }
                            const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                            const fileName = `Tonnage Booklets${extension}`;
                            file.originalName = fileName;
                            const renamedFile = renameFile(file, fileName);
                            clearErrors("tonnageBooklets");
                            setValue("tonnageBooklets", renamedFile, { shouldValidate: true });
                          }
                        }}
                        watch={watch}
                        accept=".pdf,.jpg,.jpeg,.png"
                        defaultValue={watch("tonnageBooklets")}
                        clearErrors={clearErrors}
                      />
                    </div>
                  </Card.Body>
                </Card>
              )}
            </Col>

            <Col md={6}>
              {viewMode ? (
                <SingleFileSection
                  title={t('Stability Booklets')}
                  fileName={watch("stabilityBooklets")?.name}
                  fileSize={watch("stabilityBooklets")?.size}
                  onDownload={handleDownload}
                  icon={<BsFileEarmarkPdf className="text-info" size={12} />}
                />
              ) : (
                <Card className="h-100 shadow-sm border-0">
                  <Card.Header className="bg-light border-0 py-2">
                    <h6 className="mb-0 text-primary fw-bold d-flex align-items-center" style={{ fontSize: '0.75rem' }}>
                      <BsFileEarmarkPdf className="text-info me-2" size={12} />
                      {t('Stability Booklets')}
                    </h6>
                  </Card.Header>
                  <Card.Body className="p-2">
                    <div style={{ fontSize: "0.8rem" }}>
                      <InputFile
                        label={t('Stability Booklets')}
                        required={true}
                        name="stabilityBooklets"
                        register={register("stabilityBooklets")}
                        errors={errors}
                        onChange={(e) => {
                          if (e.target.files && e?.target?.files[0]) {
                            const file = e.target.files[0];
                            if (file.size > 10 * 1024 * 1024) {
                              setError("stabilityBooklets", {
                                type: 'manual',
                                message: t('File size should not exceed 10MB')
                              });
                              return;
                            }
                            const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                            const fileName = `Stability Booklets${extension}`;
                            file.originalName = fileName;
                            const renamedFile = renameFile(file, fileName);
                            clearErrors("stabilityBooklets");
                            setValue("stabilityBooklets", renamedFile, { shouldValidate: true });
                          }
                        }}
                        watch={watch}
                        accept=".pdf,.jpg,.jpeg,.png"
                        defaultValue={watch("stabilityBooklets")}
                        clearErrors={clearErrors}
                      />
                    </div>
                  </Card.Body>
                </Card>
              )}
            </Col>

            <Col md={12}>
              <Card className="shadow-sm border-0">
                <Card.Body className="p-3">
                  <div className="d-flex align-items-start">
                    <input
                      type="checkbox"
                      id="termsAccepted"
                      className="me-3 mt-1"
                      {...register("termsAccepted", { required: t('You must accept the terms and conditions') })}
                      disabled={viewMode}
                      checked={viewMode ? true : watch("termsAccepted")}
                    />
                    <div>
                      <label
                        htmlFor="termsAccepted"
                        className="mb-0 fw-medium"
                        style={{ 
                          color: "#333", 
                          cursor: viewMode ? "default" : "pointer", 
                          lineHeight: "1.5",
                          fontSize: "0.85rem"
                        }}
                      >
                        {t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.')}
                      </label>
                      {errors.termsAccepted && !viewMode && (
                        <div className="text-danger small mt-2">
                          {errors.termsAccepted.message}
                        </div>
                      )}
                    </div>
                  </div>
                </Card.Body>
              </Card>
            </Col>
          </Row>
        </div>
      </Collapsible>
    </div>
  );
};

export default Documents;
