import React, { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import "bootstrap/dist/css/bootstrap.min.css";
import { Container, Row, Col, Modal, Button, Table } from "react-bootstrap";
import "./DashboardMain.css";
import FileUploadModal from "./FileUploadModal.jsx";
import ActionTable from "./ActionTable.js"; 
import { toast } from "react-toastify";
import { APP_MESSAGES, openFileInNewTab } from "../../../utils/constants.ts";
import { URLS_ENDPOINT } from "../../../utils/urlsConstants.ts";
import { postData } from "../../../services/http.service.ts";
// import Collapsible from "../../../common/Collapsible.js";
import Collapsible from "../stepperForm/formCommon/Collapsible.js";
import PreviewCard from "./PreviewCard.js";
import { FaCheckCircle, FaClock, FaHourglassStart } from "react-icons/fa";

import { FaDownload, FaClipboardList, FaFile, FaFilePdf } from "react-icons/fa6";

const DashboardMain = () => {
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [modalData, setModalData] = useState({});
  const [historyModal, setHistoryModal] = useState(false);
  const [historyData, setHistoryData] = useState({});
  const [showDocumentModal, setShowDocumentModal] = useState(false);
  const [documentListData, setDocumentListData] = useState([]);
  const navigate = useNavigate();
   const [isTrackModalOpen, setIsTrackModalOpen] = useState(false);
    const [trackData, setTrackData] = useState({});
    
    const [showModal, setShowModal] = useState(false);

  const handleOpenModal = () => setShowModal(true);
  const handleCloseModal = () => setShowModal(false);

  const handleDocumentModal = () => setShowDocumentModal(!showDocumentModal);

  const [rowData, setRowData] = useState([]);
  const columns = [
    {
      colName: "SL NO",
      fieldName: "slNo",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "SL NO",
      minWidth: "5rem",
    },
    {
      colName: "Claim Number",
      fieldName: "claimNumber",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Claim Number",
      minWidth: "10rem",
    },
    {
      colName: "Claimant",
      fieldName: "claimant",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Claimant",
      minWidth: "10rem",
    },
    {
      colName: "Status",
      fieldName: "status",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Status",
      minWidth: "10rem",
    },
    {
      colName: "comment",
      fieldName: "comment",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "comment",
      minWidth: "10rem",
    },
    {
      colName: "Amount",
      fieldName: "amount",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Amount",
      minWidth: "10rem",
    },
    {
      colName: "Date Submitted",
      fieldName: "dateSubmitted",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Date Submitted",
      minWidth: "10rem",
    },
    {
      colName: "Action",
      fieldName: "action",
      actions: ["view", "edit","track","delete"],
      clsName: "col-sm-2 column-text-start actions-column",
    },
  ];
  const handleTrackRow = (row) => {
    console.log("Track row:", row.uuid);
    // Set static data for tracking
    const staticTrackData = {
      applicationNumber: row.claimNumber || "N/A",
      trackingSteps: [
        { step: "Step 1", description: "Application Submitted", date: "2023-10-01" },
        { step: "Step 2", description: "Under Review", date: "2023-10-05" },
        { step: "Step 3", description: "Approved", date: "2023-10-10" },
      ],
    };
    setTrackData(staticTrackData);
    setIsTrackModalOpen(true);
  };

  // const handleViewRow = (row) => {
  //   console.log("View row:", row.uuid);
  //   if (row?.uuid) {
  //     navigate(`/apply-claim/view/${row.uuid}`);
  //   } else {
  //     console.error("UUID not found in the row object.");
  //     toast.warning("No UUID Available..", { position: "top-right" });
  //   }
  // };

   // const handleAddButtonClick = () => {
  //   setIsLoading(true);
  //   setTimeout(() => {
  //     setIsLoading(false);
  //     navigate("/registration");
  //   }, 1000);
  // };

  const handleEditRow = (row) => {
    console.log("Edit row:", row.uuid);
    if (row?.uuid) {
      navigate(`/apply-claim/edit/${row.uuid}`);
    } else {
      console.error("UUID not found in the row object.");
      toast.warning("No UUID Available..", { position: "top-right" });
    }
  };

  const formatFileInfo = (document) => {
    if (!document) return "N/A";
    return `${document.docType || 'Document'} (${document.docName || 'No name'})`;
  };

  const transformApplicationData = (application) => {
    if (!application) return null;

    const basicDetails = application.creditorBasicDetails || {};
    const claimDetails = application.claimDetails || {};
    const signatoryDetails = application.signatoryDetails || {};

    return {
      applicationNumber: application.applicationNumber,
      step1: {
        creditorDetails: {
          // "Application Number": application.applicationNumber,
          "Debtor Name": basicDetails.debtorName,
          "Creditor Name": basicDetails.creditorName,
          "Total Claim Amount": basicDetails.totalClaimAmount,
          "Debt Details": basicDetails.debtDetails,
          "Mutual Credit Details": basicDetails.mutualCreditDetails,
        },
        identificationDetails: {
          "Identification Type": basicDetails.document?.docType,
          "Identification Number": basicDetails.identificationNumber,
          "Document Name": formatFileInfo(basicDetails.document),
        },
      },
      step2: {
        financialDetails: {
          "Security Interest Amount": claimDetails.securityInterestAmount,
          "Guarantee Amount": claimDetails.guaranteeAmount,
          "Guarantor Name": claimDetails.guarantorName,
          "Guarantor Address": claimDetails.guarantorAddress,
          "Creditor Address": claimDetails.creditorAddress,
          "Creditor Email": claimDetails.creditorEmail,
          "Principal Borrower Name": claimDetails.principalBorrowerName,
          "Principal Borrower Address": claimDetails.principalBorrowerAddress,
        },
        beneficiaryDetails: {
          "Beneficiary Name": claimDetails.beneficiaryName,
          "Beneficiary Address": claimDetails.beneficiaryAddress,
          "Corporate Debtor Security Amount": claimDetails.corporateDebtorSecurityAmount,
          "Corporate Debtor Guarantee Amount": claimDetails.corporateDebtorGuaranteeAmount,
        },
        addressproofDetails: {
          "Address Proof Type": claimDetails.document?.docType,
          "Address Proof Number": claimDetails.addressProofNumber,
          "Address Proof Document": formatFileInfo(claimDetails.document),
        },
        bankDetails: {
      
          "Account Number": claimDetails.bankAccountNumber,
          "IFSC Code": claimDetails.bankIfscCode,
          "Branch Name": claimDetails.bankBranchName,
        },
      },
      step3: {
        signatoryDetails: {
          "Signatory Name": signatoryDetails.name,
          "Signatory Position": signatoryDetails.position,
          "Signatory Address": signatoryDetails.address,
          "Signatory Document": formatFileInfo(signatoryDetails.document),
        },
      },
      status: application.applicationStatus,
    };
  };

  const handleOnViewRow = async (row) => {
    try {
      setIsLoading(true);
      
      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;
      
      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }
  
      const payload = {
        userInfo: userInfo,
        uuids: [row.uuid], // Use the uuid from the row
        applicationNumbers: [],
        claimantUUIDs: []
      };
  
      const URL =
        process.env.REACT_APP_APPLICATION_SERVICE +
        URLS_ENDPOINT.APP_SERVICES.APPLICATION_VIEW_ID;
  
      const response = await postData(URL, payload);
      
      if (response?.data?.status?.code === "200" && response?.data?.applicationDetails?.length > 0) {
        const transformedData = transformApplicationData(response.data.applicationDetails[0]);
        setModalData(transformedData);
        setIsViewModalOpen(true);
      } else {
        toast.error("No application details found", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching application details:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
    } finally {
      setIsLoading(false);
    }
  };
// const fetchDocumentList = async (data) => {
  //   if (data?.registrationBooksData?.[0]?.uuid) {
  //     try {
  //       const URL =
  //         process.env.REACT_APP_BASE_URL +
  //         URLS_ENDPOINT.APP_SERVICES.DOWNLOAD_DOC +
  //         data?.registrationBooksData?.[0]?.uuid;
  //       const response = await postData(URL, {});
  //       if (response?.data?.documentList?.length > 0) {
  //         setDocumentListData(response?.data?.documentList);
  //         handleDocumentModal();
  //       } else {
  //         toast.info(APP_MESSAGES.NO_DATA_MSG, { position: "top-right" });
  //       }
  //     } catch (error) {
  //       toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
  //     }
  //   } else {
  //     toast.info(APP_MESSAGES.NO_DATA_MSG, { position: "top-right" });
  //   }
  // };

  // const getDocumentFile = async (docInfo) => {
  //   if (docInfo?.registrationUuidFk) {
  //     try {
  //       const URL =
  //         process.env.REACT_APP_BASE_URL +
  //         URLS_ENDPOINT.APP_SERVICES.DOWNLOAD_DOC +
  //         docInfo?.registrationUuidFk +
  //         "&documentUuid=" +
  //         docInfo?.uuid;
  //       const response = await postData(URL, {});
  //       const base64String = response?.data?.documentList[0]?.documentBase64 || "";
  //       if (base64String) {
  //         openFileInNewTab(base64String);
  //       } else {
  //         toast.info(APP_MESSAGES.NO_DATA_MSG, { position: "top-right" });
  //       }
  //     } catch (error) {
  //       toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
  //     }
  //   } else {
  //     toast.info(APP_MESSAGES.NO_DATA_MSG, { position: "top-right" });
  //   }
  // };


  const fetchDashboardData = async () => {
    try {
      setIsLoading(true);
      
      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails
      
      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }

      const payload = {
        userInfo: userInfo,
        filterCriteria: {}
      };

      const URL =
          process.env.REACT_APP_APPLICATION_SERVICE +
          URLS_ENDPOINT.APP_SERVICES.DASHBOARD_LIST;

      const response = await postData(URL, payload);
      
      if (response?.data.status === "200" && response?.data.dashboardApplications?.length > 0) {
        // Format the data to match your table structure
        const formattedData = response.data.dashboardApplications.map((item, index) => ({
          ...item,
          id: item.uuid, 
          slNo: index + 1,
          claimNumber: item.applicationNumber,
          claimant: item.creditorName,
          status: item.applicationStatus,
          amount: `${item.totalClaimAmount}` || "0.00",
          dateSubmitted: item.submittedDate || new Date().toLocaleDateString(),
          action: ["view"],
          originalData: item, 
        }));
             
        // if (userFormData?.userType === "CRP") {
        //   formattedData.forEach((item) => {
        //     item.claimNumber = (
        //       <a href={`/apply-claim/${item.id}`} style={{ color: "#269ccc", textDecoration: "underline" }}>
        //         {item.claimNumber}
        //       </a>
        //     );
        //   });
        // }
        
        setRowData(formattedData);
      } else {
        setRowData([]);
        toast.info("No applications found", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching dashboard data:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setRowData([]);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchDashboardData();
  }, []);

  return (
    <div className="container-fluid mt-5" style={{ paddingLeft: 0, paddingRight: 0 }}>
      {!isLoading ? (
        <>
          <h3 className="mb-2 text-center">Claim Submission Service</h3>

        
          <ActionTable
            columns={columns}
            rowData={rowData}
            hideExportBtn={false}
            onViewRow={handleOnViewRow}
            handleEditRow={handleEditRow}
            onTrackRow={handleTrackRow}
           
          />

        {/* Tracking Modal */}
<Modal
  show={isTrackModalOpen}
  onHide={() => setIsTrackModalOpen(false)}
  dialogClassName="modal-1110w"
  aria-labelledby="tracking-modal-title"
>
  <Modal.Header closeButton>
    <Modal.Title id="tracking-modal-title">Tracking Details</Modal.Title>
  </Modal.Header>
  <Modal.Body>
    {trackData ? (
      <>
        <div className="mb-4 text-center">
          <h5 className="text-muted mb-2">Application Number</h5>
          <div
            style={{
              display: "inline-block",
              backgroundColor: "#e6f4ff",
              color: "#007bff",
              padding: "10px 20px",
              borderRadius: "30px",
              fontWeight: "600",
              fontSize: "1.2rem",
              border: "1px solid #b3daff",
            }}
          >
            {trackData.applicationNumber}
          </div>
        </div>

        <div className="timeline-container">
          {trackData.trackingSteps &&
            trackData.trackingSteps.map((step, index) => (
              <div key={index} className="timeline-step">
                <div className="timeline-icon">
                  {index === 0 ? (
                    <FaHourglassStart color="#0d6efd" />
                  ) : index === trackData.trackingSteps.length - 1 ? (
                    <FaCheckCircle color="green" />
                  ) : (
                    <FaClock color="#ffc107" />
                  )}
                </div>
                <div className="timeline-content">
                  {/* <h6 className="mb-1">{step.step}</h6> */}
                  <p className="mb-1 text-muted">{step.description}</p>
                  <small className="text-secondary">
                    <i className="fa fa-calendar"></i> {step.date}
                  </small>
                </div>
              </div>
            ))}
        </div>
      </>
    ) : (
      <p>No tracking data available.</p>
    )}
  </Modal.Body>
  <Modal.Footer>
    <Button variant="secondary" onClick={() => setIsTrackModalOpen(false)}>
      Close
    </Button>
  </Modal.Footer>
</Modal>

           <Modal
                      show={isViewModalOpen}
                      onHide={() => setIsViewModalOpen(false)}
                      dialogClassName="modal-1110w"
                      aria-labelledby="example-custom-modal-styling-title"
                    >
                      <Modal.Header closeButton>
                        <Modal.Title id="example-custom-modal-styling-title">
                          Application Details
                        </Modal.Title>
                      </Modal.Header>
                      <Modal.Body>
                        {modalData ? (
                          <>
                          <div className="d-flex justify-content-between align-items-center mb-3" style={{width: "100%"}}>
                              <h4 className="mb-0">Application Number:</h4>
                              
                              <div
                                style={{
                                  backgroundColor: "#f0f8ff", // Light blue background
                                  color: "#4682b4", // Steel blue text
                                  padding: "8px 15px",
                                  borderRadius: "5px",
                                  fontWeight: "bold",
                                  fontSize: "1.1rem",
                                  border: "1px solid #add8e6",
                                  marginRight:"auto",
                                  marginLeft:"10px",

                                }}
                              >
                                {modalData.applicationNumber || "N/A"}
                              </div>
          
                              <button onClick={handleOpenModal} style={{
                                      display: "flex",
                                      alignItems: "center",
                                      padding: "0.5rem",
                                      backgroundColor: "rgb(7 76 101)",
                                      color: "white",
                                      border: "none",
                                      borderRadius: "8px",
                                      cursor: "pointer",
                                      fontSize: "1 rem",

                                    width: "40px",
                                    height: "40px",
                                    }}><FaClipboardList /></button>
                            </div>
                            {showModal && (
  <div
    style={{
      position: "fixed",
      top: 0,
      left: 0,
      height: "100%",
      width: "100%",
      backgroundColor: "rgba(0,0,0,0.5)",
      display: "flex",
      justifyContent: "center",
      alignItems: "center",
      zIndex: 1000,
    }}
  >
    <div
      style={{
        backgroundColor: "white",
        padding: "2rem",
        borderRadius: "10px",
        minWidth: "600px",
        maxWidth: "90%",
        maxHeight: "80vh",
        overflowY: "auto",
      }}
    >
      <div className="d-flex justify-content-between align-items-center mb-4">
        <h2 className="mb-0">
          Documents for Application: 
        </h2>
        <button 
          onClick={handleCloseModal}
          style={{
            background: "none",
            border: "none",
            fontSize: "1.5rem",
            cursor: "pointer",
            color: "#6c757d",
          }}
        >
          &times;
        </button>
      </div>

      <Table striped bordered hover responsive>
        <thead>
          <tr>
            <th style={{ width: "10%" }}>SL #</th>
            <th style={{ width: "70%" }}>Document Name</th>
            <th style={{ width: "20%" }}>Action</th>
          </tr>
        </thead>
        <tbody>
       
              <tr >
                <td>1</td>
                <td>
                  <div className="d-flex align-items-center">
                    <FaFilePdf className="me-2" style={{ color: "red" }} />
                    {modalData.applicationNumber || "N/A"}
                  
                  </div>
                </td>
                <td>
                  <Button
                    variant="outline-primary"
                    size="sm"
                    // onClick={() => getDocumentFile(item)}
                    className="d-flex align-items-center justify-content-center"
                    style={{ width: "100%" }}
                  >
                    <FaDownload className="me-2" />
                    Download
                  </Button>
                </td>
              </tr>
         
        </tbody>
      </Table>

      <div className="d-flex justify-content-end mt-3">
        <Button variant="secondary" onClick={handleCloseModal}>
          Close
        </Button>
      </div>
    </div>
  </div>
)}
                          {/* <h4 className="mb-3">Application Number: {modalData.applicationNumber || "N/A"}</h4> */}
                            <Collapsible title="Creditor & Identification Details">
                              <div className="card mb-4 tiles_Size">
                                <div className="card-body">
                                  <h5 style={{ fontWeight: 600 }}>Creditor Details</h5>
                                  <br />
                                  <Container fluid>
                                    <Row className="g-3">
                                      {modalData.step1?.creditorDetails && Object.entries(modalData.step1.creditorDetails).map(([key, value]) => (
                                        <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                          <PreviewCard title={key} value={value || "N/A"} />
                                        </Col>
                                      ))}
                                    </Row>
                                  </Container>
                                </div>
                              </div>
                              <div className="card mb-4 tiles_Size">
                                <div className="card-body">
                                  <h5 style={{ fontWeight: 600 }}>Identification Details</h5>
                                  <br />
                                  <Container fluid>
                                    <Row className="g-3">
                                      {modalData.step1?.identificationDetails && Object.entries(modalData.step1.identificationDetails).map(([key, value]) => (
                                        <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                          <PreviewCard title={key} value={value || "N/A"} />
                                        </Col>
                                      ))}
                                    </Row>
                                  </Container>
                                </div>
                              </div>
                            </Collapsible>
          
                            <Collapsible title="Financial & Beneficiary Details">
                              <div className="card mb-4 tiles_Size">
                                <div className="card-body">
                                  <h5 style={{ fontWeight: 600 }}>Financial Details</h5>
                                  <br />
                                  <Container fluid>
                                    <Row className="g-3">
                                      {modalData.step2?.financialDetails && Object.entries(modalData.step2.financialDetails).map(([key, value]) => (
                                        <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                          <PreviewCard title={key} value={value || "N/A"} />
                                        </Col>
                                      ))}
                                    </Row>
                                  </Container>
                                </div>
                              </div>
                              <div className="card mb-4 tiles_Size">
                                <div className="card-body">
                                  <h5 style={{ fontWeight: 600 }}>Beneficiary Details</h5>
                                  <br />
                                  <Container fluid>
                                    <Row className="g-3">
                                      {modalData.step2?.beneficiaryDetails && Object.entries(modalData.step2.beneficiaryDetails).map(([key, value]) => (
                                        <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                          <PreviewCard title={key} value={value || "N/A"} />
                                        </Col>
                                      ))}
                                    </Row>
                                  </Container>
                                </div>
                              </div>
                              <div className="card mb-4 tiles_Size">
                                <div className="card-body">
                                  <h5 style={{ fontWeight: 600 }}>Address Proof Details</h5>
                                  <br />
                                  <Container fluid>
                                    <Row className="g-3">
                                      {modalData.step2?.addressproofDetails && Object.entries(modalData.step2.addressproofDetails).map(([key, value]) => (
                                        <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                          <PreviewCard title={key} value={value || "N/A"} />
                                        </Col>
                                      ))}
                                    </Row>
                                  </Container>
                                </div>
                              </div>
                              <div className="card mb-4 tiles_Size">
                                <div className="card-body">
                                  <h5 style={{ fontWeight: 600 }}>Bank Details</h5>
                                  <br />
                                  <Container fluid>
                                    <Row className="g-3">
                                      {modalData.step2?.bankDetails && Object.entries(modalData.step2.bankDetails).map(([key, value]) => (
                                        <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                          <PreviewCard title={key} value={value || "N/A"} />
                                        </Col>
                                      ))}
                                    </Row>
                                  </Container>
                                </div>
                              </div>
                            </Collapsible>
          
                            <Collapsible title="Signatory Details">
                              <div className="card mb-4 tiles_Size">
                                <div className="card-body">
                                  <h5 style={{ fontWeight: 600 }}>Signatory Information</h5>
                                  <br />
                                  <Container fluid>
                                    <Row className="g-3">
                                      {modalData.step3?.signatoryDetails && Object.entries(modalData.step3.signatoryDetails).map(([key, value]) => (
                                        <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                          <PreviewCard title={key} value={value || "N/A"} />
                                        </Col>
                                      ))}
                                    </Row>
                                  </Container>
                                </div>
                              </div>
                            </Collapsible>
          
                            {/* <div className="card mb-4 tiles_Size">
                              <div className="card-body">
                                <h5 style={{ fontWeight: 600 }}>Application Status</h5>
                                <br />
                                <Container fluid>
                                  <Row className="g-3">
                                    <Col xs={12} sm={6} md={3} className="mb-3">
                                      <PreviewCard 
                                        title="Current Status" 
                                        value={modalData.status || "N/A"} 
                                        style={{ 
                                          color: modalData.status === "Approved" ? "green" : 
                                                modalData.status === "Rejected" ? "red" : 
                                                "orange",
                                          fontWeight: "bold"
                                        }}
                                      />
                                    </Col>
                                  </Row>
                                </Container>
                              </div>
                            </div> */}
                          </>
                        ) : (
                          <p>No data available.</p>
                        )}
                      </Modal.Body>
                      <Modal.Footer>
                        <Button variant="secondary" onClick={() => setIsViewModalOpen(false)}>
                          Close
                        </Button>
                      </Modal.Footer>
                    </Modal>
          
          <FileUploadModal modal={isModalOpen} setModal={setIsModalOpen} />
        </>
      ) : (
        <div className="loader-container">
          <div className="loader"></div>
        </div>
      )}
    </div>
  );
};

export default DashboardMain;

/* General Styles */
:root {
  --primary-color: #269ccc;
  --primary-dark: #076C75;
  --secondary-color: #09828D;
  --text-color: #333;
  --light-gray: #f9f9f9;
  --medium-gray: #e0e0e0;
  --dark-gray: #777;
  --white: #ffffff;
  --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

/* body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  color: var(--text-color);
  background-color: #f5f7fa;
  margin: 0;
  padding: 0;
  min-height: 100vh;
} */

.container-fluid {
  width: 100%;
  padding: 0 15px;
  margin: 0 auto;
  box-sizing: border-box;
}

/* Header Styles */
.dashboard-header {
  margin-bottom: 2rem;
  padding: 1rem 0;
  border-bottom: 1px solid var(--medium-gray);
}

.mb-2.text-center {
  font-size: 2rem;
  font-weight: 600;
  color: var(--primary-color);
  letter-spacing: 0.5px;
  margin: 1rem 0;
  text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1);
}

/* Card Styles */
.card {
  border: none;
  border-radius: 8px;
  box-shadow: var(--shadow);
  margin-bottom: 1.5rem;
  background: var(--white);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
}

.card-header {
  background-color: var(--primary-color);
  color: var(--white);
  font-weight: 600;
  border-radius: 8px 8px 0 0 !important;
  padding: 1rem 1.25rem;
  border-bottom: none;
}

.card-body {
  padding: 1.5rem;
}

/* Professional Table Styles */
.table-responsive {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  margin-bottom: 1rem;
  position: relative;
}

.table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 0.9rem;
  min-width: 600px;
}

.table th {
  position: sticky;
  top: 0;
  z-index: 10;
}

.table th,
.table td {
  padding: 12px 15px;
  text-align: left;
  vertical-align: middle;
  border-bottom: 1px solid var(--medium-gray);
}

.table thead th {
  background-color: var(--primary-color);
  color: var(--white);
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.8rem;
  letter-spacing: 0.5px;
}

.table tbody tr {
  transition: background-color 0.2s ease;
}

.table tbody tr:nth-child(even) {
  background-color: var(--light-gray);
}

.table tbody tr:hover {
  background-color: rgba(38, 156, 204, 0.05);
}

.table tbody tr:last-child td {
  border-bottom: none;
}

/* Status Badges */
.badge {
  padding: 6px 10px;
  font-weight: 500;
  font-size: 0.75rem;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.badge-success {
  background-color: #d4edda;
  color: #155724;
}

.badge-warning {
  background-color: #fff3cd;
  color: #856404;
}

.badge-danger {
  background-color: #f8d7da;
  color: #721c24;
}

/* Button Styles */
.btn {
  font-weight: 500;
  padding: 8px 16px;
  border-radius: 6px;
  transition: all 0.2s ease;
  font-size: 0.85rem;
  letter-spacing: 0.3px;
  white-space: nowrap;
}

.btn-primary {
  background-color: var(--primary-color);
  border-color: var(--primary-color);
}

.btn-primary:hover {
  background-color: var(--primary-dark);
  border-color: var(--primary-dark);
  transform: translateY(-1px);
}

.btn-outline-primary {
  color: var(--primary-color);
  border-color: var(--primary-color);
}

.btn-outline-primary:hover {
  background-color: var(--primary-color);
  color: var(--white);
}

/* Action Buttons */
.btn-sm {
  padding: 5px 10px;
  font-size: 0.75rem;
}

.btn-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

/* Pagination Styles */
.pagination {
  display: flex;
  justify-content: center;
  list-style: none;
  padding: 1rem 0;
  margin: 0;
}

.pagination .page-item {
  margin: 0 3px;
}

.pagination .page-link {
  padding: 8px 14px;
  font-size: 0.85rem;
  color: var(--secondary-color);
  text-decoration: none;
  border: 1px solid var(--medium-gray);
  border-radius: 6px;
  transition: all 0.2s ease;
  min-width: 38px;
  text-align: center;
}

.pagination .page-link:hover {
  background-color: var(--light-gray);
  border-color: var(--medium-gray);
}

.pagination .active .page-link {
  background-color: var(--secondary-color);
  color: var(--white);
  border-color: var(--secondary-color);
}

.pagination .disabled .page-link {
  color: var(--dark-gray);
  pointer-events: none;
  background-color: var(--light-gray);
}

/* Custom Scrollbars */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--light-gray);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb {
  background: var(--primary-color);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--primary-dark);
}

/* For Firefox */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--primary-color) var(--light-gray);
}

/* Loader Styles */
.loader-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
 
}



.loader {
  border: 4px solid rgba(38, 156, 204, 0.1);
  border-top: 4px solid var(--primary-color);
  border-radius: 50%;
  width: 40px;
  height: 40px;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Form Controls */
.form-control {
  border-radius: 6px;
  padding: 8px 12px;
  border: 1px solid var(--medium-gray);
  transition: border-color 0.2s ease;
}

.form-control:focus {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 0.2rem rgba(38, 156, 204, 0.25);
}

/* Utility Classes */
.d-flex {
  display: flex;
}

.mr-2 {
  margin-right: 0.5rem;
}

.mb-3 {
  margin-bottom: 1rem;
}

/* Modal Styles */
.modal-1110w {
  max-width: 1110px;
}

.modal-content {
  border-radius: 10px;
  border: none;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
}

.white-icon {
  filter: brightness(0) invert(1);
}

.black-icon {
  filter: brightness(0) invert(0);
}

/* Preview Card */
.preview-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 1.25rem;
  border: 1px solid var(--medium-gray);
  border-radius: 8px;
  background-color: var(--white);
  box-shadow: var(--shadow);
}

.preview-card h6 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  color: var(--primary-color);
}

.preview-card p {
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
  color: var(--text-color);
}

/* Timeline Styles */
.timeline-container {
  position: relative;
  margin-left: 20px;
  padding-left: 20px;
  border-left: 2px solid var(--medium-gray);
}

.timeline-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20px;
  position: relative;
}

.timeline-icon {
  position: absolute;
  left: -26px;
  top: 2px;
  background: var(--white);
  padding: 6px;
  border-radius: 50%;
  border: 2px solid var(--medium-gray);
  font-size: 1rem;
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
}

.timeline-content {
  padding-left: 20px;
  background: var(--white);
  padding: 12px 15px;
  border-radius: 6px;
  box-shadow: var(--shadow);
  width: 100%;
}

.timeline-date {
  font-size: 0.75rem;
  color: var(--dark-gray);
  margin-bottom: 5px;
}

.timeline-title {
  font-weight: 600;
  margin-bottom: 5px;
  color: var(--primary-color);
}

.timeline-description {
  font-size: 0.85rem;
  color: var(--text-color);
}

/* Responsive Adjustments */
@media (max-width: 1199.98px) {
  .modal-1110w {
    max-width: 95%;
  }
}

@media (max-width: 991.98px) {
  .mb-2.text-center {
    font-size: 1.75rem;
  }
  
  .card-body {
    padding: 1.25rem;
  }
  
  .table th,
  .table td {
    padding: 10px 12px;
  }
}

@media (max-width: 767.98px) {
  .container-fluid {
    padding: 0 10px;
  }
  
  .mb-2.text-center {
    font-size: 1.5rem;
  }
  
  .row {
    flex-direction: column;
  }
  
  .col-md-6, .col-md-4, .col-md-2 {
    margin-bottom: 1rem;
    width: 100%;
  }
  
  .d-flex {
    flex-direction: column;
  }
  
  .mr-2 {
    margin-right: 0;
    margin-bottom: 0.5rem;
  }
  
  .table-responsive {
    border: 1px solid var(--medium-gray);
    border-radius: 6px;
  }
  
  .pagination .page-link {
    padding: 6px 10px;
    min-width: 32px;
  }
}

@media (max-width: 575.98px) {
  .mb-2.text-center {
    font-size: 1.3rem;
  }
  
  .card-header {
    padding: 0.75rem 1rem;
  }
  
  .card-body {
    padding: 1rem;
  }
  
  .btn {
    padding: 6px 12px;
    font-size: 0.8rem;
  }
  
  .pagination .page-item {
    margin: 0 2px;
  }
  
  .pagination .page-link {
    padding: 4px 8px;
    min-width: 28px;
    font-size: 0.75rem;
  }
}
