const validateStep = async () => {
  const currentFields = getCurrentStepFields();
  const requiredFields = currentFields
    .filter(field => field.required && (!field.showIf || field.showIf()));

  // Validate required fields
  requiredFields.forEach(field => {
    const value = getValues(field.name);
    if (!value || value === '') {
      setError(field.name, {
        type: 'required',
        message: `${field.label} is required`
      });
    } else if (field.type === 'file') {
      const file = value;
      const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
      
      if (!validTypes.includes(file.type)) {
        setError(field.name, {
          type: 'fileType',
          message: 'Only PDF, JPG or PNG files are allowed'
        });
      }

      if (file.size > 2 * 1024 * 1024) {
        setError(field.name, {
          type: 'fileSize',
          message: 'File size should not exceed 2MB'
        });
      }
    } else if (field.validation && field.validation.pattern) {
      const pattern = field.validation.pattern.value;
      if (!pattern.test(value)) {
        setError(field.name, {
          type: 'pattern',
          message: field.validation.pattern.message
        });
      }
    }
  });

  const fieldsToValidate = currentFields
    .filter(field => !field.showIf || field.showIf())
    .map(field => field.name);

  return await trigger(fieldsToValidate);
};
