        name: "otherGstUpload",
        code: "OTHER_GST",
        label: "GST",
        labelKey: "OTHER_GST",
        type: "file",
        required: () => true,
        colSize: 6,
      },
    ],
  },
};

export const getDocumentsForOwner = (formData = {}, ownerCd = null, t = null) => {
  const ownerCode = formData?.categoryOfOwner || ownerCd;

  return [
    ...OWNER_DOC_CONFIG.baseDocuments,
    ...(OWNER_DOC_CONFIG.categoryDocuments[ownerCode] || []),
  ].map((doc) => ({
    ...doc,
    label: t?.(`vesselOwnerRegistration.${doc.labelKey}`) || doc.label,
    required:
      typeof doc.required === "function"
        ? doc.required(formData)
        : !!doc.required,
  }));
};
