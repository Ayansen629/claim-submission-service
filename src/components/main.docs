import React from "react";
import { Form } from "react-bootstrap";
import "./styles/InputRadio.css";

type OptionType = {
  label: string;
  value: string;
};

interface InputRadioProps {
  name: string;
  label: string;
  options: OptionType[];
  register: any;
  rules?: any;
  errors?: any;
  className?: string;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
}

const InputRadio: React.FC<InputRadioProps> = ({
  name,
  label,
  options,
  register,
  rules = {},
  errors,
  className = "",
  onChange,
}) => {
  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      <div className="d-flex align-items-center flex-wrap gap-3">
        <Form.Label className="fw-bold mb-0 me-3">{label}</Form.Label>
        <div className="d-flex flex-wrap gap-3">
          {options?.map((option) => (
            <label
              className="radio-button mb-0"
              key={option.value}
              htmlFor={`${name}-${option.value}`}
            >
              <input
                type="radio"
                id={`${name}-${option.value}`}
                value={option.value}
                {...register(name, {
                  ...rules,
                  onChange,
                })}
                className="radio-input"
              />
              <span className="radio-label">{option.label}</span>
            </label>
          ))}
        </div>
      </div>
      {errors?.[name] && (
        <p className="text-danger mt-1 small">{errors[name]?.message}</p>
      )}
    </Form.Group>
  );
};

export default InputRadio;

.radio-button-group {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.radio-button {
  display: flex;
  align-items: center;
  background-color: #f2f8ff;
  border: 2px solid #cbdaf7;
  border-radius: 15px;
  padding: 8px 20px;
  cursor: pointer;
  transition: all 0.2s ease;
  font-weight: 500;
  color: #2466bf;
}

.radio-button:hover {
  background-color: #e1edff;
  border-color: #4695ff;
}

.radio-input {
  display: none;
}

.radio-input:checked+.radio-label {
  background-color: #4695ff;
  color: #fff;
  border-radius: 10px;
  padding: 5px 15px;
}

.radio-label {
  transition: all 0.2s ease;
}
