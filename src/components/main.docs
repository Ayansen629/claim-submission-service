{formData.classificationSociety && (
  <>
    <hr className="my-3" />
    <Row className="mb-3">
      <Col md={12}>
        <strong className="text-muted">{t("Classification Society")}:</strong>
        <div className="mt-1">
          <span className="text-dark">{formData.classificationSociety}</span>
        </div>
      </Col>
    </Row>
  </>
)}
