import React, { useState } from "react";
import { Container, Row, Col, Card, Button, Badge } from "react-bootstrap";
import { FaArrowLeft, FaEye, FaDownload, FaChevronLeft, FaChevronRight } from "react-icons/fa";
import { useNavigate } from "react-router-dom";
import ActionDropdown from "../../../../common/ActionDropdown.js";
import styles from './AddressChangeView.module.css';

const AddressChangeView = () => {
  const navigate = useNavigate();
  const [vesselCurrentPage, setVesselCurrentPage] = useState(1);
  const [paymentCurrentPage, setPaymentCurrentPage] = useState(1);
  const itemsPerPage = 5;

  // 10 vessel data entries
  const vesselData = [
    { id: 1, name: "Tungabhadra", number: "WB031", status: "pending" },
    { id: 2, name: "Subarnarekha", number: "WB032", status: "approved" },
    { id: 3, name: "Mahanadi", number: "WB034", status: "pending" },
    { id: 4, name: "Alaknanda", number: "WB035", status: "rejected" },
    { id: 5, name: "Bagirathi", number: "WB176", status: "approved" },
    { id: 6, name: "Meghna", number: "WB033", status: "pending" },
    { id: 7, name: "Yamuna", number: "WB037", status: "approved" },
    { id: 8, name: "Kaveri", number: "WB038", status: "pending" },
    { id: 9, name: "Narmada", number: "WB039", status: "rejected" },
    { id: 10, name: "Godavari", number: "WB040", status: "approved" }
  ];

  // 10 payment data entries
  const paymentData = [
    { id: "WB/IWT/REG/25-26/001014", type: "Owner Address Change", amount: "₹500", date: "22-09-2026", status: "Pending" },
    { id: "WB/IWT/REG/25-26/001015", type: "Vessel Registration", amount: "₹1000", date: "23-09-2026", status: "Success" },
    { id: "WB/IWT/REG/25-26/001016", type: "Certificate Renewal", amount: "₹750", date: "24-09-2026", status: "Failed" },
    { id: "WB/IWT/REG/25-26/001017", type: "Transfer of Ownership", amount: "₹1200", date: "25-09-2026", status: "Success" },
    { id: "WB/IWT/REG/25-26/001018", type: "Duplicate Certificate", amount: "₹300", date: "26-09-2026", status: "Pending" },
    { id: "WB/IWT/REG/25-26/001019", type: "Modification Fee", amount: "₹800", date: "27-09-2026", status: "Success" },
    { id: "WB/IWT/REG/25-26/001020", type: "Inspection Fee", amount: "₹600", date: "28-09-2026", status: "Pending" },
    { id: "WB/IWT/REG/25-26/001021", type: "License Renewal", amount: "₹900", date: "29-09-2026", status: "Success" },
    { id: "WB/IWT/REG/25-26/001022", type: "Registration Fee", amount: "₹1100", date: "30-09-2026", status: "Failed" },
    { id: "WB/IWT/REG/25-26/001023", type: "Survey Fee", amount: "₹450", date: "01-10-2026", status: "Success" }
  ];

  const actionOptions = [
    { actionName: "Approve Application" },
    { actionName: "Reject Application" },
    { actionName: "Send Back for Correction" },
    { actionName: "Forward to Next Level" },
    { actionName: "View Details" }
  ];

  // Pagination logic
  const vesselTotalPages = Math.ceil(vesselData.length / itemsPerPage);
  const vesselStartIndex = (vesselCurrentPage - 1) * itemsPerPage;
  const vesselCurrentData = vesselData.slice(vesselStartIndex, vesselStartIndex + itemsPerPage);

  const paymentTotalPages = Math.ceil(paymentData.length / itemsPerPage);
  const paymentStartIndex = (paymentCurrentPage - 1) * itemsPerPage;
  const paymentCurrentData = paymentData.slice(paymentStartIndex, paymentStartIndex + itemsPerPage);

  const handleActionClick = (action) => {
    console.log("Action clicked:", action);
  };

  const PaginationControls = ({ currentPage, totalPages, onPageChange, type }) => (
    <div className={styles.paginationContainer}>
      <div className={styles.paginationInfo}>
        Showing {((currentPage - 1) * itemsPerPage) + 1}-{Math.min(currentPage * itemsPerPage, type === 'vessel' ? vesselData.length : paymentData.length)} of {type === 'vessel' ? vesselData.length : paymentData.length} entries
      </div>
      <div className={styles.paginationControls}>
        <Button
          variant="outline-primary"
          size="sm"
          onClick={() => onPageChange(currentPage - 1)}
          disabled={currentPage === 1}
          className={styles.paginationBtn}
        >
          <FaChevronLeft />
        </Button>
        
        {[...Array(totalPages)].map((_, index) => {
          const page = index + 1;
          return (
            <Button
              key={page}
              variant={currentPage === page ? 'primary' : 'outline-primary'}
              size="sm"
              onClick={() => onPageChange(page)}
              className={styles.paginationBtn}
            >
              {page}
            </Button>
          );
        })}
        
        <Button
          variant="outline-primary"
          size="sm"
          onClick={() => onPageChange(currentPage + 1)}
          disabled={currentPage === totalPages}
          className={styles.paginationBtn}
        >
          <FaChevronRight />
        </Button>
      </div>
    </div>
  );

  return (
    <div className={styles.container}>
      <div className={styles.mainContent}>
        <div className={styles.topSection}>
          <div className={styles.headerRow}>
            <Button
              variant="outline-primary"
              onClick={() => navigate(-1)}
              className={styles.backButton}
            >
              <FaArrowLeft />
            </Button>
            <h5 className={styles.title}>
              Application Details Update
            </h5>
            <div className={styles.applicationId}>
              WB-IWT/REG/2025/302748
            </div>
          </div>
          
          <div className={styles.statusBanner}>
            Company Address has been updated from ABC Pvt Ltd.
          </div>
        </div>

        <Row className="mb-4">
          <Col lg={6} className="mb-3">
            <Card className={styles.namesCard}>
              <Card.Body>
                <div className={styles.nameField}>
                  <div className={styles.fieldLabel}>Existing Address</div>
                  <div className={styles.fieldValue}>123, Park View Road, Salt Lake, Kolkata - 700091, West Bengal</div>
                </div>
                <div className={styles.nameField}>
                  <div className={styles.fieldLabel}>New Address</div>
                  <div className={styles.fieldValue}>New Howrah Station, Opposite Platform 1, Howrah - 711101, West Bengal</div>
                </div>
              </Card.Body>
            </Card>
          </Col>

          <Col lg={6} className="mb-3">
            <Card className={styles.fileCard}>
              <Card.Body>
                <div className={styles.warningText}>
                  Valid documents for address change have been uploaded by the owner for your verification.
                </div>
                <div className={styles.fileRow}>
                  <span className={styles.fileName}>File Name</span>
                  <div className={styles.fileActions}>
                    <button className={styles.iconButton}>
                      <FaEye />
                    </button>
                    <button className={styles.iconButton}>
                      <FaDownload />
                    </button>
                  </div>
                </div>
              </Card.Body>
            </Card>
          </Col>
        </Row>

        <div className={styles.vesselSection}>
          <div className={styles.tableContainer}>
            <div className={styles.vesselHeader}>
              <div className={styles.sectionTitle}>SL</div>
              <div className={styles.sectionTitle}>Vessel Name</div>
              <div className={styles.sectionTitle}>Registration Number</div>
              <div className={styles.sectionTitle}>Existing Book of Registration</div>
              <div className={styles.sectionTitle}>Existing Registration Certificate</div>
              <div className={styles.sectionTitle}>New Registration Certificate</div>
            </div>

            {vesselCurrentData.map((vessel, index) => (
              <div key={vessel.id} className={styles.vesselRow}>
                <div className={styles.vesselCell} data-label="SL">
                  <span className={styles.vesselNumber}>{vesselStartIndex + index + 1}</span>
                </div>
                <div className={styles.vesselCell} data-label="Vessel Name">
                  <span className={styles.vesselName}>{vessel.name}</span>
                </div>
                <div className={styles.vesselCell} data-label="Registration Number">
                  <span>{vessel.number}</span>
                </div>
                <div className={styles.vesselCell} data-label="Existing Book">
                  <div className={styles.vesselActions}>
                    <button className={styles.vesselIconButton}>
                      <FaEye />
                    </button>
                    <button className={styles.vesselIconButton}>
                      <FaDownload />
                    </button>
                  </div>
                </div>
                <div className={styles.vesselCell} data-label="Existing Certificate">
                  <div className={styles.vesselActions}>
                    <button className={styles.vesselIconButton}>
                      <FaEye />
                    </button>
                    <button className={styles.vesselIconButton}>
                      <FaDownload />
                    </button>
                  </div>
                </div>
                <div className={styles.vesselCell} data-label="New Certificate">
                  <div className={styles.vesselActions}>
                    <button className={styles.vesselIconButton}>
                      <FaEye />
                    </button>
                    <button className={styles.vesselIconButton}>
                      <FaDownload />
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
          
          <PaginationControls
            currentPage={vesselCurrentPage}
            totalPages={vesselTotalPages}
            onPageChange={setVesselCurrentPage}
            type="vessel"
          />
        </div>

        <div className={styles.paymentSection}>
          <div className={styles.paymentHeader}>
            <span className={styles.paymentIcon}>💳</span>
            <span className={styles.paymentTitle}>Payment Details</span>
          </div>
          
          <div className={styles.tableContainer}>
            <div className={styles.paymentTableHeader}>
              <div className={styles.tableHeaderCell}>Payment Id</div>
              <div className={styles.tableHeaderCell}>Payment Type</div>
              <div className={styles.tableHeaderCell}>Amount</div>
              <div className={styles.tableHeaderCell}>Payment Date</div>
              <div className={styles.tableHeaderCell}>Status</div>
              <div className={styles.tableHeaderCell}>Receipt</div>
            </div>

            {paymentCurrentData.map((payment) => (
              <div key={payment.id} className={styles.paymentRow}>
                <div className={styles.paymentCell} data-label="Payment ID">{payment.id}</div>
                <div className={styles.paymentCell} data-label="Payment Type">{payment.type}</div>
                <div className={styles.paymentCell} data-label="Amount">{payment.amount}</div>
                <div className={styles.paymentCell} data-label="Payment Date">{payment.date}</div>
                <div className={styles.paymentCell} data-label="Status">
                  <Badge bg={payment.status === 'Success' ? 'success' : payment.status === 'Failed' ? 'danger' : 'warning'} text="dark">
                    {payment.status}
                  </Badge>
                </div>
                <div className={styles.paymentCell} data-label="Receipt">
                  <button className={styles.tableIconButton}>
                    <FaEye />
                  </button>
                  <button className={styles.tableIconButton}>
                    <FaDownload />
                  </button>
                </div>
              </div>
            ))}
          </div>
          
          <PaginationControls
            currentPage={paymentCurrentPage}
            totalPages={paymentTotalPages}
            onPageChange={setPaymentCurrentPage}
            type="payment"
          />
        </div>

        <div className={styles.actionSection}>
          <ActionDropdown 
            actions={actionOptions}
            onActionClick={handleActionClick}
          />
        </div>
      </div>
    </div>
  );
};

export default AddressChangeView;
