import React, { useState } from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";

const themeColor = "#2E57A7";
const successColor = "#28a745";

const Stepper = ({ 
  steps, 
  onSave, 
  viewMode = false, 
  actionComponent = null,
  onNext,
  onBack,
  onPayNow 
}) => {
  const { t } = useTranslation();
  const [activeStep, setActiveStep] = useState(0);
  const [completed, setCompleted] = useState({});
  const [errors, setErrors] = useState({});

  const totalSteps = steps.length;

  const handleNext = async () => {
    if (viewMode) {
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
      return;
    }
    
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
        onNext && onNext(activeStep);
      } else {
        toast.error("Please fix the errors before proceeding.");
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
      onNext && onNext(activeStep);
    }
  };

  const handleBack = () => {
    setActiveStep((prev) => Math.max(prev - 1, 0));
    onBack && onBack(activeStep);
  };

  const handleSave = async () => {
    if (viewMode) return;
    
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        if (activeStep < totalSteps - 1) {
          setActiveStep((prev) => prev + 1);
        } else {
          onSave();
        }
      } else {
        toast.error("Please fix the errors before proceeding.");
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      if (activeStep < totalSteps - 1) {
        setActiveStep((prev) => prev + 1);
      } else {
        onSave();
      }
    }
  };

  const handlePayNow = () => {
    if (onPayNow) {
      onPayNow();
    } else if (
      steps[activeStep] &&
      steps[activeStep].component &&
      typeof steps[activeStep].component.props.onPayNow === "function"
    ) {
      steps[activeStep].component.props.onPayNow();
    }
  };

  return (
    <Box sx={{ width: "100%", padding: "1rem" }}>
      <Paper
        elevation={3}
        sx={{
          padding: "0.75rem 1.5rem",
          borderRadius: "0.75rem",
          overflowX: "auto",
          whiteSpace: "nowrap",
          backgroundColor: "#fafafa",
        }}
      >
        <Stack direction="row" alignItems="center" spacing={1}>
          {steps.map((step, index) => (
            <React.Fragment key={index}>
              <Stack
                direction="row"
                alignItems="center"
                spacing={0.5}
                sx={{ cursor: "pointer" }}
                onClick={() => setActiveStep(index)}
              >
                {completed[index] ? (
                  <CheckCircleFill size={18} color={successColor} />
                ) : (
                  <Typography
                    sx={{
                      fontSize: "0.875rem",
                      width: "1.5rem",
                      height: "1.5rem",
                      textAlign: "center",
                      borderRadius: "50%",
                      backgroundColor: "#e0e0e0",
                      display: "inline-flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: "bold",
                      color: "#666",
                    }}
                  >
                    {index + 1}
                  </Typography>
                )}
                <Typography
                  sx={{
                    fontWeight: index === activeStep ? "bold" : "normal",
                    color: index === activeStep ? themeColor : "#999",
                    fontSize: "0.875rem",
                    whiteSpace: "nowrap",
                  }}
                >
                  {step.label}
                </Typography>
              </Stack>
              {index < steps.length - 1 && <ChevronRight size={14} color="#ccc" />}
            </React.Fragment>
          ))}
        </Stack>
      </Paper>

      <Paper
        elevation={2}
        sx={{
          marginTop: "1rem",
          borderRadius: "0.75rem",
          backgroundColor: "#fff",
          width: "100%",
        }}
      >
        {steps[activeStep].component}
        {errors[activeStep]}
      </Paper>

      <Divider sx={{ margin: "2rem 0" }} />

      <Box
        sx={{
          display: "flex",
          justifyContent: "space-between",
          gap: "1rem",
          flexWrap: "wrap",
        }}
      >
        <Button
          variant="outlined"
          onClick={handleBack}
          disabled={activeStep === 0}
          sx={{
            color: themeColor,
            borderColor: themeColor,
            fontWeight: "bold",
            borderRadius: "0.5rem",
            minWidth: "8rem",
            fontSize: "0.9rem",
          }}
        >
          {t("Previous")}
        </Button>
        
        {viewMode ? (
          activeStep === totalSteps - 1 ? (
            actionComponent || (
              <Button
                variant="contained"
                sx={{
                  backgroundColor: themeColor,
                  fontWeight: "bold",
                  borderRadius: "0.5rem",
                  minWidth: "8rem",
                  fontSize: "0.9rem",
                  color: "#fff",
                  "&:hover": {
                    backgroundColor: "#1f4ea0",
                  },
                }}
              >
                {t("Take Action")}
              </Button>
            )
          ) : (
            <Button
              variant="contained"
              onClick={handleNext}
              sx={{
                backgroundColor: themeColor,
                fontWeight: "bold",
                borderRadius: "0.5rem",
                minWidth: "8rem",
                fontSize: "0.9rem",
                color: "#fff",
                "&:hover": {
                  backgroundColor: "#1f4ea0",
                },
              }}
            >
              {t("Next")}
            </Button>
          )
        ) : (
          activeStep === totalSteps - 1 ? (
            <Button
              variant="contained"
              onClick={handlePayNow}
              sx={{
                backgroundColor: themeColor,
                fontWeight: "bold",
                borderRadius: "0.5rem",
                minWidth: "8rem",
                fontSize: "0.9rem",
                color: "#fff",
                "&:hover": {
                  backgroundColor: "#1f4ea0",
                },
              }}
            >
              {t("Pay Now")}
            </Button>
          ) : (
            <Button
              variant="contained"
              onClick={handleSave}
              sx={{
                backgroundColor: themeColor,
                fontWeight: "bold",
                borderRadius: "0.5rem",
                minWidth: "8rem",
                fontSize: "0.9rem",
                color: "#fff",
                "&:hover": {
                  backgroundColor: "#1f4ea0",
                },
              }}
            >
              {t("Save & Next")}
            </Button>
          )
        )}
      </Box>
    </Box>
  );
};

export default Stepper;
