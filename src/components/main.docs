const getStatData = (surveyData, upcomingSurveys) => {
  // Calculate dynamic counts from survey data
  const pendingSurveys = surveyData.filter(s => s.status === SURVEY_STATUSES.PENDING).length;
  const inProgressSurveys = surveyData.filter(s => s.status === SURVEY_STATUSES.IN_PROGRESS).length;
  const completedSurveys = surveyData.filter(s => s.status === SURVEY_STATUSES.COMPLETED).length;
  const scheduledSurveys = surveyData.filter(s => s.status === SURVEY_STATUSES.SCHEDULED).length;
  
  // Calculate surveys in next 30 days
  const today = new Date();
  const next30Days = new Date();
  next30Days.setDate(today.getDate() + 30);
  const upcoming30Days = upcomingSurveys.filter(survey => {
    const surveyDate = new Date(survey.date);
    return surveyDate >= today && surveyDate <= next30Days;
  }).length;

  return [
    {
      title: "Total Registered Vessels",
      value: surveyData.reduce((acc, curr) => {
        return acc.add(curr.vesselName); // Using Set to count unique vessels
      }, new Set()).size,
      icon: BsClipboardData,
      color: "#28a745",
      subtitle: "(Unique vessels in system)",
      trend: "up", // can be 'up', 'down', or 'neutral'
      trendValue: "5%",
    },
    {
      title: "Pending Survey Applications",
      value: pendingSurveys,
      icon: BsExclamationTriangle,
      color: "#ffc107",
      subtitle: "(Require immediate attention)",
      alert: pendingSurveys > 20,
    },
    {
      title: "Surveys In Progress",
      value: inProgressSurveys,
      icon: BsExclamationTriangle,
      color: "#fd7e14",
      subtitle: "(Currently being conducted)",
      progress: Math.min(100, (inProgressSurveys / 50) * 100), // 50 is capacity
    },
    {
      title: "Drawing Approvals Pending",
      value: 7,
      icon: BsExclamationTriangle,
      color: "#dc3545",
      subtitle: "(Technical drawings for review)",
      deadline: "3 days", // optional deadline indicator
    },
    {
      title: "Survey Statistics",
      imageSrc: chart_icon,
      color: "#6ec1e4",
      subtitle: "(Current year breakdown)",
      interactive: true, // indicates this card is clickable
    },
    {
      title: "Surveys Scheduled",
      value: scheduledSurveys,
      icon: BsCalendarEvent,
      color: "#17a2b8",
      subtitle: "(Including next 30 days)",
      secondaryValue: upcoming30Days,
      secondaryLabel: "next 30d",
    },
    {
      title: "Surveys Completed",
      value: completedSurveys,
      icon: BsCheckCircle,
      color: "#28a745",
      subtitle: "(Year to date)",
      target: 100, // yearly target
      progress: Math.min(100, (completedSurveys / 100) * 100),
    },
    {
      title: "Certificates Issued",
      value: completedSurveys * 0.9, // assuming 90% completion rate
      icon: BsFileEarmarkCheck,
      color: "#6f42c1",
      subtitle: "(Current fiscal year)",
      trend: "up",
      trendValue: "12% YoY",
    },
    {
      title: "Average Processing Time",
      value: "4.2",
      unit: "days",
      icon: BsClock,
      color: "#20c997",
      subtitle: "(Last 30 surveys average)",
      comparison: "2.1% faster",
    }
  ];
};

// Usage in your component:
const [statData, setStatData] = useState([]);

useEffect(() => {
  if (surveyData.length && upcomingSurveys.length) {
    setStatData(getStatData(surveyData, upcomingSurveys));
  }
}, [surveyData, upcomingSurveys]);
