<div className="container-fluid position-relative z-2">
  <div className={`row g-0 pt-4 px-4 ${styles.headerRow}`}>
    {/* Right Side: Nav Links + Line */}
    <div className={`${styles.topNavCol} mb-0 col-12 position-relative`}>
      <div className={`d-flex justify-content-center align-items-center w-100 ${styles.navGroupWrapper}`}>
        <div className="d-flex flex-column align-items-center w-100">
          <Nav className="d-flex flex-wrap justify-content-center">
            {/* Nav items */}
          </Nav>
          <div className="w-100 border-top border-white mt-1"></div>
        </div>

        {/* Logo and Login button for desktop */}
        <div className="d-none d-md-block">
          <img src={BengalLogo} alt="Logo" style={{ width: "4.25rem", height: "5rem", position: "absolute", top: "-17px", right: "0" }} />
          <Button variant="light" className={`${styles.homeLoginBtn}`} onClick={() => navigate("/login")}>
            {t("home2.Login")}
          </Button>
        </div>
      </div>
    </div>

    {/* Left Side: Logo + Brand Name */}
    <div className="mt-0 col-12 d-flex flex-column align-items-center align-items-md-start">
      <div className="d-flex align-items-center justify-content-center" style={{ marginTop: "-2rem" }}>
        <img className="me-2" src={IWTIcon} alt="Logo" style={{ width: "5.5rem", borderRadius: "0px" }} />
      </div>
      <div className="text-center text-md-start">
        <p className={`${styles.brandName} mt-1`}>{t("home2.InlandWaterTransportServices")}</p>
        <p className={`${styles.brandName} mt-1`}>{t("home2.departmentOfWB")}</p>
      </div>
      
      {/* Login button for mobile */}
      <div className="d-block d-md-none mt-2">
        <Button variant="light" className={`${styles.homeLoginBtn}`} onClick={() => navigate("/login")}>
          {t("home2.Login")}
        </Button>
      </div>
    </div>
  </div>
</div>
