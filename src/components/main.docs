<Col md={4}>
  <InputSelect
    label={t("Type of Survey")}
    required={true}
    name="basicVesselInfo.typeOfSurvey"
    options={[
      {
        value: "",
        label: "-- Select --",
      },
      ...(masterData?.surveyTypes?.map((type) => ({
        value: type.valueCode,
        label: type.valueLabel,
      })) || []),
    ]}
    register={register("basicVesselInfo.typeOfSurvey", {
      required: t("Type of Survey is required"),
    })}
    errors={errors}
    value={watch("basicVesselInfo.typeOfSurvey") || ""}
    onChange={(value) =>
      !viewMode &&
      handleSelectChange("basicVesselInfo.typeOfSurvey", value)
    }
    disabled={true}
  />
</Col>



useEffect(() => {
  // Find Renewal survey type from masterData
  const renewalSurvey = masterData?.surveyTypes?.find(
    type => type.valueCode === "Renewal" || type.valueLabel === "Renewal"
  );
  
  if (renewalSurvey) {
    setValue("basicVesselInfo.typeOfSurvey", renewalSurvey.valueCode);
  }
}, [setValue, masterData])
