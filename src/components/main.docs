import React, { useState, useEffect } from "react";
import { Row, Col, Table, Card } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { formatDate } from "../../../../../utils/constants.ts";
import styles from "../../../../common/styles/ProvisionalCertificateOfSurvey.module.css";

const ProvisionalCertificateOfSurvey = ({ registrationData, surveyData, preFilledCertData }) => {
  const { t } = useTranslation();

  const currentDate = new Date();
  const expiryDate = new Date(currentDate.getTime() + (60 * 24 * 60 * 60 * 1000));

  // Only editable fields
  const [editableData, setEditableData] = useState({
    expiryDay: expiryDate.getDate().toString().padStart(2, '0'),
    expiryMonth: (expiryDate.getMonth() + 1).toString().padStart(2, '0'),
    expiryYear: expiryDate.getFullYear().toString(),
    certificateNo: '',
    loadingMarksOnSide: 'Yes',
    notExtendingBeyondNauticalMiles: '12',
    safetyEquipment: {
      noOfBoats: '',
      noOfBuoyantApparatus: '',
      noOfLifebuoys: '',
      noOfLifejackets: '',
      fireExtinguishersFoamType: '',
      fireExtinguishersSodaAcid: '',
      fireExtinguishersDryCarbonPowder: '',
      anchorCable: '',
      hose: ''
    }
  });

  useEffect(() => {
    if (preFilledCertData) {
      setEditableData(prev => ({
        ...prev,
        expiryDay: preFilledCertData.expiryDay || prev.expiryDay,
        expiryMonth: preFilledCertData.expiryMonth || prev.expiryMonth,
        expiryYear: preFilledCertData.expiryYear || prev.expiryYear,
        certificateNo: preFilledCertData.certificateNo || '',
        loadingMarksOnSide: preFilledCertData.loadingMarksOnSide || 'Yes',
        notExtendingBeyondNauticalMiles: preFilledCertData.notExtendingBeyondNauticalMiles || '12',
        safetyEquipment: {
          noOfBoats: preFilledCertData.noOfBoats || '',
          noOfBuoyantApparatus: preFilledCertData.noOfBuoyantApparatus || '',
          noOfLifebuoys: preFilledCertData.noOfLifebuoys || '',
          noOfLifejackets: preFilledCertData.noOfLifejackets || '',
          fireExtinguishersFoamType: preFilledCertData.fireExtinguishersFoamType || '',
          fireExtinguishersSodaAcid: preFilledCertData.fireExtinguishersSodaAcid || '',
          fireExtinguishersDryCarbonPowder: preFilledCertData.fireExtinguishersDryCarbonPowder || '',
          anchorCable: preFilledCertData.anchorCable || '',
          hose: preFilledCertData.hose || ''
        }
      }));
    }
  }, [preFilledCertData]);

  const handleInputChange = (field, value) => {
    if (field.includes('.')) {
      const [parent, child] = field.split('.');
      setEditableData(prev => ({
        ...prev,
        [parent]: {
          ...prev[parent],
          [child]: value
        }
      }));
    } else {
      setEditableData(prev => ({
        ...prev,
        [field]: value
      }));
    }
  };

  return (
    <div className={styles.certificateContainer}>
      {/* Header */}
      <div className={styles.certificateHeader}>
        <div className={styles.headerContent}>
          <h3 className={styles.certificateTitle}>PROVISIONAL CERTIFICATE OF SURVEY</h3>
          <p className={styles.subtitle}>Inland Vessels Act, 2021</p>
        </div>
      </div>

      {/* Certificate Info Card */}
      <Card className={styles.infoCard}>
        <Card.Body>
          <Row className="g-3">
            <Col xs={12} lg={4}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Category")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.category || "INITIAL"}</div>
              </div>
            </Col>
            <Col xs={12} lg={8}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Expiry on or before the")}</label>
                <div className={styles.dateInputGroup}>
                  <input
                    type="text"
                    className={styles.dateInput}
                    value={editableData.expiryDay}
                    onChange={(e) => handleInputChange('expiryDay', e.target.value)}
                    maxLength="2"
                    placeholder="DD"
                  />
                  <span className={styles.dateSeparator}>-</span>
                  <input
                    type="text"
                    className={styles.dateInput}
                    value={editableData.expiryMonth}
                    onChange={(e) => handleInputChange('expiryMonth', e.target.value)}
                    maxLength="2"
                    placeholder="MM"
                  />
                  <span className={styles.dateSeparator}>-</span>
                  <input
                    type="text"
                    className={styles.dateInput}
                    value={editableData.expiryYear}
                    onChange={(e) => handleInputChange('expiryYear', e.target.value)}
                    maxLength="4"
                    placeholder="YYYY"
                  />
                </div>
              </div>
            </Col>
          </Row>

          <Row className="g-3 mt-2">
            <Col xs={12} lg={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Provisional Certificate of Survey No.")}</label>
                <input
                  type="text"
                  className={styles.editableInput}
                  value={editableData.certificateNo}
                  onChange={(e) => handleInputChange('certificateNo', e.target.value)}
                  placeholder="Enter Certificate No."
                />
              </div>
            </Col>
            <Col xs={12} lg={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Zone of operation")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.zoneOfOperation || "ZONE 1"}</div>
              </div>
            </Col>
          </Row>

          <Row className="g-3 mt-2">
            <Col xs={12} lg={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Date of Issue")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.dateOfIssue || formatDate(currentDate)}</div>
              </div>
            </Col>
            <Col xs={12} lg={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Date of Expiry")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.dateOfExpiry || formatDate(expiryDate)}</div>
              </div>
            </Col>
          </Row>
        </Card.Body>
      </Card>

      {/* Statement */}
      <div className={styles.statementBox}>
        <p>{t("This Provisional Certificate of Survey has been issued subsequent to Survey carried out of the below detailed inland vessel.")}</p>
      </div>

      {/* Vessel Details */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("VESSEL DETAILS")}</h5>
        </Card.Header>
        <Card.Body>
          <Row className="g-3">
            <Col xs={12} md={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Name of the Vessel")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.vesselName || "N/A"}</div>
              </div>
            </Col>
            <Col xs={12} md={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Official No.")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.officialNo || "N/A"}</div>
              </div>
            </Col>
            <Col xs={12} md={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Port of Registry")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.portOfRegistry || "N/A"}</div>
              </div>
            </Col>
            <Col xs={12} md={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Certificate of Registry No.")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.certificateOfRegistryNo || "N/A"}</div>
              </div>
            </Col>
            <Col xs={12} md={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Gross Tonnage")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.grossTonnage || "N/A"}</div>
              </div>
            </Col>
            <Col xs={12} md={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Registered Tonnage")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.registeredTonnage || "N/A"}</div>
              </div>
            </Col>
            <Col xs={12} md={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Freeboard Assigned")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.freeboardAssigned || "N/A"}</div>
              </div>
            </Col>
            <Col xs={12} md={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Loading marks placed on the vessel's side")}</label>
                <select
                  className={styles.editableSelect}
                  value={editableData.loadingMarksOnSide}
                  onChange={(e) => handleInputChange('loadingMarksOnSide', e.target.value)}
                >
                  <option value="Yes">Yes</option>
                  <option value="No">No</option>
                </select>
              </div>
            </Col>
            <Col xs={12} md={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Name of Owner")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.ownerName || "N/A"}</div>
              </div>
            </Col>
            <Col xs={12} md={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Address of Owner")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.ownerAddress || "N/A"}</div>
              </div>
            </Col>
          </Row>
        </Card.Body>
      </Card>

      {/* Survey Details */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("SURVEY DETAILS")}</h5>
        </Card.Header>
        <Card.Body>
          <Row className="g-3">
            <Col xs={12} md={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Date of Survey carried out")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.dateOfSurveyCarriedOut || formatDate(currentDate)}</div>
              </div>
            </Col>
            <Col xs={12} md={6}>
              <div className={styles.fieldGroup}>
                <label className={styles.fieldLabel}>{t("Place of survey carried out")}</label>
                <div className={styles.fieldValue}>{preFilledCertData?.placeOfSurveyCarriedOut || "N/A"}</div>
              </div>
            </Col>
          </Row>
        </Card.Body>
      </Card>

      {/* Plying Limits */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("PLYING LIMITS")}</h5>
        </Card.Header>
        <Card.Body>
          <div className={styles.plyingLimitsContent}>
            <span className={styles.inlineLabel}>{t("Within inland waters limits")}:</span>
            <span className={styles.inlineValue}>{preFilledCertData?.zoneOfOperation || "ZONE 1"}</span>
            <span className={styles.inlineLabel}>{t("not extending beyond")}:</span>
            <input
              type="text"
              className={styles.inlineInput}
              value={editableData.notExtendingBeyondNauticalMiles}
              onChange={(e) => handleInputChange('notExtendingBeyondNauticalMiles', e.target.value)}
            />
            <span className={styles.inlineLabel}>{t("Nautical Miles from the nearest shore.")}</span>
          </div>
        </Card.Body>
      </Card>

      {/* Capacity */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("CARGO/PASSENGER CAPACITY")}</h5>
        </Card.Header>
        <Card.Body>
          <Row className="g-3">
            <Col xs={12} md={4}>
              <div className={styles.capacityItem}>
                <span className={styles.capacityLabel}>{t("Cargo")}:</span>
                <span className={styles.capacityValue}>{preFilledCertData?.cargoCapacity || "N/A"}</span>
              </div>
            </Col>
            <Col xs={12} md={4}>
              <div className={styles.capacityItem}>
                <span className={styles.capacityLabel}>{t("Passengers")}:</span>
                <span className={styles.capacityValue}>{preFilledCertData?.passengerCapacity || "N/A"}</span>
              </div>
            </Col>
            <Col xs={12} md={4}>
              <div className={styles.capacityItem}>
                <span className={styles.capacityLabel}>{t("Crew")}:</span>
                <span className={styles.capacityValue}>{preFilledCertData?.crewCapacity || "N/A"}</span>
              </div>
            </Col>
          </Row>
        </Card.Body>
      </Card>

      {/* Safety Equipment */}
      <Card className={styles.detailsCard}>
        <Card.Header className={styles.cardHeader}>
          <h5>{t("SAFETY EQUIPMENT")}</h5>
        </Card.Header>
        <Card.Body>
          <div className="table-responsive">
            <Table className={styles.safetyTable}>
              <thead>
                <tr>
                  <th>{t("Boats")}</th>
                  <th>{t("Life Rafts")}</th>
                  <th>{t("Lifebuoys")}</th>
                  <th>{t("Lifejackets")}</th>
                  <th>{t("Foam Type")}</th>
                  <th>{t("Soda Acid")}</th>
                  <th>{t("Dry Powder")}</th>
                  <th>{t("Anchor Cable")}</th>
                  <th>{t("Hose")}</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    <input
                      type="text"
                      className={styles.tableInput}
                      value={editableData.safetyEquipment.noOfBoats}
                      onChange={(e) => handleInputChange('safetyEquipment.noOfBoats', e.target.value)}
                      placeholder="-"
                    />
                  </td>
                  <td>
                    <input
                      type="text"
                      className={styles.tableInput}
                      value={editableData.safetyEquipment.noOfBuoyantApparatus}
                      onChange={(e) => handleInputChange('safetyEquipment.noOfBuoyantApparatus', e.target.value)}
                      placeholder="-"
                    />
                  </td>
                  <td>
                    <input
                      type="text"
                      className={styles.tableInput}
                      value={editableData.safetyEquipment.noOfLifebuoys}
                      onChange={(e) => handleInputChange('safetyEquipment.noOfLifebuoys', e.target.value)}
                      placeholder="-"
                    />
                  </td>
                  <td>
                    <input
                      type="text"
                      className={styles.tableInput}
                      value={editableData.safetyEquipment.noOfLifejackets}
                      onChange={(e) => handleInputChange('safetyEquipment.noOfLifejackets', e.target.value)}
                      placeholder="-"
                    />
                  </td>
                  <td>
                    <input
                      type="text"
                      className={styles.tableInput}
                      value={editableData.safetyEquipment.fireExtinguishersFoamType}
                      onChange={(e) => handleInputChange('safetyEquipment.fireExtinguishersFoamType', e.target.value)}
                      placeholder="-"
                    />
                  </td>
                  <td>
                    <input
                      type="text"
                      className={styles.tableInput}
                      value={editableData.safetyEquipment.fireExtinguishersSodaAcid}
                      onChange={(e) => handleInputChange('safetyEquipment.fireExtinguishersSodaAcid', e.target.value)}
                      placeholder="-"
                    />
                  </td>
                  <td>
                    <input
                      type="text"
                      className={styles.tableInput}
                      value={editableData.safetyEquipment.fireExtinguishersDryCarbonPowder}
                      onChange={(e) => handleInputChange('safetyEquipment.fireExtinguishersDryCarbonPowder', e.target.value)}
                      placeholder="-"
                    />
                  </td>
                  <td>
                    <input
                      type="text"
                      className={styles.tableInput}
                      value={editableData.safetyEquipment.anchorCable}
                      onChange={(e) => handleInputChange('safetyEquipment.anchorCable', e.target.value)}
                      placeholder="-"
                    />
                  </td>
                  <td>
                    <input
                      type="text"
                      className={styles.tableInput}
                      value={editableData.safetyEquipment.hose}
                      onChange={(e) => handleInputChange('safetyEquipment.hose', e.target.value)}
                      placeholder="-"
                    />
                  </td>
                </tr>
              </tbody>
            </Table>
          </div>
        </Card.Body>
      </Card>

      {/* Certificate Statement */}
      <div className={styles.certificationBox}>
        <h6 className={styles.certificationTitle}>{t("THIS IS TO CERTIFY")}</h6>
        <p className={styles.certificationText}>
          {t("that the provisions of the rules with respect to the survey of the above mentioned Inland Vessel and the Transmission of declaration in respect thereof, have been complied with.")}
        </p>
      </div>

      {/* Validity Statement */}
      <div className={styles.validityBox}>
        <p>
          {t("This Provisional Certificate of Survey, issued under the provisions of section 13(1) of the Inland Vessels Act, 2021 continues to be in force only until the")} 
          <strong> ({editableData.expiryDay}-{editableData.expiryMonth}-{editableData.expiryYear})</strong>
        </p>
      </div>
    </div>
  );
};

export default ProvisionalCertificateOfSurvey;
