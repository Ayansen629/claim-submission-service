import React, { useState, useEffect, useCallback } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip"; 
import "./StepFirst.css";

const StepFirst = ({ provideSubmitHandler, formData }) => {
  const methods = useForm();
  const { register, handleSubmit, formState: { errors }, trigger, clearErrors, setValue, control, getValues, watch } = methods;

  const claimantDetailsSchema = [
    { 
      name: "CreditorName", 
      label: <>Creditor Name <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "Creditor Name is required" },
      placeholder: "Enter Creditor Name" // Added placeholder
    },
    { 
      name: "totalClaimAmount", 
      label: <>Total Claim Amount <span className="required-asterisk">*</span></>, 
      type: "number", 
      rules: { required: "Total Claim Amount is required", min: { value: 0, message: "Value must be greater than or equal to 0" } },
      placeholder: "Enter Total Claim Amount" // Added placeholder
    },
    { 
      name: "debtDetails", 
      label: <>Debt Incurred Details <span className="required-asterisk">*</span></>, 
      type: "textarea", 
      rules: { required: "Debt Details are required" },
      tooltip: "Details of how and when debt incurred", // Added tooltip
      placeholder: "Enter Debt Incurred Details" // Added placeholder
    },
    { 
      name: "mutualCreditDetails", 
      label: <>Mutual Credit/Debts Details <span className="required-asterisk">*</span></>, 
      type: "textarea", 
      rules: { required: "Mutual Credit Details are required" },
      tooltip: "Details of any mutual credit, mutual debts, or other mutual dealings between the corporate debtor and the creditor which may be set-off against the claim", // Added tooltip
      placeholder: "Enter Mutual Credit/Debts Details" // Added placeholder
    },
    {
      name: "identificationType",
      label: <>Identification Type <span className="required-asterisk">*</span></>,
      type: "select",
      options: [
        { value: "", label: "Select Identification Type", disabled: true }, // Default placeholder option
        { value: "Aadhar", label: "Aadhar" },
        { value: "PAN", label: "PAN" },
        { value: "Passport", label: "Passport" },
      ],
      rules: { required: "Identification type is required" },
      tooltip: "Select the type of identification document.",
    },
    {
      name: "identificationNumber",
      label: <>Identification Number <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Identification number is required" },
      tooltip: "You can enter Aadhar, PAN, or Passport number.",
      placeholder: "Enter Identification Number" // Added placeholder
    },
    {
      name: "identificationDocument",
      label: <>Identification Document <span className="required-asterisk">*</span></>,
      type: "file",
      rules: { required: "Identification document is required" },
      tooltip: "Upload a document as proof of identification (e.g., Aadhar, PAN, or Passport).",
    },
  ];

  const onSubmit = useCallback(async () => {
    // Trigger validation for all fields
    const isValid = await trigger();
  
    // Check if the Identification Document is uploaded
    const identificationDocument = getValues("identificationDocument");
  
    if (!isValid || !identificationDocument) {
      console.error("Validation failed or Identification Document not uploaded");
      return false;
    }
  
    return getValues(); // Return form values if validation passes
  }, [trigger, getValues]);

  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        setValue(key, formData[key]);
      });
    }
  }, [formData, setValue]);

  useEffect(() => {
    if (provideSubmitHandler) {
      provideSubmitHandler(onSubmit);
    }
  }, [provideSubmitHandler, onSubmit]);

  // Watch the identificationType field to trigger validation when it changes
  const identificationType = watch("identificationType");

  useEffect(() => {
    if (identificationType) {
      trigger("identificationType"); // Trigger validation for identificationType
    }
  }, [identificationType, trigger]);

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        <div className="mb-4 bg-light">
          <Collapsible title="Creditor Basic Details">
            <div className="flex-container">
              {claimantDetailsSchema.map((fieldConfig) => (
                <DynamicField
                  key={fieldConfig.name}
                  fieldConfig={fieldConfig}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  trigger={trigger}
                  getValues={getValues}
                />
              ))}
            </div>
          </Collapsible>
        </div>
      </form>
    </FormProvider>
  );
};

export default StepFirst;
