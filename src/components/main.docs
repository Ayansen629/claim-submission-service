        // iwtRegistrationBookTFk: apiData.step1?.uuidofRegistrationBook ? String(apiData.step1.uuidofRegistrationBook) : "",
        typeOfBoiler: apiData.step2?.typeOfBoiler || "",
        noOfBoiler: apiData.step2?.noOfBoiler || null,
        totalHeatingSurface: apiData.step2?.totalHeatingSurface || null,
        grateArea: apiData.step2?.grateArea || null,
        workingPressure: apiData.step2?.workingPressure || null,
        madeBy: apiData.step2?.boilerMadeBy || null,
        yearOfMake: apiData.step2?.boilerYearOfMake || null,
        madeOfMaterial: apiData.step2?.madeOfMaterial || null,
        
      },
