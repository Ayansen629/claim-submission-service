/* ===== Table Component - Fixed Structure for Horizontal Scrolling ===== */
.table-component {
  width: 100%;
  margin-top: 20px;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  background-color: #ffffff;
  overflow: hidden; /* Contain all child elements */
}

/* Table Wrapper - Handles horizontal scrolling */
.table-scroll-wrapper {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch; /* Smooth scrolling on mobile */
}

/* Table Structure */
.table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed; /* Critical for consistent column widths */
  min-width: 800px; /* Minimum width before scrolling activates */
}

/* Table Header - Fixed during scrolling */
.table thead {
  position: sticky;
  top: 0;
  z-index: 20;
}

.table th {
  background: #269ccc;
  color: #ffffff;
  font-size: 18px;
  font-weight: 500;
  padding: 16px;
  text-align: left;
  border-bottom: 2px solid #1d87b0;
}

/* Table Body */
.table tbody {
  background-color: #ffffff;
}

.table tr {
  transition: background-color 0.2s ease;
}

.table tr:nth-child(even) {
  background-color: #f9f9f9;
}

.table tr:hover {
  background-color: #f1f8ff;
}

.table td {
  padding: 14px 16px;
  font-size: 14px;
  color: #34495e;
  border-bottom: 1px solid #ecf0f1;
  vertical-align: middle;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Table Footer - Fixed during scrolling */
.table-footer {
  position: sticky;
  bottom: 0;
  background: #f5f5f5;
  padding: 12px 16px;
  border-top: 1px solid #ddd;
  text-align: right;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* Status Badges */
.status-badge {
  display: inline-block;
  padding: 4px 12px;
  border-radius: 16px;
  font-size: 13px;
  font-weight: 500;
}

.status-approve {
  background: #e8f7e7;
  color: #27ae60;
}

.status-initiate {
  background: #d0e7f5;
  color: #2980b9;
}

.status-pending {
  background: #fff3e0;
  color: #e67e22;
}

/* Action Buttons */
.action-buttons {
  display: flex;
  gap: 8px;
}

.action-button {
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  border-radius: 4px;
  transition: background 0.2s;
}

.action-button:hover {
  background: rgba(0, 0, 0, 0.05);
}

.action-button img {
  width: 20px;
  height: 20px;
  display: block;
}

.action-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Pagination */
.pagination {
  display: flex;
  align-items: center;
  gap: 8px;
}

.page-number {
  min-width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #269ccc;
  border-radius: 4px;
  border: 1px solid #269ccc;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s;
}

.page-number:hover,
.page-number.active {
  background: #269ccc;
  color: #ffffff;
}

.pagination-button {
  background: none;
  border: none;
  color: #269ccc;
  font-size: 14px;
  cursor: pointer;
  padding: 6px;
}

.pagination-button:disabled {
  color: #cccccc;
  cursor: not-allowed;
}

/* Search Container */
.search-container {
  margin-bottom: 20px;
  display: flex;
  justify-content: center;
}

.search-input {
  width: 100%;
  max-width: 400px;
  padding: 10px 16px;
  border: 1px solid #d9d9d9;
  border-radius: 4px;
  font-size: 14px;
  outline: none;
  transition: border-color 0.3s;
}

.search-input:focus {
  border-color: #269ccc;
  box-shadow: 0 0 0 2px rgba(38, 156, 204, 0.2);
}

/* Responsive Adjustments */
@media (max-width: 768px) {
  .table-component {
    border-radius: 0;
    box-shadow: none;
  }
  
  .table th {
    padding: 12px;
    font-size: 16px;
  }
  
  .table td {
    padding: 10px 12px;
    font-size: 13px;
  }
  
  .table-footer {
    flex-direction: column;
    gap: 12px;
    align-items: flex-end;
  }
  
  .search-input {
    max-width: 100%;
  }
}

/* Print Styles */
@media print {
  .table-component {
    box-shadow: none;
  }
  
  .table th {
    background: #269ccc !important;
    color: white !important;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
}
