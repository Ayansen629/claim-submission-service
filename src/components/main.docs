import React from 'react';
import { Card } from 'react-bootstrap';
import { useNavigate } from 'react-router-dom';
import { OFFICER_L1_STAT_DATA } from './employeeDashboardConstants';
import StatusCard from '../../common/StatusCard';

const OfficerL1Dashboard = ({ userDetails }) => {
  const navigate = useNavigate();

  return (
    <Card className="bg-transparent mb-4 dashboard-card">
      <Card.Header className="dashboard-card-header">
        Officer L1 Dashboard
        <div style={{ float: 'right', width: 180 }}>
          <button 
            className="generic-btn-submit" 
            type="button" 
            onClick={() => navigate('/dashboard/employee-dashboard/employee-applications')}
          >
            View Applications &nbsp; <FaUsersBetweenLines size={15} color={'#fff'} />
          </button>
        </div>
      </Card.Header>
      <Card.Body>
        <div className="row g-3">
          {OFFICER_L1_STAT_DATA.map((item, index) => (
            <div className="col-md-4 col-lg-4 col-sm-6" key={index}>
              <StatusCard {...item} />
            </div>
          ))}
        </div>
      </Card.Body>
    </Card>
  );
};

export default OfficerL1Dashboard;
