import React, { useState, useEffect, useRef } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaCheckCircle } from "react-icons/fa";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
  defaultValue?: string | File;
  autoFocus?: boolean;
  clearErrors?: (fieldName: string) => void;
}


const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  watch,
  defaultValue,
  clearErrors
}) => {
  const hasError = errors && errors[name];
  const fileInputRef = useRef(null);
  const [fileSelected, setFileSelected] = useState(false);
   const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  
  const currentFile = watch ? watch(name) : null;

  useEffect(() => {
  
    if (currentFile && fileSelected) {
      clearErrors(name);
    }
  }, [currentFile, fileSelected, name, clearErrors]);

  const handleFileChange = (e) => {
    if (e.target.files && e.target.files[0]) {
      setFileSelected(true);
      if (onChange) {
        onChange(e);
      }
    }
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      <div
        className={`file-upload border rounded p-3 ${hasError ? 'border-danger' : currentFile ? 'border-success' : ''}`}
        style={{
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderRadius: '8px',
          transition: 'all 0.3s ease'
        }}
      >
        <div className="d-flex align-items-center">
          <label
            htmlFor={name}
            className={`file-label btn ${hasError ? 'btn-outline-danger' : 'btn-primary'} mb-0 d-inline-flex align-items-center`}
            style={{
              borderRadius: '6px',
              padding: '8px 16px',
              cursor: disabled ? 'not-allowed' : 'pointer',
              opacity: disabled ? 0.6 : 1,
              minWidth: '120px',
              color: 'white'
            }}
          >
            <FaUpload className="file-icon me-2" />
            <span className="file-text">Choose File</span>
          </label>
          <div
            className={`file-name-container ms-3 flex-grow-1 border rounded px-3 py-2 ${currentFile ? 'bg-light-success' : 'bg-light'} d-flex align-items-center ${hasError ? 'border-danger' : currentFile ? 'border-success' : ''}`}
            style={{
              overflow: 'hidden'
            }}
          >
            {currentFile ? (
              <>
                <FaCheckCircle className="text-success me-2 flex-shrink-0" />
                <div className="overflow-hidden">
                  <span className="text-success fw-bold" style={{ fontSize: '0.8rem' }}>Selected File:</span>
                  <div className="d-flex align-items-center">
                    <span className="file-icon-preview me-2 flex-shrink-0">
                      {currentFile.name.endsWith('.pdf') ? (
                        <FaFilePdf color="#dc3545" />
                      ) : (
                        <FaFileImage color="#28a745" />
                      )}
                    </span>
                    <span 
                      className="text-dark fw-semibold" 
                      style={{ 
                        overflow: 'hidden', 
                        textOverflow: 'ellipsis', 
                        whiteSpace: 'nowrap' 
                      }}
                    >
                      {currentFile.name}
                    </span>
                  </div>
                </div>
              </>
            ) : (
              <span className="text-muted">No file chosen</span>
            )}
          </div>
        </div>
        <input
          ref={fileInputRef}
          type="file"
          id={name}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="d-none"
        />
      </div>
      {hasError ? (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      ) : (
        <Form.Text className="text-muted small mt-1">
          {t("Upload PDF, JPG or PNG file (Max size: 2MB)")}
        </Form.Text>
      )}
    </Form.Group>
  );
};
export default InputFile;
import React, { useState } from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";


const themeColor = "#2E57A7";
const successColor = "#28a745";

const Stepper = ({ steps, onSave }) => {
   const { t } = useTranslation();
    const { changeLanguage } = useLanguageContext();
  const [activeStep, setActiveStep] = useState(0);
  const [completed, setCompleted] = useState({});
  const [errors, setErrors] = useState({});

  const totalSteps = steps.length;

  const handleNext = async () => {
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
      } else {
        toast.error("Please fix the errors before proceeding.");
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
    }
  };

  const handleBack = () => {
    setActiveStep((prev) => Math.max(prev - 1, 0));
  };

  const handleSave = async () => {
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        onSave();
      } else {
        toast.error("Please fix the errors before proceeding.");
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      onSave();
    }
  };

  // Custom handler for Pay Now on Invoicing step
  const handlePayNow = () => {
    if (
      steps[activeStep] &&
      steps[activeStep].component &&
      typeof steps[activeStep].component.props.onPayNow === "function"
    ) {
      steps[activeStep].component.props.onPayNow();
    }
  };

  return (
    <Box sx={{ width: "100%", padding: "1rem" }}>
      {/* Step Header */}
      <Paper
        elevation={3}
        sx={{
          padding: "0.75rem 1.5rem",
          borderRadius: "0.75rem",
          overflowX: "auto",
          whiteSpace: "nowrap",
          backgroundColor: "#fafafa",
        }}
      >
        <Stack direction="row" alignItems="center" spacing={1}>
          {steps.map((step, index) => (
            <React.Fragment key={index}>
              <Stack
                direction="row"
                alignItems="center"
                spacing={0.5}
                sx={{ cursor: "pointer" }}
                onClick={() => setActiveStep(index)}
              >
                {completed[index] ? (
                  <CheckCircleFill size={18} color={successColor} />
                ) : (
                  <Typography
                    sx={{
                      fontSize: "0.875rem",
                      width: "1.5rem",
                      height: "1.5rem",
                      textAlign: "center",
                      borderRadius: "50%",
                      backgroundColor: "#e0e0e0",
                      display: "inline-flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: "bold",
                      color: "#666",
                    }}
                  >
                    {index + 1}
                  </Typography>
                )}
                <Typography
                  sx={{
                    fontWeight: index === activeStep ? "bold" : "normal",
                    color: index === activeStep ? themeColor : "#999",
                    fontSize: "0.875rem",
                    whiteSpace: "nowrap",
                  }}
                >
                  {step.label}
                </Typography>
              </Stack>
              {index < steps.length - 1 && <ChevronRight size={14} color="#ccc" />}
            </React.Fragment>
          ))}
        </Stack>
      </Paper>

      {/* Step Content */}
      <Paper
        elevation={2}
        sx={{
          marginTop: "1rem",
          borderRadius: "0.75rem",
          backgroundColor: "#fff",
          width: "100%",
        }}
      >
        {steps[activeStep].component}
        {errors[activeStep]}
      </Paper>

      <Divider sx={{ margin: "2rem 0" }} />

      {/* Navigation Buttons */}
      <Box
        sx={{
          display: "flex",
          justifyContent: "space-between",
          gap: "1rem",
          flexWrap: "wrap",
        }}
      >
        <Button
          variant="outlined"
          onClick={handleBack}
          disabled={activeStep === 0}
          sx={{
            color: themeColor,
            borderColor: themeColor,
            fontWeight: "bold",
            borderRadius: "0.5rem",
            minWidth: "8rem",
            fontSize: "0.9rem",
          }}
        >
          {t("Previous")}
        </Button>
        {activeStep === 1 ? (
          <Button
            variant="contained"
            onClick={handlePayNow}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            {t("Pay Now")}
          </Button>
        ) : activeStep === totalSteps - 1 ? (
          <Button
            variant="contained"
            onClick={handleSave}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            Save
          </Button>
        ) : (
          <Button
            variant="contained"
            onClick={handleNext}
            sx={{
              backgroundColor: themeColor,
              fontWeight: "bold",
              borderRadius: "0.5rem",
              minWidth: "8rem",
              fontSize: "0.9rem",
              color: "#fff",
              "&:hover": {
                backgroundColor: "#1f4ea0",
              },
            }}
          >
            {t("Save & Next")}
          </Button>
        )}
      </Box>
    </Box>
  );
};

export default Stepper;
///
import React, { useState, useEffect, useRef } from "react";
import { useForm, FormProvider } from "react-hook-form";
import { Container, Row, Col, Button, Card, Image } from "react-bootstrap";
import {
  FaBuilding,
  FaFileUpload,
  FaCheck,
  FaArrowRight,
  FaArrowLeft,
} from "react-icons/fa";
import "./UserRegistration.css";
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";
import { toast } from "react-toastify";
import NewLoader from "../../common/NewLoader.js";
import { getData, postFORMdata } from "../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../utils/urlsConstants.ts";
import { handleErrorMessage } from "../../../utils/errorMessageHandler.js";
import { mapToVesselUserDetails } from "../model/mapToVesselModel.ts";
import ApprovalModal from "../../common/ApprovalModal.js";
import ActionDropdown from "../../common/ActionDropdown.js";
import DynamicFormFields from "../../common/DynamicFormFields";
import createFormFieldsConfig from "../../common/FormFieldsConfig";
import { NavDropdown } from "react-bootstrap";
import { MdOutlineLanguage } from "react-icons/md";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../common/LanguageContext.js";
const VesselBuilderRegistrationPage = () => {
  const { t } = useTranslation(); // Language translation hook
  const isCompMount = useRef(true);
  const { changeLanguage } = useLanguageContext();
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [successMessage, setSuccessMessage] = useState("");
  const [validationMessage, setValidationMessage] = useState("");
  const loaderRef = useRef();
  const PUBLIC_URL = process.env.REACT_APP_PUBLIC_URL;
  const actionsFromAPI = ["Accept", "Reject", "Send Back"];
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const handleActionSubmit = (formData) => {
    const payload = {
      action: selectedAction,
      ...formData,
    };
    console.log("Submitted Data:", payload);
    setShowApprovalModal(false);
    setSelectedAction("");
    // we need to API call here
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const methods = useForm({
    mode: "onBlur",
    defaultValues: { country: "India" },
  });

  const {
    handleSubmit,
    formState: { errors },
    trigger,
    setValue,
    getValues,
    watch,
    setError,
    clearErrors,
  } = methods;
  const totalSteps = 2;

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [changeLanguage]);

  useEffect(() => {
    setTimeout(() => {
      // console.log("Current Step:", currentStep);
      // console.log("current form data:", formData);
      Object.keys(formData).forEach((key) => {
        if (formData[key]) {
          // console.log("Setting value for", key, formData[key]);
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [currentStep, setValue, formData]);

  const getDetailsByPIN = async (pinCode) => {
    try {
      const URL =
        PUBLIC_URL +
        URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE +
        pinCode;
      loaderRef.current?.show();
      const response = await getData(URL);
      if (response?.status === 200 && response?.data?.length > 0) {
        setValue("district", response?.data[0]?.district);
        setValue("stateUt", response?.data[0]?.stateName);
        loaderRef?.current?.hide();
      } else {
        loaderRef?.current?.hide();
        toast.info("No Data Found! Please enter manually..", {
          position: "top-right",
        });
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const formFields = createFormFieldsConfig(getDetailsByPIN);

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1:
        return formFields.step1;
      case 2:
        return formFields.step2;
      default:
        return [];
    }
  };

  const validateStep = async () => {
    const currentFields = getCurrentStepFields();
    const currentValues = getValues();

    const isValid = await trigger(currentFields.map((field) => field.name));

    const fileFields = currentFields.filter(
      (field) => field.type === "file" && field.required
    );
    let fileErrorsExist = false;

    for (const field of fileFields) {
      const file = currentValues[field.name];

      if (!file) {
        setError(field.name, {
          type: "required",
          message: `${field.label} is required`,
        });
        fileErrorsExist = true;
        continue;
      }

      if (file instanceof File) {
        const validTypes = [
          "application/pdf",
          "image/jpeg",
          "image/png",
          "image/jpg",
        ];
        if (!validTypes.includes(file.type)) {
          setError(field.name, {
            type: "fileType",
            message: "Only PDF, JPG or PNG files are allowed",
          });
          fileErrorsExist = true;
          continue;
        }

        if (file.size > 2 * 1024 * 1024) {
          setError(field.name, {
            type: "fileSize",
            message: "File size should not exceed 2MB",
          });
          fileErrorsExist = true;
          continue;
        }
      }

      if (errors[field.name]) {
        clearErrors(field.name);
      }
    }

    return isValid && !fileErrorsExist;
  };

  const handleNext = async () => {
    const isStepValid = await validateStep();

    if (isStepValid) {
      setValidationMessage("");
      const currentValues = getValues();
      const fileFields = getCurrentStepFields().filter(
        (field) => field.type === "file"
      );

      fileFields.forEach((field) => {
        if (currentValues[field.name]) {
          setFormData((prev) => ({
            ...prev,
            [field.name]: currentValues[field.name],
          }));
        }
      });

      setFormData((prev) => ({ ...prev, ...currentValues }));

      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    } else {
      const firstError = Object.keys(errors)[0];
      if (firstError) {
        const element = document.getElementsByName(firstError)[0];
        if (element) {
          element.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      }
    }
  };

  const handlePrevious = () => {
    const currentValues = getValues();
    const fileFields = getCurrentStepFields().filter(
      (field) => field.type === "file"
    );
    fileFields.forEach((field) => {
      if (currentValues[field.name]) {
        setFormData((prev) => ({
          ...prev,
          [field.name]: currentValues[field.name],
        }));
      }
    });

    setFormData((prev) => ({ ...prev, ...currentValues }));
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
    setValidationMessage("");
  };

  const onSubmit = (data) => {
    const finalData = { ...formData, ...data };
    finalData.userCategory = "Ship-Builder";
    finalData.userType = "Builder";
    const formDetails = mapToVesselUserDetails({ ...finalData });

    const filesToUpload = [
      finalData?.companyDetails,
      finalData?.gstCertificate,
      finalData?.panCardUpload,
      finalData?.factoryLicense,
      finalData?.addressProof,
      finalData?.fireCertificate,
      finalData?.esipfRegistration,
      finalData?.iso9001,
      finalData?.iso14001,
      finalData?.iso45001,
      finalData?.pollutionCertificate,
      finalData?.experienceCertificate,
    ].filter((file) => file);

    const fd = new FormData();
    fd.append(
      "request",
      new Blob([JSON.stringify(formDetails)], { type: "application/json" })
    );
    filesToUpload?.forEach((file) => {
      if (file) {
        fd.append(`files`, file);
      }
    });
    submitUserDetails(fd);
  };

  const submitUserDetails = async (payload) => {
    try {
      const URL =
        process.env.REACT_APP_AUTH_URL + URLS_ENDPOINT.USER_SERVICE.CREATE_USER;
      loaderRef.current?.show();
      const response = await postFORMdata(URL, payload);
      const apiRes = { ...response?.data };
      if (
        response?.status === 200 &&
        apiRes?.responseStatus?.status === "200"
      ) {
        loaderRef?.current?.hide();
        setIsSubmitted(true);
        setSuccessMessage(apiRes?.responseStatus?.message);
        window.scrollTo(0, 0);
      } else {
        loaderRef?.current?.hide();
        toast.info(
          apiRes?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err, "builder-error");
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const stepTitles = [
    { title: t("Vessel Builder Details"), icon: FaBuilding },
    { title: t("Documents Upload"), icon: FaFileUpload },
  ];

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="registration-container py-5">
        <div
          style={{
            position: "absolute",
            top: "10px",
            right: "10px",
            zIndex: 1050,
          }}
        >
          <NavDropdown
            title={
              <MdOutlineLanguage
                style={{ fontSize: "1.5rem", color: "#fff" }}
              />
            }
            id="language-nav-dropdown"
            className="mx-2"
            style={{
              display: "inline-block",
              marginTop: "10px",
              zIndex: 1050,
              position: "relative",
            }}
          >
            <NavDropdown.Item
              onClick={() => changeLanguage("en")}
              className="small-text"
              style={{
                color: "#000000",
                padding: "10px 15px",
              }}
            >
              English
            </NavDropdown.Item>
            <NavDropdown.Item
              onClick={() => changeLanguage("bn")}
              className="small-text"
              style={{
                color: "#000000",
                padding: "10px 15px",
              }}
            >
              বাংলা
            </NavDropdown.Item>
          </NavDropdown>
        </div>
        <Row className="justify-content-center">
          <Col md={10} xl={9}>
            <Card className="registration-card">
              <Card.Header className="registration-header p-0">
                <div className="registration-header-content">
                  <div className="header-logo-container">
                    <Image
                      src={IWT_FULL_IMG}
                      alt="IWT Logo"
                      className="header-logo"
                    />
                  </div>
                  <h3 className="header-title">
                    {t("Vessel Builder Registration")}
                  </h3>
                </div>
              </Card.Header>

              <Card.Body className="registration-body p-4 p-md-5">
                {isSubmitted ? (
                  <div className="success-container text-center py-5">
                    <div
                      className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4"
                      style={{
                        width: "90px",
                        height: "90px",
                        boxShadow: "0 10px 20px rgba(40, 167, 69, 0.3)",
                      }}
                    >
                      <FaCheck className="success-icon text-white fs-1" />
                    </div>
                    <h4 className="success-title text-success mb-3 fw-bold">
                      Registration Successful!
                    </h4>
                    <div
                      className="registration-id p-4 bg-light rounded mb-4"
                      style={{ borderLeft: "4px solid #0077b6" }}
                    >
                      {successMessage ||
                        "Your vessel builder registration has been submitted successfully. You will receive a confirmation email shortly."}
                    </div>
                    <Button
                      variant="primary"
                      size="lg"
                      className="mt-2 d-flex align-items-center justify-content-center mx-auto"
                      style={{
                        background: "linear-gradient(135deg, #0077b6, #023e8a)",
                        border: "none",
                        boxShadow: "0 4px 15px rgba(0, 119, 182, 0.3)",
                        borderRadius: "8px",
                        padding: "12px 30px",
                        fontWeight: "600",
                        transition: "all 0.3s ease",
                        minWidth: "150px",
                        height: "50px",
                      }}
                      onClick={() => (window.location.href = "/")}
                    >
                      Go to Home
                    </Button>
                  </div>
                ) : (
                  <FormProvider {...methods}>
                    <form>
                      <div className="text-center mb-4">
                        <p className="text-muted">
                          {t(
                            "Please complete all required information to register as a vessel builder"
                          )}
                        </p>
                      </div>

                      <div className="stepper-container mb-5">
                        <div className="stepper d-flex justify-content-between">
                          {[1, 2].map((step) => (
                            <React.Fragment key={step}>
                              <div
                                className={`step ${
                                  currentStep >= step ? "active" : ""
                                } ${
                                  currentStep > step ? "completed" : ""
                                } flex-grow-1 text-center`}
                              >
                                <div
                                  className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2"
                                  style={{
                                    width: "60px",
                                    height: "60px",
                                    borderRadius: "50%",
                                    fontSize: "20px",
                                    fontWeight: "bold",
                                    boxShadow:
                                      currentStep >= step
                                        ? "0 5px 15px rgba(0, 119, 182, 0.3)"
                                        : "0 4px 10px rgba(0, 0, 0, 0.1)",
                                    background:
                                      currentStep >= step
                                        ? currentStep > step
                                          ? "linear-gradient(135deg, #28a745, #20c997)"
                                          : "linear-gradient(135deg, #0077b6, #023e8a)"
                                        : "#ffffff",
                                    border:
                                      currentStep >= step
                                        ? "none"
                                        : "2px solid #e9ecef",
                                    color:
                                      currentStep >= step ? "#fff" : "#6c757d",
                                    transition: "all 0.4s ease",
                                  }}
                                >
                                  {currentStep > step ? (
                                    <FaCheck size={22} />
                                  ) : (
                                    React.createElement(
                                      stepTitles[step - 1].icon,
                                      { size: 18 }
                                    )
                                  )}
                                </div>
                                <div
                                  className="step-label fw-bold"
                                  style={{
                                    color:
                                      currentStep >= step
                                        ? currentStep > step
                                          ? "#28a745"
                                          : "#0077b6"
                                        : "#6c757d",
                                    fontSize: "0.9em",
                                    transition: "all 0.3s ease",
                                  }}
                                >
                                  {stepTitles[step - 1].title}
                                </div>
                              </div>
                              {step < 2 && (
                                <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                                  <div
                                    className={`connector-line w-100 ${
                                      currentStep > step ? "active" : ""
                                    }`}
                                    style={{
                                      height: "4px",
                                      background:
                                        currentStep > step
                                          ? "linear-gradient(to right, #28a745, #20c997)"
                                          : "#e9ecef",
                                      borderRadius: "2px",
                                      transition: "all 0.5s ease",
                                    }}
                                  ></div>
                                </div>
                              )}
                            </React.Fragment>
                          ))}
                        </div>
                      </div>

                      <div className="step-content">
                        <div className="form-section p-4 rounded mb-4">
                          <div className="form-content">
                            <DynamicFormFields
                              fields={getCurrentStepFields()}
                              setFormData={setFormData}
                              errors={errors}
                              clearErrors={clearErrors}
                            />
                          </div>
                        </div>
                      </div>

                      <div
                        className="form-navigation mt-4"
                        style={{ display: "block" }}
                      >
                        {currentStep > 1 && (
                          <Button
                            variant="outline-secondary"
                            onClick={handlePrevious}
                            // hidden={currentStep === 1}
                            className="prev-btn"
                            style={{ float: "left" }}
                          >
                            <FaArrowLeft className="btn-icon me-2" />{" "}
                            {t("Previous")}
                          </Button>
                        )}

                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="next-btn"
                          style={{ float: "right" }}
                        >
                          {currentStep === totalSteps
                            ? t("Submit Registration")
                            : t("Next")}
                          {currentStep !== totalSteps && (
                            <FaArrowRight className="btn-icon ms-2" />
                          )}
                        </Button>
                        {/* <div style={{ 'float': 'right' }} className="d-flex flex-column align-items-center">
                          <ActionDropdown actions={actionsFromAPI} onActionClick={handleActionClick} />
                          <ApprovalModal
                            show={showApprovalModal}
                            handleClose={handleCloseModal}
                            handleSubmitData={handleActionSubmit}
                            selectedAction={selectedAction}
                          />
                        </div> */}
                      </div>
                    </form>
                  </FormProvider>
                )}
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Container>
    </>
  );
};

export default VesselBuilderRegistrationPage;
import React from "react";
import { Row, Col } from "react-bootstrap";
import { useFormContext } from "react-hook-form";
import InputText from "./InputText.tsx";
import InputFile from "./InputFile.tsx";
import { renameFile } from "../../utils/constants.ts";
import InputSelect from "./InputSelect.tsx";

const DynamicFormFields = ({ fields, setFormData, errors, clearErrors }) => {
  const { register, setValue, watch } = useFormContext();

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case "file":
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(
                  file?.name?.lastIndexOf(".")
                );
                const fileName = `${field.label}${extension}`;
                file.originalName = fileName;
                const renamedFile = renameFile(file, fileName);

                clearErrors(field.name);

                setValue(field.name, renamedFile, { shouldValidate: true });
                setFormData((prev) => {
                  const updated = { ...prev, [field.name]: renamedFile };
                  return updated;
                });
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={watch(field.name)}
            clearErrors={clearErrors}
          />
        );

      case "select":
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register(field?.name, {
              ...field.validation,
            })}
            errors={errors}
            icon={field.icon}
            className="mb-4"
            onChange={(value, selObj) => {
              setValue(field.name, value);
              if (errors[field.name]) {
                clearErrors(field.name);
              }
              setFormData((prev) => ({
                ...prev,
                [field.name]: value,
              }));
            }}
            autoFocus={field.autoFocus}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...field.validation,
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className="mb-4"
          />
        );
    }
  };

  return (
    <Row className="g-3">
      {fields.map((field, index) => (
        <Col key={index} md={field.colSize || 12}>
          {renderField(field)}
        </Col>
      ))}
    </Row>
  );
};

export default DynamicFormFields;


