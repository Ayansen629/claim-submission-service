.declaration-text {
  font-size: 1rem;
  line-height: 1.6;
  color: #333;
  text-align: justify;
  text-justify: distribute;
  font-family: 'Times New Roman', serif;
}

.declaration-text p {
  text-align: justify;
  margin-bottom: 1rem;
  text-indent: 0;
  hyphens: auto;
  -webkit-hyphens: auto;
  -ms-hyphens: auto;
  word-spacing: 0.1em;
  letter-spacing: 0.01em;
}

.highlight-field {
  background: linear-gradient(120deg, #2466BF 0%, #1976d2 100%);
  color: white !important;
  padding: 2px 4px;
  border-radius: 2px;
  font-weight: bold !important;
  font-style: italic !important;
  display: inline;
}

.declaration-content {
  background: white;
  padding: 2rem;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}
