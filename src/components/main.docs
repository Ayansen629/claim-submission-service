import React, { useState, useCallback, useMemo, memo } from "react";
import { Row, Col, Table, Form, Button } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import Collapsible from "../../../../common/Collapsible.js";
import { FaFire, FaCog, FaCompass, FaUsers, FaShieldAlt, FaBolt, FaHome, FaPlus, FaTrash } from "react-icons/fa";
import { conditionOptions, initialEquipementData } from "./constants/VesselEquipementConstant.js";
import InputText from "../../../../common/InputText.tsx";
import InputSelect from "../../../../common/InputSelect.tsx";
import { useFieldArray, useForm } from "react-hook-form";
import { useMasterData } from "../../../../context/MasterDataContext.js";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";

// Memoized table row components to prevent unnecessary re-renders
const EquipmentTableRow = memo(({ 
  category, 
  fieldName, 
  register, 
  errors, 
  watch, 
  handleConditionChange, 
  isFieldDisabled,
  viewMode 
}) => {
  return (
    <tr>
      <td>{category.categoryLable}</td>
      <td>
        <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>
          <InputText
            name={`${fieldName}.number`}
            type="number"
            placeholder="Enter number"
            register={register(`${fieldName}.number`)}
            errors={errors}
            disabled={isFieldDisabled}
          />
        </div>
      </td>
      <td>
        <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>
          <InputText
            name={`${fieldName}.type`}
            placeholder="Enter type"
            register={register(`${fieldName}.type`)}
            errors={errors}
            disabled={isFieldDisabled}
          />
        </div>
      </td>
      <td>
        <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>
          <InputText
            name={`${fieldName}.capacity`}
            placeholder="Enter capacity"
            register={register(`${fieldName}.capacity`)}
            errors={errors}
            disabled={isFieldDisabled}
          />
        </div>
      </td>
      <td>
        <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>
          <InputText
            name={`${fieldName}.location`}
            placeholder="Enter location"
            register={register(`${fieldName}.location`)}
            errors={errors}
            disabled={isFieldDisabled}
          />
        </div>
      </td>
      {viewMode && (
        <>
          <td>
            <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>
              <InputSelect
                name={`${fieldName}.condition`}
                options={conditionOptions}
                value={watch(`${fieldName}.condition`)}
                register={register(`${fieldName}.condition`)}
                onChange={(value) => handleConditionChange(`${fieldName}.condition`, value)}
                errors={errors}
                disabled={false}
              />
            </div>
          </td>
          <td>
            <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>
              <InputText
                name={`${fieldName}.remarks`}
                placeholder="Enter remarks"
                register={register(`${fieldName}.remarks`)}
                errors={errors}
                disabled={false}
              />
            </div>
          </td>
        </>
      )}
    </tr>
  );
});

const DeckSpaceRow = memo(({ 
  index, 
  register, 
  errors, 
  isFieldDisabled, 
  handleRemoveDeck, 
  deckFields 
}) => {
  return (
    <tr>
      <td>
        <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>
          <InputText
            name={`deckSpaces.${index}.deckType`}
            placeholder="Enter Deck/Space Type"
            register={register(`deckSpaces.${index}.deckType`)}
            errors={errors}
            disabled={isFieldDisabled}
          />
        </div>
      </td>
      <td>
        <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>
          <InputText
            name={`deckSpaces.${index}.size`}
            placeholder="Enter Size"
            register={register(`deckSpaces.${index}.size`)}
            errors={errors}
            disabled={isFieldDisabled}
          />
        </div>
      </td>
      <td>
        <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>
          <InputText
            name={`deckSpaces.${index}.function`}
            placeholder="Enter Function"
            register={register(`deckSpaces.${index}.function`)}
            errors={errors}
            disabled={isFieldDisabled}
          />
        </div>
      </td>
      <td>
        <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>
          <InputText
            name={`deckSpaces.${index}.maxPassengers`}
            type="number"
            placeholder="Enter Max. No. of Passenger"
            register={register(`deckSpaces.${index}.maxPassengers`)}
            errors={errors}
            disabled={isFieldDisabled}
          />
        </div>
      </td>
      <td>
        <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>
          <InputText
            name={`deckSpaces.${index}.remarks`}
            placeholder="Enter Remarks"
            register={register(`deckSpaces.${index}.remarks`)}
            errors={errors}
            disabled={isFieldDisabled}
          />
        </div>
      </td>
      {deckFields?.length > 1 && !isFieldDisabled && (
        <td className="text-center align-middle">
          <div className="d-flex justify-content-center align-items-center ms-2 mb-2" style={{ height: '100%' }}>
            <Button
              variant="outline-danger"
              onClick={() => handleRemoveDeck(index)}
              type="button"
              className="deck-remove-btn"
            >
              <FaTrash className="me-2" /> Remove
            </Button>
          </div>
        </td>
      )}
    </tr>
  );
});

const VesselEquipmentForm = ({ formMethods, viewMode = false, editMode = false }) => {
  const { t } = useTranslation();
  const { masterData } = useMasterData();

  // Check vessel owner login
  const userRole = getFromLocalStorage("userRole");
  const isVesselOwner = userRole === "VESSEL_OWNER";
  
  // Determine if fields should be disabled
  const isFieldDisabled = viewMode;

  const internalFormMethods = useForm({
    mode: "onTouched",
  });
  const methods = formMethods || internalFormMethods;

  const { register, watch, getValues, setValue, formState: { errors }, control } = methods;

  const { fields: deckFields, append: appendDeck, remove: removeDeck } = useFieldArray({
    control,
    name: "deckSpaces"
  });

  // Memoize equipment icons to prevent re-renders
  const getEquipmentIcon = useMemo(() => {
    const iconMap = {
      "Fire Fighting Items": <FaFire className="me-2" style={{ color: "#2466BF" }} />,
      "Equipments": <FaCog className="me-2" style={{ color: "#2466BF" }} />,
      "Navigational Equipments": <FaCompass className="me-2" style={{ color: "#2466BF" }} />,
      "Life-Saving Equipment": <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />,
      "Machinery/Electrical": <FaBolt className="me-2" style={{ color: "#2466BF" }} />,
      "Accommodation/Safety": <FaHome className="me-2" style={{ color: "#2466BF" }} />
    };
    return (equipmentName) => iconMap[equipmentName] || <FaCog className="me-2" style={{ color: "#2466BF" }} />;
  }, []);

  // Memoized callback for condition change to prevent re-renders
  const handleConditionChange = useCallback((fieldName, value) => {
    setValue(fieldName, value);
  }, [setValue]);

  // Memoized callback for deck operations
  const handleAddDeck = useCallback(() => {
    appendDeck(initialEquipementData?.deckSpaces?.[0]);
  }, [appendDeck]);

  const handleRemoveDeck = useCallback((index) => {
    removeDeck(index);
  }, [removeDeck]);

  const RenderDynamicEquipmentTable = memo(({ equipment }) => {
    return (
      <Collapsible
        title={
          <>
            {getEquipmentIcon(equipment.equipmentName)}
            <span>{equipment.equipmentName}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem", overflowX: "auto" }}>
          <Table striped bordered hover responsive className="mb-0 equipment-table">
            <thead style={{ backgroundColor: "#f8f9fa", position: "sticky", top: 0, zIndex: 1 }}>
              <tr>
                <th style={{ color: "#2466BF", fontWeight: "600", minWidth: "200px" }}>Equipment</th>
                <th style={{ color: "#2466BF", fontWeight: "600", minWidth: "120px" }}>Number</th>
                <th style={{ color: "#2466BF", fontWeight: "600", minWidth: "150px" }}>Type</th>
                <th style={{ color: "#2466BF", fontWeight: "600", minWidth: "150px" }}>Capacity</th>
                <th style={{ color: "#2466BF", fontWeight: "600", minWidth: "150px" }}>Location</th>
                {viewMode && (
                  <>
                    <th style={{ color: "#2466BF", fontWeight: "600", minWidth: "150px" }}>Condition</th>
                    <th style={{ color: "#2466BF", fontWeight: "600", minWidth: "200px" }}>Remarks</th>
                  </>
                )}
              </tr>
            </thead>
            <tbody>
              {equipment.equipmentCategories.map((category) => {
                const fieldName = `equipment.${equipment.id}.${category.categoryCode}`;
                return (
                  <EquipmentTableRow
                    key={category.categoryCode}
                    category={category}
                    fieldName={fieldName}
                    register={register}
                    errors={errors}
                    watch={watch}
                    handleConditionChange={handleConditionChange}
                    isFieldDisabled={isFieldDisabled}
                    viewMode={viewMode}
                  />
                );
              })}
            </tbody>
          </Table>
        </div>
      </Collapsible>
    );
  });

  return (
    <form autoComplete="off" className="vessel-equipment-form">
      <style>
        {`
          .vessel-equipment-form {
            overflow-anchor: none;
          }
          
          .equipment-table {
            max-height: 60vh;
            display: block;
            overflow-y: auto;
          }
          
          .deck-remove-btn {
            transition: all 0.2s ease;
          }
          
          .deck-remove-btn:hover {
            transform: scale(1.05);
          }
          
          .table-container {
            max-height: 400px;
            overflow-y: auto;
          }
        `}
      </style>
      
      {masterData?.equipmentCategories?.map((equipment) => (
        <RenderDynamicEquipmentTable key={equipment.id} equipment={equipment} />
      ))}

      <Collapsible
        title={
          <>
            <FaUsers className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Location of passengers on specific decks and spaces in maximum loaded condition")}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem" }}>
          <div className="table-container">
            <Table striped bordered hover responsive className="mb-0">
              <thead style={{ backgroundColor: "#f8f9fa", position: "sticky", top: 0, zIndex: 1 }}>
                <tr>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Deck/Space Type")}</th>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Size")}</th>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Function")}</th>
                  <th style={{ fontWeight: "600", color: "#2466BF", minWidth: "200px" }}>{t("Max. No. of Passenger")}</th>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Remarks")}</th>
                  {deckFields?.length > 1 && !isFieldDisabled && (
                    <th style={{ fontWeight: "600", color: "#2466BF", minWidth: "150px" }}>{t("Actions")}</th>
                  )}
                </tr>
              </thead>
              <tbody>
                {deckFields.map((deck, index) => (
                  <DeckSpaceRow
                    key={deck.id || index}
                    index={index}
                    register={register}
                    errors={errors}
                    isFieldDisabled={isFieldDisabled}
                    handleRemoveDeck={handleRemoveDeck}
                    deckFields={deckFields}
                  />
                ))}
              </tbody>
            </Table>
          </div>
          {!isFieldDisabled && (
            <Button
              variant="outline-primary"
              onClick={handleAddDeck}
              className="mt-2"
              type="button"
            >
              <FaPlus className="me-2" /> Add
            </Button>
          )}
        </div>
      </Collapsible>

      <Collapsible
        title={
          <>
            <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Freeboard")}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem" }}>
          <Table striped bordered hover responsive className="mb-0">
            <thead style={{ backgroundColor: "#f8f9fa" }}>
              <tr>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Minimum freeboard")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Number of Passengers")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Cargo (Tonne)")}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <InputText
                    name={'freeboard.minFreeboard'}
                    placeholder={t('Enter Minimum Freeboard')}
                    register={register('freeboard.minFreeboard')}
                    errors={errors}
                    disabled={isFieldDisabled}
                  />
                </td>
                <td>
                  <InputText
                    name={'freeboard.numPassengers'}
                    type={"number"}
                    placeholder={t('Enter Number of Passengers')}
                    register={register('freeboard.numPassengers')}
                    errors={errors}
                    disabled={isFieldDisabled}
                  />
                </td>
                <td>
                  <InputText
                    name={'freeboard.cargo'}
                    placeholder={t('Enter Cargo (Tonne)')}
                    register={register('freeboard.cargo')}
                    errors={errors}
                    disabled={isFieldDisabled}
                  />
                </td>
              </tr>
            </tbody>
          </Table>
        </div>
      </Collapsible>
    </form>
  );
};

export default VesselEquipmentForm;
