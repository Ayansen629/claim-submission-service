.officer-view-container {
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  min-height: 100vh;
  padding: 2rem 1rem;
}

.modern-card {
  border-radius: 16px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  border: none;
  overflow: hidden;
}

.modern-header {
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  border-bottom: 1px solid #e2e8f0;
  padding: 2rem;
}

.modern-back-btn {
  background: none;
  border: none;
  padding: 0.5rem;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.modern-back-btn:hover {
  background: rgba(59, 130, 246, 0.1);
  transform: translateX(-2px);
}

.application-label {
  font-size: 1rem;
  font-weight: 600;
  color: #64748b;
  letter-spacing: 0.025em;
}

.application-number {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: white;
  padding: 0.5rem 1.25rem;
  border-radius: 25px;
  font-weight: 700;
  font-size: 0.95rem;
  letter-spacing: 0.05em;
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}

.status-container {
  min-width: 120px;
  text-align: center;
}

.status-badge {
  font-size: 0.85rem;
  padding: 0.6rem 1.2rem;
  border-radius: 20px;
  font-weight: 600;
  letter-spacing: 0.025em;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.modern-body {
  padding: 2.5rem;
  background: #ffffff;
}

.modern-stepper-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 3rem;
  position: relative;
}

.modern-stepper-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
}

.stepper-connector {
  flex: 1;
  height: 3px;
  background: linear-gradient(90deg, #e2e8f0 0%, #cbd5e1 100%);
  margin: 0 2rem;
  border-radius: 2px;
  position: relative;
}

.modern-stepper-item.completed ~ .stepper-connector::before,
.modern-stepper-item.active ~ .stepper-connector::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, #10b981 0%, #059669 100%);
  border-radius: 2px;
  width: 100%;
  transition: width 0.5s ease;
}

.modern-step-counter {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 1rem;
  margin-bottom: 0.75rem;
  transition: all 0.3s ease;
  background: #e2e8f0;
  color: #64748b;
  border: 2px solid #e2e8f0;
}

.modern-stepper-item.active .modern-step-counter {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: white;
  border-color: #3b82f6;
  box-shadow: 0 3px 10px rgba(59, 130, 246, 0.3);
  transform: scale(1.02);
}

.modern-stepper-item.completed .modern-step-counter {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: white;
  border-color: #10b981;
  box-shadow: 0 3px 10px rgba(16, 185, 129, 0.3);
}

.modern-step-name {
  font-size: 0.9rem;
  font-weight: 600;
  color: #64748b;
  text-align: center;
  letter-spacing: 0.025em;
}

.modern-stepper-item.active .modern-step-name {
  color: #3b82f6;
  font-weight: 700;
}

.modern-stepper-item.completed .modern-step-name {
  color: #10b981;
  font-weight: 700;
}

.form-content {
  padding: 1.5rem 0;
}

.disabled-field {
  background-color: #f8fafc !important;
  border: 1.5px solid #e2e8f0 !important;
  border-radius: 6px !important;
  color: #475569 !important;
  font-weight: 500;
  font-size: 0.9rem;
}

.file-display-container {
  width: 100%;
}

.file-display-with-doc {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem 0.8rem;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border: 1.5px solid #0ea5e9;
  border-radius: 6px;
  transition: all 0.2s ease;
  min-height: 40px;
}

.file-display-with-doc:hover {
  box-shadow: 0 2px 8px rgba(14, 165, 233, 0.15);
  border-color: #0284c7;
}

.file-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.file-name {
  font-weight: 600;
  color: #0369a1;
  font-size: 0.85rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200px;
}

.file-download-btn {
  color: #059669 !important;
  padding: 0.2rem 0.3rem !important;
  border-radius: 4px;
  transition: all 0.2s ease;
  text-decoration: none !important;
  min-width: auto;
  background: rgba(5, 150, 105, 0.1);
  border: 1px solid rgba(5, 150, 105, 0.2);
}

.file-download-btn:hover {
  background: rgba(5, 150, 105, 0.2);
  transform: scale(1.05);
  color: #047857 !important;
}

.file-display-no-doc {
  display: flex;
  align-items: center;
  padding: 0.6rem 0.8rem;
  background: #f8fafc;
  border: 1.5px dashed #cbd5e1;
  border-radius: 6px;
  min-height: 40px;
}

.no-doc-text {
  font-weight: 500;
  color: #64748b;
  font-size: 0.85rem;
  font-style: italic;
}

.navigation-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 2px solid #f1f5f9;
}

.nav-btn {
  padding: 0.7rem 1.8rem;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.85rem;
  letter-spacing: 0.025em;
  transition: all 0.2s ease;
  border: 1.5px solid;
}

.prev-btn {
  border-color: #3b82f6;
  color: #3b82f6;
  background: white;
}

.prev-btn:hover:not(:disabled) {
  background: #3b82f6;
  color: white;
  transform: translateX(-1px);
}

.next-btn {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  border-color: #3b82f6;
  color: white;
  box-shadow: 0 3px 10px rgba(59, 130, 246, 0.3);
}

.next-btn:hover {
  transform: translateX(1px);
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
}

.action-dropdown {
  padding: 0.7rem 1.8rem;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.85rem;
}

@media (max-width: 768px) {
  .officer-view-container {
    padding: 1rem 0.5rem;
  }
  
  .modern-header {
    padding: 1.5rem;
  }
  
  .modern-body {
    padding: 1.5rem;
  }
  
  .modern-stepper-wrapper {
    flex-direction: column;
    gap: 1rem;
  }
  
  .stepper-connector {
    width: 3px;
    height: 2rem;
    margin: 0;
  }
  
  .navigation-footer {
    flex-direction: column;
    gap: 1rem;
  }
  
  .nav-btn {
    width: 100%;
    justify-content: center;
  }
}
