import React, { useState } from "react";
import { useNavigate } from "react-router-dom";
import Header from "./Header";
import Sidebar from "./Sidebar";
// import "../private/Dashboard.css";

const HeaderSidebar = ({ children, onLogout }) => {
  const [isSidebarOpen, setIsSidebarOpen] = useState(true);
  const navigate = useNavigate();

  const toggleSidebar = () => setIsSidebarOpen((prev) => !prev);

  const handleMenuClick = (menu) => {
    if (menu === "logout") {
      onLogout?.();
      navigate("/");
    } else {
      navigate(`/${menu}`);
    }
  };

  return (
    <div className="header-sidebar-container">
      <Header
        toggleSidebar={toggleSidebar}
        onLogout={onLogout}
        isSidebarOpen={isSidebarOpen}
      />
      <div className="main-layout">
        <Sidebar isSidebarOpen={isSidebarOpen} onMenuClick={handleMenuClick} />
        <div
          className={`content-container ${isSidebarOpen ? "" : "collapsed"}`}
        >
          {children}
        </div>
      </div>
    </div>
  );
};


export default HeaderSidebar;

/* Sidebar Menu List */
ul.nav.flex-column {
  list-style: none;
  padding: 0;
  margin: 0;
}

.nav-item {
  padding: 15px 20px;
  transition: background-color 0.3s ease;
}

.nav-item a {
  font-size: 0.9rem;
  color: #FFFFFF;
  text-decoration: none;
  display: flex;
  align-items: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}



/* Responsive Adjustments */
@media (max-width: 768px) {
  .custom-navbar {
    height: auto;
    padding: 0 15px;
  }

  /* Adjust Navbar for smaller screens */
  .navbar-nav {
    flex-direction: column;
  }

  .navbar-nav .nav-item {
    text-align: center;
    padding: 10px 0;
  }



  /* Make profile dropdown more responsive */
  .navbar-collapse {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
}

@media (max-width: 576px) {

  /* Logo and Profile adjustments */
  .navbar-brand {
    font-size: 1.2rem;
  }

  .navbar-nav .nav-item {
    padding: 5px 0;
  }

  .btn-dark {
    font-size: 1.2rem;
  }
}

/* Loader */
.loader-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  /* Full height */
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
}

/* Media Query Adjustments */
@media (min-width: 768px) {
  .data-digitization-container {
    padding: 40px;
  }
}

@media (min-width: 1024px) {
  .data-digitization-container {
    padding: 60px;
  }
}

.dashboard-container {
  background-color: #f4f6f9;
  width: 100%;
  /* Full width */
  height: 100vh;
  /* Full height */
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
  box-sizing: border-box;
}

/* Data Digitization Container */
.data-digitization-container {
  width: 100%;
  /* Full width */
  height: auto;
  background: #fff;
  border-radius: 10px;
  box-shadow: 0px 2px 6px rgba(0, 0, 0, 0.1);
  padding: 20px;
  box-sizing: border-box;
}

.nav-item a:hover,
.nav-item.active a {
  background-color: white !important;
  color: #2466BF !important;
  font-weight: 550;
  text-decoration: underline;
}



/* Header */
.custom-navbar {
  background-color: #2466BF;
  color: white;
  height: 6rem;
  display: flex;
  align-items: center;
  padding: 0 20px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  z-index: 1050;
  transition: margin-left 0.5s ease;
  /* Added transition for header */
}




.nav-link {
  color: white !important;
}






.btn-dark {
  font-size: 1rem;
  background-color: #15323d;
  transition: all 0.5s ease;
  margin-right: 20px;
  /* Added margin for spacing */
}



/* Logo and Text */
.navbar-brand {
  display: flex;
  align-items: center;
  margin-left: 1rem;
  transition: all 0.3s ease;
}

.navbar-brand img {
  margin-right: 1rem;
}

.navbar-brand h2 {
  font-size: 1.5rem;
}

/* Adjust Sidebar Toggle and Logo Text */
.sidebar-expanded .btn-dark {
  left: 200px;
}

.sidebar-collapsed .btn-dark {
  left: 0;
}


.navbar-brand.title {
  font-size: 1.2rem;
  font-weight: bold;

}




/* Default Alignment (when sidebar is collapsed) */
.shift-center {
  margin-left: 10px;
  /* Adjust as needed */
  transition: margin-left 0.5s ease;
  /* Smooth transition */
}

/* Shift to the left when the sidebar is open */
.shift-left {
  margin-left: 12%;
  /* Adjust as needed */
  transition: margin-left 0.5s ease;
  /* Smooth transition */
}

.custom-dropdown-item {
  color: black !important;
}


/* Toggle Button */
.toggle-btn {
  font-size: 1.5rem;
  color: white;
  background: none;
  border: none;
}

/* Center nav links to wrap and be column-aligned on small screens */
.nav-links {
  flex: 1;
  flex-wrap: wrap;
  justify-content: center;
  text-align: center;
}

/* Responsive tweaks */
@media (max-width: 768px) {
  .nav-links {
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .custom-navbar {
    flex-direction: column;
    align-items: stretch;
    padding: 10px;
    height: auto;
  }

  .toggle-btn {
    margin-bottom: 10px;
  }
}

.nav-drops.nav-item a:hover,
.nav-drops.nav-item.active a {
  background-color: #2466BF !important;
  color: white !important;
  font-weight: 550;
}
