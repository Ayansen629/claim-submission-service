const actionDropdown =
  isViewMode && isOfficerLogin && actionsFromAPI?.length > 0 ? (
    <div style={{ display: "flex", gap: "0.5rem", alignItems: "center" }}>
      <Button
        variant="contained"
        onClick={() => handleFormSubmit({ index: 1, getFormData: () => methods?.getValues() })}
        style={{
          backgroundColor: "#1f4ea0",
          fontWeight: "bold",
          borderRadius: "0.5rem",
          minWidth: "6rem",
          fontSize: "0.8rem",
          color: "#fff",
          padding: "4px 12px",
          height: "32px",
        }}
      >
        Save
      </Button>
      
      {userRole === USER_ROLES?.OFFICER_L3 && showOfficerActions && (
        <>
          <Button
            variant="outlined"
            onClick={() => handleProvisionModalOpen("survey")}
            style={{
              borderColor: "#2E57A7",
              color: "#2E57A7",
              fontWeight: "500",
              borderRadius: "0.5rem",
              minWidth: "5rem",
              fontSize: "0.75rem",
              padding: "4px 8px",
              height: "32px",
            }}
          >
            Survey Cert
          </Button>
          <Button
            variant="outlined"
            onClick={() => handleProvisionModalOpen("registration")}
            style={{
              borderColor: "#2E57A7",
              color: "#2E57A7",
              fontWeight: "500",
              borderRadius: "0.5rem",
              minWidth: "5rem",
              fontSize: "0.75rem",
              padding: "4px 8px",
              height: "32px",
            }}
          >
            Reg Cert
          </Button>
        </>
      )}
      
      <ActionDropdown
        actions={actionsFromAPI}
        onActionClick={handleWorkflowActionClick}
        variant="contained"
        sx={{
          backgroundColor: "#2E57A7",
          fontWeight: "bold",
          borderRadius: "0.5rem",
          minWidth: "6rem",
          fontSize: "0.8rem",
          color: "#fff",
          height: "32px",
          "&:hover": {
            backgroundColor: "#1f4ea0",
          },
        }}
      />
    </div>
  ) : null;
