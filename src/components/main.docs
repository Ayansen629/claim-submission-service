import React, { useState, useEffect } from "react";
import { useForm } from "react-hook-form";
import { FaPlus, FaMinus } from "react-icons/fa";

const ClaimTypeFields = ({ claimType, control, setValue, getValues }) => {
  // Initialize with existing entityData or empty array
  const [entityData, setEntityData] = useState(getValues("entityData") || []);

  // Add new entity
  const addEntity = () => {
    const newId = entityData.length > 0 ? Math.max(...entityData.map(e => e.id)) + 1 : 1;
    const entityType = claimType === "PRINCIPAL_BORROWER" ? "GUARANTOR" :
                     claimType === "GUARANTOR" ? "PRINCIPAL_BORROWER" :
                     "BENEFICIARY";
    
    setEntityData([
      ...entityData,
      {
        id: newId,
        name: "",
        address: "",
        type: entityType
      }
    ]);
  };

  // Remove entity
  const removeEntity = (id) => {
    if (entityData.length <= 1) return;
    setEntityData(entityData.filter(entity => entity.id !== id));
  };

  // Update entity field
  const updateEntity = (id, field, value) => {
    setEntityData(entityData.map(entity => 
      entity.id === id ? { ...entity, [field]: value } : entity
    ));
  };

  // Save to form data whenever entityData changes
  useEffect(() => {
    setValue("entityData", entityData);
  }, [entityData, setValue]);

  // Get field labels based on claim type
  const { nameLabel, addressLabel } = 
    claimType === "PRINCIPAL_BORROWER" ? {
      nameLabel: "Name of the guarantor",
      addressLabel: "Address of the guarantor"
    } : claimType === "GUARANTOR" ? {
      nameLabel: "Name of the Principal Borrower",
      addressLabel: "Address of the Principal Borrower"
    } : {
      nameLabel: "Name of the Beneficiary",
      addressLabel: "Address of the Beneficiary"
    };

  return (
    <div>
      {/* Other claim fields... */}

      {entityData.map((entity) => (
        <div key={entity.id} className="entity-field-group">
          <div className="entity-field-row">
            <div className="form-group">
              <label>{nameLabel} *</label>
              <input
                value={entity.name}
                onChange={(e) => updateEntity(entity.id, "name", e.target.value)}
                placeholder={`Enter ${nameLabel.toLowerCase()}`}
                required
              />
            </div>
            
            {entity.id !== 1 && (
              <button 
                type="button" 
                onClick={() => removeEntity(entity.id)}
                title={`Remove ${nameLabel}`}
              >
                <FaMinus />
              </button>
            )}
          </div>

          <div className="form-group">
            <label>{addressLabel} *</label>
            <input
              value={entity.address}
              onChange={(e) => updateEntity(entity.id, "address", e.target.value)}
              placeholder={`Enter ${addressLabel.toLowerCase()}`}
              required
            />
          </div>
        </div>
      ))}

      <button 
        type="button" 
        onClick={addEntity}
      >
        <FaPlus /> Add {claimType === "GUARANTOR" ? "Principal Borrower" : 
                      claimType === "PRINCIPAL_BORROWER" ? "Guarantor" : "Beneficiary"}
      </button>
    </div>
  );
};

// Usage in your form component
const MyForm = () => {
  const { control, handleSubmit, setValue, getValues } = useForm();

  const onSubmit = (data) => {
    // data will contain the entityData array exactly as shown
    console.log(data);
  };

  return (
    <form onSubmit={handleSubmit(onSubmit)}>
      <ClaimTypeFields 
        claimType="PRINCIPAL_BORROWER" 
        control={control}
        setValue={setValue}
        getValues={getValues}
      />
      <button type="submit">Submit</button>
    </form>
  );
};
