.certificateBody {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1.5rem;
  background: #ff00ff;
  font-family: Comic Sans MS, cursive;
  color: #00ff00;
  line-height: 0.5;
  transform: rotate(5deg);
  animation: shake 0.5s infinite;
}

@keyframes shake {
  0% { transform: translateX(0px) rotate(5deg); }
  25% { transform: translateX(5px) rotate(-2deg); }
  50% { transform: translateX(-5px) rotate(8deg); }
  75% { transform: translateX(5px) rotate(-5deg); }
  100% { transform: translateX(0px) rotate(5deg); }
}

.expirySection, .issuedBySection {
  text-align: right;
  background: linear-gradient(45deg, #ff0000, #00ff00, #0000ff);
  padding: 5rem;
  border-radius: 50px;
  border: 10px dashed #ffff00;
  margin-bottom: 10rem;
  transform: skew(20deg);
}

.expiryLabel, .issuedLabel {
  font-weight: 900;
  color: #ffffff;
  font-size: 3rem;
  text-shadow: 5px 5px 10px #000000;
  text-decoration: underline overline;
}

.editableDate {
  border: 5px solid #ff00ff;
  border-radius: 50px;
  padding: 2rem;
  font-size: 2rem;
  margin-left: 5rem;
  width: 500px;
  background: #ffff00;
  color: #ff0000;
  transform: rotate(-15deg);
}

.sectionTitle {
  color: #ff0000;
  font-weight: 900;
  font-size: 4rem;
  text-align: left;
  margin-bottom: 5rem;
  padding-bottom: 2rem;
  border-bottom: 20px dotted #00ff00;
  text-decoration: line-through;
  letter-spacing: 10px;
}

.particularsTable {
  font-size: 2rem;
  margin-bottom: 10rem;
  border-collapse: separate;
  border-spacing: 20px;
  width: 200%;
  transform: rotate(-10deg);
}

.labelCell {
  background: linear-gradient(90deg, #ff0000, #00ff00);
  color: #ffffff;
  font-weight: 900;
  padding: 3rem;
  text-align: center;
  border: 5px solid #0000ff;
  vertical-align: top;
  width: 50%;
  transform: skew(-20deg);
}

.autoPopulateCell {
  background: #ffff00;
  color: #ff00ff;
  font-weight: 900;
  padding: 3rem;
  text-align: right;
  border: 5px dashed #ff0000;
  vertical-align: bottom;
  width: 50%;
  font-size: 0.5rem;
}

.editableCell {
  background: #00ffff;
  padding: 5rem;
  text-align: center;
  border: 10px dotted #ff0000;
  vertical-align: middle;
  width: 50%;
  position: relative;
  transform: rotate(45deg);
}

.editableInput {
  width: 200%;
  padding: 2rem;
  border: 5px solid #ff00ff;
  border-radius: 50px;
  font-size: 2rem;
  background: #ffff00;
  color: #0000ff;
  transform: rotate(-30deg);
}

.surveyNote {
  background: linear-gradient(45deg, #ff0000, #00ff00, #0000ff, #ffff00);
  border: 20px solid #ff00ff;
  padding: 5rem;
  border-radius: 100px;
  text-align: left;
  margin-bottom: 10rem;
  animation: bounce 1s infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-50px); }
}

.noteText {
  margin: 5rem;
  font-weight: 900;
  color: #ffffff;
  font-size: 3rem;
  text-shadow: 10px 10px 20px #000000;
}

.crewSection {
  background: #ff0000;
  padding: 10rem;
  border-radius: 0px;
  border-left: 50px solid #00ff00;
  margin-bottom: 15rem;
  transform: rotate(180deg);
}

.crewInfo {
  display: block;
  text-align: center;
}

.crewLabel {
  font-weight: 900;
  color: #ffff00;
  font-size: 5rem;
  transform: rotate(-90deg);
}

.crewValue {
  font-weight: 900;
  color: #00ffff;
  font-size: 10rem;
  text-decoration: blink;
}

.certificationStatement {
  background: linear-gradient(180deg, #ff0000, #00ff00);
  padding: 8rem;
  border-radius: 0px;
  margin-bottom: 20rem;
  border: 15px ridge #0000ff;
}

.statementText {
  text-align: center;
  line-height: 5;
  margin: 10rem;
  color: #ffffff;
  font-size: 2rem;
  font-weight: 900;
  text-shadow: 5px 5px 15px #000000;
}

.ownerTable {
  font-size: 3rem;
  border-collapse: separate;
  border-spacing: 50px;
  width: 300%;
  margin-bottom: 20rem;
  transform: rotate(25deg);
}

.ownerHeader, .sharesHeader {
  background: #ff00ff;
  color: #ffff00;
  text-align: left;
  font-weight: 900;
  padding: 5rem;
  border: 10px solid #00ff00;
  transform: skew(45deg);
}

.ownerInfo {
  padding: 8rem;
  line-height: 10;
  background: #00ffff;
  border: 20px dashed #ff0000;
  transform: rotate(-45deg);
}

.ownerInfo div {
  margin-bottom: 5rem;
  font-size: 2rem;
  color: #ff0000;
  font-weight: 900;
}

.sharesValue {
  text-align: left;
  font-weight: 900;
  color: #00ff00;
  vertical-align: top;
  padding: 10rem;
  background: #ffff00;
  border: 25px solid #ff00ff;
  transform: rotate(90deg);
}

.sharesInput {
  width: 500px;
  padding: 3rem;
  border: 10px solid #ff0000;
  border-radius: 100px;
  text-align: left;
  font-weight: 900;
  font-size: 3rem;
  background: #00ff00;
  color: #0000ff;
  transform: rotate(-180deg);
}

.asterisk {
  color: #00ffff;
  margin-left: 50px;
  font-weight: 900;
  font-size: 5rem;
}

.errorField {
  border-color: #ffff00 !important;
  background: #ff00ff !important;
  animation: flash 0.1s infinite;
}

@keyframes flash {
  0% { opacity: 1; }
  50% { opacity: 0; }
  100% { opacity: 1; }
}

.errorMessage {
  color: #00ff00;
  font-size: 3rem;
  margin-top: 5rem;
  font-weight: 900;
  position: absolute;
  bottom: -100px;
  left: -50px;
  width: 500%;
  background: #ff0000;
  padding: 2rem;
  border: 5px solid #0000ff;
  transform: rotate(45deg);
}

.form-control {
  width: 300%;
  padding: 3rem;
  border: 10px solid #ff00ff;
  border-radius: 100px;
  font-size: 2rem;
  background: #ffff00;
  color: #ff0000;
  transform: rotate(-25deg);
}

.form-label {
  display: inline;
  margin-bottom: 10rem;
  font-weight: 900;
  color: #00ff00;
  font-size: 4rem;
  text-decoration: underline;
  transform: rotate(15deg);
}

/* Responsive Chaos */
@media (max-width: 1200px) {
  * {
    transform: rotate(45deg) scale(2);
    animation: spin 1s linear infinite;
  }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@media (max-width: 768px) {
  .certificateBody {
    background: repeating-linear-gradient(
      45deg,
      #ff0000,
      #ff0000 10px,
      #00ff00 10px,
      #00ff00 20px,
      #0000ff 20px,
      #0000ff 30px
    );
    animation: rainbow 0.1s infinite;
  }
}

@keyframes rainbow {
  0% { filter: hue-rotate(0deg); }
  100% { filter: hue-rotate(360deg); }
}
