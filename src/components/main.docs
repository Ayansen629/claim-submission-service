/* General Styles */
/* body {
  font-family: Arial, sans-serif;
  background-color: #f5f5f5;
  color: #34495e;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
} */

.container {
  flex: 1;
  padding: 20px;
  width: 100%;
  /* max-width: 1200px; */
  margin: 0 auto;
}

/* Table Container */
.table-container {
  width: 100%;
  overflow-x: auto;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  margin-top: 20px;
  background-color: #ffffff;
}

/* Table */
.table {
  width: 100%;
  border-collapse: collapse;
  background-color: #ffffff;
}

.table th,
.table td {
  padding: 12px 16px;
  text-align: left;
  border-bottom: 1px solid #ecf0f1;
  vertical-align: middle;
}

.table th {
  background: #269ccc;
  color: #ffffff;
  /* font-weight: 900; */
  font-size: 18px;
}

.table_datarow {
  background-color: #f9f9f9;
  transition: background-color 0.3s ease;
}

.table_datarow:nth-child(even) {
  background-color: #ffffff;
}
.table_data {
  padding: 12px 16px;
  font-size: 14px;
  font-weight: 400;
  color: #34495e;
  border-bottom: 1px solid #ecf0f1;
  text-align: left;
}

.table_datarow:hover {
  background-color: #f1f8ff;
}

/* Table Footer */
.table_footer {
  background: #f5f5f5;
  color: #000000;
  padding: 10px 15px;
  border-top: 1px solid #ddd;
  text-align: right;
  width: 100%;
}

/* Pagination Number */
.page_number {
  background: #ffffff;
  color: #269ccc;
  border-radius: 50px;
  padding: 6px 12px;
  font-size: 14px;
  border: 1px solid #269ccc;
  margin: 0 5px;
}

.page_number:hover {
  background: #269ccc;
  color: #ffffff;
}

/* Status Column */
.status-column {
  padding: 5px 10px;
  border-radius: 16px;
  font-size: 13px;
}

.approve-status {
  background: #e8f7e7;
  color: #27ae60;
}

.initiate-status {
  background: #d0e7f5;
  color: #2980b9;
}

.pending-status {
  background: #fff3e0;
  color: #e67e22;
}

/* Search Container */
.search-container {
  margin-bottom: 20px;
  display: flex;
  justify-content: center;
}

.search-container input[type="text"] {
  width: 100%;
  max-width: 400px;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-size: 14px;
  outline: none;
  transition: border-color 0.3s ease;
}

.search-container input[type="text"]:focus {
  border-color: #269ccc;
}

/* Media Queries for Smaller Screens */
@media (max-width: 768px) {
  .table_header,
  .table_footer {
    padding: 12px;
  }

  .table_data {
    font-size: 12px;
    padding: 8px 12px;
  }

  .search-container input[type="text"] {
    width: 100%;
  }
}

/* Action Buttons */
.action_button {
  background: none;
  border: none;
  cursor: pointer;
}

.action_button img {
  width: 20px;
  height: 20px;
}

.action_button:disabled img {
  filter: grayscale(100%);
  opacity: 0.5;
}

.action_button:disabled {
  cursor: not-allowed;
}

/* Tooltip */
.tooltip {
  display: inline-block;
  position: relative;
}

.tooltip .tooltiptext {
  visibility: hidden;
  width: 120px;
  background-color: #555;
  color: #fff;
  text-align: center;
  border-radius: 6px;
  padding: 5px;
  position: absolute;
  z-index: 1;
  bottom: 125%;
  left: 50%;
  margin-left: -60px;
  opacity: 0;
  transition: opacity 0.3s;
}

.tooltip:hover .tooltiptext {
  visibility: visible;
  opacity: 1;
}

/* Sortable Header */
.sortable_header {
  cursor: pointer;
}

.sortable_header .table-arrow {
  margin-left: 5px;
}

/* Selection Info */
.selection_info {
  font-size: 14px;
  color: #34495e;
}

/* Pagination Buttons */
.pagination_button {
  background: none;
  border: none;
  color: #269ccc;
  font-size: 14px;
  cursor: pointer;
}

.pagination_button:disabled {
  color: #ccc;
  cursor: not-allowed;
}
