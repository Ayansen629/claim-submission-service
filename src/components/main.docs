import React from 'react';
import { useFormContext } from 'react-hook-form';
import "react-datepicker/dist/react-datepicker.css";
import { Download, CheckCircle, Info } from "lucide-react";
import { Button, Tooltip, OverlayTrigger } from "react-bootstrap";
// import './DynamicField.css'; // Create this CSS file for custom styles

const DynamicField = ({
  fieldConfig,
  register,
  errors,
  setValue,
  trigger,
  getValues,
  control,
}) => {
  const {
    name,
    label,
    type,
    rules = {},
    options = [],
    placeholder = '',
    disabled = false,
    tooltip = '',
    note = '',
    accept = '',
    isUploading = false,
    uploadError = null,
    onFileUpload = () => {},
    setIsUploading = () => {},
    setUploadError = () => {},
    defaultValue = null,
    onChange = () => {},
    inline = false,
    icon = null,
  } = fieldConfig;

  const { watch } = useFormContext();
  const value = watch(name);
  const hasError = errors[name];
  const [uploadSuccess, setUploadSuccess] = React.useState(false);

  const handleFileChange = async (e) => {
    // Don't process if disabled
    if (disabled) return;
    
    const file = e.target.files[0];
    if (file && fieldConfig.onFileUpload) {
      try {
        fieldConfig.setIsUploading(true);
        fieldConfig.setUploadError(null);
        setUploadSuccess(false);

        const result = await fieldConfig.onFileUpload(file);

        if (result && result.fileId) {
          setValue(name, {
            fileId: result.fileId,
            docName: file.name,
            docType: file.type,
            docSource: 'upload',
            fileUrl: `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${result.fileId}`
          }, { shouldValidate: true });
          setUploadSuccess(true);
        }
      } catch (error) {
        fieldConfig.setUploadError(error.message);
        setValue(name, null, { shouldValidate: true });
        setUploadSuccess(false);
      } finally {
        fieldConfig.setIsUploading(false);
      }
    }
  };

  const renderFilePreview = (fileValue) => {
    if (!fileValue) return null;

    const fileUrl = typeof fileValue === 'object' ? 
      `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileValue.fileId}` : 
      fileValue;

    const fileName = typeof fileValue === 'object' ? 
      fileValue.docName || fileValue.name || 'Uploaded file' : 
      fileValue;

    return (
      <div className="file-preview-container mt-2">
        {uploadSuccess && (
          <div className="text-success d-flex align-items-center gap-2 mb-2">
            <CheckCircle size={16} />
            <span>File uploaded successfully!</span>
          </div>
        )}
        <div className="d-flex align-items-center gap-2 bg-light p-2 rounded">
          <span className="text-truncate" style={{ maxWidth: '200px' }}>{fileName}</span>
          <Button
            variant="outline-primary"
            size="sm"
            href={fileUrl}
            target="_blank"
            rel="noopener noreferrer"
            download
            className="p-1 ms-auto"
            title="Download file"
          >
            <Download size={16} />
          </Button>
        </div>
      </div>
    );
  };

  const handleRadioChange = (e) => {
    // Don't process if disabled
    if (disabled) return;
    
    const selectedValue = e.target.value;
    setValue(name, selectedValue, { shouldValidate: true });
    onChange(e);
  };

  const renderTooltip = (text) => (
    <Tooltip id={`tooltip-${name}`}>{text}</Tooltip>
  );

  const renderField = () => {
    switch (type) {
      case 'text':
      case 'email':
      case 'number':
        return (
          <div className="input-group">
            <input
              type={type}
              id={name}
              className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
              placeholder={placeholder}
              disabled={disabled}
              {...register(name, rules)}
            />
          </div>
        );
      case 'textarea':
        return (
          <textarea
            id={name}
            className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
            placeholder={placeholder}
            rows={3}
            disabled={disabled}
            {...register(name, rules)}
          />
        );
      case 'select':
        return (
          <select
            id={name}
            className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
            disabled={disabled}
            {...register(name, rules)}
          >
            <option value="">{placeholder || 'Select an option'}</option>
            {options.map((option) => (
              <option key={option.value} value={option.value}>
                {option.label}
              </option>
            ))}
          </select>
        );
      case 'radio':
        return (
          <div className={`d-flex ${inline ? 'flex-wrap gap-3' : 'flex-column gap-2'}`}>
            {options.map((option) => (
              <div key={option.value} className="form-check">
                <input
                  type="radio"
                  id={`${name}-${option.value}`}
                  className="form-check-input"
                  style={{
                    backgroundColor: value === option.value ? '#269ccc' : '',
                    borderColor: '#269ccc',
                  }}
                  value={option.value}
                  checked={value === option.value}
                  disabled={disabled}
                  {...register(name, rules)}
                  onChange={handleRadioChange}
                />
                <label
                  htmlFor={`${name}-${option.value}`}
                  className={`form-check-label ${disabled ? 'text-muted' : ''}`}
                >
                  {option.label}
                </label>
              </div>
            ))}
          </div>
        );
      case 'file':
        return (
          <div className="custom-file-input">
            {note && (
              <small className="text-muted d-block mb-2">
                {note}
              </small>
            )}
            <input
              type="file"
              id={name}
              onChange={handleFileChange}
              className="d-none"
              disabled={isUploading || disabled}
              accept={accept}
            />
            {!disabled && (
              <label
                htmlFor={name}
                className={`btn btn-outline-primary ${isUploading || disabled ? 'disabled' : ''}`}
              >
                {isUploading ? (
                  <>
                    <span className="spinner-border spinner-border-sm me-2" role="status"></span>
                    Uploading...
                  </>
                ) : (
                  'Choose File'
                )}
              </label>
            )}
            {value && renderFilePreview(value)}
            {uploadError && (
              <div className="text-danger mt-2 small">
                {uploadError}
              </div>
            )}
          </div>
        );
     
     
        default:
        return null;
    }
  };

  return (
    <div className={`mb-3 ${type === 'radio' ? 'radio-field' : ''}`}>
      <label htmlFor={name} className={`form-label d-flex align-items-center ${disabled ? 'text-muted' : ''}`}>
        {icon && <span className="me-2">{icon}</span>}
        {label}
        {tooltip && (
          <OverlayTrigger
            placement="top"
            overlay={renderTooltip(tooltip)}
          >
            <span className="ms-2">
              <Info size={14} className="text-muted" />
            </span>
          </OverlayTrigger>
        )}
      </label>
      {renderField()}
      {errors[name] && !disabled && (
        <div className="invalid-feedback d-block">
          {errors[name].message}
        </div>
      )}
    </div>
  );
};

export default DynamicField;
