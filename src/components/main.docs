/* Fix for BengalLogo positioning */
.desktopLogo {
  width: 4.25rem;
  height: 5rem;
  position: absolute;
  top: -17px;
  right: 0;
}

.mobileLogo {
  width: 3rem;
  height: 3.5rem;
  position: absolute;
  right: 0;
  top: -10px;
}

/* Improved responsive behavior for hero section */
@media (max-width: 768px) {
  .heroSection {
    height: auto;
    min-height: 60vh;
    padding-bottom: 2rem;
  }
  
  .headerRow {
    flex-direction: column;
  }
  
  .topNavCol {
    margin-bottom: 1rem !important;
  }
  
  .brandName {
    font-size: 16px;
    line-height: 1.3;
    text-align: center;
  }
  
  /* Better nav items for mobile */
  .navLinkItems {
    font-size: 12px;
    padding: 0.25rem 0.5rem !important;
  }
}

@media (max-width: 576px) {
  .heroSection {
    min-height: 55vh;
  }
  
  .brandName {
    font-size: 14px;
  }
  
  /* Stack nav items vertically on very small screens */
  @media (max-width: 400px) {
    .nav {
      flex-direction: column;
      align-items: center;
    }
    
    .navLinkItems {
      padding: 0.5rem 0 !important;
    }
  }
}

/* Ensure content doesn't overflow on mobile */
.container-fluid {
  overflow-x: hidden;
}
