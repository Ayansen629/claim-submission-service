/* Add to employeeDashboard.css */
.row.g-3 > [class*="col-"] {
  display: flex;
  height: 100%;
}

.status-card {
  height: 100%;
  min-height: 220px;
}

.survey-tracker-card {
  height: 100%;
}

/* Ensure all cards have equal height */
.stats-row {
  display: flex;
  flex-wrap: wrap;
}

.stats-row > [class*="col-"] {
  display: flex;
}

/* Responsive adjustments */
@media (max-width: 992px) {
  .survey-tracker-card {
    grid-column: span 1;
  }
  
  .row.g-3 > [class*="col-"] {
    flex: 0 0 100%;
    max-width: 100%;
  }
}
