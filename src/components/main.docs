{/* Documents Upload Section */}
<Collapsible
  title={
    <div className="d-flex align-items-center">
      <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
      <span style={{ color: "#2466BF" }}>Documents Upload</span>
    </div>
  }
  defaultOpen={true}
>
  <Card className="form-section-card">
    <Card.Body>
      <Row className="g-3">
        <Col md={6}>
          <InputText
            name="addressProof"
            label="Address Proof"
            type="file"
            required={!isEditMode}
            register={register("addressProof", {
              required: !isEditMode && "Address Proof is required",
              validate: {
                validFileType: (files) => {
                  if (!files || !files.length || !files[0]) return true; // Proper null check
                  const file = files[0];
                  const validExtensions = ['.jpg', '.jpeg', '.png', '.pdf'];
                  const validTypes = ['image/jpeg', 'image/png', 'application/pdf'];
                  const extension = file.name?.substring(file.name.lastIndexOf('.')).toLowerCase();
                  
                  // Check both extension and type
                  const isValidType = validTypes.includes(file.type);
                  const isValidExtension = validExtensions.includes(extension);
                  
                  return (isValidType || isValidExtension) || "Only JPG, PNG, and PDF files are allowed";
                },
                validFileSize: (files) => {
                  if (!files || !files.length || !files[0]) return true; // Proper null check
                  return files[0].size <= 2 * 1024 * 1024 || "File size must be less than 2MB";
                }
              }
            })}
            errors={errors}
            accept=".jpg,.jpeg,.png,.pdf"
            onChange={(e) => {
              const files = e.target.files;
              if (!files || !files.length) return; // Proper null check
              
              const file = files[0];
              const validExtensions = ['.jpg', '.jpeg', '.png', '.pdf'];
              const extension = file.name?.substring(file.name.lastIndexOf('.')).toLowerCase();
              
              if (!extension || !validExtensions.includes(extension)) {
                toast.error("Only JPG, PNG, and PDF files are allowed");
                e.target.value = '';
                return;
              }
              
              if (file.size > 2 * 1024 * 1024) {
                toast.error("File size must be less than 2MB");
                e.target.value = '';
                return;
              }
              
              const fileName = `Address Proof${extension}`;
              file.originalName = fileName;
              setAddressProofFile(renameFile(file, fileName));
            }}
          />
          <small className="text-muted">
            Upload PDF, JPG or PNG (Max: 2MB)
          </small>
          {isEditMode && employeeData?.fileStoreMaps?.[0]?.downLoadFile && (
            <div className="mt-2" style={{ display: "flex", alignItems: "center", gap: 6 }}>
              <Button
                variant="link"
                style={{ padding: 0, color: "#2466BF" }}
                onClick={() => handleFileDownload(employeeData.fileStoreMaps[0].downLoadFile)}
              >
                <FaDownload style={{ marginRight: 4 }} />
                Download address proof
              </Button>
            </div>
          )}
        </Col>

        {/* Repeat the same pattern for identityProof and appointmentLetter */}
        <Col md={6}>
          <InputText
            name="identityProof"
            label="Identity Proof"
            type="file"
            required={!isEditMode}
            register={register("identityProof", {
              required: !isEditMode && "Identity Proof is required",
              validate: {
                validFileType: (files) => {
                  if (!files || !files.length || !files[0]) return true;
                  const file = files[0];
                  const validExtensions = ['.jpg', '.jpeg', '.png', '.pdf'];
                  const validTypes = ['image/jpeg', 'image/png', 'application/pdf'];
                  const extension = file.name?.substring(file.name.lastIndexOf('.')).toLowerCase();
                  
                  const isValidType = validTypes.includes(file.type);
                  const isValidExtension = validExtensions.includes(extension);
                  
                  return (isValidType || isValidExtension) || "Only JPG, PNG, and PDF files are allowed";
                },
                validFileSize: (files) => {
                  if (!files || !files.length || !files[0]) return true;
                  return files[0].size <= 2 * 1024 * 1024 || "File size must be less than 2MB";
                }
              }
            })}
            errors={errors}
            accept=".jpg,.jpeg,.png,.pdf"
            onChange={(e) => {
              const files = e.target.files;
              if (!files || !files.length) return;
              
              const file = files[0];
              const validExtensions = ['.jpg', '.jpeg', '.png', '.pdf'];
              const extension = file.name?.substring(file.name.lastIndexOf('.')).toLowerCase();
              
              if (!extension || !validExtensions.includes(extension)) {
                toast.error("Only JPG, PNG, and PDF files are allowed");
                e.target.value = '';
                return;
              }
              
              if (file.size > 2 * 1024 * 1024) {
                toast.error("File size must be less than 2MB");
                e.target.value = '';
                return;
              }
              
              const fileName = `Identity Proof${extension}`;
              file.originalName = fileName;
              setIdentityProofFile(renameFile(file, fileName));
            }}
          />
          <small className="text-muted">
            Upload PDF, JPG or PNG (Max: 2MB)
          </small>
          {isEditMode && employeeData?.fileStoreMaps?.[1]?.downLoadFile && (
            <div className="mt-2" style={{ display: "flex", alignItems: "center", gap: 6 }}>
              <Button
                variant="link"
                style={{ padding: 0, color: "#2466BF" }}
                onClick={() => handleFileDownload(employeeData.fileStoreMaps[1].downLoadFile)}
              >
                <FaDownload style={{ marginRight: 4 }} />
                Download identity proof
              </Button>
            </div>
          )}
        </Col>

        <Col md={6}>
          <InputText
            name="appointmentLetter"
            label="Appointment Letter"
            type="file"
            required={!isEditMode}
            register={register("appointmentLetter", {
              required: !isEditMode && "Appointment Letter is required",
              validate: {
                validFileType: (files) => {
                  if (!files || !files.length || !files[0]) return true;
                  const file = files[0];
                  const validExtensions = ['.jpg', '.jpeg', '.png', '.pdf'];
                  const validTypes = ['image/jpeg', 'image/png', 'application/pdf'];
                  const extension = file.name?.substring(file.name.lastIndexOf('.')).toLowerCase();
                  
                  const isValidType = validTypes.includes(file.type);
                  const isValidExtension = validExtensions.includes(extension);
                  
                  return (isValidType || isValidExtension) || "Only JPG, PNG, and PDF files are allowed";
                },
                validFileSize: (files) => {
                  if (!files || !files.length || !files[0]) return true;
                  return files[0].size <= 2 * 1024 * 1024 || "File size must be less than 2MB";
                }
              }
            })}
            errors={errors}
            accept=".jpg,.jpeg,.png,.pdf"
            onChange={(e) => {
              const files = e.target.files;
              if (!files || !files.length) return;
              
              const file = files[0];
              const validExtensions = ['.jpg', '.jpeg', '.png', '.pdf'];
              const extension = file.name?.substring(file.name.lastIndexOf('.')).toLowerCase();
              
              if (!extension || !validExtensions.includes(extension)) {
                toast.error("Only JPG, PNG, and PDF files are allowed");
                e.target.value = '';
                return;
              }
              
              if (file.size > 2 * 1024 * 1024) {
                toast.error("File size must be less than 2MB");
                e.target.value = '';
                return;
              }
              
              const fileName = `Appointment Letter${extension}`;
              file.originalName = fileName;
              setAppointmentLetterFile(renameFile(file, fileName));
            }}
          />
          <small className="text-muted">
            Upload PDF, JPG or PNG (Max: 2MB)
          </small>
          {isEditMode && employeeData?.fileStoreMaps?.[2]?.downLoadFile && (
            <div className="mt-2" style={{ display: "flex", alignItems: "center", gap: 6 }}>
              <Button
                variant="link"
                style={{ padding: 0, color: "#2466BF" }}
                onClick={() => handleFileDownload(employeeData.fileStoreMaps[2].downLoadFile)}
              >
                <FaDownload style={{ marginRight: 4 }} />
                Download appointment letter
              </Button>
            </div>
          )}
        </Col>
      </Row>
    </Card.Body>
  </Card>
</Collapsible>
