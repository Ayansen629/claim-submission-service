          }
        }
      },
      {
        name: 'panNumber',
        label: 'PAN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter PAN number (e.g., ABCDE1234F)',
        validation: { 
          required: 'PAN number is required',
          pattern: {
            value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
            message: 'Invalid PAN format'
          }
        }
      },
      {
        name: 'gstNumber',
        label: 'GST Number',
        type: 'text',
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter GST number (if applicable)',
