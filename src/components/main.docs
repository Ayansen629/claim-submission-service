{/* Documents Upload Section */}
<Collapsible
  title={
    <div className="d-flex align-items-center">
      <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
      <span style={{ color: "#2466BF" }}>Documents Upload</span>
    </div>
  }
  defaultOpen={true}
>
  <Card className="form-section-card">
    <Card.Body>
      <Row className="g-3">
        {/* Address Proof */}
        <Col md={6}>
          <div className="document-upload-container">
            <label className="form-label fw-semibold">
              Address Proof {!isEditMode && <span className="text-danger">*</span>}
            </label>
            <div className="file-input-wrapper">
              <input
                type="file"
                id="addressProof"
                className={`form-control file-input ${errors.addressProof ? 'is-invalid' : ''}`}
                accept=".jpg,.jpeg,.png,.pdf"
                {...register("addressProof", {
                  required: !isEditMode && "Address Proof is required",
                  validate: {
                    validFileType: (files) => {
                      if (!files || !files.length) return true;
                      const file = files[0];
                      const validExtensions = ['.jpg', '.jpeg', '.png', '.pdf'];
                      const extension = file.name?.substring(file.name.lastIndexOf('.')).toLowerCase();
                      return validExtensions.includes(extension) || "Only JPG, PNG, and PDF files are allowed";
                    },
                    validFileSize: (files) => {
                      if (!files || !files.length) return true;
                      return files[0].size <= 2 * 1024 * 1024 || "File size must be less than 2MB";
                    }
                  }
                })}
                onChange={(e) => {
                  const files = e.target.files;
                  if (!files || !files.length) return;
                  
                  const file = files[0];
                  const validExtensions = ['.jpg', '.jpeg', '.png', '.pdf'];
                  const extension = file.name?.substring(file.name.lastIndexOf('.')).toLowerCase();
                  
                  if (!extension || !validExtensions.includes(extension)) {
                    toast.error("Only JPG, PNG, and PDF files are allowed");
                    e.target.value = '';
                    return;
                  }
                  
                  if (file.size > 2 * 1024 * 1024) {
                    toast.error("File size must be less than 2MB");
                    e.target.value = '';
                    return;
                  }
                  
                  const fileName = `Address Proof${extension}`;
                  file.originalName = fileName;
                  setAddressProofFile(renameFile(file, fileName));
                }}
              />
              <label htmlFor="addressProof" className="file-input-label">
                <span className="file-input-text">
                  {addressProofFile ? addressProofFile.name : "Choose file..."}
                </span>
                <span className="file-input-button">Browse</span>
              </label>
            </div>
            <small className="text-muted d-block mt-1">
              Allowed formats: PDF, JPG, PNG (Max: 2MB)
            </small>
            {errors.addressProof && (
              <div className="invalid-feedback d-block" style={{ color: '#dc3545' }}>
                {errors.addressProof.message}
              </div>
            )}
            {isEditMode && employeeData?.fileStoreMaps?.[0]?.downLoadFile && (
              <div className="mt-2 download-link">
                <Button
                  variant="link"
                  className="p-0 text-primary text-decoration-none"
                  onClick={() => handleFileDownload(employeeData.fileStoreMaps[0].downLoadFile)}
                >
                  <FaDownload className="me-1" />
                  Download address proof
                </Button>
              </div>
            )}
          </div>
        </Col>

        {/* Identity Proof */}
        <Col md={6}>
          <div className="document-upload-container">
            <label className="form-label fw-semibold">
              Identity Proof {!isEditMode && <span className="text-danger">*</span>}
            </label>
            <div className="file-input-wrapper">
              <input
                type="file"
                id="identityProof"
                className={`form-control file-input ${errors.identityProof ? 'is-invalid' : ''}`}
                accept=".jpg,.jpeg,.png,.pdf"
                {...register("identityProof", {
                  required: !isEditMode && "Identity Proof is required",
                  validate: {
                    validFileType: (files) => {
                      if (!files || !files.length) return true;
                      const file = files[0];
                      const validExtensions = ['.jpg', '.jpeg', '.png', '.pdf'];
                      const extension = file.name?.substring(file.name.lastIndexOf('.')).toLowerCase();
                      return validExtensions.includes(extension) || "Only JPG, PNG, and PDF files are allowed";
                    },
                    validFileSize: (files) => {
                      if (!files || !files.length) return true;
                      return files[0].size <= 2 * 1024 * 1024 || "File size must be less than 2MB";
                    }
                  }
                })}
                onChange={(e) => {
                  const files = e.target.files;
                  if (!files || !files.length) return;
                  
                  const file = files[0];
                  const validExtensions = ['.jpg', '.jpeg', '.png', '.pdf'];
                  const extension = file.name?.substring(file.name.lastIndexOf('.')).toLowerCase();
                  
                  if (!extension || !validExtensions.includes(extension)) {
                    toast.error("Only JPG, PNG, and PDF files are allowed");
                    e.target.value = '';
                    return;
                  }
                  
                  if (file.size > 2 * 1024 * 1024) {
                    toast.error("File size must be less than 2MB");
                    e.target.value = '';
                    return;
                  }
                  
                  const fileName = `Identity Proof${extension}`;
                  file.originalName = fileName;
                  setIdentityProofFile(renameFile(file, fileName));
                }}
              />
              <label htmlFor="identityProof" className="file-input-label">
                <span className="file-input-text">
                  {identityProofFile ? identityProofFile.name : "Choose file..."}
                </span>
                <span className="file-input-button">Browse</span>
              </label>
            </div>
            <small className="text-muted d-block mt-1">
              Allowed formats: PDF, JPG, PNG (Max: 2MB)
            </small>
            {errors.identityProof && (
              <div className="invalid-feedback d-block" style={{ color: '#dc3545' }}>
                {errors.identityProof.message}
              </div>
            )}
            {isEditMode && employeeData?.fileStoreMaps?.[1]?.downLoadFile && (
              <div className="mt-2 download-link">
                <Button
                  variant="link"
                  className="p-0 text-primary text-decoration-none"
                  onClick={() => handleFileDownload(employeeData.fileStoreMaps[1].downLoadFile)}
                >
                  <FaDownload className="me-1" />
                  Download identity proof
                </Button>
              </div>
            )}
          </div>
        </Col>

        {/* Appointment Letter */}
        <Col md={6}>
          <div className="document-upload-container">
            <label className="form-label fw-semibold">
              Appointment Letter {!isEditMode && <span className="text-danger">*</span>}
            </label>
            <div className="file-input-wrapper">
              <input
                type="file"
                id="appointmentLetter"
                className={`form-control file-input ${errors.appointmentLetter ? 'is-invalid' : ''}`}
                accept=".jpg,.jpeg,.png,.pdf"
                {...register("appointmentLetter", {
                  required: !isEditMode && "Appointment Letter is required",
                  validate: {
                    validFileType: (files) => {
                      if (!files || !files.length) return true;
                      const file = files[0];
                      const validExtensions = ['.jpg', '.jpeg', '.png', '.pdf'];
                      const extension = file.name?.substring(file.name.lastIndexOf('.')).toLowerCase();
                      return validExtensions.includes(extension) || "Only JPG, PNG, and PDF files are allowed";
                    },
                    validFileSize: (files) => {
                      if (!files || !files.length) return true;
                      return files[0].size <= 2 * 1024 * 1024 || "File size must be less than 2MB";
                    }
                  }
                })}
                onChange={(e) => {
                  const files = e.target.files;
                  if (!files || !files.length) return;
                  
                  const file = files[0];
                  const validExtensions = ['.jpg', '.jpeg', '.png', '.pdf'];
                  const extension = file.name?.substring(file.name.lastIndexOf('.')).toLowerCase();
                  
                  if (!extension || !validExtensions.includes(extension)) {
                    toast.error("Only JPG, PNG, and PDF files are allowed");
                    e.target.value = '';
                    return;
                  }
                  
                  if (file.size > 2 * 1024 * 1024) {
                    toast.error("File size must be less than 2MB");
                    e.target.value = '';
                    return;
                  }
                  
                  const fileName = `Appointment Letter${extension}`;
                  file.originalName = fileName;
                  setAppointmentLetterFile(renameFile(file, fileName));
                }}
              />
              <label htmlFor="appointmentLetter" className="file-input-label">
                <span className="file-input-text">
                  {appointmentLetterFile ? appointmentLetterFile.name : "Choose file..."}
                </span>
                <span className="file-input-button">Browse</span>
              </label>
            </div>
            <small className="text-muted d-block mt-1">
              Allowed formats: PDF, JPG, PNG (Max: 2MB)
            </small>
            {errors.appointmentLetter && (
              <div className="invalid-feedback d-block" style={{ color: '#dc3545' }}>
                {errors.appointmentLetter.message}
              </div>
            )}
            {isEditMode && employeeData?.fileStoreMaps?.[2]?.downLoadFile && (
              <div className="mt-2 download-link">
                <Button
                  variant="link"
                  className="p-0 text-primary text-decoration-none"
                  onClick={() => handleFileDownload(employeeData.fileStoreMaps[2].downLoadFile)}
                >
                  <FaDownload className="me-1" />
                  Download appointment letter
                </Button>
              </div>
            )}
          </div>
        </Col>
      </Row>
    </Card.Body>
  </Card>
</Collapsible>
