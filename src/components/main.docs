.custom-declaration-btn {
  background-color: var(--btn-bg) !important;
  border-color: var(--btn-border) !important;
}

.custom-declaration-btn:hover,
.custom-declaration-btn:focus,
.custom-declaration-btn:active {
  background-color: var(--btn-bg) !important;
  border-color: var(--btn-border) !important;
  opacity: 0.9;
}
