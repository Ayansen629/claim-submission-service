/* SurveyTrackerCard.css */

.survey-tracker-card {
  grid-column: span 2;
  height: 100%;
}

.survey-tracker-card .status-card-content {
  padding: 15px;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.card-header-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.card-header-text {
  margin-left: 12px;
}

.calendar-wrapper {
  margin-top: 5px;
  width: 100%;
  flex: 1;
  min-height: 0; /* Allows calendar to shrink */
}

/* Compact Calendar Styling */
.survey-calendar {
  width: 100% !important;
  height: 100% !important;
  font-family: inherit !important;
  border: none !important;
  background: transparent !important;
  display: flex;
  flex-direction: column;
}

.survey-calendar .react-datepicker__month-container {
  width: 100%;
  height: 100%;
  float: none;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.survey-calendar .react-datepicker__header {
  background-color: transparent;
  border-bottom: none;
  padding: 0 0 5px 0;
}

.survey-calendar .react-datepicker__day-names {
  display: flex;
  justify-content: space-around;
  margin: 0;
  padding: 0;
}

.survey-calendar .react-datepicker__day-name {
  color: #666;
  font-weight: 500;
  font-size: 0.65rem;
  margin: 0;
  width: 1.8em;
  line-height: 1.8em;
}

.survey-calendar .react-datepicker__month {
  margin: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.survey-calendar .react-datepicker__week {
  display: flex;
  justify-content: space-around;
  flex: 1;
}

.survey-calendar .react-datepicker__day {
  margin: 0;
  width: 1.8em;
  line-height: 1.8em;
  font-size: 0.7rem;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
}

.survey-calendar .react-datepicker__day--selected,
.survey-calendar .react-datepicker__day--keyboard-selected {
  background-color: #6f42c1;
  color: white;
}

.survey-calendar .react-datepicker__day--today {
  font-weight: bold;
  color: #0d6efd;
}

.survey-calendar .react-datepicker__navigation {
  top: 0.3em;
  width: 1.5em;
  height: 1.5em;
}

.day-container {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.day-number {
  font-size: 0.7rem;
}

.event-indicators {
  position: absolute;
  bottom: 0;
  display: flex;
  gap: 1px;
}

.event-indicator {
  width: 3px;
  height: 3px;
  border-radius: 50%;
}

/* Ensure left border color shows */
.status-card {
  position: relative;
  overflow: hidden;
}

.status-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background-color: inherit;
}

.survey-tracker-card::before {
  background-color: #6f42c1; /* Default purple color */
}
