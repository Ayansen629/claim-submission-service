                register={register("navigationEquipment.magneticCompass")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Very High Frequency (VHF) radio")}
                name="navigationEquipment.vhfRadio"
                type="number"
