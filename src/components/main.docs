.custom-sidebar {
  background-color: #f4f8fc;
  color: #2466bf;
  height: calc(100vh - 60px);
  transition:
    width 0.5s cubic-bezier(0.33, 1, 0.68, 1),
    box-shadow 0.4s ease-out,
    background 0.3s ease;
  overflow: hidden;
  padding-top: 0;
  box-shadow: 2px 0 12px rgba(0, 0, 0, 0.1);
  border-right: 1px solid #e1eaf5;
  position: fixed;
  top: 75px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  will-change: transform, width;
}

.custom-sidebar.collapsed {
  width: 60px;
  transition:
    width 0.5s cubic-bezier(0.33, 1, 0.68, 1),
    box-shadow 0.4s ease-out,
    background 0.3s ease;
}

.custom-sidebar.expanded {
  width: 17rem;
  transition:
    width 0.5s cubic-bezier(0.33, 1, 0.68, 1),
    box-shadow 0.4s ease-out,
    background 0.3s ease;
}

.custom-sidebar-menu,
.custom-sidebar-submenu-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.custom-sidebar-item {
  transition: background 0.3s ease;
}

.custom-sidebar-item.active > .custom-sidebar-link {
  background-color: #d6e6f9;
  font-weight: 600;
}

.custom-sidebar-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 18px;
  cursor: pointer;
  text-decoration: none;
  transition: 
    background 0.3s ease,
    transform 0.2s ease;
  border-radius: 0 20px 20px 0;
  transform-origin: left center;
}

.custom-sidebar-link:hover {
  background-color: #e8f1fc;
  transform: scale(1.02);
}

.custom-sidebar-link-content {
  display: flex;
  align-items: center;
  transition: opacity 0.3s ease;
}

.custom-sidebar.collapsed .custom-sidebar-link-content {
  opacity: 0.9;
}

.custom-sidebar-icon {
  margin-right: 12px;
  font-size: 1.1rem;
  transition: transform 0.3s ease;
}

.custom-sidebar.collapsed .custom-sidebar-icon {
  margin-right: 0;
  transform: scale(1.1);
}

.custom-sidebar-chevron {
  margin-left: auto;
  transition: 
    transform 0.4s cubic-bezier(0.68, -0.6, 0.32, 1.6),
    opacity 0.2s ease;
}

.custom-sidebar-chevron.rotate {
  transform: rotate(90deg);
}

.custom-sidebar-submenu {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transform: translateY(-5px);
  transition:
    max-height 0.6s cubic-bezier(0.33, 1, 0.68, 1),
    opacity 0.5s ease 0.1s,
    transform 0.5s cubic-bezier(0.33, 1, 0.68, 1) 0.1s;
  will-change: max-height, opacity, transform;
}

.custom-sidebar-submenu.expanded {
  max-height: 1000px;
  opacity: 1;
  transform: translateY(0);
  transition:
    max-height 0.7s cubic-bezier(0.33, 1, 0.68, 1),
    opacity 0.4s ease,
    transform 0.5s cubic-bezier(0.33, 1, 0.68, 1);
}

.custom-sidebar-submenu-list {
  padding: 5px 0;
}

.custom-sidebar-sublink {
  margin: 3px 5px;
  display: block;
  padding: 10px 35px;
  color: #2466bf;
  text-decoration: none;
  font-size: 0.85rem;
  border-radius: 0 20px 20px 0;
  transition: 
    background 0.3s ease, 
    color 0.3s ease,
    transform 0.2s ease,
    padding-left 0.3s ease;
  transform-origin: left center;
}

.custom-sidebar-sublink:hover {
  background-color: #e1ecfb;
  color: #1d4f9b;
  transform: scale(1.02);
  padding-left: 38px;
}

.custom-sidebar-sublink.active {
  background-color: #d6e6f9;
  color: #1d4f9b;
  font-weight: 500;
}

@media (max-width: 768px) {
  .custom-sidebar {
    top: 0;
    left: 0;
    height: 100vh;
    width: 250px;
    transform: translateX(-100%);
    transition:
      transform 0.5s cubic-bezier(0.33, 1, 0.68, 1),
      box-shadow 0.4s ease-out,
      background 0.3s ease;
  }

  .custom-sidebar.collapsed {
    transform: translateX(-100%);
  }

  .custom-sidebar.expanded {
    transform: translateX(0);
    box-shadow: 4px 0 20px rgba(0, 0, 0, 0.15);
  }

  .custom-sidebar-close {
    display: flex;
    padding: 1rem;
    justify-content: flex-end;
  }

  .custom-sidebar-close svg {
    transition: transform 0.3s ease;
  }

  .custom-sidebar-close svg:hover {
    transform: rotate(90deg);
  }
}

.custom-sidebar-menu {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 10px 0;
  scrollbar-width: thin;
  scrollbar-color: rgba(36, 102, 191, 0.3) transparent;
}

.custom-sidebar-menu::-webkit-scrollbar {
  width: 6px;
}

.custom-sidebar-menu::-webkit-scrollbar-thumb {
  background-color: rgba(36, 102, 191, 0.3);
  border-radius: 4px;
  transition: background-color 0.3s ease;
}

.custom-sidebar-menu::-webkit-scrollbar-thumb:hover {
  background-color: rgba(36, 102, 191, 0.5);
}

.custom-sidebar-submenu.expanded::-webkit-scrollbar {
  width: 4px;
}

.custom-sidebar-submenu.expanded::-webkit-scrollbar-thumb {
  background-color: rgba(36, 102, 191, 0.25);
}
