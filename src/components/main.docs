const validateStep = async () => {
  const currentFields = getCurrentStepFields();
  
  // Get all required fields for this step
  const requiredFields = currentFields.filter(field => 
    field.required && (!field.showIf || field.showIf())
  );
  
  let hasErrors = false;
  
  // Check each required field
  for (const field of requiredFields) {
    const value = getValues(field.name);
    
    // Check if field is empty
    if (!value || value === '') {
      setError(field.name, {
        type: 'required',
        message: `${field.label} is required`
      });
      hasErrors = true;
    } 
    // For file fields, check if we have a valid file
    else if (field.type === 'file' && value instanceof File) {
      // File exists, check if it's valid
      const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
      if (!validTypes.includes(value.type)) {
        setError(field.name, {
          type: 'fileType',
          message: 'Only PDF, JPG or PNG files are allowed'
        });
        hasErrors = true;
      } else if (value.size > 2 * 1024 * 1024) {
        setError(field.name, {
          type: 'fileSize',
          message: 'File size should not exceed 2MB'
        });
        hasErrors = true;
      } else {
        // Valid file, clear any errors
        clearErrors(field.name);
      }
    }
  }
  
  return !hasErrors;
};
