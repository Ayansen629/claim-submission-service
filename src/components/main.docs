.subCard {
    flex: 1 1 calc(33.33% - 1rem);
    border-radius: 1rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.07);
    padding: 1rem;
    text-align: center;
    border-left: 2px solid var(--primary-color);
    transition: transform 0.2s ease;
    color: white;
}

.subCard:nth-child(1) {
    background-color: #0070C0;
}

.subCard:nth-child(2) {
    background-color: #00A3E0;
}

.subCard:nth-child(3) {
    background-color: #00A3E0;
}

.subCard h5 {
    font-size: 1em;
    color: white;
    margin-bottom: 0.5rem;
}

.subValue {
    font-size: 1.25rem;
    font-weight: 600;
    color: white;
}

.subCount {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
}
