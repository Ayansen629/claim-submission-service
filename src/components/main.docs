import React, { useState, useEffect, useRef ,useCallback} from "react";
import style from "./ActionTable.module.css";
import _ from "lodash";
// import GenericExportDropdown from "./export/GenericExport";
import editIcon from "../../../assests/icons/edit.svg";
import viewIcon from "../../../assests/icons/view.svg";
import deleteIcon from "../../../assests/icons/delete.svg";
import upload from "../../../assests/icons/upload.svg";
import download from "../../../assests/icons/download.svg";

import { BsGeoAltFill } from "react-icons/bs";

import Tooltip from "@mui/material/Tooltip";
import { Dropdown } from "react-bootstrap";
// import { FaCodePullRequest,FaFrown } from "react-icons/fa6";

const ActionTable = (props) => {
  console.log(props.rowData ,"originaldata")
  
   
  const [searchedData, setSearchedData] = useState(props.rowData || []);
  const [currentPage, setCurrentPage] = useState(1);
  const [selected, setSelected] = useState([]);
  const [sortedColumn, setSortedColumn] = useState(null);
  const [sortOrder, setSortOrder] = useState("");
  const hideColumns = props.hideColumns || [];
  const [searchQuery, setSearchQuery] = useState("");

  useEffect(() => {
    if (props.rowData) {
      setSearchedData(props.rowData);
      setCurrentPage(1);
      const selectedRows = props.rowData
        .filter((item) => item.isChecked)
        .map((item) => item.id);
      setSelected(selectedRows);
    }
  }, [props.rowData]);

  const [itemsPerPage, setItemPerPage] = useState(10);
  const indexOfLastItem = currentPage * itemsPerPage;
  const indexOfFirstItem = indexOfLastItem - itemsPerPage;
  const currentItems = searchedData.slice(indexOfFirstItem, indexOfLastItem);
  const totalPages = Math.ceil((props.rowData?.length || 0) / itemsPerPage);

  const handleNextPage = () => {
    setCurrentPage((prevPage) => Math.min(prevPage + 1, totalPages));
  };
  // Debounced search function
  const debouncedSearch = useCallback(
    _.debounce((query) => {
      if (query) {
        const searchValue = query.toLowerCase();
        const filterObject = (obj) => {
          return Object.values(obj).some((value) => {
            if (typeof value === "object" && value !== null) {
              return filterObject(value);
            }
            return value?.toString().toLowerCase().includes(searchValue);
          });
        };
        const filtered = props.rowData.filter((item) => filterObject(item));
        setSearchedData(filtered);
        setCurrentPage(1);
      } else {
        setSearchedData(props.rowData);
      }
    }, 300),
    [props.rowData]
  );

  const handlePrevPage = () => {
    setCurrentPage((prevPage) => Math.max(prevPage - 1, 1));
  };

  const handleOnSearch = (e) => {
    const query = e.target.value;
    setSearchQuery(query);
    debouncedSearch(query);
  };

  // const handleOnSearch = (e) => {
  //   if (e.target.value) {
  //     const searchValue = e.target.value.toLowerCase();
  //     const filterObject = (obj) => {
  //       return Object.values(obj).some((value) => {
  //         if (typeof value === "object" && value !== null) {
  //           return filterObject(value);
  //         }
  //         return value?.toString().toLowerCase().includes(searchValue);
  //       });
  //     };
  //     const filtered = props.rowData.filter((item) => filterObject(item));
  //     setSearchedData(filtered);
  //     setCurrentPage(1);
  //   } else {
  //     setSearchedData(props.rowData);
  //   }
  // };

  const sortByColumn = (column) => {
    if (sortedColumn === column) {
      setSortOrder(sortOrder === "asc" ? "desc" : "asc");
    } else {
      setSortedColumn(column);
      setSortOrder("asc");
    }
  };

  const showSortedColumnIcon = (columnName) => {
    return sortedColumn === columnName ? (
      sortOrder === "asc" ? (
        <i className="fa fa-long-arrow-up table-arrow" aria-hidden="true" />
      ) : (
        <i className="fa fa-long-arrow-down table-arrow" aria-hidden="true" />
      )
    ) : (
      <></>
    );
  };

  useEffect(() => {
    if (sortOrder && sortedColumn) {
      const sortedData = [...searchedData].sort((a, b) => {
        const columnValueA = _.get(a, sortedColumn);
        const columnValueB = _.get(b, sortedColumn);
        if (sortOrder === "asc") {
          return typeof columnValueA === "string"
            ? columnValueA?.localeCompare(columnValueB)
            : columnValueA - columnValueB;
        } else {
          return typeof columnValueA === "string"
            ? columnValueB?.localeCompare(columnValueA)
            : columnValueB - columnValueA;
        }
      });
      setSearchedData(sortedData);
    }
  }, [sortOrder, sortedColumn]);

  const handleDeleteRow = (rowData) => {
    props.onDeleteRow?.(rowData);
  };
  const handleTrack = (rowData) => {
    props.onTrackRow?.(rowData);
  };

  const handleView = (rowData) => {
    props.onViewRow?.(rowData);
  };
  const handleEdit = (rowData) => {
    props.handleEditRow(rowData)
  };

  const handleDownload = (rowData) => {
    props.download?.(rowData);
  };

  const onCheckColumn = (event) => {
    if (props.checkType === "multiCheck") {
      if (event.target.checked) {
        const newSelecteds = currentItems.map((n) => n);
        setSelected(newSelecteds);
        props.onCheckHandler?.(newSelecteds);
        return;
      }
      setSelected([]);
      props.onCheckHandler?.([]);
    } else {
      setSelected([]);
      props.onCheckHandler?.([]);
    }
  };

  const onRowCheck = (event, id, row) => {
    if (props.checkType === "multiCheck") {
      const selectedIndex = selected.map((e) => e.id).indexOf(id);
      let newSelected = [];
      const NOCHECK_ITEM = -1;
      if (selectedIndex === NOCHECK_ITEM) {
        newSelected = newSelected.concat(selected, row);
      } else if (selectedIndex === 0) {
        newSelected = newSelected.concat(selected.slice(1));
      } else if (selectedIndex === selected.length - 1) {
        newSelected = newSelected.concat(selected.slice(0, -1));
      } else if (selectedIndex > 0) {
        newSelected = newSelected.concat(
          selected.slice(0, selectedIndex),
          selected.slice(selectedIndex + 1)
        );
      }
      setSelected(newSelected);
      props.onCheckHandler?.(newSelected);
    } else {
      const selectedIndex = selected.map((e) => e.id).indexOf(id);
      let newSelected = [];
      const NOCHECK_ITEM = -1;
      if (selectedIndex === NOCHECK_ITEM) {
        newSelected = newSelected.concat(selected, row);
      } else if (selectedIndex === 0) {
        newSelected = newSelected.concat(selected.slice(1));
      } else if (selectedIndex > 0) {
        newSelected = newSelected.concat(
          selected.slice(0, selectedIndex),
          selected.slice(selectedIndex + 1)
        );
      }
      setSelected(newSelected);
      props.onCheckHandler?.(newSelected);
    }
  };

  const isSelected = (id) => {
    const pos = selected.map((e) => e.id).indexOf(id);
    return pos !== -1;
  };

  const uncheckLast = () => {
    if (props.checkType === "singleCheck") {
      let ns = selected.slice(1);
      setSelected(ns);
    }
  };

  const handlePullBack = (rowData) => {
    props.pullBack?.(rowData);
  };

  useEffect(() => {
    let x = document.getElementById("table-column-check");
    const checkedItems = selected.every((id) =>
      currentItems.some((obj) => obj.id === id)
    );
    if (props.checkType) {
      if (
        selected.length > 0 &&
        selected.length < props.rowData.length &&
        selected.length === currentItems.length &&
        checkedItems
      ) {
        x.indeterminate = true;
      } else {
        x.indeterminate = false;
      }
      if (selected.length > 1 && props.checkType === "singleCheck") {
        uncheckLast();
      }
    }
  }, [selected, currentItems]);

  const onRowClick = (event, rowData) => {
    props.additionalMethod?.(rowData);
  };

  const onChangeRowsPerPage = (item) => {
    setItemPerPage(item);
  };
  const userData = JSON.parse(localStorage.getItem("userFormData"));
  const PaginationOptions = () => {
    const [isShow, setIsShow] = useState(false);
    const exportRef = useRef(null);

    useEffect(() => {
      const handleOutsideClick = (e) => {
        if (exportRef.current && !exportRef.current.contains(e.target)) {
          setIsShow(false);
        }
      };
      document.addEventListener("click", handleOutsideClick);
      return () => {
        document.removeEventListener("click", handleOutsideClick);
      };
    }, []);



    return (
      <div
      id="export_button"
      ref={exportRef}
      className="d-inline-flex flex-row align-items-center stickyCard"
    >
      <div className="ps-3" style={{ marginRight: "10px" }}>
        {" "}
        {/* Added margin to create a gap */}
        Rows per page
      </div>
      <Dropdown>
        <Dropdown.Toggle
          id="dropdownMenuButton1"
          style={{
            color: "white", // Text color
            backgroundColor: "#269ccc", // Background color
            borderColor: "#000000", // Border color (optional, for consistency)
          }}
        >
          <span className="font-14">{itemsPerPage}</span>
        </Dropdown.Toggle>

        <Dropdown.Menu>
          {[10, 25, 50, 100].map((item, i) => (
            <Dropdown.Item
              key={i}
              onClick={() => onChangeRowsPerPage(item)}
              onMouseEnter={(e) => {
                e.currentTarget.style.backgroundColor = "#269ccc"; // Hover background color
                e.currentTarget.style.color = "#000"; // Hover text color
              }}
              onMouseLeave={(e) => {
                e.currentTarget.style.backgroundColor = ""; // Reset background color
                e.currentTarget.style.color = ""; // Reset text color
              }}
              style={{
                cursor: "pointer",
                transition: "background-color 0.3s ease, color 0.3s ease", // Smooth transition
              }}
            >
              {item}
            </Dropdown.Item>
          ))}
        </Dropdown.Menu>
      </Dropdown>
    </div>
    );
  };

  return (
    <div className="mb-5 px-0 mx-0 generic-action-table pt-3">
    {/* Search Bar and Filters */}
    <div
      className={`row ${style.application_search} ${
        props.hideSearchBar ? "justify-content-end mb-2" : "justify-content-center"
      }`}
    >
      {props.filters && (
        <div className="col-sm-6 my-2 fw-600" style={{ width: "fit-content" }}>
          {props.filters()}
        </div>
      )}
      {!props.hideSearchBar && (
        <div className="col-sm-4 my-2">
          <input
            type="search"
            onChange={handleOnSearch}
            placeholder="Search"
            //  placeholder="🔍 Search by Claim Number, Claimant, or Status..."
            className={`form-control ${props.hideSearchBar && "d-none"}`}
            style={{ width: "100%", maxWidth: "400px" }}
          />
        </div>
      )}
      {props.showCustomBtn && (
        <div
          id="table_custom_button_div"
          className="col-sm-2 my-2"
          style={props.btnStyle ? props.btnStyle : { width: "12%" }}
        >
          <button
            onClick={props.handleBtnClick}
            type="button"
            disabled={props.isCustomBtnDisabled}
            className="btn btn-primary"
            style={{ width: "100%" }}
          >
            <span className="font-14">{props.btnName}</span>
          </button>
        </div>
      )}
    </div>
  
    {/* Table */}
    <div className="table-container">
      <table className={`table ${style.table}`} style={{ width: props.tableWidth }}>
        <thead>
          <tr className="table_header">
            {props.columns?.map((data, colIndx) => {
              const checkedItems = selected.every((item) =>
                currentItems.some((obj) => obj.id === item.id)
              );
              return data.fieldName === "checkbox" && props.checkType === "multiCheck" ? (
                <th
                  key={colIndx}
                  className={`px-3 py-2 ${data.clsName}`}
                  style={{ minWidth: data.minWidth || "6rem" }}
                >
                  <input
                    type="checkbox"
                    id="table-column-check"
                    ref={(input) => {
                      if (input) {
                        input.indeterminate =
                          selected.length > 0 && selected.length < currentItems.length;
                      }
                    }}
                    checked={
                      props.rowData?.length > 0 &&
                      selected.length === currentItems.length &&
                      checkedItems
                    }
                    name="column-check"
                    onClick={(e) => onCheckColumn(e, data)}
                  />
                </th>
              ) : !hideColumns.includes(data.fieldName) ? (
                <th
                  key={colIndx}
                  className={`px-3 py-2 ${data.clsName}`}
                  style={{ minWidth: data.minWidth || "6rem" }}
                  onClick={() => sortByColumn(data.fieldName)}
                >
                  {data.titleCode ? data.titleCode : data.colName}{" "}
                  {showSortedColumnIcon(data.fieldName)}
                </th>
              ) : null;
            })}
          </tr>
        </thead>
        <tbody>
          {searchedData.length !== 0 ? (
            currentItems.map((row, index) => {
              const rowId = row.id;
              const isItemSelected = isSelected(rowId);
              return (
                <tr key={index} className="table_datarow">
                  {props.columns.map((o, colIndex) =>
             
                  
                 
                    o.isClickable ? (
                      <td
                        key={colIndex}
                        className={`px-3 py-2 ${o.clsName} ${
                          colIndex === props.columns.length - 1
                            ? "last-column"
                            : colIndex === 0
                            ? "first-column"
                            : ""
                        }`}
                        style={{
                          color: "#3370D4",
                          cursor: "pointer",
                          fontWeight: row.isRead === false ? "bolder" : "normal",
                        }}
                        onClick={(e) => onRowClick(e, row)}
                      >
                        
                        <span>{_.get(row, o.fieldName)}</span>
                      </td>
                    ) : o.fieldName === "checkbox" ? (
                      <td key={colIndex} className={`px-3 py-2 ${o.clsName}`}>
                        <input
                          type="checkbox"
                          checked={isItemSelected}
                          name="row-check"
                          onChange={(event) => onRowCheck(event, rowId, row)}
                        />
                      </td>
                    ) : !hideColumns.includes(o.fieldName) && o.fieldName !== "action" ? (
                      <td
                        key={colIndex}
                        className={`px-3 py-2 ${o.clsName} ${
                          colIndex === props.columns.length - 1
                            ? "last-column"
                            : colIndex === 0
                            ? "first-column"
                            : ""
                        }`}
                        style={{
                          fontWeight: row.isRead === false ? "bolder" : "normal",
                        }}
                      >
                        {o.colName === "Status" ? (
                          
                          <span className={`status-column ${_.get(row, o.fieldName)}-status`}>
                            {_.get(row, o.fieldName) ? _.get(row, o.fieldName) : <>
                            <i className="fa fa-exclamation-circle me-1" >No Status found</i>
                            </>}
                            {o.fieldName2 ? _.get(row, o.fieldName2) : ""}
                          </span>
                        ) : (
                          <span>
                            {_.get(row, o.fieldName)}{" "}
                            {o.fieldName2 ? _.get(row, o.fieldName2) : ""}
                          </span>
                        )}
                      </td>
                    ) :!hideColumns.includes(o.fieldName) && o.fieldName === "action" ? (
                      <td key={colIndex} className={`px-3 py-2 ${o.clsName} action-column`}>
                        <div className="d-flex" style={{ gap: "12px", justifyContent: "center" }}>
                          {/* Edit Button */}
                          {/* {o.actions.includes("edit") && (
                            <Tooltip title="Edit this item" placement="top" arrow>
                              <button
                                className="btn btn-light border-secondary btn-sm "
                                onClick={() => props.handleEditRow(row)}
                                type="button"
                                disabled // Disable the button
                                style={{ opacity: 0.5, cursor: "not-allowed" }} // Visual indication of disabled state
                              >
                                <img src={editIcon} alt="edit" className="table-action-icon" />
                              </button>
                            </Tooltip>
                          )}
                     */}
                     {console.log(row.applicationStatus,"statusdata")}
                     {/* row.applicationStatus!=="Sent back" */}

{o.actions.includes("edit") && userData?.userType !== "CRP" &&
 (
  
<Tooltip title="Edit this item" placement="top" arrow>
  <button
    className="btn btn-light border-secondary btn-sm"
    onClick={() => handleEdit(row)}
    type="button"
    disabled={
      row.applicationStatus !== "Sent back" && row.applicationStatus !== "Draft"
    }
    style={
      row.applicationStatus !== "Sent back" && row.applicationStatus !== "Draft"
        ? { opacity: 0.5, cursor: "not-allowed" }
        : {}
    }
  >
    <img src={editIcon} alt="edit" className="table-action-icon" />
  </button>
</Tooltip>

)}
                          {/* View Button */}
                          {o.actions.includes("view") && (
                            <Tooltip title="View details" placement="top" arrow>
                              <button
                                className="btn btn-info btn-sm"
                                onClick={() => handleView(row)}
                                type="button"
                                // disabled
                                // style={{ opacity: 0.5, cursor: "not-allowed" }} 
                              >
                                <img src={viewIcon} alt="view" className="table-action-icon" />
                              </button>
                            </Tooltip>
                          )}
                          
                          {o.actions.includes("track") &&  userData?.userType !== "CRP"  &&(
  <Tooltip title="Track this item" placement="top" arrow>
    <button
      className="btn btn-info btn-sm"
      onClick={() => handleTrack(row)}
      type="button"
    >
      <BsGeoAltFill />
    </button>
  </Tooltip>
)}

                    
                          {/* Delete Button */}
                          {/* {o.actions.includes("delete") && (
                            <Tooltip title="Delete this item" placement="top" arrow>
                              <button
                                className="btn btn-danger btn-sm"
                                onClick={() => handleDeleteRow(row)}
                                type="button"
                              >
                                <img src={deleteIcon} alt="delete" className="table-action-icon" />
                              </button>
                            </Tooltip>
                          )} */}
                        </div>
                      </td>
                    ) : null
                  )}
                </tr>
              );
            })
          ) : (
            <tr>
              <td colSpan={props.columns.length} className="text-center fw-bold py-4">
                <h5>Sorry, we couldn't find any results</h5>
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  
    {/* Table Footer */}
    <div
          className={`col-sm-12 py-3 position-relative d-flex justify-content-between align-items-center ${style.table_footer}`}
        >
          <div>
            Entries found: {props?.rowData?.length || searchedData.length}
          </div>
          <div
            className="d-flex align-items-center"
            style={{ marginRight: 30 }}
          >
            <PaginationOptions />
            <div>
              <button
                onClick={handlePrevPage}
                disabled={currentPage === 1}
                className="btn btn-light"
              >
                <i className="fa fa-arrow-left" aria-hidden="true"></i>
              </button>
              <span className={`mx-1 ${style.pagenumber}`}>{currentPage}</span>
              <button
                onClick={handleNextPage}
                disabled={currentPage === totalPages}
                className="btn btn-light"
              >
                <i className="fa fa-arrow-right" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </div>
  </div>
  );
};

export default ActionTable;

/* Table Container */
.table-container {
  width: 100%;
  overflow-x: auto;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  margin-top: 20px;
  background-color: #ffffff;
}

/* Table */
.table {
  width: 100%;
  border-collapse: collapse;
  background-color: #ffffff;
}

/* Table Header */
.table_header {
  background: #269ccc;
  color: #ffffff;
  font-weight: 900;
  padding: 16px;
  text-align: left;
  font-size: 18px;
  border-bottom: 2px solid #1f8bbf;
}

/* Table Data Rows */
.table_datarow {
  background-color: #f9f9f9;
  transition: background-color 0.3s ease;
}

.table_datarow:nth-child(even) {
  background-color: #ffffff;
}

.table_data {
  padding: 12px 16px;
  font-size: 14px;
  font-weight: 400;
  color: #34495e;
  border-bottom: 1px solid #ecf0f1;
  text-align: left;
}

.table_datarow:hover {
  background-color: #f1f8ff;
}

.table_footer {
  background: #f5f5f5; /* Gray background */
  color: #000000; /* Black text */
  padding: 10px 15px;
  border-top: 1px solid #ddd; /* Light gray border */
  text-align: right;
}
/* Pagination Number */
.pagenumber {
  background: #ffffff;
  color: #269ccc;
  border-radius: 50px;
  padding: 6px 12px;
  font-size: 14px;
  border: 1px solid #269ccc;
}

.pagenumber:hover {
  background: #269ccc;
  color: #ffffff;
}

/* Status Column */
.status-column {
  padding: 5px 10px;
  border-radius: 16px;
  font-size: 13px;
}


.approve-status {
  background: #e8f7e7;
  color: #27ae60;
}

.initiate-status {
  background: #d0e7f5;
  color: #2980b9;
}

.pending-status {
  background: #fff3e0;
  color: #e67e22;
}

/* Search Container */
.search-container {
  margin-bottom: 20px;
  display: flex;
  justify-content: center;
}

.search-container input[type="text"] {
  width: 100%;
  max-width: 400px;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-size: 14px;
  outline: none;
  transition: border-color 0.3s ease;
}

.search-container input[type="text"]:focus {
  border-color: #269ccc;
}





/* Media Queries for Smaller Screens */
@media (max-width: 768px) {
  .table_header,
  .table_footer {
    padding: 12px;
  }

  .table_data {
    font-size: 12px;
    padding: 8px 12px;
  }

  .search-container input[type="text"] {
    width: 100%;
  }
}
.pagenumber {
  background: #3498db; /* Blue background */
  color: white;
  border-radius: 50px;
  padding: 6px 12px;
  font-size: 14px;
}
.arrow {
  background: transparent;
  border: none;
  color: #333;
  cursor: pointer;
}
import React, { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import "bootstrap/dist/css/bootstrap.min.css";
import { Container, Row, Col, Modal, Button, Table } from "react-bootstrap";
import "./DashboardMain.css";
import FileUploadModal from "./FileUploadModal.jsx";
import ActionTable from "./ActionTable.js"; 
import { toast } from "react-toastify";
import { APP_MESSAGES, openFileInNewTab } from "../../../utils/constants.ts";
import { URLS_ENDPOINT } from "../../../utils/urlsConstants.ts";
import { postData } from "../../../services/http.service.ts";
// import Collapsible from "../../../common/Collapsible.js";
import Collapsible from "../stepperForm/formCommon/Collapsible.js";
import PreviewCard from "./PreviewCard.js";
import { FaCheckCircle, FaClock, FaHourglassStart } from "react-icons/fa";

import { FaDownload, FaClipboardList, FaFile, FaFilePdf } from "react-icons/fa6";

const DashboardMain = () => {
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [modalData, setModalData] = useState({});
  const [historyModal, setHistoryModal] = useState(false);
  const [historyData, setHistoryData] = useState({});
  const [showDocumentModal, setShowDocumentModal] = useState(false);
  const [documentListData, setDocumentListData] = useState([]);
  const navigate = useNavigate();
   const [isTrackModalOpen, setIsTrackModalOpen] = useState(false);
    const [trackData, setTrackData] = useState({});

  const handleDocumentModal = () => setShowDocumentModal(!showDocumentModal);

  const [rowData, setRowData] = useState([]);
  const columns = [
    {
      colName: "SL NO",
      fieldName: "slNo",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "SL NO",
      minWidth: "5rem",
    },
    {
      colName: "Claim Number",
      fieldName: "claimNumber",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Claim Number",
      minWidth: "10rem",
    },
    {
      colName: "Claimant",
      fieldName: "claimant",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Claimant",
      minWidth: "10rem",
    },
    {
      colName: "Status",
      fieldName: "status",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Status",
      minWidth: "10rem",
    },
    {
      colName: "comment",
      fieldName: "comment",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "comment",
      minWidth: "10rem",
    },
    {
      colName: "Amount",
      fieldName: "amount",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Amount",
      minWidth: "10rem",
    },
    {
      colName: "Date Submitted",
      fieldName: "dateSubmitted",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Date Submitted",
      minWidth: "10rem",
    },
    {
      colName: "Action",
      fieldName: "action",
      actions: ["view", "edit","track"],
      clsName: "col-sm-2 column-text-start actions-column",
    },
  ];
  const handleTrackRow = (row) => {
    console.log("Track row:", row.uuid);
    // Set static data for tracking
    const staticTrackData = {
      applicationNumber: row.claimNumber || "N/A",
      trackingSteps: [
        { step: "Step 1", description: "Application Submitted", date: "2023-10-01" },
        { step: "Step 2", description: "Under Review", date: "2023-10-05" },
        { step: "Step 3", description: "Approved", date: "2023-10-10" },
      ],
    };
    setTrackData(staticTrackData);
    setIsTrackModalOpen(true);
  };

  // const handleViewRow = (row) => {
  //   console.log("View row:", row.uuid);
  //   if (row?.uuid) {
  //     navigate(`/apply-claim/view/${row.uuid}`);
  //   } else {
  //     console.error("UUID not found in the row object.");
  //     toast.warning("No UUID Available..", { position: "top-right" });
  //   }
  // };

   // const handleAddButtonClick = () => {
  //   setIsLoading(true);
  //   setTimeout(() => {
  //     setIsLoading(false);
  //     navigate("/registration");
  //   }, 1000);
  // };

  const handleEditRow = (row) => {
    console.log("Edit row:", row.uuid);
    if (row?.uuid) {
      navigate(`/apply-claim/edit/${row.uuid}`);
    } else {
      console.error("UUID not found in the row object.");
      toast.warning("No UUID Available..", { position: "top-right" });
    }
  };

  const formatFileInfo = (document) => {
    if (!document) return "N/A";
    return `${document.docType || 'Document'} (${document.docName || 'No name'})`;
  };

  const transformApplicationData = (application) => {
    if (!application) return null;

    const basicDetails = application.creditorBasicDetails || {};
    const claimDetails = application.claimDetails || {};
    const signatoryDetails = application.signatoryDetails || {};

    return {
      applicationNumber: application.applicationNumber,
      step1: {
        creditorDetails: {
          // "Application Number": application.applicationNumber,
          "Debtor Name": basicDetails.debtorName,
          "Creditor Name": basicDetails.creditorName,
          "Total Claim Amount": basicDetails.totalClaimAmount,
          "Debt Details": basicDetails.debtDetails,
          "Mutual Credit Details": basicDetails.mutualCreditDetails,
        },
        identificationDetails: {
          "Identification Type": basicDetails.document?.docType,
          "Identification Number": basicDetails.identificationNumber,
          "Document Name": formatFileInfo(basicDetails.document),
        },
      },
      step2: {
        financialDetails: {
          "Security Interest Amount": claimDetails.securityInterestAmount,
          "Guarantee Amount": claimDetails.guaranteeAmount,
          "Guarantor Name": claimDetails.guarantorName,
          "Guarantor Address": claimDetails.guarantorAddress,
          "Creditor Address": claimDetails.creditorAddress,
          "Creditor Email": claimDetails.creditorEmail,
          "Principal Borrower Name": claimDetails.principalBorrowerName,
          "Principal Borrower Address": claimDetails.principalBorrowerAddress,
        },
        beneficiaryDetails: {
          "Beneficiary Name": claimDetails.beneficiaryName,
          "Beneficiary Address": claimDetails.beneficiaryAddress,
          "Corporate Debtor Security Amount": claimDetails.corporateDebtorSecurityAmount,
          "Corporate Debtor Guarantee Amount": claimDetails.corporateDebtorGuaranteeAmount,
        },
        addressproofDetails: {
          "Address Proof Type": claimDetails.document?.docType,
          "Address Proof Number": claimDetails.addressProofNumber,
          "Address Proof Document": formatFileInfo(claimDetails.document),
        },
        bankDetails: {
      
          "Account Number": claimDetails.bankAccountNumber,
          "IFSC Code": claimDetails.bankIfscCode,
          "Branch Name": claimDetails.bankBranchName,
        },
      },
      step3: {
        signatoryDetails: {
          "Signatory Name": signatoryDetails.name,
          "Signatory Position": signatoryDetails.position,
          "Signatory Address": signatoryDetails.address,
          "Signatory Document": formatFileInfo(signatoryDetails.document),
        },
      },
      status: application.applicationStatus,
    };
  };

  const handleOnViewRow = async (row) => {
    try {
      setIsLoading(true);
      
      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;
      
      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }
  
      const payload = {
        userInfo: userInfo,
        uuids: [row.uuid], // Use the uuid from the row
        applicationNumbers: [],
        claimantUUIDs: []
      };
  
      const URL =
        process.env.REACT_APP_APPLICATION_SERVICE +
        URLS_ENDPOINT.APP_SERVICES.APPLICATION_VIEW_ID;
  
      const response = await postData(URL, payload);
      
      if (response?.data?.status?.code === "200" && response?.data?.applicationDetails?.length > 0) {
        const transformedData = transformApplicationData(response.data.applicationDetails[0]);
        setModalData(transformedData);
        setIsViewModalOpen(true);
      } else {
        toast.error("No application details found", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching application details:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
    } finally {
      setIsLoading(false);
    }
  };
// const fetchDocumentList = async (data) => {
  //   if (data?.registrationBooksData?.[0]?.uuid) {
  //     try {
  //       const URL =
  //         process.env.REACT_APP_BASE_URL +
  //         URLS_ENDPOINT.APP_SERVICES.DOWNLOAD_DOC +
  //         data?.registrationBooksData?.[0]?.uuid;
  //       const response = await postData(URL, {});
  //       if (response?.data?.documentList?.length > 0) {
  //         setDocumentListData(response?.data?.documentList);
  //         handleDocumentModal();
  //       } else {
  //         toast.info(APP_MESSAGES.NO_DATA_MSG, { position: "top-right" });
  //       }
  //     } catch (error) {
  //       toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
  //     }
  //   } else {
  //     toast.info(APP_MESSAGES.NO_DATA_MSG, { position: "top-right" });
  //   }
  // };

  // const getDocumentFile = async (docInfo) => {
  //   if (docInfo?.registrationUuidFk) {
  //     try {
  //       const URL =
  //         process.env.REACT_APP_BASE_URL +
  //         URLS_ENDPOINT.APP_SERVICES.DOWNLOAD_DOC +
  //         docInfo?.registrationUuidFk +
  //         "&documentUuid=" +
  //         docInfo?.uuid;
  //       const response = await postData(URL, {});
  //       const base64String = response?.data?.documentList[0]?.documentBase64 || "";
  //       if (base64String) {
  //         openFileInNewTab(base64String);
  //       } else {
  //         toast.info(APP_MESSAGES.NO_DATA_MSG, { position: "top-right" });
  //       }
  //     } catch (error) {
  //       toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
  //     }
  //   } else {
  //     toast.info(APP_MESSAGES.NO_DATA_MSG, { position: "top-right" });
  //   }
  // };


  const fetchDashboardData = async () => {
    try {
      setIsLoading(true);
      
      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails
      
      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }

      const payload = {
        userInfo: userInfo,
        filterCriteria: {}
      };

      const URL =
          process.env.REACT_APP_APPLICATION_SERVICE +
          URLS_ENDPOINT.APP_SERVICES.DASHBOARD_LIST;

      const response = await postData(URL, payload);
      
      if (response?.data.status === "200" && response?.data.dashboardApplications?.length > 0) {
        // Format the data to match your table structure
        const formattedData = response.data.dashboardApplications.map((item, index) => ({
          ...item,
          id: item.uuid, 
          slNo: index + 1,
          claimNumber: item.applicationNumber,
          claimant: item.creditorName,
          status: item.applicationStatus,
          amount: `${item.totalClaimAmount}` || "0.00",
          dateSubmitted: item.submittedDate || new Date().toLocaleDateString(),
          action: ["view"],
          originalData: item, 
        }));
             
        if (userFormData?.userType === "CRP") {
          formattedData.forEach((item) => {
            item.claimNumber = (
              <a href={`/apply-claim/${item.id}`} style={{ color: "#269ccc", textDecoration: "underline" }}>
                {item.claimNumber}
              </a>
            );
          });
        }
        
        setRowData(formattedData);
      } else {
        setRowData([]);
        toast.info("No applications found", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching dashboard data:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setRowData([]);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchDashboardData();
  }, []);

  return (
    <div className="container-fluid mt-5" style={{ paddingLeft: 0, paddingRight: 0 }}>
      {!isLoading ? (
        <>
          <h3 className="mb-2 text-center">Claim Submission Service</h3>
          <br />
          <div className="row mb-3 align-items-center">
            <div className="col-12 col-md-4 d-flex justify-content-md-end justify-content-center gap-2 ms-auto">
              {/* Add buttons here if needed */}
            </div>
          </div>
          <ActionTable
            columns={columns}
            rowData={rowData}
            hideExportBtn={false}
            onViewRow={handleOnViewRow}
            handleEditRow={handleEditRow}
            onTrackRow={handleTrackRow}
           
          />

        {/* Tracking Modal */}
<Modal
  show={isTrackModalOpen}
  onHide={() => setIsTrackModalOpen(false)}
  dialogClassName="modal-1110w"
  aria-labelledby="tracking-modal-title"
>
  <Modal.Header closeButton>
    <Modal.Title id="tracking-modal-title">Tracking Details</Modal.Title>
  </Modal.Header>
  <Modal.Body>
    {trackData ? (
      <>
        <div className="mb-4 text-center">
          <h5 className="text-muted mb-2">Application Number</h5>
          <div
            style={{
              display: "inline-block",
              backgroundColor: "#e6f4ff",
              color: "#007bff",
              padding: "10px 20px",
              borderRadius: "30px",
              fontWeight: "600",
              fontSize: "1.2rem",
              border: "1px solid #b3daff",
            }}
          >
            {trackData.applicationNumber}
          </div>
        </div>

        <div className="timeline-container">
          {trackData.trackingSteps &&
            trackData.trackingSteps.map((step, index) => (
              <div key={index} className="timeline-step">
                <div className="timeline-icon">
                  {index === 0 ? (
                    <FaHourglassStart color="#0d6efd" />
                  ) : index === trackData.trackingSteps.length - 1 ? (
                    <FaCheckCircle color="green" />
                  ) : (
                    <FaClock color="#ffc107" />
                  )}
                </div>
                <div className="timeline-content">
                  {/* <h6 className="mb-1">{step.step}</h6> */}
                  <p className="mb-1 text-muted">{step.description}</p>
                  <small className="text-secondary">
                    <i className="fa fa-calendar"></i> {step.date}
                  </small>
                </div>
              </div>
            ))}
        </div>
      </>
    ) : (
      <p>No tracking data available.</p>
    )}
  </Modal.Body>
  <Modal.Footer>
    <Button variant="secondary" onClick={() => setIsTrackModalOpen(false)}>
      Close
    </Button>
  </Modal.Footer>
</Modal>

          <Modal
            show={isViewModalOpen}
            onHide={() => setIsViewModalOpen(false)}
            dialogClassName="modal-1110w"
            aria-labelledby="example-custom-modal-styling-title"
          >
            <Modal.Header closeButton>
              <Modal.Title id="example-custom-modal-styling-title">
                Application Details
              </Modal.Title>
            </Modal.Header>
            <Modal.Body>
              {modalData ? (
                <>
                <div className="d-flex justify-content-between align-items-center mb-3">
                    <h4 className="mb-0">Application Number:</h4>
                    <div
                      style={{
                        backgroundColor: "#f0f8ff", // Light blue background
                        color: "#4682b4", // Steel blue text
                        padding: "8px 15px",
                        borderRadius: "5px",
                        fontWeight: "bold",
                        fontSize: "1.1rem",
                        border: "1px solid #add8e6", // Light cyan border
                      }}
                    >
                      {modalData.applicationNumber || "N/A"}
                    </div>
                  </div>
                {/* <h4 className="mb-3">Application Number: {modalData.applicationNumber || "N/A"}</h4> */}
                  <Collapsible title="Creditor & Identification Details">
                    <div className="card mb-4 tiles_Size">
                      <div className="card-body">
                        <h5 style={{ fontWeight: 600 }}>Creditor Details</h5>
                        <br />
                        <Container fluid>
                          <Row className="g-3">
                            {modalData.step1?.creditorDetails && Object.entries(modalData.step1.creditorDetails).map(([key, value]) => (
                              <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                <PreviewCard title={key} value={value || "N/A"} />
                              </Col>
                            ))}
                          </Row>
                        </Container>
                      </div>
                    </div>
                    <div className="card mb-4 tiles_Size">
                      <div className="card-body">
                        <h5 style={{ fontWeight: 600 }}>Identification Details</h5>
                        <br />
                        <Container fluid>
                          <Row className="g-3">
                            {modalData.step1?.identificationDetails && Object.entries(modalData.step1.identificationDetails).map(([key, value]) => (
                              <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                <PreviewCard title={key} value={value || "N/A"} />
                              </Col>
                            ))}
                          </Row>
                        </Container>
                      </div>
                    </div>
                  </Collapsible>

                  <Collapsible title="Financial & Beneficiary Details">
                    <div className="card mb-4 tiles_Size">
                      <div className="card-body">
                        <h5 style={{ fontWeight: 600 }}>Financial Details</h5>
                        <br />
                        <Container fluid>
                          <Row className="g-3">
                            {modalData.step2?.financialDetails && Object.entries(modalData.step2.financialDetails).map(([key, value]) => (
                              <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                <PreviewCard title={key} value={value || "N/A"} />
                              </Col>
                            ))}
                          </Row>
                        </Container>
                      </div>
                    </div>
                    <div className="card mb-4 tiles_Size">
                      <div className="card-body">
                        <h5 style={{ fontWeight: 600 }}>Beneficiary Details</h5>
                        <br />
                        <Container fluid>
                          <Row className="g-3">
                            {modalData.step2?.beneficiaryDetails && Object.entries(modalData.step2.beneficiaryDetails).map(([key, value]) => (
                              <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                <PreviewCard title={key} value={value || "N/A"} />
                              </Col>
                            ))}
                          </Row>
                        </Container>
                      </div>
                    </div>
                    <div className="card mb-4 tiles_Size">
                      <div className="card-body">
                        <h5 style={{ fontWeight: 600 }}>Address Proof Details</h5>
                        <br />
                        <Container fluid>
                          <Row className="g-3">
                            {modalData.step2?.addressproofDetails && Object.entries(modalData.step2.addressproofDetails).map(([key, value]) => (
                              <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                <PreviewCard title={key} value={value || "N/A"} />
                              </Col>
                            ))}
                          </Row>
                        </Container>
                      </div>
                    </div>
                    <div className="card mb-4 tiles_Size">
                      <div className="card-body">
                        <h5 style={{ fontWeight: 600 }}>Bank Details</h5>
                        <br />
                        <Container fluid>
                          <Row className="g-3">
                            {modalData.step2?.bankDetails && Object.entries(modalData.step2.bankDetails).map(([key, value]) => (
                              <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                <PreviewCard title={key} value={value || "N/A"} />
                              </Col>
                            ))}
                          </Row>
                        </Container>
                      </div>
                    </div>
                  </Collapsible>

                  <Collapsible title="Signatory Details">
                    <div className="card mb-4 tiles_Size">
                      <div className="card-body">
                        <h5 style={{ fontWeight: 600 }}>Signatory Information</h5>
                        <br />
                        <Container fluid>
                          <Row className="g-3">
                            {modalData.step3?.signatoryDetails && Object.entries(modalData.step3.signatoryDetails).map(([key, value]) => (
                              <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                <PreviewCard title={key} value={value || "N/A"} />
                              </Col>
                            ))}
                          </Row>
                        </Container>
                      </div>
                    </div>
                  </Collapsible>

                  {/* <div className="card mb-4 tiles_Size">
                    <div className="card-body">
                      <h5 style={{ fontWeight: 600 }}>Application Status</h5>
                      <br />
                      <Container fluid>
                        <Row className="g-3">
                          <Col xs={12} sm={6} md={3} className="mb-3">
                            <PreviewCard 
                              title="Current Status" 
                              value={modalData.status || "N/A"} 
                              style={{ 
                                color: modalData.status === "Approved" ? "green" : 
                                      modalData.status === "Rejected" ? "red" : 
                                      "orange",
                                fontWeight: "bold"
                              }}
                            />
                          </Col>
                        </Row>
                      </Container>
                    </div>
                  </div> */}
                </>
              ) : (
                <p>No data available.</p>
              )}
            </Modal.Body>
            <Modal.Footer>
              <Button variant="secondary" onClick={() => setIsViewModalOpen(false)}>
                Close
              </Button>
            </Modal.Footer>
          </Modal>
          
          <FileUploadModal modal={isModalOpen} setModal={setIsModalOpen} />
        </>
      ) : (
        <div className="loader-container">
          <div className="loader"></div>
        </div>
      )}
    </div>
  );
};

export default DashboardMain;
