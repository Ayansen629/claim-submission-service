import React, { useState } from "react";
import { Row, Col, Table, Form, Button } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import Collapsible from "../../../../common/Collapsible.js";
import { FaFire, FaCog, FaCompass, FaUsers, FaShieldAlt, FaBolt, FaHome, FaPlus, FaTrash } from "react-icons/fa";
import { accomodationEquipmentTableData, conditionOptions, equipmentTableData, fireEquipmentTableData, initialEquipementData, lifeSavingEquipmentTableData, machineryTableData, navigationTableData } from "./constants/VesselEquipementConstant.js";
import InputText from "../../../../common/InputText.tsx";
import InputSelect from "../../../../common/InputSelect.tsx";
import InputFile from "../../../../common/InputFile.tsx";
import { sub } from "date-fns";
import { useFieldArray, useForm } from "react-hook-form";
import { useMasterData } from "../../../../context/MasterDataContext.js";


const VesselEquipmentForm = ({ formMethods, viewMode = false, editMode = false }) => {
  const { t } = useTranslation();
   const { masterData } = useMasterData();
   console.log("masterData-survey", masterData);


  const internalFormMethods = useForm({
    mode: "onTouched",
  });
  const methods = formMethods || internalFormMethods;

  const { register, watch, getValues, setValue, formState: { errors } } = methods;

  const [passengerDecks, setPassengerDecks] = useState([
    { deckType: "", size: "", function: "", maxPassengers: "", remarks: "" }
  ]);

  const { fields: deckFields, append: appendDeck, remove: removeDeck } = useFieldArray({
    control: formMethods.control,
    name: "deckSpaces"
  });

  const RenderEquipmentTable = ({ tableItems, title, icon, addVisible = false }) => {
    return (
      <Collapsible
        title={
          <>
            {icon}
            <span>{title}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem", overflowX: "auto" }}>
          <Table striped bordered hover responsive className="mb-0">
            <thead style={{ backgroundColor: "#f8f9fa" }}>
              <tr>
                {tableItems.headers.map((header, index) => (
                  <th key={tableItems.name + header.title} style={{ minWidth: header.minWidth, color: "#2466BF" }}>
                    {header.title}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {tableItems.items.map((item, index) => (
                <tr key={item?.title + item?.key}>
                  <td>{item.title}</td>
                  {item.subItems.map((subItem, subIndex) => {
                    const name = `${tableItems.name}.${item.key}.${subItem.item}`;
                    return <td key={item?.key + subItem?.item}>
                      {(subItem?.type === "text" || subItem?.type === "number") && (
                        <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>
                          <InputText
                            required={subItem?.required}
                            name={name}
                            type={subItem?.type}
                            placeholder={t(subItem?.placeholder)}
                            // value={watch(name)}
                            register={register(name, subItem?.register)}
                            errors={errors}
                            disabled={viewMode}
                          /> </div>
                      )}
                      {subItem?.type === "select" && (
                        <div>
                          <InputSelect
                            required={subItem?.required}
                            name={name}
                            options={subItem?.options}
                            value={watch(name)}
                            register={register(name, subItem?.register)}
                            onChange={(value) => {
                              setValue(name, value);
                            }}
                            errors={errors}
                            disabled={viewMode}
                          />
                        </div>
                      )}
                    </td>
                  })}
                </tr>
              ))}
            </tbody>
          </Table>
          {!viewMode && addVisible && (
            <Button
              variant="outline-primary"
              onClick={() => { }}
              className="mt-2"
            >
              <FaPlus className="me-2" /> Add
            </Button>
          )}
        </div>
      </Collapsible>
    );
  };

  return (
    <form autoComplete="off">
      {/* Fire Fighting Items */}
      <RenderEquipmentTable
        tableItems={fireEquipmentTableData}
        title="Fire Fighting Items"
        icon={<FaFire className="me-2" style={{ color: "#2466BF" }} />}
      />

      {/* Equipment */}
      <RenderEquipmentTable
        tableItems={equipmentTableData}
        title="Equipments"
        icon={<FaCog className="me-2" style={{ color: "#2466BF" }} />}
      />

      {/* Navigational Equipment */}
      <RenderEquipmentTable
        tableItems={navigationTableData}
        title="Navigational Equipment"
        icon={<FaCompass className="me-2" style={{ color: "#2466BF" }} />}
      />

      {/* Passenger Location */}
      <Collapsible
        title={
          <>
            <FaUsers className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Location of passengers on specific decks and spaces in maximum loaded condition")}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem", overflowX: "auto" }}>
          <Table striped bordered hover responsive className="mb-0">
            <thead style={{ backgroundColor: "#f8f9fa" }}>
              <tr>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Deck/Space Type")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Size")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Function")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF", minWidth: "200px" }}>{t("Max. No. of Passenger")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Remarks")}</th>
                {deckFields?.length > 1 && (
                  <th style={{ fontWeight: "600", color: "#2466BF", minWidth: "150px" }}>{t("Actions")}</th>
                )} 
              </tr>
            </thead>
            <tbody>
              {deckFields.map((deck, index) => (
                <tr key={index}>
                  <td>
                    <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>

                      <InputText
                        name={`deckSpaces.${index}.maxPassengersNo`}
                        type={"number"}
                        placeholder={t("Enter Max. No. of Passenger")}
                        // value={watch(name)}
                        register={register(`deckSpaces.${index}.maxPassengersNo`, {})}
                        errors={errors}
                        disabled={viewMode}
                      />
                    </div>
                  </td>
                  <td>
                    <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>

                      <InputText
                        name={`deckSpaces.${index}.size`}
                        placeholder={t("Enter Size")}
                        // value={watch(name)}
                        register={register(`deckSpaces.${index}.size`, {})}
                        errors={errors}
                        disabled={viewMode}
                      />
                    </div>
                  </td>
                  <td>
                    <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>

                      <InputText
                        name={`deckSpaces.${index}.function`}
                        placeholder={t("Enter Function")}
                        // value={watch(name)}
                        register={register(`deckSpaces.${index}.function`, {})}
                        errors={errors}
                        disabled={viewMode}
                      />
                    </div>
                  </td>
                  <td>
                    <InputSelect
                      name={`deckSpaces.${index}.condition`}
                      options={conditionOptions}
                      value={watch(`deckSpaces.${index}.condition`)}
                      register={register(`deckSpaces.${index}.condition`, {})}
                      onChange={(value) => {
                        setValue(`deckSpaces.${index}.condition`, value);
                      }}
                      errors={errors}
                      disabled={viewMode}
                    />
                  </td>
                  <td>
                    <div className="d-flex justify-content-center align-items-center mt-1" style={{ height: '100%' }}>

                      <InputText
                        name={`deckSpaces.${index}.remarks`}
                        placeholder={t("Enter Remarks")}
                        // value={watch(name)}
                        register={register(`deckSpaces.${index}.remarks`, {})}
                        errors={errors}
                        disabled={viewMode}
                      />
                    </div>
                  </td>
                  {index !== 0 && (
                    <td className="text-center align-middle">
                      <td>
                        <div className="d-flex justify-content-center align-items-center ms-2 mb-2" style={{ height: '100%' }}>
                          <Button
                            variant="outline-danger"
                            onClick={() => removeDeck(index)}
                          >
                            <FaTrash className="me-2" /> Remove
                          </Button>
                        </div>
                      </td>

                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </Table>
          {!viewMode && (
            <Button
              variant="outline-primary"
              onClick={() => appendDeck(initialEquipementData?.deckSpaces?.[0])}
              className="mt-2"
            >
              <FaPlus className="me-2" /> Add
            </Button>
          )}
        </div>
      </Collapsible>

      {/* Freeboard */}
      <Collapsible
        title={
          <>
            <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Freeboard")}</span>
          </>
        }
        openStat={true}
      >
        <div style={{ padding: "1rem", overflowX: "auto" }}>
          <Table striped bordered hover responsive className="mb-0">
            <thead style={{ backgroundColor: "#f8f9fa" }}>
              <tr>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Minimum freeboard")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Number of Passengers")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Cargo (Tonne)")}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <InputText
                    name={'freeboard.minFreeboard'}
                    placeholder={t('Enter Minimum Freeboard')}
                    register={register('freeboard.minFreeboard', {})}
                    errors={errors}
                    disabled={viewMode}
                  />
                </td>
                <td>
                  <InputText
                    name={'freeboard.numPassengers'}
                    type={"number"}
                    placeholder={t('Enter Number of Passengers')}
                    register={register('freeboard.numPassengers', {})}
                    errors={errors}
                    disabled={viewMode}
                  />
                </td>
                <td>
                  <InputText
                    name={'freeboard.cargo'}
                    placeholder={t('Enter Cargo (Tonne)')}
                    register={register('freeboard.cargo', {})}
                    errors={errors}
                    disabled={viewMode}
                  />
                </td>
              </tr>
            </tbody>
          </Table>
        </div>
      </Collapsible>

      {/* Life-Saving Equipment */}
      <RenderEquipmentTable
        tableItems={lifeSavingEquipmentTableData}
        title="Life-Saving Equipment"
        icon={<FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />}
      />

      {/* Machinery/Electrical */}
      <RenderEquipmentTable
        tableItems={machineryTableData}
        title="Machinery/Electrical"
        icon={<FaBolt className="me-2" style={{ color: "#2466BF" }} />}
      />

      {/* Accommodation/Safety */}
      <RenderEquipmentTable
        tableItems={accomodationEquipmentTableData}
        title="Accommodation/Safety"
        icon={<FaHome className="me-2" style={{ color: "#2466BF" }} />}
        addVisible={false}
      />
    </form>
  );
};

export default VesselEquipmentForm
