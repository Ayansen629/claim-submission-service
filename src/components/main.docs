import React, { useCallback, useEffect, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepFirst.css";
import 'bootstrap/dist/css/bootstrap.min.css';
import { FaPlus, FaTimes, FaDownload, FaBuilding, FaUser, FaHome, FaIdCard } from "react-icons/fa";

const StepFirst = ({ provideSubmitHandler, formData, onValidationComplete, onNext }) => {
  const [uploadError, setUploadError] = useState(null);
  const [incorporatedRecords, setIncorporatedRecords] = useState([
    { id: 1, details: "", proof: null }
  ]);
  const [partnershipRecords, setPartnershipRecords] = useState([
    { id: 1, details: "", proof: null }
  ]);
  const [uploadingRecordId, setUploadingRecordId] = useState(null);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [userFormData, setUserFormData] = useState(null);
  // Load user data from localStorage
useEffect(() => {
  const storedData = localStorage.getItem('userFormData');
  if (storedData) {
    const parsedData = JSON.parse(storedData);
    setUserFormData(parsedData);
  }
}, []);

const methods = useForm({
  mode: "onChange",
  reValidateMode: "onChange",
  defaultValues: {
    corporateDebtorName: userFormData?.corporateDebtorName || "",
    identificationType: "INCORPORATED",
    financialCreditorName: userFormData?.userDetails?.claimantName || "",
    financialCreditorEmail: userFormData?.userDetails?.emailId || "",
    addressLine1: "",
    addressLine2: "",
    city: "",
    state: "",
    pincode: "",
    identificationtype_details: [{ id: 1, details: "", proof: null }]
  }
});
  // const methods = useForm({
  //   mode: "onChange",
  //   reValidateMode: "onChange",
  //   defaultValues: {
  //     corporateDebtorName: "",
  //     identificationType: "INCORPORATED",
  //     financialCreditorName: "",
  //     financialCreditorEmail: "",
  //     addressLine1: "",
  //     addressLine2: "",
  //     city: "",
  //     state: "",
  //     pincode: "",
  //     identificationtype_details: [{ id: 1, details: "", proof: null }]
  //   }
  // });

  const {
    register,
    handleSubmit,
    formState: { errors, isValid },
    trigger,
    setValue,
    control,
    getValues,
    watch,
    resetField
  } = methods;

   // Set initial values when userFormData is loaded
   useEffect(() => {
    if (userFormData) {
      setValue('corporateDebtorName', userFormData.corporateDebtorName);
      setValue('financialCreditorName', userFormData.userDetails.claimantName);
      setValue('financialCreditorEmail', userFormData.userDetails.emailId);
    }
  }, [userFormData, setValue]);

  const watchIdentificationType = watch("identificationType", "INCORPORATED");


  // Initialize form data
  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        setValue(key, formData[key]);
      });

      if (formData.identificationtype_details && formData.identificationtype_details.length > 0) {
        if (formData.identificationType === "INCORPORATED") {
          setIncorporatedRecords(formData.identificationtype_details);
        } else {
          setPartnershipRecords(formData.identificationtype_details);
        }
        setValue("identificationtype_details", formData.identificationtype_details);
      }
    }
  }, [formData, setValue]);

  // Update identificationtype_details value when records change
  useEffect(() => {
    if (watchIdentificationType === "INCORPORATED") {
      setValue("identificationtype_details", incorporatedRecords);
    } else {
      setValue("identificationtype_details", partnershipRecords);
    }
  }, [incorporatedRecords, partnershipRecords, watchIdentificationType, setValue]);

  const handleFileUpload = async (file, recordId) => {
    try {
      setUploadingRecordId(recordId);
      setUploadError(null);
      const result = await uploadDocument(file, 'identification');
      return {
        fileId: result.fileId,
        fileName: file.name,
        fileType: file.type
      };
    } catch (error) {
      setUploadError(error.message || "Upload failed");
      throw error;
    } finally {
      setUploadingRecordId(null);
    }
  };

  const addIdentificationRecord = () => {
    const records = watchIdentificationType === "INCORPORATED" ? incorporatedRecords : partnershipRecords;
    const setRecords = watchIdentificationType === "INCORPORATED" ? setIncorporatedRecords : setPartnershipRecords;
    
    const newId = records.length > 0
      ? Math.max(...records.map(r => r.id)) + 1
      : 1;
    const newRecord = { id: newId, details: "", proof: null };
    const updatedRecords = [...records, newRecord];
    setRecords(updatedRecords);
  };

  const removeIdentificationRecord = (id) => {
    const records = watchIdentificationType === "INCORPORATED" ? incorporatedRecords : partnershipRecords;
    const setRecords = watchIdentificationType === "INCORPORATED" ? setIncorporatedRecords : setPartnershipRecords;
    
    if (records.length > 1) {
      const updatedRecords = records.filter(r => r.id !== id);
      setRecords(updatedRecords);
    }
  };

  const updateRecordDetails = (id, value) => {
    const records = watchIdentificationType === "INCORPORATED" ? incorporatedRecords : partnershipRecords;
    const setRecords = watchIdentificationType === "INCORPORATED" ? setIncorporatedRecords : setPartnershipRecords;
    
    const updatedRecords = records.map(record =>
      record.id === id ? { ...record, details: value } : record
    );
    setRecords(updatedRecords);
  };

  const updateRecordProof = async (e, id) => {
    const file = e.target.files[0];
    if (!file) return;
    try {
      const doc = await handleFileUpload(file, id);
      
      const records = watchIdentificationType === "INCORPORATED" ? incorporatedRecords : partnershipRecords;
      const setRecords = watchIdentificationType === "INCORPORATED" ? setIncorporatedRecords : setPartnershipRecords;
      
      const updatedRecords = records.map(record =>
        record.id === id ? { ...record, proof: doc } : record
      );
      setRecords(updatedRecords);
    } catch (err) {
      console.error("Upload failed:", err);
    }
  };

  const handleRemoveProof = (id) => {
    const records = watchIdentificationType === "INCORPORATED" ? incorporatedRecords : partnershipRecords;
    const setRecords = watchIdentificationType === "INCORPORATED" ? setIncorporatedRecords : setPartnershipRecords;
    
    const updatedRecords = records.map(record =>
      record.id === id ? { ...record, proof: null } : record
    );
    setRecords(updatedRecords);
  };

  const corporateDebtorSchema = [
    {
      name: "corporateDebtorName",
      label: <>Corporate Debtor Name <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Corporate debtor name is required" },
      icon: <FaBuilding className="me-2" />,
      placeholder: "Enter corporate debtor name",
      disabled:true

    }
  ];

  const basicDetailsSchema = [
    {
      name: "financialCreditorName",
      label: <>Name of the financial creditor <span className="required-asterisk">*</span></>,
      type: "text",
      rules: { required: "Financial creditor name is required" },
      icon: <FaUser className="me-2" />,
      placeholder: "Enter financial creditor name",
      disabled:true


    },
    {
      name: "financialCreditorEmail",
      label: <>Email address of the financial creditor <span className="required-asterisk">*</span></>,
      type: "email",
      rules: {
        required: "Email is required",
        pattern: {
          value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
          message: "Invalid email address"
        }
      },
      icon: <FaUser className="me-2" />,
      placeholder: "Enter financial creditor email",
      disabled:true
    },
    {
      name: "identificationType",
      label: <>Identification type <span className="required-asterisk">*</span></>,
      type: "radio",
      options: [
        { value: "INCORPORATED", label: "Incorporated body" },
        { value: "INDIVIDUAL_PARTNERSHIP", label: "Partnership or individual" }
      ],
      rules: { required: "Select an identification type" },
      icon: <FaIdCard className="me-2" />,
      inline : true
    }
  ];

  const addressDetailsSchema = [
    { 
      name: "addressLine1", 
      label: <>Address line 1 <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "Address line 1 is required" },
      icon: <FaHome className="me-2" />,
      placeholder: "Enter address line 1"
    },
    { 
      name: "addressLine2", 
      label: "Address line 2", 
      type: "text",
      icon: <FaHome className="me-2" />,
      placeholder: "Enter address line 2"
    },
    { 
      name: "city", 
      label: <>City <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "City is required" },
      icon: <FaHome className="me-2" />,
      placeholder: "Enter city name"
    },
    { 
      name: "state", 
      label: <>State <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "State is required" },
      icon: <FaHome className="me-2" />,
      placeholder: "Enter state name"
    },
    { 
      name: "pincode", 
      label: <>Pincode <span className="required-asterisk">*</span></>, 
      type: "text", 
      rules: { required: "Pincode is required" },
      icon: <FaHome className="me-2" />,
       placeholder: "Enter pincode number"
    }
  ];
// Add a useEffect to watch for identificationType changes and clear the other type's data
useEffect(() => {
  const subscription = watch((value, { name }) => {
    if (name === "identificationType") {
      if (value.identificationType === "INCORPORATED") {
        // Clear partnership records when switching to incorporated
        setPartnershipRecords([{ id: 1, details: "", proof: null }]);
      } else {
        // Clear incorporated records when switching to partnership
        setIncorporatedRecords([{ id: 1, details: "", proof: null }]);
      }
    }
  });
  return () => subscription.unsubscribe();
}, [watch]);
  const onSubmit = useCallback(async () => {
    setIsSubmitting(true);
    try {
      const isValid = await trigger();
      if (!isValid) {
        console.error("Validation failed");
        return false;
      }
      
      const formValues = getValues();
      if (onNext) {
        onNext(formValues);
      }
      return formValues;
    } finally {
      setIsSubmitting(false);
    }
  }, [trigger, getValues, onNext]);

  useEffect(() => {
    if (onValidationComplete) {
      onValidationComplete(isValid);
    }
  }, [isValid, onValidationComplete]);

  useEffect(() => {
    if (provideSubmitHandler) {
      provideSubmitHandler(onSubmit);
    }
  }, [provideSubmitHandler, onSubmit]);

  const currentRecords = watchIdentificationType === "INCORPORATED" ? incorporatedRecords : partnershipRecords;

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        <div className="mb-4 bg-white p-4 rounded-3 shadow-sm">
          {/* Corporate Debtor Section */}
          <Collapsible 
            title={
              <div className="d-flex align-items-center">
                <FaBuilding className="me-2" />
                Corporate Debtor Details
              </div>
            } 
            defaultOpen
            iconColor="#269ccc"
          >
            <div className="container-fluid">
              <div className="row g-3">
                {corporateDebtorSchema.map((f) => (
                  <div key={f.name} className="col-md-6">
                    <DynamicField
                      fieldConfig={f}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      trigger={trigger}
                      getValues={getValues}
                    />
                  </div>
                ))}
              </div>
            </div>
          </Collapsible>
        </div>

        <div className="mb-4 bg-white p-4 rounded-3 shadow-sm">
          <Collapsible 
            title={
              <div className="d-flex align-items-center">
                <FaUser className="me-2" />
                Financial Creditor Details
              </div>
            } 
            defaultOpen
            iconColor="#269ccc"
          >
            <div className="container-fluid">
              <div className="row g-3">
                {basicDetailsSchema.map((f) => (
                  <div key={f.name} className="col-md-6">
                    <DynamicField
                      fieldConfig={f}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      trigger={trigger}
                      getValues={getValues}
                    />
                  </div>
                ))}
              </div>

              <div className="mt-4">
                <h5 className="d-flex align-items-center">
                  <FaIdCard className="me-2" />
                  {watchIdentificationType === "INCORPORATED"
                    ? "Incorporation Details"
                    : "Partnership or Individual Records"}
                </h5>
                {currentRecords.map((record, index) => (
                  <div key={record.id} className="mb-4 p-3 border rounded bg-light">
                    {watchIdentificationType === "INDIVIDUAL_PARTNERSHIP" && (
                      <div className="d-flex justify-content-between align-items-center mb-3">
                        <h6 className="mb-0">Record {index + 1}</h6>
                        {currentRecords.length > 1 && (
                          <button
                            type="button"
                            className="btn btn-sm btn-danger"
                            onClick={() => removeIdentificationRecord(record.id)}
                            disabled={uploadingRecordId !== null || isSubmitting}
                          >
                            <FaTimes className="me-1" /> Remove
                          </button>
                        )}
                      </div>
                    )}
                    <div className="row g-3">
                      <div className="col-6">
                        <label className="form-label">
                          <FaIdCard className="me-2" />
                          {watchIdentificationType === "INCORPORATED"
                            ? "Identification Number"
                            : "Identification Records"} <span className="required-asterisk">*</span>
                        </label>
                        <input
                          type="text"
                          className={`form-control ${errors.identificationtype_details?.[index]?.details ? 'is-invalid' : ''}`}
                          value={record.details}
                          onChange={(e) => updateRecordDetails(record.id, e.target.value)}
                          placeholder={
                            watchIdentificationType === "INCORPORATED"
                              ? "Enter Identification number"
                              : "Enter identification records"
                          }
                          disabled={uploadingRecordId !== null || isSubmitting}
                        />
                        {errors.identificationtype_details?.[index]?.details && (
                          <div className="invalid-feedback d-block">
                            {errors.identificationtype_details[index].details.message}
                          </div>
                        )}
                      </div>
                      <div className="col-6">
                        <label className="form-label">
                          <FaDownload className="me-2" />
                          {watchIdentificationType === "INCORPORATED"
                            ? "Proof of Identification"
                            : "Proof of Identification"} <span className="required-asterisk">*</span>
                        </label>
                        {record.proof ? (
                          <div className="d-flex align-items-center mt-2">
                            <span className="me-2">{record.proof.fileName}</span>
                            <a
                              href={`${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${record.proof.fileId}`}
                              target="_blank"
                              rel="noopener noreferrer"
                              className="btn btn-sm btn-outline-primary me-2"
                            >
                              <FaDownload className="me-1" /> Download
                            </a>
                            <button
                              type="button"
                              className="btn btn-sm btn-outline-danger"
                              onClick={() => handleRemoveProof(record.id)}
                              disabled={uploadingRecordId !== null || isSubmitting}
                            >
                              <FaTimes className="me-1" /> Remove
                            </button>
                          </div>
                        ) : null}
                        <input
                          type="file"
                          id={`proof_${record.id}`}
                          onChange={(e) => updateRecordProof(e, record.id)}
                          className="d-none"
                          disabled={uploadingRecordId !== null || isSubmitting}
                        />
                        <label htmlFor={`proof_${record.id}`} className="btn btn-outline-primary w-100 mt-2">
                          {uploadingRecordId === record.id ? (
                            <>
                              <span className="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                              Uploading...
                            </>
                          ) : (
                            <>
                              <FaDownload className="me-2" />
                              Choose File
                            </>
                          )}
                        </label>
                        {errors.identificationtype_details?.[index]?.proof && (
                          <div className="invalid-feedback d-block">
                            {errors.identificationtype_details[index].proof.message}
                          </div>
                        )}
                        <small className="form-text text-muted mt-1">Max file size: 5MB (PDF, JPEG, PNG)</small>
                      </div>
                    </div>
                  </div>
                ))}
                {watchIdentificationType === "INDIVIDUAL_PARTNERSHIP" && (
                  <button
                    type="button"
                    className="btn btn-outline-primary mt-2"
                    onClick={addIdentificationRecord}
                    disabled={uploadingRecordId !== null || isSubmitting}
                  >
                    <FaPlus className="me-2" /> Add Another Identification Record
                  </button>
                )}
              </div>
            </div>
          </Collapsible>
        </div>

        {/* Address Section */}
        <div className="mb-4 bg-white p-4 rounded-3 shadow-sm">
          <Collapsible 
            title={
              <div className="d-flex align-items-center">
                <FaHome className="me-2" />
                Address Details
              </div>
            } 
            defaultOpen
            iconColor="#269ccc"
          >
            <div className="container-fluid">
              <div className="row g-3">
                {addressDetailsSchema.map((f) => (
                  <div key={f.name} className="col-md-6">
                    <DynamicField
                      fieldConfig={f}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      trigger={trigger}
                      getValues={getValues}
                      disabled={uploadingRecordId !== null || isSubmitting}
                    />
                  </div>
                ))}
              </div>
            </div>
          </Collapsible>
        </div>
      </form>
    </FormProvider>
  );
};

export default StepFirst;

/* Flex container setup to wrap items */
.flex-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  padding: 20px;
  max-width: 1200px;
  margin: 0 auto;
  align-items: flex-start;
  justify-content: flex-start;
}

/* Standard Flex item */
.flex-item {
  flex: 1 1 calc(50% - 20px);
  box-sizing: border-box;
  padding: 20px;
  text-align: left;
  min-width: 250px;
  max-width: calc(50% - 20px);
  display: flex;
  flex-direction: column;
}

/* Consistent width for input fields */
.form-input {
  width: 100%;
  padding: 12px;
  margin-top: 8px;
  font-size: 14px;
  border: 1px solid #ddd;
  border-radius: 4px;
  box-sizing: border-box;
  height: 40px;
  background-color: #fff;
}

/* Error styling for inputs */
.form-input.input-error {
  border-color: red ;
}

/* Error message text */
.error-message {
  color: red;
  font-size: 12px;
  margin-top: 5px;
}

/* Custom Checkbox Styling */
.custom-checkbox {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.custom-checkbox input[type="checkbox"] {
  margin-right: 10px;
  width: 18px;
  height: 18px;
  cursor: pointer;
}

.custom-checkbox label {
  font-size: 14px;
  font-weight: normal;
  cursor: pointer;
}

/* Custom File Input Styling */
.custom-file-input {
  position: relative;
  overflow: hidden;
  display: inline-block;
  width: 100%;
  margin-top: 8px;
}

.custom-file-input input[type="file"] {
  position: absolute;
  left: 0;
  top: 0;
  opacity: 0;
  cursor: pointer;
  width: 100%;
  height: 100%;
}

.custom-file-input .file-label {
  display: block;
  padding: 10px;
  background-color: #f9f9f9;
  border: 1px solid #ddd;
  border-radius: 4px;
  text-align: center;
  font-size: 14px;
  color: #333;
  cursor: pointer;
}

.custom-file-input .file-label:hover {
  background-color: #e9e9e9;
}

/* Identification Proof Container */
.identification-proof-container {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.file-upload-section {
  display: flex;
  flex-direction: column;
  gap: 8px;
}


.tooltip {
  position: relative;
  display: inline-block;
  margin-left: 5px;
  cursor: pointer;
}

.tooltip .tooltiptext {
  visibility: hidden;
  width: 200px;
  background-color: #555;
  color: #fff;
  text-align: center;
  border-radius: 6px;
  padding: 5px;
  position: absolute;
  z-index: 1;
  bottom: 125%;
  left: 50%;
  margin-left: -100px;
  opacity: 0;
  transition: opacity 0.3s;
}

.tooltip:hover .tooltiptext {
  visibility: visible;
  opacity: 1;
}



.required-asterisk {
  color: red;
  font-size: 14px;
  margin-left: 4px;
}

.error-message {
  color: red;
  font-size: 12px;
  margin-top: 5px;
}

/* Add these styles to your existing StepFirst.css */

.file-upload-status {
  transition: all 0.3s ease;
  border: 1px solid #dee2e6 !important;
}

.file-upload-status:hover {
  background-color: #f8f9fa !important;
}

.btn-outline-primary {
  border-color: #269ccc;
  color: #269ccc;
}

.btn-outline-primary:hover {
  background-color: #269ccc;
  color: white;
}

.required-asterisk {
  color: #dc3545;
  font-weight: bold;
}

/* Add some spacing between form elements */
.flex-container > * {
  margin-bottom: 1.5rem;
}

/* Style for upload progress/status */
.upload-status {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.5rem;
  font-size: 0.875rem;
}

.upload-status.success {
  color: #198754;
}

.upload-status.error {
  color: #dc3545;
}
.file-upload-note{
  font-size: 0.8rem;
  color: #6c757d;
  margin-top: 0.5rem;

}
.upload-progress{
  color: #17a2b8;
  font-size: 0.9rem;
  margin-top: 0.25rem;
}

import React from "react";
import { useFormContext, Controller } from "react-hook-form";
import { Form, Row, Col, Card, Button, Spinner, Alert, Badge } from "react-bootstrap";
import { FaDownload, FaTrash, FaFilePdf, FaFileImage } from "react-icons/fa";
import "./DocumentsUpload.css";
import 'bootstrap/dist/css/bootstrap.min.css';

const DocumentsUpload = ({
    isUploadingIdentity, 
    isUploadingAddress,
    uploadError, 
    setIsUploadingIdentity, 
    setIsUploadingAddress,
    setUploadError, 
    onFileUpload  
}) => {
    const { control, watch, setValue, formState: { errors } } = useFormContext();
    const [uploadSuccess, setUploadSuccess] = React.useState(false);

    const identityProofOptions = [
        { value: "aadhaar", label: "Aadhaar Card" },
        { value: "pan", label: "PAN Card" },
        { value: "voter_id", label: "Voter ID" },
        { value: "passport", label: "Passport" },
        { value: "driving_license", label: "Driving License" }
    ];

    const addressProofOptions = [
        { value: "aadhaar", label: "Aadhaar Card" },
        { value: "voter_id", label: "Voter ID" },
        { value: "passport", label: "Passport" },
        { value: "driving_license", label: "Driving License" },
        { value: "utility_bill", label: "Utility Bill" },
        { value: "rent_agreement", label: "Rent Agreement" }
    ];

    const watchedFields = watch(["identityProofType", "identityProofFile", "addressProofType", "addressProofFile"]);

    const handleFileUpload = async (file, fieldName) => {
        try {
            // Set the correct uploading state based on fieldName
            if (fieldName === "identityProofFile") {
                setIsUploadingIdentity(true);
            } else {
                setIsUploadingAddress(true);
            }
            
            setUploadError(null);
            setUploadSuccess(false);
            const result = await onFileUpload(file);
            setValue(fieldName, {
                fileId: result.fileId,
                fileName: file.name,
                fileType: file.type
            });
            setUploadSuccess(true);
            return result;
        } catch (error) {
            setUploadError(error.message);
            throw error;
        } finally {
            // Reset the correct uploading state based on fieldName
            if (fieldName === "identityProofFile") {
                setIsUploadingIdentity(false);
            } else {
                setIsUploadingAddress(false);
            }
        }
    };

    const handleFileChange = async (e, fieldName) => {
        const file = e.target.files[0];
        if (!file) return;

        const fileSizeInMB = file.size / (1024 * 1024);
        const maxSize = 5;
        const allowedTypes = ["image/jpeg", "image/png", "application/pdf"];

        if (fileSizeInMB > maxSize) {
            setUploadError(`File size must be ≤ ${maxSize}MB`);
            return;
        }

        if (!allowedTypes.includes(file.type)) {
            setUploadError(`Invalid file type. Allowed: ${allowedTypes.join(', ')}`);
            return;
        }

        try {
            await handleFileUpload(file, fieldName);
        } catch (error) {
            console.error("Upload failed:", error);
        }
    };

    const removeFile = (fieldName) => {
        setValue(fieldName, null);
        setUploadSuccess(false);
    };

    const getFileIcon = (fileType) => {
        if (fileType === 'application/pdf') return <FaFilePdf className="text-danger me-2 fs-4" />;
        if (fileType.includes('image/')) return <FaFileImage className="text-secondary me-2 fs-4" />;
        return <FaFileImage className="text-secondary me-2 fs-4" />;
    };

    const renderFilePreview = (fileValue, type) => {
        if (!fileValue) return null;

        const fileUrl = typeof fileValue === 'object' ? 
            `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileValue.fileId}` : 
            fileValue;

        const fileName = typeof fileValue === 'object' ? 
            fileValue.fileName || 'Uploaded file' : 
            fileValue.split('/').pop() || 'Uploaded file';

        return (
            <div className="file-preview-container bg-light p-3 rounded mb-3">
                {uploadSuccess && (
                    <div className="text-success d-flex align-items-center gap-2 mb-2">
                        <span>File uploaded successfully!</span>
                    </div>
                )}
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        {getFileIcon(typeof fileValue === 'object' ? fileValue.fileType : '')}
                        <div>
                            <div className="fw-bold text-truncate" style={{ maxWidth: '200px' }}>{fileName}</div>
                            <small className="text-muted">
                                <Badge bg={type === 'identity' ? "info" : "primary"}>
                                    {type === 'identity' ? "Identity Proof" : "Address Proof"}
                                </Badge>
                            </small>
                        </div>
                    </div>
                    <div className="d-flex gap-2">
                        <Button
                            variant="outline-primary"
                            size="sm"
                            href={fileUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            download
                            title="Download file"
                        >
                            <FaDownload />
                        </Button>
                        <Button
                            variant="outline-danger"
                            size="sm"
                            onClick={() => removeFile(type === 'identity' ? 'identityProofFile' : 'addressProofFile')}
                            title="Remove file"
                        >
                            <FaTrash />
                        </Button>
                    </div>
                </div>
            </div>
        );
    };

    return (
        <Card className="mb-4 document-upload-card shadow-sm">
            <Card.Body>
                <Row className="mb-4 g-3">
                    <Col md={6}>
                        <Form.Group controlId="identityProofType">
                            <Form.Label>Identity Proof Type <span className="text-danger">*</span></Form.Label>
                            <Controller
                                name="identityProofType"
                                control={control}
                                rules={{ required: "Identity proof type is required" }}
                                render={({ field }) => (
                                    <Form.Select 
                                        {...field} 
                                        isInvalid={!!errors.identityProofType}
                                        onChange={(e) => {
                                            field.onChange(e);
                                            setValue("identityProofFile", null);
                                        }}
                                    >
                                        <option value="">Select identity proof</option>
                                        {identityProofOptions.map((type) => (
                                            <option key={type.value} value={type.value}>
                                                {type.label}
                                            </option>
                                        ))}
                                    </Form.Select>
                                )}
                            />
                            {errors.identityProofType && (
                                <Form.Control.Feedback type="invalid" className="d-block">
                                    {errors.identityProofType.message}
                                </Form.Control.Feedback>
                            )}
                        </Form.Group>
                    </Col>

                    {watchedFields[0] && (
                        <Col md={6}>
                            <Form.Group controlId="identityProofFile">
                                <Form.Label>
                                    Upload Identity Proof <span className="text-danger">*</span>
                                </Form.Label>
                                {watchedFields[1] ? (
                                    renderFilePreview(watchedFields[1], 'identity')
                                ) : (
                                    <div className="file-upload-container border rounded p-3">
                                        <input
                                            type="file"
                                            id="identityProofFile"
                                            accept=".pdf,.jpg,.jpeg,.png"
                                            onChange={(e) => handleFileChange(e, "identityProofFile")}
                                            className="d-none"
                                            disabled={isUploadingIdentity}
                                        />
                                        <label htmlFor="identityProofFile" className="btn btn-outline-primary w-100">
                                            {isUploadingIdentity ? (
                                                <>
                                                    <Spinner animation="border" size="sm" className="me-2" />
                                                    Uploading...
                                                </>
                                            ) : (
                                                "Choose File"
                                            )}
                                        </label>
                                        <div className="small text-muted mt-2">
                                            Accepted formats: PDF, JPG, PNG (Max 5MB)
                                        </div>
                                    </div>
                                )}
                                {errors.identityProofFile && (
                                    <Form.Control.Feedback type="invalid" className="d-block">
                                        {errors.identityProofFile.message}
                                    </Form.Control.Feedback>
                                )}
                                {uploadError && !watchedFields[1] && (
                                    <Alert variant="danger" className="mt-2 small p-2">
                                        {uploadError}
                                    </Alert>
                                )}
                            </Form.Group>
                        </Col>
                    )}
                </Row>

                <Row className="g-3">
                    <Col md={6}>
                        <Form.Group controlId="addressProofType">
                            <Form.Label>Address Proof Type <span className="text-danger">*</span></Form.Label>
                            <Controller
                                name="addressProofType"
                                control={control}
                                rules={{ required: "Address proof type is required" }}
                                render={({ field }) => (
                                    <Form.Select 
                                        {...field} 
                                        isInvalid={!!errors.addressProofType}
                                        onChange={(e) => {
                                            field.onChange(e);
                                            setValue("addressProofFile", null);
                                        }}
                                    >
                                        <option value="">Select address proof</option>
                                        {addressProofOptions.map((type) => (
                                            <option key={type.value} value={type.value}>
                                                {type.label}
                                            </option>
                                        ))}
                                    </Form.Select>
                                )}
                            />
                            {errors.addressProofType && (
                                <Form.Control.Feedback type="invalid" className="d-block">
                                    {errors.addressProofType.message}
                                </Form.Control.Feedback>
                            )}
                        </Form.Group>
                    </Col>

                    {watchedFields[2] && (
                        <Col md={6}>
                            <Form.Group controlId="addressProofFile">
                                <Form.Label>
                                    Upload Address Proof <span className="text-danger">*</span>
                                </Form.Label>
                                {watchedFields[3] ? (
                                    renderFilePreview(watchedFields[3], 'address')
                                ) : (
                                    <div className="file-upload-container border rounded p-3">
                                        <input
                                            type="file"
                                            id="addressProofFile"
                                            accept=".pdf,.jpg,.jpeg,.png"
                                            onChange={(e) => handleFileChange(e, "addressProofFile")}
                                            className="d-none"
                                            disabled={isUploadingAddress}
                                        />
                                        <label htmlFor="addressProofFile" className="btn btn-outline-primary w-100">
                                            {isUploadingAddress ? (
                                                <>
                                                    <Spinner animation="border" size="sm" className="me-2" />
                                                    Uploading...
                                                </>
                                            ) : (
                                                "Choose File"
                                            )}
                                        </label>
                                        <div className="small text-muted mt-2">
                                            Accepted formats: PDF, JPG, PNG (Max 5MB)
                                        </div>
                                    </div>
                                )}
                                {errors.addressProofFile && (
                                    <Form.Control.Feedback type="invalid" className="d-block">
                                        {errors.addressProofFile.message}
                                    </Form.Control.Feedback>
                                )}
                                {uploadError && !watchedFields[3] && (
                                    <Alert variant="danger" className="mt-2 small p-2">
                                        {uploadError}
                                    </Alert>
                                )}
                            </Form.Group>
                        </Col>
                    )}
                </Row>
            </Card.Body>
        </Card>
    );
};

export default DocumentsUpload;


