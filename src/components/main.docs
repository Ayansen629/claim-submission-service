<Card.Body>
  <div className="row g-3">
    {getStatData().map((item, index) => (
      <div 
        className={item.isCalendar ? "col-md-8 col-lg-6 col-sm-12" : "col-md-4 col-lg-3 col-sm-12"} 
        key={index}
      >
        {item.isCalendar ? (
          <SurveyTrackerCard events={item.events} color={item.color || "#6f42c1"} />
        ) : (
          <StatusCard {...item} />
        )}
      </div>
    ))}
  </div>
</Card.Body>
