

import { useEffect } from "react";
import { Form, useFieldArray, useFormContext } from "react-hook-form";
import { Card, Row, Col, Button } from "react-bootstrap";
import InputSelect from "../../../common/InputSelect.tsx";
import InputText from "../../../common/InputText.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { FaPlus, FaTrash, FaUser, FaMapMarkerAlt, FaGraduationCap, FaBriefcase, FaFileUpload } from "react-icons/fa";
import { CONSTANT_REGEX } from "../../../../utils/constants.ts";
import { useMasterData } from "../../../context/MasterDataContext.js";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import { getData } from "../../../../services/http.service.ts";

const EmployeeRegistrationForm = ({ onSubmit, onCancel }) => {
  const { control, register, setValue, watch, handleSubmit, formState: { errors } } = useFormContext();
  const { fields, append, remove } = useFieldArray({
    control,
    name: "educationDetails"
  });

  const watchPin = watch("vesselUserDetails.pin");

  const { masterData } = useMasterData();
  console.log("Master Data:", masterData);

  useEffect(() => {
    const fetchAddressDetails = async (pin) => {
      if (pin?.length === 6) {
        try {
          const URL = process.env.REACT_APP_PUBLIC_URL + URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE + pin;
          const response = await getData(URL);
          if (response?.status === 200 && response?.data?.length > 0) {

            setValue('vesselUserDetails.district', response?.data[0]?.district);
            setValue('vesselUserDetails.stateUt', response?.data[0]?.stateName);
            setValue("vesselUserDetails.country", "India");

          } else {
            setValue("vesselUserDetails.district", "");
            setValue("vesselUserDetails.stateUt", "");
            setValue("vesselUserDetails.country", "");
          }
        } catch (error) {
          setValue("vesselUserDetails.district", " ");
          setValue("vesselUserDetails.stateUt", "");
          setValue("vesselUserDetails.country", "");
        }
      }
    };

    if (watchPin) {
      fetchAddressDetails(watchPin);
    }
  }, [watchPin, setValue]);

  return (
    <Form onSubmit={handleSubmit(onSubmit)}>
      <div className="employee-registration-form">
        {/* Personal Details Section */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaUser className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>Personal Details</span>
            </div>
          }
          defaultOpen={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col md={4}>
                  <InputText
                    name="vesselUserDetails.firstName"
                    label="First Name"
                    placeholder="Enter first name"
                    register={register("vesselUserDetails.firstName", { required: "First Name is required" })}
                    errors={errors?.vesselUserDetails?.firstName ? { vesselUserDetails: { firstName: errors.vesselUserDetails.firstName } } : {}}
                    style={{
                      borderColor: errors?.vesselUserDetails?.firstName ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.firstName ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={4}>
                  <InputText
                    name="vesselUserDetails.lastName"
                    label="Last Name"
                    placeholder="Enter last name"
                    register={register("vesselUserDetails.lastName", { required: "Last Name is required" })}
                    errors={errors?.vesselUserDetails?.lastName ? { vesselUserDetails: { lastName: errors.vesselUserDetails.lastName } } : {}}
                    style={{
                      borderColor: errors?.vesselUserDetails?.lastName ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.lastName ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={4}>
                  <InputText
                    name="vesselUserDetails.email"
                    label="Email ID"
                    type="email"
                    placeholder="Enter email address"
                    register={register("vesselUserDetails.email", {
                      required: "Email is required",
                      pattern: {
                        value: CONSTANT_REGEX.EMAIL,
                        message: "Invalid email address"
                      }
                    })}
                    errors={errors?.vesselUserDetails?.email ? { vesselUserDetails: { email: errors.vesselUserDetails.email } } : {}}
                    style={{
                      borderColor: errors?.vesselUserDetails?.email ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.email ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={4}>
                  <InputText
                    name="vesselUserDetails.phoneNumber"
                    label="Phone Number"
                    placeholder="Enter 10-digit phone number"
                    register={register("vesselUserDetails.phoneNumber", {
                      required: "Phone Number is required",
                      pattern: {
                        value: CONSTANT_REGEX.MOBILE,
                        message: "Invalid phone number"
                      }
                    })}
                    errors={errors?.vesselUserDetails?.phoneNumber ? { vesselUserDetails: { phoneNumber: errors.vesselUserDetails.phoneNumber } } : {}}
                    style={{
                      borderColor: errors?.vesselUserDetails?.phoneNumber ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.phoneNumber ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={4}>
                 <InputSelect
  name="vesselUserDetails.gender"
  label="Gender"
  placeholder="-- Select gender --"
  options={masterData?.genders?.map(type => ({
    value: type.valueCode,
    label: type.valueLabel
  })) || []}
  register={register}
  errors={errors?.vesselUserDetails?.gender ? { vesselUserDetails: { gender: errors.vesselUserDetails.gender } } : {}}
  value={watch("vesselUserDetails.gender") || ""}
  onChange={val => setValue("vesselUserDetails.gender", val, { shouldValidate: true })}
/>
                </Col>
                <Col md={4}>
                  <InputText
                    name="vesselUserDetails.dateOfBirth"
                    label="Date of Birth"
                    type="date"
                    placeholder="Select date of birth"
                    register={register("vesselUserDetails.dateOfBirth", { required: "Date of Birth is required" })}
                    errors={errors?.vesselUserDetails?.dateOfBirth ? { vesselUserDetails: { dateOfBirth: errors.vesselUserDetails.dateOfBirth } } : {}}
                    style={{
                      borderColor: errors?.vesselUserDetails?.dateOfBirth ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.dateOfBirth ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>

        {/* Address Details Section */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaMapMarkerAlt className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>Address Details</span>
            </div>
          }
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col md={6}>
                  <InputText
                    name="vesselUserDetails.addressLine1"
                    label="Address Line-1"
                    placeholder="Enter address line 1"
                    register={register("vesselUserDetails.addressLine1", { required: "Address Line-1 is required" })}
                    errors={errors?.vesselUserDetails?.addressLine1 ? { address: { line1: errors.vesselUserDetails.addressLine1 } } : {}}
                    style={{
                      borderColor: errors?.vesselUserDetails?.addressLine1 ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.addressLine1 ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={6}>
                  <InputText
                    name="vesselUserDetails.addressLine2"
                    label="Address Line-2"
                    placeholder="Enter address line 2 (optional)"
                    register={register("vesselUserDetails.addressLine2")}
                    errors={errors?.vesselUserDetails?.addressLine2 ? { vesselUserDetails: { line2: errors.vesselUserDetails.addressLine2 } } : {}}
                  />
                </Col>
                <Col md={3}>
                  <InputText
                    name="vesselUserDetails.pin"
                    label="PIN"
                    placeholder="Enter 6-digit PIN code"
                    register={register("vesselUserDetails.pin", {
                      required: "PIN Code is required",
                      pattern: {
                        value: /^\d{6}$/,
                        message: "Invalid PIN code (must be 6 digits)"
                      }
                    })}
                    errors={errors?.vesselUserDetails?.pin ? { address: { pin: errors.vesselUserDetails.pin } } : {}}
                    style={{
                      borderColor: errors?.vesselUserDetails?.pin ? '#dc3545' : undefined,
                      backgroundColor: errors?.vesselUserDetails?.pin ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={3}>
                  <InputText
                    name="vesselUserDetails.district"
                    label="District"
                    placeholder="Auto-populated"
                    register={register("vesselUserDetails.district")}
                    errors={errors?.address?.district ? { address: { district: errors.vesselUserDetails.district } } : {}}
                    readOnly
                  />
                </Col>
                <Col md={3}>
                  <InputText
                    name="vesselUserDetails.stateUt"
                    label="State/UT"
                    placeholder="Auto-populated"
                    register={register("vesselUserDetails.stateUt")}
                    errors={errors?.address?.state ? { address: { state: errors.vesselUserDetails.stateUt } } : {}}
                    readOnly
                  />
                </Col>
                <Col md={3}>
                  <InputText
                    name="vesselUserDetails.country"
                    label="Country"
                    placeholder="Enter country"
                    register={register("vesselUserDetails.country")}
                    errors={errors?.address?.country ? { address: { country: errors.vesselUserDetails.country } } : {}}
                    readOnly
                  />
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>

        {/* Education Details Section */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaGraduationCap className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>Education Details</span>
            </div>
          }
        >
          <Card className="form-section-card">
            <Card.Body>
              {fields.map((field, index) => (
                <div key={field.id} className="education-entry mb-4">
                  {index > 0 && <div className="entry-divider mb-3"></div>}
                  <Row className="g-3">
                    <Col md={4}>
                      <InputText
                        name={`vesselUserDetails?.educationDetails.${index}.qualification`}
                        label={`Qualification ${index === 0 ? '*' : ''}`}
                        placeholder="Enter qualification"
                        register={register(`educationDetails.${index}.qualification`,
                          index === 0 ? { required: "Qualification is required" } : {}
                        )}
                        errors={errors?.educationDetails?.[index]?.qualification ?
                          { educationDetails: { [index]: { qualification: errors.educationDetails[index].qualification } } } : {}}
                        style={{
                          borderColor: errors?.educationDetails?.[index]?.qualification ? '#dc3545' : undefined,
                          backgroundColor: errors?.educationDetails?.[index]?.qualification ? '#fff8f8' : undefined
                        }}
                      />
                    </Col>
                    <Col md={4}>
                      <InputText
                        name={`educationDetails.${index}.stream`}
                        label={`Stream ${index === 0 ? '*' : ''}`}
                        placeholder="Enter stream"
                        register={register(`educationDetails.${index}.stream`,
                          index === 0 ? { required: "Stream is required" } : {}
                        )}
                        errors={errors?.educationDetails?.[index]?.stream ?
                          { educationDetails: { [index]: { stream: errors.educationDetails[index].stream } } } : {}}
                        style={{
                          borderColor: errors?.educationDetails?.[index]?.stream ? '#dc3545' : undefined,
                          backgroundColor: errors?.educationDetails?.[index]?.stream ? '#fff8f8' : undefined
                        }}
                      />
                    </Col>
                    <Col md={3}>
                      <InputText
                        name={`educationDetails.${index}.yearOfPassing`}
                        label={`Year of Passing ${index === 0 ? '*' : ''}`}
                        placeholder="Enter year"
                        type="number"
                        register={register(`educationDetails.${index}.yearOfPassing`, {
                          ...(index === 0 ? { required: "Year of Passing is required" } : {}),
                          min: { value: 1900, message: "Invalid year" },
                          max: { value: new Date().getFullYear(), message: "Invalid year" }
                        })}
                        errors={errors?.educationDetails?.[index]?.yearOfPassing ?
                          { educationDetails: { [index]: { yearOfPassing: errors.educationDetails[index].yearOfPassing } } } : {}}
                        style={{
                          borderColor: errors?.educationDetails?.[index]?.yearOfPassing ? '#dc3545' : undefined,
                          backgroundColor: errors?.educationDetails?.[index]?.yearOfPassing ? '#fff8f8' : undefined
                        }}
                      />
                    </Col>
                    <Col md={1} className="d-flex align-items-end">
                      {index > 0 && (
                        <Button
                          variant="danger"
                          size="sm"
                          onClick={() => remove(index)}
                          className="mt-1"
                        >
                          <FaTrash />
                        </Button>
                      )}
                    </Col>
                  </Row>
                </div>
              ))}
              <Button
                variant="outline-primary"
                onClick={() => append({ qualification: "", stream: "", yearOfPassing: "" })}
                className="add-education-btn"
              >
                <FaPlus className="me-2" /> Add Education Details
              </Button>
            </Card.Body>
          </Card>
        </Collapsible>

        {/* Professional Details Section */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaBriefcase className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>Professional Details</span>
            </div>
          }
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col md={4}>
                  <InputText
                    name="professional.appointmentDate"
                    label="Appointment Date"
                    type="date"
                    placeholder="Select appointment date"
                    register={register("professional.appointmentDate", { required: "Appointment Date is required" })}
                    errors={errors?.professional?.appointmentDate ?
                      { professional: { appointmentDate: errors.professional.appointmentDate } } : {}}
                    style={{
                      borderColor: errors?.professional?.appointmentDate ? '#dc3545' : undefined,
                      backgroundColor: errors?.professional?.appointmentDate ? '#fff8f8' : undefined
                    }}
                  />
                </Col>
                <Col md={4}>
               <InputSelect
  name="professional.employeeType"
  label="Employee Type"
  placeholder="Select employee type"
  options={masterData?.employeeTypes?.map(type => ({
    value: type.valueCode,
    label: type.valueLabel
  })) || []}
  register={register}
  errors={errors?.professional?.employeeType ? { professional: { employeeType: errors.professional.employeeType } } : {}}
  value={watch("professional.employeeType") || ""}
  onChange={val => setValue("professional.employeeType", val, { shouldValidate: true })}
/>
                </Col>
                <Col md={4}>
  <InputSelect
    name="professional.employeeStatus"
    label="Employee Status"
    placeholder="Select employee status"
    options={masterData?.employeeStatuses?.map(type => ({
      value: type.valueCode,
      label: type.valueLabel
    })) || []}
    register={register}
    errors={errors?.professional?.employeeStatus ?
      { professional: { employeeStatus: errors.professional.employeeStatus } } : {}}
    value={watch("professional.employeeStatus") || ""}
    onChange={val => setValue("professional.employeeStatus", val, { shouldValidate: true })}
  />
</Col>
<Col md={4}>
  <InputSelect
    name="professional.designation"
    label="Designation"
    placeholder="Select designation"
    options={masterData?.designations?.map(type => ({
      value: type.valueCode,
      label: type.valueLabel
    })) || []}
    register={register}
    errors={errors?.professional?.designation ?
      { professional: { designation: errors.professional.designation } } : {}}
    value={watch("professional.designation") || ""}
    onChange={val => setValue("professional.designation", val, { shouldValidate: true })}
  />
</Col>
                <Col md={4}>
                  <InputText
                    name="professional.department"
                    label="Department"
                    placeholder="Auto-populated"
                    register={register("professional.department")}
                    errors={errors?.professional?.department ?
                      { professional: { department: errors.professional.department } } : {}}
                    readOnly
                  />
                </Col>
                <Col md={4}>
                  <InputText
                    name="professional.section"
                    label="Section"
                    placeholder="Enter section"
                    register={register("professional.section")}
                    errors={errors?.professional?.section ?
                      { professional: { section: errors.professional.section } } : {}}
                  />
                </Col>
               <Col md={4}>
  <InputSelect
    name="professional.roles"
    label="Roles"
    placeholder="Select role"
    options={masterData?.roles?.map(type => ({
      value: type.valueCode,
      label: type.valueLabel
    })) || []}
    register={register}
    errors={errors?.professional?.roles ?
      { professional: { roles: errors.professional.roles } } : {}}
    value={watch("professional.roles") || ""}
    onChange={val => setValue("professional.roles", val, { shouldValidate: true })}
  />
</Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>

        {/* Documents Upload Section */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>Documents Upload</span>
            </div>
          }
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col md={4}>
                  <InputText
                    name="documents.addressProof"
                    label="Address Proof"
                    type="file"
                    register={register("documents.addressProof", { required: "Address Proof is required" })}
                    errors={errors?.documents?.addressProof ?
                      { documents: { addressProof: errors.documents.addressProof } } : {}}
                    style={{
                      borderColor: errors?.documents?.addressProof ? '#dc3545' : undefined,
                      backgroundColor: errors?.documents?.addressProof ? '#fff8f8' : undefined
                    }}
                  />
                  <small className="text-muted">Upload PDF, JPG or PNG (Max: 2MB)</small>
                </Col>
                <Col md={4}>
                  <InputText
                    name="documents.identityProof"
                    label="Identity Proof"
                    type="file"
                    register={register("documents.identityProof", { required: "Identity Proof is required" })}
                    errors={errors?.documents?.identityProof ?
                      { documents: { identityProof: errors.documents.identityProof } } : {}}
                    style={{
                      borderColor: errors?.documents?.identityProof ? '#dc3545' : undefined,
                      backgroundColor: errors?.documents?.identityProof ? '#fff8f8' : undefined
                    }}
                  />
                  <small className="text-muted">Upload PDF, JPG or PNG (Max: 2MB)</small>
                </Col>
                <Col md={4}>
                  <InputText
                    name="documents.appointmentLetter"
                    label="Appointment Letter"
                    type="file"
                    register={register("documents.appointmentLetter", { required: "Appointment Letter is required" })}
                    errors={errors?.documents?.appointmentLetter ?
                      { documents: { appointmentLetter: errors.documents.appointmentLetter } } : {}}
                    style={{
                      borderColor: errors?.documents?.appointmentLetter ? '#dc3545' : undefined,
                      backgroundColor: errors?.documents?.appointmentLetter ? '#fff8f8' : undefined
                    }}
                  />
                  <small className="text-muted">Upload PDF, JPG or PNG (Max: 2MB)</small>
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>
          <div className="d-flex justify-content-end mt-4 gap-2">
                <Button
                  variant="secondary"
                  onClick={onCancel}
                  className="cancel-btn"
                >
                  Cancel
                </Button>
                <Button
                  variant="primary"
                  type="submit"
                  className="submit-btn"
                  style={{
                    background: "linear-gradient(135deg, #0077b6, #023e8a)",
                    border: "none",
                    boxShadow: "0 4px 6px rgba(0, 0, 0, 0.1)",
                    padding: "8px 20px",
                  }}
                >
                  Submit
                </Button>
              </div>
      </div>
    </Form>

  );
};

export default EmployeeRegistrationForm;


import { useNavigate } from "react-router-dom";
import "react-toastify/dist/ReactToastify.css";
import { useTranslation } from "react-i18next";
import { useEffect, useState, useRef } from "react";
import ActionTable from "../../../common/ActionTable.tsx";
import { toast } from "react-toastify";
import ActionModal from "../../../common/ActionModal.tsx";
import {
  APP_MESSAGES,
  CONSTANT_REGEX_SAMPLE,
} from "../../../../utils/constants.ts";
import { FormProvider, useForm } from "react-hook-form";
import { USER_REGIS_MASTER } from "./userManagConst.ts";
import { Card, Row, Col, Button } from "react-bootstrap";
import InputSelect from "../../../common/InputSelect.tsx";
import InputText from "../../../common/InputText.tsx";
import EmployeeRegistrationForm from "./EmployeeRegistrationForm.js";
import NewLoader from "../../../common/NewLoader.js";
import {
  getData,
  postData,
  postFORMdata,
} from "../../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import { handleErrorMessage } from "../../../../utils/errorMessageHandler.js";
import { useMasterData } from "../../../context/MasterDataContext.js";

const empFormdefaultValues = {
  vesselUserDetails: {
    id: "",
    userType: "",
    userCategory: "",
    firstName: "",
    lastName: "",
    emailId: "",
    phoneNumber: "",
    panNumber: "",
    gstNumber: "",
    addressDetails: "",
    addressLine1: "",
    addressLine2: "",
    pin: "",
    district: "",
    stateUt: "",
    country: "",
    isActive: true,
    keycloakId: "",
    dateOfBirth: "",
    gender: "",
    authorizedPerson: null,
    companyRegistration: null,
    educationDetails: {
      uuid: "",
      employeeUUID: "",
      qualification: "",
      stream: "",
      yearOfPassing: "",
      additionalEducationDetails: "",
    },
    professionalDetails: {
      uuid: "",
      employeeUUID: "",
      appointmentDate: "",
      employeeType: "",
      employeeStatus: "",
      designation: "",
      department: "",
      section: "",
      role: "",
    },
    aadharNumber: "",
    password: "",
  },
  documents: {
    addressProof: null,
    identityProof: null,
    appointmentLetter: null,
  },
};

const UserManagement = () => {
  const { t } = useTranslation();
  let navigate = useNavigate();
  const [rowData, setRowData] = useState([]);
  const [modal, setModal] = useState(false);
  const [modalAction, setModalAction] = useState("");
  const [userFormData, setuserFormData] = useState(empFormdefaultValues);
  const [modalTitle, setModalTitle] = useState(t("Add Employee"));
  const [isLoading, setIsLoading] = useState(false);
  const loaderRef = useRef();
  const { masterData } = useMasterData();

  const {
    register,
    handleSubmit,
    watch,
    reset,
    setValue,
    formState: { errors },
  } = useForm();

  const methods = useForm({
    defaultValues: empFormdefaultValues,
  });

  useEffect(() => {
    setuserFormData([]);
    getUserDetails();
  }, []);

  const columns = USER_REGIS_MASTER.USER_INFO_COLUMNS;
  const userMockData = USER_REGIS_MASTER.MOCK_USER_DATA;

  const getUserDetails = async () => {
    setIsLoading(true);
    try {
      setTimeout(() => {
        setRowData(userMockData);
        setIsLoading(false);
      }, 500);
    } catch (error) {
      console.error("Error fetching user details:", error);
      toast.error(t("Error fetching user details"));
      setIsLoading(false);
    }
  };

  const handleRowClick = (e) => {};

  const handleBtnClick = () => {
    methods.reset();
    setModalTitle(t("Add Employee"));
    setModal(true);
  };

  const handleEditRow = (e) => {
    setModalTitle(t("Edit Employee"));
    setuserFormData(e);

    setModal(true);
  };

  const Toggle = () => {
    setuserFormData(empFormdefaultValues);
    setModal(false);
  };

  const onSubmitFilterForm = async (e) => {
    if (e && Object.keys(e).length > 0) {
      console.log("Filter form submitted:", e);
     
    }
  };

  
  const handleFormSubmit = async (data) => {
    try {
      console.log("Form submitted with data:", JSON.stringify(data, null, 2));
      
      
      const formDataObj = new FormData();
      
    
      const completeData = {
        vesselUserDetails: {
          ...data.vesselUserDetails,
          email: data.vesselUserDetails.emailId || "",
          gender: data.vesselUserDetails.gender || "",
          professionalDetails: {
            uuid: "",
            employeeUUID: "",
            appointmentDate: data.professional?.appointmentDate || "",
            employeeType: data.professional?.employeeType || "",
            employeeStatus: data.professional?.employeeStatus || "",
            designation: data.professional?.designation || "",
            department: data.professional?.department || "",
            section: data.professional?.section || "",
            role: data.professional?.roles || ""
          }
        },
        documents: {},
        // professional: {
        //   ...data.professional,
        //   employeeType: data.professional?.employeeType || "",
        //   employeeStatus: data.professional?.employeeStatus || "",
        //   designation: data.professional?.designation || "",
        //   roles: data.professional?.roles || ""
        // },
        educationDetails: data.educationDetails || []
      };
      
     
      if (data.documents) {
        for (const [docKey, docFile] of Object.entries(data.documents)) {
          if (docFile && docFile[0]) {
            console.log(`Adding file: ${docKey}`, docFile[0]);
            
         
            formDataObj.append(docKey, docFile[0]);
            
          
            completeData.documents[docKey] = {
              name: docFile[0].name,
              type: docFile[0].type,
              size: docFile[0].size
            };
          }
        }
      }
      
    
      formDataObj.append("data", JSON.stringify(completeData));
      
      
      console.log("Form data payload:");
      for (const [key, value] of formDataObj.entries()) {
        console.log(`${key}:`, value instanceof File ? `File: ${value.name}` : value);
      }

      
      await submitEmpDetails(formDataObj);
      
      
      setModal(false);
      getUserDetails();
    } catch (error) {
      console.error("Error submitting form:", error);
      toast.error("Error submitting form");
    }
  };

  const submitEmpDetails = async (payload) => {
    try {
      const URL =
        process.env.REACT_APP_AUTH_URL + URLS_ENDPOINT.USER_SERVICE.CREATE_EMP;
      loaderRef.current?.show();
      
    
      console.log("Submitting payload to API:", payload);
      
    
      const dataStr = payload.get("data");
      if (dataStr) {
        try {
          const dataObj = JSON.parse(dataStr);
          console.log("Parsed data object:", dataObj);
        } catch (e) {
          console.error("Error parsing data:", e);
        }
      }
      
      const response = await postFORMdata(URL, payload);
      const apiRes = { ...response?.data };
      if (
        response?.status === 200 &&
        apiRes?.responseStatus?.status === "200"
      ) {
        loaderRef?.current?.hide();
        toast.success(
          apiRes?.responseStatus?.message || "Employee registered successfully!",
          { position: "top-right" }
        );
      } else {
        loaderRef?.current?.hide();
        toast.info(
          apiRes?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  return (
    <>
      <NewLoader ref={loaderRef} />

      <div className="w-full">
        <Card>
          <form
            style={{ padding: "2rem", margin: 0 }}
            onSubmit={handleSubmit(onSubmitFilterForm)}
          >
            <Row>
              <Col md={2}>
                <InputText
                  type="text"
                  name="empId"
                  maxlength={10}
                  label="Employee Id"
                  placeholder="Enter Employee Id"
                  register={{
                    ...register("empId", {}),
                  }}
                  errors={errors}
                  onKeyDown={(e) => {
                    if (!/^\d$/.test(e.key)) {
                      e.preventDefault();
                    }
                  }}
                />
              </Col>

              <Col md={2}>
                <InputText
                  type="text"
                  name="empName"
                  label="Employee Name"
                  placeholder="Enter employee name"
                  register={{
                    ...register("empName", {}),
                  }}
                  errors={errors}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label="Designation"
                  name="designation"
                     options={masterData?.designations?.map(type => ({
                    value: type.valueCode,
                    label: type.valueLabel
                  })) || []}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected Desig :", val)}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label="Status"
                  name="status"
                  options={[
                    { value: "active", label: "Active" },
                    { value: "inactive", label: "Inactive" },
                  ]}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected:", val)}
                />
              </Col>

              <Col md={2}>
                <InputText
                  type="text"
                  name="phoneNumber"
                  label="Phone Number"
                  maxlength={10}
                  placeholder="Enter Phone Number"
                  register={{
                    ...register("phoneNumber", {}),
                  }}
                  onKeyDown={(e) => {
                    if (!/^\d$/.test(e.key)) {
                      e.preventDefault();
                    }
                  }}
                  errors={errors}
                />
              </Col>

              <Col md={2}>
                <div style={{ display: "flex", gap: "8px", marginTop: "2rem" }}>
                  <div className="w48">
                    <button className="generic-btn-submit" type="submit">
                      Filter
                    </button>
                  </div>
                  <div className="w48">
                    <button
                      className="generic-btn-cancel "
                      type="reset"
                      onClick={() => {
                        reset();
                      }}
                    >
                      {t("login.reset")}
                    </button>
                  </div>
                </div>
              </Col>
            </Row>
            <Row className="mt-2">
              <Col
                md={{ span: 2, offset: 10 }}
                className="d-flex justify-content-end"
              >
                <button
                  className="generic-btn-submit"
                  type="button"
                  onClick={handleBtnClick}
                >
                  <i className="fa fa-plus" aria-hidden="true"></i> {t("Add")}
                </button>
              </Col>
            </Row>
          </form>
        </Card>
        <>
          <ActionTable
            tableHeader="Employee List"
            columns={columns}
            rowData={rowData}
            additionalMethod={handleRowClick}
            showCustomBtn={true}
            btnName={t("Add")}
            handleBtnClick={handleBtnClick}
            handleEditRow={handleEditRow}
            hideExportBtn={true}
            searchBarPlaceholder={t("Table.SEARCH_BY")}
          />
        </>

        <ActionModal
          show={modal}
          close={Toggle}
          title={modalTitle}
          action={modalAction}
          isFooterHide={true}
          size={"lg"}
        >
          <FormProvider {...methods}>
           
             <EmployeeRegistrationForm
              onSubmit={methods.handleSubmit(handleFormSubmit)}
              onCancel={Toggle}
            />
            
          
          </FormProvider>
        </ActionModal>
      </div>
    </>
  );
};

export default UserManagement;

import React from "react";
import Select from "react-select";
import { Form } from "react-bootstrap";
import "./InputSelect.css";

interface InputSelectProps {
  label: string;
  required?: boolean;
  name: string;
  options: Array<{ value: string | number; label: string }>;
  register?: any;
  errors?: any;
  disabled?: boolean;
  onChange?: (value: string | number, selObj?:any) => void;
  className?: string;
  style?: React.CSSProperties;
  icon?: React.ElementType;
  value?: any;
  isMulti?: boolean;
  isClearable?: boolean;
}

const InputSelect: React.FC<InputSelectProps> = ({
  label,
  required,
  name,
  options,
  register,
  errors,
  disabled,
  onChange,
  className = "",
  style = {},
  icon: IconComponent,
  value,
  isMulti = false,
  isClearable = false,
}) => {
  const hasError = errors && errors[name];
  const selectedOption = options.find(opt => opt.value === value);
  
  
  const showError = hasError && (!value || value === '');

  const handleChange = (selected: any) => {
    onChange?.(selected?.value || "", selected);
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold d-block">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>

      <div className="position-relative">
        {IconComponent && (
          <div
            className={`input-icon position-absolute ${
              showError ? "text-danger" : value ? "text-success" : "text-primary"
            }`}
            style={{
              left: "10px",
              top: "50%",
              transform: "translateY(-50%)",
              zIndex: 2,
            }}
          >
            <IconComponent size={18} />
          </div>
        )}

        <Select
          options={options}
          value={selectedOption}
          onChange={handleChange}
          isDisabled={disabled}
          isMulti={isMulti}
          isClearable={isClearable}
          className={`react-select-container ${showError ? "is-invalid" : ""}`}
          classNamePrefix="react-select"
          styles={{
            control: (base, state) => ({
              ...base,
              borderColor: showError ? "#dc3545" : state.isFocused ? "#80bdff" : "#ced4da",
              boxShadow: state.isFocused && !showError ? "0 0 0 0.2rem rgba(0, 123, 255, 0.25)" : "none",
              paddingLeft: IconComponent ? "40px" : "12px",
              backgroundColor: showError ? "#fff8f8" : "white",
              minHeight: "calc(1.5em + 1rem + 2px)",
              "&:hover": {
                borderColor: showError ? "#dc3545" : "#ced4da"
              }
            }),
            menu: (base) => ({
              ...base,
              zIndex: 9999
            })
          }}
        />
      </div>

      {showError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;
import React, { useState, useRef, useEffect } from "react";
import { Form, InputGroup, OverlayTrigger, Tooltip } from "react-bootstrap";
import { FaEye, FaEyeSlash, FaCheckCircle } from "react-icons/fa";
import classNames from "classnames";
import { CONSTANT_REGEX } from "../../utils/constants.ts";

interface InputTextProps {
  label: string;
  required?: boolean;
  name: string;
  type?: string;
  placeholder?: string;
  register?: any;
  disabled?: boolean;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  maxlength?: number;
  readOnly?: boolean;
  errors?: any;
  className?: string;
  onKeyDown?: (e: React.KeyboardEvent<HTMLInputElement>) => void;
  icon?: React.ElementType;
  description?: string;
  style?: React.CSSProperties;
  autoFocus?: boolean;
}

const InputText: React.FC<InputTextProps> = ({
  label,
  required,
  name,
  type = "text",
  placeholder,
  register,
  disabled,
  onChange,
  maxlength,
  readOnly,
  errors,
  className = "",
  onKeyDown,
  icon: IconComponent,
  description,
  style = {},
  autoFocus,
}) => {
  const [showPassword, setShowPassword] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);

  const isPassword = type === "password";
  const inputType = isPassword ? (showPassword ? "text" : "password") : type;
  const hasError = errors && errors[name];
  
  const [inputValue, setInputValue] = useState("");
  const [isComplete, setIsComplete] = useState(false);
  
 
  const validationPattern = useRef<RegExp | null>(null);
  
 
  useEffect(() => {
    if (type === "email") {
      validationPattern.current = CONSTANT_REGEX.EMAIL;
    } else if (name.includes("pan")) {
      validationPattern.current = CONSTANT_REGEX.PAN;
    } else if (name.includes("gst")) {
      validationPattern.current = CONSTANT_REGEX.GSTNO;
    } else if (name.includes("phone") || name.includes("mobile")) {
      validationPattern.current = CONSTANT_REGEX.MOBILE;
    } else if (name.includes("pin")) {
      validationPattern.current = CONSTANT_REGEX.PINCODE;
    } else {
      validationPattern.current = null;
    }
  }, [type, name]);
  
 
  useEffect(() => {
    if (!inputValue) return;
    
    let valid = false;
    
    
    if (name.includes("pin") && inputValue.length === 6) {
      valid = true;
    }
    
    else if (validationPattern.current) {
      valid = validationPattern.current.test(inputValue);
    } else if (required) {
      valid = inputValue.length > 0;
    } else {
      valid = true;
    }
    
    setIsComplete(valid);
  }, [inputValue, required, name]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const value = e.target.value;
    setInputValue(value);
    
    
    if (name.includes("pin") && value.length === 6) {
     
      setTimeout(() => {
        if (inputRef.current) {
          inputRef.current.value = value;
        }
      }, 100);
    }
    
    if (onChange) {
      onChange(e);
    }
  };

  const togglePasswordVisibility = () => setShowPassword((prev) => !prev);

  const inputClasses = classNames("shadow-sm w-100", {
    "is-invalid": hasError && !isComplete,
    "border-start-0": IconComponent,
    "border-end-0": isPassword,
    "disabled": disabled,
  });

  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      {label && (
        <Form.Label className="fw-semibold d-block">
          {label}
          {required && <span className="text-danger ms-1">*</span>}
        </Form.Label>
      )}

      <InputGroup className="flex-nowrap w-100 flex-md-nowrap flex-wrap">
        {IconComponent && (
          <InputGroup.Text
            className={`bg-white border-end-0 ${
              hasError ? "border-danger text-danger" : 
              (isComplete && inputValue && !hasError) ? "border-success" : ""
            }`}
            style={{
              borderColor: hasError ? "#dc3545" : 
                          (isComplete && inputValue && !hasError) ? "#198754" : "#ced4da",
              transition: "all 0.3s ease",
            }}
          >
            <IconComponent 
              size={18} 
              color={
                hasError ? "#dc3545" : 
                (isComplete && inputValue && !hasError) ? "#198754" : "#387AD4"
              } 
            />
          </InputGroup.Text>
        )}

        <Form.Control
          ref={inputRef}
          type={inputType}
          name={name}
          placeholder={placeholder}
          {...register}
          disabled={disabled}
          onChange={handleChange}
          maxLength={maxlength}
          readOnly={readOnly}
          onKeyDown={onKeyDown}
          min={0}
          className={inputClasses}
          aria-label={label}
          style={{
            ...style,
            borderColor: hasError && !isComplete ? "#dc3545" : 
                        (isComplete && inputValue && !hasError) ? "#198754" : "#ced4da",
            backgroundColor: hasError && !isComplete ? "#fff8f8" : 
                           (isComplete && inputValue && !hasError) ? "#f8fff9" : "white",
            transition: "all 0.3s ease"
          }}
        />

        {isPassword && (
          <OverlayTrigger
            placement="top"
            overlay={
              <Tooltip id={`tooltip-${name}`}>
                {showPassword ? "Hide password" : "Show password"}
              </Tooltip>
            }
          >
            <InputGroup.Text
              className={`bg-white border-start-0 ${
                hasError ? "border-danger" : 
                (isComplete && inputValue && !hasError) ? "border-success" : ""
              }`}
              role="button"
              onClick={togglePasswordVisibility}
              aria-label="Toggle password visibility"
              style={{
                cursor: "pointer",
                borderColor: hasError ? "#dc3545" : 
                            (isComplete && inputValue && !hasError) ? "#198754" : "#ced4da",
              }}
            >
              {showPassword ? (
                <FaEyeSlash
                  size={18}
                  color={hasError ? "#dc3545" : 
                         (isComplete && inputValue && !hasError) ? "#198754" : "#387AD4"}
                />
              ) : (
                <FaEye 
                  size={18} 
                  color={hasError ? "#dc3545" : 
                         (isComplete && inputValue && !hasError) ? "#198754" : "#387AD4"} 
                />
              )}
            </InputGroup.Text>
          </OverlayTrigger>
        )}
      </InputGroup>

      {description && (
        <Form.Text style={{ color: "#5A67D8" }} className="d-block mt-1">
          {description}
        </Form.Text>
      )}

      {hasError?.message && !isComplete && (
        <Form.Text className="text-danger d-block">
          {errors?.[name]?.message}
        </Form.Text>
      )}
     {/* {isComplete && inputValue && hasError && (
        <Form.Text className="text-success d-block">
          Valid input
        </Form.Text>
      )} */}
    </Form.Group>
  );
};

export default InputText;
