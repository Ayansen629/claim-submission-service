import React, { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import "bootstrap/dist/css/bootstrap.min.css";
import { Container, Row, Col, Modal, Button, Table, Badge } from "react-bootstrap";
import "./DashboardMain.css";
import FileUploadModal from "./FileUploadModal.jsx";
import ActionTable from "./ActionTable.js";
import { toast } from "react-toastify";
import { APP_MESSAGES, openFileInNewTab } from "../../../utils/constants.ts";
import { URLS_ENDPOINT } from "../../../utils/urlsConstants.ts";
import { postData } from "../../../services/http.service.ts";
import Collapsible from "../../../common/Collapsible.js";
import PreviewCard from "./PreviewCard.js";
// import HistoryView from "../common/HistoryView";
import { FaDownload, FaClipboardList, FaFile, FaFilePdf } from "react-icons/fa6";

const DashboardMain = () => {
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [modalData, setModalData] = useState({});
  const [historyModal, setHistoryModal] = useState(false);
  const [historyData, setHistoryData] = useState({});
  const [showDocumentModal, setShowDocumentModal] = useState(false);
  const [documentListData, setDocumentListData] = useState([]);
  const navigate = useNavigate();

  const handleDocumentModal = () => setShowDocumentModal(!showDocumentModal);

  const [rowData, setRowData] = useState([]);
  const columns = [
    {
      colName: "SL NO",
      fieldName: "slNo",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "SL NO",
      minWidth: "5rem",
    },
    {
      colName: "Claim Number",
      fieldName: "claimNumber",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Claim Number",
      minWidth: "10rem",
    },
    {
      colName: "Claimant",
      fieldName: "claimant",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Claimant",
      minWidth: "10rem",
    },
    {
      colName: "Status",
      fieldName: "status",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Status",
      minWidth: "10rem",
    },
    {
      colName: "Amount",
      fieldName: "amount",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Amount",
      minWidth: "10rem",
    },
    {
      colName: "Date Submitted",
      fieldName: "dateSubmitted",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Date Submitted",
      minWidth: "10rem",
    },
    {
      colName: "Action",
      fieldName: "action",
      actions: ["view"],
      clsName: "col-sm-2 column-text-start actions-column",
    },
  ];

  const formatFileInfo = (fileData) => {
    if (!fileData) return "No file uploaded";
    if (typeof fileData === "string") return fileData;
    return fileData.docName || "File uploaded";
  };

  const renderPreviewSection = (fields) => (
    <Container fluid>
      <Row className="g-3">
        {Object.entries(fields).map(([key, value]) => (
          <Col key={key} xs={12} sm={6} md={4} className="mb-3">
            <PreviewCard title={key} value={value || 'N/A'} />
          </Col>
        ))}
      </Row>
    </Container>
  );

  const renderCard = (title, fields) => (
    <div className="mb-3">
      <h5 style={{ fontWeight: 600 }}>{title}</h5>
      {renderPreviewSection(fields)}
    </div>
  );

  const transformApplicationData = (application) => {
    if (!application) return null;

    const basicDetails = application.creditorBasicDetails || {};
    const claimDetails = application.claimDetails || {};
    const signatoryDetails = application.signatoryDetails || {};

    return {
      step1: {
        creditorDetails: {
          "Application Number": application.applicationNumber,
          "Debtor Name": basicDetails.debtorName,
          "Creditor Name": basicDetails.creditorName,
          "Total Claim Amount": basicDetails.totalClaimAmount,
          "Debt Details": basicDetails.debtDetails,
          "Mutual Credit Details": basicDetails.mutualCreditDetails,
        },
        identificationDetails: {
          "Identification Type": basicDetails.document?.docType,
          "Identification Number": basicDetails.identificationNumber,
          "Document Name": formatFileInfo(basicDetails.document),
        },
      },
      step2: {
        financialDetails: {
          "Security Interest Amount": claimDetails.securityInterestAmount,
          "Guarantee Amount": claimDetails.guaranteeAmount,
          "Guarantor Name": claimDetails.guarantorName,
          "Guarantor Address": claimDetails.guarantorAddress,
          "Creditor Address": claimDetails.creditorAddress,
          "Creditor Email": claimDetails.creditorEmail,
        },
        beneficiaryDetails: {
          "Beneficiary Name": claimDetails.beneficiaryName,
          "Beneficiary Address": claimDetails.beneficiaryAddress,
          "Corporate Debtor Security Amount": claimDetails.corporateDebtorSecurityAmount,
          "Corporate Debtor Guarantee Amount": claimDetails.corporateDebtorGuaranteeAmount,
        },
        addressproofDetails: {
          "Address Proof Type": claimDetails.document?.docType,
          "Address Proof Number": claimDetails.addressProofNumber,
          "Address Proof Document": formatFileInfo(claimDetails.document),
        },
        bankDetails: {
          "Principal Borrower Name": claimDetails.principalBorrowerName,
          "Principal Borrower Address": claimDetails.principalBorrowerAddress,
          "Account Number": claimDetails.bankAccountNumber,
          "IFSC Code": claimDetails.bankIfscCode,
          "Branch Name": claimDetails.bankBranchName,
        },
      },
      step3: {
        signatoryDetails: {
          "Signatory Name": signatoryDetails.name,
          "Signatory Position": signatoryDetails.position,
          "Signatory Address": signatoryDetails.address,
          "Signatory Document": formatFileInfo(signatoryDetails.document),
        },
      },
      status: application.applicationStatus,
    };
  };

  const handleOnViewRow = async (row) => {
    try {
      setIsLoading(true);

      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails;

      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }

      const payload = {
        userInfo: userInfo,
        uuids: [row.uuid], // Use the uuid from the row
        applicationNumbers: [],
        claimantUUIDs: []
      };

      const URL =
        process.env.REACT_APP_APPLICATION_SERVICE +
        URLS_ENDPOINT.APP_SERVICES.APPLICATION_VIEW_ID;

      const response = await postData(URL, payload);

      if (response?.data?.status?.code === "200" && response?.data?.applicationDetails?.length > 0) {
        setModalData(response.data.applicationDetails);
        setIsViewModalOpen(true);
      } else {
        toast.error("No application details found", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching application details:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
    } finally {
      setIsLoading(false);
    }
  };

  const fetchDashboardData = async () => {
    try {
      setIsLoading(true);

      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails

      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }

      const payload = {
        userInfo: userInfo,
        filterCriteria: {}
      };

      const URL =
        process.env.REACT_APP_APPLICATION_SERVICE +
        URLS_ENDPOINT.APP_SERVICES.DASHBOARD_LIST;


      const response = await postData(URL, payload);
      console.log(response, "responselist");


      if (response?.data.status === "200" && response?.data.dashboardApplications?.length > 0) {
        // Format the data to match your table structure
        const formattedData = response.data.dashboardApplications.map((item, index) => ({
          ...item,
          id: item.uuid,
          slNo: index + 1,
          claimNumber: item.applicationNumber,
          claimant: item.creditorName,
          status: item.applicationStatus,
          amount: `${item.totalClaimAmount}` || "0.00",
          dateSubmitted: item.submittedDate || new Date().toLocaleDateString(),
          action: ["view"],
          originalData: item,
        }));
        if (userFormData?.userType === "CRP") {
          formattedData.forEach((item) => {
            item.claimNumber = (
              <a href={`/apply-claim/${item.id}`} style={{ color: "#269ccc", textDecoration: "underline" }}>
                {item.claimNumber}
              </a>
            );
          });
        }

        setRowData(formattedData);
      } else {
        setRowData([]);
        toast.info("No applications found", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching dashboard data:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setRowData([]);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchDashboardData();
  }, []);


  return (
    <div className="container-fluid mt-5" style={{ paddingLeft: 0, paddingRight: 0 }}>
      {!isLoading ? (
        <>
          <h3 className="mb-2 text-center">Claim Submission Service</h3>
          <br />
          <div className="row mb-3 align-items-center">
            <div className="col-12 col-md-4 d-flex justify-content-md-end justify-content-center gap-2 ms-auto">
              {/* <button className="btn btn-success btn-sm" onClick={handleAddButtonClick}>
                <i className="fas fa-plus"></i> Add
              </button> */}
              {/* <button className="btn btn-success btn-sm" onClick={() => setIsModalOpen(true)}>
                <i className="fas fa-upload"></i> Bulk Upload
              </button> */}
            </div>
          </div>
          <ActionTable
            columns={columns}
            rowData={rowData}
            hideExportBtn={false}
            // handleEditRow={handleEditRow}
            onViewRow={handleOnViewRow}
            // onHistoryView={handleOnHistoryViewRow}
          />

          <Modal
            show={isViewModalOpen}
            onHide={() => setIsViewModalOpen(false)}
            dialogClassName="modal-1110w"
            aria-labelledby="example-custom-modal-styling-title"
          >
            <Modal.Header closeButton>
              <Modal.Title id="example-custom-modal-styling-title">
                Application Details
              </Modal.Title>
            </Modal.Header>
            <Modal.Body>
              {modalData?.length > 0 ? (
                <>
                  {modalData.map((application, index) => {
                    const formattedAppData = transformApplicationData(application);
                    return (
                      <Collapsible
                        key={index}
                        title={`Application: ${application.applicationNumber || 'N/A'}`}
                      >
                        <div className="card mb-4 tiles_Size">
                          <div className="card-body">
                            <div className="d-flex justify-content-between align-items-center mb-3">
                              <h5 style={{ fontWeight: 600 }}>Application Details</h5>
                              <Badge bg="info">
                                Status: {formattedAppData.status || 'Not Available'}
                              </Badge>
                            </div>
                            {formattedAppData && (
                              <>
                                <Collapsible title="Step 1: Creditor and Identification Details">
                                  {formattedAppData.step1 && (
                                    <>
                                      {formattedAppData.step1.creditorDetails &&
                                        renderCard("Creditor Details", formattedAppData.step1.creditorDetails)}
                                      {formattedAppData.step1.identificationDetails &&
                                        renderCard(
                                          "Identification Details",
                                          formattedAppData.step1.identificationDetails
                                        )}
                                    </>
                                  )}
                                </Collapsible>

                                <Collapsible title="Step 2: Financial and Beneficiary Details">
                                  {formattedAppData.step2 && (
                                    <>
                                      {formattedAppData.step2.financialDetails &&
                                        renderCard(
                                          "Financial Details",
                                          formattedAppData.step2.financialDetails
                                        )}
                                      {formattedAppData.step2.addressproofDetails &&
                                        renderCard(
                                          "Address Proof Details",
                                          formattedAppData.step2.addressproofDetails
                                        )}
                                      {formattedAppData.step2.beneficiaryDetails &&
                                        renderCard(
                                          "Beneficiary Details",
                                          formattedAppData.step2.beneficiaryDetails
                                        )}
                                      {formattedAppData.step2.bankDetails &&
                                        renderCard("Bank Details", formattedAppData.step2.bankDetails)}
                                    </>
                                  )}
                                </Collapsible>

                                <Collapsible title="Step 3: Signatory Details">
                                  {formattedAppData.step3 &&
                                    formattedAppData.step3.signatoryDetails &&
                                    renderCard(
                                      "Signatory Details",
                                      formattedAppData.step3.signatoryDetails
                                    )}
                                </Collapsible>
                              </>
                            )}
                          </div>
                        </div>
                      </Collapsible>
                    );
                  })}
                </>
              ) : (
                <p>No application data available.</p>
              )}
            </Modal.Body>
            <Modal.Footer>
              <Button variant="secondary" onClick={() => setIsViewModalOpen(false)}>
                Close
              </Button>
              <Button variant="primary" onClick={() => {
                // Add any additional action here if needed
                setIsViewModalOpen(false);
              }}>
                Print/Download
              </Button>
            </Modal.Footer>
          </Modal>
          <FileUploadModal modal={isModalOpen} setModal={setIsModalOpen} />
        </>
      ) : (
        <div className="loader-container">
          <div className="loader"></div>
        </div>
      )}
    </div>
  );
};

export default DashboardMain;
