import React, { useCallback, useEffect, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DocumentsUpload from "./DocumentsUpload";
import { FaUpload } from "react-icons/fa";
import 'bootstrap/dist/css/bootstrap.min.css';
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepFourth.css"

const StepFourth = ({ provideSubmitHandler, formData, onValidationComplete }) => {
    const [isUploadingIdentity, setIsUploadingIdentity] = useState(false);
    const [isUploadingAddress, setIsUploadingAddress] = useState(false);
    const [uploadError, setUploadError] = useState(null);
    const [isCRPUser, setIsCRPUser] = useState(false);

    // Check if user is CRP
    useEffect(() => {
        const storedData = localStorage.getItem('userFormData');
        if (storedData) {
            const parsedData = JSON.parse(storedData);
            setIsCRPUser(parsedData?.userType === "CRP");
        }
    }, []);

    const methods = useForm({
        mode: "onChange",
        reValidateMode: "onChange",
        defaultValues: formData || {}
    });
    
    const { handleSubmit, formState: { errors, isValid }, trigger, getValues } = methods;

    const handleFileUpload = async (file) => {
        // Don't upload if user is CRP
        if (isCRPUser) return null;
        
        try {
            const result = await uploadDocument(file, 'document');
            return result;
        } catch (error) {
            setUploadError(error.message);
            throw error;
        }
    };

    const onSubmit = useCallback(async () => {
        const isValid = await trigger();
        if (!isValid) {
            console.error("Validation failed");
            return false;
        }
        return getValues();
    }, [trigger, getValues]);

    useEffect(() => {
        if (onValidationComplete) {
            onValidationComplete(isValid);
        }
    }, [isValid, onValidationComplete]);

    useEffect(() => {
        if (provideSubmitHandler) {
            provideSubmitHandler(onSubmit);
        }
    }, [provideSubmitHandler, onSubmit]);

    return (
        <div className="container-fluid p-0">
            <style>
                {`
                    .step-header {
                        background-color: #269ccc;
                        color: white;
                        padding: 15px;
                        border-radius: 5px;
                        margin-bottom: 20px;
                    }
                `}
            </style>
            
            <FormProvider {...methods}>
                <form className="form-stepper">
                    <div className="step-header">
                        <FaUpload className="section-icon" />
                        <h4>Document Upload</h4>
                    </div>
                    <DocumentsUpload 
                        isUploadingIdentity={isUploadingIdentity}
                        isUploadingAddress={isUploadingAddress}
                        uploadError={uploadError}
                        setIsUploadingIdentity={setIsUploadingIdentity}
                        setIsUploadingAddress={setIsUploadingAddress}
                        setUploadError={setUploadError}
                        onFileUpload={handleFileUpload}
                        disabled={isCRPUser} // Pass disabled prop to DocumentsUpload
                    />
                </form>
            </FormProvider>
        </div>
    );
};

export default StepFourth;


///////////////////
import React from "react";
import { useFormContext, Controller } from "react-hook-form";
import { Form, Row, Col, Card, Button, Spinner, Alert, Badge } from "react-bootstrap";
import { FaDownload, FaTrash, FaFilePdf, FaFileImage } from "react-icons/fa";
import "./DocumentsUpload.css";
import 'bootstrap/dist/css/bootstrap.min.css';

const DocumentsUpload = ({
    isUploadingIdentity, 
    isUploadingAddress,
    uploadError, 
    setIsUploadingIdentity, 
    setIsUploadingAddress,
    setUploadError, 
    onFileUpload,
    disabled // Add disabled prop
}) => {
    const { control, watch, setValue, formState: { errors } } = useFormContext();
    const [uploadSuccess, setUploadSuccess] = React.useState(false);

    const identityProofOptions = [
        { value: "aadhaar", label: "Aadhaar Card" },
        { value: "pan", label: "PAN Card" },
        { value: "voter_id", label: "Voter ID" },
        { value: "passport", label: "Passport" },
        { value: "driving_license", label: "Driving License" }
    ];

    const addressProofOptions = [
        { value: "aadhaar", label: "Aadhaar Card" },
        { value: "voter_id", label: "Voter ID" },
        { value: "passport", label: "Passport" },
        { value: "driving_license", label: "Driving License" },
        { value: "utility_bill", label: "Utility Bill" },
        { value: "rent_agreement", label: "Rent Agreement" }
    ];

    const watchedFields = watch(["identityProofType", "identityProofFile", "addressProofType", "addressProofFile"]);

    const handleFileUpload = async (file, fieldName) => {
        // Don't upload if disabled
        if (disabled) return null;
        
        try {
            // Set the correct uploading state based on fieldName
            if (fieldName === "identityProofFile") {
                setIsUploadingIdentity(true);
            } else {
                setIsUploadingAddress(true);
            }
            
            setUploadError(null);
            setUploadSuccess(false);
            const result = await onFileUpload(file);
            setValue(fieldName, {
                fileId: result.fileId,
                fileName: file.name,
                fileType: file.type
            });
            setUploadSuccess(true);
            return result;
        } catch (error) {
            setUploadError(error.message);
            throw error;
        } finally {
            // Reset the correct uploading state based on fieldName
            if (fieldName === "identityProofFile") {
                setIsUploadingIdentity(false);
            } else {
                setIsUploadingAddress(false);
            }
        }
    };

    const handleFileChange = async (e, fieldName) => {
        // Don't process if disabled
        if (disabled) return;
        
        const file = e.target.files[0];
        if (!file) return;

        const fileSizeInMB = file.size / (1024 * 1024);
        const maxSize = 5;
        const allowedTypes = ["image/jpeg", "image/png", "application/pdf"];

        if (fileSizeInMB > maxSize) {
            setUploadError(`File size must be ≤ ${maxSize}MB`);
            return;
        }

        if (!allowedTypes.includes(file.type)) {
            setUploadError(`Invalid file type. Allowed: ${allowedTypes.join(', ')}`);
            return;
        }

        try {
            await handleFileUpload(file, fieldName);
        } catch (error) {
            console.error("Upload failed:", error);
        }
    };

    const removeFile = (fieldName) => {
        // Don't process if disabled
        if (disabled) return;
        
        setValue(fieldName, null);
        setUploadSuccess(false);
    };

    const getFileIcon = (fileType) => {
        if (fileType === 'application/pdf') return <FaFilePdf className="text-danger me-2 fs-4" />;
        if (fileType.includes('image/')) return <FaFileImage className="text-secondary me-2 fs-4" />;
        return <FaFileImage className="text-secondary me-2 fs-4" />;
    };

    const renderFilePreview = (fileValue, type) => {
        if (!fileValue) return null;

        const fileUrl = typeof fileValue === 'object' ? 
            `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileValue.fileId}` : 
            fileValue;

        const fileName = typeof fileValue === 'object' ? 
            fileValue.fileName || 'Uploaded file' : 
            fileValue.split('/').pop() || 'Uploaded file';

        return (
            <div className="file-preview-container bg-light p-3 rounded mb-3">
                {uploadSuccess && (
                    <div className="text-success d-flex align-items-center gap-2 mb-2">
                        <span>File uploaded successfully!</span>
                    </div>
                )}
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        {getFileIcon(typeof fileValue === 'object' ? fileValue.fileType : '')}
                        <div>
                            <div className="fw-bold text-truncate" style={{ maxWidth: '200px' }}>{fileName}</div>
                            <small className="text-muted">
                                <Badge bg={type === 'identity' ? "info" : "primary"}>
                                    {type === 'identity' ? "Identity Proof" : "Address Proof"}
                                </Badge>
                            </small>
                        </div>
                    </div>
                    <div className="d-flex gap-2">
                        <Button
                            variant="outline-primary"
                            size="sm"
                            href={fileUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            download
                            title="Download file"
                        >
                            <FaDownload />
                        </Button>
                        {!disabled && ( // Only show remove button if not disabled
                            <Button
                                variant="outline-danger"
                                size="sm"
                                onClick={() => removeFile(type === 'identity' ? 'identityProofFile' : 'addressProofFile')}
                                title="Remove file"
                                disabled={disabled}
                            >
                                <FaTrash />
                            </Button>
                        )}
                    </div>
                </div>
            </div>
        );
    };

    return (
        <Card className="mb-4 document-upload-card shadow-sm">
            <Card.Body>
                <Row className="mb-4 g-3">
                    <Col md={6}>
                        <Form.Group controlId="identityProofType">
                            <Form.Label>Identity Proof Type <span className="text-danger">*</span></Form.Label>
                            <Controller
                                name="identityProofType"
                                control={control}
                                rules={{ required: "Identity proof type is required" }}
                                render={({ field }) => (
                                    <Form.Select 
                                        {...field} 
                                        isInvalid={!!errors.identityProofType}
                                        onChange={(e) => {
                                            if (!disabled) {
                                                field.onChange(e);
                                                setValue("identityProofFile", null);
                                            }
                                        }}
                                        disabled={disabled}
                                    >
                                        <option value="">Select identity proof</option>
                                        {identityProofOptions.map((type) => (
                                            <option key={type.value} value={type.value}>
                                                {type.label}
                                            </option>
                                        ))}
                                    </Form.Select>
                                )}
                            />
                            {errors.identityProofType && (
                                <Form.Control.Feedback type="invalid" className="d-block">
                                    {errors.identityProofType.message}
                                </Form.Control.Feedback>
                            )}
                        </Form.Group>
                    </Col>

                    {watchedFields[0] && (
                        <Col md={6}>
                            <Form.Group controlId="identityProofFile">
                                <Form.Label>
                                    Upload Identity Proof <span className="text-danger">*</span>
                                </Form.Label>
                                {watchedFields[1] ? (
                                    renderFilePreview(watchedFields[1], 'identity')
                                ) : (
                                    <div className="file-upload-container border rounded p-3">
                                        <input
                                            type="file"
                                            id="identityProofFile"
                                            accept=".pdf,.jpg,.jpeg,.png"
                                            onChange={(e) => handleFileChange(e, "identityProofFile")}
                                            className="d-none"
                                            disabled={isUploadingIdentity || disabled}
                                        />
                                        {!disabled && ( // Only show upload button if not disabled
                                            <label htmlFor="identityProofFile" className="btn btn-outline-primary w-100">
                                                {isUploadingIdentity ? (
                                                    <>
                                                        <Spinner animation="border" size="sm" className="me-2" />
                                                        Uploading...
                                                    </>
                                                ) : (
                                                    "Choose File"
                                                )}
                                            </label>
                                        )}
                                        <div className="small text-muted mt-2">
                                            Accepted formats: PDF, JPG, PNG (Max 5MB)
                                        </div>
                                    </div>
                                )}
                                {errors.identityProofFile && (
                                    <Form.Control.Feedback type="invalid" className="d-block">
                                        {errors.identityProofFile.message}
                                    </Form.Control.Feedback>
                                )}
                                {uploadError && !watchedFields[1] && (
                                    <Alert variant="danger" className="mt-2 small p-2">
                                        {uploadError}
                                    </Alert>
                                )}
                            </Form.Group>
                        </Col>
                    )}
                </Row>

                <Row className="g-3">
                    <Col md={6}>
                        <Form.Group controlId="addressProofType">
                            <Form.Label>Address Proof Type <span className="text-danger">*</span></Form.Label>
                            <Controller
                                name="addressProofType"
                                control={control}
                                rules={{ required: "Address proof type is required" }}
                                render={({ field }) => (
                                    <Form.Select 
                                        {...field} 
                                        isInvalid={!!errors.addressProofType}
                                        onChange={(e) => {
                                            if (!disabled) {
                                                field.onChange(e);
                                                setValue("addressProofFile", null);
                                            }
                                        }}
                                        disabled={disabled}
                                    >
                                        <option value="">Select address proof</option>
                                        {addressProofOptions.map((type) => (
                                            <option key={type.value} value={type.value}>
                                                {type.label}
                                            </option>
                                        ))}
                                    </Form.Select>
                                )}
                            />
                            {errors.addressProofType && (
                                <Form.Control.Feedback type="invalid" className="d-block">
                                    {errors.addressProofType.message}
                                </Form.Control.Feedback>
                            )}
                        </Form.Group>
                    </Col>

                    {watchedFields[2] && (
                        <Col md={6}>
                            <Form.Group controlId="addressProofFile">
                                <Form.Label>
                                    Upload Address Proof <span className="text-danger">*</span>
                                </Form.Label>
                                {watchedFields[3] ? (
                                    renderFilePreview(watchedFields[3], 'address')
                                ) : (
                                    <div className="file-upload-container border rounded p-3">
                                        <input
                                            type="file"
                                            id="addressProofFile"
                                            accept=".pdf,.jpg,.jpeg,.png"
                                            onChange={(e) => handleFileChange(e, "addressProofFile")}
                                            className="d-none"
                                            disabled={isUploadingAddress || disabled}
                                        />
                                        {!disabled && ( // Only show upload button if not disabled
                                            <label htmlFor="addressProofFile" className="btn btn-outline-primary w-100">
                                                {isUploadingAddress ? (
                                                    <>
                                                        <Spinner animation="border" size="sm" className="me-2" />
                                                        Uploading...
                                                    </>
                                                ) : (
                                                    "Choose File"
                                                )}
                                            </label>
                                        )}
                                        <div className="small text-muted mt-2">
                                            Accepted formats: PDF, JPG, PNG (Max 5MB)
                                        </div>
                                    </div>
                                )}
                                {errors.addressProofFile && (
                                    <Form.Control.Feedback type="invalid" className="d-block">
                                        {errors.addressProofFile.message}
                                    </Form.Control.Feedback>
                                )}
                                {uploadError && !watchedFields[3] && (
                                    <Alert variant="danger" className="mt-2 small p-2">
                                        {uploadError}
                                    </Alert>
                                )}
                            </Form.Group>
                        </Col>
                    )}
                </Row>
            </Card.Body>
        </Card>
    );
};

export default DocumentsUpload;
