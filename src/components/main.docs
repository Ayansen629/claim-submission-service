<Col md={4}>
  <InputText
    label={t("vesselDetails.GST")}
    required={JSON.parse(getFromLocalStorage("ownerDetails") || "{}")?.categoryOfOwner !== "INDIVIDUAL"}
    name="gst"
    placeholder={t("vesselDetails.Please enter GST")}
    register={register("gst", {
      required: JSON.parse(getFromLocalStorage("ownerDetails") || "{}")?.categoryOfOwner !== "INDIVIDUAL" 
        ? t("vesselDetails.GST is required") 
        : false,
    })}
    errors={errors}
    disabled={viewMode || (!errors?.gst && !!getValues("gst"))}
  />
</Col>
