import React, { useState, useRef, useEffect } from "react";
import { Form, InputGroup, OverlayTrigger, Tooltip } from "react-bootstrap";
import { FaEye, FaEyeSlash, FaInfo, FaInfoCircle } from "react-icons/fa";
import classNames from "classnames";
import { CONSTANT_REGEX } from "../../utils/constants.ts";

interface InputTextProps {
  label: string;
  required?: boolean;
  name: string;
  type?: string;
  placeholder?: string;
  register?: any;
  disabled?: boolean;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  maxlength?: number;
  readOnly?: boolean;
  errors?: any;
  className?: string;
  onKeyDown?: (e: React.KeyboardEvent<HTMLInputElement>) => void;
  icon?: React.ElementType;
  description?: string;
  style?: React.CSSProperties;
  autoFocus?: boolean;
  tooltipText?: string;
  minDate?: string | Date;
  maxDate?: string | Date;
}

const InputText: React.FC<InputTextProps> = ({
  label,
  required,
  name,
  type = "text",
  placeholder,
  register,
  disabled,
  onChange,
  maxlength,
  readOnly,
  errors,
  className = "",
  onKeyDown,
  icon: IconComponent,
  description,
  style = {},
  autoFocus,
  tooltipText = "",
  minDate = "",
  maxDate = new Date(),
}) => {
  const [showPassword, setShowPassword] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);
  const isPassword = type === "password";
  const inputType = isPassword ? (showPassword ? "text" : "password") : type;

  // Format Date -> YYYY-MM-DD
  const formatDate = (date?: string | Date) => {
    if (!date) return undefined;
    if (typeof date === "string") return date;
    return date.toISOString().split("T")[0]; // only YYYY-MM-DD
  };

  // const errorMessage = errors?.[name]?.message || "";
  // const errorMessage = getNestedError(errors, name);

  const errorMessage =
    name?.split(".")?.reduce((acc, key) => acc?.[key], errors)?.message || "";
  const [inputValue, setInputValue] = useState("");
  const [isValid, setIsValid] = useState(false);
  const [touched, setTouched] = useState(false);
  const [isTyping, setIsTyping] = useState(false);
  const validationPattern = useRef<RegExp | null>(null);

  useEffect(() => {
    if (type === "email") {
      validationPattern.current = CONSTANT_REGEX.EMAIL;
    } else if (name.includes("pan")) {
      validationPattern.current = CONSTANT_REGEX.PAN;
    } else if (name.includes("gst")) {
      validationPattern.current = CONSTANT_REGEX.GSTNO;
    } else if (name.includes("phone") || name.includes("mobile")) {
      validationPattern.current = CONSTANT_REGEX.MOBILE;
    } else if (name.includes("pin")) {
      validationPattern.current = CONSTANT_REGEX.PINCODE;
    } else {
      validationPattern.current = null;
    }
  }, [type, name]);

  useEffect(() => {
    if (!inputValue && !required) {
      setIsValid(true);
      return;
    }

    if (!inputValue) {
      setIsValid(false);
      return;
    }

    let valid = false;

    if (name.includes("pin") && inputValue.length === 6) {
      valid = true;
    } else if (validationPattern.current) {
      valid = validationPattern.current.test(inputValue);
    } else if (required) {
      valid = inputValue.length > 0;
    } else {
      valid = true;
    }

    setIsValid(valid);
  }, [inputValue, required, name]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const value = e.target.value;
    setInputValue(value);
    setTouched(true);
    setIsTyping(true);

    if (name.includes("pin") && value.length === 6) {
      setTimeout(() => {
        if (inputRef.current) {
          inputRef.current.value = value;
        }
      }, 100);
    }

    if (onChange) {
      onChange(e);
    }
  };

  const togglePasswordVisibility = () => setShowPassword((prev) => !prev);

  const showError = errorMessage && !isTyping;
  const showSuccess = touched && isValid && inputValue && !showError;

  const inputClasses = classNames("shadow-sm w-100", {
    "is-invalid": showError,
    "is-valid": showSuccess,
    "border-start-0": IconComponent,
    "border-end-0": isPassword,
    disabled: disabled,
  });

  return (
    <Form.Group className={`mb-2 ${className}`} controlId={name}>
      {label && (
        <Form.Label className="fw-semibold d-flex align-items-center justify-content-between">
          <span>
            {label}
            {required && <span className="text-danger ms-1">*</span>}
          </span>
          {tooltipText && (
            <OverlayTrigger
              placement="auto"
              overlay={<Tooltip id={`tooltip-${name}`}>{tooltipText}</Tooltip>}
            >
              <FaInfoCircle
                style={{
                  cursor: "pointer",
                  fontSize: "18px",
                  color: "#0c9573ff",
                }}
              />
            </OverlayTrigger>
          )}
        </Form.Label>
      )}

      <InputGroup className="flex-nowrap w-100 flex-md-nowrap flex-wrap">
        {IconComponent && (
          <InputGroup.Text
            className={`bg-white border-end-0 ${
              showError
                ? "border-danger text-danger"
                : showSuccess
                ? "border-success text-success"
                : ""
            }`}
            style={{
              borderColor: showError
                ? "#dc3545"
                : showSuccess
                ? "#198754"
                : "#ced4da",
              transition: "all 0.3s ease",
            }}
          >
            <IconComponent
              size={18}
              color={
                showError ? "#dc3545" : showSuccess ? "#198754" : "#2466BF"
              }
            />
          </InputGroup.Text>
        )}

        <Form.Control
          ref={inputRef}
          type={inputType}
          name={name}
          placeholder={placeholder}
          {...register}
          disabled={disabled}
          onChange={(e: any) => {
            handleChange(e);
            if (register?.onChange) {
              register.onChange(e);
            }
          }}
          maxLength={maxlength}
          readOnly={readOnly}
          onKeyDown={onKeyDown}
          min={type === "date" ? formatDate(minDate) : 0}
          max={type === "date" ? formatDate(maxDate) : undefined}
          className={inputClasses}
          aria-label={label}
          onBlur={(e) => {
            setTouched(true);
            setIsTyping(false);
            if (register?.onBlur) {
              register.onBlur(e);
            }
          }}
          style={{
            ...style,
            borderColor: showError
              ? "#dc3545"
              : showSuccess
              ? "#198754"
              : "#ced4da",
            backgroundColor: showError
              ? "#fff8f8"
              : showSuccess
              ? "#f8fff9"
              : "white",
            transition: "all 0.3s ease",
          }}
          autoFocus={autoFocus}
        />

        {isPassword && (
          <OverlayTrigger
            placement="top"
            overlay={
              <Tooltip id={`tooltip-${name}`}>
                {showPassword ? "Hide password" : "Show password"}
              </Tooltip>
            }
          >
            <InputGroup.Text
              className={`bg-white border-start-0 ${
                showError
                  ? "border-danger text-danger"
                  : showSuccess
                  ? "border-success text-success"
                  : ""
              }`}
              role="button"
              onClick={togglePasswordVisibility}
              aria-label="Toggle password visibility"
              style={{
                cursor: "pointer",
                borderColor: showError
                  ? "#dc3545"
                  : showSuccess
                  ? "#198754"
                  : "#ced4da",
                transition: "all 0.3s ease",
              }}
            >
              {showPassword ? (
                <FaEyeSlash
                  size={18}
                  color={
                    showError ? "#dc3545" : showSuccess ? "#198754" : "#387AD4"
                  }
                />
              ) : (
                <FaEye
                  size={18}
                  color={
                    showError ? "#dc3545" : showSuccess ? "#198754" : "#387AD4"
                  }
                />
              )}
            </InputGroup.Text>
          </OverlayTrigger>
        )}
      </InputGroup>

      {description && (
        <Form.Text style={{ color: "#5A67D8" }} className="d-block mt-1">
          {description}
        </Form.Text>
      )}

      {showError && (
        <Form.Text className="text-danger d-block">
          {errorMessage}
          {/* {errorMessage || `${label} is required`} */}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputText;
