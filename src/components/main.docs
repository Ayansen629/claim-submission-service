import React, { useEffect, useCallback, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip";
import axios from "axios"; // Make sure to install axios
import "./StepFirst.css";

const StepFirst = ({ provideSubmitHandler, formData }) => {
  const [isUploading, setIsUploading] = useState(false);
  const [uploadError, setUploadError] = useState(null);
  const [uploadedFileUrl, setUploadedFileUrl] = useState(null);

  // ... (previous code remains the same until claimantDetailsSchema)

  const claimantDetailsSchema = [
    // ... (other fields remain the same)
    {
      name: "identificationDocument",
      label: <>Identification Document <span className="required-asterisk">*</span></>,
      type: "file",
      rules: { 
        required: "Identification document is required",
        validate: {
          fileUploaded: () => uploadedFileUrl !== null || "Please upload the document"
        }
      },
      tooltip: "Upload a clear scan of your identification document",
      accept: "image/*,.pdf",
      isUploading,
      uploadError
    },
  ];

  // Add file upload handler
  const handleFileUpload = async (file) => {
    if (!file) return;

    setIsUploading(true);
    setUploadError(null);

    try {
      // Create form data
      const formData = new FormData();
      formData.append('file', file);
      formData.append('documentType', 'identification');
      formData.append('userId', userFormData?.userId || ''); // Add any user identifier if available

      // Make API call
      const response = await axios.post('/api/upload-document', formData, {
        headers: {
          'Content-Type': 'multipart/form-data',
          'Authorization': `Bearer ${localStorage.getItem('token')}` // if using auth
        }
      });

      if (response.data.success) {
        setUploadedFileUrl(response.data.fileUrl);
        setValue("identificationDocument", response.data.fileUrl, { shouldValidate: true });
      } else {
        throw new Error(response.data.message || 'File upload failed');
      }
    } catch (error) {
      console.error('Upload error:', error);
      setUploadError(error.message || 'Failed to upload document');
    } finally {
      setIsUploading(false);
    }
  };

  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    
    if (!isValid || !uploadedFileUrl) {
      console.error("Validation failed or required documents missing");
      return false;
    }

    return getValues();
  }, [trigger, getValues, uploadedFileUrl]);

  // ... (rest of the component remains the same, except pass the handleFileUpload to DynamicField)

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        {/* ... (existing JSX remains the same) */}
        {claimantDetailsSchema.map((fieldConfig) => (
          <DynamicField
            key={fieldConfig.name}
            fieldConfig={fieldConfig}
            control={control}
            register={register}
            errors={errors}
            setValue={setValue}
            trigger={trigger}
            getValues={getValues}
            onFileUpload={handleFileUpload} // Pass the upload handler
          />
        ))}
        {/* ... (rest of the JSX remains the same) */}
      </form>
    </FormProvider>
  );
};

export default StepFirst;

//////////////////
// In your DynamicField.js component
const DynamicField = ({
  fieldConfig,
  register,
  errors,
  onFileUpload, // Add this prop
  // ... other props
}) => {
  // ... other field type handlers

  const handleFileChange = (e) => {
    const file = e.target.files[0];
    if (file && onFileUpload) {
      onFileUpload(file);
    }
  };

  // In the return statement, for file type:
  if (fieldConfig.type === "file") {
    return (
      <div className="form-group">
        <label htmlFor={fieldConfig.name}>
          {fieldConfig.label}
          {fieldConfig.tooltip && (
            <Tooltip title={fieldConfig.tooltip} arrow>
              <span className="tooltip-icon">i</span>
            </Tooltip>
          )}
        </label>
        <input
          type="file"
          id={fieldConfig.name}
          accept={fieldConfig.accept}
          onChange={handleFileChange}
          disabled={fieldConfig.disabled || fieldConfig.isUploading}
        />
        {fieldConfig.isUploading && <div>Uploading...</div>}
        {fieldConfig.uploadError && (
          <div className="error-message">{fieldConfig.uploadError}</div>
        )}
        {errors[fieldConfig.name] && (
          <div className="error-message">{errors[fieldConfig.name].message}</div>
        )}
      </div>
    );
  }

  // ... rest of the component
};
