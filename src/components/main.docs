.asterisk {
  color: #dc3545;
  margin-left: 2px;
}

.errorField {
  border: 2px solid #dc3545 !important;
  background-color: #fff5f5;
}

.errorMessage {
  color: #dc3545;
  font-size: 0.75rem;
  margin-top: 4px;
  font-weight: 500;
}

.editableInput {
  width: 100%;
  padding: 0.4rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  font-size: 0.75rem;
}

.sharesInput {
  width: 80px;
  padding: 0.5rem;
  border: 2px solid #2466BF;
  border-radius: 4px;
  text-align: center;
  font-weight: bold;
}

.required {
  font-weight: 600;
}
