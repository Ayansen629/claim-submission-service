.modalOverlay {
  position: fixed;
  top: 30px;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modalContent {
  background: white;
  border-radius: 20px;
  max-width: 700px;
  width: 95%;
  max-height: 70vh;
  overflow-y: auto;
  position: relative;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
}

.modalHeader {
  position: relative;
  padding: 15px 15px 0 15px;
}

.closeButton {
  position: absolute;
  top: 10px;
  right: 10px;
  background: none;
  border: none;
  font-size: 18px;
  color: #666;
  cursor: pointer;
  padding: 5px;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.closeButton:hover {
  background: #f0f0f0;
  color: #333;
}

.modalBody {
  padding: 15px 20px;
  text-align: center;
}

.modalImage {
  width: 60px;
  height: 60px;
  margin: 0 auto 15px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modalImage img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.modalTitle {
  color: #1A61C1;
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 15px;
}

.modalText {
  color: #333;
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 15px;
  line-height: 1.3;
  white-space: nowrap;
}

.modalList {
  text-align: left;
  color: #555;
  font-size: 12px;
  line-height: 1.4;
  margin-bottom: 20px;
  padding-left: 0;
  list-style: none;
}

.modalList li {
  margin-bottom: 8px;
  padding-left: 12px;
  position: relative;
  display: block;
  white-space: nowrap;
}

.modalList li::before {
  content: '•';
  color: #1A61C1;
  font-weight: bold;
  position: absolute;
  left: 0;
  top: 0;
  line-height: 1.4;
}

.modalFooter {
  display: flex;
  justify-content: center;
  gap: 15px;
  padding: 0 20px 20px;
}

.cancelButton {
  background: transparent;
  color: #dc2626;
  border: 2px solid #dc2626;
  padding: 10px 20px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.cancelButton:hover {
  background: #dc2626;
  color: white;
}

.proceedNowButton {
  background: #1A61C1;
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.proceedNowButton:hover {
  background: #1548a0;
  transform: translateY(-1px);
}

@media (max-width: 768px) {
  .modalContent {
    width: 98%;
    max-width: none;
  }
  
  .modalBody {
    padding: 12px 15px;
  }
  
  .modalTitle {
    font-size: 18px;
  }
  
  .modalText {
    font-size: 13px;
    white-space: normal;
  }
  
  .modalList {
    font-size: 11px;
  }
  
  .modalList li {
    white-space: normal;
  }
  
  .modalFooter {
    flex-direction: column;
    padding: 0 15px 15px;
  }
  
  .cancelButton,
  .proceedNowButton {
    width: 100%;
    padding: 10px;
  }
}

@media (max-width: 480px) {
  .modalContent {
    width: 99%;
    border-radius: 15px;
  }
  
  .modalImage {
    width: 50px;
    height: 50px;
  }
  
  .modalTitle {
    font-size: 16px;
  }
  
  .modalText {
    font-size: 12px;
    white-space: normal;
  }
  
  .modalList {
    font-size: 10px;
  }
  
  .modalList li {
    white-space: normal;
  }
  
  .cancelButton,
  .proceedNowButton {
    font-size: 13px;
    padding: 8px;
  }
}
