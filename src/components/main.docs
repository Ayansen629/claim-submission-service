import React from 'react';
import { Form } from 'react-bootstrap';
import { FaUpload } from 'react-icons/fa';

const InputFile = ({ 
  label, 
  required, 
  name, 
  register, 
  errors, 
  onChange, 
  accept, 
  disabled, 
  className = "", 
  style = {}, 
  watch 
}) => {
  const hasError = errors && errors[name];
  
  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      <div 
        className={`file-upload d-flex align-items-center border rounded p-3 ${hasError ? 'border-danger' : ''}`} 
        style={{
          ...style,
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderRadius: '8px',
          height: '50px'
        }}
      >
        <input 
          type="file" 
          id={name}
          {...register(name)}
          onChange={(e) => {
            if (e.target.files?.[0]) {
              setValue(name, e.target.files[0]);
              if (onChange) onChange(e);
              if (errors?.[name]) {
                clearErrors(name);
              }
            }
          }}
          accept={accept}
          disabled={disabled}
          className="file-input d-none"
        />
        <label 
          htmlFor={name} 
          className={`file-label btn btn-outline-primary mb-0 d-inline-flex align-items-center ${hasError ? 'border-danger' : ''}`} 
          style={{ 
            borderRadius: '6px',
            height: '40px'
          }}
        >
          <FaUpload className={`file-icon me-2 ${hasError ? 'text-danger' : 'text-primary'}`} />
          <span className={`file-text ${hasError ? 'text-danger' : ''}`}>Choose File</span>
        </label>
        <span className={`file-name ms-3 ${hasError ? 'text-danger' : 'text-muted'}`}>
          {watch?.(name)?.name ? watch(name).name : 'No file chosen'}
        </span>
      </div>
      
      <Form.Text className="text-muted small mt-1">
        Upload PDF, JPG or PNG file (Max size: 2MB)
      </Form.Text>
      
      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;

/////////////////////////
import React, { useState } from 'react';
import { Form, InputGroup } from 'react-bootstrap';
import { FaEye, FaEyeSlash } from 'react-icons/fa';

const InputText = ({ 
  label, 
  required, 
  name, 
  type = 'text', 
  placeholder, 
  register, 
  disabled, 
  onChange, 
  maxlength, 
  readOnly, 
  errors, 
  className = "", 
  onKeyDown, 
  icon: IconComponent, 
  description, 
  style = {} 
}) => {
  const [showPassword, setShowPassword] = useState(false);
  const isPassword = type === 'password';
  const inputType = isPassword ? (showPassword ? 'text' : 'password') : type;
  const hasError = errors && errors[name];

  const handleInputChange = (e) => {
    if (onChange) onChange(e);
    if (errors?.[name]) {
      clearErrors(name);
    }
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      {label && (
        <Form.Label className="fw-bold text-dark">
          {label}
          {required && <span className="text-danger ms-1">*</span>}
        </Form.Label>
      )}

      <InputGroup className="input-with-icon">
        {IconComponent && (
          <InputGroup.Text 
            className={`bg-white ${hasError ? 'border-danger' : ''}`}
            style={{
              borderRight: 'none',
              borderColor: hasError ? '#dc3545' : '#ced4da',
              height: '50px'
            }}
          >
            <IconComponent 
              className={hasError ? 'text-danger' : 'text-primary'} 
              size={18} 
            />
          </InputGroup.Text>
        )}

        <Form.Control
          type={inputType}
          name={name}
          placeholder={placeholder}
          {...register(name, {
            onChange: handleInputChange
          })}
          disabled={disabled}
          onChange={handleInputChange}
          maxLength={maxlength}
          readOnly={readOnly}
          onKeyDown={onKeyDown}
          className={`${hasError ? 'is-invalid border-danger' : ''}`}
          style={{
            ...style,
            height: '50px',
            borderRadius: '8px',
            borderColor: hasError ? '#dc3545' : '#ced4da',
            backgroundColor: hasError ? '#fff8f8' : 'white'
          }}
        />

        {isPassword && (
          <InputGroup.Text
            className={`bg-white ${hasError ? 'border-danger' : ''}`}
            style={{
              borderLeft: 'none',
              borderColor: hasError ? '#dc3545' : '#ced4da',
              height: '50px',
              cursor: "pointer"
            }}
            onClick={() => setShowPassword(!showPassword)}
            aria-label="Toggle password visibility"
          >
            {showPassword ? 
              <FaEyeSlash size={18} color={hasError ? '#dc3545' : '#387AD4'} /> : 
              <FaEye size={18} color={hasError ? '#dc3545' : '#387AD4'} />
            }
          </InputGroup.Text>
        )}
      </InputGroup>

      {description && (
        <Form.Text className="text-muted small mt-1">
          {description}
        </Form.Text>
      )}

      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputText;
//////////////////////////////////
import React from 'react';
import { Form } from 'react-bootstrap';

const InputSelect = ({ 
  label, 
  required, 
  name, 
  options, 
  register, 
  errors, 
  disabled, 
  onChange, 
  className = "", 
  style = {}, 
  icon: IconComponent,
  defaultValue 
}) => {
  const hasError = errors && errors[name];

  const handleSelectChange = (e) => {
    if (onChange) onChange(e);
    if (errors?.[name]) {
      clearErrors(name);
    }
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      <div className="position-relative">
        {IconComponent && (
          <div 
            className={`input-icon-container ${hasError ? 'text-danger' : 'text-primary'}`}
            style={{
              position: 'absolute',
              left: '10px',
              top: '50%',
              transform: 'translateY(-50%)',
              zIndex: 4
            }}
          >
            <IconComponent size={18} />
          </div>
        )}
        
        <Form.Select
          {...register(name, {
            onChange: handleSelectChange
          })}
          disabled={disabled}
          onChange={handleSelectChange}
          className={`${hasError ? 'is-invalid border-danger' : ''}`}
          style={{
            ...style,
            height: '50px',
            borderRadius: '8px',
            borderColor: hasError ? '#dc3545' : '#ced4da',
            backgroundColor: hasError ? '#fff8f8' : 'white',
            paddingLeft: IconComponent ? '40px' : '12px'
          }}
          defaultValue={defaultValue}
        >
          {options.map((option, index) => (
            <option key={index} value={option.value}>
              {option.label}
            </option>
          ))}
        </Form.Select>
      </div>
      
      {hasError && (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputSelect;
//////////////////////////
const DynamicField = ({ field }) => {
  if (field.showIf && !field.showIf()) return null;

  const commonProps = {
    label: field.label,
    required: field.required,
    name: field.name,
    register: register(field.name, field.validation),
    errors: errors,
    className: "mb-4",
    icon: field.icon,
    watch: watch
  };

  switch(field.type) {
    case 'select':
      return (
        <InputSelect
          {...commonProps}
          options={field.options}
          onChange={(e) => {
            if (field.onChange) field.onChange(e);
            if (errors?.[field.name]) clearErrors(field.name);
          }}
        />
      );
      
    case 'file':
      return (
        <InputFile
          {...commonProps}
          onChange={(e) => {
            if (e.target.files?.[0]) {
              setValue(field.name, e.target.files[0]);
              if (errors?.[field.name]) clearErrors(field.name);
            }
          }}
        />
      );
      
    default:
      return (
        <InputText
          {...commonProps}
          type={field.type}
          placeholder={field.placeholder}
          onChange={(e) => {
            if (field.onChange) field.onChange(e);
            if (errors?.[field.name]) clearErrors(field.name);
          }}
        />
      );
  }
};
