import { SURVEY_STATUSES, SURVEY_TYPES } from './constants';

const OWNERS = [
  "John Doe",
  "Jane Smith",
  "Robert Johnson",
  "Emily Davis",
  "Michael Wilson",
];

const PENDING_WITH_LEVELS = [
  "Level 1 Approver",
  "Level 2 Approver",
  "Level 3 Approver",
];

const VESSEL_TYPES = [
  "Bulk Carrier",
  "Container Ship",
  "Tanker",
  "Passenger Ship",
  "Fishing Vessel",
  "Offshore Vessel"
];

const generateVesselNo = (index) => {
  const prefix = ['MV', 'SS', 'FV', 'OSV'];
  return `${prefix[index % prefix.length]}${1000 + index}`;
};

export const generateSurveyData = (count = 20) => {
  return Array.from({ length: count }, (_, i) => ({
    id: `SUR-${2025}-${(i + 1).toString().padStart(4, "0")}`,
    surveyType: SURVEY_TYPES[Math.floor(Math.random() * SURVEY_TYPES.length)],
    vesselName: generateVesselNo(i),
    vesselType: VESSEL_TYPES[Math.floor(Math.random() * VESSEL_TYPES.length)],
    owner: OWNERS[Math.floor(Math.random() * OWNERS.length)],
    dateRequested: new Date(
      2025,
      Math.floor(Math.random() * 12),
      Math.floor(Math.random() * 28) + 1
    ).toISOString().split("T")[0],
    dateScheduled: new Date(
      2025,
      Math.floor(Math.random() * 12),
      Math.floor(Math.random() * 28) + 1
    ).toISOString().split("T")[0],
    status: Object.values(SURVEY_STATUSES)[Math.floor(Math.random() * Object.values(SURVEY_STATUSES).length)],
    pendingWith: PENDING_WITH_LEVELS[Math.floor(Math.random() * PENDING_WITH_LEVELS.length)],
    location: ['Port A', 'Port B', 'Dry Dock A', 'Anchorage'][Math.floor(Math.random() * 4)],
    duration: [1, 2, 3, 5][Math.floor(Math.random() * 4)],
    surveyorNotes: ['Routine check', 'Renewal due', 'Damage assessment', 'Initial inspection'][Math.floor(Math.random() * 4)]
  }));
};

