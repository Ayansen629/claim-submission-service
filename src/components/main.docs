    //     setProvisionalCertData(
    //       isRegistration ? data?.data?.registrationCertificateDetails : data
    //     );
    //     setModalType(type);
    //     setOpenCertificateModal(true);
    //     return;
    //   }

    //   toast.info(data?.responseStatus?.message || "Something went wrong..", {
