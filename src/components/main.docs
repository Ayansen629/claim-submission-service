const handleOnViewRow = async (row) => {
  try {
    setIsLoading(true);
    
    // Get user data from localStorage
    const userFormData = JSON.parse(localStorage.getItem("userFormData"));
    const userInfo = userFormData?.fullloginDetails;
    
    if (!userInfo) {
      throw new Error("User information not found in localStorage");
    }

    const payload = {
      userInfo: userInfo,
      uuids: [row.uuid], // Use the uuid from the row
      applicationNumbers: [],
      claimantUUIDs: []
    };

    const URL =
      process.env.REACT_APP_APPLICATION_SERVICE +
      URLS_ENDPOINT.APP_SERVICES.APPLICATION_SEARCH;

    const response = await postData(URL, payload);
    
    if (response?.data?.status?.code === "200" && response?.data?.applicationDetails?.length > 0) {
      setModalData(response.data.applicationDetails);
      setIsViewModalOpen(true);
    } else {
      toast.error("No application details found", { position: "top-right" });
    }
  } catch (error) {
    console.error("Error fetching application details:", error);
    toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
  } finally {
    setIsLoading(false);
  }
};
<Modal
  show={isViewModalOpen}
  onHide={() => setIsViewModalOpen(false)}
  dialogClassName="modal-1110w"
  aria-labelledby="example-custom-modal-styling-title"
>
  <Modal.Header closeButton>
    <Modal.Title id="example-custom-modal-styling-title">
      Application Details
    </Modal.Title>
  </Modal.Header>
  <Modal.Body>
    {modalData?.length > 0 ? (
      <>
        {modalData.map((application, index) => (
          <Collapsible
            key={index}
            title={`Application: ${application.applicationNumber || 'N/A'}`}
          >
            <div className="card mb-4 tiles_Size">
              <div className="card-body">
                <div className="d-flex justify-content-between align-items-center mb-3">
                  <h5 style={{ fontWeight: 600 }}>Basic Details</h5>
                  <Badge bg="info">
                    Status: {application.status || 'Not Available'}
                  </Badge>
                </div>
                <Container fluid>
                  <Row className="g-3">
                    {Object.entries({
                      "Application Number": application.applicationNumber,
                      "Debtor Name": application.creditorBasicDetails?.debtorName,
                      "Creditor Name": application.creditorBasicDetails?.creditorName,
                      "Total Claim Amount": application.creditorBasicDetails?.totalClaimAmount,
                      "Debt Details": application.creditorBasicDetails?.debtDetails,
                      "Mutual Credit Details": application.creditorBasicDetails?.mutualCreditDetails,
                    }).map(([key, value]) => (
                      <Col key={key} xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title={key} value={value || 'N/A'} />
                      </Col>
                    ))}
                  </Row>
                </Container>
              </div>
            </div>

            <div className="card mb-4 tiles_Size">
              <div className="card-body">
                <h5 style={{ fontWeight: 600 }}>Identification Details</h5>
                <Container fluid>
                  <Row className="g-3">
                    {Object.entries({
                      "Identification Type": application.creditorBasicDetails?.document?.docType,
                      "Identification Number": application.creditorBasicDetails?.identificationNumber,
                      "Document Name": application.creditorBasicDetails?.document?.docName,
                    }).map(([key, value]) => (
                      <Col key={key} xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title={key} value={value || 'N/A'} />
                      </Col>
                    ))}
                  </Row>
                </Container>
              </div>
            </div>

            <div className="card mb-4 tiles_Size">
              <div className="card-body">
                <h5 style={{ fontWeight: 600 }}>Claim Details</h5>
                <Container fluid>
                  <Row className="g-3">
                    {Object.entries({
                      "Security Interest Amount": application.claimDetails?.securityInterestAmount,
                      "Guarantee Amount": application.claimDetails?.guaranteeAmount,
                      "Guarantor Name": application.claimDetails?.guarantorName,
                      "Guarantor Address": application.claimDetails?.guarantorAddress,
                      "Creditor Address": application.claimDetails?.creditorAddress,
                      "Creditor Email": application.claimDetails?.creditorEmail,
                    }).map(([key, value]) => (
                      <Col key={key} xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title={key} value={value || 'N/A'} />
                      </Col>
                    ))}
                  </Row>
                </Container>
              </div>
            </div>

            <div className="card mb-4 tiles_Size">
              <div className="card-body">
                <h5 style={{ fontWeight: 600 }}>Signatory Details</h5>
                <Container fluid>
                  <Row className="g-3">
                    {Object.entries({
                      "Signatory Name": application.signatoryDetails?.name,
                      "Signatory Position": application.signatoryDetails?.position,
                      "Signatory Address": application.signatoryDetails?.address,
                      "Document Type": application.signatoryDetails?.document?.docType,
                      "Document Name": application.signatoryDetails?.document?.docName,
                    }).map(([key, value]) => (
                      <Col key={key} xs={12} sm={6} md={4} className="mb-3">
                        <PreviewCard title={key} value={value || 'N/A'} />
                      </Col>
                    ))}
                  </Row>
                </Container>
              </div>
            </div>
          </Collapsible>
        ))}
      </>
    ) : (
      <p>No application data available.</p>
    )}
  </Modal.Body>
  <Modal.Footer>
    <Button variant="secondary" onClick={() => setIsViewModalOpen(false)}>
      Close
    </Button>
    <Button variant="primary" onClick={() => {
      // Add any additional action here if needed
      setIsViewModalOpen(false);
    }}>
      Print/Download
    </Button>
  </Modal.Footer>
</Modal>

import React, { useEffect, useMemo, useState } from "react";
import { Container, Row, Col, Spinner, Badge } from "react-bootstrap";
import Collapsible from "./formCommon/Collapsible";
import { useFormData } from "../../context/FormDataContext";
import PreviewCard from "../../private/Dashboard/PreviewCard";

const ReviewStep = () => {
  const { formData } = useFormData();
  const [draftResponse, setDraftResponse] = useState(null);
  const [loading, setLoading] = useState(true);

  // Load draft data from localStorage on mount
  useEffect(() => {
    const savedDraft = localStorage.getItem("draftResponse");
    if (savedDraft) {
      try {
        const parsedDraft = JSON.parse(savedDraft);
        setDraftResponse(parsedDraft);
      } catch (error) {
        console.error("Error parsing draft data:", error);
      }
    }
    setLoading(false);
  }, []);

  // Get application number from draft response
  const applicationNumber = useMemo(() => {
    if (!draftResponse) return null;
    return draftResponse.data.applicationDetails?.applicationNumber || "N/A";
  }, [draftResponse]);

  // Transform the draft response to match your form structure
  const transformedDraftData = useMemo(() => {
    if (!draftResponse) return null;

    const basicDetails = draftResponse.data.applicationDetails?.creditorBasicDetails || {};
    const claimDetails = draftResponse.data.applicationDetails?.claimDetails || {};
    const signatoryDetails = draftResponse.data.applicationDetails?.signatoryDetails || {};

    return {
      debtorName: basicDetails.debtorName,
      CreditorName: basicDetails.creditorName,
      totalClaimAmount: basicDetails.totalClaimAmount,
      debtDetails: basicDetails.debtDetails,
      mutualCreditDetails: basicDetails.mutualCreditDetails,
      identificationType: basicDetails.document?.docType,
      identificationNumber: basicDetails.identificationNumber,
      identificationDocument: basicDetails.document,

      securityInterestAmount: claimDetails.securityInterestAmount,
      guaranteeAmount: claimDetails.guaranteeAmount,
      guarantorName: claimDetails.guarantorName,
      guarantorAddress: claimDetails.guarantorAddress,
      creditorAddress: claimDetails.creditorAddress,
      creditorEmail: claimDetails.creditorEmail,
      beneficiaryName: claimDetails.beneficiaryName,
      beneficiaryAddress: claimDetails.beneficiaryAddress,
      corporateDebtorSecurityAmount: claimDetails.corporateDebtorSecurityAmount,
      corporateDebtorGuaranteeAmount: claimDetails.corporateDebtorGuaranteeAmount,
      principalBorrowerName: claimDetails.principalBorrowerName,
      principalBorrowerAddress: claimDetails.principalBorrowerAddress,
      accountNumber: claimDetails.bankAccountNumber,
      ifscCode: claimDetails.bankIfscCode,
      branchName: claimDetails.bankBranchName,
      addressProofType: claimDetails.document?.docType,
      addressProofNumber: claimDetails.addressProofNumber,
      addressProofDocument: claimDetails.document,

      signatoryName: signatoryDetails.name,
      signatoryPosition: signatoryDetails.position,
      signatoryAddress: signatoryDetails.address,
      signatoryDocument: signatoryDetails.document,
    };
  }, [draftResponse]);

  // Use draft data if available, otherwise use regular form data
  const displayData = transformedDraftData || formData;

  // Format the data for display
  const formattedData = useMemo(() => {
    if (!displayData || Object.keys(displayData).length === 0) return null;

    const formatFileInfo = (fileData) => {
      if (!fileData) return "No file uploaded";
      if (typeof fileData === "string") return fileData;
      return fileData.docName || "File uploaded";
    };

    return {
      step1: {
        creditorDetails: {
          "Debtor Name": displayData.debtorName,
          "Creditor Name": displayData.CreditorName,
          "Total Claim Amount": displayData.totalClaimAmount,
          "Debt Details": displayData.debtDetails,
          "Mutual Credit Details": displayData.mutualCreditDetails,
        },
        identificationDetails: {
          "Identification Type": displayData.identificationType,
          "Identification Number": displayData.identificationNumber,
          "Identification Document": formatFileInfo(displayData.identificationDocument),
        }
      },
      step2: {
        financialDetails: {
          "Security Interest Amount": displayData.securityInterestAmount,
          "Guarantee Amount": displayData.guaranteeAmount,
          "Guarantor Name": displayData.guarantorName,
          "Guarantor Address": displayData.guarantorAddress,
          "Creditor Address": displayData.creditorAddress,
          "Creditor Email": displayData.creditorEmail,
        },
        beneficiaryDetails: {
          "Beneficiary Name": displayData.beneficiaryName,
          "Beneficiary Address": displayData.beneficiaryAddress,
          "Corporate Debtor Security Amount": displayData.corporateDebtorSecurityAmount,
          "Corporate Debtor Guarantee Amount": displayData.corporateDebtorGuaranteeAmount,
        },
        addressproofDetails: {
          "Address Proof Type": displayData.addressProofType,
          "Address Proof Number": displayData.addressProofNumber,
          "Address Proof Document": formatFileInfo(displayData.addressProofDocument),
        },
        bankDetails: {
          "Principal Borrower Name": displayData.principalBorrowerName,
          "Principal Borrower Address": displayData.principalBorrowerAddress,
          "Account Number": displayData.accountNumber,
          "IFSC Code": displayData.ifscCode,
          "Branch Name": displayData.branchName,
        }
      },
      step3: {
        signatoryDetails: {
          "Signatory Name": displayData.signatoryName,
          "Signatory Position": displayData.signatoryPosition,
          "Signatory Address": displayData.signatoryAddress,
          "Signatory Document": formatFileInfo(displayData.signatoryDocument),
        }
      }
    };
  }, [displayData]);

  if (loading) {
    return (
      <div className="d-flex justify-content-center align-items-center" style={{ height: "100vh" }}>
        <Spinner animation="border" />
      </div>
    );
  }

  if (!formattedData) {
    return (
      <div className="alert alert-info">
        No form data available to display
      </div>
    );
  }

  const renderPreviewSection = (fields) => (
    <Container fluid>
      <Row className="g-3">
        {Object.entries(fields).map(([key, value]) => (
          <Col key={key} xs={12} sm={6} md={3} className="mb-3">
            <PreviewCard 
              title={key} 
              value={value} 
            />
          </Col>
        ))}
      </Row>
    </Container>
  );

  const renderCard = (title, fields) => (
    <div className="mb-3">
      <h5 style={{ fontWeight: 600 }}>{title}</h5>
      {renderPreviewSection(fields)}
    </div>
  );

  return (
    <div className="form-stepper">
      {draftResponse && (
        <div className="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
          <div>
            <span className="text-muted small">Application Number:</span>
            <span className="ms-2 fw-bold">{applicationNumber}</span>
          </div>
          <Badge bg="warning" className="text-dark">
            Draft Preview
          </Badge>
        </div>
      )}

      <Collapsible title="Step 1: Creditor and Identification Details">
        {renderCard("Creditor Details", formattedData.step1.creditorDetails)}
        {renderCard("Identification Details", formattedData.step1.identificationDetails)}
      </Collapsible>

      <Collapsible title="Step 2: Financial and Beneficiary Details">
        {renderCard("Financial Details", formattedData.step2.financialDetails)}
        {renderCard("Address Proof Details", formattedData.step2.addressproofDetails)}
        {renderCard("Beneficiary Details", formattedData.step2.beneficiaryDetails)}
        {renderCard("Bank Details", formattedData.step2.bankDetails)}
      </Collapsible>

      <Collapsible title="Step 3: Signatory Details">
        {renderCard("Signatory Details", formattedData.step3.signatoryDetails)}
      </Collapsible>
    </div>
  );
};

export default React.memo(ReviewStep);
