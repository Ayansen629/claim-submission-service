/* Header.css */
:root {
  --header-bg: linear-gradient(90deg, #1e293b 0%, #0f172a 100%);
  --header-text: #e2e8f0;
  --header-active: #f8fafc;
  --header-icon: #f59e0b;
  --header-hover: rgba(226, 232, 240, 0.08);
  --header-border: rgba(255, 255, 255, 0.05);
  --header-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --header-height: 70px;
  --search-bg: rgba(255, 255, 255, 0.1);
  --dropdown-bg: #1e293b;
  --dropdown-border: rgba(255, 255, 255, 0.1);
  --badge-bg: #ef4444;
}

.custom-header {
  background: var(--header-bg);
  color: var(--header-text);
  height: var(--header-height);
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 1.5rem;
  box-shadow: var(--header-shadow);
  border-bottom: 1px solid var(--header-border);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.sidebar-toggle {
  background: none;
  border: none;
  color: var(--header-icon);
  font-size: 1.25rem;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
}

.sidebar-toggle:hover {
  background: var(--header-hover);
  color: var(--header-active);
}

.header-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.logo-img {
  height: 2.5rem;
  border-radius: 8px;
}

.app-title {
  font-size: 1.35rem;
  font-weight: 600;
  color: var(--header-active);
  margin: 0;
}

.header-search {
  flex: 1;
  max-width: 500px;
  margin: 0 2rem;
}

.search-container {
  position: relative;
  width: 100%;
}

.search-icon {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--header-icon);
}

.search-container input {
  width: 100%;
  padding: 0.65rem 1rem 0.65rem 2.5rem;
  border-radius: 6px;
  border: none;
  background: var(--search-bg);
  color: var(--header-active);
  font-size: 0.95rem;
  transition: all 0.2s;
}

.search-container input:focus {
  outline: none;
  background: rgba(255, 255, 255, 0.15);
  box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.2);
}

.header-right {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.notification-icon-container {
  position: relative;
}

.notification-icon {
  background: none;
  border: none;
  color: var(--header-text);
  font-size: 1.25rem;
  cursor: pointer;
  position: relative;
  transition: all 0.2s;
  width: 2.5rem;
  height: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.notification-icon:hover {
  color: var(--header-icon);
  background: var(--header-hover);
}

.notification-badge {
  position: absolute;
  top: 0.25rem;
  right: 0.25rem;
  background: var(--badge-bg);
  color: white;
  border-radius: 50%;
  width: 1.25rem;
  height: 1.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  font-weight: 600;
}

.notification-dropdown {
  position: absolute;
  right: 0;
  top: 100%;
  width: 320px;
  max-height: 400px;
  overflow-y: auto;
  background: var(--dropdown-bg);
  border-radius: 8px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  border: 1px solid var(--dropdown-border);
  padding: 0.5rem 0;
  z-index: 1100;
  margin-top: 0.5rem;
}

.notification-item {
  padding: 0.75rem 1rem;
  font-size: 0.9rem;
  transition: all 0.2s;
  cursor: pointer;
}

.notification-item:hover {
  background: var(--header-hover);
}

.notification-empty {
  padding: 1rem;
  text-align: center;
  color: #94a3b8;
  font-size: 0.9rem;
}

.user-menu-container {
  position: relative;
}

.user-profile {
  background: none;
  border: none;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: var(--header-text);
  cursor: pointer;
  transition: all 0.2s;
  padding: 0.25rem 0.5rem;
  border-radius: 6px;
}

.user-profile:hover {
  background: var(--header-hover);
}

.user-avatar {
  font-size: 2rem;
  color: var(--header-icon);
}

.user-name {
  font-weight: 500;
  font-size: 0.95rem;
}

.user-dropdown {
  position: absolute;
  right: 0;
  top: 100%;
  width: 240px;
  background: var(--dropdown-bg);
  border-radius: 8px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  border: 1px solid var(--dropdown-border);
  z-index: 1100;
  margin-top: 0.5rem;
}

.user-dropdown-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
}

.dropdown-avatar {
  font-size: 2.5rem;
  color: var(--header-icon);
}

.user-dropdown-name {
  font-weight: 600;
  font-size: 0.95rem;
}

.user-dropdown-email {
  font-size: 0.8rem;
  color: #94a3b8;
  margin-top: 0.25rem;
}

.dropdown-divider {
  height: 1px;
  background: var(--dropdown-border);
  margin: 0.5rem 0;
}

.dropdown-item {
  width: 100%;
  text-align: left;
  padding: 0.75rem 1rem;
  background: none;
  border: none;
  color: var(--header-text);
  cursor: pointer;
  font-size: 0.9rem;
  transition: all 0.2s;
}

.dropdown-item:hover {
  background: var(--header-hover);
  color: var(--header-active);
}

.logout-item {
  color: #ef4444;
}

.logout-item:hover {
  color: #fff;
  background: rgba(239, 68, 68, 0.1);
}

/* Responsive styles */
@media (max-width: 1024px) {
  .header-search {
    margin: 0 1rem;
  }
}

@media (max-width: 768px) {
  .custom-header {
    padding: 0 1rem;
  }
  
  .app-title {
    display: none;
  }
  
  .header-search {
    display: none;
  }
  
  .user-name {
    display: none;
  }
}
