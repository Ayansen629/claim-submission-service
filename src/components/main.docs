import React, { useState, useEffect, useRef } from "react";
import { useForm, FormProvider } from "react-hook-form";
import { Container, Row, Col, Button, Card, Badge } from "react-bootstrap";
import {
  FaFileUpload,
  FaArrowLeft,
  FaArrowRight,
  FaArrowAltCircleLeft,
  FaCheckCircle,
  FaUser,
  FaBuilding,
} from "react-icons/fa";
import { useNavigate, useParams, useLocation } from "react-router-dom";
import ActionDropdown from "../../../common/ActionDropdown";
import ApprovalModal from "../../../common/ApprovalModal";
import "./userViewPage.css";
import NewLoader from "../../../common/NewLoader";
import DynamicViewFields from "../../../common/DynamicViewFields";
import { useTranslation } from "react-i18next";
import { getFromLocalStorage } from "../../../../utils/localStorageUtils";
import {
  SERVICE_BASE,
  URLS_ENDPOINT,
} from "../../../../utils/urlsConstants.ts";
import { toast } from "react-toastify";
import { postData } from "../../../../services/http.service.ts";
import { handleErrorMessage } from "../../../../utils/errorMessageHandler";

const UserViewPage = () => {
  const { t } = useTranslation();
  const { type, id } = useParams();
  const location = useLocation();
  const applicationInfo = location.state?.application;
  const userRole = getFromLocalStorage("userRole");
  const userDetails = getFromLocalStorage("userDetails")
    ? JSON.parse(getFromLocalStorage("userDetails"))
    : "";
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isLoading, setIsLoading] = useState(true);
  const [showApprovalModal, setShowApprovalModal] = useState(false);
  const [selectedAction, setSelectedAction] = useState("");
  const [completedSteps, setCompletedSteps] = useState(new Set());
  const navigate = useNavigate();
  const [actionsFromAPI, setActionsFromAPI] = useState([]);
  const loaderRef = useRef();

  const isOwner = applicationInfo?.userType === "VESSEL_OWNER";
  const isBuilder = applicationInfo?.userType === "VESSEL_BUILDER";
  const totalSteps = isOwner ? 3 : 2;

  // File mapping function
  const mapFilesByFieldName = (fileStoreMap) => {
    const fileMap = {};

    fileStoreMap?.forEach((file) => {
      const fieldName = file.fieldName?.toLowerCase();

      // Owner file mappings
      if (fieldName?.includes("pancard")) {
        fileMap.panCardUpload = file;
      } else if (fieldName?.includes("gstcertificate")) {
        fileMap.gstCertificate = file;
      } else if (fieldName?.includes("addressproof")) {
        fileMap.addressProof = file;
      } else if (fieldName?.includes("letterofauthorization")) {
        fileMap.authorizationLetter = file;
      } else if (fieldName?.includes("companyregistrationcertificate")) {
        fileMap.companyRegistrationCertificate = file;
      } else if (fieldName?.includes("moacertificate")) {
        fileMap.moaCertificate = file;
      } else if (fieldName?.includes("aoacertificate")) {
        fileMap.aoaCertificate = file;
      }
      // Builder file mappings
      else if (fieldName?.includes("company details")) {
        fileMap.companyDetails = file;
      } else if (fieldName?.includes("pan card")) {
        fileMap.panCardUpload = file;
      } else if (fieldName?.includes("factory license")) {
        fileMap.factoryLicense = file;
      } else if (fieldName?.includes("fire certificate")) {
        fileMap.fireCertificate = file;
      } else if (fieldName?.includes("esipf registration")) {
        fileMap.esipfRegistration = file;
      } else if (fieldName?.includes("iso 9001")) {
        fileMap.iso9001 = file;
      } else if (fieldName?.includes("iso 14001")) {
        fileMap.iso14001 = file;
      } else if (fieldName?.includes("iso 45001")) {
        fileMap.iso45001 = file;
      } else if (fieldName?.includes("pollution certificate")) {
        fileMap.pollutionCertificate = file;
      } else if (fieldName?.includes("experience certificate")) {
        fileMap.experienceCertificate = file;
      } else if (fieldName?.includes("address proof")) {
        fileMap.addressProof = file;
      } else if (fieldName?.includes("gst certificate")) {
        fileMap.gstCertificate = file;
      }
    });

    return fileMap;
  };

  useEffect(() => {
    setIsLoading(true);
    loaderRef.current?.show?.();

    if (applicationInfo) {
      let processedData = {};

      if (isOwner && applicationInfo.ownerDetails) {
        const ownerData = applicationInfo.ownerDetails;
        const mappedFiles = mapFilesByFieldName(ownerData.fileStoreMap);

        processedData = {
          categoryOfOwner: ownerData.categoryOfOwner,
          ownerCompanyName: ownerData.ownerCompanyName,
          emailId: ownerData.emailId,
          phoneNumber: ownerData.phoneNumber,
          panNo: ownerData.panNo,
          gstNo: ownerData.gstNo,
          addressLine1: ownerData.addressLine1,
          addressLine2: ownerData.addressLine2,
          pin: ownerData.pin,
          district: ownerData.district,
          state: ownerData.state,
          country: ownerData.country,
          authorisedFname: ownerData.authorisedFname,
          authorisedLname: ownerData.authorisedLname,
          authorisedMob: ownerData.authorisedMob,
          authorisedEmail: ownerData.authorisedEmail,
          aadharNumber: ownerData.aadharNumber,
          tradeLicenseNumber: ownerData.tradeLicenseNumber,
          cinNo: ownerData.cinNo,
          dinNo: ownerData.dinNo,
          registrationNumber:
            applicationInfo.userBasicDetails.registrationNumber,
          status: applicationInfo.userBasicDetails.isActive
            ? "Approved"
            : "Pending Review",
          fileStoreMap: ownerData.fileStoreMap || [],
          ...mappedFiles,
        };
      } else if (isBuilder && applicationInfo.builderDetails) {
        const builderData = applicationInfo.builderDetails;
        const mappedFiles = mapFilesByFieldName(builderData.fileStoreMap);

        processedData = {
          builderName: builderData.builderName,
          emailId: builderData.emailId,
          phoneNumber: builderData.phone,
          panNo: builderData.panNo,
          gstNo: builderData.gstNo,
          addressLine1: builderData.addressLine1,
          addressLine2: builderData.addressLine2,
          pin: builderData.pin,
          district: builderData.district,
          state: builderData.state,
          country: builderData.country,
          registrationNumber:
            applicationInfo.userBasicDetails.registrationNumber,
          status: applicationInfo.userBasicDetails.isActive
            ? "Approved"
            : "Pending Review",
          fileStoreMap: builderData.fileStoreMap || [],
          ...mappedFiles,
        };
      }

      setFormData(processedData);
      setActionsFromAPI(
        applicationInfo?.processActionMapResponce?.processs[0]?.actions || []
      );
      setCompletedSteps(new Set([1]));
    }

    setTimeout(() => {
      setIsLoading(false);
      loaderRef.current?.hide?.();
    }, 500);
  }, [applicationInfo, isOwner, isBuilder]);

  const methods = useForm({ defaultValues: { country: "India" } });
  const { setValue } = methods;

  useEffect(() => {
    if (!isLoading && Object.keys(formData).length > 0) {
      Object.keys(formData).forEach((key) => {
        if (formData[key] !== undefined && formData[key] !== null) {
          setValue(key, formData[key]);
        }
      });
    }
  }, [isLoading, formData, setValue]);

  const handleActionClick = (action) => {
    setSelectedAction(action);
    setShowApprovalModal(true);
  };

  const workflowApplicationSubmit = async (modalFormData) => {
    loaderRef?.current?.show();

    try {
      const URL =
        SERVICE_BASE.IWT_WORKFLOW +
        URLS_ENDPOINT.WORK_FLOW_SERVICE.WORKFLOW_ACTION;

      const payload = {
        applicationNo: applicationInfo?.userBasicDetails?.registrationNumber,
        processId:
          applicationInfo?.processActionMapResponce?.processs?.[0]?.processId,
        actionId: selectedAction?.actionId,
        assignerRole: userRole,
        assignerName: userDetails?.userName || "",
        fileId: modalFormData?.document?.url || "",
        remarks: modalFormData?.reason,
      };

      const response = await postData(URL, payload);
      if (response && response?.status === 200 && response?.data?.responseStatus?.status === '200') {
        toast.success(
          response?.data?.responseStatus?.message || "Action submitted successfully"
        );
        loaderRef?.current?.hide();
        handleCloseModal();
        setTimeout(()=>{
          navigate("/user-registration/view");
        },2000)
      } else {
        loaderRef?.current?.hide();
        toast.info(
          response?.data?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const handleCloseModal = () => {
    setShowApprovalModal(false);
    setSelectedAction("");
  };

  const getFormFieldsConfig = () => {
    if (isOwner) {
      return {
        step1: [
          {
            name: "categoryOfOwner",
            label: t("vesselOwnerRegistration.Category of Owner"),
            type: "text",
            colSize: 6,
          },
          {
            name: "ownerCompanyName",
            label: t("vesselOwnerRegistration.Owner/Company Name"),
            type: "text",
            colSize: 6,
          },
          {
            name: "emailId",
            label: t("vesselOwnerRegistration.Email ID"),
            type: "email",
            colSize: 6,
          },
          {
            name: "phoneNumber",
            label: t("vesselOwnerRegistration.Phone Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "panNo",
            label: t("vesselOwnerRegistration.PAN Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "aadharNumber",
            label: t("vesselOwnerRegistration.aadharNo"),
            type: "text",
            colSize: 6,
          },
          {
            name: "tradeLicenseNumber",
            label: t("vesselOwnerRegistration.tradeLicense"),
            type: "text",
            colSize: 6,
          },
          {
            name: "gstNo",
            label: t("vesselOwnerRegistration.GST Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "addressLine1",
            label: t("vesselOwnerRegistration.Address Line-1"),
            type: "text",
            colSize: 6,
          },
          {
            name: "addressLine2",
            label: t("vesselOwnerRegistration.Address Line-2"),
            type: "text",
            colSize: 6,
          },
          {
            name: "pin",
            label: t("vesselOwnerRegistration.PIN"),
            type: "text",
            colSize: 6,
          },
          {
            name: "district",
            label: t("vesselOwnerRegistration.District"),
            type: "text",
            colSize: 6,
          },
          {
            name: "state",
            label: t("vesselOwnerRegistration.State / UT"),
            type: "text",
            colSize: 6,
          },
          {
            name: "country",
            label: t("vesselOwnerRegistration.Country"),
            type: "text",
            colSize: 6,
          },
        ],
        step2: [
          {
            name: "authorisedFname",
            label: t("vesselOwnerRegistration.First Name"),
            type: "text",
            colSize: 6,
          },
          {
            name: "authorisedLname",
            label: t("vesselOwnerRegistration.Last Name"),
            type: "text",
            colSize: 6,
          },
          {
            name: "authorisedMob",
            label: t("vesselOwnerRegistration.Primary Mobile Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "authorisedEmail",
            label: t("vesselOwnerRegistration.Email ID"),
            type: "email",
            colSize: 6,
          },
          {
            name: "authorizationLetter",
            label: t("vesselOwnerRegistration.Letter of Authorization"),
            type: "file",
            colSize: 6,
          },
        ],
        step3: [
          {
            name: "panCardUpload",
            label: t("vesselOwnerRegistration.PAN Card"),
            type: "file",
            colSize: 6,
          },
          {
            name: "gstCertificate",
            label: t("vesselOwnerRegistration.GST Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "addressProof",
            label: t("vesselOwnerRegistration.Address Proof"),
            type: "file",
            colSize: 6,
          },
          {
            name: "companyRegistrationCertificate",
            label: t(
              "vesselOwnerRegistration.Company Registration Certificate"
            ),
            type: "file",
            colSize: 6,
          },
          {
            name: "moaCertificate",
            label: t("vesselOwnerRegistration.MOA Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "aoaCertificate",
            label: t("vesselOwnerRegistration.AOA Certificate"),
            type: "file",
            colSize: 6,
          },
        ],
      };
    } else {
      return {
        step1: [
          {
            name: "builderName",
            label: t("builderRegistration.builderName"),
            type: "text",
            colSize: 6,
          },
          {
            name: "emailId",
            label: t("builderRegistration.Email ID"),
            type: "email",
            colSize: 6,
          },
          {
            name: "phoneNumber",
            label: t("builderRegistration.Phone Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "panNo",
            label: t("builderRegistration.PAN Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "gstNo",
            label: t("builderRegistration.GST Number"),
            type: "text",
            colSize: 6,
          },
          {
            name: "addressLine1",
            label: t("builderRegistration.Address Line-1"),
            type: "text",
            colSize: 6,
          },
          {
            name: "addressLine2",
            label: t("builderRegistration.Address Line-2"),
            type: "text",
            colSize: 6,
          },
          {
            name: "pin",
            label: t("builderRegistration.PIN"),
            type: "text",
            colSize: 6,
          },
          {
            name: "district",
            label: t("builderRegistration.District"),
            type: "text",
            colSize: 6,
          },
          {
            name: "state",
            label: t("builderRegistration.State / UT"),
            type: "text",
            colSize: 6,
          },
          {
            name: "country",
            label: t("builderRegistration.Country"),
            type: "text",
            colSize: 6,
          },
        ],
        step2: [
          {
            name: "companyDetails",
            label: t("builderRegistration.Company Details"),
            type: "file",
            colSize: 6,
          },
          {
            name: "gstCertificate",
            label: t("builderRegistration.GST Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "panCardUpload",
            label: t("builderRegistration.PAN Card"),
            type: "file",
            colSize: 6,
          },
          {
            name: "factoryLicense",
            label: t("builderRegistration.Factory License"),
            type: "file",
            colSize: 6,
          },
          {
            name: "addressProof",
            label: t("builderRegistration.Address Proof"),
            type: "file",
            colSize: 6,
          },
          {
            name: "fireCertificate",
            label: t("builderRegistration.Fire Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "esipfRegistration",
            label: t("builderRegistration.ESIPF Registration"),
            type: "file",
            colSize: 6,
          },
          {
            name: "iso9001",
            label: t("builderRegistration.ISO 9001 Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "iso14001",
            label: t("builderRegistration.ISO 14001 Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "iso45001",
            label: t("builderRegistration.ISO 45001 Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "pollutionCertificate",
            label: t("builderRegistration.Pollution Certificate"),
            type: "file",
            colSize: 6,
          },
          {
            name: "experienceCertificate",
            label: t("builderRegistration.Experience Certificate"),
            type: "file",
            colSize: 6,
          },
        ],
      };
    }
  };

  const formFields = getFormFieldsConfig();

  const getDisabledFormFieldsConfig = () => {
    const config = {};
    Object.keys(formFields).forEach((stepKey) => {
      config[stepKey] = formFields[stepKey].map((field) => ({
        ...field,
        disabled: true,
        inputClassName: "disabled-field",
      }));
    });
    return config;
  };

  const disabledFormFields = getDisabledFormFieldsConfig();

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1:
        return disabledFormFields.step1;
      case 2:
        return disabledFormFields.step2;
      case 3:
        return disabledFormFields.step3 || [];
      default:
        return [];
    }
  };

  const handleNext = () => {
    if (currentStep < totalSteps) {
      setCompletedSteps((prev) => new Set([...prev, currentStep]));
      setCurrentStep(currentStep + 1);
      window.scrollTo(0, 0);
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const handleBackToList = () => {
    navigate("/user-registration/view");
  };

  const getStatusBadge = (status) => {
    const statusMap = {
      "Pending Review": "warning",
      Pending: "warning",
      Approved: "success",
      Completed: "success",
      Rejected: "danger",
      Processing: "info",
    };
    return (
      <Badge bg={statusMap[status] || "secondary"} className="status-badge">
        {status}
      </Badge>
    );
  };

  const getStepIcon = (stepNumber) => {
    if (completedSteps.has(stepNumber)) {
      return <FaCheckCircle className="text-white" size={12} />;
    }

    if (isOwner) {
      const ownerIcons = [FaUser, FaUser, FaFileUpload];
      return currentStep === stepNumber
        ? React.createElement(ownerIcons[stepNumber - 1], {
            className: "text-white",
            size: 12,
          })
        : stepNumber;
    } else {
      const builderIcons = [FaBuilding, FaFileUpload];
      return currentStep === stepNumber
        ? React.createElement(builderIcons[stepNumber - 1], {
            className: "text-white",
            size: 12,
          })
        : stepNumber;
    }
  };

  const getStepTitles = () => {
    if (isOwner) {
      return [
        t("vesselOwnerRegistration.Vessel Owner Details"),
        t("vesselOwnerRegistration.Authorized Person's Details"),
        t("vesselOwnerRegistration.Documents Upload"),
      ];
    } else {
      return [
        t("builderRegistration.Vessel Builder Details"),
        t("builderRegistration.Documents Upload"),
      ];
    }
  };

  const stepTitles = getStepTitles();

  if (isLoading) {
    return <NewLoader ref={loaderRef} />;
  }

  return (
    <>
      <Container fluid className="py-4 officer-view-container">
        <Row className="justify-content-center">
          <Col size={12}>
            <Card className="shadow-lg border-0 modern-card">
              <Card.Header className="modern-header">
                <div className="header-content">
                  <div className="header-left">
                    <button className="back-btn" style={{ width: "2.4rem" }} onClick={handleBackToList}>
                      <FaArrowAltCircleLeft style={{ verticalAlign: "baseline" }} size={16} />
                    </button>
                  </div>

                  <div className="header-center">
                    <h2 className="app-title">Application Review</h2>
                    <div className="app-details">
                      <div className="app-number">
                        <span className="app-label">ID:</span>
                        <span className="app-id">
                          {formData.registrationNumber || "N/A"}
                        </span>
                      </div>
                      <div className="user-type">
                        <span className="type-badge">
                          {isOwner ? "Owner" : "Builder"}
                        </span>
                      </div>
                    </div>
                  </div>

                  {/* <div className="header-right">
                    {getStatusBadge(formData.status)}
                  </div> */}
                </div>
              </Card.Header>

              <Card.Body className="modern-body">
                <div className="stepper-container">
                  {Array.from({ length: totalSteps }, (_, i) => i + 1).map(
                    (step, index) => (
                      <React.Fragment key={step}>
                        <div
                          className={`stepper-step ${
                            currentStep === step ? "active" : ""
                          } ${completedSteps.has(step) ? "completed" : ""}`}
                        >
                          <div className="step-circle">{getStepIcon(step)}</div>
                          <div className="step-label">
                            {stepTitles[step - 1]}
                          </div>
                        </div>

                        {index < totalSteps - 1 && (
                          <div className="step-connector"></div>
                        )}
                      </React.Fragment>
                    )
                  )}
                </div>

                <FormProvider {...methods}>
                  <form>
                    <div className="form-section">
                      <Row className="g-3">
                        <DynamicViewFields
                          fields={getCurrentStepFields()}
                          setFormData={setFormData}
                          formData={formData}
                        />
                      </Row>
                    </div>

                    <div className="form-actions">
                      {currentStep > 1 && (
                        <Button
                          variant="outline-secondary"
                          onClick={handlePrevious}
                          className="action-btn prev-btn"
                        >
                          <FaArrowLeft size={12} className="me-2" /> Previous
                        </Button>
                      )}

                      {currentStep < totalSteps ? (
                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="action-btn next-btn"
                          style={
                            currentStep === 1 ? { marginLeft: "auto" } : {}
                          }
                        >
                          Next <FaArrowRight size={12} className="ms-2" />
                        </Button>
                      ) : (
                        <ActionDropdown
                          actions={actionsFromAPI}
                          onActionClick={handleActionClick}
                          variant="success"
                          className="action-dropdown"
                        />
                      )}
                    </div>
                  </form>
                </FormProvider>
              </Card.Body>
            </Card>
          </Col>
        </Row>

        <ApprovalModal
          show={showApprovalModal}
          handleClose={handleCloseModal}
          handleSubmitData={workflowApplicationSubmit}
          selectedAction={selectedAction}
        />
      </Container>
    </>
  );
};

export default UserViewPage

import React, { useState, useEffect, useRef } from "react";
import { useForm, FormProvider } from "react-hook-form";
import { useTranslation } from "react-i18next";
import { Dropdown } from "react-bootstrap";
import { FaGlobe, FaCheck } from "react-icons/fa";
import { FiFlag } from "react-icons/fi";
import { GiIndiaGate } from "react-icons/gi";
import './stepper-styles.css';

import {
  Container,
  Row,
  Col,
  Form,
  Button,
  Card,
  Image,
  Alert,
} from "react-bootstrap";
import {
  FaUser,
  FaBuilding,
  FaFileUpload,
  FaArrowRight,
  FaArrowLeft,
  FaIdCard,
  FaEnvelope,
  FaPhone,
  FaMapMarkerAlt,
  FaUpload,
  FaShip,
} from "react-icons/fa";
import "./UserRegistration.css";
import IWT_FULL_IMG from "../../../assets/images/iwt-whole.jpg";
import { toast } from "react-toastify";
import {
  getData,
  postData,
  postFORMdata,
} from "../../../services/http.service.ts";
import { URLS_ENDPOINT } from "../../../utils/urlsConstants.ts";
import { handleErrorMessage } from "../../../utils/errorMessageHandler.js";
import {
  createOwnerOrBuilderPayload,
  mapToVesselUserDetails,
} from "../model/mapToVesselModel.ts";
import NewLoader from "../../common/NewLoader.js";
import InputText from "../../common/InputText.tsx";
import InputFile from "../../common/InputFile.tsx";
import i18n from "i18next";
import InputSelect from "../../common/InputSelect.tsx";
import {
  MasterDataProvider,
  useMasterData,
} from "../../context/MasterDataContext.js";
import { useLanguageContext } from "../../common/LanguageContext.js";
import { CONSTANT_REGEX } from "../../../utils/constants.ts";

const VesselOwnerRegistrationPage = () => {
  const { i18n, t } = useTranslation();
  const { changeLanguage, language } = useLanguageContext();
  const isCompMount = useRef(true);

  const { masterData } = useMasterData();

  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({});
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [successMessage, setSuccessMessage] = useState("");
  const[applicationData,setApplicationData]=useState(null);
  const [isCompany, setIsCompany] = useState(false);
  const [isExemptCategory, setIsExemptCategory] = useState(false);
  const [validationMessage, setValidationMessage] = useState("");
  const loaderRef = useRef();
  const PUBLIC_URL = process.env.REACT_APP_PUBLIC_URL;
  const methods = useForm({
    mode: "onBlur",
    defaultValues: { categoryOfOwner: "", country: "India" },
  });

  const {
    register,
    handleSubmit,
    formState: { errors },
    trigger,
    setValue,
    getValues,
    watch,
    clearErrors,
    setError,
  } = methods;

  const totalSteps = 3;

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [i18n.language]);

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach((key) => {
        if (formData[key] !== undefined) {
          console.log("Setting value for", key, formData[key]);
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [currentStep, setValue, formData]);

  const formFields = {
    step1: [
      {
        name: "categoryOfOwner",
        label: t("vesselOwnerRegistration.Category of Owner"),
        type: "select",
        options: [
          ...(masterData?.ownerTypes?.map((type) => ({
            value: type.valueCode,
            label: type.valueLabel,
            isCompany: type.isCompany,
          })) || []),
        ],
        required: true,
        icon: FaBuilding,
        colSize: 6,
        validation: { required: t("vesselOwnerRegistration.OwnerCatRequired") },
      },
      {
        name: "ownerCompanyName",
        label: t("vesselOwnerRegistration.Owner/Company Name"),
        type: "text",
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 150,
        placeholder: t("vesselOwnerRegistration.Enter owner or company name"),
        validation: {
          required: t("vesselOwnerRegistration.Owner name is required"),
        },
      },
      {
        name: "emailId",
        label: t("vesselOwnerRegistration.Email ID"),
        type: "email",
        required: true,
        icon: FaEnvelope,
        maxlength: 100,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Enter email address"),
        validation: {
          required: t("vesselOwnerRegistration.Email is required"),
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: t("vesselOwnerRegistration.Invalid email address"),
          },
        },
      },
      {
        name: "phoneNumber",
        label: t("vesselOwnerRegistration.Phone Number"),
        type: "text",
        required: true,
        icon: FaPhone,
        colSize: 6,
        maxlength: 10,
        placeholder: t("vesselOwnerRegistration.Enter 10-digit phone number"),
        validation: {
          required: t("vesselOwnerRegistration.Phone number is required"),
          pattern: {
            value: /^[0-9]{10}$/,
            message: t(
              "vesselOwnerRegistration.Phone number must be 10 digits"
            ),
          },
        },
      },

      {
        name: "panNo",
        label: t("vesselOwnerRegistration.PAN Number"),
        type: "text",
        required: !isExemptCategory,
        icon: FaIdCard,
        colSize: 6,
        maxlength: 10,

        placeholder: t(
          "vesselOwnerRegistration.Enter PAN number (e.g., ABCDE1234F)"
        ),
        validation: !isExemptCategory ? {
          required: t("vesselOwnerRegistration.PAN number is required"),
          pattern: {
            value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
            message: t("vesselOwnerRegistration.Invalid PAN format"),
          },
        } : {},
      },

      {
        name: "aadharNumber",
        key: "aadharNo",
        label: t("vesselOwnerRegistration.aadharNo"),
        type: "text",
        required: !isExemptCategory,
        icon: FaIdCard,
        colSize: 6,
        maxlength: 12,
        placeholder: t("vesselOwnerRegistration.aadharNoPhl"),
        validation: !isExemptCategory ? {
          required: t("vesselOwnerRegistration.aadharNoReq"),
          pattern: {
            value: CONSTANT_REGEX.AADHAR,
            message: t("vesselOwnerRegistration.aadharNoInv"),
          },
        } : {},
      },

      {
        name: "tradeLicenseNumber",
        key: "tradeLicenseNo.",
        label: t("vesselOwnerRegistration.tradeLicense"),
        type: "text",
        required: !isExemptCategory,
        icon: FaIdCard,
        colSize: 6,
        maxlength: 50,
        placeholder: t("vesselOwnerRegistration.tradeLicensePhl"),
        validation: !isExemptCategory ? {
          required: t("vesselOwnerRegistration.tradeLicenseReq"),
          pattern: {
            value: CONSTANT_REGEX.TRADE_LICENSE,
            message: t("vesselOwnerRegistration.tradeLicenseInv"),
          },
        } : {},
      },

      {
        name: "gstNo",
        label: t("vesselOwnerRegistration.GST Number"),
        type: "text",
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: t(
          "vesselOwnerRegistration.Enter GST number (if applicable)"
        ),
        validation: {
          pattern: {
            value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
            message: t("vesselOwnerRegistration.Invalid GST format"),
          },
        },
      },
      {
        name: "cinNo",
        label: t("vesselOwnerRegistration.CIN Number"),
        type: "text",
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Enter CIN number"),
        validation: {
          pattern: {
            value: /^[A-Z]{1}[0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$/,
            message: t("vesselOwnerRegistration.Invalid CIN format"),
          },
        },
        showIf: () => isCompany,
      },
      {
        name: "dinNo",
        label: t("vesselOwnerRegistration.DIN Number"),
        type: "text",
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Enter DIN number"),
        validation: {
          pattern: {
            value: /^[0-9]{8}$/,
            message: t("vesselOwnerRegistration.DIN must be 8 digits"),
          },
        },
        showIf: () => isCompany,
      },
      {
        name: "addressLine1",
        label: t("vesselOwnerRegistration.Address Line-1"),
        type: "text",
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 150,
        placeholder: t("vesselOwnerRegistration.Enter address line 1"),
        validation: {
          required: t("vesselOwnerRegistration.Address is required"),
        },
      },
      {
        name: "addressLine2",
        label: t("vesselOwnerRegistration.Address Line-2"),
        type: "text",
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 150,
        placeholder: t(
          "vesselOwnerRegistration.Enter address line 2 (optional)"
        ),
      },
      {
        name: "pin",
        label: t("vesselOwnerRegistration.PIN"),
        type: "text",
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 6,
        placeholder: t("vesselOwnerRegistration.Enter 6-digit PIN code"),
        validation: {
          required: t("vesselOwnerRegistration.PIN code is required"),
          pattern: {
            value: /^[0-9]{6}$/,
            message: t("vesselOwnerRegistration.PIN must be 6 digits"),
          },
        },
        onChange: (e, setValue, watch) => {
          const changedValue = e?.target?.value || "";
          if (changedValue?.length === 6) {
            setValue("district", "");
            setValue("state", "");
            setValue("country", "India");
            getDetailsByPIN(changedValue);
          }
        },
      },
      {
        name: "district",
        label: t("vesselOwnerRegistration.District"),
        type: "text",
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Please enter district"),
      },
      {
        name: "state",
        label: t("vesselOwnerRegistration.State / UT"),
        type: "text",
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Please enter state"),
      },
      {
        name: "country",
        label: t("vesselOwnerRegistration.Country"),
        type: "text",
        required: false,
        disabled: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Please enter country"),
      },
    ],
    step2: [
      {
        name: "authorisedFname",
        label: t("vesselOwnerRegistration.First Name"),
        type: "text",
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 50,
        placeholder: t("Enter first name"),
        validation: {
          required: t("vesselOwnerRegistration.First name is required"),
        },
      },
      {
        name: "authorisedLname",
        maxlength: 50,
        label: t("vesselOwnerRegistration.Last Name"),
        type: "text",
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: t("vesselOwnerRegistration.Enter last name"),
        validation: {
          required: t("vesselOwnerRegistration.Last name is required"),
        },
      },
      {
        name: "authorisedMob",
        label: t("vesselOwnerRegistration.Primary Mobile Number"),
        type: "text",
        required: true,
        icon: FaPhone,
        colSize: 6,
        maxlength: 10,
        placeholder: t("vesselOwnerRegistration.Enter 10-digit mobile number"),
        validation: {
          required: t("vesselOwnerRegistration.Mobile number is required"),
          pattern: {
            value: /^[0-9]{10}$/,
            message: t(
              "vesselOwnerRegistration.Mobile number must be 10 digits"
            ),
          },
        },
      },
      {
        name: "authorisedEmail",
        label: t("vesselOwnerRegistration.Email ID"),
        type: "email",
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        maxlength: 100,
        placeholder: t("vesselOwnerRegistration.Enter email address"),
        validation: {
          required: t("vesselOwnerRegistration.Email is required"),
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: t("vesselOwnerRegistration.Invalid email address"),
          },
        },
      },
      {
        name: "authorizationLetter",
        label: t("vesselOwnerRegistration.Letter of Authorization"),
        type: "file",
        required: false,
        colSize: 12,
      },
    ],
step3: [
  {
    name: "panCardUpload",
    label: t("vesselOwnerRegistration.PAN Card"),
    type: "file",
    required: () => formData.categoryOfOwner === "INDIVIDUAL",
    colSize: 6,
  },
  {
    name: "gstCertificate",
    label: t("vesselOwnerRegistration.GST Certificate"),
    type: "file",
    required: false,
    colSize: 6,
  },
  {
    name: "addressProof",
    label: t("vesselOwnerRegistration.Address Proof"),
    type: "file",
    required: () => formData.categoryOfOwner === "INDIVIDUAL",
    colSize: 6,
  },
   // {
      //   name: "companyRegistrationCertificate",
      //   label: t("vesselOwnerRegistration.Company Registration Certificate"),
      //   type: "file",
      //   required: false,
      //   colSize: 6,
      // },
  {
    name: "tradeLicenseUpload",
    label: t("vesselOwnerRegistration.Trade License"),
    type: "file",
    required: () => formData.categoryOfOwner === "INDIVIDUAL",
    colSize: 6,
    showIf: () => !isExemptCategory,
  },
  {
    name: "companyRegistrationCertificate",
    label: t("Company Registration Certificate"),
    type: "file",
    required: false,
    colSize: 6,
    showIf: () => isCompany,
  },
  {
    name: "moaCertificate",
    label: t("vesselOwnerRegistration.MOA Certificate"),
    type: "file",
    required: false,
    colSize: 6,
    validation: {},
    showIf: () => isCompany,
  },
  {
    name: "aoaCertificate",
    label: t("vesselOwnerRegistration.AOA Certificate"),
    type: "file",
    required: false,
    colSize: 6,
    validation: {},
    showIf: () => isCompany,
  },
],
  };

  const getDetailsByPIN = async (pinCode) => {
    try {
      const URL =
        PUBLIC_URL +
        URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE +
        pinCode;
      loaderRef.current?.show();
      const response = await getData(URL);
      if (response?.status === 200 && response?.data?.length > 0) {
        setValue("district", response?.data[0]?.district);
        setValue("state", response?.data[0]?.stateName);
        loaderRef?.current?.hide();
      } else {
        loaderRef?.current?.hide();
        toast.info("No Data Found! Pleasee enter manually..", {
          position: "top-right",
        });
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const getCurrentStepFields = () => {
    let fields = [];
    switch (currentStep) {
      case 1:
        fields = formFields.step1;
        break;
      case 2:
        fields = formFields.step2;
        break;
      case 3:
        fields = formFields.step3;
        break;
      default:
        fields = [];
    }

    return fields.filter((field) => !field.showIf || field.showIf());
  };


const validateStep = async () => {
  const currentFields = getCurrentStepFields();
  const requiredFields = currentFields.filter((field) => {
    
    if (isExemptCategory && ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(field.name)) {
      return false;
    }
    
    
    if (typeof field.required === 'function') {
      return field.required();
    }
    
    return field.required;
  });

  requiredFields.forEach((field) => {
    const value = getValues(field.name);
    if (!value || value === "") {
      setError(field.name, {
        type: "required",
        message: `${field.label} is required`,
      });
    } else if (field.validation && field.validation.pattern) {
      const pattern = field.validation.pattern.value;
      if (!pattern.test(value)) {
        setError(field.name, {
          type: "pattern",
          message: field.validation.pattern.message,
        });
      }
    }
  });

  const fieldsToValidate = currentFields
    .filter((field) => {
      if (isExemptCategory && ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(field.name)) {
        return false;
      }
      return true;
    })
    .map((field) => field.name);
  return await trigger(fieldsToValidate);
};


  const handleNext = async () => {
    const isStepValid = await validateStep();

    if (isStepValid) {
      setValidationMessage("");

      const currentValues = getValues();

      setFormData((prev) => {
        const newFormData = { ...prev };

        Object.keys(currentValues).forEach((key) => {
          if (currentValues[key] !== undefined) {
            newFormData[key] = currentValues[key];
          }
        });

        return newFormData;
      });

      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    }
  };

  const handlePrevious = () => {
    const currentValues = getValues();

    const fileFields = getCurrentStepFields().filter(
      (field) => field.type === "file"
    );
    fileFields.forEach((field) => {
      if (currentValues[field.name]) {
        setFormData((prev) => ({
          ...prev,
          [field.name]: currentValues[field.name],
        }));
      }
    });

    setFormData((prev) => ({ ...prev, ...currentValues }));

    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
    setValidationMessage("");
  };

const onSubmit = (data) => {
  const finalData = { ...formData, ...data };

  const payload = createOwnerOrBuilderPayload("VESSEL_OWNER", {
    ...finalData,
  });

  const files = [
    finalData?.addressProof,
    finalData?.panCardUpload,
    finalData?.gstCertificate,
    finalData?.authorizationLetter,
    finalData?.companyRegistrationCertificate,
    finalData?.moaCertificate,
    finalData?.aoaCertificate,
    finalData?.tradeLicenseUpload,
  ];
  const fd = new FormData();

  fd.append(
    "request",
    new Blob([JSON.stringify(payload)], { type: "application/json" })
  );
  files?.forEach((file) => {
    if (file) {
      fd.append(`files`, file);
    }
  });
  submitUserDetails(fd);
};

  const submitUserDetails = async (payload) => {
    try {
      const URL =
        process.env.REACT_APP_AUTH_URL +
        URLS_ENDPOINT.USER_SERVICE.CREATE_UPDATE_USER;
      loaderRef.current?.show();
      const response = await postFORMdata(URL, payload);
      const apiRes = { ...response?.data };
      if (
        response?.status === 200 &&
        apiRes?.responseStatus?.status === "200"
      ) {
        loaderRef?.current?.hide();
        setIsSubmitted(true);
        setSuccessMessage(apiRes?.responseStatus?.message);
        setApplicationData(apiRes?.data);
        window.scrollTo(0, 0);
      } else {
        loaderRef?.current?.hide();
        toast.info(
          apiRes?.responseStatus?.message || "Something went wrong..",
          { position: "top-right" }
        );
      }
    } catch (err) {
      console.log(err);
      loaderRef?.current?.hide();
      handleErrorMessage(err?.response?.data);
    }
  };

  const DynamicField = ({ field }) => {
    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case "select":
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register(field?.name, {
              ...field.validation,
            })}
            errors={errors}
            icon={field.icon}
            className="mb-3"
             // onChange={(value, selObj) => {
            //   setIsCompany(selObj?.isCompany || false);
            //   const isExempt = value === "STATE" || value === "STATE GOVERNMENT/ PANCHAYET" || value === "CENTRAL" || value==="PRIVATE_LTD" ;
            //   setIsExemptCategory(isExempt);
            //   setValue(field.name, value);
              
            //   if (isExempt) {
            //     clearErrors(["panNo", "aadharNumber", "tradeLicenseNumber"]);
            //   }
              
            //   if (errors[field.name]) {
            //     clearErrors(field.name);
            //   }
            //   setFormData((prev) => ({
            //     ...prev,
            //     [field.name]: value,
            //   }));
            // }}
          onChange={(value, selObj) => {
  setIsCompany(selObj?.isCompany || false);
  
  const exemptCategories = ["CENTRAL", "STATE", "STATE GOVERNMENT/ PANCHAYET", "PRIVATE_LTD"];
  const isExempt = exemptCategories.includes(value);
  setIsExemptCategory(isExempt);
  
  setValue(field.name, value);
  
  if (isExempt) {
    clearErrors(["panNo", "aadharNumber", "tradeLicenseNumber"]);
  }
  
  if (errors[field.name]) {
    clearErrors(field.name);
  }
  setFormData((prev) => ({
    ...prev,
    [field.name]: value,
  }));
}}
            value={formData[field.name] || watch(field.name)}
            autoFocus={field.autoFocus}
          />
        );

    case "file":
  return (
    <InputFile
      label={field.label}
      required={typeof field.required === 'function' ? field.required() : field.required}
      name={field.name}
      key={field.name}
      register={register(field.name, {
        required: (typeof field.required === 'function' ? field.required() : field.required) 
          ? `${field.label} is required` 
          : false
      })}
      errors={errors}
      onChange={(e) => {
        if (e.target.files && e.target.files[0]) {
          const file = e.target.files[0];
          const extension = file.name.substring(file.name.lastIndexOf("."));
          
          const modifiedFile = new File([file], `${field.label.replace(/\s+/g, "").toLowerCase()}${extension}`, {
            type: file.type,
            lastModified: file.lastModified
          });
          
          setValue(field.name, modifiedFile);
          
          setFormData((prev) => {
            const updated = { ...prev, [field.name]: modifiedFile };
            return updated;
          });
          
          if (errors[field.name]) {
            clearErrors(field.name);
          }
          
          const validTypes = [
            "application/pdf",
            "image/jpeg",
            "image/png",
            "image/jpg",
          ];
          if (!validTypes.includes(file.type)) {
            setError(field.name, {
              type: "manual",
              message: "Only PDF, JPG or PNG files are allowed",
            });
          }
          
          if (file.size > 2 * 1024 * 1024) {
            setError(field.name, {
              type: "manual",
              message: "File size should not exceed 2MB",
            });
          }
        }
      }}
      className="mb-3"
      watch={watch}
      accept=".pdf,.jpg,.jpeg,.png"
      defaultValue={formData[field.name]}
      autoFocus={field.autoFocus}
      style={{
        borderColor: errors[field.name] ? "#dc3545" : "#ced4da",
        backgroundColor: errors[field.name] ? "#fff8f8" : "white",
      }}
    />
  );

      default:
        return (
          <InputText
            label={field.label}
            required={isExemptCategory && ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(field.name) ? false : field.required}
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...(isExemptCategory && ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(field.name) ? {} : field.validation),
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className="mb-3"
            style={{
              borderColor: (errors[field.name] && !(isExemptCategory && ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(field.name))) ? "#dc3545" : "#ced4da",
              backgroundColor: (errors[field.name] && !(isExemptCategory && ["panNo", "aadharNumber", "tradeLicenseNumber"].includes(field.name))) ? "#fff8f8" : "white",
            }}
            autoFocus={field.autoFocus}
          />
        );
    }
  };

  const stepTitles = [
    {
      title: t("vesselOwnerRegistration.Vessel Owner Details"),
      icon: FaBuilding,
    },
    {
      title: t("vesselOwnerRegistration.Authorized Person's Details"),
      icon: FaUser,
    },
    {
      title: t("vesselOwnerRegistration.Documents Upload"),
      icon: FaFileUpload,
    },
  ];

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="registration-container py-5">
        <div
          style={{
            position: "absolute",
            top: "10px",
            right: "10px",
            zIndex: 1050,
          }}
        >
          <Dropdown>
            <Dropdown.Toggle
              variant="link"
              className="p-0 d-flex align-items-center gap-1"
              style={{
                color: "#fff",
                textDecoration: "none",
                fontSize: "1.5rem",
                marginTop: "10px",
              }}
            >
              <FaGlobe />
            </Dropdown.Toggle>
            <Dropdown.Menu className="language-dropdown-menu">
              <Dropdown.Item
                onClick={() => changeLanguage("en")}
                active={language === "en"}
                className="d-flex align-items-center gap-2"
              >
                <FiFlag size={18} style={{ color: "#2563eb" }} />
                <span>English</span>
                {language === "en" && (
                  <FaCheck className="ms-auto text-success" />
                )}
              </Dropdown.Item>
              <Dropdown.Item
                onClick={() => changeLanguage("bn")}
                active={language === "bn"}
                className="d-flex align-items-center gap-2"
              >
                <GiIndiaGate size={18} style={{ color: "#f59e42" }} />
                <span>বাংলা</span>
                {language === "bn" && (
                  <FaCheck className="ms-auto text-success" />
                )}
              </Dropdown.Item>
            </Dropdown.Menu>
          </Dropdown>
        </div>
        <Row className="justify-content-center">
          <Col lg={10} xl={9}>
            <Card className="registration-card">
              <Card.Header className="registration-header p-0">
                <div className="registration-header-content">
                  <div className="header-logo-container">
                    <Image
                      src={IWT_FULL_IMG}
                      alt="IWT Logo"
                      className="header-logo"
                    />
                  </div>
                  <h3 className="header-title">
                    {t("vesselOwnerRegistration.Vessel Owner Registration")}
                  </h3>
                </div>
              </Card.Header>

              <Card.Body className="registration-body p-4 p-md-5">
                {isSubmitted ? (
                  <div className="success-container text-center py-5">
                    <div
                      className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4"
                      style={{
                        width: "90px",
                        height: "90px",
                        boxShadow: "0 10px 20px rgba(40, 167, 69, 0.3)",
                      }}
                    >
                      <FaCheck className="success-icon text-white fs-1" />
                    </div>
                    <h4 className="success-title text-success mb-3 fw-bold">
                      Registration Successful!
                    </h4>
                    <div
  className="registration-id p-4 bg-light rounded mb-4"
  // style={{ borderLeft: "4px solid #0077b6" }}
>
  <div className="mb-3">
    <strong>Registration Number:</strong>
    <div className="text-primary fs-5 fw-bold mt-2">
      {applicationData?.userBasicDetails?.registrationNumber || "N/A"}
    </div>
  </div>
  <p className="mb-0">
    {successMessage || 
    //  `Your vessel owner registration has been submitted successfully with Registration Number: ${applicationData?.userBasicDetails?.registrationNumber || "N/A"}. You will receive a confirmation email shortly.`}
      "Your vessel owner registration has been submitted successfully. You will receive a confirmation email shortly."}
  </p>
</div>
                    {/* <div
                      className="registration-id p-4 bg-light rounded mb-4"
                      // style={{ borderLeft: "4px solid #0077b6" }}
                    >
                      {successMessage ||
                        "Your vessel builder registration has been submitted successfully. You will receive a confirmation email shortly."}
                    </div> */}
                    <Button
                      variant="primary"
                      size="lg"
                      className="mt-2 d-flex align-items-center justify-content-center mx-auto"
                      style={{
                        background: "linear-gradient(135deg, #0077b6, #023e8a)",
                        border: "none",
                        boxShadow: "0 4px 15px rgba(0, 119, 182, 0.3)",
                        borderRadius: "8px",
                        padding: "12px 30px",
                        fontWeight: "600",
                        transition: "all 0.3s ease",
                        minWidth: "150px",
                        height: "50px",
                      }}
                      onClick={() => (window.location.href = "/")}
                    >
                      Go to Home
                    </Button>
                  </div>
                ) : (
                  <FormProvider {...methods}>
                    <form>
                      <div className="text-center mb-4">
                        <p className="text-muted">
                          {t(
                            "vesselOwnerRegistration.Please complete all required information to register your vessel"
                          )}
                        </p>
                      </div>
                      <div className="stepper-container">
                        <div className="stepper">
                          {[1, 2, 3].map((step, index) => (
                            <React.Fragment key={step}>
                              <div className={`step ${currentStep >= step ? 'active' : ''} ${currentStep > step ? 'completed' : ''}`}>
                                <div className="step-circle">
                                  {currentStep > step ? (
                                    <FaCheck size={16} />
                                  ) : (
                                    React.createElement(stepTitles[step - 1].icon, { size: 16 })
                                  )}
                                </div>
                                <div className="step-label">
                                  {stepTitles[step - 1].title}
                                </div>
                              </div>
                              {index < 2 && (
                                <div className={`step-connector ${currentStep > step ? 'active' : ''}`}></div>
                              )}
                            </React.Fragment>
                          ))}
                        </div>
                      </div>

                      <div className="step-content">
                        <div className="form-section p-4 rounded mb-4">
                          <div className="section-title">
                            {React.createElement(
                              stepTitles[currentStep - 1].icon,
                              { className: "section-icon" }
                            )}
                            <h4 className="mb-0 fw-bold">
                              {stepTitles[currentStep - 1].title}
                            </h4>
                          </div>

                          <div className="form-content py-3">
                            <Row className="g-3">
                              {getCurrentStepFields().map((field, index) => (
                                <Col
                                  key={`${field.name}-${isCompany}-${isExemptCategory}`}
                                  md={field.colSize || 12}
                                  className="mb-0"
                                >
                                  <DynamicField field={field} />
                                </Col>
                              ))}
                            </Row>
                          </div>
                        </div>
                      </div>

                      <div
                        className="form-navigation mt-4"
                        style={{ display: "block" }}
                      >
                        {currentStep > 1 && (
                          <Button
                            variant="outline-secondary"
                            onClick={handlePrevious}
                            className="prev-btn"
                            style={{ float: "left" }}
                          >
                            <FaArrowLeft className="btn-icon me-2" />{" "}
                            {t("Previous")}
                          </Button>
                        )}

                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="next-btn"
                          style={{ float: "right" }}
                        >
                          {currentStep === totalSteps
                            ? t("Submit Registration")
                            : t("Next")}
                          {currentStep !== totalSteps && (
                            <FaArrowRight className="btn-icon ms-2" />
                          )}
                        </Button>
                      </div>
                    </form>
                  </FormProvider>
                )}
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Container>
    </>
  );
};

export default VesselOwnerRegistrationPage;

