  //   }
  // };

// console.log("update response:",formData)
  const handleNext = async () => {
    if (!currentSubmitHandler) {
      console.error("No submit handler available.");
      return;
    }
  
    const currentStepData = await currentSubmitHandler();
    if (!currentStepData) {
      console.error("Form validation failed.");
      return;
    }
  
    if (!validateStepData(currentStep, currentStepData)) {
      return;
    }
  
    // Update form data
    const updatedFormData = {
      ...formData,
      [`step${currentStep}`]: { ...formData[`step${currentStep}`], ...currentStepData },
    };
  
    if (!deepEqual(updatedFormData, formData)) {
      setFormData(updatedFormData);
    }
  
    console.log("Updated Form Data:", JSON.stringify(updatedFormData, null, 2));
  
    // Transform formData to API payload structure
    const transformedPayload = transformFormData(updatedFormData);
  
    if (currentStep === stepsConfig.length) {
      setIsComplete(true);
  
      try {
        const isEdit = isEditMode;
        const endpoint = isEdit
          ? `${process.env.REACT_APP_BASE_URL}${URLS_ENDPOINT.APP_SERVICES.REGISTRATION_EDIT}`
          : `${process.env.REACT_APP_BASE_URL}${URLS_ENDPOINT.APP_SERVICES.REGISTRATION_CREATE}`;
  
        const payload = isEdit ? editFormData(updatedFormData) : transformedPayload;
        const response = await postData(endpoint, payload);
  
        // console.log("API Response:", response.data);
  
        // Check the response status and handle accordingly
        const responseStatus = response?.data?.responseStatus;
        if (responseStatus?.status === "200") {
          toast.success(responseStatus?.message );
  
          if (isEdit) {
            // Handle Update API response
            const transactionData = response?.data?.transactionResponse?.iwtTransaction?.[0];
            if (transactionData && transactionData?.nameOfPersonTitleDerived) {
              console.log("Updated Transaction Data:", transactionData);
              toast.info(`Updated Transaction: ${transactionData?.nameOfPersonTitleDerived}`);
            }
          } else {
            // Handle Registration API response
            const registrationData = response?.data?.iwtRegistrationResponses?.[0];
            if (registrationData) {
              console.log("Registration Data:", registrationData);
              toast.info(`Registration Successful for Vessel: ${registrationData?.registrationBooksData?.[0]?.nameOfVessel}`);
            }
          }
  
          // Navigate after successful submission
          navigate("/dashboard");
        } else {
          // Handle Error response (status other than 200)
          const errorMessage =
            responseStatus?.message || "Something went wrong. Please try again.";
          toast.error(errorMessage);
        }
      } catch (error) {
        console.error("API Submission Failed:", error.response?.data || error.message);
        toast.error("Registration failed. Please try again later.");
      }
    } else {
      setCurrentStep((prevStep) => prevStep + 1);
    }
  };
  












