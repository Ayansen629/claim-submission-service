/* Calendar Container */
.survey-tracker-card {
  grid-column: span 2;
  height: 100%;
}

.survey-tracker-card .status-card-content {
  padding: 15px;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.calendar-wrapper {
  margin-top: 5px;
  width: 100%;
  flex: 1;
  min-height: 0;
}

/* Day Cell Styling */
.day-container {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 2px;
}

.day-number {
  font-size: 0.8rem;
  font-weight: 500;
  margin-bottom: 2px;
}

.day-container.today .day-number {
  color: #fff;
  background-color: #0d6efd;
  border-radius: 50%;
  width: 1.8em;
  height: 1.8em;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* Event Display */
.event-details {
  flex: 1;
  overflow-y: auto;
  max-height: 60px;
  scrollbar-width: thin;
}

.event-item {
  padding: 2px 4px;
  margin: 2px 0;
  background-color: rgba(255,255,255,0.9);
  border-radius: 3px;
  font-size: 0.65rem;
  line-height: 1.2;
}

.event-title {
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.event-vessel {
  color: #666;
  font-size: 0.6rem;
}

/* Calendar Global Styles */
.survey-calendar {
  width: 100% !important;
  height: 100% !important;
}

.survey-calendar .react-datepicker__month-container {
  width: 100%;
  height: 100%;
}

.survey-calendar .react-datepicker__day {
  height: 80px;
  padding: 2px;
  display: flex;
  flex-direction: column;
}

.survey-calendar .react-datepicker__day--outside-month {
  opacity: 0.5;
}

/* Responsive Adjustments */
@media (max-width: 768px) {
  .survey-calendar .react-datepicker__day {
    height: 60px;
    font-size: 0.7rem;
  }
  
  .event-item {
    font-size: 0.6rem;
  }
}
