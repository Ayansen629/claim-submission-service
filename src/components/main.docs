import React from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import { FaCheckCircle, FaDownload } from 'react-icons/fa';
import { Button } from 'react-bootstrap';
import './SubmissionSuccess.css'; // Keep your existing styling

// Import PDF components
import ClaimFormPdf from '../components/ClaimFormPdf'; // Adjust path as needed
import { pdf } from '@react-pdf/renderer';

const SubmissionSuccess = () => {
  const location = useLocation();
  const navigate = useNavigate();

  const { applicationNumber, formData } = location.state || {};

  // Static fallback data if formData is not provided
  const mockFormData = {
    creditorBasicDetails: {
      financialCreditorName: 'ABC Finance Ltd.',
      identificationNumber: 'ID123456789',
    },
    addressDetails: {
      addressLine1: '123 Main Street',
      addressLine2: '',
      city: 'Mumbai',
      state: 'Maharashtra',
      pincode: '400001',
    },
    claimDetails: {
      claimAmount: '₹50,000.00',
      securityValue: '₹20,000.00',
      guaranteeValue: '₹0.00',
      principalBorrowerName: 'XYZ Manufacturing Pvt. Ltd.',
      debtDetails: 'Loan issued on 01 Jan 2023',
    },
    signatoryDetails: {
      creditorName: 'John Doe',
      creditorPosition: 'Director',
      creditorAddress: '123 Office Complex, Mumbai'
    }
  };

  const handleDownloadPDF = async () => {
    try {
      // Use real formData or fallback to mock data
      const dataForPDF = formData || mockFormData;

      // Generate the PDF as a Blob
      const blob = await pdf(<ClaimFormPdf applicationData={dataForPDF} />).toBlob();

      // Create download link and trigger download
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `Application_${applicationNumber || 'claim'}.pdf`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);

    } catch (error) {
      console.error("Failed to generate PDF", error);
      alert("An error occurred while generating the PDF. Please try again.");
    }
  };

  const handleReturnToDashboard = () => {
    navigate('/dashboard');
  };

  return (
    <div className="submission-success-container">
      <div className="success-card">
        <FaCheckCircle className="success-icon" size={80} color="#28a745" />
        <h2>Claim Form Submitted Successfully!</h2>

        <div className="application-details">
          <p>Your application has been submitted with the following details:</p>
          <p><strong>Application Number:</strong> {applicationNumber || 'N/A'}</p>
          <p><strong>Date Submitted:</strong> {new Date().toLocaleDateString()}</p>
        </div>

        <div className="success-actions">
          <Button
            variant="success"
            onClick={handleDownloadPDF}
            className="download-button"
          >
            <FaDownload style={{ marginRight: '8px' }} />
            Download Application PDF
          </Button>

          <Button
            variant="outline-primary"
            onClick={handleReturnToDashboard}
            className="dashboard-button"
          >
            Return to Dashboard
          </Button>
        </div>

        <div className="success-message">
          <p>Thank you for submitting your claim form. You will receive a confirmation email shortly.</p>
          <p>You can track the status of your application in the dashboard.</p>
        </div>
      </div>
    </div>
  );
};

export default SubmissionSuccess;
