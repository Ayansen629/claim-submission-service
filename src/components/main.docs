onChange={(value, selObj) => {
  setIsCompany(selObj?.isCompany || false);
  
  // Use correct valueCode from your masterData
  const exemptCategories = ["CENTRAL", "STATE", "STATE GOVERNMENT/ PANCHAYET", "PRIVATE_LTD"];
  const isExempt = exemptCategories.includes(value);
  setIsExemptCategory(isExempt);
  
  setValue(field.name, value);
  
  if (isExempt) {
    setValue("panNo", "");
    setValue("aadharNumber", "");
    setValue("tradeLicenseNumber", "");
    clearErrors(["panNo", "aadharNumber", "tradeLicenseNumber"]);
  }
  
  if (errors[field.name]) {
    clearErrors(field.name);
  }
  setFormData((prev) => ({
    ...prev,
    [field.name]: value,
  }));
}}
