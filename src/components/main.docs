import React, { useState, useEffect } from 'react';
import { Table, Dropdown, Form, Button, Tooltip, OverlayTrigger } from 'react-bootstrap';
import {
    PencilSquare,
    Eye,
    Trash3,
    GeoAltFill,
    Plus,
    ArrowDown,
    ArrowUp,
    Database,
    Check,
    Calendar,
    FileEarmarkText,
    Download
} from 'react-bootstrap-icons';
import { useNavigate } from 'react-router-dom';
import './ActionTable.module.css';

const ActionTable = (props) => {
    // ... (keep all your existing state and effect hooks)

    // ... (keep all your existing handler functions)

    return (
        <div className="mb-5 px-3 mx-0 generic-action-table pt-4" style={{ margin: '20px' }}>
            {/* Search and Filter Controls - keep as is */}

            {/* Table */}
            <div className="table-responsive mb-4" style={{ overflowX: 'hidden', margin: '0 10px' }}>
                <Table className="table align-middle" style={{ 
                    width: '100%', 
                    tableLayout: 'fixed', 
                    marginBottom: '0',
                    borderBottom: '2px solid #dee2e6'
                }}>
                    {/* Table Header and Body - keep previous structure */}
                </Table>
            </div>

            {/* Enhanced Table Footer */}
            <div className="d-flex justify-content-between align-items-center py-3 px-3 table-footer" 
                 style={{
                     borderTop: '1px solid #e9ecef',
                     backgroundColor: '#f8f9fa',
                     borderRadius: '0 0 8px 8px'
                 }}>
                <div className="d-flex align-items-center">
                    <span className="text-muted me-3">
                        Showing {indexOfFirstItem + 1}-{Math.min(indexOfLastItem, searchedData.length)} of {searchedData.length} entries
                    </span>
                    {selected.length > 0 && (
                        <span className="badge bg-primary rounded-pill">
                            {selected.length} selected
                        </span>
                    )}
                </div>

                <div className="d-flex align-items-center">
                    <PaginationOptions />

                    <div className="btn-group ms-3 pagination-controls">
                        <Button
                            variant="outline-secondary"
                            onClick={handlePrevPage}
                            disabled={currentPage === 1}
                            className="page-nav-btn"
                        >
                            <i className="fas fa-chevron-left" />
                        </Button>

                        <div className="px-3 d-flex align-items-center page-info">
                            Page <span className="fw-bold mx-1">{currentPage}</span> of {totalPages || 1}
                        </div>

                        <Button
                            variant="outline-secondary"
                            onClick={handleNextPage}
                            disabled={currentPage === totalPages || totalPages === 0}
                            className="page-nav-btn"
                        >
                            <i className="fas fa-chevron-right" />
                        </Button>
                    </div>
                </div>
            </div>
        </div>
    );
};

export default ActionTable;

/* Table Container */
.generic-action-table {
  background-color: #fff;
  border-radius: 8px;
  box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
  width: calc(100% - 40px);
  padding: 20px;
  margin: 20px auto;
}

/* Checkbox Styling */
.form-check-input {
  width: 18px;
  height: 18px;
  margin-top: 0;
  cursor: pointer;
}

.form-check-input:checked {
  background-color: #269ccc;
  border-color: #269ccc;
}

/* Disabled Edit Icon Styling */
.custom-disabled-btn {
  opacity: 0.65;
  cursor: not-allowed;
}

.custom-disabled-btn .action-icon {
  color: #adb5bd !important;
}

/* Table Footer */
.table-footer {
  padding: 12px 20px;
  margin-top: -1px; /* Connects with table border */
}

.page-nav-btn {
  padding: 6px 12px;
  border-color: #dee2e6;
  min-width: 36px;
}

.page-nav-btn:hover:not(:disabled) {
  background-color: #269ccc;
  color: white;
}

.page-nav-btn:disabled {
  opacity: 0.5;
}

.page-info {
  font-size: 0.9rem;
  color: #495057;
}

/* Pagination Dropdown */
.dropdown-toggle {
  min-width: 70px;
  justify-content: center;
}

/* Table Borders */
.table thead tr:first-child th {
  border-top: none;
}

.table tbody tr:last-child td {
  border-bottom: none;
}

/* Action Icons */
.action-icon {
  font-size: 1.1rem;
}

/* Responsive Adjustments */
@media (max-width: 768px) {
  .generic-action-table {
    padding: 15px;
    width: calc(100% - 30px);
    margin: 15px auto;
  }
  
  .form-check-input {
    width: 16px;
    height: 16px;
  }
  
  .table-footer {
    flex-direction: column;
    gap: 15px;
    padding: 15px;
  }
  
  .page-info {
    padding: 0 8px;
  }
}
