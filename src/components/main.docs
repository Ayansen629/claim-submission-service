import React, { useState, useEffect } from "react";
import DataDigitization from "./DataDigitization"; 
import Loader from "../common/Loader";

const Dashboard = () => {
  const [isDataDigitizationVisible, setDataDigitizationVisible] = useState(true); 
  const [isloading, setIsLoading] = useState(false);
  
  useEffect(() => {
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
    }, 1000);
  }, []);

  return (
    <>
      {!isloading ? (
        <div
          style={{
            textAlign: "center",
            backgroundColor: "#f4f6f9",
            minHeight: "100vh",
            padding: "0", 
            width: "100%", 
            display: "flex",
            justifyContent: "center",
            alignItems: "flex-start", // Changed from center to flex-start
          }}
        >
          {isDataDigitizationVisible && (
            <div
              className="data-digitization-container"
              style={{
                maxWidth: "100%",
                width: "100%", 
                margin: "0",
                padding: "0", // Reduced padding from 5px to 0
              }}
            >
              <DataDigitization />
            </div>
          )}
        </div>
      ) : (
        <div className="loader-container">
          <Loader isLoading={isloading} message="Please wait..." />
        </div>
      )}
    </>
  );
};

export default Dashboard;
