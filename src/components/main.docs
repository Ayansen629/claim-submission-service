import React, { useState, useEffect, useRef } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaCheckCircle } from "react-icons/fa";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
  defaultValue?: string | File;
  autoFocus?: boolean;
  clearErrors?: (fieldName: string) => void;
}


const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  watch,
  defaultValue,
  clearErrors
}) => {
  const hasError = errors && errors[name];
  const fileInputRef = useRef(null);
  const [fileSelected, setFileSelected] = useState(false);
   const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  
  const currentFile = watch ? watch(name) : null;

  useEffect(() => {
  
    if (currentFile && fileSelected) {
      clearErrors(name);
    }
  }, [currentFile, fileSelected, name, clearErrors]);

  const handleFileChange = (e) => {
    if (e.target.files && e.target.files[0]) {
      setFileSelected(true);
      if (onChange) {
        onChange(e);
      }
    }
  };
console.log("InputFile component rendered with name:", currentFile?.name || "No file selected");
  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      <div
        className={`file-upload border rounded p-3 ${hasError ? 'border-danger' : currentFile ? 'border-success' : ''}`}
        style={{
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderRadius: '8px',
          transition: 'all 0.3s ease'
        }}
      >
        <div className="d-flex align-items-center">
          <label
            htmlFor={name}
            className={`file-label btn ${hasError ? 'btn-outline-danger' : 'btn-primary'} mb-0 d-inline-flex align-items-center`}
            style={{
              borderRadius: '6px',
              padding: '8px 16px',
              cursor: disabled ? 'not-allowed' : 'pointer',
              opacity: disabled ? 0.6 : 1,
              minWidth: '120px',
              color: 'white'
            }}
          >
            <FaUpload className="file-icon me-2" />
            <span className="file-text">Choose File</span>
          </label>
          <div
            className={`file-name-container ms-3 flex-grow-1 border rounded px-3 py-2 ${currentFile ? 'bg-light-success' : 'bg-light'} d-flex align-items-center ${hasError ? 'border-danger' : currentFile ? 'border-success' : ''}`}
            style={{
              overflow: 'hidden'
            }}
          >
            {currentFile ? (
              <>
                <FaCheckCircle className="text-success me-2 flex-shrink-0" />
                <div className="overflow-hidden">
                  <span className="text-success fw-bold" style={{ fontSize: '0.8rem' }}>Selected File:</span>
                  <div className="d-flex align-items-center">
                    <span className="file-icon-preview me-2 flex-shrink-0">
                      {currentFile.name.endsWith('.pdf') ? (
                        <FaFilePdf color="#dc3545" />
                      ) : (
                        <FaFileImage color="#28a745" />
                      )}
                    </span>
                    <span 
                      className="text-dark fw-semibold" 
                      style={{ 
                        overflow: 'hidden', 
                        textOverflow: 'ellipsis', 
                        whiteSpace: 'nowrap' 
                      }}
                    >
                      {currentFile.name}
                    </span>
                  </div>
                </div>
              </>
            ) : (
              <span className="text-muted">No file chosen</span>
            )}
          </div>
        </div>
        <input
          ref={fileInputRef}
          type="file"
          id={name}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="d-none"
        />
      </div>
      {hasError ? (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      ) : (
        <Form.Text className="text-muted small mt-1">
          {t("Upload PDF, JPG or PNG file (Max size: 2MB)")}
        </Form.Text>
      )}
    </Form.Group>
  );
};
export default InputFile;

import React, { useState, useEffect, useRef } from "react";
import { useForm } from "react-hook-form";
import { Row, Col } from "react-bootstrap";
import InputText from "../../../common/InputText.tsx";
import InputSelect from "../../../common/InputSelect.tsx";
import InputRadio from "../../../common/InputRadio.tsx";
import InputFile from "../../../common/InputFile";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";

const VesselDetails = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [formData, setFormData] = useState({});
  const isCompMount = useRef(true);

  const {
    register,
    watch,
    setValue,
    clearErrors,
    trigger,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");
  const category = watch("category");

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [changeLanguage]);

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  
  useEffect(() => {
    if (category === "A") {
      setValue("zone", "1", { shouldValidate: true });
      setValue("supervisionAuthority", "classificationSociety", { shouldValidate: true });
      clearErrors("zone");
      clearErrors("supervisionAuthority");
    }
  }, [category, setValue, clearErrors]);

  const formFields = {
    basicInfo: [
      {
        name: 'ownerName',
        label: t('Name of Owner'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Name of Owner'),
        validation: { required: t('Name is required') }
      },
      {
        name: 'ownerAddress',
        label: t('Address of Owner'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Address of Owner'),
        validation: { required: t('Address is required') }
      },
      {
        name: 'mobile',
        label: t('Mobile'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Mobile'),
        validation: { required: t('Mobile is required') }
      },
      {
        name: 'email',
        label: t('Email Id'),
        type: 'email',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Email Id'),
        validation: { required: t('Email is required') }
      },
      {
        name: 'pan',
        label: t('PAN'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter PAN'),
        validation: { required: t('PAN is required') }
      },
      {
        name: 'aadhar',
        label: t('Aadhar'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Aadhar'),
        validation: { required: t('Aadhar is required') }
      },
      {
        name: 'tradeLicence',
        label: t('Trade Licence'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Trade Licence'),
        validation: { required: t('Trade Licence is required') }
      },
      {
        name: 'gst',
        label: t('GST'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GST'),
        validation: { required: t('GST is required') }
      },
      {
        name: 'grt',
        label: t('Gross Tonnage (GRT)'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GRT'),
        validation: { required: t('GRT is required') }
      },
      {
        name: 'workOrderValue',
        label: t('Work Order Value'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Enter Work Order Value'),
        validation: {
          required: t('Work Order Value is required'),
          pattern: {
            value: /^[0-9]+$/,
            message: t('Please enter a valid number')
          }
        }
      },
      {
        name: 'vesselType',
        label: t('Type of Vessel'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'new', label: t('New Vessel') },
          { value: 'old', label: t('Old Vessel') }
        ],
        validation: { required: t('vesselType is required') }
      },
      {
        name: 'category',
        label: t('Category'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'A', label: t('Category A') },
          { value: 'B', label: t('Category B') },
          { value: 'C', label: t('Category C') }
        ],
        validation: { required: t('category is required') }
      },
      {
        name: 'zone',
        label: t('Zone'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: '1', label: t('Zone 1') },
          { value: '2', label: t('Zone 2') },
          { value: '3', label: t('Zone 3') }
        ],
        validation: { required: category !== "A" && t('zone is required') },
        disabled: category === "A"
      },
      {
        name: 'supervisionAuthority',
        label: t('Supervision Authority'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'iwt', label: t('IWT') },
          { value: 'classificationSociety', label: t('Classification Society') }
        ],
        validation: { required: category !== "A" && t('Supervision Authority is required') },
        disabled: category === "A"
      },
      {
        name: 'purchaseType',
        label: t('Purchase Type'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'new', label: t('New') },
          { value: 'used', label: t('Used') }
        ],
        validation: { required: t('Purchase Type is required') }
      },
      {
        name: 'classificationSociety',
        label: t('Name of the Classification Society'),
        type: 'text',
        required: false,
        colSize: 4,
        placeholder: t('Please enter Name of the Classification Society'),
        validation: {}
      },
      {
        name: 'constructedBy',
        label: t('Constructed By ?'),
        type: 'radio',
        required: true,
        colSize: 6,
        options: [
          { label: t('Self'), value: '1' },
          { label: t('Builder'), value: '2' }
        ],
        validation: { required: t('Please select a Constructor Type') }
      },
      {
        name: 'builder',
        label: t('Builder'),
        type: 'select',
        required: true,
        colSize: 6,
        options: [
          { value: 'builder1', label: t('Builder 1') },
          { value: 'builder2', label: t('Builder 2') }
        ],
        showIf: () => constructedBy === "2",
        validation: { required: constructedBy === "2" && t('Builder is required') }
      }
    ],
    builderDetails: [
      {
        name: 'builderName',
        label: t('Builder Name'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Name'),
        validation: { required: constructedBy === "2" && t('Builder Name is required') }
      },
      {
        name: 'builderAddress',
        label: t('Builder Address'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Address'),
        validation: { required: constructedBy === "2" && t('Builder Address is required') }
      },
      {
        name: 'builderEmail',
        label: t('Builder Email Id'),
        type: 'email',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Email Id'),
        validation: {
          required: constructedBy === "2" && t('Builder Email is required'),
          pattern: constructedBy === "2" && {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: t('Invalid email address')
          }
        }
      },
      {
        name: 'builderMobile',
        label: t('Mobile'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Mobile'),
        validation: {
          required: constructedBy === "2" && t('Builder Mobile is required'),
          pattern: constructedBy === "2" && {
            value: /^[0-9]{10}$/,
            message: t('Invalid mobile number')
          }
        }
      },
      {
        name: 'builderTradeLicence',
        label: t('Trade Licence'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Trade Licence'),
        validation: { required: constructedBy === "2" && t('Builder Trade Licence is required') }
      },
      {
        name: 'builderGST',
        label: t('GST'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GST'),
        validation: { required: constructedBy === "2" && t('Builder GST is required') }
      },
      {
        name: 'builderAuth',
        label: t('Builder Authorization'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'auth', label: t('Authorized') },
          { value: 'rejected', label: t('Rejected') }
        ],
        validation: { required: constructedBy === "2" && t('Builder Authorization is required') }
      },
      {
        name: 'authLetter',
        label: t('Authorisation Letter'),
        type: 'file',
        required: true,
        colSize: 4,
        validation: { required: constructedBy === "2" && t('Authorization Letter is required') }
      }
    ]
  };

  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'select':
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register(field.name, field.validation)}
            errors={category !== "A" || !field.disabled ? errors : {}}
            value={formData[field.name] || watch(field.name) || ""}
            onChange={(value) => {
              if (viewMode || field.disabled) return;
              setValue(field.name, value, { shouldValidate: true });
              clearErrors(field.name);
              setFormData(prev => ({
                ...prev,
                [field.name]: value
              }));
            }}
            disabled={viewMode || field.disabled}
          />
        );

      case 'file':
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (viewMode) return;
              if (e.target.files && e.target.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
                const customFileName = `${field.label}${extension}`;
                file.originalName = customFileName;
                setValue(field.name, file);

                setFormData(prev => ({
                  ...prev,
                  [field.name]: file
                }));

                if (errors[field.name]) {
                  clearErrors(field.name);
                }

                const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'Only PDF, JPG or PNG files are allowed'
                  });
                } else if (file.size > 2 * 1024 * 1024) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'File size should not exceed 2MB'
                  });
                }
              }
            }}
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={formData[field.name]}
            clearErrors={clearErrors}
            setValue={setValue}
            disabled={viewMode}
          />
        );

      case 'radio':
        return (
          <InputRadio
            name={field.name}
            label={field.label}
            options={field.options}
            register={register}
            rules={field.validation}
            errors={errors}
            onChange={() => !viewMode && clearErrors(field.name)}
            disabled={viewMode}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field.name, field.validation)}
            onChange={handleChange}
            errors={errors}
            disabled={viewMode}
          />
        );
    }
  };

  return (
    <form autoComplete="off">
      {/* Basic Information Collapsible */}
      <Collapsible title={t("Basic Information")} openStat={true}>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          {formFields.basicInfo.map((field, index) => (
            <Col key={index} md={field.colSize || 12}>
              <DynamicField field={field} />
            </Col>
          ))}
        </Row>
      </Collapsible>

      {/* Builder Details Collapsible */}
      {constructedBy === "2" && (
        <Collapsible title={t("Builder Details")} openStat={true}>
          <Row className="gy-3" style={{ padding: "1rem" }}>
            {formFields.builderDetails.map((field, index) => (
              <Col key={index} md={field.colSize || 12}>
                <DynamicField field={field} />
              </Col>
            ))}
          </Row>
        </Collapsible>
      )}
    </form>
  );
};

export default VesselDetails;
