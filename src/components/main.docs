export const openPDFInNewTab = (base64String) => {
  const byteCharacters = atob(base64String);
  const byteArrays = new Uint8Array(byteCharacters?.length);
  for (let i = 0; i < byteCharacters?.length; i++) {
    byteArrays[i] = byteCharacters?.charCodeAt(i);
  }
  const blob = new Blob([byteArrays], { type: "application/pdf" });
  const url = URL.createObjectURL(blob);
  window.open(url, "_blank");
};

export const openFileInNewTab = (base64String, type?: string) => {
  const byteCharacters = atob(base64String);
  const byteArrays = new Uint8Array(byteCharacters?.length);
  for (let i = 0; i < byteCharacters?.length; i++) {
    byteArrays[i] = byteCharacters?.charCodeAt(i);
  }
  const blob = new Blob([byteArrays], { type: type || "application/pdf" });
  const url = URL.createObjectURL(blob);
  window.open(url, "_blank");
};

export const formatDate = (dateString) => {
  if (!dateString) return "";
  try {
    return moment(dateString).isValid()
      ? moment(dateString).format("YYYY-MM-DD")
      : "";
  } catch {
    return "";
  }
};

export const formatDateTime = (dateString) => {
  if (!dateString) return "";
  try {
    return moment(dateString).isValid()
      ? moment(dateString).format("YYYY-MM-DD hh:mm A")
      : "";
  } catch {
    return "";
  }
};

export const headerStyle = {
  backgroundColor: "#EAF1FB",
  color: "#2466BF",
  fontWeight: 600,
  borderRadius: "0.4rem",
  padding: "0.75rem 1rem",
};

export const defaultLSKeys = [
  "access_token",
  "refresh_token",
  "expires_in",
  "userDetails",
  "tokenDetails",
  "userRole",
];

export const clearAppStorage = (keys?: string[]) => {
  const keysToRemove = keys || defaultLSKeys;
  keysToRemove.forEach((key) => {
    removeFromLocalStorage(key);
  });
};

export const renameFile = (file: File, newFileName: string): File => {
  return new File([file], newFileName, {
    type: file.type,
    lastModified: file.lastModified,
  });
};


export const allowOnlyInteger = (e) => {
  const k = e.key;
  const ctrl = e.ctrlKey || e.metaKey;
  return (
    /^\d$/.test(k) ||
    ['Backspace', 'ArrowLeft', 'ArrowRight', 'Delete', 'Tab'].includes(k) || 
    (ctrl && ['a', 'c', 'v', 'x'].includes(k.toLowerCase())) 
  );
}

export const officarRole= ['L1','L2','L3']
import React, { useEffect, useState } from "react";
import { Link, useLocation } from "react-router-dom";
import {
  FaHome,
  FaUser,
  FaCog,
  FaChevronRight,
  FaShip,
  FaDatabase,
  FaTimes
} from "react-icons/fa";
import "./styles/Sidebar.css"; 

const menuItems = [
  {
    name: "dashboard",
    label: "Dashboard",
    icon: <FaHome />,
    path: "/dashboard",
    // subMenu: [
    //   { name: "vessel-owner", label: "Vessel Owner", path: "/dashboard" },
    //   { name: "employee-dashboard", label: "Employee", path: "/dashboard/employee-dashboard" },
    // ],
  },
  {
    name: "vessel-registration",
    label: "Vessel Registration",
    path: "/vessel-registration/new-vessel",
    icon: <FaShip />,
    subMenu: [
      { name: "add-user", label: "New Vessel Registration", path: "/vessel-registration/new-vessel" },
      // { name: "manage-vessel", label: "View / Update", path: "/vessel-registration/manage-vessel" },
      { name: "", label: "Name Change of Vessel", path: "" },
      { name: "", label: "Registration for Alteration/Modification of Inland Vessels", path: "" },
      { name: "", label: "Transfer of Registry", path: "" },
      { name: "", label: "Transfer of Inland Vessel", path: "" },
      { name: "", label: "Cancellation of Registration", path: "" },
      { name: "", label: "Registration for Mortgage of mechanically propelled inland vessel (Hypothecation)", path: "" },
      { name: "", label: "De-registration for Mortgage of mechanically propelled inland vessel (De-hypothecation)", path: "" },
      { name: "", label: "Transfer for Mortgage of mechanically propelled inland vessel or share", path: "" },
      { name: "", label: "Duplicate Registration Certificatee", path: "" },
      { name: "upload-legacy-data", label: "Upload Legacy Data", path: "/vessel-registration/upload-legacy-data" },


    ],
  },
  {
    name: "master",
    label: "Master",
    icon: <FaDatabase />,
    subMenu: [
      { name: "manage-employee", label: "Employee Management", path: "/iwt/employee-management" },
