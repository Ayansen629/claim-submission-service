import React, { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import "bootstrap/dist/css/bootstrap.min.css";
import { Container, Row, Col, Modal, Button, Table } from "react-bootstrap";
import "./DashboardMain.css";
import FileUploadModal from "./FileUploadModal.jsx";
import ActionTable from "./ActionTable.js"; 
import { toast } from "react-toastify";
import { APP_MESSAGES } from "../../../utils/constants.ts";
import { postData } from "../../../services/http.service.ts";
import Collapsible from "../../../common/Collapsible.js";
import PreviewCard from "./PreviewCard.js";

const DashboardMain = () => {
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [isLoading, setIsLoading] = useState(true); // Start with loading true
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [modalData, setModalData] = useState({});
  const [rowData, setRowData] = useState([]);
  const navigate = useNavigate();

  const columns = [
    {
      colName: "ID",
      fieldName: "uuid",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "ID",
      minWidth: "5rem",
    },
    {
      colName: "Application Number",
      fieldName: "applicationNumber",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Application Number",
      minWidth: "10rem",
    },
    {
      colName: "Debtor Name",
      fieldName: "debtorName",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Debtor Name",
      minWidth: "10rem",
    },
    {
      colName: "Creditor Name",
      fieldName: "creditorName",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Creditor Name",
      minWidth: "10rem",
    },
    {
      colName: "Total Claim Amount",
      fieldName: "totalClaimAmount",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Total Claim Amount",
      minWidth: "10rem",
    },
    {
      colName: "Submitted Date",
      fieldName: "submittedDate",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Submitted Date",
      minWidth: "10rem",
    },
    {
      colName: "Status",
      fieldName: "applicationStatus",
      clsName: "column-text-start",
      isClickable: false,
      titleCode: "Status",
      minWidth: "10rem",
    },
    {
      colName: "Action",
      fieldName: "action",
      actions: ["view"],
      clsName: "col-sm-2 column-text-start actions-column",
    },
  ];

  const modalDataDetails = [
    {
      creditorName: "John Doe",
      totalClaimAmount: "$10,000",
      debtIncurredDetails: "Loan for business expansion",
      mutualCreditDebtsDetails: "Mutual agreement with XYZ Corp",
      identificationType: "Aadhar",
      aadhar: "1234 5678 9012",
      identificationNumber: "ID123456",
      identificationDocument: "Aadhar Card",
      signatoryName: "Jane Smith",
      signatoryDocument: "Document.pdf",
      signatoryPosition: "Manager",
      signatoryAddress: "123 Main St, City, Country",
    },
  ];

  const handleOnViewRow = () => {
    console.log("Using static data for modal");
    setModalData(modalDataDetails);
    setIsViewModalOpen(true);
  };

  const fetchDashboardData = async () => {
    try {
      setIsLoading(true);
      
      // Get user data from localStorage
      const userFormData = JSON.parse(localStorage.getItem("userFormData"));
      const userInfo = userFormData?.fullloginDetails?.userInfo;
      
      if (!userInfo) {
        throw new Error("User information not found in localStorage");
      }

      const payload = {
        userInfo: userInfo,
        filterCriteria: {}
      };

      const response = await postData(
        "cms-application-service/dashboard/getApplications",
        payload
      );

      if (response?.status === "200" && response?.dashboardApplications?.length > 0) {
        // Format the data to match your table structure
        const formattedData = response.dashboardApplications.map((item, index) => ({
          ...item,
          id: item.uuid, // Ensure you have an id field for the table
          slNo: index + 1,
          action: ["view"] // Add action buttons
        }));
        
        setRowData(formattedData);
      } else {
        setRowData([]);
        toast.info("No applications found", { position: "top-right" });
      }
    } catch (error) {
      console.error("Error fetching dashboard data:", error);
      toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
      setRowData([]);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchDashboardData();
  }, []);

  return (
    <div className="container-fluid mt-5" style={{ paddingLeft: 0, paddingRight: 0 }}>
      {!isLoading ? (
        <>
          <h3 className="mb-2 text-center">Claim Submission Service</h3>
          <br />
          <div className="row mb-3 align-items-center">
            <div className="col-12 col-md-4 d-flex justify-content-md-end justify-content-center gap-2 ms-auto">
              {/* Add any buttons you need here */}
            </div>
          </div>
          
          <ActionTable
            columns={columns}
            rowData={rowData}
            hideExportBtn={false}
            onViewRow={handleOnViewRow}
          />

          <Modal
            show={isViewModalOpen}
            onHide={() => setIsViewModalOpen(false)}
            dialogClassName="modal-1110w"
            aria-labelledby="example-custom-modal-styling-title"
          >
            <Modal.Header closeButton>
              <Modal.Title id="example-custom-modal-styling-title">
                Preview Details
              </Modal.Title>
            </Modal.Header>
            <Modal.Body>
              {modalDataDetails?.length > 0 ? (
                <>
                  {modalDataDetails.map((data, index) => (
                    <Collapsible
                      key={index}
                      title={index === 0 ? "Current Information" : `History Details - ${index}`}
                    >
                      <div className="card mb-4 tiles_Size">
                        <div className="card-body">
                          <h5 style={{ fontWeight: 600 }}>Creditor Details</h5>
                          <br />
                          <Container fluid>
                            <Row className="g-3">
                              {Object.entries({
                                "Creditor Name": data.creditorName,
                                "Total Claim Amount": data.totalClaimAmount,
                                "Debt Incurred Details": data.debtIncurredDetails,
                                "Mutual Credit/Debts Details": data.mutualCreditDebtsDetails,
                              }).map(([key, value]) => (
                                <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                  <PreviewCard title={key} value={value} />
                                </Col>
                              ))}
                            </Row>
                          </Container>
                        </div>
                      </div>
                      <div className="card mb-4 tiles_Size">
                        <div className="card-body">
                          <h5 style={{ fontWeight: 600 }}>Identification Details</h5>
                          <br />
                          <Container fluid>
                            <Row className="g-3">
                              {Object.entries({
                                "Identification Type": data.identificationType,
                                "Aadhar": data.aadhar,
                                "Identification Number": data.identificationNumber,
                                "Identification Document": data.identificationDocument,
                              }).map(([key, value]) => (
                                <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                  <PreviewCard title={key} value={value} />
                                </Col>
                              ))}
                            </Row>
                          </Container>
                        </div>
                      </div>
                      <div className="card mb-4 tiles_Size">
                        <div className="card-body">
                          <h5 style={{ fontWeight: 600 }}>Signatory Details</h5>
                          <br />
                          <Container fluid>
                            <Row className="g-3">
                              {Object.entries({
                                "Signatory Name": data.signatoryName,
                                "Signatory Document": data.signatoryDocument,
                                "Signatory Position": data.signatoryPosition,
                                "Signatory Address": data.signatoryAddress,
                              }).map(([key, value]) => (
                                <Col key={key} xs={12} sm={6} md={3} className="mb-3">
                                  <PreviewCard title={key} value={value} />
                                </Col>
                              ))}
                            </Row>
                          </Container>
                        </div>
                      </div>
                    </Collapsible>
                  ))}
                </>
              ) : (
                <p>No data available.</p>
              )}
            </Modal.Body>
            <Modal.Footer>
              <Button variant="secondary" onClick={() => setIsViewModalOpen(false)}>
                Close
              </Button>
            </Modal.Footer>
          </Modal>
          
          <FileUploadModal modal={isModalOpen} setModal={setIsModalOpen} />
        </>
      ) : (
        <div className="loader-container">
          <div className="loader"></div>
        </div>
      )}
    </div>
  );
};

export default DashboardMain;
