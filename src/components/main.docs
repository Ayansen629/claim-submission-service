
import React, { useCallback, useEffect, useState } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import { FaSignature, FaUserTie, FaHome, FaUpload, FaCheckCircle } from "react-icons/fa";
import { MdDescription } from "react-icons/md";
import 'bootstrap/dist/css/bootstrap.min.css';
import { uploadDocument } from "../../../services/documentUploadService";
import "./StepThird.css";

const StepThird = ({ provideSubmitHandler, formData, onValidationComplete }) => {
    const methods = useForm({
        mode: "onChange",
        reValidateMode: "onChange"
    });
    
    const { 
        register, 
        handleSubmit, 
        formState: { errors, isValid }, 
        trigger, 
        setValue, 
        control, 
        getValues,
        watch
    } = methods;

    const [hasSignature, setHasSignature] = useState(false);
    const watchAllFields = watch();
    const [isUploading, setIsUploading] = useState(false);
    const [uploadError, setUploadError] = useState(null);
    const [uploadSuccess, setUploadSuccess] = useState(false);
    const [isCRPUser, setIsCRPUser] = useState(false);

    // Check if user is CRP
    useEffect(() => {
        const storedData = localStorage.getItem('userFormData');
        if (storedData) {
            const parsedData = JSON.parse(storedData);
            setIsCRPUser(parsedData?.userType === "CRP");
        }
    }, []);

    const handleFileUpload = async (file) => {
        if (isCRPUser) return null; // Don't upload if user is CRP
        
        try {
            setIsUploading(true);
            setUploadError(null);
            setUploadSuccess(false);
            const result = await uploadDocument(file, 'identification');
            setUploadSuccess(true);
            return result;
        } catch (error) {
            setUploadError(error.message);
            throw error;
        } finally {
            setIsUploading(false);
        }
    };

    const creditorDetailsSchema = [
       { 
            name: "creditorName", 
            label: <>
                <FaUserTie className="field-icon" />
                Name of financial creditor (in BLOCK LETTERS) <span className="required-asterisk">*</span>
            </>, 
            type: "text", 
            rules: { 
                required: "Creditor name is required",
                pattern: {
                    value: /^[A-Z\s]+$/,
                    message: "Please enter in BLOCK LETTERS only"
                },
                minLength: {
                    value: 3,
                    message: "Name must be at least 3 characters"
                }
            },
            placeholder: "Enter name in BLOCK LETTERS",
            className: "mb-4 creditor-name-field",
            onChange: async (e) => {
                if (!isCRPUser) {
                    await trigger("creditorName");
                }
            },
            colSize: 6,
            disabled: isCRPUser
        },
        { 
            name: "creditorPosition", 
            label: <>
                <MdDescription className="field-icon" />
                Position with or in relation to creditor <span className="required-asterisk">*</span>
            </>, 
            type: "text", 
            rules: { 
                required: "Position is required",
                minLength: {
                    value: 3,
                    message: "Position must be at least 3 characters"
                }
            },
            placeholder: "Enter position/relation to creditor",
            className: "mb-4 creditor-position-field",
            onChange: async (e) => {
                if (!isCRPUser) {
                    await trigger("creditorPosition");
                }
            },
            colSize: 6,
            disabled: isCRPUser
        },
        { 
            name: "creditorSignatureText", 
            label: <>
                <FaSignature className="field-icon" />
                Signature of financial creditor <span className="required-asterisk">*</span>
            </>, 
            type: "text", 
            rules: { 
                required: "Signature is required",
                minLength: {
                    value: 3,
                    message: "Signature must be at least 3 characters"
                }
            },
            placeholder: "Enter signature text",
            className: "mb-4",
            onChange: async (e) => {
                if (!isCRPUser) {
                    await trigger("creditorSignatureText");
                }
            },
            colSize: 6,
            disabled: isCRPUser
        },
        { 
            name: "creditorAddress", 
            label: <>
                <FaHome className="field-icon" />
                Address of person signing <span className="required-asterisk">*</span>
            </>, 
            type: "textarea",
            rules: { 
                required: "Address is required",
                minLength: {
                    value: 10,
                    message: "Address must be at least 10 characters"
                }
            },
            placeholder: "Enter complete address",
            className: "mb-4",
            rows: 3,
            onChange: async (e) => {
                if (!isCRPUser) {
                    await trigger("creditorAddress");
                }
            },
            colSize: 12,
            disabled: isCRPUser
        },
        { 
            name: "hasSignature", 
            label: <>
                <FaUpload className="field-icon" />
                Do you have a signature to upload?
            </>, 
            type: "radio", 
            options: [
                { value: "yes", label: "Yes" },
                { value: "no", label: "No" }
            ],
            rules: { required: "Please select an option" },
            className: "mb-4",
            onChange: (e) => {
                if (!isCRPUser) {
                    setHasSignature(e.target.value === "yes");
                    setValue("signatureFile", null);
                    setUploadSuccess(false);
                }
            },
            colSize: 6,
            inline: true,
            disabled: isCRPUser
        },
        
        ...(hasSignature ? [{
            name: "signatureFile",
            label: <>
                <FaSignature className="field-icon" />
                Upload Signature <span className="required-asterisk">*</span>
            </>,
            type: "file",
            rules: { 
                required: "Signature file is required",
                validate: {
                    fileSize: (files) => {
                        if (files && files[0]) {
                            const fileSizeInMB = files[0].size / (1024 * 1024);
                            return fileSizeInMB <= 5 || "File size must be ≤ 5MB";
                        }
                        return true;
                    }
                }
            },
            accept: ".jpg,.jpeg,.png,.pdf",
            onFileUpload: handleFileUpload,
            isUploading,
            uploadError,
            uploadSuccess,
            note: "Max file size: 5MB (PDF, JPEG, PNG)",
            className: "mb-4 border p-3 rounded",
            colSize: 6,
            disabled: isCRPUser
        }] : [])
    ];

    const onSubmit = useCallback(async () => {
        const isValid = await trigger();
        
        if (!isValid) {
            const errorField = Object.keys(errors)[0];
            if (errorField) {
                document.querySelector(`[name="${errorField}"]`)?.scrollIntoView({ 
                    behavior: 'smooth', 
                    block: 'center' 
                });
            }
            return false;
        }
        
        return getValues();
    }, [trigger, getValues, errors]);

    useEffect(() => {
        if (formData) {
            Object.keys(formData).forEach((key) => {
                setValue(key, formData[key], { shouldValidate: true });
            });
            if (formData.hasSignature) {
                setHasSignature(formData.hasSignature === "yes");
            }
        }
    }, [formData, setValue]);

    useEffect(() => {
        if (provideSubmitHandler) {
            provideSubmitHandler(onSubmit);
        }
    }, [provideSubmitHandler, onSubmit]);

    // Make sure DynamicField component can handle disabled prop
    const enhancedCreditorDetailsSchema = creditorDetailsSchema.map(field => ({
        ...field,
        disabled: isCRPUser
    }));

    return (
       <FormProvider {...methods}>
                <form className="form-stepper">
                    <div className="form-section-container">
                        <Collapsible 
                            title={
                                <div className="section-header">
                                    <FaSignature className="section-icon" />
                                    <span>Signature of financial creditor or person authorised to act on its behalf</span>
                                </div>
                            } 
                            defaultOpen={true}
                        >
                            <div className="row g-3 align-items-start">
                                {enhancedCreditorDetailsSchema.map((fieldConfig) => (
                                    <div 
                                        key={fieldConfig.name} 
                                        className={`col-md-${fieldConfig.colSize || 12} ${fieldConfig.className}`}
                                    >
                                        <DynamicField
                                            fieldConfig={{
                                                ...fieldConfig,
                                                isUploading,
                                                uploadError,
                                                uploadSuccess,
                                                setIsUploading,
                                                setUploadError,
                                                setUploadSuccess,
                                                onFileUpload: handleFileUpload
                                            }}
                                            control={control}
                                            register={register}
                                            errors={errors}
                                            setValue={setValue}
                                            trigger={trigger}
                                            getValues={getValues}
                                        />
                                    </div>
                                ))}
                            </div>
                        </Collapsible>
                    </div>
                </form>
            </FormProvider>
    );
};

export default StepThird;



import React from 'react';
import { useFormContext } from 'react-hook-form';
import "react-datepicker/dist/react-datepicker.css";
import { Download, CheckCircle, Info } from "lucide-react";
import { Button, Tooltip, OverlayTrigger } from "react-bootstrap";
// import './DynamicField.css'; // Create this CSS file for custom styles

const DynamicField = ({
  fieldConfig,
  register,
  errors,
  setValue,
  trigger,
  getValues,
  control,
}) => {
  const {
    name,
    label,
    type,
    rules = {},
    options = [],
    placeholder = '',
    disabled = false,
    tooltip = '',
    note = '',
    accept = '',
    isUploading = false,
    uploadError = null,
    onFileUpload = () => {},
    setIsUploading = () => {},
    setUploadError = () => {},
    defaultValue = null,
    onChange = () => {},
    inline = false,
    icon = null,
  } = fieldConfig;

  const { watch } = useFormContext();
  const value = watch(name);
  const hasError = errors[name];
  const [uploadSuccess, setUploadSuccess] = React.useState(false);

  const handleFileChange = async (e) => {
    const file = e.target.files[0];
    if (file && fieldConfig.onFileUpload) {
      try {
        fieldConfig.setIsUploading(true);
        fieldConfig.setUploadError(null);
        setUploadSuccess(false);

        const result = await fieldConfig.onFileUpload(file);

        if (result.success) {
          setValue(name, {
            fileId: result.fileId,
            docName: result.docName,
            docType: result.docType,
            docSource: result.docSource,
            fileUrl: result.fileUrl
          }, { shouldValidate: true });
          setUploadSuccess(true);
        }
      } catch (error) {
        fieldConfig.setUploadError(error.message);
        setValue(name, null, { shouldValidate: true });
        setUploadSuccess(false);
      } finally {
        fieldConfig.setIsUploading(false);
      }
    }
  };

  const renderFilePreview = (fileValue) => {
    if (!fileValue) return null;

    const fileUrl = typeof fileValue === 'object' ? 
      `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileValue.fileId}` : 
      fileValue;

    const fileName = typeof fileValue === 'object' ? 
      fileValue.docName || fileValue.name || 'Uploaded file' : 
      fileValue;

    return (
      <div className="file-preview-container mt-2">
        {uploadSuccess && (
          <div className="text-success d-flex align-items-center gap-2 mb-2">
            <CheckCircle size={16} />
            <span>File uploaded successfully!</span>
          </div>
        )}
        <div className="d-flex align-items-center gap-2 bg-light p-2 rounded">
          <span className="text-truncate" style={{ maxWidth: '200px' }}>{fileName}</span>
          <Button
            variant="outline-primary"
            size="sm"
            href={fileUrl}
            target="_blank"
            rel="noopener noreferrer"
            download
            className="p-1 ms-auto"
            title="Download file"
          >
            <Download size={16} />
          </Button>
        </div>
      </div>
    );
  };

  const handleRadioChange = (e) => {
    const selectedValue = e.target.value;
    setValue(name, selectedValue, { shouldValidate: true });
    onChange(e);
  };

  const renderTooltip = (text) => (
    <Tooltip id={`tooltip-${name}`}>{text}</Tooltip>
  );

  const renderField = () => {
    switch (type) {
      case 'text':
      case 'email':
      case 'number':
        return (
          <div className="input-group">
            {/* {icon && (
              <span className="input-group-text">
                {icon}
              </span>
            )} */}
            <input
              type={type}
              id={name}
              className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
              placeholder={placeholder}
              disabled={disabled}
              {...register(name, rules)}
            />
          </div>
        );
      case 'textarea':
        return (
          <textarea
            id={name}
            className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
            placeholder={placeholder}
            rows={3}
            {...register(name, rules)}
          />
        );
      case 'select':
        return (
          <select
            id={name}
            className={`form-control ${errors[name] ? 'is-invalid' : ''}`}
            {...register(name, rules)}
          >
            <option value="">{placeholder || 'Select an option'}</option>
            {options.map((option) => (
              <option key={option.value} value={option.value}>
                {option.label}
              </option>
            ))}
          </select>
        );
      case 'radio':
        return (
          <div className={`d-flex ${inline ? 'flex-wrap gap-3' : 'flex-column gap-2'}`}>
            {options.map((option) => (
              <div key={option.value} className="form-check">
                <input
                  type="radio"
                  id={`${name}-${option.value}`}
                  className="form-check-input"
                  style={{
                    backgroundColor: value === option.value ? '#269ccc' : '',
                    borderColor: '#269ccc',
                  }}
                  value={option.value}
                  checked={value === option.value}
                  {...register(name, rules)}
                  onChange={handleRadioChange}
                />
                <label
                  htmlFor={`${name}-${option.value}`}
                  className="form-check-label"
                >
                  {option.label}
                </label>
              </div>
            ))}
          </div>
        );
      case 'file':
        return (
          <div className="custom-file-input">
            {note && (
              <small className="text-muted d-block mb-2">
                {note}
              </small>
            )}
            <input
              type="file"
              id={name}
              onChange={handleFileChange}
              className="d-none"
              disabled={isUploading || disabled}
              accept={accept}
            />
            <label
              htmlFor={name}
              className={`btn btn-outline-primary ${isUploading ? 'disabled' : ''}`}
            >
              {isUploading ? (
                <>
                  <span className="spinner-border spinner-border-sm me-2" role="status"></span>
                  Uploading...
                </>
              ) : (
                'Choose File'
              )}
            </label>
            {value && renderFilePreview(value)}
            {uploadError && (
              <div className="text-danger mt-2 small">
                {uploadError}
              </div>
            )}
          </div>
        );
     
     
        default:
        return null;
    }
  };

  return (
    <div className={`mb-3 ${type === 'radio' ? 'radio-field' : ''}`}>
      <label htmlFor={name} className="form-label d-flex align-items-center">
        {icon && <span className="me-2">{icon}</span>}
        {label}
        {tooltip && (
          <OverlayTrigger
            placement="top"
            overlay={renderTooltip(tooltip)}
          >
            <span className="ms-2">
              <Info size={14} className="text-muted" />
            </span>
          </OverlayTrigger>
        )}
      </label>
      {renderField()}
      {errors[name] && (
        <div className="invalid-feedback d-block">
          {errors[name].message}
        </div>
      )}
    </div>
  );
};

export default DynamicField;
