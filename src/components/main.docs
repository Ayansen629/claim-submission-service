<div
  style={{
    position: "absolute",
    top: "10px",
    right: "10px",
    zIndex: 9999, // Increased z-index
  }}
>
  <Dropdown>
    <Dropdown.Toggle
      variant="link"
      className="p-0 d-flex align-items-center gap-1"
      style={{
        color: "#fff",
        textDecoration: "none",
        fontSize: "1.5rem",
        marginTop: "10px",
      }}
    >
      <FaGlobe />
    </Dropdown.Toggle>
    <Dropdown.Menu 
      className="language-dropdown-menu"
      style={{ zIndex: 10000 }} // Added inline z-index for menu
    >
      <Dropdown.Item
        onClick={() => changeLanguage("en")}
        active={language === "en"}
        className="d-flex align-items-center gap-2"
      >
        <FiFlag size={18} style={{ color: "#2563eb" }} />
        <span>English</span>
        {language === "en" && (
          <FaCheck className="ms-auto text-success" />
        )}
      </Dropdown.Item>
      <Dropdown.Item
        onClick={() => changeLanguage("bn")}
        active={language === "bn"}
        className="d-flex align-items-center gap-2"
      >
        <GiIndiaGate size={18} style={{ color: "#f59e42" }} />
        <span>বাংলা</span>
        {language === "bn" && (
          <FaCheck className="ms-auto text-success" />
        )}
      </Dropdown.Item>
    </Dropdown.Menu>
  </Dropdown>
</div>
