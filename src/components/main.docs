// FormFieldsConfig.js
import React from 'react';
import { FaUser, FaIdCard, FaEnvelope, FaPhone, FaMapMarkerAlt } from 'react-icons/fa';
import { CONSTANT_REGEX } from '../../../utils/constants.ts';

const createFormFieldsConfig = (getDetailsByPIN) => {
  return {
    step1: [
      {
        name: 'firstName',
        label: 'First Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 80,
        placeholder: "Enter Builder's First name",
        validation: { required: 'First name is required' }
      },
      {
        name: 'lastName',
        label: 'Last Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        maxlength: 80,
        placeholder: "Enter Builder's Last name",
        validation: { required: 'Last name is required' }
      },
      {
        name: 'emailId',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: {
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      {
        name: 'phoneNumber',
        label: 'Phone Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        maxlength: 10,
        placeholder: 'Enter 10-digit phone number',
        validation: {
          required: 'Phone number is required (10 digits)',
          pattern: {
            value: CONSTANT_REGEX.MOBILE,
            message: 'Please enter a valid Phone number'
          }
        },
      },
      {
        name: 'panNumber',
        label: 'PAN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        maxlength: 10,
        placeholder: 'Enter PAN number (e.g., ABCDE1234F)',
        validation: {
          required: 'PAN number is required',
          pattern: {
            value: CONSTANT_REGEX.PAN,
            message: 'Invalid PAN number'
          }
        }
      },
      {
        name: 'gstNumber',
        label: 'GST Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter GST number',
        maxlength: 15,
        validation: {
          required: 'GST number is required',
          pattern: {
            value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
            message: 'Invalid GST No.'
          }
        }
      },
      {
        name: 'addressLine1',
        label: 'Address Line-1',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 100,
        placeholder: 'Enter address line 1',
        validation: { required: 'Address is required' }
      },
      {
        name: 'addressLine2',
        label: 'Address Line-2',
        type: 'text',
        required: false,
        maxlength: 100,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 2 (optional)'
      },
      {
        name: 'pin',
        label: 'PIN',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 6,
        placeholder: 'Enter 6-digit PIN code',
        validation: {
          required: 'PIN code is required',
          pattern: {
            value: /^[0-9]{6}$/,
            message: 'PIN must be 6 digits'
          }
        },
        onChange: (e, setValue, watch) => {
          const changedValue = e?.target?.value || "";
          if (changedValue?.length === 6) {
            setValue('district', '');
            setValue('stateUt', '');
            setValue('country', 'India');
            getDetailsByPIN(changedValue);
          }
        },
      },
      {
        name: 'district',
        label: 'District',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter district',
      },
      {
        name: 'stateUt',
        label: 'State / UT',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter state',
      },
      {
        name: 'country',
        label: 'Country',
        type: 'text',
        required: false,
        disabled: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Please enter country',
      }
    ],
    step2: [
      {
        name: 'addressProof',
        label: 'Address Proof',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'panCardUpload',
        label: 'PAN Card',
        type: 'file',
        required: false,
        colSize: 6,
      },
      {
        name: 'gstCertificate',
        label: 'GST Certificate',
        type: 'file',
        required: false,
        colSize: 6,
      }
    ]
  };
};

export default createFormFieldsConfig;
