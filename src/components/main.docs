import React, { useState, useEffect, useRef } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFile, FaFilePdf, FaFileImage, FaCheckCircle } from "react-icons/fa";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
  defaultValue?: string | File;
  autoFocus?: boolean;
  clearErrors?: (fieldName: string) => void;
}


const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  watch,
  defaultValue,
  clearErrors
}) => {
  const hasError = errors && errors[name];
  const fileInputRef = useRef(null);
  const [fileSelected, setFileSelected] = useState(false);
   const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  
  const currentFile = watch ? watch(name) : null;

  useEffect(() => {
  
    if (currentFile && fileSelected) {
      clearErrors(name);
    }
  }, [currentFile, fileSelected, name, clearErrors]);

  const handleFileChange = (e) => {
    if (e.target.files && e.target.files[0]) {
      setFileSelected(true);
      if (onChange) {
        onChange(e);
      }
    }
  };

  return (
    <Form.Group className={`mb-4 ${className}`} controlId={name}>
      <Form.Label className="fw-bold text-dark">
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      <div
        className={`file-upload border rounded p-3 ${hasError ? 'border-danger' : currentFile ? 'border-success' : ''}`}
        style={{
          backgroundColor: hasError ? '#fff8f8' : 'white',
          borderRadius: '8px',
          transition: 'all 0.3s ease'
        }}
      >
        <div className="d-flex align-items-center">
          <label
            htmlFor={name}
            className={`file-label btn ${hasError ? 'btn-outline-danger' : 'btn-primary'} mb-0 d-inline-flex align-items-center`}
            style={{
              borderRadius: '6px',
              padding: '8px 16px',
              cursor: disabled ? 'not-allowed' : 'pointer',
              opacity: disabled ? 0.6 : 1,
              minWidth: '120px',
              color: hasError ? '#dc3545' : '#fff',
            
            }}
          >
            <FaUpload className="file-icon me-2" style={{ color: hasError ? '#dc3545' : '#fff' }} />
            <span className="file-text" style={{ color: hasError ? '#dc3545' : '#fff' }}>Choose File</span>
          </label>
          <div
            className={`file-name-container ms-3 flex-grow-1 border rounded px-3 py-2 ${currentFile ? 'bg-light-success' : 'bg-light'} d-flex align-items-center ${hasError ? 'border-danger' : currentFile ? 'border-success' : ''}`}
            style={{
              overflow: 'hidden'
            }}
          >
            {currentFile ? (
              <>
                <FaCheckCircle className="text-success me-2 flex-shrink-0" />
                <div className="overflow-hidden">
                  <span className="text-success fw-bold" style={{ fontSize: '0.8rem' }}>Selected File:</span>
                  <div className="d-flex align-items-center">
                    <span className="file-icon-preview me-2 flex-shrink-0">
                      {currentFile.name.endsWith('.pdf') ? (
                        <FaFilePdf color="#dc3545" />
                      ) : (
                        <FaFileImage color="#28a745" />
                      )}
                    </span>
                    <span 
                      className="text-dark fw-semibold" 
                      style={{ 
                        overflow: 'hidden', 
                        textOverflow: 'ellipsis', 
                        whiteSpace: 'nowrap' 
                      }}
                    >
                      {currentFile.name}
                    </span>
                  </div>
                </div>
              </>
            ) : (
              <span className="text-muted">No file chosen</span>
            )}
          </div>
        </div>
        <input
          ref={fileInputRef}
          type="file"
          id={name}
          onChange={handleFileChange}
          accept={accept}
          disabled={disabled}
          className="d-none"
        />
      </div>
      {hasError ? (
        <Form.Text className="text-danger small mt-1 d-block">
          {errors[name]?.message}
        </Form.Text>
      ) : (
        <Form.Text className="text-muted small mt-1">
          {t("Upload PDF, JPG or PNG file (Max size: 2MB)")}
        </Form.Text>
      )}
    </Form.Group>
  );
};
export default InputFile;
