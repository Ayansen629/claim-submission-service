    },
    mode: "onTouched",
  });
  const {
    trigger,
    getValues,
    setError,
    setValue,
    reset,
    formState: { errors },
  } = methods;
  const [actionsFromAPI, setActionsFromAPI] = useState([]);
  const [registrationData, setRegistrationData] = useState(null);
  const [initialRegistryData, setInitialRegistryData] = useState(null);

  const userRole = getFromLocalStorage("userRole") || "";
  const userDetails = getFromLocalStorage("userDetails")
    ? JSON.parse(getFromLocalStorage("userDetails"))
    : "";

  const isOfficerLogin = OFFICER_ROLES.includes(userRole) || false;

  const [paymentData, setPaymentData] = useState({
