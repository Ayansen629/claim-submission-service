const storedEnclosures = sessionStorage.getItem('step1Enclosures');
  const step1Enclosures = storedEnclosures ? JSON.parse(storedEnclosures) : [];
  
  // Get enclosures with IDs from initial response or stored ones
  let finalEnclosures = [];
  if (registrationData?.RegistrationResponse?.enclosers?.length > 0) {
    finalEnclosures = registrationData.RegistrationResponse.enclosers;
  } else if (step1Enclosures.length > 0) {
    finalEnclosures = step1Enclosures;
  } else {
    finalEnclosures = extractAllEnclosures(formValues);
  }
