.officer-view-container {
  background: linear-gradient(120deg, #f5f7fa 60%, #e3eafc 100%);
  min-height: 100vh;
  padding-bottom: 32px;
}

.card {
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(13,110,253,0.06);
  border: none;
}

.back-btn {
  min-width: 140px;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.application-number {
  background: linear-gradient(90deg, #e3eafc 0%, #b6d0fe 100%);
  color: #0d6efd;
  font-size: 1.05rem;
  font-family: 'Roboto Mono', monospace;
  border: 1.5px solid #b6d0fe;
  margin-right: 0;
}

.status-badge {
  font-size: 1rem;
  padding: 0.5em 1.2em;
  border-radius: 2em;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.stepper-wrapper {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32px;
  position: relative;
  background: transparent;
  padding: 24px 0 12px 0;
}

.stepper-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 120px;
}

.stepper-item:not(:last-child)::after {
  content: "";
  position: absolute;
  top: 18px;
  left: 50%;
  width: 100%;
  height: 4px;
  background: linear-gradient(90deg, #e3eafc 0%, #b6d0fe 100%);
  z-index: 0;
  transform: translateX(18px);
}

.stepper-item:last-child::after {
  display: none;
}

.stepper-item.active .step-counter,
.stepper-item.completed .step-counter {
  background: linear-gradient(135deg, #0d6efd 60%, #198754 100%);
  color: #fff;
  border-color: #0d6efd;
  box-shadow: 0 2px 8px rgba(13,110,253,0.08);
}

.stepper-item.completed .step-counter {
  background: linear-gradient(135deg, #198754 60%, #0d6efd 100%);
  border-color: #198754;
}

.stepper-item .step-counter {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  border: 2.5px solid #dee2e6;
  color: #6c757d;
  font-weight: 700;
  font-size: 1.2rem;
  margin-bottom: 10px;
  transition: all 0.2s;
}

.step-name {
  color: #6c757d;
  font-size: 1rem;
  font-weight: 500;
  letter-spacing: 0.01em;
  text-align: center;
}

.stepper-item.active .step-name {
  color: #0d6efd;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.stepper-item.completed .step-name {
  color: #198754;
  font-weight: 700;
}

.disabled-field {
  background-color: #f8f9fa !important;
  color: #495057 !important;
  cursor: not-allowed !important;
  border: 1.5px solid #e3eafc !important;
  border-radius: 6px !important;
}

.file-display {
  padding: 10px 16px;
  background-color: #f8f9fa;
  border-radius: 6px;
  border: 1.5px solid #dee2e6;
  font-size: 0.97rem;
  min-width: 180px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.file-name {
  font-weight: 500;
  color: #0d6efd;
  font-family: 'Roboto Mono', monospace;
  font-size: 1rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140px;
}

.file-download-btn {
  color: #198754 !important;
  margin-left: 8px;
  padding: 0 6px;
}

@media (max-width: 768px) {
  .stepper-wrapper {
    flex-direction: column;
    align-items: flex-start;
    padding: 16px 0 8px 0;
  }
  .stepper-item {
    flex-direction: row;
    margin-bottom: 18px;
    width: 100%;
    min-width: 0;
  }
  .stepper-item:not(:last-child)::after {
    display: none;
  }
  .stepper-item .step-counter {
    margin-right: 15px;
    margin-bottom: 0;
  }
  .step-name {
    margin-top: 3px;
    text-align: left;
  }
}
