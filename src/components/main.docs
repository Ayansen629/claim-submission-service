<Form className="modern-search">
  <InputGroup className="search-input-group">
    <InputGroup.Text className="search-prefix">
      <BsFilter size={14} className="filter-icon" />
    </InputGroup.Text>
    <Form.Control
      type="text"
      placeholder={t("dashboard.Search Vessels...")}
      className="search-input"
      value={vesselSearchTerm}
      onChange={(e) => setVesselSearchTerm(e.target.value)}
    />
    <Button className="modern-search-btn">
      <BsSearch size={14} />
    </Button>
  </InputGroup>
</Form>


.modern-search .search-input-group {
  border-radius: 25px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 163, 224, 0.1);
  transition: all 0.3s ease;
}

.modern-search .search-input-group:focus-within {
  box-shadow: 0 4px 12px rgba(0, 163, 224, 0.2);
  transform: translateY(-1px);
}

.search-prefix {
  background: linear-gradient(135deg, #00A3E0, #1A61C1);
  border: none;
  color: white;
  padding: 0.75rem 1rem;
}

.search-input {
  border: none;
  padding: 0.75rem 1rem;
  font-size: 0.9rem;
  background: #f8f9fa;
}

.search-input:focus {
  background: white;
  box-shadow: none;
  border: none;
}

.modern-search-btn {
  background: linear-gradient(135deg, #00A3E0, #1A61C1);
  border: none;
  padding: 0.75rem 1.25rem;
  transition: all 0.3s ease;
}

.modern-search-btn:hover {
  background: linear-gradient(135deg, #1A61C1, #00A3E0);
  transform: scale(1.05);
}

.filter-icon {
  opacity: 0.9;
}
