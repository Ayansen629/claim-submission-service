import React, { useState, useEffect } from "react";
import { FaPhone, FaEnvelope, FaCheckSquare, FaEdit } from "react-icons/fa";
import styles from './Profile.module.css';
import UserProfileLogo from "../../../assets/images/user-profilelogo.jpg";
import { getFromLocalStorage } from "../../../utils/localStorageUtils.js";
import { USER_ROLES } from "../../../utils/constants.ts";
import ImportantModal from "./ImportantModal";

const Profile = () => {
  const [profileData, setProfileData] = useState({
    name: "",
    phone: "",
    email: "",
    pan: "",
    aadhar: "",
    license: ""
  });
  const [userRole, setUserRole] = useState("");
  const [showModal, setShowModal] = useState(false);
  const [selectedOption, setSelectedOption] = useState("");

  useEffect(() => {
    const safeParse = (key) => {
      try {
        return JSON.parse(getFromLocalStorage(key) || "{}");
      } catch {
        return {};
      }
    };

    const role = getFromLocalStorage("userRole");
    setUserRole(role);
    let data = {};

    if (role === USER_ROLES.VESSEL_OWNER) {
      const ownerDetails = safeParse("ownerDetails");
      data = {
        name: ownerDetails.ownerCompanyName || ownerDetails.authorisedFname || "Not Available",
        phone: ownerDetails.phoneNumber || "Not Available",
        email: ownerDetails.emailId || "Not Available",
        pan: ownerDetails.panNo ? `${ownerDetails.panNo.substring(0, 4)}*******` : "Not Available",
        aadhar: ownerDetails.aadharNumber ? `${ownerDetails.aadharNumber.substring(0, 4)} ${ownerDetails.aadharNumber.substring(4, 8)} ****` : "Not Available",
        license: ownerDetails.tradeLicenseNumber ? `${ownerDetails.tradeLicenseNumber.substring(0, 15)}******` : "Not Available"
      };
    } else {
      const employeeDetails = safeParse("employeeDetails");
      data = {
        name: `${employeeDetails.firstName || ""} ${employeeDetails.lastName || ""}`.trim() || "Not Available",
        phone: employeeDetails.phoneNumber || "Not Available",
        email: employeeDetails.emailId || "Not Available",
        pan: "Not Available",
        aadhar: "Not Available",
        license: "Not Available"
      };
    }

    setProfileData(data);
  }, []);

  const handleOptionSelect = (option) => {
    setSelectedOption(option);
  };

  const handleProceed = () => {
    if (selectedOption) {
      setShowModal(true);
    }
  };

  const closeModal = () => {
    setShowModal(false);
    setSelectedOption("");
  };

  return (
    <div className={styles.container}>
      <div className={styles.card}>
        <div className={styles.circularImage}>
          <img 
            src={UserProfileLogo}
            alt="Profile"
          />
          <div className={styles.editIcon}>
            <FaEdit />
          </div>
        </div>
        
        <h1 className={styles.companyName}>{profileData.name}</h1>
        
        <div className={styles.contactRow}>
          <div className={styles.contactItem}>
            <FaPhone className={styles.phoneIcon} />
            <span>{profileData.phone !== "Not Available" ? `+91 ${profileData.phone}` : profileData.phone}</span>
          </div>
          <div className={styles.contactItem}>
            <FaEnvelope className={styles.emailIcon} />
            <span>{profileData.email}</span>
          </div>
        </div>
        
        <div className={styles.documentRow}>
          <span className={styles.docLabel}>PAN Number: {profileData.pan}</span>
          <span className={styles.docLabel}>Aadhar Number: {profileData.aadhar}</span>
          {userRole === USER_ROLES.VESSEL_OWNER && (
            <span className={styles.docLabel}>Trade License No: {profileData.license}</span>
          )}
        </div>
        
        {userRole === USER_ROLES.VESSEL_OWNER && (
          <div className={styles.vesselSection}>
            <div className={styles.optionsSection}>
              <div 
                className={`${styles.option} ${selectedOption === 'Name Change' ? styles.selected : ''}`}
                onClick={() => handleOptionSelect('Name Change')}
              >
                <FaCheckSquare className={styles.checkIcon} />
                <span>Name Change</span>
                <FaEdit className={styles.optionEditIcon} />
              </div>
              <div 
                className={`${styles.option} ${selectedOption === 'Address Change' ? styles.selected : ''}`}
                onClick={() => handleOptionSelect('Address Change')}
              >
                <FaCheckSquare className={styles.checkIcon} />
                <span>Address Change</span>
                <FaEdit className={styles.optionEditIcon} />
              </div>
            </div>
          </div>
        )}
        
        <button className={styles.proceedButton} onClick={handleProceed}>
          Proceed Now
        </button>
      </div>
      
      <ImportantModal 
        show={showModal}
        onClose={closeModal}
        selectedOption={selectedOption}
      />
    </div>
  );
};

export default Profile;
