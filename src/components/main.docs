{/* DECLARATION OF OWNERSHIP */}
<Collapsible
  title={
    <div className="d-flex align-items-center">
      <FaUser className="me-2" style={{ color: "#2466BF" }} />
      <span style={{ color: "#2466BF" }}>
        {t("DECLARATION OF OWNERSHIP")}
      </span>
    </div>
  }
  defaultOpen={true}
>
  <Card className="form-section-card">
    <Card.Body>
      <div className="declaration-wrapper">
        <div className="d-flex justify-content-end mb-3">
          {!isViewMode && (
            <>
              {!isFormSubmitted && !isDeclarationEditable && !watch("workOrderDate") && (
                <Button
                  size="sm"
                  onClick={() => setIsDeclarationEditable(true)}
                  style={{
                    backgroundColor: "#007bff",
                    borderColor: "#007bff",
                    color: "#ffffff",
                    marginRight: "10px"
                  }}
                >
                  Select Work Order Date
                </Button>
              )}
              {!isFormSubmitted && isDeclarationEditable && (
                <Button
                  size="sm"
                  onClick={() => {
                    if (!watch("workOrderDate")) {
                      toast.error("Please select work order date first");
                      return;
                    }
                    setIsDeclarationEditable(false);
                    toast.success("Work order date saved successfully!");
                  }}
                  style={{
                    backgroundColor: "#28a745",
                    borderColor: "#28a745",
                    color: "#ffffff",
                    marginRight: "10px"
                  }}
                >
                  Save Date
                </Button>
              )}
              {!isFormSubmitted && watch("workOrderDate") && !isDeclarationEditable && (
                <Button
                  size="sm"
                  onClick={() => setIsDeclarationEditable(true)}
                  style={{
                    backgroundColor: "#ffc107",
                    borderColor: "#ffc107",
                    color: "#000000",
                    marginRight: "10px"
                  }}
                >
                  Edit Date
                </Button>
              )}
              {watch("workOrderDate") && (
                <Button
                  size="sm"
                  onClick={handleGenerateDeclaration}
                  style={{
                    backgroundColor: "#00A3E0",
                    borderColor: "#00A3E0",
                    color: "#ffffff",
                  }}
                >
                  Generate Declaration
                </Button>
              )}
            </>
          )}
        </div>

        <div className="declaration-content">
          <div className="declaration-text">
            <p className="mb-3 text-justify">
              I/We <span
                className={`highlight-field ${watch("ownerName") ? "auto-populated" : ""}`}
              >
                <strong><em>{watch("ownerName") || "[Owner Name]"}</em></strong>
              </span> residing permanently at{" "}
              <span
                className={`highlight-field ${watch("address") ? "auto-populated" : ""}`}
              >
                <strong><em>{watch("address") || "[Address of Owner]"}</em></strong>
              </span> having original place of business at{" "}
              <span
                className={`highlight-field ${watch("originalPlaceOfBusiness") ? "auto-populated" : ""}`}
              >
                <strong><em>{watch("originalPlaceOfBusiness") || "[Place of Business]"}</em></strong>
              </span>
            </p>

            <p className="mb-3 text-justify">
              do hereby declare that vessel named <span
                className={`highlight-field ${watch("vesselName") ? "auto-populated" : ""}`}
              >
                <strong><em>{watch("vesselName") || "[Vessel Name]"}</em></strong>
              </span> was built at{" "}
              <span
                className={`highlight-field ${watch("placeOfBuild") ? "auto-populated" : ""}`}
              >
                <strong><em>{watch("placeOfBuild") || "[Place of Build]"}</em></strong>
              </span>
            </p>

            <p className="mb-3 text-justify">
              in the year <span
                className={`highlight-field ${watch("vesselyearOfBuild") ? "auto-populated" : ""}`}
              >
                <strong><em>{watch("vesselyearOfBuild") || "[Year of Build]"}</em></strong>
              </span> and was purchased by me on{" "}
              {isDeclarationEditable ? (
                <InputText
                  name="workOrderDate"
                  type="date"
                  register={register("workOrderDate", {
                    required: "Work order date is required"
                  })}
                  maxDate=""
                  errors={errors}
                  clearErrors={clearErrors}
                  className="d-inline-block"
                  style={{
                    width: "auto",
                    display: "inline-block",
                    minWidth: "150px",
                    margin: "0 4px"
                  }}
                />
              ) : (
                <span
                  className="highlight-field editable-field"
                >
                  <strong><em>{watch("workOrderDate") ? new Date(watch("workOrderDate")).toLocaleDateString('en-GB') : "[Work Order Date]"}</em></strong>
                </span>
              )}
              {" "}for rupees <span
                className={`highlight-field ${watch("workOrderValue") ? "auto-populated" : ""}`}
              >
                <strong><em>{watch("workOrderValue") || "[Work Order Value]"}</em></strong>
              </span> and wish to have the same registered in my name at the port of{" "}
              <span
                className={`highlight-field ${watch("nameOfRegistry") ? "auto-populated" : ""}`}
              >
                <strong><em>{watch("nameOfRegistry") || "[Port of Registry]"}</em></strong>
              </span> and that I am the owner of the same.
            </p>
          </div>
        </div>
      </div>
    </Card.Body>
  </Card>
</Collapsible>
