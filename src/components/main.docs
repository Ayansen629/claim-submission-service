/* Dashboard Styles */
.dashboard-card {
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(13, 110, 253, 0.06);
  border: none;
}

.dashboard-card-header {
  background: linear-gradient(90deg, #0d6efd 0%, #0b5ed7 100%);
  color: white;
  padding: 1rem 1.5rem;
  border-bottom: none;
}

.inbox-search .form-control {
  border-radius: 6px;
  border-right: none;
}

.inbox-search .btn {
  border-radius: 0 6px 6px 0;
}

.filter-btn {
  border-radius: 6px;
}

.status-badge {
  font-size: 0.85rem;
  padding: 0.35em 0.8em;
  border-radius: 2em;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.status-badge.pending {
  background-color: #fff3cd;
  color: #856404;
}

.status-badge.completed {
  background-color: #d4edda;
  color: #155724;
}

.status-badge.processing {
  background-color: #cce5ff;
  color: #004085;
}

.status-badge.rejected {
  background-color: #f8d7da;
  color: #721c24;
}

/* Filter Card Styles */
.filter-card {
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(13, 110, 253, 0.06);
  border: none;
}

.filter-card .card-header {
  background: linear-gradient(90deg, #0d6efd 0%, #0b5ed7 100%);
  color: white;
  padding: 1rem 1.5rem;
  border-bottom: none;
}

.filter-card .card-header h5 {
  margin-bottom: 0;
  font-weight: 600;
}

.filter-card .card-body {
  padding: 1.5rem;
}

.filter-card .form-label {
  font-weight: 500;
  color: #495057;
  margin-bottom: 0.5rem;
}

.filter-card .btn {
  padding: 0.5rem 1rem;
  font-weight: 500;
}

/* Responsive adjustments */
@media (max-width: 992px) {
  .filter-card .col-md-3 {
    margin-bottom: 1rem;
  }
  
  .filter-card .d-flex.align-items-end {
    margin-top: 1rem;
  }
  
  .dashboard-card-header {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .dashboard-card-header > div {
    margin-bottom: 0.5rem;
  }
}
