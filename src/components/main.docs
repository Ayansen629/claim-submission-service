// Stepper.js
import React, { useState, useRef, useEffect, useCallback, useMemo } from "react";
import { useNavigate, useParams } from "react-router-dom";
import { toast } from "react-toastify";
import { Modal, Button, Form } from "react-bootstrap";
import "./Stepper.css";
import { useRegistration } from "../../context/ApplicationContext";
import ReviewStep from "./ReviewStep";
import { FormDataProvider } from "../../context/FormDataContext";

// ... (keep all the existing utility functions: deepEqual, generateFileId, extractFileDetails, etc.)

const Stepper = ({ stepsConfig = [], formAllData }) => {
  // ... (keep all the existing state declarations)

  /**
   * Handles preview functionality - shows all form data in console and modal
   */
  const handlePreview = async () => {
    if (!currentSubmitHandler) {
      console.error("No submit handler available.");
      return;
    }

    const currentStepData = await currentSubmitHandler();
    if (!currentStepData) {
      console.error("Form validation failed.");
      return;
    }

    if (!validateStepData(currentStep, currentStepData)) {
      return;
    }

    const processedStepData = await processFileUploads(currentStepData, currentStep);
    
    const updatedFormData = {
      ...formData,
      [`step${currentStep}`]: { ...formData[`step${currentStep}`], ...processedStepData },
    };

    if (!deepEqual(updatedFormData, formData)) {
      setFormData(updatedFormData);
      updateRegistrationData(`step${currentStep}`, updatedFormData[`step${currentStep}`], id);
    }

    // Create the payload same as handleNext would
    const previewPayload = createFormPayload(updatedFormData);
    console.log("Preview Payload:", JSON.stringify(previewPayload, null, 2));
    
    // Open the preview modal
    setHasPreviewed(true);
    setIsViewModalOpen(true);
  };

  // ... (keep all other existing functions: handleNext, handleSaveDraft, etc.)

  return (
    <FormDataProvider formData={flattenFormData(formData)}> 
      {/* ... (keep all existing JSX until the buttons section) */}

      <div className="stepper-buttons">
        {currentStep > 1 && (
          <button className="buttonplus previous-button" onClick={handlePrevious}>
            Previous
          </button>
        )}
        {currentStep === 1 && (
          <button className="buttonplus cancel-button" onClick={handleCancel}>
            Cancel
          </button>
        )}

        {currentStep === 3 && !isCRPUser && (
          <div className="last-step-buttons">
            <button
              className="buttonplus draft-button"
              onClick={handleSaveDraft}
              disabled={isSavingDraft}
            >
              {isSavingDraft ? "Saving..." : "Save as Draft"}
            </button>
            <button
              className="buttonplus preview-button"
              onClick={handlePreview}  // Changed to use handlePreview
            >
              Preview
            </button>
          </div>
        )}

        {/* ... (keep rest of the button JSX) */}
      </div>

      {/* Preview Modal */}
      <Modal 
        show={isViewModalOpen} 
        onHide={() => setIsViewModalOpen(false)}
        size="lg"
        centered
      >
        <Modal.Header closeButton>
          <Modal.Title>Form Preview</Modal.Title>
        </Modal.Header>
        <Modal.Body>
          <ReviewStep 
            formData={flattenFormData(formData)}
            isPreview={true}
            onConfirm={() => {
              setIsViewModalOpen(false);
              handleNext(); // Submit the form when confirmed
            }}
          />
        </Modal.Body>
        <Modal.Footer>
          <Button variant="secondary" onClick={() => setIsViewModalOpen(false)}>
            Back to Edit
          </Button>
          <Button 
            variant="primary" 
            onClick={() => {
              setIsViewModalOpen(false);
              handleNext(); // Submit the form
            }}
          >
            Confirm and Submit
          </Button>
        </Modal.Footer>
      </Modal>

      {/* Existing Action Modal */}
      <Modal show={showModal} onHide={handleModalClose} centered>
        {/* ... (keep existing action modal JSX) */}
      </Modal>
    </FormDataProvider>
  );
};

export default Stepper;
