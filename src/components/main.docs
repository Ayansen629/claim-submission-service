import React, { useState } from 'react';
import { useForm, Controller } from 'react-hook-form';
import {
  Stepper,
  Step,
  StepLabel,
  Button,
  TextField,
  MenuItem,
  Grid,
  Paper,
  Typography,
  IconButton,
  InputAdornment,
  FormControl,
  InputLabel,
  Select,
} from '@mui/material';
import AddCircleOutlineIcon from '@mui/icons-material/AddCircleOutline';
import RemoveCircleOutlineIcon from '@mui/icons-material/RemoveCircleOutline';

const VesselOwnerRegistrationForm = () => {
  const [activeStep, setActiveStep] = useState(0);
  const [authorizedPersons, setAuthorizedPersons] = useState([{ id: 1 }]);
  const { control, handleSubmit, watch, trigger } = useForm({
    defaultValues: {
      categoryOfOwner: '',
      ownerName: '',
      email: '',
      phoneNumber: '',
      panNumber: '',
      gstNumber: '',
      addressLine1: '',
      addressLine2: '',
      pin: '',
      district: '',
      state: '',
      country: '',
      authorizedPersons: [{
        firstName: '',
        lastName: '',
        mobileNumber: '',
        email: '',
        authorizationLetter: null,
      }],
      documents: {
        panCard: null,
        gstCertificate: null,
        addressProof: null,
        companyRegistrationCertificate: null,
        cinNumber: '',
        dinNumber: '',
        moaCertificate: null,
        aoaCertificate: null,
      },
    },
  });

  const ownerCategory = watch('categoryOfOwner');
  const steps = ['Owner Details', 'Authorized Persons', 'Documents Upload'];

  const handleNext = async () => {
    let isValid = false;
    
    if (activeStep === 0) {
      isValid = await trigger([
        'categoryOfOwner', 'ownerName', 'email', 'phoneNumber', 
        'panNumber', 'addressLine1', 'pin'
      ]);
    } else if (activeStep === 1) {
      isValid = await trigger(['authorizedPersons']);
    }

    if (isValid) {
      setActiveStep((prevActiveStep) => prevActiveStep + 1);
    }
  };

  const handleBack = () => {
    setActiveStep((prevActiveStep) => prevActiveStep - 1);
  };

  const handleAddAuthorizedPerson = () => {
    setAuthorizedPersons([...authorizedPersons, { id: Date.now() }]);
  };

  const handleRemoveAuthorizedPerson = (id) => {
    if (authorizedPersons.length > 1) {
      setAuthorizedPersons(authorizedPersons.filter(person => person.id !== id));
    }
  };

  const onSubmit = (data) => {
    console.log('Form submitted:', data);
    // Handle form submission logic here
  };

  const getStepContent = (step) => {
    switch (step) {
      case 0:
        return (
          <Grid container spacing={3}>
            <Grid item xs={12}>
              <Controller
                name="categoryOfOwner"
                control={control}
                rules={{ required: 'Category is required' }}
                render={({ field, fieldState: { error } }) => (
                  <FormControl fullWidth error={!!error}>
                    <InputLabel>Category of Owner</InputLabel>
                    <Select
                      {...field}
                      label="Category of Owner"
                    >
                      <MenuItem value="Individual">Individual</MenuItem>
                      <MenuItem value="Company">Company</MenuItem>
                      <MenuItem value="Organization">Organization</MenuItem>
                    </Select>
                    {error && <Typography color="error">{error.message}</Typography>}
                  </FormControl>
                )}
              />
            </Grid>
            
            <Grid item xs={12}>
              <Controller
                name="ownerName"
                control={control}
                rules={{ required: 'Name is required' }}
                render={({ field, fieldState: { error } }) => (
                  <TextField
                    {...field}
                    label={ownerCategory === 'Individual' ? 'Owner Name' : 'Company/Organization Name'}
                    fullWidth
                    error={!!error}
                    helperText={error?.message}
                  />
                )}
              />
            </Grid>
            
            <Grid item xs={12} sm={6}>
              <Controller
                name="email"
                control={control}
                rules={{ 
                  required: 'Email is required',
                  pattern: {
                    value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                    message: 'Invalid email address'
                  }
                }}
                render={({ field, fieldState: { error } }) => (
                  <TextField
                    {...field}
                    label="Email ID"
                    fullWidth
                    error={!!error}
                    helperText={error?.message}
                  />
                )}
              />
            </Grid>
            
            <Grid item xs={12} sm={6}>
              <Controller
                name="phoneNumber"
                control={control}
                rules={{ 
                  required: 'Phone number is required',
                  pattern: {
                    value: /^[0-9]{10}$/,
                    message: 'Invalid phone number'
                  }
                }}
                render={({ field, fieldState: { error } }) => (
                  <TextField
                    {...field}
                    label="Phone Number"
                    fullWidth
                    error={!!error}
                    helperText={error?.message}
                  />
                )}
              />
            </Grid>
            
            <Grid item xs={12} sm={6}>
              <Controller
                name="panNumber"
                control={control}
                rules={{ 
                  required: 'PAN is required',
                  pattern: {
                    value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
                    message: 'Invalid PAN number'
                  }
                }}
                render={({ field, fieldState: { error } }) => (
                  <TextField
                    {...field}
                    label="PAN Number"
                    fullWidth
                    error={!!error}
                    helperText={error?.message}
                  />
                )}
              />
            </Grid>
            
            {ownerCategory !== 'Individual' && (
              <Grid item xs={12} sm={6}>
                <Controller
                  name="gstNumber"
                  control={control}
                  rules={{ 
                    pattern: {
                      value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
                      message: 'Invalid GST number'
                    }
                  }}
                  render={({ field, fieldState: { error } }) => (
                    <TextField
                      {...field}
                      label="GST Number"
                      fullWidth
                      error={!!error}
                      helperText={error?.message}
                    />
                  )}
                />
              </Grid>
            )}
            
            <Grid item xs={12}>
              <Typography variant="subtitle1" gutterBottom>
                Address Details
              </Typography>
            </Grid>
            
            <Grid item xs={12}>
              <Controller
                name="addressLine1"
                control={control}
                rules={{ required: 'Address Line 1 is required' }}
                render={({ field, fieldState: { error } }) => (
                  <TextField
                    {...field}
                    label="Address Line 1"
                    fullWidth
                    error={!!error}
                    helperText={error?.message}
                  />
                )}
              />
            </Grid>
            
            <Grid item xs={12}>
              <Controller
                name="addressLine2"
                control={control}
                render={({ field }) => (
                  <TextField
                    {...field}
                    label="Address Line 2"
                    fullWidth
                  />
                )}
              />
            </Grid>
            
            <Grid item xs={12} sm={4}>
              <Controller
                name="pin"
                control={control}
                rules={{ 
                  required: 'PIN is required',
                  pattern: {
                    value: /^[1-9][0-9]{5}$/,
                    message: 'Invalid PIN code'
                  }
                }}
                render={({ field, fieldState: { error } }) => (
                  <TextField
                    {...field}
                    label="PIN"
                    fullWidth
                    error={!!error}
                    helperText={error?.message}
                  />
                )}
              />
            </Grid>
            
            <Grid item xs={12} sm={4}>
              <Controller
                name="district"
                control={control}
                render={({ field }) => (
                  <TextField
                    {...field}
                    label="District"
                    fullWidth
                    disabled
                  />
                )}
              />
            </Grid>
            
            <Grid item xs={12} sm={4}>
              <Controller
                name="state"
                control={control}
                render={({ field }) => (
                  <TextField
                    {...field}
                    label="State/UT"
                    fullWidth
                    disabled
                  />
                )}
              />
            </Grid>
            
            <Grid item xs={12} sm={4}>
              <Controller
                name="country"
                control={control}
                render={({ field }) => (
                  <TextField
                    {...field}
                    label="Country"
                    fullWidth
                    disabled
                  />
                )}
              />
            </Grid>
          </Grid>
        );
      case 1:
        return (
          <Grid container spacing={3}>
            {authorizedPersons.map((person, index) => (
              <React.Fragment key={person.id}>
                <Grid item xs={12}>
                  <Typography variant="subtitle1" gutterBottom>
                    Authorized Person {index + 1}
                  </Typography>
                  {index > 0 && (
                    <IconButton 
                      onClick={() => handleRemoveAuthorizedPerson(person.id)}
                      color="error"
                    >
                      <RemoveCircleOutlineIcon />
                    </IconButton>
                  )}
                </Grid>
                
                <Grid item xs={12} sm={6}>
                  <Controller
                    name={`authorizedPersons[${index}].firstName`}
                    control={control}
                    rules={{ required: 'First name is required' }}
                    render={({ field, fieldState: { error } }) => (
                      <TextField
                        {...field}
                        label="First Name"
                        fullWidth
                        error={!!error}
                        helperText={error?.message}
                      />
                    )}
                  />
                </Grid>
                
                <Grid item xs={12} sm={6}>
                  <Controller
                    name={`authorizedPersons[${index}].lastName`}
                    control={control}
                    rules={{ required: 'Last name is required' }}
                    render={({ field, fieldState: { error } }) => (
                      <TextField
                        {...field}
                        label="Last Name"
                        fullWidth
                        error={!!error}
                        helperText={error?.message}
                      />
                    )}
                  />
                </Grid>
                
                <Grid item xs={12} sm={6}>
                  <Controller
                    name={`authorizedPersons[${index}].mobileNumber`}
                    control={control}
                    rules={{ 
                      required: 'Mobile number is required',
                      pattern: {
                        value: /^[0-9]{10}$/,
                        message: 'Invalid mobile number'
                      }
                    }}
                    render={({ field, fieldState: { error } }) => (
                      <TextField
                        {...field}
                        label="Primary Mobile Number"
                        fullWidth
                        error={!!error}
                        helperText={error?.message}
                      />
                    )}
                  />
                </Grid>
                
                <Grid item xs={12} sm={6}>
                  <Controller
                    name={`authorizedPersons[${index}].email`}
                    control={control}
                    rules={{ 
                      required: 'Email is required',
                      pattern: {
                        value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                        message: 'Invalid email address'
                      }
                    }}
                    render={({ field, fieldState: { error } }) => (
                      <TextField
                        {...field}
                        label="Email ID"
                        fullWidth
                        error={!!error}
                        helperText={error?.message}
                      />
                    )}
                  />
                </Grid>
                
                <Grid item xs={12}>
                  <Controller
                    name={`authorizedPersons[${index}].authorizationLetter`}
                    control={control}
                    rules={{ required: 'Authorization letter is required' }}
                    render={({ field: { onChange, value, ...field }, fieldState: { error } }) => (
                      <TextField
                        {...field}
                        type="file"
                        label="Upload Letter of Authorization"
                        fullWidth
                        InputLabelProps={{ shrink: true }}
                        onChange={(e) => onChange(e.target.files[0])}
                        error={!!error}
                        helperText={error?.message}
                      />
                    )}
                  />
                </Grid>
              </React.Fragment>
            ))}
            
            <Grid item xs={12}>
              <Button
                variant="outlined"
                startIcon={<AddCircleOutlineIcon />}
                onClick={handleAddAuthorizedPerson}
              >
                Add Another Authorized Person
              </Button>
            </Grid>
          </Grid>
        );
      case 2:
        return (
          <Grid container spacing={3}>
            <Grid item xs={12}>
              <Controller
                name="documents.panCard"
                control={control}
                rules={{ required: 'PAN card is required' }}
                render={({ field: { onChange, value, ...field }, fieldState: { error } }) => (
                  <TextField
                    {...field}
                    type="file"
                    label="PAN Card"
                    fullWidth
                    InputLabelProps={{ shrink: true }}
                    onChange={(e) => onChange(e.target.files[0])}
                    error={!!error}
                    helperText={error?.message}
                  />
                )}
              />
            </Grid>
            
            {ownerCategory !== 'Individual' && (
              <Grid item xs={12}>
                <Controller
                  name="documents.gstCertificate"
                  control={control}
                  rules={{ required: 'GST certificate is required' }}
                  render={({ field: { onChange, value, ...field }, fieldState: { error } }) => (
                    <TextField
                      {...field}
                      type="file"
                      label="GST Certificate"
                      fullWidth
                      InputLabelProps={{ shrink: true }}
                      onChange={(e) => onChange(e.target.files[0])}
                      error={!!error}
                      helperText={error?.message}
                    />
                  )}
                />
              </Grid>
            )}
            
            <Grid item xs={12}>
              <Controller
                name="documents.addressProof"
                control={control}
                rules={{ required: 'Address proof is required' }}
                render={({ field: { onChange, value, ...field }, fieldState: { error } }) => (
                  <TextField
                    {...field}
                    type="file"
                    label="Address Proof"
                    fullWidth
                    InputLabelProps={{ shrink: true }}
                    onChange={(e) => onChange(e.target.files[0])}
                    error={!!error}
                    helperText={error?.message}
                  />
                )}
              />
            </Grid>
            
            {ownerCategory === 'Company' && (
              <>
                <Grid item xs={12}>
                  <Controller
                    name="documents.companyRegistrationCertificate"
                    control={control}
                    rules={{ required: 'Company registration certificate is required' }}
                    render={({ field: { onChange, value, ...field }, fieldState: { error } }) => (
                      <TextField
                        {...field}
                        type="file"
                        label="Company Registration Certificate"
                        fullWidth
                        InputLabelProps={{ shrink: true }}
                        onChange={(e) => onChange(e.target.files[0])}
                        error={!!error}
                        helperText={error?.message}
                      />
                    )}
                  />
                </Grid>
                
                <Grid item xs={12} sm={6}>
                  <Controller
                    name="documents.cinNumber"
                    control={control}
                    rules={{ required: 'CIN number is required' }}
                    render={({ field, fieldState: { error } }) => (
                      <TextField
                        {...field}
                        label="CIN Number"
                        fullWidth
                        error={!!error}
                        helperText={error?.message}
                      />
                    )}
                  />
                </Grid>
                
                <Grid item xs={12} sm={6}>
                  <Controller
                    name="documents.dinNumber"
                    control={control}
                    rules={{ required: 'DIN number is required' }}
                    render={({ field, fieldState: { error } }) => (
                      <TextField
                        {...field}
                        label="DIN Number"
                        fullWidth
                        error={!!error}
                        helperText={error?.message}
                      />
                    )}
                  />
                </Grid>
                
                <Grid item xs={12}>
                  <Controller
                    name="documents.moaCertificate"
                    control={control}
                    rules={{ required: 'MOA certificate is required' }}
                    render={({ field: { onChange, value, ...field }, fieldState: { error } }) => (
                      <TextField
                        {...field}
                        type="file"
                        label="MOA Certificate"
                        fullWidth
                        InputLabelProps={{ shrink: true }}
                        onChange={(e) => onChange(e.target.files[0])}
                        error={!!error}
                        helperText={error?.message}
                      />
                    )}
                  />
                </Grid>
                
                <Grid item xs={12}>
                  <Controller
                    name="documents.aoaCertificate"
                    control={control}
                    rules={{ required: 'AOA certificate is required' }}
                    render={({ field: { onChange, value, ...field }, fieldState: { error } }) => (
                      <TextField
                        {...field}
                        type="file"
                        label="AOA Certificate"
                        fullWidth
                        InputLabelProps={{ shrink: true }}
                        onChange={(e) => onChange(e.target.files[0])}
                        error={!!error}
                        helperText={error?.message}
                      />
                    )}
                  />
                </Grid>
              </>
            )}
          </Grid>
        );
      default:
        return 'Unknown step';
    }
  };

  return (
    <Paper elevation={3} sx={{ p: 4, maxWidth: 800, margin: 'auto' }}>
      <Typography variant="h5" gutterBottom align="center">
        Vessel Owner Registration Form
      </Typography>
      
      <Stepper activeStep={activeStep} alternativeLabel sx={{ mb: 4 }}>
        {steps.map((label) => (
          <Step key={label}>
            <StepLabel>{label}</StepLabel>
          </Step>
        ))}
      </Stepper>

      <form onSubmit={handleSubmit(onSubmit)}>
        {getStepContent(activeStep)}
        
        <Box sx={{ display: 'flex', justifyContent: 'flex-end', mt: 3 }}>
          {activeStep !== 0 && (
            <Button onClick={handleBack} sx={{ mr: 1 }}>
              Back
            </Button>
          )}
          
          {activeStep === steps.length - 1 ? (
            <Button 
              variant="contained" 
              color="primary" 
              type="submit"
            >
              Submit
            </Button>
          ) : (
            <Button 
              variant="contained" 
              color="primary" 
              onClick={handleNext}
            >
              Next
            </Button>
          )}
        </Box>
      </form>

      {activeStep === steps.length && (
        <Box sx={{ mt: 2 }}>
          <Typography variant="h6" gutterBottom>
            Registration Submitted Successfully
          </Typography>
          <Typography>
            Thank you for registering your vessel. We will review your information and contact you shortly.
          </Typography>
        </Box>
      )}
    </Paper>
  );
