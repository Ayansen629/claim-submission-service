import React from 'react';
import { Row, Col, Button } from 'react-bootstrap';
import { useFormContext } from 'react-hook-form';
import InputText from './InputText.tsx';
import InputFile from './InputFile.tsx';
import { renameFile } from '../../utils/constants.ts';
import { FaFileAlt, FaDownload } from 'react-icons/fa';

const DynamicFormFields = ({ fields, setFormData }) => {
  const { register, formState: { errors }, setValue, watch, setError } = useFormContext();

  const handleDownload = (filename) => {
    // Mock download functionality
    const link = document.createElement('a');
    link.href = '#'; // In a real app, this would be the file URL
    link.setAttribute('download', filename);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    console.log(`Downloading ${filename}`);
  };

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'file':
        // Check if field has a render function (for view mode)
        if (field.render) {
          return field.render(watch(field.name));
        }
        
        // For disabled file inputs in view mode
        if (field.disabled) {
          const fileName = watch(field.name);
          return (
            <div className="mb-3">
              <label className="form-label">{field.label}</label>
              <div className="file-display d-flex align-items-center justify-content-between">
                <div className="d-flex align-items-center">
                  <FaFileAlt className="me-2 text-primary" />
                  <span>{fileName || 'No file uploaded'}</span>
                </div>
                {fileName && (
                  <Button 
                    variant="outline-primary" 
                    size="sm" 
                    onClick={() => handleDownload(fileName)}
                  >
                    <FaDownload className="me-1" /> Download
                  </Button>
                )}
              </div>
            </div>
          );
        }

        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(file?.name?.lastIndexOf('.'));
                const fileName = `${field.label}${extension}`;
                file.originalName = fileName;
                setValue(field.name, renameFile(file, fileName));
                setFormData(prev => {
                  const updated = { ...prev, [field.name]: file };
                  return updated;
                });

                const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'Only PDF, JPG or PNG files are allowed'
                  });
                }

                if (file.size > 2 * 1024 * 1024) {
                  setError(field.name, {
                    type: 'manual',
                    message: 'File size should not exceed 2MB'
                  });
                }
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={watch(field.name)}
            disabled={field.disabled}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field?.name, {
              ...field.validation,
            })}
            onChange={handleChange}
            errors={errors}
            readOnly={field.readOnly}
            icon={field.icon}
            maxlength={field?.maxlength}
            onKeyDown={field?.keyDown}
            disabled={field?.disabled || false}
            className={`mb-4 ${field.inputClassName || ''}`}
            style={{
              borderColor: errors[field.name] ? '#dc3545' : '#ced4da',
              backgroundColor: errors[field.name] ? '#fff8f8' : 'white'
            }}
          />
        );
    }
  };

  return (
    <Row className="g-3">
      {fields.map((field, index) => (
        <Col key={index} md={field.colSize || 12}>
          {renderField(field)}
        </Col>
      ))}
    </Row>
  );
};

export default DynamicFormFields;

/////////////////
const getDisabledFormFieldsConfig = () => {
  const originalConfig = createFormFieldsConfig(() => {});
  const disabledStep1 = originalConfig.step1.map(field => ({
    ...field,
    disabled: true,
    inputClassName: 'disabled-field' 
  }));
  
  const disabledStep2 = originalConfig.step2.map(field => ({
    ...field,
    disabled: true
  }));
  
  return {
    step1: disabledStep1,
    step2: disabledStep2
  };
};
