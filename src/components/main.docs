/* Mobile responsive styles */
@media (max-width: 767px) {
  .heroSection {
    height: auto;
    min-height: 100vh;
    padding-bottom: 2rem;
  }
  
  .headerRow {
    flex-direction: column;
  }
  
  .brandName {
    font-size: 18px;
    text-align: center;
  }
  
  .mobileLogo {
    width: 3.5rem !important;
    height: 4rem !important;
  }
  
  .navGroupWrapper {
    flex-direction: column;
  }
  
  .homeLoginBtn {
    position: static !important;
    margin-top: 1rem;
  }
}

@media (max-width: 575px) {
  .brandName {
    font-size: 16px;
    line-height: 1.3;
  }
}

/* Ensure proper spacing on all devices */
.desktopLogo {
  width: 5.25rem;
  height: 5rem;
  position: absolute;
  top: -17px;
  right: 0;
}
