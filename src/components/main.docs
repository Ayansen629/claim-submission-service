import React, { useState, useEffect } from "react";
import { Row, Col, Form, Button, Card, Alert } from "react-bootstrap";
import { useForm } from "react-hook-form";
import { useTranslation } from "react-i18next";
import Collapsible from "../../../common/Collapsible";
import InputText from "../../../common/InputText";
import InputSelect from "../../../common/InputSelect";
import InputRadio from "../../../common/InputRadio";
import InputFile from "../../../common/InputFile";
import DocumentsStepper from "./DocumentsStepper";

const VesselDetails = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const {
    register,
    handleSubmit,
    watch,
    setValue,
    clearErrors,
    trigger,
    formState: { errors },
  } = formMethods;

  // Form sections configuration
  const formSections = [
    {
      title: t("Basic Information"),
      fields: [
        {
          name: "ownerName",
          label: t("Name of Owner"),
          type: "text",
          required: true,
          col: 4,
          validation: { required: t("Name is required") },
        },
        {
          name: "ownerAddress",
          label: t("Address of Owner"),
          type: "text",
          required: true,
          col: 4,
          validation: { required: t("Address is required") },
        },
        {
          name: "mobile",
          label: t("Mobile"),
          type: "text",
          required: true,
          col: 4,
          validation: { required: t("Mobile is required") },
        },
        {
          name: "email",
          label: t("Email Id"),
          type: "text",
          required: true,
          col: 4,
          validation: {
            required: t("Email is required"),
            pattern: {
              value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
              message: t("Invalid email address"),
            },
          },
        },
        {
          name: "pan",
          label: t("PAN"),
          type: "text",
          required: true,
          col: 4,
          validation: { required: t("PAN is required") },
        },
        {
          name: "aadhar",
          label: t("Aadhar"),
          type: "text",
          required: true,
          col: 4,
          validation: { required: t("Aadhar is required") },
        },
        {
          name: "tradeLicence",
          label: t("Trade Licence"),
          type: "text",
          required: true,
          col: 4,
          validation: { required: t("Trade Licence is required") },
        },
        {
          name: "gst",
          label: t("GST"),
          type: "text",
          required: true,
          col: 4,
          validation: { required: t("GST is required") },
        },
        {
          name: "grt",
          label: t("Gross Tonnage (GRT)"),
          type: "text",
          required: true,
          col: 4,
          validation: { required: t("GRT is required") },
        },
        {
          name: "workOrderValue",
          label: t("Work Order Value"),
          type: "text",
          required: true,
          col: 4,
          validation: {
            required: t("Work Order Value is required"),
            pattern: {
              value: /^[0-9]+$/,
              message: t("Please enter a valid number"),
            },
          },
        },
        {
          name: "vesselType",
          label: t("Type of Vessel"),
          type: "select",
          required: true,
          col: 4,
          options: [
            { value: "new", label: t("New Vessel") },
            { value: "old", label: t("Old Vessel") },
          ],
          validation: { required: t("vesselType is required") },
        },
        {
          name: "category",
          label: t("Category"),
          type: "select",
          required: true,
          col: 4,
          options: [
            { value: "A", label: t("Category A") },
            { value: "B", label: t("Category B") },
            { value: "C", label: t("Category C") },
          ],
          validation: { required: t("category is required") },
          onChange: (value) => {
            if (value === "A") {
              setValue("zone", "1", { shouldValidate: true });
              setValue("supervisionAuthority", "classificationSociety", { shouldValidate: true });
              clearErrors(["zone", "supervisionAuthority"]);
            }
          },
        },
        {
          name: "zone",
          label: t("Zone"),
          type: "select",
          required: (watch) => watch("category") !== "A",
          col: 4,
          options: [
            { value: "1", label: t("Zone 1") },
            { value: "2", label: t("Zone 2") },
            { value: "3", label: t("Zone 3") },
          ],
          validation: {
            required: (watch) => watch("category") !== "A" && t("zone is required"),
          },
          disabled: (watch) => watch("category") === "A",
        },
        {
          name: "supervisionAuthority",
          label: t("Supervision Authority"),
          type: "select",
          required: (watch) => watch("category") !== "A",
          col: 4,
          options: [
            { value: "iwt", label: t("IWT") },
            { value: "classificationSociety", label: t("Classification Society") },
          ],
          validation: {
            required: (watch) => watch("category") !== "A" && t("Supervision Authority is required"),
          },
          disabled: (watch) => watch("category") === "A",
        },
        {
          name: "purchaseType",
          label: t("Purchase Type"),
          type: "select",
          required: true,
          col: 4,
          options: [
            { value: "new", label: t("New") },
            { value: "used", label: t("Used") },
          ],
          validation: { required: t("Purchase Type is required") },
        },
        {
          name: "classificationSociety",
          label: t("Name of the Classification Society"),
          type: "text",
          required: false,
          col: 4,
          disabled: (watch) => watch("category") === "A",
        },
        {
          name: "constructedBy",
          label: t("Constructed By ?"),
          type: "radio",
          required: true,
          col: 6,
          options: [
            { label: t("Self"), value: "1" },
            { label: t("Builder"), value: "2" },
          ],
          validation: { required: t("Please select a Contructor Type") },
        },
      ],
    },
    {
      title: t("Builder Details"),
      condition: (watch) => watch("constructedBy") === "2",
      fields: [
        {
          name: "builderName",
          label: t("Builder Name"),
          type: "text",
          required: true,
          col: 4,
          validation: { required: t("Builder Name is required") },
        },
        {
          name: "builderAddress",
          label: t("Builder Address"),
          type: "text",
          required: true,
          col: 4,
          validation: { required: t("Builder Address is required") },
        },
        {
          name: "builderEmail",
          label: t("Builder Email Id"),
          type: "text",
          required: true,
          col: 4,
          validation: {
            required: t("Builder Email is required"),
            pattern: {
              value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
              message: t("Invalid email address"),
            },
          },
        },
        {
          name: "builderMobile",
          label: t("Mobile"),
          type: "text",
          required: true,
          col: 4,
          validation: {
            required: t("Builder Mobile is required"),
            pattern: {
              value: /^[0-9]{10}$/,
              message: t("Invalid mobile number"),
            },
          },
        },
        {
          name: "builderTradeLicence",
          label: t("Trade Licence"),
          type: "text",
          required: true,
          col: 4,
          validation: { required: t("Builder Trade Licence is required") },
        },
        {
          name: "builderGST",
          label: t("GST"),
          type: "text",
          required: true,
          col: 4,
          validation: { required: t("Builder GST is required") },
        },
        {
          name: "builderAuth",
          label: t("Builder Authorization"),
          type: "select",
          required: true,
          col: 4,
          options: [
            { value: "auth", label: t("Authorized") },
            { value: "rejected", label: t("Rejected") },
          ],
        },
        {
          name: "authLetter",
          label: t("Authorisation Letter"),
          type: "file",
          required: true,
          col: 4,
          validation: { required: t("Authorization Letter is required") },
        },
      ],
    },
    {
      title: t("Documents"),
      fields: [], // Handled separately by DocumentsStepper
      customComponent: <DocumentsStepper formMethods={formMethods} viewMode={viewMode} />,
    },
    {
      title: t("Declaration"),
      fields: [
        {
          name: "termsAccepted",
          label: t("I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule."),
          type: "checkbox",
          required: true,
          col: 12,
          validation: { required: t("You must accept the terms and conditions") },
        },
      ],
    },
  ];

  const renderField = (field) => {
    const fieldValue = watch(field.name);
    const isDisabled = typeof field.disabled === "function" 
      ? field.disabled(watch) 
      : field.disabled || viewMode;
    const isRequired = typeof field.required === "function" 
      ? field.required(watch) 
      : field.required;

    const commonProps = {
      label: field.label,
      name: field.name,
      required: isRequired,
      register: register(field.name, field.validation),
      errors: errors,
      value: fieldValue,
      onChange: (value) => {
        if (viewMode) return;
        setValue(field.name, value, { shouldValidate: true });
        clearErrors(field.name);
        if (field.onChange) field.onChange(value);
      },
      disabled: isDisabled,
    };

    switch (field.type) {
      case "select":
        return (
          <InputSelect
            {...commonProps}
            options={field.options}
          />
        );
      case "radio":
        return (
          <InputRadio
            {...commonProps}
            options={field.options}
          />
        );
      case "file":
        return (
          <InputFile
            {...commonProps}
            onChange={(e) => {
              if (viewMode) return;
              const files = e.target.files;
              if (files && files.length > 0) {
                setValue(field.name, files[0]);
                clearErrors(field.name);
              }
            }}
          />
        );
      case "checkbox":
        return (
          <Form.Group className="mb-3">
            <Form.Check
              type="checkbox"
              id={field.name}
              label={field.label}
              isInvalid={!!errors[field.name]}
              {...register(field.name, field.validation)}
              onChange={() => !viewMode && clearErrors(field.name)}
              disabled={viewMode}
            />
            {errors[field.name] && (
              <Form.Control.Feedback type="invalid">
                {errors[field.name].message}
              </Form.Control.Feedback>
            )}
          </Form.Group>
        );
      default:
        return <InputText {...commonProps} type={field.type} />;
    }
  };

  const onSubmit = (data) => {
    console.log("Form Submitted:", data);
  };

  return (
    <form onSubmit={handleSubmit(onSubmit)}>
      {formSections.map((section, index) => {
        // Skip section if condition is false
        if (section.condition && !section.condition(watch)) {
          return null;
        }

        return (
          <Collapsible key={index} title={section.title} openStat={true}>
            {section.customComponent || (
              <Row className="gy-3" style={{ padding: "1rem" }}>
                {section.fields.map((field, fieldIndex) => (
                  <Col key={fieldIndex} md={field.col || 12}>
                    {renderField(field)}
                  </Col>
                ))}
              </Row>
            )}
          </Collapsible>
        );
      })}
    </form>
  );
};

export default VesselDetails;
