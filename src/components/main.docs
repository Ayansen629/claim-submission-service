import React, { useState, useEffect, useRef } from "react";
import { Form } from "react-bootstrap";
import { FaUpload, FaFilePdf, FaFileImage, FaCheckCircle, FaTimes } from "react-icons/fa";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

interface InputFileProps {
  label: string;
  required?: boolean;
  name: string;
  errors?: any;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
  accept?: string;
  disabled?: boolean;
  className?: string;
  style?: React.CSSProperties;
  watch?: any;
  defaultValue?: string | File;
  autoFocus?: boolean;
  clearErrors?: (fieldName: string) => void;
  register?: any;
}

const InputFile: React.FC<InputFileProps> = ({
  label,
  required,
  name,
  errors,
  onChange,
  accept = ".pdf,.jpg,.jpeg,.png",
  disabled,
  className = "",
  watch,
  defaultValue,
  clearErrors,
  register
}) => {
  const hasError = errors && errors[name];
  const fileInputRef = useRef<HTMLInputElement>(null);
  const [fileSelected, setFileSelected] = useState(false);
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  const currentFile = watch ? watch(name) : null;

  useEffect(() => {
    if (currentFile && fileSelected) {
      clearErrors && clearErrors(name);
    }
  }, [currentFile, fileSelected, name, clearErrors]);

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files[0]) {
      setFileSelected(true);
      if (onChange) {
        onChange(e);
      }
    }
  };

  const handleRemoveFile = (e: React.MouseEvent) => {
    e.preventDefault();
    e.stopPropagation();
    
    if (fileInputRef.current) {
      fileInputRef.current.value = '';
    }
    setFileSelected(false);
    
    // Create a proper event object to clear the file
    const fakeEvent = {
      target: {
        files: [],
        value: '',
        name: name
      }
    } as any;
    
    if (onChange) {
      onChange(fakeEvent);
    }
    
    // Also clear errors if function exists
    if (clearErrors) {
      clearErrors(name);
    }
  };

  const getFileIcon = (fileName: string) => {
    if (!fileName || typeof fileName !== 'string') {
      return <FaFileImage className="text-primary" size={14} />;
    }
    
    const lowerFileName = fileName.toLowerCase();
    if (lowerFileName.includes('.pdf')) {
      return <FaFilePdf className="text-danger" size={14} />;
    }
    return <FaFileImage className="text-success" size={14} />;
  };

  const getFileName = (file: any) => {
    if (!file) return label; // Show label name when no file
    if (file.name) return file.name;
    if (file.fileName) return file.fileName;
    return label; // Fallback to label name
  };

  return (
    <Form.Group className={`mb-3 ${className}`} controlId={name}>
      <Form.Label className="fw-semibold text-dark mb-2" style={{ fontSize: '0.9rem' }}>
        {label}
        {required && <span className="text-danger ms-1">*</span>}
      </Form.Label>
      
      <div className="d-flex align-items-stretch gap-2">
        <label
          htmlFor={name}
          className={`btn ${hasError ? 'btn-outline-danger' : 'btn-outline-primary'} btn-sm d-flex align-items-center justify-content-center`}
          style={{
            cursor: disabled ? 'not-allowed' : 'pointer',
            opacity: disabled ? 0.6 : 1,
            minWidth: '90px',
            padding: '6px 10px',
            fontSize: '0.8rem',
            borderRadius: '6px',
            height: '34px'
          }}
        >
          <FaUpload size={11} className="me-1" />
          {t("Choose")}
        </label>

        <div className="flex-grow-1 position-relative">
          {currentFile ? (
            <div className={`d-flex align-items-center border rounded px-2 py-1 ${hasError ? 'border-danger bg-danger-subtle' : 'border-success bg-light'}`} style={{ height: '34px' }}>
              <div className="d-flex align-items-center flex-grow-1 me-2">
                <FaCheckCircle className="text-success me-2 flex-shrink-0" size={12} />
                <div className="me-2 flex-shrink-0">
                  {getFileIcon(getFileName(currentFile))}
                </div>
                <span 
                  className="text-dark fw-medium"
                  style={{ 
                    fontSize: '0.8rem',
                    overflow: 'hidden', 
                    textOverflow: 'ellipsis', 
                    whiteSpace: 'nowrap' 
                  }}
                  title={getFileName(currentFile)}
                >
                  {getFileName(currentFile)}
                </span>
              </div>
              <button
                type="button"
                className="btn btn-outline-danger btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center position-absolute"
                onClick={handleRemoveFile}
                disabled={disabled}
                style={{ 
                  width: '22px', 
                  height: '22px', 
                  fontSize: '0.7rem',
                  right: '4px',
                  top: '50%',
                  transform: 'translateY(-50%)',
                  zIndex: 10
                }}
              >
                <FaTimes size={9} />
              </button>
            </div>
          ) : (
            <div className={`border rounded px-2 py-1 bg-light ${hasError ? 'border-danger' : 'border-secondary'} d-flex align-items-center`} style={{ height: '34px' }}>
              <span className="text-muted" style={{ fontSize: '0.8rem' }}>
                {t("No file selected")}
              </span>
            </div>
          )}
        </div>
      </div>

      <input
        ref={fileInputRef}
        type="file"
        id={name}
        onChange={handleFileChange}
        accept={accept}
        disabled={disabled}
        className="d-none"
        {...(register && register)}
      />

      {hasError ? (
        <Form.Text className="text-danger small mt-1 d-block" style={{ fontSize: '0.75rem' }}>
          <FaTimes size={8} className="me-1" />
          {errors[name]?.message}
        </Form.Text>
      ) : (
        <Form.Text className="text-muted small mt-1" style={{ fontSize: '0.75rem' }}>
          {t("PDF, JPG, PNG (Max: 10MB)")}
        </Form.Text>
      )}
    </Form.Group>
  );
};

export default InputFile;
