// Stepper.js
import React, { useState, useRef, useEffect, useCallback, useMemo } from "react";
import { useNavigate, useParams } from "react-router-dom";
import { toast } from "react-toastify";
import { Modal, Button, Form } from "react-bootstrap";
import "./Stepper.css";
import { useRegistration } from "../../context/ApplicationContext";
import ReviewStep from "./ReviewStep";
import { FormDataProvider } from "../../context/FormDataContext";

/**
 * Utility function to perform deep equality check
 * @param {Object} obj1 - First object to compare
 * @param {Object} obj2 - Second object to compare
 * @returns {boolean} - True if objects are deeply equal
 */
const deepEqual = (obj1, obj2) => {
  return JSON.stringify(obj1) === JSON.stringify(obj2);
};

/**
 * Generates a unique file ID
 * @param {File} file - The file object
 * @returns {string} - Generated file ID
 */
const generateFileId = (file) => {
  return `file-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`;
};

/**
 * Extracts file details for payload
 * @param {File} file - The file object
 * @returns {Object|null} - File details object or null if no file
 */
const extractFileDetails = (file) => {
  if (!file) return null;
  
  return {
    fileId: file.id || generateFileId(file),
    fileName: file.name,
    fileSize: file.size,
    fileType: file.type,
    uploadedAt: new Date().toISOString(),
  };
};

/**
 * Creates a professional form payload from raw form data
 * @param {Object} formData - The raw form data from all steps
 * @returns {Object} - Structured payload for API submission
 */
const createFormPayload = (formData) => {
  return {
    claimDetails: {
      debtorName: formData.step1?.debtorName,
      creditorName: formData.step1?.CreditorName,
      totalClaimAmount: parseFloat(formData.step1?.totalClaimAmount) || 0,
      debtDetails: formData.step1?.debtDetails,
      mutualCreditDetails: formData.step1?.mutualCreditDetails,
    },
    identificationDetails: {
      type: formData.step1?.identificationType,
      number: formData.step1?.identificationNumber,
      document: extractFileDetails(formData.step1?.identificationDocument),
    },
    securityDetails: {
      securityInterestAmount: parseFloat(formData.step2?.securityInterestAmount) || 0,
      guaranteeAmount: parseFloat(formData.step2?.guaranteeAmount) || 0,
      guarantorDetails: {
        name: formData.step2?.guarantorName,
        address: formData.step2?.guarantorAddress,
      },
      creditorContact: {
        address: formData.step2?.creditorAddress,
        email: formData.step2?.creditorEmail,
      },
      beneficiaryDetails: {
        name: formData.step2?.beneficiaryName,
        address: formData.step2?.beneficiaryAddress,
      },
      corporateDebtorDetails: {
        securityAmount: parseFloat(formData.step2?.corporateDebtorSecurityAmount) || 0,
        guaranteeAmount: parseFloat(formData.step2?.corporateDebtorGuaranteeAmount) || 0,
      },
      principalBorrower: {
        name: formData.step2?.principalBorrowerName,
        address: formData.step2?.principalBorrowerAddress,
      },
      bankDetails: {
        accountNumber: formData.step2?.accountNumber,
        ifscCode: formData.step2?.ifscCode,
        branchName: formData.step2?.branchName,
      },
      addressProof: extractFileDetails(formData.step2?.addressProof),
    },
    signatoryDetails: {
      name: formData.step3?.signatoryName,
      position: formData.step3?.signatoryPosition,
      address: formData.step3?.signatoryAddress,
      document: extractFileDetails(formData.step3?.signatoryDocument),
    },
    metadata: {
      submissionDate: new Date().toISOString(),
      currentStep: formData.currentStep,
      status: formData.status || "draft",
      formType: formData.formType,
      userType: formData.userType,
    },
  };
};

/**
 * Gets the file field names for a specific step
 * @param {number} stepNumber - The step number
 * @returns {Array} - Array of file field names
 */
const getFileFieldsForStep = (stepNumber) => {
  switch(stepNumber) {
    case 1: return ['identificationDocument'];
    case 2: return ['addressProof'];
    case 3: return ['signatoryDocument'];
    default: return [];
  }
};

/**
 * Processes file uploads for a step's data
 * @param {Object} stepData - The step's form data
 * @param {number} stepNumber - The step number
 * @returns {Promise<Object>} - Processed step data with file references
 */
const processFileUploads = async (stepData, stepNumber) => {
  const fileFields = getFileFieldsForStep(stepNumber);
  const processedData = { ...stepData };

  for (const field of fileFields) {
    if (stepData[field] && stepData[field] instanceof File) {
      // In a real implementation, you would upload the file here
      // const uploadResponse = await uploadFile(stepData[field]);
      // processedData[field] = {
      //   id: uploadResponse.fileId,
      //   name: stepData[field].name,
      //   ...uploadResponse
      // };
      
      // Mock implementation for demo
      processedData[field] = {
        id: generateFileId(stepData[field]),
        name: stepData[field].name,
        size: stepData[field].size,
        type: stepData[field].type,
        uploadedAt: new Date().toISOString()
      };
    }
  }

  return processedData;
};

const Stepper = ({ stepsConfig = [], formAllData }) => {
  const { id } = useParams();
  const isEditMode = !!id;
  const [currentStep, setCurrentStep] = useState(1);
  const [isConfirmed, setIsConfirmed] = useState(false);
  const [isComplete, setIsComplete] = useState(false);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [hasPreviewed, setHasPreviewed] = useState(false);
  const [formData, setFormData] = useState({});
  const [margins, setMargins] = useState({ marginLeft: 0, marginRight: 0 });
  const stepRef = useRef([]);
  const navigate = useNavigate();
  const [currentSubmitHandler, setCurrentSubmitHandler] = useState(null);
  const [showModal, setShowModal] = useState(false);
  const [comments, setComments] = useState("");
  const [actionType, setActionType] = useState("");
  const [isSavingDraft, setIsSavingDraft] = useState(false);

  const {
    registrationData,
    handleStepDataFetch,
    updateRegistrationData,
    loadDataFromLocalStorage,
    isDataLoaded,
  } = useRegistration();

  const userFormData = JSON.parse(localStorage.getItem("userFormData"));
  const isCRPUser = userFormData?.userType === "CRP";

  const filteredStepsConfig = useMemo(() => {
    if (isCRPUser) {
      return stepsConfig.filter((step) => step.name !== "Review & Submit");
    }
    return stepsConfig;
  }, [stepsConfig, isCRPUser]);

  useEffect(() => {
    if (id) {
      loadDataFromLocalStorage(id);
    }
  }, [id, loadDataFromLocalStorage]);

  useEffect(() => {
    if (isEditMode && registrationData && !deepEqual(formData, registrationData)) {
      setFormData(registrationData);
    }
  }, [isEditMode, registrationData, formData]);

  useEffect(() => {
    const savedIsConfirmed = localStorage.getItem("isConfirmed");
    if (savedIsConfirmed) {
      setIsConfirmed(JSON.parse(savedIsConfirmed));
    }
  }, []);

  useEffect(() => {
    localStorage.setItem("isConfirmed", JSON.stringify(isConfirmed));
  }, [isConfirmed]);

  useEffect(() => {
    const newSubmitHandler = filteredStepsConfig[currentStep - 1]?.submitHandler;
    if (newSubmitHandler && newSubmitHandler !== currentSubmitHandler) {
      setCurrentSubmitHandler(() => newSubmitHandler);
    }
  }, [currentStep, filteredStepsConfig]);

  const updateSubmitHandler = useCallback((submitHandler) => {
    setCurrentSubmitHandler(() => submitHandler);
  }, []);

  useEffect(() => {
    if (stepRef.current.length > 0) {
      const firstStep = stepRef.current[0]?.offsetWidth || 0;
      const lastStep = stepRef.current[filteredStepsConfig.length - 1]?.offsetWidth || 0;
      setMargins({
        marginLeft: firstStep / 2,
        marginRight: lastStep / 2,
      });
    }
  }, [filteredStepsConfig.length]);

  /**
   * Validates required fields for the current step
   * @param {number} step - The step number
   * @param {Object} data - The step's form data
   * @returns {boolean} - True if validation passes
   */
  const validateStepData = (step, data) => {
    const requiredFields = filteredStepsConfig[step - 1]?.requiredFields || [];
    for (let field of requiredFields) {
      if (!data[field]) {
        toast.error(`${field} is required.`);
        return false;
      }
    }
    return true;
  };

  /**
   * Handles moving to the next step
   */
  const handleNext = async () => {
    if (!currentSubmitHandler) {
      console.error("No submit handler available.");
      return;
    }

    const currentStepData = await currentSubmitHandler();
    if (!currentStepData) {
      console.error("Form validation failed.");
      return;
    }

    if (!validateStepData(currentStep, currentStepData)) {
      return;
    }

    const processedStepData = await processFileUploads(currentStepData, currentStep);
    
    const updatedFormData = {
      ...formData,
      [`step${currentStep}`]: { ...formData[`step${currentStep}`], ...processedStepData },
    };

    if (!deepEqual(updatedFormData, formData)) {
      setFormData(updatedFormData);
      updateRegistrationData(`step${currentStep}`, updatedFormData[`step${currentStep}`], id);
    }

    if (currentStep === filteredStepsConfig.length) {
      const finalPayload = createFormPayload(updatedFormData);
      console.log("Final Payload:", JSON.stringify(finalPayload, null, 2));
      
      // Here you would typically send the payload to your API
      // await submitForm(finalPayload);
      
      setIsComplete(true);
      toast.success("Form submitted successfully");
      navigate("/dashboard");
    } else {
      setCurrentStep((prevStep) => prevStep + 1);
    }
  };

  const handlePreview = async () => {
    if (!currentSubmitHandler) {
      console.error("No submit handler available.");
      return;
    }

    const currentStepData = await currentSubmitHandler();
    if (!currentStepData) {
      console.error("Form validation failed.");
      return;
    }

    if (!validateStepData(currentStep, currentStepData)) {
      return;
    }

    const processedStepData = await processFileUploads(currentStepData, currentStep);
    
    const updatedFormData = {
      ...formData,
      [`step${currentStep}`]: { ...formData[`step${currentStep}`], ...processedStepData },
    };

    if (!deepEqual(updatedFormData, formData)) {
      setFormData(updatedFormData);
      updateRegistrationData(`step${currentStep}`, updatedFormData[`step${currentStep}`], id);
    }

    // Create the payload same as handleNext would
    const previewPayload = createFormPayload(updatedFormData);
    console.log("Preview Payload:", JSON.stringify(previewPayload, null, 2));
    
    // Open the preview modal
    setCurrentStep(filteredStepsConfig.length);
    // setHasPreviewed(true);
    // setIsViewModalOpen(true);
  };

  /**
   * Handles saving the form as a draft
   */
  const handleSaveDraft = async () => {
    setIsSavingDraft(true);
    try {
      const currentStepData = currentSubmitHandler ? await currentSubmitHandler() : {};
      const processedStepData = await processFileUploads(currentStepData, currentStep);
      
      const draftId = id || `draft-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`;
      
      const draftData = {
        ...formData,
        [`step${currentStep}`]: { 
          ...formData[`step${currentStep}`], 
          ...processedStepData 
        },
        id: draftId,
        status: "draft",
        lastSaved: new Date().toISOString(),
        currentStep,
        formType: userFormData?.formType,
        userType: userFormData?.userType,
      };

      const existingDraft = JSON.parse(localStorage.getItem("formDrafts") || "[]");
      const updatedDrafts = [
        ...existingDraft.filter((draft) => draft.id !== draftId), 
        draftData
      ];
      localStorage.setItem("formDrafts", JSON.stringify(updatedDrafts));
      
      toast.success("Draft saved successfully");
      navigate("/drafts"); 
    } catch (error) {
      console.error("Error saving draft:", error);
      toast.error("Failed to save draft");
    } finally {
      setIsSavingDraft(false);
    }
  };

  /**
   * Handles action button clicks (Accept, Reject, etc.)
   * @param {string} action - The action type
   */
  const handleActionClick = (action) => {
    setActionType(action);
    setShowModal(true);
  };

  const handleModalClose = () => {
    setShowModal(false);
    setComments("");
  };

  /**
   * Handles submitting an action with comments
   */
  const handleActionSubmit = () => {
    console.log(`Action: ${actionType}, Comments: ${comments}`);
    toast.success(`${actionType} submitted successfully`);
    navigate("/dashboard");
  };

  const handlePrevious = () => {
    setCurrentStep((prevStep) => Math.max(1, prevStep - 1));
    setIsConfirmed(false);
    localStorage.removeItem("isConfirmed");
  };

  const handleCancel = () => {
    navigate("/dashboard");
  };

  /**
   * Calculates the progress bar width
   * @returns {number} - The progress percentage
   */
  const calculateProgressBarWidth = () => {
    return ((currentStep - 1) / (filteredStepsConfig.length - 1)) * 100;
  };

  const ActiveComponent = filteredStepsConfig[currentStep - 1]?.Component;
  const shouldRenderReviewStep = currentStep === filteredStepsConfig.length && isDataLoaded;

  /**
   * Flattens form data for the review step
   * @param {Object} formData - The form data
   * @returns {Object} - Flattened form data
   */
  const flattenFormData = (formData) => {
    const flattened = {
      ...formData.step1,
      ...formData.step2,
      ...formData.step3,
    };
    
    // Process file fields to show names
    const fileFields = ['identificationDocument', 'addressProof', 'signatoryDocument'];
    fileFields.forEach(field => {
      if (flattened[field]) {
        flattened[field] = flattened[field].name || "File uploaded";
      }
    });
    
    return flattened;
  };

  return (
    <FormDataProvider formData={flattenFormData(formData)}> 
      <div className="stepper">
        {filteredStepsConfig.map((step, index) => (
          <div
            key={step.name}
            ref={(el) => (stepRef.current[index] = el)}
            className={`step ${
              currentStep > index + 1 || isComplete ? "complete" : ""
            } ${currentStep === index + 1 ? "active" : ""}`}
          >
            <div className="step-number">
              {currentStep > index + 1 || isComplete ? (
                <span>✓</span>
              ) : (
                index + 1
              )}
            </div>
            <div className="step-name">{step.name}</div>
          </div>
        ))}

        <div
          className="progress-bar"
          style={{
            marginLeft: margins.marginLeft,
            marginRight: margins.marginRight,
          }}
        >
          <div
            className="progress"
            style={{ width: `${calculateProgressBarWidth()}%` }}
          ></div>
        </div>
      </div>

      {ActiveComponent && (
        <ActiveComponent
          formData={formData[`step${currentStep}`] || {}}
          provideSubmitHandler={updateSubmitHandler}
          setFormData={setFormData}
        />
      )}

      {shouldRenderReviewStep && !isCRPUser && (
        <ReviewStep />
      )}

      {currentStep === filteredStepsConfig.length && !isCRPUser && (
        <div className="confirmation-container">
          <Form.Group controlId="formConfirmation" className="mt-3 confirmation-checkbox">
            <Form.Check
              type="checkbox"
              label="I confirm that the information provided is correct."
              checked={isConfirmed}
              onChange={(e) => setIsConfirmed(e.target.checked)}
            />
          </Form.Group>
        </div>
      )}

      <div className="stepper-buttons">
        {currentStep > 1 && (
          <button className="buttonplus previous-button" onClick={handlePrevious}>
            Previous
          </button>
        )}
        {currentStep === 1 && (
          <button className="buttonplus cancel-button" onClick={handleCancel}>
            Cancel
          </button>
        )}

        {currentStep === 3 && !isCRPUser && (
          <div className="last-step-buttons">
            <button
              className="buttonplus draft-button"
              onClick={handleSaveDraft}
              disabled={isSavingDraft}
            >
              {isSavingDraft ? "Saving..." : "Save as Draft"}
            </button>
            <button
              className="buttonplus preview-button"
              onClick={handlePreview}
            >
              Preview
            </button>
          </div>
        )}

        {currentStep !== 3 && currentStep !== filteredStepsConfig.length && (
          <button
            className="buttonplus next-button"
            onClick={handleNext}
            disabled={isComplete}
          >
            Next
          </button>
        )}

        {currentStep === filteredStepsConfig.length && isCRPUser ? (
          <>
            <button
              className="buttonplus sendback-button"
              onClick={() => handleActionClick("Sendback To Claimants")}
            >
              Sendback To Claimants
            </button>
            <button
              className="buttonplus accept-contingent-button"
              onClick={() => handleActionClick("Accept as Contingent")}
            >
              Accept as Contingent
            </button>
            <button
              className="buttonplus accept-button"
              onClick={() => handleActionClick("Accept")}
            >
              Accept
            </button>
            <button
              className="buttonplus reject-button"
              onClick={() => handleActionClick("Reject")}
            >
              Reject
            </button>
          </>
        ) : currentStep === filteredStepsConfig.length ? (
          <button
            className="buttonplus next-button"
            onClick={handleNext}
            disabled={!isConfirmed || isComplete}
          >
            Submit
          </button>
        ) : null}
      </div>

      <Modal show={showModal} onHide={handleModalClose} centered>
        <Modal.Header closeButton>
          <Modal.Title>{actionType} Form</Modal.Title>
        </Modal.Header>
        <Modal.Body>
          <Form>
            <Form.Group controlId="comments">
              <Form.Label>Comments</Form.Label>
              <Form.Control
                as="textarea"
                rows={3}
                value={comments}
                onChange={(e) => setComments(e.target.value)}
                placeholder="Enter your comments..."
              />
            </Form.Group>
          </Form>
        </Modal.Body>
        <Modal.Footer>
          <Button className="modal-close-button" onClick={handleModalClose}>
            Close
          </Button>
          <Button
            className="modal-submit-button"
            onClick={handleActionSubmit}
            disabled={!comments.trim()}
          >
            Submit
          </Button>
        </Modal.Footer>
      </Modal>
    </FormDataProvider>
  );
};

export default Stepper;
