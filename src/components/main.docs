            title: "Anchors",
            key: "anchors",
            subItems: [...commonTableItems]
        },
        {
            title: "Anchor cables/Chains",
            key: "anchorCablesChains",
            subItems: [...commonTableItems]
        },
        {
            title: "Bilge pumps",
            key: "bilgePumps",
            subItems: [...commonTableItems]
        },
