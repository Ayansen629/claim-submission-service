const handleFormSubmit = async (stepInfo) => {
  if (stepInfo.index === 0) {
    const formValues = stepInfo?.getFormData?.() || {};
    
    console.log("=== SURVEY FORM DATA ===");
    console.log("Step Index:", stepInfo.index);
    console.log("Step Label:", stepInfo.label);
    console.log("Form Values:", formValues);
    console.log("Crew Details:", formValues.crewDetails);
    console.log("Files:", {
      authorizationFile: formValues.authorizationFile,
      paymentChallan: formValues.paymentChallan,
      lastCertificateCopy: formValues.lastCertificateCopy,
      registrationCertificateCopy: formValues.registrationCertificateCopy
    });
    console.log("========================");
    
    // Simulate success and move to next step
    toast.success("Survey details saved successfully.");
    stepperRef.current?.goToNextStep();
  }
  
  if (stepInfo.index === 1) {
    const formValues = stepInfo?.getFormData?.() || {};
    
    console.log("=== EQUIPMENT FORM DATA ===");
    console.log("Step Index:", stepInfo.index);
    console.log("Step Label:", stepInfo.label);
    console.log("Form Values:", formValues);
    console.log("===========================");
    
    toast.success("Equipment details saved successfully.");
  }
};
