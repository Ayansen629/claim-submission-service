/* Card Styling */
.stats-container {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  margin-bottom: 20px;
}

.status-card {
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(36, 102, 191, 0.07);
  border: none;
  background: #fff;
  transition: box-shadow 0.2s;
  flex: 1;
  min-width: 200px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  height: 160px;
}

.status-card:hover {
  box-shadow: 0 4px 16px rgba(36, 102, 191, 0.15);
}

.status-card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.status-card .icon-wrapper {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}

.status-card .value {
  font-size: 28px;
  font-weight: 600;
  margin: 5px 0;
}

.status-card .title {
  font-size: 14px;
  color: #555;
  margin-bottom: 5px;
}

.status-card .subtitle {
  font-size: 12px;
  color: #888;
}

.search-combined-card {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 200px;
}

.search-container {
  margin-top: auto;
  padding-top: 15px;
}

.search-input-group {
  width: 100%;
}

.search-input-group .form-control {
  border-radius: 8px 0 0 8px;
  border: 1px solid #ddd;
}

.search-input-group .btn {
  border-radius: 0 8px 8px 0;
}

.status-badge {
  display: inline-block;
  padding: 0.25em 0.75em;
  border-radius: 12px;
  background: #f0ad4e;
  color: #fff;
  font-size: 0.95em;
  font-weight: 500;
}

.status-badge.completed {
  background: #28a745;
}

/* Responsive adjustments */
@media (max-width: 992px) {
  .status-card {
    min-width: calc(50% - 15px);
  }
}

@media (max-width: 768px) {
  .stats-container {
    flex-direction: column;
  }
  
  .status-card, .search-combined-card {
    width: 100%;
  }
  
  .search-container {
    margin-top: 15px;
  }
}
