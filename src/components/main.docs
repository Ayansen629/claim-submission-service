const handlePayNow = () => {
  navigate(`/payment?appNumber=${vesselRegisData.applicationNumber}`, {
    state: {
      paymentData,
      applicationNumber: vesselRegisData.applicationNumber,
      fullPaymentData,
    },
  });
};

