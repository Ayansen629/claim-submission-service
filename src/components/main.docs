// Update the useForm configuration
const methods = useForm({
  mode: 'onChange',
  reValidateMode: 'onChange',
  defaultValues: { ownerCategory: '', country: 'India' }
});

// Modify the DynamicField component to handle onChange events
const DynamicField = ({ field }) => {
  // Skip rendering if showIf condition is false
  if (field.showIf && !field.showIf()) return null;

  const handleChange = (e) => {
    if (field.onChange) field.onChange(e);
    // Trigger validation for this field immediately
    trigger(field.name);
  };

  switch(field.type) {
    case 'select':
      return (
        <Form.Group className="form-group">
          <Form.Label>
            {field.label} {field.required && <span className="required">*</span>}
          </Form.Label>
          <div className="input-with-icon">
            <Form.Select 
              {...register(field.name, field.validation)}
              className={errors[field.name] ? 'is-invalid' : ''}
              disabled={field.readOnly}
              onChange={handleChange}
            >
              {field.options.map((option, idx) => (
                <option key={idx} value={option.value}>{option.label}</option>
              ))}
            </Form.Select>
            {field.icon && React.createElement(field.icon, { className: "input-icon" })}
          </div>
          {errors[field.name] && <div className="error-message">{errors[field.name].message}</div>}
        </Form.Group>
      );
    
    case 'file':
      return (
        <Form.Group className="form-group">
          <Form.Label>
            {field.label} {field.required && <span className="required">*</span>}
          </Form.Label>
          <div className="file-upload">
            <input 
              type="file" 
              id={field.name}
              onChange={(e) => {
                if (e.target.files[0]) {
                  setValue(field.name, e.target.files[0].name);
                  trigger(field.name); // Validate immediately
                }
              }}
              className="file-input"
            />
            <label htmlFor={field.name} className="file-label">
              <FaUpload className="file-icon" />
              <span className="file-text">Choose File</span>
            </label>
            <span className="file-name">
              {watch(field.name) ? watch(field.name) : 'No file chosen'}
            </span>
          </div>
          <div className="file-help-text">Upload PDF, JPG or PNG file (Max size: 2MB)</div>
          {errors[field.name] && <div className="error-message">{errors[field.name].message}</div>}
        </Form.Group>
      );
    
    default: // text, email, etc.
      return (
        <Form.Group className="form-group">
          <Form.Label>
            {field.label} {field.required && <span className="required">*</span>}
          </Form.Label>
          <div className="input-with-icon">
            <Form.Control 
              type={field.type} 
              {...register(field.name, field.validation)}
              className={errors[field.name] ? 'is-invalid' : field.readOnly ? 'auto-populated' : ''}
              placeholder={field.placeholder}
              readOnly={field.readOnly}
              defaultValue={field.defaultValue}
              onChange={handleChange}
            />
            {field.icon && React.createElement(field.icon, { className: "input-icon" })}
          </div>
          {errors[field.name] && <div className="error-message">{errors[field.name].message}</div>}
        </Form.Group>
      );
  }
};
