import React, { useState } from "react";
import { Button, Modal, Form } from "react-bootstrap";
import InputFile from "../../../common/InputFile";

const PaymentModal = ({
  show,
  onHide,
  paymentMode,
  setPaymentMode,
  challanFile,
  onChallanUpload,
  onOnlinePay,
  isLoading,
}) => {
  const [submitting, setSubmitting] = useState(false);

  const handleOfflineSubmit = (e) => {
    e.preventDefault();
    setSubmitting(true);
    setTimeout(() => {
      setSubmitting(false);
      onHide();
      onOnlinePay();
    }, 800);
  };

  return (
    <Modal show={show} onHide={onHide} centered>
      <Modal.Header closeButton>
        <Modal.Title>Payment Option</Modal.Title>
      </Modal.Header>
      <Modal.Body>
        <Form onSubmit={handleOfflineSubmit}>
          <Form.Group>
            <Form.Label className="fw-semibold mb-2">Select Payment Mode</Form.Label>
            <div className="d-flex gap-3 mb-3">
              <Form.Check
                type="radio"
                id="offline"
                label="Offline"
                checked={paymentMode === "offline"}
                onChange={() => setPaymentMode("offline")}
                name="paymentMode"
              />
              <Form.Check
                type="radio"
                id="online"
                label="Online"
                checked={paymentMode === "online"}
                onChange={() => setPaymentMode("online")}
                name="paymentMode"
              />
            </div>
          </Form.Group>
          {paymentMode === "offline" && (
            <div className="mb-3">
              <InputFile
                label="Upload Challan"
                name="challan"
                required
                value={challanFile}
                onChange={onChallanUpload}
                errors={{}}
              />
            </div>
          )}
          <div className="d-flex justify-content-end gap-2 mt-4">
            <Button
              variant="secondary"
              onClick={onHide}
              style={{
                minWidth: 100,
                fontWeight: 500,
                borderRadius: 6,
                fontSize: "1rem",
              }}
              disabled={isLoading}
            >
              Close
            </Button>
            {paymentMode === "offline" ? (
              <Button
                type="submit"
                variant="primary"
                disabled={submitting || isLoading}
                style={{
                  minWidth: 120,
                  fontWeight: 600,
                  borderRadius: 6,
                  fontSize: "1rem",
                }}
              >
                {submitting ? "Submitting..." : "Submit"}
              </Button>
            ) : (
              <Button
                variant="success"
                onClick={onOnlinePay}
                disabled={isLoading}
                style={{
                  minWidth: 160,
                  fontWeight: 600,
                  borderRadius: 6,
                  fontSize: "1rem",
                }}
              >
                Proceed to Payment Gateway
              </Button>
            )}
          </div>
        </Form>
      </Modal.Body>
    </Modal>
  );
};

export default PaymentModal;
