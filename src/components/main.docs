useEffect(() => {
  // Force re-render of form fields when exemption status changes
  const currentFields = getCurrentStepFields();
  currentFields.forEach(field => {
    if (["panNo", "aadharNumber", "tradeLicenseNumber"].includes(field.name)) {
      const currentValue = getValues(field.name);
      setValue(field.name, currentValue, { shouldValidate: false });
    }
  });
}, [isExemptCategory]);
