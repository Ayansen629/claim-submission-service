<Form className="inbox-search">
  <InputGroup>
    <InputGroup.Text className="search-icon-wrapper">
      <BsFilter size={16} />
    </InputGroup.Text>
    <Form.Control
      type="text"
      placeholder={t("dashboard.Search Vessels...")}
      aria-label="Search"
      value={vesselSearchTerm}
      onChange={(e) => setVesselSearchTerm(e.target.value)}
    />
    <Button className="search-btn">
      <BsSearch />
    </Button>
  </InputGroup>
</Form>
.search-icon-wrapper {
  background-color: #f8f9fa;
  border-right: none;
  color: #6c757d;
}

.inbox-search .form-control {
  border-left: none;
  border-right: none;
}

.inbox-search .form-control:focus {
  border-color: #00A3E0;
  box-shadow: none;
}
