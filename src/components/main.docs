// EmployeeRegistrationForm.jsx
import { useEffect } from "react";
import { useFieldArray, useFormContext } from "react-hook-form";
import { Card, Row, Col, Button } from "react-bootstrap";
import InputSelect from "../common/InputSelect.tsx";
import InputText from "../common/InputText.tsx";
import Collapsible from "../common/Collapsible";
import { FaPlus, FaTrash, FaUser, FaMapMarkerAlt, FaGraduationCap, FaBriefcase, FaFileUpload } from "react-icons/fa";

const EmployeeRegistrationForm = () => {
  const { control, register, setValue, watch, formState: { errors } } = useFormContext();
  const { fields, append, remove } = useFieldArray({
    control,
    name: "educationDetails"
  });

  const watchPin = watch("address.pin");
  
  // Auto-populate address details
  useEffect(() => {
    const fetchAddressDetails = async (pin) => {
      if (pin?.length === 6) {
        try {
          // Show loading state
          setValue("address.district", "Loading...");
          setValue("address.state", "Loading...");
          setValue("address.country", "Loading...");
          
          // Call the API
          const response = await fetch(`https://api.postalpincode.in/pincode/${pin}`);
          const data = await response.json();
          
          if (data && data[0] && data[0].Status === "Success" && data[0].PostOffice && data[0].PostOffice.length > 0) {
            const postOffice = data[0].PostOffice[0];
            setValue("address.district", postOffice.District);
            setValue("address.state", postOffice.State);
            setValue("address.country", "India");
            console.log("Address details populated for PIN:", pin, postOffice);
          } else {
            // If API fails or returns no data
            setValue("address.district", "Not found");
            setValue("address.state", "Not found");
            setValue("address.country", "Not found");
            console.error("No data found for PIN:", pin);
          }
        } catch (error) {
          console.error("Error fetching address details:", error);
          // Set error state
          setValue("address.district", "Error fetching");
          setValue("address.state", "Error fetching");
          setValue("address.country", "Error fetching");
        }
      }
    };

    if (watchPin) {
      fetchAddressDetails(watchPin);
    }
  }, [watchPin, setValue]);

  return (
    <div className="employee-registration-form">
      {/* Personal Details Section */}
      <Collapsible 
        title={
          <div className="d-flex align-items-center">
            <FaUser className="me-2" />
            <span>Personal Details</span>
          </div>
        } 
        defaultOpen={true}
      >
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={4}>
                <InputText
                  name="personal.firstName"
                  label="First Name"
                  placeholder="Enter first name"
                  register={register("personal.firstName", { required: "First Name is required" })}
                  errors={errors?.personal?.firstName ? { personal: { firstName: errors.personal.firstName } } : {}}
                  style={{
                    borderColor: errors?.personal?.firstName ? '#dc3545' : undefined,
                    backgroundColor: errors?.personal?.firstName ? '#fff8f8' : undefined
                  }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.lastName"
                  label="Last Name"
                  placeholder="Enter last name"
                  register={register("personal.lastName", { required: "Last Name is required" })}
                  errors={errors?.personal?.lastName ? { personal: { lastName: errors.personal.lastName } } : {}}
                  style={{
                    borderColor: errors?.personal?.lastName ? '#dc3545' : undefined,
                    backgroundColor: errors?.personal?.lastName ? '#fff8f8' : undefined
                  }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.email"
                  label="Email ID"
                  type="email"
                  placeholder="Enter email address"
                  register={register("personal.email", {
                    required: "Email is required",
                    pattern: {
                      value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                      message: "Invalid email address"
                    }
                  })}
                  errors={errors?.personal?.email ? { personal: { email: errors.personal.email } } : {}}
                  style={{
                    borderColor: errors?.personal?.email ? '#dc3545' : undefined,
                    backgroundColor: errors?.personal?.email ? '#fff8f8' : undefined
                  }}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.phoneNumber"
                  label="Phone Number"
                  placeholder="Enter 10-digit phone number"
                  register={register("personal.phoneNumber", {
                    required: "Phone Number is required",
                    pattern: {
                      value: /^\d{10}$/,
                      message: "Invalid phone number"
                    }
                  })}
                  errors={errors?.personal?.phoneNumber ? { personal: { phoneNumber: errors.personal.phoneNumber } } : {}}
                  style={{
                    borderColor: errors?.personal?.phoneNumber ? '#dc3545' : undefined,
                    backgroundColor: errors?.personal?.phoneNumber ? '#fff8f8' : undefined
                  }}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="personal.gender"
                  label="Gender"
                  placeholder="Select gender"
                  options={[
                    { value: "male", label: "Male" },
                    { value: "female", label: "Female" },
                    { value: "other", label: "Other" }
                  ]}
                  register={register}
                  errors={errors?.personal?.gender ? { personal: { gender: errors.personal.gender } } : {}}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="personal.dob"
                  label="Date of Birth"
                  type="date"
                  placeholder="Select date of birth"
                  register={register("personal.dob", { required: "Date of Birth is required" })}
                  errors={errors?.personal?.dob ? { personal: { dob: errors.personal.dob } } : {}}
                  style={{
                    borderColor: errors?.personal?.dob ? '#dc3545' : undefined,
                    backgroundColor: errors?.personal?.dob ? '#fff8f8' : undefined
                  }}
                />
              </Col>
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Address Details Section */}
      <Collapsible 
        title={
          <div className="d-flex align-items-center">
            <FaMapMarkerAlt className="me-2" />
            <span>Address Details</span>
          </div>
        }
      >
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={6}>
                <InputText
                  name="address.line1"
                  label="Address Line-1"
                  placeholder="Enter address line 1"
                  register={register("address.line1", { required: "Address Line-1 is required" })}
                  errors={errors?.address?.line1 ? { address: { line1: errors.address.line1 } } : {}}
                  style={{
                    borderColor: errors?.address?.line1 ? '#dc3545' : undefined,
                    backgroundColor: errors?.address?.line1 ? '#fff8f8' : undefined
                  }}
                />
              </Col>
              <Col md={6}>
                <InputText
                  name="address.line2"
                  label="Address Line-2"
                  placeholder="Enter address line 2 (optional)"
                  register={register("address.line2")}
                  errors={errors?.address?.line2 ? { address: { line2: errors.address.line2 } } : {}}
                />
              </Col>
              <Col md={3}>
                <InputText
                  name="address.pin"
                  label="PIN"
                  placeholder="Enter 6-digit PIN code"
                  register={register("address.pin", {
                    required: "PIN Code is required",
                    pattern: {
                      value: /^\d{6}$/,
                      message: "Invalid PIN code (must be 6 digits)"
                    }
                  })}
                  errors={errors?.address?.pin ? { address: { pin: errors.address.pin } } : {}}
                  style={{
                    borderColor: errors?.address?.pin ? '#dc3545' : undefined,
                    backgroundColor: errors?.address?.pin ? '#fff8f8' : undefined
                  }}
                />
              </Col>
              <Col md={3}>
                <InputText
                  name="address.district"
                  label="District"
                  placeholder="Auto-populated"
                  register={register("address.district")}
                  errors={errors?.address?.district ? { address: { district: errors.address.district } } : {}}
                  readOnly
                />
              </Col>
              <Col md={3}>
                <InputText
                  name="address.state"
                  label="State/UT"
                  placeholder="Auto-populated"
                  register={register("address.state")}
                  errors={errors?.address?.state ? { address: { state: errors.address.state } } : {}}
                  readOnly
                />
              </Col>
              <Col md={3}>
                <InputText
                  name="address.country"
                  label="Country"
                  placeholder="Auto-populated"
                  register={register("address.country")}
                  errors={errors?.address?.country ? { address: { country: errors.address.country } } : {}}
                  readOnly
                />
              </Col>
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Education Details Section */}
      <Collapsible 
        title={
          <div className="d-flex align-items-center">
            <FaGraduationCap className="me-2" />
            <span>Education Details</span>
          </div>
        }
      >
        <Card className="form-section-card">
          <Card.Body>
            {fields.map((field, index) => (
              <div key={field.id} className="education-entry mb-4">
                {index > 0 && <div className="entry-divider mb-3"></div>}
                <Row className="g-3">
                  <Col md={4}>
                    <InputText
                      name={`educationDetails.${index}.qualification`}
                      label={`Qualification ${index === 0 ? '*' : ''}`}
                      placeholder="Enter qualification"
                      register={register(`educationDetails.${index}.qualification`, 
                        index === 0 ? { required: "Qualification is required" } : {}
                      )}
                      errors={errors?.educationDetails?.[index]?.qualification ? 
                        { educationDetails: { [index]: { qualification: errors.educationDetails[index].qualification } } } : {}}
                      style={{
                        borderColor: errors?.educationDetails?.[index]?.qualification ? '#dc3545' : undefined,
                        backgroundColor: errors?.educationDetails?.[index]?.qualification ? '#fff8f8' : undefined
                      }}
                    />
                  </Col>
                  <Col md={4}>
                    <InputText
                      name={`educationDetails.${index}.stream`}
                      label={`Stream ${index === 0 ? '*' : ''}`}
                      placeholder="Enter stream"
                      register={register(`educationDetails.${index}.stream`, 
                        index === 0 ? { required: "Stream is required" } : {}
                      )}
                      errors={errors?.educationDetails?.[index]?.stream ? 
                        { educationDetails: { [index]: { stream: errors.educationDetails[index].stream } } } : {}}
                      style={{
                        borderColor: errors?.educationDetails?.[index]?.stream ? '#dc3545' : undefined,
                        backgroundColor: errors?.educationDetails?.[index]?.stream ? '#fff8f8' : undefined
                      }}
                    />
                  </Col>
                  <Col md={3}>
                    <InputText
                      name={`educationDetails.${index}.yearOfPassing`}
                      label={`Year of Passing ${index === 0 ? '*' : ''}`}
                      placeholder="Enter year"
                      type="number"
                      register={register(`educationDetails.${index}.yearOfPassing`, {
                        ...(index === 0 ? { required: "Year of Passing is required" } : {}),
                        min: { value: 1900, message: "Invalid year" },
                        max: { value: new Date().getFullYear(), message: "Invalid year" }
                      })}
                      errors={errors?.educationDetails?.[index]?.yearOfPassing ? 
                        { educationDetails: { [index]: { yearOfPassing: errors.educationDetails[index].yearOfPassing } } } : {}}
                      style={{
                        borderColor: errors?.educationDetails?.[index]?.yearOfPassing ? '#dc3545' : undefined,
                        backgroundColor: errors?.educationDetails?.[index]?.yearOfPassing ? '#fff8f8' : undefined
                      }}
                    />
                  </Col>
                  <Col md={1} className="d-flex align-items-end">
                    {index > 0 && (
                      <Button
                        variant="danger"
                        size="sm"
                        onClick={() => remove(index)}
                        className="mt-1"
                      >
                        <FaTrash />
                      </Button>
                    )}
                  </Col>
                </Row>
              </div>
            ))}
            <Button
              variant="outline-primary"
              onClick={() => append({ qualification: "", stream: "", yearOfPassing: "" })}
              className="add-education-btn"
            >
              <FaPlus className="me-2" /> Add Education Details
            </Button>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Professional Details Section */}
      <Collapsible 
        title={
          <div className="d-flex align-items-center">
            <FaBriefcase className="me-2" />
            <span>Professional Details</span>
          </div>
        }
      >
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={4}>
                <InputText
                  name="professional.appointmentDate"
                  label="Appointment Date"
                  type="date"
                  placeholder="Select appointment date"
                  register={register("professional.appointmentDate", { required: "Appointment Date is required" })}
                  errors={errors?.professional?.appointmentDate ? 
                    { professional: { appointmentDate: errors.professional.appointmentDate } } : {}}
                  style={{
                    borderColor: errors?.professional?.appointmentDate ? '#dc3545' : undefined,
                    backgroundColor: errors?.professional?.appointmentDate ? '#fff8f8' : undefined
                  }}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.employeeType"
                  label="Employee Type"
                  placeholder="Select employee type"
                  options={[
                    { value: "full-time", label: "Full Time" },
                    { value: "part-time", label: "Part Time" },
                    { value: "contract", label: "Contract" }
                  ]}
                  register={register}
                  errors={errors?.professional?.employeeType ? 
                    { professional: { employeeType: errors.professional.employeeType } } : {}}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.employeeStatus"
                  label="Employee Status"
                  placeholder="Select employee status"
                  options={[
                    { value: "active", label: "Active" },
                    { value: "on-leave", label: "On Leave" },
                    { value: "terminated", label: "Terminated" }
                  ]}
                  register={register}
                  errors={errors?.professional?.employeeStatus ? 
                    { professional: { employeeStatus: errors.professional.employeeStatus } } : {}}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.designation"
                  label="Designation"
                  placeholder="Select designation"
                  options={[
                    { value: "manager", label: "Manager" },
                    { value: "developer", label: "Developer" },
                    { value: "designer", label: "Designer" }
                  ]}
                  register={register}
                  errors={errors?.professional?.designation ? 
                    { professional: { designation: errors.professional.designation } } : {}}
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="professional.department"
                  label="Department"
                  placeholder="Auto-populated"
                  register={register("professional.department")}
                  errors={errors?.professional?.department ? 
                    { professional: { department: errors.professional.department } } : {}}
                  readOnly
                />
              </Col>
              <Col md={4}>
                <InputText
                  name="professional.section"
                  label="Section"
                  placeholder="Enter section"
                  register={register("professional.section")}
                  errors={errors?.professional?.section ? 
                    { professional: { section: errors.professional.section } } : {}}
                />
              </Col>
              <Col md={4}>
                <InputSelect
                  name="professional.roles"
                  label="Roles"
                  placeholder="Select role"
                  options={[
                    { value: "admin", label: "Admin" },
                    { value: "user", label: "User" },
                    { value: "manager", label: "Manager" }
                  ]}
                  register={register}
                  errors={errors?.professional?.roles ? 
                    { professional: { roles: errors.professional.roles } } : {}}
                />
              </Col>
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>

      {/* Documents Upload Section */}
      <Collapsible 
        title={
          <div className="d-flex align-items-center">
            <FaFileUpload className="me-2" />
            <span>Documents Upload</span>
          </div>
        }
      >
        <Card className="form-section-card">
          <Card.Body>
            <Row className="g-3">
              <Col md={4}>
                <InputText
                  name="documents.addressProof"
                  label="Address Proof"
                  type="file"
                  register={register("documents.addressProof", { required: "Address Proof is required" })}
                  errors={errors?.documents?.addressProof ? 
                    { documents: { addressProof: errors.documents.addressProof } } : {}}
                  style={{
                    borderColor: errors?.documents?.addressProof ? '#dc3545' : undefined,
                    backgroundColor: errors?.documents?.addressProof ? '#fff8f8' : undefined
                  }}
                />
                <small className="text-muted">Upload PDF, JPG or PNG (Max: 2MB)</small>
              </Col>
              <Col md={4}>
                <InputText
                  name="documents.identityProof"
                  label="Identity Proof"
                  type="file"
                  register={register("documents.identityProof", { required: "Identity Proof is required" })}
                  errors={errors?.documents?.identityProof ? 
                    { documents: { identityProof: errors.documents.identityProof } } : {}}
                  style={{
                    borderColor: errors?.documents?.identityProof ? '#dc3545' : undefined,
                    backgroundColor: errors?.documents?.identityProof ? '#fff8f8' : undefined
                  }}
                />
                <small className="text-muted">Upload PDF, JPG or PNG (Max: 2MB)</small>
              </Col>
              <Col md={4}>
                <InputText
                  name="documents.appointmentLetter"
                  label="Appointment Letter"
                  type="file"
                  register={register("documents.appointmentLetter", { required: "Appointment Letter is required" })}
                  errors={errors?.documents?.appointmentLetter ? 
                    { documents: { appointmentLetter: errors.documents.appointmentLetter } } : {}}
                  style={{
                    borderColor: errors?.documents?.appointmentLetter ? '#dc3545' : undefined,
                    backgroundColor: errors?.documents?.appointmentLetter ? '#fff8f8' : undefined
                  }}
                />
                <small className="text-muted">Upload PDF, JPG or PNG (Max: 2MB)</small>
              </Col>
            </Row>
          </Card.Body>
        </Card>
      </Collapsible>
    </div>
  );
};

export default EmployeeRegistrationForm;
