const onSubmit = (data) => {
  const finalData = { ...formData, ...data };

  const payload = createOwnerOrBuilderPayload("VESSEL_OWNER", {
    ...finalData,
  });

  const files = [
    finalData?.addressProof,
    finalData?.panCardUpload,
    finalData?.gstCertificate,
    finalData?.authorizationLetter,
    finalData?.companyRegistrationCertificate,
    finalData?.moaCertificate,
    finalData?.aoaCertificate,
    finalData?.tradeLicenseUpload,
  ];
  const fd = new FormData();

  fd.append(
    "request",
    new Blob([JSON.stringify(payload)], { type: "application/json" })
  );
  files?.forEach((file) => {
    if (file) {
      fd.append(`files`, file);
    }
  });
  submitUserDetails(fd);
};
