  //   // }
  // };

  //-- SUBMIT INTIAL SURVEY DATA TO API -- //
  const submitIntialSurveyData = async (surveyPayload, stepInfo = null) => {
    try {
      loaderRef.current?.show();
      const apiUrl =
        SERVICE_BASE.IWT_SURVEY_SERVICE +
        URLS_ENDPOINT.SURVEY_SERVICE.SURVEY_CREATE;

      const response = await postData(apiUrl, surveyPayload);
      if (response?.status === 200 || response?.status === 201) {
        setInitialRegistryData(response?.data || []);

        if (isOfficerLogin && isViewMode && !stepInfo) {
          toast.success("Survey Condtions/Remarks saved successfully!");
        } else {
          toast.success(
            response?.data?.responseStatus?.message ||
            "Intial survey data submitted successfully!"
          );
        }

        if (stepInfo) {
          stepperRef.current?.goToNextStep();
          if (stepInfo?.index === 1) {
            fetchPaymentDetails();
          }
        }
      } else {
        toast.error(
          response?.data?.responseStatus?.message ||
          "Failed to submit initial survey data."
        );
      }
    } catch (err) {
      handleErrorMessage(
        err?.response?.data ||
        "Failed to save survey. Check console for details."
      );
    } finally {
      loaderRef?.current?.hide();
    }
  };

 const fetchPaymentDetails = async () => {
  try {
    // loaderRef.current?.show();
    
    const payload = {
      category: "SURVEY",
      paymentProcess: "TRANSFEROFREGISTRYCHARGE",
      application_no: registrationData?.vessel.applicationNumber ?? "",
    };

    const apiUrl =
      SERVICE_BASE.IWT_REGISTRATION +
      URLS_ENDPOINT.VESSEL_SERVICE.PAYMENT_GENERATE;

    const response = await postData(apiUrl, payload);

    const isSuccess =
      response?.status === 200 &&
      ["201", 201, "FeeSlab found successfully"].includes(
        response?.data?.responseStatus?.status
      );

    if (!isSuccess) {
      // loaderRef.current?.hide();
      return;
    }

    const apiData = response?.data?.data ?? {};

    const formattedData = {
      invoiceBreakupInfo: (apiData?.feesDetailsl ?? []).map((fee, index) => ({
        id: fee?.id ?? index.toString(),
        label: fee?.category_description ?? fee?.category_name ?? "",
        amount: fee?.totalCalucation ?? fee?.old_data ?? 0,
        categoryHeader: fee?.catHeaderName ?? "",
      })),
      summary: {
        subTotal: apiData?.totalAmount ?? 0,
        cgst: apiData?.cgst ?? 0,
        sgst: apiData?.sgst ?? 0,
          // igst: apiData?.igst ?? 0,
        totalPayable: apiData?.totalAmountAtergst ?? 0,
      },
    };

    setPaymentData(formattedData);
    setFullPaymentData(response?.data ?? {});
    // loaderRef.current?.hide();
  } catch (error) {
    console.error("Error fetching payment details:", error);
    // loaderRef.current?.hide();
  }
};

  const handlePayNow = () => {
    navigate(`/payment?applicationNo=${registrationData?.vessel.applicationNumber}`, {
      state: {
        paymentData,
        applicationNumber: registrationData?.vessel.applicationNumber,
        fullPaymentData,
      },
    });
  };
  useEffect(() => {
    const vesselData = location.state?.vesselData;
    if (vesselData) {
        setVesselData(vesselData);
    }
}, [location.state]);

  const handleSave = () => {
    console.log("=== HANDLE SAVE ===");
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      navigate("/vessel-survey/success", {
        state: { surveyId: "VS2024001" },
      });
    }, 1500);
  };

  const getSteps = () => {
    const baseSteps = [
      {
        label: t("Vessel Details"),
        component: (
          <TransferOfRegistryForm
            formMethods={methods}
            viewMode={isViewMode}
            editMode={isEditMode}
            registrationData={registrationData}
            initialRegistryData={initialRegistryData}
            vesselData={vesselData}
          />
        ),
        validate: validateSurveyForm,
        getFormData: () => methods?.getValues(),
      },
      {
        label: t("Equipment & Vessel Information"),
        component: (
          <TransferEquipmentForm
            formMethods={methods}
            viewMode={isViewMode}
            editMode={isEditMode}
            registrationData={registrationData}
            initialRegistryData={initialRegistryData}
          />
        ),
        validate: validateEquipmentForm,
        getFormData: () => methods?.getValues(),
      },
    ];

    if (registrationData?.basicDetails?.initialSurveyCompleted && isOfficerLogin && userRole !== USER_ROLES.VESSEL_OWNER) {
      baseSteps.push({
        label: t("Book of Registration"),
        component: (
          <BookOfRegistrationForm
            formMethods={methods}
            viewMode={isOfficerLogin ? false : isViewMode}
            registrationData={registrationData}
          />
        ),
        validate: validateBookForm,
        getFormData: () => methods?.getValues(),
      });

      baseSteps.push({
        label: t("Certificate of Registration"),
        component: (
          <CertificateOfRegistrationForm8
            formMethods={methods}
            viewMode={isOfficerLogin ? false : isViewMode}
            registrationData={registrationData}
          />
        ),
        validate: validateCertificateForm,
        getFormData: () => methods?.getValues(),
      });
    }

    if (
      !isOfficerLogin &&
      !isViewMode &&
      userRole === USER_ROLES.VESSEL_OWNER && 
      !registrationData?.basicDetails?.initialSurveyCompleted
    ) {
      baseSteps.push({
        label: t("vesselDetails.Invoicing"),
        component: (
          <Invoicing
            supervisionAuthority={
              registrationData?.vessel?.supervisionAuthority ||
              "CLASSIFICATION SOCIETY"
            }
            onPayNow={handlePayNow}
            vesselData={registrationData}
            paymentData={paymentData}
          />
        ),
        showPayBtn: true,
        validate: () => true,
      });
    }
    return baseSteps;
  };

  const extractDocuments = (formData, dynamicTypes) => {
    const documents = [];
    console.log("vesselData", vesselData);
    const existingDocs = vesselData?.documents || [];
    console.log("existingDocs", existingDocs);

    dynamicTypes.forEach((type) => {
      Object.keys(formData)
        .filter((key) => key.startsWith(`${type}_fileStoreId_`))
        .forEach((storeKey) => {
          const index = storeKey.split("_").pop();
          const fileStoreId = formData[storeKey];
          const description = formData[`${type}_desc_${index}`] || "";
          const fileObj = formData?.[`${type}_file_${index}`];
          const existingDoc = existingDocs.find(
            (doc) =>
              doc.documentType === type &&
              doc.documentName?.includes(index.padStart(2, "0"))
          );

          if (fileStoreId) {
            documents.push({
              //  id: "", /// --- UPDATE API CALL
              id: existingDoc?.id || "",
              fileStoreId,
              documentName:
                fileObj?.name || `${type}_${index.padStart(2, "0")}.pdf`,
              documentType: type,
              documentSource: type,
              description,
            });
          }
        });
    });
    return documents;
  };

  const handleProvisionModalOpen = async (type) => {
    // const isRegistration = type === "registration";

    // const URL = isRegistration
