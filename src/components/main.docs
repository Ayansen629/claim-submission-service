import React, { useState, useEffect } from "react";
import { createRoot } from 'react-dom/client';

export const ToastTop = ({ targetId, duration, message, type }) => {
    const toastClasses = ['toast', 'align-items-center', 'text-white',
        'border-0', 'position-absolute', 'notification', 'show'];
    toastClasses.push(type);
    
    useEffect(() => {
        const timeout = setTimeout(() => {
            remove(targetId);
        }, duration * 1000);
        
        return () => {
            clearTimeout(timeout);
        };
    }, [targetId, duration]);

    const remove = (id) => {
        const container = document.getElementById(id);
        if (container && container._reactRoot) {
            container._reactRoot.unmount();
            delete container._reactRoot;
        }
    }

    return (
        <div className={toastClasses.join(' ')}
            role="alert"
            aria-live="assertive"
            aria-atomic="true">
            <div className="d-flex">
                <div className="toast-body">
                    {message}
                </div>
                <button type="button" className="btn-close btn-close-white me-2 m-auto" 
                        onClick={() => remove(targetId)}></button>
            </div>
        </div>
    );
};

export const toast = {
    notify: (message, options = {}) => {
        const duration = options.duration || 5;
        const targetId = options.targetId || "toast-container";
        const type = options.type === "error" ? "bg-danger" : "bg-warning";
        
        const container = document.getElementById(targetId);
        if (!container) {
            console.error(`Toast container with id '${targetId}' not found`);
            return;
        }
        
        if (!container._reactRoot) {
            container._reactRoot = createRoot(container);
        }
        
        container._reactRoot.render(
            <ToastTop
                message={message}
                targetId={targetId}
                duration={duration}
                type={type}
            />
        );
    },
    
    success: (message, options = {}) => {
        toast.notify(message, { ...options, type: "success" });
    },
    
    error: (message, options = {}) => {
        toast.notify(message, { ...options, type: "error" });
    },
    
    warning: (message, options = {}) => {
        toast.notify(message, { ...options, type: "warning" });
    }
};

export const ToastsContainer = ({ id = 'toast-container' }) => {
    return (
        <div id={id} className="toasts-container" style={{
            position: 'fixed',
            top: '20px',
            right: '20px',
            zIndex: 9999
        }}>
        </div>
    );
};
