/* Navbar.css - Professional Version */
:root {
  --primary-color: #2563eb; /* More vibrant blue */
  --primary-dark: #1d4ed8;
  --primary-light: #dbeafe;
  --secondary-color: #f59e0b;
  --text-dark: #1f2937;
  --text-light: #6b7280;
  --white: #ffffff;
  --light-bg: #f9fafb;
  --border-color: #e5e7eb;
  --success-color: #10b981;
  --danger-color: #ef4444;
  --warning-color: #f59e0b;
  --info-color: #3b82f6;
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.1);
  --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  --border-radius: 8px;
  --navbar-height: 70px;
  --sidebar-width: 240px;
  --sidebar-collapsed-width: 72px;
}

/* Base Styles */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--navbar-height);
  background-color: var(--white);
  box-shadow: var(--shadow-sm);
  z-index: 1000;
  transition: var(--transition);
  padding: 0;
  margin: 0;
  width: 100%;
  border-bottom: 1px solid var(--border-color);
}

.navbar-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  padding: 0 1.5rem;
  width: 100%;
  max-width: 100%;
}

/* Brand Logo */
.navbar-brand {
  display: flex;
  align-items: center;
  gap: 1rem;
  height: 100%;
}

.brand-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  color: var(--text-dark);
  font-weight: 600;
  font-size: 1.25rem;
}

.logo-img {
  height: 32px;
  width: auto;
}

.brand-name {
  display: block;
  white-space: nowrap;
  color: var(--primary-color);
  font-weight: 700;
  letter-spacing: 0.5px;
  font-size: 1.1rem;
}

/* Menu Toggle Button */
.menu-toggle {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 24px;
  height: 18px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
  margin-right: 1rem;
  outline: none;
}

.menu-toggle span {
  display: block;
  width: 100%;
  height: 2px;
  background-color: var(--text-dark);
  transition: var(--transition);
  border-radius: 2px;
}

.menu-toggle:hover span {
  background-color: var(--primary-color);
}

/* Search Container */
.navbar-center {
  flex: 1;
  display: flex;
  justify-content: center;
  max-width: 600px;
  margin: 0 1.5rem;
}

.search-container {
  position: relative;
  width: 100%;
  max-width: 500px;
  transition: var(--transition);
}

.search-input {
  width: 100%;
  padding: 0.65rem 1rem 0.65rem 2.75rem;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  background-color: var(--light-bg);
  font-size: 0.9rem;
  transition: var(--transition);
  outline: none;
  color: var(--text-dark);
}

.search-input:focus {
  border-color: var(--primary-color);
  background-color: var(--white);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.search-btn {
  position: absolute;
  left: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
  background: transparent;
  border: none;
  color: var(--text-light);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

/* Navbar Right Section */
.navbar-right {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-left: auto;
}

.nav-action-btn {
  background: transparent;
  border: none;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-dark);
  cursor: pointer;
  transition: var(--transition);
  position: relative;
}

.nav-action-btn:hover {
  background-color: var(--light-bg);
  color: var(--primary-color);
}

.nav-action-btn:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

/* Create Claim Button */
.create-claim-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: linear-gradient(to right, var(--primary-color), var(--primary-dark));
  color: var(--white);
  border: none;
  border-radius: 8px;
  font-weight: 500;
  font-size: 0.9rem;
  cursor: pointer;
  transition: var(--transition);
  text-decoration: none;
  box-shadow: var(--shadow-sm);
}

.create-claim-btn:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
  color: var(--white);
}

.create-claim-btn:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
}

.create-claim-btn span {
  display: inline-block;
}

/* User Profile */
.user-profile {
  position: relative;
}

.profile-btn {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0.25rem;
  border-radius: var(--border-radius);
  transition: var(--transition);
  max-width: 200px;
  outline: none;
}

.profile-btn:hover {
  background-color: var(--light-bg);
}

.avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(to right, var(--primary-color), var(--primary-dark));
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 0.9rem;
  flex-shrink: 0;
}

.user-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  width: 220px;
  background-color: var(--white);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-lg);
  z-index: 1000;
  overflow: hidden;
  animation: fadeIn 0.2s ease;
  border: 1px solid var(--border-color);
}

.dropdown-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  color: var(--text-dark);
  text-decoration: none;
  transition: var(--transition);
  cursor: pointer;
  border: none;
  background: transparent;
  width: 100%;
  text-align: left;
  font-size: 0.9rem;
  outline: none;
}

.dropdown-item:hover {
  background-color: var(--light-bg);
  color: var(--primary-color);
}

.dropdown-item:focus {
  box-shadow: none;
  background-color: var(--light-bg);
}

.dropdown-divider {
  height: 1px;
  background-color: var(--border-color);
  margin: 0.25rem 0;
}

/* Sidebar - Professional Design */
.sidebar {
  position: fixed;
  top: var(--navbar-height);
  left: 0;
  width: var(--sidebar-collapsed-width);
  height: calc(100vh - var(--navbar-height));
  background-color: var(--white);
  border-right: 1px solid var(--border-color);
  z-index: 900;
  transition: var(--transition);
  overflow-x: hidden;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.sidebar.expanded {
  width: var(--sidebar-width);
}

.sidebar-menu {
  padding: 0.5rem 0;
}

.sidebar-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.75rem 1.25rem;
  margin: 0 0.5rem;
  color: var(--text-dark);
  text-decoration: none;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
  white-space: nowrap;
  border-radius: 6px;
  outline: none;
}

.sidebar-item:hover {
  background-color: var(--light-bg);
  color: var(--primary-color);
}

.sidebar-item.active {
  color: var(--primary-color);
  background-color: var(--primary-light);
  font-weight: 500;
}

.sidebar-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 3px;
  background-color: var(--primary-color);
  border-radius: 0 3px 3px 0;
}

.sidebar-icon {
  font-size: 1.1rem;
  min-width: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sidebar-text {
  opacity: 0;
  transition: var(--transition);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 0.9rem;
}

.sidebar.expanded .sidebar-text {
  opacity: 1;
  display: block;
}

.sidebar-footer {
  padding: 0.5rem 0;
  border-top: 1px solid var(--border-color);
  margin-top: auto;
}

.logout-btn {
  color: var(--danger-color);
  margin: 0 0.5rem;
  border-radius: 6px;
}

.logout-btn:hover {
  background-color: rgba(239, 68, 68, 0.1);
  color: var(--danger-color);
}

.logout-btn:focus {
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
}

/* Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Responsive Styles */
@media (max-width: 992px) {
  .navbar-center {
    display: none;
  }
  
  .search-container.active {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 1rem;
    background-color: var(--white);
    box-shadow: var(--shadow-sm);
    z-index: 1000;
    display: flex;
  }
  
  .sidebar {
    transform: translateX(-100%);
  }
  
  .sidebar.expanded {
    transform: translateX(0);
    width: 240px;
  }
}

@media (min-width: 993px) {
  .search-icon {
    display: none;
  }
  
  .sidebar {
    transform: translateX(0);
  }
  
  .sidebar-text {
    display: none;
  }
  
  .sidebar.expanded .sidebar-text {
    display: block;
  }
}

@media (max-width: 768px) {
  .brand-name {
    display: none;
  }
  
  .create-claim-btn span {
    display: none;
  }
  
  .create-claim-btn {
    width: 38px;
    height: 38px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
  
  .user-info {
    display: none;
  }
  
  .navbar-container {
    padding: 0 1rem;
  }
}
