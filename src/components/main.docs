const ClaimTypeFields = ({ 
  claimType, 
  control, 
  register, 
  errors, 
  setValue, 
  getValues, 
  watch,
  trigger
}) => {
  const hasSecurityInterest = watch("hasSecurityInterest");
  const hasGuarantee = watch("hasGuarantee");
  
  const [showSecurityFields, setShowSecurityFields] = useState(hasSecurityInterest === "yes");
  const [showGuaranteeFields, setShowGuaranteeFields] = useState(hasGuarantee === "yes");

  // Initialize entity fields based on existing data
  const initialEntityFields = useMemo(() => {
    const fields = [];
    let i = 1;
    while (getValues(`${claimType}Name${i}`)) {
      fields.push(i);
      i++;
    }
    return fields.length > 0 ? fields : [1];
  }, [claimType, getValues]);

  const [entityFields, setEntityFields] = useState(initialEntityFields);

  useEffect(() => {
    setShowSecurityFields(hasSecurityInterest === "yes");
    setShowGuaranteeFields(hasGuarantee === "yes");
  }, [hasSecurityInterest, hasGuarantee]);

  const handleSecurityInterestChange = (value) => {
    setShowSecurityFields(value === "yes");
    if (value === "no") {
      setValue("securityValue", "", { shouldValidate: false });
      setValue("securityDate", "", { shouldValidate: false });
    }
  };

  const handleGuaranteeChange = (value) => {
    setShowGuaranteeFields(value === "yes");
    if (value === "no") {
      setValue("guaranteeValue", "", { shouldValidate: false });
      setValue("guaranteeDate", "", { shouldValidate: false });
    }
  };

  // Updated collectEntityData function with type handling
  const collectEntityData = () => {
    const entityType = 
      claimType === "principalBorrower" ? "PRINCIPAL_BORROWER" :
      claimType === "guarantor" ? "GUARANTOR" :
      "BENEFICIARY";

    const entities = entityFields.map(entityNum => ({
      id: entityNum,
      name: getValues(`${claimType}Name${entityNum}`) || "",
      address: getValues(`${claimType}Address${entityNum}`) || "",
      type: entityType
    }));

    setValue("entityData", entities, { shouldValidate: false });
    return entities;
  };

  const addEntityField = async () => {
    const newIndex = entityFields.length + 1;
    setEntityFields([...entityFields, newIndex]);
    setTimeout(() => collectEntityData(), 100);
    document.getElementById(`${claimType}Name${newIndex}`)?.focus();
  };

  const removeEntityField = async (index) => {
    if (entityFields.length <= 1) return;
    
    const newFields = [...entityFields];
    newFields.splice(index, 1);
    setEntityFields(newFields);
    
    const entityNum = index + 1;
    setValue(`${claimType}Name${entityNum}`, undefined, { shouldValidate: false });
    setValue(`${claimType}Address${entityNum}`, undefined, { shouldValidate: false });
    
    setTimeout(() => collectEntityData(), 100);
    await trigger();
  };

  // Update entity data whenever any field changes
  useEffect(() => {
    const subscription = watch((value, { name, type }) => {
      if (name && (name.includes('Name') || name.includes('Address'))) {
        collectEntityData();
      }
    });
    return () => subscription.unsubscribe();
  }, [watch, entityFields]);

  // ... (rest of the ClaimTypeFields component remains the same)
};

const FormCDetails = ({ provideSubmitHandler, formData, onValidationComplete }) => {
  const methods = useForm({ mode: "onChange" });
  const { 
    register, 
    handleSubmit, 
    formState: { errors, isValid }, 
    control, 
    setValue, 
    getValues, 
    watch, 
    reset, 
    trigger 
  } = methods;
  
  const [selectedClaimType, setSelectedClaimType] = useState("");

  const bankAccountFields = [
    // ... (keep existing bankAccountFields array)
  ];

  const claimTypeOptions = [
    { value: "", label: "Select Claim Type", disabled: true },
    { value: "principalBorrower", label: "Corporate Debtor as Principal Borrower" },
    { value: "guarantor", label: "Corporate Debtor as Guarantor" },
    { value: "financialDebt", label: "Financial Debt Covered" },
  ];

  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    if (!isValid) {
      console.error("Validation failed");
      return false;
    }
    
    const formValues = getValues();
    console.log("Form Submit Data with Entity Data:", formValues);
    
    // Transform entity data for payload
    const entityData = formValues.entityData || [];
    const transformedData = {
      principalBorrowerDetails: entityData
        .filter(e => e.type === "PRINCIPAL_BORROWER")
        .map(e => ({ name: e.name, address: e.address })),
      guarantorDetails: entityData
        .filter(e => e.type === "GUARANTOR")
        .map(e => ({ name: e.name, address: e.address })),
      beneficiaryDetails: entityData
        .filter(e => e.type === "BENEFICIARY")
        .map(e => ({ name: e.name, address: e.address }))
    };
    
    return {
      ...formValues,
      ...transformedData
    };
  }, [trigger, getValues]);

  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        setValue(key, formData[key]);
      });
      if (formData.claimType) {
        setSelectedClaimType(formData.claimType);
      }
    }
  }, [formData, setValue]);

  const handleClaimTypeChange = async (value) => {
    setSelectedClaimType(value);
    
    const baseReset = {
      claimType: value,
      claimAmount: "",
      hasSecurityInterest: "",
      hasGuarantee: "",
      securityValue: "",
      securityDate: "",
      guaranteeValue: "",
      guaranteeDate: "",
      entityData: []
    };

    // Clear entity fields based on previous claim type
    const resetEntityFields = (prefix) => {
      const entityNums = Array.from({ length: 10 }, (_, i) => i + 1);
      return entityNums.reduce((acc, num) => {
        acc[`${prefix}Name${num}`] = "";
        acc[`${prefix}Address${num}`] = "";
        return acc;
      }, {});
    };

    let resetState = { ...baseReset };

    if (value === "principalBorrower") {
      resetState = { ...resetState, ...resetEntityFields("principalBorrower") };
    } else if (value === "guarantor") {
      resetState = { ...resetState, ...resetEntityFields("guarantor") };
    } else if (value === "financialDebt") {
      resetState = { ...resetState, ...resetEntityFields("financialDebt") };
    }

    reset(resetState);
    await trigger();
  };

  // ... (rest of the FormCDetails component remains the same)
};

export default FormCDetails;
