import React, { useState, useContext, useEffect } from "react";
import { useForm } from "react-hook-form";
import { useNavigate } from "react-router-dom";
import { toast } from "react-toastify";
import FormInputRenderer from "../../common/FormInputRenderer";
import { UserContext } from "../../components/context/UserContext.js"; // Import UserContext
import "./Login.css";

const LoginPage = () => {
  const {
    register,
    handleSubmit,
    watch,
    formState: { errors },
    setValue,
    reset,
  } = useForm();
  const navigate = useNavigate();
  const { setUserData } = useContext(UserContext); // Use context to set user data

  const [otpSent, setOtpSent] = useState(false);
  const [otpVerified, setOtpVerified] = useState(false);
  const [otp, setOtp] = useState("");
  const [loading, setLoading] = useState(false);
  const [selectedRadio, setSelectedRadio] = useState("corporator"); // Default to "corporator"

  const username = watch("username");
  const userType = watch("userType");
  const financialCreditorType = watch("financialCreditorType");
  const operationalCreditorType = watch("operationalCreditorType");
  const corporateDebtorName = watch("corporateDebtorName");

  // Reset form fields when radio button changes
  useEffect(() => {
    reset({
      username: "",
      userType: "",
      financialCreditorType: "",
      operationalCreditorType: "",
      corporateDebtorName: "",
    });
    setOtpSent(false);
    setOtp("");
  }, [selectedRadio, reset]);

  const isValidUsername = (username) => {
    const mobileRegex = /^[6-9]\d{9}$/;
    return mobileRegex.test(username);
  };

  // Check if all required fields are filled for Claimants
  const isClaimantsFormValid = () => {
    if (selectedRadio === "claimants") {
      if (!isValidUsername(username) || !userType || !corporateDebtorName) return false;

      if (userType === "Financial Creditors" && !financialCreditorType) return false;
      if (userType === "Operational Creditors" && !operationalCreditorType) return false;

      return true;
    }
    return false;
  };

  // Check if all required fields are filled for Corporators
  const isCorporatorsFormValid = () => {
    if (selectedRadio === "corporator") {
      return isValidUsername(username) && !!userType && !!corporateDebtorName;
    }
    return false;
  };

  // Function to simulate sending OTP
  const handleSendOTP = async () => {
    if ((selectedRadio === "claimants" && isClaimantsFormValid()) || (selectedRadio === "corporator" && isCorporatorsFormValid())) {
      setLoading(true);

      // Simulate API call delay
      setTimeout(() => {
        const payload = {
          userType: selectedRadio === "corporator" ? "CRP" : "CLM",
          userId: username,
          corporateDebtorName: corporateDebtorName,
          claimantType: userType || "",
          claimantCategoryType:
            selectedRadio === "claimants" && userType === "Financial Creditors"
              ? financialCreditorType
              : selectedRadio === "claimants" && userType === "Operational Creditors"
              ? operationalCreditorType
              : "",
          otp: "123456", // Static OTP
        };

        console.log("Payload for Send OTP:", payload);

        toast.success("OTP Sent", { position: "top-right" });
        setOtpSent(true);
        setLoading(false);
      }, 1000);
    } else {
      toast.error("Please provide valid details.");
    }
  };

  const handleVerifyOTP = async (data) => {
    if (!otp) {
      toast.error("Please enter your OTP first.", { position: "top-right" });
      return;
    }
    if (!data.termsAccepted) {
      toast.info("Please accept the terms and conditions.", {
        position: "top-right",
      });
      return;
    }
  
    setLoading(true);
  
    // Simulate API call delay
    setTimeout(() => {
      if (otp === "123456") {
        const payload = {
          userType: selectedRadio === "corporator" ? "CRP" : "CLM",
          userId: username,
          corporateDebtorName: corporateDebtorName,
          claimantType: userType || "",
          claimantCategoryType:
            selectedRadio === "claimants" && userType === "Financial Creditors"
              ? financialCreditorType
              : selectedRadio === "claimants" && userType === "Operational Creditors"
              ? operationalCreditorType
              : "",
          otp: otp,
        };
  
        console.log("Payload for Verify OTP:", payload);
  
        // Save user data in context
        setUserData({
          userType: payload.userType,
          userId: payload.userId,
          corporateDebtorName: payload.corporateDebtorName,
          claimantType: payload.claimantType,
          claimantCategoryType: payload.claimantCategoryType,
        });
  
        // Save form data to localStorage
        localStorage.setItem("userFormData", JSON.stringify(payload));
  
        toast.success("OTP Verified Successfully", { position: "top-right" });
  
        // Navigate to dashboard
        setTimeout(() => {
          navigate("/dashboard");
        }, 1000);
      } else {
        toast.error("Failed to verify OTP. Please try again.", {
          position: "top-right",
        });
      }
      setLoading(false);
    }, 1000);
  };

  const corporatorOptions = [
    { value: "IRP", label: "IRP" },
    { value: "RP", label: "RP" },
    { value: "Liquidator", label: "Liquidator" },
    { value: "Bankruptcy Trustee", label: "Bankruptcy Trustee" },
  ];

  const claimantsOptions = [
    { value: "Financial Creditors", label: "Financial Creditors" },
    { value: "Operational Creditors", label: "Operational Creditors" },
    { value: "Employees and Workmen", label: "Employees and Workmen" },
    {
      value: "Employees and Workmen – Through Authorised Representative",
      label: "Employees and Workmen – Through Authorised Representative",
    },
    {
      value: "Other Creditors (other than financial and operational creditors)",
      label: "Other Creditors (other than financial and operational creditors)",
    },
  ];

  const financialCreditorOptions = [
    {
      value: "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)",
      label: "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)",
    },
    {
      value: "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)",
      label: "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)",
    },
    {
      value: "Unsecured Financial Creditors in Class of Creditors (Homebuyers)",
      label: "Unsecured Financial Creditors in Class of Creditors (Homebuyers)",
    },
    {
      value: "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)",
      label: "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)",
    },
  ];

  const operationalCreditorOptions = [
    {
      value: "Operational Creditors – (Other than Govt Authorities)",
      label: "Operational Creditors – (Other than Govt Authorities)",
    },
    {
      value: "Operational Creditors – Govt Authorities",
      label: "Operational Creditors – Govt Authorities",
    },
  ];

  const corporateDebtorOptions = [
    { value: "Jalpower Corporation Limited", label: "Jalpower Corporation Limited" },
    { value: "Neesa Leisure Limited", label: "Neesa Leisure Limited" },
    { value: "Empathy Infra and Engineering Private Limited", label: "Empathy Infra and Engineering Private Limited" },
    { value: "Simpa Energy India Private Limited", label: "Simpa Energy India Private Limited" },
    { value: "Eicher Polaris Private Limited", label: "Eicher Polaris Private Limited" },
  ];

  const InputFields = [
    ...(selectedRadio === "claimants"
      ? [
          {
            type: "text",
            name: "username",
            label: "Mobile Number",
            placeholder: "Enter your 10-digit mobile number",
          },
        ]
      : []),
    ...(selectedRadio === "corporator"
      ? [
          {
            type: "text",
            name: "username",
            label: "Mobile Number",
            placeholder: "Enter your 10-digit mobile number",
          },
        ]
      : []),
    {
      type: "dropdown",
      name: "corporateDebtorName",
      label: "Corporate Debtor Name",
      options: corporateDebtorOptions,
    },
    ...(selectedRadio === "claimants"
      ? [
          {
            type: "dropdown",
            name: "userType",
            label: "Claimant Type",
            options: claimantsOptions,
          },
        ]
      : []),
    ...(selectedRadio === "corporator"
      ? [
          {
            type: "dropdown",
            name: "userType",
            label: "Corporator Type",
            options: corporatorOptions,
          },
        ]
      : []),
  ];

  return (
    <div className="login-page">
      <div className="login-container">
        <div className="Login-header">
          <div className="login-text">LOG IN</div>
        </div>
        <div className="radio-options">
          <div className="radio-op">
            <input
              type="radio"
              id="corporator"
              name="radioGroup"
              value="corporator"
              checked={selectedRadio === "corporator"}
              onChange={() => setSelectedRadio("corporator")}
            />
            <label htmlFor="corporator">Corporator</label>
          </div>
          <div className="radio-op">
            <input
              type="radio"
              id="claimants"
              name="radioGroup"
              value="claimants"
              checked={selectedRadio === "claimants"}
              onChange={() => setSelectedRadio("claimants")}
            />
            <label htmlFor="claimants">Claimants</label>
          </div>
        </div>
        <div className="login-form">
          <form onSubmit={handleSubmit(handleVerifyOTP)}>
            {InputFields.map((field) => (
              <div key={field.name}>
                <FormInputRenderer
                  field={field}
                  register={register}
                  errors={errors}
                  watch={watch}
                  setValue={setValue}
                />
              </div>
            ))}
            {selectedRadio === "claimants" && userType === "Financial Creditors" && (
              <div className="dropdown-container">
                <select
                  className="dropdown-select"
                  {...register("financialCreditorType", { required: true })}
                >
                  <option value="">Select Claimants Categories </option>
                  {financialCreditorOptions.map((option) => (
                    <option key={option.value} value={option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </div>
            )}

            {selectedRadio === "claimants" && userType === "Operational Creditors" && (
              <div className="dropdown-container">
                <select
                  className="dropdown-select"
                  {...register("operationalCreditorType", { required: true })}
                >
                  <option value="">Select Claimants Categories </option>
                  {operationalCreditorOptions.map((option) => (
                    <option key={option.value} value={option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </div>
            )}

            {!otpSent && (
              <button
                type="button"
                className={`send-otp-btn ${
                  (selectedRadio === "claimants" && isClaimantsFormValid()) ||
                  (selectedRadio === "corporator" && isCorporatorsFormValid())
                    ? ""
                    : "disabled"
                }`}
                onClick={handleSendOTP}
                disabled={
                  (selectedRadio === "claimants" && !isClaimantsFormValid()) ||
                  (selectedRadio === "corporator" && !isCorporatorsFormValid())
                }
              >
                Send OTP
              </button>
            )}

            {otpSent && !otpVerified && (
              <div className="otp-verification">
                <input
                  type="password"
                  placeholder="Enter OTP here..."
                  value={otp}
                  onChange={(e) => setOtp(e.target.value)}
                />
              </div>
            )}

            <div className="login-footer">
              <div className="terms-conditions">
                <input
                  type="checkbox"
                  id="termsAccepted"
                  {...register("termsAccepted", {
                    required: "You must accept the terms",
                  })}
                />
                <label htmlFor="termsAccepted">
                  I accept the{" "}
                  <a href="/terms-and-conditions">Terms & Conditions</a>
                </label>
              </div>
              <button
                type="submit"
                className="login-btn"
                disabled={!otp || loading || !watch("termsAccepted")}
              >
                {loading ? "Logging in..." : "Verify OTP & Login"}
              </button>
              {selectedRadio === "claimants" && (
                <div className="register-text" onClick={() => navigate("/register")}>
                  Don't have an account? <span className="register-link">Register here</span>
                </div>
              )}
            </div>
          </form>
        </div>
      </div>
    </div>
  );
};

export default LoginPage;
