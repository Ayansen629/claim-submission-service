const ClaimTypeFields = ({ 
  claimType, 
  control, 
  register, 
  errors, 
  setValue, 
  getValues, 
  watch,
  trigger
}) => {
  // Initialize state based on form values
  const hasSecurityInterest = watch("hasSecurityInterest");
  const hasGuarantee = watch("hasGuarantee");
  
  const [showSecurityFields, setShowSecurityFields] = useState(hasSecurityInterest === "yes");
  const [showGuaranteeFields, setShowGuaranteeFields] = useState(hasGuarantee === "yes");

  // Function to get entity type based on claim type
  function getEntityType(claimType) {
    switch(claimType) {
      case "PRINCIPAL_BORROWER": return "GUARANTOR";
      case "GUARANTOR": return "PRINCIPAL_BORROWER";
      case "BENEFICIARY": return "BENEFICIARY";
      default: return "";
    }
  }

  const currentClaimType = watch("claimType");
  const formEntityData = watch("entityData");
  
  // Initialize entity data with correct types
  const [entityData, setEntityData] = useState(() => {
    const existingData = getValues("entityData");
    if (existingData && existingData.length > 0) {
      return existingData;
    }
    return [{ 
      id: 1, 
      name: "", 
      address: "", 
      type: getEntityType(claimType) 
    }];
  });

  // Update entity types when claimType changes
  useEffect(() => {
    if (claimType) {
      setEntityData(prev => {
        return prev.map(entity => ({
          ...entity,
          type: getEntityType(claimType)
        }));
      });
    }
  }, [claimType]);

  useEffect(() => {
    setEntityData([{ 
        id: 1, 
        name: "", 
        address: "", 
        type: getEntityType(currentClaimType) 
      }]);
      setValue("entityData", [{
        id: 1,
        name: "",
        address: "",
        type: getEntityType(currentClaimType)
      }]);
  }, [currentClaimType, setValue]);

  // Handle form value changes
  useEffect(() => {
    setShowSecurityFields(hasSecurityInterest === "yes");
    setShowGuaranteeFields(hasGuarantee === "yes");
  }, [hasSecurityInterest, hasGuarantee]);

  const handleSecurityInterestChange = (value) => {
    setShowSecurityFields(value === "yes");
    if (value === "no") {
      setValue("securityValue", "", { shouldValidate: false });
      setValue("securityDate", "", { shouldValidate: false });
    }
  };

  const handleGuaranteeChange = (value) => {
    setShowGuaranteeFields(value === "yes");
    if (value === "no") {
      setValue("guaranteeValue", "", { shouldValidate: false });
      setValue("guaranteeDate", "", { shouldValidate: false });
    }
  };

  // Sync entityData with form values when claimType changes or when form data loads
  useEffect(() => {
    if (formEntityData && formEntityData.length > 0) {
      setEntityData(formEntityData);
    } else {
      const newEntity = { 
        id: 1, 
        name: "", 
        address: "", 
        type: getEntityType(currentClaimType) 
      };
      setEntityData([newEntity]);
      setValue("entityData", [newEntity]);
    }
  }, [currentClaimType, formEntityData, setValue]);

  // Update form data when entity data changes
  useEffect(() => {
    setValue("entityData", entityData, { shouldValidate: true });
  }, [entityData, setValue]);

  const updateEntityDetails = (id, field, value) => {
    const updatedEntities = entityData.map(entity => 
      entity.id === id ? { ...entity, [field]: value } : entity
    );
    setEntityData(updatedEntities);
  };

  const addEntityField = () => {
    const newId = entityData.length > 0 ? Math.max(...entityData.map(e => e.id)) + 1 : 1;
    setEntityData([...entityData, { 
      id: newId, 
      name: "", 
      address: "", 
      type: getEntityType(claimType) 
    }]);
  };

  const removeEntityField = (id) => {
    if (entityData.length <= 1) return;
    const updatedEntities = entityData.filter(entity => entity.id !== id);
    setEntityData(updatedEntities);
  };

  const commonClaimFields = [
    {
      name: "claimAmount",
      label: "Amount of claim",
      type: "number",
      rules: { 
        required: "Claim amount is required",
        min: { value: 1, message: "Amount must be greater than 0" }
      },
      placeholder: "Enter claim amount"
    }
  ];

  const additionalFields = [
    {
      name: "hasSecurityInterest",
      label: "Amount of claim covered by security interest",
      type: "radio",
      options: [
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" }
      ],
      rules: { required: "This field is required" },
      onChange: handleSecurityInterestChange,
      show: claimType !== "BENEFICIARY"
    },
    {
      name: "securityValue",
      label: "Value of the security",
      type: "number",
      rules: showSecurityFields ? { 
        required: "Security value is required",
        min: { value: 1, message: "Value must be greater than 0" }
      } : {},
      placeholder: "Enter security value",
      show: showSecurityFields && claimType !== "BENEFICIARY"
    },
    {
      name: "securityDate",
      label: "Date of the security",
      type: "date",
      rules: showSecurityFields ? { 
        required: "Security date is required",
        validate: value => {
          const today = new Date().toISOString().split('T')[0];
          return value <= today || "Date cannot be in the future";
        }
      } : {},
      placeholder: "Select security date",
      show: showSecurityFields && claimType !== "BENEFICIARY"
    },
    {
      name: "hasGuarantee",
      label: "Amount of claim covered by guarantee",
      type: "radio",
      options: [
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" }
      ],
      rules: { required: "This field is required" },
      onChange: handleGuaranteeChange,
      show: claimType !== "BENEFICIARY"
    },
    {
      name: "guaranteeValue",
      label: "Value of the guarantee",
      type: "number",
      rules: showGuaranteeFields ? { 
        required: "Guarantee value is required",
        min: { value: 1, message: "Value must be greater than 0" }
      } : {},
      placeholder: "Enter guarantee value",
      show: showGuaranteeFields && claimType !== "BENEFICIARY"
    },
    {
      name: "guaranteeDate",
      label: "Date of the guarantee",
      type: "date",
      rules: showGuaranteeFields ? { 
        required: "Guarantee date is required",
        validate: value => {
          const today = new Date().toISOString().split('T')[0];
          return value <= today || "Date cannot be in the future";
        }
      } : {},
      placeholder: "Select guarantee date",
      show: showGuaranteeFields && claimType !== "BENEFICIARY"
    }
  ];

  const getEntityFieldLabels = () => {
    switch (claimType) {
      case "PRINCIPAL_BORROWER":
        return {
          nameLabel: "Name of the guarantor",
          addressLabel: "Address of the guarantor"
        };
      case "GUARANTOR":
        return {
          nameLabel: "Name of the Principal Borrower",
          addressLabel: "Address of the Principal Borrower"
        };
      case "BENEFICIARY":
        return {
          nameLabel: "Name of the Beneficiary",
          addressLabel: "Address of the Beneficiary"
        };
      default:
        return {
          nameLabel: "Name",
          addressLabel: "Address"
        };
    }
  };

  const { nameLabel, addressLabel } = getEntityFieldLabels();

  // Group fields into pairs for two-column layout
  const groupedFields = [];
  for (let i = 0; i < additionalFields.length; i += 2) {
    const pair = additionalFields.slice(i, i + 2);
    groupedFields.push(pair);
  }

  return (
    <div className="form-section">
      {/* Common claim fields */}
      <div className="row g-3 mb-4">
        {commonClaimFields.map((field) => (
          <div key={field.name} className="col-md-6">
            <DynamicField
              fieldConfig={field}
              control={control}
              register={register}
              errors={errors}
              setValue={setValue}
              getValues={getValues}
              watch={watch}
            />
          </div>
        ))}
      </div>

      {/* Additional fields in two-column layout */}
      {groupedFields.map((fieldPair, index) => (
        <div key={index} className="row g-3 mb-4">
          {fieldPair.map((field) => (
            field.show !== false && (
              <div key={field.name} className="col-md-6">
                <DynamicField
                  fieldConfig={field}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  getValues={getValues}
                  watch={watch}
                />
              </div>
            )
          ))}
        </div>
      ))}

      {/* Entity fields */}
      {entityData.map((entity, index) => (
        <div key={entity.id} className="entity-field-group mb-4 p-3 border rounded bg-light">
          <div className="d-flex justify-content-between align-items-center mb-3">
            <h6 className="mb-0">
              {claimType === "GUARANTOR" ? "Principal Borrower" : 
               claimType === "PRINCIPAL_BORROWER" ? "Guarantor" : "Beneficiary"} {index + 1}
            </h6>
            {entityData.length > 1 && (
              <button
                type="button"
                className="btn btn-sm btn-danger"
                onClick={() => removeEntityField(entity.id)}
              >
                <FaMinus className="me-1" /> Remove
              </button>
            )}
          </div>
          
          <div className="row g-3">
            <div className="col-md-6">
              <label className="form-label">
                {nameLabel} <span className="required-asterisk">*</span>
              </label>
              <input
                type="text"
                className={`form-control ${errors.entityData?.[index]?.name ? "is-invalid" : ""}`}
                value={entity.name || ""}
                onChange={(e) => updateEntityDetails(entity.id, "name", e.target.value)}
                placeholder={`Enter ${nameLabel.toLowerCase()}`}
              />
              {errors.entityData?.[index]?.name && (
                <div className="invalid-feedback">{errors.entityData[index].name.message}</div>
              )}
            </div>
            
            <div className="col-md-6">
              <label className="form-label">
                {addressLabel} <span className="required-asterisk">*</span>
              </label>
              <input
                type="text"
                className={`form-control ${errors.entityData?.[index]?.address ? "is-invalid" : ""}`}
                value={entity.address || ""}
                onChange={(e) => updateEntityDetails(entity.id, "address", e.target.value)}
                placeholder={`Enter ${addressLabel.toLowerCase()}`}
              />
              {errors.entityData?.[index]?.address && (
                <div className="invalid-feedback">{errors.entityData[index].address.message}</div>
              )}
            </div>
          </div>
        </div>
      ))}

      <button 
        type="button" 
        className="btn btn-outline-primary btn-sm add-more-btn"
        onClick={addEntityField}
      >
        <FaPlus className="me-2" /> Add {claimType === "GUARANTOR" ? "Principal Borrower" : 
                      claimType === "PRINCIPAL_BORROWER" ? "Guarantor" : "Beneficiary"}
      </button>
    </div>
  );
};
