import React, { useState } from 'react';
import { useForm, Controller } from 'react-hook-form';
import {
  Stepper, Step, StepLabel, Button, TextField, MenuItem,
  Grid, Paper, Typography, IconButton, FormControl, InputLabel,
  Select, Box, Card, CardContent, Divider, Avatar, LinearProgress
} from '@mui/material';
import {
  AddCircleOutline as AddIcon,
  RemoveCircleOutline as RemoveIcon,
  Person as PersonIcon,
  Business as BusinessIcon,
  Description as DocumentsIcon,
  CheckCircle as SuccessIcon
} from '@mui/icons-material';
import { styled } from '@mui/material/styles';

// Styled Components
const StyledPaper = styled(Paper)(({ theme }) => ({
  padding: theme.spacing(4),
  maxWidth: 900,
  margin: 'auto',
  boxShadow: '0px 4px 20px rgba(0, 0, 0, 0.1)',
  borderRadius: '12px',
  [theme.breakpoints.down('sm')]: { padding: theme.spacing(2) },
}));

const StepIcon = ({ icon, active }) => (
  <Avatar sx={{ 
    bgcolor: active ? 'primary.main' : 'grey.300',
    width: 32, height: 32, transition: 'all 0.3s ease'
  }}>{icon}</Avatar>
);

const DocumentUploadCard = styled(Card)(({ theme }) => ({
  border: `1px dashed ${theme.palette.divider}`,
  transition: 'all 0.3s ease',
  '&:hover': { borderColor: theme.palette.primary.main, boxShadow: theme.shadows[4] },
}));

// Field Configurations
const ownerCategories = [
  { value: 'Individual', label: 'Individual' },
  { value: 'Company', label: 'Company' },
  { value: 'Organization', label: 'Organization' }
];

const ownerFields = [
  { name: 'ownerName', label: 'Owner Name', type: 'text', required: true, grid: { xs: 12, md: 6 } },
  { name: 'email', label: 'Email ID', type: 'email', required: true, grid: { xs: 12, md: 6 } },
  { name: 'phoneNumber', label: 'Phone Number', type: 'tel', required: true, grid: { xs: 12, md: 6 } },
  { name: 'panNumber', label: 'PAN Number', type: 'text', required: true, grid: { xs: 12, md: 6 } },
  { name: 'gstNumber', label: 'GST Number', type: 'text', required: false, grid: { xs: 12, md: 6 } },
  { name: 'addressLine1', label: 'Address Line 1', type: 'text', required: true, grid: { xs: 12 } },
  { name: 'addressLine2', label: 'Address Line 2', type: 'text', required: false, grid: { xs: 12 } },
  { name: 'pin', label: 'PIN Code', type: 'text', required: true, grid: { xs: 12, md: 4 } },
  { name: 'district', label: 'District', type: 'text', required: false, disabled: true, grid: { xs: 12, md: 4 } },
  { name: 'state', label: 'State/UT', type: 'text', required: false, disabled: true, grid: { xs: 12, md: 4 } }
];

const authorizedPersonFields = [
  { name: 'firstName', label: 'First Name', type: 'text', required: true, grid: { xs: 12, sm: 6 } },
  { name: 'lastName', label: 'Last Name', type: 'text', required: true, grid: { xs: 12, sm: 6 } },
  { name: 'mobileNumber', label: 'Mobile Number', type: 'tel', required: true, grid: { xs: 12, sm: 6 } },
  { name: 'email', label: 'Email ID', type: 'email', required: true, grid: { xs: 12, sm: 6 } }
];

const documentFields = [
  { name: 'panCard', label: 'PAN Card', type: 'file', required: true, accept: '.pdf,.jpg,.jpeg,.png' },
  { name: 'gstCertificate', label: 'GST Certificate', type: 'file', required: false, accept: '.pdf,.jpg,.jpeg,.png' },
  { name: 'addressProof', label: 'Address Proof', type: 'file', required: true, accept: '.pdf,.jpg,.jpeg,.png' },
  { name: 'companyRegistrationCertificate', label: 'Company Registration', type: 'file', required: false, accept: '.pdf,.jpg,.jpeg,.png' },
  { name: 'cinNumber', label: 'CIN Number', type: 'text', required: false },
  { name: 'dinNumber', label: 'DIN Number', type: 'text', required: false }
];

// Main Component
const VesselOwnerRegistrationForm = () => {
  const [activeStep, setActiveStep] = useState(0);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [submitSuccess, setSubmitSuccess] = useState(false);
  const [authorizedPersons, setAuthorizedPersons] = useState([{ id: 1 }]);
  
  const { control, handleSubmit, watch, trigger } = useForm({
    defaultValues: {
      categoryOfOwner: '',
      ...ownerFields.reduce((acc, field) => ({ ...acc, [field.name]: '' }), {}),
      authorizedPersons: [authorizedPersonFields.reduce((acc, field) => ({ ...acc, [field.name]: '' }), {})],
      documents: documentFields.reduce((acc, field) => ({ ...acc, [field.name]: field.type === 'file' ? null : '' }), {})
    }
  });

  const ownerCategory = watch('categoryOfOwner');
  const steps = [
    { label: 'Owner Details', icon: <PersonIcon /> },
    { label: 'Authorized Persons', icon: <BusinessIcon /> },
    { label: 'Documents Upload', icon: <DocumentsIcon /> }
  ];

  const handleNext = async () => {
    const fieldsToValidate = activeStep === 0 
      ? ['categoryOfOwner', ...ownerFields.filter(f => f.required).map(f => f.name)]
      : ['authorizedPersons'];
    
    const isValid = await trigger(fieldsToValidate);
    if (isValid) setActiveStep(prev => prev + 1);
  };

  const handleBack = () => setActiveStep(prev => prev - 1);

  const handleAddPerson = () => setAuthorizedPersons([...authorizedPersons, { id: Date.now() }]);
  const handleRemovePerson = (id) => authorizedPersons.length > 1 && 
    setAuthorizedPersons(authorizedPersons.filter(p => p.id !== id));

  const onSubmit = async (data) => {
    setIsSubmitting(true);
    try {
      await new Promise(resolve => setTimeout(resolve, 1500));
      console.log('Form submitted:', data);
      setSubmitSuccess(true);
    } finally {
      setIsSubmitting(false);
    }
  };

  // Field Renderers
  const renderTextField = (name, label, rules = {}, options = {}) => (
    <Controller
      name={name}
      control={control}
      rules={rules}
      render={({ field, fieldState: { error } }) => (
        <TextField
          {...field}
          label={label}
          fullWidth
          error={!!error}
          helperText={error?.message}
          variant="outlined"
          {...options}
        />
      )}
    />
  );

  const renderFileField = (name, label, rules = {}, options = {}) => (
    <Controller
      name={name}
      control={control}
      rules={rules}
      render={({ field: { onChange, ...field }, fieldState: { error } }) => (
        <DocumentUploadCard>
          <CardContent>
            <TextField
              {...field}
              type="file"
              label={label}
              fullWidth
              InputLabelProps={{ shrink: true }}
              onChange={(e) => onChange(e.target.files[0])}
              error={!!error}
              helperText={error?.message}
              variant="outlined"
              {...options}
            />
          </CardContent>
        </DocumentUploadCard>
      )}
    />
  );

  // Step Content
  const getStepContent = (step) => {
    switch (step) {
      case 0:
        return (
          <Grid container spacing={3}>
            <Grid item xs={12}>
              <Typography variant="h6" gutterBottom>Basic Information</Typography>
              <Divider sx={{ mb: 3 }} />
            </Grid>

            <Grid item xs={12}>
              <Controller
                name="categoryOfOwner"
                control={control}
                rules={{ required: 'Category is required' }}
                render={({ field, fieldState: { error } }) => (
                  <FormControl fullWidth error={!!error}>
                    <InputLabel>Category of Owner</InputLabel>
                    <Select {...field} label="Category of Owner">
                      {ownerCategories.map((opt) => (
                        <MenuItem key={opt.value} value={opt.value}>{opt.label}</MenuItem>
                      ))}
                    </Select>
                    {error && <Typography variant="caption" color="error">{error.message}</Typography>}
                  </FormControl>
                )}
              />
            </Grid>

            {ownerFields
              .filter(field => ownerCategory !== 'Individual' || field.name !== 'gstNumber')
              .map((field) => (
                <Grid item key={field.name} {...field.grid}>
                  {renderTextField(
                    field.name,
                    field.label,
                    { 
                      required: field.required ? `${field.label} is required` : false,
                      pattern: field.type === 'email' ? { 
                        value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                        message: 'Invalid email address'
                      } : undefined
                    },
                    { disabled: field.disabled }
                  )}
                </Grid>
              ))}
          </Grid>
        );

      case 1:
        return (
          <Grid container spacing={3}>
            <Grid item xs={12}>
              <Typography variant="h6" gutterBottom>Authorized Persons</Typography>
              <Divider sx={{ mb: 3 }} />
            </Grid>

            {authorizedPersons.map((person, index) => (
              <React.Fragment key={person.id}>
                <Grid item xs={12}>
                  <Box display="flex" alignItems="center" justifyContent="space-between">
                    <Typography variant="subtitle1">Person {index + 1}</Typography>
                    {index > 0 && (
                      <IconButton onClick={() => handleRemovePerson(person.id)} color="error" size="small">
                        <RemoveIcon />
                      </IconButton>
                    )}
                  </Box>
                </Grid>

                {authorizedPersonFields.map((field) => (
                  <Grid item key={field.name} {...field.grid}>
                    {renderTextField(
                      `authorizedPersons[${index}].${field.name}`,
                      field.label,
                      { required: field.required ? `${field.label} is required` : false }
                    )}
                  </Grid>
                ))}

                <Grid item xs={12}>
                  {renderFileField(
                    `authorizedPersons[${index}].authorizationLetter`,
                    'Letter of Authorization',
                    { required: 'Authorization letter is required' },
                    { accept: '.pdf,.jpg,.jpeg,.png' }
                  )}
                </Grid>

                {index < authorizedPersons.length - 1 && (
                  <Grid item xs={12}><Divider sx={{ my: 3 }} /></Grid>
                )}
              </React.Fragment>
            ))}

            <Grid item xs={12}>
              <Button variant="outlined" startIcon={<AddIcon />} onClick={handleAddPerson}>
                Add Authorized Person
              </Button>
            </Grid>
          </Grid>
        );

      case 2:
        return (
          <Grid container spacing={3}>
            <Grid item xs={12}>
              <Typography variant="h6" gutterBottom>Required Documents</Typography>
              <Divider sx={{ mb: 3 }} />
            </Grid>

            {documentFields
              .filter(field => ownerCategory !== 'Individual' || !['gstCertificate', 'companyRegistrationCertificate'].includes(field.name))
              .map((field) => (
                <Grid item xs={12} key={field.name}>
                  {field.type === 'file' ? (
                    renderFileField(
                      `documents.${field.name}`,
                      field.label,
                      { required: field.required ? `${field.label} is required` : false },
                      { accept: field.accept }
                    )
                  ) : (
                    renderTextField(
                      `documents.${field.name}`,
                      field.label,
                      { required: field.required ? `${field.label} is required` : false }
                    )
                  )}
                </Grid>
              ))}
          </Grid>
        );

      default:
        return null;
    }
  };

  return (
    <StyledPaper>
      <Typography variant="h4" gutterBottom align="center" sx={{ mb: 4 }}>
        Vessel Owner Registration
      </Typography>

      <Stepper activeStep={activeStep} alternativeLabel sx={{ mb: 4 }}>
        {steps.map((step, index) => (
          <Step key={step.label}>
            <StepLabel StepIconComponent={() => <StepIcon icon={step.icon} active={index <= activeStep} />}>
              {step.label}
            </StepLabel>
          </Step>
        ))}
      </Stepper>

      {isSubmitting && <LinearProgress sx={{ mb: 3 }} />}

      <form onSubmit={handleSubmit(onSubmit)}>
        {submitSuccess ? (
          <Box textAlign="center" py={6}>
            <SuccessIcon color="success" sx={{ fontSize: 80, mb: 2 }} />
            <Typography variant="h5" gutterBottom>
              Registration Successful!
            </Typography>
            <Typography color="textSecondary">
              Your vessel registration has been submitted. We'll contact you shortly.
            </Typography>
          </Box>
        ) : (
          <>
            {getStepContent(activeStep)}
            
            <Box sx={{ display: 'flex', justifyContent: 'flex-end', mt: 4 }}>
              {activeStep !== 0 && (
                <Button onClick={handleBack} sx={{ mr: 2 }}>
                  Back
                </Button>
              )}
              
              {activeStep === steps.length - 1 ? (
                <Button type="submit" variant="contained" color="primary" disabled={isSubmitting}>
                  {isSubmitting ? 'Submitting...' : 'Submit Registration'}
                </Button>
              ) : (
                <Button variant="contained" color="primary" onClick={handleNext}>
                  Next
                </Button>
              )}
            </Box>
          </>
        )}
      </form>
    </StyledPaper>
  );
};

export default VesselOwnerRegistrationForm;
