const extractAllEnclosures = (formValues) => {
  const enclosures = [];
  
  // Single file documents - fix the field checking
  const singleFileTypes = [
    { field: "certificateOfRegistration", type: "CERTIFICATE_OF_REGISTRATION", name: "Certificate of Registration" },
    { field: "NOCfromOriginalRegistrationAuthority", type: "NOC_FROM_ORIGINAL_REGISTRATION_AUTHORITY", name: "NOC from Original Registration Authority" },
    { field: "lastSurveyCertificate", type: "LAST_SURVEY_CERTIFICATE", name: "Last Survey Certificate" },
    { field: "tonnageBooklet", type: "TONNAGE_BOOKLET", name: "Tonnage Booklet" },
    { field: "stabilityBooklet", type: "STABILITY_BOOKLET", name: "Stability Booklet" },
    { field: "insuranceCertificate", type: "INSURANCE_CERTIFICATE", name: "Insurance Certificate" },
    { field: "paymentChallan", type: "PAYMENT_CHALLAN", name: "Payment Challan" }
  ];

  singleFileTypes.forEach(({ field, type, name }) => {
    // Check in enclosure object for fileStoreId
    const fileStoreId = formValues.enclosure?.[`${field}FileStoreId`];
    const fileName = formValues.enclosure?.[field]?.name || formValues.enclosure?.[`${field}OriginalName`];
    
    if (fileStoreId) {
      enclosures.push({
        id: "",
        documentName: fileName || `${name}.pdf`,
        documentType: type,
        fileStoreId,
        documentSource: "TRANSFER_ENCLOSURE",
        description: name,
        active: true
      });
    }
  });

  // Multi-file documents (keep existing)
  const multiFileTypes = ["DRAWING", "RADIOGRAPHY_REPORT", "MATERIAL_TEST_REPORT", "OTHER_INSPECTION_REPORT", "OTHER_TECH_DOC"];
  
  multiFileTypes.forEach(type => {
    Object.keys(formValues)
      .filter(key => key.startsWith(`${type}_fileStoreId_`))
      .forEach(storeKey => {
        const index = storeKey.split("_").pop();
        const fileStoreId = formValues[storeKey];
        const fileObj = formValues[`${type}_file_${index}`];
        
        if (fileStoreId) {
          enclosures.push({
            id: "",
            documentName: fileObj?.name || `${type}_${index}.pdf`,
            documentType: type,
            fileStoreId,
            documentSource: "TRANSFER_ENCLOSURE",
            description: formValues[`${type}_desc_${index}`] || type,
            active: true
          });
        }
      });
  });

  return enclosures;
};
