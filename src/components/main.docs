//     }
//   };
 
  const handlePrevious = () => {
    setCurrentStep((prevStep) => Math.max(1, prevStep - 1));
  };
 
  const handleCancel = () => {
    navigate("/dashboard");
  };
 
  const calculateProgressBarWidth = () => {
    return ((currentStep - 1) / (stepsConfig.length - 1)) * 100;
  };
 
  const ActiveComponent = stepsConfig[currentStep - 1]?.Component;
  console.log("Active Component:", ActiveComponent);

 
  return (
    <>
      <div className="stepper">
        {stepsConfig.map((step, index) => (
          <div
            key={step.name}
            ref={(el) => (stepRef.current[index] = el)}
            className={`step ${
              currentStep > index + 1 || isComplete ? "complete" : ""
            } ${currentStep === index + 1 ? "active" : ""}`}
          >
            <div className="step-number">
              {currentStep > index + 1 || isComplete ? (
                <span>&#10003;</span>
              ) : (
                index + 1
              )}
            </div>
            <div className="step-name">{step.name}</div>
          </div>
        ))}
 
        <div
          className="progress-bar"
          style={{
            marginLeft: margins.marginLeft,
            marginRight: margins.marginRight,
          }}
        >
          <div
            className="progress"
            style={{ width: `${calculateProgressBarWidth()}%` }}
          ></div>
        </div>
      </div>
 
      {ActiveComponent && (
      <ActiveComponent
      formData={formData[`step${currentStep}`] || {}} // Ensure no undefined values
      provideSubmitHandler={updateSubmitHandler}
      setFormData={setFormData}
      // onUpdateData={onStepDataUpdate}
      // formAllData={formAllData}
    />
   
      )}
<div className="stepper-buttons">
  {currentStep > 1 && (
    <button className="buttonplus previous-button" onClick={handlePrevious}>
      Previous
    </button>
  )}
  {currentStep === 1 && (
    <button className="buttonplus cancel-button" onClick={handleCancel}>
      Cancel
    </button>
  )}
  <div className="right-button-group">
  {currentStep === 3 && (
      <button className="cancelthirdstep" onClick={handleCancel}>
        Cancel
      </button>
    )}
    <button
      className="buttonplus next-button"
      onClick={handleNext}
      disabled={isComplete}
    >
      {currentStep === stepsConfig.length ? "Submit" : "Next"}
    </button>
    
  </div>
</div>
    </>
  );
};
 
export default Stepper;
 

const transformFormData = (formData) => {
  // Determine transaction data based on transactionDataAvailable
  const transactionStepData = formData.step3 || {};
  const transactionDetails =
    transactionStepData.transactionDataAvailable === "no"
      ? [] // Empty object in array when "No" is selected
      : [
          {
            nameOfPersonTitleDerived: transactionStepData.transactionDetails?.nameOfPersonTitleDerived || "",
            noOfSharesAffected: transactionStepData.transactionDetails?.noOfSharesAffected || "",
            dateHourOfRegistry: transactionStepData.transactionDetails?.dateHourOfRegistry || "",
            natureOfTransaction: transactionStepData.transactionDetails?.natureOfTransaction || "",
            nameResidenceOccupation: transactionStepData.transactionDetails?.nameResidenceOccupation || "",
            numberOfTransactionTransferee: transactionStepData.transactionDetails?.numberOfTransactionTransferee || "",
            remarks: transactionStepData.transactionDetails?.remarks || "",
            dateOfTransaction: transactionStepData.transactionDetails?.dateOfTransaction || "",
            transactionNo: transactionStepData.transactionDetails?.transactionNo || "",
          },
        ];

  return {
    boiler: [
      {
        typeOfBoiler: formData.step2?.typeOfBoiler || "",
        noOfBoiler: formData.step2?.noOfBoiler || "",
        totalHeatingSurface: formData.step2?.totalHeatingSurface || "",
        grateArea: formData.step2?.grateArea || "",
        workingPressure: formData.step2?.workingPressure || "",
        madeBy: formData.step2?.boilerMadeBy || "",
        yearOfMake: formData.step2?.boilerYearOfMake || "",
        madeOfMaterial: formData.step2?.madeOfMaterial || "",
      },
    ],
    engine: [
      {
        typeOfEngine: formData.step2?.typeOfEngine || "",
        engineNo: formData.step2?.engineNo || "",
        description: formData.step2?.enginedescription || "",
        noOfSeats: formData.step2?.noOfSeats || "",
        madeBy: formData.step2?.engineMadeBy || "",
        yearOfMake: formData.step2?.engineYearOfMake || "",
        noOfCylindersPerSet: formData.step2?.noOfCylindersPerSet || "",
        diameterOfCylinderInInches: formData.step2?.diameterOfCylinderInInches || "",
        strokesInInches: formData.step2?.strokesInInches || "",
        surfaceJet: formData.step2?.surfaceJet || "",
        nhp: formData.step2?.nhp || "",
        bhp: formData.step2?.bhp || "",
        ihp: formData.step2?.ihp || "",
        rpm: formData.step2?.engineRpm || "",
      },
    ],
    propulsion: [
      {
        propelerType: formData.step2?.propelerType || "",
        rpm: formData.step2?.propulsionsRpm || "",
        speedOfVessel: formData.step2?.speedOfVessel || "",
        propulsionGearedOrDirectDriven: formData.step2?.propulsionGearedOrDirectDriven || "",
        propulsionType: formData.step2?.propulsionType || "",
        registeringAuthority: formData.step2?.registeringAuthority || "",
        dateOfRegistration: formData.step2?.dateOfRegistration || "",
      },
    ],
    registrationBook: [
      {
        registrationNo: formData.step1?.registrationNo || "",
        noAndYear: formData.step1?.noAndYear || "",
        nameOfVessel: formData.step1?.nameOfVessel || "",
        portOfRegistry: formData.step1?.portOfRegistry || "",
        yearOfRegistry: formData.step1?.yearOfRegistry || "",
        nameOfOwner: formData.step1?.nameOfOwner || "",
        addressOfOwner: formData.step1?.addressOfOwner || "",
        status: formData.step1?.status || "Active",
        registrationBookNo: formData.step1?.registrationBookNo || "",
      },
    ],
    transaction: transactionDetails, // Use the computed transaction data
    vesselDescription: [
      {
        vesselType: formData.step1?.vesselType || "",
        category: formData.step1?.category || "",
        grossTonnage: formData.step1?.grossTonnage || "",
        registeredTonnage: formData.step1?.registeredTonnage || "",
      },
    ],
    vesselParticulars: [
      {
        lengthOverall: formData.step2?.lengthOverall || "",
        breadthExtreme: formData.step2?.breadthExtreme || "",
        depthOfUndersideOfDeckamidShips: formData.step2?.depthOfUndersideOfDeckamidShips || "",
        builderNameAddress: formData.step2?.builderNameAddress || "",
        builderAddress: formData.step2?.builderAddress || "",
        yearOfBuild: formData.step2?.yearOfBuild || "",
        typeOfHull: formData.step2?.typeOfHull || "",
        noOfDecks: formData.step2?.noOfDecks || "",
        noOfBulkheads: formData.step2?.noOfBulkheads || "",
        description: formData.step2?.particulardescription || "",
        stren: formData.step2?.stren || "",
        build: formData.step2?.build || "",
      },
    ],
  };
};
