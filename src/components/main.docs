const ClaimTypeFields = ({ 
  claimType, 
  control, 
  register, 
  errors, 
  setValue, 
  getValues, 
  watch,
  trigger
}) => {
  // ... (other state declarations remain the same)

  const collectEntityData = useCallback(() => {
    const entityType = 
      claimType === "principalBorrower" ? "PRINCIPAL_BORROWER" :
      claimType === "guarantor" ? "GUARANTOR" :
      "BENEFICIARY";

    const entities = entityFields.map(entityNum => {
      const name = getValues(`${claimType}Name${entityNum}`);
      const address = getValues(`${claimType}Address${entityNum}`);
      
      // Only include entities that have at least a name
      if (name) {
        return {
          id: entityNum,
          name: name || "",
          address: address || "",
          type: entityType
        };
      }
      return null;
    }).filter(Boolean); // Remove null entries

    setValue("entityData", entities, { shouldValidate: true });
    return entities;
  }, [claimType, entityFields, getValues, setValue]);

  const addEntityField = useCallback(() => {
    const newIndex = (entityFields.length > 0 ? Math.max(...entityFields) : 0) + 1;
    setEntityFields([...entityFields, newIndex]);
    
    // Focus the new field after a small delay
    setTimeout(() => {
      document.getElementById(`${claimType}Name${newIndex}`)?.focus();
    }, 100);
  }, [entityFields, claimType]);

  const removeEntityField = useCallback(async (index) => {
    if (entityFields.length <= 1) return;

    const entityNumToRemove = entityFields[index];
    const newFields = entityFields.filter((_, i) => i !== index);
    setEntityFields(newFields);

    // Clear the form values for the removed entity
    setValue(`${claimType}Name${entityNumToRemove}`, undefined, { shouldValidate: false });
    setValue(`${claimType}Address${entityNumToRemove}`, undefined, { shouldValidate: false });

    // Get current entityData and filter out the removed entity
    const currentEntityData = getValues("entityData") || [];
    const updatedEntityData = currentEntityData.filter(entity => 
      entity.id !== entityNumToRemove
    );

    // Update the entityData array in form state
    setValue("entityData", updatedEntityData, { shouldValidate: true });

    await trigger();
  }, [entityFields, setValue, getValues, trigger, claimType]);

  // Watch for changes and update entityData
  useEffect(() => {
    const subscription = watch((value, { name }) => {
      if (name && (name.includes('Name') || name.includes('Address'))) {
        collectEntityData();
      }
    });
    return () => subscription.unsubscribe();
  }, [watch, collectEntityData]);

  // Render method remains the same
  // ...
};
