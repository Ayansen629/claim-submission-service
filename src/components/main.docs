import React from "react";
import { useNavigate } from "react-router-dom";
import { Container, Row, Col, Button } from "react-bootstrap";
import { FaHome } from "react-icons/fa";
import TrackingStepper from "./TrackingStepper";
import "./TrackingPage.css"; // Add this CSS file

const TrackingPage = () => {
  const navigate = useNavigate();
  
  const steps = [
    {
      title: "Application Submitted",
      description: "Your application has been received",
      date: "2023-05-15"
    },
    {
      title: "Initial Review",
      description: "Verification of documents and information",
      date: "2023-05-17"
    },
    {
      title: "Detailed Assessment",
      description: "Evaluation by case officer"
    },
    {
      title: "Final Decision",
      description: "Approval or rejection of application"
    }
  ];

  return (
    <Container className="tracking-page-container">
      {/* Dashboard Navigation Button */}
      <div className="dashboard-return-container">
        <Button 
          variant="outline-primary" 
          onClick={() => navigate('/dashboard')}
          className="dashboard-return-button"
        >
          <FaHome className="me-2" />
          Go to Dashboard
        </Button>
      </div>

      {/* Main Tracking Content */}
      <Row className="justify-content-center">
        <Col lg={8}>
          <TrackingStepper 
            status="under_review" 
            currentStep={2} 
            steps={steps} 
          />
        </Col>
      </Row>
    </Container>
  );
};

export default TrackingPage;


/* Tracking Page Container */
.tracking-page-container {
  position: relative;
  padding-top: 2rem;
  padding-bottom: 3rem;
}

/* Dashboard Navigation Button */
.dashboard-return-container {
  position: absolute;
  top: 1rem;
  right: 1rem;
  z-index: 100;
}

.dashboard-return-button {
  display: flex;
  align-items: center;
  padding: 0.5rem 1rem;
  font-weight: 500;
  border-radius: 4px;
  transition: all 0.2s ease;
}

.dashboard-return-button:hover {
  background-color: #f8f9fa;
  transform: translateY(-1px);
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .dashboard-return-container {
    position: static;
    margin-bottom: 1rem;
    text-align: right;
  }
  
  .dashboard-return-button {
    display: inline-flex;
  }
}
