import React, { useState } from "react";
import { Button, Card } from "react-bootstrap";
import { BsPlus } from "react-icons/bs";
import { useTranslation } from "react-i18next";
import ActionTable from "../../../../../common/ActionTable.tsx";
import FileUploadModal from "./FileUploadModal";

const ReportsDashboard = ({
  initialReports = {
    materialTest: [],
    radiography: [],
    inspection: [],
    other: [],
  },
  onViewReport,
  onDeleteReport,
  onDownloadReport,
  onSaveReports,
  onResetReports,
}) => {
  const { t } = useTranslation();
  const [showFileModal, setShowFileModal] = useState(false);
  const [currentReportType, setCurrentReportType] = useState("");
  const [reports, setReports] = useState(initialReports);

  const REPORT_COLUMNS = [
    {
      colName: "Add Attachment",
      fieldName: "fileName",
      clsName: "column-text-start",
    },
    {
      colName: "Description",
      fieldName: "description",
      clsName: "column-text-start",
    },
    {
      colName: "Remarks",
      fieldName: "remarks",
      clsName: "column-text-start",
    },
    {
      colName: "Action",
      fieldName: "action",
      actions: ['view', 'delete', 'download'],
      clsName: "col-sm-2 column-text-start actions-column",
    },
  ];

  const handleAddReport = (reportType) => {
    setCurrentReportType(reportType);
    setShowFileModal(true);
  };

  const handleFileUpload = (e) => {
    e.preventDefault();
    const file = e.target.file.files[0];
    if (file) {
      const newReport = {
        id: Date.now(),
        fileName: file.name,
        description: e.target.description.value || "No description",
        remarks: e.target.remarks.value || "No remarks",
      };

      setReports((prev) => ({
        ...prev,
        [currentReportType]: [...prev[currentReportType], newReport],
      }));

      setShowFileModal(false);
    }
  };

  const handleTableAction = (action, rowData, reportType) => {
    switch (action) {
      case 'view':
        onViewReport?.(rowData, reportType);
        break;
      case 'delete':
        onDeleteReport?.(rowData, reportType);
        setReports(prev => ({
          ...prev,
          [reportType]: prev[reportType].filter(report => report.id !== rowData.id)
        }));
        break;
      case 'download':
        onDownloadReport?.(rowData, reportType);
        break;
      default:
        break;
    }
  };

  const renderReportTable = (reportType, reportData) => {
    const translatedColumns = REPORT_COLUMNS.map(col => ({
      ...col,
      colName: t(col.colName)
    }));

    return (
      <div className="mb-4">
        <div className="d-flex justify-content-between align-items-center mb-3">
          <h5 className="mb-0">
            {t(
              reportType
                .replace(/([A-Z])/g, " $1")
                .replace(/^./, (str) => str.toUpperCase()) + " Report"
            )}
          </h5>
          <Button
            variant="primary"
            size="sm"
            onClick={() => handleAddReport(reportType)}
          >
            <BsPlus size={20} /> {t("Add")}
          </Button>
        </div>

        <ActionTable
          columns={translatedColumns}
          rowData={reportData}
          tableHeader={null}
          hideExportBtn={true}
          hideSearchBar={true}
          pagination={false}
          onViewRow={(rowData) => handleTableAction('view', rowData, reportType)}
          onDeleteRow={(rowData) => handleTableAction('delete', rowData, reportType)}
          download={(rowData) => handleTableAction('download', rowData, reportType)}
          noDataText={t("No reports available")}
        />
      </div>
    );
  };

  return (
    <Card className="mt-4">
      <Card.Header className="dashboard-card-header">
        <h5>{t("Reports")}</h5>
      </Card.Header>
      <Card.Body>
        <div className="reports-section">
          {renderReportTable("materialTest", reports.materialTest)}
          {renderReportTable("radiography", reports.radiography)}
          {renderReportTable("inspection", reports.inspection)}
          {renderReportTable("other", reports.other)}

          <div className="d-flex justify-content-end mt-4">
            <Button 
              variant="secondary" 
              className="me-2"
              onClick={onResetReports}
            >
              {t("Reset")}
            </Button>
            <Button 
              variant="primary"
              onClick={() => onSaveReports?.(reports)}
            >
              {t("Save")}
            </Button>
          </div>
        </div>
      </Card.Body>

      <FileUploadModal
        show={showFileModal}
        onHide={() => setShowFileModal(false)}
        reportType={currentReportType}
        onSubmit={handleFileUpload}
      />
    </Card>
  );
};

export default ReportsDashboard;
