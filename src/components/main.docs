import React, { useState, useCallback, useEffect } from "react";
import { useForm, FormProvider } from "react-hook-form";
import DynamicField from "./formCommon/DynamicField";
import Collapsible from "./formCommon/Collapsible";
import { Button } from 'react-bootstrap';
import 'bootstrap/dist/css/bootstrap.min.css';

const StepThird = ({ provideSubmitHandler, formData }) => {
    const methods = useForm();
    const { register, handleSubmit, formState: { errors }, trigger, setValue, control, getValues } = methods;

    const financialCreditorDetailsSchema = [
        { 
            name: "creditorName", 
            label: <>Name of financial creditor or person authorised to act on its behalf (in BLOCK LETTERS) <span className="required-asterisk">*</span></>, 
            type: "text", 
            rules: { 
                required: "Creditor name is required",
                pattern: {
                    value: /^[A-Z\s]+$/,
                    message: "Please enter in BLOCK LETTERS only"
                }
            },
            placeholder: "Enter name in BLOCK LETTERS" 
        },
        { 
            name: "creditorPosition", 
            label: <>Position with or in relation to creditor <span className="required-asterisk">*</span></>, 
            type: "text", 
            rules: { required: "Position is required" },
            placeholder: "Enter position/relation to creditor" 
        },
        { 
            name: "creditorAddress", 
            label: <>Address of person signing <span className="required-asterisk">*</span></>, 
            type: "textarea",
            rules: { 
                required: "Address is required",
            },
            placeholder: "Enter complete address" 
        },
    ];

    const onSubmit = useCallback(async () => {
        const isValid = await trigger();
        if (!isValid) {
            console.error("Validation failed");
            return false;
        }
        return getValues();
    }, [trigger, getValues]);

    useEffect(() => {
        if (formData) {
            Object.keys(formData).forEach((key) => {
                setValue(key, formData[key]);
            });
        }
    }, [formData, setValue]);

    useEffect(() => {
        if (provideSubmitHandler) {
            provideSubmitHandler(onSubmit);
        }
    }, [provideSubmitHandler, onSubmit]);

    return (
        <FormProvider {...methods}>
            <form className="form-stepper">
                <div className="mb-4 bg-light">
                    <Collapsible title="Financial Creditor Details" defaultOpen={true}>
                        <div className="flex-container">
                            {financialCreditorDetailsSchema.map((fieldConfig) => (
                                <DynamicField
                                    key={fieldConfig.name}
                                    fieldConfig={fieldConfig}
                                    control={control}
                                    register={register}
                                    errors={errors}
                                    setValue={setValue}
                                    trigger={trigger}
                                    getValues={getValues}
                                />
                            ))}
                        </div>
                    </Collapsible>
                </div>
            </form>
        </FormProvider>
    );
};

export default StepThird;
