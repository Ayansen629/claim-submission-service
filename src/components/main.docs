import React from "react";
import { useLocation, useNavigate, useParams } from "react-router-dom";
import DynamicTabs from "../../../common/DynamicTabs";
import VesselSurveyRegistration from "./survey/VesselSurveyRegistration";
import VesselReportsAndDocs from "./common/VesselReportsAndDocs";
import { useTranslation } from "react-i18next";
import { Button } from "react-bootstrap";
import { Box, Typography, Stack, Paper } from "@mui/material";
import { BsArrowLeft } from "react-icons/bs";

const VesselApplicationDetailsView = () => {
  const { t } = useTranslation();
  const { id } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  const { rowData } = location?.state || {};
  
  const tabs = [
    {
      key: "registration",
      title: t("Registration Information"),
      content: <VesselReportsAndDocs applicationNo={id} viewMode tabMode />,
    },
    ...(rowData?.enableInitialSurvey
      ? [
          {
            key: "survey",
            title: t("Initial Survey - Details"),
            content: (
              <VesselSurveyRegistration applicationNo={id} viewMode tabMode />
            ),
          },
        ]
      : []),
  ];

  return (
    <Box sx={{ p: 3, backgroundColor: "#f8fafc", minHeight: "100vh" }}>
      {/* Enhanced Header */}
      <Paper 
        elevation={0}
        sx={{ 
          p: 3, 
          mb: 3, 
          borderRadius: 2,
          background: "linear-gradient(135deg, #f6f9fc 0%, #ffffff 100%)",
          border: "1px solid #e1e8ed",
          position: "relative",
          overflow: "hidden",
          "&::before": {
            content: '""',
            position: "absolute",
            top: 0,
            left: 0,
            width: "4px",
            height: "100%",
            backgroundColor: "#2E57A7"
          }
        }}
      >
        <Box sx={{ display: 'flex', alignItems: 'center' }}>
          <Button
            variant="outline-primary"
            onClick={() => navigate("/dashboard")}
            className="d-flex align-items-center justify-content-center"
            sx={{
              borderRadius: "8px",
              width: 48,
              height: 48,
              border: "1px solid #e1e8ed",
              color: "#2E57A7",
              backgroundColor: "#fff",
              transition: "all 0.3s ease",
              padding: 0,
              marginRight: 2,
              boxShadow: "0 2px 6px rgba(0,0,0,0.05)",
              "&:hover": {
                backgroundColor: "#2E57A7",
                color: "#fff",
                transform: "translateY(-2px)",
                boxShadow: "0 4px 12px rgba(46, 87, 167, 0.15)",
                borderColor: "#2E57A7"
              }
            }}
            aria-label={t("Back to Dashboard")}
          >
            <BsArrowLeft size={18} />
          </Button>
          
          <Stack spacing={0.5}>
            <Typography
              sx={{
                fontWeight: 600,
                color: "#1a3353",
                fontSize: "1.5rem",
                lineHeight: 1.2,
              }}
              component="h1"
            >
              {t("Vessel Application Details")}
            </Typography>
            {id && (
              <Typography
                sx={{
                  fontWeight: 500,
                  color: "#64748b",
                  fontSize: "0.95rem",
                }}
              >
                Application ID: {id}
              </Typography>
            )}
          </Stack>
        </Box>
      </Paper>
      
      {/* Enhanced Tabs Section */}
      <Paper 
        elevation={0}
        sx={{ 
          borderRadius: 2,
          overflow: "hidden",
          border: "1px solid #e1e8ed",
          backgroundColor: "#fff"
        }}
      >
        <DynamicTabs tabs={tabs} />
      </Paper>
    </Box>
  );
};

export default VesselApplicationDetailsView;
