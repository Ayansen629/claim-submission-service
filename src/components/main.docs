  useEffect(() => {
    const generateMockData = () => {
      const mockData = [];
      for (let i = 1; i <= 100; i++) {
        mockData.push({
          id: i,
          claimNumber: `CLM-${1000 + i}`,
          claimant: `Claimant ${i}`,
          status: i % 2 === 0 ? "Approved" : "Pending",
          amount: `$${(Math.random() * 10000).toFixed(2)}`,
          dateSubmitted: new Date(
            Date.now() - Math.floor(Math.random() * 10000000000)
          ).toLocaleDateString(),
          action: ["view", "edit"],
        });
      }
      return mockData;
    };
  
    try {
      const formattedData = generateMockData();
  
      // Retrieve user data from localStorage
      const userData = JSON.parse(localStorage.getItem("userFormData"));
  
      // If userType is CRP, update claimNumber to be a clickable link
      if (userData?.userType === "CRP") {
        formattedData.forEach((item) => {
          item.claimNumber = (
            <a href={`/apply-claim/${item.id}`} style={{ color: "#269ccc", textDecoration: "underline" }}>
              {item.claimNumber}
            </a>
          );
        });
      }
  
      setRowData(formattedData);
    } catch (error) {
      toast.error("Failed to generate mock data", { position: "top-right" });
    }
  }, []);
  

  // useEffect(() => {
  //   const fetchTableData = async () => {
  //     try {
  //       const URL =
  //         process.env.REACT_APP_BASE_URL +
  //         URLS_ENDPOINT.APP_SERVICES.DASHBOARD_SEARCH;
  //       const response = await postData(URL, {});
  //       if (response?.data?.length > 0) {
  //         const formattedData = response?.data?.map((item, index) => ({
  //           ...item,
  //           id: item.uuid,
  //           slNo: index + 1,
  //         }));
  //         setRowData(formattedData);
  //       } else {
  //         setRowData([]);
  //       }
  //     } catch (error) {
  //       toast.error(APP_MESSAGES.API_ERR, { position: "top-right" });
  //     }
  //   };
  //   fetchTableData();
  // }, []);

  return (
    <div className="container-fluid mt-5" style={{ paddingLeft: 0, paddingRight: 0 }}>
      {!isLoading ? (
        <>
          <h3 className="mb-2 text-center">Claim Submission Service</h3>
          <br />
          <div className="row mb-3 align-items-center">
            <div className="col-12 col-md-4 d-flex justify-content-md-end justify-content-center gap-2 ms-auto">
              {/* <button className="btn btn-success btn-sm" onClick={handleAddButtonClick}>
                <i className="fas fa-plus"></i> Add
              </button> */}
              {/* <button className="btn btn-success btn-sm" onClick={() => setIsModalOpen(true)}>
                <i className="fas fa-upload"></i> Bulk Upload
              </button> */}
            </div>
          </div>
          <ActionTable
