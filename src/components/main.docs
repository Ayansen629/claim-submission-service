useEffect(() => {
  if (!intialSurveyData && masterData?.surveyTypes) {
    const initialSurvey = masterData.surveyTypes.find(
      type => type.valueLabel === "Initial"
    );
    if (initialSurvey) {
      setValue("basicVesselInfo.typeOfSurvey", initialSurvey.valueCode);
    }
  }
}, [masterData, intialSurveyData, setValue]);
