import React, { useState } from 'react';
import { Modal, Button } from 'react-bootstrap';
import { format, addDays, setHours, setMinutes } from 'date-fns';
import 'bootstrap/dist/css/bootstrap.min.css';
import './AppointmentModal.css';

const AppointmentModal = ({ show, handleClose, handleConfirm }) => {
  // Generate date and time slots
  const generateSlots = () => {
    const slots = [];
    const today = new Date();
    
    // For each of the next 7 days
    for (let i = 0; i < 7; i++) {
      const date = addDays(today, i);
      const dateFormatted = format(date, 'MMM d, yyyy');
      const dayName = format(date, 'EEEE');
      const daySlots = [];
      
      // Generate different number of slots for each day
      const slotCount = [4, 3, 5, 4, 6, 2, 4][i]; // Varying slots per day
      
      for (let j = 0; j < slotCount; j++) {
        const hour = 9 + j; // Starting at 9 AM
        const startTime = setHours(setMinutes(date, 0), hour);
        const endTime = setHours(setMinutes(date, 0), hour + 1);
        const timeString = hour < 12 ? `${hour}:00 AM` : `${hour-12}:00 PM`;
        const endString = hour+1 < 12 ? `${hour+1}:00 AM` : `${hour-11}:00 PM`;
        
        daySlots.push({
          id: `${date.getTime()}-${j}`,
          start: startTime,
          end: endTime,
          timeDisplay: `${timeString} - ${endString}`,
          dateDisplay: dateFormatted,
          dayName: dayName,
          fullDisplay: `${timeString} - ${endString}, ${dayName} ${dateFormatted}`
        });
      }
      
      slots.push(...daySlots);
    }
    
    return slots;
  };

  const [selectedSlot, setSelectedSlot] = useState(null);
  const timeSlots = generateSlots();

  return (
    <Modal show={show} onHide={handleClose} centered size="lg" className="appointment-modal">
      <Modal.Header closeButton className="border-bottom-0">
        <Modal.Title className="fw-bold text-primary">Select Your Appointment</Modal.Title>
      </Modal.Header>
      
      <Modal.Body>
        <div className="slots-grid">
          {timeSlots.map((slot) => (
            <div 
              key={slot.id}
              className={`slot-card ${selectedSlot?.id === slot.id ? 'selected' : ''}`}
              onClick={() => setSelectedSlot(slot)}
            >
              <div className="slot-day">{slot.dayName}</div>
              <div className="slot-date">{slot.dateDisplay}</div>
              <div className="slot-time">{slot.timeDisplay}</div>
              {selectedSlot?.id === slot.id && (
                <div className="selected-badge">
                  <i className="bi bi-check-circle-fill"></i>
                </div>
              )}
            </div>
          ))}
        </div>
      </Modal.Body>
      
      <Modal.Footer className="border-top-0">
        <Button variant="outline-secondary" onClick={handleClose}>
          Cancel
        </Button>
        <Button 
          variant="primary" 
          onClick={() => {
            if (selectedSlot) {
              handleConfirm(selectedSlot);
              handleClose();
            }
          }}
          disabled={!selectedSlot}
          className="confirm-btn"
        >
          Confirm Appointment
        </Button>
      </Modal.Footer>
    </Modal>
  );
};

export default AppointmentModal;
