import React, { useState } from "react";
import { Row, Col, Form, Button, Alert } from "react-bootstrap";
import InputFile from "../../../common/InputFile";
import { useTranslation } from "react-i18next";

const DocumentsStepper = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const {
    register,
    watch,
    setValue,
    clearErrors,
    formState: { errors },
  } = formMethods;

  const [activeDocStep, setActiveDocStep] = useState(0);

  const documentSteps = [
    {
      title: t("Work Order"),
      name: "workOrderFiles",
      required: false,
      multiple: true,
    },
    {
      title: t("Drawings"),
      name: "drawingFiles",
      required: false,
      multiple: true,
    },
    {
      title: t("Tonnage Booklets"),
      name: "tonnageBooklets",
      required: true,
      multiple: false,
    },
    {
      title: t("Stability Booklets"),
      name: "stabilityBooklets",
      required: true,
      multiple: false,
    },
  ];

  const currentStep = documentSteps[activeDocStep];
  const currentFiles = watch(currentStep.name) || [];

  const handleNext = () => {
    // Validate current step before proceeding
    if (currentStep.required && (!currentFiles || currentFiles.length === 0)) {
      return;
    }
    if (activeDocStep < documentSteps.length - 1) {
      setActiveDocStep(activeDocStep + 1);
    }
  };

  const handlePrev = () => {
    if (activeDocStep > 0) {
      setActiveDocStep(activeDocStep - 1);
    }
  };

  const handleFileChange = (e) => {
    if (viewMode) return;
    
    const files = e.target.files;
    if (files && files.length > 0) {
      if (currentStep.multiple) {
        // For multiple files, append to existing files
        const existingFiles = Array.isArray(currentFiles) ? currentFiles : [];
        const newFiles = [...existingFiles, ...Array.from(files)];
        setValue(currentStep.name, newFiles);
      } else {
        // For single file, replace existing file
        setValue(currentStep.name, files[0]);
      }
      clearErrors(currentStep.name);
    }
  };

  const removeFile = (index) => {
    if (viewMode) return;
    
    if (currentStep.multiple) {
      const updatedFiles = [...currentFiles];
      updatedFiles.splice(index, 1);
      setValue(currentStep.name, updatedFiles.length > 0 ? updatedFiles : null);
    } else {
      setValue(currentStep.name, null);
    }
  };

  return (
    <div className="documents-stepper">
      <div className="stepper-header mb-4">
        <h5>{currentStep.title}</h5>
        <div className="stepper-progress">
          {documentSteps.map((step, index) => (
            <span
              key={index}
              className={`step-dot ${index === activeDocStep ? "active" : ""} ${
                index < activeDocStep ? "completed" : ""
              }`}
              onClick={() => !viewMode && setActiveDocStep(index)}
            />
          ))}
        </div>
      </div>

      {currentStep.required && (!currentFiles || currentFiles.length === 0) && (
        <Alert variant="danger" className="mb-3">
          {t("This document is required")}
        </Alert>
      )}

      <div className="file-upload-section mb-4">
        {!viewMode && (
          <InputFile
            label={t("Upload File")}
            name={currentStep.name}
            register={register(currentStep.name, {
              required: currentStep.required && t("This document is required"),
            })}
            errors={errors}
            onChange={handleFileChange}
            multiple={currentStep.multiple}
            accept=".pdf,.jpg,.jpeg,.png"
          />
        )}

        {currentFiles && currentFiles.length > 0 && (
          <div className="uploaded-files mt-3">
            <h6>{t("Uploaded Files")}:</h6>
            <ul className="list-unstyled">
              {Array.isArray(currentFiles) ? (
                currentFiles.map((file, index) => (
                  <li key={index} className="d-flex align-items-center mb-2">
                    <span className="me-2">
                      {file.name || (file instanceof File ? file.name : "File")}
                    </span>
                    {!viewMode && (
                      <Button
                        variant="link"
                        size="sm"
                        className="text-danger p-0"
                        onClick={() => removeFile(index)}
                      >
                        {t("Remove")}
                      </Button>
                    )}
                  </li>
                ))
              ) : (
                <li className="d-flex align-items-center mb-2">
                  <span className="me-2">
                    {currentFiles.name ||
                      (currentFiles instanceof File ? currentFiles.name : "File")}
                  </span>
                  {!viewMode && (
                    <Button
                      variant="link"
                      size="sm"
                      className="text-danger p-0"
                      onClick={() => removeFile(0)}
                    >
                      {t("Remove")}
                    </Button>
                  )}
                </li>
              )}
            </ul>
          </div>
        )}
      </div>

      {!viewMode && (
        <div className="stepper-navigation d-flex justify-content-between">
          <Button
            variant="outline-secondary"
            onClick={handlePrev}
            disabled={activeDocStep === 0}
          >
            {t("Previous")}
          </Button>
          <Button
            variant="primary"
            onClick={handleNext}
            disabled={
              currentStep.required &&
              (!currentFiles || currentFiles.length === 0)
            }
          >
            {activeDocStep === documentSteps.length - 1
              ? t("Finish")
              : t("Next")}
          </Button>
        </div>
      )}
    </div>
  );
};

export default DocumentsStepper;
