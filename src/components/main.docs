import React from "react";
import { Row, Col, Table } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { formatDate } from "../../../../../utils/constants.ts";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";

const ProvisionalCertificateOfRegistration = ({ registrationData, surveyData }) => {
  const { t } = useTranslation();
  
  const employeeDetailsString = getFromLocalStorage("employeeDetails");
  const employeeDetails = employeeDetailsString ? JSON.parse(employeeDetailsString) : {};
  
  const currentDate = new Date();
  const expiryDate = new Date(currentDate.getTime() + (365 * 24 * 60 * 60 * 1000)); // 1 year from now

  return (
    <div className="registration-certificate-container">
      <div className="certificate-header">
        <h4 className="certificate-title">{t("PROVISIONAL CERTIFICATE OF REGISTRATION")}</h4>
      </div>

      <div className="certificate-body">
        {/* Expiry Date */}
        <div className="expiry-section mb-4">
          <span className="expiry-label">{t("Expiry on or before the")} ({formatDate(expiryDate)})</span>
        </div>

        {/* Issued By */}
        <div className="issued-by-section mb-4">
          <span className="issued-label">{t("Issued by")} ({t("IWT Authority")})</span>
        </div>

        {/* Particulars of Vessel */}
        <div className="vessel-particulars mb-4">
          <h5 className="section-title">{t("PARTICULARS OF VESSEL")}</h5>
          
          <Table bordered className="particulars-table">
            <tbody>
              <tr>
                <td className="label-cell">{t("Official Number")}</td>
                <td className="value-cell">{registrationData?.vessel?.registrationNo || "N/A"}</td>
                <td className="label-cell">{t("Registration Date")}</td>
                <td className="value-cell">{formatDate(currentDate)}</td>
                <td className="label-cell">{t("Name of the Vessel")}</td>
                <td className="value-cell">{registrationData?.vessel?.vesselName || "N/A"}</td>
                <td className="label-cell">{t("Port of Registry")}</td>
                <td className="value-cell">{registrationData?.vessel?.registry || "N/A"}</td>
              </tr>
              <tr>
                <td className="label-cell">{t("Previous Registration No.")}</td>
                <td className="value-cell">-</td>
                <td className="label-cell">{t("Date of Previous Registry")}</td>
                <td className="value-cell">-</td>
                <td className="label-cell">{t("Port of Previous Registry")}</td>
                <td className="value-cell">-</td>
                <td className="label-cell">{t("Name of Builder")}</td>
                <td className="value-cell">{registrationData?.builder?.name || "N/A"}</td>
              </tr>
              <tr>
                <td className="label-cell">{t("Address of Builder")}</td>
                <td className="value-cell">{registrationData?.builder?.address || "N/A"}</td>
                <td className="label-cell">{t("Where Built")}</td>
                <td className="value-cell">{registrationData?.vessel?.placeOfBuild || "N/A"}</td>
                <td className="label-cell">{t("Propulsion Type")}</td>
                <td className="value-cell">{registrationData?.engine?.type || "N/A"}</td>
                <td className="label-cell">{t("Number of Deck")}</td>
                <td className="value-cell">1</td>
              </tr>
              <tr>
                <td className="label-cell">{t("Material Description")}</td>
                <td className="value-cell">{surveyData?.hullParticulars?.hullMaterial || "Steel"}</td>
                <td className="label-cell">{t("Number of Bulkheads")}</td>
                <td className="value-cell">{surveyData?.hullParticulars?.numberOfBulkheads || "N/A"}</td>
                <td className="label-cell">{t("Stern")}</td>
                <td className="value-cell">Transom</td>
                <td className="label-cell">{t("Build")}</td>
                <td className="value-cell">{registrationData?.vessel?.yearOfBuild || "N/A"}</td>
              </tr>
              <tr>
                <td className="label-cell">{t("Length")}</td>
                <td className="value-cell">{surveyData?.basicVesselInfo?.lengthOfVessel || "N/A"}</td>
                <td className="label-cell">{t("Breadth")}</td>
                <td className="value-cell">{surveyData?.basicVesselInfo?.breadthOfVessel || "N/A"}</td>
                <td className="label-cell">{t("Depth")}</td>
                <td className="value-cell">{surveyData?.basicVesselInfo?.depthOfVessel || "N/A"}</td>
                <td className="label-cell">{t("Draft")}</td>
                <td className="value-cell">{surveyData?.basicVesselInfo?.draft || "N/A"}</td>
              </tr>
              <tr>
                <td className="label-cell">{t("Length of the Engine Room")}</td>
                <td className="value-cell">8m</td>
                <td className="label-cell">{t("GROSS TONNAGE")}</td>
                <td className="value-cell">{registrationData?.vessel?.grt || "N/A"}</td>
                <td className="label-cell">{t("NET TONNAGE")}</td>
                <td className="value-cell">{surveyData?.basicVesselInfo?.netTonnage || "N/A"}</td>
                <td className="label-cell">{t("Number of crew")}</td>
                <td className="value-cell">5</td>
              </tr>
              <tr>
                <td className="label-cell">{t("Number of Engines:")}</td>
                <td className="value-cell">{surveyData?.detailsOfPropulsion?.numberOfEngine || "1"}</td>
                <td className="label-cell">{t("Combined Power")}</td>
                <td className="value-cell">{registrationData?.engine?.horsepower || "N/A"} HP</td>
                <td className="label-cell">{t("Name of Engine Maker")}</td>
                <td className="value-cell">{registrationData?.engine?.make || "N/A"}</td>
                <td className="label-cell">{t("Address of Engine Maker")}</td>
                <td className="value-cell">{registrationData?.engine?.makerAddress || "N/A"}</td>
              </tr>
            </tbody>
          </Table>
        </div>

        {/* Survey Certificate Note */}
        <div className="survey-note mb-4">
          <p className="note-text">
            {t("A detailed summary of the tonnages for this vessel is shown on the Certificate of Survey")}
          </p>
        </div>

        {/* Crew Accommodation */}
        <div className="crew-section mb-4">
          <div className="crew-info">
            <span className="crew-label">{t("The Number of crew for whom accommodation is certified")}</span>
            <span className="crew-value">5</span>
          </div>
        </div>

        {/* Certification Statement */}
        <div className="certification-statement mb-4">
          <p className="statement-text">
            {t("I, the undersigned, Registering Authority at the Port of")} <strong>{registrationData?.vessel?.registry || "N/A"}</strong> {t("in")} <strong>West Bengal</strong> {t("here by certify that the Inland Vessel the Description of which is prefixed to this Provisional certificate, has been duly surveyed, and that the above Description is true; that")} <strong>{registrationData?.vessel?.nameOfMaster || "N/A"}</strong> {t("whose Certificate of Competency of Service is No")} <strong>COC123456</strong>, {t("is the Master of the said Vessel, and that the Name")} <strong>{registrationData?.owner?.name || "N/A"}</strong> {t("Residence of")} <strong>{registrationData?.owner?.address || "N/A"}</strong>, {t("owner of")} <strong>{registrationData?.vessel?.vesselName || "N/A"}</strong>, {t("Number of Tenth Shares Held by are as follows")} :-
          </p>
        </div>

        {/* Owner Details Table */}
        <div className="owner-details">
          <Table bordered className="owner-table">
            <thead>
              <tr>
                <th className="owner-header">{t("Name Residence and Occupation of the Owner")}</th>
                <th className="shares-header">{t("Number of Tenth Shares")}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td className="owner-info">
                  <div><strong>{t("Name")}:</strong> {registrationData?.owner?.name || "N/A"}</div>
                  <div><strong>{t("Residence")}:</strong> {registrationData?.owner?.address || "N/A"}</div>
                  <div><strong>{t("Occupation")}:</strong> {registrationData?.other?.occupation || "Business"}</div>
                </td>
                <td className="shares-value">10/10</td>
              </tr>
            </tbody>
          </Table>
        </div>
      </div>

      <style jsx>{`
        .registration-certificate-container {
          background: white;
          border: 2px solid #2466BF;
          border-radius: 12px;
          overflow: hidden;
          box-shadow: 0 4px 12px rgba(36, 102, 191, 0.15);
          margin-top: 1rem;
        }

        .certificate-header {
          background: linear-gradient(135deg, #2466BF 0%, #1a4fa0 100%);
          padding: 1rem;
          text-align: center;
        }

        .certificate-title {
          color: white;
          font-weight: 700;
          font-size: 1.3rem;
          margin: 0;
          letter-spacing: 1px;
        }

        .certificate-body {
          padding: 2rem;
          background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        }

        .expiry-section, .issued-by-section {
          text-align: center;
          background: #f8f9fa;
          padding: 1rem;
          border-radius: 6px;
          border: 1px solid #dee2e6;
        }

        .expiry-label, .issued-label {
          font-weight: 600;
          color: #2466BF;
          font-size: 1rem;
        }

        .section-title {
          color: #2466BF;
          font-weight: 700;
          font-size: 1.1rem;
          text-align: center;
          margin-bottom: 1rem;
          text-transform: uppercase;
          letter-spacing: 0.5px;
          border-bottom: 2px solid #2466BF;
          padding-bottom: 0.5rem;
        }

        .particulars-table {
          font-size: 0.8rem;
          margin-bottom: 0;
        }

        .label-cell {
          background: #2466BF;
          color: white;
          font-weight: 600;
          padding: 0.5rem;
          text-align: center;
          width: 12.5%;
        }

        .value-cell {
          background: white;
          color: #333;
          font-weight: 600;
          padding: 0.5rem;
          text-align: center;
          width: 12.5%;
        }

        .survey-note {
          background: #fff3cd;
          border: 1px solid #ffeaa7;
          padding: 1rem;
          border-radius: 6px;
          text-align: center;
        }

        .note-text {
          margin: 0;
          font-weight: 600;
          color: #856404;
        }

        .crew-section {
          background: #f8f9fa;
          padding: 1rem;
          border-radius: 6px;
          border-left: 4px solid #2466BF;
        }

        .crew-info {
          display: flex;
          justify-content: space-between;
          align-items: center;
        }

        .crew-label {
          font-weight: 600;
          color: #666;
        }

        .crew-value {
          font-weight: 700;
          color: #2466BF;
          font-size: 1.1rem;
        }

        .certification-statement {
          background: #f8f9fa;
          padding: 1.5rem;
          border-radius: 6px;
          border-left: 4px solid #2466BF;
        }

        .statement-text {
          text-align: justify;
          line-height: 1.6;
          margin: 0;
          color: #333;
        }

        .owner-table {
          font-size: 0.9rem;
        }

        .owner-header, .shares-header {
          background: #2466BF;
          color: white;
          text-align: center;
          font-weight: 600;
          padding: 0.75rem;
        }

        .owner-info {
          padding: 1rem;
          line-height: 1.6;
        }

        .owner-info div {
          margin-bottom: 0.5rem;
        }

        .shares-value {
          text-align: center;
          font-weight: 700;
          color: #2466BF;
          font-size: 1.1rem;
          vertical-align: middle;
        }

        @media (max-width: 768px) {
          .certificate-body {
            padding: 1rem;
          }
          
          .particulars-table {
            font-size: 0.7rem;
          }
          
          .label-cell, .value-cell {
            padding: 0.25rem;
          }
          
          .crew-info {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
          }
        }
      `}</style>
    </div>
  );
};

export default ProvisionalCertificateOfRegistration;
