// For Purchase Type
<InputSelect
  label="Purchase Type"
  name="purchaseType"
  options={[
    { value: "new", label: "New" },
    { value: "used", label: "Used" },
  ]}
  register={register}
  errors={errors}
  value={watch("purchaseType") || ""}
  onChange={(value) => {
    setValue("purchaseType", value, { shouldValidate: true });
    clearErrors("purchaseType");
  }}
/>

// For Builder (when constructedBy === "2")
{constructedBy === "2" && (
  <InputSelect
    label="Builder"
    name="builder"
    required
    options={[
      { value: "builder1", label: "Builder 1" },
      { value: "builder2", label: "Builder 2" },
    ]}
    register={register}
    errors={errors}
    value={watch("builder") || ""}
    onChange={(value) => {
      setValue("builder", value, { shouldValidate: true });
      clearErrors("builder");
    }}
  />
)}

// For Builder Authorization (when constructedBy === "2")
{constructedBy === "2" && (
  <InputSelect
    label="Builder Authorization"
    name="builderAuth"
    required
    options={[
      { value: "auth", label: "Authorized" },
      { value: "rejected", label: "Rejected" },
    ]}
    register={register}
    errors={errors}
    value={watch("builderAuth") || ""}
    onChange={(value) => {
      setValue("builderAuth", value, { shouldValidate: true });
      clearErrors("builderAuth");
    }}
  />
)}
