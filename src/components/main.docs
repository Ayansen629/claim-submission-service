:root {
  --primary-color: #2466BF;
  --primary-gradient: linear-gradient(90deg, rgb(36, 102, 191) 0%, rgb(70, 149, 255) 100%);
  --text-color: #545D69;
  --placeholder-color: #999;
  --disabled-bg: #f5f5f5;
  --dropdown-hover: #e6f0fa;
}

input,
textarea,
select {
  font-size: 14px !important;
}

label {
  font-size: 14px !important;
  color: var(--text-color) !important;
}

input::placeholder,
textarea::placeholder {
  font-size: 13px;
  color: var(--placeholder-color);
}

.form-control {
  font-size: 14px !important;
  padding: 10px !important;
}

.iwt-bg {
  background: var(--primary-gradient);
}

.center-screen {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}

.fade-icon {
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.custom-multi-select .custom-dropdown-toggle:hover {
  border-color: var(--primary-color);
}

.custom-multi-select .dropdown-menu {
  border-color: var(--primary-color);
  z-index: 1000;
}

.custom-multi-select .dropdown-item:hover {
  background-color: var(--dropdown-hover);
  color: var(--primary-color);
}

.custom-multi-select input[type="checkbox"]:checked {
  accent-color: var(--primary-color);
}

.input-icon svg {
  color: var(--primary-color);
}

.form-select:disabled {
  background-color: #e9ecef;
  cursor: not-allowed;
}

.form-select {
  padding: 10px;
}

.modal-header {
  background: var(--primary-color);
  border: 3px solid var(--primary-color);
  color: white;
  text-align: center;
}

.disabled {
  background-color: var(--disabled-bg) !important;
  cursor: not-allowed;
  opacity: 0.65;
  font-size: 14px;
  color: black;
  font-weight: 550;
}

