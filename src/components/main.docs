// Helper function to map equipment keys back to IDs dynamically
const getEquipmentIdFromKey = (equipmentKey) => {
  const equipmentKeyMap = {
    "Fire Fighting Items": "EquipmentFireFightingItems",
    "Equipments": "Equipments", 
    "Navigational Equipments": "EquipmentNavigationalEquipments",
    "Life-Saving Equipment": "EquipmentLifeSavingEquipment",
    "Machinery/Electrical": "EquipmentMachineryElectrical",
    "Accommodation/Safety": "EquipmentAccommodationSafety"
  };

  // Find the equipment name that matches the key
  const equipmentName = Object.keys(equipmentKeyMap).find(name => 
    equipmentKeyMap[name] === equipmentKey
  );

  if (equipmentName) {
    // Find the equipment ID from masterData
    const equipment = masterData?.equipmentCategories?.find(eq => 
      eq.equipmentName === equipmentName
    );
    return equipment?.id;
  }

  return null;
};
