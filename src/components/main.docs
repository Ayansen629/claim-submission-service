<Button
  size="sm"
  onClick={() => {
    if (isDeclarationEditable) {
      setIsDeclarationEditable(false);
    } else {
      handleGenerateDeclaration();
    }
  }}
  style={{
    backgroundColor: `${isDeclarationEditable ? "#28a745" : "#00A3E0"} !important`, 
    borderColor:`${isDeclarationEditable ? "#28a745" : "#00A3E0"} !important`,  
    color:"#ffffff !important",
  }}
>
  {isDeclarationEditable ? "Save Declaration" : "Generate Declaration"}
</Button>
