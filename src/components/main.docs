useEffect(() => {
  const ownerDetails = getFromLocalStorage("ownerDetails") 
    ? JSON.parse(getFromLocalStorage("ownerDetails")) 
    : null;

  if (ownerDetails) {
    setValue("basicDetails.ownerDetails.nameOfOwner", ownerDetails.ownerCompanyName || "");
    
  
    const address = [ownerDetails.addressLine1, ownerDetails.addressLine2]
      .filter(Boolean)
      .join(", ");
    setValue("basicDetails.ownerDetails.addressLine1", address);
    
    setValue("basicDetails.ownerDetails.phoneNumber", ownerDetails.phoneNumber || "");
  }
}, [setValue]);

const extractAllEnclosures = (formValues) => {
  const enclosures = [];
  
  // Single file documents 
  const singleFileTypes = [
    { field: "certificateOfRegistration", type: "REGISTRATION_CERTIFICATE", name: "Certificate of Registration" },
    { field: "NOCfromOriginalRegistrationAuthority", type: "NOC_FROM_ORIGINAL_REGISTRATION_AUTHORITY", name: "NOC from Original Registration Authority" },
    { field: "lastSurveyCertificate", type: "SURVEY_COPY_OF_LAST_CERTIFICATE_OF_SURVEY", name: "Last Survey Certificate" },
    { field: "tonnageBooklet", type: "TONNAGE_BOOKLETS", name: "Tonnage Booklet" },
    { field: "stabilityBooklet", type: "STABILITY_BOOKLETS", name: "Stability Booklet" },
    { field: "insuranceCertificate", type: "INSURANCE_CERTIFICATE", name: "Insurance Certificate" },
    { field: "paymentChallan", type: "PAYMENT_CHALLAN_OR_ACKNOWLEDGEMENT", name: "Payment Challan" }
  ];

  singleFileTypes.forEach(({ field, type, name }) => {
   
    const fileStoreId = formValues.enclosure?.[`${field}FileStoreId`];
    const fileName = formValues.enclosure?.[field]?.name || formValues.enclosure?.[`${field}OriginalName`];
    
    if (fileStoreId) {
      enclosures.push({
        id: "",
        documentName: fileName || `${name}.pdf`,
        documentType: type,
        fileStoreId,
        documentSource: "TRANSFER_OF_REGISTRY_ENCLOSURES",
        description: name,
        active: true
      });
    }
  });

  // Multi-file documents 
  const multiFileTypes = ["MAIN_AND_OTHER_DRAWINGS", "RADIOGRAPHY_REPORT", "MATERIAL_TEST_REPORT", "OTHER_INSPECTION_REPORTS", "OTHER_TECHNICAL_DOCUMENT"];
  
  multiFileTypes.forEach(type => {
    Object.keys(formValues)
      .filter(key => key.startsWith(`${type}_fileStoreId_`))
      .forEach(storeKey => {
        const index = storeKey.split("_").pop();
        const fileStoreId = formValues[storeKey];
        const fileObj = formValues[`${type}_file_${index}`];
        
        if (fileStoreId) {
          enclosures.push({
            id: "",
            documentName: fileObj?.name || `${type}_${index}.pdf`,
            documentType: type,
            fileStoreId,
            documentSource: "TRANSFER_OF_REGISTRY_ENCLOSURES",
            description: formValues[`${type}_desc_${index}`] || type,
            active: true
          });
        }
      });
  });

  return enclosures;
};
