const handleGenerateDeclaration = async () => {
  try {
    loaderRef.current?.show();
    
    const formValues = watch();
    const currentDate = new Date();
    
    const payload = {
      formType: "DECLARATIONOFOWNERSHIP",
      ownerName: formValues.ownerName || "",
      permanentAddress: formValues.address || "",
      businessAddress: formValues.originalPlaceOfBusiness || "",
      vesselName: formValues.vesselName || "",
      builtAt: formValues.placeOfBuild || "",
      builtYear: formValues.vesselyearOfBuild || "",
      purchaseDate: formValues.workOrderDate ? new Date(formValues.workOrderDate).toLocaleDateString('en-GB') : "",
      purchaseAmount: formValues.workOrderValue || "",
      portOfRegistration: formValues.nameOfRegistry || "",
      day: currentDate.getDate().toString(),
      month: currentDate.toLocaleString('default', { month: 'long' }),
      year: currentDate.getFullYear().toString().slice(-2),
      witnessName: "Mr. Witness Name"
    };

    const accessToken = getFromLocalStorage("access_token");
    const tokenDetails = JSON.parse(getFromLocalStorage("tokenDetails") || "{}");
    const sessionState = tokenDetails.session_state || "";

    if (!accessToken) {
      toast.error("Authentication token missing. Please login again.");
      return;
    }

    const apiUrl = SERVICE_BASE.IWT_PDFSERVICE + URLS_ENDPOINT.VESSEL_SERVICE.INVOICE_DOWNLOAD;

    const response = await fetch(apiUrl, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${accessToken}`,
        "X-Request-ID": sessionState,
      },
      body: JSON.stringify(payload),
    });

    if (!response.ok) {
      const errorMsg = await response.text();
      throw new Error(errorMsg || "Failed to generate declaration");
    }

    const blob = await response.blob();
    const url = window.URL.createObjectURL(blob);

    const link = document.createElement("a");
    link.href = url;
    link.download = `Declaration_of_Ownership_${formValues.vesselName || "vessel"}.pdf`;
    document.body.appendChild(link);
    link.click();
    link.remove();

    toast.success("Declaration PDF generated successfully!");
    window.URL.revokeObjectURL(url);

  } catch (error) {
    console.error("Declaration generation error:", error);
    toast.error(error.message || "Failed to generate declaration PDF");
  } finally {
    loaderRef.current?.hide();
  }
};
