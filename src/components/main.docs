import React from "react";
import { Card, Row, Col } from "react-bootstrap";
import { FaPhone, FaEnvelope, FaCheckSquare, FaSquare, FaMapMarkerAlt } from "react-icons/fa";
import "./BusinessCard.css";

// You would import your actual image, using a placeholder for demonstration
// import headerImage from "../assets/header-image.jpg";

const BusinessCard = () => {
  return (
    <div className="business-card-container">
      <Card className="business-card">
        {/* Header Image */}
        <div className="card-header-image">
          <img 
            src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80" 
            alt="Company Header"
            className="header-img"
          />
          <div className="header-overlay">
            <h2>ABC Pvt Ltd</h2>
            <p>Transport & Logistics Solutions</p>
          </div>
        </div>
        
        <Card.Body>
          {/* Contact Information */}
          <Row className="contact-info">
            <Col xs={12}>
              <p><FaPhone className="icon" /> +91 7044606052</p>
              <p><FaEnvelope className="icon" /> abc@gmail.com</p>
              <p><FaMapMarkerAlt className="icon" /> Kolkata, West Bengal</p>
            </Col>
          </Row>
          
          {/* Document Numbers */}
          <Row className="document-numbers">
            <Col xs={12}>
              <p><strong>PAN Number:</strong> 23PK*******</p>
              <p><strong>Aachar Number:</strong> 2345 5367 g****</p>
              <p><strong>Trade License No:</strong> WB/KMC/TL/2025/******</p>
            </Col>
          </Row>
          
          <hr className="divider" />
          
          {/* Vessel Details */}
          <div className="vessel-details">
            <h5>Vessel Details</h5>
            <div className="checkbox-item">
              {false ? <FaCheckSquare className="checked" /> : <FaSquare className="unchecked" />}
              <span>Name Change</span>
            </div>
            <div className="checkbox-item">
              {true ? <FaCheckSquare className="checked" /> : <FaSquare className="unchecked" />}
              <span>Address Change</span>
            </div>
          </div>
          
          {/* Proceed Button */}
          <div className="text-center mt-4">
            <button className="proceed-btn">
              Proceed Now
            </button>
          </div>
        </Card.Body>
      </Card>
    </div>
  );
};

export default BusinessCard;
