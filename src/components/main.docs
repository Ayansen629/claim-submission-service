/* Dropdown toggle button */
.dropdownToggle {
  background: transparent;
  border: none;
  color: #6c757d;
  padding: 6px 8px;
  border-radius: 6px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.dropdownToggle:hover {
  background-color: rgba(13, 110, 253, 0.08);
  color: #0d6efd;
  transform: translateY(-1px);
}

.dropdownToggle:focus {
  box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
  outline: none;
}

.dotsContainer {
  display: flex;
  flex-direction: column;
  gap: 3px;
  align-items: center;
  justify-content: center;
}

.dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background-color: #6c757d;
  transition: all 0.3s ease;
}

.dropdownToggle:hover .dot {
  background-color: #0d6efd;
  transform: scale(1.2);
}

/* Dropdown menu */
.dropdownMenu {
  border: none;
  border-radius: 10px;
  padding: 6px;
  min-width: 220px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12), 0 4px 12px rgba(0, 0, 0, 0.08);
  animation: slideIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  background: #fff;
  transform-origin: top right;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(6px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.dropdownHeader {
  padding: 10px 12px 6px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #6c757d;
  text-align: center;
  border-bottom: 1px solid #f1f3f5;
  margin-bottom: 4px;
}

.menuItems {
  padding: 2px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Dropdown items */
.dropdownItem {
  padding: 0;
  border-radius: 8px;
  margin: 2px 0;
  transition: all 0.2s ease;
  border: none;
  width: 100%;
  display: flex;
  justify-content: center;
}

.dropdownItem:hover {
  background: linear-gradient(135deg, #0d6efd, #0a58ca);
  transform: translateX(2px);
}

.itemContent {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  font-size: 13px;
  color: #212529;
  transition: all 0.2s ease;
  width: 100%;
  justify-content: flex-start;
}

.dropdownItem:hover .itemContent {
  color: white;
}

.iconWrapper {
  width: 26px;
  height: 26px;
  border-radius: 6px;
  background-color: rgba(13, 110, 253, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.dropdownItem:hover .iconWrapper {
  background-color: rgba(255, 255, 255, 0.2);
  transform: scale(1.05);
}

.iconWrapper svg {
  color: #0d6efd;
  transition: all 0.3s ease;
  width: 14px;
  height: 14px;
}

.dropdownItem:hover .iconWrapper svg {
  color: white;
}

/* Special styling for delete item */
.deleteItem:hover {
  background: linear-gradient(135deg, #dc3545, #bd2130);
}

.deleteItem .iconWrapper {
  background-color: rgba(220, 53, 69, 0.1);
}

.deleteItem .iconWrapper svg {
  color: #dc3545;
}

/* Focus states for accessibility */
.dropdownItem:focus {
  outline: none;
}

.dropdownItem:focus .itemContent {
  background-color: rgba(13, 110, 253, 0.1);
  border-radius: 8px;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .dropdownMenu {
    min-width: 200px;
  }
  
  .itemContent {
    padding: 8px 10px;
    font-size: 12px;
  }
  
  .iconWrapper {
    width: 24px;
    height: 24px;
    margin-right: 8px;
  }
}
