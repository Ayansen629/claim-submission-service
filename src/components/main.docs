// Add this useEffect in VesselDetails.js after existing useEffects
useEffect(() => {
  // Trigger validation in Documents component when GRT changes
  const grtValue = watch("grt");
  if (grtValue && grtValue.trim() !== "") {
    setTimeout(() => {
      trigger(["tonnageBooklets", "stabilityBooklets"]);
    }, 100);
  }
}, [watch("grt"), trigger]);
