import React, { useContext } from "react";
import { UserContext } from "../../../context/UserContext.js";
import FormCDetails from "../form-component/FormCDetails.js";
import FormBDetails from "../form-component/FormBDetails.js";
import FormCADetails from "../form-component/FormCADetails.js";
import FormDDetails from "../form-component/FormDDetails.js";
import FormEDetails from "../form-component/FormEDetails.js";
import FormFDetails from "../form-component/FormFDetails.js";
import FormGDetails from "../form-component/FormGDetails.js";

const RenderFormComponent = ({ provideSubmitHandler, formData }) => {
  const { userData, formType } = useContext(UserContext); 
  console.log("Form Type:", formType); 
  console.log("User Data:", userData); 

  // If userType is CRP, always render FormCDetails
  if (userData?.userType === "CRP") {
    return <FormCDetails provideSubmitHandler={provideSubmitHandler} formData={formData} />;
  }

  // Render based on formType from context
  switch(formType) {
    case "Form C":
      return <FormCDetails provideSubmitHandler={provideSubmitHandler} formData={formData} />;
    case "Form CA":
      return <FormCADetails provideSubmitHandler={provideSubmitHandler} formData={formData} />;
    case "Form B":
      return <FormBDetails provideSubmitHandler={provideSubmitHandler} formData={formData} />;
    case "Form D":
      return <FormDDetails provideSubmitHandler={provideSubmitHandler} formData={formData} />;
    case "Form E":
      return <FormEDetails provideSubmitHandler={provideSubmitHandler} formData={formData} />;
    case "Form F":
      return <FormFDetails provideSubmitHandler={provideSubmitHandler} formData={formData} />;
    case "Form G":
      return <FormGDetails provideSubmitHandler={provideSubmitHandler} formData={formData} />;
    default:
      return <div>No form found for form type: {formType}. Please contact support.</div>;
  }
};

export default RenderFormComponent;
