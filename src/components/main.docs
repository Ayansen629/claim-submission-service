else if (stepIndex === 1) {
  // Step 2: Update with step 1 IDs and equipment data
  const storedEnclosures = sessionStorage.getItem('step1Enclosures');
  const step1Enclosures = storedEnclosures ? JSON.parse(storedEnclosures) : [];
  
  // Extract current form enclosures if any new files were uploaded
  const currentEnclosures = extractAllEnclosures(formValues);
  
  // Merge stored enclosures with any new ones, prioritize current if available
  const finalEnclosures = currentEnclosures.length > 0 ? currentEnclosures : step1Enclosures;
  
  payload = {
    registrationRequest: {
      id: registrationData?.RegistrationResponse?.id || "",
      applicationNumber: registrationData?.RegistrationResponse?.applicationNumber || "",
      applicationType: "TRANSFER_OF_REGISTRY",
      basicDetails: {
        ...registrationData?.RegistrationResponse?.basicDetails,
        id: registrationData?.RegistrationResponse?.basicDetails?.id || ""
      },
      vesselDetails: {
        ...registrationData?.RegistrationResponse?.vesselDetails,
        id: registrationData?.RegistrationResponse?.vesselDetails?.id || ""
      },
      engineDetails: {
        ...registrationData?.RegistrationResponse?.engineDetails,
        id: registrationData?.RegistrationResponse?.engineDetails?.id || ""
      }
    },
    initialSurveyRequest: {
      ...initialRegistryData,
      surveyId: initialRegistryData?.surveyId || "",
      BasicVesselInformation: {
        ...initialRegistryData?.BasicVesselInformation,
        id: initialRegistryData?.BasicVesselInformation?.id || ""
      },
      HullParticulars: {
        ...initialRegistryData?.HullParticulars,
        id: initialRegistryData?.HullParticulars?.id || ""
      },
      RadioandNavigationEquipment: {
        ...initialRegistryData?.RadioandNavigationEquipment,
        id: initialRegistryData?.RadioandNavigationEquipment?.id || ""
      },
      PollutionControlDevices: {
        ...initialRegistryData?.PollutionControlDevices,
        id: initialRegistryData?.PollutionControlDevices?.id || ""
      },
      DetailsofPropulsionofEngine: {
        ...initialRegistryData?.DetailsofPropulsionofEngine,
        id: initialRegistryData?.DetailsofPropulsionofEngine?.id || ""
      },
      CrewDetails: (initialRegistryData?.CrewDetails || []).map(crew => ({
        ...crew,
        id: crew?.id || ""
      })),
      SurveyEquipments: buildEquipmentPayload(formValues, initialRegistryData)?.SurveyEquipments || initialRegistryData?.SurveyEquipments,
      passengerDistributionMaxLoad: buildEquipmentPayload(formValues, initialRegistryData)?.passengerDistributionMaxLoad || initialRegistryData?.passengerDistributionMaxLoad,
      vesselFreeboardData: buildEquipmentPayload(formValues, initialRegistryData)?.vesselFreeboardData || initialRegistryData?.vesselFreeboardData
    },
    enclosers: finalEnclosures
  };
}
