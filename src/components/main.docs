.analytics-card {
  width: 100%;
  height: 10rem;
  border-radius: 1rem;
  padding: 1rem;
  box-shadow: -3px 3px 6px rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: #f5f5f5;
  color: #ffffff;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  cursor: pointer;
}

.analytics-card:hover {
  transform: scale(1.05);
  box-shadow: -6px 6px 15px rgba(0, 0, 0, 0.25);
}

.analytics-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.analytics-card-title {
  font-size: 1rem;
  font-weight: 600;
  margin: 0;
  flex: 1;
  line-height: 1.2;
}

.analytics-card-icon img,
.analytics-card-icon svg {
  width: 32px;
  height: 32px;
  object-fit: contain;
}

.analytics-card-value {
  font-size: 2rem;
  font-weight: 700;
  margin: 0.5rem 0 0.5rem;
  text-align: center;
  flex-grow: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.analytics-card-subtitle {
  font-size: 0.8rem;
  opacity: 0.9;
  line-height: 1.2;
}
