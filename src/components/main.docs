const FileUploadCard = ({ label, name, onRemove, showRemove = false }) => (
  <Card className="mb-3 border-2 border-dashed border-primary border-opacity-25">
    <Card.Body className="p-2 p-sm-3">
      <div className="mb-2 mb-sm-3">
        <InputFile
          label={label}
          name={name}
          register={register(name)}
          errors={errors}
          onChange={(e) => {
            if (e.target.files && e?.target?.files[0]) {
              const file = e.target.files[0];
              
              if (file.size > 10 * 1024 * 1024) {
                setError(name, {
                  type: 'manual',
                  message: t('File size should not exceed 10MB')
                });
                return;
              }
              
              const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
              const fileName = `${label}${extension}`;
              file.originalName = fileName;
              const renamedFile = renameFile(file, fileName);

              clearErrors(name);
              setValue(name, renamedFile, { shouldValidate: true });
              setFormData((prev) => ({
                ...prev,
                [name]: renamedFile
              }));
            }
          }}
          watch={watch}
          defaultValue={watch(name)}
          clearErrors={clearErrors}
          accept=".pdf,.jpg,.jpeg,.png"
        />
      </div>
      <div className="mb-2 mb-sm-3">
        <InputText
          label={t("Description")}
          name={name.replace('_file_', '_desc_')}
          placeholder={t("Enter file description")}
          register={register(name.replace('_file_', '_desc_'))}
          errors={errors}
        />
      </div>
      {showRemove && (
        <div className="text-end">
          <Button
            variant="outline-danger"
            size="sm"
            onClick={onRemove}
            className="rounded-pill"
          >
            <BsTrash className="me-1" size={12} />
            <span className="d-none d-sm-inline">Remove</span>
          </Button>
        </div>
      )}
    </Card.Body>
  </Card>
);

const DocumentCard = ({ fileName, description, onDownload, fileSize, onRemove, showRemove = false }) => (
  <Card className="mb-2 border-0 shadow-sm">
    <Card.Body className="p-2 p-sm-3">
      <div className="d-flex justify-content-between align-items-start">
        <div className="d-flex align-items-start flex-grow-1 me-2">
          <div className="bg-danger bg-opacity-10 rounded-circle p-1 me-2 flex-shrink-0">
            <BsFileEarmarkPdf className="text-danger" size={14} />
          </div>
          <div className="flex-grow-1 min-width-0">
            <h6 className="mb-1 text-primary fw-semibold" style={{ 
              fontSize: "0.85rem",
              overflow: 'hidden',
              textOverflow: 'ellipsis',
              whiteSpace: 'nowrap'
            }}>
              {fileName}
            </h6>
            <p className="mb-0 text-muted" style={{ 
              fontSize: '0.75rem',
              overflow: 'hidden',
              textOverflow: 'ellipsis',
              whiteSpace: 'nowrap'
            }}>
              {description}
            </p>
            {fileSize && (
              <span className="badge bg-light text-dark mt-1" style={{ fontSize: '0.65rem' }}>
                {(fileSize / 1024 / 1024).toFixed(1)} MB
              </span>
            )}
          </div>
        </div>
        <div className="d-flex gap-1 flex-shrink-0">
          <Button
            variant="outline-primary"
            size="sm"
            onClick={() => onDownload(fileName)}
            className="rounded-pill p-1 d-flex align-items-center"
            style={{ minWidth: 'auto' }}
          >
            <BsDownload size={12} />
            <span className="ms-1 d-none d-sm-inline" style={{ fontSize: '0.7rem' }}>
              {t("Download")}
            </span>
          </Button>
          {showRemove && (
            <Button
              variant="outline-danger"
              size="sm"
              onClick={onRemove}
              className="rounded-pill p-1"
              style={{ minWidth: 'auto' }}
            >
              <BsTrash size={12} />
            </Button>
          )}
        </div>
      </div>
    </Card.Body>
  </Card>
);
