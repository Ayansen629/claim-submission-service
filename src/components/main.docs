import React from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import { FaCheckCircle, FaDownload } from 'react-icons/fa';
import { Button } from 'react-bootstrap';
import { PDFDownloadLink } from '@react-pdf/renderer';
import { Document, Page, Text, View, StyleSheet } from '@react-pdf/renderer';
import './SubmissionSuccess.css'; // You can create this CSS file for styling

// Create styles
const styles = StyleSheet.create({
  page: {
    padding: 30,
  },
  header: {
    fontSize: 24,
    marginBottom: 10,
    textAlign: 'center',
    fontWeight: 'bold',
  },
  subHeader: {
    fontSize: 16,
    marginBottom: 5,
    textAlign: 'center',
    fontWeight: '600',
  },
  subject: {
    fontSize: 14,
    marginTop: 5,
    marginBottom: 5,
    fontWeight: '600',
  },
  subSectionHeading: {
    fontSize: 12,
    marginBottom: 20,
    textAlign: 'center',
    fontWeight: '400',
  },
  sectionHeader: {
    fontSize: 18,
    marginTop: 15,
    marginBottom: 10,
    fontWeight: 'bold',
    borderBottom: '1 solid #000',
  },
  text: {
    fontSize: 12,
    marginBottom: 5,
  },
  section: {
    marginTop: 10,
  },
  table: {
    display: "table",
    width: "100%",
    marginTop: 10,
  },
  tableRow: {
    flexDirection: "row",
  },
  tableCell: {
    flex: 1,
    padding: 5,
    fontSize: 10,
  },
  tableHeader: {
    fontWeight: "bold",
    backgroundColor: "#f0f0f0",
  },
  rowBetween: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
  }
});

const ClaimFormPdf = ({ applicationData }) => {
  // Extract data from applicationData or use defaults
    const creditorName = applicationData?.step1?.creditorDetails?.["Financial Creditor Name"] || "ABC Creditors Ltd.";
    const identificationNumber = applicationData?.step1?.creditorDetails?.["Identification Number"] || "PAN123";
    const address = applicationData?.step1?.creditorDetails?.["Address"] || "123 Main St, Anytown, Anystate 12345";
    const claimAmount = applicationData?.step2?.claimDetails?.["Claim Amount"] || "100000";
    const securityAmount = applicationData?.step2?.claimDetails?.["Security Value"] || "50000";
    const guaranteeAmount = applicationData?.step2?.claimDetails?.["Guarantee Value"] || "0";
    const principalBorrower = applicationData?.step2?.claimDetails?.["Principal Borrower Name"] || "XYZ Corp";
    const debtDetails = applicationData?.step2?.claimDetails?.["Debt Details"] || "Loan Agreement #LA-2023-001";
    const signatoryName = applicationData?.step3?.signatoryDetails?.["Creditor Name"] || "John Doe";
    const signatoryPosition = applicationData?.step3?.signatoryDetails?.["Creditor Position"] || "CFO";
    const signatoryAddress = applicationData?.step3?.signatoryDetails?.["Creditor Address"] || "10 Downing St";

  return (
    <Document>
      <Page style={styles.page}>
        <View style={styles.section}>
          <Text style={styles.header}>FORM C</Text>
          <Text style={styles.subHeader}>SUBMISSION OF CLAIM BY FINANCIAL CREDITORS</Text>
          <Text style={styles.subSectionHeading}>(Under Regulation 8 of the Insolvency and Bankruptcy Board of India (Insolvency Resolution Process for Corporate Persons) Regulations, 2016)</Text>

          <View style={[styles.rowBetween, { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }]}>
            <Text style={styles.text}>From</Text>
            <Text style={styles.text}>{new Date().toLocaleDateString()}</Text>
          </View>
          <Text style={styles.text}>{creditorName}</Text>
          <Text style={styles.text}>{address}</Text>
          <Text style={styles.text}>To</Text>
          <Text style={styles.text}>The Interim Resolution Professional / Resolution Professional</Text>
          <Text style={styles.text}>[Name of the Insolvency Resolution Professional / Resolution Professional]</Text>
          <Text style={styles.text}>[Address as set out in public announcement]</Text>
          <Text style={styles.subject}>Subject: Submission of claim and proof of claim.</Text>
          <Text style={styles.text}>
            {creditorName}, hereby submits this claim in respect of the corporate{"\n"}
            insolvency resolution process of [name of corporate debtor]. The details for the same{"\n"}
            are setout below:
          </Text>

          <View style={styles.table}>
            {/* Table Header */}
            <View style={styles.tableRow}>
              <Text style={[styles.tableCell, styles.tableHeader]}>Name of the financial creditor</Text>
              <Text style={[styles.tableCell, styles.tableHeader]}>Identification number of the financial creditor</Text>
              <Text style={[styles.tableCell, styles.tableHeader]}>Address and email address of the financial creditor for correspondence</Text>
            </View>

            {/* Table Rows */}
            <View style={styles.tableRow}>
              <Text style={styles.tableCell}>{creditorName}</Text>
              <Text style={styles.tableCell}>{identificationNumber}</Text>
              <Text style={styles.tableCell}>{address}</Text>
            </View>
          </View>

          {/* Amount of Claim */}
          <View style={styles.table}>
            <View style={styles.tableRow}>
              <Text style={[styles.tableCell, styles.tableHeader]}>Amount of claim </Text>
              <Text style={[styles.tableCell, styles.tableHeader]}>Amount of claim covered by security interest, if any</Text>
              <Text style={[styles.tableCell, styles.tableHeader]}>Amount of claim covered by guarantee, if any</Text>
            </View>
            <View style={styles.tableRow}>
              <Text style={styles.tableCell}>{claimAmount}</Text>
              <Text style={styles.tableCell}>{securityAmount}</Text>
              <Text style={styles.tableCell}>{guaranteeAmount}</Text>
            </View>
          </View>

          {/* Additional Details */}
          <View style={styles.table}>
            <View style={styles.tableRow}>
              <Text style={[styles.tableCell, styles.tableHeader]}>Name and address of the principal borrower</Text>
              <Text style={[styles.tableCell, styles.tableHeader]}>Details of how and when debt incurred</Text>
            </View>
            <View style={styles.tableRow}>
              <Text style={styles.tableCell}>{principalBorrower}</Text>
              <Text style={styles.tableCell}>{debtDetails}</Text>
            </View>
          </View>

          {/* Signatory Section */}
          <View style={styles.table}>
            <View style={styles.tableRow}>
              <Text style={[styles.tableCell, styles.tableHeader]}>Signature of financial creditor or person authorised to act on its behalf</Text>
            </View>
            <View style={styles.tableRow}>
              <Text style={styles.tableCell}>[Signature]</Text>
            </View>

            <View style={styles.tableRow}>
              <Text style={[styles.tableCell, styles.tableHeader]}>Name in BLOCK LETTERS</Text>
            </View>
            <View style={styles.tableRow}>
              <Text style={styles.tableCell}>{signatoryName}</Text>
            </View>

            <View style={styles.tableRow}>
              <Text style={[styles.tableCell, styles.tableHeader]}>Position with or in relation to creditor</Text>
            </View>
            <View style={styles.tableRow}>
              <Text style={styles.tableCell}>{signatoryPosition}</Text>
            </View>

            <View style={styles.tableRow}>
              <Text style={[styles.tableCell, styles.tableHeader]}>Address of person signing</Text>
            </View>
            <View style={styles.tableRow}>
              <Text style={styles.tableCell}>{signatoryAddress}</Text>
            </View>
          </View>

          <Text style={styles.subHeader}>DECLARATION</Text>
           <Text style={styles.text}>
            I, {signatoryName}, currently residing at {signatoryAddress}, do hereby declare and state as follows: -
          </Text>
          <Text style={styles.text}>1. [Name of corporate debtor], the corporate debtor was, at the insolvency commencement date, being the……………..day of…………..20……., actually indebted to me for a sum of Rs. {claimAmount}.</Text>
          <Text style={styles.text}>2. In respect of my claim of the said sum or any part thereof, I have relied on the documents specified below: [Please list the documents relied on as evidence of claim].</Text>
          <Text style={styles.text}>3. The said documents are true, valid and genuine to the best of my knowledge, information and belief and no material facts have been concealed therefrom.</Text>
          <Text style={styles.text}>4. In respect of the said sum or any part thereof, neither I, nor any person, by my order, to my knowledge or belief, for my use, had or received any manner of satisfaction or security whatsoever, save and except the following:
            [Please state details of any mutual credit, mutual debts, or other mutual dealings between the corporate debtor and the creditor which may be set-off against the claim].
          </Text>
          <Text style={styles.text}>5. I undertake to update my claim as and when the claim is satisfied, partly or fully, from any source in any manner, after the insolvency commencement date.</Text>
          <Text style={styles.text}>6. I am / I am not a related party of the corporate debtor, as defined under section 5 (24) of the Code.</Text>
          <Text style={styles.text}>7. I am eligible to join committee of creditors by virtue of proviso to section 21 (2) of the Code even though I am a related party of the corporate debtor.</Text>

          <View style={[styles.rowBetween, { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }]}>
            <Text style={styles.text}>Place:</Text>
            <Text style={styles.text}>Signature of the claimant</Text>
          </View>
          <Text style={styles.subHeader}>VERIFICATION</Text>
          <Text style={styles.text}>I, {signatoryName} the claimant hereinabove, do hereby verify that the contents of this proof of claim are true and correct to my knowledge and belief and no material fact has been concealed therefrom.</Text>
          <Text style={styles.text}>Verified at … on this …… day of ………., 20….</Text>
          <View style={[styles.rowBetween, { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }]}>
            <Text style={styles.text}></Text>
            <Text style={styles.text}>Signature of the claimant</Text>
          </View>
          <Text style={styles.text}>[Note: In the case of company or limited liability partnership, the declaration and verification shall be made by the director/manager/secretary/designated partner and in the case of other entities, an officer authorised for the purpose by the entity.]</Text>
        </View>
      </Page>
    </Document>
  );
};

const SubmissionSuccess = () => {
  const location = useLocation();
  const navigate = useNavigate();
  const { applicationNumber } = location.state || { applicationNumber: 'APP-2025-0001' }; // Use the static application number

    const staticClaimData = {
    step1: {
      creditorDetails: {
        "Financial Creditor Name": "ABC Creditors Ltd.",
        "Financial Creditor Email": "abc@example.com",
        "Address": "123 Main St, Anytown",
        "City": "Anytown",
        "State": "Anystate",
        "Pincode": "12345"
      },
      identificationDetails: {
        "Identification Type": "PAN",
        "Identification Details": [
          { id: "PAN123", details: "PAN Card Number: ABCDE1234F", proof: "pan_card.pdf" }
        ]
      }
    },
    step2: {
      claimDetails: {
        "Claim Type": "Financial Debt",
        "Has Security Interest": "Yes",
        "Has Guarantee": "No",
        "Claim Amount": 100000,
        "Principal Borrower Name": "XYZ Corp",
        "Principal Borrower Address": "456 Business Park, Anytown",
        "Debt Details": "Loan Agreement #LA-2023-001",
        "Debt Date": "2023-01-15",
        "Mutual Details": "N/A",
        "Security Value": 50000,
        "Security Date": "2022-12-01",
        "Guarantee Value": 0,
        "Guarantee Date": null
      },
      bankDetails: {
        "Account Number": "1234567890",
        "IFSC Code": "ABCD0123456",
        "Bank Name": "Any Bank",
        "Branch Name": "Main Branch",
        "Branch Address": "789 Bank St, Anytown",
        "City": "Anytown",
        "State": "Anystate",
        "District": "Anydistrict"
      }
    },
    step3: {
      signatoryDetails: {
        "Creditor Name": "John Doe",
        "Creditor Position": "CFO",
        "Creditor Signature": "John Doe",
        "Has Signature": "Yes",
        "Creditor Address": "10 Downing St",
        "Signature File": "signature.jpg"
      }
    },
    step4: {
      documentDetails: {
        "Identity Proof Type": "PAN",
        "Address Proof Type": "Utility Bill",
        "Identity Proof File": "pan_card.pdf",
        "Address Proof File": "utility_bill.pdf"
      }
    }
  };

  const handleReturnToDashboard = () => {
    navigate('/dashboard');
  };

  return (
    <div className="submission-success-container">
      <div className="success-card">
        <FaCheckCircle className="success-icon" size={80} color="#28a745" />
        <h2>Claim Form Submitted Successfully!</h2>

        <div className="application-details">
          <p>Your application has been submitted with the following details:</p>
          <p><strong>Application Number:</strong> {applicationNumber || 'N/A'}</p>
          <p><strong>Date Submitted:</strong> {new Date().toLocaleDateString()}</p>
        </div>

        <div className="success-actions">
          <PDFDownloadLink
            document={<ClaimFormPdf applicationData={staticClaimData} />}  // Pass the static data
            fileName={`claim_form_${applicationNumber}.pdf`}
          >
            {({ blob, url, loading, error }) => (
              <Button
                variant="success"
                className="download-button"
                disabled={loading} // Disable button while loading
              >
                {loading ? (
                  <>Loading...</> // Show loading state
                ) : (
                  <>
                    <FaDownload className="mr-2" />
                    Download Application PDF
                  </>
                )}
              </Button>
            )}
          </PDFDownloadLink>

          <Button
            variant="outline-primary"
            onClick={handleReturnToDashboard}
            className="dashboard-button"
          >
            Return to Dashboard
          </Button>
        </div>

        <div className="success-message">
          <p>Thank you for submitting your claim form. You will receive a confirmation email shortly.</p>
          <p>You can track the status of your application in the dashboard.</p>
        </div>
      </div>
    </div>
  );
};

export default SubmissionSuccess;
