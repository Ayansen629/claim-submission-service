<Dropdown align="end">
  <OverlayTrigger
    placement="top"
    overlay={
      <BSTooltip id={`tooltip-${row?.id}`}>
        More Actions
      </BSTooltip>
    }
  >
    <Dropdown.Toggle
      variant="link"
      id={`dropdown-${row?.id}`}
      className="action-toggle p-2 rounded-circle"
      style={{
        border: "1px solid #e0e6ed",
        backgroundColor: "#ffffff",
        color: "#6c757d",
        transition: "all 0.2s ease",
        boxShadow: "0 2px 4px rgba(0,0,0,0.08)",
      }}
      onMouseEnter={(e) => {
        e.currentTarget.style.backgroundColor = "#f8f9fa";
        e.currentTarget.style.borderColor = "#2E57A7";
        e.currentTarget.style.color = "#2E57A7";
        e.currentTarget.style.transform = "scale(1.05)";
      }}
      onMouseLeave={(e) => {
        e.currentTarget.style.backgroundColor = "#ffffff";
        e.currentTarget.style.borderColor = "#e0e6ed";
        e.currentTarget.style.color = "#6c757d";
        e.currentTarget.style.transform = "scale(1)";
      }}
    >
      <ThreeDots size={18} />
    </Dropdown.Toggle>
  </OverlayTrigger>

  <Dropdown.Menu 
    className="shadow-lg border-0 animated-dropdown"
    style={{
      borderRadius: "12px",
      padding: "8px 0",
      minWidth: "220px",
      backgroundColor: "#ffffff",
      backdropFilter: "blur(10px)",
      border: "1px solid rgba(0,0,0,0.08)",
      boxShadow: "0 10px 40px rgba(0,0,0,0.15), 0 4px 12px rgba(0,0,0,0.1)",
      animation: "dropdownFadeIn 0.2s ease-out",
    }}
  >
    {/* Edit Action */}
    {(o.actions.includes("edit") || row?.isEditable) && (
      <Dropdown.Item
        onClick={() => handleEdit(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #667eea 0%, #764ba2 100%)";
          e.currentTarget.style.color = "#fff";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <PencilSquare size={16} className="me-3" style={{ minWidth: "16px" }} />
        <span>Edit</span>
      </Dropdown.Item>
    )}

    {/* View Action */}
    {o.actions.includes("view") && (
      <Dropdown.Item
        onClick={() => handleView(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)";
          e.currentTarget.style.color = "#fff";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <FaEye size={16} className="me-3" style={{ minWidth: "16px" }} />
        <span>View</span>
      </Dropdown.Item>
    )}

    {/* Delete Action */}
    {o.actions.includes("delete") && (
      <>
        <Dropdown.Divider style={{ margin: "8px 0", borderColor: "#f1f3f4" }} />
        <Dropdown.Item
          onClick={() => handleDeleteRow(row)}
          className="d-flex align-items-center px-3 py-2 border-0"
          style={{
            transition: "all 0.2s ease",
            borderRadius: "8px",
            margin: "2px 8px",
            fontSize: "14px",
            fontWeight: "500",
          }}
          onMouseEnter={(e) => {
            e.currentTarget.style.background = "linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%)";
            e.currentTarget.style.color = "#fff";
            e.currentTarget.style.transform = "translateX(4px)";
          }}
          onMouseLeave={(e) => {
            e.currentTarget.style.background = "transparent";
            e.currentTarget.style.color = "#dc3545";
            e.currentTarget.style.transform = "translateX(0)";
          }}
        >
          <FaTrash size={16} className="me-3" style={{ minWidth: "16px" }} />
          <span>Delete</span>
        </Dropdown.Item>
      </>
    )}

    {/* Download Action */}
    {o.actions.includes("download") && (
      <Dropdown.Item
        onClick={() => handleDownload(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <FaDownload size={16} className="me-3" style={{ minWidth: "16px" }} />
        <span>Download</span>
      </Dropdown.Item>
    )}

    {/* Upload Reports */}
    {(o.actions.includes("uploadReports") || row?.isEnableUploadReports) && (
      <Dropdown.Item
        onClick={() => handleUploadReports(row)}
        className="d-flex align-items-center px-3 py-2 border-0"
        style={{
          transition: "all 0.2s ease",
          borderRadius: "8px",
          margin: "2px 8px",
          fontSize: "14px",
          fontWeight: "500",
        }}
        onMouseEnter={(e) => {
          e.currentTarget.style.background = "linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%)";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(4px)";
        }}
        onMouseLeave={(e) => {
          e.currentTarget.style.background = "transparent";
          e.currentTarget.style.color = "#495057";
          e.currentTarget.style.transform = "translateX(0)";
        }}
      >
        <Upload size={16} className="me-3" style={{ minWidth: "16px" }} />
        <span>Upload Reports</span>
      </Dropdown.Item>
    )}

    {/* Add other actions with similar styling... */}
  </Dropdown.Menu>
</Dropdown>
