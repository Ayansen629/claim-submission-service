import React from "react";
import { Card, Badge } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { BsCheckCircleFill, BsClock, BsXCircleFill, BsCreditCard } from "react-icons/bs";
import ActionTable from "../../../common/ActionTable.tsx";

const PaymentDetailsView = ({ supervisionAuthority, formData }) => {
  const { t } = useTranslation();

  // Payment table data
  const paymentTableData = [
    {
      id: 1,
      paymentId: "PAY-2024-001",
      status: "paid",
      paymentDate: "2024-01-16",
      receipt: "receipt_001.pdf"
    },
    {
      id: 2,
      paymentId: "PAY-2024-002", 
      status: "pending",
      paymentDate: "2024-01-20",
      receipt: "receipt_002.pdf"
    },
    {
      id: 3,
      paymentId: "PAY-2024-003", 
      status: "failed",
      paymentDate: "2024-01-18",
      receipt: "receipt_003.pdf"
    }
  ];

  // Payment table columns
  const paymentColumns = [
    {
      colName: t("Payment ID"),
      fieldName: "paymentId",
      clsName: "column-text-start",
    },
    {
      colName: t("Status"),
      fieldName: "status",
      clsName: "column-text-center",
    },
    {
      colName: t("Payment Date"),
      fieldName: "paymentDate",
      clsName: "column-text-center",
    },
    {
      colName: t("Receipt"),
      fieldName: "receipt",
      clsName: "column-text-center",
    }
  ];

  const handleDownloadReceipt = (rowData) => {
    console.log("Download receipt for row:", rowData.receipt);
    
    // Create download link
    const link = document.createElement('a');
    link.href = '#'; // Replace with actual file URL
    link.download = rowData.receipt;
    link.click();
    
    // You can also show a toast notification
    // toast.success(`Downloading ${rowData.receipt}`);
  };

  const getStatusBadge = (status) => {
    switch (status) {
      case 'paid':
        return (
          <Badge 
            className="d-flex align-items-center gap-1 px-2 py-1 rounded-pill"
            style={{ 
              background: "linear-gradient(135deg, #28a745 0%, #20c997 100%)",
              border: "none",
              fontSize: "0.75rem",
              fontWeight: "500"
            }}
          >
            <BsCheckCircleFill size={10} /> {t("Paid")}
          </Badge>
        );
      case 'pending':
        return (
          <Badge 
            className="d-flex align-items-center gap-1 px-2 py-1 rounded-pill"
            style={{ 
              background: "linear-gradient(135deg, #ffc107 0%, #fd7e14 100%)",
              border: "none",
              fontSize: "0.75rem",
              fontWeight: "500",
              color: "white"
            }}
          >
            <BsClock size={10} /> {t("Pending")}
          </Badge>
        );
      case 'failed':
        return (
          <Badge 
            className="d-flex align-items-center gap-1 px-2 py-1 rounded-pill"
            style={{ 
              background: "linear-gradient(135deg, #dc3545 0%, #e83e8c 100%)",
              border: "none",
              fontSize: "0.75rem",
              fontWeight: "500"
            }}
          >
            <BsXCircleFill size={10} /> {t("Failed")}
          </Badge>
        );
      default:
        return <Badge bg="secondary" className="px-2 py-1" style={{ fontSize: "0.75rem" }}>{t("Unknown")}</Badge>;
    }
  };

  return (
    <div className="container py-3">
      <Card className="shadow-sm border-0" style={{ borderRadius: "12px", overflow: "hidden" }}>
        <Card.Header 
          className="text-white py-2 d-flex align-items-center"
          style={{ 
            background: "linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%)",
            borderBottom: "none"
          }}
        >
          <BsCreditCard size={18} className="me-2" />
          <div>
            <h6 className="mb-0 fw-semibold text-white">{t("Payment Details")}</h6>
          </div>
        </Card.Header>
        
        <Card.Body className="p-0" style={{ background: "#ffffff" }}>
          <div className="p-3">
            <ActionTable
              columns={paymentColumns}
              rowData={paymentTableData}
              onDownloadReceipt={handleDownloadReceipt}
              tableHeader={null}
              hideExportBtn={true}
              hideSearchBar={true}
              pagination={true}
              itemsInboxPerPage={10}
              tableClassName="table-hover"
              noDataText={
                <div className="text-center py-4 text-muted">
                  <BsCreditCard size={32} className="mb-2 opacity-25" />
                  <h6 className="mb-1" style={{ fontSize: "0.9rem" }}>{t("No Payment Records")}</h6>
                  <p className="mb-0 small">{t("No payment transactions found for this registration")}</p>
                </div>
              }
            />
          </div>
        </Card.Body>
      </Card>
    </div>
  );
};

export default PaymentDetailsView;
