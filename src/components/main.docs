import React from "react";
import { Navbar, Nav, NavDropdown, Form, Button, Container, Row, Col, Card, Dropdown } from "react-bootstrap";
import { FaGlobe, FaCheck } from "react-icons/fa";
import { FiFlag } from "react-icons/fi";
import { GiIndiaGate } from "react-icons/gi";
import styles from "./iwtHome2.module.css";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";
import { useNavigate } from "react-router-dom";

const HeaderHome2 = () => {
    const { t } = useTranslation();
    const { changeLanguage, language } = useLanguageContext();
    let navigate = useNavigate();

    return (
        <Navbar expand="lg" style={{ backgroundColor: "#0F55B2" }}>
            <Navbar.Toggle aria-controls="navbarSupportedContent" style={{ margin: "0.7rem" }} />
            <Navbar.Collapse id="navbarSupportedContent" className={styles.navbarCollapse}>
                <Nav className={`me-auto d-flex align-items-center ${styles.navItems}`}>
                    <Dropdown>
                        <Dropdown.Toggle
                            variant="link"
                            className={`text-white nav-link p-0 d-flex align-items-center gap-1 ${styles.navLinkItems}`}
                        >
                            <FaGlobe />
                            <span>{t("home2.language")}</span>
                        </Dropdown.Toggle>
                        <Dropdown.Menu className="language-dropdown-menu">
                            <Dropdown.Item
                                onClick={() => changeLanguage("en")}
                                active={language === "en"}
                                className="d-flex align-items-center gap-2"
                            >
                                <FiFlag size={18} style={{ color: "#2563eb" }} />
                                <span>English</span>
                                {language === "en" && (
                                    <FaCheck className="ms-auto text-success" />
                                )}
                            </Dropdown.Item>
                            <Dropdown.Item
                                onClick={() => changeLanguage("bn")}
                                active={language === "bn"}
                                className="d-flex align-items-center gap-2"
                            >
                                <GiIndiaGate size={18} style={{ color: "#f59e42" }} />
                                <span>বাংলা</span>
                                {language === "bn" && (
                                    <FaCheck className="ms-auto text-success" />
                                )}
                            </Dropdown.Item>
                        </Dropdown.Menu>
                    </Dropdown>

                    <span className={`text-white mx-2 ${styles.navbarSeparator}`}>|</span>
                    <Nav.Link className={`${styles.navLinkItems}`}>{t("home2.skipToMainCnt")}</Nav.Link>
                </Nav>

                <Form className={`d-flex justify-content-around ${styles.formButtons}`}>
                    <Button type="button" className={`${styles.topNavBtn} mx-2`} style={{ backgroundColor: "transparent" }}>
                        {t("home2.aMinus")}
                    </Button>
                    <Button type="button" className={`${styles.topNavBtn} mx-2`} style={{ backgroundColor: "transparent" }}>
                        {t("home2.a")}
                    </Button>
                    <Button type="button" className={`${styles.topNavBtn} mx-2`} style={{ backgroundColor: "transparent" }}>
                        {t("home2.aPlus")}
                    </Button>
                </Form>
            </Navbar.Collapse>
        </Navbar>
    );
}

export default HeaderHome2;
