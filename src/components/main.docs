<Dropdown align="end">
  <OverlayTrigger
    placement="top"
    overlay={
      <BSTooltip id={`tooltip-${row?.id}`}>
        More Actions
      </BSTooltip>
    }
  >
    <Dropdown.Toggle
      variant="link"
      id={`dropdown-${row?.id}`}
      className={`${style.dropdownToggle} action-toggle`}
    >
      <div className={style.dotsContainer}>
        <div className={style.dot}></div>
        <div className={style.dot}></div>
        <div className={style.dot}></div>
      </div>
    </Dropdown.Toggle>
  </OverlayTrigger>

  <Dropdown.Menu className={`${style.dropdownMenu} shadow-lg`}>
    <div className={style.dropdownHeader}>
      <span>Actions</span>
      <div className={style.headerDivider}></div>
    </div>
    
    <div className={style.menuItems}>
      {(o.actions.includes("edit") || row?.isEditable) && (
        <Dropdown.Item
          onClick={() => handleEdit(row)}
          className={style.dropdownItem}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <PencilSquare size={16} />
            </div>
            <span>Edit</span>
          </div>
        </Dropdown.Item>
      )}

      {o.actions.includes("view") && (
        <Dropdown.Item
          onClick={() => handleView(row)}
          className={style.dropdownItem}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <FaEye size={16} />
            </div>
            <span>View</span>
          </div>
        </Dropdown.Item>
      )}

      {o.actions.includes("delete") && (
        <Dropdown.Item
          onClick={() => handleDeleteRow(row)}
          className={`${style.dropdownItem} ${style.deleteItem}`}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <FaTrash size={16} />
            </div>
            <span>Delete</span>
          </div>
        </Dropdown.Item>
      )}

      {o.actions.includes("download") && (
        <Dropdown.Item
          onClick={() => handleDownload(row)}
          className={style.dropdownItem}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <FaDownload size={16} />
            </div>
            <span>Download</span>
          </div>
        </Dropdown.Item>
      )}

      {o.actions.includes("upload") && (
        <Dropdown.Item
          onClick={() => handleView(row)}
          className={style.dropdownItem}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <FaUpload size={16} />
            </div>
            <span>Upload</span>
          </div>
        </Dropdown.Item>
      )}

      {(o.actions.includes("uploadReports") || row?.isEnableUploadReports) && (
        <Dropdown.Item
          onClick={() => handleUploadReports(row)}
          className={style.dropdownItem}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <Upload size={16} />
            </div>
            <span>Upload Reports</span>
          </div>
        </Dropdown.Item>
      )}

      {(o.actions.includes("vesselRegistration") || row?.isEnableApplicationRegistration) && (
        <Dropdown.Item
          onClick={() => handleVesselRegistration(row)}
          className={style.dropdownItem}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <FileEarmarkText size={16} />
            </div>
            <span>Vessel Registration</span>
          </div>
        </Dropdown.Item>
      )}

      {(o.actions.includes("provisionalCertificate") || row?.isEnableProvisionalCertificate) && (
        <Dropdown.Item
          onClick={() => handleProvisionalCertificate(row)}
          className={style.dropdownItem}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <Award size={16} />
            </div>
            <span>Provisional Certificate</span>
          </div>
        </Dropdown.Item>
      )}

      {o.actions.includes("revisedDrawing") && (
        <Dropdown.Item
          onClick={() => handleRevisedDrawing(row)}
          className={style.dropdownItem}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <Pencil size={16} />
            </div>
            <span>Revised Drawing</span>
          </div>
        </Dropdown.Item>
      )}

      {(o.actions.includes("paySupervisionFee") || !row?.isEnableSupervisionFee) && (
        <Dropdown.Item
          onClick={() => handlePaySupervisionFee(row)}
          className={style.dropdownItem}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <CreditCard size={16} />
            </div>
            <span>Pay Supervision Fee</span>
          </div>
        </Dropdown.Item>
      )}

      {o.actions.includes("applyInitialSurvey") || (row?.enableInitialSurvey && (
        <Dropdown.Item
          onClick={() => handleApplyInitialSurvey(row)}
          className={style.dropdownItem}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <ClipboardCheck size={16} />
            </div>
            <span>Apply Initial Survey</span>
          </div>
        </Dropdown.Item>
      ))}
      
      {row?.isCMNGenerated && (
        <Dropdown.Item
          onClick={() => handleDownloadCMN(row)}
          className={style.dropdownItem}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <Download size={16} />
            </div>
            <span>Download CMN</span>
          </div>
        </Dropdown.Item>
      )}

      {row?.isCMNGenerated && !row.enableInitialSurvey && (
        <Dropdown.Item
          onClick={() => handleSlotBooking(row)}
          className={style.dropdownItem}
        >
          <div className={style.itemContent}>
            <div className={style.iconWrapper}>
              <Calendar2Check size={16} />
            </div>
            <span>Slot Booking</span>
          </div>
        </Dropdown.Item>
      )}
    </div>
  </Dropdown.Menu>
</Dropdown>
