/* General Styles */
html, body {
  overflow-x: hidden;
  width: 100%;
}

.container-fluid {
  width: 100%;
  padding-left: 15px;
  padding-right: 15px;
  margin-left: auto;
  margin-right: auto;
  overflow: hidden;
}

/* Header Styles */
.mb-2.text-center {
  font-size: clamp(1.5rem, 2.5vw, 2.5rem);
  font-weight: bold;
  color: #269ccc;
  letter-spacing: 1px;
  text-transform: uppercase;
  text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
  margin-bottom: 1rem;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  padding: 0 15px;
}

/* Table Styles - Improved Responsiveness */
.table-responsive {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  -ms-overflow-style: -ms-autohiding-scrollbar;
  margin-bottom: 1rem;
}

.table-responsive::-webkit-scrollbar {
  height: 8px;
}

.table-responsive::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 4px;
}

.table-responsive::-webkit-scrollbar-thumb {
  background: #269ccc;
  border-radius: 4px;
}

.table-responsive::-webkit-scrollbar-thumb:hover {
  background: #1a7a9c;
}

.table {
  width: 100%;
  min-width: 600px; /* Ensures table doesn't collapse too much */
  margin-bottom: 0;
}

.table th,
.table td {
  text-align: center;
  vertical-align: middle;
  padding: 12px 8px;
  font-size: 0.9rem;
  white-space: nowrap;
}

.table thead th {
  background-color: #269ccc;
  color: #fff;
  font-weight: bold;
  position: sticky;
  top: 0;
}

.table tbody tr:nth-child(even) {
  background-color: #f9f9f9;
}

.table tbody tr:hover {
  background-color: #f1f1f1;
}

/* Pagination Styles */
.pagination {
  display: flex;
  justify-content: center;
  list-style: none;
  padding: 0;
  flex-wrap: wrap;
}

.pagination .page-item {
  margin: 2px;
}

.pagination .page-link {
  padding: 6px 10px;
  font-size: 0.85rem;
  color: #09828D;
  text-decoration: none;
  border: 1px solid #09828D;
  border-radius: 4px;
  transition: all 0.3s ease;
  min-width: 36px;
  text-align: center;
}

.pagination .page-link:hover {
  background-color: #086e74;
  color: #fff;
}

.pagination .active .page-link {
  background-color: #09828D;
  color: #fff;
  border-color: #09828D;
}

/* Loader */
.loader-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.loader {
  border: 6px solid #f3f3f3;
  border-top: 6px solid #09828D;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* Form Controls */
.d-flex {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.d-flex .mr-2 {
  margin-right: 0.5rem;
}

.d-flex .form-control {
  min-width: 150px;
  flex: 1 1 auto;
}

/* Button Styles */
.col-12.col-md-4 {
  display: flex;
  justify-content: flex-end;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.col-12.col-md-4 .btn {
  white-space: nowrap;
  font-size: 0.85rem;
  padding: 0.4rem 0.8rem;
  background-color: #269ccc;
  border-color: #269ccc;
  color: white;
  flex: 1 1 auto;
}

.col-12.col-md-4 .btn:hover {
  background-color: #076C75;
  border-color: #076C75;
}

/* Modal Styles */
.modal-1110w {
  max-width: 95vw;
  width: 100%;
  margin: 1.75rem auto;
}

.white-icon {
  filter: brightness(0) invert(1);
}

.black-icon {
  filter: brightness(0) invert(0);
}

/* Preview Card */
.preview-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 1rem;
  border: 1px solid #ddd;
  border-radius: 8px;
  background-color: #fff;
  box-sizing: border-box;
}

.preview-card h6 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.preview-card p {
  font-size: 0.9rem;
  margin-bottom: 0;
}

/* Timeline */
.timeline-container {
  position: relative;
  margin-left: 20px;
  padding-left: 10px;
  border-left: 2px solid #ddd;
  overflow: visible;
}

.timeline-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20px;
  position: relative;
}

.timeline-icon {
  position: absolute;
  left: -26px;
  top: 2px;
  background: #fff;
  padding: 6px;
  border-radius: 50%;
  border: 2px solid #dee2e6;
  font-size: 1.2rem;
}

.timeline-content {
  padding-left: 20px;
}

/* Responsive Adjustments */
@media (max-width: 992px) {
  .table th, 
  .table td {
    padding: 8px 6px;
    font-size: 0.8rem;
  }
  
  .modal-1110w {
    max-width: 98vw;
  }
}

@media (max-width: 768px) {
  .container-fluid {
    padding-left: 10px;
    padding-right: 10px;
  }
  
  .col-12.col-md-4 {
    justify-content: flex-start;
  }
  
  .d-flex {
    flex-direction: column;
  }
  
  .d-flex .form-control {
    width: 100%;
  }
  
  .table-responsive {
    border: 1px solid #ddd;
    border-radius: 4px;
  }
}

@media (max-width: 576px) {
  .mb-2.text-center {
    font-size: 1.8rem;
  }
  
  .pagination .page-link {
    padding: 4px 8px;
    min-width: 30px;
  }
  
  .col-12.col-md-4 .btn {
    width: 100%;
    margin-bottom: 0.5rem;
  }
}
