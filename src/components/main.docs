//   try {
//     // Log the complete form data
//     console.log("Form submitted with data:", JSON.stringify(data, null, 2));
    
//     // Create FormData object for API submission
//     const formDataObj = new FormData();
    
//     // Process nested objects for API submission
//     for (const [key, value] of Object.entries(data)) {
//       if (key === "documents") {
//         // Handle file uploads
//         for (const [docKey, docFile] of Object.entries(value)) {
//           if (docFile && docFile[0]) {
//             console.log(`Adding file: ${docKey}`, docFile[0]);
//             formDataObj.append(docKey, docFile[0]);
//           }
//         }
//       } else {
//         // Handle other form data
//         formDataObj.append(key, JSON.stringify(value));
//       }
//     }
    
//     // Log the FormData entries
//     console.log("Form data payload:");
//     for (const [key, value] of formDataObj.entries()) {
//       console.log(`${key}:`, value instanceof File ? `File: ${value.name}` : value);
//     }

//     // Submit formData to your API
//     // await postData("your-api-endpoint", formDataObj);
    
//     toast.success("Employee registered successfully!");
//     setModal(false); // Close modal after successful submission
//   } catch (error) {
//     console.error("Error submitting form:", error);
//     toast.error("Error submitting form");
//   }
// };





// UserManagement.jsx - handleFormSubmit function update
const handleFormSubmit = async (data) => {
  try {
    // Log the complete form data
    console.log("Form submitted with data:", JSON.stringify(data, null, 2));
    
    // Create FormData object for API submission
    const formDataObj = new FormData();
    
    // Add validation for required fields
    let hasErrors = false;
    
    // Validate personal details
    if (!data.personal?.firstName) {
      methods.setError("personal.firstName", { type: "required", message: "First Name is required" });
      hasErrors = true;
    }
    
    if (!data.personal?.lastName) {
      methods.setError("personal.lastName", { type: "required", message: "Last Name is required" });
      hasErrors = true;
    }
    
    if (!data.personal?.email) {
      methods.setError("personal.email", { type: "required", message: "Email is required" });
      hasErrors = true;
    } else if (!/^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i.test(data.personal.email)) {
      methods.setError("personal.email", { type: "pattern", message: "Invalid email address" });
      hasErrors = true;
    }
    
    if (!data.personal?.phoneNumber) {
      methods.setError("personal.phoneNumber", { type: "required", message: "Phone Number is required" });
      hasErrors = true;
    } else if (!/^\d{10}$/.test(data.personal.phoneNumber)) {
      methods.setError("personal.phoneNumber", { type: "pattern", message: "Phone number must be 10 digits" });
      hasErrors = true;
    }
    
    // Validate address details
    if (!data.address?.line1) {
      methods.setError("address.line1", { type: "required", message: "Address Line-1 is required" });
      hasErrors = true;
    }
    
    if (!data.address?.pin) {
      methods.setError("address.pin", { type: "required", message: "PIN Code is required" });
      hasErrors = true;
    } else if (!/^\d{6}$/.test(data.address.pin)) {
      methods.setError("address.pin", { type: "pattern", message: "PIN must be 6 digits" });
      hasErrors = true;
    }
    
    // Validate document uploads
    if (!data.documents?.addressProof || !data.documents.addressProof[0]) {
      methods.setError("documents.addressProof", { type: "required", message: "Address Proof is required" });
      hasErrors = true;
    }
    
    if (hasErrors) {
      console.log("Form has validation errors");
      return;
    }
    
    // Process form data for API submission
    for (const [key, value] of Object.entries(data)) {
      if (key === "documents") {
        // Handle file uploads
        for (const [docKey, docFile] of Object.entries(value)) {
          if (docFile && docFile[0]) {
            console.log(`Adding file: ${docKey}`, docFile[0]);
            formDataObj.append(docKey, docFile[0]);
          }
        }
      } else {
        // Handle other form data
        formDataObj.append(key, JSON.stringify(value));
      }
    }
    
    // Log the FormData entries
    console.log("Form data payload:");
    for (const [key, value] of formDataObj.entries()) {
      console.log(`${key}:`, value instanceof File ? `File: ${value.name}` : value);
    }

    // Submit formData to your API
    // await postData("your-api-endpoint", formDataObj);
    
    toast.success("Employee registered successfully!");
    setModal(false); // Close modal after successful submission
  } catch (error) {
    console.error("Error submitting form:", error);
    toast.error("Error submitting form");
  }
};


  return (
    <>
      <div className="w-full">
        <Card>
          <form
            style={{ padding: "2rem", margin: 0 }}
            onSubmit={handleSubmit(onSubmitFilterForm)}
          >
            <Row>
              <Col md={2}>
                <InputText
                  type="text"
                  name="empId"
                  maxlength={10}
                  label="Employee Id"
                  placeholder="Enter Employee Id"
                  register={{
                    ...register("empId", {}),
                  }}
                  errors={errors}
                  onKeyDown={(e) => {
                    if (!/^\d$/.test(e.key)) {
                      e.preventDefault();
                    }
                  }}
                />
              </Col>

              <Col md={2}>
                <InputText
                  type="text"
                  name="empName"
                  label="Employee Name"
                  placeholder="Enter employee name"
                  register={{
                    ...register("empName", {}),
                  }}
                  errors={errors}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label="Designation"
                  name="designation"
                  options={[
                    { value: 1, label: "Senior Engg" },
                    { value: 2, label: "Junior Engg" },
                    { value: 3, label: "Vessel Owner" },
                  ]}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected Desig :", val)}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label="Status"
                  name="status"
                  options={[
                    { value: "active", label: "Active" },
                    { value: "inactive", label: "Inactive" },
                  ]}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected:", val)}
                />
              </Col>

              <Col md={2}>
                <InputText
                  type="text"
                  name="phoneNumber"
                  label="Phone Number"
                  maxlength={10}
                  placeholder="Enter Phone Number"
                  register={{
                    ...register("phoneNumber", {}),
                  }}
                  onKeyDown={(e) => {
                    if (!/^\d$/.test(e.key)) {
                      e.preventDefault();
                    }
                  }}
                  errors={errors}
                />
              </Col>

              <Col
                md={2}
                // className="filter-btn"
                // style={{ display: "flex", position: "relative", top: "2rem" }}
              >
                <div style={{ display: "flex",gap:"8px",marginTop:"2rem" }}>
                  <div className="w48">
                     <button className="generic-btn-submit" type="submit">
                    Filter
                  </button>
                    </div>
                    <div className="w48">
                      <button
                    className="generic-btn-cancel "
                    type="reset"
                    onClick={() => {
                      reset();
                    }}
                  >
                    {t("login.reset")}
                  </button>
                      </div>
                 
                  

                </div>
                {/* <Col >
                  
                </Col>
                &nbsp;&nbsp;
                <Col>
                  
                </Col> */}
              </Col>
            </Row>
            <Row className="mt-2">
              <Col md={{ span: 2, offset: 10 }} className="d-flex justify-content-end">
                <button
                  className="generic-btn-submit"
                  type="button"
                  onClick={handleBtnClick}
                >
                  <i className="fa fa-plus" aria-hidden="true"></i> {t("Add")}
                </button>
              </Col>
            </Row>
          </form>
        </Card>
        <>
          <ActionTable
            tableHeader="Employee List"
            columns={columns}
            rowData={rowData}
            additionalMethod={handleRowClick}
            showCustomBtn={true}
            btnName={t("Add")}
            handleBtnClick={handleBtnClick}
            handleEditRow={handleEditRow}
            hideExportBtn={true}
            searchBarPlaceholder={t("Table.SEARCH_BY")}
          />
        </>

        <ActionModal
          show={modal}
          close={Toggle}
          title={modalTitle}
          action={modalAction}
          isFooterHide={true}
          size={"lg"}
        >
          <FormProvider {...methods}>
            <form onSubmit={methods.handleSubmit(handleFormSubmit)}>
              <EmployeeRegistrationForm />
              <div className="d-flex justify-content-end mt-4 gap-2">
                <Button 
                  variant="secondary" 
                  onClick={Toggle}
                  className="cancel-btn"
                >
                  Cancel
                </Button>
                <Button 
                  variant="primary" 
                  type="submit"
                  className="submit-btn"
                  style={{
                    background: 'linear-gradient(135deg, #0077b6, #023e8a)',
                    border: 'none',
                    boxShadow: '0 4px 6px rgba(0, 0, 0, 0.1)',
                    padding: '8px 20px'
                  }}
                >
                  Submit
                </Button>
              </div>
            </form>
          </FormProvider>
        </ActionModal>
      </div>
    </>
  );
};

export default UserManagement;
