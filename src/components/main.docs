const extractEnclosers = (formData, registrationData) => {
  const enclosers = [];

  if (
    registrationData?.enclosers &&
    Array.isArray(registrationData.enclosers)
  ) {
    registrationData.enclosers.forEach((encloser) => {
      enclosers.push({
        id: encloser.id || "",
        fileStoreId: encloser.fileStoreId || "",
        documentName: encloser.documentName || "",
        documentType: encloser.documentType || "",
        documentSource: encloser.documentSource || "",
        description: encloser.description || "",
      });
    });
  }

  const encloserTypes = [
    {
      key: "thirdPartyInsurance",
      type: "THIRD_PARTY_INSURANCE",
      name: "Third Party Insurance",
    },
    {
      key: "builderCertificate",
      type: "BUILDERS_CERTIFICATE",
      name: "Builder Certificate",
    },
    {
      key: "instrumentOfSale",
      type: "INSTRUMENT_OF_SALE",
      name: "Instrument of Sale",
    },
    {
      key: "mortgageDetails",
      type: "MORTGAGE_DETAILS",
      name: "Mortgage Details",
    },
    {
      key: "pniInsurance",
      type: "PREOTECTION_AND_INDEMNITY_INSURANCE_NO",
      name: "Protection and Indemnity Insurance",
    },
    {
      key: "declarationOfOwnership",
      type: "DECLARATION_OF_OWNERSHIP",
      name: "Declaration of Ownership",
    },
    { key: "challan", type: "CHALLAN", name: "Challan" },
  ];

  encloserTypes.forEach(({ key, type, name }) => {
    const fileStoreId = formData?.[`${key}FileStoreId`];
    if (fileStoreId) {
      // Get the actual filename from fileStates instead of hardcoding .pdf
      const actualFileName = registrationFormData?.[key]?.name || `${name}.pdf`;
      
      enclosers.push({
        id: "",
        fileStoreId,
        documentName: actualFileName, // Use actual filename with correct extension
        documentType: type,
        documentSource: type,
        description: `${name} document`,
      });
    }
  });

  return enclosers;
};
