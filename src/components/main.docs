<Box
  sx={{
    display: "flex",
    justifyContent: "space-between",
    gap: "1rem",
    flexDirection: { xs: "column", sm: "row" },
    alignItems: { xs: "stretch", sm: "center" },
  }}
>
  <Button
    variant="outlined"
    onClick={handleBack}
    disabled={activeStep === 0}
    sx={{
      color: themeColor,
      borderColor: themeColor,
      fontWeight: "bold",
      borderRadius: "0.5rem",
      minWidth: { xs: "100%", sm: "8rem" },
      fontSize: "0.9rem",
    }}
  >
    {t("Previous")}
  </Button>
  
  {/* Rest of button logic remains the same but with responsive styling */}
</Box>
