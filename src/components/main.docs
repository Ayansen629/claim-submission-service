.user-info {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.user-name {
  font-weight: 600;
  font-size: 0.9rem;
  color: #2466BF;
}

.user-role {
  font-size: 0.75rem;
  color: #6b7280;
  margin-top: 2px;
}

.dropdown-item-custom:hover .user-name {
  color: #1d4ed8;
}

.dropdown-item-custom:hover .user-role {
  color: #4b5563;
}
