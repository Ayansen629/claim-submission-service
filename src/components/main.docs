                  placeholder={!viewMode ? t("Enter Total No. of Deck Crew") : ""}
                  register={register("crewDetails.totalDeckCrew")}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
              <Col md={6}>
                <InputText
                  label={t("Total No. of Engine Crew")}
                  name="crewDetails.totalEngineCrew"
                  type="number"
                  placeholder={!viewMode ? t("Enter Total No. of Engine Crew") : ""}
                  register={register("crewDetails.totalEngineCrew")}
                  errors={errors}
                  disabled={viewMode}
                />
              </Col>
            </Row>

            {/* Individual Crew Members */}
            {fields.map((field, index) => (
              <Row key={field.id} className="gy-3 mb-3 border-bottom pb-3">
                <Col md={3}>
                  <InputSelect
                    label={t("Crew Type")}
                    required={false}
                    placeholder={!viewMode ? t("-- Select --") : ""}

                    name={`crewDetails.crewDetails.${index}.crewType`}
                    options={[
                      { value: "", label: "-- Select --" },
                      ...(masterData?.crewTypes?.map((type) => ({
                        value: type.valueCode,
                        label: type.valueLabel,
                      })) || []),
                    ]}
                    register={register(`crewDetails.crewDetails.${index}.crewType`, {
                      required: t("Crew Type is required"),
                    })}
                    errors={errors}
                    value={watch(`crewDetails.crewDetails.${index}.crewType`) || ""}
                    onChange={(value) =>
                      !viewMode &&
                      handleSelectChange(`crewDetails.crewDetails.${index}.crewType`, value)
                    }
                    disabled={viewMode}
                  />
                </Col>
                <Col md={3}>
                  <InputText
                    label={t("Name")}
                    required={false}
                    name={`crewDetails.crewDetails.${index}.name`}
                    placeholder={!viewMode ? t("Enter Name") : ""}
                    register={register(`crewDetails.crewDetails.${index}.name`, {
                      required: t("Name is required"),
                    })}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Rank")}
                    name={`crewDetails.crewDetails.${index}.rank`}
                    placeholder={!viewMode ? t("Enter Rank") : ""}
                    register={register(`crewDetails.crewDetails.${index}.rank`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("COC No.")}
                    name={`crewDetails.crewDetails.${index}.cocNo`}
                    placeholder={!viewMode ? t("Enter COC No.") : ""}
                    register={register(`crewDetails.crewDetails.${index}.cocNo`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={2}>
                  <InputText
                    label={t("Validity")}
                    name={`crewDetails.crewDetails.${index}.validity`}
                    placeholder={!viewMode ? t("Enter Validity") : ""}
                    register={register(`crewDetails.crewDetails.${index}.validity`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                <Col md={6}>
                  <InputText
                    label={t("Place of Issue")}
                    name={`crewDetails.crewDetails.${index}.placeOfIssue`}
                    placeholder={!viewMode ? t("Enter Place of Issue") : ""}
                    register={register(`crewDetails.crewDetails.${index}.placeOfIssue`)}
                    errors={errors}
                    disabled={viewMode}
                  />
                </Col>
                {!viewMode && index > 0 && (
                  <Col md={6} className="text-end">
                    <Button
                      variant="danger"
                      size="sm"
                      onClick={() => remove(index)}
                      className="mt-1"
                    >
                      <FaTrash /> Remove
                    </Button>
                  </Col>
                )}
              </Row>
            ))}
            {!viewMode && (
              <Button
                variant="outline-primary"
                onClick={() =>
                  append({
                    crewType: "",
                    name: "",
                    rank: "",
                    cocNo: "",
                    validity: "",
                    placeOfIssue: "",
                  })
                }
                className="mt-2"
              >
                <FaPlus className="me-2" /> Add Crew Member
              </Button>
            )}
          </div>
        </Collapsible>

        {/* Enclosure */}
        <Collapsible
          title={
            <div className="d-flex align-items-center">
              <FaFileUpload className="me-2" style={{ color: "#2466BF" }} />
              <span style={{ color: "#2466BF" }}>{t("ENCLOSURE")}</span>
            </div>
          }
          defaultOpen={true}
        >
          <Card className="form-section-card">
            <Card.Body>
              <Row className="g-3">
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "certificateOfRegistration",
                    t("Certificate of Registration")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "NOCfromOriginalRegistrationAuthority",
                    t("NOC from Original Registration Authority")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "lastSurveyCertificate",
                    t("Last Survey Certificate")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField(
                    "tonnageBooklet",
                    t("Tonnage Booklet")
                  )}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("stabilityBooklet", t("Stability Booklet"))}
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("insuranceCertificate", t("Insurance Certificate"))}
                </Col>
                <Col xs={12} lg={6}>
                  <MultiFile
                    title={t("Main Drawing and Other Drawings")}
                    files={drawingFiles}
                    setFiles={setDrwaingFiles}
                    type="DRAWING"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                  />
                </Col>
                <Col xs={12} lg={6}>
                  <MultiFile
                    title={t("Radiography Report")}
                    files={radiographyFiles}
                    setFiles={setRadiographyFiles}
                    type="RADIOGRAPHY_REPORT"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                  />
                </Col>
                <Col xs={12} lg={6}>
                  <MultiFile
                    title={t("Material Test Report")}
                    files={materialTestFiles}
                    setFiles={setMaterialTestFiles}
                    type="MATERIAL_TEST_REPORT"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                  />
                </Col>
                <Col xs={12} lg={6}>
                  <MultiFile
                    title={t("Other Inspection Reports")}
                    files={otherInspectionFiles}
                    setFiles={setOtherInspectionFiles}
                    type="OTHER_INSPECTION_REPORT"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                  />
                </Col>
                <Col xs={12} lg={6}>
                  <MultiFile
                    title={t("Other Technical Document")}
                    files={otherTechnicalDocumentFiles}
                    setFiles={setOtherTechnicalDocumentFiles}
                    type="OTHER_TECH_DOC"
                    icon={<BsFileEarmarkPdf className="text-primary" size={12} />}
                    watch={watch}
                    viewMode={viewMode}
                    editMode={editMode}
                    clearErrors={clearErrors}
                    register={register}
                    errors={errors}
                    setError={setError}
                    setValue={setValue}
                    unregister={unregister}
                    ref={loaderRef}
                  />
                </Col>
                <Col xs={12} lg={6}>
                  {renderFileField("paymentChallan", t("Payment Challan/Acknowledgement"))}
                </Col>
              </Row>
            </Card.Body>
          </Card>
        </Collapsible>
      </form>
    </>
  );
};

export default TransferOfRegistryForm
import React, { useState, useCallback, useMemo, memo } from "react";
import { Table, Button } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import Collapsible from "../../../../common/Collapsible.js";
import { FaFire, FaCog, FaCompass, FaUsers, FaShieldAlt, FaBolt, FaHome, FaPlus, FaTrash, FaFileContract } from "react-icons/fa";
import { conditionOptions, initialEquipementData } from "./constants/VesselEquipementConstant.js";
import InputText from "../../../../common/InputText.tsx";
import InputSelect from "../../../../common/InputSelect.tsx";
import { useFieldArray, useForm } from "react-hook-form";
import { useMasterData } from "../../../../context/MasterDataContext.js";
import { getFromLocalStorage } from "../../../../../utils/localStorageUtils.js";
import { USER_ROLES } from "../../../../../utils/constants.ts";
import DeclarationOfSurvey from "./DeclarationOfSurvey.js";

const EquipmentTableRow = memo(({
  category,
  fieldName,
  register,
  errors,
  watch,
  handleConditionChange,
  isFieldDisabled,
  viewMode,
  values,
  isConditionDisabled
}) => {

  return (
    <tr>
      <td>{category.categoryLable}</td>
      <td>
        <InputText
          name={`${fieldName}.number`}
          type="number"
          placeholder={!viewMode ? "Enter number" : ""}
          register={register(`${fieldName}.number`)}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`${fieldName}.type`}
          placeholder={!viewMode ? "Enter type" : ""}
          register={register(`${fieldName}.type`)}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`${fieldName}.capacity`}
          placeholder={!viewMode ? "Enter capacity" : ""} register={register(`${fieldName}.capacity`)}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`${fieldName}.location`}
          placeholder={!viewMode ? "Enter location" : ""}
          register={register(`${fieldName}.location`)}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      {viewMode && (
        <>
          <td>
            <InputSelect
              name={`${fieldName}.condition`}
              options={conditionOptions}
              value={watch(`${fieldName}.condition`)}
              register={register(`${fieldName}.condition`)}
              onChange={(value) => handleConditionChange(`${fieldName}.condition`, value)}
              errors={errors}
              disabled={isConditionDisabled}
            />
          </td>
          <td>
            <textarea
              {...register(`${fieldName}.remarks`)}
              placeholder={!viewMode ? "Enter remarks" : ""} disabled={isConditionDisabled}
              style={{
                width: "100%",
                minHeight: "60px",
                padding: "8px",
                border: "1px solid #ced4da",
                borderRadius: "4px",
                resize: "vertical",
                fontSize: "14px"
              }}
            />
          </td>
        </>
      )}
    </tr>
  );
});

const DeckSpaceRow = memo(({
  index,
  register,
  errors,
  isFieldDisabled,
  handleRemoveDeck,
  deckFields,
  viewMode
}) => {
  return (
    <tr>
      <td>
        <InputText
          name={`deckSpaces.${index}.deckType`}
          placeholder={!viewMode ? "Enter Deck/Space Type" : ""} register={register(`deckSpaces.${index}.deckType`)}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`deckSpaces.${index}.size`}
          placeholder={!viewMode ? "Enter Size" : ""} register={register(`deckSpaces.${index}.size`)}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`deckSpaces.${index}.function`}
          placeholder={!viewMode ? "Enter Function" : ""}
          register={register(`deckSpaces.${index}.function`)}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`deckSpaces.${index}.maxPassengers`}
          type="number"
          placeholder={!viewMode ? "Enter Max. No. of Passenger" : ""} register={register(`deckSpaces.${index}.maxPassengers`)}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      <td>
        <InputText
          name={`deckSpaces.${index}.remarks`}
          placeholder={!viewMode ? "Enter Remarks" : ""}
          register={register(`deckSpaces.${index}.remarks`)}
          errors={errors}
          disabled={isFieldDisabled}
        />
      </td>
      {deckFields?.length > 1 && !isFieldDisabled && (
        <td className="text-center align-middle">
          <Button
            variant="outline-danger"
            onClick={() => handleRemoveDeck(index)}
            type="button"
            className="deck-remove-btn"
          >
            <FaTrash className="me-2" /> Remove
          </Button>
        </td>
      )}
    </tr>
  );
});

const RenderDynamicEquipmentTable = memo(({ equipment, register, errors, watch, handleConditionChange, isFieldDisabled, viewMode, getEquipmentIcon, values, isConditionDisabled }) => {
  return (
    <Collapsible
      title={
        <>
          {getEquipmentIcon(equipment.equipmentName)}
          <span>{equipment.equipmentName}</span>
        </>
      }
      openStat={true}
    >
      <div className="table-container">
        <Table striped bordered hover responsive className="mb-0 equipment-table">
          <thead>
            <tr>
              <th>{equipment.equipmentName}</th>
              <th>Number</th>
              <th>Type</th>
              <th>Capacity</th>
              <th>Location</th>
              {viewMode && (
                <>
                  <th style={{ minWidth: "200px" }}>Condition</th>
                  <th>Remarks</th>
                </>
              )}
            </tr>
          </thead>
          <tbody>
            {equipment.equipmentCategories.map((category) => {
              const fieldName = `equipment.${equipment.id}.${category.categoryCode}`;
              return (
                <EquipmentTableRow
                  key={category.categoryCode}
                  category={category}
                  fieldName={fieldName}
                  register={register}
                  errors={errors}
                  watch={watch}
                  handleConditionChange={handleConditionChange}
                  isFieldDisabled={isFieldDisabled}
                  viewMode={viewMode}
                  values={values}
                  isConditionDisabled={isConditionDisabled}
                />
              );
            })}
          </tbody>
        </Table>
      </div>
    </Collapsible>
  );
});


const TransferEquipmentForm = ({ formMethods, viewMode = false, editMode = false, registrationData, intialSurveyData }) => {
  const { t } = useTranslation();
  const { masterData } = useMasterData();

  const userRole = getFromLocalStorage("userRole");
  const isL3Officer = userRole === USER_ROLES.OFFICER_L3;
  const isFieldDisabled = viewMode;
  const isConditionDisabled = !intialSurveyData?.processActionMapResponce;

  const internalFormMethods = useForm({ mode: "onTouched" });
  const methods = formMethods || internalFormMethods;
  const { register, watch, setValue, formState: { errors }, control } = methods;

  const { fields: deckFields, append: appendDeck, remove: removeDeck } = useFieldArray({
    control,
    name: "deckSpaces"
  });

  const values = watch();

  const getEquipmentIcon = useMemo(() => {
    const iconMap = {
      "Fire Fighting Items": <FaFire className="me-2" style={{ color: "#2466BF" }} />,
      "Equipments": <FaCog className="me-2" style={{ color: "#2466BF" }} />,
      "Navigational Equipments": <FaCompass className="me-2" style={{ color: "#2466BF" }} />,
      "Life-Saving Equipment": <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />,
      "Machinery/Electrical": <FaBolt className="me-2" style={{ color: "#2466BF" }} />,
      "Accommodation/Safety": <FaHome className="me-2" style={{ color: "#2466BF" }} />
    };
    return (equipmentName) => iconMap[equipmentName] || <FaCog className="me-2" style={{ color: "#2466BF" }} />;
  }, []);

  const handleConditionChange = useCallback((fieldName, value) => {
    setValue(fieldName, value, { shouldValidate: true, shouldDirty: true });
  }, [setValue]);

  const handleAddDeck = useCallback(() => {
    appendDeck(initialEquipementData?.deckSpaces?.[0]);
  }, [appendDeck]);

  const handleRemoveDeck = useCallback((index) => {
    removeDeck(index);
  }, [removeDeck]);

  const equipmentTables = useMemo(() => {
    if (!masterData?.equipmentCategories) return null;
    console.log("changed");
    return masterData.equipmentCategories.map((equipment) => (
      <RenderDynamicEquipmentTable
        key={equipment.id}
        equipment={equipment}
        register={register}
        errors={errors}
        watch={watch}
        handleConditionChange={handleConditionChange}
        isFieldDisabled={isFieldDisabled}
        viewMode={viewMode}
        getEquipmentIcon={getEquipmentIcon}
        values={values}
        isConditionDisabled={isConditionDisabled}
      />
    ));
  }, [masterData?.equipmentCategories, register, errors, watch, handleConditionChange, isFieldDisabled, viewMode, getEquipmentIcon, values, isConditionDisabled]);

  const deckRows = useMemo(() => {
    return deckFields.map((deck, index) => (
      <DeckSpaceRow
        key={deck.id || index}
        index={index}
        register={register}
        errors={errors}
        isFieldDisabled={isFieldDisabled}
        handleRemoveDeck={handleRemoveDeck}
        deckFields={deckFields}
        viewMode={viewMode}
      />
    ));
  }, [deckFields, register, errors, isFieldDisabled, handleRemoveDeck]);

  return (
    <form autoComplete="off" className="vessel-equipment-form">
      <style>
        {`
          .vessel-equipment-form { overflow-anchor: none; }
          .table-container {
            max-height: 400px;
            overflow-y: auto;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
          }
          .equipment-table { margin-bottom: 0; }
          .equipment-table thead th {
            position: sticky;
            top: 0;
            background-color: #f8f9fa;
            z-index: 10;
            color: #2466BF;
            font-weight: 600;
          }
          .equipment-table td {
            min-width: 150px;
            vertical-align: middle;
            padding: 8px;
          }
          .equipment-table select, .equipment-table .form-select {
            min-width: 150px !important;
            width: 100% !important;
          }
          .deck-remove-btn {
            transition: all 0.2s ease;
            min-width: 100px;
          }
          .deck-remove-btn:hover { transform: scale(1.05); }
          .table-container::-webkit-scrollbar { width: 8px; height: 8px; }
          .table-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
          }
          .table-container::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 4px;
          }
          .table-container::-webkit-scrollbar-thumb:hover { background: #a8a8a8; }
        `}
      </style>

      {equipmentTables}

      <Collapsible
        title={
          <>
            <FaUsers className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Location of passengers on specific decks and spaces in maximum loaded condition")}</span>
          </>
        }
        openStat={true}
      >
        <div className="p-3">
          <div className="table-container">
            <Table striped bordered hover responsive className="mb-0">
              <thead>
                <tr>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Deck/Space Type")}</th>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Size")}</th>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Function")}</th>
                  <th style={{ fontWeight: "600", color: "#2466BF", minWidth: "200px" }}>{t("Max. No. of Passenger")}</th>
                  <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Remarks")}</th>
                  {deckFields?.length > 1 && !isFieldDisabled && (
                    <th style={{ fontWeight: "600", color: "#2466BF", minWidth: "150px" }}>{t("Actions")}</th>
                  )}
                </tr>
              </thead>
              <tbody>
                {deckRows}
              </tbody>
            </Table>
          </div>
          {!isFieldDisabled && (
            <Button
              variant="outline-primary"
              onClick={handleAddDeck}
              className="mt-3"
              type="button"
            >
              <FaPlus className="me-2" /> Add Deck/Space
            </Button>
          )}
        </div>
      </Collapsible>

      <Collapsible
        title={
          <>
            <FaShieldAlt className="me-2" style={{ color: "#2466BF" }} />
            <span>{t("Freeboard")}</span>
          </>
        }
        openStat={true}
      >
        <div className="p-3">
          <Table striped bordered hover responsive className="mb-0">
            <thead>
              <tr>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Minimum freeboard")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Number of Passengers")}</th>
                <th style={{ fontWeight: "600", color: "#2466BF" }}>{t("Cargo (Tonne)")}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <InputText
                    name={'freeboard.minFreeboard'}
                     placeholder={ !viewMode ?t("Enter Minimum Freeboard"):""} 
                    register={register('freeboard.minFreeboard')}
                    errors={errors}
                    disabled={isFieldDisabled}
                  />
                </td>
                <td>
                  <InputText
                    name={'freeboard.numPassengers'}
                    type={"number"}
                     placeholder={ !viewMode ?t("Enter Number of Passengers"):""} 
                    register={register('freeboard.numPassengers')}
                    errors={errors}
                    disabled={isFieldDisabled}
                  />
                </td>
                <td>
                  <InputText
                    name={'freeboard.cargo'}
                    placeholder={ !viewMode ?t("Enter Cargo (Tonne)"):""} 
                    register={register('freeboard.cargo')}
                    errors={errors}
                    disabled={isFieldDisabled}
                  />
                </td>
              </tr>
            </tbody>
          </Table>
        </div>
      </Collapsible>

      {isL3Officer && (
        <Collapsible
          title={
            <>
              <FaFileContract className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Declaration of Survey")}</span>
            </>
          }
          openStat={true}
        >
          <DeclarationOfSurvey registrationData={registrationData} />
        </Collapsible>
      )}
    </form>
  );
};


