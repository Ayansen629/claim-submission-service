<div className="form-content py-3">
  <Row className="g-3"> {/* Reduced from g-4 to g-3 */}
    {getCurrentStepFields().map((field, index) => (
      <Col
        key={index}
        md={field.colSize || 12}
        className="mb-1" // Reduced from mb-2 to mb-1
      >
        <DynamicField field={field} />
      </Col>
    ))}
  </Row>
</div>
