const createRegistrationPayload = (formData, registrationFormData) => {
  const basePayload = {
    id: registrationData?.id || "",
    applicationNumber: id || "",
    basicDetails: {
      // ... all existing basicDetails code
      id: registrationData?.basicDetails?.id || "",
      applicationNumber: id || "",
      status: registrationData?.basicDetails?.status || "",
      constructedBy:
        registrationData?.basicDetails?.constructedBy ||
        registrationFormData?.builderName ||
        "",
      ownerDetails: {
        id: registrationData?.basicDetails?.ownerDetails?.id || "",
        ownerName:
          registrationFormData?.ownerName ||
          registrationData?.basicDetails?.ownerDetails?.ownerCompanyName ||
          "",
        ownerType:
          registrationFormData?.ownerType ||
          registrationData?.basicDetails?.ownerDetails?.categoryOfOwner ||
          "",
        email:
          registrationFormData?.builderEmail ||
          registrationData?.basicDetails?.ownerDetails?.emailId ||
          "",
        address:
          registrationFormData?.address ||
          registrationData?.basicDetails?.ownerDetails?.addressLine1 ||
          "",
      },
      builderDetails: {
        id: registrationData?.basicDetails?.builderDetails?.id || "",
        builderName:
          registrationFormData?.builderName ||
          registrationData?.basicDetails?.builderDetails?.builderName ||
          "",
        registrationNumber:
          registrationData?.basicDetails?.builderDetails
            ?.registrationNumber || "",
        address:
          registrationFormData?.builderAddress ||
          registrationData?.basicDetails?.builderDetails?.addressLine1 ||
          "",
        contactPerson:
          registrationData?.basicDetails?.builderDetails?.contactPerson || "",
        contactNumber:
          registrationFormData?.builderphoneNumber ||
          registrationData?.basicDetails?.builderDetails?.phone ||
          "",
      },
      builderAuthorization:
        registrationData?.basicDetails?.builderAuthorization || "",
      authorizationLetter: registrationData?.basicDetails?.authorizationLetter
        ? {
            id: registrationData.basicDetails.authorizationLetter.id || "",
            fileStoreId:
              registrationData.basicDetails.authorizationLetter.fileStoreId ||
              "",
            documentName:
              registrationData.basicDetails.authorizationLetter
                .documentName || "Authorization_Letter.pdf",
            documentType:
              registrationData.basicDetails.authorizationLetter
                .documentType || "AUTHORIZATION_LETTER",
            documentSource:
              registrationData.basicDetails.authorizationLetter
                .documentSource || "AUTHORIZATION_LETTER",
            descriptions:
              registrationData.basicDetails.authorizationLetter.description ||
              "builder authorised letter",
          }
        : {
            id: "",
            fileStoreId: "",
            documentName: "Authorization_Letter.pdf",
            documentType: "AUTHORIZATION_LETTER",
            documentSource: "AUTHORIZATION_LETTER",
            descriptions: "builder authorised letter",
          },
      occupation:
        registrationFormData?.occupation ||
        registrationData?.basicDetails?.occupation ||
        "",
      originalPlaceBusiness:
        registrationFormData?.originalPlaceOfBusiness ||
        registrationData?.basicDetails?.originalPlaceBusiness ||
        "",
      isDrawingFee: registrationData?.basicDetails?.isDrawingFee || false,
      isSupervisionFee:
        registrationData?.basicDetails?.isSupervisionFee || false,
      isApplicationRegistrationFee:
        registrationData?.basicDetails?.isApplicationRegistrationFee || false,
      isProvisionaCertificate:
        registrationData?.basicDetails?.isProvisionaCertificate || false,
      isEditable:
        registrationData?.basicDetails?.isEditable !== undefined
          ? registrationData.basicDetails.isEditable
          : true,
    },
    vesselDetails: {
      // ... all existing vesselDetails code
      id: registrationData?.vesselDetails?.id || "",
      typeOfVessel:
        registrationFormData?.typeOfVessel ||
        registrationData?.vesselDetails?.typeOfVessel ||
        "",
      categoryOfVessel:
        registrationFormData?.categoryOfVessel ||
        registrationData?.vesselDetails?.categoryOfVessel ||
        "",
      zone:
        registrationFormData?.zone ||
        registrationData?.vesselDetails?.zone ||
        "",
      grossTonnage:
        parseInt(formData?.grt) ||
        registrationData?.vesselDetails?.grossTonnage ||
        0,
      workOrderValue:
        formData?.workOrderValue ||
        registrationData?.vesselDetails?.workOrderValue ||
        "",
      purchaseType:
        formData?.purchaseType ||
        registrationData?.vesselDetails?.purchaseType ||
        "",
      supervisionAuthority:
        formData?.supervisionAuthority ||
        registrationData?.vesselDetails?.supervisionAuthority ||
        "",
      nameOfMaster:
        registrationFormData?.nameOfMaster ||
        registrationData?.vesselDetails?.nameOfMaster ||
        "",
      certficateNumber:
        registrationFormData?.certificateNo ||
        registrationData?.vesselDetails?.certficateNumber ||
        "",
      nameOfRegistry:
        registrationFormData?.nameOfRegistry ||
        registrationData?.vesselDetails?.nameOfRegistry ||
        "",
      registrationNumber:
        registrationFormData?.registrationNo ||
        registrationData?.vesselDetails?.registrationNumber ||
        "",
      vesselName:
        registrationFormData?.vesselName ||
        registrationData?.vesselDetails?.vesselName ||
        "",
      kindOfVessel:
        registrationFormData?.kindOfVessel ||
        registrationData?.vesselDetails?.kindOfVessel ||
        "",
      mortgage:
        registrationFormData?.mortgage ||
        registrationData?.vesselDetails?.mortgage ||
        "",
      placeOfBuild:
        registrationFormData?.placeOfBuild ||
        registrationData?.vesselDetails?.placeOfBuild ||
        "",
      insuranceDetails:
        registrationFormData?.detailsOfInsurance ||
        registrationData?.vesselDetails?.insuranceDetails ||
        "",
      yearOfBuild:
        parseInt(registrationFormData?.vesselyearOfBuild) ||
        registrationData?.vesselDetails?.yearOfBuild ||
        null,
      pniClubNo:
        registrationFormData?.protectionAndIndemnityClubNo ||
        registrationData?.vesselDetails?.pniClubNo ||
        "",
      pniClubName:
        registrationFormData?.protectionAndIndemnityClubName ||
        registrationData?.vesselDetails?.pniClubName ||
        "",
      applicationNo:
        id || registrationData?.vesselDetails?.applicationNo || "",
      nameOfClassificationSociety:
        formData?.classificationSociety ||
        registrationData?.vesselDetails?.nameOfClassificationSociety ||
        "",
      iwtVesselBasicDetailsTFk:
        registrationData?.basicDetails?.id ||
        registrationData?.vesselDetails?.iwtVesselBasicDetailsTFk ||
        "",
      insuranceValidDate:
        registrationFormData?.insuranceValidUpto ||
        registrationData?.vesselDetails?.insuranceValidDate ||
        "",
    },
    documents: extractDocuments(formData, registrationData),
    engineDetails: registrationData?.engineDetails
      ? {
          // ... existing engineDetails code
          id: registrationData.engineDetails.id || "",
          yearOfBuild:
            registrationFormData?.yearOfBuild ||
            registrationData.engineDetails.yearOfBuild ||
            "",
          engineType:
            registrationFormData?.typeOfEngine ||
            registrationData.engineDetails.engineType ||
            "",
          engineMake:
            registrationFormData?.engineMake ||
            registrationData.engineDetails.engineMake ||
            "",
          makerAddress:
            registrationFormData?.engineMakerAddress ||
            registrationData.engineDetails.makerAddress ||
            "",
          pin:
            registrationFormData?.enginepin ||
            registrationData.engineDetails.pin ||
            "",
          mobile:
            registrationFormData?.enginephoneNumber ||
            registrationData.engineDetails.mobile ||
            "",
          email:
            registrationFormData?.engineemail ||
            registrationData.engineDetails.email ||
            "",
          horsepower:
            parseFloat(registrationFormData?.horsepower) ||
            registrationData.engineDetails.horsepower ||
            0,
          speed:
            parseFloat(registrationFormData?.speed) ||
            registrationData.engineDetails.speed ||
            0,
          yearOfMake:
            registrationFormData?.yearOfMake ||
            registrationData.engineDetails.yearOfMake ||
            "",
          iwtApplRegistrationTFk:
            registrationData?.basicDetails?.id ||
            registrationData.engineDetails.iwtApplRegistrationTFk ||
            "",
        }
      : {
          id: "",
          yearOfBuild: registrationFormData?.yearOfBuild || "",
          engineType: registrationFormData?.typeOfEngine || "",
          engineMake: registrationFormData?.engineMake || "",
          makerAddress: registrationFormData?.engineMakerAddress || "",
          pin: registrationFormData?.enginepin || "",
          mobile: registrationFormData?.enginephoneNumber || "",
          email: registrationFormData?.engineemail || "",
          horsepower: parseFloat(registrationFormData?.horsepower) || 0,
          speed: parseFloat(registrationFormData?.speed) || 0,
          yearOfMake: registrationFormData?.yearOfMake || "",
          iwtApplRegistrationTFk: registrationData?.basicDetails?.id || "",
        },
    enclosers: extractEnclosers(registrationFormData, registrationData),
  };

  // Add appointmentSlots only if they exist
  if (appointmentSlots && appointmentSlots.length > 0) {
    basePayload.appointmentSlots = appointmentSlots;
  }

  return basePayload;
};
