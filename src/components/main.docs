const collectEntityData = () => {
  // Determine the entity type based on the claim type
  const entityType = 
    claimType === "principalBorrower" ? "PRINCIPAL_BORROWER" :
    claimType === "guarantor" ? "GUARANTOR" :
    "BENEFICIARY";

  // Create entity objects with the type field
  const entities = entityFields.map(entityNum => ({
    id: entityNum,
    name: getValues(`${claimType}Name${entityNum}`) || "",
    address: getValues(`${claimType}Address${entityNum}`) || "",
    type: entityType // This ensures the type field is always included
  }));

  // Store the complete entity data in the form
  setValue("entityData", entities, { shouldValidate: false });
  
  // For debugging - log the complete entity data
  console.log("Entity Data:", JSON.stringify(entities, null, 2));
  
  return entities;
};
