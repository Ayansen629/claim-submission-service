// UserManagement.jsx
import { useNavigate } from "react-router-dom";
import "react-toastify/dist/ReactToastify.css";
import { postData } from "../../../../services/http.service";
import { useTranslation } from "react-i18next";
import { useEffect, useState } from "react";
import ActionTable from "../../../common/ActionTable.tsx";
import { URLS_ENDPOINT } from "../../../../utils/urlsConstants.ts";
import { toast } from "react-toastify";
import ActionModal from "../../../common/ActionModal.tsx";
import {
  APP_MESSAGES,
  CONSTANT_REGEX_SAMPLE,
} from "../../../../utils/constants.ts";
import { FormProvider, useForm } from "react-hook-form";
import { USER_REGIS_MASTER } from "./userManagConst.ts";
import { Card, Row, Col, Button } from "react-bootstrap";
import InputSelect from "../../../common/InputSelect.tsx";
import InputText from "../../../common/InputText.tsx";
import EmployeeRegistrationForm from "../../../common/EmployeeRegistrationForm";

const formData = {
  salutation: "",
  nameAsPerAadhar: "",
  userName: "",
  firstName: "",
  middleName: "",
  lastName: "",
  mobileNumber: "",
  aadharNumber: "",
  password: "",
  plainPassword: "",
  active: true,
  isBlocked: false,
  blockedAt: "",
  alternateMobileNumber: "",
  emailId: "",
  gender: "",
  panNumber: "",
  voterIdNumber: "",
  drivingLicense: "",
  address: "",
  gurdianName: "",
  gurdianRelation: "",
  type: "",
  dob: "",
  ageOnDate: "",
  bloodGroup: "",
  photo: "",
  identificationMark: "",
  nationality: "",
  educationQualification: "",
  individualTypeDesignation: "",
  panAttachmentUrl: "",
  passwordExpiryDate: "",
  rolesCode: "",
  districtName: "",
  blockName: "",
  panchayatName: "",
  projectCode: "",
  projectName: "",
  ifscCode: "",
  bankName: "",
  bankType: "",
};

type EmployeeSearchFormData = {
  empId?: string;
  empName?: string;
  designation?: string;
  status?: string;
  phoneNumber?: string;
};

const UserManagement = () => {
  const { t } = useTranslation();
  let navigate = useNavigate();
  const [rowData, setRowData] = useState([]);
  const [modal, setModal] = useState(false);
  const [modalAction, setModalAction] = useState("");
  const [userFormData, setuserFormData] = useState(formData);
  const [modalTitle, setModalTitle] = useState(t("Add Employee"));
  const [isLoading, setIsLoading] = useState(false);

  const {
    register,
    handleSubmit,
    watch,
    reset,
    setValue,
    formState: { errors },
  } = useForm<EmployeeSearchFormData>();

  const methods = useForm({
    defaultValues: {
      personal: {
        firstName: "",
        lastName: "",
        email: "",
        phoneNumber: "",
        gender: "",
        dob: ""
      },
      address: {
        line1: "",
        line2: "",
        pin: "",
        district: "",
        state: "",
        country: ""
      },
      educationDetails: [{
        qualification: "",
        stream: "",
        yearOfPassing: ""
      }],
      professional: {
        appointmentDate: "",
        employeeType: "",
        employeeStatus: "",
        designation: "",
        department: "",
        section: "",
        roles: ""
      },
      documents: {
        addressProof: null,
        identityProof: null,
        appointmentLetter: null
      }
    }
  });

  useEffect(() => {
    setuserFormData([]);
    getUserDetails();
  }, []);

  const columns = USER_REGIS_MASTER.USER_INFO_COLUMNS;
  const userMockData = USER_REGIS_MASTER.MOCK_USER_DATA;

  const getUserDetails = async () => {
    setIsLoading(true);
    try {
      // Use the mock data from USER_REGIS_MASTER
      setTimeout(() => {
        setRowData(userMockData);
        setIsLoading(false);
      }, 500);
    } catch (error) {
      console.error("Error fetching user details:", error);
      toast.error(t("Error fetching user details"));
      setIsLoading(false);
    }
  };

  const handleRowClick = (e) => {};

  const handleBtnClick = () => {
    // Reset form data before opening modal
    methods.reset();
    setModalTitle(t("Add Employee"));
    setModal(true);
  };

  const handleEditRow = (e) => {
    setModalTitle(t("Edit Employee"));
    setuserFormData(e);
    
    // Populate form with existing data
    const { firstName, lastName, email } = e;
    methods.reset({
      personal: {
        firstName,
        lastName,
        email,
        // Add other fields as needed
      },
      // Add other sections as needed
    });
    
    setModal(true);
  };

  const Toggle = () => {
    setuserFormData(formData);
    setModal(false); // Ensure modal closes
  };

  const onSubmitFilterForm = async (e) => {
    if (e && Object.keys(e).length > 0) {
      console.log("Filter form submitted:", e);
      // Implement filter logic here
    }
  };

  const handleFormSubmit = async (data) => {
    try {
      console.log("Form submitted with data:", JSON.stringify(data, null, 2));
      
      // Create FormData object for file uploads
      const formDataObj = new FormData();
      
      // Handle nested objects and arrays
      Object.entries(data).forEach(([key, value]) => {
        if (key === "documents") {
          // Handle file uploads
          Object.entries(value).forEach(([docKey, docFile]) => {
            if (docFile && docFile[0]) {
              formDataObj.append(docKey, docFile[0]);
            }
          });
        } else if (typeof value === 'object' && value !== null) {
          // Handle nested objects by stringifying them
          formDataObj.append(key, JSON.stringify(value));
        } else {
          formDataObj.append(key, value);
        }
      });
      
      // Log the FormData entries for debugging
      for (let pair of formDataObj.entries()) {
        console.log(pair[0] + ': ' + pair[1]);
      }

      // Submit formData to your API
      // await postData("your-api-endpoint", formDataObj);
      toast.success("Employee registered successfully!");
      setModal(false); // Close modal after successful submission
    } catch (error) {
      console.error("Error submitting form:", error);
      toast.error("Error submitting form");
    }
  };

  return (
    <>
      <div className="w-full">
        <Card>
          <form
            style={{ padding: "2rem", margin: 0 }}
            onSubmit={handleSubmit(onSubmitFilterForm)}
          >
            <Row>
              <Col md={2}>
                <InputText
                  type="text"
                  name="empId"
                  maxlength={10}
                  label="Employee Id"
                  placeholder="Enter Employee Id"
                  register={{
                    ...register("empId", {}),
                  }}
                  errors={errors}
                  onKeyDown={(e) => {
                    if (!/^\d$/.test(e.key)) {
                      e.preventDefault();
                    }
                  }}
                />
              </Col>

              <Col md={2}>
                <InputText
                  type="text"
                  name="empName"
                  label="Employee Name"
                  placeholder="Enter employee name"
                  register={{
                    ...register("empName", {}),
                  }}
                  errors={errors}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label="Designation"
                  name="designation"
                  options={[
                    { value: 1, label: "Senior Engg" },
                    { value: 2, label: "Junior Engg" },
                    { value: 3, label: "Vessel Owner" },
                  ]}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected Desig :", val)}
                />
              </Col>

              <Col md={2}>
                <InputSelect
                  label="Status"
                  name="status"
                  options={[
                    { value: "active", label: "Active" },
                    { value: "inactive", label: "Inactive" },
                  ]}
                  register={register}
                  errors={errors}
                  defaultValue={""}
                  onChange={(val) => console.log("Selected:", val)}
                />
              </Col>

              <Col md={2}>
                <InputText
                  type="text"
                  name="phoneNumber"
                  label="Phone Number"
                  maxlength={10}
                  placeholder="Enter Phone Number"
                  register={{
                    ...register("phoneNumber", {}),
                  }}
                  onKeyDown={(e) => {
                    if (!/^\d$/.test(e.key)) {
                      e.preventDefault();
                    }
                  }}
                  errors={errors}
                />
              </Col>

              <Col
                md={2}
                style={{ display: "flex", position: "relative", top: "2rem" }}
              >
                <Col>
                  <button className="generic-btn-submit" type="submit">
                    Filter
                  </button>
                </Col>
                &nbsp;&nbsp;
                <Col>
                  <button
                    className="generic-btn-cancel"
                    type="reset"
                    onClick={() => {
                      reset();
                    }}
                  >
                    {t("login.reset")}
                  </button>
                </Col>
              </Col>
            </Row>
            <Row className="mt-2">
              <Col md={{ span: 2, offset: 10 }} className="d-flex justify-content-end">
                <button
                  className="generic-btn-submit"
                  type="button"
                  onClick={handleBtnClick}
                >
                  <i className="fa fa-plus" aria-hidden="true"></i> {t("Add")}
                </button>
              </Col>
            </Row>
          </form>
        </Card>
        <>
          <ActionTable
            tableHeader="Employee List"
            columns={columns}
            rowData={rowData}
            additionalMethod={handleRowClick}
            showCustomBtn={true}
            btnName={t("Add")}
            handleBtnClick={handleBtnClick}
            handleEditRow={handleEditRow}
            hideExportBtn={true}
            searchBarPlaceholder={t("Table.SEARCH_BY")}
          />
        </>

        <ActionModal
          show={modal}
          close={Toggle}
          title={modalTitle}
          action={modalAction}
          isFooterHide={true}
          size={"lg"}
        >
          <FormProvider {...methods}>
            <form onSubmit={methods.handleSubmit(handleFormSubmit)}>
              <EmployeeRegistrationForm />
              <div className="d-flex justify-content-end mt-4 gap-2">
                <Button 
                  variant="secondary" 
                  onClick={Toggle}
                  className="cancel-btn"
                >
                  Cancel
                </Button>
                <Button 
                  variant="primary" 
                  type="submit"
                  className="submit-btn"
                  style={{
                    background: 'linear-gradient(135deg, #0077b6, #023e8a)',
                    border: 'none',
                    boxShadow: '0 4px 6px rgba(0, 0, 0, 0.1)',
                    padding: '8px 20px'
                  }}
                >
                  Submit
                </Button>
              </div>
            </form>
          </FormProvider>
        </ActionModal>
      </div>
    </>
  );
};

export default UserManagement;

