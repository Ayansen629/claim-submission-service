// ... (previous imports remain the same)

const ActionTable = (props) => {
    // ... (previous state and functions remain the same until the return statement)

    return (
        // ... (previous JSX remains the same until the tbody section)

                    <tbody>
                        {currentItems.length > 0 ? (
                            currentItems.map((row, index) => (
                                <tr 
                                    key={row.id} 
                                    className={`${isSelected(row.id) ? 'selected-row' : ''} ${index % 2 === 0 ? 'even-row' : 'odd-row'}`} 
                                    style={{ borderBottom: '1px solid #e9ecef' }}
                                >
                                    {/* ... (rest of the row content remains the same) */}
                                </tr>
                            ))
                        ) : (
                            // ... (no records found row remains the same)
                        )}
                    </tbody>

        // ... (rest of the component remains the same)

            <style jsx>{`
                /* ... (previous styles remain the same) */

                /* Add these new styles for the table rows */
                tbody tr.even-row {
                    background-color: #ffffff;
                }
                
                tbody tr.odd-row {
                    background-color: #f8f9fa;
                }
                
                tbody tr:hover {
                    background-color: #e9f5ff !important;
                }
                
                tbody tr.selected-row {
                    background-color: #d1e7ff !important;
                }
                
                /* Make sure the hover and selected states override the alternating colors */
                tbody tr.even-row:hover,
                tbody tr.odd-row:hover,
                tbody tr.even-row.selected-row,
                tbody tr.odd-row.selected-row {
                    background-color: #e9f5ff !important;
                }

                /* ... (rest of the styles remain the same) */
            `}</style>
    );
};

export default ActionTable;
