import React, { useState, useEffect, useCallback, useMemo } from "react";
import { useForm, FormProvider, Controller } from "react-hook-form";
import Collapsible from "../formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip";
import {
  FaInfoCircle,
  FaPlus,
  FaMinus,
  FaFileAlt,
  FaMoneyBillWave,
  FaCalendarAlt,
  FaHandshake,
  FaBalanceScale,
  FaUniversity,
  FaLandmark,
  FaMapMarkerAlt,
  FaCity,
  FaGlobeAmericas,
} from "react-icons/fa";
import { GiBank } from "react-icons/gi";
import { BsBank2, BsBuilding } from "react-icons/bs";
import axios from "axios";
import "./FormC.css";

// DynamicField Component
const DynamicField = ({
  fieldConfig,
  control,
  register,
  errors,
  setValue,
  getValues,
  watch,
}) => {
  const { name, label, type, options, rules, tooltip, placeholder, rows, show } =
    fieldConfig;
  const hasError = errors[name];

  const handleRadioChange = (value) => {
    setValue(name, value, { shouldValidate: true });
    if (fieldConfig.onChange) fieldConfig.onChange(value);
  };

  if (show !== undefined && !show) return null;

  return (
    <div className={`form-group ${type === "radio" ? "radio-group-container" : ""}`}>
      <label className="form-label">
        {label}
        {rules?.required && <span className="required-asterisk">*</span>}
        {tooltip && (
          <Tooltip title={tooltip} arrow>
            <span className="form-tooltip">
              <FaInfoCircle />
            </span>
          </Tooltip>
        )}
      </label>
      {type === "select" ? (
        <select
          {...register(name, rules)}
          className={`form-control ${hasError ? "is-invalid" : ""}`}
          onChange={(e) => {
            setValue(name, e.target.value, { shouldValidate: true });
            if (fieldConfig.onChange) fieldConfig.onChange(e.target.value);
          }}
        >
          {options.map((option) => (
            <option key={option.value} value={option.value} disabled={option.disabled}>
              {option.label}
            </option>
          ))}
        </select>
      ) : type === "radio" ? (
        <div className="radio-group">
          {options.map((option) => (
            <label key={option.value} className="radio-option">
              <input
                type="radio"
                {...register(name, rules)}
                value={option.value}
                checked={watch(name) === option.value}
                onChange={() => handleRadioChange(option.value)}
                className="radio-input"
              />
              <span className="radio-label">{option.label}</span>
            </label>
          ))}
        </div>
      ) : type === "textarea" ? (
        <textarea
          {...register(name, rules)}
          className={`form-control ${hasError ? "is-invalid" : ""}`}
          rows={rows || 3}
          placeholder={placeholder}
        />
      ) : type === "date" ? (
        <input
          {...register(name, rules)}
          type="date"
          className={`form-control ${hasError ? "is-invalid" : ""}`}
          placeholder={placeholder}
        />
      ) : (
        <input
          {...register(name, rules)}
          type={type}
          className={`form-control ${hasError ? "is-invalid" : ""}`}
          placeholder={placeholder}
        />
      )}
      {hasError && <div className="invalid-feedback">{errors[name]?.message}</div>}
    </div>
  );
};

// IFSC Search Component
const IFSCSearch = ({ fieldConfig, register, errors, setValue, trigger }) => {
  const [bankDetails, setBankDetails] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);

  const fetchBankDetails = async (ifsc) => {
    if (ifsc.length < 4) return;
    setLoading(true);
    setError(null);
    try {
      const response = await axios.get(`https://ifsc.razorpay.com/ ${ifsc}`);
      setBankDetails(response.data);
      setValue("bankName", response.data.BANK, { shouldValidate: true });
      setValue("branchName", response.data.BRANCH, { shouldValidate: true });
      setValue(
        "branchAddress",
        `${response.data.ADDRESS}, ${response.data.CITY}, ${response.data.STATE}`,
        { shouldValidate: true }
      );
      setValue("city", response.data.CITY, { shouldValidate: true });
      setValue("state", response.data.STATE, { shouldValidate: true });
      setValue("district", response.data.DISTRICT, { shouldValidate: true });
      await Promise.all([
        trigger("bankName"),
        trigger("branchName"),
        trigger("branchAddress"),
        trigger("city"),
        trigger("state"),
        trigger("district"),
      ]);
    } catch (err) {
      setError("Invalid IFSC code or failed to fetch details");
      setBankDetails(null);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="form-group">
      <label className="form-label">
        {fieldConfig.label}
        {fieldConfig.rules?.required && <span className="required-asterisk">*</span>}
      </label>
      <input
        {...register(fieldConfig.name, fieldConfig.rules)}
        type="text"
        className={`form-control ${errors[fieldConfig.name] ? "is-invalid" : ""}`}
        placeholder={fieldConfig.placeholder}
        onChange={(e) => {
          setValue(fieldConfig.name, e.target.value.toUpperCase(), {
            shouldValidate: true,
          });
          trigger(fieldConfig.name);
          fetchBankDetails(e.target.value);
        }}
      />
      {loading && <div className="loading-indicator">Loading bank details...</div>}
      {error && <div className="invalid-feedback">{error}</div>}
      {errors[fieldConfig.name] && (
        <div className="invalid-feedback">{errors[fieldConfig.name].message}</div>
      )}
    </div>
  );
};

// ClaimTypeFields Component
const ClaimTypeFields = ({
  claimType,
  control,
  register,
  errors,
  setValue,
  getValues,
  watch,
  trigger,
}) => {
  const hasSecurityInterest = watch("hasSecurityInterest");
  const hasGuarantee = watch("hasGuarantee");

  const [showSecurityFields, setShowSecurityFields] = useState(
    hasSecurityInterest === "yes"
  );
  const [showGuaranteeFields, setShowGuaranteeFields] = useState(
    hasGuarantee === "yes"
  );

  // Initialize entity fields based on existing data
  const initialEntityFields = useMemo(() => {
    const currentEntityData = getValues("entityData") || [];
    return currentEntityData.map((_, index) => index + 1);
  }, [getValues]);

  const [entityFields, setEntityFields] = useState(initialEntityFields);

  useEffect(() => {
    setShowSecurityFields(hasSecurityInterest === "yes");
    setShowGuaranteeFields(hasGuarantee === "yes");
  }, [hasSecurityInterest, hasGuarantee]);

  const handleSecurityInterestChange = (value) => {
    setShowSecurityFields(value === "yes");
    if (value === "no") {
      setValue("securityValue", "", { shouldValidate: false });
      setValue("securityDate", "", { shouldValidate: false });
    }
  };

  const handleGuaranteeChange = (value) => {
    setShowGuaranteeFields(value === "yes");
    if (value === "no") {
      setValue("guaranteeValue", "", { shouldValidate: false });
      setValue("guaranteeDate", "", { shouldValidate: false });
    }
  };

  // Collect entity data into array and update form state
  const collectEntityData = useCallback(() => {
    const entityType = claimType === "PRINCIPAL_BORROWER" ? "GUARANTOR" : "PRINCIPAL_BORROWER";

    const entities = entityFields.map((entityNum) => {
      const name = getValues(`${claimType}Name${entityNum}`);
      const address = getValues(`${claimType}Address${entityNum}`);

      if (name) {
        return {
          id: entityNum,
          name: name || "",
          address: address || "",
          type: entityType,
        };
      }
      return null;
    }).filter(Boolean);

    setValue("entityData", entities, { shouldValidate: true });
    return entities;
  }, [claimType, entityFields, getValues, setValue]);

  // Add new entity field
  const addEntityField = useCallback(() => {
    const newIndex = (entityFields.length > 0 ? Math.max(...entityFields) : 0) + 1;
    setEntityFields([...entityFields, newIndex]);
  }, [entityFields]);

  // Remove entity field
  const removeEntityField = useCallback(
    async (index) => {
      if (entityFields.length <= 1) return;
      const entityNumToRemove = entityFields[index];
      const newFields = entityFields.filter((_, i) => i !== index);
      setEntityFields(newFields);

      const currentEntityData = getValues("entityData") || [];
      const updatedEntityData = currentEntityData.filter(
        (entity) => entity.id !== entityNumToRemove
      );

      setValue("entityData", updatedEntityData, { shouldValidate: true });
      await trigger();
    },
    [entityFields, getValues, setValue, trigger]
  );

  // Watch for changes and update entityData
  useEffect(() => {
    const subscription = watch((value, { name }) => {
      if (name && (name.includes("Name") || name.includes("Address"))) {
        collectEntityData();
      }
    });
    return () => subscription.unsubscribe();
  }, [watch, collectEntityData]);

  useEffect(() => {
    collectEntityData();
  }, []);

  const commonClaimFields = [
    {
      name: "claimAmount",
      label: "Amount of claim",
      type: "number",
      rules: {
        required: "Claim amount is required",
        min: { value: 1, message: "Amount must be greater than 0" },
      },
      placeholder: "Enter claim amount",
    },
  ];

  const additionalFields = [
    {
      name: "hasSecurityInterest",
      label: "Amount of claim covered by security interest",
      type: "radio",
      options: [
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" },
      ],
      rules: { required: "This field is required" },
      onChange: handleSecurityInterestChange,
      show: claimType !== "BENEFICIARY",
    },
    {
      name: "securityValue",
      label: "Value of the security",
      type: "number",
      rules: showSecurityFields
        ? {
            required: "Security value is required",
            min: { value: 1, message: "Value must be greater than 0" },
          }
        : {},
      placeholder: "Enter security value",
      show: showSecurityFields && claimType !== "BENEFICIARY",
    },
    {
      name: "securityDate",
      label: "Date of the security",
      type: "date",
      rules: showSecurityFields
        ? {
            required: "Security date is required",
            validate: (value) => {
              const today = new Date().toISOString().split("T")[0];
              return value <= today || "Date cannot be in the future";
            },
          }
        : {},
      placeholder: "Select security date",
      show: showSecurityFields && claimType !== "BENEFICIARY",
    },
    {
      name: "hasGuarantee",
      label: "Amount of claim covered by guarantee",
      type: "radio",
      options: [
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" },
      ],
      rules: { required: "This field is required" },
      onChange: handleGuaranteeChange,
      show: claimType !== "BENEFICIARY",
    },
    {
      name: "guaranteeValue",
      label: "Value of the guarantee",
      type: "number",
      rules: showGuaranteeFields
        ? {
            required: "Guarantee value is required",
            min: { value: 1, message: "Value must be greater than 0" },
          }
        : {},
      placeholder: "Enter guarantee value",
      show: showGuaranteeFields && claimType !== "BENEFICIARY",
    },
    {
      name: "guaranteeDate",
      label: "Date of the guarantee",
      type: "date",
      rules: showGuaranteeFields
        ? {
            required: "Guarantee date is required",
            validate: (value) => {
              const today = new Date().toISOString().split("T")[0];
              return value <= today || "Date cannot be in the future";
            },
          }
        : {},
      placeholder: "Select guarantee date",
      show: showGuaranteeFields && claimType !== "BENEFICIARY",
    },
  ];

  const getEntityFieldLabels = () => {
    switch (claimType) {
      case "PRINCIPAL_BORROWER":
        return {
          nameLabel: "Name of the guarantor",
          addressLabel: "Address of the guarantor",
        };
      case "GUARANTOR":
        return {
          nameLabel: "Name of the Principal Borrower",
          addressLabel: "Address of the Principal Borrower",
        };
      default:
        return {
          nameLabel: "Name",
          addressLabel: "Address",
        };
    }
  };

  const { nameLabel, addressLabel } = getEntityFieldLabels();

  return (
    <div className="form-section">
      {commonClaimFields.map((field) => (
        <DynamicField
          key={field.name}
          fieldConfig={field}
          control={control}
          register={register}
          errors={errors}
          setValue={setValue}
          getValues={getValues}
          watch={watch}
        />
      ))}
      {additionalFields.map((field) => (
        <DynamicField
          key={field.name}
          fieldConfig={field}
          control={control}
          register={register}
          errors={errors}
          setValue={setValue}
          getValues={getValues}
          watch={watch}
        />
      ))}

      {entityFields.map((entityNum, index) => (
        <div key={entityNum} className="entity-field-group">
          <div className="entity-field-row">
            <DynamicField
              fieldConfig={{
                name: `${claimType}Name${entityNum}`,
                label: `${nameLabel} ${entityNum}`,
                type: "text",
                rules: { required: "This field is required" },
                placeholder: `Enter ${nameLabel.toLowerCase()} ${entityNum}`,
              }}
              control={control}
              register={register}
              errors={errors}
              setValue={setValue}
              getValues={getValues}
              watch={watch}
            />
            {index > 0 && (
              <button
                type="button"
                className="btn btn-danger btn-sm remove-entity-btn"
                onClick={() => removeEntityField(index)}
                aria-label={`Remove ${nameLabel} ${entityNum}`}
                title={`Remove ${nameLabel} ${entityNum}`}
              >
                <FaMinus />
              </button>
            )}
          </div>
          <DynamicField
            fieldConfig={{
              name: `${claimType}Address${entityNum}`,
              label: `${addressLabel} ${entityNum}`,
              type: "text",
              rules: { required: "This field is required" },
              placeholder: `Enter ${addressLabel.toLowerCase()} ${entityNum}`,
            }}
            control={control}
            register={register}
            errors={errors}
            setValue={setValue}
            getValues={getValues}
            watch={watch}
          />
        </div>
      ))}

      <button
        type="button"
        className="btn btn-outline-primary btn-sm add-more-btn"
        onClick={addEntityField}
      >
        <FaPlus />{" "}
        {claimType === "GUARANTOR" ? "Principal Borrower" : "Guarantor"}
      </button>
    </div>
  );
};

// Main FormCDetails Component
const FormCDetails = ({ provideSubmitHandler, formData, onValidationComplete }) => {
  const methods = useForm({ mode: "onChange" });
  const {
    register,
    handleSubmit,
    formState: { errors, isValid },
    control,
    setValue,
    getValues,
    watch,
    reset,
    trigger,
  } = methods;

  const [selectedClaimType, setSelectedClaimType] = useState("");

  const onSubmit = useCallback(async () => {
    const isValid = await trigger();
    if (!isValid) {
      console.error("Validation failed");
      return false;
    }

    // Get raw form values
    const formValues = getValues();

    // Filter out unnecessary dynamic fields
    const cleanedFormValues = Object.keys(formValues).reduce((acc, key) => {
      if (!/^(PRINCIPAL_BORROWER|GUARANTOR)(Name|Address)\d+$/.test(key)) {
        acc[key] = formValues[key];
      }
      return acc;
    }, {});

    // Log final form data (only entityData included)
    console.log("Cleaned Form Data:", cleanedFormValues);

    return cleanedFormValues;
  }, [trigger, getValues]);

  useEffect(() => {
    if (formData) {
      Object.keys(formData).forEach((key) => {
        setValue(key, formData[key]);
      });
      if (formData.claimType) {
        setSelectedClaimType(formData.claimType);
      }
    }
  }, [formData, setValue]);

  const handleClaimTypeChange = async (value) => {
    setSelectedClaimType(value);
    const baseReset = {
      claimType: value,
      claimAmount: "",
      hasSecurityInterest: "",
      hasGuarantee: "",
      securityValue: "",
      securityDate: "",
      guaranteeValue: "",
      guaranteeDate: "",
    };

    reset(baseReset);
    await trigger();
  };

  const getClaimTitle = () => {
    switch (selectedClaimType) {
      case "PRINCIPAL_BORROWER":
        return " Corporate Debtor as Principal Borrower";
      case "GUARANTOR":
        return " Corporate Debtor as Guarantor";
      case "BENEFICIARY":
        return " Financial Debt Covered";
      default:
        return "Claim Details";
    }
  };

  useEffect(() => {
    if (provideSubmitHandler) {
      provideSubmitHandler(onSubmit);
    }
  }, [provideSubmitHandler, onSubmit]);

  const bankAccountFields = [
    {
      name: "accountNumber",
      label: "Account Number",
      type: "text",
      rules: {
        required: "Account number is required",
        pattern: {
          value: /^[0-9]{9,18}$/,
          message: "Account number must be 9-18 digits",
        },
      },
      placeholder: "Enter account number",
    },
    {
      name: "ifscCode",
      label: "IFSC Code",
      type: "text",
      rules: {
        required: "IFSC code is required",
        pattern: {
          value: /^[A-Za-z]{4}0[A-Za-z0-9]{6}$/,
          message: "Invalid IFSC code format (e.g., ABCD0123456)",
        },
      },
      placeholder: "Enter IFSC code (e.g., ABCD0123456)",
      component: IFSCSearch,
    },
    {
      name: "bankName",
      label: "Bank Name",
      type: "text",
      rules: { required: "Bank name is required" },
      placeholder: "Enter bank name",
    },
    {
      name: "branchName",
      label: "Branch Name",
      type: "text",
      rules: { required: "Branch name is required" },
      placeholder: "Enter branch name",
    },
    {
      name: "branchAddress",
      label: "Branch Address",
      type: "text",
      rules: { required: "Branch address is required" },
      placeholder: "Enter branch address",
    },
    {
      name: "city",
      label: "City",
      type: "text",
      rules: { required: "City is required" },
      placeholder: "Enter city",
    },
    {
      name: "state",
      label: "State",
      type: "text",
      rules: { required: "State is required" },
      placeholder: "Enter state",
    },
    {
      name: "district",
      label: "District",
      type: "text",
      rules: { required: "District is required" },
      placeholder: "Enter district",
    },
  ];

  const claimTypeOptions = [
    { value: "", label: "Select Claim Type", disabled: true },
    { value: "PRINCIPAL_BORROWER", label: "Corporate Debtor as Principal Borrower" },
    { value: "GUARANTOR", label: "Corporate Debtor as Guarantor" },
    { value: "BENEFICIARY", label: "Financial Debt Covered" },
  ];

  return (
    <FormProvider {...methods}>
      <form className="form-stepper">
        {/* Claim Details Section */}
        <div className="form-section-container">
          <Collapsible
            title={
              <div className="section-header">
                <FaFileAlt className="section-icon" />
                <span>Details of Claim</span>
              </div>
            }
            defaultOpen={true}
          >
            <div className="form-grid">
              {/* Claim Type Dropdown */}
              <div className="form-group">
                <label className="form-label">
                  <FaMoneyBillWave className="field-icon" />
                  Select Claim Type <span className="required-asterisk">*</span>
                </label>
                <select
                  {...register("claimType", { required: "Claim type is required" })}
                  className={`form-control ${errors.claimType ? "is-invalid" : ""}`}
                  onChange={(e) => handleClaimTypeChange(e.target.value)}
                  value={selectedClaimType}
                >
                  {claimTypeOptions.map((option) => (
                    <option key={option.value} value={option.value} disabled={option.disabled}>
                      {option.label}
                    </option>
                  ))}
                </select>
                {errors.claimType && (
                  <div className="invalid-feedback">{errors.claimType.message}</div>
                )}
              </div>

              {/* Claim Type Specific Fields */}
              {selectedClaimType && (
                <ClaimTypeFields
                  claimType={selectedClaimType}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  getValues={getValues}
                  watch={watch}
                  trigger={trigger}
                />
              )}

              {/* Details of How Debt Incurred */}
              <div className="form-group">
                <label className="form-label">
                  <FaFileAlt className="field-icon" />
                  Details of how debt incurred{" "}
                  <span className="required-asterisk">*</span>
                </label>
                <textarea
                  {...register("debtDetails", { required: "This field is required" })}
                  className={`form-control ${errors.debtDetails ? "is-invalid" : ""}`}
                  placeholder="Enter details of how debt was incurred"
                  rows={3}
                />
                {errors.debtDetails && (
                  <div className="invalid-feedback">{errors.debtDetails.message}</div>
                )}
              </div>

              {/* Date of Debt Incurred */}
              <div className="form-group">
                <label className="form-label">
                  <FaCalendarAlt className="field-icon" />
                  Date of debt incurred{" "}
                  <span className="required-asterisk">*</span>
                </label>
                <input
                  {...register("debtDate", {
                    required: "This field is required",
                    validate: (value) => {
                      const today = new Date().toISOString().split("T")[0];
                      return value <= today || "Date cannot be in the future";
                    },
                  })}
                  type="date"
                  className={`form-control ${errors.debtDate ? "is-invalid" : ""}`}
                  placeholder="Select date"
                />
                {errors.debtDate && (
                  <div className="invalid-feedback">{errors.debtDate.message}</div>
                )}
              </div>

              {/* Mutual Dealings */}
              <div className="form-group full-width">
                <label className="form-label">
                  <FaHandshake className="field-icon" />
                  Details of any mutual credit, mutual debts, or other mutual dealings
                </label>
                <textarea
                  {...register("mutualDetails")}
                  className="form-control"
                  placeholder="Enter details of any mutual dealings"
                  rows={5}
                />
              </div>
            </div>
          </Collapsible>
        </div>

        {/* Bank Account Details Section */}
        <div className="form-section-container">
          <Collapsible
            title={
              <div className="section-header">
                <BsBank2 className="section-icon" />
                <span>Bank Account Details</span>
              </div>
            }
            defaultOpen={true}
          >
            <div className="form-grid">
              {bankAccountFields.map((field) =>
                field.component ? (
                  <field.component
                    key={field.name}
                    fieldConfig={field}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    trigger={trigger}
                  />
                ) : (
                  <div key={field.name} className="form-group">
                    <label className="form-label">
                      {field.name === "accountNumber" && (
                        <FaUniversity className="field-icon" />
                      )}
                      {field.name === "ifscCode" && <GiBank className="field-icon" />}
                      {field.name === "bankName" && (
                        <FaLandmark className="field-icon" />
                      )}
                      {field.name === "branchName" && (
                        <BsBuilding className="field-icon" />
                      )}
                      {field.name === "branchAddress" && (
                        <FaMapMarkerAlt className="field-icon" />
                      )}
                      {field.name === "city" && <FaCity className="field-icon" />}
                      {field.name === "state" && (
                        <FaGlobeAmericas className="field-icon" />
                      )}
                      {field.name === "district" && (
                        <FaMapMarkerAlt className="field-icon" />
                      )}
                      {field.label} {field.rules?.required && <span className="required-asterisk">*</span>}
                    </label>
                    <input
                      {...register(field.name, field.rules)}
                      type={field.type || "text"}
                      className={`form-control ${errors[field.name] ? "is-invalid" : ""}`}
                      placeholder={field.placeholder}
                    />
                    {errors[field.name] && (
                      <div className="invalid-feedback">{errors[field.name].message}</div>
                    )}
                  </div>
                )
              )}
            </div>
          </Collapsible>
        </div>
      </form>
    </FormProvider>
  );
};

export default FormCDetails;
