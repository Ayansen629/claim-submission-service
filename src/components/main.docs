import React from "react";
import { Card, Row, Col, Table, Button } from "react-bootstrap";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";
import { BsReceipt, BsCurrencyRupee } from "react-icons/bs";

const Invoicing = ({ supervisionAuthority, onPayNow }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();

  // Mock invoice data based on supervision authority
  const getInvoiceData = () => {
    if (supervisionAuthority === "iwt") {
      return {
        invoiceBreakupInfo: [
          { id: "1", label: "Drawing Approval Fee", amount: 1000.0 },
          { id: "2", label: "Supervision Fee", amount: 10000.0 },
          { id: "3", label: "Processing Fees", amount: 500.0 },
          { id: "4", label: "Documentation Charges", amount: 300.0 }
        ],
        summary: {
          subTotal: 11800.0,
          cgst: 1062.0,
          sgst: 1062.0,
          totalPayable: 13924.0
        }
      };
    } else if (supervisionAuthority === "classificationSociety") {
      return {
        invoiceBreakupInfo: [
          { id: "1", label: "Drawing Scrutiny Fee", amount: 500.0 },
          { id: "2", label: "Processing Fees", amount: 300.0 },
          { id: "3", label: "Documentation Charges", amount: 200.0 }
        ],
        summary: {
          subTotal: 1000.0,
          cgst: 90.0,
          sgst: 90.0,
          totalPayable: 1180.0
        }
      };
    }
    
    // Default comprehensive invoice
    return {
      invoiceBreakupInfo: [
        { id: "1", label: "Tonnage Fees", amount: 2000.0 },
        { id: "2", label: "Registration Charges", amount: 1500.0 },
        { id: "3", label: "Survey Fees", amount: 1200.0 },
        { 
          id: "4", 
          label: "Inspection Charges", 
          components: [
            { name: "Initial", amount: 800.0 },
            { name: "Follow-up", amount: 400.0 }
          ]
        },
        { id: "5", label: "Processing Fees", amount: 500.0 },
        { 
          id: "6", 
          label: "Port Clearance Tax", 
          components: [
            { name: "Primary", amount: 1000.0 },
            { name: "Additional", amount: 300.0 }
          ]
        },
        { id: "7", label: "Manning Certification Fees", amount: 750.0 },
        { id: "8", label: "Environmental Cess", amount: 350.0 },
        { id: "9", label: "Duplicate Certificate Fees", amount: 250.0 }
      ],
      summary: {
        subTotal: 9250.0,
        cgst: 832.5,
        sgst: 832.5,
        totalPayable: 10915.0
      }
    };
  };

  const invoiceData = getInvoiceData();

  const formatCurrency = (amount) => {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      minimumFractionDigits: 2
    }).format(amount);
  };

  return (
    <div className="container py-4">
      <div className="d-flex align-items-center mb-4">
        <BsReceipt size={24} className="text-primary me-2" />
        <h2 className="mb-0" style={{ color: "#2466BF", fontWeight: 600 }}>
          {t("Invoice Details")}
        </h2>
      </div>

      <Row className="justify-content-center">
        <Col lg={10} xl={8}>
          {/* Invoice Header */}
          <Card className="shadow-sm mb-4">
            <Card.Header 
              className="text-white py-3"
              style={{ background: "linear-gradient(135deg, #2466bf 0%, #1a4fa0 100%)" }}
            >
              <div className="d-flex justify-content-between align-items-center">
                <div>
                  <h5 className="mb-1 text-white">{t("Fee Breakdown")}</h5>
                  <small className="text-white-50">
                    {supervisionAuthority === "iwt" ? t("IWT Authority") : 
                     supervisionAuthority === "classificationSociety" ? t("Classification Society") : 
                     t("Standard Charges")}
                  </small>
                </div>
                <BsCurrencyRupee size={24} />
              </div>
            </Card.Header>

            <Card.Body className="p-0">
              <Table responsive className="mb-0">
                <thead className="bg-light">
                  <tr>
                    <th className="py-3 px-4 border-0">{t("Description")}</th>
                    <th className="py-3 px-4 text-end border-0">{t("Amount")}</th>
                  </tr>
                </thead>
                <tbody>
                  {invoiceData.invoiceBreakupInfo.map((item) => (
                    <React.Fragment key={item.id}>
                      <tr>
                        <td className="py-3 px-4 fw-semibold">
                          {t(item.label)}
                        </td>
                        <td className="py-3 px-4 text-end fw-semibold">
                          {item.amount ? formatCurrency(item.amount) : ''}
                        </td>
                      </tr>
                      {item.components && item.components.map((component, idx) => (
                        <tr key={`${item.id}-${idx}`} className="bg-light bg-opacity-50">
                          <td className="py-2 px-4 ps-5 text-muted">
                            <small>• {t(component.name)}</small>
                          </td>
                          <td className="py-2 px-4 text-end text-muted">
                            <small>{formatCurrency(component.amount)}</small>
                          </td>
                        </tr>
                      ))}
                    </React.Fragment>
                  ))}
                </tbody>
              </Table>
            </Card.Body>
          </Card>

          {/* Summary Card */}
          <Card className="shadow-sm">
            <Card.Body className="p-4">
              <h5 className="text-primary mb-3 fw-bold">{t("Payment Summary")}</h5>
              
              <div className="row">
                <div className="col-md-8">
                  <div className="d-flex justify-content-between py-2">
                    <span>{t("Sub Total")}:</span>
                    <span className="fw-semibold">{formatCurrency(invoiceData.summary.subTotal)}</span>
                  </div>
                  <div className="d-flex justify-content-between py-2">
                    <span>{t("CGST")} (9%):</span>
                    <span className="fw-semibold">{formatCurrency(invoiceData.summary.cgst)}</span>
                  </div>
                  <div className="d-flex justify-content-between py-2 border-bottom">
                    <span>{t("SGST")} (9%):</span>
                    <span className="fw-semibold">{formatCurrency(invoiceData.summary.sgst)}</span>
                  </div>
                  <div className="d-flex justify-content-between py-3">
                    <span className="fw-bold fs-5 text-primary">{t("Total Payable")}:</span>
                    <span className="fw-bold fs-5 text-success">{formatCurrency(invoiceData.summary.totalPayable)}</span>
                  </div>
                </div>
                
                <div className="col-md-4 d-flex align-items-center justify-content-center">
                  <div className="text-center">
                    <div 
                      className="rounded-circle d-flex align-items-center justify-content-center mb-3 mx-auto"
                      style={{ 
                        width: "80px", 
                        height: "80px", 
                        background: "linear-gradient(135deg, #28a745 0%, #20c997 100%)" 
                      }}
                    >
                      <BsCurrencyRupee size={32} className="text-white" />
                    </div>
                    <Button
                      onClick={onPayNow}
                      size="lg"
                      className="fw-bold px-4"
                      style={{
                        background: "linear-gradient(135deg, #28a745 0%, #20c997 100%)",
                        border: "none",
                        borderRadius: "25px"
                      }}
                    >
                      {t("Pay Now")}
                    </Button>
                  </div>
                </div>
              </div>
            </Card.Body>
          </Card>

          {/* Terms & Conditions */}
          <Card className="mt-4 border-0 bg-light">
            <Card.Body className="p-3">
              <h6 className="text-muted mb-2">{t("Terms & Conditions")}:</h6>
              <ul className="text-muted small mb-0">
                <li>{t("All fees are inclusive of applicable taxes")}</li>
                <li>{t("Payment is required before certificate issuance")}</li>
                <li>{t("Refunds are subject to terms and conditions")}</li>
                <li>{t("Additional charges may apply for expedited processing")}</li>
              </ul>
            </Card.Body>
          </Card>
        </Col>
      </Row>
    </div>
  );
};

export default Invoicing;
