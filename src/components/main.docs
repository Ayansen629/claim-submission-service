import React, { useEffect, useMemo, useState } from "react";
import { Container, Row, Col, Spinner, Badge, Button, Card } from "react-bootstrap";
import Collapsible from "./formCommon/Collapsible";
import { useFormData } from "../../context/FormDataContext";
import PreviewCard from "../../private/Dashboard/PreviewCard";
import { FaDownload, FaUser, FaBuilding, FaFileAlt, FaMoneyBillWave, FaUniversity, FaSignature, FaIdCard, FaUsers } from "react-icons/fa";
import axios from "axios";
import "./ReviewStep.css";

// Component to render a section of preview cards
const PreviewSection = ({ title, icon, fields }) => {
  if (!fields || Object.keys(fields).length === 0) return null;
  
  return (
    <div className="mb-4">
      <h5 className="section-title">
        {icon && <span className="section-icon">{icon}</span>}
        {title}
      </h5>
      <Container fluid>
        <Row className="g-3">
          {Object.entries(fields).map(([key, value]) => (
            <Col key={key} xs={12} sm={6} md={4} lg={3} className="mb-3">
              <PreviewCard title={key} value={value} />
            </Col>
          ))}
        </Row>
      </Container>
    </div>
  );
};

const ReviewStep = () => {
  const { formData } = useFormData();
  const [draftResponse, setDraftResponse] = useState(null);
  const [loading, setLoading] = useState(true);
  const [downloading, setDownloading] = useState({});
  const staticApplicationNumber = "CLAIM/CIRP/20250425/0093993";

  // Load draft data from localStorage on mount
  useEffect(() => {
    const savedDraft = localStorage.getItem("draftResponse");
    if (savedDraft) {
      try {
        const parsedDraft = JSON.parse(savedDraft);
        setDraftResponse(parsedDraft);
      } catch (error) {
        console.error("Error parsing draft data:", error);
      }
    }
    setLoading(false);
  }, []);

  // Handle document download
  const handleDownload = async (fileId, fileName) => {
    try {
      setDownloading(prev => ({ ...prev, [fileId]: true }));
      
      const response = await axios.get(
        `${process.env.REACT_APP_FILE_SERVICE}v1/files/id?fileStoreId=${fileId}`,
        { responseType: 'blob' }
      );

      // Create download link
      const url = window.URL.createObjectURL(new Blob([response.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', fileName || 'document');
      document.body.appendChild(link);
      link.click();
      link.remove();
      
    } catch (error) {
      console.error('Error downloading file:', error);
      alert('Failed to download document');
    } finally {
      setDownloading(prev => ({ ...prev, [fileId]: false }));
    }
  };

  // Format document display with download button
  const formatFileInfo = (fileData) => {
    if (!fileData) return "No file uploaded";
    if (typeof fileData === "string") return fileData;
    
    const fileName = fileData.fileName || fileData.docName || "File uploaded";
    const fileId = fileData.fileId || fileData.docId;
    
    return (
      <div className="d-flex align-items-center">
        <span className="me-2">{fileName}</span>
        <Button 
          variant="link" 
          size="sm" 
          className="p-0"
          onClick={() => handleDownload(fileId, fileName)}
          disabled={downloading[fileId]}
        >
          {downloading[fileId] ? (
            <Spinner animation="border" size="sm" />
          ) : (
            <FaDownload className="text-primary" />
          )}
        </Button>
      </div>
    );
  };

  // Get entity labels based on claim type
  const getEntityLabels = (claimType) => {
    switch (claimType) {
      case "principalBorrower":
        return {
          nameLabel: "Name of the guarantor",
          addressLabel: "Address of the guarantor",
          sectionTitle: "Guarantor Details"
        };
      case "guarantor":
        return {
          nameLabel: "Name of the Principal Borrower",
          addressLabel: "Address of the Principal Borrower",
          sectionTitle: "Principal Borrower Details"
        };
      case "financialDebt":
        return {
          nameLabel: "Name of the Beneficiary",
          addressLabel: "Address of the Beneficiary",
          sectionTitle: "Beneficiary Details"
        };
      default:
        return {
          nameLabel: "Name",
          addressLabel: "Address",
          sectionTitle: "Entity Details"
        };
    }
  };

  // Transform the form data for display
  const formattedData = useMemo(() => {
    if (!formData) return null;

    const claimType = formData.step2?.claimType;
    const entityLabels = getEntityLabels(claimType);

    return {
      corporateDebtor: {
        "Corporate Debtor Name": formData.step1?.corporateDebtorName || "N/A",
      },
      
      creditorDetails: {
        "Financial Creditor Name": formData.step1?.financialCreditorName,
        "Financial Creditor Email": formData.step1?.financialCreditorEmail,
        "Identification Type": formData.step1?.identificationType === "incorporated" 
          ? "Incorporated Body" 
          : "Partnership or Individual",
      },
      
      addressDetails: {
        "Address Line 1": formData.step1?.addressLine1,
        "Address Line 2": formData.step1?.addressLine2,
        "City": formData.step1?.city,
        "State": formData.step1?.state,
        "Pincode": formData.step1?.pincode
      },
      
      identificationDetails: {
        "Identification Records": formData.step1?.identificationtype_details?.map((detail, index) => (
          <div key={detail.id} className="mb-2 identification-record">
            <div className="record-header">Record {index + 1}</div>
            <div><strong>Details:</strong> {detail.details}</div>
            <div><strong>Proof:</strong> {formatFileInfo(detail.proof)}</div>
          </div>
        )) || "N/A"
      },
      
      claimDetails: {
        "Claim Type": formData.step2?.claimType,
        "Principal Borrower Name": formData.step2?.principalBorrowerName1,
        "Principal Borrower Address": formData.step2?.principalBorrowerAddress1,
        "Claim Amount": formData.step2?.claimAmount ? `₹${formData.step2.claimAmount}` : "N/A",
        "Debt Details": formData.step2?.debtDetails,
        "Debt Date": formData.step2?.debtDate,
      },
      
      entityDetails: {
        [entityLabels.sectionTitle]: formData.step2?.entityData && formData.step2.entityData.length > 0 ? (
          <div className="entity-records-container">
            {formData.step2.entityData.map((entity, index) => (
              <div key={entity.id} className="mb-2 identification-record">
                <div className="record-header">{entityLabels.sectionTitle.replace(" Details", "")} {index + 1}</div>
                <div><strong>{entityLabels.nameLabel}:</strong> {entity.name}</div>
                <div><strong>{entityLabels.addressLabel}:</strong> {entity.address}</div>
              </div>
            ))}
          </div>
        ) : `No ${entityLabels.sectionTitle.toLowerCase()} found`
      },
      
      securityDetails: {
        "Has Security Interest": formData.step2?.hasSecurityInterest === "yes" ? "Yes" : "No",
        "Security Value": formData.step2?.securityValue ? `₹${formData.step2.securityValue}` : "N/A",
        "Security Date": formData.step2?.securityDate || "N/A",
      },
      
      guaranteeDetails: {
        "Has Guarantee": formData.step2?.hasGuarantee === "yes" ? "Yes" : "No",
        "Guarantee Value": formData.step2?.guaranteeValue ? `₹${formData.step2.guaranteeValue}` : "N/A",
        "Guarantee Date": formData.step2?.guaranteeDate || "N/A",
        "Mutual Details": formData.step2?.mutualDetails || "N/A",
      },
      
      bankDetails: {
        "Account Number": formData.step2?.accountNumber,
        "IFSC Code": formData.step2?.ifscCode,
        "Bank Name": formData.step2?.bankName,
        "Branch Name": formData.step2?.branchName,
        "Branch Address": formData.step2?.branchAddress,
        "City": formData.step2?.city,
        "State": formData.step2?.state,
        "District": formData.step2?.district
      },
      
      signatoryDetails: {
        "Creditor Name": formData.step3?.creditorName,
        "Creditor Position": formData.step3?.creditorPosition,
        "Creditor Address": formData.step3?.creditorAddress,
        "Has Signature": formData.step3?.hasSignature === "yes" ? "Yes" : "No",
        "Signature": formatFileInfo(formData.step3?.signatureFile)
      },
      
      documentDetails: {
        "Identity Proof Type": formData.step4?.identityProofType,
        "Identity Proof": formatFileInfo(formData.step4?.identityProofFile),
        "Address Proof Type": formData.step4?.addressProofType,
        "Address Proof": formatFileInfo(formData.step4?.addressProofFile)
      }
    };
  }, [formData, downloading]);

  if (loading) {
    return (
      <div className="d-flex justify-content-center align-items-center" style={{ height: "100vh" }}>
        <Spinner animation="border" />
      </div>
    );
  }

  if (!formattedData) {
    return (
      <div className="alert alert-info">
        No form data available to display
      </div>
    );
  }

  return (
    <div className="form-stepper review-step">
      <div className="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
        <div>
          <span className="text-muted small">Application Number:</span>
          <span className="ms-2 fw-bold">{staticApplicationNumber}</span>
        </div>
        <Badge bg="warning" className="text-dark">
          Draft Preview
        </Badge>
      </div>

      <Collapsible title="Step 1: Corporate Debtor & Creditor Details">
        <PreviewSection 
          title="Corporate Debtor Details" 
          icon={<FaBuilding />} 
          fields={formattedData.corporateDebtor} 
        />
        <PreviewSection 
          title="Financial Creditor Details" 
          icon={<FaUser />} 
          fields={formattedData.creditorDetails} 
        />
        <PreviewSection 
          title="Address Details" 
          icon={<FaBuilding />} 
          fields={formattedData.addressDetails} 
        />
        <PreviewSection 
          title="Identification Details" 
          icon={<FaIdCard />} 
          fields={formattedData.identificationDetails} 
        />
      </Collapsible>

      <Collapsible title="Step 2: Claim & Financial Details">
        <PreviewSection 
          title="Claim Details" 
          icon={<FaFileAlt />} 
          fields={formattedData.claimDetails} 
        />
        {formData.step2?.entityData && formData.step2.entityData.length > 0 && (
          <PreviewSection 
            title={getEntityLabels(formData.step2?.claimType).sectionTitle}
            icon={<FaUsers />} 
            fields={formattedData.entityDetails} 
          />
        )}
        <PreviewSection 
          title="Security Details" 
          icon={<FaMoneyBillWave />} 
          fields={formattedData.securityDetails} 
        />
        <PreviewSection 
          title="Guarantee Details" 
          icon={<FaMoneyBillWave />} 
          fields={formattedData.guaranteeDetails} 
        />
        <PreviewSection 
          title="Bank Details" 
          icon={<FaUniversity />} 
          fields={formattedData.bankDetails} 
        />
      </Collapsible>

      <Collapsible title="Step 3: Signatory Details">
        <PreviewSection 
          title="Signatory Information" 
          icon={<FaSignature />} 
          fields={formattedData.signatoryDetails} 
        />
      </Collapsible>

      <Collapsible title="Step 4: Document Verification">
        <PreviewSection 
          title="Document Details" 
          icon={<FaFileAlt />} 
          fields={formattedData.documentDetails} 
        />
      </Collapsible>
    </div>
  );
};

export default React.memo(ReviewStep);

