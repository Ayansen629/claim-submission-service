import React, { useEffect, useState } from "react";
import { Container, Row, Col, Spinner } from "react-bootstrap";
import Collapsible from "./formCommon/Collapsible";
import PreviewCard from "../../private/Dashboard/PreviewCard";

const ReviewStep = () => {
  const [previewData, setPreviewData] = useState(null);
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    // Load data from localStorage when component mounts
    const loadPreviewData = () => {
      const savedData = localStorage.getItem('formPreviewData');
      if (savedData) {
        setPreviewData(JSON.parse(savedData));
      }
      setIsLoading(false);
    };

    loadPreviewData();
    
    // Cleanup function to remove the data when component unmounts
    return () => {
      localStorage.removeItem('formPreviewData');
    };
  }, []);

  const formatFileInfo = (fileData) => {
    if (!fileData) return "No file uploaded";
    if (typeof fileData === "string") return fileData;
    return fileData.name || fileData.fileName || "File uploaded";
  };

  const renderPreviewSection = (fields) => (
    <Container fluid>
      <Row className="g-3">
        {Object.entries(fields).map(([key, value]) => (
          <Col key={key} xs={12} sm={6} md={3} className="mb-3">
            <PreviewCard 
              title={key} 
              value={value} 
            />
          </Col>
        ))}
      </Row>
    </Container>
  );

  const renderCard = (title, fields) => (
    <div className="mb-3">
      <h5 style={{ fontWeight: 600 }}>{title}</h5>
      {renderPreviewSection(fields)}
    </div>
  );

  if (isLoading) {
    return (
      <div className="d-flex justify-content-center align-items-center" style={{ height: "100vh" }}>
        <Spinner animation="border" />
      </div>
    );
  }

  if (!previewData) {
    return <div>No preview data available</div>;
  }

  // Format the data structure for rendering
  const formattedData = {
    step1: {
      creditorDetails: {
        "Debtor Name": previewData.claimDetails?.debtorName,
        "Creditor Name": previewData.claimDetails?.creditorName,
        "Total Claim Amount": previewData.claimDetails?.totalClaimAmount,
        "Debt Details": previewData.claimDetails?.debtDetails,
        "Mutual Credit Details": previewData.claimDetails?.mutualCreditDetails,
      },
      identificationDetails: {
        "Identification Type": previewData.identificationDetails?.type,
        "Identification Number": previewData.identificationDetails?.number,
        "Identification Document": formatFileInfo(previewData.identificationDetails?.document),
      }
    },
    step2: {
      financialDetails: {
        "Security Interest Amount": previewData.securityDetails?.securityInterestAmount,
        "Guarantee Amount": previewData.securityDetails?.guaranteeAmount,
        "Guarantor Name": previewData.securityDetails?.guarantorDetails?.name,
        "Guarantor Address": previewData.securityDetails?.guarantorDetails?.address,
        "Creditor Address": previewData.securityDetails?.creditorContact?.address,
        "Creditor Email": previewData.securityDetails?.creditorContact?.email,
      },
      beneficiaryDetails: {
        "Beneficiary Name": previewData.securityDetails?.beneficiaryDetails?.name,
        "Beneficiary Address": previewData.securityDetails?.beneficiaryDetails?.address,
        "Corporate Debtor Security Amount": previewData.securityDetails?.corporateDebtorDetails?.securityAmount,
        "Corporate Debtor Guarantee Amount": previewData.securityDetails?.corporateDebtorDetails?.guaranteeAmount,
      },
      bankDetails: {
        "Principal Borrower Name": previewData.securityDetails?.principalBorrower?.name,
        "Principal Borrower Address": previewData.securityDetails?.principalBorrower?.address,
        "Account Number": previewData.securityDetails?.bankDetails?.accountNumber,
        "IFSC Code": previewData.securityDetails?.bankDetails?.ifscCode,
        "Branch Name": previewData.securityDetails?.bankDetails?.branchName,
        "Address Proof": formatFileInfo(previewData.securityDetails?.addressProof),
      }
    },
    step3: {
      signatoryDetails: {
        "Signatory Name": previewData.signatoryDetails?.name,
        "Signatory Position": previewData.signatoryDetails?.position,
        "Signatory Address": previewData.signatoryDetails?.address,
        "Signatory Document": formatFileInfo(previewData.signatoryDetails?.document),
      }
    }
  };

  return (
    <div className="form-stepper">
      <Collapsible title="Step 1: Creditor and Identification Details">
        {renderCard("Creditor Details", formattedData.step1.creditorDetails)}
        {renderCard("Identification Details", formattedData.step1.identificationDetails)}
      </Collapsible>

      <Collapsible title="Step 2: Financial and Beneficiary Details">
        {renderCard("Financial Details", formattedData.step2.financialDetails)}
        {renderCard("Beneficiary Details", formattedData.step2.beneficiaryDetails)}
        {renderCard("Bank Details", formattedData.step2.bankDetails)}
      </Collapsible>

      <Collapsible title="Step 3: Signatory Details">
        {renderCard("Signatory Details", formattedData.step3.signatoryDetails)}
      </Collapsible>
    </div>
  );
};

export default ReviewStep;
