.analytics-card {
  width: 100%;
  height: 10rem;
  border-radius: 12px;
  padding: 1rem;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: #f5f5f5;
  color: #ffffff;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  cursor: pointer;
  border: 3px solid white;
  position: relative;
}

.analytics-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
}

.analytics-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.analytics-card-title {
  font-size: 0.9rem;
  font-weight: 600;
  margin: 0;
  flex: 1;
  line-height: 1.2;
  text-transform: uppercase;
}

.analytics-card-icon img,
.analytics-card-icon svg {
  width: 28px;
  height: 28px;
  object-fit: contain;
}

.analytics-card-value {
  font-size: 2rem;
  font-weight: 700;
  margin: 0.5rem 0;
  text-align: center;
  flex-grow: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.analytics-card-subtitle {
  font-size: 0.75rem;
  opacity: 0.9;
  line-height: 1.2;
  text-align: center;
}
