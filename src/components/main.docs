  const handleFileChange = async (e, documentType) => {
    if (viewMode) return;
    const file = e?.target?.files[0];
    if (!file) return;

    const maxSize = 10 * 1024 * 1024;
    if (file.size > maxSize) {
      toast.error("File size must be less than or equal to 10 MB.");
      e.target.value = null;
      return;
    }

    loaderRef.current?.show();

    try {
      const formData = new FormData();
      formData.append("file", file);

      const uploadUrl = BASE_IP + URLS_ENDPOINT.FILE_STORE_SERVICE.UPLOAD_FILE;
      const response = await postFORMdata(uploadUrl, formData);

      const fileStoreId = response?.data?.files[0]?.fileStoreId;

      if (fileStoreId) {
        const fileExtension = file.name.substring(file.name.lastIndexOf("."));

        const getStandardizedFileName = (docType, extension) => {
          const baseNames = {
            authorizationFile: "Authorised Person",
            paymentChallan: "Payment Acknowledgement",
            builderCertificate: "Builder Certificate",
            lastCertificateCopy: "Certificate of Survey",
            registrationCertificateCopy: "Certificate of Registration",
            testCertificate: "Test Certificate",
          };
          return `${baseNames[docType] || docType}${extension}`;
        };

        const standardizedName = getStandardizedFileName(
          documentType,
          fileExtension
        );

        const displayFile = new File([file], standardizedName, {
          type: file.type,
        });

        setFileStates((prev) => ({
          ...prev,
          [documentType]: {
            name: standardizedName,
            fileStoreId,
            originalName: file.name,
            displayFile: displayFile,
          },
        }));

        setValue(`enclosure.${documentType}`, displayFile);
        setValue(`enclosure.${documentType}FileStoreId`, fileStoreId);
        setValue(`enclosure.${documentType}OriginalName`, file.name);
        clearErrors(`enclosure.${documentType}`);
        toast.success("File uploaded successfully!");
      }
    } catch (err) {
      console.error("File upload failed:", err);
      toast.error("File upload failed. Please try again.");
      setFileStates((prev) => ({ ...prev, [documentType]: null }));
      setValue(`enclosure.${documentType}`, null);
      setValue(`enclosure.${documentType}FileStoreId`, null);
      setValue(`enclosure.${documentType}OriginalName`, null);
      e.target.value = null;
    } finally {
      loaderRef.current?.hide();
    }
  };


  const handleFileDownload = async (fileStoreId, fileName, originalName) => {
    try {
      if (!fileStoreId) return;
      const url = `${BASE_IP}/filestore/v1/files/id?fileStoreId=${fileStoreId}`;

      const accessToken = getFromLocalStorage("access_token");
      const tokenDetails = getFromLocalStorage("tokenDetails");
      const sessionState = tokenDetails
        ? JSON.parse(tokenDetails)?.session_state
        : "";

      const response = await axios({
        method: "GET",
        url: url,
        responseType: "blob",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "X-Request-ID": sessionState,
          Accept: "application/octet-stream",
        },
      });

      if (response.data) {
        let filename = fileName || "document";
        const contentDisposition = response.headers["content-disposition"];
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(
            /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
          );
          if (filenameMatch && filenameMatch[1]) {
            filename = filenameMatch[1].replace(/['"]/g, "");
          }
        }

        const blob = new Blob([response.data], {
          type: response.headers["content-type"] || "application/octet-stream",
        });
        const blobUrl = window.URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = blobUrl;
        link.setAttribute("download", filename);
        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          window.URL.revokeObjectURL(blobUrl);
        }, 100);
      }
    } catch (error) {
      console.error("Error downloading file:", error);
      toast.error("Failed to download file. Please try again.");
    }
  };

  const [fileStates, setFileStates] = useState({
    authorizationFile: null,
    paymentChallan: null,
    builderCertificate: null,
    lastCertificateCopy: null,
    registrationCertificateCopy: null,
    testCertificate: null,
  });



  useEffect(() => {
    const enclosureData = watch("enclosure");
    if (enclosureData) {
      const newFileStates = {};

      Object.keys(fileStates).forEach(docType => {
        const fileStoreId = enclosureData[`${docType}FileStoreId`];
        const fileName = enclosureData[`${docType}OriginalName`] || enclosureData[docType]?.name;

        if (fileStoreId && fileName) {
          newFileStates[docType] = {
            name: fileName,
            fileStoreId: fileStoreId,
            originalName: fileName
          };
        }
      });

      if (Object.keys(newFileStates).length > 0) {
        setFileStates(prev => ({ ...prev, ...newFileStates }));
      }
    }
  }, [registrationData]);


  useEffect(() => {
    if (!intialSurveyData?.Enclosure) return;

    const newFileStates = {};

    intialSurveyData.Enclosure.forEach(doc => {
      const typeMap = {
        SURVEY_AUTHORIZATION_OF_AUTHORISED_PERSON: "authorizationFile",
        SURVEY_PAYMENT_CHALLAN: "paymentChallan",
        SURVEY_BUILDER_CERTIFICATE: "builderCertificate",
        SURVEY_COPY_OF_LAST_CERTIFICATE_OF_SURVEY: "lastCertificateCopy",
        SURVEY_COPY_OF_CERTIFICATE_OF_REGISTRATION: "registrationCertificateCopy",
        SURVEY_TEST_CERTIFICATE: "testCertificate",
      };

      const key = typeMap[doc.documentType];
      if (key && doc.fileStoreId) {
        newFileStates[key] = {
          name: doc.documentName,
          fileStoreId: doc.fileStoreId,
          originalName: doc.documentName
        };
      }
    });

    setFileStates(prev => ({ ...prev, ...newFileStates }));
  }, [intialSurveyData?.Enclosure]);


  // const renderFileField = (docType, label) => {
  //   if (viewMode) {
  //     return (
  //       <>
  //         <label className="form-label">{t(label)}</label>
  //         {fileStates[docType] ? (
  //           <div
  //             className="d-flex align-items-center p-2 border rounded"
  //             style={{ backgroundColor: "#f8f9fa" }}
  //           >
  //             <span className="me-2">{fileStates[docType].name}</span>
  //             <button
  //               type="button"
  //               className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
  //               onClick={() =>
  //                 handleFileDownload(
  //                   fileStates[docType].fileStoreId,
  //                   fileStates[docType].name,
  //                   fileStates[docType].originalName
  //                 )
  //               }
  //               title="Download file"
  //               style={{ width: "24px", height: "24px", padding: "0" }}
  //             >
  //               <FaDownload size={10} />
  //             </button>
  //           </div>
  //         ) : (
  //           <div
  //             className="p-2 border rounded text-muted"
  //             style={{ backgroundColor: "#f8f9fa" }}
  //           >
  //             No file uploaded
  //           </div>
  //         )}
  //       </>
  //     );
  //   }

  //   return (
  //     <>
  //       <div style={{ display: "flex" }}>
  //         <InputFile
  //           name={`enclosure.${docType}`}
  //           label={t(label)}
  //           id={docType}
  //           style={{ width: "100%" }}
  //           register={register(`enclosure.${docType}`, {
  //             required: !fileStates[docType] && t(`${label} is required`),
  //           })}
  //           errors={errors}
  //           required={!fileStates[docType]}
  //           clearErrors={clearErrors}
  //           onChange={(e) => handleFileChange(e, docType)}
  //         />

  //         {fileStates[docType] && (
  //           <FaTimesCircle
  //             className="text-danger position-relative"
  //             style={{
  //               top: "3rem",
  //               right: "3.5rem",
  //               cursor: "pointer",
  //             }}
  //             size={18}
  //             title="Remove file"
  //             onClick={() => {
  //               setFileStates((prev) => ({
  //                 ...prev,
  //                 [docType]: null,
  //               }));
  //               setValue(`enclosure.${docType}`, null);
  //               setValue(`enclosure.${docType}FileStoreId`, null);
  //               clearErrors(`enclosure.${docType}`);
  //             }}
  //           />
  //         )}
  //       </div>

  //       {fileStates[docType] && (
  //         <div className="d-flex align-items-center mt-1 mb-1">
  //           <small className="text-success me-2">
  //             ✓ {fileStates[docType].name}
  //           </small>
  //           <button
  //             type="button"
  //             className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
  //             onClick={() =>
  //               handleFileDownload(
  //                 fileStates[docType].fileStoreId,
  //                 fileStates[docType].name,
  //                 fileStates[docType].originalName
  //               )
  //             }
  //             title="Download file"
  //             style={{ width: "24px", height: "24px", padding: "0" }}
  //           >
  //             <FaDownload size={10} />
  //           </button>
  //         </div>
  //       )}
  //     </>
  //   );
  // };

  const renderFileField = (docType, label) => {
    if (viewMode) {
      return (
        <>
          <label className="form-label">{t(label)}</label>
          {fileStates[docType] ? (
            <div
              className="d-flex align-items-center p-2 border rounded"
              style={{ backgroundColor: "#f8f9fa" }}
            >
              <span className="me-2">{fileStates[docType].name}</span>
              <button
                type="button"
                className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center"
                onClick={() =>
                  handleFileDownload(
                    fileStates[docType].fileStoreId,
                    fileStates[docType].name,
                    fileStates[docType].originalName
                  )
                }
                title="Download file"
                style={{ width: "24px", height: "24px", padding: "0" }}
              >
                <FaDownload size={10} />
              </button>
            </div>
          ) : (
            <div
              className="p-2 border rounded text-muted"
              style={{ backgroundColor: "#f8f9fa" }}
            >
              No file uploaded
            </div>
          )}
        </>
      );
    }

    return (
      <>
        <div className="position-relative">
          <InputFile
            name={`enclosure.${docType}`}
            label={t(label)}
            id={docType}
            style={{ width: "100%" }}
            register={register(`enclosure.${docType}`, {
              required: !fileStates[docType] && t(`${label} is required`),
            })}
            errors={errors}
            // required={!fileStates[docType]}
            clearErrors={clearErrors}
            onChange={(e) => handleFileChange(e, docType)}
            watch={watch}
            defaultValue={
              fileStates[docType]?.displayFile || watch(`enclosure.${docType}`)
            }
            key={`${docType}-${fileStates[docType] ? "uploaded" : "empty"}`}
          />

          {fileStates[docType] && (
            <FaTimesCircle
              className="text-danger position-absolute"
              style={{
                top: "50%",
                right: "10px",
                transform: "translateY(-50%)",
                cursor: "pointer",
                zIndex: 10,
              }}
              size={18}
              title="Remove file"
              onClick={() => {
                setFileStates((prev) => ({
                  ...prev,
                  [docType]: null,
                }));
                setValue(`enclosure.${docType}`, null);
                setValue(`enclosure.${docType}FileStoreId`, null);
                setValue(`enclosure.${docType}OriginalName`, null);
                clearErrors(`enclosure.${docType}`);

                const fileInput = document.getElementById(docType);
                if (fileInput) {
                  fileInput.value = "";
                  const event = new Event("change", { bubbles: true });
                  fileInput.dispatchEvent(event);
                }
              }}
            />
          )}
        </div>

        {fileStates[docType] && (
          <div
            className="d-flex align-items-center mt-2"
            style={{ maxWidth: "100%" }}
          >
            <small className="text-success me-2 flex-grow-1 text-truncate">
              ✓ {fileStates[docType].name}
            </small>
            <button
              type="button"
              className="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
              onClick={() =>
                handleFileDownload(
                  fileStates[docType].fileStoreId,
                  fileStates[docType].name,
                  fileStates[docType].originalName
                )
              }
              title="Download file"
              style={{ width: "24px", height: "24px", padding: "0" }}
            >
              <FaDownload size={10} />
            </button>
          </div>
        )}
      </>
    );
  };

  const values = watch();

  useEffect(() => {
    if (!registrationData) return;

    const mapping = {
      // Basic Vessel Info
      "basicVesselInfo.nameOfVessel": registrationData.vessel?.vesselName,
      "basicVesselInfo.grossTonnage": registrationData.vessel?.grt,
      "basicVesselInfo.typeOfVessel": registrationData.vessel?.type,
      "basicVesselInfo.officialNo": registrationData.vessel?.registrationNo,
      "basicVesselInfo.categoryOfVessel": registrationData.vessel?.category,
      "basicVesselInfo.yearOfBuild": registrationData.vessel?.yearOfBuild,
      "basicVesselInfo.nameOfOwner": registrationData.owner?.name,
      "basicVesselInfo.addressOfOwner": registrationData.owner?.address,
      "basicVesselInfo.ownerTelephone": registrationData.owner?.mobile,
      "basicVesselInfo.nameOfBuilder": registrationData.builder?.name,
      "basicVesselInfo.addressOfBuilder": registrationData.builder?.address,

      // Engine / Propulsion
      "engineDetails.engineType": registrationData.engine?.type,
      "engineDetails.engineMake": registrationData.engine?.make,
      "engineDetails.makerAddress":
        registrationData.engine?.makerAddress,
      "engineDetails.yearOfMake": registrationData.engine?.yearOfMake,
      "engineDetails.horsepower": registrationData.engine?.horsepower,
      "engineDetails.speed": registrationData.engine?.speed,
    };

    const validEntries = Object.entries(mapping).filter(
      ([, value]) => value != null
    );
    validEntries.forEach(([key, value]) => setValue(key, value));
  }, [registrationData, setValue]);
  return (
    <>
      <NewLoader ref={loaderRef} />
      <form autoComplete="off">
        {/* Basic Vessel Information */}
        <Collapsible
          title={
            <>
              <FaShip className="me-2" style={{ color: "#2466BF" }} />
              <span>{t("Basic Vessel Information")}</span>
            </>
          }
          openStat={true}
        >
          <Row className="gy-3" style={{ padding: "1rem" }}>
            <Col md={4}>
              <InputText
                label={t("Port of Registry of Vessel")}
                name="vesselDetails.portOfRegistry"
                placeholder={!viewMode ? t("Enter Port of Registry of Vessel") : ""} register={register("vesselDetails.portOfRegistry")}
                errors={errors}
                disabled={viewMode}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Official No. of the Vessel")}
                name="basicVesselInfo.officialNo"
                placeholder={!viewMode ? t("Enter Official No. of the Vessel") : ""} register={register("basicVesselInfo.officialNo")}
                errors={errors}
                disabled={viewMode}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Name of Vessel")}
                register={register("vesselDetails.vesselName")}
                name="vesselDetails.vesselName"
                placeholder={!viewMode ? t("Enter Name of Vessel") : ""}
                errors={errors}
                disabled={viewMode}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Name of Owner")}
                name="basicDetails.ownerDetails.nameOfOwner"
                placeholder={!viewMode ? t("Enter Name of Owner") : ""}
                register={register("basicDetails.ownerDetails.nameOfOwner")}
                errors={errors}
                disabled={viewMode}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Address of Owner")}
                name="basicDetails.ownerDetails.addressLine1"
                placeholder={!viewMode ? t("Enter Address of Owner") : ""}
                register={register("basicDetails.ownerDetails.addressLine1")}
                errors={errors}
                disabled={viewMode}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Owner's Telephone No.")}
                name="basicDetails.ownerDetails.phoneNumber"
                placeholder={!viewMode ? t("Enter Owner's Telephone No.") : ""}
                register={register("basicDetails.ownerDetails.phoneNumber")}
                errors={errors}
                disabled={viewMode}
                maxlength={10}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Type of Vessel")}
                name="vesselDetails.typeOfVessel"
                placeholder={!viewMode ? t("Enter Type of Vessel") : ""}
                register={register("vesselDetails.typeOfVessel")}
                errors={errors}
                disabled={viewMode}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Category of Vessel")}
                name="vesselDetails.categoryOfVessel"
                placeholder={!viewMode ? t("Enter Category of Vessel") : ""}
                register={register("vesselDetails.categoryOfVessel")}
                errors={errors}
                disabled={viewMode}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Date of Registry")}
                name="basicDetails.dateOfRegistration"
                placeholder={!viewMode ? t("Enter Date of Registry") : ""}
                type="date"
                register={register("basicDetails.dateOfRegistration")}
                errors={errors}
                disabled={viewMode}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Length of the Vessel (Meter)")}
                name="vesselDetails.lengthOfVessel"
                type="number"
                placeholder={!viewMode ? t("Enter Length of the Vessel (Meter)") : ""}
                register={register("vesselDetails.lengthOfVessel")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Breadth of the Vessel (Meter)")}
                name="vesselDetails.breadthOfVessel"
                type="number"
                placeholder={!viewMode ? t("Enter Breadth of the Vessel (Meter)") : ""}
                register={register("vesselDetails.breadthOfVessel")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Depth of the Vessel (Meter)")}
                name="vesselDetails.depthOfVessel"
                type="number"
                placeholder={!viewMode ? t("Enter Depth of the Vessel (Meter)") : ""}
                register={register("vesselDetails.depthOfVessel")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Year of Build")}
                name="vesselDetails.yearOfBuild"
                placeholder={!viewMode ? t("Enter Year of Build") : ""}
                register={register("vesselDetails.yearOfBuild")}
                errors={errors}
                disabled={viewMode}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
            <Col md={4}>
              <InputText
