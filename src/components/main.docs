/* General Styles */
.container-fluid {
  width: 100%;
  padding-left: 0;
  padding-right: 0;
}

.mb-2.text-center {
  font-size: 2.5rem;
  font-weight: bold;
  color: #269ccc;
  letter-spacing: 1px;
  text-transform: uppercase;
  text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
  margin-bottom: 1rem;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Table Styles */
.table-responsive {
  overflow-x: auto;
  width: 100%;
}

.table {
  width: 100%;
}

.table th,
.table td {
  text-align: center;
  vertical-align: middle;
  padding: 12px;
  font-size: 0.9rem;
}

.table thead th {
  background-color: #269ccc;
  color: #fff;
  font-weight: bold;
}

.table tbody tr:nth-child(even) {
  background-color: #f9f9f9;
}

.table tbody tr:hover {
  background-color: #f1f1f1;
}

/* Pagination Styles */
.pagination {
  display: flex;
  justify-content: center;
  list-style: none;
  padding: 0;
}

.pagination .page-item {
  margin: 0 5px;
}

.pagination .page-link {
  padding: 8px 12px;
  font-size: 0.9rem;
  color: #09828D;
  text-decoration: none;
  border: 1px solid #09828D;
  border-radius: 4px;
  transition: all 0.3s ease;
}

.pagination .page-link:hover {
  background-color: #086e74;
  color: #fff;
}

.pagination .active .page-link {
  background-color: #09828D;
  color: #fff;
  border-color: #09828D;
}

/* Loader */
.loader-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.loader {
  border: 6px solid #f3f3f3;
  border-top: 6px solid #09828D;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.d-flex {
  display: flex;
}

.d-flex .mr-2 {
  margin-right: 0.5rem;
}

.d-flex .form-control {
  width: auto;
}

/* Button Styles */
.col-12.col-md-4 {
  display: flex;
  justify-content: flex-end;
  gap: 0.5rem;
}

.col-12.col-md-4 .btn {
  white-space: nowrap;
  font-size: 0.85rem;
  padding: 0.4rem 0.8rem;
  background-color: #269ccc;
  border-color: #269ccc;
  color: white;
}

.col-12.col-md-4 .btn:hover {
  background-color: #076C75;
  border-color: #076C75;
}

/* Media Queries for smaller screens */
@media (max-width: 768px) {
  .col-12.col-md-4 .btn {
    flex: 1 1 100%;
  }

  .row {
    flex-direction: column;
  }

  .col-md-6, .col-md-2 {
    margin-bottom: 1rem;
  }
}

.modal-1110w {
  max-width: 1200px;
  width: 1200px;
}

.white-icon {
  filter: brightness(0) invert(1);
}

.black-icon {
  filter: brightness(0) invert(0);
}

/* Ensure PreviewCard is flexible */
.preview-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 1rem;
  border: 1px solid #ddd;
  border-radius: 8px;
  background-color: #fff;
}

.preview-card h6 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.preview-card p {
  font-size: 0.9rem;
  margin-bottom: 0;
}


.timeline-container {
  position: relative;
  margin-left: 20px;
  padding-left: 10px;
  border-left: 2px solid #ddd;
}

.timeline-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20px;
  position: relative;
}

.timeline-icon {
  position: absolute;
  left: -26px;
  top: 2px;
  background: #fff;
  padding: 6px;
  border-radius: 50%;
  border: 2px solid #dee2e6;
  font-size: 1.2rem;
}

.timeline-content {
  padding-left: 20px;
}



action table
/* General Styles */
body {
  font-family: Arial, sans-serif;
  background-color: #f5f5f5;
  color: #34495e;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.container {
  flex: 1;
  padding: 20px;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}

/* Table Container */
.table-container {
  width: 100%;
  overflow-x: auto;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  margin-top: 20px;
  background-color: #ffffff;
}

/* Table */
.table {
  width: 100%;
  border-collapse: collapse;
  background-color: #ffffff;
}

.table th,
.table td {
  padding: 12px 16px;
  text-align: left;
  border-bottom: 1px solid #ecf0f1;
  vertical-align: middle;
}

.table th {
  background: #269ccc;
  color: #ffffff;
  font-weight: 900;
  font-size: 18px;
}

.table_datarow {
  background-color: #f9f9f9;
  transition: background-color 0.3s ease;
}

.table_datarow:nth-child(even) {
  background-color: #ffffff;
}

.table_datarow:hover {
  background-color: #f1f8ff;
}

/* Table Footer */
.table_footer {
  background: #f5f5f5;
  color: #000000;
  padding: 10px 15px;
  border-top: 1px solid #ddd;
  text-align: right;
  width: 100%;
}

/* Pagination Number */
.page_number {
  background: #ffffff;
  color: #269ccc;
  border-radius: 50px;
  padding: 6px 12px;
  font-size: 14px;
  border: 1px solid #269ccc;
  margin: 0 5px;
}

.page_number:hover {
  background: #269ccc;
  color: #ffffff;
}

/* Status Column */
.status-column {
  padding: 5px 10px;
  border-radius: 16px;
  font-size: 13px;
}

.approve-status {
  background: #e8f7e7;
  color: #27ae60;
}

.initiate-status {
  background: #d0e7f5;
  color: #2980b9;
}

.pending-status {
  background: #fff3e0;
  color: #e67e22;
}

/* Search Container */
.search-container {
  margin-bottom: 20px;
  display: flex;
  justify-content: center;
}

.search-container input[type="text"] {
  width: 100%;
  max-width: 400px;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-size: 14px;
  outline: none;
  transition: border-color 0.3s ease;
}

.search-container input[type="text"]:focus {
  border-color: #269ccc;
}

/* Media Queries for Smaller Screens */
@media (max-width: 768px) {
  .table_header,
  .table_footer {
    padding: 12px;
  }

  .table_data {
    font-size: 12px;
    padding: 8px 12px;
  }

  .search-container input[type="text"] {
    width: 100%;
  }
}

/* Action Buttons */
.action_button {
  background: none;
  border: none;
  cursor: pointer;
}

.action_button img {
  width: 20px;
  height: 20px;
}

.action_button:disabled img {
  filter: grayscale(100%);
  opacity: 0.5;
}

.action_button:disabled {
  cursor: not-allowed;
}

/* Tooltip */
.tooltip {
  display: inline-block;
  position: relative;
}

.tooltip .tooltiptext {
  visibility: hidden;
  width: 120px;
  background-color: #555;
  color: #fff;
  text-align: center;
  border-radius: 6px;
  padding: 5px;
  position: absolute;
  z-index: 1;
  bottom: 125%;
  left: 50%;
  margin-left: -60px;
  opacity: 0;
  transition: opacity 0.3s;
}

.tooltip:hover .tooltiptext {
  visibility: visible;
  opacity: 1;
}

/* Sortable Header */
.sortable_header {
  cursor: pointer;
}

.sortable_header .table-arrow {
  margin-left: 5px;
}

/* Selection Info */
.selection_info {
  font-size: 14px;
  color: #34495e;
}

/* Pagination Buttons */
.pagination_button {
  background: none;
  border: none;
  color: #269ccc;
  font-size: 14px;
  cursor: pointer;
}

.pagination_button:disabled {
  color: #ccc;
  cursor: not-allowed;
}
