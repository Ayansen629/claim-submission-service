import React from "react";
import { FaTimes } from "react-icons/fa";
import styles from './ImportantModal.module.css';
import ImportantLogo from "../../../assets/images/important_logo.png";

const ImportantModal = ({ show, onClose, selectedOption }) => {
  if (!show) return null;

  return (
    <div className={styles.modalOverlay}>
      <div className={styles.modalContent}>
        <div className={styles.modalHeader}>
          <button className={styles.closeButton} onClick={onClose}>
            <FaTimes />
          </button>
        </div>
        
        <div className={styles.modalBody}>
          <div className={styles.modalImage}>
            <img src={ImportantLogo} alt="Important" />
          </div>
          
        
          
          <p className={styles.modalText}>
            You are attempting to modify the Owner Name / Registered Address associated with your vessel(s).
          </p>
          
          <ul className={styles.modalList}>
            <li>Any change in Owner's Name or Registered Address requires issuance of a new Registration Certificate.</li>
            <li>A prescribed government fee will be applicable for issuance of the new certificate.</li>
            <li>Please upload valid supporting documents (e.g., Incorporation Certificate, Gazette Notification, Affidavit, Proof of Address, etc.)</li>
            <li>Incorrect or incomplete details may lead to rejection of application or cancellation of vessel registration under Inland Water Transport Rules.</li>
          </ul>
        </div>
        
        <div className={styles.modalFooter}>
          <button className={styles.cancelButton} onClick={onClose}>
            Cancel
          </button>
          <button className={styles.proceedNowButton}>
            Proceed Now
          </button>
        </div>
      </div>
    </div>
  );
};

export default ImportantModal;
.modalOverlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modalContent {
  background: white;
  border-radius: 20px;
  max-width: 500px;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  position: relative;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
}

.modalHeader {
  position: relative;
  padding: 20px 20px 0 20px;
}

.closeButton {
  position: absolute;
  top: 15px;
  right: 15px;
  background: none;
  border: none;
  font-size: 20px;
  color: #666;
  cursor: pointer;
  padding: 5px;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.closeButton:hover {
  background: #f0f0f0;
  color: #333;
}

.modalBody {
  padding: 20px 30px;
  text-align: center;
}

.modalImage {
  width: 80px;
  height: 80px;
  margin: 0 auto 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modalImage img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.modalTitle {
  color: #1A61C1;
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 20px;
}

.modalText {
  color: #333;
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 20px;
  line-height: 1.4;
}

.modalList {
  text-align: left;
  color: #555;
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 30px;
  padding-left: 0;
  list-style: none;
}

.modalList li {
  margin-bottom: 12px;
  padding-left: 15px;
  position: relative;
  display: flex;
  align-items: flex-start;
}

.modalList li::before {
  content: '•';
  color: #1A61C1;
  font-weight: bold;
  position: absolute;
  left: 0;
  top: 0;
  line-height: 1.5;
}

.modalFooter {
  display: flex;
  justify-content: center;
  gap: 20px;
  padding: 0 30px 30px;
}

.cancelButton {
  background: transparent;
  color: #dc2626;
  border: 2px solid #dc2626;
  padding: 12px 24px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 16px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.cancelButton:hover {
  background: #dc2626;
  color: white;
}

.proceedNowButton {
  background: #1A61C1;
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 16px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.proceedNowButton:hover {
  background: #1548a0;
  transform: translateY(-1px);
}

@media (max-width: 768px) {
  .modalContent {
    width: 95%;
    max-width: none;
  }
  
  .modalBody {
    padding: 15px 20px;
  }
  
  .modalTitle {
    font-size: 20px;
  }
  
  .modalText {
    font-size: 14px;
  }
  
  .modalList {
    font-size: 13px;
  }
  
  .modalFooter {
    flex-direction: column;
    padding: 0 20px 20px;
  }
  
  .cancelButton,
  .proceedNowButton {
    width: 100%;
    padding: 12px;
  }
}

@media (max-width: 480px) {
  .modalContent {
    width: 98%;
    border-radius: 15px;
  }
  
  .modalImage {
    width: 60px;
    height: 60px;
  }
  
  .modalTitle {
    font-size: 18px;
  }
  
  .modalText {
    font-size: 13px;
  }
  
  .modalList {
    font-size: 12px;
  }
  
  .cancelButton,
  .proceedNowButton {
    font-size: 14px;
    padding: 10px;
  }
}
