import React, { useState, useEffect } from "react";
import { Box, Typography, Stack } from "@mui/material";
import { useParams, useLocation } from "react-router-dom";
import Stepper from "../../../common/Stepper.jsx";
import VesselDetails from "./VesselDetails.js";
import Documents from "./Documents.js";
import { useForm } from "react-hook-form";
import Invoicing from "../../../common/Invoicing.js";
import PaymentModal from "../../../common/PaymentModal.js"; 
import PreviewPage from "../../../common/PreviewPage";
import { vesselData, previewSections } from "./vesselData";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";

const NewVesselRegistration = () => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const { id } = useParams();
  const location = useLocation();
  
  const isEditMode = !!id && location.pathname.includes('/edit/');
  const isViewMode = !!id && location.pathname.includes('/view/');
  const isNormalMode = !isEditMode && !isViewMode;
  
  const methods = useForm({ mode: "onTouched" });
  const { trigger, getValues, setError, setValue, reset } = methods;

  // Static data for edit/view mode
  const staticData = {
    ownerName: "John Doe",
    ownerAddress: "123 Main Street, Harbor City, State 12345",
    mobile: "9876543210",
    email: "john.doe@example.com",
    pan: "ABCDE1234F",
    aadhar: "123456789012",
    tradeLicence: "TL123456789",
    gst: "GST123456789012",
    grt: "500",
    workOrderValue: "1000000",
    vesselType: "new",
    category: "A",
    zone: "1",
    supervisionAuthority: "classificationSociety",
    purchaseType: "new",
    classificationSociety: "Lloyd's Register Classification Society",
    constructedBy: "2",
    builder: "builder1",
    builderName: "ABC Marine Shipyard Pvt Ltd",
    builderAddress: "456 Port Road, Shipyard Complex, Harbor City 54321",
    builderEmail: "contact@abcshipyard.com",
    builderMobile: "9876543211",
    builderTradeLicence: "BTL789012345",
    builderGST: "BGST987654321098",
    builderAuth: "auth",
    termsAccepted: true,
    workOrder_file_1: { name: "Work_Order_Document.pdf", size: 1024000 },
    workOrder_desc_1: "Main work order document for vessel construction",
    drawings_file_1: { name: "Vessel_Technical_Drawings.pdf", size: 2048000 },
    drawings_desc_1: "Complete technical drawings and specifications",
    tonnageBooklets: { name: "Tonnage_Booklets.pdf", size: 512000 },
    stabilityBooklets: { name: "Stability_Booklets.pdf", size: 768000 },
    authLetter: { name: "Authorization_Letter.pdf", size: 256000 }
  };

  const [showModal, setShowModal] = useState(false);
  const [paymentMode, setPaymentMode] = useState("offline");
  const [challanFile, setChallanFile] = useState(null);
  const [showPreview, setShowPreview] = useState(false);
  const [isLoading, setIsLoading] = useState(false);

  useEffect(() => {
    if (isNormalMode) {
      // Clear all form data when in normal mode
      reset();
    } else if (isEditMode || isViewMode) {
      // Set static data for edit/view mode
      setTimeout(() => {
        Object.keys(staticData).forEach(key => {
          setValue(key, staticData[key]);
        });
      }, 100);
    }
  }, [isEditMode, isViewMode, isNormalMode, setValue, reset, location.pathname]);

  // ... rest of the existing code remains the same ...

  const validateVesselDetails = async () => {
    if (isViewMode) return true;
    const basicFields = [
      "ownerName", "ownerAddress", "mobile", "email", "pan", 
      "aadhar", "tradeLicence", "gst", "grt", "workOrderValue",
      "vesselType", "category", "purchaseType", "constructedBy"
    ];
    
    const constructedBy = getValues("constructedBy");
    if (constructedBy === "2") {
      basicFields.push(
        "builderName", "builderAddress", "builderEmail", 
        "builderMobile", "builderTradeLicence", "builderGST", 
        "builderAuth", "authLetter"
      );
    }
    
    const valid = await trigger(basicFields);
    return valid;
  };

  const validateDocuments = async () => {
    if (isViewMode) return true;
    const requiredFields = ['tonnageBooklets', 'stabilityBooklets', 'termsAccepted'];
    const constructedBy = getValues("constructedBy");
    
    if (constructedBy === "2") {
      requiredFields.push('authLetter');
    }
    
    let hasErrors = false;
    
    requiredFields.forEach(fieldName => {
      const fieldValue = getValues(fieldName);
      
      if (!fieldValue || (fieldValue instanceof FileList && fieldValue.length === 0)) {
        setError(fieldName, {
          type: 'required',
          message: `${fieldName} is required`
        });
        hasErrors = true;
      }
    });
    
    return !hasErrors;
  };

  const supervisionAuthority = methods.watch("supervisionAuthority");

  const handleChallanUpload = (e) => {
    setChallanFile(e.target.files?.[0] || null);
  };

  const handleOnlinePay = () => {
    setIsLoading(true);
    setShowModal(false);
   
    setTimeout(() => {
      setIsLoading(false);
      setShowPreview(true);
    }, 1500);
  };

  const steps = [
    {
      label: t("Vessel Details"),
      component: <VesselDetails formMethods={methods} viewMode={showPreview || isViewMode} />,
      validate: validateVesselDetails,
    },
    {
      label: t("Documents"),
      component: <Documents formMethods={methods} viewMode={showPreview || isViewMode} />,
      validate: validateDocuments,
    },
    {
      label: t("Invoicing"),
      component: (
        <Invoicing
          supervisionAuthority={supervisionAuthority}
          onPayNow={() => setShowModal(true)}
        />
      ),
      validate: () => true,
    },
  ];

  const handleSave = () => {
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      setShowPreview(true);
    }, 1500);
  };

  if (showPreview) {
    return (
      <PreviewPage
        data={vesselData}
        sections={previewSections}
        title="Vessel Registration Preview"
        subtitle={isEditMode ? "Registration details updated successfully" : "Registration details submitted successfully"}
        onBack={() => setShowPreview(false)}
        submitButtonText={isEditMode ? "Update Registration" : "Take Action"}
        onSubmit={() => alert(isEditMode ? "Registration updated..." : "Taking action...")}
        icons={{ title: "vessel" }}
        viewMode={true}
      />
    );
  }

  return (
    <Box sx={{ padding: "1rem 0 0 0.75rem", backgroundColor: "#f5f6fa", minHeight: "100vh" }}>
      {isLoading ? (
        <div className="d-flex justify-content-center align-items-center" style={{ height: "80vh" }}>
          <div className="text-center">
            <div className="spinner-border text-primary" role="status" style={{ width: "3rem", height: "3rem" }}>
              <span className="visually-hidden">Loading...</span>
            </div>
            <p className="mt-3">Processing your request...</p>
          </div>
        </div>
      ) : (
        <>
          <Stack spacing={0.5}>
            <Typography
              sx={{
                fontWeight: 550,
                color: "#2E57A7",
                fontSize: "1.2rem",
              }}
            >
             {isViewMode ? t("View Vessel Registration") + ` - ${id}` : 
              isEditMode ? t("Edit Vessel Registration") + ` - ${id}` : t("New Vessel Registration")}
              &nbsp;
              <span style={{ color: "#666", fontSize: "0.65rem" }}>
                {isViewMode ? t("(View vessel registration details)") :
                 isEditMode ? t("(Update vessel registration details)") : t("(Fill in the vessel details to complete registration)")}
              </span>
            </Typography>
          </Stack>
          <Stepper steps={steps} onSave={handleSave} viewMode={isViewMode} />
          {!isViewMode && (
            <PaymentModal
              show={showModal}
              onHide={() => setShowModal(false)}
              paymentMode={paymentMode}
              setPaymentMode={setPaymentMode}
              challanFile={challanFile}
              onChallanUpload={handleChallanUpload}
              onOnlinePay={handleOnlinePay}
              isLoading={isLoading}
              formMethods={methods}
            />
          )}
        </>
      )}
    </Box>
  );
};

export default NewVesselRegistration;

import React, { useState, useEffect } from "react";
import { Row, Col, Form, Button } from "react-bootstrap";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import InputFile from "../../../common/InputFile.tsx";
import InputText from "../../../common/InputText.tsx";
import { renameFile } from "../../../../utils/constants.ts";
import { BsDownload } from "react-icons/bs";

const Documents = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const [formData, setFormData] = useState({});
  const [workOrderFiles, setWorkOrderFiles] = useState([{ id: 1 }]);
  const [drawingsFiles, setDrawingsFiles] = useState([{ id: 1 }]);
  
  const {
    register,
    watch,
    setValue,
    clearErrors,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  const addFileInput = (type) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      const newId = workOrderFiles.length > 0 ? Math.max(...workOrderFiles.map(f => f.id)) + 1 : 1;
      setWorkOrderFiles([...workOrderFiles, { id: newId }]);
    } else if (type === 'drawings') {
      const newId = drawingsFiles.length > 0 ? Math.max(...drawingsFiles.map(f => f.id)) + 1 : 1;
      setDrawingsFiles([...drawingsFiles, { id: newId }]);
    }
  };

  const removeFileInput = (type, id) => {
    if (viewMode) return;
    if (type === 'workOrder') {
      setWorkOrderFiles(workOrderFiles.filter(file => file.id !== id));
      setValue(`workOrder_file_${id}`, null);
      setValue(`workOrder_desc_${id}`, "");
      clearErrors([`workOrder_file_${id}`, `workOrder_desc_${id}`]);
    } else if (type === 'drawings') {
      setDrawingsFiles(drawingsFiles.filter(file => file.id !== id));
      setValue(`drawings_file_${id}`, null);
      setValue(`drawings_desc_${id}`, "");
      clearErrors([`drawings_file_${id}`, `drawings_desc_${id}`]);
    }
  };

  const handleDownload = (fileName) => {
    // Simulate file download
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
  };

  const DocumentViewCard = ({ fileName, description, onDownload }) => (
    <div className="mb-3 p-3 border rounded" style={{ backgroundColor: "white" }}>
      <div className="d-flex justify-content-between align-items-start">
        <div className="flex-grow-1">
          <div className="mb-2">
            <strong className="text-primary">{fileName}</strong>
          </div>
          <div className="text-muted small mb-2">
            {description}
          </div>
        </div>
        <Button
          variant="outline-primary"
          size="sm"
          onClick={() => onDownload(fileName)}
          className="ms-2"
        >
          <BsDownload className="me-1" />
          Download
        </Button>
      </div>
    </div>
  );

  const formFields = [
    {
      name: 'tonnageBooklets',
      label: t('Tonnage Booklets'),
      type: 'file',
      required: true,
      colSize: 6,
      validation: { required: t('Tonnage Booklets are required') }
    },
    {
      name: 'stabilityBooklets',
      label: t('Stability Booklets'),
      type: 'file',
      required: true,
      colSize: 6,
      validation: { required: t('Stability Booklets are required') }
    },
    {
      name: 'termsAccepted',
      label: t('I have thoroughly read and understood all the terms and conditions as mentioned in the Schedule.'),
      type: 'checkbox',
      required: true,
      colSize: 12,
      validation: { required: t('You must accept the terms and conditions') }
    }
  ];

  const renderField = (field) => {
    if (field.showIf && !field.showIf()) return null;

    switch (field.type) {
      case "file":
        if (viewMode) {
          const fileData = watch(field.name);
          if (fileData && fileData.name) {
            return (
              <div className="mb-3">
                <label className="form-label fw-bold">{field.label}</label>
                <DocumentViewCard
                  fileName={fileData.name}
                  description={`${field.label} document`}
                  onDownload={handleDownload}
                />
              </div>
            );
          }
          return null;
        }
        
        return (
          <InputFile
            label={field.label}
            required={field.required}
            name={field.name}
            key={field.name}
            register={register(field.name)}
            errors={errors}
            onChange={(e) => {
              if (e.target.files && e?.target?.files[0]) {
                const file = e.target.files[0];
                const extension = file?.name?.substring(
                  file?.name?.lastIndexOf(".")
                );
                const fileName = `${field.label}${extension}`;
                file.originalName = fileName;
                const renamedFile = renameFile(file, fileName);

                clearErrors(field.name);

                setValue(field.name, renamedFile, { shouldValidate: true });
                setFormData((prev) => {
                  const updated = { ...prev, [field.name]: renamedFile };
                  return updated;
                });
              }
            }}
            className="mb-4"
            watch={watch}
            accept=".pdf,.jpg,.jpeg,.png"
            defaultValue={watch(field.name)}
            clearErrors={clearErrors}
          />
        );

      case 'checkbox':
        return (
          <div className="mb-3">
            <div className="d-flex align-items-start">
              <input
                type="checkbox"
                id={field.name}
                className="me-2 mt-1"
                {...register(field.name, field.validation)}
                disabled={viewMode}
                checked={viewMode ? watch(field.name) : undefined}
              />
              <div>
                <label
                  htmlFor={field.name}
                  className="mb-0"
                  style={{ fontWeight: 500, color: "#333", cursor: viewMode ? "default" : "pointer" }}
                >
                  {field.label}
                </label>
                {errors[field.name] && !viewMode && (
                  <div className="text-danger small mt-1" style={{ display: "block" }}>
                    {errors[field.name].message}
                  </div>
                )}
              </div>
            </div>
          </div>
        );

      default:
        return null;
    }
  };

  return (
    <div>
      <Collapsible title={t("Documents")} openStat={true}>
        <div style={{ padding: "1rem" }}>
          <Row className="gy-4">
            {/* Work Order Section */}
            <Col lg={6} md={12}>
              <div className="border rounded p-3" style={{ backgroundColor: "#f8f9fa" }}>
                <div className="d-flex justify-content-between align-items-center mb-3">
                  <h6 className="mb-0 fw-bold text-primary">{t("Work Order")}</h6>
                  {!viewMode && (
                    <Button
                      variant="primary"
                      size="sm"
                      onClick={() => addFileInput('workOrder')}
                      style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
                    >
                      + Add
                    </Button>
                  )}
                </div>
                {workOrderFiles.map((fileInput, idx) => {
                  const fileData = watch(`workOrder_file_${fileInput.id}`);
                  const descData = watch(`workOrder_desc_${fileInput.id}`);
                  
                  if (viewMode) {
                    if (fileData && fileData.name) {
                      return (
                        <DocumentViewCard
                          key={fileInput.id}
                          fileName={fileData.name}
                          description={descData || `Work Order document ${idx + 1}`}
                          onDownload={handleDownload}
                        />
                      );
                    }
                    return null;
                  }
                  
                  return (
                    <div key={fileInput.id} className="mb-3 p-2 border rounded" style={{ backgroundColor: "white" }}>
                      <div className="mb-2">
                        <InputFile
                          label={`${t("Choose File")} ${idx + 1}`}
                          name={`workOrder_file_${fileInput.id}`}
                          register={register(`workOrder_file_${fileInput.id}`)}
                          errors={errors}
                          onChange={(e) => {
                            if (e.target.files && e?.target?.files[0]) {
                              const file = e.target.files[0];
                              const extension = file?.name?.substring(
                                file?.name?.lastIndexOf(".")
                              );
                              const fileName = `Work Order${extension}`;
                              file.originalName = fileName;
                              const renamedFile = renameFile(file, fileName);

                              clearErrors(`workOrder_file_${fileInput.id}`);

                              setValue(`workOrder_file_${fileInput.id}`, renamedFile, { shouldValidate: true });
                              setFormData((prev) => {
                                const updated = { ...prev, [`workOrder_file_${fileInput.id}`]: renamedFile };
                                return updated;
                              });
                            }
                          }}
                          watch={watch}
                          defaultValue={watch(`workOrder_file_${fileInput.id}`)}
                          clearErrors={clearErrors}
                        />
                      </div>
                      <div className="mb-2">
                        <InputText
                          label={t("Description")}
                          name={`workOrder_desc_${fileInput.id}`}
                          placeholder={t("Enter file description")}
                          register={register(`workOrder_desc_${fileInput.id}`)}
                          errors={errors}
                          onChange={() => clearErrors(`workOrder_desc_${fileInput.id}`)}
                        />
                      </div>
                      {workOrderFiles.length > 1 && (
                        <div className="text-end">
                          <Button
                            variant="outline-danger"
                            size="sm"
                            onClick={() => removeFileInput('workOrder', fileInput.id)}
                          >
                            Remove
                          </Button>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </Col>

            {/* Drawings Section */}
            <Col lg={6} md={12}>
              <div className="border rounded p-3" style={{ backgroundColor: "#f8f9fa" }}>
                <div className="d-flex justify-content-between align-items-center mb-3">
                  <h6 className="mb-0 fw-bold text-primary">{t("Drawings")}</h6>
                  {!viewMode && (
                    <Button
                      variant="primary"
                      size="sm"
                      onClick={() => addFileInput('drawings')}
                      style={{ backgroundColor: "#2466BF", borderColor: "#2466BF" }}
                    >
                      + Add
                    </Button>
                  )}
                </div>
                {drawingsFiles.map((fileInput, idx) => {
                  const fileData = watch(`drawings_file_${fileInput.id}`);
                  const descData = watch(`drawings_desc_${fileInput.id}`);
                  
                  if (viewMode) {
                    if (fileData && fileData.name) {
                      return (
                        <DocumentViewCard
                          key={fileInput.id}
                          fileName={fileData.name}
                          description={descData || `Drawings document ${idx + 1}`}
                          onDownload={handleDownload}
                        />
                      );
                    }
                    return null;
                  }
                  
                  return (
                    <div key={fileInput.id} className="mb-3 p-2 border rounded" style={{ backgroundColor: "white" }}>
                      <div className="mb-2">
                        <InputFile
                          label={`${t("Choose File")} ${idx + 1}`}
                          name={`drawings_file_${fileInput.id}`}
                          register={register(`drawings_file_${fileInput.id}`)}
                          errors={errors}
                          onChange={(e) => {
                            if (e.target.files && e?.target?.files[0]) {
                              const file = e.target.files[0];
                              const extension = file?.name?.substring(
                                file?.name?.lastIndexOf(".")
                              );
                              const fileName = `Drawings${extension}`;
                              file.originalName = fileName;
                              const renamedFile = renameFile(file, fileName);

                              clearErrors(`drawings_file_${fileInput.id}`);

                              setValue(`drawings_file_${fileInput.id}`, renamedFile, { shouldValidate: true });
                              setFormData((prev) => {
                                const updated = { ...prev, [`drawings_file_${fileInput.id}`]: renamedFile };
                                return updated;
                              });
                            }
                          }}
                          watch={watch}
                          defaultValue={watch(`drawings_file_${fileInput.id}`)}
                          clearErrors={clearErrors}
                        />
                      </div>
                      <div className="mb-2">
                        <InputText
                          label={t("Description")}
                          name={`drawings_desc_${fileInput.id}`}
                          placeholder={t("Enter file description")}
                          register={register(`drawings_desc_${fileInput.id}`)}
                          errors={errors}
                          onChange={() => clearErrors(`drawings_desc_${fileInput.id}`)}
                        />
                      </div>
                      {drawingsFiles.length > 1 && (
                        <div className="text-end">
                          <Button
                            variant="outline-danger"
                            size="sm"
                            onClick={() => removeFileInput('drawings', fileInput.id)}
                          >
                            Remove
                          </Button>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </Col>

            {formFields.map((field, index) => (
              <Col key={index} md={field.colSize || 12} className="mb-2">
                {renderField(field)}
              </Col>
            ))}
          </Row>
        </div>
      </Collapsible>
    </div>
  );
};

export default Documents;

import React, { useState, useEffect, useRef } from "react";
import { useForm } from "react-hook-form";
import { Row, Col, Button } from "react-bootstrap";
import InputText from "../../../common/InputText.tsx";
import InputSelect from "../../../common/InputSelect.tsx";
import InputRadio from "../../../common/InputRadio.tsx";
import InputFile from "../../../common/InputFile.tsx";
import Collapsible from "../../../common/Collapsible.js";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../../../common/LanguageContext.js";
import { renameFile } from "../../../../utils/constants.ts";
import { BsDownload } from "react-icons/bs";

const VesselDetails = ({ formMethods, viewMode = false }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [formData, setFormData] = useState({});
  const isCompMount = useRef(true);

  const {
    register,
    watch,
    setValue,
    clearErrors,
    trigger,
    getValues,
    setError,
    formState: { errors },
  } = formMethods;

  const constructedBy = watch("constructedBy");
  const category = watch("category");

  useEffect(() => {
    if (isCompMount.current) {
      isCompMount.current = false;
      return;
    }
    const fieldsWithErrors = Object.keys(errors);
    trigger(fieldsWithErrors);
  }, [changeLanguage]);

  useEffect(() => {
    setTimeout(() => {
      Object.keys(formData).forEach(key => {
        if (formData[key] !== undefined) {
          setValue(key, formData[key], { shouldValidate: false });
        }
      });
    }, 0);
  }, [setValue, formData]);

  useEffect(() => {
    if (category === "A") {
      setValue("zone", "1", { shouldValidate: true });
      setValue("supervisionAuthority", "classificationSociety", { shouldValidate: true });
      clearErrors("zone");
      clearErrors("supervisionAuthority");
    }
  }, [category, setValue, clearErrors]);

  const handleDownload = (fileName) => {
    const link = document.createElement('a');
    link.href = '#';
    link.download = fileName;
    link.click();
  };

  const DocumentViewCard = ({ fileName, onDownload }) => (
    <div className="mb-2 p-2 border rounded" style={{ backgroundColor: "#f8f9fa" }}>
      <div className="d-flex justify-content-between align-items-center">
        <div className="flex-grow-1">
          <strong className="text-primary small">{fileName}</strong>
        </div>
        <Button
          variant="outline-primary"
          size="sm"
          onClick={() => onDownload(fileName)}
        >
          <BsDownload size={14} />
        </Button>
      </div>
    </div>
  );

  const formFields = {
    basicInfo: [
      {
        name: 'ownerName',
        label: t('Name of Owner'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Name of Owner'),
        validation: { required: t('Name is required') }
      },
      {
        name: 'ownerAddress',
        label: t('Address of Owner'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Address of Owner'),
        validation: { required: t('Address is required') }
      },
      {
        name: 'mobile',
        label: t('Mobile'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Mobile'),
        validation: { required: t('Mobile is required') }
      },
      {
        name: 'email',
        label: t('Email Id'),
        type: 'email',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Email Id'),
        validation: { required: t('Email is required') }
      },
      {
        name: 'pan',
        label: t('PAN'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter PAN'),
        validation: { required: t('PAN is required') }
      },
      {
        name: 'aadhar',
        label: t('Aadhar'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Aadhar'),
        validation: { required: t('Aadhar is required') }
      },
      {
        name: 'tradeLicence',
        label: t('Trade Licence'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Trade Licence'),
        validation: { required: t('Trade Licence is required') }
      },
      {
        name: 'gst',
        label: t('GST'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GST'),
        validation: { required: t('GST is required') }
      },
      {
        name: 'grt',
        label: t('Gross Tonnage (GRT)'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GRT'),
        validation: { required: t('GRT is required') }
      },
      {
        name: 'workOrderValue',
        label: t('Work Order Value'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Enter Work Order Value'),
        validation: {
          required: t('Work Order Value is required'),
          pattern: {
            value: /^[0-9]+$/,
            message: t('Please enter a valid number')
          }
        }
      },
      {
        name: 'vesselType',
        label: t('Type of Vessel'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'new', label: t('New Vessel') },
          { value: 'old', label: t('Old Vessel') }
        ],
        validation: { required: t('vesselType is required') }
      },
      {
        name: 'category',
        label: t('Category'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'A', label: t('Category A') },
          { value: 'B', label: t('Category B') },
          { value: 'C', label: t('Category C') }
        ],
        validation: { required: t('category is required') }
      },
      {
        name: 'zone',
        label: t('Zone'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: '1', label: t('Zone 1') },
          { value: '2', label: t('Zone 2') },
          { value: '3', label: t('Zone 3') }
        ],
        validation: { required: category !== "A" && t('zone is required') },
        disabled: category === "A"
      },
      {
        name: 'supervisionAuthority',
        label: t('Supervision Authority'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'iwt', label: t('IWT') },
          { value: 'classificationSociety', label: t('Classification Society') }
        ],
        validation: { required: category !== "A" && t('Supervision Authority is required') },
        disabled: category === "A"
      },
      {
        name: 'purchaseType',
        label: t('Purchase Type'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'new', label: t('New') },
          { value: 'used', label: t('Used') }
        ],
        validation: { required: t('Purchase Type is required') }
      },
      {
        name: 'classificationSociety',
        label: t('Name of the Classification Society'),
        type: 'text',
        required: false,
        colSize: 4,
        placeholder: t('Please enter Name of the Classification Society'),
        validation: {}
      },
      {
        name: 'constructedBy',
        label: t('Constructed By ?'),
        type: 'radio',
        required: true,
        colSize: 6,
        options: [
          { label: t('Self'), value: '1' },
          { label: t('Builder'), value: '2' }
        ],
        validation: { required: t('Please select a Constructor Type') }
      },
      {
        name: 'builder',
        label: t('Builder'),
        type: 'select',
        required: true,
        colSize: 6,
        options: [
          { value: 'builder1', label: t('Builder 1') },
          { value: 'builder2', label: t('Builder 2') }
        ],
        showIf: () => constructedBy === "2",
        validation: { required: t('Builder is required') }
      }
    ],
    builderDetails: [
      {
        name: 'builderName',
        label: t('Builder Name'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Name'),
        validation: { required: t('Builder Name is required') }
      },
      {
        name: 'builderAddress',
        label: t('Builder Address'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Address'),
        validation: { required: t('Builder Address is required') }
      },
      {
        name: 'builderEmail',
        label: t('Builder Email Id'),
        type: 'email',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Builder Email Id'),
        validation: {
          required: t('Builder Email is required'),
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: t('Invalid email address')
          }
        }
      },
      {
        name: 'builderMobile',
        label: t('Mobile'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Mobile'),
        validation: {
          required: t('Builder Mobile is required'),
          pattern: {
            value: /^[0-9]{10}$/,
            message: t('Invalid mobile number')
          }
        }
      },
      {
        name: 'builderTradeLicence',
        label: t('Trade Licence'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter Trade Licence'),
        validation: { required: t('Builder Trade Licence is required') }
      },
      {
        name: 'builderGST',
        label: t('GST'),
        type: 'text',
        required: true,
        colSize: 4,
        placeholder: t('Please enter GST'),
        validation: { required: t('Builder GST is required') }
      },
      {
        name: 'builderAuth',
        label: t('Builder Authorization'),
        type: 'select',
        required: true,
        colSize: 4,
        options: [
          { value: 'auth', label: t('Authorized') },
          { value: 'rejected', label: t('Rejected') }
        ],
        validation: { required: t('Builder Authorization is required') }
      },
      {
        name: 'authLetter',
        label: t('Authorization Letter'),
        type: 'file',
        required: true,
        colSize: 6,
        validation: { required: t('Authorization Letter is required') }
      }
    ]
  };

  const DynamicField = ({ field }) => {
    if (field.showIf && !field.showIf()) return null;

    const handleChange = (e) => {
      if (field?.onChange) field.onChange(e, setValue, watch);
    };

    switch (field.type) {
      case 'select':
        return (
          <InputSelect
            label={field.label}
            required={field.required}
            name={field.name}
            options={field.options}
            register={register(field.name, field.validation)}
            errors={errors}
            value={formData[field.name] || watch(field.name) || ""}
            onChange={(value) => {
              if (viewMode || field.disabled) return;
              setValue(field.name, value, { shouldValidate: true });
              clearErrors(field.name);
              setFormData(prev => ({
                ...prev,
                [field.name]: value
              }));
            }}
            disabled={viewMode || field.disabled}
          />
        );

      case 'file':
        if (viewMode) {
          const fileData = watch(field.name);
          if (fileData && fileData.name) {
            return (
              <div className="mb-3">
                <label className="form-label fw-bold">{field.label}</label>
                <DocumentViewCard
                  fileName={fileData.name}
                  onDownload={handleDownload}
                />
              </div>
            );
          }
          return null;
        }
        
        return (
          <div className="mb-2">
            <InputFile
              label={field.label}
              required={field.required}
              name={field.name}
              register={register(field.name, field.validation)}
              errors={errors}
              onChange={(e) => {
                if (viewMode) return;
                if (e.target.files && e?.target?.files[0]) {
                  const file = e.target.files[0];
                  
                  const validTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg'];
                  if (!validTypes.includes(file.type)) {
                    setError(field.name, {
                      type: 'manual',
                      message: t('Only PDF, JPG or PNG files are allowed')
                    });
                    setValue(field.name, null);
                    return;
                  }
                  
                  if (file.size > 2 * 1024 * 1024) {
                    setError(field.name, {
                      type: 'manual',
                      message: t('File size should not exceed 2MB')
                    });
                    setValue(field.name, null);
                    return;
                  }
                  
                  const extension = file?.name?.substring(file?.name?.lastIndexOf("."));
                  const fileName = `${field.label}${extension}`;
                  file.originalName = fileName;
                  const renamedFile = renameFile(file, fileName);

                  clearErrors(field.name);
                  setValue(field.name, renamedFile, { shouldValidate: true });
                  setFormData((prev) => ({
                    ...prev,
                    [field.name]: renamedFile
                  }));
                }
              }}
              disabled={viewMode}
              watch={watch}
              defaultValue={watch(field.name)}
              clearErrors={clearErrors}
              accept=".pdf,.jpg,.jpeg,.png"
            />
          </div>
        );

      case 'radio':
        return (
          <InputRadio
            name={field.name}
            label={field.label}
            options={field.options}
            register={register}
            rules={field.validation}
            errors={errors}
            onChange={() => !viewMode && clearErrors(field.name)}
            disabled={viewMode}
          />
        );

      default:
        return (
          <InputText
            label={field.label}
            required={field.required}
            name={field.name}
            type={field.type}
            placeholder={field.placeholder}
            register={register(field.name, field.validation)}
            onChange={handleChange}
            errors={errors}
            disabled={viewMode}
          />
        );
    }
  };

  return (
    <form autoComplete="off">
      <Collapsible title={t("Basic Information")} openStat={true}>
        <Row className="gy-3" style={{ padding: "1rem" }}>
          {formFields.basicInfo.map((field, index) => (
            <Col key={index} md={field.colSize || 12}>
              <DynamicField field={field} />
            </Col>
          ))}
        </Row>
      </Collapsible>

      {constructedBy === "2" && (
        <Collapsible title={t("Builder Details")} openStat={true}>
          <Row className="gy-3" style={{ padding: "1rem" }}>
            {formFields.builderDetails.map((field, index) => (
              <Col key={index} md={field.colSize || 12}>
                <DynamicField field={field} />
              </Col>
            ))}
          </Row>
        </Collapsible>
      )}
    </form>
  );
};

export default VesselDetails;

import React, { useState } from "react";
import { Box, Button, Typography, Paper, Divider, Stack } from "@mui/material";
import { ChevronRight, CheckCircleFill } from "react-bootstrap-icons";
import { toast } from "react-toastify";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";

const themeColor = "#2E57A7";
const successColor = "#28a745";

const Stepper = ({ steps, onSave, viewMode = false }) => {
  const { t } = useTranslation();
  const { changeLanguage } = useLanguageContext();
  const [activeStep, setActiveStep] = useState(0);
  const [completed, setCompleted] = useState({});
  const [errors, setErrors] = useState({});

  const totalSteps = steps.length;

  const handleNext = async () => {
    if (viewMode) {
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
      return;
    }
    
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
      } else {
        toast.error("Please fix the errors before proceeding.");
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      setActiveStep((prev) => Math.min(prev + 1, totalSteps - 1));
    }
  };

  const handleBack = () => {
    setActiveStep((prev) => Math.max(prev - 1, 0));
  };

  const handleSave = async () => {
    if (viewMode) return;
    
    const currentStep = steps[activeStep];
    if (currentStep.validate) {
      const isValid = await currentStep.validate();
      setErrors((prev) => ({ ...prev, [activeStep]: !isValid }));
      if (isValid) {
        setCompleted({ ...completed, [activeStep]: true });
        if (activeStep < totalSteps - 1) {
          setActiveStep((prev) => prev + 1);
        } else {
          onSave();
        }
      } else {
        toast.error("Please fix the errors before proceeding.");
      }
    } else {
      setCompleted({ ...completed, [activeStep]: true });
      if (activeStep < totalSteps - 1) {
        setActiveStep((prev) => prev + 1);
      } else {
        onSave();
      }
    }
  };

  const handlePayNow = () => {
    if (
      steps[activeStep] &&
      steps[activeStep].component &&
      typeof steps[activeStep].component.props.onPayNow === "function"
    ) {
      steps[activeStep].component.props.onPayNow();
    }
  };

  return (
    <Box sx={{ width: "100%", padding: "1rem" }}>
      <Paper
        elevation={3}
        sx={{
          padding: "0.75rem 1.5rem",
          borderRadius: "0.75rem",
          overflowX: "auto",
          whiteSpace: "nowrap",
          backgroundColor: "#fafafa",
        }}
      >
        <Stack direction="row" alignItems="center" spacing={1}>
          {steps.map((step, index) => (
            <React.Fragment key={index}>
              <Stack
                direction="row"
                alignItems="center"
                spacing={0.5}
                sx={{ cursor: "pointer" }}
                onClick={() => setActiveStep(index)}
              >
                {completed[index] ? (
                  <CheckCircleFill size={18} color={successColor} />
                ) : (
                  <Typography
                    sx={{
                      fontSize: "0.875rem",
                      width: "1.5rem",
                      height: "1.5rem",
                      textAlign: "center",
                      borderRadius: "50%",
                      backgroundColor: "#e0e0e0",
                      display: "inline-flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: "bold",
                      color: "#666",
                    }}
                  >
                    {index + 1}
                  </Typography>
                )}
                <Typography
                  sx={{
                    fontWeight: index === activeStep ? "bold" : "normal",
                    color: index === activeStep ? themeColor : "#999",
                    fontSize: "0.875rem",
                    whiteSpace: "nowrap",
                  }}
                >
                  {step.label}
                </Typography>
              </Stack>
              {index < steps.length - 1 && <ChevronRight size={14} color="#ccc" />}
            </React.Fragment>
          ))}
        </Stack>
      </Paper>

      <Paper
        elevation={2}
        sx={{
          marginTop: "1rem",
          borderRadius: "0.75rem",
          backgroundColor: "#fff",
          width: "100%",
        }}
      >
        {steps[activeStep].component}
        {errors[activeStep]}
      </Paper>

      {!viewMode && (
        <>
          <Divider sx={{ margin: "2rem 0" }} />

          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              gap: "1rem",
              flexWrap: "wrap",
            }}
          >
            <Button
              variant="outlined"
              onClick={handleBack}
              disabled={activeStep === 0}
              sx={{
                color: themeColor,
                borderColor: themeColor,
                fontWeight: "bold",
                borderRadius: "0.5rem",
                minWidth: "8rem",
                fontSize: "0.9rem",
              }}
            >
              {t("Previous")}
            </Button>
            
            {activeStep === totalSteps - 1 ? (
              <Button
                variant="contained"
                onClick={handlePayNow}
                sx={{
                  backgroundColor: themeColor,
                  fontWeight: "bold",
                  borderRadius: "0.5rem",
                  minWidth: "8rem",
                  fontSize: "0.9rem",
                  color: "#fff",
                  "&:hover": {
                    backgroundColor: "#1f4ea0",
                  },
                }}
              >
                {t("Pay Now")}
              </Button>
            ) : (
              <Button
                variant="contained"
                onClick={activeStep === 1 ? handleSave : handleNext}
                sx={{
                  backgroundColor: themeColor,
                  fontWeight: "bold",
                  borderRadius: "0.5rem",
                  minWidth: "8rem",
                  fontSize: "0.9rem",
                  color: "#fff",
                  "&:hover": {
                    backgroundColor: "#1f4ea0",
                  },
                }}
              >
                {activeStep === 1 ? t("Save & Next") : t("Next")}
              </Button>
            )}
          </Box>
        </>
      )}
      
      {viewMode && (
        <>
          <Divider sx={{ margin: "2rem 0" }} />
          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              gap: "1rem",
              flexWrap: "wrap",
            }}
          >
            <Button
              variant="outlined"
              onClick={handleBack}
              disabled={activeStep === 0}
              sx={{
                color: themeColor,
                borderColor: themeColor,
                fontWeight: "bold",
                borderRadius: "0.5rem",
                minWidth: "8rem",
                fontSize: "0.9rem",
              }}
            >
              {t("Previous")}
            </Button>
            
            <Button
              variant="contained"
              onClick={handleNext}
              disabled={activeStep === totalSteps - 1}
              sx={{
                backgroundColor: themeColor,
                fontWeight: "bold",
                borderRadius: "0.5rem",
                minWidth: "8rem",
                fontSize: "0.9rem",
                color: "#fff",
                "&:hover": {
                  backgroundColor: "#1f4ea0",
                },
              }}
            >
              {t("Next")}
            </Button>
          </Box>
        </>
      )}
    </Box>
  );
};

export default Stepper;

import React, { useState } from "react";
import { Button, Modal, Form } from "react-bootstrap";
import InputFile from "./InputFile";
import { useTranslation } from "react-i18next";
import { useLanguageContext } from "../common/LanguageContext";


const PaymentModal = ({
  show,
  onHide,
  paymentMode,
  setPaymentMode,
  challanFile,
  onChallanUpload,
  onOnlinePay,
  isLoading,
  formMethods, 
  supervisionAuthority, 
}) => {
  const [submitting, setSubmitting] = useState(false);

    const { t } = useTranslation();
    const { changeLanguage } = useLanguageContext();
  const handleOfflineSubmit = (e) => {
    e.preventDefault();
    setSubmitting(true);

    
    const formData = formMethods.getValues();

   
    console.log("===== VESSEL REGISTRATION FORM DATA =====");
    console.log("1. Vessel Details:", {
      basicInfo: {
        ownerName: formData.ownerName,
        ownerAddress: formData.ownerAddress,
        mobile: formData.mobile,
        email: formData.email,
        pan: formData.pan,
        aadhar: formData.aadhar,
        tradeLicence: formData.tradeLicence,
        gst: formData.gst,
        grt: formData.grt,
        workOrderValue: formData.workOrderValue,
      },
      vesselSpecs: {
        vesselType: formData.vesselType,
        category: formData.category,
        zone: formData.zone,
        supervisionAuthority: formData.supervisionAuthority,
        purchaseType: formData.purchaseType,
        classificationSociety: formData.classificationSociety,
      },
      builderDetails: formData.constructedBy === "2" ? {
        builderName: formData.builderName,
        builderAddress: formData.builderAddress,
        builderEmail: formData.builderEmail,
        builderMobile: formData.builderMobile,
        builderTradeLicence: formData.builderTradeLicence,
        builderGST: formData.builderGST,
        builderAuth: formData.builderAuth,
        authLetter: formData.authLetter,
     
      } : null,
      documents: {
        workOrderFiles: formData.workOrderFiles, 
        drawingFiles: formData.drawingFiles, 
        tonnageBooklets: formData.tonnageBooklets,
        stabilityBooklets: formData.stabilityBooklets,
      },
      declaration: {
        termsAccepted: formData.termsAccepted,
      },
    });

    console.log("2. Invoicing Details:", {
      supervisionAuthority: supervisionAuthority,
      paymentMode: paymentMode,
      challanFile: challanFile?.name || null,
    });

  
    setTimeout(() => {
      setSubmitting(false);
      onHide();
      onOnlinePay();
    }, 800);
  };

  return (
    <Modal show={show} onHide={onHide} centered>
      <Modal.Header closeButton>
        <Modal.Title>{t("Payment Option")}</Modal.Title>
      </Modal.Header>
      <Modal.Body>
        <Form onSubmit={handleOfflineSubmit}>
          <Form.Group>
            <Form.Label className="fw-semibold mb-2">
              {t("Select Payment Mode")}
            </Form.Label>
            <div className="d-flex gap-3 mb-3">
              <Form.Check
                type="radio"
                id="offline"
                label={t("Offline")}
                checked={paymentMode === "offline"}
                onChange={() => setPaymentMode("offline")}
                name="paymentMode"
              />
              <Form.Check
                type="radio"
                id="online"
                label={t("Online")}
                checked={paymentMode === "online"}
                onChange={() => setPaymentMode("online")}
                name="paymentMode"
              />
            </div>
          </Form.Group>
          {paymentMode === "offline" && (
            <div className="mb-3">
              <InputFile
                label={t("Upload Challan")}
                name="challan"
                required
                value={challanFile}
                onChange={onChallanUpload}
                errors={{}}
              />
            </div>
          )}
          <div className="d-flex justify-content-end gap-2 mt-4">
            <Button
              variant="secondary"
              onClick={onHide}
              style={{
                minWidth: 100,
                fontWeight: 500,
                borderRadius: 6,
                fontSize: "1rem",
              }}
              disabled={isLoading}
            >
             {t(" Close")}
            </Button>
            {paymentMode === "offline" ? (
              <Button
                type="submit"
                variant="primary"
                disabled={submitting || isLoading}
                style={{
                  minWidth: 120,
                  fontWeight: 600,
                  borderRadius: 6,
                  fontSize: "1rem",
                }}
              >
                {submitting ? t("Submitting...") : t("Submit")}
              </Button>
            ) : (
              <Button
                variant="success"
                onClick={onOnlinePay}
                disabled={isLoading}
                style={{
                  minWidth: 160,
                  fontWeight: 600,
                  borderRadius: 6,
                  fontSize: "1rem",
                }}
              >
                {t("Proceed to Payment Gateway")}
              </Button>
            )}
          </div>
        </Form>
      </Modal.Body>
    </Modal>
  );
};

export default PaymentModal;
