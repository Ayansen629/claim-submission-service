.heroSection {
  position: relative;
  width: 100%;
  height: 100vh;
  /* Adjust height as needed */
  background: url("/src/assets/images/homeBgImage1.jpg") no-repeat center center/cover;
  /* Replace with your image path */
  display: flex;
  /* align-items: center; */
  justify-content: center;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #0F55B2 0%, rgba(15, 85, 178, 0.66) 37.98%, rgba(255, 255, 255, 0) 100%);
  z-index: 1;
}

.heroContent {
  position: relative;
  z-index: 2;
}

.separator {
  width: 100%;
  height: 2px;
  /* thickness of the line */
  background-color: white;
}

.brandName {
  font-family: "Aptos", sans-serif;
  font-weight: 400;
  font-style: normal;
  font-size: 22px;
  line-height: 28px;
  letter-spacing: 0;
  color: white;
  margin: 0;
}

.homeLoginBtn {
  /* position: absolute;
  right: 0;
  border-radius: 4px;
  color: #1A61C1; */

  position: absolute;
  right: 86px;
  top: 12px;
  border-radius: 4px;
  color: #1A61C1;
}

@media (max-width: 998px) {
  .homeLoginBtn {
    position: relative;
    margin-left: 1rem;
  }
}

/* @media (min-width: 363px) and (max-width: 668px) {
  .homeLoginBtn {
    top: 6rem;
  }
} */

/* @media (min-width: 669px) and (max-width: 790px) {
  .homeLoginBtn {
    top: 4rem;
    right: 4rem;
  }
} */

/* @media (max-width: 362px) {
  .homeLoginBtn {
    top: 8rem;
  }
} */

.homeLoginBtn:hover {
  border-radius: 4px;
  color: white !important;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.43) 0%, rgba(0, 210, 224, 0.43) 47.12%, rgba(0, 163, 224, 0.43) 100%) !important;
}

.topNavBtn {
  border-radius: 6px;
  border: 1px solid white;
  background-color: transparent;
  color: white;
}

.topNavBtn:hover {
  border: 1px solid white;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.43) 0%, rgba(0, 210, 224, 0.43) 47.12%, rgba(0, 163, 224, 0.43) 100%) !important;

}

.section2 {
  position: relative;
  width: 100%;
  /* height: 120vh; */
  background: linear-gradient(180deg, #FFFFFF 0.96%, #00A3E0 100%);
  overflow: hidden;
}

.bgImage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: fill;
  mix-blend-mode: screen;
  z-index: 0;
}

.section2Content {
  position: relative;
  z-index: 1;
}

.navLinkItems {
  color: white !important;
  z-index: 1075;
}

.navLinkItems:hover {
  color: #2466BF !important;
}


.popupCardParent {
  width: 11rem;
  height: 11rem;
  border-radius: 4px;
  box-shadow: 0 4px 5px rgba(0, 0, 0, 0.25);
}

.popupCardInner {
  width: 9rem;
  height: 9rem;
  background-color: inherit;
  border-color: white;
  border-width: 1px;
  border-style: solid;
  border-radius: 4px;
}

.popupCardTitle {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 600;
  font-size: 25px;
  line-height: 1.2;
  letter-spacing: 0;
  color: #fff;
}

.popupCardText {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 130;
  font-size: 10px;
  line-height: 1.2;
  letter-spacing: 0;
  color: #fff;
}

.advertiseCardText {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 100;
  font-size: 1rem;
  line-height: 1.2;
  letter-spacing: 0;
  color: #0070C0;
}

.popup2CardTitle {
  font-family: "Aptos", Arial, sans-serif;
  ;
  font-weight: 700;
  font-style: Bold;
  font-size: 32px;
  line-height: 1.2;
  letter-spacing: 0;
}

.popup2CardText {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 130;
  font-size: 12px;
  line-height: 1.2;
  letter-spacing: 0;
}

.subText {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 600;
  font-size: 32px;
  line-height: 1.2;
  letter-spacing: 0;
  color: #0070C0;
}

.subTextSpan {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 300;
  font-style: Regular;
  font-size: 24px;
  line-height: 1.2;
  letter-spacing: 0;
  color: #0070C0;
}

.serviceContainer {
  width: 70%
}

.serviceCard {
  width: 16rem;
  border-radius: 5px;
  box-shadow: 0 4px 5px rgba(0, 0, 0, 0.25);
}

.serviceCardTitle {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 700;
  font-style: normal;
  /* "bold" goes in font-weight, not font-style */
  font-size: 1.05rem;
  /* ~17px (1rem ≈ 16px) */
  line-height: 1.4rem;
  /* slightly bigger than font-size for readability */
  letter-spacing: 0;
  color: #203532;
  width: 85%;
}

.serviceCardText {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 400;
  font-size: 0.7rem;
  /* ~11px */
  line-height: 1.1rem;
  letter-spacing: 0;
  text-align: center;
  width: 85%;
}


.serviceCardBtn {
  width: 100%;
  /* full width of card body */
  max-width: 85%;
  /* won’t exceed 85% */
  border-radius: 5px;
  background-color: #00A3E0;
  color: white;
  font-size: 12px;
  line-height: 1.2rem;
  height: 3.2rem;
}


.serviceCardBtnText {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 200;
  color: white;
}

.serviceCardIcon {
  width: 40px;
  height: 40px;
  object-fit: contain;
}

.serviceCardBtnIcon {
  width: 15px;
  height: 15px;
  object-fit: contain;
  margin-bottom: 0.2rem;
}

.article {
  position: relative;
  width: 100%;
  /* height: 90vh; */
  /* max-height: 150vh; */
  background: linear-gradient(180deg, #FFFFFF 0.96%, #00A3E0 100%);
  overflow: hidden;
}

.articleBgImage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: fill;
  mix-blend-mode: screen;
  z-index: 0;
}

.atricleContent {
  position: relative;
  z-index: 1;
}

.artCard {
  width: 18rem;
  position: "relative";
  border-radius: 4px;
}

.artGlobalCard {
  max-width: 20rem;
  /* min-width: 14rem; */
  max-height: 32rem;
}

.artMidCard {
  width: 18rem;
  min-width: 14rem;
  max-height: 10rem;
  min-height: 10rem;

  position: relative;
  /* fix: remove quotes */
  border-radius: 8px;
  /* slightly bigger radius */
  overflow: hidden;
  /* ensures children (image/overlay) are clipped */
}


.artLeftImg {
  width: 100%;
  height: 100%;
  min-height: 14rem;
  object-fit: cover;
}

.artRightImg {
  width: 100%;
  height: 100%;
  min-height: 13rem;
  object-fit: cover;
}

.artLeftIcon {
  position: absolute;
  top: 0.8rem;
  left: 0.8rem;
  width: 2rem;
  height: 2rem;
}

.artCardContent {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 400;
  font-size: 0.7rem;
  line-height: 1.2;
  letter-spacing: 0;
}

.subIcons {
  width: 0.8rem;
  height: 0.8rem;
}

.artRightIcon {
  width: 2rem;
  height: 2rem;
}

.artMidCard1Div {
  margin-top: 4rem;
  width: 100%;
  background: linear-gradient(180deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(0, 0, 0, 0.6) 100%);
}

.artMidCard1Content {
  font-family: "Aptos", Arial, sans-serif;
  font-weight: 400;
  font-size: 0.7rem;
  line-height: 1.2;
  letter-spacing: 0;
}

.artCenterIcon {
  width: 2rem;
  height: 2rem;
  max-width: 20%;
  height: auto;
}

.footer {
  background-Color: #1B62C0;
  width: 100%;
}

.footerTitle {
  font-family: 'Roboto', sans-serif;
  font-weight: 300;
  font-style: normal;
  font-size: 1.25rem;
  line-height: 1.2;
  letter-spacing: 0;
