import React, { useState, useEffect, useRef } from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { Container, Row, Col, Form, Button, Card, Image } from 'react-bootstrap';
import {
  FaUser, FaBuilding, FaFileUpload, FaCheck, FaArrowRight,
  FaArrowLeft, FaIdCard, FaEnvelope, FaPhone, FaMapMarkerAlt
} from 'react-icons/fa';
import Select from 'react-select';
import { toast } from 'react-toastify';
import { getData, postFORMdata } from "../../../services/http.service.ts";
import { URLS_ENDPOINT } from '../../../utils/urlsConstants.ts';
import { mapToVesselUserDetails } from '../model/mapToVesselModel.ts';
import NewLoader from '../../common/NewLoader.js';
import { useMasterData } from '../../context/MasterDataContext.js';

// Define types for our form data
interface FormData {
  ownerCategory: string;
  firstName: string;
  emailId: string;
  phoneNumber: string;
  panNumber: string;
  gstNumber?: string;
  addressLine1: string;
  addressLine2?: string;
  pin: string;
  district?: string;
  stateUt?: string;
  country: string;
  // ... add other fields as needed
}

const VesselOwnerRegistrationPage = () => {
  const { masterData } = useMasterData();
  const [currentStep, setCurrentStep] = useState(1);
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [successMessage, setSuccessMessage] = useState("");
  const loaderRef = useRef();
  const PUBLIC_URL = process.env.REACT_APP_PUBLIC_URL;

  const methods = useForm<FormData>({
    mode: 'onBlur',
    defaultValues: { 
      ownerCategory: '', 
      country: 'India',
      // Add other default values as needed
    }
  });

  const { 
    register, 
    handleSubmit, 
    formState: { errors }, 
    trigger, 
    setValue, 
    getValues, 
    watch, 
    clearErrors,
    control
  } = methods;

  const totalSteps = 3;
  const ownerCategory = watch('ownerCategory');
  const pinCode = watch('pin');

  // Watch for PIN code changes and fetch details when length is 6
  useEffect(() => {
    if (pinCode?.length === 6) {
      setValue('district', '');
      setValue('stateUt', '');
      getDetailsByPIN(pinCode);
    }
  }, [pinCode, setValue]);

  const getDetailsByPIN = async (pinCode: string) => {
    try {
      const URL = PUBLIC_URL + URLS_ENDPOINT.APP_SERVICES.GET_DETAILS_BY_PINCODE + pinCode;
      loaderRef.current?.show();
      const response = await getData(URL);
      
      if (response?.status === 200 && response?.data?.length > 0) {
        setValue('district', response.data[0].district, { shouldValidate: true });
        setValue('stateUt', response.data[0].stateName, { shouldValidate: true });
        setValue('country', 'India', { shouldValidate: true });
        loaderRef.current?.hide();
      } else {
        loaderRef.current?.hide();
        toast.info("No data found for this PIN code. Please enter details manually.", { 
          position: "top-right",
          autoClose: 5000
        });
      }
    } catch (err) {
      console.error("Error fetching PIN code details:", err);
      loaderRef.current?.hide();
      toast.error("Failed to fetch PIN code details. Please try again or enter manually.", {
        position: "top-right",
        autoClose: 5000
      });
    }
  };

  const formFields = {
    step1: [
      {
        name: 'ownerCategory',
        label: 'Category of Owner',
        type: 'select',
        options: [
          { value: '', label: 'Select Category', isDisabled: true },
          ...(masterData?.data?.ownerTypes?.map(type => ({
            value: type.valueCode,
            label: type.valueLabel
          })) || [])
        ],
        required: true,
        icon: FaBuilding,
        colSize: 6,
        validation: { 
          required: 'Owner category is required',
          validate: (value: string) => value !== '' || 'Owner category is required'
        }
      },
      {
        name: 'firstName',
        label: 'Owner/Company Name',
        type: 'text',
        required: true,
        icon: FaUser,
        colSize: 6,
        placeholder: 'Enter owner or company name',
        validation: { required: 'Owner name is required' }
      },
      {
        name: 'emailId',
        label: 'Email ID',
        type: 'email',
        required: true,
        icon: FaEnvelope,
        colSize: 6,
        placeholder: 'Enter email address',
        validation: {
          required: 'Email is required',
          pattern: {
            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
            message: 'Invalid email address'
          }
        }
      },
      {
        name: 'phoneNumber',
        label: 'Phone Number',
        type: 'text',
        required: true,
        icon: FaPhone,
        colSize: 6,
        placeholder: 'Enter 10-digit phone number',
        validation: {
          required: 'Phone number is required',
          pattern: {
            value: /^[0-9]{10}$/,
            message: 'Phone number must be 10 digits'
          }
        }
      },
      {
        name: 'panNumber',
        label: 'PAN Number',
        type: 'text',
        required: true,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter PAN number (e.g., ABCDE1234F)',
        validation: {
          required: 'PAN number is required',
          pattern: {
            value: /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/,
            message: 'Invalid PAN format'
          }
        }
      },
      {
        name: 'gstNumber',
        label: 'GST Number',
        type: 'text',
        required: false,
        icon: FaIdCard,
        colSize: 6,
        placeholder: 'Enter GST number (if applicable)',
        validation: {
          pattern: {
            value: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/,
            message: 'Invalid GST format'
          }
        }
      },
      {
        name: 'addressLine1',
        label: 'Address Line-1',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 1',
        validation: { required: 'Address is required' }
      },
      {
        name: 'addressLine2',
        label: 'Address Line-2',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Enter address line 2 (optional)'
      },
      {
        name: 'pin',
        label: 'PIN',
        type: 'text',
        required: true,
        icon: FaMapMarkerAlt,
        colSize: 6,
        maxlength: 6,
        placeholder: 'Enter 6-digit PIN code',
        validation: {
          required: 'PIN code is required',
          pattern: {
            value: /^[0-9]{6}$/,
            message: 'PIN must be 6 digits'
          }
        }
      },
      {
        name: 'district',
        label: 'District',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'District will auto-fill from PIN'
      },
      {
        name: 'stateUt',
        label: 'State / UT',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'State will auto-fill from PIN'
      },
      {
        name: 'country',
        label: 'Country',
        type: 'text',
        required: false,
        icon: FaMapMarkerAlt,
        colSize: 6,
        placeholder: 'Country will auto-fill from PIN'
      }
    ],
    // ... step2 and step3 fields (similar structure)
  };

  const getCurrentStepFields = () => {
    switch (currentStep) {
      case 1: return formFields.step1;
      // case 2: return formFields.step2;
      // case 3: return formFields.step3;
      default: return [];
    }
  };

  const validateStep = async () => {
    const currentFields = getCurrentStepFields();
    const fieldsToValidate = currentFields
      .filter(field => !field.showIf || field.showIf())
      .map(field => field.name);
    
    const isValid = await trigger(fieldsToValidate);

    // Additional validation for select fields
    if (isValid) {
      for (const field of currentFields) {
        if (field.type === 'select' && field.required) {
          const value = getValues(field.name as keyof FormData);
          if (!value) {
            setError(field.name, {
              type: 'required',
              message: `${field.label} is required`
            });
            return false;
          }
        }
      }
    }

    return isValid;
  };

  const handleNext = async () => {
    const isStepValid = await validateStep();
    if (isStepValid) {
      if (currentStep < totalSteps) {
        setCurrentStep(currentStep + 1);
        window.scrollTo(0, 0);
      } else {
        handleSubmit(onSubmit)();
      }
    }
  };

  const handlePrevious = () => {
    setCurrentStep(Math.max(1, currentStep - 1));
    window.scrollTo(0, 0);
  };

  const onSubmit = (data: FormData) => {
    const formDetails = mapToVesselUserDetails(data);
    const fd = new FormData();
    fd.append("request", new Blob([JSON.stringify(formDetails)], { type: 'application/json' }));
    // Add files to FormData if needed
    submitUserDetails(fd);
  };

  const submitUserDetails = async (payload: FormData) => {
    try {
      const URL = process.env.REACT_APP_AUTH_URL + URLS_ENDPOINT.USER_SERVICE.CREATE_USER;
      loaderRef.current?.show();
      const response = await postFORMdata(URL, payload);
      const apiRes = response?.data;
      
      if (response?.status === 200 && apiRes?.responseStatus?.status === '200') {
        loaderRef.current?.hide();
        setIsSubmitted(true);
        setSuccessMessage(apiRes?.responseStatus?.message);
        window.scrollTo(0, 0);
      } else {
        loaderRef.current?.hide();
        toast.error(apiRes?.responseStatus?.message || "Something went wrong", { position: "top-right" });
      }
    } catch (err) {
      console.error(err);
      loaderRef.current?.hide();
      toast.error("Failed to submit form. Please try again.", { position: "top-right" });
    }
  };

  const InputSelect = ({ field }: { field: any }) => {
    const fieldValue = watch(field.name);
    const selectedOption = field.options.find((opt: any) => opt.value === fieldValue);

    return (
      <Form.Group className={`mb-4`} controlId={field.name}>
        <Form.Label className="fw-semibold d-block">
          {field.label}
          {field.required && <span className="text-danger ms-1">*</span>}
        </Form.Label>

        <div className="position-relative">
          {field.icon && (
            <div className="input-icon position-absolute text-primary"
              style={{
                left: "10px",
                top: "50%",
                transform: "translateY(-50%)",
                zIndex: 2,
              }}
            >
              <field.icon size={18} />
            </div>
          )}

          <Select
            options={field.options}
            value={selectedOption}
            onChange={(selected: any) => {
              setValue(field.name, selected?.value || '', { shouldValidate: true });
            }}
            isDisabled={field.disabled}
            isClearable={!field.required}
            className={`react-select-container ${errors[field.name] ? "is-invalid" : ""}`}
            classNamePrefix="react-select"
            styles={{
              control: (base, state) => ({
                ...base,
                borderColor: errors[field.name] ? "#dc3545" : state.isFocused ? "#80bdff" : "#ced4da",
                boxShadow: state.isFocused && !errors[field.name] ? "0 0 0 0.2rem rgba(0, 123, 255, 0.25)" : "none",
                paddingLeft: field.icon ? "40px" : "12px",
                backgroundColor: errors[field.name] ? "#fff8f8" : "white",
                minHeight: "calc(1.5em + 1rem + 2px)",
                "&:hover": {
                  borderColor: errors[field.name] ? "#dc3545" : "#ced4da"
                }
              }),
              menu: (base) => ({
                ...base,
                zIndex: 9999
              })
            }}
          />
        </div>

        {errors[field.name] && (
          <Form.Text className="text-danger small mt-1 d-block">
            {errors[field.name]?.message}
          </Form.Text>
        )}
      </Form.Group>
    );
  };

  const InputText = ({ field }: { field: any }) => {
    return (
      <Form.Group className={`mb-4`} controlId={field.name}>
        <Form.Label className="fw-semibold d-block">
          {field.label}
          {field.required && <span className="text-danger ms-1">*</span>}
        </Form.Label>

        <div className="position-relative">
          {field.icon && (
            <div className="input-icon position-absolute text-primary"
              style={{
                left: "10px",
                top: "50%",
                transform: "translateY(-50%)",
                zIndex: 2,
              }}
            >
              <field.icon size={18} />
            </div>
          )}

          <Form.Control
            type={field.type}
            placeholder={field.placeholder}
            {...register(field.name, field.validation)}
            isInvalid={!!errors[field.name]}
            maxLength={field.maxlength}
            onChange={(e: React.ChangeEvent<HTMLInputElement>) => {
              if (field.onChange) {
                field.onChange(e, setValue, watch);
              }
            }}
            style={{
              paddingLeft: field.icon ? "40px" : "12px",
              borderColor: errors[field.name] ? "#dc3545" : "#ced4da",
              backgroundColor: errors[field.name] ? "#fff8f8" : "white"
            }}
          />
        </div>

        {errors[field.name] && (
          <Form.Text className="text-danger small mt-1 d-block">
            {errors[field.name]?.message}
          </Form.Text>
        )}
      </Form.Group>
    );
  };

  const DynamicField = ({ field }: { field: any }) => {
    if (field.showIf && !field.showIf()) return null;

    switch (field.type) {
      case 'select':
        return <InputSelect field={field} />;
      case 'text':
      case 'email':
        return <InputText field={field} />;
      // Add cases for other field types as needed
      default:
        return <InputText field={field} />;
    }
  };

  const stepTitles = [
    { title: "Vessel Owner Details", icon: FaBuilding },
    { title: "Authorized Person's Details", icon: FaUser },
    { title: "Documents Upload", icon: FaFileUpload }
  ];

  return (
    <>
      <NewLoader ref={loaderRef} />
      <Container fluid className="registration-container py-5">
        <Row className="justify-content-center">
          <Col lg={10} xl={9}>
            <Card className="registration-card">
              <Card.Header className="registration-header p-0">
                <div className="registration-header-content">
                  <div className="header-logo-container">
                    <Image
                      src={IWT_FULL_IMG}
                      alt="IWT Logo"
                      className="header-logo"
                    />
                  </div>
                  <h3 className="header-title">
                    Vessel Owner Registration
                  </h3>
                </div>
              </Card.Header>

              <Card.Body className="registration-body p-4 p-md-5">
                {isSubmitted ? (
                  <div className="success-container text-center py-5">
                    <div className="success-icon-container bg-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style={{ width: '90px', height: '90px', boxShadow: '0 10px 20px rgba(40, 167, 69, 0.3)' }}>
                      <FaCheck className="success-icon text-white fs-1" />
                    </div>
                    <h4 className="success-title text-success mb-3 fw-bold">Registration Successful!</h4>
                    <div className="registration-id p-4 bg-light rounded mb-4" style={{ borderLeft: '4px solid #0077b6' }}>
                      {successMessage}
                    </div>
                    <Button
                      variant="primary"
                      size="lg"
                      className="mt-2 d-flex align-items-center justify-content-center mx-auto"
                      style={{
                        background: 'linear-gradient(135deg, #0077b6, #023e8a)',
                        border: 'none',
                        boxShadow: '0 4px 15px rgba(0, 119, 182, 0.3)',
                        borderRadius: '8px',
                        padding: '12px 30px',
                        fontWeight: '600',
                        transition: 'all 0.3s ease',
                        minWidth: '150px',
                        height: '50px'
                      }}
                      onClick={() => window.location.href = '/'}
                    >
                      Go to Home
                    </Button>
                  </div>
                ) : (
                  <FormProvider {...methods}>
                    <form>
                      <div className="text-center mb-4">
                        <p className="text-muted">Please complete all required information to register your vessel</p>
                      </div>

                      <div className="stepper-container mb-5">
                        <div className="stepper d-flex justify-content-between">
                          {[1, 2, 3].map((step) => (
                            <React.Fragment key={step}>
                              <div className={`step ${currentStep >= step ? 'active' : ''} ${currentStep > step ? 'completed' : ''} flex-grow-1 text-center`}>
                                <div
                                  className="step-icon d-flex align-items-center justify-content-center mx-auto mb-2"
                                  style={{
                                    width: '60px',
                                    height: '60px',
                                    borderRadius: '50%',
                                    fontSize: '20px',
                                    fontWeight: 'bold',
                                    boxShadow: currentStep >= step ? '0 5px 15px rgba(0, 119, 182, 0.3)' : '0 4px 10px rgba(0, 0, 0, 0.1)',
                                    background: currentStep >= step ?
                                      (currentStep > step ? 'linear-gradient(135deg, #28a745, #20c997)' : 'linear-gradient(135deg, #0077b6, #023e8a)') :
                                      '#ffffff',
                                    border: currentStep >= step ? 'none' : '2px solid #e9ecef',
                                    color: currentStep >= step ? '#fff' : '#6c757d',
                                    transition: 'all 0.4s ease'
                                  }}>
                                  {currentStep > step ? <FaCheck size={22} /> : React.createElement(stepTitles[step - 1].icon, { size: 22 })}
                                </div>
                                <div className="step-label fw-bold"
                                  style={{
                                    color: currentStep >= step ? (currentStep > step ? '#28a745' : '#0077b6') : '#6c757d',
                                    fontSize: '0.9rem',
                                    transition: 'all 0.3s ease'
                                  }}>
                                  {stepTitles[step - 1].title}
                                </div>
                              </div>
                              {step < 3 && (
                                <div className="step-connector flex-grow-1 d-flex align-items-center px-2">
                                  <div className={`connector-line w-100 ${currentStep > step ? 'active' : ''}`}
                                    style={{
                                      height: '4px',
                                      background: currentStep > step ? 'linear-gradient(to right, #28a745, #20c997)' : '#e9ecef',
                                      borderRadius: '2px',
                                      transition: 'all 0.5s ease'
                                    }}></div>
                                </div>
                              )}
                            </React.Fragment>
                          ))}
                        </div>
                      </div>

                      <div className="step-content">
                        <div className="form-section p-4 rounded mb-4">
                          <div className="section-title">
                            {React.createElement(stepTitles[currentStep - 1].icon, { className: "section-icon" })}
                            <h4 className="mb-0 fw-bold">{stepTitles[currentStep - 1].title}</h4>
                          </div>

                          <div className="form-content py-3">
                            <Row className="g-4">
                              {getCurrentStepFields().map((field, index) => (
                                <Col key={index} md={field.colSize || 12} className="mb-2">
                                  <DynamicField field={field} />
                                </Col>
                              ))}
                            </Row>
                          </div>
                        </div>
                      </div>

                      <div className="form-navigation mt-4" style={{ display: 'block' }}>
                        {currentStep > 1 && (
                          <Button
                            variant="outline-secondary"
                            onClick={handlePrevious}
                            className="prev-btn"
                            style={{ float: 'left' }}
                          >
                            <FaArrowLeft className="btn-icon me-2" /> Previous
                          </Button>
                        )}

                        <Button
                          variant="primary"
                          onClick={handleNext}
                          className="next-btn"
                          style={{ float: 'right' }}
                        >
                          {currentStep === totalSteps ? 'Submit Registration' : 'Next'}
                          {currentStep !== totalSteps && <FaArrowRight className="btn-icon ms-2" />}
                        </Button>
                      </div>
                    </form>
                  </FormProvider>
                )}
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Container>
    </>
  );
};

export default VesselOwnerRegistrationPage;
