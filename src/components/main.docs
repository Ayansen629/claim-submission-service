import { axiosInstance, axiosBlobInstance } from "./config";

export const getData = async (url: string) => {
  return await axiosInstance.get(url);
};

export const getBlobData = async (url: string) => {
  return await axiosBlobInstance.get(url, {
    headers: {
      "Accept": "application/octet-stream",
    },
  });
};

export const postData = async (url: string, payload?: any, headers?: any) => {
  return await axiosInstance.post(url, payload || {});
};

export const postFORMdata = async (url: string, payload?: any, headers?: any) => {
  const requestHeaders = {
    headers: {
      "Content-Type": "multipart/form-data",
      ...headers,
    },
  };
  return await axiosInstance.post(url, payload || {}, requestHeaders);
};

export const updateData = async (url: string, payload?: any) => {
  return await axiosInstance.put(url, payload || {});
};

export const deleteData = async (url: string) => {
  return await axiosInstance.delete(url);
};
