import React, { useState, useEffect } from "react";
import { useForm, FormProvider, Controller } from "react-hook-form";
import Collapsible from "../formCommon/Collapsible";
import Tooltip from "@mui/material/Tooltip";
import { FaInfoCircle } from "react-icons/fa";
import axios from "axios";

const DynamicField = ({ fieldConfig, control, register, errors, setValue, getValues, watch }) => {
  const { name, label, type, options, rules, tooltip, placeholder, rows, show } = fieldConfig;
  const hasError = errors[name];

  const handleRadioChange = (value) => {
    setValue(name, value);
    if (fieldConfig.onChange) fieldConfig.onChange(value);
  };

  if (show !== undefined && !show) return null;

  return (
    <div className="flex-item">
      <label>
        {label}
        {tooltip && (
          <Tooltip title={tooltip} arrow>
            <span style={{ marginLeft: "5px", cursor: "pointer" }}>
              <FaInfoCircle />
            </span>
          </Tooltip>
        )}
      </label>
      
      {type === "select" ? (
        <select
          {...register(name, rules)}
          className={`form-input ${hasError ? "input-error" : ""}`}
          onChange={(e) => {
            setValue(name, e.target.value);
            if (fieldConfig.onChange) fieldConfig.onChange(e.target.value);
          }}
        >
          {options.map((option) => (
            <option key={option.value} value={option.value} disabled={option.disabled}>
              {option.label}
            </option>
          ))}
        </select>
      ) : type === "radio" ? (
        <div className="radio-group">
          {options.map((option) => (
            <label key={option.value} className="radio-option">
              <input
                type="radio"
                {...register(name, rules)}
                value={option.value}
                checked={watch(name) === option.value}
                onChange={() => handleRadioChange(option.value)}
              />
              {option.label}
            </label>
          ))}
        </div>
      ) : type === "textarea" ? (
        <textarea
          {...register(name, rules)}
          className={`form-input ${hasError ? "input-error" : ""}`}
          rows={rows || 3}
          placeholder={placeholder}
        />
      ) : type === "date" ? (
        <input
          {...register(name, rules)}
          type="date"
          className={`form-input ${hasError ? "input-error" : ""}`}
          placeholder={placeholder}
        />
      ) : (
        <input
          {...register(name, rules)}
          type={type}
          className={`form-input ${hasError ? "input-error" : ""}`}
          placeholder={placeholder}
        />
      )}
      {hasError && <p className="error-message">{errors[name]?.message}</p>}
    </div>
  );
};

const IFSCSearch = ({ fieldConfig, register, errors, setValue }) => {
  const [bankDetails, setBankDetails] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);

  const fetchBankDetails = async (ifsc) => {
    if (ifsc.length < 4) return;
    
    setLoading(true);
    setError(null);
    try {
      const response = await axios.get(`https://ifsc.razorpay.com/${ifsc}`);
      setBankDetails(response.data);
      setValue("bankName", response.data.BANK);
      setValue("branchName", response.data.BRANCH);
      setValue("branchAddress", `${response.data.ADDRESS}, ${response.data.CITY}, ${response.data.STATE}`);
      setValue("city", response.data.CITY);
      setValue("state", response.data.STATE);
      setValue("district", response.data.DISTRICT);
    } catch (err) {
      setError("Invalid IFSC code or failed to fetch details");
      setBankDetails(null);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="flex-item">
      <label>{fieldConfig.label}</label>
      <input
        {...register(fieldConfig.name, fieldConfig.rules)}
        type="text"
        className={`form-input ${errors[fieldConfig.name] ? "input-error" : ""}`}
        placeholder={fieldConfig.placeholder}
        onChange={(e) => {
          setValue(fieldConfig.name, e.target.value);
          fetchBankDetails(e.target.value);
        }}
      />
      {loading && <p className="loading-message">Loading bank details...</p>}
      {error && <p className="error-message">{error}</p>}
      {bankDetails && (
        <div className="bank-details">
          <p><strong>Bank:</strong> {bankDetails.BANK}</p>
          <p><strong>Branch:</strong> {bankDetails.BRANCH}</p>
          <p><strong>Address:</strong> {bankDetails.ADDRESS}, {bankDetails.CITY}, {bankDetails.STATE}</p>
          <p><strong>District:</strong> {bankDetails.DISTRICT}</p>
        </div>
      )}
      {errors[fieldConfig.name] && (
        <p className="error-message">{errors[fieldConfig.name].message}</p>
      )}
    </div>
  );
};

const FormCDetails = ({ provideSubmitHandler, formData }) => {
  const methods = useForm();
  const { register, handleSubmit, formState: { errors }, control, setValue, getValues, watch, reset } = methods;
  const [selectedClaimType, setSelectedClaimType] = useState("");
  const [showSecurityFields, setShowSecurityFields] = useState(false);
  const [showGuaranteeFields, setShowGuaranteeFields] = useState(false);
  const [principalBorrowers, setPrincipalBorrowers] = useState([1]);

  const onSubmit = (data) => {
    if (provideSubmitHandler) {
      provideSubmitHandler(data);
    }
  };

  useEffect(() => {
    if (formData) {
      reset(formData);
      if (formData.claimType) {
        setSelectedClaimType(formData.claimType);
      }
      if (formData.hasSecurityInterest === "yes") {
        setShowSecurityFields(true);
      }
      if (formData.hasGuarantee === "yes") {
        setShowGuaranteeFields(true);
      }
      // Initialize principal borrowers if data exists
      if (formData.principalBorrowerName1) {
        const borrowerCount = Object.keys(formData).filter(key => 
          key.startsWith("principalBorrowerName")
        ).length;
        setPrincipalBorrowers(Array.from({length: borrowerCount}, (_, i) => i + 1));
      }
    }
  }, [formData, reset]);

  const handleClaimTypeChange = (value) => {
    setSelectedClaimType(value);
    // Reset form when claim type changes
    reset({
      claimType: value,
      hasSecurityInterest: "",
      hasGuarantee: ""
    });
    setShowSecurityFields(false);
    setShowGuaranteeFields(false);
    setPrincipalBorrowers([1]);
  };

  const handleSecurityInterestChange = (value) => {
    setShowSecurityFields(value === "yes");
  };

  const handleGuaranteeChange = (value) => {
    setShowGuaranteeFields(value === "yes");
  };

  const addPrincipalBorrower = () => {
    setPrincipalBorrowers([...principalBorrowers, principalBorrowers.length + 1]);
  };

  const removePrincipalBorrower = (index) => {
    if (principalBorrowers.length <= 1) return;
    
    const newBorrowers = [...principalBorrowers];
    newBorrowers.splice(index, 1);
    setPrincipalBorrowers(newBorrowers);
    
    // Clear the removed borrower's data
    const borrowerNum = index + 1;
    setValue(`principalBorrowerName${borrowerNum}`, undefined);
    setValue(`principalBorrowerAddress${borrowerNum}`, undefined);
  };

  // Claim type options
  const claimTypeOptions = [
    { value: "", label: "Select Claim Type", disabled: true },
    { value: "principalBorrower", label: "Corporate Debtor as Principal Borrower" },
    { value: "guarantor", label: "Corporate Debtor as Guarantor" },
    { value: "financialDebt", label: "Financial Debt Covered" },
  ];

  // Common fields for principal borrower and guarantor
  const commonClaimFields = [
    {
      name: "claimAmount",
      label: "Amount of claim",
      type: "number",
      rules: { required: "Claim amount is required" },
      placeholder: "Enter claim amount"
    },
    {
      name: "hasSecurityInterest",
      label: "Amount of claim covered by security interest",
      type: "radio",
      options: [
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" }
      ],
      rules: { required: "This field is required" },
      onChange: handleSecurityInterestChange
    },
    {
      name: "securityValue",
      label: "Value of the security",
      type: "number",
      rules: showSecurityFields ? { required: "Security value is required" } : {},
      placeholder: "Enter security value",
      show: showSecurityFields
    },
    {
      name: "securityDate",
      label: "Date of the security",
      type: "date",
      rules: showSecurityFields ? { required: "Security date is required" } : {},
      placeholder: "Select security date",
      show: showSecurityFields
    },
    {
      name: "hasGuarantee",
      label: "Amount of claim covered by guarantee",
      type: "radio",
      options: [
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" }
      ],
      rules: { required: "This field is required" },
      onChange: handleGuaranteeChange
    },
    {
      name: "guaranteeValue",
      label: "Value of the guarantee",
      type: "number",
      rules: showGuaranteeFields ? { required: "Guarantee value is required" } : {},
      placeholder: "Enter guarantee value",
      show: showGuaranteeFields
    },
    {
      name: "guaranteeDate",
      label: "Date of the guarantee",
      type: "date",
      rules: showGuaranteeFields ? { required: "Guarantee date is required" } : {},
      placeholder: "Select guarantee date",
      show: showGuaranteeFields
    }
  ];

  // Bank account fields
  const bankAccountFields = [
    {
      name: "accountNumber",
      label: "Account Number",
      type: "text",
      rules: { required: "Account number is required" },
      placeholder: "Enter account number"
    },
    {
      name: "ifscCode",
      label: "IFSC Code",
      type: "text",
      rules: { 
        required: "IFSC code is required",
        pattern: {
          value: /^[A-Za-z]{4}0[A-Za-z0-9]{6}$/,
          message: "Invalid IFSC code format"
        }
      },
      placeholder: "Enter IFSC code",
      component: IFSCSearch
    },
    {
      name: "bankName",
      label: "Bank Name",
      type: "text",
      rules: { required: "Bank name is required" },
      placeholder: "Enter bank name"
    },
    {
      name: "branchName",
      label: "Branch Name",
      type: "text",
      rules: { required: "Branch name is required" },
      placeholder: "Enter branch name"
    },
    {
      name: "branchAddress",
      label: "Branch Address",
      type: "text",
      rules: { required: "Branch address is required" },
      placeholder: "Enter branch address"
    },
    {
      name: "city",
      label: "City",
      type: "text",
      rules: { required: "City is required" },
      placeholder: "Enter city"
    },
    {
      name: "state",
      label: "State",
      type: "text",
      rules: { required: "State is required" },
      placeholder: "Enter state"
    },
    {
      name: "district",
      label: "District",
      type: "text",
      rules: { required: "District is required" },
      placeholder: "Enter district"
    }
  ];

  return (
    <FormProvider {...methods}>
      <form className="form-stepper" onSubmit={handleSubmit(onSubmit)}>
        {/* Claim Type Selection */}
        <div className="mb-4 bg-light">
          <div className="flex-item">
            <label>
              Select Claim Type <span className="required-asterisk">*</span>
            </label>
            <select
              {...register("claimType", { required: "Claim type is required" })}
              className={`form-input ${errors.claimType ? "input-error" : ""}`}
              onChange={(e) => handleClaimTypeChange(e.target.value)}
              value={selectedClaimType}
            >
              {claimTypeOptions.map((option) => (
                <option key={option.value} value={option.value} disabled={option.disabled}>
                  {option.label}
                </option>
              ))}
            </select>
            {errors.claimType && <p className="error-message">{errors.claimType.message}</p>}
          </div>
        </div>

        {/* Claim Details Section */}
        {selectedClaimType === "principalBorrower" && (
          <div className="mb-4 bg-light">
            <Collapsible title="Details of claim: Corporate Debtor as Principal Borrower">
              <div className="flex-container">
                {commonClaimFields.map((field) => (
                  <DynamicField
                    key={field.name}
                    fieldConfig={field}
                    control={control}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    getValues={getValues}
                    watch={watch}
                  />
                ))}

                {/* Principal Borrower fields */}
                {principalBorrowers.map((borrowerNum, index) => (
                  <React.Fragment key={borrowerNum}>
                    <div className="flex-item-with-button">
                      <DynamicField
                        fieldConfig={{
                          name: `principalBorrowerName${borrowerNum}`,
                          label: `Name of the Principal Borrower ${borrowerNum}`,
                          type: "text",
                          rules: { required: "This field is required" },
                          placeholder: "Enter name"
                        }}
                        control={control}
                        register={register}
                        errors={errors}
                        setValue={setValue}
                        getValues={getValues}
                        watch={watch}
                      />
                      {index > 0 && (
                        <button 
                          type="button" 
                          className="remove-btn"
                          onClick={() => removePrincipalBorrower(index)}
                        >
                          Remove
                        </button>
                      )}
                    </div>

                    <DynamicField
                      fieldConfig={{
                        name: `principalBorrowerAddress${borrowerNum}`,
                        label: `Address of the Principal Borrower ${borrowerNum}`,
                        type: "text",
                        rules: { required: "This field is required" },
                        placeholder: "Enter address"
                      }}
                      control={control}
                      register={register}
                      errors={errors}
                      setValue={setValue}
                      getValues={getValues}
                      watch={watch}
                    />
                  </React.Fragment>
                ))}

                <button 
                  type="button" 
                  className="add-more-btn" 
                  onClick={addPrincipalBorrower}
                >
                  + Add 
                </button>

                {/* Common fields for all claim types */}
                <DynamicField
                  fieldConfig={{
                    name: "debtDetails",
                    label: "Details of how debt incurred",
                    type: "textarea",
                    rules: { required: "This field is required" },
                    placeholder: "Enter details of how debt was incurred"
                  }}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  getValues={getValues}
                  watch={watch}
                />

                <DynamicField
                  fieldConfig={{
                    name: "debtDate",
                    label: "Date of debt incurred",
                    type: "date",
                    rules: { required: "This field is required" },
                    placeholder: "Select date"
                  }}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  getValues={getValues}
                  watch={watch}
                />

                <DynamicField
                  fieldConfig={{
                    name: "mutualDetails",
                    label: "Details of any mutual credit, mutual debts, or other mutual dealings between the corporate debtor and the creditor which may be set-off against the claim",
                    type: "textarea",
                    rows: 5,
                    placeholder: "Enter details of any mutual dealings"
                  }}
                  control={control}
                  register={register}
                  errors={errors}
                  setValue={setValue}
                  getValues={getValues}
                  watch={watch}
                />
              </div>
            </Collapsible>
          </div>
        )}

        {/* Bank Account Details Section (always shown) */}
        <div className="mb-4 bg-light">
          <Collapsible title="Bank Account Details">
            <div className="flex-container">
              {bankAccountFields.map((field) => (
                field.component ? (
                  <field.component
                    key={field.name}
                    fieldConfig={field}
                    control={control}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    getValues={getValues}
                    watch={watch}
                  />
                ) : (
                  <DynamicField
                    key={field.name}
                    fieldConfig={field}
                    control={control}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    getValues={getValues}
                    watch={watch}
                  />
                )
              ))}
            </div>
          </Collapsible>
        </div>

        
      </form>
    </FormProvider>
  );
};

export default FormCDetails;
