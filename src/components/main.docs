              <InputText
                label={t("Address 1 of Builder")}
                name="basicDetails.builderDetails.addressLine1"
                placeholder={!viewMode ? t("Enter Address 1 of Builder") : ""}
                register={register("basicDetails.builderDetails.addressLine1")}
                errors={errors}
                disabled={viewMode}
                style={{ backgroundColor: "#f8f9fa" }}
              />
            </Col>
             <Col md={4}>
              <InputText
                label={t("Address 2 of Builder")}
                name="basicDetails.builderDetails.addressLine2"
                placeholder={!viewMode ? t("Enter Address 2 of Builder") : ""}
                register={register("basicDetails.builderDetails.addressLine2")}
