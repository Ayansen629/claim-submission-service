const handleBookOfRegistrationSubmit = async () => {
  try {
    loaderRef.current?.show();
    
    const formData = methods?.getValues();
    
    const payload = {
      ...originalRegistrationData,
      vesselDetails: {
        ...originalRegistrationData?.vesselDetails,
        surveyId: intialSurveyData?.surveyId || "",
        lengthOfVessel: parseFloat(intialSurveyData?.BasicVesselInformation?.lengthOfVessel) || 0,
        breadthOfVessel: parseFloat(intialSurveyData?.BasicVesselInformation?.breadthOfVessel) || 0,
        depthOfVessel: parseFloat(intialSurveyData?.BasicVesselInformation?.depthOfVessel) || 0,
        hullMaterial: intialSurveyData?.HullParticulars?.hullMaterial || "",
        noOfBulkheads: parseFloat(intialSurveyData?.HullParticulars?.noOfBulkheads) || 0,
      },
      engineDetails: {
        ...originalRegistrationData?.engineDetails,
        internalCombustionEngineNo: formData?.bookOfRegistration?.engine?.engineNo || "",
        description: formData?.bookOfRegistration?.engine?.description || "",
        noOfCylindersPerSet: formData?.bookOfRegistration?.engine?.cylindersPerSet || "",
        nhp: parseFloat(formData?.bookOfRegistration?.engine?.nhp) || null,
        ihp: parseFloat(formData?.bookOfRegistration?.engine?.ihp) || null,
        propulsionType: formData?.bookOfRegistration?.propulsion?.propulsionType || "",
        boilderDescription: formData?.certificateOfRegistration?.particularsOfBoilers?.description || "",
        boilerNumber: formData?.certificateOfRegistration?.particularsOfBoilers?.number || "",
        loadedPressure: formData?.certificateOfRegistration?.particularsOfBoilers?.loadedPressure || "",
        lengthOfEngineRoom: parseFloat(intialSurveyData?.DetailsofPropulsionofEngine?.lengthOfEngineRoom) || 0,
        noOfCylinderPerSetRotaryEngine: parseInt(intialSurveyData?.DetailsofPropulsionofEngine?.noOfCylinderPerSetRotaryEngine) || 0,
        noOfCylinderPerSetReciprocatingEngine: parseInt(intialSurveyData?.DetailsofPropulsionofEngine?.noOfCylinderPerSetReciprocatingEngine) || 0,
        noOfShaft: parseInt(intialSurveyData?.DetailsofPropulsionofEngine?.noOfShaft) || 0,
      },
    };

    const apiUrl = SERVICE_BASE.IWT_REGISTRATION + URLS_ENDPOINT.VESSEL_SERVICE.CREATE;
    const response = await postData(apiUrl, payload);

    if (response?.status === 200 && response?.data?.responseStatus) {
      toast.success(response?.data?.responseStatus?.message || "Book of Registration saved successfully!");
      return true;
    } else {
      toast.error(response?.data?.responseStatus?.message || "Failed to save Book of Registration.");
      return false;
    }
  } catch (error) {
    console.error("Book of Registration submission error:", error);
    toast.error("Failed to save Book of Registration. Please try again.");
    return false;
  } finally {
    loaderRef.current?.hide();
  }
};
