/* General Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Main Header */
.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 1.5rem;
  background-color: #fff; 
  /* border-bottom: 1px solid #34495e; */
  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
  top: 0;
  left: 0;
  width: 100%;
  position: fixed;
  z-index: 1000;
}

/* Logo Section */
.header-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo-container {
  width: 50px;
  height: 50px;
  /* background-color: #34495e; */
  border-radius: 60%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.2);
}

.logo {
  width: 30px;
  height: 30px;
  object-fit: contain;
}

.header-title h4 {
  font-size: 18px;
  font-weight: bold;
  color: #269ccc; 
  margin: 0;
}

.header-title p {
  font-size: 14px;
  font-weight: bold;
  color: #99c8e8; 
  margin: 0;
}

/* Navigation Menu */
.header-nav {
  display: flex;
  align-items: center;
}

.nav-list {
  display: flex;
  list-style-type: none;
  gap: 1.5rem;
  margin: 0;
  padding: 0;
}

.nav-item {
  position: relative;
}

.nav-link {
  text-decoration: none;
  font-size: 16px;
  font-weight: bold;
  color: #7b7b7b;
  transition: color 0.2s ease;
  padding: 0.5rem 0;
  display: block;
}

.nav-link:hover {
  color:#269ccc;
}

/* Dropdown Menu for Claim Management */
.dropdown-createmenu {
  position: absolute;
  top: 100%;
  left: 0;
  background: #269ccc;
  /* border: 1px solid #34495e; */
  list-style-type: none;
  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
  min-width: 200px;
  z-index: 1000;
  display: none;
  padding: 0.5rem 0;
  border-radius: 8px;
}

.nav-item.dropdown:hover .dropdown-createmenu {
  display: block;
}

/* User Menu Dropdown */
.dropdown-menu-end {
  position: absolute;
  top: 100%;
  right: 0;
  background-color: #fff;
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 0.5rem 0;
  min-width: 180px;
  display: none;
  z-index: 1000;
  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1); 
}

.user-menu:hover .dropdown-menu-end {
  display: block;
}

/* Dropdown Items */
.dropdown-menu-end .dropdown-rightheader {
  padding: 0.75rem 1rem;
  font-size: 14px;
  color: #7b7b7b; 
  background-color: transparent;
  transition: background-color 0.2s ease, color 0.2s ease;
  border: none; 
  width: 100%; 
  text-align: left;
  cursor: pointer; 
}

/* Hover Effect for Dropdown Items */
.dropdown-menu-end .dropdown-rightheader:hover {
  background-color: #269ccc; 
  color: #fff; 
  border-radius: 4px; 
}




.dropdown-item-header {
  display: block;
  padding: 0.5rem 1rem;
  text-decoration: none;
  font-size: 14px;
  color: #ecf0f1;
  transition: background-color 0.2s ease;
}

.dropdown-item-header:hover {
  background-color: #3498db;
  border-radius: 4px;
}

/* Nested Dropdown Menu */
.nested-dropdown-menu {
  position: absolute;
  top: 0;
  left: 100%;
  /* background: #2c3e50; */
  background: #269ccc;
  /* border: 1px solid #34495e; */
  list-style-type: none;
  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
  min-width: 200px;
  display: none;
  padding: 0.5rem 0;
  border-radius: 8px;
}

.dropdown-createmenu li:hover .nested-dropdown-menu {
  display: block;
}

/* User Menu Section */
.user-menu {
  position: relative;
}

.user-profile {
  width: 40px;
  height: 40px;
  border: 2px solid #269ccc; 
  border-radius: 50%;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.user-profile:hover {
  transform: scale(1.1);
  box-shadow: 0px 0px 10px rgba(52, 152, 219, 0.8); 
}

.dropdown-menu-end {
  position: absolute;
  top: 100%;
  right: 0;
  background-color: #fff;
  /* border: 1px solid #34495e; */
  border-radius: 8px;
  padding: 0.5rem 0;
  min-width: 180px;
  display: none;
  z-index: 1000;
  color: #000;
}

.user-menu:hover .dropdown-menu-end {
  display: block;
}

.dropdown-menu-end .dropdown-rightheader{
  padding: 0.75rem 1rem;
  font-size: 14px;
  color: #7b7b7b;
  background-color: transparent;
  transition: background-color 0.2s ease;
}

.dropdown-menu-end .dropdown-rightheader:hover {
  background-color: #269ccc;
  border-radius: 4px;
  color: #fff;;
}

/* Hamburger Menu for Mobile */
.hamburger-menu {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  margin-left: auto; 
}

.hamburger-menu div {
  width: 25px;
  height: 3px;
  background-color: #ecf0f1;
  transition: all 0.3s ease;
}

/* Responsive Design */
@media (max-width: 768px) {
  .hamburger-menu {
    display: flex;
    order: 2;
  }

  .header-nav {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: #2c3e50;
    flex-direction: column;
    align-items: flex-start;
    padding: 1rem;
    display: none;
  }

  .header-nav.active {
    display: flex;
  }

  .nav-list {
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .nav-item {
    width: 100%;
  }

  .dropdown-createmenu {
    position: static;
    display: none;
    width: 100%;
  }

  .nav-item.dropdown:hover .dropdown-createmenu {
    display: block;
  }

  .nested-dropdown-menu {
    position: static;
    display: none;
    width: 100%;
  }

  .dropdown-createmenu li:hover .nested-dropdown-menu {
    display: block;
  }

  .user-menu {
    order: 3; 
  }
}

import React, { useState, useRef, useEffect, useContext } from "react";
import { useNavigate, Link } from "react-router-dom";
import "./Header.css";
import Logo from "../../assests/images/Logo.png";
import Profile from "../../assests/images/Profile.png";
import { UserContext } from "../../components/context/UserContext.js";

const Header = () => {
  const [isUserMenuOpen, setIsUserMenuOpen] = useState(false);
  const [isCreateClaimDropdownOpen, setIsCreateClaimDropdownOpen] = useState(false);
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const [isApplyClaimDropdownOpen, setIsApplyClaimDropdownOpen] = useState(false);
  const [isInsolvencyDropdownOpen, setIsInsolvencyDropdownOpen] = useState(false);
  const [isLiquidationDropdownOpen, setIsLiquidationDropdownOpen] = useState(false);
  const userMenuRef = useRef(null);
  const navigate = useNavigate();
  const { userData, updateFormType } = useContext(UserContext); // Use updateFormType from context
  console.log(userData, "userDaTA");

  const selectedRadio = userData || {};

  const toggleUserMenu = () => {
    setIsUserMenuOpen(!isUserMenuOpen);
  };

  const toggleCreateClaimDropdown = () => {
    setIsCreateClaimDropdownOpen(!isCreateClaimDropdownOpen);
  };

  const toggleMobileMenu = () => {
    setIsMobileMenuOpen(!isMobileMenuOpen);
  };

  const toggleApplyClaimDropdown = () => {
    setIsApplyClaimDropdownOpen(!isApplyClaimDropdownOpen);
    setIsInsolvencyDropdownOpen(false);
    setIsLiquidationDropdownOpen(false);
  };

  const toggleInsolvencyDropdown = () => {
    setIsInsolvencyDropdownOpen(!isInsolvencyDropdownOpen);
    setIsLiquidationDropdownOpen(false);
    updateFormType("Insolvency"); // Update formType in context
  };

  const toggleLiquidationDropdown = () => {
    setIsLiquidationDropdownOpen(!isLiquidationDropdownOpen);
    setIsInsolvencyDropdownOpen(false);
    updateFormType("Liquidation"); // Update formType in context
  };

  useEffect(() => {
    const handleClickOutside = (event) => {
      if (userMenuRef.current && !userMenuRef.current.contains(event.target)) {
        setIsUserMenuOpen(false);
      }
    };

    document.addEventListener("mousedown", handleClickOutside);
    return () => {
      document.removeEventListener("mousedown", handleClickOutside);
    };
  }, []);

  const handleLogout = () => {
    localStorage.clear();
    navigate("/login");
  };

  const handleMyProfileClick = () => {
    navigate("/my-profile");
    setIsUserMenuOpen(false);
  };

  const handleChangePasswordClick = () => {
    navigate("/change-password");
    setIsUserMenuOpen(false);
  };

  const renderForm = () => {
    const { claimantType, claimantCategoryType } = selectedRadio;

    if (claimantType === "Financial Creditors") {
      if (
        claimantCategoryType === "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)" ||
        claimantCategoryType === "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)" ||
        claimantCategoryType === "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)"
      ) {
        return <Link to="/apply-claim" className="dropdown-item-header" onClick={toggleMobileMenu}>Form C</Link>;
      } else if (claimantCategoryType === "Unsecured Financial Creditors in Class of Creditors (Homebuyers)") {
        return <Link to="/apply-claim" className="dropdown-item-header" onClick={toggleMobileMenu}>Form CA</Link>;
      }
    } else if (claimantType === "Operational Creditors") {
      return <Link to="/apply-claim" className="dropdown-item-header" onClick={toggleMobileMenu}>Form B</Link>;
    } else if (claimantType === "Employees and Workmen") {
      return <Link to="/apply-claim" className="dropdown-item-header" onClick={toggleMobileMenu}>Form D</Link>;
    } else if (claimantType === "Employees and Workmen – Through Authorised Representative") {
      return <Link to="/apply-claim" className="dropdown-item-header" onClick={toggleMobileMenu}>Form E</Link>;
    } else if (claimantType === "Other Creditors (other than financial and operational creditors)") {
      return <Link to="/apply-claim" className="dropdown-item-header" onClick={toggleMobileMenu}>Form F</Link>;
    }

    return null;
  };

  const renderFormLiquidation = () => {
    const { claimantType, claimantCategoryType } = selectedRadio;

    if (claimantType === "Financial Creditors") {
      if (
        claimantCategoryType === "Secured Financial Creditors (Banks/ARCs/NBFCs/FIs)" ||
        claimantCategoryType === "Unsecured Financial Creditors (Banks/ARCs/NBFCs/FIs)" ||
        claimantCategoryType === "Unsecured Financial Creditors – (Other than Banks / ARCs / NBFCs)" ||
        claimantCategoryType === "Unsecured Financial Creditors in Class of Creditors (Homebuyers)"
      ) {
        return <Link to="/apply-claim" className="dropdown-item-header" onClick={toggleMobileMenu}>Form D</Link>;
      }
    } else if (claimantType === "Operational Creditors") {
      return <Link to="/apply-claim" className="dropdown-item-header" onClick={toggleMobileMenu}>Form C</Link>;
    } else if (claimantType === "Employees and Workmen") {
      return <Link to="/apply-claim" className="dropdown-item-header" onClick={toggleMobileMenu}>Form E</Link>;
    } else if (claimantType === "Employees and Workmen – Through Authorised Representative") {
      return <Link to="/apply-claim" className="dropdown-item-header" onClick={toggleMobileMenu}>Form F</Link>;
    } else if (claimantType === "Other Creditors (other than financial and operational creditors)") {
      return <Link to="/apply-claim" className="dropdown-item-header" onClick={toggleMobileMenu}>Form G</Link>;
    }

    return null;
  };

  return (
    <header className="app-header">
      <div className="header-left">
        <div className="logo-container">
          <img src={Logo} alt="Logo" className="logo" />
        </div>
        <div className="header-title">
          <h4>Claim Submission</h4>
          <p>Service</p>
        </div>
      </div>

      <div className="hamburger-menu" onClick={toggleMobileMenu}>
        <div></div>
        <div></div>
        <div></div>
      </div>

      <nav className={`header-nav ${isMobileMenuOpen ? "active" : ""}`}>
        <ul className="nav-list">
          <li className="nav-item">
            <Link to="/dashboard" className="nav-link" onClick={toggleMobileMenu}>
              Home
            </Link>
          </li>
          <li className="nav-item">
            <Link to="/about" className="nav-link" onClick={toggleMobileMenu}>
              About Us
            </Link>
          </li>
          <li className="nav-item dropdown">
            <a
              href="#"
              className="nav-link dropdown-toggle"
              onClick={toggleCreateClaimDropdown}
            >
              Claim Management
            </a>
            <ul className="dropdown-createmenu">
              {selectedRadio.userType === "CRP" && (
                <li>
                  <a
                    href="#"
                    className="dropdown-item-header"
                    onClick={toggleCreateClaimDropdown}
                  >
                    Create Claim
                  </a>
                  {isCreateClaimDropdownOpen && (
                    <ul className="nested-dropdown-menu">
                      <li>
                        <Link
                          to="/create-claim/creditor"
                          className="dropdown-item-header"
                          onClick={toggleMobileMenu}
                        >
                          Creditor
                        </Link>
                      </li>
                      <li>
                        <Link
                          to="/create-claim/financial"
                          className="dropdown-item-header"
                          onClick={toggleMobileMenu}
                        >
                          Financial
                        </Link>
                      </li>
                      <li>
                        <Link
                          to="/create-claim/homebuyer"
                          className="dropdown-item-header"
                          onClick={toggleMobileMenu}
                        >
                          Homebuyer
                        </Link>
                      </li>
                    </ul>
                  )}
                </li>
              )}
              {selectedRadio.userType === "CLM" && (
                <li>
                  <a
                    href="#"
                    className="dropdown-item-header"
                    onClick={toggleApplyClaimDropdown}
                  >
                    Apply for Claim
                  </a>
                  {isApplyClaimDropdownOpen && (
                    <ul className="nested-dropdown-menu">
                      <li>
                        <a
                          href="#"
                          className="dropdown-item-header"
                          onClick={toggleInsolvencyDropdown}
                        >
                          Insolvency
                        </a>
                        {isInsolvencyDropdownOpen && (
                          <ul className="nested-dropdown-menu">
                            <li>{renderForm()}</li>
                          </ul>
                        )}
                      </li>
                      <li>
                        <a
                          href="#"
                          className="dropdown-item-header"
                          onClick={toggleLiquidationDropdown}
                        >
                          Liquidation
                        </a>
                        {isLiquidationDropdownOpen && (
                          <ul className="nested-dropdown-menu">
                            <li>{renderFormLiquidation()}</li>
                          </ul>
                        )}
                      </li>
                    </ul>
                  )}
                </li>
              )}
            </ul>
          </li>
        </ul>
      </nav>

      <div className="user-menu" ref={userMenuRef}>
        <img
          src={Profile}
          alt="User"
          className="user-profile"
          onClick={toggleUserMenu}
        />
        {isUserMenuOpen && (
          <ul className="dropdown-menu dropdown-menu-end">
            <li>
              <button className="dropdown-rightheader" onClick={handleMyProfileClick}>
                My Profile
              </button>
            </li>
            <li>
              <button className="dropdown-rightheader" onClick={handleChangePasswordClick}>
                Change Password
              </button>
            </li>
            <li>
              <button className="dropdown-rightheader" onClick={handleLogout}>
                Logout
              </button>
            </li>
          </ul>
        )}
      </div>
    </header>
  );
};

export default Header;
