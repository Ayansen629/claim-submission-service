                placeholder={t("Enter Bulkhead Placement")}
                register={register("hullParticulars.bulkheadPlacement")}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputText
                label={t("Bulkhead Thickness")}
                name="hullParticulars.bulkheadThickness"
                type="number"
