                  "engineDetails.engineCylinder"
                )}
                errors={errors}
                disabled={viewMode}
              />
            </Col>
            <Col md={4}>
              <InputSelect
                label={t("Propeller Type")}
                name="engineDetails.propellerType"
                placeholder={!viewMode ? t("-- Select --") : ""}
                options={[
                  {
                    value: "",
                    label: "-- Select --",
                  },
                  ...(masterData?.propellerTypes?.map((type) => ({
                    value: type.valueCode,
                    label: type.valueLabel,
                  })) || []),
                ]}
                register={register("engineDetails.propellerType")}
                errors={errors}
                value={watch("engineDetails.propellerType") || ""}
                onChange={(value) =>
                  !viewMode &&
                  handleSelectChange("engineDetails.propellerType", value)
