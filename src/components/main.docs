const FormCDetails = ({ provideSubmitHandler, formData }) => {
  const methods = useForm();
  const { register, handleSubmit, formState: { errors }, control, setValue, getValues, watch, reset } = methods;
  const [selectedClaimType, setSelectedClaimType] = useState("");

  // Bank account fields
  const bankAccountFields = [
    {
      name: "accountNumber",
      label: "Account Number",
      type: "text",
      rules: { required: "Account number is required" },
      placeholder: "Enter account number"
    },
    {
      name: "ifscCode",
      label: "IFSC Code",
      type: "text",
      rules: { 
        required: "IFSC code is required",
        pattern: {
          value: /^[A-Za-z]{4}0[A-Za-z0-9]{6}$/,
          message: "Invalid IFSC code format"
        }
      },
      placeholder: "Enter IFSC code",
      component: IFSCSearch
    },
    {
      name: "bankName",
      label: "Bank Name",
      type: "text",
      rules: { required: "Bank name is required" },
      placeholder: "Enter bank name"
    },
    {
      name: "branchName",
      label: "Branch Name",
      type: "text",
      rules: { required: "Branch name is required" },
      placeholder: "Enter branch name"
    },
    {
      name: "branchAddress",
      label: "Branch Address",
      type: "text",
      rules: { required: "Branch address is required" },
      placeholder: "Enter branch address"
    },
    {
      name: "city",
      label: "City",
      type: "text",
      rules: { required: "City is required" },
      placeholder: "Enter city"
    },
    {
      name: "state",
      label: "State",
      type: "text",
      rules: { required: "State is required" },
      placeholder: "Enter state"
    },
    {
      name: "district",
      label: "District",
      type: "text",
      rules: { required: "District is required" },
      placeholder: "Enter district"
    }
  ];

  // Claim type options - keep all options but only show fields for financialDebt
  const claimTypeOptions = [
    { value: "", label: "Select Claim Type", disabled: true },
    { value: "principalBorrower", label: "Corporate Debtor as Principal Borrower" },
    { value: "guarantor", label: "Corporate Debtor as Guarantor" },
    { value: "financialDebt", label: "Financial Debt Covered" },
  ];

  const onSubmit = (data) => {
    if (provideSubmitHandler) {
      provideSubmitHandler(data);
    }
  };

  useEffect(() => {
    if (formData) {
      reset(formData);
      if (formData.claimType) {
        setSelectedClaimType(formData.claimType);
      }
    }
  }, [formData, reset]);

  const handleClaimTypeChange = (value) => {
    setSelectedClaimType(value);
    // Reset form when claim type changes
    reset({
      claimType: value,
    });
  };

  // Only show title when financialDebt is selected
  const getClaimTitle = () => {
    if (selectedClaimType === "financialDebt") {
      return "Details of claim: Financial Debt Covered";
    }
    return null;
  };

  return (
    <FormProvider {...methods}>
      <form className="form-stepper" onSubmit={handleSubmit(onSubmit)}>
        {/* Claim Type Selection - always shown with all options */}
        <div className="mb-4 bg-light">
          <div className="flex-item">
            <label>
              Select Claim Type <span className="required-asterisk">*</span>
            </label>
            <select
              {...register("claimType", { required: "Claim type is required" })}
              className={`form-input ${errors.claimType ? "input-error" : ""}`}
              onChange={(e) => handleClaimTypeChange(e.target.value)}
              value={selectedClaimType}
            >
              {claimTypeOptions.map((option) => (
                <option key={option.value} value={option.value} disabled={option.disabled}>
                  {option.label}
                </option>
              ))}
            </select>
            {errors.claimType && <p className="error-message">{errors.claimType.message}</p>}
          </div>
        </div>

        {/* Claim Details Section - only shown for financialDebt */}
        {selectedClaimType === "financialDebt" && (
          <div className="mb-4 bg-light">
            <Collapsible title={getClaimTitle()}>
              <ClaimTypeFields 
                claimType={selectedClaimType}
                control={control}
                register={register}
                errors={errors}
                setValue={setValue}
                getValues={getValues}
                watch={watch}
              />
            </Collapsible>
          </div>
        )}

        {/* Bank Account Details Section (always shown) */}
        <div className="mb-4 bg-light">
          <Collapsible title="Bank Account Details">
            <div className="flex-container">
              {bankAccountFields.map((field) => (
                field.component ? (
                  <field.component
                    key={field.name}
                    fieldConfig={field}
                    control={control}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    getValues={getValues}
                    watch={watch}
                  />
                ) : (
                  <DynamicField
                    key={field.name}
                    fieldConfig={field}
                    control={control}
                    register={register}
                    errors={errors}
                    setValue={setValue}
                    getValues={getValues}
                    watch={watch}
                  />
                )
              ))}
            </div>
          </Collapsible>
        </div>
      </form>
    </FormProvider>
  );
};


const ClaimTypeFields = ({ 
  claimType, 
  control, 
  register, 
  errors, 
  setValue, 
  getValues, 
  watch 
}) => {
  const [entityFields, setEntityFields] = useState([1]);

  const addEntityField = () => {
    setEntityFields([...entityFields, entityFields.length + 1]);
  };

  const removeEntityField = (index) => {
    if (entityFields.length <= 1) return;
    
    const newFields = [...entityFields];
    newFields.splice(index, 1);
    setEntityFields(newFields);
    
    // Clear the removed entity's data
    const entityNum = index + 1;
    setValue(`financialDebtName${entityNum}`, undefined);
    setValue(`financialDebtAddress${entityNum}`, undefined);
  };

  return (
    <div className="flex-container">
      {/* Amount of claim */}
      <DynamicField
        fieldConfig={{
          name: "claimAmount",
          label: "Amount of claim",
          type: "number",
          rules: { required: "Claim amount is required" },
          placeholder: "Enter claim amount"
        }}
        control={control}
        register={register}
        errors={errors}
        setValue={setValue}
        getValues={getValues}
        watch={watch}
      />

      {/* Beneficiary fields */}
      {entityFields.map((entityNum, index) => (
        <React.Fragment key={entityNum}>
          <div className="flex-item-with-button">
            <DynamicField
              fieldConfig={{
                name: `financialDebtName${entityNum}`,
                label: `Name of the Beneficiary ${entityNum}`,
                type: "text",
                rules: { required: "This field is required" },
                placeholder: "Enter beneficiary name"
              }}
              control={control}
              register={register}
              errors={errors}
              setValue={setValue}
              getValues={getValues}
              watch={watch}
            />
            {index > 0 && (
              <button 
                type="button" 
                className="remove-btn"
                onClick={() => removeEntityField(index)}
              >
                Remove
              </button>
            )}
          </div>

          <DynamicField
            fieldConfig={{
              name: `financialDebtAddress${entityNum}`,
              label: `Address of the Beneficiary ${entityNum}`,
              type: "text",
              rules: { required: "This field is required" },
              placeholder: "Enter beneficiary address"
            }}
            control={control}
            register={register}
            errors={errors}
            setValue={setValue}
            getValues={getValues}
            watch={watch}
          />
        </React.Fragment>
      ))}

      <button 
        type="button" 
        className="add-more-btn" 
        onClick={addEntityField}
      >
        + Add Beneficiary
      </button>
    </div>
  );
};
